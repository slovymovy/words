                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c3582da-daa1-3da7-a818-cb93a6392d61",
                        "entry_id": "e5f5a667-a15c-3787-b405-410f6c083e70",
                        "glosses": [
                            "aanstaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf7adfc-1b73-4363-80d0-893894cbf466",
                                "sense_id": "1c3582da-daa1-3da7-a818-cb93a6392d61",
                                "text": "Hij zou wel eens de aankomende voorzitter van onze vereniging kunnen zijn."
                            },
                            {
                                "example_id": "4d199874-6753-4ccc-9310-48e7d3101ead",
                                "sense_id": "1c3582da-daa1-3da7-a818-cb93a6392d61",
                                "text": "Aanstaande woensdag komen mijn kinderen eten."
                            },
                            {
                                "example_id": "5b55c72e-3029-429f-996a-47d1b8f0c7c2",
                                "sense_id": "1c3582da-daa1-3da7-a818-cb93a6392d61",
                                "text": "Inspiratiebron: Europese Commissievoorzitter Von der Leyen noemt de Argentijn een inspiratiebron. \"Hij inspireerde miljoenen mensen, ver buiten de katholieke kerk, met zijn bescheidenheid en pure liefde voor de minderbedeelden.\" Ook CDU-leider Merz, aankomend bondskanselier van Duitsland, zegt dat de paus herinnerd zal worden \"vanwege zijn onvermoeibare inzet voor de zwaksten in de samenleving, voor rechtvaardigheid en verzoening\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "6103b4e9-0dd3-3c99-951a-22a1ebbacc60",
                        "entry_id": "e5f5a667-a15c-3787-b405-410f6c083e70",
                        "glosses": [
                            "opgroeiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6756be15-1a4a-4366-90ff-258f0897c40a",
                                "sense_id": "6103b4e9-0dd3-3c99-951a-22a1ebbacc60",
                                "text": "Hij was een jong en veelbelovend aankomend talent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f26c9c1-a7aa-4548-918d-482a16a97a53",
