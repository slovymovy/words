        "nl-extract.jsonl": [
            {
                "entry_id": "e49d1c3f-8baa-374a-8d9d-da213fff31de",
                "word": "vereenzelvigen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f5902c8b-8aba-3924-8597-2b2beb2ae2f8",
                        "entry_id": "e49d1c3f-8baa-374a-8d9d-da213fff31de",
                        "glosses": [
                            "zich vereenzelvigen met: zich met iets identificeren"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "e21d3de8-56e2-49b8-a264-ef073f041ca3",
                                "sense_id": "f5902c8b-8aba-3924-8597-2b2beb2ae2f8",
                                "text": "Toen ik jong was keek ik vooral naar films over echte mensen die leefden in een realistische wereld. Zij hadden geen speciale krachten. Dat maakte hen eenvoudiger om je mee te vereenzelvigen. Het fenomeen fantasy bestond destijds amper. Of beter gezegd: ik kwam er niet mee in aanraking.’’"
                            },
                            {
                                "example_id": "d3fcd32b-4740-4a19-be2f-2edeeb592946",
                                "sense_id": "f5902c8b-8aba-3924-8597-2b2beb2ae2f8",
                                "text": "Overigens twijfel ik niet aan de potentie van FvD-leider Thierry Baudet. Die heeft in korte tijd veel voor elkaar gekregen. Maar leider en beweging moet je alleen in een dictatuur met elkaar vereenzelvigen, en zover is het nog niet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16d7de47-1471-492f-9382-26a106ce1f18",
                        "source_entry_id": "e49d1c3f-8baa-374a-8d9d-da213fff31de",
                        "source_sense_id": "f5902c8b-8aba-3924-8597-2b2beb2ae2f8",
                        "target_lang_word": "identify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7738e3-c244-33f8-8a0e-99dd4195c8eb",
                                        "entry_id": "50286627-3f1d-3633-ba5e-71457420b0bb",
                                        "glosses": [
                                            "To establish the identity of someone or something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d2572e8-2f9a-4314-9fec-2257d924033d",
                                                "sense_id": "eb7738e3-c244-33f8-8a0e-99dd4195c8eb",
                                                "text": "It was hard to identify the shoplifter because the CCTV records didn't have a clear image."
                                            },
                                            {
                                                "example_id": "6046e848-5086-49ef-88fd-89baa52cf5e3",
                                                "sense_id": "eb7738e3-c244-33f8-8a0e-99dd4195c8eb",
                                                "text": "The formal name of a national having domiciliary register shall be identified by the national identity card."
                                            },
                                            {
                                                "example_id": "26b128d7-7483-4c30-8569-5eced1bd5e9d",
                                                "sense_id": "eb7738e3-c244-33f8-8a0e-99dd4195c8eb",
                                                "text": "A provision of law may not be construed as requiring a new grant to be awarded to a specified non-Federal Government entity unless that provision of law (1) specifically refers to this subsection; specifically identifies the particular non-Federal Government entity involved; and (3) specifically states that the award to that entity is required by such provision of law in contravention of the policy set forth in subsection (a)."
                                            },
                                            {
                                                "example_id": "d4464e5b-177e-4ec6-a402-a1c8a0d1680a",
                                                "sense_id": "eb7738e3-c244-33f8-8a0e-99dd4195c8eb",
                                                "text": "If you have normal insulins with a normal oral glucose tolerance identifying nondiabetes, does it mean that you were never diabetic..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a708e16-92b5-3eb4-8031-017dd5dea8d2",
                                        "entry_id": "50286627-3f1d-3633-ba5e-71457420b0bb",
                                        "glosses": [
                                            "To disclose the identity of someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10963401-6c4f-4e4d-afbf-ed55b09174e3",
                                                "sense_id": "5a708e16-92b5-3eb4-8031-017dd5dea8d2",
                                                "text": "The Associated Press will not identify the suspect of the crime because he is a juvenile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b0a2116-085d-386c-b014-b69f26ea2ac4",
                                        "entry_id": "50286627-3f1d-3633-ba5e-71457420b0bb",
                                        "glosses": [
                                            "To establish the taxonomic classification of an organism."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8fb88da-66ec-4fda-89b2-6b55ae2a0f7d",
                                                "sense_id": "2b0a2116-085d-386c-b014-b69f26ea2ac4",
                                                "text": "A recent biological inventory uncovered 41 species and 2 subspecies of insects new to science and many species not before identified in the State of Washington."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68c72c76-3c90-32e7-909e-0823cf0bce99",
                                        "entry_id": "50286627-3f1d-3633-ba5e-71457420b0bb",
                                        "glosses": [
                                            "To equate or make the same; to unite or combine into one."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b07aea31-6fea-42b6-9509-b793ee57c3ad",
                                                "sense_id": "68c72c76-3c90-32e7-909e-0823cf0bce99",
                                                "text": "Every precaution is taken to identify the interests of the people, and their rulers."
                                            },
                                            {
                                                "example_id": "721222ae-a6c2-4a58-b6b8-893018862fd5",
                                                "sense_id": "68c72c76-3c90-32e7-909e-0823cf0bce99",
                                                "text": "18 February, 1780, Edmund Burke, Speech on Economical Reform\nLet us identify, let us incorporate ourselves with the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2918b819-f172-351f-a864-6cdd9d131ebc",
                                        "entry_id": "50286627-3f1d-3633-ba5e-71457420b0bb",
                                        "glosses": [
                                            "To have a strong affinity with; to feel oneself to be modelled on or connected to."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aa4e6a9-ebfe-47ba-9016-bfa935b2371a",
                                                "sense_id": "2918b819-f172-351f-a864-6cdd9d131ebc",
                                                "text": "Der Traum erhält eine neue Deutung, wenn sie im Traum nicht sich, sondern die Freundin meint, wenn sie sich an die Stelle der Freundin gesetzt oder, wie wir sagen können, sich mit ihr identifiziert hat.",
                                                "translation": "The dream is given a new interpretation if in her dream she means not herself but her friend, if she has put herself in the place of her friend, or, as we may say, she has identified herself with her.",
                                                "english": "The dream is given a new interpretation if in her dream she means not herself but her friend, if she has put herself in the place of her friend, or, as we may say, she has identified herself with her."
                                            },
                                            {
                                                "example_id": "2a96c3f5-7e6e-4002-9b40-2e86f65f1ab7",
                                                "sense_id": "2918b819-f172-351f-a864-6cdd9d131ebc",
                                                "text": "Cash endures because his most well-known songs—“I Walk the Line” and “Ring of Fire” among them—weave deeply personal narratives with which listeners of all stripes can effortlessly identify."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "177815d3-47e7-37e9-a64d-fac59d0ea478",
                                        "entry_id": "50286627-3f1d-3633-ba5e-71457420b0bb",
                                        "glosses": [
                                            "To associate oneself with some group; to feel, or believe one feels, the same way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca95bfb-30dc-4023-b1ea-ba2335a95ecb",
                                                "sense_id": "177815d3-47e7-37e9-a64d-fac59d0ea478",
                                                "text": "Now, the vast majority of us identify with the second group, the one that believes in trusting the wisdom of the people rather than taking power away from them and concentrating it in the other hands."
                                            },
                                            {
                                                "example_id": "72ef745e-c851-4acf-8221-048dc1d24cff",
                                                "sense_id": "177815d3-47e7-37e9-a64d-fac59d0ea478",
                                                "text": "My lover and I are arguing about time. Specifically how much time I'm devoting to AIDS Action. […] I try not to take her accusations to heart. That is, until she says it. \"You're more gay-identified than woman-identified.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f7c0cf-b3cf-3924-8f23-443bdcc67809",
                                        "entry_id": "50286627-3f1d-3633-ba5e-71457420b0bb",
                                        "glosses": [
                                            "To claim an identity; to describe oneself as a member of a group; to assert the use of a particular term to describe oneself."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09fe0b9c-cd5c-4b36-b7aa-4ddbcea5bfdf",
                                                "sense_id": "49f7c0cf-b3cf-3924-8f23-443bdcc67809",
                                                "text": "\"The main message is that it's the interface between individuals and society that causes students who identify as gay, lesbian, or bisexual the most distress,\" said study first author Yue Zhao."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89387e60-fbb4-49ec-9a6f-b8b52091d61f",
