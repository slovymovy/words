        "fr-extract.jsonl": [
            {
                "entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                "word": "menon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a441b400-ddd1-4206-a37c-38bfd205e934",
                        "entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "menons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85bd36d4-b0b7-3706-b43e-1f87e0f5ec63",
                        "entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "glosses": [
                            "Bouc de tête chargé de mener un troupeau, notamment durant une transhumance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb04ce9-0707-4b45-9f00-3d71bb1b7805",
                                "sense_id": "85bd36d4-b0b7-3706-b43e-1f87e0f5ec63",
                                "text": "Un jeune berger, le bâton à la main, marchait en tête et derrière lui avançaient, de front, guides et chefs de file, ceux qu'on nomme les menons, béliers et boucs puissamment cornus, portant des cloches énormes pendues à de larges colliers de cuir."
                            }
                        ]
                    },
                    {
                        "sense_id": "c236680b-43b6-38fb-8cdf-1aaa763189e7",
                        "entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "glosses": [
                            "Bouc châtré (en Provence seuls des boucs châtrés sont mêlés aux brebis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e833cfd4-473a-4fac-88fb-bb8928d9291a",
                                "sense_id": "c236680b-43b6-38fb-8cdf-1aaa763189e7",
                                "text": "Ces boucs chastrés (en aucuns endroits appellés menons) entretient-on au troupeau quatre ou cinq ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "951bd98c-d655-36cd-9c9c-8a2b088f37ef",
                        "entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "glosses": [
                            "Chèvre du Levant dont la peau sert à faire du maroquin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f1e166-2cd4-45f7-a15a-fc7658ce3f31",
                                "sense_id": "951bd98c-d655-36cd-9c9c-8a2b088f37ef",
                                "text": "D'autres peaux […] peuvent être employées dans certains cas : le chagrin, les peaux de menon, de bouquetin, la peau de phoque, de crocodile, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "d077a794-feb9-3b5c-8ccb-fc3304c3d3ec",
                        "entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "glosses": [
                            "Autrefois, personne chargée d’arranger les mariages aux mieux des intérêts des familles et de discuter de la dot."
                        ],
                        "tags": [
                            "Berry"
                        ],
                        "examples": [
                            {
                                "example_id": "ef04e616-9702-437e-ba0c-25adc50f87f2",
                                "sense_id": "d077a794-feb9-3b5c-8ccb-fc3304c3d3ec",
                                "text": "Lorsqu’un galant a définitivement arrêté sa visée et jeté son dévolu, il se met en quêt d’un menon, c'est à dire d’une personne d’expérience capable de le guider dans son entreprise, d'aplanir toutes les difficultés et qui veuille bien se charger de la demande en mariage, tout en faisant valoir les qualités de son protégé."
                            }
                        ]
                    },
                    {
                        "sense_id": "410c5de2-fa17-3c2b-b077-6984c3731a44",
                        "entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "glosses": [
                            "Mouton, flocons de poussière qui s’assemblent sous les meubles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b8bdfde-09aa-4f5c-adeb-3a9fc3991e4b",
                                "sense_id": "410c5de2-fa17-3c2b-b077-6984c3731a44",
                                "text": "ce soir j’en ai assez\nde n’être qu’un menon\nqui gît sous un lit à refaire,\nun pauvre menon sans nom\nà la merci d’un courant d’air."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ee01978-a8f7-49c1-9cb7-9f45517e9b4d",
                        "source_entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "source_sense_description": "bouc de tête",
                        "target_lang_word": "bellwether",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bellwether",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "644b6c77-6a37-3ba0-9288-83fc79b0831e",
                                        "entry_id": "8398f189-2db1-312a-8b41-85b5e5c92f71",
                                        "glosses": [
                                            "The leading sheep of a flock, having a bell hung round its neck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd490fb5-dab4-457d-bb69-7db14cdfa282",
                                                "sense_id": "644b6c77-6a37-3ba0-9288-83fc79b0831e",
                                                "text": "Several old ladies forthwith proclaimed their intention of following him; but, as one or two of them were deaf, and another had been threatened with an attack of that mild, but obstinate complaint, dementia senilis, many thought it was not so much the force of his arguments as a kind of tendency to jump as the bellwether jumps, well known in flocks not included in the Christian fold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97faf4a1-7893-3c3f-a86b-062a812937d9",
                                        "entry_id": "8398f189-2db1-312a-8b41-85b5e5c92f71",
                                        "glosses": [
                                            "Anything that indicates future trends."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68ab4f63-9bb5-489e-acc7-74d878f0852b",
                                                "sense_id": "97faf4a1-7893-3c3f-a86b-062a812937d9",
                                                "text": "Mortgage delinquencies often act as a bellwether for a forthcoming recession."
                                            },
                                            {
                                                "example_id": "4be4a2dc-f833-4e5b-a3c5-1764944fd933",
                                                "sense_id": "97faf4a1-7893-3c3f-a86b-062a812937d9",
                                                "text": "At Hampton Court the little flocks of visitors are not provided with an official bellwether, but are left to browse at discretion upon the local antiquities."
                                            },
                                            {
                                                "example_id": "2e97a97c-d6f5-4e9f-9a9a-1822a951fc7f",
                                                "sense_id": "97faf4a1-7893-3c3f-a86b-062a812937d9",
                                                "text": "I suspect that, after all,[…]—that all this has been known, perhaps for ages, to certain ones upon this earth, a cult or order, members of which function like bellwethers to the rest of us, or as superior slaves or overseers, directing us in accordance with instructions received—from Somewhere else—in our mysterious usefulness."
                                            },
                                            {
                                                "example_id": "4efb8258-59d7-4b6f-8c69-984f4602c66d",
                                                "sense_id": "97faf4a1-7893-3c3f-a86b-062a812937d9",
                                                "text": "In December, after everyone had weighed in, Nature, a bellwether of mainstream scientific thought for more than a century, cautiously supported a future of automated scientific scrutiny in an editorial that addressed the Statcheck controversy without explicitly naming it."
                                            },
                                            {
                                                "example_id": "cca122ac-fd17-40c7-af34-576f034885f0",
                                                "sense_id": "97faf4a1-7893-3c3f-a86b-062a812937d9",
                                                "text": "A bellwether election in Germany’s most populous state has shown a further eroding of support for populist parties on the far ends of the political spectrum, thrown up questions over the pulling power of the chancellor, Olaf Scholz, and entrenched the growing authority of the Greens."
                                            },
                                            {
                                                "example_id": "6324767f-1b41-456e-9efe-6bc9cad91580",
                                                "sense_id": "97faf4a1-7893-3c3f-a86b-062a812937d9",
                                                "text": "Wisconsin’s state Supreme Court races were once sleepy affairs. But over the past decade they have increasingly been seen as crucial national bellwethers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b47b426-4be4-3553-8891-a01b5f8b1705",
                                        "entry_id": "8398f189-2db1-312a-8b41-85b5e5c92f71",
                                        "glosses": [
                                            "A stock or bond that is widely believed to be an indicator of the overall market's condition."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4bc460-f75a-47dc-86e1-dda0a3cdbbdd",
                                                "sense_id": "4b47b426-4be4-3553-8891-a01b5f8b1705",
                                                "text": "One of my favorite sentiment indicators is bellwether stocks — key stocks that are leaders in their fields. When investors buy or sell these shares, it's usually a good sign of confidence or the lack of it in that sector of the market and sometimes even the economy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f376729b-1497-4b15-bcc0-d761721787b5",
                        "source_entry_id": "9a9c6821-967d-30ed-ae4f-364944dbf3f7",
                        "source_sense_description": "bouc châtré",
                        "target_lang_word": "hňup",
