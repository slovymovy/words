                "senses": [
                    {
                        "sense_id": "f5e3da26-86ef-3e43-8c3f-cbec8a33c52c",
                        "entry_id": "fb2cc57d-03d9-3247-bfaf-79d9b5a979b7",
                        "glosses": [
                            "Convertir en marionnette ; soumettre quelqu’un à ses ordres occultes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191d4f34-0e06-4ab6-940b-32c2b7aceda1",
                                "sense_id": "f5e3da26-86ef-3e43-8c3f-cbec8a33c52c",
                                "text": "Quelle impudence de marionnettiser un homme mort depuis longtemps, incapable de se défendre ! De lui faire boire du thé alors que, si ça se trouve, il n’aimait que le café."
                            },
                            {
                                "example_id": "bfeab833-c314-4e6f-bd39-51b4442ae8d0",
                                "sense_id": "f5e3da26-86ef-3e43-8c3f-cbec8a33c52c",
                                "text": "Les lobbies ont « marionnettisé » la plupart des députés, et totalement les « responsables » européens."
                            },
                            {
                                "example_id": "1770bdcb-8fb3-45bf-be6d-e092ad403558",
                                "sense_id": "f5e3da26-86ef-3e43-8c3f-cbec8a33c52c",
                                "text": "Puis, pour mieux éclairer leur propos, ils vont jouer, mimer, musiquer, marionnettiser les plus fameuses scènes du drame passionnel."
                            }
                        ]
                    }
                ],
