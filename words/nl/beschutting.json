            "pos": "noun",
            "senses": [
                {
                    "sense_id": "500da01c-bceb-31bd-a492-4710675cdc13",
                    "sense_definition": "De toestand van beschermd zijn tegen weersomstandigheden of gevaar.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bescherming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de hevige storm zochten de wandelaars snel <w>beschutting</w> in een nabijgelegen grot.",
                            "target_lang_translations": {
                                "en": "During the heavy storm, the hikers quickly sought <w>shelter</w> in a nearby cave."
                            }
                        },
                        {
                            "text": "De dichte bomen boden de nodige <w>beschutting</w> tegen de wind voor de kampeerders.",
                            "target_lang_translations": {
                                "en": "The dense trees provided the necessary <w>protection</w> from the wind for the campers."
                            }
                        }
                    ],
                    "synonyms": [
                        "bescherming",
                        "dekking",
                        "veiligheid"
                    ],
                    "antonyms": [
                        "blootstelling"
                    ],
                    "common_phrases": [
                        "beschutting zoeken",
                        "beschutting bieden tegen"
                    ],
                    "target_lang_definitions": {
                        "en": "The state of being protected from weather conditions or danger."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shelter",
                                "target_lang_sense_clarification": "the state of being protected or shielded"
                            },
                            {
                                "target_lang_word": "protection",
                                "target_lang_sense_clarification": "the state of being safe from harm or weather"
                            },
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "protection from weather or gunfire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec198c85-d040-355a-b82e-bdffbd756e20",
                    "sense_definition": "Een fysieke plek of object dat dient als bescherming tegen elementen zoals wind en regen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bescherming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was op de kale bergtop geen enkele <w>beschutting</w> te vinden tegen de felle zon.",
                            "target_lang_translations": {
                                "en": "There was no <w>shelter</w> at all to be found on the bare mountaintop against the bright sun."
                            }
                        },
                        {
                            "text": "Het kleine houten hutje diende als een tijdelijke <w>beschutting</w> voor de boswachter.",
                            "target_lang_translations": {
                                "en": "The small wooden hut served as a temporary <w>shelter</w> for the forest ranger."
                            }
                        }
                    ],
                    "synonyms": [
                        "schuilplaats",
                        "onderdak"
                    ],
                    "common_phrases": [
                        "enige beschutting",
                        "natuurlijke beschutting"
                    ],
                    "target_lang_definitions": {
                        "en": "A physical place or object that serves as protection against elements such as wind and rain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shelter",
                                "target_lang_sense_clarification": "a physical structure or place providing protection"
                            },
                            {
                                "target_lang_word": "refuge",
                                "target_lang_sense_clarification": "a place providing safety or shelter"
                            },
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "something that provides physical protection"
                            }
                        ]
