                                    {
                                        "sense_id": "c58c98e6-ee0b-36c1-8888-05291996e204",
                                        "entry_id": "56082bdb-d5dc-3767-a041-740d8975dd13",
                                        "glosses": [
                                            "Autorin eines kurzen, regelmäßig erscheinenden, journalistischen Beitrags in einer Zeitung oder einer Zeitschrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5c64ab8-6a66-4022-a655-dc917b566e34",
                                                "sense_id": "c58c98e6-ee0b-36c1-8888-05291996e204",
                                                "text": "Die Kolumnistin der überregionalen Zeitung genießt in der Öffentlichkeit hohes Ansehen."
                                            },
                                            {
                                                "example_id": "12791e1f-1a44-4800-a62d-7ee98cb5bf71",
                                                "sense_id": "c58c98e6-ee0b-36c1-8888-05291996e204",
                                                "text": "„Für eine Wahlperiode saß sie sogar für die Fortschrittspartei im Parlament, und lange war sie Kolumnistin im Zweiten Programm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a51e598-3531-4b45-8c7d-e14bf22c179c",
