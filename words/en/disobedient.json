{
    "word_family": [
        "disobedience",
        "disobediently",
        "disobey",
        "obedient"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5f3e7d7-427d-3f78-9c63-3a897ce8ad4e",
                    "sense_definition": "Refusing or failing to obey rules, authority, or commands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>disobedient</w> child refused to go to bed when his parents asked.",
                            "target_lang_translations": {
                                "de": "Das <w>ungehorsame</w> Kind weigerte sich ins Bett zu gehen, als seine Eltern es darum baten."
                            }
                        },
                        {
                            "text": "She took her <w>disobedient</w> dog to training classes to improve its behavior.",
                            "target_lang_translations": {
                                "de": "Sie brachte ihren <w>ungehorsamen</w> Hund zur Hundeschule, um sein Verhalten zu verbessern."
                            }
                        }
                    ],
                    "synonyms": [
                        "defiant"
                    ],
                    "antonyms": [
                        "obedient"
                    ],
                    "common_phrases": [
                        "disobedient child",
                        "disobedient behavior"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht bereit oder fähig, Regeln, Autoritäten oder Anweisungen zu befolgen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ungehorsam",
                                "target_lang_sense_clarification": "allgemein, bezogen auf Personen oder Tiere"
                            },
                            {
                                "target_lang_word": "aufsässig",
                                "target_lang_sense_clarification": "störrisch, sich rebellisch widersetzend"
                            },
                            {
                                "target_lang_word": "folgsam",
                                "target_lang_sense_clarification": "im verneinten Sinn (nicht folgsam)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3489df9e-23e0-3d01-b18a-0b400ff7727c",
                    "sense_definition": "A person who refuses to obey rules, laws, or authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police arrested several civil <w>disobedients</w> during the peaceful protest.",
                            "target_lang_translations": {
                                "de": "Die Polizei verhaftete während des friedlichen Protests mehrere zivile <w>Ungehorsame</w>."
                            }
                        },
                        {
                            "text": "The government refused to grant amnesty to the political <w>disobedients</w>.",
                            "target_lang_translations": {
                                "de": "Die Regierung weigerte sich, den politischen <w>Aufsässigen</w> eine Amnestie zu gewähren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "civil disobedients"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die sich weigert, Regeln, Gesetzen oder Autoritäten zu gehorchen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ungehorsame",
                                "target_lang_sense_clarification": "substantiviertes Adjektiv für eine ungehorsame Person"
                            },
                            {
                                "target_lang_word": "Aufsässige",
                                "target_lang_sense_clarification": "Person, die sich widersetzt oder rebelliert"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}