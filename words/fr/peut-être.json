            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4756cc3f-2cdb-39f3-8df6-d09c8fe8c4a2",
                    "sense_definition": "D'une manière possible mais sans certitude ; exprime le doute ou l'éventualité.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "probabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Est-ce que tu veux venir avec moi demain au cinéma ? <w>Peut-être</w>."
                        },
                        {
                            "text": "Il est en retard ce matin, il a <w>peut-être</w> raté son bus habituel."
                        }
                    ],
                    "synonyms": [
                        "possiblement",
                        "ça se peut"
                    ],
                    "common_phrases": [
                        "peut-être bien",
                        "peut-être que"
                    ]
                },
                {
                    "sense_id": "4ff9297f-f433-319d-b4e8-ef9bf94995cf",
                    "sense_definition": "S'emploie pour concéder un fait avant d'introduire une objection ou une restriction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as <w>peut-être</w> raison sur ce point, mais la décision finale m'appartient."
                        },
                        {
                            "text": "Ce livre est <w>peut-être</w> captivant, mais il demande beaucoup trop de temps."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b74d7508-7113-3ac3-a3a5-3b4426734920",
                    "sense_definition": "Chose incertaine, supposition ou éventualité sur laquelle on hésite à compter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incertitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ne peut pas fonder un projet d'une telle importance sur un simple <w>peut-être</w>."
                        },
                        {
                            "text": "Il n'y a pas de <w>peut-être</w> qui tienne, nous devons régler cette affaire aujourd'hui."
                        }
                    ],
                    "common_phrases": [
                        "le grand peut-être"
                    ]
                },
                {
                    "sense_id": "ddcc6af7-5ffb-3567-86d1-84539850d0ea",
                    "sense_definition": "Personne ou situation dont le devenir ou la réussite demeure incertain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incertitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune musicien a du talent, mais ce n'est encore qu'un brillant <w>peut-être</w>."
                        },
                        {
                            "text": "L'avenir de cette jeune entreprise reste pour l'instant un fragile <w>peut-être</w>."
                        }
                    ]
                }
            ]
        }
