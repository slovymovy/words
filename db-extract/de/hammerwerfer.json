                "senses": [
                    {
                        "sense_id": "7c82ce64-f550-3913-9c9d-1844e514acb7",
                        "entry_id": "e534c995-02df-3017-8fc7-e7fdf71f2526",
                        "glosses": [
                            "Person, die das Hammerwerfen ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "858f5787-3e43-4d45-b55f-c69a36066a82",
                                "sense_id": "7c82ce64-f550-3913-9c9d-1844e514acb7",
                                "text": "„2016 machten wieder mehr als 200 Sportler mit, unter ihnen Kugelstösser, Hammerwerfer, Sprinter.“"
                            },
                            {
                                "example_id": "7aa38a21-36ac-46ab-bd14-c5ca9db910c6",
                                "sense_id": "7c82ce64-f550-3913-9c9d-1844e514acb7",
                                "text": "„Ebenfalls zum 44-köpfigen Aufgebot in London gehören der Münchner Hammerwerfer Johannes Bichler und der Hochspringer Tobias Potye - diese beiden aber waren in Erding am Start: Potye gewann locker mit 2,21 Meter, die er wie alle vorherigen Höhen im jeweils ersten Versuch überwand - sein Trainingspartner Lucas Mihota wurde wenige Tage vor seinem Einsatz bei der U20-WM in Tampere Zweiter mit 2,14 Meter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
