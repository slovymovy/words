                        ],
                        "form": "die Wieden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "351e6411-ada1-3909-bb8f-a210270a74a9",
                        "entry_id": "c92150d4-7e38-3b83-b907-2ad2f8b770c2",
                        "glosses": [
                            "vierter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0deeb07-4031-41ab-a860-5b18f091ffc0",
                                "sense_id": "351e6411-ada1-3909-bb8f-a210270a74a9",
                                "text": "Aus der Wieden heraus entwickelten sich der heutige 5. (Margareten) und 10. (Favoriten) Bezirk."
                            },
                            {
                                "example_id": "b6b6de83-d467-4d32-81b2-5da3535d7af6",
                                "sense_id": "351e6411-ada1-3909-bb8f-a210270a74a9",
                                "text": "Man sieht schon: Wieden neigt zum Wechsel. Vielleicht hat dieser Hang zum Changieren mit der Lage zu tun: Wieden ist nämlich ein Auto-, Öffi-, Radfahrer- und Fußgängerbezirk."
                            },
                            {
                                "example_id": "7ba8c041-3d20-4210-b2dc-52fb72ba97ff",
                                "sense_id": "351e6411-ada1-3909-bb8f-a210270a74a9",
                                "text": "1876 erhielt Strauss die Baugenehmigung für ein Wohnhaus im Bezirk Wieden, Igelgasse 4/6, was Strauss im Haus 4 für sich und seine Familie selbst nutzte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "51e6d01c-f380-33f7-a9ab-91ecaad0dc22",
                        "entry_id": "c92150d4-7e38-3b83-b907-2ad2f8b770c2",
                        "glosses": [
                            "ehemaliger Vorort, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d7a2ce-e9d2-4ed4-8e4a-e826bf752256",
                                "sense_id": "51e6d01c-f380-33f7-a9ab-91ecaad0dc22",
                                "text": "Die Wieden wurde 1137 erstmals genannt, sie ist damit eine der am frühesten genannten Vorstädte Wiens."
                            },
                            {
                                "example_id": "bd751fb7-c188-4ef6-bdf5-48829104a152",
                                "sense_id": "51e6d01c-f380-33f7-a9ab-91ecaad0dc22",
                                "text": "Die Anfänge der Wieden gehen zurück bis zum Beginn des 13. Jahrhunderts."
                            },
                            {
                                "example_id": "e42e0d64-b2be-429f-8207-1832c79501dc",
                                "sense_id": "51e6d01c-f380-33f7-a9ab-91ecaad0dc22",
                                "text": "Die ursprüngliche Siedlung der Wieden erstreckte sich am Wienfluss entlang bis zum heutigen Karlsplatz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
