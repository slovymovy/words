                                        "glosses": [
                                            "That cracks; that produces a sharp sound as of something splitting or breaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abdacaed-8785-41a1-9700-2c9b8bd0a5c5",
                                                "sense_id": "79efd351-9b88-3055-94cc-d8db7e6ee4f8",
                                                "text": "From the spot where the body lay came a fierce fizzing and cracking sound, which ceased, however, before the fumes had cleared away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36af0b2a-fe4b-3d0e-b509-2e04c802cebd",
                                        "entry_id": "36056048-1baa-3c44-a67a-76fc59bb7986",
                                        "glosses": [
                                            "Great; excellent."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "696edd8f-0c42-4a49-bf34-03d4ea1e0575",
                                                "sense_id": "36af0b2a-fe4b-3d0e-b509-2e04c802cebd",
                                                "text": "Near-synonym: crackerjack"
                                            },
                                            {
                                                "example_id": "fd7d924b-8c9d-4f3d-b72a-6f58145a7901",
                                                "sense_id": "36af0b2a-fe4b-3d0e-b509-2e04c802cebd",
                                                "text": "The race started at a cracking pace."
                                            },
                                            {
                                                "example_id": "10b906ef-bd4d-4ec9-8dea-f4a7e7c6c7ca",
                                                "sense_id": "36af0b2a-fe4b-3d0e-b509-2e04c802cebd",
                                                "text": "That's a cracking example of what we've been looking for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a649e88f-93e9-33a7-bd0b-43fbeecc3b9d",
                                        "entry_id": "36056048-1baa-3c44-a67a-76fc59bb7986",
                                        "glosses": [
                                            "Enjoyable."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74314030-3e2b-4570-ad7d-9d5b29a93ec9",
                                                "sense_id": "a649e88f-93e9-33a7-bd0b-43fbeecc3b9d",
                                                "text": "We had a cracking time."
                                            },
                                            {
                                                "example_id": "84cc7aec-687b-4d59-9b7c-c1a4a5d4af2b",
                                                "sense_id": "a649e88f-93e9-33a7-bd0b-43fbeecc3b9d",
                                                "text": "Near the back of the concourse is a piano, [...]. Explains Reeve: \"It was donated by a lady who had written to me. My Duty Manager at the time had a qualification and so was able to restore it to full working order. I've heard some cracking tunes on it.\""
                                            }
                                        ]
                                    }
                                ]
