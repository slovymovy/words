                "senses": [
                    {
                        "sense_id": "823a92a0-f228-3975-be9e-1b5f7b847a56",
                        "entry_id": "57f02f4e-ace3-311b-9235-497d8b4f1c61",
                        "glosses": [
                            "Order (Befehl), die eine vorher ergangene Order ersetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ce7705d-029b-405a-8c35-626b0db94167",
                                "sense_id": "823a92a0-f228-3975-be9e-1b5f7b847a56",
                                "text": "In den frühen Morgenstunden erging der Gegenbefehl zum Stehenbleiben des Regiments."
                            },
                            {
                                "example_id": "115cc953-3c69-405d-953f-f7e08dcde6e6",
                                "sense_id": "823a92a0-f228-3975-be9e-1b5f7b847a56",
                                "text": "„Diese Anordnungen kamen jedoch nur unvollständig zur Durchführung, wurden überdies noch durch Gegenbefehle mehrfach geändert.“"
                            },
                            {
                                "example_id": "591c5509-2f7d-4d8c-be98-03f210c4653d",
                                "sense_id": "823a92a0-f228-3975-be9e-1b5f7b847a56",
                                "text": "„Ein Maschinengewehr blieb vor dem Tor, weil der Gegenbefehl nicht gekommen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
