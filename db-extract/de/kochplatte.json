                ],
                "senses": [
                    {
                        "sense_id": "711a97dc-4ae8-38a2-bf12-009e2a553d51",
                        "entry_id": "82f5f348-c7e1-3992-a3de-bb1d9960553d",
                        "glosses": [
                            "einzelne, meist runde Platte als Bestandteil eines Kochherds, auf der ein Topf, eine Pfanne oder Ähnliches beim Kochen erhitzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f5ee009-662d-4200-a68f-34bdb34b0fca",
                                "sense_id": "711a97dc-4ae8-38a2-bf12-009e2a553d51",
                                "text": "„In den rund zehn Quadratmeter großen Zimmern blüht der Schimmel unter den Tapeten. Ein kleiner Herd mit zwei Kochplatten im fensterlosen Flur stellt die Küche dar.“"
                            },
                            {
                                "example_id": "0bb465c9-920b-425a-b7c3-bd9270b08d5d",
                                "sense_id": "711a97dc-4ae8-38a2-bf12-009e2a553d51",
                                "text": "„Elektrische Kochplatten waren ohnedies Mangelware auf dem schwarzen Markt.“"
                            },
                            {
                                "example_id": "f7c9b525-bb93-49e5-b703-bc945df1b9c5",
                                "sense_id": "711a97dc-4ae8-38a2-bf12-009e2a553d51",
                                "text": "„Die Küche war so groß wie eine Besenkammer und verfügte über genau zwei Kochplatten, dazu kam noch ein Bad mit Toilette für alle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3321d9d7-20f5-3d18-a418-bbed7bef242f",
                        "entry_id": "82f5f348-c7e1-3992-a3de-bb1d9960553d",
                        "glosses": [
                            "kleines, tragbares Gerät mit (zumindest) einer elektrisch beheizbaren Platte zum Kochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1660ad46-ffc3-425a-b456-fff1096aa381",
                                "sense_id": "3321d9d7-20f5-3d18-a418-bbed7bef242f",
                                "text": "„Um das Zentralgebäude mit Restaurant, Aufenthalts- und Fernsehraum, Hallenbad und Sauna gruppieren sich rund 40 Bungalows, von denen die meisten vier Schlafplätze haben, einige Wohnungen sind größer. Einziger Nachteil: Es gibt keine Kochgelegenheit. Wer also weder Tauchsieder noch Kochplatte im Reisegepäck hatte, der konnte in seinen vier Wänden nicht einmal. Tee zubereiten oder einen Grog brauen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3db73078-a6a3-4873-882e-ef4f835cb7f7",
                        "source_entry_id": "82f5f348-c7e1-3992-a3de-bb1d9960553d",
                        "source_sense_id": "711a97dc-4ae8-38a2-bf12-009e2a553d51",
