                                    },
                                    {
                                        "sense_id": "6f5cc122-c9ae-39fe-a617-a8cf556c45da",
                                        "entry_id": "0123d144-4608-3c3d-aa0f-23c0860ca86c",
                                        "glosses": [
                                            "An instance of sarging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b696acb-9dcd-4f8e-a5b3-e91e11d6774e",
                                                "sense_id": "6f5cc122-c9ae-39fe-a617-a8cf556c45da",
                                                "text": "I did not interpret this advice correctly at first and in the same sarge as the hand-slap Juggler observed that she was really into me and liking my game but a little annoyed that I kept encroaching on her by moving myself closer to her while keeping myself square."
                                            },
                                            {
                                                "example_id": "9f7616c3-ca69-47bb-a6d8-4320bc42c701",
                                                "sense_id": "6f5cc122-c9ae-39fe-a617-a8cf556c45da",
                                                "text": "I thought it would be funny and depressing to join them on what they call the \"Saturday Sarge.\" A sarge is when a group of morons roam around looking for girls to annoy. Sounds gr8 right?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sarge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "970a393b-920c-3023-a339-5aee4b7fb7ed",
                                        "entry_id": "1303bbd5-5408-3204-91f9-718c7018635f",
                                        "glosses": [
                                            "To go out and engage women in order to pick them up."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff78a4c-f547-4b9d-9511-42f7df83c499",
                                                "sense_id": "970a393b-920c-3023-a339-5aee4b7fb7ed",
                                                "text": "Sure, the echoes of PUA raise concerns and I have no doubt Saturday Sarge has its fair share of men just wanting to pick up women for sex (Phil says in the four years he's sarged he's only slept with about 10 – the same amount another sarger says he's slept with in the last six months)."
                                            }
                                        ]
                                    }
                                ]
