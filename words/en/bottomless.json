                        {
                            "text": "Her eyes held a <w>bottomless</w> sorrow that nobody could begin to comprehend.",
                            "target_lang_translations": {
                                "es": "Sus ojos albergaban una tristeza <w>insondable</w> que nadie podía llegar a comprender."
                            }
