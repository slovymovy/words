                "translations": [
                    {
                        "translation_id": "bc06a854-723b-450b-9c74-56c30020c2b9",
                        "source_entry_id": "88a60e3c-8763-3e20-91b4-20d52754f2d1",
                        "source_sense_id": "e2951a32-c0ce-3122-80ab-2458a8b00a90",
                        "target_lang_word": "hinduistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinduistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fccb7083-b978-306f-bb83-094db7fa92a2",
                                        "entry_id": "b411671d-bdbb-3c7f-bbb7-2ec2202b756e",
                                        "glosses": [
                                            "den Hinduismus betreffend, zum Hinduismus gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1785a561-286d-468f-b7d0-f13e35792e01",
                                                "sense_id": "fccb7083-b978-306f-bb83-094db7fa92a2",
                                                "text": "Der Hinduismus besteht, genau besehen, aus drei Hindu-Religionen und vier Formen hinduistischer Religiosität, die in allen Hindu-Religionen vorkommen können."
                                            },
                                            {
                                                "example_id": "5d83b823-8d5e-4d93-9974-1c712d86ff93",
                                                "sense_id": "fccb7083-b978-306f-bb83-094db7fa92a2",
                                                "text": "Der Philosoph und Publizist Vanamali Gunturu hat eine ebenso profunde wie originelle Einführung in die hinduistische Religion und ihr für christliche Überzeugungen „unmoralisches“ Verhältnis zur Sexualität vorgelegt."
                                            },
                                            {
                                                "example_id": "c1c7e2fc-89b5-4d43-93f5-4ffd5c2d3520",
                                                "sense_id": "fccb7083-b978-306f-bb83-094db7fa92a2",
                                                "text": "Sie [Arundhati Roy] wirft dem mehrheitlich hinduistisch geprägten Land vor, einen Religionskrieg gegen die muslimische Minderheit zu führen."
                                            },
                                            {
                                                "example_id": "aca4c4c3-7a1e-4d18-8ddb-8f8db4590d57",
                                                "sense_id": "fccb7083-b978-306f-bb83-094db7fa92a2",
                                                "text": "In Uttar Pradesh, wo mehr als 200 Millionen Menschen leben, hatte Modis hinduistisch-nationalistische Bharatiya-Janata-Partei (BJP) die Parlamentswahl 2014 klar gewonnen."
                                            },
                                            {
                                                "example_id": "a64b3a5f-464b-4d23-9aa4-4f61dbb823e8",
                                                "sense_id": "fccb7083-b978-306f-bb83-094db7fa92a2",
                                                "text": "Der Tempel ist ein hinduistisches Heiligtum, so wie ganz Bali überwiegend hinduistisch geprägt ist, während die überwiegende Mehrheit der Indonesier Muslime sind."
                                            },
                                            {
                                                "example_id": "72b1063b-c87e-4db3-9388-00e3f0771cfc",
                                                "sense_id": "fccb7083-b978-306f-bb83-094db7fa92a2",
                                                "text": "„Unter seinem Sohn Mahmud von Ghazni (998–1030) erreichte das Ghaznavidenreich seine größte Entfaltung. Diesem gelang es, den westlichen Punjab, den bis dahin die hinduistischen Shahis beherrscht hatten, seinem Reich einzuverleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
