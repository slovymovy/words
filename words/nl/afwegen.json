{
    "word_family": [
        "weging",
        "gewicht",
        "overwegen",
        "weegschaal"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "758dac70-bddc-34cb-a658-443e4733bb93",
                    "sense_definition": "het belang of de waarde van verschillende zaken zorgvuldig met elkaar vergelijken om een beslissing te nemen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "overweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de voor- en nadelen goed tegen elkaar <w>afwegen</w> voordat je een keuze maakt.",
                            "target_lang_translations": {
                                "en": "You must <w>weigh up</w> the pros and cons carefully before making a choice."
                            }
                        },
                        {
                            "text": "De directie zal alle verschillende belangen zorgvuldig <w>afwegen</w> in dit dossier.",
                            "target_lang_translations": {
                                "en": "The management will carefully <w>balance</w> all the different interests in this file."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwegen",
                        "beoordelen",
                        "vergelijken"
                    ],
                    "common_phrases": [
                        "voor- en nadelen afwegen",
                        "belangen afwegen",
                        "zorgvuldig afwegen"
                    ],
                    "target_lang_definitions": {
                        "en": "To carefully compare the importance or value of different things in order to make a decision."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weigh up",
                                "target_lang_sense_clarification": "to consider pros and cons"
                            },
                            {
                                "target_lang_word": "balance",
                                "target_lang_sense_clarification": "to compare different interests or factors"
                            },
                            {
                                "target_lang_word": "weigh",
                                "target_lang_sense_clarification": "to evaluate options"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092d12d1-8de7-3b78-a2cb-06a995ffbc0b",
                    "sense_definition": "met een weegschaal bepalen hoeveel iets weegt of een specifieke hoeveelheid van iets nemen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je voor mij honderd gram suiker <w>afwegen</w> voor het recept?",
                            "target_lang_translations": {
                                "en": "Can you <w>weigh out</w> one hundred grams of sugar for me for the recipe?"
                            }
                        },
                        {
                            "text": "In het laboratorium moet de assistent de stoffen heel nauwkeurig <w>afwegen</w>.",
                            "target_lang_translations": {
                                "en": "In the laboratory, the assistant must <w>weigh</w> the substances very accurately."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegen",
                        "afmeten"
                    ],
                    "common_phrases": [
                        "hoeveelheid afwegen",
                        "nauwkeurig afwegen"
                    ],
                    "target_lang_definitions": {
                        "en": "To determine the weight of something using a scale or to measure out a specific quantity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weigh out",
                                "target_lang_sense_clarification": "to measure a specific amount of a substance"
                            },
                            {
                                "target_lang_word": "weigh",
                                "target_lang_sense_clarification": "to measure weight using a scale"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}