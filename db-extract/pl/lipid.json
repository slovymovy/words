                                "target_senses": [
                                    {
                                        "sense_id": "3530d681-609f-3b1d-93fe-fe64589363f3",
                                        "entry_id": "a009e404-ee7c-3deb-959b-326cf3417527",
                                        "glosses": [
                                            "wasserunlöslicher Naturstoff; Fett oder fettähnliche Substanz"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5afaef75-1b26-44df-8e31-314bac30d9d1",
                                                "sense_id": "3530d681-609f-3b1d-93fe-fe64589363f3",
                                                "text": "„Fette sind nur eine Art von Lipiden, eine Kategorie von Molekülen, die ihre Unfähigkeit, sich gut mit Wasser zu vermischen, gemeinsam haben. Lipide sind meist hydrophob, unpolar und bestehen überwiegend aus Kohlenwasserstoffketten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
