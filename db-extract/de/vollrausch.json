                "senses": [
                    {
                        "sense_id": "72bf5733-3fbc-3cef-9b66-e401e8df22c2",
                        "entry_id": "86bffbc6-e246-3c68-99de-63f5bc494d97",
                        "glosses": [
                            "drunken stupor"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "9d100d61-4b4a-4d15-8df9-9646980fe452",
                                "sense_id": "72bf5733-3fbc-3cef-9b66-e401e8df22c2",
                                "text": "Alkoholiker konnten nach der früheren Gesetzgebung oft damit rechnen, dass ihre Taten, im Vollrausch begangen, einen milden Richter fanden."
                            },
                            {
                                "example_id": "23223341-5eb2-4c62-8d1d-676db5fc3dc9",
                                "sense_id": "72bf5733-3fbc-3cef-9b66-e401e8df22c2",
                                "text": "Wann ist endlich wieder Zeit für 'n Vollrausch? / Wann kommt der Filmriss? / Wo bleibt der Rollentausch?"
                            }
                        ]
                    }
                ],
