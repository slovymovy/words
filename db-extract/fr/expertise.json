                                            {
                                                "example_id": "24fae36b-24b0-41ed-b6f0-0bb0498cb8e1",
                                                "sense_id": "4c3bf681-02b9-3ad6-bdc3-0fbb3fec95fb",
                                                "text": "\"Mas somente após a perícia poderemos dar mais detalhes\", afirmou Santoro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a19c51-6122-3e37-8232-fd15651097dc",
                                        "entry_id": "deb6f63f-4663-380b-bb54-5b7a1a63a8da",
