                ],
                "senses": [
                    {
                        "sense_id": "fc38a45c-2670-30a0-8a25-357d5193b071",
                        "entry_id": "2e427883-d4fd-3b9f-bc19-bbe94c70fef1",
                        "glosses": [
                            "ловкий, хитрый приём, применяемый с целью достичь чего-либо или уклониться от чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4db4494d-8f51-40f7-bc78-c991b27a7dae",
                        "source_entry_id": "2e427883-d4fd-3b9f-bc19-bbe94c70fef1",
                        "source_sense_id": "fc38a45c-2670-30a0-8a25-357d5193b071",
                        "target_lang_word": "ruse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                        "entry_id": "d8c0d0ed-9787-3b69-bf73-4d4deb3eaa85",
                                        "glosses": [
                                            "Procédé ingénieux utilisé pour avoir le dessus sur un ennemi, échapper à un prédateur ou abuser une victime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d2796b-333e-41be-a2df-f38e918bb4dc",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "La férocité ancienne tend à être remplacée par la ruse et beaucoup de sociologues estiment que c'est là un progrès sérieux ; quelques philosophes qui n'ont pas l'habi­tude de suivre les opinions du troupeau, ne voient pas très bien en quoi cela constitue le progrès au point de vue de la morale."
                                            },
                                            {
                                                "example_id": "af52836a-883e-4f1a-aff7-cfe86d903987",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "Privé de tout accommodement, de ses fards, de ses sourires et de ses ruses, le vice a peu de chance de séduire la vertu la plus chancelante."
                                            },
                                            {
                                                "example_id": "6e25bce4-2e5b-47c9-8228-2242314aef2c",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "Toutes les ruses, il les imagine et les déploie avec un machiavélisme qui parfois lui pèse."
                                            },
                                            {
                                                "example_id": "2bf46d98-b180-42aa-90c6-309dd3930f9d",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "Ruses innocentes : Petites finesses que l’on emploie sans mauvaise intention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                        "entry_id": "d8c0d0ed-9787-3b69-bf73-4d4deb3eaa85",
                                        "glosses": [
                                            "Talent qu’a une personne à tromper autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2ecd84-a738-492b-9c56-37200da43b7a",
                                                "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                                "text": "Ce brigand était plus célèbre pour sa ruse que pour son courage."
                                            },
                                            {
                                                "example_id": "a9e41714-6446-4fed-bb57-56735247437e",
                                                "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                                "text": "Il est plein de ruse et de malice."
                                            },
                                            {
                                                "example_id": "3a5c6844-fc22-4335-98fc-82e73ab8ac29",
                                                "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                                "text": "Il a de la ruse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839c190a-c337-3618-9181-77ccd7a7eb80",
                                        "entry_id": "d8c0d0ed-9787-3b69-bf73-4d4deb3eaa85",
                                        "glosses": [
                                            "Les détours dont le lièvre, le cerf, le renard, etc., se servent quand on les chasse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ruse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7df2bca1-3e3b-3d40-ac66-fdacd266d097",
