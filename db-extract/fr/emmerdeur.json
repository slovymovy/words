                        "form": "emmerdeurs"
                    },
                    {
                        "form_id": "23e0b3a8-b814-4e7a-bc94-70ea11267469",
                        "entry_id": "462ffc2f-87cf-3345-875c-3396785a7e13",
                        "tags": [
                            "feminine"
                        ],
                        "form": "emmerdeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                        "entry_id": "462ffc2f-87cf-3345-875c-3396785a7e13",
                        "glosses": [
                            "Personne emmerdante, c'est-à-dire qui importune, qui ennuie, qui énerve les autres."
                        ],
                        "tags": [
                            "colloquial",
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "650c5e5a-0777-404b-8fc8-426d4de7a62b",
                                "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                                "text": "Dire qu’il suffit de mettre un gigot au feu pour voir s’amener les emmerdeurs !"
                            },
                            {
                                "example_id": "18c42f23-f4a5-48ce-ad9c-4fbd0855eb0c",
                                "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                                "text": "Au retour des dernières épreuves avant BAT, j'ai vu qu'elle avait encore rétabli des pétouilles que j'avais pourtant annulées lors des premières navettes, mais j'ai quand même donné mon imprimatur pour ne pas passer pour un emmerdeur […]."
                            },
                            {
                                "example_id": "fa367989-6413-4c42-9019-a123e97fa168",
                                "sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                                "text": "Tu n'es qu'un chichiteux, lui dit sa mère, un emmerdeur, précisent les autres membres de sa famille et ses amis, une foutue buse, déplore sa compagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3b96ee9-9826-49c3-94fc-128ac455ba68",
                        "source_entry_id": "462ffc2f-87cf-3345-875c-3396785a7e13",
                        "source_sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
                        "target_lang_word": "Langweiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langweiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce38233-f519-30cb-a65b-c0a16f8b3827",
                                        "entry_id": "8065b2cf-195b-3024-86f5-efef84790f63",
                                        "glosses": [
                                            "Person, die für andere Leute langweilig ist, die andere langweilt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32aeafe9-521e-42b7-bedd-53ef441ae004",
                                                "sense_id": "5ce38233-f519-30cb-a65b-c0a16f8b3827",
                                                "text": "Mensch, ist das ein Langweiler, jetzt labert er schon seit Stunden davon, wie er stundenlang belanglose Artikel in ein Online-Wörterbuch-Projekt stellt."
                                            },
                                            {
                                                "example_id": "61af4ebb-4775-4df6-94c3-8f81a6a659bb",
                                                "sense_id": "5ce38233-f519-30cb-a65b-c0a16f8b3827",
                                                "text": "Du bist vielleicht ein Langweiler, anstatt mal etwas Neues zu probieren, stecken wir wie gehabt zusammen."
                                            },
                                            {
                                                "example_id": "c9fdaefb-93ee-4c49-8c99-333f1ee9b268",
                                                "sense_id": "5ce38233-f519-30cb-a65b-c0a16f8b3827",
                                                "text": "„Einige von ihnen befinden sich auf dem besten Weg, zu Langweilern zu mutieren, auch dieses Schicksal teilen sie mit vielen Männern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3051b26f-430b-374d-9c6a-ff379d4e8f0a",
                                        "entry_id": "8065b2cf-195b-3024-86f5-efef84790f63",
                                        "glosses": [
                                            "Person, die durch ihre Langsamkeit oder Unentschlossenheit andere Leute ungeduldig macht"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80fddf6f-b8df-4a48-9dab-f98e7329a7ac",
                                                "sense_id": "3051b26f-430b-374d-9c6a-ff379d4e8f0a",
                                                "text": "Der Zentralstürmer, dieser Langweiler, versucht es nur mit Fernschüssen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcd0bc55-fb57-4a17-9050-1806b0757704",
                        "source_entry_id": "462ffc2f-87cf-3345-875c-3396785a7e13",
                        "source_sense_id": "f1f94107-470c-3c7a-b6fb-69080d5633ad",
