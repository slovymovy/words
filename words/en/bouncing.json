{
    "word_family": [
        "bounce",
        "bouncy",
        "bouncer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e971b264-e9ea-3357-a29e-d3105fa88003",
                    "sense_definition": "Healthy and full of energy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple was delighted to welcome a <w>bouncing</w> baby girl into their family.",
                            "target_lang_translations": {
                                "ru": "Пара была счастлива приветствовать в своей семье <w>здоровую</w> малышку.",
                                "nl": "Het stel was verheugd om een <w>gezonde</w> baby-dochter in hun familie te verwelkomen."
                            }
                        },
                        {
                            "text": "After a difficult labour, she gave birth to a healthy, <w>bouncing</w> baby boy.",
                            "target_lang_translations": {
                                "ru": "После трудных родов она родила крепкого, <w>здорового</w> мальчика.",
                                "nl": "Na een zware bevalling schonk ze het leven aan een gezonde, <w>levendige</w> baby-jongen."
                            }
                        }
                    ],
                    "synonyms": [
                        "vigorous",
                        "healthy",
                        "robust"
                    ],
                    "antonyms": [
                        "frail",
                        "weak"
                    ],
                    "common_phrases": [
                        "bouncing baby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здоровый, энергичный, полный сил",
                        "nl": "Gezond en vol energie"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здоровый",
                                "target_lang_sense_clarification": "о ребенке, полном сил"
                            },
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "о человеке, полном жизненной силы"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gezond",
                                "target_lang_sense_clarification": "vaak gebruikt in de uitdrukking 'een gezonde baby'"
                            },
                            {
                                "target_lang_word": "levendig",
                                "target_lang_sense_clarification": "vol energie en levenslust"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4819ba1a-1f26-3143-9409-8c2a98072ef5",
                    "sense_definition": "Unusually large or impressive in size",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a <w>bouncing</w> bonus after the company had a record-breaking year.",
                            "target_lang_translations": {
                                "ru": "Он получил <w>огромный</w> бонус после того, как компания показала рекордные результаты за год.",
                                "nl": "Hij ontving een <w>enorme</w> bonus nadat het bedrijf een recordjaar had gedraaid."
                            }
                        },
                        {
                            "text": "The bill for the repairs was a <w>bouncing</w> sum that we had not expected.",
                            "target_lang_translations": {
                                "ru": "Счет за ремонт оказался <w>внушительной</w> суммой, которую мы не ожидали.",
                                "nl": "De rekening voor de reparaties was een <w>aanzienlijk</w> bedrag dat we niet hadden verwacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "whopping",
                        "enormous",
                        "huge"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is increasingly rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычайно большой или внушительный по размеру",
                        "nl": "Ongewoon groot of indrukwekkend van omvang"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "о сумме или размере чего-либо"
                            },
                            {
                                "target_lang_word": "внушительный",
                                "target_lang_sense_clarification": "о размере платежа или бонуса"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "enorm",
                                "target_lang_sense_clarification": "zeer groot in omvang of bedrag"
                            },
                            {
                                "target_lang_word": "aanzienlijk",
                                "target_lang_sense_clarification": "indrukwekkend of substantieel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebd6c84e-d690-34f0-a274-16d4824ebebe",
                    "sense_definition": "The act of moving up and down or rebounding",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>bouncing</w> of the ball against the wall became very annoying.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>отскакивание</w> мяча от стены стало очень раздражать.",
                                "nl": "Het constante <w>stuiteren</w> van de bal tegen de muur werd erg irritant."
                            }
                        },
                        {
                            "text": "The <w>bouncing</w> of the car on the rough road made everyone feel quite sick.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>подпрыгивания</w> машины на неровной дороге всех начало укачивать.",
                                "nl": "Het <w>op en neer gaan</w> van de auto op de hobbelige weg maakte iedereen behoorlijk misselijk."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebounding",
                        "springing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс движения вверх-вниз или отскакивания",
                        "nl": "De handeling van het op en neer bewegen of terugkaatsen"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпрыгивание",
                                "target_lang_sense_clarification": "движение вверх-вниз"
                            },
                            {
                                "target_lang_word": "отскакивание",
                                "target_lang_sense_clarification": "рикошет или отскок предмета"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "stuiteren",
                                "target_lang_sense_clarification": "het herhaaldelijk op en neer gaan van een voorwerp"
                            },
                            {
                                "target_lang_word": "op en neer gaan",
                                "target_lang_sense_clarification": "het proces van opwaartse en neerwaartse beweging"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d861c37d-31c2-3e03-8099-5f433823aecd",
                    "sense_definition": "Present participle and gerund of <w>bounce</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children are <w>bouncing</w> on the trampoline in the backyard.",
                            "target_lang_translations": {
                                "ru": "Дети <w>подпрыгивают</w> на батуте на заднем дворе.",
                                "nl": "De kinderen zijn aan het <w>stuiteren</w> op de trampoline in de achtertuin."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>bouncing</w> ideas off her colleagues to find a solution.",
                            "target_lang_translations": {
                                "ru": "Она провела день, <w>обсуждая</w> идеи с коллегами, чтобы найти решение.",
                                "nl": "Ze bracht de middag door met het <w>aftoetsen van</w> ideeën bij haar collega's om een oplossing te vinden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bouncing around"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle and gerund form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «подпрыгивать» или «отскакивать»",
                        "nl": "Tegenwoordig deelwoord en gerundium van 'stuiteren' of 'op en neer springen'"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпрыгивающий",
                                "target_lang_sense_clarification": "причастие, описывающее движение"
                            },
                            {
                                "target_lang_word": "отскакивающий",
                                "target_lang_sense_clarification": "причастие, описывающее отскок"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "stuiterend",
                                "target_lang_sense_clarification": "het proces van het maken van een stuiterende beweging"
                            },
                            {
                                "target_lang_word": "op en neer springend",
                                "target_lang_sense_clarification": "het actief springen op een oppervlak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}