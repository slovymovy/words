                    {
                        "sense_id": "4d601af5-8f0c-3377-ba2b-52bb7b601bd7",
                        "entry_id": "f912ed7a-24d2-3376-9630-4da9ef47ad54",
                        "glosses": [
                            "thingy, widget, gizmo (unspecified object)"
                        ],
                        "tags": [
                            "colloquial",
                            "inanimate",
                            "masculine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5511157f-ebc9-3eec-80a7-6223a8422c78",
                        "entry_id": "f912ed7a-24d2-3376-9630-4da9ef47ad54",
                        "glosses": [
                            "loot (stolen item)"
                        ],
                        "tags": [
                            "especially",
                            "in-plural",
                            "inanimate",
                            "masculine",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b8a77f43-c4b8-4a68-b674-23f4e65a3f1a",
                                "sense_id": "5511157f-ebc9-3eec-80a7-6223a8422c78",
                                "text": "Złodzieje w przypadku zagrożenia lub raczej przedstawiciele „proletariatu złodziejskiego” chronili się jak włóczędzy w licznych jeszcze wtedy ruinach pałaców. Tam też odnajdywano niekiedy skradzione „fanty”.",
                                "translation": "Thieves, in case of emergency, or rather representatives of the \"thieves' proletariat\" protected themselves like vagabons in the numerous ruins of the castle. Sometimes one could also find there stolen \"loot\".",
                                "english": "Thieves, in case of emergency, or rather representatives of the \"thieves' proletariat\" protected themselves like vagabons in the numerous ruins of the castle. Sometimes one could also find there stolen \"loot\"."
                            },
                            {
                                "example_id": "7cc51853-b82f-4ea2-b29b-03bcc7f94bb0",
                                "sense_id": "5511157f-ebc9-3eec-80a7-6223a8422c78",
                                "text": "Skradziony fant miał trafić w jego ręce i to była szansa, żeby przyłapać go wreszcie na gorącym uczynku.",
                                "translation": "The stolen loot was supposed to end up in his hands there was a chance to catch him im the act.",
                                "english": "The stolen loot was supposed to end up in his hands there was a chance to catch him im the act."
                            },
                            {
                                "example_id": "b7072d91-12b5-4266-ab8c-7d618fcbae4f",
                                "sense_id": "5511157f-ebc9-3eec-80a7-6223a8422c78",
                                "text": "Dwa celne ciosy wystarczyły, żeby złodziej, obok juchy, puścił też farbę. Po fanty komisarz musiał się jednak pofatygować nieco dalej.",
                                "translation": "Two successful hits were enough to spill more than blood; the thief spilt the beans. As for the loot, the commissioner had to stretch his legs a bit in order to retrieve them.",
                                "english": "Two successful hits were enough to spill more than blood; the thief spilt the beans. As for the loot, the commissioner had to stretch his legs a bit in order to retrieve them."
                            }
                        ]
                    }
                ],
