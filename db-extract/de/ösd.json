                        "glosses": [
                            "Österreichisches Sprachdiplom Deutsch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f131e17-41c5-46bc-82cf-5bf830a02647",
                                "sense_id": "300191ac-68d8-329b-a8d2-a3db40e8a98c",
                                "text": "Die Prüfungen des ÖSD entsprechen internationalen Rahmenrichtlinien und sind als Nachweis von Deutschkenntnissen bekannt und von internationaler Bedeutung."
                            },
                            {
                                "example_id": "20a49d89-ba52-4a94-bc2f-bdcb693cea82",
                                "sense_id": "300191ac-68d8-329b-a8d2-a3db40e8a98c",
                                "text": "Die VHS Wien ist ein anerkanntes Prüfungszentrum für das Österreichische Sprachdiplom (ÖSD)."
                            },
                            {
                                "example_id": "bb175a4b-055f-4b25-bbb9-92fa2ab71b17",
                                "sense_id": "300191ac-68d8-329b-a8d2-a3db40e8a98c",
                                "text": "Das Österreichische Sprachdiplom Deutsch (ÖSD) ist für Migranten der erste wichtige Schritt zur Integration in die Gesellschaft und weltweit anerkannt."
                            },
                            {
                                "example_id": "8cb8b6fd-a2db-4e2d-9f15-243fd3f621fd",
                                "sense_id": "300191ac-68d8-329b-a8d2-a3db40e8a98c",
                                "text": "\"Es kommt immer wieder vor, dass Personen, die ein gewisses ÖSD-Niveau bereits absolviert haben, wieder in einem Kurs der selben Stufe landen\", so ein Trainer."
                            },
                            {
                                "example_id": "19f4bf3a-8fab-42fc-bf97-18359e88c98d",
                                "sense_id": "300191ac-68d8-329b-a8d2-a3db40e8a98c",
                                "text": "Das heißt, wo immer Sie Ihre Deutschkenntnisse nachweisen wollen, an österreichischen oder internationalen Universitäten, gegenüber einem Arbeitgeber in Österreich, Deutschland oder anderswo, bei Behörden eines beliebigen deutschsprachigen Landes: Ihr ÖSD-Diplom hilft Ihnen immer."
                            }
                        ],
                        "sense_index_json": "\"1\""
