                "senses": [
                    {
                        "sense_id": "ae40caae-8735-323a-a77d-1617774daeeb",
                        "entry_id": "b760bca6-91bd-39e5-b50a-b944d9e991a5",
                        "glosses": [
                            "hypothetische nordamerikanische Währung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6cf2c3-2da7-4b28-8b34-4554dbc7233a",
                                "sense_id": "ae40caae-8735-323a-a77d-1617774daeeb",
                                "text": "„Im November 2007 habe ich zum ersten Mal einen Artikel in »The Boston Globe« mit dem Titel »The amero conspiracy« (Die Amero—Verschwörung) gelesen.“"
                            },
                            {
                                "example_id": "895c185c-a352-42b3-94c2-f6bb16ab9e7d",
                                "sense_id": "ae40caae-8735-323a-a77d-1617774daeeb",
                                "text": "„Dennoch erfahren der Begriff Amero und die ihm zugrunde liegende Verschwörungstheorie in den USA ein gewisses Medienecho, zuletzt nachdem durch Wikileaks ein Bericht der amerikanischen Vertretung in Ottawa aus dem Jahr 2005 veröffentlicht wurde in dem weitere Integrationsschritte bis hin zur Währungsunion diskutiert werden.“"
                            },
                            {
                                "example_id": "2c6ca7fc-0a39-4e1e-9db4-a875e484f7ae",
                                "sense_id": "ae40caae-8735-323a-a77d-1617774daeeb",
                                "text": "„Der Amero ist seit Jahren immer wieder als neue, kommende Weltleitwährung im Gespräch. Er soll eine Gemeinschaftswährung der USA, Mexiko und Kanada darstellen, welche wohl als Edelmetallwährung konzipiert wurde und für den Fall eines heftigen Dollarcrash genau diesen ablösen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7ac06b0-ef52-4f7a-8117-987571ed3c73",
                        "source_entry_id": "b760bca6-91bd-39e5-b50a-b944d9e991a5",
                        "source_sense_id": "ae40caae-8735-323a-a77d-1617774daeeb",
                        "source_sense_description": "hypothetische nordamerikanische Währung",
                        "target_lang_word": "amero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "505cfb23-1a01-35a4-86ed-e88d15fa9302",
                                        "entry_id": "aa543f4e-181b-3ac7-8af2-88de49567be5",
                                        "glosses": [
                                            "A proposed unified currency of Canada, the United States, and Mexico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02bc75f7-c58f-4fcd-9138-bb5de0546f61",
                                                "sense_id": "505cfb23-1a01-35a4-86ed-e88d15fa9302",
                                                "text": "The amero notes and coins will have in common abstract designs on one side. Notes and coins will be produced in each of the three countries […]"
                                            },
                                            {
                                                "example_id": "9bc317f0-f565-42b1-9ab5-c78b6d4ea10b",
                                                "sense_id": "505cfb23-1a01-35a4-86ed-e88d15fa9302",
                                                "text": "From the US point of view, the key benefit of the amero model - reduced transactions costs - would be fully duplicated by the dollarization alternative."
                                            },
                                            {
                                                "example_id": "28d1ce94-e0cf-4d9e-ab7b-8e8b1100dbe0",
                                                "sense_id": "505cfb23-1a01-35a4-86ed-e88d15fa9302",
                                                "text": "The Amero would increase the GDP of the US by only roughly 15%."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
