                ],
                "senses": [
                    {
                        "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                        "entry_id": "8fe67f7b-fa2b-34e2-87d1-078b4718bf97",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf700035-dbd2-4d60-98d9-48131d118a84",
                                "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                                "text": "Frau Stadtmüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5330fd49-11d5-4c0d-9c13-d0b1782714ab",
                                "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                                "text": "Herr Stadtmüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b2bdfb4e-49c2-4e1e-ade6-ccafaa306ad0",
                                "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                                "text": "Die Stadtmüllers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "aa95b9b6-7882-43a1-b5d3-2fbea19bedfa",
                                "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                                "text": "Der Stadtmüller trägt nie die Schals, die die Stadtmüller ihm strickt."
                            },
                            {
                                "example_id": "79a2c9be-491e-491e-8ff2-8860b46dc96b",
                                "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stadtmüller kommt, geht der Herr Stadtmüller.“"
                            },
                            {
                                "example_id": "67f51aac-8397-41d6-8d2f-d45bf9a23e91",
                                "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                                "text": "Stadtmüller kommt und geht."
                            },
                            {
                                "example_id": "be118e45-4363-42db-8a6c-ca75932222f9",
                                "sense_id": "eefb1726-05f1-3a66-a703-bd97ea47b7df",
                                "text": "Stadtmüllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
