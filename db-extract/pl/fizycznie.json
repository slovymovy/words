                "translations": [
                    {
                        "translation_id": "e5af74fc-234d-4705-8778-77efe0318f43",
                        "source_entry_id": "854263ca-5036-39f8-b9be-3b42d096488d",
                        "source_sense_id": "e8c7b19a-d2e2-37e2-a9eb-aeae3e340c5b",
                        "target_lang_word": "materially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "materially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6f31e1-773e-364b-9961-e3cd2f4a5cbe",
                                        "entry_id": "5b7e4da0-3070-356f-8624-e4a6737c3103",
                                        "glosses": [
                                            "In a material manner; with regard to physical things or characteristics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2aa36a-041f-406c-8e63-79d53fe5c38b",
                                                "sense_id": "5f6f31e1-773e-364b-9961-e3cd2f4a5cbe",
                                                "text": "Tobacco, for instance, shrinks materially by frequent reshippings, and as all goods are warehoused as a convenience to importers, duties should be paid on what the importer receives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89cb145f-b2c0-3211-b544-9c033e039a6a",
                                        "entry_id": "5b7e4da0-3070-356f-8624-e4a6737c3103",
                                        "glosses": [
                                            "To a significant degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2ffed1-cbdf-4585-a283-f5a9cf7df8ee",
                                                "sense_id": "89cb145f-b2c0-3211-b544-9c033e039a6a",
                                                "text": "In cases of extreme thickening of the coats of the stomach, of a scirrhoid character, where the suffering patients are almost worn out with constant pain, such remedies, applied over the epigastrium, most materially alleviate the distress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dba90c6-6865-49a3-9271-629f34e45063",
                        "source_entry_id": "854263ca-5036-39f8-b9be-3b42d096488d",
                        "source_sense_id": "e8c7b19a-d2e2-37e2-a9eb-aeae3e340c5b",
                        "target_lang_word": "tangibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tangibly",
