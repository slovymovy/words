                "senses": [
                    {
                        "sense_id": "239799fb-7c61-3325-b7bf-45daad328731",
                        "entry_id": "30300c5b-fbd2-326d-a4e1-6a0e637db385",
                        "glosses": [
                            "Zunge eines Rindes"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "07153338-c344-434e-a8cf-ff6732d655da",
                                "sense_id": "239799fb-7c61-3325-b7bf-45daad328731",
                                "text": "„Auch die Rindszunge wird geräuchert und getrocknet gern gegessen.“"
                            },
                            {
                                "example_id": "ea070ead-5879-4022-8990-4d88c55ef694",
                                "sense_id": "239799fb-7c61-3325-b7bf-45daad328731",
                                "text": "„Die Rindszunge wird, wenn man sie nicht frisch verspeisen will, mit Salz und Salpeter eingerieben.“"
                            },
                            {
                                "example_id": "03415b25-33aa-4fe2-9b9a-e85c6bed2691",
                                "sense_id": "239799fb-7c61-3325-b7bf-45daad328731",
                                "text": "„Zu jedem Festtag muss ich Ihnen die absonderlichsten Dinge besorgen, skandinavische Dorscheier oder Hammelmägen, Rindszungen, Kuheuter oder Schweinsköpfe in Aspik.“"
                            },
                            {
                                "example_id": "f7a9e6ca-d705-4180-b796-0bd839c2af7e",
                                "sense_id": "239799fb-7c61-3325-b7bf-45daad328731",
                                "text": "„Sie brachten uns auch noch Rindszungen und Schinken herauf, wir aßen aber nicht mehr davon, weil wir an dem andern schon genug hatten […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
