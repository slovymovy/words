                        "source_entry_id": "1f1f660b-c668-3f4d-99d9-43cf0b444934",
                        "source_sense_id": "583e1c52-3908-3576-a634-9b3c51a51a92",
                        "target_lang_word": "villainous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "villainous",
