                ],
                "senses": [
                    {
                        "sense_id": "10e6d7a7-f089-341f-91c9-408f4b4f223d",
                        "entry_id": "53996367-45bc-3026-baad-c8fd3ac58991",
                        "glosses": [
                            "беспощадная, ненасытная сила, требующая беспрестанных человеческих жертв"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95daa1b-a294-4e47-b4c0-28979fc57029",
                                "sense_id": "10e6d7a7-f089-341f-91c9-408f4b4f223d",
                                "text": "Критическая масса наработанного людьми зла приводит в действие молох войн и революций, и он катком проходится по странам и народам, пока не увязает в кровавом месиве…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e0a7f11-18cf-44d8-b8ee-c2b3748be5b6",
                        "source_entry_id": "53996367-45bc-3026-baad-c8fd3ac58991",
                        "source_sense_id": "10e6d7a7-f089-341f-91c9-408f4b4f223d",
                        "target_lang_word": "Moloch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moloch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fa9ad3c-5499-3cb8-8b80-ef7ccb30489f",
                                        "entry_id": "6113520f-60f9-3bf7-b4ae-0b3249db2aee",
                                        "glosses": [
                                            "An ancient Ammonite deity worshiped by the Canaanites, Phoenician and related cultures in North Africa and the Levant, often depicted with the head of a bull."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70eef460-c8a6-3cda-b8e2-fc5b4a455455",
                                        "entry_id": "6113520f-60f9-3bf7-b4ae-0b3249db2aee",
                                        "glosses": [
                                            "A person or thing demanding or requiring a very costly sacrifice."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a04ad9bd-bb3c-4149-93e8-674857d21148",
                                                "sense_id": "70eef460-c8a6-3cda-b8e2-fc5b4a455455",
                                                "text": "[W]e can't without wonder remember that horrid Invention projected in this place, but thanks be to God diſappointed, wherein there was not Reverence to the ſacred Bones of Princes, but all were at one blaſt to be offer'd up to Moloch."
                                            },
                                            {
                                                "example_id": "3d9b3438-b48b-4866-9c22-708c593fa882",
                                                "sense_id": "70eef460-c8a6-3cda-b8e2-fc5b4a455455",
                                                "text": "They [bankers] would do what has been done by the Bank of France—buy bullion at a premium, on the approach of danger, and keep peril at a safe and respectable distance. Any expenditure that might be incurred for that purpose would be small indeed when contrasted with the immense loss and suffering caused by the present system, and the continual fear in which the public now live of some new crisis—because it has been out of one and into another for a long period now; and that will be the case hereafter, until we have no interval to gather strength, and recruit for the next struggle with Mammon, or Moloch, or whatever other name of evil import belongs to the \"Tutelarity\" of Lombard-street and its precincts."
                                            },
                                            {
                                                "example_id": "d154b681-43f4-42a1-8910-b629eac466e0",
                                                "sense_id": "70eef460-c8a6-3cda-b8e2-fc5b4a455455",
                                                "text": "[…] poor Johnny Tetterby staggering under his Moloch of an infant, the Juggernaut that crushes all his enjoyments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e709ebf-bddb-4191-95e9-ee2f3756c9a5",
                        "source_entry_id": "53996367-45bc-3026-baad-c8fd3ac58991",
                        "source_sense_id": "10e6d7a7-f089-341f-91c9-408f4b4f223d",
                        "target_lang_word": "moloc",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8f14afc6-9759-4ad1-bc30-229f9610ee4f",
                        "source_entry_id": "53996367-45bc-3026-baad-c8fd3ac58991",
                        "source_sense_id": "10e6d7a7-f089-341f-91c9-408f4b4f223d",
                        "target_lang_word": "Moloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moloch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f13b7f49-541d-30ee-b78b-6fa3fbc0c9c4",
                                        "entry_id": "819944eb-2d44-3f3b-9b99-53cec816db35",
                                        "glosses": [
                                            "phönizisch-kanaanäische Opferriten, bei denen nach biblischer Überlieferung Kinder durch Feuer geopfert wurden bzw. der Name des auf diese Weise zu opfernden Wesens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385fb356-a866-4f91-9dca-7c1485363a1e",
                                                "sense_id": "f13b7f49-541d-30ee-b78b-6fa3fbc0c9c4",
                                                "text": "„Sag zu den Israeliten: Jeder Mann unter den Israeliten oder unter den Fremden in Israel, der eines seiner Kinder dem Moloch gibt, wird mit dem Tod bestraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d80062ca-01a7-3a85-b8b9-c3d1cd7175b2",
                                        "entry_id": "819944eb-2d44-3f3b-9b99-53cec816db35",
                                        "glosses": [
                                            "etwas, das ständig und unerbittlich Opfer fordert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f40b719a-e63a-4742-8ed1-d5a3d1092fe0",
                                                "sense_id": "d80062ca-01a7-3a85-b8b9-c3d1cd7175b2",
                                                "text": "Der Moloch Großstadt frisst sich in die blühenden Landschaften."
                                            },
                                            {
                                                "example_id": "07cce4fb-7b24-4c25-bb6f-530f5869a929",
                                                "sense_id": "d80062ca-01a7-3a85-b8b9-c3d1cd7175b2",
                                                "text": "„Über Nacht wurde ich aus der Vertrautheit des Dorfes in die Anonymität des Molochs entlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
