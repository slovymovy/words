                        "examples": [
                            {
                                "example_id": "5a08ddec-1e22-45fb-83bc-078e1486f7c5",
                                "sense_id": "aac29eae-89ed-3684-abde-cf7e91a25470",
                                "text": "Kitzbühel ist einer der bedeutendsten Wintersportorte Österreichs."
                            },
                            {
                                "example_id": "579a3062-4ff1-4030-8e6e-0d3b9e163152",
                                "sense_id": "aac29eae-89ed-3684-abde-cf7e91a25470",
                                "text": "„Kitzbühel war schon vor dem ersten Weltkrieg der bedeutendste Wintersportort Tirols.“"
                            },
                            {
                                "example_id": "26cdd2f3-7010-4b8a-b88a-5aea370d0371",
                                "sense_id": "aac29eae-89ed-3684-abde-cf7e91a25470",
                                "text": "„Thomas Dreßen sorgt in Kitzbühel für die Topsensation und holt sich den Abfahrtssieg.“"
                            }
