            {
                "entry_id": "b8904e64-59a0-3cf1-8039-92510ba3a1cd",
                "word": "mahjong",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5fe2d05-82bf-3636-902e-3a8c719b83db",
                        "entry_id": "b8904e64-59a0-3cf1-8039-92510ba3a1cd",
                        "glosses": [
                            "A game (originally Chinese) for four players, using a collection of tiles divided into five or six suits."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "21ae1f3a-7d33-4124-a976-b26286e83a02",
                                "sense_id": "a5fe2d05-82bf-3636-902e-3a8c719b83db",
                                "text": "My usual mahjong kaki."
                            },
                            {
                                "example_id": "0a98867f-d550-4c60-b7de-79cf20da84a3",
                                "sense_id": "a5fe2d05-82bf-3636-902e-3a8c719b83db",
                                "text": "While most of the country has spent the weekend counting hongbaos and mahjong tiles, those guys have been out there salvaging hongbaos and half of Thomson Road."
                            },
                            {
                                "example_id": "73626a85-6022-46d9-8c98-295d3e25d083",
                                "sense_id": "a5fe2d05-82bf-3636-902e-3a8c719b83db",
                                "text": "Ho Sau-Mei, one of Hong Kong’s last mahjong tile carvers, is getting old."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c2c313c-b856-36a7-843e-8d615a48829f",
                        "entry_id": "b8904e64-59a0-3cf1-8039-92510ba3a1cd",
                        "glosses": [
                            "A solitaire game using the same tiles, where the player wins by removing pairs of matching exposed tiles until none remain."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b991abe8-7b41-4cb2-ba63-e8fde439d210",
                        "source_entry_id": "b8904e64-59a0-3cf1-8039-92510ba3a1cd",
                        "source_sense_description": "game for four players",
                        "target_lang_word": "mahjong",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mahjong",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "81fcc035-ae7c-3c2b-b57d-229161e74332",
                                        "entry_id": "af2f75b9-87a2-32fd-94b2-422b78d3de6f",
                                        "glosses": [
                                            "Chinees spel voor 4 personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6a0e59-c064-473f-bc49-dd39c0153509",
                                                "sense_id": "81fcc035-ae7c-3c2b-b57d-229161e74332",
                                                "text": "Heerlijk, stijlvol parkje met veel bankjes, midden in Chinatown. Leent zich prima voor het nuttigen van een lunch uit een zakje, gezeten tussen de mahjongspelers. Een echte buurttuin. Mulberry St., metro Canal St."
                                            },
                                            {
                                                "example_id": "43b990a4-fc37-4815-80ea-9310f14b63eb",
                                                "sense_id": "81fcc035-ae7c-3c2b-b57d-229161e74332",
                                                "text": "Sinds de jaren negentig zijn de drie games onlosmakelijk verbonden met Windows. Tegenwoordig zitten Patience, Mahjong en Mijnenveger niet meer in Windows 8, maar zijn ze via de Windows Store te downloaden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1f86ff7-c136-47f4-8341-eb37a9d72b55",
