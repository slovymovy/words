    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d4a9615-4533-381c-804e-c8e534db5d92",
                    "sense_definition": "present participle and gerund of <w>bulge</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His pockets were <w>bulging</w> with all the coins he had collected.",
                            "target_lang_translations": {
                                "ru": "Его карманы <w>оттопыривались</w> от всех собранных им монет.",
                                "cs": "Jeho kapsy byly <w>vyboulené</w> všemi mincemi, které nasbíral."
                            }
                        },
                        {
                            "text": "She stared at him with her eyes <w>bulging</w> in surprise.",
                            "target_lang_translations": {
                                "ru": "Она уставилась на него с <w>выпученными</w> от удивления глазами.",
                                "cs": "Zírala na něj s očima <w>vypoulenýma</w> úžasem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bulging pockets",
                        "bulging eyes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола bulge (выпячиваться, раздуваться, топорщиться)",
                        "cs": "přítomné příčestí a gerundium slovesa bulge (vyboulený, vypouklý, vyčnívající)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпячивающийся",
                                "target_lang_sense_clarification": "о глазах или карманах"
                            },
                            {
                                "target_lang_word": "раздувающийся",
                                "target_lang_sense_clarification": "о наполненных вещах"
                            },
                            {
                                "target_lang_word": "выпученный",
                                "target_lang_sense_clarification": "о глазах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyboulený",
                                "target_lang_sense_clarification": "o věcech, které jsou naplněné a vypínají se"
                            },
                            {
                                "target_lang_word": "vypoulený",
                                "target_lang_sense_clarification": "o očích"
                            },
                            {
                                "target_lang_word": "vyčnívající",
                                "target_lang_sense_clarification": "o něčem, co vystupuje z povrchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "feab8e6e-0005-3b94-af40-548af2a86735",
                    "sense_definition": "The shape or motion of something that bulges; a swelling or protruding part.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Watt saw the little movements of the stuff, the little <w>bulgings</w> and crumplings, and the sudden indrawings.",
                            "target_lang_translations": {
                                "ru": "Ватт видел легкие движения материала, небольшие <w>выпячивания</w> и смятия, а также внезапные втягивания.",
                                "cs": "Watt viděl drobné pohyby té látky, malé <w>vybouleniny</w> a zmačkání a náhlá vtažení."
                            }
                        },
                        {
                            "text": "It was noticed that there had been saggings and <w>bulgings</w> in the trays.",
                            "target_lang_translations": {
                                "ru": "Было замечено, что в лотках появились провисания и <w>вздутия</w>.",
                                "cs": "Bylo zaznamenáno, že se na tácech objevila prohnutí a <w>vybouleniny</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swellings",
                        "protrusions",
                        "bulges"
                    ],
                    "antonyms": [
                        "depressions",
                        "indentations"
                    ],
                    "common_phrases": [
                        "saggings and bulgings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма или движение чего-то, что выпячивается; набухание, выпуклость или выступающая часть",
                        "cs": "tvar nebo pohyb něčeho, co se vybouluje; vyboulenina, vypouklina nebo vystupující část"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпуклость",
                                "target_lang_sense_clarification": "выступающая часть"
                            },
                            {
                                "target_lang_word": "выпячивание",
                                "target_lang_sense_clarification": "процесс или результат деформации"
                            },
                            {
                                "target_lang_word": "вздутие",
                                "target_lang_sense_clarification": "набухание поверхности"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyboulenina",
                                "target_lang_sense_clarification": "vystupující část na povrchu"
                            },
                            {
                                "target_lang_word": "vypouklina",
                                "target_lang_sense_clarification": "tvarová deformace směrem ven"
                            },
                            {
                                "target_lang_word": "vzedmutí",
                                "target_lang_sense_clarification": "proces nebo stav nabobtnání či vyboulení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
