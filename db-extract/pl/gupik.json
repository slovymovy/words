                                                "sense_id": "208347fc-0242-3199-9a11-29dc991303d5",
                                                "text": "Throw that one back; it’s just a guppy!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130c0b02-938b-3970-ac9b-af5d60502aef",
