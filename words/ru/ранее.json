{
    "word_family": [
        "рано",
        "ранний",
        "раньше"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1ce02e71-e088-38d0-8178-a7d8af09acb6",
                    "sense_definition": "Сравнительная степень наречия <w>рано</w>; в более раннее время.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом году зима наступила <w>ранее</w> обычного.",
                            "target_lang_translations": {
                                "en": "This year winter arrived <w>earlier</w> than usual.",
                                "zh": "今年冬天比往年<w>更早</w>到来。"
                            }
                        },
                        {
                            "text": "Мы должны выехать <w>ранее</w>, чтобы не опоздать на поезд.",
                            "target_lang_translations": {
                                "en": "We must leave <w>earlier</w> so as not to miss the train.",
                                "zh": "我们必须<w>提早</w>出发，以免错过火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прежде"
                    ],
                    "antonyms": [
                        "позже",
                        "позднее"
                    ],
                    "common_phrases": [
                        "не ранее чем"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree of рано"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adverb 'early'; at an earlier time.",
                        "zh": "副词“早”的比较级；在更早的时间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "earlier",
                                "target_lang_sense_clarification": "comparative"
                            },
                            {
                                "target_lang_word": "sooner",
                                "target_lang_sense_clarification": "time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更早",
                                "target_lang_sense_clarification": "时间上的比较"
                            },
                            {
                                "target_lang_word": "提早",
                                "target_lang_sense_clarification": "比预期时间早"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54c0eebe-dfc6-3f4d-8799-db7873ba1db6",
                    "sense_definition": "В прошлом, в предшествующее время; до настоящего момента.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Как мы упоминали <w>ранее</w>, этот вопрос требует особого внимания.",
                            "target_lang_translations": {
                                "en": "As we mentioned <w>earlier</w>, this issue requires special attention.",
                                "zh": "正如我们<w>先前</w>提到的，这个问题需要特别关注。"
                            }
                        },
                        {
                            "text": "<w>Ранее</w> в этом здании находилась городская библиотека.",
                            "target_lang_translations": {
                                "en": "<w>Previously</w> the city library was located in this building.",
                                "zh": "这座建筑<w>以前</w>是市图书馆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прежде",
                        "раньше"
                    ],
                    "antonyms": [
                        "позднее"
                    ],
                    "common_phrases": [
                        "как сказано ранее",
                        "гораздо ранее"
                    ],
                    "target_lang_definitions": {
                        "en": "In the past, in preceding time; before the present moment.",
                        "zh": "在过去，在之前的时间；在当前时刻之前。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "previously",
                                "target_lang_sense_clarification": "in the past"
                            },
                            {
                                "target_lang_word": "earlier",
                                "target_lang_sense_clarification": "before now"
                            },
                            {
                                "target_lang_word": "formerly",
                                "target_lang_sense_clarification": "past state"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先前",
                                "target_lang_sense_clarification": "在过去"
                            },
                            {
                                "target_lang_word": "以前",
                                "target_lang_sense_clarification": "在当前时刻之前"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "7fee649e-29ed-37b6-a8f8-557c7406763f",
                    "sense_definition": "До наступления определённого момента или срока.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не смогу освободиться <w>ранее</w> семи часов вечера.",
                            "target_lang_translations": {
                                "en": "I won't be free <w>before</w> seven o'clock in the evening.",
                                "zh": "我晚上七点<w>之前</w>没法空出来。"
                            }
                        },
                        {
                            "text": "Пожалуйста, не приходите <w>ранее</w> назначенного времени.",
                            "target_lang_translations": {
                                "en": "Please do not come <w>earlier than</w> the appointed time.",
                                "zh": "请不要在约定时间<w>之前</w>到达。"
                            }
                        }
                    ],
                    "synonyms": [
                        "до",
                        "прежде"
                    ],
                    "antonyms": [
                        "позже"
                    ],
                    "common_phrases": [
                        "ранее срока"
                    ],
                    "target_lang_definitions": {
                        "en": "Before the onset of a certain moment or deadline.",
                        "zh": "在某个特定时刻或期限到来之前。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "before",
                                "target_lang_sense_clarification": "preposition"
                            },
                            {
                                "target_lang_word": "earlier than",
                                "target_lang_sense_clarification": "phrase"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……之前",
                                "target_lang_sense_clarification": "介词，表示时间界限"
                            },
                            {
                                "target_lang_word": "不早于",
                                "target_lang_sense_clarification": "表示时间下限"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}