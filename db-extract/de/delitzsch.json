                        "examples": [
                            {
                                "example_id": "66fef806-0f6b-4430-8605-bfa59290b093",
                                "sense_id": "92697deb-41ed-3438-bc14-f8dc2c4e8ed9",
                                "text": "Delitzsch liegt in Deutschlands Osten."
                            },
                            {
                                "example_id": "ca3977ac-b1c1-4c55-9903-96890efec630",
                                "sense_id": "92697deb-41ed-3438-bc14-f8dc2c4e8ed9",
                                "text": "Ich bin in Delitzsch geboren."
                            },
                            {
                                "example_id": "f0bd4cf3-d2fb-4574-a2d6-bc1b52b4e171",
                                "sense_id": "92697deb-41ed-3438-bc14-f8dc2c4e8ed9",
                                "text": "Wir haben in Delitzsch unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "c8838051-2dfb-4f82-a3fe-f20e3c61a202",
                                "sense_id": "92697deb-41ed-3438-bc14-f8dc2c4e8ed9",
                                "text": "Nach Delitzsch führen viele Wege."
                            },
                            {
                                "example_id": "4f16ab55-a148-459f-88de-49eeb7dc1539",
                                "sense_id": "92697deb-41ed-3438-bc14-f8dc2c4e8ed9",
                                "text": "Delitzsch liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "e3900bb3-5b0c-4145-b499-429ab50f8e07",
                                "sense_id": "92697deb-41ed-3438-bc14-f8dc2c4e8ed9",
                                "text": "Das Delitzsch des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
