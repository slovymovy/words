                "senses": [
                    {
                        "sense_id": "1382c173-bd20-3f1f-8a0e-5ff1378c716b",
                        "entry_id": "1ddadb31-d598-3c61-9b97-82fb92215493",
                        "glosses": [
                            "wereldwijd schandaal toen bleek dat Volkswagen software in dieselauto's had ingebouwd die milieutesten manipuleerde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b01de7-2db8-4ed6-9081-d286370f1f13",
                                "sense_id": "1382c173-bd20-3f1f-8a0e-5ff1378c716b",
                                "text": "Na het schandaal met sjoemelsoftware in 2015, toen Volkswagen het grootste verlies ooit boekte, werd vorig jaar alweer een stijgende lijn ingezet. Over heel 2016 was de winst 7,1 miljard euro. Topman Müller noemt de kwartaalcijfers bemoedigend en zegt dat de strategie die na 'dieselgate' is ingevoerd zijn vruchten afwerpt."
                            },
                            {
                                "example_id": "d8b1d36b-6513-439b-b9c5-4a5ac3bc5d1b",
                                "sense_id": "1382c173-bd20-3f1f-8a0e-5ff1378c716b",
                                "text": "Toch noemt Europarlementariër Gerben-Jan Gerbrandy (D66) het een opvallend resultaat. Gerbrandy was lid van de speciale commissie die onderzoek deed naar dieselgate, zoals het schandaal rond Volkswagen in de wandeling wordt genoemd."
                            }
                        ]
                    }
