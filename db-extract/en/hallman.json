                        "glosses": [
                            "A person in charge of a hall or corridor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1479333-0f60-444a-bf49-e5c287fab2ce",
                                "sense_id": "59a04a6e-3076-3feb-9aac-9130d2204925",
                                "text": "A hallman, an officer having charge of halls, corridors and dormitories, was shown to have carried a strap and the night-watchman the same, and that they both used the instruments on the boys."
                            },
                            {
                                "example_id": "8c91aec2-6518-4515-a67b-c14eed341ad9",
                                "sense_id": "59a04a6e-3076-3feb-9aac-9130d2204925",
                                "text": "The little extras to be provided include three concierges, bonded maid service, a doorman, a hallman, elevator operators, 24-hour room service, and 24-hour dry cleaning — all for an additional fee, of course."
                            }
                        ]
                    }
