                ],
                "senses": [
                    {
                        "sense_id": "79d43e9c-3a19-3624-b3da-3831f532a25d",
                        "entry_id": "b81b0943-fdfe-3c2b-9081-2d0e4085cce1",
                        "glosses": [
                            "Personne qui complote, qui fait partie d'un complot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eff5313-558e-418c-9190-3d6f471c638f",
                                "sense_id": "79d43e9c-3a19-3624-b3da-3831f532a25d",
                                "text": "La lecture de son message ainsi que la présidence de séance échoient à un élu du groupe Le Pen, Édouard Frédéric-Dupont, le vieux comploteur du 6 février 1934. C'est l'occasion d'un coup médiatique qui n'a rien d'improvisé."
                            },
                            {
                                "example_id": "386794ec-a233-4b2c-ba1b-d9ae666c0c28",
                                "sense_id": "79d43e9c-3a19-3624-b3da-3831f532a25d",
                                "text": "Un mafieux, un assassin, un comploteur doit toujours craindre l’existence cachée d’un semblable prêt à le supplanter à la moindre occasion : c’est dans l'ordre des choses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d5610df-e5e5-4aa0-beac-14354f4d7174",
                        "source_entry_id": "b81b0943-fdfe-3c2b-9081-2d0e4085cce1",
                        "source_sense_id": "79d43e9c-3a19-3624-b3da-3831f532a25d",
                        "target_lang_word": "conspirator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspirator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8007bf-bce5-3094-9f18-bdfd70a883b6",
                                        "entry_id": "cc762a07-ffae-328f-96a2-23661315d63f",
                                        "glosses": [
                                            "One of a group that acts in harmony to do something unlawful and unethical; a person who is part of a conspiracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1287b6-fb9a-45f9-a484-2135f1475c8d",
                                                "sense_id": "dc8007bf-bce5-3094-9f18-bdfd70a883b6",
                                                "text": "The conspirators were rounded up by the police and arrested."
                                            },
                                            {
                                                "example_id": "cc5524f4-d998-47f2-8a1e-65992728c80d",
                                                "sense_id": "dc8007bf-bce5-3094-9f18-bdfd70a883b6",
                                                "text": "All the Jacobite gentry of that part of the country were collected together; though, it must be confessed, their appearance and their usual after-dinner conversation were rather at variance. Now they looked calm and comfortable, with as little the appearance of conspirators as possible; then they were (by their own account) the most oppressed of individuals, and the most devoted of partisans, ready to die, so that their wrongs were redressed, and the rightful king restored."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
