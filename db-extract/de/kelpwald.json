                ],
                "senses": [
                    {
                        "sense_id": "7f7d1492-3143-3928-a379-a59a0e6449e2",
                        "entry_id": "a66867f4-c7b1-3303-93ad-bcff8ea6340d",
                        "glosses": [
                            "Wald aus großem Seetang in den Uferzonen der Meere der gemäßigten Breite"
                        ],
                        "tags": [
                            "Meeresbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "38f54ca9-a03e-45bc-8a58-69819481fcd2",
                                "sense_id": "7f7d1492-3143-3928-a379-a59a0e6449e2",
                                "text": "„Komplexe Beziehungen verbinden die Organismen in und um den Kelpwald Seeigel […] ernähren sich etwa gefräßig von Kelpen.“"
                            },
                            {
                                "example_id": "c1121982-bb6c-4e91-a68d-f8a519c5706f",
                                "sense_id": "7f7d1492-3143-3928-a379-a59a0e6449e2",
                                "text": "„Ähnlich wie beim tropischen Regenwald können beim Kelpwald mehrere Stockwerke - und damit verschiedene Lebensräume - unterschieden werden: die Haftorgane auf dem Boden, die biegsamen Stängel und die blattähnlichen Wedel.“"
                            },
                            {
                                "example_id": "acf33ff0-4c5c-43ea-be6b-45a75671623b",
                                "sense_id": "7f7d1492-3143-3928-a379-a59a0e6449e2",
                                "text": "„Im meterhohen Kelpwald finden Fische reichlich Nahrung. Algen gelten als die „Weiden des Meeres\".“"
                            },
                            {
                                "example_id": "881e4e89-9b60-4470-baad-e91610165771",
                                "sense_id": "7f7d1492-3143-3928-a379-a59a0e6449e2",
                                "text": "Die Kelpwälder gelten als submarine Gegenstücke der Regenwälder, weil sie eine ähnlich große Artenvielfalt aufweisen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
