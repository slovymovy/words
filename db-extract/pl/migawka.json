                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                        "entry_id": "1720151f-8197-3513-bf06-d26e4c37d176",
                                        "glosses": [
                                            "Vorrichtung zum Zumachen, Sperrvorrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b88ab345-84d6-453b-868f-e3f72baff5c5",
                                                "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                                "text": "Der Verschluss klemmt, daher kann ich nicht öffnen."
                                            },
                                            {
                                                "example_id": "5ca63133-acd3-4cfb-af13-2d8e0ca11e02",
                                                "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                                "text": "„Kanther spielte mit dem Verschluss seiner Rindsledertasche.“"
                                            },
                                            {
                                                "example_id": "220b2882-51e6-40ac-9f85-a347cd151734",
                                                "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                                "text": "„Ich klinkte die Tür wieder ein, kam mir aber trotz des Verschlusses ein wenig bloßgestellt vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "689d5371-f0e2-3cf8-a1eb-9549bfeab8b0",
                                        "entry_id": "1720151f-8197-3513-bf06-d26e4c37d176",
                                        "glosses": [
                                            "die Handlung des Verschließens, Absperrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a71bd1e-4729-4514-8ed2-070748dbe282",
                                                "sense_id": "689d5371-f0e2-3cf8-a1eb-9549bfeab8b0",
                                                "text": "Der Verschluss aller Wertgegenstände ist sinnvoll."
                                            }
                                        ],
