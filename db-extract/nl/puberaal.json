                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b054c9c-142e-4daf-b033-e862bd56311f",
                        "source_entry_id": "e2b31937-8716-3494-94a4-98f0ebf158a4",
                        "source_sense_id": "23bae4ef-6e3f-3534-819f-c69a90f59d8f",
                        "source_sense_description": "behorende tot, zich voordoend bij pubers",
                        "target_lang_word": "adolescent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adolescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "012d053d-7229-32a8-b9f0-d5f38ada8159",
                                        "entry_id": "fec9bc46-655a-3ab9-8ec5-97ba68e5c584",
                                        "glosses": [
                                            "Of, relating to, or at the age of adolescence; at the stage between being a child and an adult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79d1cd8-1658-49f9-ae9c-b8a9b4ee0e02",
                                                "sense_id": "012d053d-7229-32a8-b9f0-d5f38ada8159",
                                                "text": "Schools, unless discipline were doubly strong, / Detain their adolescent charge too long."
                                            },
                                            {
                                                "example_id": "666a7113-1f90-4a3d-be87-964b74a09cb7",
                                                "sense_id": "012d053d-7229-32a8-b9f0-d5f38ada8159",
                                                "text": "Again, voice change is not easy and vulnerability plays a big part, but if choral teachers and adolescent singers approach it with the right mindframe, the experience can be empowering, enlightening, and restorative for all involved."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adolescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aab9c6c-53ab-3eb2-9af2-ad64d596dcdf",
                                        "entry_id": "dbd7e257-0eeb-3f05-8bf3-50928b4e1cff",
                                        "glosses": [
                                            "A person who is in adolescence; someone who has reached puberty but is not yet an adult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7d37ad-1944-4ff7-ad80-a5f32c2f45be",
                                                "sense_id": "8aab9c6c-53ab-3eb2-9af2-ad64d596dcdf",
                                                "text": "Besides, there are a great many of these accusers, and they have been accusing me now for a great many years; and what is more, they approached you at the most impressionable age, when some of you were children or adolescents; and they literally won their case by default, because there was no one to defend me."
                                            },
                                            {
                                                "example_id": "758ab590-903d-485d-8265-d2cd1292a850",
                                                "sense_id": "8aab9c6c-53ab-3eb2-9af2-ad64d596dcdf",
                                                "text": "‘A healthy adolescent might be expected to produce five hundred billion blood cells a day.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49ef79eb-e8b3-4398-9c22-04b217e3f3d6",
                        "source_entry_id": "e2b31937-8716-3494-94a4-98f0ebf158a4",
                        "source_sense_id": "23bae4ef-6e3f-3534-819f-c69a90f59d8f",
                        "source_sense_description": "behorende tot, zich voordoend bij pubers",
                        "target_lang_word": "juvenile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juvenile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f4e7500-2ed3-3194-ad94-a2d5504ad114",
                                        "entry_id": "30fe76e9-ca9f-3cf3-9fac-3beae2ccc53e",
                                        "glosses": [
                                            "Young; not fully developed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e084db-b08b-4d3b-82c9-a8bef8cf9801",
                                                "sense_id": "2f4e7500-2ed3-3194-ad94-a2d5504ad114",
                                                "text": "There are certain Climates, where the Mind ripens and attains ſooner to Perfection than in others: nay there are ſome Conſtitutions of Body, where the humours are ſo exactly mixt, that they form an admirable Temper; the Effects thereof are diſcoverable in the firſt Juvenile Years, and leave very fine Remains, even in a decrepit Age."
                                            },
                                            {
                                                "example_id": "2512475e-3ec0-4a2f-9cf6-3061d86fb28a",
                                                "sense_id": "2f4e7500-2ed3-3194-ad94-a2d5504ad114",
                                                "text": "We should then be able to count on the labours of fifty thousand juvenile home missionaries, and the next generation would be able to speak from a happier experience than we, of \"times of refreshing from the presence of the Lord.\"—From the Canada Sunday School Record."
                                            },
                                            {
                                                "example_id": "f867a97a-29f9-40ff-ad0d-336374565d06",
                                                "sense_id": "2f4e7500-2ed3-3194-ad94-a2d5504ad114",
                                                "text": "When juvenile offenders are spoken of, young thieves are usually intended; for an examination of the annals of crime will show that varied as are the offences of adults, those for which children are arraigned in a criminal court are almost invariably thefts more or less trivial; […]"
                                            },
                                            {
                                                "example_id": "1d21a7ae-ef80-449a-a01d-800b1ae9a1fd",
                                                "sense_id": "2f4e7500-2ed3-3194-ad94-a2d5504ad114",
                                                "text": "[T]he juvenile justice system became firmly established as the legitimate institution for responding to juvenile delinquency and misconduct during 1900 and 1960."
                                            },
                                            {
                                                "example_id": "c142fb29-da43-4b55-8aaa-6f20c5ecd738",
                                                "sense_id": "2f4e7500-2ed3-3194-ad94-a2d5504ad114",
                                                "text": "Juvenile rheumatoid arthritis (JRA), often referred to by doctors today as juvenile idiopathic arthritis (JIA), is a type of arthritis that causes joint inflammation and stiffness for more than six weeks in a child aged 16 or younger. It affects approximately 50,000 children in the United States. Inflammation causes redness, swelling, warmth, and soreness in the joints, although many children with JRA do not complain of joint pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b77861-f663-34f2-b35e-e93eb3fa4555",
                                        "entry_id": "30fe76e9-ca9f-3cf3-9fac-3beae2ccc53e",
                                        "glosses": [
                                            "Characteristic of youth or immaturity; childish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787db077-0f51-43c8-9edc-39305c562cf8",
                                                "sense_id": "52b77861-f663-34f2-b35e-e93eb3fa4555",
                                                "text": "Adde to this diſsipated and diſtracted ſtate of Miniſters, their private diſtreſſes and poverties, together with the publick neglect and indifferency of people toward them; who can wonder if they look pitifully one on another, which no jocoſe or juvenile drolings can relieve?"
                                            },
                                            {
                                                "example_id": "3809557c-557d-45c8-9605-49da1034e981",
                                                "sense_id": "52b77861-f663-34f2-b35e-e93eb3fa4555",
                                                "text": "This is illuſtrated by a variety of examples; particularly by the attachment which we naturally form to inanimate objects; and by the pleaſure derived from hiſtoric ſcenes, from painting, and from the review of juvenile days."
                                            },
                                            {
                                                "example_id": "5d3d983e-c227-4db3-ba6a-c186e20d221e",
                                                "sense_id": "52b77861-f663-34f2-b35e-e93eb3fa4555",
                                                "text": "Juvenile rheumatoid arthritis is a form of rheumatoid arthritis that affects children under the age of 16[…]. Juvenile rheumatoid arthritis impacts the larger joints of the body and is a chronic condition."
                                            },
                                            {
                                                "example_id": "bc360624-65e5-4983-a91f-6042265ccc8c",
                                                "sense_id": "52b77861-f663-34f2-b35e-e93eb3fa4555",
                                                "text": "He indicated that Cheong should follow his actions, but Cheong was little tempted and chose not to engage in such a juvenile scene."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "juvenile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d911f26-c432-3549-aecb-ba468ec55d53",
                                        "entry_id": "ac43a6a4-e06b-39ba-83a4-2f701c543d04",
                                        "glosses": [
                                            "A prepubescent child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38847fe4-f598-4ef7-ad19-149a6965db09",
                                                "sense_id": "9d911f26-c432-3549-aecb-ba468ec55d53",
                                                "text": "One patient, a pedophile with a long history of arrests, penal incarceration, psychiatric admissions, and outpatient psychotherapy, commented that in the past when he saw a juvenile male playing, he (the patient) would without hesitation approach the boy and make a sexual proposition. When he was on MPA [medroxyprogesterone acetate] therapy, he stated that, at worst, when he saw such a juvenile, he only smiled \"with appreciation\" for the boy's good looks and otherwise kept about his business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dc41741-b35a-3e91-8cd8-8a2caa812bc1",
                                        "entry_id": "ac43a6a4-e06b-39ba-83a4-2f701c543d04",
                                        "glosses": [
                                            "A person younger than the age of majority; a minor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d87d712-d0dc-4e4e-a07e-38878db1fab5",
                                                "sense_id": "7dc41741-b35a-3e91-8cd8-8a2caa812bc1",
                                                "text": "Every childhood seems to have exactly such a juvenile in its midst and mists. He's the boy who refuses to fear the opposite sex, purely because everyone else embraces that particular fear, and he's the type who is unafraid to make a decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51778202-60c1-32f6-89b3-a84ce3128b5e",
                                        "entry_id": "ac43a6a4-e06b-39ba-83a4-2f701c543d04",
                                        "glosses": [
                                            "A person younger than the age of full criminal responsibility, such that the person either cannot be held criminally liable or is subject to less severe forms of punishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df2bcc24-28d1-4231-8552-e0edf60c9e76",
                                                "sense_id": "51778202-60c1-32f6-89b3-a84ce3128b5e",
                                                "text": "If the juvenile violates the conditions of the stayed sentence, typically by committing a new offense, the court may revoke the stay and require that the offender be taken into custody. The juvenile is then given written notice of the reasons for the revocation of the stayed sentence, and may have a hearing with representation of legal counsel if the revocation is challenged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec200058-6235-37ec-9a8b-259ba5ad3f1a",
                                        "entry_id": "ac43a6a4-e06b-39ba-83a4-2f701c543d04",
                                        "glosses": [
                                            "A publication for young adult readers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd785b51-beaf-4b53-8729-78405f0635e7",
                                                "sense_id": "ec200058-6235-37ec-9a8b-259ba5ad3f1a",
                                                "text": "Formerly a publisher of juveniles, out of the market till 1959, when it will enter adult fiction field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ca05c5-1156-3dc5-b8be-fec2b60ab8e8",
                                        "entry_id": "ac43a6a4-e06b-39ba-83a4-2f701c543d04",
                                        "glosses": [
                                            "An actor playing a child's role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818b5060-46b3-46da-8e9c-5b668796563c",
                                                "sense_id": "83ca05c5-1156-3dc5-b8be-fec2b60ab8e8",
                                                "text": "'Home,' as, following his habit of giving monosyllable titles to his pieces, T[homas] W[illiam] Robertson christened his version of 'L'Aventurière,' has been revived. […] In a juvenile part, Mr. Lytton Sothern made a successful début."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22d782d-5302-3f74-a684-9d4bd05d2c5c",
                                        "entry_id": "ac43a6a4-e06b-39ba-83a4-2f701c543d04",
                                        "glosses": [
                                            "A sexually immature animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984de370-b81e-432d-8156-14707376acec",
                                                "sense_id": "d22d782d-5302-3f74-a684-9d4bd05d2c5c",
                                                "text": "Even if juveniles acquire sex-specific adult-like foraging skills before reaching adult size, their smaller body size may put them at a foraging disadvantage. […] The size effect on foraging is reduced in species that use small or easily manipulated substrates. For instance, in Costa Rican squirrel monkeys, juveniles apparently mastered techniques for insect foraging only a few months after weaning, when they were still much smaller than adults[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b459d58c-3021-3575-a3a3-86b0bf679b30",
                                        "entry_id": "ac43a6a4-e06b-39ba-83a4-2f701c543d04",
                                        "glosses": [
                                            "A two-year-old racehorse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f999b315-8935-4e64-b96e-0d38c5976f23",
                                                "sense_id": "b459d58c-3021-3575-a3a3-86b0bf679b30",
                                                "text": "Even more incredible is the legion of two-year-olds who win handsomely as juveniles and then disappear from the racetrack."
                                            },
                                            {
                                                "example_id": "1ca66a60-f62f-4c64-8ef7-72327bf065b1",
                                                "sense_id": "b459d58c-3021-3575-a3a3-86b0bf679b30",
                                                "text": "Professional trainers foster young horses with obvious potential. Instance the way Sir Michael Stoute uses patience to bring along his two-year-old colts and fillies at Newmarket, or the careful approach taken with juveniles by that wonderful conditioner Charlie Whittingham in California."
                                            },
                                            {
                                                "example_id": "ba201122-3934-41c4-b1ab-d8569169b16e",
                                                "sense_id": "b459d58c-3021-3575-a3a3-86b0bf679b30",
                                                "text": "Thereafter, males aged two to four are colts, females are fillies, racing two-year-olds are sometimes referred to as juveniles, and animals still running at five, the age of thoroughbred maturity, or older, are horses or mares according to gender."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
