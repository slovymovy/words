                        "entry_id": "a8bc839c-cc03-366e-98f1-5895af843b8c",
                        "glosses": [
                            "tot treurnis stemmend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96907b9c-7f02-48b2-a3b8-dd0d593d14c5",
                                "sense_id": "e5950df2-1505-3c3f-815b-f606b9106daf",
                                "text": "Raleigh is zaterdagmiddag door een hevige windhoos getroffen met tragische, zelfs dodelijke gevolgen."
                            },
                            {
                                "example_id": "640228aa-292f-4ff6-81a2-8714c2f61f42",
                                "sense_id": "e5950df2-1505-3c3f-815b-f606b9106daf",
                                "text": "Iedereen reageert anders op de dood van een dierbare, het is niet te voorspellen hoe iemand tragisch nieuws van deze magnitude tot zich laat doordringen."
                            },
                            {
                                "example_id": "4880ceec-cfbc-4a9f-9082-1d09accefc82",
                                "sense_id": "e5950df2-1505-3c3f-815b-f606b9106daf",
                                "text": "'Het is niet tragisch om voor de liefde te sterven,' zegt ze."
                            },
                            {
                                "example_id": "3252cd6a-3ef0-4f21-9916-993b6bf4fd39",
                                "sense_id": "e5950df2-1505-3c3f-815b-f606b9106daf",
                                "text": "Volgens haar gaat het om een tragisch ongeluk."
                            }
                        ]
                    }
