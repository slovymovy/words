                    {
                        "sense_id": "f9c8ac12-017a-3a1e-b23a-849a7810fe4c",
                        "entry_id": "5f1d64cf-b6c2-33e5-a49a-ed0a5213154e",
                        "glosses": [
                            "Petite ouverture plate, triangulaire ou ronde, fermée par une grille et insérée dans une toiture en ardoise ou en tuiles plates ajustées pour effectuer la ventilation des combles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9063c54b-3aae-4cb8-9d74-be4ddce526d0",
                                "sense_id": "f9c8ac12-017a-3a1e-b23a-849a7810fe4c",
                                "text": "Pour les toitures en tuiles mécaniques (voir photo), la ventilation est assurée par des tuiles spéciales insérées dans la couverture et comportant un petit outeau."
                            }
                        ]
                    },
                    {
                        "sense_id": "df5cec37-64d6-3211-a945-97fa267581fb",
                        "entry_id": "5f1d64cf-b6c2-33e5-a49a-ed0a5213154e",
                        "glosses": [
                            "Fenêtre ou petite lucarne sur le versant de forme triangulaire avec ouverture rectangulaire, servant à l’éclairage d’une pièce mansardée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "616bee1d-238a-45e0-9fd5-5c90f3f84ab0",
                                "sense_id": "df5cec37-64d6-3211-a945-97fa267581fb",
                                "text": "Le chien-assis, plus ancien que la fenêtres en outeau est lui, de section rectangulaire surmontée d’un petit toit."
                            },
                            {
                                "example_id": "2216e511-e95b-43d5-ae2e-d95d8a79b1c6",
                                "sense_id": "df5cec37-64d6-3211-a945-97fa267581fb",
                                "text": "L’outeau, contrairement aux chatières, comporte une charpente de lucarne."
                            }
                        ]
                    }
                ],
