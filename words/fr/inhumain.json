    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aa010ac6-6ed7-3ac5-8a0d-8c46d5dd39fb",
                    "sense_definition": "Qui fait preuve d'une cruauté excessive et manque totalement de compassion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cruaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce gardien se montrait particulièrement <w>inhumain</w> envers les détenus sans défense."
                        },
                        {
                            "text": "Face à la détresse de cette famille, son refus catégorique était tout simplement <w>inhumain</w>."
                        }
                    ],
                    "synonyms": [
                        "cruel",
                        "impitoyable",
                        "féroce"
                    ],
                    "antonyms": [
                        "humain"
                    ],
                    "common_phrases": [
                        "comportement inhumain"
                    ]
                },
                {
                    "sense_id": "35f75a02-3127-3b8a-bafe-81616bcf9784",
                    "sense_definition": "Qui est contraire à la dignité et intolérable pour un être humain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dignite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les réfugiés vivaient entassés dans des conditions <w>inhumaines</w> depuis plusieurs semaines."
                        },
                        {
                            "text": "Le tribunal international a condamné ce traitement <w>inhumain</w> infligé aux civils."
                        }
                    ],
                    "synonyms": [
                        "barbare",
                        "dégradant"
                    ],
                    "antonyms": [
                        "humain"
                    ],
                    "common_phrases": [
                        "traitement inhumain",
                        "conditions inhumaines",
                        "acte inhumain"
                    ]
                },
                {
                    "sense_id": "4f4a5594-95bd-330c-8eb5-6a31b6365875",
                    "sense_definition": "Qui dépasse la mesure normale ou les capacités ordinaires de l'être humain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "depassement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'athlète a dû fournir un effort <w>inhumain</w> pour franchir le col sous la tempête."
                        },
                        {
                            "text": "Ce personnage de légende possédait une beauté <w>inhumaine</w> qui troublait tous les témoins."
                        }
                    ],
                    "synonyms": [
                        "surhumain"
                    ],
                    "common_phrases": [
                        "effort inhumain",
                        "beauté inhumaine"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1aa6cf4f-08c6-3cca-8343-3cbf37917f13",
                    "sense_definition": "Personne particulièrement cruelle, impitoyable et dépourvue de toute sensibilité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cruaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seul un véritable <w>inhumain</w> pouvait abandonner des bêtes blessées dans un tel état."
                        },
                        {
                            "text": "On décrivait ce souverain sanguinaire comme un <w>inhumain</w> incapable du moindre remords."
                        }
                    ],
                    "synonyms": [
                        "monstre",
                        "bourreau"
                    ]
                }
            ]
        }
