                        "examples": [
                            {
                                "example_id": "62379ae7-1a11-4cb7-ab5d-1683855e7812",
                                "sense_id": "70904e3f-900a-39aa-9fa0-3b827e8f9330",
                                "text": "Les broussins de quelques arbres ont une grande valeur dans le commerce, soit à raison de l’entrelacement de leurs fibres qui rend leur bois infendable, soit à raison de leur coloration qui fait ressembler leur bois à du marbre."
                            },
                            {
                                "example_id": "fcbbf250-ce5a-46e5-8316-79ad9cf942b3",
                                "sense_id": "70904e3f-900a-39aa-9fa0-3b827e8f9330",
                                "text": "Le bois de l’ostryer est blanc, dur, fort et ses fibres roulées, tortillées, le rendent presque infendable."
                            },
                            {
                                "example_id": "62facaa3-184a-4862-9225-d88c30aa3100",
                                "sense_id": "70904e3f-900a-39aa-9fa0-3b827e8f9330",
                                "text": "Et n’embrouille pas tes faux cils pour essayer de me fendre le cœur. Il est infendable désormais, et crois bien que ce n’est pas gai !..."
                            }
                        ]
                    }
