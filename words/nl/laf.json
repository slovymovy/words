            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74205ad9-2b94-3a34-9451-dc567eb33aae",
                    "sense_definition": "een gebrek aan moed tonend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een verschrikkelijk <w>laffe</w> daad was dat!",
                            "target_lang_translations": {
                                "en": "What a terribly <w>cowardly</w> act that was!"
                            }
                        },
                        {
                            "text": "Het is erg <w>laf</w> om weg te rennen als iemand hulp nodig heeft.",
                            "target_lang_translations": {
                                "en": "It is very <w>cowardly</w> to run away when someone needs help."
                            }
                        }
                    ],
                    "synonyms": [
                        "bang",
                        "angstig"
                    ],
                    "antonyms": [
                        "dapper",
                        "moedig",
                        "heldhaftig"
                    ],
                    "common_phrases": [
                        "laffe daad",
                        "laffe aanval"
                    ],
                    "target_lang_definitions": {
                        "en": "showing a lack of courage"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cowardly",
                                "target_lang_sense_clarification": "lacking courage"
                            },
                            {
                                "target_lang_word": "yellow",
                                "target_lang_sense_clarification": "informal term for being afraid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c4296a1-1df2-34e5-a0b7-f5007cc65a60",
                    "sense_definition": "onaangenaam smakeloos, flauw",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "smaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een <w>laf</w> smaakje aan deze soep.",
                            "target_lang_translations": {
                                "en": "There is a <w>bland</w> taste to this soup."
                            }
                        },
                        {
                            "text": "Zonder zout en peper smaakt het eten een beetje <w>laf</w>.",
                            "target_lang_translations": {
                                "en": "Without salt and pepper, the food tastes a bit <w>insipid</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "flauw",
                        "smakeloos",
                        "zoutloos"
                    ],
                    "antonyms": [
                        "pittig",
                        "hartig",
                        "smaakvol"
                    ],
                    "common_phrases": [
                        "laf smaakje"
                    ],
                    "target_lang_definitions": {
                        "en": "unpleasantly tasteless or bland"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bland",
                                "target_lang_sense_clarification": "lacking strong flavor"
                            },
                            {
                                "target_lang_word": "insipid",
                                "target_lang_sense_clarification": "unappetizingly flavorless"
                            },
                            {
                                "target_lang_word": "tasteless",
                                "target_lang_sense_clarification": "having no flavor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
