                ],
                "senses": [
                    {
                        "sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                        "entry_id": "b4dab976-aebd-39e1-9080-a0cc9a46ea80",
                        "glosses": [
                            "Geheimnis, das Geheimgehaltene als Teil einer Geheimlehre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95dc0fe-fb51-4ac1-8356-f03f9c0ecd19",
                                "sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                                "text": "„Das Buch bleibt »bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn. Ein Arkanum für den analphabetischen Laien, hat es, dank seiner Rolle in der Liturgie und seinem Gehalt, sakralen, wenn nicht gar magischen Charakter auch für den Gebildeten. (Max Wehrli)«“"
                            },
                            {
                                "example_id": "f7b1d1cc-cc59-48e9-9c5f-a3c78c68e54a",
                                "sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                                "text": "„Die Übung schweigender Konzentration ist also aus einem Arkanum zum Normalfall unserer Arbeitswelt geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ffd81645-1886-3560-9ec5-812727ced85a",
                        "entry_id": "b4dab976-aebd-39e1-9080-a0cc9a46ea80",
                        "glosses": [
                            "Geheimmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8ecaaa-c5b8-4578-8c07-c177355da277",
                                "sense_id": "ffd81645-1886-3560-9ec5-812727ced85a",
                                "text": "„Die Masse des Arzneimittels hielt Paracelsus nur für die äußere Hülle, worin das Arkanum selbst immateriell enthalten ist.“"
                            },
                            {
                                "example_id": "1f774b87-5f66-4b49-97da-953b88e2c2c2",
                                "sense_id": "ffd81645-1886-3560-9ec5-812727ced85a",
                                "text": "„Der Leidende, der Jahre lang ängstlich und furchtsam sein Zimmer kaum zu verlassen gewagt, entschloß sich mit enthusiastischer Freude nach dem Orte zu reisen, wo das Arkanum für sein langwieriges Übel sich befinden sollte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00046765-0bbf-4660-91ea-388eb74762ca",
                        "source_entry_id": "b4dab976-aebd-39e1-9080-a0cc9a46ea80",
                        "source_sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                        "source_sense_description": "Geheimnis, das Geheimgehaltene als Teil einer Geheimlehre",
                        "target_lang_word": "arcana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                                        "entry_id": "7c7f83c8-99b1-38e8-a86f-4bd6dfceffad",
                                        "glosses": [
                                            "Specialized knowledge that is mysterious to the uninitiated."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3136606e-1c10-4f16-ad1f-3bd36080bcc3",
                                                "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                                                "text": "Thou deign'st no answer,—or I fain would ask\nIf since thy bright creation, thou hast seen\nOught like a Newton, whose admitted eye\nThe arcana of the universe explored\nLight's subtle ray its mechanism disclosed,\nThe impetuous comet his mysterious lore\nUnfolded,"
                                            },
                                            {
                                                "example_id": "bdb98e23-6d9f-4bc0-ab66-909ffbfc0f29",
                                                "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                                                "text": "The witch, repository of hieratic lore and folk legends and occult arcana, became the distributor of philtres and unguents, electuaries and pastilles, herbs and charms and incantations - directed toward sexual pleasures and amatory satisfactions."
                                            },
                                            {
                                                "example_id": "e1493326-9eed-4190-aa24-a75660a4cde8",
                                                "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                                                "text": "This is not, however, a mere salmagundi of alphabetical arcana."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arcana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30e64217-35d7-39a2-9948-61a355a90949",
                                        "entry_id": "0475b103-c7c4-36f7-a2f1-870e1c2c6d83",
                                        "glosses": [
