                "senses": [
                    {
                        "sense_id": "1b00a2c9-cf49-3a7f-be0c-97cc706fad27",
                        "entry_id": "e6ddf6d0-f3a2-3d5f-a50a-1b7b80218961",
                        "glosses": [
                            "Nettoyer de la matière fécale qui salissait."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "40aacb78-f631-4dbc-859c-962dd1c42ee7",
                                "sense_id": "1b00a2c9-cf49-3a7f-be0c-97cc706fad27",
                                "text": "Que mieux vaudrait dévider la pelote,\ntordre le fil, ravauder la culotte,\ntremper la soupe et mettre pois en lard,\ndésembrenner les fesses du poupart\net dorloter un époux qui radote,\npauvre catau."
                            },
                            {
                                "example_id": "93f8a023-f397-4257-a5d9-e254d9cbc79f",
                                "sense_id": "1b00a2c9-cf49-3a7f-be0c-97cc706fad27",
                                "text": "Il peinait à se pencher pour désembrenner le bout de ses bottes en caïman."
                            },
                            {
                                "example_id": "fb698c57-4f5e-4644-9f5e-cc64812aea94",
                                "sense_id": "1b00a2c9-cf49-3a7f-be0c-97cc706fad27",
                                "text": "Porco! déculotte et désembrenne-toi"
                            }
                        ]
                    }
                ],
