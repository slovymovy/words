                ],
                "senses": [
                    {
                        "sense_id": "b26c3362-b9d8-3d60-9200-3f008090a65e",
                        "entry_id": "c6775afe-8d24-3334-8dfe-57370c645d3c",
                        "glosses": [
                            "Qui attriste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be3fdccd-f420-43b8-a751-e2dbc73b48c3",
                                "sense_id": "b26c3362-b9d8-3d60-9200-3f008090a65e",
                                "text": "Madeleine semblait se complaire dans ces récits pitoyables, et énumérer avec je ne sais quelle sombre avidité toutes ces calamités voisines qui formaient autour de sa vie un concours de conjonctures attristantes."
                            },
                            {
                                "example_id": "37b8f474-73b4-45fe-85a9-bf8ef6bc3444",
                                "sense_id": "b26c3362-b9d8-3d60-9200-3f008090a65e",
                                "text": "Mes rideaux ouverts laissaient voir, au premier plan, toujours la même petite table attristante, avec des tasses de tisane, des fioles de remèdes."
                            },
                            {
                                "example_id": "7f774d3f-01d7-47fc-9018-ca4d4dd661c2",
                                "sense_id": "b26c3362-b9d8-3d60-9200-3f008090a65e",
                                "text": "Cependant, […], j’avouerai que les rives de la Caspienne m’ont paru mornes et attristantes. Aucune animation sur le littoral, ni végétation ni oiseaux."
                            },
                            {
                                "example_id": "683bf7dc-7bbe-4524-9a33-7092d8a6bdd0",
                                "sense_id": "b26c3362-b9d8-3d60-9200-3f008090a65e",
                                "text": "On ne les reverra plus\nEt c'est bien attristant\nLes belles pompes funèbres de nos vingt ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
