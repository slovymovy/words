                    },
                    {
                        "form_id": "41c6930a-b403-4cd0-8ba5-dd36eb7f9f8e",
                        "entry_id": "9db2f13a-10f0-32ac-820e-bde174c6ea9e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "envahisseuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "496b9b4d-db5b-3c38-9049-95b3d894ece9",
                        "entry_id": "9db2f13a-10f0-32ac-820e-bde174c6ea9e",
                        "glosses": [
                            "Celui qui envahit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06943e19-2096-427d-b849-2c62cfd8a0e6",
                                "sense_id": "496b9b4d-db5b-3c38-9049-95b3d894ece9",
                                "text": "D’ailleurs, les Maoris et les Australiens, toujours en guerre avec leurs envahisseurs, pouvaient rendre fort difficile l’opération projetée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9903d602-9dc8-4761-88bd-29989b55efe5",
                        "source_entry_id": "9db2f13a-10f0-32ac-820e-bde174c6ea9e",
                        "source_sense_id": "496b9b4d-db5b-3c38-9049-95b3d894ece9",
                        "target_lang_word": "Eindringling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eindringling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                        "entry_id": "803d8bee-8367-3190-b062-ef7cd53ceb87",
                                        "glosses": [
                                            "jemand, der sich unerlaubt/unerwünscht Zutritt verschafft hat/verschafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84024386-0d49-4d70-bcaa-ae377a9b76f2",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "Eindringlinge werden erschossen."
                                            },
                                            {
                                                "example_id": "b8c8d75b-b995-4c6c-88e6-4c36e2947216",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Wir sind keine Eindringlinge, sondern Ehrengäste.“"
                                            },
                                            {
                                                "example_id": "8e834410-32af-48f4-b67f-bd58f03fd6c1",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Vor allem die rohe Gewalt der Eindringlinge traumatisiert die Römer zutiefst.“"
                                            },
                                            {
                                                "example_id": "6f3aaa9e-418d-4787-a245-af07c8dfd179",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Rücksichtslos schickt er seine Sklaven zwei Sommer nacheinander auf Thorsteins Land - obwohl er weiß, dass der Nachbar angekündigt hat, solche Eindringlinge zu erschlagen.“"
                                            },
                                            {
                                                "example_id": "755992f3-262b-479c-b92e-37df3cb33051",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„»Rus« nennen die Einheimischen die Eindringlinge - wahrscheinlich abgeleitet von einem Wort, mit dem die Finnen die Schweden bezeichnen.“"
                                            },
                                            {
                                                "example_id": "574bc812-cf55-422f-9d8f-7653f5a4f3d7",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Die Mauer soll Amerika uneinnehmbar für Eindringlinge machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f729f0c-9e55-42cd-9390-20d872a2fa13",
                        "source_entry_id": "9db2f13a-10f0-32ac-820e-bde174c6ea9e",
                        "source_sense_id": "496b9b4d-db5b-3c38-9049-95b3d894ece9",
                        "target_lang_word": "invader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "921598c2-3efb-3c25-8858-46a571e8521e",
                                        "entry_id": "8f0ace7b-9674-3362-b957-10982447b6bc",
                                        "glosses": [
                                            "One who invades a region."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc73d12-7057-4e83-8575-9a24cd380cea",
                                                "sense_id": "921598c2-3efb-3c25-8858-46a571e8521e",
                                                "text": "He remarks on the growth of the pretensions of the invaders since the treaty between Alfred and Guthrum which put the Northern warriors only on the same level as the twelf[-]hyndmen, or ordinary thegns."
                                            },
                                            {
                                                "example_id": "50d4d635-3d08-462b-bce8-245429a60055",
                                                "sense_id": "921598c2-3efb-3c25-8858-46a571e8521e",
                                                "text": "The underroot tendril! We are at fault for giving the invader a path to Lady Brianna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "146206c6-fefb-3805-8034-d4fc6eaaca1b",
                                        "entry_id": "8f0ace7b-9674-3362-b957-10982447b6bc",
                                        "glosses": [
                                            "An intruder (especially on someone's privacy)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
