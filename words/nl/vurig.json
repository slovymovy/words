                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zon ging onder met een <w>vurige</w> gloed aan de horizon.",
                            "target_lang_translations": {
