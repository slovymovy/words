                                        "entry_id": "acef3948-2521-3719-b8ff-cae1141bf498",
                                        "glosses": [
                                            "Denoting a person whose choice of love-interest arises from the dependence of the libido on another instinct (e.g., hunger)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82121210-2bb8-4e22-a968-d0d7f3ee9904",
                                                "sense_id": "e99c67fb-b4b7-397e-9cea-31195685f7d3",
                                                "text": "I don’t think I have to gloss the true anaclitic purport behind your need to humiliate a woman doctor symbolically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bed1057c-4204-3856-b4e8-e9cab1a6f331",
                                        "entry_id": "acef3948-2521-3719-b8ff-cae1141bf498",
                                        "glosses": [
                                            "Pertaining to an acute emotional dependence on another person or persons."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673f4add-ec43-4a23-8799-179dd795d4b1",
                                                "sense_id": "bed1057c-4204-3856-b4e8-e9cab1a6f331",
                                                "text": "When introjects are weak (or even absent), an anaclitic personality configuration results, characterized by dependency, insecurity, and feelings of helplessness and emptiness."
                                            }
                                        ]
                                    }
