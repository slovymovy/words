                                            "Misspelling of dictater."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "472d817d-7394-4022-a48f-14052c1af297",
                        "source_entry_id": "19eccd3a-7072-3279-8c88-1567c080b53f",
                        "source_sense_id": "c864e61b-4337-364b-966f-e50e2c4233d6",
