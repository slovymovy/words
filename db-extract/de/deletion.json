                ],
                "senses": [
                    {
                        "sense_id": "9647ffa8-bf0f-3e28-baa7-77d1728e9574",
                        "entry_id": "58992f8b-8d40-378b-b481-c40022f234d6",
                        "glosses": [
                            "Mutation, bei der es zur Entfernung einer Nukleotidsequenz (ein bis mehreren Nukleotidpaare) oder eines Teils beziehungsweise des gesamten Chromosoms kommt"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "17d2819a-2cf9-48af-b140-8d6e65a813f6",
                                "sense_id": "9647ffa8-bf0f-3e28-baa7-77d1728e9574",
                                "text": "Eine Deletion ist immer ein Verlust von genetischem Material."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "873251c9-7f92-30cd-be85-4b2e76ba4d94",
                        "entry_id": "58992f8b-8d40-378b-b481-c40022f234d6",
                        "glosses": [
                            "Auslassung sprachlicher Einheiten im Satz; Probe zur Unterscheidung notwendiger von nicht notwendigen Teilen eines Satzes oder Satzgliedes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ceae3b-a11f-4f48-8469-1c7e7be163f1",
                                "sense_id": "873251c9-7f92-30cd-be85-4b2e76ba4d94",
                                "text": "Mit Hilfe von Deletionen kann man herausfinden, welche Bestandteile sprachlicher Einheiten notwendig und welche nur fakultativ sind. Deletionen zeigen z.B. dass Attribute keine notwendigen Bestandteile von Sätzen bzw. Satzgliedern sind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bbb1713-5670-40ac-ac90-cb3431f0c026",
                        "source_entry_id": "58992f8b-8d40-378b-b481-c40022f234d6",
                        "source_sense_id": "9647ffa8-bf0f-3e28-baa7-77d1728e9574",
                        "source_sense_description": "Mutation, bei der es zur Entfernung einer Nukleotidsequenz oder des gesamten Chromosoms kommt",
                        "target_lang_word": "刪除",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "刪除",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "8f64507f-cda6-3083-9c00-75e315db3c0d",
                                        "entry_id": "2afa2a70-4e57-35a1-bc53-d29e6eda0653",
                                        "glosses": [
                                            "去掉使其不存在"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a7918fc-eb0a-420c-8ce6-2f51e7df0807",
                                                "sense_id": "8f64507f-cda6-3083-9c00-75e315db3c0d",
                                                "text": "僅就篇帙，刪除煩復，搜補闕遺。"
                                            },
                                            {
                                                "example_id": "465ccb17-8e77-4b73-aed0-cf1497fc41ff",
                                                "sense_id": "8f64507f-cda6-3083-9c00-75e315db3c0d",
                                                "text": "仅就篇帙，删除烦复，搜补阙遗。"
                                            },
                                            {
                                                "example_id": "714937f0-3792-435b-9af0-fe673210619f",
                                                "sense_id": "8f64507f-cda6-3083-9c00-75e315db3c0d",
                                                "text": "舊形式是采取，必有所刪除，既有刪除，必有所增益。"
                                            },
                                            {
                                                "example_id": "154c6221-5af9-418d-8a95-68a5859a2041",
                                                "sense_id": "8f64507f-cda6-3083-9c00-75e315db3c0d",
                                                "text": "旧形式是采取，必有所删除，既有删除，必有所增益。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
