{
    "word_family": [
        "grow",
        "growth"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd011a22-b8f4-3ff6-811f-43c6af0a97f7",
                    "sense_definition": "Physically mature and fully developed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>grown-up</w> woman with a career of her own.",
                            "target_lang_translations": {
                                "ru": "Она <w>взрослая</w> женщина, у которой есть собственная карьера."
                            }
                        },
                        {
                            "text": "The <w>grown-up</w> animals are much larger than the babies.",
                            "target_lang_translations": {
                                "ru": "<w>Взрослые</w> животные намного крупнее детенышей."
                            }
                        }
                    ],
                    "synonyms": [
                        "adult",
                        "full-grown",
                        "mature"
                    ],
                    "common_phrases": [
                        "grown-up person"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически зрелый и полностью развитый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "относящийся к человеку или животному, достигшему зрелости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc9d765-c567-33b9-b757-d85d32a44b0b",
                    "sense_definition": "Having a mature, responsible, or sensible outlook.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a very <w>grown-up</w> decision to save his money instead of spending it.",
                            "target_lang_translations": {
                                "ru": "Он принял очень <w>взрослое</w> решение откладывать деньги, а не тратить их."
                            }
                        },
                        {
                            "text": "Try to have a <w>grown-up</w> conversation about your problems.",
                            "target_lang_translations": {
                                "ru": "Постарайтесь провести <w>взрослый</w> разговор о своих проблемах."
                            }
                        }
                    ],
                    "synonyms": [
                        "mature"
                    ],
                    "common_phrases": [
                        "grown-up conversation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий зрелым, ответственным или разумным подходом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "о поведении или подходе, свидетельствующем о зрелости"
                            },
                            {
                                "target_lang_word": "зре́лый",
                                "target_lang_sense_clarification": "о рассудительном и серьезном отношении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce8b38d2-4602-327a-b465-4565c9590314",
                    "sense_definition": "Suitable for or intended for adults.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie contains some <w>grown-up</w> themes that might be scary for children.",
                            "target_lang_translations": {
                                "ru": "В фильме затрагиваются некоторые <w>взрослые</w> темы, которые могут напугать детей."
                            }
                        },
                        {
                            "text": "They discussed <w>grown-up</w> matters like taxes and insurance.",
                            "target_lang_translations": {
                                "ru": "Они обсуждали <w>взрослые</w> дела, такие как налоги и страхование."
                            }
                        }
                    ],
                    "synonyms": [
                        "adult",
                        "18+",
                        "R-rated"
                    ],
                    "common_phrases": [
                        "grown-up themes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для взрослых или подходящий для них."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "предназначенный для аудитории старшего возраста"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e79f3fc-73ce-3e5c-b7aa-b05489bbc5bd",
                    "sense_definition": "A person who is fully developed and no longer a child.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>grown-ups</w> were talking in the kitchen while the children played outside.",
                            "target_lang_translations": {
                                "ru": "<w>Взрослые</w> разговаривали на кухне, пока дети играли на улице."
                            }
                        },
                        {
                            "text": "Sometimes being a <w>grown-up</w> is harder than being a child.",
                            "target_lang_translations": {
                                "ru": "Иногда быть <w>взрослым</w> труднее, чем ребенком."
                            }
                        }
                    ],
                    "synonyms": [
                        "adult",
                        "grownup"
                    ],
                    "common_phrases": [
                        "ask a grown-up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который полностью развит и больше не является ребенком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "существительное, обозначающее человека, вышедшего из детского возраста"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}