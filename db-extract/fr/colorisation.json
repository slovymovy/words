                "entry_id": "ba5ef9f6-bfdf-303f-bb06-2a994b6b8150",
                "word": "colorisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9caeb1f5-2489-448c-9fcf-9abaee79b6ec",
                        "entry_id": "ba5ef9f6-bfdf-303f-bb06-2a994b6b8150",
                        "tags": [
