                        "examples": [
                            {
                                "example_id": "05b5716a-9f0c-4a81-96d5-e3fde9b29c25",
                                "sense_id": "b4b3d4df-741d-3eb3-8702-6347a7a5abe5",
                                "text": "Вторым лицом после воеводы был губный староста, ведавший дела уголовные: его выбирали всех чинов люди из дворян или детей боярских."
                            }
                        ]
