                ],
                "senses": [
                    {
                        "sense_id": "a9962916-0ae0-3741-8864-144417aaedfc",
                        "entry_id": "eca7f732-c578-321d-9a1b-744669d70157",
                        "glosses": [
                            "Störung eines normalen Rhythmus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "553a4308-f4fc-4955-b4e4-b06bf9d7ef4e",
                                "sense_id": "a9962916-0ae0-3741-8864-144417aaedfc",
                                "text": "„Tatsächlich fanden sie die Dysrhythmie bei verschiedenen neurologischen und psychiatrischen Erkrankungen.“"
                            },
                            {
                                "example_id": "a9685d85-3231-4f6c-9067-1eaa15476de0",
                                "sense_id": "a9962916-0ae0-3741-8864-144417aaedfc",
                                "text": "„Der Jetlag, in Fachkreisen auch zirkadiane Dysrhythmie genannt, ist wohl jedem, der schon einmal weite Strecken geflogen ist, bekannt.“"
                            },
                            {
                                "example_id": "b50f2c79-01ca-4cd0-a63e-a87feb95020c",
                                "sense_id": "a9962916-0ae0-3741-8864-144417aaedfc",
                                "text": "„Es fand sich ein langsamer polymorpher Theta- und Delta-Rhythmus symmetrisch über beide Hemisphären verstreut oder eine mit der Schwere der Erkrankung zunehmend deutlicher werdende langsame Dysrhythmie (S 1 bis S 3).“"
                            },
                            {
                                "example_id": "d3fee295-84e6-48e1-976d-25c2e657f824",
                                "sense_id": "a9962916-0ae0-3741-8864-144417aaedfc",
                                "text": "„Manche verstehen unter Dysrhythmie alles, was nicht dem Norm-Rhythmus entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
