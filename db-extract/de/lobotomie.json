                ],
                "senses": [
                    {
                        "sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
                        "entry_id": "e82481bf-0d15-3410-ba8e-6432a201891f",
                        "glosses": [
                            "eine neurochirurgische Operation, bei der die Nervenbahnen zwischen Thalamus und Stirnhirn sowie Teile der grauen Substanz durchtrennt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0df52895-8510-43c1-96cc-3c0675cf26d3",
                                "sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
                                "text": "Die Lobotomie ist ein operativer Eingriff in die weiße Gehirnsubstanz bei bestimmten psychiatrischen Krankheiten."
                            },
                            {
                                "example_id": "1426a6ca-8be4-4134-8f27-33d6ff655724",
                                "sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
                                "text": "Die Lobotomie ist ein heute nicht mehr übliches, medizinisches Verfahren."
                            },
                            {
                                "example_id": "ebca6d18-9367-44ff-8af7-8b4ebda0b86e",
                                "sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
                                "text": "„Appollonia, die vor der Lobotomie eine äußerst temperamentvolle und lebenslustige junge Dame war, verwandelte sich danach in ein scheues Wesen, das sich ängstlich vor allen Menschen versteckte.“"
                            },
                            {
                                "example_id": "e306c091-9d7a-4d3d-8507-446e50ea6753",
                                "sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
                                "text": "„Aber die bisherigen Methoden der Lobotomie, Leukotomie oder Elektroschocktherapie waren reine Schlächterei, verglichen mit der Anwendung der feinen Elektronadeln.“"
                            },
                            {
                                "example_id": "17a794e4-4e48-41da-a7ef-d849eed18fa2",
                                "sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
                                "text": "„Seine Familie wurde von noch mehr Tragödien heimgesucht als die von Weich: Sein älterer Bruder Charles war zwei Jahre vor Bernies Geburt gestorben, ein anderer Bruder, Sol, war schizophren und wurde schließlich einer Lobotomie unterzogen, und er selbst litt an einer so schlimmen Dickdarmentzündung, dass er zwei Jahre nicht zur Schule gehen konnte und einen Kolostomiebeutel tragen musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16dba86f-2458-43b4-a389-5c0ea8cabc1f",
                        "source_entry_id": "e82481bf-0d15-3410-ba8e-6432a201891f",
                        "source_sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
                        "target_lang_word": "lobotomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lobotomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f231693-198b-33a5-9c79-26334cb51f0d",
                                        "entry_id": "178eca08-ed8b-3235-87b8-4213fb3c4b19",
                                        "glosses": [
                                            "A surgical operation on the frontal lobe of the brain intent on treating certain mental illnesses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d989cd71-7413-4604-83a5-a2056bc29562",
                                                "sense_id": "5f231693-198b-33a5-9c79-26334cb51f0d",
                                                "text": "They existed at a time in history when shock therapy, brain tissue manipulation, implants, drug experimentation and lobotomies were treatments de jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cf7584-32da-38a6-a7ac-814d3ab83731",
                                        "entry_id": "178eca08-ed8b-3235-87b8-4213fb3c4b19",
                                        "glosses": [
                                            "The severing of the prefrontal cortex from the thalamic region of the brain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dff90ae-38be-370f-9396-8d40d09f877e",
                                        "entry_id": "178eca08-ed8b-3235-87b8-4213fb3c4b19",
                                        "glosses": [
                                            "The severing of the sympathetic nerve trunk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                        "entry_id": "178eca08-ed8b-3235-87b8-4213fb3c4b19",
                                        "glosses": [
                                            "Separation, removal or deprivation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6debef19-170d-4cde-b891-7cd36019b97d",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "Yet this conscience is a deep part of the soul; to silence it, characters must perform a kind of moral lobotomy, excising the best parts of themselves, until what is left becomes less than human."
                                            },
                                            {
                                                "example_id": "a4b63f9c-177e-403c-ab74-02ed1234a2f2",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "Organisations which set out to treat all individuals as the same, or are ‘colour-blind’ in their philosophy, could be said to impose a form of cultural lobotomy on their clients, in denying the additional skills, knowledge and experience that they have as members of a minority culture."
                                            },
                                            {
                                                "example_id": "a0a49089-91c7-4fc7-804b-159ed7ea3087",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "Put another way, how can we avoid an ethical lobotomy in establishing an organizational perspective?"
                                            },
                                            {
                                                "example_id": "136f246c-423e-4b33-8dd0-9b3c298f9ed4",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "In the end, as Levinson feared, the price of Charlie being accepted into normative school society is a kind of social lobotomy: he is tamed, so he is not really Charlie anymore."
                                            },
                                            {
                                                "example_id": "d785ec5b-c4c2-4c17-a26f-8443b6dbb6ad",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "From Tadros’s perspective — the perspective of classical utilitarianism — there is nothing objectionable about this moral lobotomy whereby a wrongdoer pops a moral anesthetic pill immediately after committing whatever atrocity one could imagine in order to avoid suffering — provided, that is, that she would “understand” the wrongness of her actions."
                                            },
                                            {
                                                "example_id": "e02ea67d-205e-4661-8386-3b9f554ce73c",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "We might be able to offer some sort of mental rehabilitation for clinicians who suffer from this type of intellectual lobotomy."
                                            },
                                            {
                                                "example_id": "f36f1f76-5d59-4a6e-8339-191eff0cfada",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "For the surviving generations, in particular the post-World War II generation and their children, a time of cultural lobotomy began, accompanied by a fundamental sense of shame for the abuse carried out in the name of the nation."
                                            },
                                            {
                                                "example_id": "d1b1b714-8ad2-4008-929b-d39a9e46b84c",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "The offender’s acceptance of his condemnation presupposes the coherent ensemble of collective consciousness of a specific ethical universe; that is, for an offender to recognize his act as criminal before a judge is to disapprove of the act and to negate his rupture of the public sphere by his private conduct. The North African refuses this ethical lobotomy by denial and retraction of his confession."
                                            },
                                            {
                                                "example_id": "dce7cbe9-3cce-4b05-bc43-1261a7dfd7b2",
                                                "sense_id": "5be7bae1-0ef4-3bff-abe6-e5b993ba296f",
                                                "text": "It is as if civic engagement required a moral-intellectual lobotomy, the better to overcome doubts about the inherent goodness of the community, the moral worth of a given group identity, or the value of specific ideological commitment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "871fb35a-67a0-4898-8664-86e363b29e7c",
                        "source_entry_id": "e82481bf-0d15-3410-ba8e-6432a201891f",
                        "source_sense_id": "6cdebaae-2e0b-3ea5-86a4-f3a8727b2a40",
