                "senses": [
                    {
                        "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                        "entry_id": "a27470ee-96aa-32a7-b42a-0064a4f09fd0",
                        "glosses": [
                            "Zimmer/Raum, der verschiedenen Zwecken dient, beispielsweise Sport, Aufführungen, Versammlungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b5c600e-4db5-46ec-966a-bdd769c0a744",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Für die etwa 400 Muslime in Penzberg sowie weitere mehrere Hundert im Umland wurde 2005 eine Moschee mit Bibliothek und Mehrzweckräumen eröffnet.“"
                            },
                            {
                                "example_id": "b6e9ebf9-b6dd-4324-a587-e6dabc91b13a",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„In den 1980er Jahren wurde im Untergeschoss ein Jugendfreizeitzentrum mit Mehrzweckräumen eingerichtet.“"
                            },
                            {
                                "example_id": "6f517779-6f8b-46e7-a6bf-f3511e1f2a03",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Die höchste Einzelförderung mit 500.000 Euro ist für den Neubau einer Sporthalle mit Mehrzweckraum in Neumünster geplant, nachdem dort ein Feuer ein Gebäude des TS Einfeld zerstörte.“"
                            },
                            {
                                "example_id": "29a3e543-d042-4984-bed5-5c3c4a25f814",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Ich treffe die Musikpädagogin in einem Mehrzweckraum im Souterrain.“"
                            },
                            {
                                "example_id": "3d159ff3-f885-4583-bf2b-d28110e5db7a",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„In Schwyz wurde ein Mann und eine Frau von der Polizei verhaftet, nachdem sie in einen Mehrzweckraum eingebrochen waren.“"
                            },
                            {
                                "example_id": "9741fc55-9893-4e89-86ef-bc75f3e26dd4",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "Theater im Gefängnis: „Die jüngste Produktion \"Schwarz-Rot-Gold\" beispielsweise wird dann an sechs Abenden im Mehrzweckraum der Anstalt aufgeführt.“"
                            },
                            {
                                "example_id": "2834503a-0038-464a-a0bc-80682741ebd2",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Aufgeführt werden die luki*ju-Stücke noch heute kaum auf herkömmlichen Theaterbühnen, sondern öfter in Turnhallen, Mehrzweckräumen oder in der Aula eines Schulhauses.“"
                            },
                            {
                                "example_id": "de8808b8-d65a-40ed-8544-8acc1a892793",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Dort befindet sich ein 72 Quadratmeter großer Mehrzweckraum, der beispielsweise als Schulungsraum genutzt werden kann.“"
                            },
                            {
                                "example_id": "211a1124-1ce8-4be3-81bf-0cdf64a2d82e",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Bewegungsfreiheit zählt auch in den Innenräumen der Kita. Es gibt im Vergleich zu anderen Häusern relativ wenig Spielzeug. Dafür wird regelmäßig im Mehrzweckraum gehopst und geklettert, aber auch gerungen und gerauft.“"
                            },
                            {
                                "example_id": "7bac12a4-a110-444b-aa28-9836b3b4ecb8",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Wang Dan gibt nun Tipps zur Organisation von politischen Bewegungen, knapp zwanzig Zuhörer sitzen ihm in einem Mehrzweckraum über der Markthalle in der taiwanischen Stadt Xinzhu gegenüber.“"
                            },
                            {
                                "example_id": "d8e2e060-ebaa-4944-812e-348797bad92c",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "„Das neue Kirchengebäude wird nicht nur für die Gottesdienste der Universität Leipzig genutzt, sondern ist durch einen abtrennbaren Mehrzweckraum auch als Veranstaltungsort für Konzerte und Seminare gedacht.“"
                            },
                            {
                                "example_id": "b8ba9dcb-f245-41b5-844c-942dba231550",
                                "sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                                "text": "[Meistersingerhalle in Nürnberg:] „In den ersten 20 Jahren wurden im Wesentlichen klassische Konzerte veranstaltet; der Große Saal fasst in Konzertbestuhlung ca. 2100 Sitzplätze. Danach wurde der Mehrzweckraum auch für andere Veranstaltungen genutzt; z. B. finden hier Landes-Parteitage, ebenso Bälle, Rockkonzerte und Kongresse statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
