                },
                {
                    "sense_id": "aad162ef-0684-39a3-9782-c8c5197dd2b5",
                    "sense_definition": "looking healthy, well-fed, and well-groomed",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horses in the field looked <w>sleek</w> and strong under the summer sun.",
                            "target_lang_translations": {
                                "ru": "Лошади в поле выглядели <w>холеными</w> и сильными под летним солнцем.",
                                "zh": "夏日阳光下，田野里的马儿看起来<w>毛色光亮</w>且强壮。"
                            }
                        },
                        {
                            "text": "A <w>sleek</w> animal usually indicates that it is receiving proper nutrition and care.",
                            "target_lang_translations": {
                                "ru": "<w>Лоснящееся</w> животное обычно указывает на то, что оно получает правильное питание и уход.",
                                "zh": "动物<w>毛色光亮</w>通常表明它得到了适当的营养和照顾。"
                            }
                        }
