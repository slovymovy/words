                    {
                        "translation_id": "527394eb-ece4-49a9-8a0b-933dfafda4c9",
                        "source_entry_id": "7779a1ef-8d63-31aa-a46a-012064b0de80",
                        "source_sense_id": "f21cad99-727e-3c5f-a47a-8061da837ce0",
                        "source_sense_description": "een chronische geestesziekte met perioden van verwardheid en psychose",
                        "target_lang_word": "schizophrenia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schizophrenia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff748fe-557d-3d02-a8fd-f94c01e1be44",
                                        "entry_id": "814dbabd-478d-3fbe-9f80-af0e99d48c02",
                                        "glosses": [
                                            "A psychiatric diagnosis denoting a persistent, often chronic, mental illness characterised by abnormal perception, thinking, behavior and emotion, often marked by delusions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b870f5d5-1e72-4c08-8957-5c1e8dc2a667",
                                                "sense_id": "8ff748fe-557d-3d02-a8fd-f94c01e1be44",
                                                "text": "Increasing data suggests that regular marijuana use in adolescence may also be a risk factor for developing very serious psychotic disorders, especially schizophrenia."
                                            },
                                            {
                                                "example_id": "79af51a4-86ad-498c-9300-702400386956",
                                                "sense_id": "8ff748fe-557d-3d02-a8fd-f94c01e1be44",
                                                "text": "In 1995, 2% of schizophrenia diagnoses in the country were associated with cannabis use disorder. In 2000, it increased to around 4%. Since 2010, that figure increased to 8%, the study found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a03d3e6-40ab-3554-8ab4-e2f3fced0f74",
                                        "entry_id": "814dbabd-478d-3fbe-9f80-af0e99d48c02",
                                        "glosses": [
                                            "A condition in which a person is supposed to have several distinct personalities; dissociative identity disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ecf09cc-4711-435d-80e9-9192af7fc15f",
                                                "sense_id": "0a03d3e6-40ab-3554-8ab4-e2f3fced0f74",
                                                "text": "You have enough money to afford schizophrenia for a while. Especially if the personality B dreams up things that personality A makes practical, financially advantageous use of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5f17ada-8b09-379a-bc1c-56d1ff397b1f",
                                        "entry_id": "814dbabd-478d-3fbe-9f80-af0e99d48c02",
                                        "glosses": [
                                            "Any condition in which disparate or mutually exclusive activities coexist; a lack of decision between options."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61dc42fc-e2c6-4433-87fe-c80c9b8ee6f4",
                                                "sense_id": "b5f17ada-8b09-379a-bc1c-56d1ff397b1f",
                                                "text": "[O]ne can understand how the cultural disorientation which beset the African Continent has confused Africa's political behaviour, creating a political schizophrenia that made nation-building impossible."
                                            },
                                            {
                                                "example_id": "09dab65f-8a90-425f-93d4-d8e6a0be6db3",
                                                "sense_id": "b5f17ada-8b09-379a-bc1c-56d1ff397b1f",
                                                "text": "Nevertheless, a certain amount of schizophrenia pertains to the study of World Englishes as New Englishes, for while new Englishes are regarded as valid varieties in their own right, the description and delineation of them in linguistic terms is conducted through the gaze of native-speaker norms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "194a79f4-9fc2-43be-abc6-f5b7e3407a68",
                        "source_entry_id": "7779a1ef-8d63-31aa-a46a-012064b0de80",
                        "source_sense_id": "f21cad99-727e-3c5f-a47a-8061da837ce0",
                        "source_sense_description": "een chronische geestesziekte met perioden van verwardheid en psychose",
                        "target_lang_word": "schizophrénie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schizophrénie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fdca08f-9d24-3aec-98a8-4f9287f39aa5",
                                        "entry_id": "104e5163-851a-352e-b02f-2059d6f7e1d7",
                                        "glosses": [
                                            "Pathologie psychiatrique, psychose d’évolution chronique, qui a pour conséquences une altération de la perception de la réalité, des troubles cognitifs, et un dysfonctionnement social et comportemental important."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56f15760-5981-45e3-b78f-b71cf2463238",
                                                "sense_id": "9fdca08f-9d24-3aec-98a8-4f9287f39aa5",
                                                "text": "La psychose, elle, est un état chronique de pétage de plombs qui vous fait prendre des vessies pour des lanternes. Les deux principales psychoses sont la schizophrénie et la paranoïa."
                                            },
                                            {
                                                "example_id": "47e8010c-19f3-446c-9e1b-e7b880af4524",
                                                "sense_id": "9fdca08f-9d24-3aec-98a8-4f9287f39aa5",
                                                "text": "La distractibilité est un problème fréquent dans la schizophrénie, qu’elle soit rapportée par les membres de la famille, repérée par les équipes soignantes, ou soulevée au moment de l’entretien sur les plaintes cognitives par le patient lui-même."
                                            },
                                            {
                                                "example_id": "b4967ce3-5fff-45de-ab32-3119928bbe40",
                                                "sense_id": "9fdca08f-9d24-3aec-98a8-4f9287f39aa5",
                                                "text": "Le groupe des schizophrénies – prototype des psychoses – représente un ensemble de maladies neuropsychiques fréquentes (environ 1 % de la population), causes de handicap, de souffrances et de comportements suicidaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47de7749-fd7b-3b56-91eb-6727f6679eb5",
                                        "entry_id": "104e5163-851a-352e-b02f-2059d6f7e1d7",
                                        "glosses": [
                                            "Situation où un individu se ressent ou est perçu comme inhabituellement incohérent, comme une sorte de double personnalité temporaire ; actes paraissant étrangement discordants ou en déphasage avec les paroles ou l’environnement ; attitudes ou propos contradictoires évocateurs de la schizophrénie."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f21fff-21b0-4ccd-9a6a-bfff3587aa11",
                                                "sense_id": "47de7749-fd7b-3b56-91eb-6727f6679eb5",
                                                "text": "« Attention de bien cadrer votre vidéo », conseillait à ce propos le journaliste américain Will Reeve, après s’être ridiculisé dans un improbable combo caleçon-veste de costume sur l’antenne de la chaîne ABC, lors d’un direct à domicile entaché par un plan un peu trop large. Ne sachant plus vraiment s’il est chez lui ou au bureau, le télétravailleur confiné est bien souvent un être à demi habillé, atteint d’une forme de schizophrénie vestimentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6da0ad85-90ea-3326-9558-0a64c8ebcb65",
                                        "entry_id": "104e5163-851a-352e-b02f-2059d6f7e1d7",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)…"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7586d279-b14a-4b08-8f6d-487bfdae63d1",
                                                "sense_id": "6da0ad85-90ea-3326-9558-0a64c8ebcb65",
                                                "text": "Ce qui est moins anodin : les effets du thé bien infusé. Le thé peu infusé réveille. Trop infusé, il endort. Comment expliquer la schizophrénie du sachet de thé ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
