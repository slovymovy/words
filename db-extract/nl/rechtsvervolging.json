                                "target_senses": [
                                    {
                                        "sense_id": "adb922c5-e4f2-34cd-b64f-880d9576a38f",
                                        "entry_id": "2c5447bc-a504-3ddd-890c-833dd421c149",
                                        "glosses": [
                                            "Vexation, poursuite injuste et violente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1447a578-a637-4630-856e-48729bd371ad",
                                                "sense_id": "adb922c5-e4f2-34cd-b64f-880d9576a38f",
                                                "text": "Le parti socialiste allemand tira une force particulière de l'idée catastrophique que ses propagandistes répandaient partout et qui fut prise très au sérieux tant que les persécutions bismarckiennes maintinrent un esprit belliqueux dans les groupes."
                                            },
                                            {
                                                "example_id": "ec464fe2-eb40-475a-83da-3a2be02bee7b",
                                                "sense_id": "adb922c5-e4f2-34cd-b64f-880d9576a38f",
                                                "text": "J’ai déjà fait voir, dans le premier chapitre, combien la persécution révolutionnaire est disposée à survivre aux jésuites."
                                            },
                                            {
                                                "example_id": "d42ef0ff-e45c-4a5c-b3b3-6245c9d58bb2",
                                                "sense_id": "adb922c5-e4f2-34cd-b64f-880d9576a38f",
                                                "text": "Il y a l'abbé Fortier, ce monarchiste rigide, qui bien certainement ne voudra pas se transformer en prêtre constitutionnel, et qui préférera la persécution au serment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986ea08f-c175-389b-bf5e-8be03d4a9c99",
                                        "entry_id": "2c5447bc-a504-3ddd-890c-833dd421c149",
                                        "glosses": [
                                            "Importunité continuelle dont on se trouve fatigué."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1413205-4c65-47f6-9857-3f956feca01f",
                                                "sense_id": "986ea08f-c175-389b-bf5e-8be03d4a9c99",
                                                "text": "Il revient sans cesse à la charge : c’est une persécution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
