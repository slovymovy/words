                    },
                    {
                        "sense_id": "25d1e996-fa34-3043-92a6-71e109d2b16b",
                        "entry_id": "11fa65f9-3318-3633-91e3-83332758ac4c",
                        "glosses": [
                            "A telegraphic device with a flexible metal tongue for producing clicks like those of the sounder."
