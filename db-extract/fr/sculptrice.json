                                                "sense_id": "6246f4b7-5049-3116-b60f-b561d198948d",
                                                "text": "Die Bildhauerin arbeitet momentan an einer Büste von Herkules."
                                            },
                                            {
                                                "example_id": "a63de67e-4ba4-43e0-9272-2775f3f222ff",
                                                "sense_id": "6246f4b7-5049-3116-b60f-b561d198948d",
                                                "text": "„Die Bildhauerin Sibylle Pasche liebt ihr traditionsreiches Handwerk jenseits des Mainstreams.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66bce195-890b-4f11-b8bc-75a97cadfdb4",
                        "source_entry_id": "89597711-27c0-3c8d-8b36-8d7bfa01ebbb",
