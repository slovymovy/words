{
    "word_family": [
        "chaser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28d5add9-546e-3a36-980b-5a0bdfe0a98f",
                    "sense_definition": "To follow someone or something quickly in order to catch them.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pursuit_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog likes to <chase> the cat around the garden.",
                            "target_lang_translations": {
                                "ru": "Собака любит <гоняться> за кошкой по саду.",
                                "zh": "那只狗喜欢在花园里<w>追赶</w>猫。"
                            }
                        },
                        {
                            "text": "Police officers had to <chase> the suspect on foot.",
                            "target_lang_translations": {
                                "ru": "Полицейским пришлось <преследовать> подозреваемого пешком.",
                                "zh": "警察不得不徒步<w>追捕</w>嫌疑人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pursue",
                        "run after"
                    ],
                    "common_phrases": [
                        "chase after",
                        "chase down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро следовать за кем-то или чем-то с целью поймать.",
                        "zh": "为了抓住某人或某物而快速跟随。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "гнаться с целью поимки"
                            },
                            {
                                "target_lang_word": "гнаться",
                                "target_lang_sense_clarification": "бежать следом, стараясь настичь"
                            },
                            {
                                "target_lang_word": "погнаться",
                                "target_lang_sense_clarification": "начать преследование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追赶",
                                "target_lang_sense_clarification": "快速跟随以试图抓住"
                            },
                            {
                                "target_lang_word": "追逐",
                                "target_lang_sense_clarification": "在后面追赶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0addb09-86bb-3652-a17f-96e27f0f6a00",
                    "sense_definition": "To try hard to obtain or achieve something, such as a goal, success, or a victory.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pursuit_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team is <chasing> their first major win of the season.",
                            "target_lang_translations": {
                                "ru": "Команда <гонится> за своей первой крупной победой в сезоне.",
                                "zh": "该队正在<w>追求</w>本赛季的首场重大胜利。"
                            }
                        },
                        {
                            "text": "She moved to the city to <chase> her dreams of becoming an actress.",
                            "target_lang_translations": {
                                "ru": "Она переехала в город, чтобы <погнаться> за своей мечтой стать актрисой.",
                                "zh": "她搬到城市去<w>追逐</w>她成为演员的梦想。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pursue",
                        "seek",
                        "go after"
                    ],
                    "common_phrases": [
                        "chase a dream",
                        "chase success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упорно пытаться получить или достичь чего-либо, например цели, успеха или победы.",
                        "zh": "努力获取或实现某事，如目标、成功或胜利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнаться",
                                "target_lang_sense_clarification": "перен. стремиться к достижению чего-либо"
                            },
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "добиваться цели или мечты"
                            },
                            {
                                "target_lang_word": "охотиться",
                                "target_lang_sense_clarification": "искать или добиваться чего-то труднодоступного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追求",
                                "target_lang_sense_clarification": "努力寻找或争取"
                            },
                            {
                                "target_lang_word": "追逐",
                                "target_lang_sense_clarification": "比喻对目标或梦想的执着"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d26dd776-80d0-31e4-bead-fc69dccd69bc",
                    "sense_definition": "To persistently pursue someone as a romantic partner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pursuit_romantic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole summer <chasing> a girl he met at the beach.",
                            "target_lang_translations": {
                                "ru": "Он провел все лето, <бегая> за девушкой, которую встретил на пляже.",
                                "zh": "他整个夏天都在<w>追求</w>他在海滩上遇到的那个女孩。"
                            }
                        },
                        {
                            "text": "Stop <chasing> people who are not interested in you.",
                            "target_lang_translations": {
                                "ru": "Перестань <добиваться> людей, которым ты не интересен.",
                                "zh": "别再<w>纠缠</w>那些对你不感兴趣的人了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pursue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настойчиво добиваться чьего-либо внимания как романтического партнера.",
                        "zh": "执着地追求某人作为浪漫伴侣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бегать",
                                "target_lang_sense_clarification": "разг. настойчиво ухаживать"
                            },
                            {
                                "target_lang_word": "добиваться",
                                "target_lang_sense_clarification": "стремиться к отношениям"
                            },
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "неотступно следовать, не давать прохода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追求",
                                "target_lang_sense_clarification": "向某人示爱或试图建立恋爱关系"
                            },
                            {
                                "target_lang_word": "纠缠",
                                "target_lang_sense_clarification": "指过分且令人困扰的追求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efc33df5-298d-301e-a0b9-c7d1ff897f1b",
                    "sense_definition": "To consume a mild beverage immediately after drinking strong liquor to wash away the taste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drank a shot of tequila and <chased> it with a cold beer.",
                            "target_lang_translations": {
                                "ru": "Он выпил стопку текилы и <запил> её холодным пивом.",
                                "zh": "他喝了一杯龙舌兰酒，然后<w>用</w>冰啤酒冲淡了味道。"
                            }
                        },
                        {
                            "text": "I need some water to <chase> this strong medicine.",
                            "target_lang_translations": {
                                "ru": "Мне нужна вода, чтобы <запить> это сильное лекарство.",
                                "zh": "我需要些水来<w>送服</w>这苦药。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chase with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпить легкий напиток сразу после крепкого алкоголя, чтобы перебить вкус.",
                        "zh": "在喝烈酒或吃药后立即喝点温和的饮料以冲淡味道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запивать",
                                "target_lang_sense_clarification": "пить жидкость после приема чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "送服",
                                "target_lang_sense_clarification": "指用水或饮料配合药物服用"
                            },
                            {
                                "target_lang_word": "冲淡",
                                "target_lang_sense_clarification": "通过喝其他液体来减弱口感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7503be9b-8681-3262-996b-881155c78174",
                    "sense_definition": "To decorate metal by engraving or embossing patterns onto its surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metalwork",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silversmith carefully <chased> a floral design onto the cup.",
                            "target_lang_translations": {
                                "ru": "Серебряных дел мастер аккуратно <вычеканил> цветочный узор на чаше.",
                                "zh": "银匠在杯子上小心地<w>錾刻</w>了花卉图案。"
                            }
                        },
                        {
                            "text": "This antique bowl is beautifully <chased> with intricate details.",
                            "target_lang_translations": {
                                "ru": "Эта старинная чаша красиво <украшена чеканкой> с замысловатыми деталями.",
                                "zh": "这只古董碗上<w>錾刻</w>着精美的细节。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать металл путем гравировки или чеканки узоров на его поверхности.",
                        "zh": "通过在金属表面雕刻或压印图案来装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чеканить",
                                "target_lang_sense_clarification": "выбивать узор на металле"
                            },
                            {
                                "target_lang_word": "гравировать",
                                "target_lang_sense_clarification": "вырезать узор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "錾刻",
                                "target_lang_sense_clarification": "金属工艺中的雕刻技法"
                            },
                            {
                                "target_lang_word": "浮雕",
                                "target_lang_sense_clarification": "通过压印形成的装饰效果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06d58bcf-2c62-3d56-a3de-8a515f6e3b35",
                    "sense_definition": "The act of following someone or something quickly in order to catch them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pursuit_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police car was involved in a high-speed <chase> on the highway.",
                            "target_lang_translations": {
                                "ru": "Полицейская машина участвовала в скоростной <погоне> на шоссе.",
                                "zh": "警车在高速公路上参与了一场高速<w>追逐</w>。"
                            }
                        },
                        {
                            "text": "After a long <chase>, the fox finally escaped into the woods.",
                            "target_lang_translations": {
                                "ru": "После долгой <погони> лиса наконец скрылась в лесу.",
                                "zh": "经过长时间的<w>追逐</w>，狐狸最终逃进了树林。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give chase",
                        "car chase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по быстрому преследованию кого-то или чего-то с целью поимки.",
                        "zh": "为了抓住某人或某物而进行的快速追赶行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погоня",
                                "target_lang_sense_clarification": "стремительное преследование"
                            },
                            {
                                "target_lang_word": "преследование",
                                "target_lang_sense_clarification": "процесс следования за кем-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追逐",
                                "target_lang_sense_clarification": "追赶的过程"
                            },
                            {
                                "target_lang_word": "追捕",
                                "target_lang_sense_clarification": "特指警察对嫌疑人的追赶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8365849c-c72e-37dc-a6b9-7517e97f39f2",
                    "sense_definition": "A children's game where one player runs after others to try to catch or touch them.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played <chase> in the park until it got dark.",
                            "target_lang_translations": {
                                "ru": "Дети играли в <догонялки> в парке до темноты.",
                                "zh": "孩子们在公园里玩<w>捉人游戏</w>直到天黑。"
                            }
                        },
                        {
                            "text": "We used to play <chase> during recess at school.",
                            "target_lang_translations": {
                                "ru": "Мы раньше играли в <салки> на переменах в школе.",
                                "zh": "我们以前在学校课间休息时常玩<w>捉人游戏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "game",
                        "tag"
                    ],
                    "common_phrases": [
                        "play chase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детская игра, в которой один игрок бегает за другими, пытаясь их поймать или коснуться.",
                        "zh": "一种儿童游戏，一名玩家跑着去抓或触碰其他人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "догонялки",
                                "target_lang_sense_clarification": "детская игра"
                            },
                            {
                                "target_lang_word": "салки",
                                "target_lang_sense_clarification": "разновидность игры в догонялки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捉人游戏",
                                "target_lang_sense_clarification": "常见的儿童追逐游戏"
                            },
                            {
                                "target_lang_word": "抓人",
                                "target_lang_sense_clarification": "指代此类游戏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72f7c43c-438f-30ce-a57b-93e9b585accb",
                    "sense_definition": "A groove, channel, or hollow space in a wall or floor used to encase pipes or wires.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electrician cut a <chase> into the brickwork to hide the cables.",
                            "target_lang_translations": {
                                "ru": "Электрик прорезал <штробу> в кирпичной кладке, чтобы спрятать кабели.",
                                "zh": "电工在砖墙上切开一道<w>线槽</w>来隐藏电缆。"
                            }
                        },
                        {
                            "text": "Pipes were run through a vertical <chase> behind the bathroom wall.",
                            "target_lang_translations": {
                                "ru": "Трубы были проложены через вертикальный <канал> за стеной ванной.",
                                "zh": "管道穿过浴室墙后的一道垂直<w>管槽</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Паз, канал или углубление в стене или полу для прокладки труб или проводов.",
                        "zh": "墙壁或地板上的凹槽，用于埋设管道或电线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штроба",
                                "target_lang_sense_clarification": "строительный термин: канавка для коммуникаций"
                            },
                            {
                                "target_lang_word": "паз",
                                "target_lang_sense_clarification": "выемка или углубление"
                            },
                            {
                                "target_lang_word": "канал",
                                "target_lang_sense_clarification": "скрытая полость для труб"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "线槽",
                                "target_lang_sense_clarification": "用于隐藏电线的通道"
                            },
                            {
                                "target_lang_word": "管槽",
                                "target_lang_sense_clarification": "用于埋设管道的凹槽"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
