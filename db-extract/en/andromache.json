                                        "entry_id": "77b8b236-8d75-376b-8eaa-dc84b4fe7421",
                                        "glosses": [
                                            "Femme d’Hector durant la guerre de Troie, fille d’Éétion."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "010e4248-00d0-4f9f-a67d-6ff3c14a7c35",
                                                "sense_id": "c3bce824-bb94-3f5e-a4bc-72917a221d2d",
                                                "text": "Andromaque était belle et toujours touchante, comme il se doit (en réalité, c’était une tigresse qui avait fait tuer un enfant à la place de son fils)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0c9ab71-3625-3a25-ba58-6e5512ce6f4a",
                                        "entry_id": "77b8b236-8d75-376b-8eaa-dc84b4fe7421",
                                        "glosses": [
                                            "(175) Andromaque, internationalement (175) Andromache, planète mineure de la ceinture principale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
