                    {
                        "translation_id": "e64513c9-01a1-4e80-b56a-3f17298e8c83",
                        "source_entry_id": "b39454db-687e-3b61-a4c9-a59d98bc59a1",
                        "source_sense_id": "22dd58bb-6c41-3df2-b12a-2f01b85d1c89",
