                "senses": [
                    {
                        "sense_id": "e978a4ad-9c0d-37b4-8ee8-370989220f34",
                        "entry_id": "df97c4ec-641a-31bd-8b6f-aecc04b099bb",
                        "glosses": [
                            "Ecclésiastique anglais, prêtre dans l’église anglicane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ee8e6a-2312-4fff-81d4-5fdd8848bc5b",
                                "sense_id": "e978a4ad-9c0d-37b4-8ee8-370989220f34",
                                "text": "Pierrot ramasse le mouchoir, essuie les yeux du clergyman et le mouche. Puis il se mouche aussi, en déployant le mouchoir."
                            },
                            {
                                "example_id": "d63f51b4-c1d5-4151-b9fb-5e91d83adbc4",
                                "sense_id": "e978a4ad-9c0d-37b4-8ee8-370989220f34",
                                "text": "Entre un homme d’une cinquantaine d'années vêtu d’un costume sombre et strict comme celui d’un clergyman, chemise blanche et cravate noire, un air de componction et de suffisance, le visage rose et les cheveux gris teintés de violet."
                            }
                        ]
                    },
                    {
                        "sense_id": "60549dae-ae3e-3591-a6d8-32bdd9a9537e",
                        "entry_id": "df97c4ec-641a-31bd-8b6f-aecc04b099bb",
                        "glosses": [
                            "Nom de l'habit porté par certains prêtres. Il consiste d'une veste de couleur sombre (noire ou grise) et d'une chemise fermée par une collerette dite col romain. Le clergyman remplace souvent la soutane depuis le concile Vatican II."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "742ea57b-e697-4e80-95f1-e795895e1692",
                        "source_entry_id": "df97c4ec-641a-31bd-8b6f-aecc04b099bb",
                        "target_lang_word": "clergyman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clergyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                        "entry_id": "a86a902f-de41-3127-9379-3ac45148de20",
                                        "glosses": [
                                            "A male member of a clergy; especially, an ordained (male) Christian minister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7437b683-e12e-4ea7-be01-17ce19297c45",
                                                "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                                "text": "Holonym: clergy"
                                            },
                                            {
                                                "example_id": "4b5269bd-82af-46db-88dd-f7fc0eb55d34",
                                                "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                                "text": "I think if post commanders of the unchaplained posts could employ acceptable clergymen […] then the needs might be met."
                                            },
                                            {
                                                "example_id": "6968f2f4-048f-41a3-a89c-3dacffd6ffb7",
                                                "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                                "text": "The king experienced his first attack in autumn 1788, and as his condition worsened and the physicians-in-ordinary proved unable to cope or cure, the Reverend Dr Francis Willis (1717–1807), a clergyman doctor who ran a madhouse in Lincolnshire, was called in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e27ec9f-243f-4cca-a8bb-9afa3657d58f",
                        "source_entry_id": "df97c4ec-641a-31bd-8b6f-aecc04b099bb",
                        "target_lang_word": "priest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                        "entry_id": "a8c44922-8cb0-384e-9064-cdd173d1c253",
                                        "glosses": [
                                            "A religious clergyman (clergywoman, clergyperson) who is trained to perform services or sacrifices at a church or temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93341e8a-44f3-4f95-b7cc-a1d10280d18d",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "The priest at the Catholic church heard his confession."
                                            },
                                            {
                                                "example_id": "669057ab-b4ae-462d-9903-79d834fb901a",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "The Shinto priest burnt incense for his ancestors."
                                            },
                                            {
                                                "example_id": "b8b8f450-b8cd-41cd-b982-d4a60ab2d3d9",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "The Israelite priests were descended from Moses' brother Aaron."
                                            },
                                            {
                                                "example_id": "e028db96-9316-4e65-ac3a-f1ead79ee4d4",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305009a5-9fb5-3872-8562-1192a993aab2",
                                        "entry_id": "a8c44922-8cb0-384e-9064-cdd173d1c253",
                                        "glosses": [
                                            "A blunt tool, used for quickly stunning and killing fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e86ebe-f013-4a4e-922e-48663c4f685e",
                                                "sense_id": "305009a5-9fb5-3872-8562-1192a993aab2",
                                                "text": "They flop and struggle, but she unhooks them swiftly, stunning them with a small brass priest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4404b956-4504-39d4-a420-912536e15feb",
                                        "entry_id": "a8c44922-8cb0-384e-9064-cdd173d1c253",
                                        "glosses": [
                                            "The highest office in the Aaronic priesthood."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "priest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a2c7ad-87b7-3157-8c7c-381b1306f840",
                                        "entry_id": "13dda2c7-93fa-3574-99f4-7ce47856907e",
                                        "glosses": [
                                            "To ordain as a priest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6856fbf2-3168-4d39-b963-642e4cd1aa5f",
                                                "sense_id": "d4a2c7ad-87b7-3157-8c7c-381b1306f840",
                                                "text": "If there bee any lasie fellow, any that cannot away with worke, any that would wallow in pleasures, hee is hastie to be priested. And when hee is made one, and has gotten a benefice, he consorts with his neighbour priests, who are altogether given to pleasures; and then both hee, and they, live, not like Christians, but like epicures; drinking, eating, feasting, and revelling, till the cow come home, as the saying is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
