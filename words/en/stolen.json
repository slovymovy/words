{
    "word_family": [
        "steal",
        "stealer",
        "stealing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7069a96-70a2-375b-8dd9-e550b75fe120",
                    "sense_definition": "The past participle of <w>steal</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My bicycle has been <stolen> from the rack outside.",
                            "target_lang_translations": {
                                "ru": "Мой велосипед был <украден> со стойки на улице.",
                                "zh": "我的自行车在外面停车架上<w>被偷</w>了。"
                            }
                        },
                        {
                            "text": "She realized she had <stolen> the wrong bag by mistake.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что по ошибке <украла> не ту сумку.",
                                "zh": "她意识到自己不小心<w>偷</w>错了包。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have stolen",
                        "was stolen",
                        "get stolen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола <w>steal</w>.",
                        "zh": "动词 steal 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украденный",
                                "target_lang_sense_clarification": "причастие прошедшего времени"
                            },
                            {
                                "target_lang_word": "украсть",
                                "target_lang_sense_clarification": "глагол (инфинитив)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被偷",
                                "target_lang_sense_clarification": "被动语态下的动作"
                            },
                            {
                                "target_lang_word": "偷走",
                                "target_lang_sense_clarification": "完成动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52b11a59-08c3-30ea-9d5e-4958214a1c32",
                    "sense_definition": "Describing something that has been taken from its owner without permission or legal right.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found the <stolen> car abandoned in a ditch.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла <украденную> машину брошенной в канаве.",
                                "zh": "警察发现那辆<w>被盗</w>的汽车被遗弃在沟里。"
                            }
                        },
                        {
                            "text": "He was charged with possession of <stolen> property.",
                            "target_lang_translations": {
                                "ru": "Ему предъявили обвинение в хранении <краденого> имущества.",
                                "zh": "他被指控持有<w>赃</w>物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nicked",
                        "lifted",
                        "hot"
                    ],
                    "antonyms": [
                        "returned",
                        "retrieved"
                    ],
                    "common_phrases": [
                        "stolen goods",
                        "stolen property",
                        "stolen vehicle",
                        "stolen moments"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает что-то, что было отнято у владельца без разрешения или законного права.",
                        "zh": "形容未经许可或法律允许从所有者处拿走的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краденый",
                                "target_lang_sense_clarification": "прилагательное"
                            },
                            {
                                "target_lang_word": "украденный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "ворованный",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被盗的",
                                "target_lang_sense_clarification": "形容词，指被偷窃的物品"
                            },
                            {
                                "target_lang_word": "赃",
                                "target_lang_sense_clarification": "指非法所得的财物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09c60342-5abe-3390-a72a-31e29d26cdee",
                    "sense_definition": "An item or vehicle that has been taken illegally.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang was driving around in <stolens> all night.",
                            "target_lang_translations": {
                                "ru": "Банда всю ночь разъезжала на <ворованных тачках>.",
                                "zh": "那个团伙整晚都在开着<w>黑车</w>到处转悠。"
                            }
                        },
                        {
                            "text": "Police are cracking down on the trade of <stolens> in the city.",
                            "target_lang_translations": {
                                "ru": "Полиция принимает жесткие меры против торговли <краденым> в городе.",
                                "zh": "警方正在严厉打击城里的<w>赃物</w>交易。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often refers specifically to stolen cars"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или транспортное средство, которые были незаконно изъяты.",
                        "zh": "非法获取的物品或车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краденое",
                                "target_lang_sense_clarification": "существительное (об украденных вещах)"
                            },
                            {
                                "target_lang_word": "угон",
                                "target_lang_sense_clarification": "сленг (об угнанном автомобиле)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赃物",
                                "target_lang_sense_clarification": "名词，指被盗物品"
                            },
                            {
                                "target_lang_word": "黑车",
                                "target_lang_sense_clarification": "俚语，指被盗车辆"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}