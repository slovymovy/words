                        "entry_id": "4fe4364f-0baa-3445-8ef2-7746b1cb69cf",
                        "glosses": [
                            "Any of various herbs of the family Gentianaceae found in temperate and mountainous regions with violet or blue flowers."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "a7cc501a-1b43-41e0-ada2-48b6c051b423",
                                "sense_id": "92f71a59-acc4-3e95-ad05-ccc2a4bde891",
                                "text": "On the cover of the leaflet advertising the Alpenrose Gasthof in Zirl am Gurgl […] there is a decorative picture of a young woman. […] She has bright flaxen hair and laughing eyes of the same hue as the gentians in the meadow beyond the inn."
                            }
                        ]
                    },
                    {
                        "sense_id": "0538989a-0bcc-38cc-a817-71e76e95dfe2",
                        "entry_id": "4fe4364f-0baa-3445-8ef2-7746b1cb69cf",
                        "glosses": [
                            "Dried roots and rhizome of European gentian (Gentiana lutea), used as a tonic."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
