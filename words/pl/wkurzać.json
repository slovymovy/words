                    "sense_definition": "powodować u kogoś silne zdenerwowanie lub gniew",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciągłe spóźnienia kolegi bardzo mnie <w>wkurzają</w>.",
                            "target_lang_translations": {
