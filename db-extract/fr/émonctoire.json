                                        "glosses": [
                                            "Pertaining to the elimination of waste from the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0148effa-da6c-4425-93f3-f2a89a0b9324",
                                                "sense_id": "b45f4197-4c8b-3e18-8e21-8c1426f9895d",
                                                "text": "A mixture of poor diet and poor hygiene caused him inflammation of the emunctory aperture."
                                            },
                                            {
                                                "example_id": "43efd0f6-d4e3-49bb-b0f0-5ae9c93e634b",
                                                "sense_id": "b45f4197-4c8b-3e18-8e21-8c1426f9895d",
                                                "text": "This guy was extremely hirsute. Everywhere. So much I used to wonder how he could clearly manage certain emunctory functions."
                                            }
