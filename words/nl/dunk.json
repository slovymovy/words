    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f6c31504-2fda-31cf-a6ba-b76dcd4058b5",
                    "sense_definition": "mening of oordeel over de waarde van iemand of iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar heeft een hoge <w>dunk</w> van de capaciteiten van zijn studenten.",
                            "target_lang_translations": {
                                "en": "The teacher has a high <w>opinion</w> of his students' abilities."
                            }
                        },
                        {
                            "text": "Zij heeft geen hoge <w>dunk</w> van het nieuwe beleid van de directie.",
                            "target_lang_translations": {
                                "en": "She does not have a high <w>regard</w> for management's new policy."
                            }
                        }
                    ],
                    "synonyms": [
                        "mening",
                        "opinie",
                        "oordeel"
                    ],
                    "common_phrases": [
                        "hoge dunk",
                        "geen hoge dunk"
                    ],
                    "target_lang_definitions": {
                        "en": "opinion or estimation of the worth or qualities of someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "opinion",
                                "target_lang_sense_clarification": "estimation or view of someone's qualities"
                            },
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "esteem or estimation"
                            },
                            {
                                "target_lang_word": "esteem",
                                "target_lang_sense_clarification": "respect and admiration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "289088bd-3092-395f-b4c0-7543072b3dc9",
                    "sense_definition": "sprong bij basketbal waarbij de bal krachtig van bovenaf direct in de basket wordt geduwd",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De speler maakte een spectaculaire <w>dunk</w> net voor het fluitsignaal.",
                            "target_lang_translations": {
                                "en": "The player made a spectacular <w>dunk</w> just before the final whistle."
                            }
                        },
                        {
                            "text": "Het publiek juichte luid na de krachtige <w>dunk</w> van de basketballer.",
                            "target_lang_translations": {
                                "en": "The crowd cheered loudly after the basketball player's powerful <w>dunk</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slam dunk"
                    ],
                    "common_phrases": [
                        "spectaculaire dunk"
                    ],
                    "target_lang_definitions": {
                        "en": "a basketball shot in which a player jumps and forcefully thrusts the ball directly down through the basket"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dunk",
                                "target_lang_sense_clarification": "basketball shot"
                            },
                            {
                                "target_lang_word": "slam dunk",
                                "target_lang_sense_clarification": "emphatic basketball shot"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d88f4f1-6dec-3b84-9003-4a63b7b58aa7",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>dunken</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mij <w>dunk</w> dat we hier niet langer over moeten twijfelen.",
                            "target_lang_translations": {
                                "en": "It <w>seems to me</w> that we shouldn't hesitate about this any longer."
                            }
                        },
                        {
                            "text": "Zoals mij <w>dunk</w>, is er een betere oplossing voorhanden.",
                            "target_lang_translations": {
                                "en": "As it <w>seems to me</w>, there is a better solution available."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present indicative of 'dunken' (to seem, to think)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seems to me",
                                "target_lang_sense_clarification": "used impersonally with indirect object"
                            },
                            {
                                "target_lang_word": "methinks",
                                "target_lang_sense_clarification": "archaic expression for 'it seems to me'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89c164b6-184e-3396-917c-9b854ef27109",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>dunken</w> (bij inversie)",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat <w>dunk</w> je van dit merkwaardige voorstel?",
                            "target_lang_translations": {
                                "en": "What do you <w>think</w> of this peculiar proposal?"
                            }
                        },
                        {
                            "text": "Hoe <w>dunk</w> je over de voortgang van het project?",
                            "target_lang_translations": {
                                "en": "What do you <w>think</w> about the progress of the project?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present indicative of 'dunken' in inversion (do you think / does it seem to you)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "think",
                                "target_lang_sense_clarification": "in questions asking for an opinion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ddb5998-db72-38b8-9327-5655c830485e",
                    "sense_definition": "gebiedende wijs van <w>dunken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dunk</w> niet te licht over zulke ingewikkelde kwesties.",
                            "target_lang_translations": {
                                "en": "Do not <w>judge</w> such complex matters too lightly."
                            }
                        },
                        {
                            "text": "<w>Dunk</w> er het uwe van, maar handel altijd voorzichtig.",
                            "target_lang_translations": {
                                "en": "<w>Think</w> what you will of it, but always act with caution."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "zeer ongebruikelijk in hedendaags Nederlands"
                        },
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative of 'dunken' (judge, deem, think)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "judge",
                                "target_lang_sense_clarification": "form an opinion or think"
                            },
                            {
                                "target_lang_word": "think",
                                "target_lang_sense_clarification": "consider or judge"
                            }
                        ]
                    }
                }
            ]
        }
    ]
