                                "target_senses": [
                                    {
                                        "sense_id": "dd6e7415-8d00-3702-b271-039327e9f5c4",
                                        "entry_id": "448d1075-c461-3848-9539-28d9fd2a7ef2",
                                        "glosses": [
                                            "Rough and irregular; jagged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e576f73d-74bd-420c-af6f-7852a5c35081",
                                                "sense_id": "dd6e7415-8d00-3702-b271-039327e9f5c4",
                                                "text": "Her tender arms the angry sharpness rue\nOf many a scraggy thorn and envious brier;"
                                            },
                                            {
                                                "example_id": "b694edb6-f9fc-4705-893a-69ee39d51da1",
                                                "sense_id": "dd6e7415-8d00-3702-b271-039327e9f5c4",
                                                "text": "[H]e grasped the rock. It was scraggy, and though it tore and bruised him he clung to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887bdff9-bf1f-3aa9-9c68-7a8f43bcace1",
                                        "entry_id": "448d1075-c461-3848-9539-28d9fd2a7ef2",
                                        "glosses": [
                                            "Lean or thin, scrawny."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f6c223-ec38-42f9-a460-00dcb3104c79",
                                                "sense_id": "887bdff9-bf1f-3aa9-9c68-7a8f43bcace1",
                                                "text": "On one of these occasions, he presented for the first time to Mannering his tall, gaunt, awkward, bony figure, attired in a threadbare suit of black, with a coloured handkerchief, not over clean, about his sinewy, scraggy neck."
                                            },
                                            {
                                                "example_id": "842f8cdb-98aa-4370-ada7-f0b15cfd356b",
                                                "sense_id": "887bdff9-bf1f-3aa9-9c68-7a8f43bcace1",
                                                "text": "He is twenty years younger, but has something of the same spare, scraggy physique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
