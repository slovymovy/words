                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn leaves remind us of the <w>impermanence</w> of youth and beauty."
                        },
                        {
                            "text": "Living through the crisis made her reflect deeply on the <w>impermanence</w> of life."
                        }
                    ],
