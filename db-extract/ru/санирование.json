                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e41f85cd-5607-38d4-8f79-e615eabd5bd8",
                                        "entry_id": "4d3b798a-6529-3aff-8732-d64835d830a0",
                                        "glosses": [
                                            "das Wiederherstellen eines geordneten Zustandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9181db99-55ce-49ff-8dbc-a0117b381863",
                                                "sense_id": "e41f85cd-5607-38d4-8f79-e615eabd5bd8",
                                                "text": "Der Erfolg der Sanierung [des Erdbodens] muss mit geeigneten Messverfahren nachgewiesen werden, evtl. mit wiederkehrenden Messungen (z. B. die dauerhafte Wirksamkeit der Sicherung)."
                                            },
                                            {
                                                "example_id": "1dc8a694-b2ff-490c-a176-78b27fd4ad80",
                                                "sense_id": "e41f85cd-5607-38d4-8f79-e615eabd5bd8",
                                                "text": "„Das mag auch besonders den Zorn Ludwigs XV. erregt haben, der zwar ein recht sündiger Herrscher, doch ein sehr gläubiger König war und zum Schutz des Glaubens jedenfalls während seiner Regierungszeit bedeutend mehr tat als für die Sanierung der französischen Finanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d63f1ebe-655e-30ee-be11-1637df3f9822",
                                        "entry_id": "4d3b798a-6529-3aff-8732-d64835d830a0",
                                        "glosses": [
                                            "Erneuerung eines Gebäudes oder Bauwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c19f68-99e9-487d-85a5-23321db017f3",
                                                "sense_id": "d63f1ebe-655e-30ee-be11-1637df3f9822",
                                                "text": "Geld braucht Tschechien für die Sanierung seines teils maroden Straßennetzes dringend."
                                            },
                                            {
                                                "example_id": "903e6bce-bb14-46d8-8ec8-f8efe345ed4e",
                                                "sense_id": "d63f1ebe-655e-30ee-be11-1637df3f9822",
                                                "text": "Deshalb ist eine Sanierung mit dem denkmalpflegerischen Erhaltungsanspruch schwer vereinbar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "400edebb-dbd5-3fbe-99fb-72da2933f26b",
                                        "entry_id": "4d3b798a-6529-3aff-8732-d64835d830a0",
                                        "glosses": [
                                            "das Wiederherstellen der wirtschaftlichen Leistungsfähigkeit eines Betriebes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20f4e7c-4455-4d85-82c5-f9edc9334b48",
                                                "sense_id": "400edebb-dbd5-3fbe-99fb-72da2933f26b",
                                                "text": "Es fehle aber ein Konzept für eine »nachhaltige Sanierung des Bankensystems«. Welche Folgen das haben kann, zeigt Japan."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
