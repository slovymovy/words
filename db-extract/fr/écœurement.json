                        "examples": [
                            {
                                "example_id": "33d56ea7-df50-4fa0-9eac-dfc6c2f2ec5a",
                                "sense_id": "f3fe9b19-0b0e-3210-9a08-ca6b749e917f",
                                "text": "Du coup, d'un point de vue physique : toucher la peau de l'autre, mettre la sienne à disposition, ouvrir ses cuisses, son ventre, son corps entier à l'odeur de l'étranger, l'écœurement corporel à surmonter ne me posait pas de problème.",
                                "translation": "King Kong Theory",
                                "english": "King Kong Theory"
                            },
                            {
                                "example_id": "17c0b73d-ab10-4cd6-bd11-dfaceefa7c1a",
                                "sense_id": "f3fe9b19-0b0e-3210-9a08-ca6b749e917f",
                                "text": "Cette agression ultra-violente, à laquelle il n’a pas survécu, a provoqué le chagrin, l’incompréhension et l’écœurement de toute une ville qui pleure un garçon unanimement décrit comme « joyeux et généreux »."
                            }
                        ]
                    }
