                        "entry_id": "a39ab237-d1b2-37c8-9d36-8d64c019c5c7",
                        "glosses": [
                            "истор. титул принцев австрийской императорской фамилии в 1453 - 1918 гг."
                        ],
                        "tags": [],
                        "examples": [
