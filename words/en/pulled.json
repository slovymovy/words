{
    "word_family": [
        "pull",
        "puller",
        "pullover",
        "pullout"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f7789ac-5099-3ff7-ac32-8c886997555c",
                    "sense_definition": "Simple past and past participle of <w>pull</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pulled</w> the heavy door open to let everyone inside.",
                            "target_lang_translations": {
                                "ru": "Он <w>потянул</w> тяжелую дверь на себя, чтобы впустить всех внутрь.",
                                "zh": "他<w>拉</w>开沉重的大门，让大家进去。"
                            }
                        },
                        {
                            "text": "The driver <w>pulled</w> over to the side of the road to check the map.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>съехал</w> на обочину дороги, чтобы свериться с картой.",
                                "zh": "司机把车<w>靠边</w>停下，查看地图。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pulled over",
                        "pulled out",
                        "pulled together",
                        "pulled off"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени глагола <w>pull</w> (тянуть).",
                        "zh": "动词 pull 的过去式和过去分词，表示用力拉或拖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потянул",
                                "target_lang_sense_clarification": "совершенное действие"
                            },
                            {
                                "target_lang_word": "тянул",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "тащил",
                                "target_lang_sense_clarification": "перемещал с усилием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉",
                                "target_lang_sense_clarification": "用力牵引"
                            },
                            {
                                "target_lang_word": "拖",
                                "target_lang_sense_clarification": "用力拉动重物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b94ee20d-075b-35e3-bd63-337f7c2daaf1",
                    "sense_definition": "Of cooked meat, prepared by being cooked slowly and torn into shreds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a sandwich filled with spicy <w>pulled</w> pork and coleslaw.",
                            "target_lang_translations": {
                                "ru": "Мы заказали сэндвич с острой <w>рваной</w> свининой и салатом коул-слоу.",
                                "zh": "我们点了一个夹着辣味<w>手撕</w>猪肉和卷心菜沙拉的三明治。"
                            }
                        },
                        {
                            "text": "The chef prepared delicious <w>pulled</w> chicken tacos for the party.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил вкусные тако с <w>рваной</w> курицей для вечеринки.",
                                "zh": "厨师为派对准备了美味的<w>手撕</w>鸡肉塔可。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shredded"
                    ],
                    "common_phrases": [
                        "pulled pork",
                        "pulled chicken",
                        "pulled beef",
                        "pulled meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "О приготовленном мясе: томленое и разобранное на волокна.",
                        "zh": "指烹饪后的肉类，经过长时间慢炖并撕成肉丝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рваный",
                                "target_lang_sense_clarification": "кулинарный термин (о мясе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手撕",
                                "target_lang_sense_clarification": "烹饪术语，指将肉撕成丝"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}