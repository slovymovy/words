                ],
                "senses": [
                    {
                        "sense_id": "3150538d-9dfb-39f4-b899-424c5fc8dfdb",
                        "entry_id": "4c341f16-51c3-3aac-b2e6-671fc196f2ae",
                        "glosses": [
                            "Qui assomme, au sens figuré."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "21e6e0a2-f32c-4ce3-b994-b3827eca3efb",
                                "sense_id": "3150538d-9dfb-39f4-b899-424c5fc8dfdb",
                                "text": "Et où t'en iras-tu, mon pauvre Charencey, pour esquiver l'ennui? dit un officier […] : ce vieux monde est partout le même, c'est-à-dire assommant."
                            },
                            {
                                "example_id": "5a1e6953-52cc-4474-b29a-1dd38cd09051",
                                "sense_id": "3150538d-9dfb-39f4-b899-424c5fc8dfdb",
                                "text": "Le commissaire.— Zut ! à la fin ! C’est assommant ! On ne peut pas être tranquille une minute, avec vous !"
                            },
                            {
                                "example_id": "90eb5e3b-f5da-42f5-8556-2a091bdc59ed",
                                "sense_id": "3150538d-9dfb-39f4-b899-424c5fc8dfdb",
                                "text": "Il y a beaucoup de vieilles filles autour de moi ! Je les trouve assommantes. Elles ont des idées étroites dans l’esprit et du coton dans les oreilles…"
                            },
                            {
                                "example_id": "18357ad9-43d6-42e4-93a3-cc60902f3f57",
                                "sense_id": "3150538d-9dfb-39f4-b899-424c5fc8dfdb",
                                "text": "Sans doute est-ce pour mieux rompre en visière avec des revues grisailleuses et assommantes que l’animateur Ayguesparse fonde en 1945 Marginales dont la centième livraison date de 1965."
                            }
                        ]
                    }
                ],
