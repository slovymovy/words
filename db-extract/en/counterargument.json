                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9fa863c-cc1d-48a6-a396-6a5b5390934d",
                                                "sense_id": "4b3cf433-2fcc-3e97-b1df-475dce914d3a",
                                                "text": "„Er hatte weder bestimmte Anhaltspunkte noch tröstliche Gegenargumente.“"
                                            },
                                            {
                                                "example_id": "d1fd03a0-9013-4550-b70b-1c1a186a0927",
                                                "sense_id": "4b3cf433-2fcc-3e97-b1df-475dce914d3a",
                                                "text": "„Auch die Präsidin war um Gegenargumente verlegen.“"
                                            },
                                            {
                                                "example_id": "f49a4b19-4a17-4a0f-a763-d0f579238f41",
                                                "sense_id": "4b3cf433-2fcc-3e97-b1df-475dce914d3a",
                                                "text": "„Und Bilibin zog die Haut wieder auseinander, überzeugt, dass dieses Dilema durch keine Gegenargumente aus der Welt geschafft werden könne.“"
                                            }
