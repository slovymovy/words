                "senses": [
                    {
                        "sense_id": "1f6241d9-18ac-33e8-a397-0ac177f57515",
                        "entry_id": "50344cc4-5861-3a81-9743-bacd714c7feb",
                        "glosses": [
                            "künstlich, künstlerisch gestaltete Figur einer Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd75737-e042-4b42-bfb3-1d5a52b42692",
                                "sense_id": "1f6241d9-18ac-33e8-a397-0ac177f57515",
                                "text": "„Sieben allegorische Frauenfiguren verkörpern zugleich die sieben Wochentage, die sieben freien Künste, sieben Tugenden, sieben Farben, sieben Himmelskörper und sieben Metalle.“"
                            },
                            {
                                "example_id": "a0c8bf4a-4b4a-4419-b8d6-6e63053cb086",
                                "sense_id": "1f6241d9-18ac-33e8-a397-0ac177f57515",
                                "text": "„Eiferer haben, so liest man, eine bronzene Frauenfigur mit ihrem Namenszug, die im Stadtpark an sie erinnern sollte, mit Farbe übergossen und aus ihrem Sockel zu reißen versucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
