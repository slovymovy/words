                ],
                "senses": [
                    {
                        "sense_id": "3712bd4d-94bc-3857-a2a1-831f25220fdd",
                        "entry_id": "08b060d6-dc1e-36c7-bfef-0f6ba942c166",
                        "glosses": [
                            "Qui dessèche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "751dba38-0364-4e7d-9ed1-ecee06f7fba0",
                                "sense_id": "3712bd4d-94bc-3857-a2a1-831f25220fdd",
                                "text": "Un vent desséchant. — Une exhalaison desséchante."
                            },
                            {
                                "example_id": "1632429b-e484-4f2f-911a-bef7b60042f2",
                                "sense_id": "3712bd4d-94bc-3857-a2a1-831f25220fdd",
                                "text": "À mesure que le rhum vieillit, il se colore, se brunit ; il prend, avec une odeur piquante, une saveur acre & desséchante, dont la nuance empyreumatique huileuse fait dire, à ceux qui n’y sont point accoutumés, que cette liqueur sent le vieux cuir."
                            },
                            {
                                "example_id": "aee051da-22cc-40f7-a949-9efdc44bdd53",
                                "sense_id": "3712bd4d-94bc-3857-a2a1-831f25220fdd",
                                "text": "On voyait bien à la fraîcheur de son teint qu’elle restait à la maison, loin des hâles desséchants et des soleils qui mordent la peau."
                            },
                            {
                                "example_id": "c413faf5-2bba-45fc-b36c-54cd573d70e9",
                                "sense_id": "3712bd4d-94bc-3857-a2a1-831f25220fdd",
                                "text": "Le bourgeon issu d’Hedwige pousserait bien dans le tiède et humide climat Boisrosé, à l’abri de ces desséchants simouns que Pierre déplaçait dans son sillage."
                            }
                        ]
                    }
                ],
