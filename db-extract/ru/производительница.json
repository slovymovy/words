                                            {
                                                "example_id": "c2769cda-e762-431a-a8a2-707bab371e37",
                                                "sense_id": "3d078b09-536f-36b5-9f89-617deed512b9",
                                                "text": "The manufacturer produces parts for the car industry."
                                            },
                                            {
                                                "example_id": "e48ca988-d67d-47b0-9444-900645160869",
                                                "sense_id": "3d078b09-536f-36b5-9f89-617deed512b9",
                                                "text": "Always return faulty goods to the manufacturer."
                                            },
                                            {
                                                "example_id": "257d5bf2-a87f-4a98-b36e-dccf732509e7",
                                                "sense_id": "3d078b09-536f-36b5-9f89-617deed512b9",
                                                "text": "The clothing manufacturer expanded overseas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ecfc83f-769e-44f4-8f08-9bdc2bd929de",
                        "source_entry_id": "7de919ad-4253-3e82-af98-22782693601d",
                        "target_lang_word": "maker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c04054ed-ddf5-3ff8-8441-8a98d1b5d023",
                                        "entry_id": "fc467551-0668-3cc7-be59-ca82ad34af9b",
                                        "glosses": [
                                            "Someone who makes; a person or thing that makes or produces something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1573069-44f6-4428-a617-8d00ebd69556",
                                                "sense_id": "c04054ed-ddf5-3ff8-8441-8a98d1b5d023",
                                                "text": "The silhouette sharpens and fades as the carving is moved before the flames of the hearth, its maker grunts in perfect imitation of the ancestor - a human-lioness in oestrus."
                                            },
                                            {
                                                "example_id": "081fd7ff-da8f-4839-ad06-9b6e4ef1a31c",
                                                "sense_id": "c04054ed-ddf5-3ff8-8441-8a98d1b5d023",
                                                "text": "Ukrainian and foreign UAV makers rock up early at an open field in the outskirts of Kyiv, to take part in a drone competition organized by the Ministry of Digital Transformation."
                                            },
                                            {
                                                "example_id": "ea7e8678-ef9c-4740-bdd0-747bcc5a467e",
                                                "sense_id": "c04054ed-ddf5-3ff8-8441-8a98d1b5d023",
                                                "text": "There’s a good chance you’ve heard of the Ninja Creami by now. The original version of the ice cream maker has been around since 2021, but thanks to TikTok, it’s been one of the buzziest kitchen appliances lately. […] The Ninja Creami works differently than other ice cream makers on the market. Instead of a frozen bowl or a compressor, the Creami uses a spinning blade that shaves and mixes your frozen ingredients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11cbdd1d-7a7e-3d54-8227-81628ac34701",
                                        "entry_id": "fc467551-0668-3cc7-be59-ca82ad34af9b",
                                        "glosses": [
                                            "God, the Creator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671024c8-f559-49a0-873c-592454562247",
                                                "sense_id": "11cbdd1d-7a7e-3d54-8227-81628ac34701",
                                                "text": "Well might the Sun in Darkneſs hide, / And ſhut his Glories in, / When God the mighty Maker dy’d / For Man the Creature’s Sin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1101b7a2-fdb9-3673-a094-44608f078ee6",
                                        "entry_id": "fc467551-0668-3cc7-be59-ca82ad34af9b",
                                        "glosses": [
                                            "A poet."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "782a8cad-dffa-46a6-adeb-d29d405e5f50",
                                                "sense_id": "1101b7a2-fdb9-3673-a094-44608f078ee6",
                                                "text": "Set ſophia aſyde, for euery iack raker\nAnd euery mad medler muſt now be a maker"
                                            },
                                            {
                                                "example_id": "6e3f9ab0-09d0-4566-a237-df8b78b90f52",
                                                "sense_id": "1101b7a2-fdb9-3673-a094-44608f078ee6",
                                                "text": "It is refreshing to read how makers find great allies in the past to help them tackle the present. It helps us to see that literature is a conversation across boundaries of nation, century and language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9bf8791-69f2-3f42-9bab-6ff20932ed9c",
                                        "entry_id": "fc467551-0668-3cc7-be59-ca82ad34af9b",
                                        "glosses": [
                                            "Someone who signs a promissory note, thereby becoming responsible for payment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
