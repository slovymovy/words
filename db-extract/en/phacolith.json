                        "glosses": [
                            "A lens-shaped mass that occurs in an anticlinal crest or synclinal trough."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e25cb104-32e0-4618-b922-53ab45de5998",
                                "sense_id": "4d4753a6-d4cf-3b2c-aa78-2e8602b75f60",
                                "text": "This body is a phacolith intruded along the gneiss-schist boundary in the trough of a syncline that plunges 16° southeast."
                            },
                            {
                                "example_id": "667f77e6-bffe-475f-a545-764e609b057f",
                                "sense_id": "4d4753a6-d4cf-3b2c-aa78-2e8602b75f60",
                                "text": "This bedding forms a distinctive stratigraphic sequence that may be traced from phacolith to phacolith throughout an area of 1,200 square miles."
                            },
                            {
                                "example_id": "8b1cda6e-38a0-4355-8627-597d6fe81dd7",
                                "sense_id": "4d4753a6-d4cf-3b2c-aa78-2e8602b75f60",
                                "text": "Corndon Hill, which lies east of Montgomery in Powys, Wales, is a circular phacolith made of Ordovician dolerite (Figure 5.3b)."
                            }
                        ]
                    }
