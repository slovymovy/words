                ],
                "senses": [
                    {
                        "sense_id": "074cca84-5f08-33ae-8541-c136449ace54",
                        "entry_id": "d20c2f7e-1058-39e8-99e3-8d24bb51947e",
                        "glosses": [
                            "water dat gebruikt is in de industrie of in het huishouden en dat na gebruik geloosd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430fadcc-7ba6-4053-ae96-9dbd88091942",
                                "sense_id": "074cca84-5f08-33ae-8541-c136449ace54",
                                "text": "Op de zuiveringen doorloopt het afvalwater een bepaalde route."
                            },
                            {
                                "example_id": "f985ad5e-208b-48dc-b43f-d69967af4362",
                                "sense_id": "074cca84-5f08-33ae-8541-c136449ace54",
                                "text": "Zowel provincie als gemeenten willen een alternatief zónder injectie in de ondergrond. Het gaat in dat geval om volledige zuivering van het afvalwater bij de oliewinning in Schoonebeek zelf. Het volledig gezuiverde water kan dan op het oppervlaktewater worden geloosd. Ook zou het alleen ontdaan kunnen worden van de mijnbouwhulpstoffen waarna het via een pijplijn naar zee kan worden gepompt."
                            },
                            {
                                "example_id": "dc7cdae9-bba1-4ad7-ae95-9089483a0bd1",
                                "sense_id": "074cca84-5f08-33ae-8541-c136449ace54",
                                "text": "Om precies te zijn: het stinkt niet als een riool, het stinkt naar een riool, want telkens als het regent lopen de riolen over en wordt al het afvalwater van Midden-lndiana rechtstreeks in de rivier geloosd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bffdf65-bc2f-413e-a51d-99bdd0e167ae",
                        "source_entry_id": "d20c2f7e-1058-39e8-99e3-8d24bb51947e",
                        "source_sense_id": "074cca84-5f08-33ae-8541-c136449ace54",
                        "source_sense_description": "water dat gebruikt is in de industrie of in het huishouden en dat na gebruik geloosd wordt",
                        "target_lang_word": "Abwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e78f9edf-d383-33bb-99e5-3116acddba3d",
                                        "entry_id": "be4b7f5f-8cb5-37b8-99dd-a1205186ed10",
                                        "glosses": [
                                            "durch häuslichen, gewerblichen sowie industriellen Gebrauch verunreinigtes oder auf bebauten bzw. befestigten Flächen gesammeltes und abfließendes Wasser sowie ein unbeabsichtigter Fremdwasserzufluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c318a94-a0a3-4b6e-af44-964be5011815",
                                                "sense_id": "e78f9edf-d383-33bb-99e5-3116acddba3d",
                                                "text": "\"Dies Problem hat jetzt Professor Bruce Logan in seiner „elektrisch unterstützten mikrobiellen Brennstoffzelle“ gelöst: mit Bakterien. Die Einzeller zersetzen in einer Umgebung ohne Sauerstoff organische Abfälle und die Schmutzfracht im Abwasser aus Haushalten, Lebensmittelfabriken oder auch von Bauernhöfen. Sie spalten das organische Material und sondern dabei den reinen Wasserstoff ab.\""
                                            },
                                            {
                                                "example_id": "5149fc29-8489-40a4-a994-9da65b75e6cf",
                                                "sense_id": "e78f9edf-d383-33bb-99e5-3116acddba3d",
                                                "text": "„118 Orte leiten ihr Abwasser direkt in den Strom, nur ein Drittel wird gereinigt.“"
                                            },
                                            {
                                                "example_id": "1d7b8d34-0c84-4a93-800b-0263da6f5e5e",
                                                "sense_id": "e78f9edf-d383-33bb-99e5-3116acddba3d",
                                                "text": "„Damals wurden Abwässer entsorgt, indem man sie in einen Fluss leitete.“"
                                            },
                                            {
                                                "example_id": "afe46fd3-dc59-4e0f-a630-37802b67821b",
                                                "sense_id": "e78f9edf-d383-33bb-99e5-3116acddba3d",
                                                "text": "[Jakarta/Indonesien:] „Überhaupt ist Wasser für die 18 Millionen Menschen im Ballungsgebiet ein Grund zur täglichen Sorge. Ursache ist der unverantwortliche Umgang mit Abwässern jeder Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
