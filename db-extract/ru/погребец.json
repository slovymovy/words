                                        "glosses": [
                                            "A deep, often metal-lined drawer in a sideboard used for storing wines and liquors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37082e82-762c-43bf-b93c-adcf08f86ffe",
                                                "sense_id": "30cfaea6-e714-3d44-b0f6-9363e5aacce1",
                                                "text": "I sipped at some rot-gut Lisbon, which with much ceremony he himself took from a cellaret that stood in the corner of the room, the bottle not being half-full."
                                            },
                                            {
                                                "example_id": "75b40909-3ae2-4723-baa2-6eaed9da538e",
                                                "sense_id": "30cfaea6-e714-3d44-b0f6-9363e5aacce1",
                                                "text": "The agile old servant opened the cellaret, prepared the tea table, and brought a boiling samovar."
                                            }
                                        ]
                                    }
