                "senses": [
                    {
                        "sense_id": "3032d65c-5b5e-3ded-8ea4-3aec8f3c876e",
                        "entry_id": "43f5ff54-8b03-32c4-808f-1e96bd627b1a",
                        "glosses": [
                            "ein Alkaloid, farbiges, häufig grünes Mineral"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5576a783-a8a1-4677-b5e2-c95b7b80d82d",
                                "sense_id": "3032d65c-5b5e-3ded-8ea4-3aec8f3c876e",
                                "text": "„Sächsische Hirtenknaben schnitzten rohe Bildchen aus Serpentin; das ist wohl mit das Früheste, was man über die Benutzung des Gesteines in Deutschland weiß.“ (1838)"
                            },
                            {
                                "example_id": "42aa88a2-e939-4e26-9785-45b97cb5f44f",
                                "sense_id": "3032d65c-5b5e-3ded-8ea4-3aec8f3c876e",
                                "text": "„Die ersten Versuche sollten Klarheit darüber verschaffen, wie eine möglichst weitgehende Forsteritbildung aus dem Olivin bzw. Serpentin und dem zugesetzten Magnesit zu erreichen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
