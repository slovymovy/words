                        "glosses": [
                            "Dated spelling of hutong."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6de88dfc-a4d4-4b91-b464-0332fb92a61e",
                                "sense_id": "7c9daf4a-26be-377c-a8a1-342c428bc621",
                                "text": "We opened two dispensaries [in Peking] in November last; one at An Ting, where we lived and which was open every day, Sabbath excepted; and one in the other compound at Ya'rh Hutung, which was open about three days in the week."
                            },
                            {
                                "example_id": "4e12ba65-70c2-4b43-88cd-b1fd634f0194",
                                "sense_id": "7c9daf4a-26be-377c-a8a1-342c428bc621",
                                "text": "These great streets are crossed by many broad streets, and these again by an infinite number of narrow streets, called Hutungs, or lanes."
                            },
                            {
                                "example_id": "aefc0dcb-8d93-4ccf-a2bf-b781f1313f47",
                                "sense_id": "7c9daf4a-26be-377c-a8a1-342c428bc621",
                                "text": "In the afternoon a party of us strolled out to the Chinese city [Peking], through the Great Meridian Gate, to examine the curiosity shops. The narrow streets or hutungs in this quarter reminded me of Canton."
                            },
                            {
                                "example_id": "ac03e1d4-9320-473f-9c13-eb33c7401cf8",
                                "sense_id": "7c9daf4a-26be-377c-a8a1-342c428bc621",
                                "text": "Banks, pawn-shops, and large stores were pillaged and burned, the buildings on either side of the Ta Hutung being almost completely destroyed by fire."
                            }
                        ]
                    }
