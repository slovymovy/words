                        "glosses": [
                            "een verbinding bestaande uit een benzeenring waarvan 1 waterstofatoom vervangen is door een methylgroep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6deb48f-ee3f-45b4-9c70-4ec96b9aec71",
                                "sense_id": "6f0edd4a-a2f9-3252-a7f8-73db75641d50",
                                "text": "Onderzoek dat de brandweer vrijdag heeft gedaan heeft uitgewezen dat het om tolueen gaat. De concentratie in de woning was zelfs zo hoog dat de bewoners, een gezin van drie personen, het huis uit moesten."
                            },
                            {
                                "example_id": "c23f6444-3f31-44bb-9afa-6bb463f6ed75",
                                "sense_id": "6f0edd4a-a2f9-3252-a7f8-73db75641d50",
                                "text": "„Er zit tolueen in de grond”, vertelt Anja. „Het komt met het grondwater omhoog. Alleen bij ons, dat is het rare. Maar wel in een zo grote concentratie dat er explosiegevaar dreigt en onze gezondheid direct gevaar loopt.”"
                            }
                        ]
                    }
