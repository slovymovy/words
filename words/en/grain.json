{
    "word_family": [
        "grainy",
        "granular",
        "granulate",
        "granule",
        "granary",
        "ingrain"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cccc618d-197a-35a6-9932-79cc45fb95f6",
                    "sense_definition": "The harvested seeds of food crops such as wheat, corn, rice, or barley, used as food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_crops",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer stored the <w>grain</w> in a large dry silo for the winter.",
                            "target_lang_translations": {
                                "ru": "Фермер хранил <w>зерно</w> в большом сухом силосе на зиму.",
                                "zh": "农夫把<w>谷物</w>储存在一个干燥的大筒仓里，以备过冬。"
                            }
                        },
                        {
                            "text": "Bread, pasta, and cereal are all foods made from <w>grain</w>.",
                            "target_lang_translations": {
                                "ru": "Хлеб, макароны и хлопья — это продукты, сделанные из <w>зерна</w>.",
                                "zh": "面包、意大利面和麦片都是用<w>谷物</w>制成的食物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "whole grain",
                        "grain harvest",
                        "grain production"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собранные семена продовольственных культур, таких как пшеница, кукуруза, рис или ячмень, используемые в пищу.",
                        "zh": "作为食物的谷物种子，如小麦、玉米、大米或大麦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "собирательное; продукт сельского хозяйства"
                            },
                            {
                                "target_lang_word": "зерновые",
                                "target_lang_sense_clarification": "зерновые культуры"
                            },
                            {
                                "target_lang_word": "жито",
                                "target_lang_sense_clarification": "устаревшее или региональное; рожь, ячмень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谷物",
                                "target_lang_sense_clarification": "农作物种子，统称"
                            },
                            {
                                "target_lang_word": "粮食",
                                "target_lang_sense_clarification": "作为食物的谷物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "899d1ef9-39dc-30a1-acde-d546b672861f",
                    "sense_definition": "A very small piece or amount of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a <w>grain</w> of sand in her shoe while walking on the beach.",
                            "target_lang_translations": {
                                "ru": "Гуляя по пляжу, она почувствовала <w>крупинку</w> песка в туфле.",
                                "zh": "在沙滩上散步时，她感觉到鞋里有一<w>粒</w>沙子。"
                            }
                        },
                        {
                            "text": "There is not a <w>grain</w> of truth in the rumors spreading about him.",
                            "target_lang_translations": {
                                "ru": "В слухах, распространяемых о нем, нет ни <w>зерна</w> истины.",
                                "zh": "关于他的那些传言里，一点<w>真实</w>成分都没有。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grain of sand",
                        "grain of salt",
                        "grain of truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленький кусочек или количество чего-либо.",
                        "zh": "极小的一点或少量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "перен. малое количество (правды, надежды)"
                            },
                            {
                                "target_lang_word": "крупинка",
                                "target_lang_sense_clarification": "физическая частица (песка, соли)"
                            },
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "перен. основа, суть (зерно истины)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颗粒",
                                "target_lang_sense_clarification": "细小的固体物质"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "用于抽象概念，如真理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5e356be-eead-3197-bea1-48496f66b79f",
                    "sense_definition": "A single seed of a food crop.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_crops",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird pecked at a <w>grain</w> of wheat that had fallen on the ground.",
                            "target_lang_translations": {
                                "ru": "Птица клюнула <w>зерно</w> пшеницы, упавшее на землю.",
                                "zh": "那只鸟啄食掉在地上的那一<w>粒</w>小麦。"
                            }
                        },
                        {
                            "text": "He examined the <w>grains</w> of rice to make sure they were cooked.",
                            "target_lang_translations": {
                                "ru": "Он осмотрел <w>зёрна</w> риса, чтобы убедиться, что они сварились.",
                                "zh": "他检查了米<w>粒</w>，确认它们已经煮熟了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно семя продовольственной культуры.",
                        "zh": "谷物的一粒种子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "отдельное семя"
                            },
                            {
                                "target_lang_word": "зёрнышко",
                                "target_lang_sense_clarification": "уменьшительное; маленькое семя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粒",
                                "target_lang_sense_clarification": "量词，用于细小圆形的物体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9df63955-7320-3143-9548-7e9edd63e005",
                    "sense_definition": "The arrangement, direction, or pattern of fibers in wood, meat, fabric, or stone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To make the meat tender, you should slice it against the <w>grain</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы мясо было мягким, его следует резать против <w>волокон</w>.",
                                "zh": "为了让肉质鲜嫩，你应该逆着<w>纹理</w>切。"
                            }
                        },
                        {
                            "text": "The carpenter sanded the table with the <w>grain</w> to get a smooth finish.",
                            "target_lang_translations": {
                                "ru": "Плотник шлифовал стол по <w>волокнам</w>, чтобы получить гладкую поверхность.",
                                "zh": "木匠顺着<w>纹理</w>打磨桌子，使其表面光滑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "against the grain",
                        "wood grain",
                        "with the grain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположение, направление или узор волокон в дереве, мясе, ткани или камне.",
                        "zh": "木材、肉类、织物或石材中纤维的排列方向或纹理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокна",
                                "target_lang_sense_clarification": "направление структуры материала"
                            },
                            {
                                "target_lang_word": "текстура",
                                "target_lang_sense_clarification": "рисунок поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纹理",
                                "target_lang_sense_clarification": "材料表面的花纹或结构"
                            },
                            {
                                "target_lang_word": "纹路",
                                "target_lang_sense_clarification": "纤维的走向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e4fb927-075f-3cb5-961e-877003e8850a",
                    "sense_definition": "The granular texture or appearance in a photograph or film.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer added <w>grain</w> to the image to give it a vintage look.",
                            "target_lang_translations": {
                                "ru": "Фотограф добавил <w>зернистость</w> изображению, чтобы придать ему винтажный вид.",
                                "zh": "摄影师给照片增加了<w>颗粒感</w>，使其呈现出复古的效果。"
                            }
                        },
                        {
                            "text": "High ISO settings can cause unwanted <w>grain</w> in your digital photos.",
                            "target_lang_translations": {
                                "ru": "Высокие настройки ISO могут вызвать нежелательную <w>зернистость</w> на ваших цифровых фотографиях.",
                                "zh": "高ISO设置可能会导致数码照片中出现不想要的<w>颗粒感</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "film grain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зернистая текстура или вид на фотографии или пленке.",
                        "zh": "照片或胶片上的颗粒感或纹理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зернистость",
                                "target_lang_sense_clarification": "свойство изображения"
                            },
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颗粒感",
                                "target_lang_sense_clarification": "影像质量特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c6d1f2-4e5e-3017-a791-33e739d79b17",
                    "sense_definition": "A very small unit of weight, equal to approximately 0.065 grams.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist measured the substance carefully, accurate to the last <w>grain</w>.",
                            "target_lang_translations": {
                                "ru": "Химик тщательно отмерил вещество, с точностью до последнего <w>грана</w>.",
                                "zh": "化学家仔细测量了这种物质，精确到最后一<w>格令</w>。"
                            }
                        },
                        {
                            "text": "A standard aspirin tablet contains about five <w>grains</w> of the active ingredient.",
                            "target_lang_translations": {
                                "ru": "Стандартная таблетка аспирина содержит около пяти <w>гранов</w> активного вещества.",
                                "zh": "一片标准阿司匹林药片含有约五<w>格令</w>的活性成分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "troy grain"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in historical contexts or specific fields like ballistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленькая единица веса, равная примерно 0,065 грамма.",
                        "zh": "一种极小的重量单位，约等于0.065克。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гран",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格令",
                                "target_lang_sense_clarification": "英制重量单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c2acee7-02c6-3bf4-8ace-94d6750e3274",
                    "sense_definition": "To paint or treat a surface so that it looks like it has the natural pattern of wood or stone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>grained</w> the metal door to make it resemble oak.",
                            "target_lang_translations": {
                                "ru": "Художник <w>отделал</w> металлическую дверь <w>под дерево</w>, чтобы она напоминала дуб.",
                                "zh": "艺术家对金属门进行了<w>仿木纹处理</w>，使其看起来像橡木。"
                            }
                        },
                        {
                            "text": "They decided to <w>grain</w> the cabinets for a more rustic appearance.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>отделать</w> шкафы <w>под дерево</w> для более деревенского вида.",
                                "zh": "他们决定给橱柜做<w>仿木纹处理</w>，以获得更质朴的外观。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Красить или обрабатывать поверхность так, чтобы она выглядела как натуральное дерево или камень.",
                        "zh": "对表面进行涂装或处理，使其看起来具有木材或石材的自然纹理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделывать под дерево",
                                "target_lang_sense_clarification": "имитировать текстуру дерева"
                            },
                            {
                                "target_lang_word": "наносить текстуру",
                                "target_lang_sense_clarification": "создавать узор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仿木纹处理",
                                "target_lang_sense_clarification": "工艺手段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4299b0b7-1ec8-3fa1-861f-7adbf85e13c5",
                    "sense_definition": "To feed grain to an animal, especially a horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable hand <w>grained</w> the horses after their morning exercise.",
                            "target_lang_translations": {
                                "ru": "Конюх <w>покормил зерном</w> лошадей после их утренней тренировки.",
                                "zh": "马夫在马匹晨练后给它们<w>喂了谷物</w>。"
                            }
                        },
                        {
                            "text": "Farmers <w>grain</w> their cattle to help them gain weight before winter.",
                            "target_lang_translations": {
                                "ru": "Фермеры <w>кормят зерном</w> свой скот, чтобы помочь ему набрать вес перед зимой.",
                                "zh": "农场主给牛<w>喂谷物</w>，以帮助它们在入冬前增重。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кормить животное зерном, особенно лошадь.",
                        "zh": "用谷物喂养动物，尤指马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кормить зерном",
                                "target_lang_sense_clarification": "давать зерновой корм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喂谷物",
                                "target_lang_sense_clarification": "饲养方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9407b79b-b6cd-330c-adab-5658b887423b",
                    "sense_definition": "A village on the Isle of Grain in Kent, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We visited <w>Grain</w> during our trip to the coast of Kent.",
                            "target_lang_translations": {
                                "ru": "Мы посетили <w>Грейн</w> во время нашей поездки на побережье Кента.",
                                "zh": "我们在去肯特郡海岸旅行时参观了<w>格雷恩</w>。"
                            }
                        },
                        {
                            "text": "The power station is a major landmark near the village of <w>Grain</w>.",
                            "target_lang_translations": {
                                "ru": "Электростанция — главная достопримечательность рядом с деревней <w>Грейн</w>.",
                                "zh": "发电站是<w>格雷恩</w>村附近的一个主要地标。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня на острове Грейн в графстве Кент, Англия.",
                        "zh": "位于英国肯特郡格雷恩岛上的一个村庄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грейн",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格雷恩",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}