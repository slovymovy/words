                "senses": [
                    {
                        "sense_id": "ca555589-e626-3fbd-a9ac-7379cda1f2ec",
                        "entry_id": "8e4be5a7-321a-3d9f-ab4a-290ca499e2ec",
                        "glosses": [
                            "специалист, учёный в области социологии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b353c428-7538-438b-b491-01e584a92783",
                                "sense_id": "ca555589-e626-3fbd-a9ac-7379cda1f2ec",
                                "text": "И в Москве, как показывают опросы социологов, авторитет местной власти выше, чем центральной, тогда как по всей России ровно наоборот."
                            },
                            {
                                "example_id": "b35f54c5-dec3-4cf3-80ef-302a04f8aabd",
                                "sense_id": "ca555589-e626-3fbd-a9ac-7379cda1f2ec",
                                "text": "По данным тех же социологов, 36 процентов саратовцев и 15 процентов жителей районов считают, что получают через СМИ мало «полезной информации»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65fa2312-d48e-44bd-83e5-8fe3afd6f57c",
                        "source_entry_id": "8e4be5a7-321a-3d9f-ab4a-290ca499e2ec",
                        "source_sense_id": "ca555589-e626-3fbd-a9ac-7379cda1f2ec",
                        "target_lang_word": "sociologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
