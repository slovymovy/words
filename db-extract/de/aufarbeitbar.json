                                "example_id": "790974ce-9fb0-4797-9177-557ca9f54bd4",
                                "sense_id": "7aee52c2-93ff-3adc-82bd-44a3c9ce4687",
                                "text": "„23 % der Geräte waren nicht aufarbeitbar und konnten keiner weiteren Verwendung zugeführt werden.“"
                            }
