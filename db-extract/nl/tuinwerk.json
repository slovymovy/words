                "senses": [
                    {
                        "sense_id": "9a4617ea-908d-3f50-ac69-a41171d2e820",
                        "entry_id": "1655d6a1-21a9-33a5-ad18-5cb888da9e40",
                        "glosses": [
                            "alle arbeid die in een tuin wordt verricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dbd9f94-86ae-4742-aa51-bc8d412ea76d",
                                "sense_id": "9a4617ea-908d-3f50-ac69-a41171d2e820",
                                "text": "De hele middag is de lucht vervuld van het zeurende geluid van de motorzaag, zo doordringend dat Dora het tuinwerk laat voor wat het is en alle ramen van het huis dichtdoet."
                            },
                            {
                                "example_id": "a58cd24f-484d-492d-a479-a1b70c826ca2",
                                "sense_id": "9a4617ea-908d-3f50-ac69-a41171d2e820",
                                "text": "Wanneer Cherwien is hersteld, moet er weer brood op de plank komen. \"Ik ben sterk en niet lui. Maar ik ga een andere baan zoeken. Metselen misschien, of tuinwerk. De zee ga ik niet meer op. Visserswerk? Ik ben er klaar mee. Nooit meer.\""
                            },
                            {
                                "example_id": "76bc5f2e-98ef-4869-a7f9-dd456d37b300",
                                "sense_id": "9a4617ea-908d-3f50-ac69-a41171d2e820",
                                "text": "Wordt u vaak tijdens uw tuinwerk gestoord?: „Zeker, maar dat vind ik juist zo mooi. Er fietsen hier zoveel mensen langs en bijna allemaal stoppen ze even of minderen een beetje vaart. Zeker nu we ons weilandje hebben ingezaaid met een meerjarig mengsel van akkerbloemen, krijg ik heel veel reacties. Er staan vergeten bloemen tussen die allemaal mooie nostalgische herinneringen oproepen. En zag je ooit zoveel vlinders?”"
                            }
                        ]
                    }
