                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler <w>clouted</w> the soles of the heavy work boots to improve grip.",
                            "target_lang_translations": {
                                "zh": "鞋匠给厚重的工作靴鞋底<w>装钉加固</w>，以增强抓地力。"
                            }
                        },
                        {
                            "text": "Carpenters chose to <w>clout</w> the reinforced oak door with iron studs.",
                            "target_lang_translations": {
                                "zh": "木匠们选择用铁钉饰扣来<w>装钉加固</w>加厚的橡木门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stud"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical metalworking and cobbling terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用平头大钉加固或钉牢"
