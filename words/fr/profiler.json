{
    "word_family": [
        "profil",
        "profilage",
        "profileur",
        "profileuse",
        "reprofiler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "efb43c66-ce31-34c6-83fa-681d9f774165",
                    "sense_definition": "Apparaître sous la forme d'une silhouette ou, au sens figuré, se manifester ou s'annoncer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au loin, les sommets enneigés se <w>profilent</w> à l'horizon sous les rayons du soleil couchant."
                        },
                        {
                            "text": "Une crise financière majeure se <w>profile</w> pour les petites entreprises si la situation ne s'améliore pas."
                        }
                    ],
                    "synonyms": [
                        "se dessiner",
                        "s'annoncer"
                    ],
                    "antonyms": [
                        "s'estomper",
                        "disparaître"
                    ],
                    "common_phrases": [
                        "se profiler à l'horizon",
                        "se profiler nettement"
                    ]
                },
                {
                    "sense_id": "0dfafd76-08e3-3b1e-8dff-fee18437b8b5",
                    "sense_definition": "Établir le profil psychologique ou comportemental d'une personne, notamment d'un criminel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs de la police tentent de <w>profiler</w> un criminel recherché depuis plusieurs semaines."
                        },
                        {
                            "text": "Cette méthode moderne permet de <w>profiler</w> les auteurs d'actes malveillants avec une grande précision."
                        }
                    ],
                    "synonyms": [
                        "cibler",
                        "caractériser"
                    ],
                    "common_phrases": [
                        "profiler un suspect",
                        "profiler un criminel"
                    ]
                },
                {
                    "sense_id": "3afdd124-7a51-31e3-837f-b0b1033dec3e",
                    "sense_definition": "Dessiner ou représenter les contours ou la coupe d'un objet vu de côté.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dessin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste préfère <w>profiler</w> une silhouette sur le papier noir avant de peindre les détails du visage."
                        },
                        {
                            "text": "L'architecte passe des heures à <w>profiler</w> les différentes coupes de son nouveau bâtiment."
                        }
                    ],
                    "synonyms": [
                        "esquisser",
                        "dessiner"
                    ],
                    "common_phrases": [
                        "profiler une silhouette"
                    ]
                },
                {
                    "sense_id": "c46c85b1-a236-3a31-8140-5f8783f5b7a1",
                    "sense_definition": "Donner une forme aérodynamique ou des contours réguliers à une pièce ou à un ouvrage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "façonnage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs ont réussi à <w>profiler</w> la carrosserie de la voiture pour réduire sa consommation d'énergie."
                        },
                        {
                            "text": "Cette machine industrielle permet de <w>profiler</w> avec soin les contours de chaque pièce métallique."
                        }
                    ],
                    "synonyms": [
                        "façonner",
                        "galber"
                    ],
                    "common_phrases": [
                        "profiler la carrosserie"
                    ]
                }
            ]
        }
    ]
}