                                        "entry_id": "d1635e16-c754-391a-af48-4cc1ef398533",
                                        "glosses": [
                                            "moderní svátek zamilovaných, slavený na Západě 14.února"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b723414-e0db-4f38-af18-27d855e0073a",
                                                "sense_id": "327da4e8-09da-3b94-ba38-6325c99238f3",
                                                "text": "Až do pádu komunismu se Češi s Valentýnem takřka neznali, zamilovaní slavili jen na prvního máje."
                                            },
                                            {
                                                "example_id": "859984e0-bdb3-49ba-8e2e-483a921f3e09",
                                                "sense_id": "327da4e8-09da-3b94-ba38-6325c99238f3",
                                                "text": "Nemálo našich spoluobčanů se rozhodlo slavení Valentýna bojkotovat, protože jej považují za ryze komerční příležitost, zavlečenou k nám ze Spojených států spolu se Santa Clausem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
