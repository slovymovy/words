                "senses": [
                    {
                        "sense_id": "5366e48e-01ad-3937-9d3a-a9390a2885be",
                        "entry_id": "b9ceee5b-d8f2-3a6e-8924-c2a5d2ebe920",
                        "glosses": [
                            "weibliche Person, die für die Durchführung eines Projekts verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2954ae4-d30f-405c-9347-362a0e2ba282",
                                "sense_id": "5366e48e-01ad-3937-9d3a-a9390a2885be",
                                "text": "„Als Projektmanagerin in der IT-Branche leitet Autorin Saskia Hablasch stets mehrere Projekte parallel und bearbeitet zusätzlich noch Sonderthemen.“"
                            },
                            {
                                "example_id": "9c1ec2cf-6a64-4364-8f37-add90245df25",
                                "sense_id": "5366e48e-01ad-3937-9d3a-a9390a2885be",
                                "text": "„Eine Projektmanagerin hat von ihren Mitarbeitern und Kollegen wie auch schon im Vorjahr ein schlechtes 360-Grad-Feedback bekommen.“"
                            },
                            {
                                "example_id": "af152979-ed42-448b-aff2-0503a3d22731",
                                "sense_id": "5366e48e-01ad-3937-9d3a-a9390a2885be",
                                "text": "„Ursprünglich habe ich Wirtschaft mit Schwerpunkt Projektmanagement studiert und fast zwei Jahrzehnte erfolgreich als Unternehmensberaterin, Businesstrainerin und Projektmanagerin gearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
