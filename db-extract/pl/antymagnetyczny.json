                    },
                    {
                        "translation_id": "c36cfe79-6ec9-42da-9873-3e91ee89b346",
                        "source_entry_id": "d9b13a70-5280-312b-a039-8a959fd999c4",
                        "source_sense_id": "87bf8530-cca6-305d-8c9c-cb5f1c6fa241",
                        "target_lang_word": "antimagnétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimagnétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89f05c7f-47bd-31f6-af93-52ebb367df02",
                                        "entry_id": "704dfa62-9ecf-340c-b1c0-45540aae7af5",
                                        "glosses": [
                                            "Qui résiste aux champs magnétiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90510cf0-74fd-422f-aac8-60a669370ef4",
                                                "sense_id": "89f05c7f-47bd-31f6-af93-52ebb367df02",
                                                "text": "Rendre les montres antimagnétiques est devenu presque une nécessité et ce résultat est obtenu dans la section américaine par l’emploi des boîtes d’un métal antimagnétique dans lequel on enferme la montre. Le même résultat est obtenu par un simple anneau de même métal entourant la montre."
                                            },
                                            {
                                                "example_id": "73a0677c-0900-4c57-a4cb-5a23c6e5b085",
                                                "sense_id": "89f05c7f-47bd-31f6-af93-52ebb367df02",
                                                "text": "Voilà à quoi je gamberge, mes bons amis, d’où une sorte d’espèce d’amertume sous-jacente, polyvalente, fluorescente et antimagnétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dac3a5f-2b58-3806-8e01-2a2ed64591a1",
                                        "entry_id": "704dfa62-9ecf-340c-b1c0-45540aae7af5",
                                        "glosses": [
                                            "Qui résiste au magnétisme (à l’hypnotisme)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081b2609-c1e8-402e-b316-2e2beabb8927",
                                                "sense_id": "9dac3a5f-2b58-3806-8e01-2a2ed64591a1",
                                                "text": "Je viens en observateur dans leur camp, et sachant avec quel art ils nous assouplissent et nous entraînent à pactiser avec eux, je me tiens sévèrement en garde contre leurs insinuations. Cette antimagnétique disposition explique-t-elle la singulière exception qui va s’attacher à ma personne ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eb1ad32-e75f-3d91-ad4d-c8ae08302c98",
                                        "entry_id": "704dfa62-9ecf-340c-b1c0-45540aae7af5",
                                        "glosses": [
                                            "Qui s’oppose au magnétisme, c’est-à-dire à l’hypnotisme."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df03cccc-51be-459a-b912-8d3c1eab0755",
                                                "sense_id": "8eb1ad32-e75f-3d91-ad4d-c8ae08302c98",
                                                "text": "Les coryphées de la croisade antimagnétique peu à peu s’avouent vaincus, désertent leur poste magnéticide. Dernièrement c’était le rédacteur en chef de British and foreign medical review, aujourd’hui c’est celui de l’Union médicale, M. Amédée Latour, autrement dit Jean Raymond, qui, l’année dernière, devait nous flageller si rudement dans les colonnes du Constitutionnel, qui lui étaient ouvertes dans ce but."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
