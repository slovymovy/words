                "senses": [
                    {
                        "sense_id": "2dffd298-db64-3d3c-8d54-292f458194e5",
                        "entry_id": "7351125d-dbb1-374e-8ddf-8f12f51a771b",
                        "glosses": [
                            "flektierte Form eines Wortes, die den Genitiv anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb03409-d5d7-49bb-933a-0980567d2306",
                                "sense_id": "2dffd298-db64-3d3c-8d54-292f458194e5",
                                "text": "„Technisch ist der Genitiv nicht anstrengend und so simpel, dass niemand Schwierigkeiten hat, die Genitivform zu einem beliebigen Wort aufzusagen.“"
                            },
                            {
                                "example_id": "f39db062-6c3f-43ae-af4a-4905a01b2f51",
                                "sense_id": "2dffd298-db64-3d3c-8d54-292f458194e5",
                                "text": "„Mit Ausnahme der nur verwiesenen Stichwörter hat jedes Substantiv grammatische Angaben, und zwar den Artikel, die Genitiv- und die Pluralform(en).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
