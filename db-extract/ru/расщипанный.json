                "senses": [
                    {
                        "sense_id": "55e12782-fadb-3f38-a9fd-7e9a5c199758",
                        "entry_id": "259a4df5-35fd-3ac0-b9ac-9ddbce97c698",
                        "glosses": [
                            "перен. раздёрганный, с тяжёлой судьбой, расстроенными нервами и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a08e12f4-fab3-4b2c-b52c-3738f61bf2b4",
                                "sense_id": "55e12782-fadb-3f38-a9fd-7e9a5c199758",
                                "text": "Старый дед смешит народ сказочкою, как медведь собрался на птиц войной; casus belli — лапоть старый, порванный, много лет ненадобный, расщипанный, раздёрганный серыми гусями (намёк на вздорный повод войны, на которую отправился царь Салтан)."
                            }
                        ]
                    }
