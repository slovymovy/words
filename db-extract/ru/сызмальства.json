                "senses": [
                    {
                        "sense_id": "6b667c43-4896-3b15-8f1b-b9ae6720dced",
                        "entry_id": "517f6680-5d09-30bf-b67a-43b623fe4f58",
                        "glosses": [
                            "разг. с малых лет, с детства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee19a4b-97fc-46c8-a145-8d3034bab0dc",
                                "sense_id": "6b667c43-4896-3b15-8f1b-b9ae6720dced",
                                "text": "Беда и тому, кому бог дает прямую душу да горячее сердце нетерпеливое: станут такого колотить сызмальства и доколотят до гробовой доски."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea9a308b-5993-45a1-a8d5-d800d734689c",
                        "source_entry_id": "517f6680-5d09-30bf-b67a-43b623fe4f58",
                        "source_sense_id": "6b667c43-4896-3b15-8f1b-b9ae6720dced",
                        "target_lang_word": "von Kindesbeinen an",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "von Kindesbeinen an",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d196646d-eb0c-36d2-b63c-619dc3aacbcb",
                                        "entry_id": "65192985-ae72-3375-bca8-916207e3ec1a",
                                        "glosses": [
                                            "ab der frühen Kindheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e58864-9a63-4cdc-9e8f-f9ed087fd437",
                                                "sense_id": "d196646d-eb0c-36d2-b63c-619dc3aacbcb",
                                                "text": "„Christian hat von Kindesbeinen an mit seinen Trommeln die Ruhe in Haus und Umgebung empfindlich gestört.“"
                                            },
                                            {
                                                "example_id": "bbd9efc2-cdbc-4907-82eb-54e0b6f2990e",
                                                "sense_id": "d196646d-eb0c-36d2-b63c-619dc3aacbcb",
                                                "text": "„Nun aber wolle er ihre gesamte Krankengeschichte hören, von Kindesbeinen an.“"
                                            },
                                            {
                                                "example_id": "adc87d6b-9664-4687-b0f3-c85650c26512",
                                                "sense_id": "d196646d-eb0c-36d2-b63c-619dc3aacbcb",
                                                "text": "„Hier ist man von Kindesbeinen an fest davon überzeugt, dass alles, was passiert, einem möglicherweise zum Nachteil gereicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
