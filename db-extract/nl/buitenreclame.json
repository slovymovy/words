                        "examples": [
                            {
                                "example_id": "b4992ec9-14de-4b7e-a06c-7b1dd100f682",
                                "sense_id": "3c14cf67-27fa-3062-8ceb-5b22cc0f6697",
                                "text": "Minister Franc Weerwind van Justitie kondigde in maart aan dat de gokbedrijven hadden beloofd onder meer te stoppen met buitenreclame. Hij had daarvoor afspraken gemaakt met de twee brancheorganisaties voor gokbedrijven: VNLOK en NOGA."
                            },
                            {
                                "example_id": "43ce4185-b736-45fd-a3e5-514eb1e1d796",
                                "sense_id": "3c14cf67-27fa-3062-8ceb-5b22cc0f6697",
                                "text": "Volgens Maliepaard zijn er andere reclames die schadelijker zijn, ook als het gaat om gender. \"Ik zie liever dat buitenreclame met halfnaakte vrouwen - met perfect gefotoshopte lichamen en getuite mondjes - verdwijnt\", zegt ze. \"Daar begon het Britse verbod mee: een poster van een model in bikini met een heel strak lijf, met de vraag 'Are you beach body ready'? Dat was een reclame voor dieetsupplementen, en mensen waren daar terecht boos over.\""
                            }
                        ]
                    }
