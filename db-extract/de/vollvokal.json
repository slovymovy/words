                ],
                "senses": [
                    {
                        "sense_id": "5e442fc8-9bad-3a7d-a15e-71e3661aaf4f",
                        "entry_id": "88f58018-033e-34b0-bfc4-fc138cce2a20",
                        "glosses": [
                            "betonter/betonbarer Vokal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb10b0b-18f5-4fbb-97a2-20e11f70ae6b",
                                "sense_id": "5e442fc8-9bad-3a7d-a15e-71e3661aaf4f",
                                "text": "„In vielen Sprachen werden Vollvokale in unbetonten Silben zu Schwa reduziert.“"
                            },
                            {
                                "example_id": "ce9bc319-35aa-4211-aa25-7adc7e51e1a0",
                                "sense_id": "5e442fc8-9bad-3a7d-a15e-71e3661aaf4f",
                                "text": "„Die dennoch relativ schlechten Werte für den s-Plural bei Substantiven auf Vollvokal sind erstaunlich und nur durch die geringe Frequenz derselben zu erklären.“"
                            },
                            {
                                "example_id": "ef3a5b0d-889d-4784-bd72-591843ba398a",
                                "sense_id": "5e442fc8-9bad-3a7d-a15e-71e3661aaf4f",
                                "text": "„Der s-Plural wird deutlich von Belegen auf Vollvokal (56%) dominiert.“"
                            },
                            {
                                "example_id": "eb584c08-6ea6-460e-a6b9-b94c17401642",
                                "sense_id": "5e442fc8-9bad-3a7d-a15e-71e3661aaf4f",
                                "text": "„In Zhuyin werden alle mit demselben Zeichen geschrieben, d.h. die Unterscheidung zwischen Halb- und Vollvokal wird nicht gemacht.“"
                            },
                            {
                                "example_id": "d9ab3927-2563-4d87-8e06-52f1f65a7976",
                                "sense_id": "5e442fc8-9bad-3a7d-a15e-71e3661aaf4f",
                                "text": "„Der Silbennukleus kann im Neuhochdeutschen durch einen Vollvokal, einen Reduktionsvokal oder auch durch einen silbischen Konsonanten besetzt werden. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
