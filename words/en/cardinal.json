                },
                {
                    "sense_id": "edb55008-6779-300f-8282-89340afc32d3",
                    "sense_definition": "A short hooded cloak, originally made of scarlet cloth, worn by women in the 18th century.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lady wrapped her <w>cardinal</w> tightly around her to protect against the cold wind.",
                            "target_lang_translations": {
                                "ru": "Дама плотно закуталась в свой <w>кардина́л</w>, чтобы защититься от холодного ветра.",
