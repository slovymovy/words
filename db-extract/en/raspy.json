                                            {
                                                "example_id": "d4ba4ca3-d336-4316-9e28-6aa689b64812",
                                                "sense_id": "d30f69be-7ba4-3e6a-8089-bb95d5baa6bf",
                                                "text": "Een stamppot met rauwe andijvie."
                                            },
                                            {
                                                "example_id": "f4fb6f0d-524a-4244-8bc5-210c0accc8df",
                                                "sense_id": "d30f69be-7ba4-3e6a-8089-bb95d5baa6bf",
                                                "text": "Zelfs een pakje noedels kon je kennelijk rauw eten, en hij wierp me een pak Indomie instant kipnoedels van 20 cent toe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aacb7a7-9cbb-3b45-8546-c582fd7354b5",
                                        "entry_id": "e26daa98-3eac-3911-b2f6-1a6c2a9de5ce",
                                        "glosses": [
