                                "example_id": "b70c57a8-9fc6-4c32-94dc-e202d50c2a08",
                                "sense_id": "d3c6aa54-9f8b-33a1-88f1-0a37fd3f09a4",
                                "text": "„Die Reichskartoffelstelle mühte sich, Kompensation für den Ernteausfall zu beschaffen.“"
                            },
                            {
                                "example_id": "4bf95fe9-bb28-4069-aae9-aeb5c5a052c1",
                                "sense_id": "d3c6aa54-9f8b-33a1-88f1-0a37fd3f09a4",
                                "text": "„Der Schädling kann zu extremen Ernteausfällen führen.“"
                            }
