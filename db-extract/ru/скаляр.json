                                        "sense_id": "cda86545-af2e-3530-a2a0-ce954d2da098",
                                        "entry_id": "edc1e3a5-aa80-3c6a-9a1d-49a155cfa3e9",
                                        "glosses": [
                                            "Having magnitude but not direction."
                                        ],
