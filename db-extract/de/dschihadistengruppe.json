                "senses": [
                    {
                        "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                        "entry_id": "591e994a-def6-3aae-9d9c-b82f16953d44",
                        "glosses": [
                            "den Dschihadismus zu seinem Grundsatz gemachte Gruppe"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "c1d9869d-c653-410e-860a-13cf683d9273",
                                "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                                "text": "„Ein Selbstmordattentäter hatte am Grenzübergang Taba drei südkoreanische Urlauber sowie ihren Fahrer mit in den Tod gerissen. Zu der Tat bekannte sich die Dschihadistengruppe Ansar Beit al Makdess. Militante Islamisten hatten Urlaubern in Ägypten in der vergangenen Woche mit neuen Anschlägen gedroht und ihnen ein Ultimatum zum Verlassen des Landes bis Donnerstag vergangener Woche gestellt.“"
                            },
                            {
                                "example_id": "face09b8-dc67-42f8-9d2c-beb9da5f9a2f",
                                "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                                "text": "„Irakische Sicherheitskräfte haben nach eigenen Angaben in der Provinz Anbar 55 Kämpfer getötet, die der Terrororganisation Al-Kaida nahestehen sollen. General Ali Ghaidan Madscheed, Kommandeur der Bodentruppen, sagte, die Aufständischen seien am Abend bei zwei Einsätzen gegen die Dschihadistengruppe Islamischer Staat im Irak und der Levante (ISIL) nahe den seit Tagen umkämpften Städten Ramadi und Falludscha getötet worden. Bei dem ersten Einsatz nahe Ramadi seien 25 Kämpfer ums Leben gekommen.“"
                            },
                            {
                                "example_id": "d831b0bc-47fc-469b-b805-ca12f6c512a3",
                                "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                                "text": "„Bei den Luftangriffen der US-geführten Koalition gegen die Dschihadistengruppe Islamischer Staat (IS) in Syrien sind nach Angaben von Aktivisten schon mehr als 550 Menschen getötet worden.“"
                            },
                            {
                                "example_id": "3fc0cb8c-ac5f-4c8e-ae3c-f86ffca37f30",
                                "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                                "text": "„In Syrien sind seit dem Beginn der US-geführten Offensive gegen die Dschihadistengruppe vor einer Woche nach Angaben von Aktivisten bereits mehr als 200 Extremisten getötet worden.“"
                            },
                            {
                                "example_id": "0f76853d-b94c-478f-a45c-97a7b6be8f6c",
                                "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                                "text": "„Das kanadische Parlament hat einem Militäreinsatz im Kampf gegen die Dschihadistengruppe \" Islamischer Staat\" (IS) zugestimmt.“"
                            },
                            {
                                "example_id": "d72be80f-b59f-4d2d-b650-9433f6a090f6",
                                "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                                "text": "„Die Dschihadistengruppe Islamischer Staat (IS) hat offenbar einen weiteren als Geisel genommenen US-Journalisten grausam hingerichtet.“"
                            },
                            {
                                "example_id": "07b19720-3d30-49db-af16-a32bbfb76fc8",
                                "sense_id": "0bce0c31-dfe5-371e-9eb8-7582aa64f400",
                                "text": "„Viele ausländische Kämpfer der Dschihadistengruppe kommen über die Türkei nach Syrien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
