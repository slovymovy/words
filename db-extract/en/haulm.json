                                "target_senses": [
                                    {
                                        "sense_id": "310da3f0-eaea-3200-89e3-12939b41da1d",
                                        "entry_id": "4d85bb6b-a89e-38fa-bf9b-2bc1a58c2d66",
                                        "glosses": [
                                            "Feuille tombée d’un arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80cb039a-d606-4357-9300-6e3ad22a0c59",
                                                "sense_id": "310da3f0-eaea-3200-89e3-12939b41da1d",
                                                "text": "Ramasser les fanes."
                                            },
                                            {
                                                "example_id": "6f9bc817-c606-4834-97a0-802f8ab9bf7f",
                                                "sense_id": "310da3f0-eaea-3200-89e3-12939b41da1d",
                                                "text": "Ôter les fanes des allées d’un jardin."
                                            },
                                            {
                                                "example_id": "42290fc0-0b3f-48b7-a84b-019825fcb212",
                                                "sense_id": "310da3f0-eaea-3200-89e3-12939b41da1d",
                                                "text": "Vers Oraison, on avait dû allumer des feux pour brûler les fanes de vignes ; de temps en temps une grande flamme rouge éclatait de ce côté et on voyait monter dans la nuit une fumée qui flottait comme une crinière de cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e95cd2e-9b81-3990-ae50-8a125f5d7344",
                                        "entry_id": "4d85bb6b-a89e-38fa-bf9b-2bc1a58c2d66",
                                        "glosses": [
                                            "Touffe de feuilles de certains légumes, comme les pommes de terre, les carottes, les salsifis, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b505eb8d-704c-4ae9-9143-eac484c8bce1",
                                                "sense_id": "6e95cd2e-9b81-3990-ae50-8a125f5d7344",
                                                "text": "Sa fourche tombait entre les fanes à bonne distance du pied, et, d'un seul coup de poignet, il ramenait au jour les tubercules qui s'éparpillaient sur la terre fraîche."
                                            },
                                            {
                                                "example_id": "f5cf541b-b7b6-47e9-94a2-8d194b82a8e8",
                                                "sense_id": "6e95cd2e-9b81-3990-ae50-8a125f5d7344",
                                                "text": "28 octobre 42 – Nous avons droit à un kilo de carottes sans fanes, ou à deux kilos avec fanes ! Problème insoluble."
                                            },
                                            {
                                                "example_id": "4be42694-9052-45fd-84d5-69bd0e42b860",
                                                "sense_id": "6e95cd2e-9b81-3990-ae50-8a125f5d7344",
                                                "text": "La vieille grelotteuse qui tapinait rue Saint-Martin, toujours avec son cabas, d'où sortaient parfois des poireaux ou des fanes de carottes."
                                            },
                                            {
                                                "example_id": "d51ae544-4cbd-4ef2-9ab9-98cc75d1a2b5",
                                                "sense_id": "6e95cd2e-9b81-3990-ae50-8a125f5d7344",
                                                "text": "On peut utiliser, pour le paillage, les fanes de légumes, qui auront en outre un effet nourricier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d976fe-b199-36c0-ad52-a1e1d6cf769f",
                                        "entry_id": "4d85bb6b-a89e-38fa-bf9b-2bc1a58c2d66",
                                        "glosses": [
                                            "Enveloppe foliacée de la fleur des anémones et des renoncules."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
