                "senses": [
                    {
                        "sense_id": "d8bb20f0-1e07-3816-bc9b-a824f7db1eb6",
                        "entry_id": "3fc948fa-e3c1-38b4-9ca7-5401d335ded6",
                        "glosses": [
                            "een slavin of concubine in de harem van de Turkse sultan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee5dfad-4979-4a1d-962a-c697de4deefc",
                                "sense_id": "d8bb20f0-1e07-3816-bc9b-a824f7db1eb6",
                                "text": "“Toen Matisse stierf, liet hij zijn odalisken aan mij na,” sprak Picasso kort na de dood van de kunstenaar tegen een bezoeker aan zijn studio. Die had hem gewezen op de overeenkomst tussen de oosterse naakten van Henri Matisse (1869-1954) en de serie odalisken waar Picasso een paar weken na diens dood aan was begonnen."
                            },
                            {
                                "example_id": "cc636c78-a1b4-40f4-9a36-d96e92071ac6",
                                "sense_id": "d8bb20f0-1e07-3816-bc9b-a824f7db1eb6",
                                "text": "Twee jaar nadat het gestolen schilderij Odalisk in rode broek van de Franse schilder Henri Matisse opdook in de Verenige Staten, is het weer terug in Venezuela."
                            }
                        ]
                    },
                    {
                        "sense_id": "d06ab76c-d96a-36da-a04e-b1ed72f06e2a",
                        "entry_id": "3fc948fa-e3c1-38b4-9ca7-5401d335ded6",
                        "glosses": [
                            "sluierdanseres"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39b92b07-46c7-4237-bec5-90bd02e8ddc0",
                        "source_entry_id": "3fc948fa-e3c1-38b4-9ca7-5401d335ded6",
                        "source_sense_id": "d8bb20f0-1e07-3816-bc9b-a824f7db1eb6",
                        "source_sense_description": "een slavin of concubine in de harem van de Turkse sultan",
                        "target_lang_word": "odalisque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odalisque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                        "entry_id": "4e6c2485-c1bb-3f7b-b64c-104ac316b53a",
                                        "glosses": [
                                            "A female slave in a harem, especially one in the Ottoman seraglio."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0155f9c-d5a4-4df9-a218-5f1ec1ebb2f0",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "When the young Mauretanians were his guests in the little houses before the town gates, and he was of a good humour, it would come about that he displayed his odalisques as others would their jewels."
                                            },
                                            {
                                                "example_id": "54d1eebf-71d5-4ec3-86e2-b9d9d2bf5766",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "They grew fat, but successfully resisted the enticing odalisques with whom they were confronted."
                                            },
                                            {
                                                "example_id": "3aa9c90d-04b6-4694-9193-2244b9fcbce5",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "Though I could see the titan odalisques and their garden and knew them to be no more than dream-stuff recalled, I could not escape from their fascination and the memory of the dream."
                                            },
                                            {
                                                "example_id": "ad1307ac-b873-41f0-9e41-a336fc210a28",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "The Sector is borne in a padded Waggon, like some mechanickal Odalisque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f4124d-0787-375c-9912-304720b5b9cd",
                                        "entry_id": "4e6c2485-c1bb-3f7b-b64c-104ac316b53a",
                                        "glosses": [
                                            "A desirable or sexually attractive woman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
