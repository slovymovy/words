                "senses": [
                    {
                        "sense_id": "adea98d1-6fe6-3ccb-a38b-705f3a5bf86b",
                        "entry_id": "b036d2d6-3464-34da-81ab-beef6d4bf744",
                        "glosses": [
                            "Morceau de musique fait pour être chanté par deux voix ou exécuté par deux instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb4c6f5-2e42-45a5-96cc-8431b4d1005d",
                                "sense_id": "adea98d1-6fe6-3ccb-a38b-705f3a5bf86b",
                                "text": "Un duo de flûte, un duo de violon."
                            },
                            {
                                "example_id": "102b572a-2571-4292-902a-aac684d11861",
                                "sense_id": "adea98d1-6fe6-3ccb-a38b-705f3a5bf86b",
                                "text": "Chanter des duos."
                            }
                        ]
                    },
                    {
                        "sense_id": "6eedbaad-3b85-33ae-8363-19b6fff38982",
                        "entry_id": "b036d2d6-3464-34da-81ab-beef6d4bf744",
                        "glosses": [
                            "Ensemble musical composé de deux musiciens."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "28d2ac27-35f3-3596-ad2e-574d2649f235",
                        "entry_id": "b036d2d6-3464-34da-81ab-beef6d4bf744",
                        "glosses": [
                            "Échange verbal entre deux personnes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ac562784-e99c-4884-a434-90de4d03c3c9",
                                "sense_id": "28d2ac27-35f3-3596-ad2e-574d2649f235",
                                "text": "Duo d’injures, de compliments, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0c44edc-6673-37d5-9271-73de4f50ca75",
                        "entry_id": "b036d2d6-3464-34da-81ab-beef6d4bf744",
                        "glosses": [
                            "Couple, paire, binôme."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "dd53f746-4874-49b2-8b8d-07d1f33e6f1e",
                                "sense_id": "b0c44edc-6673-37d5-9271-73de4f50ca75",
                                "text": "Avec un taille-thé, machine originaire du Japon, le duo tranche les cimes des tiges vert bouteille, propulsées dans un grand sac traînant derrière eux."
                            },
                            {
                                "example_id": "fe6e7b2c-3917-49b2-9610-991ccb64201e",
                                "sense_id": "b0c44edc-6673-37d5-9271-73de4f50ca75",
                                "text": "Nous devions former un drôle de duo, tous les deux."
                            },
                            {
                                "example_id": "b2776545-b44d-4dad-9c0f-391844e98ab2",
                                "sense_id": "b0c44edc-6673-37d5-9271-73de4f50ca75",
                                "text": "Dans le Dernier des Juifs, elle campe une dialysée vivant avec son fils de 27 ans dans une cité vidée de sa population juive. À l’écran, le duo diffuse une mélancolie tendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3bfce74-e072-3726-8482-f59432d86e26",
                        "entry_id": "b036d2d6-3464-34da-81ab-beef6d4bf744",
                        "glosses": [
                            "Nom d’une cage de laminoir comportant deux cylindres tournant en sens inverse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2fa8c85-50c9-44be-9819-fde7cea5e238",
                                "sense_id": "c3bfce74-e072-3726-8482-f59432d86e26",
                                "text": "Des laminoirs monocages duo produisaient alors du feuillard d’acier de largeur maximale 200 mm utilisé pour les ustensiles de ménage, les tubes pour literie, le feuillard d’emballage, les baleines de corsets, les boutons…"
                            }
                        ]
                    }
                ],
