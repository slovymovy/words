                "senses": [
                    {
                        "sense_id": "9dfa1147-1302-3022-999a-373c01839b67",
                        "entry_id": "a627b14c-1a02-3bba-b53b-d08f0c8a5d8a",
                        "glosses": [
                            "Drehung eines Gelenkes nach außen; Auswärtsdrehung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae969a77-2d6c-499d-a815-b048a311dba2",
                                "sense_id": "9dfa1147-1302-3022-999a-373c01839b67",
                                "text": "Die Supination meiner Hand schmerzt bei mir."
                            },
                            {
                                "example_id": "f9ea58ee-8aee-4b47-94ff-bc6c2a587195",
                                "sense_id": "9dfa1147-1302-3022-999a-373c01839b67",
                                "text": "„Bei Pronation und Supination rotiert der Unterarm um seine Längenachse, die durch das Zentrum des Radiuskopfs und dem Mittelpunkt der distalen ulnaren Gelenkfläche verläuft.“"
                            },
                            {
                                "example_id": "6702c983-3a67-4ce4-b6a8-f4e589616a39",
                                "sense_id": "9dfa1147-1302-3022-999a-373c01839b67",
                                "text": "„Der Läufer soll sich dabei fragen, ob er zur Pronation oder Supination neigt - ob sein Sprunggelenk also beim Aufsetzen nach innen oder nach außen dreht.“"
                            },
                            {
                                "example_id": "9d0e81ab-4d3f-44d2-aeaf-7957637dad76",
                                "sense_id": "9dfa1147-1302-3022-999a-373c01839b67",
                                "text": "„Seine Arme werden festgeschnallt, mit den Händen umklammert er zwei Griffe, die er nach innen und außen drehen muss; die eine Bewegung nennt man Pronation, die andere Supination.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
