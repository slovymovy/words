                            {
                                "example_id": "1025ecf6-c63e-4c9b-91de-361b26e75277",
                                "sense_id": "60c72cab-5794-3de7-81cd-571c9b0a5b5c",
                                "text": "Der Stör ist ein Knochenfisch."
                            },
                            {
                                "example_id": "8cb6bd45-e5de-4d13-b204-e08e25830f9d",
                                "sense_id": "60c72cab-5794-3de7-81cd-571c9b0a5b5c",
                                "text": "„Mit Ausnahme der Neunaugen gehören alle in Binnengewässern Mitteleuropas lebenden Fischarten zu den Knochenfischen und – bis auf die Störartigen – zu den Echten Knochenfischen.“"
                            }
                        ],
