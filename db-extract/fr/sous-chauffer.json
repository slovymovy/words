                        "glosses": [
                            "Chauffer moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9c72489-b07f-428d-a4e1-92c4798d4db8",
                                "sense_id": "dc80af6c-54b1-31c4-928c-0b8af305b267",
                                "text": "II convient donc de sous-chauffer fortement le canon dans le cas d'une utilisation en électrons."
                            },
                            {
                                "example_id": "193e7150-df5c-4939-9cde-0c64b42c91f1",
                                "sense_id": "dc80af6c-54b1-31c4-928c-0b8af305b267",
                                "text": "Si on juge suffisante une lampe ordinaire, on choisira une lampe à faible pente, exigeant un courant de chauffage élevé, de façon à pouvoir la sous-chauffer aisément, et à verre non métallisé."
                            }
                        ]
