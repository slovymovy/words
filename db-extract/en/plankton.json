                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2266e84f-49ed-45e7-953b-d576ba60544d",
                        "source_entry_id": "75d64d90-e963-3f2f-aa1c-b1f0d1e8b4e1",
                        "source_sense_description": "generic term for all the organisms that float in the sea",
                        "target_lang_word": "планкто́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "планкто́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cfd662b7-d133-3a4b-ae09-695ef0fd5c22",
                                        "entry_id": "a918dd2a-c824-37dd-b20e-5b49b03dcbf7",
                                        "glosses": [
                                            "биол., разнородные мелкие организмы, свободно дрейфующие в толще воды и не способные сопротивляться течению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "673cce74-bb57-4eff-9c93-48ba6702bf9d",
                                                "sense_id": "cfd662b7-d133-3a4b-ae09-695ef0fd5c22",
                                                "text": "Сине-зелёные водоросли отравляют планктон, губят рыб."
                                            },
                                            {
                                                "example_id": "a5678178-31f8-4d16-9833-f9787e222dab",
                                                "sense_id": "cfd662b7-d133-3a4b-ae09-695ef0fd5c22",
                                                "text": "Поверхностные слои Кольского залива и прибрежного моря — его планктон — богаты многочисленными видами диатомовых и зелёных водорослей и простейших-инфузорий корненожек, радиолярий."
                                            },
                                            {
                                                "example_id": "f843bcf2-b2c0-46e8-9cfa-3bad5c98f56f",
                                                "sense_id": "cfd662b7-d133-3a4b-ae09-695ef0fd5c22",
                                                "text": "Естественному приросту рыбы, помимо хищнического лова, немало вредит сплав брёвен по олонецким рекам: отмокающая с них кора ложится на дно и губит этим и своими выделениями как водные растения, так и плавающий речной планктон, т. е. всякую водную мелочь, которую питается выклевавшийся из икры молодик."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
