                                    {
                                        "sense_id": "eb52569f-fe80-379f-a5d0-ba55d598368c",
                                        "entry_id": "75aeca15-1640-3616-b784-ed8e7b39ba3e",
                                        "glosses": [
                                            "Qui concerne les délits et les peines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "649f1a08-c61d-419e-a0c5-80268042a41e",
                                                "sense_id": "eb52569f-fe80-379f-a5d0-ba55d598368c",
                                                "text": "Une des pensées fondamentales de l'Ancien Régime avait été l'emploi de la procédure pénale pour ruiner tous les pouvoirs qui faisaient obstacle à la royauté. Il semble que, dans toutes les sociétés primitives, le droit pénal ait commencé par être une protection accordée au chef et à quelques privilégiés […]."
                                            },
                                            {
                                                "example_id": "55f9d7b1-1435-474e-acc2-75c1a0ae0777",
                                                "sense_id": "eb52569f-fe80-379f-a5d0-ba55d598368c",
                                                "text": "Le non-paiement des cotisations sociales est constitutif d'infraction pénale dans le chef de l’employeur, ou de ses préposés et mandataires qui ont la responsabilité du paiement des cotisations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e69d0a44-91b2-49ca-b252-a5fd4a512a72",
                        "source_entry_id": "e2bad3a5-2c6a-385f-a609-87857cdb8033",
                        "source_sense_description": "of or relating to punishment",
                        "target_lang_word": "strafrechtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strafrechtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b60f9af3-c4d1-396d-b550-8faac58798ad",
                                        "entry_id": "25b96272-3a98-38b3-9716-7be79f9c90b1",
                                        "glosses": [
                                            "das Strafrecht betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6996fde-f035-4297-adfe-33a778eb1ff1",
                                                "sense_id": "b60f9af3-c4d1-396d-b550-8faac58798ad",
                                                "text": "Strafrechtlich kann man ihm nichts anhaben."
                                            },
                                            {
                                                "example_id": "a8dad6eb-b635-4421-b954-2cc54c8d403c",
                                                "sense_id": "b60f9af3-c4d1-396d-b550-8faac58798ad",
                                                "text": "„Die Landesärztekammer Sachsen meldet bislang drei strafrechtliche Anzeigen.“"
                                            },
                                            {
                                                "example_id": "e115f314-d1f1-48ae-be51-79f0369600de",
                                                "sense_id": "b60f9af3-c4d1-396d-b550-8faac58798ad",
                                                "text": "[Abtreibung:] „Wird die Schwangerschaft allerdings unter bestimmten Voraussetzungen beendet, bleibt der Abbruch zwar illegal, der Arzt und die betroffene Person werden aber strafrechtlich nicht verfolgt.“"
                                            },
                                            {
                                                "example_id": "bc8f2fbc-0d87-45d9-8bc1-89514e458f21",
                                                "sense_id": "b60f9af3-c4d1-396d-b550-8faac58798ad",
                                                "text": "„Die Diskriminierung von «Unberührbaren» kann zwar strafrechtlich verfolgt werden, da sie aber auf Meidung beruht, ist sie meist nicht nachzuweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
