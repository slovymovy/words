                                        "glosses": [
                                            "Ensemble des agents économiques liés aux petits commerces."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d9bcedd-62a6-4ae4-b31d-49400e3f0f70",
                                                "sense_id": "40ccc530-cb2c-3b20-84f7-a65f8549b9a1",
                                                "text": "Les petits commerces et les artisans souffrent de la concurrence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a75a6ff2-a15f-42e6-b6d6-e1d15d003b12",
