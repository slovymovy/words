                "senses": [
                    {
                        "sense_id": "9a38bfb2-4de6-326a-9885-0eb2c3434540",
                        "entry_id": "be4c098d-2c28-3f11-b4a5-0281447510cc",
                        "glosses": [
                            "Faire perdre son caractère éthique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c37c99-8e7b-43fd-a148-6601e5b815a4",
                                "sense_id": "9a38bfb2-4de6-326a-9885-0eb2c3434540",
                                "text": "Le travail est ainsi désenchanté et « déséthicisé »."
                            },
                            {
                                "example_id": "e4aee13d-0212-4da1-96d9-70ae2163ed9f",
                                "sense_id": "9a38bfb2-4de6-326a-9885-0eb2c3434540",
                                "text": "L’article suggère qu’il importe de « déséthiciser » les questions de migrations afin de les traiter politiquement : cela doit nous conduire à abandonner la métaphore de l’hospitalité pour traiter les conditions de la citoyenneté."
                            },
                            {
                                "example_id": "09692dd8-b943-433f-ac74-ff95a3d6ad54",
                                "sense_id": "9a38bfb2-4de6-326a-9885-0eb2c3434540",
                                "text": "D’où une « disqualification » de la relation sociale et politique, et qu’elle est pour ainsi dire « déséthicisée »."
                            }
                        ]
                    }
                ],
