                "senses": [
                    {
                        "sense_id": "67a3c9c8-ed88-3e64-92c8-185ab6fea652",
                        "entry_id": "532e2708-f885-3119-be18-0b05c139d5ae",
                        "glosses": [
                            "(früher aus Ton gefertigte) Scheibe, die in die Luft geschleudert wird, als Ziel für ein Schießen im sportlichen Wettkampf; Tontaube"
                        ],
                        "tags": [
                            "Schießsport"
                        ],
                        "examples": [
                            {
                                "example_id": "bc3c8781-7304-4c99-831d-ec57b1de5e4c",
                                "sense_id": "67a3c9c8-ed88-3e64-92c8-185ab6fea652",
                                "text": "Im olympischen Finale verfehlte er nur eine einzige Tontaube und gewann so die Goldmedaille."
                            },
                            {
                                "example_id": "c08d8f76-529f-4f43-87d6-ec0382f68831",
                                "sense_id": "67a3c9c8-ed88-3e64-92c8-185ab6fea652",
                                "text": "„Vielleicht war ich einfach hungrig, einsam, eine Tontaube, die jeder mit einer Spielzeugpistole abschießen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
