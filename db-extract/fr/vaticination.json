        "fr-extract.jsonl": [
            {
                "entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
                "word": "vaticination",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9d452d73-d70a-4190-b07b-6724569e1f99",
                        "entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
                        "tags": [
                            "plural"
                        ],
                        "form": "vaticinations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "604b7ba8-8a4f-319d-a02b-c59e45b2e66c",
                        "entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
                        "glosses": [
                            "Prédiction des choses futures, prophétie."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "385fe135-b4f1-4862-b129-d010bfc1c8c6",
                                "sense_id": "604b7ba8-8a4f-319d-a02b-c59e45b2e66c",
                                "text": "Il fait entendu dire qu’on pouvait y altérer l’ordre des lettres à telle enseigne qu’un texte aurait pu engendrer son propre contraire et promettre d’obscures vaticinations."
                            }
                        ]
                    },
                    {
                        "sense_id": "c90f7036-bfc6-30c9-b8dd-6faf3a9f8258",
                        "entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
                        "glosses": [
                            "Délire verbal, comme si on était habité par un dieu."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1f5b91f8-0ba0-445f-aa9f-586a468b5d5c",
                                "sense_id": "c90f7036-bfc6-30c9-b8dd-6faf3a9f8258",
                                "text": "Si quelqu’un avait pu enregistrer, bout à bout, ces prodigieuses vaticinations, il aurait eu une chronique épique du séjour que devait faire Gilbert de la Rouéchotte dans ce que l’on appelle « le milieu artistique » de la capitale."
                            },
                            {
                                "example_id": "4b140e61-d618-4d84-a005-b14049202286",
                                "sense_id": "c90f7036-bfc6-30c9-b8dd-6faf3a9f8258",
                                "text": "Magnus ne comprend rien aux vaticinations de frère Jean, mais son agacement est tombé, il n’a plus envie de débattre avec ce bonhomme aussi folingue que têtu, juste de se reposer et de manger un peu, la faim soudain l’emportant sur la fatigue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0412e5c0-687a-444b-b3e5-a27b30024eed",
                        "source_entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
                        "target_lang_word": "vaticination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaticination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14159ce3-4b83-30f2-a1ba-ece30179db56",
                                        "entry_id": "723379a1-0853-3427-b97e-1e66971aecd3",
                                        "glosses": [
                                            "Prediction, prophecy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3405b1ed-c86e-419b-ae5c-1f5da90961b1",
                                                "sense_id": "14159ce3-4b83-30f2-a1ba-ece30179db56",
                                                "text": "Yorick ſcarce ever heard this ſad vaticination of his deſtiny read over to him, but with a tear ſtealing from his eye, […]"
                                            },
                                            {
                                                "example_id": "38821f5c-2749-4c01-a92d-36bbaa64fdbb",
                                                "sense_id": "14159ce3-4b83-30f2-a1ba-ece30179db56",
                                                "text": "[…]for that honest gentleman, never the most susceptible of extraneous impressions, had just that moment parted from Meg Merrilies, and was too deeply wrapt up in pondering upon her vaticinations, to make any answer to Hazlewood's call."
                                            },
                                            {
                                                "example_id": "f8ba8c76-6350-4db7-8a36-1f40782159fe",
                                                "sense_id": "14159ce3-4b83-30f2-a1ba-ece30179db56",
                                                "text": "Every surmise and vaticination of the mind is entitled to a certain respect, and we learn to prefer imperfect theories, and sentences, which contain glimpses of truth, to digested systems which have no one valuable suggestion."
                                            },
                                            {
                                                "example_id": "5a74e638-19d5-442b-badf-51f182261a02",
                                                "sense_id": "14159ce3-4b83-30f2-a1ba-ece30179db56",
                                                "text": "The anonymous oracle, the author of this pamphlet, is an example of entertaining dullness. He has manufactured a very damp squib; he is a serious man in motley; and practical ideas occasionally drop in among his fantastic vaticinations."
                                            },
                                            {
                                                "example_id": "4f32e5b0-f0c9-4fee-a993-54ff3f0d0bd4",
                                                "sense_id": "14159ce3-4b83-30f2-a1ba-ece30179db56",
                                                "text": "Archer had been wont to smile at these annual vaticinations of his mother's; but this year even he was obliged to acknowledge, as he listened to an enumeration of the changes, that the \"trend\" was visible."
                                            },
                                            {
                                                "example_id": "2cfc55ce-1e40-404d-8351-4c201cb8234f",
                                                "sense_id": "14159ce3-4b83-30f2-a1ba-ece30179db56",
                                                "text": "[…][Nineteen Eighty-Four] breaks all records for gloomy vaticination[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ac8d90-e861-46d1-8e88-b81bc2d59dd6",
                        "source_entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
                        "target_lang_word": "vaticinazione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
