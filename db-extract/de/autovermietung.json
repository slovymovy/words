                    {
                        "sense_id": "6e944fc8-2e57-382f-bc55-abd77a690443",
                        "entry_id": "0665c3cd-6da1-304e-9743-04f683934a85",
                        "glosses": [
                            "die Vermietung von Autos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d7ec9a-fa59-47c1-824c-91acc3760ade",
                                "sense_id": "6e944fc8-2e57-382f-bc55-abd77a690443",
                                "text": "Autovermietungen sind bei uns nicht üblich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e2cd0b4e-5e9c-3cf9-94da-372530bf28eb",
                        "entry_id": "0665c3cd-6da1-304e-9743-04f683934a85",
                        "glosses": [
                            "Unternehmen, bei dem Fahrzeuge gegen Geld entliehen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93f5ae4-3401-456a-9df1-b7c7d7146977",
                                "sense_id": "e2cd0b4e-5e9c-3cf9-94da-372530bf28eb",
                                "text": "Bei welcher Autovermietung hattet ihr den Transporter für den Umzug besorgt?"
                            },
                            {
                                "example_id": "7f010265-cef4-422f-ab2f-422dac49f897",
                                "sense_id": "e2cd0b4e-5e9c-3cf9-94da-372530bf28eb",
                                "text": "„Dann kamen noch mehr Fremde, und er machte eine Autovermietung auf, und dann baute er eine Art Pension.“"
                            },
                            {
                                "example_id": "e827e150-d162-4335-9043-ac2f326d5208",
                                "sense_id": "e2cd0b4e-5e9c-3cf9-94da-372530bf28eb",
                                "text": "„Schon der Weg vom Flugzeug zur Autovermietung allerdings war desillusionierend.“"
                            },
                            {
                                "example_id": "ad9c04ca-526c-420a-a8d2-f8044386238a",
                                "sense_id": "e2cd0b4e-5e9c-3cf9-94da-372530bf28eb",
                                "text": "„Bei der Autovermietung standen Leute in Funktionsjacken und Turnschuhen, es war nicht schwer, besser auszusehen als andere.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
