                "senses": [
                    {
                        "sense_id": "c4669a83-7fa4-3a74-8469-c5851760689c",
                        "entry_id": "ef15e7e6-c70f-396c-b124-1d2996d0b8ae",
                        "glosses": [
                            "Maßnahmen und Vorrichtungen zum Schutz vor den schädigenden Wirkungen ionisierender und nicht ionisierender Strahlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b02f30e-45b4-4c16-a784-bb29089e11f2",
                                "sense_id": "c4669a83-7fa4-3a74-8469-c5851760689c",
                                "text": "„Wer ein paarmal Wild mit einem hohen Cäsium-Gehalt isst, müsse sich noch keine Sorgen machen, sagt Christian Katzlberger, Leiter der Abteilung Strahlenschutz bei der Ages.“"
                            },
                            {
                                "example_id": "5e8cb2c1-e423-4aaf-b353-976fdd8b3d73",
                                "sense_id": "c4669a83-7fa4-3a74-8469-c5851760689c",
                                "text": "„Noch höher als bei Handys, warnt das Bundesamt für Strahlenschutz, sei allerdings die potenzielle Belastung durch ganz normale, schnurlose Telefone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
