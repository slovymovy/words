                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The freeminer secured a <w>gale</w> to extract coal from the forest.",
                            "target_lang_translations": {
                                "ru": "Фримайнер получил <w>отвод</w> на добычу угля в лесу.",
                                "es": "El minero libre obtuvo una <w>concesión minera</w> para extraer carbón del bosque."
                            }
