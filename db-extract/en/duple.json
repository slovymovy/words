                        "examples": [
                            {
                                "example_id": "b6f882f5-c0c4-4c0e-841d-c2b3350b4bb7",
                                "sense_id": "de3d3a11-ad26-37c8-94a7-eb6515f68ee2",
                                "text": "McGonagall is earnestly trying to gather the resources of a metrical tradition, not subvert it, but the mismatch of duple and triple measure in the first line alone means that, while it’s made of recognisable metrical feet, the line doesn’t feel like it belongs to any specific metrical pattern (iambic, dactylic, anapestic etc) or mode (pastoral, elegy or ballad)."
                            }
                        ]
