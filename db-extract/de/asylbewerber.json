                                        "entry_id": "476067ae-409e-3f61-b989-037b0e614045",
                                        "glosses": [
                                            "iemand die asiel zoekt buiten zijn eigen land omdat hij in zijn eigen land wordt bedreigd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc82a1ab-a13e-4aa9-ae7b-6e7c3401adde",
                                                "sense_id": "fe06a9da-44bb-3c28-b1ac-5b6ab4095a6c",
                                                "text": "Nederland moet soms asielzoekers weigeren."
                                            },
                                            {
                                                "example_id": "7c65112f-39d1-4258-b920-8094c35491f9",
                                                "sense_id": "fe06a9da-44bb-3c28-b1ac-5b6ab4095a6c",
                                                "text": "Asielzoekers kunnen zich beroepen op het vluchtelingenverdrag van 1951."
                                            },
                                            {
                                                "example_id": "8bacd17e-4aee-42d2-bcb5-e59e3252a009",
                                                "sense_id": "fe06a9da-44bb-3c28-b1ac-5b6ab4095a6c",
                                                "text": "Staatssecretaris Van der Burg schrijft aan de Tweede Kamer dat het Centraal Orgaan opvang asielzoekers (COA) een hotel in Albergen heeft gekocht. Al sinds april wordt met de gemeente gesproken over opvang van asielzoekers in dat gebouw, maar tot een akkoord is het niet gekomen."
                                            }
