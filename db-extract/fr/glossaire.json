                                        "glosses": [
                                            "obra que contém definições de termos técnicos usados em certa área do conhecimento, ou seja, do jargão específico daquela área (como, v. g., glossário médico, mecânico, jurídico, filosófico e outros)"
                                        ],
                                        "tags": [
