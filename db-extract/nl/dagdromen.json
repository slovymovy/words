            {
                "entry_id": "f8fbd2c6-d769-3fc9-869f-b3faf54e7860",
                "word": "dagdromen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dc334970-b0df-3a7b-b23a-146079fc72d4",
                        "entry_id": "f8fbd2c6-d769-3fc9-869f-b3faf54e7860",
                        "glosses": [
                            "fantaseren over de toekomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb358ee-dae4-456d-befa-ba8a4c0e6de8",
                                "sense_id": "dc334970-b0df-3a7b-b23a-146079fc72d4",
                                "text": "Ik dagdroomde over een lange fietsvakantie door Nederland."
                            },
                            {
                                "example_id": "e20248f0-1062-486e-8592-f023ca63aef7",
                                "sense_id": "dc334970-b0df-3a7b-b23a-146079fc72d4",
                                "text": "Misschien heb ik iets gemist hoor, maar wat is er mis met zinloos vergaderen? Het is de ideale plek voor een powernap op kantoor en je kan er ook fijn je werk afmaken, je appjes beantwoorden, dagdromen over de nieuwe stagiair en je Twitter en Facebook bijwerken."
                            },
                            {
                                "example_id": "f93d284c-bdd4-4859-ac3d-0d3acd9e3f6b",
                                "sense_id": "dc334970-b0df-3a7b-b23a-146079fc72d4",
                                "text": "Naast haar stond een bijpassende handtas waarover iedere modebewuste vrouw dagdroomde."
                            }
                        ]
                    },
                    {
                        "sense_id": "df153740-c3ae-33fe-8d41-42795eeebf8c",
                        "entry_id": "f8fbd2c6-d769-3fc9-869f-b3faf54e7860",
                        "glosses": [
                            "zich in een half slapende toestand bevinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2a6537-b8fe-40a9-9ba1-76f3f6461d88",
                                "sense_id": "df153740-c3ae-33fe-8d41-42795eeebf8c",
                                "text": "Piet wordt eens wakker! Wat zit je nu weer te dagdromen."
                            }
                        ]
                    }
                ],
