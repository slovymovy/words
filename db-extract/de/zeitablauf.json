                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a9bd6a-3e83-4956-a01a-2acb8282f562",
                                "sense_id": "1c1db01b-f2a9-363f-8b0e-eebab901d1f5",
                                "text": "„In Zweifel gelten Eheverfehlungen nicht als durch Zeitablauf verwirkt, der Kläger braucht die Einhaltung der Frist des § 57 Abs 1 EheG nicht zu beweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2747b4b-f6a3-359b-a3cb-ce69ab868d17",
                        "entry_id": "aaabc0a9-ddbe-37b4-8065-b10c7b6cc0e8",
                        "glosses": [
                            "chronologischer Fortschritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2300ec8c-a790-4e59-98f8-1ab7f978b489",
                                "sense_id": "b2747b4b-f6a3-359b-a3cb-ce69ab868d17",
                                "text": "„In seinen Kompositionen lehnt sich Neuwirth an die Reihentechnik der Wiener Schule an, legt aber zusätzlich auch noch den Zeitablauf eines Werkes zahlenmäßig fest.“"
                            },
                            {
                                "example_id": "e5e88457-b113-471f-a9f4-6ec8bbed3e6c",
                                "sense_id": "b2747b4b-f6a3-359b-a3cb-ce69ab868d17",
                                "text": "„Dignitas hat angekündigt, den Zeitablauf von der Einnahme des Medikaments, bis zum Einschlafen und Tod bald statistisch untersuchen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
