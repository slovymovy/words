{
    "word_family": [
        "demand",
        "mandate",
        "mandatory",
        "command"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88769b4b-f0b9-3e36-8028-a15b91e37181",
                    "sense_definition": "A demand or an authoritative request.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king issued a stern <w>mand</w> that all citizens must pay the new tax immediately.",
                            "target_lang_translations": {
                                "ru": "Король издал строгое <w>предписание</w> о том, что все граждане должны немедленно уплатить новый налог."
                            }
                        },
                        {
                            "text": "She felt she had no choice but to follow the <w>mand</w> of her superiors.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что у неё нет другого выбора, кроме как подчиниться <w>велению</w> начальства."
                            }
                        }
                    ],
                    "synonyms": [
                        "demand",
                        "command",
                        "order"
                    ],
                    "antonyms": [
                        "suggestion",
                        "request"
                    ],
                    "common_phrases": [
                        "stern mand",
                        "royal mand"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English outside of specific historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Требование или авторитетное распоряжение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предписание",
                                "target_lang_sense_clarification": "официальное распоряжение"
                            },
                            {
                                "target_lang_word": "веление",
                                "target_lang_sense_clarification": "авторитетное требование"
                            },
                            {
                                "target_lang_word": "приказ",
                                "target_lang_sense_clarification": "строгое распоряжение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f23b5e1-0f90-3c2a-817f-d4f0b1cae005",
                    "sense_definition": "In behavioral psychology, a verbal request or command that is reinforced by a specific consequence, such as obtaining an object or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavioral_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist taught the child to use a <w>mand</w> to ask for a glass of water.",
                            "target_lang_translations": {
                                "ru": "Терапевт научил ребёнка использовать <w>манд</w>, чтобы попросить стакан воды."
                            }
                        },
                        {
                            "text": "A <w>mand</w> training session helps students communicate their immediate needs effectively.",
                            "target_lang_translations": {
                                "ru": "Занятие по обучению <w>манд-реакциям</w> помогает учащимся эффективно сообщать о своих насущных потребностях."
                            }
                        }
                    ],
                    "synonyms": [
                        "request"
                    ],
                    "common_phrases": [
                        "mand training",
                        "verbal mand"
                    ],
                    "target_lang_definitions": {
                        "ru": "В поведенческой психологии: вербальная просьба или команда, подкрепляемая конкретным последствием (получением предмета или действия)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манд",
                                "target_lang_sense_clarification": "термин в прикладном анализе поведения"
                            },
                            {
                                "target_lang_word": "просьба",
                                "target_lang_sense_clarification": "в контексте функциональной коммуникации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be339fc5-c06c-399a-a833-3774f1dfae31",
                    "sense_definition": "To produce a verbal request or command that is motivated by a specific need or desire, typically in the context of behavioral therapy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavioral_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student began to <w>mand</w> for his favorite toy after several weeks of practice.",
                            "target_lang_translations": {
                                "ru": "После нескольких недель практики ученик начал сам <w>просить</w> свою любимую игрушку."
                            }
                        },
                        {
                            "text": "It is important to reinforce the behavior when the subject starts to <w>mand</w> spontaneously.",
                            "target_lang_translations": {
                                "ru": "Важно подкреплять поведение, когда субъект начинает <w>мандировать</w> спонтанно."
                            }
                        }
                    ],
                    "synonyms": [
                        "request",
                        "ask"
                    ],
                    "common_phrases": [
                        "mand for items"
                    ],
                    "target_lang_definitions": {
                        "ru": "Озвучивать вербальную просьбу или команду, мотивированную конкретной потребностью или желанием (в контексте поведенческой терапии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мандировать",
                                "target_lang_sense_clarification": "использовать манд-реакции"
                            },
                            {
                                "target_lang_word": "просить",
                                "target_lang_sense_clarification": "выражать потребность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9349efd5-f06b-306e-8ae5-67d170e2dcb5",
                    "sense_definition": "A surname of Dutch, German, or Punjabi origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed several families with the last name <w>Mand</w>.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике значилось несколько семей с фамилией <w>Манд</w>."
                            }
                        },
                        {
                            "text": "Professor <w>Mand</w> published a significant paper on linguistics last year.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Манд</w> опубликовал важную работу по лингвистике в прошлом году."
                            }
                        }
