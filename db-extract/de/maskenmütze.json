                "senses": [
                    {
                        "sense_id": "bcac933b-2652-387f-a851-aab91f0f6c06",
                        "entry_id": "29e13cf5-294c-32c4-b8e0-792b98790965",
                        "glosses": [
                            "(verhüllende) weiche Bedeckung von Kopfhaar und Gesicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9da9c6e-7f49-4a0c-a9b6-9441a98b05d5",
                                "sense_id": "bcac933b-2652-387f-a851-aab91f0f6c06",
                                "text": "„Das bartlose Gesicht steckte nicht mehr unter einer Maskenmütze.“"
                            },
                            {
                                "example_id": "52abf6a5-9b40-4fa0-909b-4f7c9471683f",
                                "sense_id": "bcac933b-2652-387f-a851-aab91f0f6c06",
                                "text": "„Zufrieden verließ Camilla das Haus und zog Maskenmütze, Stiefel, Handschuhe und Schal an.“"
                            },
                            {
                                "example_id": "d9326cc0-35bc-403b-8cab-513e53243da8",
                                "sense_id": "bcac933b-2652-387f-a851-aab91f0f6c06",
                                "text": "„Einer kickte mit dem Fuß deren Pistole zur Seite und riss ihr die Maskenmütze vom Gesicht.“"
                            },
                            {
                                "example_id": "97bae465-c61c-4c1c-b01e-b721a4b5771b",
                                "sense_id": "bcac933b-2652-387f-a851-aab91f0f6c06",
                                "text": "„Und dann lief Noer, der durch seine Maskenmütze so gut wie nichts sehen konnte, ihnen direkt in die Arme – ich sah, wie sie ihm am Ende der Mittenhead Lane flatsch! einen Mehlsack überzogen und das Weiß in alle Richtungen davonstob.“"
                            },
                            {
                                "example_id": "a8fc1f47-de26-4dd9-8e83-a7b966f9811e",
                                "sense_id": "bcac933b-2652-387f-a851-aab91f0f6c06",
                                "text": "„Zur gefälligen Kenntniß diene den geehrten Eingeladenen zur am 5. Februar stattfindenden maskirten Abend-Unterhaltung der Verkehrs-Beamten und Bediensteten, daß die ausgestellten Karten nur für die Betreffenden und deren Familienangehörige gelten und zum Eintritt in den Saal incl. Gallerie das Tragen von mindestens einer Maskenmütze Bedingung ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
