                            {
                                "example_id": "bce0be0c-1106-4a5e-a8b8-d6000cc21bc9",
                                "sense_id": "ef1642a0-f46d-3578-88d4-ea42d6ff7e61",
                                "text": "Wyrażenie „mokra woda” to pleonazm."
