                "senses": [
                    {
                        "sense_id": "288dd948-5f24-3eb3-ad8e-0a5ff8e34cf7",
                        "entry_id": "39a69436-e978-3c8a-9446-55ce973f7f3c",
                        "glosses": [
                            "Arme à feu portative de poing dont le barillet rotatif est percé de plusieurs chambres s'alignant tour à tour avec le canon et le système de percussion, permettant de tirer plusieurs coups sans interruption."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "f242ce6c-4bd1-4bdf-be4d-b8a3c35c3572",
                                "sense_id": "288dd948-5f24-3eb3-ad8e-0a5ff8e34cf7",
                                "text": "La plupart des révolvers permettent de tirer six coups. Certains, de très fort calibre, n'en comptent que cinq, d'autres de petit calibre peuvent en compter jusqu'à douze, alors que des armes de très petite taille peuvent n'en contenir que trois pour conserver un encombrement minimal."
                            }
                        ]
                    },
                    {
                        "sense_id": "58611c76-d3d4-32fc-b396-504743c49e56",
                        "entry_id": "39a69436-e978-3c8a-9446-55ce973f7f3c",
                        "glosses": [
                            "Pistolet quelconque, à chargeur ou à barillet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9292014-22e1-456b-bc05-6cb584bf5bb4",
                                "sense_id": "58611c76-d3d4-32fc-b396-504743c49e56",
                                "text": "Tirer un coup de révolver."
                            },
                            {
                                "example_id": "233f8b4e-2a5b-43aa-bedb-2188ba139a68",
                                "sense_id": "58611c76-d3d4-32fc-b396-504743c49e56",
                                "text": "En voyage, j’avais un petit révolver dans mon nécessaire."
                            }
                        ]
                    }
