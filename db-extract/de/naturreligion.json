                "senses": [
                    {
                        "sense_id": "def00b89-9072-3ef5-98c5-e3fd2717794a",
                        "entry_id": "dfa46ac0-5e1a-3b64-87fa-8f0ab2026e6e",
                        "glosses": [
                            "„Religion, in der Naturgegenstände und Naturkräfte als göttliche Wesen verehrt werden“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70e5033-893b-4cb3-b9cf-f231dc25beb4",
                                "sense_id": "def00b89-9072-3ef5-98c5-e3fd2717794a",
                                "text": "„Die früheren Bezeichnungen Naturreligion und Stammesreligion gelten in der heutigen Religionswissenschaft als veraltet.“"
                            },
                            {
                                "example_id": "5e45d22a-a6d9-4219-b2c2-d24386565222",
                                "sense_id": "def00b89-9072-3ef5-98c5-e3fd2717794a",
                                "text": "„Die Satansmessen sind wohl die Überreste der Naturreligion, durch Anpassung an die herrschende Lehre ebenso bis zur Unkenntlichkeit entstellt wie Wotan, als er zum wilden Jäger wurde.“"
                            },
                            {
                                "example_id": "1c1a1c67-e91f-4901-b1a4-636e994a2bd4",
                                "sense_id": "def00b89-9072-3ef5-98c5-e3fd2717794a",
                                "text": "„Eine Besonderheit stellen die wenige Tausend Menschen umfassenden Kailash dar, die in den nördlich abgelegenen Tälern des langgezogenen Chitraltals beheimatet sind und Naturreligionen anhängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
