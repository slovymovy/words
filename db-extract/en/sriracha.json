                    {
                        "sense_id": "a95d0076-4320-386a-ad31-94cb879f83ae",
                        "entry_id": "78a2817e-2dfa-3ab1-8bad-bf9af95b32b0",
                        "glosses": [
                            "A Thai-style hot sauce, typically made from sun-ripened chili peppers, vinegar, garlic, sugar and salt."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "7a48b02d-3e7c-4c63-b287-b72268b340f1",
                                "sense_id": "a95d0076-4320-386a-ad31-94cb879f83ae",
                                "text": "While chicken is smoking, combine zest, hoisin, pomegranate molasses and sriracha in a small bowl."
                            },
                            {
                                "example_id": "fc2eaa47-f869-44fe-9692-3e532b7a8919",
                                "sense_id": "a95d0076-4320-386a-ad31-94cb879f83ae",
                                "text": "Chilis and peppers help, in whatever form. Hot sauce helps—shrill, vinegary tonics or sweet, syrupy srirachas. Lots of pico de gallo, with triple the jalapeño."
                            },
                            {
                                "example_id": "93b9b271-9aee-45db-ae2e-6ff0b7bd1726",
                                "sense_id": "a95d0076-4320-386a-ad31-94cb879f83ae",
                                "text": "Sriracha lovers everywhere are feeling the not so pleasant sting of the beloved hot sauce shortage, now in its second year. Drought in Mexico has resulted in a scarcity of chilli peppers – in particular, red jalapeños, the raw material of sriracha – leading Huy Fong Foods, the California-based maker of the iconic condiment, to scale back production."
                            }
                        ]
                    }
