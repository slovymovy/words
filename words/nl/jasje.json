                    "semantic_group_id": "clothing_jacket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draagt vandaag een donkerblauw <w>jasje</w> naar zijn werk.",
                            "target_lang_translations": {
                                "en": "He is wearing a dark blue <w>jacket</w> to work today.",
                                "ru": "Сегодня он надел на работу темно-синий <w>пиджак</w>.",
                                "pl": "On ma dziś na sobie ciemnoniebieską <w>marynarkę</w> do pracy.",
                                "de": "Er trägt heute ein dunkelblaues <w>Sakko</w> zur Arbeit.",
                                "fr": "Il porte aujourd'hui une <w>veste</w> bleu marine pour aller au travail.",
                                "it": "Oggi indossa una <w>giacca</w> blu scuro per andare al lavoro.",
                                "cs": "Dnes si bere do práce tmavomodré <w>sako</w>.",
                                "tr": "Bugün işe giderken koyu mavi bir <w>ceket</w> giyiyor.",
                                "es": "Hoy lleva una <w>chaqueta</w> azul oscuro al trabajo."
                            }
                        },
                        {
                            "text": "Voor het feest heeft hij zijn oude <w>jasje</w> weer uit de kast gehaald.",
                            "target_lang_translations": {
                                "en": "For the party, he took his old <w>jacket</w> out of the closet again.",
                                "ru": "Для вечеринки он снова достал из шкафа свой старый <w>пиджак</w>.",
                                "pl": "Na imprezę znowu wyciągnął z szafy swoją starą <w>marynarkę</w>.",
                                "de": "Für die Feier hat er sein altes <w>Jackett</w> wieder aus dem Schrank geholt.",
                                "fr": "Pour la fête, il a de nouveau sorti sa vieille <w>veste</w> du placard.",
                                "it": "Per la festa ha tirato di nuovo fuori dall'armadio la sua vecchia <w>giacca</w>.",
                                "cs": "Na večírek si ze skříně opět vytáhl své staré <w>sako</w>.",
                                "tr": "Parti için eski <w>ceketini</w> yine dolaptan çıkardı.",
                                "es": "Para la fiesta, volvió a sacar su vieja <w>chaqueta</w> del armario."
