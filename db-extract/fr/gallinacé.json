                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54aa0d4-1527-4bda-83af-adf0bf773b25",
                                "sense_id": "8f736982-01a3-307a-ab66-535deba64274",
                                "text": "Le grand tétras ou grand coq de bruyère est le plus gros oiseau gallinacé d’Europe."
                            }
                        ]
                    }
                ],
