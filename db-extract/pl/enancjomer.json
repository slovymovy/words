                        "entry_id": "1a95ca0f-fd5c-3932-b389-8a59fe1a634b",
                        "glosses": [
                            "cząsteczka posiadająca odpowiednik, którego struktura jest lustrzanym odbiciem jej własnej struktury"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9c579b-6e27-45d6-b2b8-fa137b01f3e0",
                                "sense_id": "b8fb5008-8b69-3ad9-82cd-d5550b57f67c",
                                "text": "Przeciwnicy hipotezy Wrighta wskazują przykłady enancjomerów optycznych, które charakteryzują się różnym zapachem mimo jednakowego widma w podczerwieni, […]."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "691c6ea1-0bce-4a58-9134-f40ba5b663de",
