                "senses": [
                    {
                        "sense_id": "85fbd07e-3235-3aa0-b84e-8f1c169afe1d",
                        "entry_id": "8d5066f8-67b6-3a54-93c2-7f56bf7bf3be",
                        "glosses": [
                            "große, dichte Menge Sand in der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d362918-5453-4b43-96fd-c81fcdb90b0a",
                                "sense_id": "85fbd07e-3235-3aa0-b84e-8f1c169afe1d",
                                "text": "„Der Mond strahlte hell über den urtümlichen Ruinen und beleuchtete eine dichte Sandwolke, die scheinbar von einem heftigen, aber abflauenden Wind aus irgendeiner Ecke der Felsflanke vor mir aufgewirbelt wurde.“"
                            },
                            {
                                "example_id": "ddd7540b-3adb-44c7-8162-7d4d77773a07",
                                "sense_id": "85fbd07e-3235-3aa0-b84e-8f1c169afe1d",
                                "text": "„Ihm war, als nehme er in der wirbelnden Sandwolke, die gewaltiger als sein Palast in die Höhe ragte, riesige verrostete, ineinander verdrehte Oberflächen wahr und höre er ein dumpfes, nicht enden wollendes Grollen, das klang wie das Sinnieren eines stählernen Kolosses.“"
                            },
                            {
                                "example_id": "ea2de6b4-6751-40c5-8f17-96b87baa09b6",
                                "sense_id": "85fbd07e-3235-3aa0-b84e-8f1c169afe1d",
                                "text": "„Der Herzog steuerte nun die Sandwolke über der Erntefabrik an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
