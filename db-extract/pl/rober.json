                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36be642f-45d7-4af0-80b0-78687b1d31be",
                                                "sense_id": "9cb03f70-ffe5-3808-a545-55ae97f6033b",
                                                "text": "For example, they may use paddle pop sticks, hand span, pencils, rubbers, mathematics equipment (i.e. base 10 material) or anything else the teacher can find to measure the lengths of nominated objects."
                                            },
                                            {
                                                "example_id": "f61b74d9-683e-4649-99b4-983265226d00",
                                                "sense_id": "9cb03f70-ffe5-3808-a545-55ae97f6033b",
                                                "text": "Drawing materials, he thought, I used to love drawing as a lad. I can afford some plain paper and pencils, surely? And a rubber, too. He smiled at the memory of an elderly uncle, also fond of drawing, who′d always called rubbers ‘lead eaters’."
                                            },
                                            {
                                                "example_id": "e20587d4-583f-4348-a8cf-1f96c22f4840",
                                                "sense_id": "9cb03f70-ffe5-3808-a545-55ae97f6033b",
                                                "text": "Stan stole a diary and some pens, pencils, ink and rubbers during his early days as a POW working on the Singapore docks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a8a977e-a13c-30b0-9ea6-2cc4cfcb1099",
                                        "entry_id": "bee1068d-1dee-3df4-96e9-a1e925c69f69",
                                        "glosses": [
                                            "A condom, especially an external condom."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad5f66f-50af-46c2-a33d-237a126f2627",
                                                "sense_id": "4a8a977e-a13c-30b0-9ea6-2cc4cfcb1099",
                                                "text": "And the rubbers you hide / In your top left pocket"
                                            },
                                            {
                                                "example_id": "afec4792-923c-4709-9132-75f2bf71ebf7",
                                                "sense_id": "4a8a977e-a13c-30b0-9ea6-2cc4cfcb1099",
                                                "text": "Don't have sex, because you will get pregnant and die! Don't have sex in the missionary position, don't have sex standing up, just don't do it, OK, promise? OK, now everybody take some rubbers."
                                            },
                                            {
                                                "example_id": "00f3adfb-beb8-463e-bfb7-4c3782656bcb",
                                                "sense_id": "4a8a977e-a13c-30b0-9ea6-2cc4cfcb1099",
                                                "text": "My daddy said \"Treat young girls like your mother\" / My momma said \"Trust no hoe, use a rubber\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "982dd2b6-c707-3811-ab85-65cc31dee6f5",
                                        "entry_id": "bee1068d-1dee-3df4-96e9-a1e925c69f69",
                                        "glosses": [
                                            "Someone or something which rubs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea38b1db-f227-4e3e-90db-5c074ade75ca",
                                                "sense_id": "982dd2b6-c707-3811-ab85-65cc31dee6f5",
                                                "text": "What perplexity plagues the chin-rubber in the foreground and what so discourages the man leaning on the lamp post? And to what doom is the large man at right moving? Photographer Cowherd has no answers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a42f506-75b2-3d9b-bfbd-355decf3ffa3",
                                        "entry_id": "bee1068d-1dee-3df4-96e9-a1e925c69f69",
                                        "glosses": [
                                            "Someone or something which rubs.",
                                            "One who rubs down horses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38c98301-7b16-3583-9f8d-4fb0491a6e05",
                                        "entry_id": "bee1068d-1dee-3df4-96e9-a1e925c69f69",
                                        "glosses": [
                                            "Someone or something which rubs.",
                                            "One who practises massage."
                                        ],
                                        "tags": [
