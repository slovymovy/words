                ],
                "senses": [
                    {
                        "sense_id": "249cb37b-2930-372b-9b7f-243fac8bd941",
                        "entry_id": "335ed919-fbef-3678-9bab-0f158933e556",
                        "glosses": [
                            "in gewisser Hinsicht mit einem Papagei vergleichbar, ihm ähnlich: so bunt, so plappernd, so krächzend oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc1ed120-bb52-48d0-b383-6efa223b5033",
                                "sense_id": "249cb37b-2930-372b-9b7f-243fac8bd941",
                                "text": "„Bei gleichzeitigem Gejammer über drohende Vergreisung und papageienhaft wiederholten Forderungen, mehr für Jugend und Bildung zu tun, leistet sich die Bundesrepublik – das immer noch reiche Land – einen Zuwachs von beschämendem Ausmaß, ‚Kinderarmut‘ genannt.“"
                            },
                            {
                                "example_id": "b65dfc5d-8246-4419-871a-55569dde9d2b",
                                "sense_id": "249cb37b-2930-372b-9b7f-243fac8bd941",
                                "text": "„Nehmen Sie Cornelia Pieper, die Generalsekretärin der FDP: zieht sie mal etwas Auffälliges an, wird sie gleich als ‚papageienhaft‘ bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
