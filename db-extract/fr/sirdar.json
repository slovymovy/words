                "senses": [
                    {
                        "sense_id": "e0b9f19e-188f-3db3-8c79-63117223d08d",
                        "entry_id": "53efa560-dbae-3d88-9ccd-ea54de72b745",
                        "glosses": [
                            "Titre de chef en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c11cdc0-eeaf-4d9b-b12a-9423797108ab",
                                "sense_id": "e0b9f19e-188f-3db3-8c79-63117223d08d",
                                "text": "Dhunputh Aukhaj s’impose ce rythme de travail pendant quatre longues années avant d’être recruté comme sirdar des travaux publics."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b602b38-088d-34bd-ab04-88c3861e683d",
                        "entry_id": "53efa560-dbae-3d88-9ccd-ea54de72b745",
                        "glosses": [
                            "Chef, guide d’un trek de montagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2908a17-1bf4-4b10-9f67-3bd093e62781",
                                "sense_id": "0b602b38-088d-34bd-ab04-88c3861e683d",
                                "text": "Nous rencontrons l’ensemble de l’équipe : sirdar, sherpa, cuisinier et porteurs qui nous accompagnent durant l’expédition."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c9ff94f-d091-3a7d-9a69-acdd8befdc9f",
                        "entry_id": "53efa560-dbae-3d88-9ccd-ea54de72b745",
                        "glosses": [
                            "Contremaître dans les plantations sucrières de l’île Maurice, à l’époque coloniale."
                        ],
                        "tags": [
                            "Île Maurice"
                        ],
                        "examples": [
                            {
                                "example_id": "ad05cd70-0ff1-45c5-99b4-e334ab132490",
                                "sense_id": "2c9ff94f-d091-3a7d-9a69-acdd8befdc9f",
                                "text": "Je hais les sirdars. Je les méprise plus que tout au monde, parce qu’ils sont endurcis et méchants, et qu’ils battent les pauvres à coups de bâton quand les fardeaux de cannes n’arrivent pas assez vite jusqu’à la charrette."
                            },
                            {
                                "example_id": "e3fb81ce-ef87-419d-b0a6-c22b885be5d1",
                                "sense_id": "2c9ff94f-d091-3a7d-9a69-acdd8befdc9f",
                                "text": "Les coups de sifflet du sirdar et des arkotties se répondaient, haletaient, tantôt aigus, tantôt graves, se confondant avec le grondement de la mer sur les récifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d54a334f-5fad-47e8-be76-0aad763c2575",
                        "source_entry_id": "53efa560-dbae-3d88-9ccd-ea54de72b745",
