                                        "examples": [
                                            {
                                                "example_id": "02929e07-fead-4fb6-9dfd-c4ced439f554",
                                                "sense_id": "5a2ff866-eaf1-3ec4-b504-1e113f1e4e8b",
                                                "text": "Messergebnisse für die Entfernungen zwischen Erde und Mond und zwischen Paris und London sind metrologisch vergleichar, wenn sie beide metrologisch auf dieselbe Maßeinheit, z. B. den Meter, rückführbar sind."
                                            },
                                            {
                                                "example_id": "9cda12b0-74f7-4e84-a2b1-4d27848d9c08",
                                                "sense_id": "5a2ff866-eaf1-3ec4-b504-1e113f1e4e8b",
                                                "text": "Einigen Referenzmaterialien sind Größenwerte zugewiesen, die metrologisch auf eine Maßeinheit außerhalb eines Einheitensystems rückführbar sind."
                                            },
                                            {
                                                "example_id": "0e0cc3e7-835d-4cb6-bf6e-861a4c59ad79",
                                                "sense_id": "5a2ff866-eaf1-3ec4-b504-1e113f1e4e8b",
                                                "text": "Metrologisch folgen sie keltischen Standards und orientieren sich auch ikonographisch an keltischen Usancen."
                                            }
                                        ],
