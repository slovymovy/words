                "entry_id": "e80e9c8a-df13-3b55-9942-e2a66c075fce",
                "word": "scag",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ef67bd76-4f89-47ff-9ebd-a86ae1a896e8",
                        "entry_id": "e80e9c8a-df13-3b55-9942-e2a66c075fce",
                        "tags": [
                            "plural"
                        ],
                        "form": "scags"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cff73964-e5d5-3cf8-bd2f-bc8d96f79abf",
                        "entry_id": "e80e9c8a-df13-3b55-9942-e2a66c075fce",
                        "glosses": [
                            "Heroin."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c2a76b0-696c-49a1-ac30-09b8a463041b",
                                "sense_id": "cff73964-e5d5-3cf8-bd2f-bc8d96f79abf",
                                "text": "And I was snorting scag while other kids played tag"
                            },
                            {
                                "example_id": "e4a48a6d-4995-441f-a9aa-9957a6300d0d",
                                "sense_id": "cff73964-e5d5-3cf8-bd2f-bc8d96f79abf",
                                "text": "So goodbye Cocaine Carolina, you and I are through / I'm going back to Sandy Scag, she knows just what to do"
                            },
                            {
                                "example_id": "00bf3fee-a24a-42e8-b2e0-984f344b9767",
                                "sense_id": "cff73964-e5d5-3cf8-bd2f-bc8d96f79abf",
                                "text": "Mark: No. I'm off the scag. Ten days without the scag. And I'm going away."
                            },
                            {
                                "example_id": "4227b917-69ba-4ba3-81ce-e76bc4e6cc35",
                                "sense_id": "cff73964-e5d5-3cf8-bd2f-bc8d96f79abf",
                                "text": "“\"The detectives wiped the mobsters' blood off their boots and found the scag.\" Scag is heroin. And the book says it's so good, you can never stop doing it!” “See me after class, Jacob.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "6e6f1af8-ff1b-3a5e-b7df-3b286bc99171",
                        "entry_id": "e80e9c8a-df13-3b55-9942-e2a66c075fce",
                        "glosses": [
                            "A woman of loose morals."
                        ],
                        "tags": [
                            "countable",
                            "derogatory",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9baad731-ab2c-36ed-bd8a-724546356084",
                        "entry_id": "e80e9c8a-df13-3b55-9942-e2a66c075fce",
                        "glosses": [
                            "A cigarette."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "76fbf955-e85d-4d27-93f3-1c4813a257d9",
                                "sense_id": "9baad731-ab2c-36ed-bd8a-724546356084",
                                "text": "“Then have a skag,” said I. / “’Twill make it seem like happier times, / You liked this brand, I understand.”"
                            },
                            {
                                "example_id": "38bb2fd2-cc4b-4de0-8dbf-0ba49fea3f9d",
                                "sense_id": "9baad731-ab2c-36ed-bd8a-724546356084",
                                "text": "Awoke when our florescent lights came on and went outside to smoke a few scags before breakfast."
                            }
                        ]
                    }
                ],
