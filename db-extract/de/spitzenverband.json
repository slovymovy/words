                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e541d00-9fad-4a46-9954-6a7d0d239b16",
                                "sense_id": "2528583a-f54f-358e-8f1a-949ca6699b32",
                                "text": "Der Spitzenverband der gesetzlichen Krankenkassen hat die Vorwürfe bereits zurückgewiesen."
                            },
                            {
                                "example_id": "68b802ac-eef2-4204-91ff-0b393dd2ef27",
                                "sense_id": "2528583a-f54f-358e-8f1a-949ca6699b32",
                                "text": "Den kommunalen Spitzenverbänden zufolge hat nur ungefähr ein Fünftel der berechtigten Eltern bisher die monatlichen 10 Euro für gesellschaftliche Teilhabe ihrer Kinder in Anspruch genommen."
                            }
                        ],
