                                        "sense_id": "18eab8e4-7639-3dd5-ab20-817217710dfd",
                                        "entry_id": "5bbe7fbf-4ba6-3820-8e42-4e7c2b3cdc67",
                                        "glosses": [
                                            "Any member of the genus Toxoplasma of parasitic sporozoans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48fc3e36-1a48-45de-b2b8-0bb42d19f2e2",
                                                "sense_id": "18eab8e4-7639-3dd5-ab20-817217710dfd",
                                                "text": "To mingle with others of its kind and produce the next generation of eggs, toxoplasma must find its way to the gastrointestinal tract of a cat."
                                            },
                                            {
                                                "example_id": "9b456a23-88b1-47ba-b429-e48fd38746c4",
                                                "sense_id": "18eab8e4-7639-3dd5-ab20-817217710dfd",
                                                "text": "All in all, toxoplasmata seem to be unpleasant but otherwise unimportant little critters, if you don't happen to be pregnant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
