                ],
                "senses": [
                    {
                        "sense_id": "8a609d44-59ee-3e88-8d1f-937d4cadf53b",
                        "entry_id": "2cf7c071-cb91-3a33-ad0a-545679e8261f",
                        "glosses": [
                            "iemand die in het buitenland zorgt voor de politieke relaties met zijn eigen land"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "479d22dd-f3c9-4709-adfc-95d27b3f39fa",
                                "sense_id": "8a609d44-59ee-3e88-8d1f-937d4cadf53b",
                                "text": "'Bedienden van diplomaten in Nederland uitgebuit'"
                            },
                            {
                                "example_id": "397c6712-4f2c-42dd-8299-fd0881b512d0",
                                "sense_id": "8a609d44-59ee-3e88-8d1f-937d4cadf53b",
                                "text": "Maar feit is wel dat niet minder dan veertien EU-landen Russische diplomaten weggebonjourd hebben."
                            },
                            {
                                "example_id": "ad6fe2e4-18e5-47af-8903-ff27439cd05d",
                                "sense_id": "8a609d44-59ee-3e88-8d1f-937d4cadf53b",
                                "text": "Mijn vader Antoine was de zoon van een Franse diplomaat in Stockholm, maar toen mama en hij elkaar ontmoetten, had een aantal Franse diplomaten hun baan opgezegd bij het gezantschap aan de Narvavâgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb3fdb7a-3cbe-34ad-8812-bfecf6f503e8",
                        "entry_id": "2cf7c071-cb91-3a33-ad0a-545679e8261f",
                        "glosses": [
                            "iemand die tactvol en omzichtig te werk gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319ad846-7b8f-455d-9140-f0e73679971e",
                                "sense_id": "bb3fdb7a-3cbe-34ad-8812-bfecf6f503e8",
                                "text": "De moeder moest een echte diplomaat zijn om ruziënde kinderen te laten stoppen met vechten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e68f4b8a-954f-4e24-bca3-2b51b6153197",
                        "source_entry_id": "2cf7c071-cb91-3a33-ad0a-545679e8261f",
                        "source_sense_id": "8a609d44-59ee-3e88-8d1f-937d4cadf53b",
                        "source_sense_description": "iemand die in het buitenland zorgt voor de politieke relaties met zijn eigen land",
                        "target_lang_word": "Diplomat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diplomat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b844c8c6-be58-3955-82fc-911351a103cf",
                                        "entry_id": "0339625e-97f2-39bf-bd1d-c640e983a92a",
                                        "glosses": [
                                            "Person, die von der Regierung eines Staates dazu ermächtigt ist, diesen Staat im Ausland oder bei internationalen Organisationen zu vertreten und Verhandlungen zu führen; eine Person im diplomatischen Dienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54c69002-db76-4b81-b63f-8989847afaa3",
                                                "sense_id": "b844c8c6-be58-3955-82fc-911351a103cf",
                                                "text": "Diplomaten genießen besondere Rechte."
                                            },
                                            {
                                                "example_id": "cc6356f4-1054-412f-9a7e-9ab4ea4d5a41",
                                                "sense_id": "b844c8c6-be58-3955-82fc-911351a103cf",
                                                "text": "Ein Diplomat ist ein Missionschef oder Mitglied des diplomatischen Personals einer Mission, der die Interessen des eigenen Staates im Ausland oder bei einer internationalen Organisation vertritt."
                                            },
                                            {
                                                "example_id": "b5e875a1-69c3-4b05-ae4c-2c03719fe564",
                                                "sense_id": "b844c8c6-be58-3955-82fc-911351a103cf",
                                                "text": "Die diplomatische Kommunikation wird ebenfalls als unverletzlich betrachtet, und Diplomaten ist es seit langem erlaubt, Dokumente mit dem sog. „Diplomatenkoffer” oder der „Diplomatenpost” außer Landes zu bringen, ohne durchsucht zu werden."
                                            },
                                            {
                                                "example_id": "6d5db97d-a306-4a65-ab23-106a643969db",
                                                "sense_id": "b844c8c6-be58-3955-82fc-911351a103cf",
                                                "text": "Als der damalige Außenminister Joschka Fischer lobhudelnde Nachrufe auf NS-belastete Diplomaten im Mitarbeitermagazin untersagte, löste er fast einen Aufstand aus."
                                            },
                                            {
                                                "example_id": "330f6f67-78c4-428b-8335-f53159b16d21",
                                                "sense_id": "b844c8c6-be58-3955-82fc-911351a103cf",
                                                "text": "„Ein solcher hilfsbereiter Fremder war Tony, ein amerikanischer Diplomat in Namibia.“"
                                            },
                                            {
                                                "example_id": "346948b5-7236-4419-9148-3bbd9d12ab99",
                                                "sense_id": "b844c8c6-be58-3955-82fc-911351a103cf",
                                                "text": "„Nachdem Fürst Andrej sich gewaschen und umgekleidet hatte, ging er in das luxuriös eingerichtete Kabinett des Diplomaten und setzte sich an den gedeckten Tisch, während Bilibin es sich am Kamin bequem machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3620fb31-69ea-4c25-8e0f-2e8f5a15b816",
                        "source_entry_id": "2cf7c071-cb91-3a33-ad0a-545679e8261f",
                        "source_sense_id": "8a609d44-59ee-3e88-8d1f-937d4cadf53b",
                        "source_sense_description": "iemand die in het buitenland zorgt voor de politieke relaties met zijn eigen land",
                        "target_lang_word": "diplomat",
