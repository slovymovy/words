                "senses": [
                    {
                        "sense_id": "4efcddbc-8f24-3006-8e19-14bc402dbd3e",
                        "entry_id": "b68df9f3-e994-37f0-8c4f-ccdbf940cc2c",
                        "glosses": [
                            "Schuss mit einem Spielgerät (Ball, Puck) an die Torlatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61d0d14-9e6f-46f4-bc49-7b238d32d6b5",
                                "sense_id": "4efcddbc-8f24-3006-8e19-14bc402dbd3e",
                                "text": "Zu mehr als zwei Lattenschüssen hat es diesmal nicht gereicht."
                            },
                            {
                                "example_id": "5c51014f-4f4e-4470-81eb-7b4a3993611b",
                                "sense_id": "4efcddbc-8f24-3006-8e19-14bc402dbd3e",
                                "text": "„Kurz nach der Pause hatten die Hausherren dann bei einem Lattenschuss Sulimanis auch noch Glück, wieder trat dabei Venuto als Vorbereiter in Erscheinung (47.).“"
                            },
                            {
                                "example_id": "2261ef95-6fab-44e7-b0d2-0111909c9b74",
                                "sense_id": "4efcddbc-8f24-3006-8e19-14bc402dbd3e",
                                "text": "„Ob Absicht oder Unglück im Glück, Pirlos Lattenschuss war nur der spektakuläre Höhepunkt in der Leistung des Weltmeisters von 2006.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
