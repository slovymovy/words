                                ]
                            },
                            {
                                "target_word": "camisole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8226a9fc-4375-309d-aa7e-779760bf5e17",
                                        "entry_id": "4bf7abf1-5188-367b-8134-fd7e9aaec1c8",
                                        "glosses": [
                                            "To straitjacket."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01b6eb07-77bb-4e85-9fbf-674447e55baf",
                                                "sense_id": "8226a9fc-4375-309d-aa7e-779760bf5e17",
                                                "text": "If, in viewing the question from its sentimental aspect, you deplore the insult offered to manly dignity by camisoling a fellow-creature, let me ask if this manly dignity is not already compromised by the fact of patients covering themselves with ordure, denuding and mutilating themselves and striking those about them?"
                                            },
                                            {
                                                "example_id": "36d32b51-691b-43c7-8c59-155ca8da40ca",
                                                "sense_id": "8226a9fc-4375-309d-aa7e-779760bf5e17",
                                                "text": "He believes it better to camisole a patient than to seclude him."
                                            },
                                            {
                                                "example_id": "78497550-1875-4f1d-86f1-c8b07c15e86d",
                                                "sense_id": "8226a9fc-4375-309d-aa7e-779760bf5e17",
                                                "text": "She had been camisoled, and fastened in bed, with “ties of muslin cloth about fifteen inches wide,” and left alone for the night, during which, her struggles “had so increased the pressure of the ties as to produce considerable swelling” and increased discoloration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f85a0b08-1faa-4945-9597-90e3bab96aad",
                        "source_entry_id": "beab5ed1-5c7f-3fad-af35-018b74edebdd",
                        "source_sense_id": "593157da-9843-3e3d-90ad-d42c55a3802f",
                        "source_sense_description": "mannenvest met lange mouwen en diepe zakken",
                        "target_lang_word": "camisole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camisole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb003d2-42f0-3936-800b-cafd53a580ff",
                                        "entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                                        "glosses": [
                                            "Sorte de vêtement du matin, court, à manches, qui se porte sur la chemise."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9262d631-aea4-47d0-bc45-c24740607621",
                                                "sense_id": "8cb003d2-42f0-3936-800b-cafd53a580ff",
                                                "text": "Des visages encore bouffis de sommeil apparurent aux fenêtres ; des groupes d’hommes, en bras de chemise, de femmes en camisole et en bonnet de nuit, se formèrent, animés, sur le bas des portes."
                                            },
                                            {
                                                "example_id": "7c2812dd-d914-40d0-ad2d-2649744d3ca3",
                                                "sense_id": "8cb003d2-42f0-3936-800b-cafd53a580ff",
                                                "text": "Et, soudain, Madeleine devint très rouge. Dans son affolement elle s’était à peine vêtue. Sa camisole déboutonnée laissait toute sa gorge à découvert et sa chemise bâillait sur sa poitrine puissante et blanche…"
                                            },
                                            {
                                                "example_id": "f30c2eb0-e58f-4317-bd29-e409b43a5b2c",
                                                "sense_id": "8cb003d2-42f0-3936-800b-cafd53a580ff",
                                                "text": "— Tranquillisez-vous, ma bonne sœur Telcide, reprend Jeanne ; comme notre sœur Marie nous l’a conseillé, nous mettrons nos petites camisoles de laine sous nos grandes pèlerines…"
                                            },
                                            {
                                                "example_id": "63db913d-bbd7-4d38-afa6-d3d3de889f4d",
                                                "sense_id": "8cb003d2-42f0-3936-800b-cafd53a580ff",
                                                "text": "Ma mère, qui avait la migraine, était étendue sur le sofa, vêtue d’une jupe et d’une camisole (elle n’avait jamais su ce qu’était un déshabillé, un peignoir, une robe de chambre)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aace4dd3-163c-3e8d-b611-4c345a943171",
                                        "entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                                        "glosses": [
                                            "Camisole de force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d768f4-c59b-4944-b1ce-d8859fcf6195",
                                                "sense_id": "aace4dd3-163c-3e8d-b611-4c345a943171",
                                                "text": "Il pousse des cris terribles, il veut se tuer ; sa fille fut alors forcée de le faire attacher sur son lit, et de lui mettre la camisole des fous."
                                            },
                                            {
                                                "example_id": "6242812e-bf31-4293-b46c-61f93d25fdb6",
                                                "sense_id": "aace4dd3-163c-3e8d-b611-4c345a943171",
                                                "text": "Quand un fou paraît tout à fait raisonnable, il est grandement temps, croyez-moi, de lui mettre la camisole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db4d5ebd-a3c4-322a-b2ae-3fc6e9adfb7e",
                                        "entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                                        "glosses": [
                                            "Vêtement sans manches ni col."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d83f052c-a3bf-436e-b56e-2ff05b3079a3",
                                                "sense_id": "db4d5ebd-a3c4-322a-b2ae-3fc6e9adfb7e",
                                                "text": "J'ai changé au moins huit fois de camisole et de chandail pour retenir finalement le chandail noir que j'ai acheté avec Sabine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "513ea89c-358b-3d5b-8932-6d6505539443",
                                        "entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                                        "glosses": [
                                            "Vêtement féminin à manches courtes couvrant le haut du corps."
                                        ],
                                        "tags": [
                                            "Afrique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
