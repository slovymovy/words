                                            {
                                                "example_id": "8064d700-88c3-4bf8-98fb-4f0cfae4f45a",
                                                "sense_id": "bc975585-f8c3-3977-be58-c3fb2c29118f",
                                                "text": "He showed Nicol into the kitchen and stowed the letter in the hallstand drawer alongside the other unopened envelopes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96487164-b2e0-4ff0-971e-51670895b304",
                        "source_entry_id": "9ee29424-e252-36eb-8831-baaea109b2c8",
                        "source_sense_id": "8f98b467-1e8c-32df-962b-270bd4f49887",
                        "source_sense_description": "freistehendes Möbelstück, an dem man Kleidungsstücke aufhängen kann",
                        "target_lang_word": "coat rack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coat rack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48d42959-2d92-369f-a9f5-1b984ec168b8",
                                        "entry_id": "8b213dc6-2ba7-35ef-8f73-ff0577ceea66",
                                        "glosses": [
                                            "A rack or stand with hooks or pegs for holding hats and coats, often placed near an entrance for temporary use"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b1e70a-ad12-4665-8d8e-caf2b5e5eb33",
                                                "sense_id": "48d42959-2d92-369f-a9f5-1b984ec168b8",
                                                "text": "She put her coat and her hat on the coat rack when she entered her friend's apartment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6648f078-ba7b-43c2-86b6-eb4499ec56dc",
                        "source_entry_id": "9ee29424-e252-36eb-8831-baaea109b2c8",
                        "source_sense_id": "8f98b467-1e8c-32df-962b-270bd4f49887",
                        "source_sense_description": "freistehendes Möbelstück, an dem man Kleidungsstücke aufhängen kann",
                        "target_lang_word": "portemanteau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portemanteau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc84efd6-5996-31e8-8304-7af4d032b26b",
                                        "entry_id": "e1003d49-1f48-3fb7-8ff3-84a2f8df770d",
                                        "glosses": [
                                            "Structure sur pied ou accrochée au mur garnie de patères auxquelles on suspend des manteaux et d’autres vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7f8b18-c1a8-4e48-b718-11988ce0fd41",
                                                "sense_id": "fc84efd6-5996-31e8-8304-7af4d032b26b",
                                                "text": "Et une main montra le lit sans draps, les portemanteaux nus de vêtements, la table déserte : la soigneuse dévastation des chambres inoccupées."
                                            },
                                            {
                                                "example_id": "b99be6fc-7ae1-41a2-8009-70bac45c4a40",
                                                "sense_id": "fc84efd6-5996-31e8-8304-7af4d032b26b",
                                                "text": "Bin, je ne l’ai pas vu… mais quand tu sais que je vais repeindre le portemanteau, pourquoi laisse-tu ton veston??"
                                            },
                                            {
                                                "example_id": "11491be5-4ae4-48fa-aeed-3bcf60c0589f",
                                                "sense_id": "fc84efd6-5996-31e8-8304-7af4d032b26b",
                                                "text": "La porte s'ouvrit sur un corridor qui sentait le linoléum, avec un portemanteau en bambou à droite, des plantes vertes, dans des cache-pot de faïence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f03c10-bec1-3b4e-85f0-f70ccd8a4599",
                                        "entry_id": "e1003d49-1f48-3fb7-8ff3-84a2f8df770d",
                                        "glosses": [
                                            "Étui cylindrique en drap que les cavaliers attachent à la selle et qui peut contenir un manteau et des effets de petit équipement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a84d94d-f6ef-44a3-8d57-4d6c5fc179eb",
                                                "sense_id": "c6f03c10-bec1-3b4e-85f0-f70ccd8a4599",
                                                "text": "Ils arrivaient l’hiver, à cheval, pistolets aux arçons, couteau de chasse au côté, et suivis d’un valet également à cheval, ayant en croupe un portemanteau de livrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c56f77-d314-3282-a33a-e4208346fef1",
                                        "entry_id": "e1003d49-1f48-3fb7-8ff3-84a2f8df770d",
                                        "glosses": [
                                            "Sorte de valise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45bc16ed-6af4-4f20-b27e-24784532d243",
                                                "sense_id": "81c56f77-d314-3282-a33a-e4208346fef1",
                                                "text": "M. de Tréville, prévenu par Son Éminence, fit son portemanteau, et, comme, sans en connaître la cause, il savait le vif désir et même l’impérieux besoin que ses amis avaient de revenir à Paris, il les désigna pour faire partie de l’escorte."
                                            },
                                            {
                                                "example_id": "437ecf7f-3bf7-45aa-aa7f-269c60b2cec4",
                                                "sense_id": "81c56f77-d314-3282-a33a-e4208346fef1",
                                                "text": "Bibi ne portait pas seulement l’homme et l’enfant, il avait encore à l’arrière-train, presque sur la queue, un portemanteau étroit, assez élevé, une sorte de petite caisse en cuir où ballottaient pêle-mêle les outils de maître Jean et ses nippes de rechange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2a36f43-0f63-3cec-9fcd-681f98a65b7e",
                                        "entry_id": "e1003d49-1f48-3fb7-8ff3-84a2f8df770d",
                                        "glosses": [
                                            "Personne chargée de porter le manteau du roi ou de la reine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb170ecb-442a-335f-ac86-2dd01f97829b",
                                        "entry_id": "e1003d49-1f48-3fb7-8ff3-84a2f8df770d",
                                        "glosses": [
                                            "Sac contenant les vêtements d'une personne qui voyage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cab51e36-087b-4242-8e5c-e4255cb144bf",
                                                "sense_id": "eb170ecb-442a-335f-ac86-2dd01f97829b",
                                                "text": "Sitôt le paquebot amarré à quai, Michel vit descendre du pont des premières et s’engager sur la passerelle un homme âgé, de haute taille, un peu corpulent, tenant d’une main un portemanteau et de l’autre un plaid soigneusement roulé et serré d’une courroie, et qu’un parapluie dépassait des deux bouts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
