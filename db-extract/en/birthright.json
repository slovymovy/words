    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d6a68246-a8f2-3462-905a-c80c83180180",
                "word": "birthright",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d6945ff8-daf0-4fc2-9ce3-42262431be0a",
                        "entry_id": "d6a68246-a8f2-3462-905a-c80c83180180",
                        "tags": [
                            "plural"
                        ],
                        "form": "birthrights"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1780ce45-1560-3d4a-bedb-cc1461f99269",
                        "entry_id": "d6a68246-a8f2-3462-905a-c80c83180180",
                        "glosses": [
                            "Something a person is entitled to due to the circumstances of their birth, such as an inheritance or citizenship."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0632b52-1949-4379-ad2c-b065ca334a32",
                                "sense_id": "1780ce45-1560-3d4a-bedb-cc1461f99269",
                                "text": "Not only has suburban life separated the great concentrated masses of our people from their birthright of meadows, fields and woods; of Nature, in her untamed splendour and mystery, most of them have never had so much as a momentary glimpse."
                            },
                            {
                                "example_id": "ec73d87f-507e-4229-bfca-e4d12401e0ab",
                                "sense_id": "1780ce45-1560-3d4a-bedb-cc1461f99269",
                                "text": "Though it's the birthright of man to unify and live his life as one / A whisper of the word will let you soar with your soul"
                            },
                            {
                                "example_id": "2573ea04-4c7c-40e1-998c-45cbe5b90235",
                                "sense_id": "1780ce45-1560-3d4a-bedb-cc1461f99269",
                                "text": "But a practically solo sequence of Dany walking through her old empty house without saying anything for minutes on end is, let’s say, a lot to ask of Emilia Clarke. She’s back at Dragonstone to reclaim her birthright, the seven or so kingdoms."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7432c13a-c6ef-4955-bafa-adb27e35a872",
                        "source_entry_id": "d6a68246-a8f2-3462-905a-c80c83180180",
                        "source_sense_id": "1780ce45-1560-3d4a-bedb-cc1461f99269",
                        "source_sense_description": "something that is owed since birth, due to inheritance",
                        "target_lang_word": "Geburtsrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geburtsrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "554aec9d-bea8-3c30-aa71-820011df01da",
                                        "entry_id": "0aaa0bb7-2ed8-3658-a7b7-8db2c8a1e6ea",
                                        "glosses": [
                                            "Recht, das einem aufgrund von Geburtsumständen (meist Abstammung/Herkunft oder Geburtsort) zusteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "336a48f6-13ab-47da-a6cc-f966e0a5183c",
                                                "sense_id": "554aec9d-bea8-3c30-aa71-820011df01da",
                                                "text": "„Sie bestehen auf ihrem Geburtsrecht.“"
                                            },
                                            {
                                                "example_id": "cf892bdb-8a1d-4b0f-b857-f2e5e6aaa625",
                                                "sense_id": "554aec9d-bea8-3c30-aa71-820011df01da",
                                                "text": "„Man schmiert drei Chutiyas in der Stadtverwaltung, spickt sie ordentlich, und dann bringt man den örtlichen Dada um, der meint, ihm stünde ein Anteil zu, als wäre es sein verdammtes Geburtsrecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
