                "senses": [
                    {
                        "sense_id": "9e44dc2b-ee3f-3367-906e-d0e49d2a1e2f",
                        "entry_id": "a53b92e6-6743-31ad-8185-c257c3abaa0c",
                        "glosses": [
                            "die Eigenschaft (der Welt), geozentrisch zu sein"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "29450392-267e-4ffc-b779-cd39a53ab0c7",
                                "sense_id": "9e44dc2b-ee3f-3367-906e-d0e49d2a1e2f",
                                "text": "Ähnlich wie unser Weltbild durch Copernicus von dem Vorurteil der Geozentrizität befreit werden musste"
                            },
                            {
                                "example_id": "1e98565f-e8e2-48db-b4a4-c96813753e72",
                                "sense_id": "9e44dc2b-ee3f-3367-906e-d0e49d2a1e2f",
                                "text": "Zu den in dieser Zeit ebenfalls revidierten Momenten des ptolemäischen Weltbildes gehörte die Auffassung von der Geozentrizität des Kosmos."
                            },
                            {
                                "example_id": "bc3d5efd-6c22-482a-a2a3-8e20452f1da1",
                                "sense_id": "9e44dc2b-ee3f-3367-906e-d0e49d2a1e2f",
                                "text": "„Die Geozentrizität aufgeben zu müssen, galt Copernicus demgegenüber als das kleinere Übel, das sich zudem nachträglich für ihn durch die größere Ökonomie und Harmonie als richtig bestätigte.“"
                            },
                            {
                                "example_id": "4e13e521-8d1e-43d2-bdef-f67cfce01077",
                                "sense_id": "9e44dc2b-ee3f-3367-906e-d0e49d2a1e2f",
                                "text": "„Für das Festhalten an der Geozentrizität in der Antike ist aber auch eine grundsätzliche Einstellung nicht zu übersehen: Das antropozentrische Weltbild der Griechen. Dieses manifestiert sich besonders in dem (bis heute) vielfach falsch verstandenen und meistens verkürzt wiedergegeben berühmten Satz des Protagoras vom »Menschen als dem Maß aller Dinge«…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
