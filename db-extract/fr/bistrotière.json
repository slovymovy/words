                        "glosses": [
                            "Féminin singulier de bistrotier."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3a8dad4e-eae9-4825-8b63-8866a22b65aa",
                                "sense_id": "bad7db1f-214e-302b-9fa4-124f9a44e9a6",
                                "text": "Un plat traditionnel de la cuisine bistrostière."
                            },
                            {
                                "example_id": "57ae96da-6f58-43e1-80bf-44830b36ebe1",
                                "sense_id": "bad7db1f-214e-302b-9fa4-124f9a44e9a6",
                                "text": "Toujours quelques bons amis pour communier avec lui au même zinc… des vieux, des jeunes, n’importe qui, surtout des demi-cloches, bohêmes, étudiants qui n’étudient que la géographie bistrotière de la capitale, peintres ratés, comploteurs en déroute, chomedus chroniques, professeurs qui n’enseignent rien, acteurs en quête de contrat, turfistes déçus, jusqu’à des mendigots en loques !"
                            }
                        ]
                    }
