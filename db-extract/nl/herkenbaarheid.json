        "nl-extract.jsonl": [
            {
                "entry_id": "fc99b22d-4f3e-30a0-bae8-4f82992c4da5",
                "word": "herkenbaarheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ca078887-4a1a-44e4-a212-6cdc17af6d85",
                        "entry_id": "fc99b22d-4f3e-30a0-bae8-4f82992c4da5",
                        "tags": [
                            "plural"
                        ],
                        "form": "herkenbaarheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9cc3300-ba0d-3e94-9252-8ff21b2ddd61",
                        "entry_id": "fc99b22d-4f3e-30a0-bae8-4f82992c4da5",
                        "glosses": [
                            "bij iets of iemand anders dingen zien die je ook kent van jezelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be481d1f-1631-4163-b03b-d6ad3b43e31c",
                                "sense_id": "d9cc3300-ba0d-3e94-9252-8ff21b2ddd61",
                                "text": "In Nederland kampt één op de drie a vier jongeren tussen de twaalf en achttien, negentien jaar met depressieve klachten. Dan praat je over honderdduizenden. Dan doet de herkenbaarheid al heel veel. Ook in de groepsprocessen die ongelooflijk helpend waren. Dit programma laat zien dat ze niet de enigen zijn.”"
                            },
                            {
                                "example_id": "77e149a7-7edb-47b6-a6b4-350ebea3699f",
                                "sense_id": "d9cc3300-ba0d-3e94-9252-8ff21b2ddd61",
                                "text": "De musical vertelt over vijf twintigers die op de middelbare school dikke vrienden waren. Na hun examens zijn ze elkaar uit het oog verloren. Jaren later komen de vrienden weer samen, alleen is één van hen er niet meer. Volgens producent Sturkenboom gaat de voorstelling over \"vriendschap, verwachtingen en het zoeken naar je identiteit. Zowel de verhaallijn als de Nederlandse popmuziek zorgen voor flinke dosis herkenbaarheid\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "768ce70e-922e-3a9a-8556-da1a4ffb28e2",
                        "entry_id": "fc99b22d-4f3e-30a0-bae8-4f82992c4da5",
                        "glosses": [
                            "het hebben van een duidelijke identiteit, zodat iedereen direct weet over wie of wat het gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd5921a8-77b0-4d4b-a5f6-9f2699bbc4a7",
                                "sense_id": "768ce70e-922e-3a9a-8556-da1a4ffb28e2",
                                "text": "Met de plaatsing van het beeld hoopt de leiding van ArtEZ de herkenbaarheid van de muziekopleiding in Enschede te versterken."
                            },
                            {
                                "example_id": "6aebaece-7158-464f-bd6f-6097e3e4a4e5",
                                "sense_id": "768ce70e-922e-3a9a-8556-da1a4ffb28e2",
                                "text": "In de Joodse traditie heerst soberheid op begraafplaatsen. Wel is het metaheerhuis waarin overledenen ritueel worden gewassen, opnieuw in de verf gezet en wordt onderhoud op en tussen bestaande graven verricht. De Lions zijn voornemens, voor een betere herkenbaarheid, de oude belettering van grafzerken te herstellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e595f50c-f91c-409f-893d-fd3f6e0e4bfc",
                        "source_entry_id": "fc99b22d-4f3e-30a0-bae8-4f82992c4da5",
                        "source_sense_id": "d9cc3300-ba0d-3e94-9252-8ff21b2ddd61",
                        "source_sense_description": "het hebben van een duidelijke identiteit",
                        "target_lang_word": "familiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "The state of being extremely friendly; intimacy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f0d17c-ef13-4be7-a394-20a1f33e2916",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "It is also folly and injustice to deprive children[…]of their fathers familiaritie, and ever to shew them a surly, austere, grim, and disdainefull countenance, hoping thereby to keepe them in awfull feare and duteous obedience."
                                            },
                                            {
                                                "example_id": "33017085-5850-4476-b7b9-d10d253785c4",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "Do not keep familiarity with any but those, with whom you may improve your time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Undue intimacy; inappropriate informality, impertinence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c51bd8-d78f-4038-8cbb-c77a80483460",
                                                "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                                "text": "Murrel did not in the least object to being called a monkey, yet he always felt a slight distaste when Julian Archer called him one.[…]It had to do with a fine shade between familiarity and intimacy which men like Murrel are never ready to disregard, however ready they may be to black their faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1831a8ab-fa15-3e6b-ad73-7cec0ddae30c",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "An instance of familiar behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Close or habitual acquaintance with someone or something; understanding or recognition acquired from experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff5d50aa-18f9-4532-b768-46d8774eff90",
                                                "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                                "text": "The objects around have been seen so often, that they have at last become, as it were, unseen; their familiarity does not carry us out of ourselves, for all their associations are our own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
