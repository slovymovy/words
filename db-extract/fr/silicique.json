                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10903a51-5bbe-4fdb-9a54-41c5199e44dc",
                                "sense_id": "f71df4cf-1288-337a-9649-6386bcd57744",
                                "text": "La liqueur hydrochlorique séparée de l'acide silicique par la filtration, est traitée comme il a été dit p. 357, quand j'ai parlé de la marche à suivre dans l'analyse des substances silicifères qui sont décomposées par les acides."
                            },
                            {
                                "example_id": "f595208c-e7e7-44db-9add-948385347cc5",
                                "sense_id": "f71df4cf-1288-337a-9649-6386bcd57744",
                                "text": "Le dérivé du silicium le plus important est la silice ou anhydride silicique, auquel correspondent l’acide silicique et les silicates."
                            }
                        ]
                    }
