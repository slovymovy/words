                                        "entry_id": "0db82092-1153-3273-b232-93e385197162",
                                        "glosses": [
                                            "A non-Jewish girl, especially one who is attractive and young."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3e1a214-8d61-4a7c-a3a1-d38430f2fa8c",
                                                "sense_id": "a94f1834-a24d-3b5a-9b6f-24ac8d2ea860",
                                                "text": "A Shickse, that wasn't bad enough? What's worse, you ask? A black man? Well this daughter of mine had to find herself a black woman in order to spite me. That I should never rest easy in my grave."
                                            }
                                        ]
                                    },
