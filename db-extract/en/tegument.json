                                "target_senses": [
                                    {
                                        "sense_id": "83f4afeb-bbe9-30ee-a16e-2a8a3cbae69b",
                                        "entry_id": "1f68c00e-aa37-3009-9513-0de6413e0df6",
                                        "glosses": [
                                            "das Bedecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8a0b35-a167-4a90-a947-f7f2ca86c490",
                                                "sense_id": "83f4afeb-bbe9-30ee-a16e-2a8a3cbae69b",
                                                "text": "Die Bedeckung der Unterkünfte schreitet gut voran."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63a1c41f-e808-3e6e-919a-12e5a8f05faa",
                                        "entry_id": "1f68c00e-aa37-3009-9513-0de6413e0df6",
                                        "glosses": [
                                            "bewaffnete Schutzeinheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e23eb03-325a-450c-b6b4-984bda93d2be",
                                                "sense_id": "63a1c41f-e808-3e6e-919a-12e5a8f05faa",
                                                "text": "Gebt ihm Bedeckung mit!"
                                            },
                                            {
                                                "example_id": "634ecb68-2a72-44e3-9246-3dcb212c3231",
                                                "sense_id": "63a1c41f-e808-3e6e-919a-12e5a8f05faa",
                                                "text": "„Die Bedeckung, die bei Tuchins Kanonen gestanden hatte, war auf irgendeinen von irgend jemand gegebenen Befehl hin zur Verwendung im Brennpunkt des Gefechts abmarschiert; aber die Batterie feuerte trotzdem weiter und wurde nur deshalb nicht von den Franzosen genommen, weil der Feind es sich nicht vorstellen konnte, dass vier gänzlich ungeschützte Kanonen die Dreistigkeit haben sollten, ihn in dieser Weise zu beschiessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8bce57f7-282b-3a70-9ae1-1521cf207059",
                                        "entry_id": "1f68c00e-aa37-3009-9513-0de6413e0df6",
                                        "glosses": [
                                            "Gegenstand zum Bedecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a54ce046-8f13-429e-81d7-a8d57888e669",
                                                "sense_id": "8bce57f7-282b-3a70-9ae1-1521cf207059",
                                                "text": "Sie trug eine seltsame Bedeckung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7b47ff1d-08b9-3034-bc51-517efd6cd130",
                                        "entry_id": "1f68c00e-aa37-3009-9513-0de6413e0df6",
                                        "glosses": [
                                            "finanzielle Abdeckung"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c6a81a3-f347-4eb7-8113-008109ec123b",
                                                "sense_id": "7b47ff1d-08b9-3034-bc51-517efd6cd130",
                                                "text": "„Bei zur Bedeckung dienenden Investmentfonds ist die Einhaltung des gesetzlich zulässigen Gesamtrisikos aus dem jeweiligen Anteil an derivativen Finanzinstrumenten durch einen unternehmensinternen Kontrollprozess sicherzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8213d481-28b4-300d-a44a-48214fd35ab1",
                                        "entry_id": "1f68c00e-aa37-3009-9513-0de6413e0df6",
                                        "glosses": [
                                            "das Decken der Muttertiere"
                                        ],
                                        "tags": [
                                            "Tierzucht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6cc99dc-678b-4d0f-9526-bdcb4afc4bcf",
                                                "sense_id": "8213d481-28b4-300d-a44a-48214fd35ab1",
                                                "text": "Die Bedeckung letztes Jahr hat unsre Bestände verdoppelt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
