                "senses": [
                    {
                        "sense_id": "52a23dba-b4c9-3221-847e-f84d028935eb",
                        "entry_id": "f9513043-46b3-30e2-8d11-36f0a04d85f5",
                        "glosses": [
                            "сделать витым, вьющимся или кудрявым; закрутить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f382d1a-e51d-466b-979d-c97221d87c23",
                                "sense_id": "52a23dba-b4c9-3221-847e-f84d028935eb",
                                "text": "Вас нужно обрить, остричь, завить и причесать по самой последней моде, не правда ли?"
                            },
                            {
                                "example_id": "7984c25d-ff27-452a-80ec-22eb92a9b02a",
                                "sense_id": "52a23dba-b4c9-3221-847e-f84d028935eb",
                                "text": "Гайдук завил рукою верхние усы и пропустил сквозь зубы звук, несколько похожий на лошадиное ржание."
                            }
                        ]
                    },
                    {
                        "sense_id": "50a1b18d-2e89-3344-9009-451027ecded3",
                        "entry_id": "f9513043-46b3-30e2-8d11-36f0a04d85f5",
                        "glosses": [
                            "нар.-поэт. заплести, свить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8eb5ee3-8288-4977-af64-a991e44edfb3",
                                "sense_id": "50a1b18d-2e89-3344-9009-451027ecded3",
                                "text": "Завьёт венок, наденет его на голову и пляшет, как русалка…"
                            }
                        ]
                    }
