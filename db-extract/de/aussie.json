                    {
                        "sense_id": "f61f85e1-6a1e-33d8-9ade-3c1a9000468c",
                        "entry_id": "e3756575-1a25-3f0f-b7b0-4a0cb0d6c873",
                        "glosses": [
                            "Einwohner Australiens"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "923e0639-1df6-446f-ab82-7420515aef12",
                                "sense_id": "f61f85e1-6a1e-33d8-9ade-3c1a9000468c",
                                "text": "„Die freundlichen Aussies locken mit Fitnessbereich, Sauna, Pool und angeschlossenem Burger-Restaurant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c3e9c8a-fc3c-469b-9f71-b6247acbcdcc",
                        "source_entry_id": "e3756575-1a25-3f0f-b7b0-4a0cb0d6c873",
                        "source_sense_id": "f61f85e1-6a1e-33d8-9ade-3c1a9000468c",
                        "source_sense_description": "Jargon: Einwohner Australiens",
                        "target_lang_word": "Aussie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aussie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9dbe600-dc0d-35fe-8333-118b1f99ae39",
                                        "entry_id": "dde58267-190d-3052-8cde-df023aa54d70",
                                        "glosses": [
                                            "An Australian."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "558f4d01-0a7c-4c51-8e86-0c20efe76c07",
                                                "sense_id": "f9dbe600-dc0d-35fe-8333-118b1f99ae39",
                                                "text": "A blokart (say blow-cart) plays to the penchant that Kiwis and Aussies have for pushing the limits in search of fun. It’s a ground-hugging, tricyclelike combination of aluminum tubing and rubber wheels with a steering wheel and a sail."
                                            },
                                            {
                                                "example_id": "13b2bc72-bdf4-4702-b784-f81e667291da",
                                                "sense_id": "f9dbe600-dc0d-35fe-8333-118b1f99ae39",
                                                "text": "What we hope to achieve with our AAMI Decade of Driving Report, is to bring awareness to where, when and how accidents occur, so that Aussie drivers can be better informed and educated on how to drive more safely. - AAMI Motor Claims Manager Leah James"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84494955-c85c-36b1-8c49-7e2591d8c255",
                                        "entry_id": "dde58267-190d-3052-8cde-df023aa54d70",
                                        "glosses": [
                                            "An Australian Shepherd dog."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7356310c-b6ef-36e0-906e-7e3c6ece603f",
                                        "entry_id": "dde58267-190d-3052-8cde-df023aa54d70",
                                        "glosses": [
                                            "Australian dollar (see also; Aussie dollar)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Aussie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "254f224a-43bc-34f0-a92a-a6ee7f1cf7aa",
                                        "entry_id": "6794e0e0-5989-3b91-b7ea-61d06e3c89df",
                                        "glosses": [
                                            "Australia (now uncommon except in sporting chants and in New Zealand)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Aussie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                        "entry_id": "2aafb297-b348-3c83-82b6-880d69279b03",
                                        "glosses": [
                                            "Australian."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand",
                                            "South-Africa",
                                            "colloquial",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bddf1ae-3088-4a41-9a9c-50eeced999c4",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "From the Marvel Mixmaster to the Miracle Microwave, every time a new-fangled gadget has lobbed into the Aussie kitchen, Aussie mums have changed their cooking styles accordingly."
                                            },
                                            {
                                                "example_id": "05e19617-f47d-44b2-83fb-5f0552aae23e",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "Most Aussie officers seemed this way to me; always cool, deliberate, and extremely rational in their decision making, a far cry from the American leadership I had seen during my first year in the army."
                                            },
                                            {
                                                "example_id": "c57d4696-2acd-419e-a851-311a37288e1d",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "Here's something I learned the hard way: The very best time of year to start off with accounting software is the beginning of the financial year (1 July for most Aussie businesses, and 1 April for most Kiwi businesses)."
                                            },
                                            {
                                                "example_id": "4837f0ac-d592-4050-b8a0-dd1fd51a8eff",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "For example, if you buy US dollars (USD) using Australian dollars (AUD) and the Aussie dollar falls, you can then sell your US dollars and you will have made money as you will have more Aussie dollars than you started with."
                                            },
                                            {
                                                "example_id": "709a314b-6d52-465c-b934-8d0d7df7b7f9",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "They′re the ‘Almost Aussies’ who embrace their new culture with a vengeance – some becoming more Aussie than Aussies."
                                            },
                                            {
                                                "example_id": "fbe60ef1-faf3-49fc-89ed-f09648efe008",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "You couldn't get more Aussie than the cast he chose—or their cars. The goodies drive Holdens and the baddies cruise around in a big, grunting, chocolate-brown Monaro."
                                            },
                                            {
                                                "example_id": "5f461aa5-d362-47fa-8ccc-76c456a80bcb",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "‘I'm a perfectionist, mate,’ he said, his accent becoming noticeably more Aussie, as it always did in private."
                                            },
                                            {
                                                "example_id": "d60ad96b-6fb1-4297-8752-567b9e6b3462",
                                                "sense_id": "e36b24ef-e518-39cf-9d23-2be442309169",
                                                "text": "'Every fucking aussie. Go to Cronulla Beach Sunday for some Leb and wog bashing Aussie Pride ok.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
