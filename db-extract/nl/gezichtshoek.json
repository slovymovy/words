                    },
                    {
                        "translation_id": "bae47dfe-2a45-4a87-85c8-ca2313554102",
                        "source_entry_id": "d8c0e1c6-d601-3d4f-9589-e9a9c83f0f66",
                        "source_sense_id": "86b363c4-b71f-3101-802e-5ff0e043b84a",
                        "source_sense_description": "de positie vanwaaruit men een bepaalde kwestie bekijkt en beoordeelt",
                        "target_lang_word": "point of view",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point of view",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df837320-3d60-3c1e-9d60-67977cdfe98d",
                                        "entry_id": "145c6f4f-0700-3a4d-8416-ed63c7783560",
                                        "glosses": [
                                            "A position from which something is perceived; outlook; standpoint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b213d9c4-c8ce-4dfa-8d1d-a637234b5d0a",
                                                "sense_id": "df837320-3d60-3c1e-9d60-67977cdfe98d",
                                                "text": "From the operator's point of view, there is a large blind spot on one side of the machine."
                                            },
                                            {
                                                "example_id": "cdfcc486-7fbe-4919-b6f9-a89432fc5ae7",
                                                "sense_id": "df837320-3d60-3c1e-9d60-67977cdfe98d",
                                                "text": "From an economist's point of view, business is all about money."
                                            },
                                            {
                                                "example_id": "48700b09-6cfd-4ee8-8f97-e891f2179dc1",
                                                "sense_id": "df837320-3d60-3c1e-9d60-67977cdfe98d",
                                                "text": "From another point of view, it was a place without a soul. The well-to-do had hearts of stone; the rich were brutally bumptious; the Press, the Municipality, all the public men, were ridiculously, vaingloriously self-satisfied."
                                            },
                                            {
                                                "example_id": "980919a0-6568-40d8-a173-5af1ddfe5115",
                                                "sense_id": "df837320-3d60-3c1e-9d60-67977cdfe98d",
                                                "text": "It has been suggested that Prothean data recording is highly dependent on a certain point of view, what Carl Jung described as the collective unconscious. The 'cipher' needed to comprehend the images implanted in Shepard's mind is the cultural knowledge of a Prothean: the archetypes, biological instincts, and common experiences universal to the race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d38cf3af-1078-37ab-ab11-8cf802d2937c",
                                        "entry_id": "145c6f4f-0700-3a4d-8416-ed63c7783560",
                                        "glosses": [
                                            "An attitude, opinion, or set of beliefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c19e18e-6fca-48b2-8e88-a066e3678e31",
                                                "sense_id": "d38cf3af-1078-37ab-ab11-8cf802d2937c",
                                                "text": "His point of view is that there is only one true religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36b4d812-7d98-3abe-a01e-b047ebb41ee2",
                                        "entry_id": "145c6f4f-0700-3a4d-8416-ed63c7783560",
                                        "glosses": [
                                            "The perspective from which a narrative is related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b3fb36-b8ec-44a1-933f-fb54ee77c03a",
                                                "sense_id": "36b4d812-7d98-3abe-a01e-b047ebb41ee2",
                                                "text": "The storyline in the film “The Usual Suspects” is presented from the point of view of an unreliable narrator."
                                            },
                                            {
                                                "example_id": "75f5827b-7653-41e4-888a-1ce54d770805",
                                                "sense_id": "36b4d812-7d98-3abe-a01e-b047ebb41ee2",
                                                "text": "Therefore, there may be no overt indication of viewpoint, either because the speaker fails to mark his or her viewpoint, or because he or she takes a neutral point of view."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
