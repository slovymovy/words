                "senses": [
                    {
                        "sense_id": "745cc102-fa57-3484-ab3d-42544fb357ce",
                        "entry_id": "311db463-3484-3e1e-95b2-52e5bec01783",
                        "glosses": [
                            "mittelgroßer Greifvogel aus der Familie der Habichtartigen, der sich meist von Kleinsäugern ernährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5c0f24b-6e07-4690-b1ac-2fc93ce482cb",
                                "sense_id": "745cc102-fa57-3484-ab3d-42544fb357ce",
                                "text": "„Gegenwärtig gilt der Mäusebussard in ganz Europa als nicht gefährdet.“"
                            },
                            {
                                "example_id": "1a41d77b-efe9-4981-8085-76bf96353c8b",
                                "sense_id": "745cc102-fa57-3484-ab3d-42544fb357ce",
                                "text": "„Im Peterhofer Kreise ist der Mäusebussard als Brutvogel keine häufige Erscheinung, was wohl wahrscheinlich darin seinen Grund hat, dass wenig passende Waldungen vorhanden sind.“"
                            },
                            {
                                "example_id": "7daef0fe-7495-4e99-b1e5-10e0807dc2d8",
                                "sense_id": "745cc102-fa57-3484-ab3d-42544fb357ce",
                                "text": "„Auch das Schweben des Mäusebussards über den Kiefernwipfeln von Brandenburg zusammen mit seinem wilden Schrei ist eindrucksvoll.“"
                            },
                            {
                                "example_id": "85a8487f-2abd-448f-81db-bc58edbf5be5",
                                "sense_id": "745cc102-fa57-3484-ab3d-42544fb357ce",
                                "text": "„Im Winter trifft man in den Niederlanden zahlreiche Mäusebussarde an, da viele Vögel aus dem hohen Norden hier überwintern.“"
                            },
                            {
                                "example_id": "00439781-163c-4524-a6a8-05566e23e9af",
                                "sense_id": "745cc102-fa57-3484-ab3d-42544fb357ce",
                                "text": "„Von Raubvögeln kömmt der Steinadler vereinzelt vor, in den höchsten Theilen des Gebirges soll er nisten; einige Mäusebussarde und Wanderfalken wurden von uns beobachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6947ed1-2f63-441d-bf0f-0ca2d3f1aaac",
