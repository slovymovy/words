                                    {
                                        "sense_id": "d4d8d7f7-f474-38e3-a5ec-cd57275c29de",
                                        "entry_id": "645bd3b3-6a2b-395a-8fca-4b1ad128da9a",
                                        "glosses": [
                                            "ein quaderförmiges Stück gefrorenes Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76cc583-560f-46c2-b188-6e8b0971508f",
                                                "sense_id": "d4d8d7f7-f474-38e3-a5ec-cd57275c29de",
                                                "text": "„Wiesloch. Diesmal nicht vom Himmel, sondern von einem unbekannten Täter wurde ein Eisblock auf das Fensterelement eines noch unbewohnten Neubaus geworfen.“"
                                            },
                                            {
                                                "example_id": "9221f04c-4ef5-49d6-9c22-33b4c3605a28",
                                                "sense_id": "d4d8d7f7-f474-38e3-a5ec-cd57275c29de",
                                                "text": "„Die Pupillen solcher vom Grauen gesättigter Augen hatten den Glanz eines Eisblocks angenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
