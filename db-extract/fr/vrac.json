                "senses": [
                    {
                        "sense_id": "41f82b2c-f5e2-3f38-afc5-a120d594c1b4",
                        "entry_id": "4bb910ae-d7e9-34a7-b4a9-cda309c47d51",
                        "glosses": [
                            "Marchandise qui n’est pas emballée ou conditionnée lors de son transport ou de sa distribution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0e2f9f-e974-4dfc-956c-c17dbcdb543d",
                                "sense_id": "41f82b2c-f5e2-3f38-afc5-a120d594c1b4",
                                "text": "Le vrac figure en tout cas de plus en plus dans la liste des petits gestes individuels que les Français sont prêts à faire pour la planète."
                            },
                            {
                                "example_id": "e95b9a80-4d5b-4f74-b165-d27be4ef99db",
                                "sense_id": "41f82b2c-f5e2-3f38-afc5-a120d594c1b4",
                                "text": "Deux grandes catégories de produits se prêtent à ce genre de transport : le vrac liquide et le vrac sec."
                            },
                            {
                                "example_id": "41da1928-051b-49b1-a8b8-c6e528d46b82",
                                "sense_id": "41f82b2c-f5e2-3f38-afc5-a120d594c1b4",
                                "text": "Le port de Montréal possède déjà 19 terminaux, dont un à Contrecoeur. Depuis les années 1950, on y décharge du vrac solide, pour alimenter, entre autres, l’industrie sidérurgique."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2de1a9c-d503-32c4-b733-e048e8d388cb",
                        "entry_id": "4bb910ae-d7e9-34a7-b4a9-cda309c47d51",
                        "glosses": [
                            "Mode de production ou de distribution d'un produit non conditionné, sans marque."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9b1a262-800c-43e7-a744-d23962e63b66",
                        "source_entry_id": "4bb910ae-d7e9-34a7-b4a9-cda309c47d51",
                        "target_lang_word": "bulk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "648b70a9-f075-3af1-8257-fdf28b6ee6a8",
                                        "entry_id": "493e9b77-6a94-3b6e-9682-ce823d1d325b",
                                        "glosses": [
                                            "Size, specifically, volume."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1898db1e-2da3-4df4-a69f-02d2a5fc539f",
                                                "sense_id": "648b70a9-f075-3af1-8257-fdf28b6ee6a8",
                                                "text": "The Quantity of Matter is the measure of the same, arising from its density and bulk conjunctly."
                                            },
                                            {
                                                "example_id": "bdece476-8c62-4eed-9cc0-31472d8edaa2",
                                                "sense_id": "648b70a9-f075-3af1-8257-fdf28b6ee6a8",
                                                "text": "“ Didn't Balbus say this morning that, if a body is immersed in liquid, it displaces as much liquid as is equal to its own bulk? ” said Hugh."
                                            },
                                            {
                                                "example_id": "9db6807a-5776-4977-85a7-3875497177f1",
                                                "sense_id": "648b70a9-f075-3af1-8257-fdf28b6ee6a8",
                                                "text": "By this process the body of the oyster acquires such a plumpness and rotundity, and its bulk and weight are so increased, as to materially increase its selling value."
                                            },
                                            {
                                                "example_id": "fd4abbcf-21a5-404c-80f0-003ae0c53bb8",
                                                "sense_id": "648b70a9-f075-3af1-8257-fdf28b6ee6a8",
                                                "text": "The cliff-dwellers had chipped and chipped away at this boulder till it rested its tremendous bulk upon a mere pin-point of its surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abd1d535-888e-3787-adb9-5dc15e898d95",
                                        "entry_id": "493e9b77-6a94-3b6e-9682-ce823d1d325b",
                                        "glosses": [
                                            "Any huge body or structure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b496773-ef95-4c83-bf10-227f0f33360b",
                                                "sense_id": "abd1d535-888e-3787-adb9-5dc15e898d95",
                                                "text": "The obese woman couldn't ease her bulk through the narrow passageway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea180a29-56fb-3915-96a6-1b5f14d1cfc6",
                                        "entry_id": "493e9b77-6a94-3b6e-9682-ce823d1d325b",
                                        "glosses": [
                                            "The major part of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e8fcfa-094c-4a52-a23e-9bce8ad58d40",
                                                "sense_id": "ea180a29-56fb-3915-96a6-1b5f14d1cfc6",
                                                "text": "In the case of such a contract, there must be an implied condition that the bulk shall correspond with the sample in quality"
                                            },
                                            {
                                                "example_id": "31cdf710-35c3-40f8-8005-b86c75e2d610",
                                                "sense_id": "ea180a29-56fb-3915-96a6-1b5f14d1cfc6",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "b30a2806-422f-43f5-9c17-2e968a0b522d",
                                                "sense_id": "ea180a29-56fb-3915-96a6-1b5f14d1cfc6",
                                                "text": "the main bulk of a nut roast is generally some form of carbohydrate, intended to lighten the load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "914d4761-df22-35ae-bb0d-a33e63b00f32",
                                        "entry_id": "493e9b77-6a94-3b6e-9682-ce823d1d325b",
                                        "glosses": [
                                            "The major part of something.",
                                            "Majority, balance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa52646b-7855-43ab-8d2b-c148d29ad58a",
                                                "sense_id": "914d4761-df22-35ae-bb0d-a33e63b00f32",
                                                "text": "The bulk of my income comes from my office job, but I also teach a couple of evening classes."
                                            },
                                            {
                                                "example_id": "53a6af16-0ea4-4c49-9774-2e00ee0d16d9",
                                                "sense_id": "914d4761-df22-35ae-bb0d-a33e63b00f32",
                                                "text": "The bulk of the criticisms were invalid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b95cc9c7-c960-3a76-b25a-ea746c1f9a92",
                                        "entry_id": "493e9b77-6a94-3b6e-9682-ce823d1d325b",
                                        "glosses": [
                                            "The major part of something.",
                                            "Gist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
