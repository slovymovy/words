            "senses": [
                {
                    "sense_id": "7a2a1b34-475e-345b-8765-183687473f83",
                    "sense_definition": "Qui a été aplati, broyé ou détruit sous l'effet d'une forte pression ou d'un choc.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le carton posé au sol était <w>écrasé</w> sous le poids des lourdes valises.",
                            "target_lang_translations": {
                                "en": "The cardboard box lying on the floor was <w>flattened</w> under the weight of the heavy suitcases.",
                                "ru": "Картонная коробка, стоявшая на полу, была <w>сплющена</w> под весом тяжёлых чемоданов.",
                                "de": "Der Karton, der auf dem Boden lag, war unter dem Gewicht der schweren Koffer <w>plattgedrückt</w>.",
                                "es": "La caja de cartón colocada en el suelo estaba <w>aplastada</w> bajo el peso de las pesadas maletas.",
                                "zh": "放在地上的纸箱在沉重行李的重压下已经<w>压扁</w>了。"
                            }
                        },
                        {
                            "text": "Sur la table de la cuisine se trouvait un fruit <w>écrasé</w> qui attirait les insectes.",
                            "target_lang_translations": {
                                "en": "On the kitchen table lay a <w>squashed</w> piece of fruit that attracted insects.",
                                "ru": "На кухонном столе лежал <w>раздавленный</w> фрукт, который привлекал насекомых.",
                                "de": "Auf dem Küchentisch lag eine <w>zerquetschte</w> Frucht, die Insekten anlockte.",
                                "es": "Sobre la mesa de la cocina había una fruta <w>aplastada</w> que atraía a los insectos.",
                                "zh": "厨房的桌子上有一个被<w>压扁</w>的水果，吸引了昆虫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aplati",
                        "broyé"
                    ],
                    "antonyms": [
                        "intact"
                    ],
                    "common_phrases": [
                        "fruit écrasé",
                        "véhicule écrasé"
                    ],
                    "target_lang_definitions": {
