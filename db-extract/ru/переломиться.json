                        "examples": [
                            {
                                "example_id": "fe4b0d31-30c1-4bfe-8ffb-29d2115b5360",
                                "sense_id": "5663e9b1-fb68-3319-8b24-b1bcd28f587a",
                                "text": "У вас, естественно, совсем другие вкусы, но ведь вы не переломитесь, если выслушаете, что случилось с Альберто и Маргаритой"
                            },
                            {
                                "example_id": "8beb952b-f4ea-45a3-97c4-3fcfb4db468e",
                                "sense_id": "5663e9b1-fb68-3319-8b24-b1bcd28f587a",
                                "text": "Слышишь? Пускай вон ребята помогут, не переломятся. Ох, господи!"
                            }
                        ]
                    }
