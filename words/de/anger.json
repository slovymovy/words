                            },
                            {
                                "target_lang_word": "meadow",
                                "target_lang_sense_clarification": "small plot of grass or pasture"
                            },
                            {
                                "target_lang_word": "pasture",
                                "target_lang_sense_clarification": "patch of land used for grazing"
                            }
                        ]
                    }
                }
            ]
        },
