                "senses": [
                    {
                        "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                        "entry_id": "eac72a6a-f8cd-33c7-bc2d-be66f025682c",
                        "glosses": [
                            "Autorin/Schriftstellerin, die Romane verfasst"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "3157b3b2-5d5c-428a-a69f-fdbdaec208de",
                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                "text": "„Folglich leitet sie politische Aussagen der Romancierin Asena ab.“"
                            },
                            {
                                "example_id": "e9e1c711-fa18-4c50-ada9-476b42768e20",
                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                "text": "„Soeben erhalte ich von Ricarda Huch (berühmte Romancierin in Zürich) einen wundervollen Brief über mein Buch, welches sie über alle Bücher der modernen Literatur stellt.“"
                            },
                            {
                                "example_id": "23960aec-323d-469e-9fd3-06a72bd3a0ac",
                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                "text": "„Es ist nicht mehr als ein bloßer Zufall, daß sowohl ein Kosmologe aus dem Populärbereich als auch eine Romancierin wieder den meteoritischen Begriff ins Spiel brachten.“"
                            },
                            {
                                "example_id": "a1c4dd71-7569-4ae4-a84e-30fb25ffe073",
                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                "text": "„Man hörte und fühlte in ihm noch immer den Hirtensänger und den Freiheitskämpfer, der sein Bein auf dem Felde gelassen hatte (man verzeihe der seinerzeit bekannten Romancierin und Übersetzerin diese Falschmeldung – M. J.) und dann mit dem Stelzfuß zur Höhe des Gelehrtenruhms emporgeklommen war.“"
                            },
                            {
                                "example_id": "74656cb1-957b-4310-b53f-c7421e086732",
                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                "text": "„Die Romancierin Maria Louise Rame schrieb im Jahr 1900: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
