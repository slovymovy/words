                "senses": [
                    {
                        "sense_id": "fae9d153-a343-3631-aba4-b46f33f4d6f4",
                        "entry_id": "e296c872-5c9b-3d86-894b-2075d9702099",
                        "glosses": [
                            "In an excited manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45877e1-87d2-4e16-b85f-73cb22e2d9d5",
                                "sense_id": "fae9d153-a343-3631-aba4-b46f33f4d6f4",
                                "text": "Everybody crowded around very excitedly and talked about the Australian crawl, a stroke I cannot do because there is something wrong with my flutter kick."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd02507b-0bcf-43c7-ad47-a09f60a47e98",
                        "source_entry_id": "e296c872-5c9b-3d86-894b-2075d9702099",
                        "source_sense_id": "fae9d153-a343-3631-aba4-b46f33f4d6f4",
                        "source_sense_description": "in an excited manner",
                        "target_lang_word": "excité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e419ddb0-5c4c-32b1-81ae-c8da67e8207a",
                                        "entry_id": "a274a82a-edbb-3e75-821f-32c7cfcbc023",
                                        "glosses": [
                                            "Qui est en état d’excitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c04f3062-e316-480b-84ad-4b7629f626ba",
                                                "sense_id": "e419ddb0-5c4c-32b1-81ae-c8da67e8207a",
                                                "text": "Et il descendit de sa chaire, plus rouge et plus excité que jamais, les yeux lançant des éclairs et brandissant vers la nef un poing terrible et vengeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94353d66-8cb9-3272-be41-788a7251f7b0",
                                        "entry_id": "a274a82a-edbb-3e75-821f-32c7cfcbc023",
                                        "glosses": [
                                            "Qui est stimulé sexuellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb0f367-e913-4e94-aa2c-10358bcfab0a",
                                                "sense_id": "94353d66-8cb9-3272-be41-788a7251f7b0",
                                                "text": "Elle fait l'amour, simplement autant qu'elle peut, de toute sa chair, sans rater une occasion. On prétend qu'une nuit, dans un cabaret, elle était tellement excitée par un de ses compagnons qu'elle a glissé sous la table avec lui et qu'ils ont forniqué, à l'abri d'une nappe, au milieu de cinquante personnes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "excité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c0d76b-fbb6-3336-95bc-5cef77a165a9",
                                        "entry_id": "21d62fa6-ae7f-3a4c-a21c-425d55068ed1",
                                        "glosses": [
                                            "Homme excité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992c3f69-7137-4d4d-8605-a9c1cd7f5d0a",
                                                "sense_id": "e2c0d76b-fbb6-3336-95bc-5cef77a165a9",
                                                "text": "Un excité s’est jeté la tête la première contre les boucliers des policiers qui l’ont arrosé de coups de matraque."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "excité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6403db-1932-3ca5-a015-46ee7f42240a",
                                        "entry_id": "49e56d64-0e3b-3b7d-85f2-03fdf082e4db",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe exciter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fb1c853-c67b-4a54-af60-78d98797ab5d",
                                                "sense_id": "8f6403db-1932-3ca5-a015-46ee7f42240a",
                                                "text": "La réputation dont jouissait la maison Bauer avait naturellement excité la jalousie de quelques maisons rivales ; une d’entre elles s’avisa de vouloir désarmorier l’enseigne des Trois-Etoiles-d’Or, et grâce à l’influence de plusieurs personnages assez haut placés, le patron de Rose Himmel allait se voir dépossédé de la fourniture de la cour, ce qui eût été, m’a-t-il dit lui-même plus tard, un coup si fatal à sa fortune et à sa réputation, qu’il n'’y aurait pas survécu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
