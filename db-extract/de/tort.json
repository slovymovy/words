                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c91fea1-06b1-3d18-a112-f2936888a9e3",
                        "entry_id": "ae574e46-d436-35ee-9edd-21099ae3bfcb",
                        "glosses": [
                            "etwas, das nicht rechtens ist; etwas, aus dem jemandem ein Nachteil, Schaden erwächst; etwas, das kränkt, verdrießt oder einfach unangenehm ist"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "494c220f-ac08-47ce-b1ad-595db14abec3",
                                "sense_id": "1c91fea1-06b1-3d18-a112-f2936888a9e3",
                                "text": "„Die Lehrersfrau Schwoch, die noch nationalsozialistischer war als ihr kriegsbegeisterter Mann, haßte natürlich sofort diesen Kienschäper und tat ihm alles zum Tort, was ihrem gehässigen Hirn nur einfiel.“"
                            },
                            {
                                "example_id": "285b2f53-f94c-44cb-8250-4cc575f56864",
                                "sense_id": "1c91fea1-06b1-3d18-a112-f2936888a9e3",
                                "text": "„Ihre müßigen Gedanken hingen mit wahrer Leidenschaft an allem, was ihr zum Torte geschah.“"
                            },
                            {
                                "example_id": "b6a28310-915d-481b-8194-8a07db0fa00c",
                                "sense_id": "1c91fea1-06b1-3d18-a112-f2936888a9e3",
                                "text": "„Ein letzter Tort, den sie Graf Ludwig Johannes Karl Erdmann antut.“"
                            },
                            {
                                "example_id": "4c86982f-2a46-4964-ab16-1e773a63c190",
                                "sense_id": "1c91fea1-06b1-3d18-a112-f2936888a9e3",
                                "text": "„Die Empörung, die sie aufgrund ihrer eigenen Behandlung verspürte, wurde geschürt durch den Brandy, aber noch mehr durch ihren uneigennützigen Ingrimm wegen des Torts, der Dr. Wilfred angetan worden war.“"
                            },
                            {
                                "example_id": "0d847ce3-29b0-43d3-87d0-912a899eb1cb",
                                "sense_id": "1c91fea1-06b1-3d18-a112-f2936888a9e3",
                                "text": "„Dass es außerhalb der Saison geregnet hatte – ›gegen die Astronomie‹, wie er wichtig erklärte, Meister Musa zum Tort –, schien den Kunden so zu verwirren, dass er keine Konsequenzen daraus zu ziehen vermochte und störrisch im Nassen verweilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fba170c-f0f5-4330-a4ef-cc6b7b9b4765",
                        "source_entry_id": "ae574e46-d436-35ee-9edd-21099ae3bfcb",
                        "source_sense_id": "1c91fea1-06b1-3d18-a112-f2936888a9e3",
                        "target_lang_word": "tort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95cfe367-04fd-38e8-82bf-8c3363ca408f",
                                        "entry_id": "9ca13073-5e09-3d03-9a00-ecc33f97aa21",
                                        "glosses": [
                                            "A wrongful act, whether intentional or negligent, regarded as non-criminal and unrelated to a contract, which causes an injury and can be remedied in civil court, usually through the awarding of damages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0166ec6-8a35-4202-9ab0-94a0ca804131",
                                                "sense_id": "95cfe367-04fd-38e8-82bf-8c3363ca408f",
                                                "text": "[…] Wrong or Iniury, is in French aptly called Tort, becauſe Iniury & wrong is wreſted or crooked, being contrary to that which is right and ſtreight. […] And Britton ſaith that Tort a la ley eſt contrarye [a wrong to the law is contrary], and as aptly for the cauſe aforeſaid is iniury in English called wrong."
                                            },
                                            {
                                                "example_id": "3d34b8cd-ad68-4677-b186-7762fa73ef93",
                                                "sense_id": "95cfe367-04fd-38e8-82bf-8c3363ca408f",
                                                "text": "Personal actions are ſuch vvhereby a man claims a debt, or perſonal duty, or damages in lieu thereof; and likevviſe vvhereby a man claims a ſatisfaction in damages for ſome injury done to his perſon or property. The former are ſaid to be founded on contracts, the latter upon torts or vvrongs: […] of the latter all actions for treſpaſſes, nuſances, aſſaults, defamatory vvords, and the like."
                                            },
                                            {
                                                "example_id": "5373bb1b-a9f1-4674-a8f6-e08a06e805b6",
                                                "sense_id": "95cfe367-04fd-38e8-82bf-8c3363ca408f",
                                                "text": "A tort is a legal wrong committed upon the person or property independent of contract. It may be either (1) a direct invasion of some legal right of the individual; (2) the infraction of some public duty by which special damage accrues to the individual; (3) the violation of some private obligation by which like damage accrues to the individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4565bcb8-85dc-320f-b02f-0210773ea0de",
                                        "entry_id": "9ca13073-5e09-3d03-9a00-ecc33f97aa21",
                                        "glosses": [
                                            "An injury or wrong."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b27a44e-631f-49e9-926b-cf6cc498fd88",
                                                "sense_id": "4565bcb8-85dc-320f-b02f-0210773ea0de",
                                                "text": "Then gan triumphant Trompets ſovvnd on hye, / That ſent to heuen the ecchoed report / Of their nevv ioy, and happie victory / Gainſt him, that had them long oppreſt with tort, / And faſt impriſoned in ſieged fort."
                                            },
                                            {
                                                "example_id": "302b3867-e102-4dd3-99eb-61bdf99445d8",
                                                "sense_id": "4565bcb8-85dc-320f-b02f-0210773ea0de",
                                                "text": "For no vvild beaſts ſhould do them any torte / There or abroad, ne vvould his maieſtye / Vſe them but vvell, vvith gracious clemencye, / As vvhome he knevv to him both faſt and true; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02f7a85f-a0f4-3706-a0c1-f9843c0ee05c",
                                        "entry_id": "b5f05e24-b4c8-3c8b-bc7d-b4a61a51c301",
                                        "glosses": [
                                            "Twisted."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb63d371-7333-4890-a207-c30173c3dcba",
                                                "sense_id": "02f7a85f-a0f4-3706-a0c1-f9843c0ee05c",
                                                "text": "And the firſt that came and gaue them moſt comfort was Henry Erle of Lãcaſter with yͤ wrie neck, called Tort coll [torticollis], who was brother to Thomas Erle of Lãcaſter yͭ was behedded, as ye haue heard before, who was a right vertuous & good knight as after ye ſhal here."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be962d2b-f6c0-37d0-b9d3-154b07e4f50d",
                                        "entry_id": "5898ca0a-6db6-3c56-a589-bfb850f7801f",
                                        "glosses": [
                                            "Synonym of tart (“sharp- or sour-tasting; (figuratively) keen, severe, sharp”)"
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5e064ed-9a0e-3e0b-9c64-89265542273a",
                                        "entry_id": "a67fa06b-d43f-33a5-b2c9-57f42e757600",
                                        "glosses": [
                                            "Synonym of taut (“stretched tight; under tension”)."
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10948f88-dcb0-4bff-8c9a-12d3b205938b",
                                                "sense_id": "a5e064ed-9a0e-3e0b-9c64-89265542273a",
                                                "text": "Yet holds he them with tortest rein, / That they may seize and entertain / The glance that to their glance opposes, / Like fiery honey sucked from roses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d376642-34ca-3884-a714-01e6fd7587b8",
                                        "entry_id": "a67fa06b-d43f-33a5-b2c9-57f42e757600",
                                        "glosses": [
                                            "Of a boat: watertight."
                                        ],
                                        "tags": [
                                            "British",
