                                            {
                                                "example_id": "5149985f-9af3-426f-941d-c3812c717ac5",
                                                "sense_id": "7ef96490-2031-3c6d-96aa-11bd0e4f2d0c",
                                                "text": "※ Για πρώτη φορά στις φοιτητικές κινητοποιήσεις οι δύο μεγάλες παρατάξεις επιδεικνύουν σε αγαστή συνεργασία έντονα αγωνιστική δράση. (εφημερίδα Ελευθεροτυπία, 5 Σεπτεμβρίου 2011)"
                                            },
                                            {
                                                "example_id": "6d3b89b1-624e-4e78-8923-24d683d9ee71",
                                                "sense_id": "7ef96490-2031-3c6d-96aa-11bd0e4f2d0c",
                                                "text": "(ειρωνικό) ※ Κάπως έτσι λοιπόν, σε αγαστή συνεργασία, Τύπος, κόμματα και κυβέρνηση έκλεισαν τ' αυτιά τους στην Κασσάνδρα. (εφημερίδα Καθημερινή, 6 Αυγούστου 2011)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e34360c2-d84a-466d-8306-c5a19b31c1aa",
                        "source_entry_id": "d070268b-f6b1-3642-8c55-6d08efc1ccb8",
                        "source_sense_description": "deserving of the highest esteem or admiration",
                        "target_lang_word": "立派",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "立派",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb74379-443f-380f-bdf2-e352f9708bdf",
                                        "entry_id": "d771da07-ce89-32e1-93aa-826da7d1d42d",
                                        "glosses": [
                                            "品質や品性が非常に優れているさま。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c1a6cd-fea4-47c0-aae1-1e93385f0553",
                                                "sense_id": "fbb74379-443f-380f-bdf2-e352f9708bdf",
                                                "text": "今はもう散つて了つたが、 馬酔木の花は樹の花の中でも立派なものだ。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66bd38f9-1a32-3824-a10c-61af3ea5b0f8",
                                        "entry_id": "d771da07-ce89-32e1-93aa-826da7d1d42d",
                                        "glosses": [
                                            "欠点や不足している所がないさま。疑うことない、間違いない、見事に。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef19dd96-9588-4645-95a6-d3ac4bc36eda",
                                                "sense_id": "66bd38f9-1a32-3824-a10c-61af3ea5b0f8",
                                                "text": "よし、それが淨土教の影響によるにもせよ、老莊道學の示唆を得たにもせよ、わが國人の氣魄とやはらぎを享けて生活趣味の常用燈となつた以上、立派に國産である。"
                                            },
                                            {
                                                "example_id": "c47d2ceb-a6bf-4afe-a3d4-deede0006f67",
                                                "sense_id": "66bd38f9-1a32-3824-a10c-61af3ea5b0f8",
                                                "text": "「無えよ、うむー。正に無え、……俺おいらの手腕はとうにしびれッちまつた。手腕ばかりならいいが、脛も腰も、骨も肉も、ないし魂も根性もだツ、立派に腐つた……。しびれきつてしまつたてえ事ッ。碌でなしだからな」"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
