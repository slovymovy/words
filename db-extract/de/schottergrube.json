                            {
                                "example_id": "a403c80b-7dd7-4b78-9d6f-516de08dc569",
                                "sense_id": "2dceb1a5-54fb-3d04-b6b5-33e8eb0cd92a",
                                "text": "„Im Sommer 1993 war es nicht ratsam, von dieser höhergelegenen Schottergrube für die dringend notwendige Sanierung der Schneealmstraße Material zu entnehmen, zumal bereits die Wiener Wasserwerke Beschwerden vorgebracht hatten, daß das Wasser in eine falsche Doline fließe.“"
                            }
                        ],
