        "nl-extract.jsonl": [
            {
                "entry_id": "392d7235-1064-310a-892c-a59b94c33195",
                "word": "vuurrood",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d473954e-cbcc-31c6-8d03-85afa4f1adc2",
                        "entry_id": "392d7235-1064-310a-892c-a59b94c33195",
                        "glosses": [
                            "in een tint rood met RAL-nummer 3000 ( )."
                        ],
                        "tags": [
                            "RAL-kleur"
                        ],
                        "examples": [
                            {
                                "example_id": "d7301828-0183-4be2-9dc0-e3d756ccf089",
                                "sense_id": "d473954e-cbcc-31c6-8d03-85afa4f1adc2",
                                "text": "De zijkant was een egaal vuurrood vlak."
                            },
                            {
                                "example_id": "c3bb1162-4f31-4df8-9093-1d50fd4ee8ef",
                                "sense_id": "d473954e-cbcc-31c6-8d03-85afa4f1adc2",
                                "text": "Hij rijdt in een vuurrode auto."
                            },
                            {
                                "example_id": "064da8bc-cff5-4462-a0ea-53a34bfa8da2",
                                "sense_id": "d473954e-cbcc-31c6-8d03-85afa4f1adc2",
                                "text": "Hoewel ik er vaak was geweest en de klinkende namen van Titiaan en Tintoretto achteloos door soireetjes had laten rollen, hoewel ik geroutineerd in mijn krant bleef lezen terwijl de vuurrode hogesnelheidstrein mij over de landverbinding van Mestre naar de oude stad bracht en veelbetekenend begon af te remmen, en hoewel ik mij had voorgenomen om mijn entree in de stad met een praktische instelling te benaderen en enige eventuele beroering van het gemoed uit te stellen totdat ik goed en wel was geïnstalleerd, moest ik even naar adem happen toen ik het station uit liep en het breekbare, pastelkleurige cliché van de stad aan het groene water zich onbekommerd en schijnbaar onschuldig voor mij ontvouwde."
                            }
                        ]
                    },
                    {
                        "sense_id": "325b2a7e-6a34-3d1c-8073-8b8a2c86d9e6",
                        "entry_id": "392d7235-1064-310a-892c-a59b94c33195",
                        "glosses": [
                            "bijzonder rood, zo rood als vuur"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a4e625e-a293-4906-adad-d7067aa37440",
                        "source_entry_id": "392d7235-1064-310a-892c-a59b94c33195",
                        "target_lang_word": "Feuerrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c922c480-9308-456c-b2d1-c5b4670523c0",
                        "source_entry_id": "392d7235-1064-310a-892c-a59b94c33195",
                        "target_lang_word": "feuerrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuerrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                        "entry_id": "341b00e9-88a3-349f-8b9c-3de84ac69bac",
                                        "glosses": [
                                            "in, von einem grellen, intensiven Rot (wie dem des Feuers)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112ea0cf-22c7-46b1-ba54-1534fdc2bcbc",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "Sie trug einen feuerroten Pullover."
                                            },
                                            {
                                                "example_id": "cf12e788-ac1d-4b95-b808-665d964e9f68",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "Seine Wangen wurden feuerrot."
                                            },
                                            {
                                                "example_id": "f91fe131-18af-42ce-8588-7b549505d79a",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Im Garten spielten die fremden Kinder, tütenblau, dottergelb, feuerrot, angezogen wie Clowns, […].“"
                                            },
                                            {
                                                "example_id": "9f9ed758-bfa1-4290-bc8b-4a0f190316b2",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Undine mit dem langen, roten Haar, in einem noch feuerroteren Kleid, ging mit halb geschlossenen Augen und gesenktem Blick, Fuß vor Fuß.“"
                                            },
                                            {
                                                "example_id": "33f0c505-f657-40e1-86bc-62ac3cc59835",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Der arme Tubaspieler hat bereits ein feuerrotes Gesicht.“"
                                            },
                                            {
                                                "example_id": "e556acd3-1483-4465-96bc-fad70ca2c61e",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Mitten auf der Straße schnaubte wütend ein nagelneues, feuerrotes Auto, dessen Windschutzscheibe durch einen Ziegel zersplittert war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27eadbbd-81b2-4c4f-8044-6550d531d30a",
                        "source_entry_id": "392d7235-1064-310a-892c-a59b94c33195",
