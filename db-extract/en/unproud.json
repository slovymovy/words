                        "glosses": [
                            "Not proud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cef8dac-6391-4f7e-81f2-b3845a8a7186",
                                "sense_id": "87fc809b-6c2f-3cb6-9f3f-42c014d9c915",
                                "text": "When he jeers at the British public who 'love me not,' it is with an air more jaunty than bitter, as of a. man not half-displeased to be above his audience, nor quite unproud of that distinction—sentiments which no audience is likely to approve of."
                            },
                            {
                                "example_id": "8857f122-cfd5-4ad5-a44d-9153fc45a041",
                                "sense_id": "87fc809b-6c2f-3cb6-9f3f-42c014d9c915",
                                "text": "Listen, thou child I used to be! / Unproud I move, and yet unbowed, / Where thou wast fed with vanity, / Thy chiefest pride — thou wast not proud!"
                            },
                            {
                                "example_id": "6d437407-3034-496d-aa8a-492bc7ef9f3e",
                                "sense_id": "87fc809b-6c2f-3cb6-9f3f-42c014d9c915",
                                "text": "Arthur would spot Dose coming a mile off on the street and pull his wallet out, stuff a five-spot into his palm for their handclasp when they collided, pity money Dose had become too unproud to refuse."
                            }
                        ]
                    }
