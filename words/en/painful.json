{
    "word_family": [
        "pain",
        "painless",
        "painfully",
        "painfulness",
        "painstaking"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5103b4a-25a5-3dc1-9831-2c2db6818060",
                    "sense_definition": "Causing physical or mental suffering, distress, or discomfort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "causing_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient found it <w>painful</w> to swallow due to a severe throat infection.",
                            "target_lang_translations": {
                                "ru": "Пациенту было <w>больно</w> глотать из-за сильной инфекции горла.",
                                "zh": "由于严重的喉咙感染，病人感到吞咽很<w>痛苦</w>。"
                            }
                        },
                        {
                            "text": "Breaking up with a long-term partner is often a <w>painful</w> experience for everyone involved.",
                            "target_lang_translations": {
                                "ru": "Разрыв с давним партнером часто является <w>болезненным</w> опытом для всех участников.",
                                "zh": "与长期伴侣分手对相关的所有人来说通常都是一段<w>痛苦的</w>经历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agonizing",
                        "excruciating",
                        "hurtful",
                        "unpleasant"
                    ],
                    "antonyms": [
                        "painless",
                        "pleasant",
                        "agreeable"
                    ],
                    "common_phrases": [
                        "painful experience",
                        "painful memory",
                        "painful reminder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий физические или душевные страдания, мучения или дискомфорт.",
                        "zh": "引起身体或精神上的痛苦、苦恼或不适。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "вызывающий физическую боль или неприятные ощущения"
                            },
                            {
                                "target_lang_word": "мучительный",
                                "target_lang_sense_clarification": "причиняющий сильные страдания, как физические, так и моральные"
                            },
                            {
                                "target_lang_word": "тяжелый",
                                "target_lang_sense_clarification": "о морально трудных переживаниях или воспоминаниях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "痛苦的",
                                "target_lang_sense_clarification": "引起身体或精神上的强烈痛苦"
                            },
                            {
                                "target_lang_word": "令人痛苦的",
                                "target_lang_sense_clarification": "形容某事让人感到难受或苦恼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0179309e-4fc0-3c46-a344-bc8066de0e73",
                    "sense_definition": "Affected by or feeling physical pain, especially regarding a specific part of the body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feeling_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>painful</w> joints made it difficult for him to walk up the stairs.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>больных</w> суставов ему было трудно подниматься по лестнице.",
                                "zh": "他<w>疼痛的</w>关节使他很难走上楼梯。"
                            }
                        },
                        {
                            "text": "The athlete had a <w>painful</w> knee after the marathon and needed to rest.",
                            "target_lang_translations": {
                                "ru": "После марафона у атлета <w>болело</w> колено, и ему требовался отдых.",
                                "zh": "马拉松比赛后，这位运动员的膝盖感到<w>疼痛</w>，需要休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aching",
                        "achy",
                        "sore",
                        "tender"
                    ],
                    "antonyms": [
                        "painless",
                        "unaching",
                        "pain-free"
                    ],
                    "common_phrases": [
                        "painful joints",
                        "painful swelling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий физическую боль или пораженный ею (обычно о части тела).",
                        "zh": "感到身体疼痛的，尤指身体的某个部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "больной",
                                "target_lang_sense_clarification": "о части тела, которая болит"
                            },
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "чувствительный к прикосновению из-за боли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疼痛的",
                                "target_lang_sense_clarification": "指身体部位感到疼痛"
                            },
                            {
                                "target_lang_word": "酸痛的",
                                "target_lang_sense_clarification": "指肌肉或关节感到酸胀疼痛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0235193c-4d28-38cc-9951-8914e8afc04a",
                    "sense_definition": "Extremely bad, poor in quality, or distressing to witness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>painful</w> to watch him try to sing when he was clearly out of tune.",
                            "target_lang_translations": {
                                "ru": "Было <w>мучительно</w> смотреть, как он пытается петь, явно не попадая в ноты.",
                                "zh": "看他唱歌时明显跑调，真是让人<w>难受</w>。"
                            }
                        },
                        {
                            "text": "The team's performance was <w>painful</w> to behold after so many weeks of practice.",
                            "target_lang_translations": {
                                "ru": "На игру команды после стольких недель тренировок было <w>тяжело</w> смотреть.",
                                "zh": "经过这么多周的训练，球队的表现简直<w>惨不忍睹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible",
                        "unpleasant"
                    ],
                    "antonyms": [
                        "pleasant",
                        "agreeable"
                    ],
                    "common_phrases": [
                        "painful to watch",
                        "painful to behold"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize how bad something is"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне плохой, некачественный или вызывающий огорчение при наблюдении.",
                        "zh": "极差的、质量低劣的，或目睹时令人感到难受的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучительный",
                                "target_lang_sense_clarification": "о чем-то, на что тяжело или неприятно смотреть"
                            },
                            {
                                "target_lang_word": "тяжелый",
                                "target_lang_sense_clarification": "о гнетущем впечатлении от увиденного"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "подчеркивает крайне низкое качество чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "令人难受的",
                                "target_lang_sense_clarification": "形容观看某事时感到尴尬或不适"
                            },
                            {
                                "target_lang_word": "糟糕的",
                                "target_lang_sense_clarification": "形容表现极差"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "400f1a64-b44f-33a3-aa9b-e879fe392f11",
                    "sense_definition": "Requiring a great deal of effort, labor, or difficulty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers began the <w>painful</w> process of cataloging thousands of ancient fragments.",
                            "target_lang_translations": {
                                "ru": "Исследователи начали <w>тяжелый</w> процесс каталогизации тысяч древних фрагментов.",
                                "zh": "研究人员开始了对数千件古代碎片进行分类的<w>艰苦</w>过程。"
                            }
                        },
                        {
                            "text": "Writing the final chapter proved to be a <w>painful</w> task that took several months.",
                            "target_lang_translations": {
                                "ru": "Написание последней главы оказалось <w>тяжкой</w> задачей, занявшей несколько месяцев.",
                                "zh": "事实证明，撰写最后一章是一项耗时数月的<w>艰巨</w>任务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "laborious",
                        "difficult"
                    ],
                    "antonyms": [
                        "painless"
                    ],
                    "common_phrases": [
                        "painful process",
                        "painful task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий больших усилий, труда или сопряженный с трудностями.",
                        "zh": "需要付出巨大努力、劳动或充满困难的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжелый",
                                "target_lang_sense_clarification": "требующий больших усилий или труда"
                            },
                            {
                                "target_lang_word": "тягостный",
                                "target_lang_sense_clarification": "трудный и неприятный процесс"
                            },
                            {
                                "target_lang_word": "тяжкий",
                                "target_lang_sense_clarification": "очень трудный, изнурительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艰苦的",
                                "target_lang_sense_clarification": "形容过程非常费力且困难"
                            },
                            {
                                "target_lang_word": "费力的",
                                "target_lang_sense_clarification": "形容任务需要耗费大量精力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5eb489-cca0-3890-9e24-91f0d98bf883",
                    "sense_definition": "Characterized by being painstaking, careful, or industrious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>painful</w> laborers worked through the night to ensure the harvest was completed.",
                            "target_lang_translations": {
                                "ru": "<w>Старательные</w> рабочие трудились всю ночь, чтобы завершить сбор урожая.",
                                "zh": "<w>勤奋的</w>工人们彻夜工作，以确保完成收割。"
                            }
                        },
                        {
                            "text": "She was known as a <w>painful</w> student who never left a single detail unchecked.",
                            "target_lang_translations": {
                                "ru": "Она была известна как <w>кропотливая</w> студентка, которая никогда не оставляла ни одной детали без проверки.",
                                "zh": "她以<w>细致</w>的学生而闻名，从不放过任何一个细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "laborious",
                        "industrious"
                    ],
                    "common_phrases": [
                        "painful labourer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся кропотливостью, тщательностью или трудолюбием (устаревшее).",
                        "zh": "以勤奋、细致或刻苦为特征的（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старательный",
                                "target_lang_sense_clarification": "прикладывающий много усилий к работе"
                            },
                            {
                                "target_lang_word": "кропотливый",
                                "target_lang_sense_clarification": "требующий терпения и внимания к деталям"
                            },
                            {
                                "target_lang_word": "трудолюбивый",
                                "target_lang_sense_clarification": "усердный в труде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勤奋的",
                                "target_lang_sense_clarification": "形容工作非常努力"
                            },
                            {
                                "target_lang_word": "细致的",
                                "target_lang_sense_clarification": "形容工作非常认真、注重细节"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}