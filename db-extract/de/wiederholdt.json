                "senses": [
                    {
                        "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                        "entry_id": "e513c7ed-7fd3-3a7e-a46b-f6d761d16765",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d24871b-3075-44ed-a5d2-827691726c70",
                                "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                                "text": "Frau Wiederholdt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e826e566-f9c8-4dd3-aed7-cf47a9601aa2",
                                "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                                "text": "Herr Wiederholdt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4dffbc13-aecb-444c-b9e8-a0f930539096",
                                "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                                "text": "Die Wiederholdts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "29501615-3bf1-463a-88b1-84dd866979e9",
                                "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                                "text": "Der Wiederholdt trägt nie die Schals, die die Wiederholdt ihm strickt."
                            },
                            {
                                "example_id": "cd0a8797-ec5e-403c-9665-33e8e7bd7a4a",
                                "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wiederholdt kommt, geht der Herr Wiederholdt.“"
                            },
                            {
                                "example_id": "fb4f0e54-7646-425b-a485-925a42addd3f",
                                "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                                "text": "Wiederholdt kommt und geht."
                            },
                            {
                                "example_id": "57ce4610-104a-43f4-a6bc-8127dc75c9e1",
                                "sense_id": "76b8e54c-9af3-399a-a722-e73eee616bed",
                                "text": "Wiederholdts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
