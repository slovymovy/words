                            {
                                "example_id": "5125bd10-7e7a-404d-87a2-9307527edc83",
                                "sense_id": "f22ebfe6-1dd1-3e5a-a754-d37ba6c5ea38",
                                "text": "Die Zwischenräume zwischen den Pfosten wurden mit einem Flechtwerk aus Weidenruten ausgefüllt."
                            },
                            {
                                "example_id": "e74d2157-3543-4f90-b0ec-757ae6dd10ba",
                                "sense_id": "f22ebfe6-1dd1-3e5a-a754-d37ba6c5ea38",
                                "text": "Seine Argumentation war ein einziges Flechtwerk aus Lügen."
                            },
                            {
                                "example_id": "122de174-e0ad-4b4f-a432-59278fcd27f8",
                                "sense_id": "f22ebfe6-1dd1-3e5a-a754-d37ba6c5ea38",
                                "text": "„Die Wände bestanden wohl aus Flechtwerk.“"
                            }
