                    {
                        "sense_id": "f690048d-d7f2-3656-8608-428f250268a9",
                        "entry_id": "51ddc229-6e05-3050-8539-f4529fa66f0d",
                        "glosses": [
                            "een smalle doorgang tussen twee zeeën en daarmee tevens de scheiding tussen twee landmassa's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a87bc3-aa55-45b9-81b8-aa3c52b0e50e",
                                "sense_id": "f690048d-d7f2-3656-8608-428f250268a9",
                                "text": "In een drukbevaren zeestraat is gisteren een olietanker aan de grond gelopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d979f989-49ac-4a42-96af-df8ffed60e9a",
                        "source_entry_id": "51ddc229-6e05-3050-8539-f4529fa66f0d",
                        "source_sense_id": "f690048d-d7f2-3656-8608-428f250268a9",
                        "source_sense_description": "een smalle doorgang tussen twee zeeën en daarmee tevens de scheiding tussen twee landmassa's",
                        "target_lang_word": "Meerenge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meerenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "785e74f3-6289-3ec8-9f0d-44373ece340a",
                                        "entry_id": "59fb589b-1b0d-35d4-8e51-3ffe2a620076",
                                        "glosses": [
                                            "enge Stelle im Meer zwischen zwei Landmassen, enge Stelle auf einer Schifffahrtsroute im Meer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b255c5-28f0-442b-ac41-b3d7d2ad1b9e",
                                                "sense_id": "785e74f3-6289-3ec8-9f0d-44373ece340a",
                                                "text": "Das Schiff fährt durch eine Meerenge."
                                            },
                                            {
                                                "example_id": "46fd91f7-4c20-4d97-b2e8-59111ea45b85",
                                                "sense_id": "785e74f3-6289-3ec8-9f0d-44373ece340a",
                                                "text": "Dänemark wird von Schweden durch eine Meerenge getrennt."
                                            },
                                            {
                                                "example_id": "487f0f4a-9038-480c-b21a-6110a10fd4e1",
                                                "sense_id": "785e74f3-6289-3ec8-9f0d-44373ece340a",
                                                "text": "Der Ärmelkanal ist eine Meerenge."
                                            },
                                            {
                                                "example_id": "6d6dcb36-2ffa-45a0-97c6-fac8b180d50d",
                                                "sense_id": "785e74f3-6289-3ec8-9f0d-44373ece340a",
                                                "text": "„Danach setzte er sich von Abydos aus im Gebiet der thrakischen Chersones fest (196 v.Chr.), womit er die strategisch wichtige Meerenge am Bosporus unter seine Kontrolle brachte.“"
                                            },
                                            {
                                                "example_id": "0c0c0c36-a1b5-4f28-9548-95e29b4c39a0",
                                                "sense_id": "785e74f3-6289-3ec8-9f0d-44373ece340a",
                                                "text": "„Von unserem Schiff aus zählten wir bei Tagesanbruch mehr als vierzig Kriegsschiffe, die nachts in der schmalen Meerenge kreuzten, um einen Überraschungsangriff zu verhindern.“"
                                            },
                                            {
                                                "example_id": "b1ef5ac0-9bdd-4fe5-9520-c47161ac18f3",
                                                "sense_id": "785e74f3-6289-3ec8-9f0d-44373ece340a",
                                                "text": "„Danach sollten sie sich durch die stark bewachte Meerenge von Gibraltar ins Mittelmeer vorkämpfen, um für Rommels Armee in Afrika die Nachschubwege vor feindlichen Schiffen abzusichern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "133ada55-d746-403b-a421-68d2b6193b03",
                        "source_entry_id": "51ddc229-6e05-3050-8539-f4529fa66f0d",
                        "source_sense_id": "f690048d-d7f2-3656-8608-428f250268a9",
                        "source_sense_description": "een smalle doorgang tussen twee zeeën en daarmee tevens de scheiding tussen twee landmassa's",
                        "target_lang_word": "strait",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b97569a-73ac-392a-ab65-4b41a0043f03",
                                        "entry_id": "a6c53e75-8bdc-3fd8-9df7-ddd1373c47e3",
                                        "glosses": [
                                            "Narrow; restricted as to space or room; close."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1ecf31-8149-466b-9064-47bb72d25776",
                                                "sense_id": "0b97569a-73ac-392a-ab65-4b41a0043f03",
                                                "text": "Sweet oil was poured out on thy head\nAnd ran down like cool rain between\nThe strait close locks it melted in."
                                            },
                                            {
                                                "example_id": "b925ad54-06ee-4f32-b664-2ca8d5c7abff",
                                                "sense_id": "0b97569a-73ac-392a-ab65-4b41a0043f03",
                                                "text": "Where shall we keep the holiday, / And duly greet the entering May? / Too strait and low our cottage doors, / And all unmeet our carpet floors; […]"
                                            },
                                            {
                                                "example_id": "3a9be923-6d9a-48e2-82dd-4394e60a344f",
                                                "sense_id": "0b97569a-73ac-392a-ab65-4b41a0043f03",
                                                "text": "1894, Ernest Dowson, “To One in Bedlam” in The Second Book of The Rhymers’ Club, London: Elkin Mathews & John Lane, p. 35,\nThose scentless wisps of straw, that miserably line\nHis strait, caged universe, whereat the dull world stares,\nPedant and pitiful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc2aa6da-6476-3054-befe-236644647a82",
                                        "entry_id": "a6c53e75-8bdc-3fd8-9df7-ddd1373c47e3",
                                        "glosses": [
                                            "Righteous, strict."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bd35d07-2e41-48af-a0ca-be0ea7bec3f1",
                                                "sense_id": "cc2aa6da-6476-3054-befe-236644647a82",
                                                "text": "to follow the strait and narrow"
                                            },
                                            {
                                                "example_id": "4168f005-1903-4cab-8640-f6e734ee80a5",
                                                "sense_id": "cc2aa6da-6476-3054-befe-236644647a82",
                                                "text": "[he] takes on him to reform / Some certain edicts and some strait decrees / That lie too heavy on the commonwealth,"
                                            },
                                            {
                                                "example_id": "e71c320d-94e5-42ee-b056-464855e8a4ee",
                                                "sense_id": "cc2aa6da-6476-3054-befe-236644647a82",
                                                "text": "[…] after the most straitest sect of our religion I lived a Pharisee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ed68213-8bb8-328c-b60a-5b4e2eff432d",
                                        "entry_id": "a6c53e75-8bdc-3fd8-9df7-ddd1373c47e3",
                                        "glosses": [
                                            "Tight; close; tight-fitting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c326b3-645e-4644-8ca3-f0e95136d65c",
                                                "sense_id": "8ed68213-8bb8-328c-b60a-5b4e2eff432d",
                                                "text": "Palamon. […] Stay a little, / Is not this peece too streight? / Arcite. No, no, tis well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0dc8812-ea4c-3153-bc5b-c06e4099276d",
                                        "entry_id": "a6c53e75-8bdc-3fd8-9df7-ddd1373c47e3",
                                        "glosses": [
                                            "Close; intimate; near; familiar."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "337d4bfb-7c67-4c3d-8f93-55b23fe174a6",
                                                "sense_id": "a0dc8812-ea4c-3153-bc5b-c06e4099276d",
                                                "text": "After the noble Prince Leonatus had by his fathers death succeeded in the kingdome of Galatia, he (forgetting all former iniuries) had receiued that naughtie Plexirtus into a streight degree of fauour […]",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aabef73-06d2-3f2b-a910-24021300f3b9",
                                        "entry_id": "a6c53e75-8bdc-3fd8-9df7-ddd1373c47e3",
                                        "glosses": [
                                            "Difficult; distressful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13a4dad3-3c32-40ef-b2e9-06ab0d90356e",
                                                "sense_id": "9aabef73-06d2-3f2b-a910-24021300f3b9",
                                                "text": "18th c., Thomas Secker, Sermons on Several Subjects, 2nd edition, 1771, Volume III, Sermon XI, p. 253,\nBut to make your strait Circumstances yet straiter, for the Sake of idle Gratifications, and distress yourselves in Necessaries, only to indulge in Trifles and Vanities, delicate Food, shewish Dress, ensnaring Diversions, is every Way wrong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6e42fbc-e605-36ac-aa86-59ce48a6b0ec",
                                        "entry_id": "a6c53e75-8bdc-3fd8-9df7-ddd1373c47e3",
                                        "glosses": [
                                            "Parsimonious; stingy; mean."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4cccf6-455c-4eeb-9852-a1d5aefd67ea",
                                                "sense_id": "c6e42fbc-e605-36ac-aa86-59ce48a6b0ec",
                                                "text": "[…] I do not ask you much, / I beg cold comfort; and you are so strait / And so ingrateful, you deny me that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff0af8a-dc84-3e3d-9613-c8699a2c7a0d",
                                        "entry_id": "a6c53e75-8bdc-3fd8-9df7-ddd1373c47e3",
                                        "glosses": [
                                            "Obsolete spelling of straight."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3811f1d-6c23-4ba0-abd9-a67d154670a9",
                                                "sense_id": "cff0af8a-dc84-3e3d-9613-c8699a2c7a0d",
                                                "text": "A strait Line over a Vowel denotes the Omission of the Letter m or n following:\nquā--quam‖nō--non‖[…]\n[…]\nThe strait Line over m in the Middle of a Word denotes the Omission of the Letter n following:\nom̄es--omnes‖om̄ia--omnia"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "strait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b69592-e25a-3ab4-aceb-87db702158be",
                                        "entry_id": "12dac676-1a83-32cd-b8b7-81ed5e285dae",
                                        "glosses": [
                                            "A narrow channel of water connecting two larger bodies of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640f1eac-f1ca-45c1-9f6f-fbd692b25180",
                                                "sense_id": "b3b69592-e25a-3ab4-aceb-87db702158be",
                                                "text": "the Strait of Gibraltar"
                                            },
                                            {
                                                "example_id": "5ca1438e-4a4f-4004-91a0-7799798bb9e8",
                                                "sense_id": "b3b69592-e25a-3ab4-aceb-87db702158be",
                                                "text": "[…] we steered directly through a large Out-let, which they call a Streight, tho’ it be fifteen Miles broad […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4756e8e5-c4b6-3118-8da6-365cf1cfc242",
                                        "entry_id": "12dac676-1a83-32cd-b8b7-81ed5e285dae",
                                        "glosses": [
                                            "A narrow pass, passage or street."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e98d4ca-dde7-4c82-9d3a-5b4f12629968",
                                                "sense_id": "4756e8e5-c4b6-3118-8da6-365cf1cfc242",
                                                "text": "He brought him through a darksom narrow strayt, / To a broad gate all built of beaten gold:"
                                            },
                                            {
                                                "example_id": "c4edbc9a-4cc3-4923-8fca-61cf3b6c30d3",
                                                "sense_id": "4756e8e5-c4b6-3118-8da6-365cf1cfc242",
                                                "text": "For honour travels in a strait so narrow, / Where one but goes abreast:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "117dd9f3-15a5-3a64-aa04-9dbdc4ac2004",
                                        "entry_id": "12dac676-1a83-32cd-b8b7-81ed5e285dae",
                                        "glosses": [
                                            "A neck of land; an isthmus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c649dddb-6604-480e-88fe-82354d76de65",
                                                "sense_id": "117dd9f3-15a5-3a64-aa04-9dbdc4ac2004",
                                                "text": "The bold Sir Bedivere uplifted him, / Sir Bedivere, the last of all his knights, / And bore him to a chapel nigh the field, / A broken chancel with a broken cross, / That stood on a dark strait of barren land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f95cc275-fb33-3f2c-8ee3-551be609a32a",
                                        "entry_id": "12dac676-1a83-32cd-b8b7-81ed5e285dae",
                                        "glosses": [
                                            "A difficult position."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2f6a2a-5150-4343-bfc3-78f52f2e27b5",
                                                "sense_id": "f95cc275-fb33-3f2c-8ee3-551be609a32a",
                                                "text": "to be in dire straits"
                                            },
                                            {
                                                "example_id": "00122372-9e38-4910-9d6b-005991a8bcaa",
                                                "sense_id": "f95cc275-fb33-3f2c-8ee3-551be609a32a",
                                                "text": "1684, Robert South, “A Sermon Preached at Westminster-Abbey” in Twelve Sermons Preached upon Several Occasions, London: Thomas Bennett, 1692, p. 420,\n[…] let no man, who owns the Belief of a Providence, grow desperate or forlorn, under any Calamity or Strait whatsoever […]"
                                            },
                                            {
                                                "example_id": "8ca87580-6389-4821-b92b-b103fbb12fc8",
                                                "sense_id": "f95cc275-fb33-3f2c-8ee3-551be609a32a",
                                                "text": "Plutarch is of opinion that this sleep of Ulysses was feigned; and that he made use of the pretence of natural infirmity to conceal the streights he was in at that time in his thoughts […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "strait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4be21e02-7a72-3e7d-a612-bb94409119d0",
                                        "entry_id": "3f1ffd90-e7f3-3772-84d4-7de4b164f58d",
                                        "glosses": [
                                            "To confine; put to difficulties."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f636d5-bfce-4481-8b21-7ee6ff7a30dc",
                                                "sense_id": "4be21e02-7a72-3e7d-a612-bb94409119d0",
                                                "text": "After Bardus, the Celtes […] were in short tyme, and with small labour broughte vnder the subiection of the Giaunt Albion, the sonne of Neptune, who altering the state of things here in this yland, straited the name of Celtica and the Celtes within the boundes of Gallia […]"
                                            },
                                            {
                                                "example_id": "b6590694-434b-4a3f-8112-b4b2f6dba48b",
                                                "sense_id": "4be21e02-7a72-3e7d-a612-bb94409119d0",
                                                "text": "[…] If your lass / Interpretation should abuse and call this / Your lack of love or bounty, you were straited / For a reply […]"
                                            },
                                            {
                                                "example_id": "77fc4888-d83e-4c3f-a08e-3ca809e32dab",
                                                "sense_id": "4be21e02-7a72-3e7d-a612-bb94409119d0",
                                                "text": "The King, Duke of York, Prince Rupert and Maurice are still at Oxford closely surrounded by the Parliaments Forces, and the other not well resolving what course to take, all their Horse being about Faringdon, in expectation of the Lord Ashley with his Foot to joyn in a Body, if they be not prevented by Colonel Fleetwood and Rainsborough, straiting and allarming Oxford very often […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2033e547-4954-32db-b72c-6f8f19bceb47",
                                        "entry_id": "3f1ffd90-e7f3-3772-84d4-7de4b164f58d",
                                        "glosses": [
                                            "To tighten."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "strait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de04f6e9-0773-3d51-806f-bd5fb3a0dae3",
                                        "entry_id": "9fbbf387-d0e7-3487-a200-b65f8971eeca",
                                        "glosses": [
                                            "Strictly; rigorously."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf802567-0df7-43ae-b48e-6630d6f95dfa",
                                                "sense_id": "de04f6e9-0773-3d51-806f-bd5fb3a0dae3",
                                                "text": "Lords, take your places; and, I pray you all, / Proceed no straiter ’gainst our uncle Gloucester / Than from true evidence of good esteem / He be approved in practise culpable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
