                ],
                "senses": [
                    {
                        "sense_id": "b03eb7b2-5e33-38d5-93a4-17f4c0d840bd",
                        "entry_id": "1069f983-7916-313f-a336-fa357eea7a1c",
                        "glosses": [
                            "Wein aus Trauben, die bei der Ernte und beim Keltern gefroren sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f422859-7b00-4511-bef1-ed1ad70f9d1d",
                                "sense_id": "b03eb7b2-5e33-38d5-93a4-17f4c0d840bd",
                                "text": "„Für die Erzeugung von Eiswein werden Trauben von der Qualitätsstufe der Beerenauslese so lange am Rebstock belassen, bis sie bei Dauerfrost von mindestens minus sieben Grad gefrieren. … Eisweine besitzen eine markante Säure, die sie nahezu unbegrenzt haltbar macht.“"
                            },
                            {
                                "example_id": "058e78ef-d210-4e3d-a5fc-b33217987f22",
                                "sense_id": "b03eb7b2-5e33-38d5-93a4-17f4c0d840bd",
                                "text": "„Der Reiz eines guten Eisweins liegt in der harmonischen Balance von reifer Fruchtsüße und animierend frischer Säure.“"
                            },
                            {
                                "example_id": "73cf9082-14a1-470f-906a-00715a61e5b4",
                                "sense_id": "b03eb7b2-5e33-38d5-93a4-17f4c0d840bd",
                                "text": "„Vorhin hat man zuschauen können, wie die schon fast schwarzgefrorenen Trauben für den Eiswein geerntet worden sind, im letzten Moment, bevor sie abfallen und vollends verfaulen würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
