                                "sense_id": "0b975812-d771-3f15-8dd1-76e6ea599583",
                                "text": "„Fogoschfilet salzen, pfeffern, mit Zitronensaft säuern, in Mehl drücken und rasch in heissem Öl anbraten, abtropfen lassen und beiseite stellen.“"
                            },
                            {
                                "example_id": "7a317eed-e850-429d-bee4-aadc883f14f0",
                                "sense_id": "0b975812-d771-3f15-8dd1-76e6ea599583",
                                "text": "„Fogoschfilet in Scheiben schneiden, salzen und in Semmelbrösel wenden.“"
                            }
                        ],
