                                        "sense_id": "0382b2b5-ae29-3610-98c0-4e745a19f361",
                                        "entry_id": "f5577a95-cb55-329a-bc91-853df8a8315d",
                                        "glosses": [
                                            "An increase, for example in popularity or hierarchy"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
