                        "examples": [
                            {
                                "example_id": "b580f493-51db-4ffa-80a0-02c6e272a43b",
                                "sense_id": "a99e9c73-1115-3ddc-9297-97745a8081ad",
                                "text": "Twee belangrijke liberalisatieprocessen die na de Tweede Wereldoorlog in internationale financiële markten hebben plaatsgevonden, hebben bijgedragen aan de huidige balansstructuur van het Nederlandse bankwezen."
                            },
                            {
                                "example_id": "af6f2f21-33dd-4252-8649-23ce88db4ecf",
                                "sense_id": "a99e9c73-1115-3ddc-9297-97745a8081ad",
                                "text": "De aanhoudende crisis heeft vele bedrijven geconfronteerd met hun financiële structuur. Toch dient die balansstructuur een permanent aandachtspunt te zijn in elke raad van bestuur of elk directiecomité. Want een zwarte zwaan zie je niet aankomen."
                            }
                        ]
