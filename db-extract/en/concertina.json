                        "sense_id": "a493db24-523f-33da-9959-606c16367bf6",
                        "entry_id": "c9726fe8-8869-38ca-befa-1faf3fa61066",
                        "glosses": [
                            "To become compressed into a shape reminiscent of a concertina."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f770d264-af58-4128-a6d1-9657f8ac2108",
                                "sense_id": "a493db24-523f-33da-9959-606c16367bf6",
                                "text": "The car concertinaed into the wall."
                            },
                            {
                                "example_id": "8d65f5dc-0b8c-492e-b919-f8687e368adb",
                                "sense_id": "a493db24-523f-33da-9959-606c16367bf6",
                                "text": "Millions of years ago the mica schists surrounding the old Brandberg West Mine became folded and concertinaed by enormous horizontal pressures."
                            }
                        ]
                    },
                    {
                        "sense_id": "680a47cb-dc1c-3f94-b479-0cb6c680d6ef",
                        "entry_id": "c9726fe8-8869-38ca-befa-1faf3fa61066",
                        "glosses": [
                            "To be drawn closer and farther apart repeatedly, or up and down, as if situated on a working concertina's folds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f77ce8-0f0d-4dc6-a990-f395f3e06736",
                                "sense_id": "680a47cb-dc1c-3f94-b479-0cb6c680d6ef",
                                "text": "This resulted in some fragmentation of the line as the boats in some cases closed to just 50 metres as they concertinaed in and out of sight of each other."
                            }
                        ]
                    }
                ],
