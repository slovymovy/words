            "senses": [
                {
                    "sense_id": "019f60ff-2006-3b0b-ab71-547a459becff",
                    "sense_definition": "met een krakende of onzuivere stem, vaak door verkoudheid of veel schreeuwen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stemgeluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het concert gisteravond was ik de volgende ochtend behoorlijk <w>schor</w>.",
                            "target_lang_translations": {
                                "en": "After the concert last night, I was quite <w>hoarse</w> the next morning."
                            }
                        },
                        {
                            "text": "Zij kreeg een <w>schorre</w> stem van dat harde schreeuwen tijdens de wedstrijd.",
                            "target_lang_translations": {
                                "en": "She got a <w>hoarse</w> voice from all that loud shouting during the match."
                            }
                        }
                    ],
                    "synonyms": [
                        "hees"
                    ],
                    "common_phrases": [
                        "schorre stem",
                        "schor praten"
                    ],
                    "target_lang_definitions": {
                        "en": "having a rough, croaky, or strained voice, often due to a cold or excessive shouting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hoarse",
                                "target_lang_sense_clarification": "rough or harsh sounding voice"
                            },
                            {
                                "target_lang_word": "husky",
                                "target_lang_sense_clarification": "slightly hoarse or dry voice"
                            },
                            {
                                "target_lang_word": "raspy",
                                "target_lang_sense_clarification": "harsh-sounding and unpleasant"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "092e257f-7b5f-39c7-86fa-154b0ff92be0",
                    "sense_definition": "een buitendijks aangeslibd stuk land dat alleen bij extreem hoog water onderloopt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "landschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de wandeling over het <w>schor</w> zagen we veel bijzondere vogels en planten.",
                            "target_lang_translations": {
                                "en": "During the walk across the <w>salt marsh</w>, we saw many special birds and plants."
                            }
                        },
                        {
                            "text": "De schapen grazen op het uitgestrekte <w>schor</w> vlakbij de Zeeuwse kust.",
                            "target_lang_translations": {
                                "en": "The sheep graze on the vast <w>salt marsh</w> near the coast of Zeeland."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwelder",
                        "gors"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in Zeeland; elders vaak kwelder genoemd."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an area of land outside the dikes that has silted up and only floods during extremely high tides"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "salt marsh",
                                "target_lang_sense_clarification": "coastal wetland flooded by salt water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
