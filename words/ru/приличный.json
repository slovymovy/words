                    "sense_id": "f792db36-eac4-3f32-8221-22cda95b5fec",
                    "sense_definition": "Соответствующий принятым в обществе правилам поведения; пристойный, воспитанный.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом ресторане всегда собирается очень <w>приличная</w> публика.",
                            "target_lang_translations": {
                                "en": "A very <w>decent</w> crowd always gathers in this restaurant.",
                                "es": "En este restaurante siempre se reúne un público muy <w>decente</w>.",
                                "fr": "Dans ce restaurant, on trouve toujours une clientèle très <w>décente</w>."
                            }
                        },
                        {
                            "text": "Он <w>приличный</w> человек и никогда не позволит себе грубости.",
                            "target_lang_translations": {
                                "en": "He is a <w>decent</w> man and would never allow himself to be rude.",
                                "es": "Él es un hombre <w>decente</w> y nunca se permitiría ser grosero.",
                                "fr": "C'est un homme <w>convenable</w> qui ne se permettra jamais d'être grossier."
                            }
                        }
                    ],
                    "synonyms": [
                        "пристойный",
                        "порядочный"
                    ],
                    "antonyms": [
                        "неприличный",
                        "постыдный"
                    ],
                    "common_phrases": [
                        "приличный человек",
                        "вести себя прилично",
                        "вполне приличный",
                        "приличное общество"
                    ],
                    "target_lang_definitions": {
