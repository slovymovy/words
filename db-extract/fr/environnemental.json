                                        "glosses": [
                                            "Environmentally friendly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09bad37-1ecc-45c0-a666-17f259b405f7",
                                                "sense_id": "e1dc0c7b-b28f-3587-8b8c-027d85682d8f",
                                                "text": "Because consumers who are buying such productss cannot fully internalize the external utility of their purchase, prices for environmental products and other environmental innovations may be insufficiently high to cover their costs ( Kaas, 1993; Cleff and Rennings, 1999)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "environmental",
