    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f8b054a4-58c8-3018-aa5e-9fd9da5254e1",
                    "sense_definition": "Qui éprouve de la honte, de la confusion ou du remords après une faute ou un échec.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant était très <w>honteux</w> d'avoir menti à ses parents au sujet de ses notes."
                        },
                        {
                            "text": "Il est resté silencieux et tout <w>honteux</w> après avoir avoué sa bêtise devant toute l'assemblée réunie hier matin."
                        }
                    ],
                    "common_phrases": [
                        "pauvre honteux",
                        "rouge et honteux"
                    ]
                },
                {
                    "sense_id": "3ac50b57-5a33-3803-a796-bd3a2ce1c6e5",
                    "sense_definition": "Qui cause ou mérite de la honte, qui est scandaleux ou déshonorant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une attitude particulièrement <w>honteuse</w> envers des personnes en grande difficulté qui avaient besoin de notre aide."
                        },
                        {
                            "text": "Il a profité de la détresse de ses voisins pour réaliser un bénéfice financier tout à fait <w>honteux</w>."
                        }
                    ],
                    "synonyms": [
                        "scandaleux"
                    ],
                    "common_phrases": [
                        "comportement honteux",
                        "conduite honteuse",
                        "marché honteux"
                    ]
                },
                {
                    "sense_id": "08bf39f0-5bb6-3c53-844c-459af9db5a32",
                    "sense_definition": "Mauvais, vilain ou impoli dans son comportement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette façon désagréable d'interpeller les passants dans la rue est véritablement <w>honteuse</w>."
                        },
                        {
                            "text": "Le commerçant s'est mis en colère et a qualifié son interlocuteur d'individu <w>honteux</w> devant tout le monde."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Belgique"
                        }
                    ]
                },
                {
                    "sense_id": "38888c6f-7f6e-3dcb-b5a3-ca10c106e1a4",
                    "sense_definition": "Qui a rapport aux parties génitales, dans l'ancienne terminologie anatomique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a pris soin de ne pas léser le nerf <w>honteux</w> pendant l'opération."
                        },
                        {
                            "text": "L'étudiant en médecine consultait un manuel ancien qui décrivait la disposition de l'artère <w>honteuse</w> interne."
                        }
