                                        ]
                                    },
                                    {
                                        "sense_id": "15fcc9c0-e580-31d4-81c6-5b093ce9fffe",
                                        "entry_id": "4b9f81bc-d544-3fa1-8568-3db7cac84afc",
                                        "glosses": [
                                            "One who slaughters and (especially) renders worn-out livestock (especially horses) and sells their flesh, bones and hides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d96a2075-d81a-458b-942f-b3efcb1f6df2",
                                                "sense_id": "15fcc9c0-e580-31d4-81c6-5b093ce9fffe",
                                                "text": "Near-synonyms: slaughterer, slaughterman"
                                            },
                                            {
                                                "example_id": "d9d7f30d-4009-40c0-afaf-c70ffc22a480",
                                                "sense_id": "15fcc9c0-e580-31d4-81c6-5b093ce9fffe",
                                                "text": "After a few years even the whip loses its virtue, and the pony goes to the knacker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e47cb343-c5bd-3ac4-b3b4-7439b0644da5",
                                        "entry_id": "4b9f81bc-d544-3fa1-8568-3db7cac84afc",
                                        "glosses": [
                                            "One who dismantles old ships, houses, etc. and sells their components."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9563b5eb-48a1-4f1d-83d0-24d252882211",
                                                "sense_id": "e47cb343-c5bd-3ac4-b3b4-7439b0644da5",
                                                "text": "Near-synonyms: salvager, salvor; scrapper, wrecker, breaker; shipbreaker, car breaker"
                                            }
