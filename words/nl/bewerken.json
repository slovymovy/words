            "senses": [
                {
                    "sense_id": "3800965a-99e6-39a4-9c90-6d78ce8c40f6",
                    "sense_definition": "een tekst, bestand of map wijzigen om deze aan te passen of te verbeteren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aanpassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt dit document eenvoudig <w>bewerken</w> door op de knop te klikken.",
                            "target_lang_translations": {
                                "en": "You can easily <w>edit</w> this document by clicking the button."
                            }
                        },
                        {
                            "text": "Klik rechts op het bestand om een <w>bestand bewerken</w> mogelijk te maken.",
                            "target_lang_translations": {
                                "en": "Right-click the file to enable <w>editing a file</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "editeren",
                        "wijzigen",
                        "aanpassen"
                    ],
                    "common_phrases": [
                        "bestand bewerken",
                        "tekst bewerken",
                        "foto bewerken"
                    ],
                    "target_lang_definitions": {
                        "en": "to change a text, file, or folder in order to adjust or improve it"
                    },
                    "translations": {
                        "en": [
