                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Homeowners have to pay their council <w>rates</w> annually.",
                            "target_lang_translations": {
                                "ru": "Домовладельцы должны платить муниципальные <w>налоги</w> ежегодно.",
                                "tr": "Ev sahipleri belediye <w>vergilerini</w> her yıl ödemek zorundadır.",
                                "fr": "Les propriétaires doivent payer leurs <w>taxes locales</w> chaque année.",
                                "zh": "房主每年都必须缴纳市政<w>地方税</w>。",
                                "nl": "Huiseigenaren moeten jaarlijks hun <w>gemeentebelastingen</w> betalen.",
                                "pl": "Właściciele domów muszą corocznie płacić lokalne <w>podatki od nieruchomości</w>.",
                                "de": "Hauseigentümer müssen ihre <w>Gemeindeabgaben</w> jährlich bezahlen.",
