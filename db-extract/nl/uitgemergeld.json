        "nl-extract.jsonl": [
            {
                "entry_id": "a42f9a2c-a9a0-3091-b097-502459d3db2f",
                "word": "uitgemergeld",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28d5eff3-2ca8-32eb-9459-a17b10b9687e",
                        "entry_id": "a42f9a2c-a9a0-3091-b097-502459d3db2f",
                        "glosses": [
                            "door ziekte, gebrek of uitputting sterk vermagerd en verzwakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cbc066f-c1da-43bf-8f6f-3876ce78d00b",
                                "sense_id": "28d5eff3-2ca8-32eb-9459-a17b10b9687e",
                                "text": "De natuurfotograaf was samen met filmmakers van de natuurorganisatie Sea Legacy naar het Canadese eiland getrokken, waar ze de uitgemergelde ijsbeer tegen het lijf liepen."
                            },
                            {
                                "example_id": "449bf025-13be-4a7e-b651-604de070d676",
                                "sense_id": "28d5eff3-2ca8-32eb-9459-a17b10b9687e",
                                "text": "Uitgemergeld was hij toen in het kamp bij Prijedor een foto van hem werd genomen. Nu staat Fikret Alic gezond en wel voor het tribunaal. ,,Vroeg of laat zul je jezelf moeten verantwoorden,’’ zegt hij. ,,Dat is nu gebeurd."
                            },
                            {
                                "example_id": "2dc14aa9-71a5-415d-9820-45f7a2fb87d5",
                                "sense_id": "28d5eff3-2ca8-32eb-9459-a17b10b9687e",
                                "text": "Zij grossierde niet bepaald in vormen. Met haar benige, tanige en uitgemergelde gestalte was zij meer iemand van duidelijke en consequente lijnen. Maar zij was in haar etherische hardheid onmiskenbaar fascinerend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9c9d449-f26c-415d-961c-c1c460178d0c",
                        "source_entry_id": "a42f9a2c-a9a0-3091-b097-502459d3db2f",
                        "source_sense_id": "28d5eff3-2ca8-32eb-9459-a17b10b9687e",
                        "target_lang_word": "starved",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starved",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7af6308-3bd6-388a-a715-bd91c561f657",
                                        "entry_id": "0b69fc8a-05ad-3ff0-90d0-124482a149ac",
                                        "glosses": [
                                            "Approaching starvation, emaciated and malnourished."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38b9e6ee-9c65-3fa3-b0a0-c6e38a2a012f",
                                        "entry_id": "0b69fc8a-05ad-3ff0-90d0-124482a149ac",
                                        "glosses": [
                                            "Deprived of nourishment or of something vital."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee3d1f91-10d3-4f0b-9ebd-e279dcbf517f",
                                                "sense_id": "38b9e6ee-9c65-3fa3-b0a0-c6e38a2a012f",
                                                "text": "Alas poore hart, that kiſſe is comfortleſſe, / As frozen vvater to a ſtarued ſnake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51079792-f43f-3397-aba5-2f9a273b7289",
                                        "entry_id": "0b69fc8a-05ad-3ff0-90d0-124482a149ac",
                                        "glosses": [
                                            "Extremely hungry."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "emphatic",
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74acb917-9daa-4ecf-979b-7e27f60984d2",
                                                "sense_id": "51079792-f43f-3397-aba5-2f9a273b7289",
                                                "text": "I’m starved! I haven’t eaten since breakfast."
                                            },
                                            {
                                                "example_id": "d30825c6-30c8-4906-8a0d-b43410a239f1",
                                                "sense_id": "51079792-f43f-3397-aba5-2f9a273b7289",
                                                "text": "She said: \"I'm starved. I could eat a horse.\" I told her she was lying, because I had once eaten horse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "starved",
                                "target_lang_code": "en",
                                "target_senses": [
