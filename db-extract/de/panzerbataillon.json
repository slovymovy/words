                "senses": [
                    {
                        "sense_id": "45310c6e-5089-3996-9894-2f21f509c5f8",
                        "entry_id": "2985daa3-8b28-302b-ba5d-557ead465304",
                        "glosses": [
                            "Bataillon der Panzertruppe"
                        ],
                        "tags": [
                            "Heer"
                        ],
                        "examples": [
                            {
                                "example_id": "79be846f-7f72-453c-80b4-c4b567537111",
                                "sense_id": "45310c6e-5089-3996-9894-2f21f509c5f8",
                                "text": "„So sinkt beispielsweise die Zahl der Panzerbataillone von 13 auf sechs.“"
                            },
                            {
                                "example_id": "53eddeb8-b1ab-4ef0-a59b-34580d107587",
                                "sense_id": "45310c6e-5089-3996-9894-2f21f509c5f8",
                                "text": "„Ein Panzerbataillon mußte umdirigiert, die Kompanien auf das neue Ziel angesetzt werden.“"
                            },
                            {
                                "example_id": "fe962d9f-bf89-43c4-ae67-ca4813d12c77",
                                "sense_id": "45310c6e-5089-3996-9894-2f21f509c5f8",
                                "text": "„Seine langjährige Erfahrung wird der einstige Kommandeur eines Panzerbataillons sicherlich gut gebrauchen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
