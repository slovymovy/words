                        "examples": [
                            {
                                "example_id": "ce05a06a-0c5b-4bc3-aae7-5666f5da3b41",
                                "sense_id": "1a85ec7a-9123-38bd-a48f-17fe9095f162",
                                "text": "De eindrekening zal veel hoger liggen, aldus de spoorbaas. Bij de berekening is er namelijk nog geen rekening gehouden met abonnementshouders en de extra bussen die ingezet werden."
                            },
                            {
                                "example_id": "5bfe10ea-161c-4d2a-ba93-0baab966716b",
                                "sense_id": "1a85ec7a-9123-38bd-a48f-17fe9095f162",
                                "text": "Het is niet de eerste keer dat Dijsselbloem slecht op de hoogte blijkt te zijn van NS-perikelen. Hij ging recent nog de mist in met de bonus van voormalig NS-baas Timo Huges, die moest vertrekken wegens diens aandeel in de spoorfraude in Limburg. Dijsselbloem zei dat de gevallen spoorbaas absoluut geen bonus zou krijgen en ontslagen was. Beide bleken niet waar."
                            }
                        ]
