                "senses": [
                    {
                        "sense_id": "94deebb5-f017-39c1-bebe-8abed84ed5e3",
                        "entry_id": "b624f3a7-9794-3f9c-9a36-631b67771a38",
                        "glosses": [
                            "Action d'autopublier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b504d98-cc61-4903-8abf-9ec130405862",
                                "sense_id": "94deebb5-f017-39c1-bebe-8abed84ed5e3",
                                "text": "Devant le refus des maisons d’édition traditionnelles, des auteurs se tournent vers l’autopublication ou la publication à compte d’auteur."
                            },
                            {
                                "example_id": "b2440583-7d09-4e4a-9d5e-c097f9f5b590",
                                "sense_id": "94deebb5-f017-39c1-bebe-8abed84ed5e3",
                                "text": "Grâce à Internet, l’autopublication se développe à destination des auteurs qui ne trouvent pas d’éditeurs."
                            },
                            {
                                "example_id": "e3fb522a-2922-48ae-997d-e41c7c8df0a0",
                                "sense_id": "94deebb5-f017-39c1-bebe-8abed84ed5e3",
                                "text": "Par amour des livres, et pour laisser par écrit mes histoires à mes amis et mes enfants, je me suis lancé dans l’aventure de l’autopublication."
                            }
                        ]
                    }
                ],
