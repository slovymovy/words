                "senses": [
                    {
                        "sense_id": "9a8531e7-d5a7-3843-a775-761b63d26468",
                        "entry_id": "d04a12ed-4bfc-30c2-a174-edfcd1ac514a",
                        "glosses": [
                            "Strömungsmaschine; angetriebene Maschine, die diese Antriebsenergie in mechanische Arbeit umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7fecd40-e0c6-4971-9db5-cbd8f971019f",
                                "sense_id": "9a8531e7-d5a7-3843-a775-761b63d26468",
                                "text": "„Bei Strömungsarbeitsmaschinen trifft die Antriebsenergie durch ein Drehmoment von der Kupplung über Welle und Rad auf die Schaufeln.“"
                            },
                            {
                                "example_id": "8cc884e9-89c5-437c-864a-9c5a2d4fcc1a",
                                "sense_id": "9a8531e7-d5a7-3843-a775-761b63d26468",
                                "text": "„Das einfache Umrüsten der Arbeitsmaschinen ermöglicht in kurzer Zeit eine Vielzahl an Versuchen, um das Betriebsverhalten von Verdränger- und Strömungsarbeitsmaschinen kennenzulernen.“"
                            },
                            {
                                "example_id": "2e7813b6-1742-4730-adb2-b26076d90179",
                                "sense_id": "9a8531e7-d5a7-3843-a775-761b63d26468",
                                "text": "„Bei welchem Dreieck (A, B) handelt es sich eine Strömungsarbeitsmaschine und bei welchem um eine Strömungskraftmaschine?“"
                            },
                            {
                                "example_id": "3e282e60-d960-45d0-9209-fabb82315a2a",
                                "sense_id": "9a8531e7-d5a7-3843-a775-761b63d26468",
                                "text": "„Die Kupplungsleistung einer Strömungsarbeitsmaschine wird durch Auswertung einer Drehmomentmessung M und einer Drehzahlmessung n ermittelt.“"
                            },
                            {
                                "example_id": "f164aaea-d49b-484e-952a-5077c9fd7c4f",
                                "sense_id": "9a8531e7-d5a7-3843-a775-761b63d26468",
                                "text": "„Strömungsarbeitsmaschinen: Pumpen und Gebläse dienen zur Förderung flüssiger und gasförmiger Medien wie zum Beispiel Wasser und Luft“"
                            },
                            {
                                "example_id": "2f72d0f7-c629-4a47-b682-2c5a8605fb19",
                                "sense_id": "9a8531e7-d5a7-3843-a775-761b63d26468",
                                "text": "„Kleine Ventilatoren werden typischerweise als Lüfter bezeichnet und gehören zu den Strömungsarbeitsmaschinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
