                ],
                "senses": [
                    {
                        "sense_id": "4b936b53-c63e-32e5-a2fa-2c5e20138009",
                        "entry_id": "ac7f1e33-404f-3d43-8bab-d22a0fba39f5",
                        "glosses": [
                            "zoals past bij een herder en zijn kunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a57e4d-228c-4599-9cc2-4de924530b8f",
                                "sense_id": "4b936b53-c63e-32e5-a2fa-2c5e20138009",
                                "text": "En in haar verbeelding wacht ze met trillende handen tot Prins Tamino zal naderen, bepruikt, geschminkt en zingend over hun eeuwige vereniging, terwijl een toneelknecht met twee handen het touw vasthoudt, klaar om het decor van de tempel voor dat van het herderlijke berglandschap te wisselen."
                            }
                        ]
                    },
                    {
                        "sense_id": "84fde8ec-572e-3485-a780-de943bf264cf",
                        "entry_id": "ac7f1e33-404f-3d43-8bab-d22a0fba39f5",
                        "glosses": [
                            "zoals past bij een heerser die misschien het beste voorheeft met zijn onderdanen maar zich niet laat sturen door die onderdanen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac975f4-3f3d-4cd5-8f1e-ccf02bd8a771",
                                "sense_id": "84fde8ec-572e-3485-a780-de943bf264cf",
                                "text": "'Zes eeuwen lang hebben de kerken van Oost en West in onmin geleefd,' zei Bostock gewichtig. 'In Constantinopel wordt Alexius beschouwd als de gelijke van de paus, hoewel hij zich niet aan de geboden van Rome stoort. De Griekse priesters mogen nota bene trouwen, stel je voor! Bidden tot Jezus of Maria doen ze niet en voor de Heilige Drieëenheid hebben ze evenmin voldoende eerbied. De paus probeert hen met herderlijke brieven op het rechte spoor te brengen.'"
                            },
                            {
                                "example_id": "3599ca39-3639-4756-a077-9144168b8b6d",
                                "sense_id": "84fde8ec-572e-3485-a780-de943bf264cf",
                                "text": "Volgens Vision-2030 gaat er inderdaad heel veel veranderen. Maar er zijn grenzen: aan de grondslagen van de oerconservatieve samenleving zal volgens de blauwdruk niet worden gemorreld. Dit laatste is een belangrijk signaal voor de hele umma, de wereldgemeenschap van moslims, inclusief de miljoen soennieten in Nederland. De islam kent geen centraal gezag, maar Saoedi-Arabië is wel het gidsland bij uitstek. De Vision-2030 zou je tussen de regels door dan ook kunnen lezen als een streng herderlijk schrijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "858787f1-0fac-4b3a-93d9-c147dcdc2f91",
                        "source_entry_id": "ac7f1e33-404f-3d43-8bab-d22a0fba39f5",
                        "source_sense_id": "4b936b53-c63e-32e5-a2fa-2c5e20138009",
                        "source_sense_description": "zoals past bij een herder en zijn kunde",
                        "target_lang_word": "pastoral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pastoral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ccc85ee-23ee-334b-822a-fcbd924b97d7",
                                        "entry_id": "61f911b6-c24a-3153-9ea0-3092aa79f444",
                                        "glosses": [
                                            "Of or pertaining to shepherds or herders of other livestock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40b8138-a178-4874-be1d-68c5b6ba8637",
                                                "sense_id": "6ccc85ee-23ee-334b-822a-fcbd924b97d7",
                                                "text": "Like the Mesolithic age of 10,000-8000 B.C., the period 6000-4000 B.C. seems to be one of the fall of fortresses and the rise of pastoral nomadism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea3f38e-59ea-3edf-a1a0-20f4cad9cff1",
                                        "entry_id": "61f911b6-c24a-3153-9ea0-3092aa79f444",
                                        "glosses": [
                                            "Relating to rural life and scenes, in particular of poetry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a75175-19a4-43c9-934c-9db99bf3ef56",
                                                "sense_id": "5ea3f38e-59ea-3edf-a1a0-20f4cad9cff1",
                                                "text": "We were living a pastoral life."
                                            },
                                            {
                                                "example_id": "8c627ff4-ff3f-4132-8ebc-f7efe3ca2ac0",
                                                "sense_id": "5ea3f38e-59ea-3edf-a1a0-20f4cad9cff1",
                                                "text": "[…] these pastoral farms, / Green to the very door; and wreaths of smoke / Sent up, in silence, from among the trees!"
                                            },
                                            {
                                                "example_id": "7658734a-fca4-495b-b80d-653f271f9bd6",
                                                "sense_id": "5ea3f38e-59ea-3edf-a1a0-20f4cad9cff1",
                                                "text": "There was a tone, too, of pastoral poetry shed over the new scenes to which they were just introduced, that had a greater effect from the contrast to those, artificial and crowded, which they had just left."
                                            },
                                            {
                                                "example_id": "740c2027-37c5-4c8f-ac0d-a4d2a64f3c2b",
                                                "sense_id": "5ea3f38e-59ea-3edf-a1a0-20f4cad9cff1",
                                                "text": "He wanders west as far as Memphis, a solitary migrant upon that flat and pastoral landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c365b1-cfa2-389f-bfd1-a273787b1c52",
                                        "entry_id": "61f911b6-c24a-3153-9ea0-3092aa79f444",
                                        "glosses": [
                                            "Relating to the care of souls, to the pastor of a church or to any local religious leader charged with the service of individual parishioners, i.e. a priest or rabbi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a730e161-7e98-430d-bfbd-f12e9f4a95a6",
                                                "sense_id": "d3c365b1-cfa2-389f-bfd1-a273787b1c52",
                                                "text": "pastoral duties"
                                            },
                                            {
                                                "example_id": "bbbd2914-4c51-4ae1-ae39-cb4662fb64bb",
                                                "sense_id": "d3c365b1-cfa2-389f-bfd1-a273787b1c52",
                                                "text": "a pastoral letter"
                                            },
                                            {
                                                "example_id": "8903d992-635d-4661-a6b6-a8530f6916f0",
                                                "sense_id": "d3c365b1-cfa2-389f-bfd1-a273787b1c52",
                                                "text": "“In terms of pastoral consequences,” Cardinal Víctor Manuel Fernández, who leads the Vatican’s office on doctrine, said in a news conference Monday, “the principle of welcoming all is clear in the words of Pope Francis.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pastoral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "034958b1-373c-3ffd-8392-b27a55091feb",
                                        "entry_id": "5506a3a3-bcf7-3aaa-b754-09632c6cf937",
                                        "glosses": [
                                            "A poem describing the life and manners of shepherds; a poem in which the speakers assume the character of shepherds; an idyll; a bucolic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4e7f09a-09a0-460e-83e1-cc4b61914324",
                                                "sense_id": "034958b1-373c-3ffd-8392-b27a55091feb",
                                                "text": "Ethel was silent from surprise: she had prepared herself for anger—even sorrow; but ridicule left her without an answer. What could she say to a hearer, who only smiled, and to whom emotion was only a scene in a pastoral?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8cd2451-8060-365a-8e2f-74871a41aca8",
                                        "entry_id": "5506a3a3-bcf7-3aaa-b754-09632c6cf937",
                                        "glosses": [
                                            "A cantata relating to rural life; a composition for instruments characterized by simplicity and sweetness; a lyrical composition the subject of which is taken from rural life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "041670ea-cbd9-3d07-8227-ccbed50dcdb0",
                                        "entry_id": "5506a3a3-bcf7-3aaa-b754-09632c6cf937",
                                        "glosses": [
                                            "A letter of a pastor to his charge; specifically, a letter addressed by a bishop to his diocese."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b00736be-ba61-3186-a9c3-e9161bd20b13",
                                        "entry_id": "5506a3a3-bcf7-3aaa-b754-09632c6cf937",
                                        "glosses": [
                                            "A letter of the House of Bishops, to be read in each parish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
