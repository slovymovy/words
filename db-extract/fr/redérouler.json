                        "glosses": [
                            "Dérouler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc088c6-b89a-4451-b2c1-503272b44397",
                                "sense_id": "521deaa2-18f5-372c-a081-4bd311546371",
                                "text": "A la faveur d’un court silence (car pendant que cette espèce de film se redéroule en elle — d’autres et quelconques paroles étaient sur leurs lèvres), il s’est senti tout à coup reporté en pensée — qui sait pourquoi ? — dans ce village d’Ukraine dont il vient de se ressouvenir, et où il a passé quelques mois il y a plus de douze ans."
                            },
                            {
                                "example_id": "f5cfbcdb-ce9a-4382-8803-6dd588e62193",
                                "sense_id": "521deaa2-18f5-372c-a081-4bd311546371",
                                "text": "Elle permettra de redérouler le processus, et d'envoyer un nouveau fichier DOC ou PDF avec la caractères à la bonne taille.(site www.lulu.com)"
                            }
                        ]
                    }
