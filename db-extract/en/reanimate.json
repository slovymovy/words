                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dda17849-2f63-397a-9ab5-9cbd93d54d3d",
                                        "entry_id": "aac1b9fc-7e70-332f-beec-c2ab81f97693",
                                        "glosses": [
                                            "het kunstmatig overnemen van de ademhaling en de bloedsomloop, indien er sprake is van een circulatiestilstand"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ae0d43c-9fe3-4163-9a2c-5cba5dde564a",
                                                "sense_id": "dda17849-2f63-397a-9ab5-9cbd93d54d3d",
                                                "text": "Iemand die niet gereanimeerd wordt, sterft gewoonlijk maar een aanzienlijk deel van de mensen die met succes wordt gereanimeerd, loopt aanmerkelijke neurologische schade op"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e8326d7-4bc3-35b3-92cd-76830d21bf1c",
                                        "entry_id": "aac1b9fc-7e70-332f-beec-c2ab81f97693",
                                        "glosses": [
                                            "wat in een slechte conditie is weer beter te maken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1bd6221-d00a-4e0d-9f87-2efc4ab6276e",
                                                "sense_id": "8e8326d7-4bc3-35b3-92cd-76830d21bf1c",
                                                "text": "Met een dubbele wissel trachtte trainer Dick Lukkien zijn zieltogende ploeg na de pauze te reanimeren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61d04d84-0dff-48f6-8900-3265ffbb8beb",
                        "source_entry_id": "507b0568-d582-3002-877a-7362d1f2fb81",
                        "source_sense_description": "to animate anew",
                        "target_lang_word": "réanimer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réanimer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dda6fea-dc24-312e-80ac-a75cdabe1ea2",
                                        "entry_id": "96d3cd5f-7936-3e7c-8b55-67250cb9c22f",
                                        "glosses": [
                                            "Rétablir les fonctions vitales chez un blessé humain ou animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "161ef473-b666-4af0-b82b-9200e64fa51c",
                                                "sense_id": "0dda6fea-dc24-312e-80ac-a75cdabe1ea2",
                                                "text": "Il est nécessaire, pour le réanimer rapidement, de le placer la gueule ouverte sous un courant d’eau de mer abondant […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1170e34b-54a3-3b65-91df-291efb53a994",
                                        "entry_id": "96d3cd5f-7936-3e7c-8b55-67250cb9c22f",
                                        "glosses": [
                                            "Ramener à la vie, à une activité normale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d14c8ee-5488-4274-b047-1578bd5e5255",
                                                "sense_id": "1170e34b-54a3-3b65-91df-291efb53a994",
                                                "text": "Toutefois, il s’agit, d’une manière générale, de réanimer ces régions en y implantant des industries nouvelles."
                                            },
                                            {
                                                "example_id": "e84968d5-5d16-46ed-9fba-102298754587",
                                                "sense_id": "1170e34b-54a3-3b65-91df-291efb53a994",
                                                "text": "Désormais, la vaccination massive représente le seul espoir de réanimer la société."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
