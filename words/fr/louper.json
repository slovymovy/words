                            },
                            {
                                "target_lang_word": "perderse",
                                "target_lang_sense_clarification": "perderse una película o evento"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错过",
                                "target_lang_sense_clarification": "错过火车或机会"
                            },
                            {
                                "target_lang_word": "赶不上",
                                "target_lang_sense_clarification": "没能赶上交通工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2d65077-9e01-353d-88e7-85dad2a914dd",
                    "sense_definition": "Échouer dans une entreprise, ne pas réussir un examen ou gâcher un travail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "echouer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'avait pas assez révisé et il a fini par <w>louper</w> son permis de conduire.",
                            "target_lang_translations": {
                                "en": "He hadn't studied enough and ended up <w>failing</w> his driving test.",
                                "ru": "Он недостаточно готовился и в итоге <w>провалил</w> экзамен на водительские права.",
                                "de": "Er hatte zu wenig gelernt und ist schließlich bei der Fahrprüfung <w>durchgefallen</w>.",
                                "es": "No había estudiado lo suficiente y acabó <w>suspendiendo</w> el examen de conducir.",
                                "zh": "他复习得不够，结果把驾照考试<w>考砸</w>了。"
                            }
                        },
                        {
                            "text": "J'ai complètement <w>loupé</w> la recette de ce gâteau en oubliant la levure.",
                            "target_lang_translations": {
                                "en": "I completely <w>botched</w> the recipe for this cake by forgetting the yeast.",
                                "ru": "Я полностью <w>испортил</w> рецепт этого торта, забыв о дрожжах.",
                                "de": "Ich habe das Rezept für diesen Kuchen komplett <w>verpatzt</w>, weil ich die Hefe vergessen habe.",
                                "es": "<w>Estropeé</w> por completo la receta de este pastel al olvidar la levadura.",
                                "zh": "我忘了放酵母，把这款蛋糕的做法<w>搞砸</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rater"
                    ],
                    "common_phrases": [
                        "louper un examen",
                        "louper son coup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To fail at an undertaking, not pass an exam, or ruin a piece of work.",
                        "ru": "Потерпеть неудачу в деле, не сдать экзамен или испортить работу.",
                        "de": "Bei einem Vorhaben scheitern, eine Prüfung nicht bestehen oder eine Arbeit verderben.",
                        "es": "Fracasar en un proyecto, no aprobar un examen o echar a perder un trabajo.",
                        "zh": "做事没有成功，考试没有通过，或把工作弄糟。"
                    },
