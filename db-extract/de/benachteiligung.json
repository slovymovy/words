                "senses": [
                    {
                        "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                        "entry_id": "db62d5a1-57ec-3b32-9138-6a97a5aab258",
                        "glosses": [
                            "schlechtere Behandlung einer Person, Personengruppe oder Organisation im Vergleich zu anderen Personen oder Organisationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e74c60-f10d-4b40-866b-93324ef4138c",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "Die Benachteiligung von Ausländern auf dem deutschen Wohnungsmarkt ist ein Fakt."
                            },
                            {
                                "example_id": "b6c4a5fa-ac16-439a-bdec-006e2ef2ebaf",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Mit Blick auf die USA räumte Blinken systematischen Rassimus und Benachteiligung der Schwarzen ein.“"
                            },
                            {
                                "example_id": "d0ab799c-70ff-4554-9163-9eab9737f946",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Die Ministerpräsidentin von Mecklenburg-Vorpommern, Manuela Schwesig, hat vor einer Benachteiligung von Kindern aus armen Familien beim digitalen Lernen während der Corona-Krise gewarnt.“"
                            },
                            {
                                "example_id": "d36bb564-d585-41d9-a595-03f4c391544e",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Die steuerliche Benachteiligung von Ehepaaren ist laut Bundesgericht verfassungswidrig.“"
                            },
                            {
                                "example_id": "9174a355-7772-44d1-8163-b253503bdaaa",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Betrachten wir die kontinuierliche Benachteiligung der Frauen dieser Welt, so lässt sich ein Muster struktureller Ungleichheit erkennen.“"
                            },
                            {
                                "example_id": "d8cd6e08-7c15-49fa-9b5d-2cbb0c5b8c04",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Das Gefühl der Benachteiligung vieler Menschen im Osten Deutschlands hängt eng mit den Erfahrungen vor und v. a. nach der Wende zusammen.“"
                            },
                            {
                                "example_id": "689ed13f-478b-497b-961d-5abc83742ae0",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Frauen scheuen den Wettbewerb, Männer lieben ihn - das gilt auch und vor allem im Berufsumfeld. Studien legen nahe, dass dieser Unterschied wesentlich für die häufige Benachteiligung des weiblichen Geschlechts bei Gehalt und Führungspositionen verantwortlich ist.“"
                            },
                            {
                                "example_id": "84ccc672-e19a-41a5-9597-660952b91980",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Wie stark werden Menschen benachteiligt, die anders aussehen als der Durchschnitt? Hinter mancher Benachteiligung steht oft eine unbewusste Haltung, Weiß-Sein ist normal und alles andere nicht.“"
                            },
                            {
                                "example_id": "18ceaa71-b581-4c29-ad48-521e1f840cdc",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "[Ausbleibende Lieferungen des Coronaimpfstoffs von AstraZeneca an die EU:] „Im Kern geht es um zwei Streitpunkte: vereinbarte Liefermengen und eine mögliche Benachteiligung gegenüber dem Vereinigten Königreich.“"
                            },
                            {
                                "example_id": "2de98a12-0b82-4ea3-a2a2-faf5889e7a89",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "[Coronaimpfstoff:] „[…] der Amnesty-Bericht [prangert] eine Benachteiligung ärmerer Länder bei der Verteilung vom Impfstoff an.“"
                            },
                            {
                                "example_id": "d7014b4e-28e7-42d2-b645-cda9e0fd1c0f",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "[Schlagzeile:] „BDI warnt vor Benachteiligung deutscher Unternehmen“"
                            },
                            {
                                "example_id": "a76ad549-0247-4120-abb9-e4460f16d3d8",
                                "sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                                "text": "„Der Verband der Fleischwirtschaft kritisiert das geplante Verbot von Werkverträgen. Er sieht darin eine willkürliche Benachteiligung der Branche, weil auch in anderen Bereichen mit Werkverträgen gearbeitet wird, hieß es vom Verband.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52d1bb71-51ca-46ac-97e5-f5b7b13a6b02",
                        "source_entry_id": "db62d5a1-57ec-3b32-9138-6a97a5aab258",
                        "source_sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                        "source_sense_description": "schlechtere Behandlung einer Person, Personengruppe oder Organisation im Vergleich zu anderen Personen oder Organisationen",
                        "target_lang_word": "disadvantage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A weakness or undesirable characteristic; con; drawback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171e49af-66f9-4007-aeb8-db815217f4d8",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "The disadvantage to owning a food processor is that you have to store it somewhere."
                                            },
                                            {
                                                "example_id": "eebef41c-d113-4c2d-b2e5-09afb7799834",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "One of the disadvantages of increasing intermediate stops is that, as we have pointed out already, certain prestige trains have to suffer, notably the \"Cornish Riviera Express\", slowed 15min to Plymouth by stops at Taunton and Exeter; the \"Torbay Express\", decelerated 18min by stops at Reading, Westbury, Taunton and Newton Abbot; and the \"Bristolian\", which adds 14min in order to allow for a Bath stop and an increased load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A setback or handicap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80eaba6-79c3-48bd-af4f-0628699f5abd",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "My height is a disadvantage for reaching high shelves."
                                            },
                                            {
                                                "example_id": "255f5862-20f3-48ab-b649-4c60190babe6",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "I was brought hither under the disadvantage of being unknown, even by sight, to any of you."
                                            },
                                            {
                                                "example_id": "4791ad39-9313-4b2a-9134-5ec9f7196d70",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "1859-1890, John G. Palfrey, History of New England to the Revolutionary War\nAbandoned by their great patron, the faction henceforward acted at disadvantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "Loss; detriment; hindrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fabbf53-3c78-404a-abcd-399d5e41e0cd",
                                                "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                                "text": "They would throw a construction on his conduct, to his disadvantage before the public."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                        "entry_id": "c2d49292-1d65-3a95-ab29-e8252a746359",
                                        "glosses": [
                                            "To place at a disadvantage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338fa432-fad7-438e-aafa-40f7007c4420",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "They fear it might disadvantage honest participants to allow automated entries."
                                            },
                                            {
                                                "example_id": "d5053aeb-1a50-4186-8e81-e831caa3049b",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "For London to have its own exclusive immigration policy would exacerbate the sense that immigration benefits only certain groups and disadvantages the rest. It would entrench the gap between London and the rest of the nation. And it would widen the breach between the public and the elite that has helped fuel anti-immigrant hostility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a5cdc7-9083-4406-b704-234d678d0cc7",
                        "source_entry_id": "db62d5a1-57ec-3b32-9138-6a97a5aab258",
                        "source_sense_id": "a8cede8b-1aa1-3cbf-abbf-2ec4a58005d7",
                        "source_sense_description": "schlechtere Behandlung einer Person, Personengruppe oder Organisation im Vergleich zu anderen Personen oder Organisationen",
                        "target_lang_word": "discrimination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discrimination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Distinction précise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e361716-767e-420f-8f60-9043f4a5edb3",
                                                "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                                "text": "La substitution du Saarmark au Reichsmark était une opération délicate, car il fallait opérer une discrimination entre les capitaux sarrois et les capitaux allemands réfugiés en Sarre en 1945-1946 ; […]."
                                            },
                                            {
                                                "example_id": "1f214d9c-e7e5-4d5d-adec-84f998feefbe",
                                                "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                                "text": "Faire la discrimination de telles ou telles choses mêlées."
                                            },
                                            {
                                                "example_id": "111b3c7f-1492-4eb3-9e2b-3d40b60beec6",
                                                "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                                                "text": "Il y a là une discrimination difficile à opérer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c911bc-92b3-30c1-986d-680ba4ec100d",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué.",
                                            "Traitement défavorable de certains groupes humains via la réduction arbitraire de leurs droits et contraire au principe de l'égalité en droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68651c6d-e7d1-4c56-a60a-72f8be39f3de",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "14 mai. - On apprend que le haut clergé bouddhique a commencé une grève de la faim pour protester contre la discrimination dont il s'estime victime."
                                            },
                                            {
                                                "example_id": "d73e6d88-78c9-4630-954c-b7e2c91ef99c",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "L'attention est ainsi également attirée sur les positions sociales qui précisément ne subissent pas de marginalisation ni de discrimination ; un travail qui a été systématiquement entamé ces dernières années par les études critiques de la masculinité, celles de la blanchitude (whiteness) et la critique de l’hétéronormativité."
                                            },
                                            {
                                                "example_id": "423d462c-5cba-481e-9b69-b76a7bb9b634",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "Un arrêt de la Cour d’appel de Paris du 5 mai 2010 offre un exemple particulièrement éclairant à ce sujet en matière de discrimination homme/femme."
                                            },
                                            {
                                                "example_id": "60410e46-6f17-4bfd-b89c-72ffbd39ea79",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "C'est ainsi que Cooper aborde l'environnement grossophobe ambiant (notamment concernant l’infrastructure des transports publics), mais aussi la discrimination dans le milieu du travail (une personne grosse aurait ainsi moins de chance de se faire engager ou de recevoir une promotion)."
                                            },
                                            {
                                                "example_id": "101d7757-c33c-45df-bff5-e3d008d2bf0d",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "A cette époque, aux États Unis, les Blancs qui militent aux côtés des Noirs contre les discriminations raciales, sont progressivement exclus de toute alliance de long terme avec les Noirs. La lutte contre le racisme devient un monopole Noir."
                                            },
                                            {
                                                "example_id": "0c4dc8e9-52c2-486a-8b4b-c3646f62fd30",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "Le racisme apparaît ainsi comme un système généralisé de discriminations qui s’alimentent ou s’informent les unes les autres : il existe un cercle vicieux, déjà repéré dans les années quarante par l’économiste Günnar Myrdal dans son ouvrage classique An American Dilemma [1944], qui assure la reproduction quasi automatique de la discrimination des Noirs dans le logement, dans l’école ou sur le marché du travail."
                                            },
                                            {
                                                "example_id": "a2018ab4-32b4-46bc-99c8-e44b4b04da4a",
                                                "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                                                "text": "Même après les débuts de la diffusion du tennis, les Anglais comme les Français maintinrent la discrimination à l’égard des classes populaires en n’acceptant dans leurs clubs que les gens issus de la meilleure société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6913a674-2f66-3363-8899-b495f32ca5d5",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué.",
                                            "Modulation d'une offre de travail, de biens ou de services en fonction des caractéristiques connues ou supposées du marché."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26aabb82-09d8-3f7e-a6aa-271494fe4a49",
                                        "entry_id": "c004feb4-86aa-3044-8e59-86bd6d583b6b",
                                        "glosses": [
                                            "Différentiation des éléments en vue de l'application d'un traitement spécifique à chaque sous-ensemble ainsi constitué.",
                                            "Principe selon lequel un moyen ou un mode de guerre doit discriminer entre civil et combattant afin d'éviter, dans la mesure du possible, des pertes collatérales civiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
