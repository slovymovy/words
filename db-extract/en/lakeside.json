                                                "sense_id": "aee7b1e5-d619-3d4c-b405-7bb4248f8e13",
                                                "text": "Вот и берег показался."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53c45d5-520a-353c-879c-53d4bcd4cad0",
