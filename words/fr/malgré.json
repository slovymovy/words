            "senses": [
                {
                    "sense_id": "91271af5-ef0d-39a7-a140-7b8ec35707ac",
                    "sense_definition": "Mauvais consentement, déplaisir ou réticence à admettre quelque chose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opposition_volonte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fini par accepter cette décision difficile, <w>malgré</w> qu'il en ait."
                        },
                        {
                            "text": "Elle dut reconnaître son erreur manifeste, <w>malgré</w> qu'elle en eût au fond."
