                        "glosses": [
                            "zgięty pręt tworzący uszko, wbijany w drzwi, wieko skrzyni, w futrynę, na który zakłada się rodzaj listwy z płaskim otworem w celu zawieszenia kłódki lub założenia kołka"
                        ],
                        "tags": [],
                        "examples": [
