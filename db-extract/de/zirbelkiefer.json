                        "sense_id": "92d46ffe-3771-3a6c-b31f-6fa71457605f",
                        "entry_id": "8db138da-7968-35c7-96ce-901a472264ad",
                        "glosses": [
                            "eine weit über tausend Jahre alt und über zwanzig Meter hoch werdende Art der Föhren oder Kiefern (Gattung Pinus), die an der Waldgrenze der Alpen und Karpaten wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec5de3a-e87b-40ef-a31f-a7233877d9d7",
                                "sense_id": "92d46ffe-3771-3a6c-b31f-6fa71457605f",
                                "text": "Die Zirbelkiefer wird bis zu 25 Meter hoch."
                            },
                            {
                                "example_id": "1851bdae-baee-4dfc-adff-616064e6c9f2",
                                "sense_id": "92d46ffe-3771-3a6c-b31f-6fa71457605f",
                                "text": "Die Samen der Zirbelkiefer, die an den braunvioletten, eiförmigen Zapfen sitzenden Zirbelnüsse, werden gegessen oder zu Öl verarbeitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
