                "translations": [
                    {
                        "translation_id": "b6993d97-8881-40de-a033-7dd3798fc240",
                        "source_entry_id": "b56f1e0d-f732-3661-a207-51f40166d98d",
                        "source_sense_id": "a3b6a4a1-af38-31a1-b115-2bda7c4e81a3",
                        "target_lang_word": "conscientiousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conscientiousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d628ac-50db-3560-8b42-ad5864eafdeb",
                                        "entry_id": "cb75c564-6fc3-3b19-b93c-c11b655a8b46",
                                        "glosses": [
                                            "The state or characteristic of being conscientious."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981cc541-0d69-4b1d-914e-0643d0fc2d06",
                                                "sense_id": "d9d628ac-50db-3560-8b42-ad5864eafdeb",
                                                "text": "It is a terrible thing a Man should be put to Death for a Crime he is not Guilty of; yet so oddly Circumstances may meet in the infinite variety of Accidents, that it is possible it should come to pass, all the Wisdom that Judges, and Conscientiousness that Juries may be possess'd of, notwithstanding."
                                            },
                                            {
                                                "example_id": "f6439b01-0710-4e78-93a8-bad99346cc9d",
                                                "sense_id": "d9d628ac-50db-3560-8b42-ad5864eafdeb",
                                                "text": "We come now to the greatest and noblest of the Moral Powers of Man; to that power which makes him quite a different order of being from any other that we know of, and which is the glory and crown of his existence:—his Conscientiousness."
                                            },
                                            {
                                                "example_id": "84c40821-892f-4224-9aeb-c87679b60b10",
                                                "sense_id": "d9d628ac-50db-3560-8b42-ad5864eafdeb",
                                                "text": "It seems evident that those who have expressed the view that the following of personal inclination is sometimes morally better than conscientiousness are confusing this issue with another to which we must next give attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7434dfd4-3d37-4f42-acd8-386a99a83af0",
                        "source_entry_id": "b56f1e0d-f732-3661-a207-51f40166d98d",
                        "source_sense_id": "a3b6a4a1-af38-31a1-b115-2bda7c4e81a3",
                        "target_lang_word": "svědomitost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "801b28e4-c0aa-429e-a40d-3fafc21b5bb1",
                        "source_entry_id": "b56f1e0d-f732-3661-a207-51f40166d98d",
                        "source_sense_id": "a3b6a4a1-af38-31a1-b115-2bda7c4e81a3",
                        "target_lang_word": "Gewissenhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewissenhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4209899-9a5f-385d-b903-b170a491061f",
                                        "entry_id": "ba5dee96-ad1f-3626-9f76-afe976e41f4d",
                                        "glosses": [
                                            "die Eigenschaft von einer Person, mit großer Genauigkeit, Sorgfalt und Pünktlichkeit vorzugehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "279668c2-5f1d-437a-9c82-e0bb30cd0563",
                                                "sense_id": "f4209899-9a5f-385d-b903-b170a491061f",
                                                "text": "Meine Frau ist die Gewissenhaftigkeit in Person."
                                            },
                                            {
                                                "example_id": "af17a1d0-8bbd-46bf-bbf8-20695faa4e47",
                                                "sense_id": "f4209899-9a5f-385d-b903-b170a491061f",
                                                "text": "Menschen mit hoher Gewissenhaftigkeit sind sorgfältiger."
                                            },
                                            {
                                                "example_id": "4d5a3045-f021-4710-a43a-526c0b381f52",
                                                "sense_id": "f4209899-9a5f-385d-b903-b170a491061f",
                                                "text": "Sie nahm ihre Medizin mit großer Gewissenhaftigkeit."
                                            },
                                            {
                                                "example_id": "a3b51153-cd8f-4f7a-95c4-5e09ea181b6e",
                                                "sense_id": "f4209899-9a5f-385d-b903-b170a491061f",
                                                "text": "Das TÜV-Siegel ist ein Ausdruck deutscher Gewissenhaftigkeit. Doch wie der Aufkleber auf die Produkte kommt, erfahren die Konsumenten meist nicht."
                                            },
                                            {
                                                "example_id": "c643d045-502d-4cee-826b-ddbe68540511",
                                                "sense_id": "f4209899-9a5f-385d-b903-b170a491061f",
                                                "text": "„Mit der ihm eigenen Gewissenhaftigkeit nahm Amundsen seine Studien auf, befaßte sich mit Anatomie, Blutzirkulation und Traumatologie.“"
                                            },
                                            {
                                                "example_id": "7b7908f0-4933-42b7-9a93-fdc58fbffd81",
                                                "sense_id": "f4209899-9a5f-385d-b903-b170a491061f",
                                                "text": "„In der Vorrede erklärt Sade, daß die historische Gewissenhaftigkeit ihm die Feder geführt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dccb71f3-c998-452e-b933-83b54c469c5c",
                        "source_entry_id": "b56f1e0d-f732-3661-a207-51f40166d98d",
                        "source_sense_id": "a3b6a4a1-af38-31a1-b115-2bda7c4e81a3",
                        "target_lang_word": "Akribie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akribie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                        "entry_id": "6a3d8b4f-54d7-3544-a579-72df21b92a87",
                                        "glosses": [
                                            "höchste Sorgsamkeit, höchste Genauigkeit, äußerste Gründlichkeit"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b59fa24-481a-4580-b843-30b99190daab",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "Er erledigte diese Aufgabe mit großer Akribie."
                                            },
                                            {
                                                "example_id": "d936c86c-6249-48db-a20c-77fb4d227a7c",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Mir wurde bald deutlich, daß man sogenannter objektiver Wahrheit nicht ohne alle erdenkliche Akribie habhaft werden kann.“"
                                            },
                                            {
                                                "example_id": "2b04487e-9a0c-4906-9c01-42686ac26bf7",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "In der Orthodoxie ist Akribie die äußerste Genauigkeit, nach der alle Gebote gewissenhaft befolgt werden müssen."
                                            },
                                            {
                                                "example_id": "c1519b5c-fa35-4172-b230-cdef38c0ef13",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Aber die Akribie derartiger Zusammenstellungen verrät einen Hang zur Eindeutigkeit, den die folgenden Ausschweifungen nicht teilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
