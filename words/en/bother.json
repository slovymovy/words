{
    "word_family": [
        "botheration",
        "bothersome"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b28a6ff-29c3-331f-a691-993c9b88068a",
                    "sense_definition": "To annoy, disturb, or cause minor irritation to someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry to <w>bother</w> you, but do you have a moment to talk?",
                            "target_lang_translations": {
                                "ru": "Извините, что <w>беспокою</w> вас, но есть ли у вас минутка поговорить?"
                            }
                        },
                        {
                            "text": "Does it <w>bother</w> you if I open the window for some fresh air?",
                            "target_lang_translations": {
                                "ru": "Вас не <w>потревожит</w>, если я открою окно, чтобы проветрить?"
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "disturb",
                        "irritate",
                        "trouble",
                        "irk"
                    ],
                    "antonyms": [
                        "soothe",
                        "please",
                        "comfort"
                    ],
                    "common_phrases": [
                        "bother someone",
                        "sorry to bother"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать, мешать или вызывать небольшое неудобство у кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "нарушать покой или отвлекать"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "создавать препятствия или неудобства"
                            },
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать досаду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0622b90-b25a-3157-a580-a88519d6d351",
                    "sense_definition": "To take the trouble or make the effort to do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not even <w>bother</w> to say goodbye before he left the party.",
                            "target_lang_translations": {
                                "ru": "Он даже не <w>потрудился</w> попрощаться, прежде чем уйти с вечеринки."
                            }
                        },
                        {
                            "text": "Why <w>bother</w> to try if you have already decided to give up?",
                            "target_lang_translations": {
                                "ru": "Зачем <w>утруждаться</w> и пробовать, если ты уже решил сдаться?"
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble oneself"
                    ],
                    "common_phrases": [
                        "bother to try",
                        "not bother to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать на себя труд или прилагать усилия, чтобы сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утруждать себя",
                                "target_lang_sense_clarification": "прилагать усилия"
                            },
                            {
                                "target_lang_word": "беспокоиться",
                                "target_lang_sense_clarification": "утруждаться чем-либо"
                            },
                            {
                                "target_lang_word": "утруждаться",
                                "target_lang_sense_clarification": "делать усилие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de2340a8-fac5-3368-8fe5-7740e6d92e13",
                    "sense_definition": "To feel concern or worry about something; to burden oneself with a specific matter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>bother</w> about such small details when the project is so large.",
                            "target_lang_translations": {
                                "ru": "Тебе не стоит <w>беспокоиться</w> о таких мелких деталях, когда проект такой масштабный."
                            }
                        },
                        {
                            "text": "I would not <w>bother</w> with an umbrella because the rain is almost over.",
                            "target_lang_translations": {
                                "ru": "Я бы не стал <w>заморачиваться</w> с зонтиком, потому что дождь почти закончился."
                            }
                        }
                    ],
                    "synonyms": [
                        "worry",
                        "mind",
                        "care"
                    ],
                    "antonyms": [
                        "ignore",
                        "neglect"
                    ],
                    "common_phrases": [
                        "bother about",
                        "bother with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать озабоченность или беспокойство по поводу чего-либо; обременять себя конкретным делом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоиться",
                                "target_lang_sense_clarification": "волноваться о чем-либо"
                            },
                            {
                                "target_lang_word": "тревожиться",
                                "target_lang_sense_clarification": "испытывать тревогу"
                            },
                            {
                                "target_lang_word": "париться",
                                "target_lang_sense_clarification": "сленг, излишне переживать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36f81ac6-6e27-38c2-ab28-a8e746c5dd5b",
                    "sense_definition": "A source of minor trouble or inconvenience.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is no <w>bother</w> at all to give you a ride to the station.",
                            "target_lang_translations": {
                                "ru": "Мне совсем не <w>трудно</w> подвезти вас до вокзала."
                            }
                        },
                        {
                            "text": "Finding a parking spot in this city is such a <w>bother</w> every morning.",
                            "target_lang_translations": {
                                "ru": "Поиск парковочного места в этом городе — такая <w>морока</w> каждое утро."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuisance",
                        "hassle",
                        "inconvenience",
                        "trouble"
                    ],
                    "antonyms": [
                        "convenience",
                        "help"
                    ],
                    "common_phrases": [
                        "no bother",
                        "bit of bother"
                    ],
                    "target_lang_definitions": {
                        "ru": "Источник небольших неприятностей или неудобств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "причина хлопот"
                            },
                            {
                                "target_lang_word": "хлопоты",
                                "target_lang_sense_clarification": "мелкие заботы"
                            },
                            {
                                "target_lang_word": "обуза",
                                "target_lang_sense_clarification": "неудобство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d492fb0-dbf9-331f-b6ae-54083811f550",
                    "sense_definition": "A state of fuss, commotion, or unnecessary activity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "commotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a lot of <w>bother</w> over who would sit in the front seat.",
                            "target_lang_translations": {
                                "ru": "Было много <w>суеты</w> из-за того, кто будет сидеть на переднем сиденье."
                            }
                        },
                        {
                            "text": "I decided it was not worth the <w>bother</w> to return the cheap item.",
                            "target_lang_translations": {
                                "ru": "Я решил, что возврат дешевой вещи не стоит <w>хлопот</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuss",
                        "ado",
                        "commotion",
                        "palaver"
                    ],
                    "antonyms": [
                        "calm",
                        "peace"
                    ],
                    "common_phrases": [
                        "worth the bother"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние суеты, переполоха или ненужной активности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суета",
                                "target_lang_sense_clarification": "излишняя активность"
                            },
                            {
                                "target_lang_word": "переполох",
                                "target_lang_sense_clarification": "шум и беспорядок"
                            },
                            {
                                "target_lang_word": "возня",
                                "target_lang_sense_clarification": "хлопоты вокруг чего-то"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a25f9e14-d54a-3077-b39b-c43394040a39",
                    "sense_definition": "A mild exclamation used to express annoyance or frustration.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>bother</w>! I have forgotten my keys inside the house again.",
                            "target_lang_translations": {
                                "ru": "Ох, <w>досада</w>! Я снова забыл ключи в доме."
                            }
                        },
                        {
                            "text": "He dropped his brush and shouted <w>bother</w> before picking it up.",
                            "target_lang_translations": {
                                "ru": "Он уронил кисть и крикнул «<w>черт</w>», прежде чем поднять ее."
                            }
                        }
                    ],
                    "synonyms": [
                        "drat",
                        "darn",
                        "blast"
                    ],
                    "common_phrases": [
                        "oh bother"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often associated with British English or older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкое восклицание, используемое для выражения раздражения или разочарования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вот досада",
                                "target_lang_sense_clarification": "выражение огорчения"
                            },
                            {
                                "target_lang_word": "черт возьми",
                                "target_lang_sense_clarification": "мягкое ругательство"
                            },
                            {
                                "target_lang_word": "блин",
                                "target_lang_sense_clarification": "разговорное восклицание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}