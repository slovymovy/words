                    "frequency": "Middle",
                    "semantic_group_id": "tolerance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle doit souvent <w>encaisser</w> les reproches injustifiés de son supérieur sans rien dire."
                        },
                        {
                            "text": "Je ne peux vraiment pas l'<w>encaisser</w> depuis qu'il m'a menti effrontément."
                        }
                    ],
                    "synonyms": [
                        "supporter",
                        "endurer"
                    ],
                    "common_phrases": [
                        "ne pas pouvoir encaisser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens de ne pas supporter une personne"
                        }
                    ]
                },
                {
                    "sense_id": "b361b486-e374-309e-9231-25d42cdd952b",
                    "sense_definition": "Mettre des marchandises ou des objets dans des caisses pour leur emballage ou transport.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emballage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers s'activent pour <w>encaisser</w> les bouteilles de vin avant leur expédition."
                        },
                        {
                            "text": "La nouvelle machine permet d'<w>encaisser</w> des centaines de produits chaque heure à l'usine."
                        }
                    ],
                    "synonyms": [
                        "emballer"
                    ]
                },
                {
                    "sense_id": "d6990b16-9b32-3915-9fda-d66b1197a296",
                    "sense_definition": "Resserrer ou contenir un cours d'eau entre des berges abruptes ou des digues.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "topographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs ont dû <w>encaisser</w> la rivière pour protéger les habitations des inondations."
                        },
                        {
                            "text": "La petite rivière s'<w>encaisse</w> entre deux falaises rocheuses avant de se jeter dans le lac."
