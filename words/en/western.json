                        {
                            "text": "The road map shows that <w>Western</w> is just a few miles ahead.",
                            "target_lang_translations": {
                                "ru": "Дорожная карта показывает, что <w>Вестерн</w> находится всего в нескольких милях впереди.",
                                "zh": "公路地图显示<w>韦斯特恩</w>就在前方几英里处。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в округе Салин, штат Небраска, США.",
                        "zh": "美国内布拉斯加州萨林县的一个村庄。"
                    },
                    "translations": {
