                        "sense_id": "553dc0d0-8f99-36b3-a16d-c708b74f6be7",
                        "entry_id": "94419b6c-2aa7-357b-8ed9-5cced9b73b29",
                        "glosses": [
                            "tentoonstelling waarbij mensen van het platteland aan de stadsbewoners laten zien wat ze zoal doen en te bieden hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21e88c4-1525-4a2c-b04d-c657657def5b",
                                "sense_id": "553dc0d0-8f99-36b3-a16d-c708b74f6be7",
                                "text": "Het was de zevende keer dat de Landdag gehouden werd. Een presentatiemiddag die bedoeld is om het publiek te laten zien welk moois de landbouwers te bieden hebben, met rijdend materieel, kraampjes en demonstraties."
                            },
                            {
                                "example_id": "760ecf02-35f7-45bf-b3aa-91e1f2cb4b66",
                                "sense_id": "553dc0d0-8f99-36b3-a16d-c708b74f6be7",
                                "text": "De stad ontmoet het platteland op de Twentse Landdag. In Het Ledeboerpark worden allerlei activiteiten gehouden. Het thema van dit jaar is ‘Energiek Platteland’. De Twentse Landdag wordt gehouden van 10:00 tot 17:00 uur. De toegang is gratis."
                            }
                        ]
                    }
