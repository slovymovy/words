                        ],
                        "examples": [
                            {
                                "example_id": "dd45aa6a-12ab-4798-a4ea-2fe077843ccc",
                                "sense_id": "29547766-b8bf-39c3-8d5f-490310799a58",
                                "text": "Egipt przedstawia tu legendarny aktor, rodowity Egipcjanin, Omar Sharif i Kate Maberly.",
                                "translation": "Egypt is represented here by legendary actor Omar Sharif, a native Egyptian, and Kate Maberly.",
                                "english": "Egypt is represented here by legendary actor Omar Sharif, a native Egyptian, and Kate Maberly."
                            },
                            {
                                "example_id": "df319166-317d-4131-9a8f-a3cae467faae",
                                "sense_id": "29547766-b8bf-39c3-8d5f-490310799a58",
                                "text": "Pokojową Nagrodę Nobla otrzymała Międzynarodowa Agencja Energii Atomowej i jej dyrektor, Egipcjanin Mohamed El Baradei.",
                                "translation": "The Nobel Peace Prize was awarded to the International Atomic Energy Agency and its director, Egyptian Mohamed El Baradei.",
                                "english": "The Nobel Peace Prize was awarded to the International Atomic Energy Agency and its director, Egyptian Mohamed El Baradei."
                            }
                        ]
