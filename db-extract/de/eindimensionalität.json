                "senses": [
                    {
                        "sense_id": "3ff18605-9b99-3445-b759-9715e0b76d8e",
                        "entry_id": "823be831-550d-3074-9341-ef9b090f748e",
                        "glosses": [
                            "Eigenschaft, von mehreren möglichen Ausprägungen (Dimensionen) nur genau eine zu zeigen oder überzubetonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46370daf-e1e6-4425-b213-7288ed7a1e23",
                                "sense_id": "3ff18605-9b99-3445-b759-9715e0b76d8e",
                                "text": "„Die überraschend opalisierende Leuchtkraft der Farben, die einen direkt hineinziehen in dieses Mixtum compositum aus der Tiefe des auseinanderstrebenden Raumes und der quälenden Eindimensionalität der Fläche!“"
                            },
                            {
                                "example_id": "29e4207a-edd0-4082-b7cc-a116d9deea7a",
                                "sense_id": "3ff18605-9b99-3445-b759-9715e0b76d8e",
                                "text": "Da wird ein Bild der Problematik gezeichnet, das an Eindimensionalität und Naivität kaum zu überbieten ist."
                            },
                            {
                                "example_id": "49973b64-ff82-43c7-a28d-d2f34dbef685",
                                "sense_id": "3ff18605-9b99-3445-b759-9715e0b76d8e",
                                "text": "„Zu den Eindimensionalitäten in der Bundesrepublik gehört die Dominanz des Ökonomischen. Lange Zeit haben unsere Nachbarn die Bundesrepublik als eine Wirtschaft auf der Suche nach dem Staat empfunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
