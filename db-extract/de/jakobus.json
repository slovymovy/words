                                        "sense_id": "97db8b5d-bff1-3692-bd15-89f401716385",
                                        "entry_id": "4299609e-a18d-36c6-82f2-253cf2643d74",
                                        "glosses": [
                                            "The twentieth book of the New Testament of the Bible, the general epistle of James."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e64d23ad-bb3a-3bc8-8031-b607aea58838",
                                        "entry_id": "4299609e-a18d-36c6-82f2-253cf2643d74",
                                        "glosses": [
                                            "One of two Apostles, James the Greater and James the Less, often identified with James, brother of Jesus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1318ffc-8229-401a-b6b3-e4f371250114",
                                                "sense_id": "e64d23ad-bb3a-3bc8-8031-b607aea58838",
                                                "text": "Now the names of the twelve apostles are these; The first, Simon, who is called Peter, and Andrew his brother; James the son of Zebedee, and John his brother; Philip, and Bartholomew; Thomas, and Matthew the publican; James the son of Alphaeus, and Lebbaeus, whose surname was Thaddaeus; Simon the Canaanite, and Judas Iscariot, who also betrayed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9984f07-9f85-3f0b-9f45-aca22a172b31",
                                        "entry_id": "4299609e-a18d-36c6-82f2-253cf2643d74",
                                        "glosses": [
                                            "A male given name from Hebrew popular since the Middle Ages. Also a common middle name."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e8d8043-14dc-4f8e-8d8b-e1f2926ce3fb",
                                                "sense_id": "b9984f07-9f85-3f0b-9f45-aca22a172b31",
                                                "text": "[…] And Normans call me James Fitz-James. / Thus watch I o'er insulted laws, / Thus learn to right the injured cause. […]"
                                            },
                                            {
                                                "example_id": "499d513b-1a2f-49aa-b980-2d4582adcd04",
                                                "sense_id": "b9984f07-9f85-3f0b-9f45-aca22a172b31",
                                                "text": "Heaven only knows why a man with a strong biblical name like James wants to be a president named Jimmy."
                                            },
                                            {
                                                "example_id": "e05ab7ef-d444-48c4-8a76-138f46101cb0",
                                                "sense_id": "b9984f07-9f85-3f0b-9f45-aca22a172b31",
                                                "text": "In the political drama that Donald Trump has created in Washington, he could not have dreamed up a more formidable adversary than James Comey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6900f3ae-42cd-30ef-9d77-107c46d3cb2d",
                                        "entry_id": "4299609e-a18d-36c6-82f2-253cf2643d74",
                                        "glosses": [
                                            "An English surname originating as a patronymic."
                                        ],
