                        "sense_id": "ad094efb-0475-3762-9bfc-bcbeabc406e3",
                        "entry_id": "89571102-fe41-310b-8737-51cad672f1ff",
                        "glosses": [
                            "past passive perfective participle of подстрели́ть (podstrelítʹ)"
                        ],
                        "tags": [
                            "form-of",
