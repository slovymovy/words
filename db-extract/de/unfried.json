                ],
                "senses": [
                    {
                        "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                        "entry_id": "8e6c3818-4452-3c4d-925e-0dd72f8762c8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b92d5b0-3692-47c7-8b07-8a6bdca0d73c",
                                "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                                "text": "Der Unfried trägt nie die Schals, die die Unfried ihm strickt."
                            },
                            {
                                "example_id": "e4c56f3f-a78d-49fe-a6e8-3e0ce83956fd",
                                "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Unfried kommt, geht der Herr Unfried.“"
                            },
                            {
                                "example_id": "3e3097c2-9a1a-4e4b-8dc4-a7b9f22dd46f",
                                "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                                "text": "Unfried kommt und geht."
                            },
                            {
                                "example_id": "37ecdf0e-4883-4a65-abb0-a4b7b76ce348",
                                "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                                "text": "Unfrieds kamen, sahen und siegten."
                            },
                            {
                                "example_id": "622f5cff-13a9-4442-b1a5-1b2cf903e5ca",
                                "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                                "text": "Frau Unfried ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "161a2d53-0ff9-4c0b-8cb5-40bfaa56a8c6",
                                "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                                "text": "Herr Unfried wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b4046ee8-ca64-4a45-a221-93d398aec368",
                                "sense_id": "3b82fc8f-8934-3fb8-b669-842917dd48c3",
                                "text": "Die Unfrieds fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
