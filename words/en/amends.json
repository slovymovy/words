            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afae3a18-563c-3123-b41b-7f69fd256046",
                    "sense_definition": "Compensation for an injury, loss, or insult; reparation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to make <w>amends</w> for his rude behavior by sending her a beautiful bouquet of flowers.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>загладить</w> <w>вину</w> за свое грубое поведение, отправив ей красивый букет цветов."
                            }
                        },
                        {
                            "text": "The company offered financial compensation to make <w>amends</w> for the delayed shipment.",
                            "target_lang_translations": {
                                "ru": "Компания предложила финансовую компенсацию, чтобы <w>возместить</w> <w>ущерб</w> за задержку поставки."
                            }
                        }
                    ],
                    "synonyms": [
                        "redress",
                        "restitution",
                        "indemnity"
                    ],
                    "common_phrases": [
                        "make amends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компенсация за ущерб, потерю или оскорбление; возмещение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компенсация",
                                "target_lang_sense_clarification": "возмещение понесённого ущерба или расходов"
                            },
                            {
                                "target_lang_word": "возмещение",
                                "target_lang_sense_clarification": "заглаживание вины или вреда"
                            }
                        ]
