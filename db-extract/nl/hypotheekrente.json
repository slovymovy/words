                        "examples": [
                            {
                                "example_id": "27f4384c-764c-47de-a8cc-ec67d0df27e6",
                                "sense_id": "5c06994e-5b82-3786-a287-f7d26866fad6",
                                "text": "De hypotheekrente is de rente die je betaalt op je hypotheeklening.",
                                "translation": "The mortgage interest is the interest you pay on your mortgage loan.",
                                "english": "The mortgage interest is the interest you pay on your mortgage loan."
                            },
                            {
                                "example_id": "931acf94-ece3-4913-9697-79559382823b",
                                "sense_id": "5c06994e-5b82-3786-a287-f7d26866fad6",
                                "text": "De hoogte van de hypotheekrente kan variëren afhankelijk van de geldende marktomstandigheden.",
                                "translation": "The amount of the mortgage interest can vary depending on the prevailing market conditions.",
                                "english": "The amount of the mortgage interest can vary depending on the prevailing market conditions."
                            },
                            {
                                "example_id": "ad4d27fb-c2bf-4689-9fc8-bdc046ac0449",
                                "sense_id": "5c06994e-5b82-3786-a287-f7d26866fad6",
                                "text": "Het is belangrijk om de verschillende aanbiedingen voor hypotheekrente te vergelijken voordat je een hypotheek afsluit.",
                                "translation": "It's important to compare the different offers for mortgage interest before taking out a mortgage.",
                                "english": "It's important to compare the different offers for mortgage interest before taking out a mortgage."
                            }
                        ]
                    }
