                    {
                        "translation_id": "7984e06b-641b-4303-bedc-d66a643a9ef0",
                        "source_entry_id": "4629011e-087d-3024-ae83-57f7920414de",
                        "source_sense_description": "breed of dog",
                        "target_lang_word": "bouledogue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
