{
    "word_family": [
        "законный",
        "незаконный",
        "законность",
        "беззаконие",
        "узаконить",
        "законодатель",
        "законодательство",
        "закономерность"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b20b6ce2-f2ba-3cd3-9b31-be62de990304",
                    "sense_definition": "Официально установленное государством общеобязательное правило поведения или нормативный акт.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все граждане обязаны знать и соблюдать <w>закон</w>.",
                            "target_lang_translations": {
                                "en": "All citizens are required to know and observe the <w>law</w>.",
                                "zh": "所有公民都有义务了解并遵守<w>法律</w>。"
                            }
                        },
                        {
                            "text": "За это преступление <w>закон</w> предусматривает строгое наказание.",
                            "target_lang_translations": {
                                "en": "The <w>law</w> provides for severe punishment for this crime.",
                                "zh": "针对这种犯罪行为，<w>法律</w>规定了严厉的惩罚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "правило",
                        "правовая норма"
                    ],
                    "antonyms": [
                        "беззаконие",
                        "анархия"
                    ],
                    "common_phrases": [
                        "нарушать закон",
                        "соблюдать закон",
                        "по закону",
                        "суровый закон"
                    ],
                    "target_lang_definitions": {
                        "en": "An officially established binding rule of conduct or a normative act.",
                        "zh": "由国家正式制定、全体公民必须遵守的行为准则或规范性文件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "law",
                                "target_lang_sense_clarification": "legal rule or system"
                            },
                            {
                                "target_lang_word": "statute",
                                "target_lang_sense_clarification": "written law"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "法律",
                                "target_lang_sense_clarification": "国家制定的强制性规则"
                            },
                            {
                                "target_lang_word": "法规",
                                "target_lang_sense_clarification": "具体的法律条文或规章"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0062328a-596b-30b3-bb96-5880d3f66ec4",
                    "sense_definition": "Объективно существующая, необходимая и устойчивая связь между явлениями в природе или обществе.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На уроке физики школьники изучали <w>закон</w> всемирного тяготения.",
                            "target_lang_translations": {
                                "en": "In physics class, the students studied the <w>law</w> of universal gravitation.",
                                "zh": "在物理课上，学生们学习了万有引力<w>定律</w>。"
                            }
                        },
                        {
                            "text": "Это противоречит всем известным <w>законам</w> природы.",
                            "target_lang_translations": {
                                "en": "This contradicts all known <w>laws</w> of nature.",
                                "zh": "这违背了所有已知的自然<w>规律</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "закономерность"
                    ],
                    "antonyms": [
                        "случайность"
                    ],
                    "common_phrases": [
                        "закон природы",
                        "закон физики",
                        "закон сохранения"
                    ],
                    "target_lang_definitions": {
                        "en": "An objective, necessary, and stable connection between phenomena in nature or society.",
                        "zh": "自然界或社会现象之间客观存在、必然且稳定的联系。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "law",
                                "target_lang_sense_clarification": "scientific principle"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定律",
                                "target_lang_sense_clarification": "科学上的客观规律"
                            },
                            {
                                "target_lang_word": "规律",
                                "target_lang_sense_clarification": "事物发展的必然趋势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3397708b-2109-3cab-9fef-6189d7759d26",
                    "sense_definition": "Система религиозных предписаний и правил, данных Богом.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Священник объяснял прихожанам <w>Закон</w> Божий и его значение.",
                            "target_lang_translations": {
                                "en": "The priest explained the <w>Law</w> of God and its significance to the parishioners.",
                                "zh": "牧师向教区居民讲解了上帝的<w>律法</w>及其意义。"
                            }
                        },
                        {
                            "text": "Древний религиозный <w>закон</w> запрещал работать в этот священный день.",
                            "target_lang_translations": {
                                "en": "Ancient religious <w>law</w> forbade working on this holy day.",
                                "zh": "古老的宗教<w>律法</w>禁止在这一神圣的日子工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Закон Божий"
                    ],
                    "common_phrases": [
                        "ветхозаветный закон",
                        "чтить закон"
                    ],
                    "target_lang_definitions": {
                        "en": "A system of religious precepts and rules given by God.",
                        "zh": "宗教中被视为神所颁布的戒律和准则。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Law",
                                "target_lang_sense_clarification": "divine commandments"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "律法",
                                "target_lang_sense_clarification": "宗教教义中的神圣准则"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9817ec32-d905-31db-8965-dbdecbd959fb",
                    "sense_definition": "Брачный союз, скреплённый церковным венчанием.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старину люди редко жили вместе, не вступив в <w>закон</w>.",
                            "target_lang_translations": {
                                "en": "In olden times, people rarely lived together without entering into <w>wedlock</w>.",
                                "zh": "在过去，人们很少在没有正式<w>婚配</w>的情况下同居。"
                            }
                        },
                        {
                            "text": "Они прожили в честном <w>законе</w> долгие и счастливые годы.",
                            "target_lang_translations": {
                                "en": "They lived in honest <w>wedlock</w> for many long and happy years.",
                                "zh": "他们以合法的<w>婚配</w>关系度过了漫长而幸福的岁月。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "жить в законе"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A marital union sealed by a church ceremony.",
                        "zh": "指通过宗教仪式认可的婚姻结合（古语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wedlock",
                                "target_lang_sense_clarification": "archaic"
                            },
                            {
                                "target_lang_word": "marriage",
                                "target_lang_sense_clarification": "union"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "婚配",
                                "target_lang_sense_clarification": "指合法的婚姻关系"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}