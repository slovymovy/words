                        "examples": [
                            {
                                "example_id": "dcea67ed-ee51-42e9-9e51-9d1373e84a87",
                                "sense_id": "bbcce02c-7b02-345a-8b71-58e46bde54e2",
                                "text": "„Im Süden des Landes, wo der Gottesdienstbesuch noch zum Leben gehört, wurde kaum eine Kirche geschlossen.“"
                            },
                            {
                                "example_id": "facb64b5-e92e-440c-ab92-879fad4cd8cf",
                                "sense_id": "bbcce02c-7b02-345a-8b71-58e46bde54e2",
                                "text": "„Gottesdienstbesuch war Pflicht in Shakespears Tagen, auferlegt durch ein Gesetz des Parlaments, dessen Nichtbefolgung unter Strafe stand.“"
                            }
                        ],
