                        "sense_id": "6b246b35-ce1c-3ea4-ba08-51746a15f787",
                        "entry_id": "e1ea90ab-9a58-32d5-963c-57c2bb61e9e6",
                        "glosses": [
                            "Fait pour une personne physique ou morale de constituer une réserve d’argent en prévision d’un préjudice potentiel qu’il pourrait causer ou subir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a7309bc-fa10-4d1e-8e7e-9c99c038805c",
                                "sense_id": "6b246b35-ce1c-3ea4-ba08-51746a15f787",
                                "text": "L’épargne en tant qu’auto-assurance présente de nombreuses caractéristiques supérieures à celles de l’assurance."
                            },
                            {
                                "example_id": "e993145d-92ff-421d-83f1-ca6ac9ff0bda",
                                "sense_id": "6b246b35-ce1c-3ea4-ba08-51746a15f787",
                                "text": "Dans ce cas, l’assuré peut assumer tous les risques et devenir ainsi son propre assureur (auto-assurance complète), ou encore partager les risques avec l’assureur (auto-assurance partielle)."
                            }
                        ]
                    },
                    {
                        "sense_id": "589e68f6-fbb9-3704-aff3-97f069796fc2",
                        "entry_id": "e1ea90ab-9a58-32d5-963c-57c2bb61e9e6",
                        "glosses": [
                            "Ensemble des procédés pour mettre en sécurité sa propre position ou ses déplacements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0484c80a-352f-4fc0-b8d4-c9268eabf43f",
                                "sense_id": "589e68f6-fbb9-3704-aff3-97f069796fc2",
                                "text": "La progression se fait de manière autonome au moyen d’outils mécaniques d’auto-assurance sur lesquels l’alpiniste s’assure, se stabilise et se tracte."
                            }
                        ]
                    }
