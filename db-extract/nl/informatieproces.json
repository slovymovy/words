                "senses": [
                    {
                        "sense_id": "9ff7782d-675d-3ff3-b382-ef16c01fd4a4",
                        "entry_id": "f8f5da1d-2373-39ea-9952-cd1b710ce794",
                        "glosses": [
                            "een eerste stap in de vorming van een"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9af0ab7-e68c-4079-ab88-be6b879a3abc",
                                "sense_id": "9ff7782d-675d-3ff3-b382-ef16c01fd4a4",
                                "text": "De afgelopen weken keek Nieuwsuur van dichtbij mee bij het informatieproces in Flevoland:"
                            },
                            {
                                "example_id": "6a02cdc5-96c1-419b-9aff-6d9e64015ae8",
                                "sense_id": "9ff7782d-675d-3ff3-b382-ef16c01fd4a4",
                                "text": "Lubbers verwerpt de kritiek dat hij tijdens het informatieproces buiten zijn boekje is gegaan. De PvdA, D66 en GroenLinks vinden dat hij onterecht gelegenheid heeft geboden aan een rechts minderheidskabinet. Maar volgens Lubbers wilden VVD, CDA en PVV niets anders dan onderhandelen over dit kabinet."
                            },
                            {
                                "example_id": "44ca0667-5893-4962-a6ef-3c6f14c64bd6",
                                "sense_id": "9ff7782d-675d-3ff3-b382-ef16c01fd4a4",
                                "text": "Daarin staat: \"Hoezeer ik een gesprek met u op zichzelf op prijs zou stellen, heb ik na rijp beraad toch moeten besluiten dat een gesprek met u op dit moment niet goed past in deze fase van het informatieproces.\""
                            }
                        ]
                    }
