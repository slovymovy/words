                "senses": [
                    {
                        "sense_id": "f5dbad1c-504c-30a4-99c2-d81fcca673b1",
                        "entry_id": "1c161b4a-35c4-3bb6-9548-ad0dd74cdee8",
                        "glosses": [
                            "A wasting of body tissues, of either genetic origin or due to inadequate or defective nutrition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "752a69ae-d8ef-4348-b12f-c9d5a81d3634",
                        "source_entry_id": "1c161b4a-35c4-3bb6-9548-ad0dd74cdee8",
                        "source_sense_id": "f5dbad1c-504c-30a4-99c2-d81fcca673b1",
                        "source_sense_description": "dystrophy",
                        "target_lang_word": "dystrophie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dystrophie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba01698c-361d-3163-984a-f7d89206742f",
                                        "entry_id": "52f9d203-82f0-384d-ad15-d36e82cc1f78",
                                        "glosses": [
                                            "Dégénérescence ou anomalie de développement d'une structure anatomique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc52f2f-6915-48e5-92cc-2d4d1f523327",
                                                "sense_id": "ba01698c-361d-3163-984a-f7d89206742f",
                                                "text": "Elle se croyait invincible et voilà que son dossier l’accusait d’ostéoporose jointe à une dystrophie osseuse."
                                            },
                                            {
                                                "example_id": "8ab202d0-4465-4c2a-9c26-47697faa78f5",
                                                "sense_id": "ba01698c-361d-3163-984a-f7d89206742f",
                                                "text": "C'est \"une nouvelle étape déterminante et ô combien symbolique\", souligne dans un communiqué l'association AFM-Téléthon, fondée en 1958 par des parents d'enfants atteints de cette maladie et organisatrice depuis 1987 à la télévision publique française du Téléthon, une adaptation du Jerry Lewis MDA Telethon créé en 1966 par l'acteur, décédé en 2017, pour collecter des fonds destinés à la lutte contre les dystrophies musculaires."
                                            },
                                            {
                                                "example_id": "0cdec1ed-a4b5-4c93-852e-a15410bd0302",
                                                "sense_id": "ba01698c-361d-3163-984a-f7d89206742f",
                                                "text": "La sarcopénie (aussi appelée dystrophie musculaire liée à l’âge) est la diminution progressive de la masse musculaire liée à l’âge."
                                            },
                                            {
                                                "example_id": "84be0197-e381-4e64-af2d-c76e14337a1b",
                                                "sense_id": "ba01698c-361d-3163-984a-f7d89206742f",
                                                "text": "Les dystrophies cutanées, cornéennes, musculaires, ovariennes."
                                            },
                                            {
                                                "example_id": "18fc71f5-7366-48b3-9509-98f26ee0d605",
                                                "sense_id": "ba01698c-361d-3163-984a-f7d89206742f",
                                                "text": "Dystrophie endothéliale de Fuchs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18dd7b8f-55eb-4f27-ad24-4d9ae2027f45",
                        "source_entry_id": "1c161b4a-35c4-3bb6-9548-ad0dd74cdee8",
                        "source_sense_id": "f5dbad1c-504c-30a4-99c2-d81fcca673b1",
                        "source_sense_description": "dystrophy",
                        "target_lang_word": "Dystrophie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dystrophie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7241015-9312-35bc-aec6-686740f01e36",
                                        "entry_id": "4c876dff-2399-310a-ac54-eaee9f541862",
                                        "glosses": [
                                            "Störung des gesamten Organismus, einzelner Organe oder Gewebe, die durch eine Mangelernährung oder Fehlernährung hervorgerufen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "354a5e78-9809-431b-bc79-564d5c2d999e",
                                                "sense_id": "f7241015-9312-35bc-aec6-686740f01e36",
                                                "text": "„Die Muskuläre Dystrophie, auch Duchenne-Krankheit genannt, ist eine relativ häufige, angeborene Schwäche der Rumpf-Muskulatur.“"
                                            },
                                            {
                                                "example_id": "6c7c7bc3-1e6f-4505-b997-1628b92a5e72",
                                                "sense_id": "f7241015-9312-35bc-aec6-686740f01e36",
                                                "text": "„Dystrophie bezeichnet in der Medizin eine degenerative Veränderung, in diesem Fall des Gewebes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2a2fae7-bc2e-371a-9351-88afdaf808c2",
                                        "entry_id": "4c876dff-2399-310a-ac54-eaee9f541862",
                                        "glosses": [
                                            "mangelhafte Versorgung von Organen oder Geweben mit Nährstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f2367a-5d33-4cb8-9a22-bdaf251adc01",
                                                "sense_id": "d2a2fae7-bc2e-371a-9351-88afdaf808c2",
                                                "text": "„Die Schweizerische Nationale Versicherungsgesellschaft hat in einer Untersuchung gezeigt, daß der größte Verlust an Arbeitsfähigkeit nach einem Knochenbruch nicht durch eine verzögerte Heilung, sondern durch Dystrophie bedingt ist.“"
                                            },
                                            {
                                                "example_id": "db24c0df-158b-4bbe-81aa-8001764f3a9c",
                                                "sense_id": "d2a2fae7-bc2e-371a-9351-88afdaf808c2",
                                                "text": "„Die Hungerkrankheit oder alimentäre Dystrophie entsteht bei langdauernder Unterernährung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae6691b3-0e25-3661-b53c-47520910d135",
                                        "entry_id": "4c876dff-2399-310a-ac54-eaee9f541862",
                                        "glosses": [
                                            "Zustand eines Sees, der sich durch einen zu geringen Gehalt an Sauerstoff und einen zu hohen Gehalt an Säure auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe85accb-46b2-4972-8b01-554543bfdffc",
                                                "sense_id": "ae6691b3-0e25-3661-b53c-47520910d135",
                                                "text": "„Zu beachten ist doch, daß eine Moorumgebung an sich nicht zugleich die Dystrophie eines Sees bedeutet.“"
                                            },
                                            {
                                                "example_id": "6b5aac2c-194e-447f-8a5b-7dafb413c843",
                                                "sense_id": "ae6691b3-0e25-3661-b53c-47520910d135",
                                                "text": "„Mit zunehmender Dystrophie des Gewässers beginnen darin nicht mehr die Protococcales, sondern die Desmidiaceae die Oberhand zu gewinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
