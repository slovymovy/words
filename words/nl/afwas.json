                {
                    "sense_id": "69b71b12-8142-3318-83dc-b26e5d4e3e9b",
                    "sense_definition": "De vuile borden, glazen en bestek die nog schoongemaakt moeten worden.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staat nog een grote stapel <w>afwas</w> in de keuken na het feestje.",
                            "target_lang_translations": {
                                "en": "There is still a large pile of <w>dishes</w> in the kitchen after the party."
                            }
                        },
                        {
                            "text": "Wie gaat vandaag de <w>afwas</w> doen na het avondeten?",
                            "target_lang_translations": {
                                "en": "Who is going to <w>do the dishes</w> today after dinner?"
                            }
                        }
                    ],
                    "synonyms": [
                        "vaat"
                    ],
                    "common_phrases": [
                        "de afwas doen",
                        "grote afwas"
                    ],
                    "target_lang_definitions": {
                        "en": "The dirty dishes, glasses, and cutlery that still need to be cleaned."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dishes",
                                "target_lang_sense_clarification": "the dirty items themselves"
                            },
                            {
                                "target_lang_word": "washing-up",
                                "target_lang_sense_clarification": "the pile of items to be washed (British)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce6a2af2-3b4b-3416-9358-e468d9530578",
                    "sense_definition": "Het proces of de handeling van het schoonmaken van het serviesgoed.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik help mijn moeder altijd met de <w>afwas</w> zodat we sneller klaar zijn.",
                            "target_lang_translations": {
                                "en": "I always help my mother with the <w>washing-up</w> so that we finish faster."
                            }
                        },
                        {
                            "text": "Tijdens de <w>afwas</w> luisteren we vaak naar de radio.",
                            "target_lang_translations": {
                                "en": "During the <w>dishwashing</w>, we often listen to the radio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "helpen met de afwas"
                    ],
                    "target_lang_definitions": {
                        "en": "The process or act of cleaning the dishes."
                    },
                    "translations": {
