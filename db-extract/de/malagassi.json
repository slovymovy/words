                                        "glosses": [
                                            "Relatif à Madagascar, aux Malgaches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f25e6d-8ba4-4e5a-994a-f5c935661b86",
                                                "sense_id": "7ba7e596-a345-3de7-9b84-4e903b393eb7",
                                                "text": "Les cieux malgaches sont fréquentés par près de 294 espèces d’oiseaux, dont 107 sont endémiques."
                                            },
                                            {
                                                "example_id": "46087380-2992-4299-8dc9-c1c34400f9c6",
                                                "sense_id": "7ba7e596-a345-3de7-9b84-4e903b393eb7",
                                                "text": "Ainsi la géologie ancienne voudrait que l’on fît un groupe indo-malgache et un groupe africano-brésilien."
                                            },
                                            {
                                                "example_id": "c3173bf3-52b0-4cac-88bf-5b4f7fb85ef1",
                                                "sense_id": "7ba7e596-a345-3de7-9b84-4e903b393eb7",
                                                "text": "Elie montra à Hoffmeister un communiqué paru dans Le Courrier, selon lequel un agent de la Sécurité malgache avait été décoré."
                                            }
                                        ]
                                    }
                                ]
                            },
