                ],
                "senses": [
                    {
                        "sense_id": "acb429e1-18be-3da4-95aa-5674e828ac28",
                        "entry_id": "7f3534b6-14d8-3ccd-b092-5af7ca2fb4f6",
                        "glosses": [
                            "Petite tache pourprée, semblable à une morsure de puce, qui se manifeste souvent sur la peau durant le cours des maladies aiguës les plus graves."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "58c43ddd-6a3c-4ae2-80f6-9eb81afebe16",
                                "sense_id": "acb429e1-18be-3da4-95aa-5674e828ac28",
                                "text": "Les hémorragies qui surviennent à partir des petits vaisseaux sanguins qui irriguent les muqueuses ont l’aspect de petites étoiles rouges ; les hémorragies en « pointe d’épingle » sont dites pétéchiales (pétéchies), tandis que celles qui sont plus étendues sont appelées ecchymoses."
                            },
                            {
                                "example_id": "922d8a7b-fbe6-4db3-ae09-9a92429dc321",
                                "sense_id": "acb429e1-18be-3da4-95aa-5674e828ac28",
                                "text": "Chez les jeunes porcelets, les septicémies peuvent conduire à la mort en moins de 15 heures et les animaux présentent de la fièvre, des difficultés respiratoires, des troubles nerveux, une cyanose et des pétéchies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e31cafd-1215-4459-bc9a-af004fcda801",
                        "source_entry_id": "7f3534b6-14d8-3ccd-b092-5af7ca2fb4f6",
                        "source_sense_id": "acb429e1-18be-3da4-95aa-5674e828ac28",
                        "target_lang_word": "petechia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petechia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b8d8239-6955-3ca4-919a-bdaaeee4a0b9",
                                        "entry_id": "94293466-154a-392b-be7a-75110d86d222",
                                        "glosses": [
                                            "A small spot, especially on an organ, caused by bleeding underneath the skin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53edb146-0ec7-4092-ae1b-96cd6d452d19",
                                                "sense_id": "7b8d8239-6955-3ca4-919a-bdaaeee4a0b9",
                                                "text": "It is scurvy. All my authorities agree – weakness, diffused muscular pain, petechia, tender gums, ill breath – and M’Alister has no doubt of it."
                                            },
                                            {
                                                "example_id": "93d42758-2e38-4600-b445-aaba7edaa63c",
                                                "sense_id": "7b8d8239-6955-3ca4-919a-bdaaeee4a0b9",
                                                "text": "The marks on Jane's skin were petechiae, little hemorrhages that indicate lack of platelets in the blood. She needed two units of platelets transfused into her bloodstream."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
