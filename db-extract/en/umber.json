                        "entry_id": "bd71c6f4-8b2e-3e4f-ae34-1c52d97e09fc",
                        "glosses": [
                            "Of a reddish brown colour, like that of the pigment."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3fae3087-ae81-45bf-a697-c1185ee20737",
                                "sense_id": "5c8b646b-5306-321b-93ec-eda634de7548",
                                "text": "Their harps are of the umber shade / That hides the blush of waking day."
                            }
                        ]
                    }
                ],
