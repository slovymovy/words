                                "sense_id": "a4bb1b53-a994-381d-a006-6a3a5bc203e4",
                                "text": "„Dominic Thiem hat jetzt schon mehr Preisgeld verdient als Thomas Muster - und Novak Djokovic wird in naher Zukunft Roger Federer übertrumpfen.“"
                            },
                            {
                                "example_id": "69963afc-a630-47f7-900e-f47aa40a94cf",
                                "sense_id": "a4bb1b53-a994-381d-a006-6a3a5bc203e4",
                                "text": "„Für die Lösung eines Teilaspekts aus diesem Fragenkreis stehen seit dem Jahr 2000 eine Million Dollar Preisgeld bereit.“"
                            }
                        ],
