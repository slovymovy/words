                "senses": [
                    {
                        "sense_id": "f8ae6a0f-2095-301a-a7ab-0ddd742120a2",
                        "entry_id": "fe2c13b2-38e9-37b5-920a-3a019d4f1b7a",
                        "glosses": [
                            "поэт. и разг. унылость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2b46fa5-ff68-487e-a037-2140996a6e9d",
                                "sense_id": "f8ae6a0f-2095-301a-a7ab-0ddd742120a2",
                                "text": "…ничего красивого вообще не шьют, поверь — вот на таких весьма стандартных девушек, как я — все уныль сплошная."
                            },
                            {
                                "example_id": "477136b9-275e-4830-b49b-aeac12d951f2",
                                "sense_id": "f8ae6a0f-2095-301a-a7ab-0ddd742120a2",
                                "text": "Заочка на филфаке — это НЕ интересно — потому что не интересно само по себе, и скрасить всю эту уныль может только хороший лектор, 5 дней в неделю [в]дохновляющий своим примером…"
                            },
                            {
                                "example_id": "b97c2e97-87a6-48d6-90cc-19fc04e532df",
                                "sense_id": "f8ae6a0f-2095-301a-a7ab-0ddd742120a2",
                                "text": "Поверите ― прикольна суть / остыденения до стыли. / Барахтаюсь в своей уныли."
                            }
                        ]
                    }
                ],
