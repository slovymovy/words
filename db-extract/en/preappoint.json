                                "example_id": "866b86f0-98ad-45f5-b6a6-afe39561bb54",
                                "sense_id": "919b088f-ca25-3de5-b1cc-5879fdb4855b",
                                "text": "ALL REMAINING ALLIANCE PERSONNEL OUTSIDE SOL THEATER ARE DIRECTED TO MUSTER AT PRE-APPOINTED STAGING AREAS AND COMMENCE OFFENSIVE COMBAT OPERATIONS AT FIRST AVAILABLE OPPORTUNITY."
                            }
