                "senses": [
                    {
                        "sense_id": "7a1065bf-a48e-3f99-b64b-9feba5569563",
                        "entry_id": "03ab1392-fde7-3295-bd6f-384f32cc7b8c",
                        "glosses": [
                            "разг. проявить в течение некоторого времени усердие, старательность в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c52b1e80-6385-49c3-aa68-9de909ade1bb",
                                "sense_id": "7a1065bf-a48e-3f99-b64b-9feba5569563",
                                "text": "Сашенька-матушка обещала помочь непременно и действительно с большой охотой поусердствовала обеим."
                            }
                        ]
                    },
                    {
                        "sense_id": "45da52cf-31cb-3bfa-b75a-502139062bf1",
                        "entry_id": "03ab1392-fde7-3295-bd6f-384f32cc7b8c",
                        "glosses": [
                            "перен., разг., ирон. проявить чрезмерное усердие в чём-либо; переусердствовать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6735ab2a-04a3-4be9-85c3-82e3b2f4daf7",
                                "sense_id": "45da52cf-31cb-3bfa-b75a-502139062bf1",
                                "text": "Если фотограф не поусердствовал ретушью, то она (т. е. сестра, а не ретушь) далеко не лишена некоторых намеков на смазливость."
                            },
                            {
                                "example_id": "122b6e55-b60b-49d3-ab41-32252fe0197f",
                                "sense_id": "45da52cf-31cb-3bfa-b75a-502139062bf1",
                                "text": "― Меня незаконно арестовали. Поусердствовали следователь и прокурор."
                            }
                        ]
                    }
                ],
