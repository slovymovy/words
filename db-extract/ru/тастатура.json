                    {
                        "translation_id": "83f0049e-a960-40f4-92e5-2c7681f9abf0",
                        "source_entry_id": "cf3bc223-cc04-3930-a49e-e0a05d4e4ef3",
                        "source_sense_id": "abc4bf3c-713d-35ba-affd-7cfecc33cb71",
                        "target_lang_word": "Tastatur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tastatur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aff0b462-4a5e-3f26-9d49-cbdd3d5c4412",
                                        "entry_id": "02af0b17-e2b3-3987-a192-041f20dc0a13",
                                        "glosses": [
                                            "Eingabegerät, das als Bedienelemente eine Anzahl von mit den Fingern drückbaren Tasten enthält."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62290e47-6152-43cd-ac67-831849a03f0a",
                                                "sense_id": "aff0b462-4a5e-3f26-9d49-cbdd3d5c4412",
                                                "text": "„In der Außenhaut des Gehäuses war die Tastatur integriert.“"
                                            },
                                            {
                                                "example_id": "3704759d-49b4-40f5-af43-8fd0c22c3619",
                                                "sense_id": "aff0b462-4a5e-3f26-9d49-cbdd3d5c4412",
                                                "text": "Dieser Text wurde mit einer Tastatur geschrieben."
                                            },
                                            {
                                                "example_id": "e6535623-fbde-4247-94f2-5194bf2fee88",
                                                "sense_id": "aff0b462-4a5e-3f26-9d49-cbdd3d5c4412",
                                                "text": "„Dieses Aufschreiben kann ein handschriftliches Aufzeichnen sein, ein Schreiben mit einer Schreibmaschine, oder es handelt sich um das Eintippen eines Textes auf der Tastatur eines Computers, auf dessen Bildschirm das Geschriebene erscheint, was man nach Wunsch speichern kann.“"
                                            },
                                            {
                                                "example_id": "fe97794f-357e-4dae-acae-5dde3f2ebdaf",
                                                "sense_id": "aff0b462-4a5e-3f26-9d49-cbdd3d5c4412",
                                                "text": "„Mit dem Klackern der Tastatur im Ohr schlafe ich ein.“"
                                            },
                                            {
                                                "example_id": "c953d6df-3c95-4fc3-9308-a1bdc399a748",
                                                "sense_id": "aff0b462-4a5e-3f26-9d49-cbdd3d5c4412",
                                                "text": "„Möglicherweise beeinflusste das Fehlen des Ausrufezeichens auf der Tastatur der Remington allgemeine Einstellungen zur Sprache, sodass ihr funktionaler Zweck Grammatikregeln wie die der Fowler-Brüder unterstützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
