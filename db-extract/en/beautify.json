                "senses": [
                    {
                        "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                        "glosses": [
                            "To make beautiful; to increase the beauty of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "15275149-e797-406e-bd0e-90351b1278c0",
                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                "text": "1592, Robert Greene, Greene's Groats-Worth of Wit, London: William Wright, “Robertoes Tale”\n[…] there is an vpstart Crow, beautified with our feathers, that with his Tygers hart wrapt in a Players hyde, supposes he is as well able to bombast out a blanke verse as the best of you:"
                            },
                            {
                                "example_id": "37ed6104-6b74-4db8-96c6-8033ba2df705",
                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                "text": "And now, / This ornament [i.e. beard] / Makes me look dismal will I clip to form; / And what this fourteen years no razor touch’d, / To grace thy marriage-day, I’ll beautify."
                            },
                            {
                                "example_id": "5857cc87-62aa-434b-b039-ca4511692acb",
                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                "text": "[…] she was at the other end of the room, beautifying a nosegay;"
                            },
                            {
                                "example_id": "2b10e7b6-40fe-416e-934e-d02b33e49b36",
                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                "text": "“[…] I’m so thankful for friendship. It beautifies life so much.”"
                            },
                            {
                                "example_id": "d0820470-4eec-4b09-a3ec-61d235358fbf",
                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                "text": "‘Boy, you take a big chance,’ Moses say. ‘Them pigeons there to beautify the park, not to eat. The people over here will kill you if you touch a fly.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "2b9dc3bb-ad79-330b-9148-f5a6783e02cb",
                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                        "glosses": [
                            "To become beautiful."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a6368553-1882-4b16-85da-4124b2ee8036",
                                "sense_id": "2b9dc3bb-ad79-330b-9148-f5a6783e02cb",
                                "text": "[…] it must be a Prospect pleasing to God himself, to see his Creation for ever beautifying in his Eyes, and drawing nearer to him, by greater Degrees of Resemblance."
                            }
                        ]
                    },
                    {
                        "sense_id": "c55edcf8-f384-327b-96c1-784c9f96de6a",
                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                        "glosses": [
                            "To make oneself beautiful."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8a206b79-e99d-49eb-b6ca-c38ca73d18ff",
                                "sense_id": "c55edcf8-f384-327b-96c1-784c9f96de6a",
                                "text": "She’d felt silly when she first put cucumbers on her eyes (to diminish puffiness), or oatmeal on her face (to cleanse the pores and absorb excess oils), or egg yolks in her hair (to make it shine). Her use of groceries had even made my mother laugh, then wonder if she should start to beautify."
                            }
                        ]
                    },
                    {
                        "sense_id": "9923df19-d00d-35eb-b438-2d5586828879",
                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                        "glosses": [
                            "Synonym of pretty-print."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb543c74-6afb-452e-ab68-7aaab92fbebe",
                        "source_entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                        "source_sense_description": "to make beautiful or more beautiful",
                        "target_lang_word": "krášlit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krášlit",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d8365241-26db-3436-906b-2df42f046c52",
                                        "entry_id": "6ff88be7-d9d6-32a3-ac9a-f1ff5570bb55",
                                        "glosses": [
                                            "činit více krásným, přitažlivějším pro zrak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9706de93-dcc2-4139-8f4f-06ce6cd6540a",
                                                "sense_id": "d8365241-26db-3436-906b-2df42f046c52",
                                                "text": "Já jsem holič, kdo je víc? Češu vlasy, krášlím líc / a ostatní holiči, ti se po mně opičí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3929b1d1-c95b-47f6-a3eb-114ba4d2307b",
                        "source_entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                        "source_sense_description": "to make beautiful or more beautiful",
                        "target_lang_word": "embellir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embellir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e7fd5b2-55ea-3e77-9845-9f8abcabda49",
                                        "entry_id": "6eb0e5f0-55af-3937-8d67-fbccb4b9ebe1",
                                        "glosses": [
                                            "Rendre plus beau."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "846aa40e-e287-44a9-8b3a-6423e8bdaf6b",
                                                "sense_id": "6e7fd5b2-55ea-3e77-9845-9f8abcabda49",
                                                "text": "Le maquignon de bas étage […] travaille les oreilles, souffle les salières, burine les dents, place une queue postiche, taille les sabots, mastique les seimes, donne un coup de pinceau, refait une jeunesse, farde, corrige, embellit ; […]."
                                            },
                                            {
                                                "example_id": "21e684e0-cf85-47a6-9cc4-f0519355b13e",
                                                "sense_id": "6e7fd5b2-55ea-3e77-9845-9f8abcabda49",
                                                "text": "Les Allemands ont considérablement embelli Strasbourg et nombre d’Alsaciens préféraient l’organisation allemande au laisser-aller français."
                                            },
                                            {
                                                "example_id": "84dd51cc-210f-49d2-ac78-4015c4f42ed7",
                                                "sense_id": "6e7fd5b2-55ea-3e77-9845-9f8abcabda49",
                                                "text": "Et puis, je continuais à embellir ma maison : je remplissais des jardinières et j’exposais des potées de couleurs vives. Les lilas plantés par Sam étaient en fleur à présent et, l’un dans l’autre, la vie était belle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "647c84fe-8069-31c4-b60d-264d23d7a423",
                                        "entry_id": "6eb0e5f0-55af-3937-8d67-fbccb4b9ebe1",
                                        "glosses": [
                                            "Rendre plus agréable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36faf4d8-db8f-4887-b73b-74912960b007",
                                                "sense_id": "647c84fe-8069-31c4-b60d-264d23d7a423",
                                                "text": "Les lèvres douces pénétraient Raoul d’une langueur infinie. Toute la volupté et tout le désir embellissaient cette compassion dangereuse qui amollit la volonté des hommes."
                                            },
                                            {
                                                "example_id": "e8ca62e6-9084-488a-8b99-4254d6a27119",
                                                "sense_id": "647c84fe-8069-31c4-b60d-264d23d7a423",
                                                "text": "Il y a là une forme subtile de ce à quoi les militantes féministes ont donné le nom de « phallocratie », comme si le mâle avait acquis la créature qu'il exhibe dans une vente aux enchères et désirait qu'on le congratulât pour cette bonne affaire grâce à laquelle son existence va être tout embellie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c2e773a-33ec-364a-8472-269bf99d62aa",
                                        "entry_id": "6eb0e5f0-55af-3937-8d67-fbccb4b9ebe1",
                                        "glosses": [
                                            "ou Devenir plus beau."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "pronominal",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837e46a5-58ed-4e3a-b1cd-6b1977c2b85f",
                                                "sense_id": "1c2e773a-33ec-364a-8472-269bf99d62aa",
                                                "text": "Au milieu de ces études si attachantes, le champ du travail s'ouvrait, s’embellissait tous les jours devant moi."
                                            },
                                            {
                                                "example_id": "b48b1274-3177-43d9-8224-a19dd7d3402c",
                                                "sense_id": "1c2e773a-33ec-364a-8472-269bf99d62aa",
                                                "text": "— En Chaouïa, dès 1904, Settat, puis Dar Ber-Rechid avaient été mis à sac par les tribus, et, depuis lors, l’insécurité n’avait fait que croître et embellir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b646aa21-7835-3819-a3ff-ae6370784928",
                                        "entry_id": "6eb0e5f0-55af-3937-8d67-fbccb4b9ebe1",
                                        "glosses": [
                                            "Enjoliver une situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b77301a4-a493-4b7d-bca4-115e6fb4d407",
                                                "sense_id": "b646aa21-7835-3819-a3ff-ae6370784928",
                                                "text": "Peut-être avait-il quelque peu embelli sa relation avec le ministre de l’Intérieur en faisant allusion à une amitié et à une intimité qui, pour l’instant, n’existaient pas, mais on n’a rien sans rien, comme l’avait dit un jour un homme sage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffacd746-affe-4b9c-91ff-c298c03143a3",
                        "source_entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
