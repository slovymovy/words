                        "glosses": [
                            "A building (or portion thereof) on a dairy farm where milk is collected, cooled, and stored temporarily, pending sale and shipment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2be956-962b-4657-89b4-44e555e33926",
                                "sense_id": "2b9aab41-d001-3f01-a550-627606ce9a53",
                                "text": "The milkhouse should be well insulated so that a minimum amount of heat will be needed during winter."
                            },
                            {
