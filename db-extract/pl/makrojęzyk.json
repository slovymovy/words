                    {
                        "translation_id": "b4cc13bd-ec3a-4ed2-be87-3f8497344b3b",
                        "source_entry_id": "92e38c81-85f6-3c0c-bef6-8d447cfae1a6",
                        "source_sense_id": "b237c932-990c-397a-9827-e64ca7e29756",
                        "target_lang_word": "macrolangue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macrolangue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38b974f5-6cac-304e-b7e9-14491313ffbe",
                                        "entry_id": "5b30aca3-3ad6-3572-9920-3209cb7cfdbe",
                                        "glosses": [
                                            "Groupe linguistique, d’importance variable, composé de plusieurs langues, dialectes ou parlers divers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385ae44f-b48a-40da-91c0-9db7fd8e7831",
                                                "sense_id": "38b974f5-6cac-304e-b7e9-14491313ffbe",
                                                "text": "Le kla-dan est une des variétés de la macrolangue dan."
                                            },
                                            {
                                                "example_id": "2c394037-4e74-45c6-98ff-7753e4ffce85",
                                                "sense_id": "38b974f5-6cac-304e-b7e9-14491313ffbe",
                                                "text": "D’après Ethnologue, il s’agit d’une macrolangue, car elle comporte plusieurs groupes de dialectes pouvant chacun être considéré comme une langue distincte."
                                            },
                                            {
                                                "example_id": "18f8631a-678a-446b-9c58-1d39557b8ae3",
                                                "sense_id": "38b974f5-6cac-304e-b7e9-14491313ffbe",
                                                "text": "L’argument présidant à l’instauration d’une macrolangue chinoise est donc que tous les chinois ont un système graphique commun. Mais la macrolangue serbo-croate (comprent le bosniaque, le croate et le serbe) n’est pas dans ce cas : le croate s’écrit en alphabet latin, le serbe en cyrillique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "666f0a14-50aa-4e37-8738-e577497f3cf9",
                        "source_entry_id": "92e38c81-85f6-3c0c-bef6-8d447cfae1a6",
                        "source_sense_id": "b237c932-990c-397a-9827-e64ca7e29756",
