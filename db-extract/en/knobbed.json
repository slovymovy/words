                        "glosses": [
                            "Having a knob or knobs."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0d399b8-75c0-4f8c-afd4-6b38a6735239",
                                "sense_id": "66aa3c02-d1e9-38be-b9e4-a87bc0806647",
                                "text": "a knobbed chromosome"
                            },
                            {
                                "example_id": "64eea107-ad2c-497c-bdfc-3d900f817feb",
                                "sense_id": "66aa3c02-d1e9-38be-b9e4-a87bc0806647",
                                "text": "1774, Oliver Goldsmith, An History of the Earth, and Animated Nature, London: J. Nourse, Volume 4, Chapter 11, The Camelopard, pp. 299-300,\nNo animal, either from its disposition, or its formation, seems less fitted for a state of natural hostility; its horns are blunt, and even knobbed at the ends; its teeth are made entirely for vegetable pasture […]"
                            },
                            {
                                "example_id": "fe6b6997-4ac0-40bc-8fc8-aad4a53d321d",
                                "sense_id": "66aa3c02-d1e9-38be-b9e4-a87bc0806647",
                                "text": "The chairs […] were railed with white bars across the back and knobbed with gold; neither the railings nor the knobs invited to ease."
                            },
                            {
                                "example_id": "0ee18660-af0d-4b15-8d74-ac8cc2676d45",
                                "sense_id": "66aa3c02-d1e9-38be-b9e4-a87bc0806647",
                                "text": "For it's been a hard life, thought Mrs. Dempster. What hadn’t she given to it? Roses; figure; her feet too. (She drew the knobbed lumps beneath her skirt.)"
                            }
                        ]
                    }
