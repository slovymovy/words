                "senses": [
                    {
                        "sense_id": "15543cea-27d5-3b14-8646-cec007124e39",
                        "entry_id": "ba4b3acb-72f7-3d3d-8b6d-afd6dffaa3bb",
                        "glosses": [
                            "een stout, lastig en/of zeer zelfingenomen kind; bij uitbreiding ook gebruikt voor pubers en (jong)volwassenen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "27b68777-b8d5-467d-a131-e643f3ce0611",
                                "sense_id": "15543cea-27d5-3b14-8646-cec007124e39",
                                "text": "- Verstappen kreeg na de race een tijdstraf van vijf seconden voor zijn actie en werd daarmee teruggezet naar plek vijf. Lege handen en weer een deukje in zijn reputatie, al zullen vooral zijn criticasters bevestiging hebben gezien voor wat zij al een tijd vinden: enorm talent, maar wat een blaag kan het zijn."
                            },
                            {
                                "example_id": "f038aee7-1b58-4386-807c-d25f6fb3d352",
                                "sense_id": "15543cea-27d5-3b14-8646-cec007124e39",
                                "text": "- Toegegeven, de rente op de kapitaalmarkt is wel eens nóg lager geweest. Maar kijk toch eens naar die Nederlandse dertigjarige staatsobligatie die afloopt in 2037: het rendement van die lening, en dus de rente die wordt gevangen als hij nu zou worden aangeschaft, bedraagt slechts 4 procent. Dat is verbluffend laag, zeker gezien de looptijd van dertig jaar. Zelfs de jonge blaag die nu vers uit de collegebanken aanschuift in de dealingroom van een grote bank is tegen die tijd een grijzende vijftiger geworden, met zijn pensionering al in het vooruitzicht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2644c7e-eece-423c-9479-22cad1cea223",
                        "source_entry_id": "ba4b3acb-72f7-3d3d-8b6d-afd6dffaa3bb",
                        "source_sense_id": "15543cea-27d5-3b14-8646-cec007124e39",
                        "source_sense_description": "een stout en lastig kind",
                        "target_lang_word": "brat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c7a22a0-eff4-373d-8f7e-b530840ff78b",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A human child."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e581643-8f1c-4765-96e4-4923653a0ae6",
                                                "sense_id": "0c7a22a0-eff4-373d-8f7e-b530840ff78b",
                                                "text": "\"So... you want to have kids someday?\" \"Uh... well, yes. I always figured I'd have a couple brats of my own someday...\" \"That's still doable, you know.\" \"I know, but the process is a lot more complicated and less intimate, and --\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65d2fa8-56fc-3254-928b-87aad611ebd6",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A human child.",
                                            "A child who is regarded as mischievous, unruly, spoiled, or selfish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b9b7415-8c31-4914-bd07-302d7371c512",
                                                "sense_id": "a65d2fa8-56fc-3254-928b-87aad611ebd6",
                                                "text": "a spoiled brat"
                                            },
                                            {
                                                "example_id": "5b23e04f-7b65-45eb-af08-6286b80042f3",
                                                "sense_id": "a65d2fa8-56fc-3254-928b-87aad611ebd6",
                                                "text": "Get that little brat away from me!"
                                            },
                                            {
                                                "example_id": "b2836d38-1315-4e72-bd3d-ba68bcdf03fb",
                                                "sense_id": "a65d2fa8-56fc-3254-928b-87aad611ebd6",
                                                "text": "He would never speak a word, - only eat and cry, and she hadn't the heart to strike it or illtreat the youngster either; but somebody taught her a charm to make him speak, and then she found out what kind of a brat he really was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4db66ed-9cfb-35f1-b86d-316d89143211",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A human child.",
                                            "The qualities possessed by a confident and assertive woman."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66caa190-d614-4d0e-97dd-f425890630b3",
                                                "sense_id": "a4db66ed-9cfb-35f1-b86d-316d89143211",
                                                "text": "Here are the people and the styles at the DNC that embodied the brat ethos."
                                            },
                                            {
                                                "example_id": "24906a0a-6b9a-4695-8402-0e0d2de27ca7",
                                                "sense_id": "a4db66ed-9cfb-35f1-b86d-316d89143211",
                                                "text": "Brat is being lazy until 10 P.M., at which point you construct a château using discarded scraps of pleather, finish it by morning, and immediately win the Pritzker Architecture Prize."
                                            },
                                            {
                                                "example_id": "08572c7b-074a-4665-87bc-2712819ea9ba",
                                                "sense_id": "a4db66ed-9cfb-35f1-b86d-316d89143211",
                                                "text": "My favorite touch is how each of her Nike shoes has its own little bow, which is just the perfect amount of brat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4947bd35-ea68-3105-9fbf-a15aed3c1b61",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A human child.",
                                            "A child (at any age) of an active member of the military or the diplomatic service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e217ff97-c611-4440-b561-954b399b81ff",
                                                "sense_id": "4947bd35-ea68-3105-9fbf-a15aed3c1b61",
                                                "text": "an army brat"
                                            },
                                            {
                                                "example_id": "9773cc10-e681-40ce-b654-541f60863c83",
                                                "sense_id": "4947bd35-ea68-3105-9fbf-a15aed3c1b61",
                                                "text": "Lt. Gen. John L. DeWitt, Commander of the Fourth Army, was an army “brat,” which means his father was an army officer. But he went into the army from Princeton, not from West Point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9237c66-021e-3042-bb27-4b66365cccd4",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A human child.",
                                            "A submissive partner who is disobedient and unruly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5460f54e-4fbc-3ed4-adf9-73e6dec0ae55",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A turbot or flatfish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acaa50b2-f6af-4ed3-ba8c-d20ad39f87c7",
                                                "sense_id": "5460f54e-4fbc-3ed4-adf9-73e6dec0ae55",
                                                "text": "For the crabby awd dealers in ling, cod, and brats / And the vurgins that tempt us wi' nice maiden skyet..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e815d6c-90d0-3c5f-baf0-72573eb7389c",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A rough cloak or ragged garment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61a62c1a-d40d-4afd-b79e-bc18b2ac435c",
                                                "sense_id": "2e815d6c-90d0-3c5f-baf0-72573eb7389c",
                                                "text": "The chief's daughter wears a brat and léine girdled with a criss."
                                            },
                                            {
                                                "example_id": "519b83c9-c7b2-451f-8423-cd9ab88d65fb",
                                                "sense_id": "2e815d6c-90d0-3c5f-baf0-72573eb7389c",
                                                "text": "The prevailing style of dress in the early medieval period comprised a léine (tunic) worn under a brat (cloak)."
                                            },
                                            {
                                                "example_id": "6138295d-1331-4da4-988c-79ba811c321c",
                                                "sense_id": "2e815d6c-90d0-3c5f-baf0-72573eb7389c",
                                                "text": "Women wore loose, flowing, ankle-length robes modelled on 11th-century European fashion (derived from what O'Neill called the léine) and, perhaps, a brat over these."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4449a1a-ca67-3edf-86e4-298d302b3a25",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "A coarse kind of apron for keeping the clothes clean; a bib."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79aeb8b6-1962-4b62-8265-454a1d71b94b",
                                                "sense_id": "d4449a1a-ca67-3edf-86e4-298d302b3a25",
                                                "text": "[She] had still on the rough worsted apron of nappy homespun wool, called a \"brat\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "562ea311-5ebb-3bc8-8d76-a93afe04bc6e",
                                        "entry_id": "0ecdcb63-bafe-322c-b9c6-c5159864a2d4",
                                        "glosses": [
                                            "The young of an animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092cb513-201b-4cf7-af4c-be87637c43a6",
                                                "sense_id": "562ea311-5ebb-3bc8-8d76-a93afe04bc6e",
                                                "text": "Their ſhoulders broad, for complet armour fit,\nTheir lims more large and of a bigger ſize\nThan all the brats yſprong from Typhons loins:"
                                            },
                                            {
                                                "example_id": "a2b6adb2-85d3-42b0-938a-ce2b3037fb79",
                                                "sense_id": "562ea311-5ebb-3bc8-8d76-a93afe04bc6e",
                                                "text": "They are your Will-Worship-men, your Prelates Brats: Take the whole Litter of’um, and you’ll finde never a barrel better Herring."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c20c6fc-2d95-3e3f-b7fe-8541d460d5c3",
                                        "entry_id": "4874400c-240a-3156-a231-b6697187c1cd",
                                        "glosses": [
                                            "To act in a bratty manner as the submissive."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c4aacf-3224-4b81-821e-23668e6a14ad",
                                                "sense_id": "2c20c6fc-2d95-3e3f-b7fe-8541d460d5c3",
                                                "text": "Ruthie was Ed's own submissive, a short, pretty, feisty ash-blonde New York City native who combined her submission to Ed with a good deal of mischievous bratting and a lot of sharp, intelligent conversation […]"
                                            },
                                            {
                                                "example_id": "7803ca47-6d2d-49ed-a53a-17909b2c8c7e",
                                                "sense_id": "2c20c6fc-2d95-3e3f-b7fe-8541d460d5c3",
                                                "text": "Rather, Ana moves between playful bratting and a type of “conquer me” wantedness that good Dominants would respond to with increased control and correction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "627f6782-f985-3ea5-84ac-6f51e52ee732",
                                        "entry_id": "1ea1d4ed-783f-36e7-8f2e-b19b93c939c9",
                                        "glosses": [
                                            "Characteristic of a confident and assertive woman."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "316840ee-e20d-49ba-8eb5-dffb9df55e38",
                                                "sense_id": "627f6782-f985-3ea5-84ac-6f51e52ee732",
                                                "text": "kamala IS brat"
                                            },
                                            {
                                                "example_id": "3c6a865d-3b40-4d05-b62c-67be81f3c09a",
                                                "sense_id": "627f6782-f985-3ea5-84ac-6f51e52ee732",
                                                "text": "Starmer's Tory predecessors Rishi Sunak and Liz Truss were identified as brat by 15 percent each of those asked."
                                            },
                                            {
                                                "example_id": "d3f0298a-3793-4ab1-adc4-6b8e46d239f3",
                                                "sense_id": "627f6782-f985-3ea5-84ac-6f51e52ee732",
                                                "text": "Kamala Harris herself was anointed as \"brat\" the moment that Joe Biden stepped down, but already Harris's mother – who had Indian heritage and raised Harris as a single parent – has been declared the uberbrat, more brat than even her daughter."
                                            },
                                            {
                                                "example_id": "ee0891b3-9a38-4ac0-a9dd-eca263e9411c",
                                                "sense_id": "627f6782-f985-3ea5-84ac-6f51e52ee732",
                                                "text": "[see title]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc36f6d5-59cb-3ca7-8184-730fd2843807",
                                        "entry_id": "c0d9ff7d-3dbc-3676-92c4-074d5da89b70",
