                ],
                "senses": [
                    {
                        "sense_id": "cef17746-4ba5-3794-96b5-fcd065b26014",
                        "entry_id": "dec0d26e-cbac-3a48-88f6-6a3108eede38",
                        "glosses": [
                            "Celle qui protège."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc2f246b-d8df-4b87-a809-27b8f2a8f8fc",
                                "sense_id": "cef17746-4ba5-3794-96b5-fcd065b26014",
                                "text": "Je me trouve une espèce d’héroïsme dans le cœur, puisque j’ai le courage de partir après la lettre de ma protectrice."
                            },
                            {
                                "example_id": "24e9f895-61fd-41fe-97ef-28c768af28b6",
                                "sense_id": "cef17746-4ba5-3794-96b5-fcd065b26014",
                                "text": "De tout temps, en effet, la fille, héroïne de tant de vieux romans, fut la protectrice, la compagne, la consolation du grec, du voleur, du tire-laine, du filou, de l’escroc."
                            },
                            {
                                "example_id": "98bd9b5a-d799-4d5d-baf9-fb41eb3604fc",
                                "sense_id": "cef17746-4ba5-3794-96b5-fcd065b26014",
                                "text": "Aux États-Unis, le baudet du Poitou a trouvé une grande protectrice en la personne d’une certaine Debbie Hamilton, qui l’a introduit dans les années 1980."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76bee850-16a5-4c85-b267-5ae4e92a64ee",
                        "source_entry_id": "dec0d26e-cbac-3a48-88f6-6a3108eede38",
                        "source_sense_id": "cef17746-4ba5-3794-96b5-fcd065b26014",
                        "target_lang_word": "Beschützerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschützerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1c2ddfd-cc76-391f-946d-bb6610a63c38",
                                        "entry_id": "f0a834fb-a274-32a2-9b0d-e585c5723975",
                                        "glosses": [
                                            "eine weibliche Person, die eine andere Person oder eine Sache in Schutz nimmt, unterstützt und hilft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0ea4c4-8ad5-40ed-b0c0-b5806fdd3907",
                                                "sense_id": "f1c2ddfd-cc76-391f-946d-bb6610a63c38",
                                                "text": "Krumine ist die Beschützerin des Ackerbaues und der Erfindungen."
                                            },
                                            {
                                                "example_id": "d541da6a-04d9-4a74-acc9-62d038fd5a80",
                                                "sense_id": "f1c2ddfd-cc76-391f-946d-bb6610a63c38",
                                                "text": "„Als ich erschöpft in dem Walde auf Moos hinsank und in Verzweiflung in die Nacht hinausschaute, da erschienst du mir, Hulda und gabst dich mir als meine Beschützerin zu erkennen.“"
                                            },
                                            {
                                                "example_id": "3eb8bb44-90af-4bf5-b59d-5bff5f818786",
                                                "sense_id": "f1c2ddfd-cc76-391f-946d-bb6610a63c38",
                                                "text": "„Meine Beschützerin verabschiedet sich von mir wie von einem Sohn, mit Tränen in den Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7968cd1d-1707-4ef5-9293-fa87a8208850",
                        "source_entry_id": "dec0d26e-cbac-3a48-88f6-6a3108eede38",
