                    "sense_id": "21c575a2-8a4a-337d-a6d0-46f4e126602a",
                    "sense_definition": "Een zwemeend met een lange puntige staart die als trekvogel leeft",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het natuurgebied zwom een prachtige <w>pijlstaart</w> tussen de andere eenden.",
                            "target_lang_translations": {
                                "en": "In the nature reserve, a beautiful <w>pintail</w> swam among the other ducks."
                            }
                        },
                        {
                            "text": "De <w>pijlstaart</w> is een trekvogel die in de winter naar het zuiden vliegt.",
                            "target_lang_translations": {
                                "en": "The <w>pintail</w> is a migratory bird that flies south in the winter."
                            }
                        }
                    ],
                    "synonyms": [
                        "pijlstaarteend"
                    ],
                    "common_phrases": [
                        "een zwemmende pijlstaart"
                    ],
                    "target_lang_definitions": {
                        "en": "A dabbling duck with a long pointed tail that lives as a migratory bird"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pintail",
                                "target_lang_sense_clarification": "the duck species"
                            },
                            {
                                "target_lang_word": "northern pintail",
                                "target_lang_sense_clarification": "specific species name"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c772c65c-5928-3eee-a780-bc6920b1cbe8",
                    "sense_definition": "Een vlinder behorend tot de familie van de Sphingidae",
