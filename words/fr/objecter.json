    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2490b8ed-5ea1-3e2c-a22b-fe92dcaa1e2b",
                    "sense_definition": "Opposer un argument, une raison ou une affirmation à ce qui vient d'être énoncé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à ces nouvelles propositions, le directeur préféra ne rien <w>objecter</w> immédiatement."
                        },
                        {
                            "text": "Plusieurs spécialistes <w>objectent</w> que cette solution théorique risque d'échouer dans la pratique."
                        }
                    ],
                    "common_phrases": [
                        "ne rien objecter",
                        "objecter que"
                    ]
                },
                {
                    "sense_id": "9c4fb922-0411-3d7f-95bf-7d96d3b7d480",
                    "sense_definition": "Faire valoir une difficulté, un empêchement ou un prétexte pour repousser une demande.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "empêchement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lorsqu'il a postulé pour cet emploi, on lui a <w>objecté</w> son manque d'expérience sur le terrain."
                        },
                        {
                            "text": "Elle a tenté d'<w>objecter</w> un empêchement de dernière minute pour éviter cette invitation formelle."
                        }
                    ],
                    "synonyms": [
                        "alléguer"
                    ],
                    "common_phrases": [
                        "objecter un prétexte",
                        "objecter la fatigue"
                    ]
                }
            ]
        }
    ]
