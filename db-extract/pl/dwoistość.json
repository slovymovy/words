                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b7a8715-832f-49df-87f7-d47f1ac26f1d",
                                "sense_id": "30dccdba-67f5-30ad-a1cc-f71bf50ad30d",
                                "text": "Niektóre zgromadzenia katarskie stosowały taki dualizm do każdej rzeczywistości, przez co dochodzili do przedkładania dwoistości proroków, dwoistej postaci Chrystusa i w końcu dwoistego Początku."
                            }
