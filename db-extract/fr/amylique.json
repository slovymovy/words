                        "glosses": [
                            "Qualifie une substance qui renferme le groupement amyle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb3480c-f9e2-4a18-8a0b-ffb57f144d95",
                                "sense_id": "95ab8a01-d209-33ae-af7a-cfc61f65f0ad",
                                "text": "alcool amylique, alcool obtenu par fermentation de la fécule de pomme de terre ou de céréales."
                            },
                            {
                                "example_id": "806bc704-6c9a-4c16-83c7-b30fd655d6ee",
                                "sense_id": "95ab8a01-d209-33ae-af7a-cfc61f65f0ad",
                                "text": "La masse pâteuse ainsi obtenue est ensuite mélangée avec de l’alcool éthylique, méthylique, butylique, amylique, de l’ammoniaque, de la soude caustique, de la potasse, du borax, des carbonates alcalins… — n’en jetez plus ! —, pour en faire une chouette gomme d’enrobage, de couleur orangée ou blond doré."
                            }
                        ]
                    }
