                                    {
                                        "sense_id": "5dca5244-a005-34f1-88ec-04f05a036344",
                                        "entry_id": "1b81c322-20c2-3602-969a-6c6c09562a9d",
                                        "glosses": [
                                            "Base, point de départ, stimulus initial pour une réflexion, une discussion, un débat ou tout autre développement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8553a4cc-3716-46cb-b865-76c8d31894b9",
                                                "sense_id": "5dca5244-a005-34f1-88ec-04f05a036344",
                                                "text": "La deuxième partie du texte proposera ainsi des pistes de réflexion pour préparer la défense de cours CCQ dans une telle perspective."
                                            },
                                            {
                                                "example_id": "9bdf28a2-495c-4f0f-a9a5-abad5812d58d",
                                                "sense_id": "5dca5244-a005-34f1-88ec-04f05a036344",
                                                "text": "Il incombe au promoteur de faire preuve d'imagination quant aux solutions de construction en utilisant toutes les opportunités de réduction des coûts de mise en œuvre. Une mutualisation des coûts avec d’autres travaux de fouilles, comme par exemple la pose de fibre optique, constitue une bonne piste de réflexion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
