                                "target_senses": [
                                    {
                                        "sense_id": "17b0db30-052e-34f0-a043-c045fd04ddc9",
                                        "entry_id": "9c2ad43c-ea93-33aa-810f-6bbb11d8f284",
                                        "glosses": [
                                            "Destruction de la culture, de la civilisation d’un groupe humain, sans viser l’élimination physique de ce groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd71fcb7-1bae-4a5b-b312-a15e6a9bc32c",
                                                "sense_id": "17b0db30-052e-34f0-a043-c045fd04ddc9",
                                                "text": "Les Américains se sont livrés à un ethnocide systématique des Amérindiens."
                                            },
                                            {
                                                "example_id": "8312d85c-b860-4e05-aec6-8f91bc9951c9",
                                                "sense_id": "17b0db30-052e-34f0-a043-c045fd04ddc9",
                                                "text": "Entre 1642 et 1649 périront ainsi les prétendus martyrs canadiens, Brébeuf, Garnier, Jogues, Lalemant, Lalande, Daniel et Goupil, fer de lance de l’entreprise d’ethnocide que les Anglais transformeront en génocide après avoir fait des Iroquois leurs dupes préférées, ceux-ci les débarrassant des Hurons qu’ils massacrent en même temps que les Français leurs alliés."
                                            },
                                            {
                                                "example_id": "22cdc269-c650-4430-9d12-813ecee20061",
                                                "sense_id": "17b0db30-052e-34f0-a043-c045fd04ddc9",
                                                "text": "La destruction des systèmes de réciprocité africains par la colonisation et la généralisation de la domination du marché capitaliste conduisent à l’ethnocide, à l’« économicide » et au génocide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
