                "senses": [
                    {
                        "sense_id": "dace27eb-4f92-35ae-898b-2392868ade03",
                        "entry_id": "bbaa217b-2c91-3371-9253-aa93adddb49a",
                        "glosses": [
                            "in freier Wildbahn lebende und auch meist geborene Ente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346558ba-f2e0-4f47-9933-14125314aab6",
                                "sense_id": "dace27eb-4f92-35ae-898b-2392868ade03",
                                "text": "„In Wildenten erfolgt die Vermehrung von Influenza-A-Viren in Lunge und Darmtrakt, und die Viren werden in hohen Konzentrationen über die Kloake ausgeschieden.“"
                            },
                            {
                                "example_id": "6ede57de-f84e-4016-a229-468b76a87c43",
                                "sense_id": "dace27eb-4f92-35ae-898b-2392868ade03",
                                "text": "„Überall watschelten Wildenten umher, Pelikane, Wasserhühner, Rotschnäbel, Phildeons mit ihren Pinselzungen und ein paar Leierschwänze mit schillernden Schwanzfedern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
