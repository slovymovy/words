{
    "word_family": [
        "rig",
        "rigging",
        "rigger"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6f5ce16a-77c9-356d-892d-e1c9232999d6",
                    "sense_definition": "Prearranged and fixed so that the winner or outcome is decided in advance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonest manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many voters stayed home because they believed the entire election was <w>rigged</w> by the ruling party.",
                            "target_lang_translations": {
                                "ru": "Многие избиратели остались дома, так как верили, что все выборы были <w>сфальсифицированы</w> правящей партией."
                            }
                        },
                        {
                            "text": "The investigation revealed a <w>rigged</w> system where only a few wealthy individuals could ever win the contracts.",
                            "target_lang_translations": {
                                "ru": "Расследование выявило <w>подстроенную</w> систему, в которой только несколько богатых людей могли выигрывать контракты."
                            }
                        }
                    ],
                    "synonyms": [
                        "stacked"
                    ],
                    "antonyms": [
                        "fair",
                        "honest",
                        "legitimate"
                    ],
                    "common_phrases": [
                        "rigged system",
                        "rigged election",
                        "rigged game"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее подготовленный или подстроенный таким образом, чтобы результат был определен заранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстроенный",
                                "target_lang_sense_clarification": "о результатах или событиях"
                            },
                            {
                                "target_lang_word": "сфальсифицированный",
                                "target_lang_sense_clarification": "о выборах или документах"
                            },
                            {
                                "target_lang_word": "купленный",
                                "target_lang_sense_clarification": "о матчах или судьях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b345fd1-d3b5-3ddc-a22c-80d16fa24bc7",
                    "sense_definition": "Equipped with the necessary ropes, sails, and masts for sailing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maritime equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain confirmed that the ship was fully <w>rigged</w> and ready to depart at dawn.",
                            "target_lang_translations": {
                                "ru": "Капитан подтвердил, что судно было полностью <w>оснащено</w> и готово к отплытию на рассвете."
                            }
                        },
                        {
                            "text": "A properly <w>rigged</w> vessel can withstand much stronger winds than one with loose equipment.",
                            "target_lang_translations": {
                                "ru": "Правильно <w>оснащенное</w> судно может выдержать гораздо более сильные ветры, чем судно с незакрепленным оборудованием."
                            }
                        }
                    ],
                    "antonyms": [
                        "unrigged"
                    ],
                    "common_phrases": [
                        "fully rigged",
                        "properly rigged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащенный необходимым такелажем, парусами и мачтами для плавания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оснащённый",
                                "target_lang_sense_clarification": "о судне с такелажем"
                            },
                            {
                                "target_lang_word": "с полным парусным вооружением",
                                "target_lang_sense_clarification": "о корабле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a0206e5-ad71-32e9-929d-3881b71a3fb5",
                    "sense_definition": "simple past and past participle of <w>rig</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician <w>rigged</w> a temporary lighting system for the outdoor stage.",
                            "target_lang_translations": {
                                "ru": "Техник <w>соорудил</w> временную систему освещения для открытой сцены."
                            }
                        },
                        {
                            "text": "They <w>rigged</w> the results of the competition to ensure their favorite candidate won.",
                            "target_lang_translations": {
                                "ru": "Они <w>подстроили</w> результаты конкурса, чтобы обеспечить победу своему любимому кандидату."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола 'rig' (сооружать, подстраивать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соорудил",
                                "target_lang_sense_clarification": "наспех или временно"
                            },
                            {
                                "target_lang_word": "подстроил",
                                "target_lang_sense_clarification": "результаты или исход"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}