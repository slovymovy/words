                        "target_lang_word": "ophrys",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ophrys",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d1eca8f-416d-3dd6-b052-62d524886440",
                                        "entry_id": "fb563b0c-1aae-3541-a57e-d23884542ebc",
                                        "glosses": [
                                            "Genre d'orchidées terrestres euroméditerranéennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb5e25b-296a-47ce-90f5-a6efe5316d6e",
                                                "sense_id": "9d1eca8f-416d-3dd6-b052-62d524886440",
                                                "text": "Les ophrys sont des plantes herbacées à 2 ou 3 tubercules, avec des feuilles en rosette basale et une hampe florale à peu de fleurs aux sépales et pétales latéraux étalés, au labelle sans éperon, avec une partie glabre et une partie poilue…"
                                            },
                                            {
                                                "example_id": "ce98951b-56ba-4fd0-9642-1a1d07d7341a",
                                                "sense_id": "9d1eca8f-416d-3dd6-b052-62d524886440",
                                                "text": "Certains insectes mâles sont attirés par la forme, les couleurs et l'odeur (phéromones) des fleurs d'ophrys et essaient de copuler les labelles, assurant par là la pollinisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
