                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb7e50b4-8349-41d9-a5a4-dc6230158776",
                                "sense_id": "a4e3aa6f-6b75-3ef9-9784-52b525b9dcec",
                                "text": "„Am Nachmittag des 25. Juni bombardierte die CIA den Exerzierplatz des größten Militärlagers in Guatemala-Stadt.“"
                            },
                            {
                                "example_id": "fafe1835-7a9b-4e79-a33e-2509cfead3e9",
                                "sense_id": "a4e3aa6f-6b75-3ef9-9784-52b525b9dcec",
                                "text": "„In der Sowjetunion äußerte die regierungsamtliche Prawda den Verdacht, Thomas Gray sei von der CIA entführt worden, weil sie intime Kenntnis von neuen mathematischen Methoden der Verschlüsselung besitze.“"
                            },
                            {
                                "example_id": "5c290c28-6895-4bb6-847b-687f68dcf7da",
                                "sense_id": "a4e3aa6f-6b75-3ef9-9784-52b525b9dcec",
                                "text": "„Noch am selben Tag kennt die CIA das Telegramm.“"
                            },
                            {
                                "example_id": "88311c54-d002-4915-b47a-ef40df598f6a",
                                "sense_id": "a4e3aa6f-6b75-3ef9-9784-52b525b9dcec",
                                "text": "„Irgendwann entdeckt der CIA wahrscheinlich noch, welch furchtbar grausame Dinge man mit einem Wattestäbchen anrichten kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
