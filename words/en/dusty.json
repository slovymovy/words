    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "acaba006-5125-363c-ad0e-8479c5af3fc3",
                    "sense_definition": "Covered with or full of dust.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found a <w>dusty</w> old book in the attic.",
                            "target_lang_translations": {
                                "ru": "Она нашла на чердаке <w>пыльную</w> старую книгу.",
                                "zh": "她在阁楼里发现了一本<w>多尘的</w>旧书。",
                                "es": "Encontró un libro viejo y <w>polvoriento</w> en el ático."
                            }
                        },
                        {
                            "text": "The travelers walked along the <w>dusty</w> road for miles.",
                            "target_lang_translations": {
                                "ru": "Путешественники много миль шли по <w>пыльной</w> дороге.",
                                "zh": "旅行者们在<w>多尘的</w>路上走了好几英里。",
                                "es": "Los viajeros caminaron por el camino <w>polvoriento</w> durante kilómetros."
                            }
                        }
                    ],
                    "synonyms": [
                        "dust-ridden",
                        "dirty"
                    ],
                    "antonyms": [
                        "clean",
                        "polished"
                    ],
                    "common_phrases": [
                        "dusty road",
                        "dusty room",
                        "dusty shelf",
                        "dusty floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый пылью или полный пыли.",
                        "zh": "覆盖着灰尘或充满灰尘的。",
                        "es": "Cubierto de polvo o lleno de él."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыльный",
                                "target_lang_sense_clarification": "покрытый пылью"
                            },
                            {
                                "target_lang_word": "запылённый",
                                "target_lang_sense_clarification": "покрывшийся слоем пыли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多尘的",
                                "target_lang_sense_clarification": "覆盖着灰尘"
                            },
                            {
                                "target_lang_word": "满是灰尘的",
                                "target_lang_sense_clarification": "充满灰尘"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "polvoriento",
                                "target_lang_sense_clarification": "cubierto de polvo"
                            },
                            {
                                "target_lang_word": "polvoroso",
                                "target_lang_sense_clarification": "que tiene mucho polvo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52f365d8-8b77-3520-9deb-9fae014a5ecc",
                    "sense_definition": "Old, outdated, or lacking originality and freshness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor's teaching methods are a bit <w>dusty</w> and need updating.",
                            "target_lang_translations": {
                                "ru": "Методы преподавания профессора немного <w>устарели</w> и требуют обновления.",
                                "zh": "教授的教学方法有点<w>过时</w>了，需要更新。",
                                "es": "Los métodos de enseñanza del profesor están un poco <w>anticuados</w> y necesitan actualizarse."
                            }
                        },
                        {
                            "text": "We need to clear out these <w>dusty</w> files and modernize the system.",
                            "target_lang_translations": {
                                "ru": "Нам нужно разобрать эти <w>запылившиеся</w> архивы и модернизировать систему.",
                                "zh": "我们需要清理这些<w>过时</w>的文件并使系统现代化。",
                                "es": "Necesitamos limpiar estos archivos <w>polvorientos</w> y modernizar el sistema."
                            }
                        }
                    ],
                    "antonyms": [
                        "modern",
                        "fresh",
                        "new"
                    ],
                    "common_phrases": [
                        "dusty ideas",
                        "dusty archives"
                    ],
                    "target_lang_definitions": {
                        "ru": "Старый, устаревший или лишенный новизны.",
                        "zh": "陈旧的、过时的或缺乏新意的。",
                        "es": "Antiguo, anticuado o falto de originalidad y frescura."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устаревший",
                                "target_lang_sense_clarification": "вышедший из моды или употребления"
                            },
                            {
                                "target_lang_word": "старомодный",
                                "target_lang_sense_clarification": "несовременный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过时的",
                                "target_lang_sense_clarification": "陈旧的"
                            },
                            {
                                "target_lang_word": "老掉牙的",
                                "target_lang_sense_clarification": "非常陈旧的"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "anticuado",
                                "target_lang_sense_clarification": "que ha quedado atrás en el tiempo"
                            },
                            {
                                "target_lang_word": "obsoleto",
                                "target_lang_sense_clarification": "que ya no se usa o es ineficaz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e93f7fb-1454-3d5b-8e58-e67ad73c83c7",
                    "sense_definition": "Powdery and resembling dust in texture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moth had large, <w>dusty</w> wings.",
                            "target_lang_translations": {
                                "ru": "У мотылька были большие <w>пыльные</w> крылья.",
                                "zh": "那只飞蛾有着巨大的、<w>粉末状的</w>翅膀。",
                                "es": "La polilla tenía alas grandes y <w>polvorientas</w>."
                            }
                        },
                        {
                            "text": "The soil was dry and <w>dusty</w> after the long drought.",
                            "target_lang_translations": {
                                "ru": "После долгой засухи почва была сухой и <w>пылевидной</w>.",
                                "zh": "长期干旱后，土壤变得干燥且呈<w>粉末状</w>。",
                                "es": "El suelo estaba seco y <w>polvoriento</w> después de la larga sequía."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Порошкообразный, напоминающий пыль по текстуре.",
                        "zh": "质地像粉末或灰尘一样的。",
                        "es": "Que tiene textura de polvo o es pulverulento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порошкообразный",
                                "target_lang_sense_clarification": "похожий на порошок"
                            },
                            {
                                "target_lang_word": "пылевидный",
                                "target_lang_sense_clarification": "мелкий, как пыль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粉末状的",
                                "target_lang_sense_clarification": "像粉末一样"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pulverulento",
                                "target_lang_sense_clarification": "que tiene composición de polvo"
                            },
                            {
                                "target_lang_word": "polvoriento",
                                "target_lang_sense_clarification": "que se deshace en polvo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f938afe0-3ea7-3d6c-b72e-4aaf94c0ac56",
                    "sense_definition": "Having a dull, muted, or greyish color.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She painted the bedroom a <w>dusty</w> pink.",
                            "target_lang_translations": {
                                "ru": "Она покрасила спальню в <w>пепельно</w>-розовый цвет.",
                                "zh": "她把卧室漆成了<w>灰调</w>粉色。",
                                "es": "Pintó el dormitorio de un rosa <w>apagado</w>."
                            }
                        },
                        {
                            "text": "The artist used <w>dusty</w> blues and greens for the landscape.",
                            "target_lang_translations": {
                                "ru": "Художник использовал для пейзажа <w>приглушённые</w> синие и зеленые тона.",
                                "zh": "艺术家在风景画中使用了<w>灰调</w>的蓝色和绿色。",
                                "es": "El artista usó azules y verdes <w>tenues</w> para el paisaje."
                            }
                        }
                    ],
                    "antonyms": [
                        "vibrant",
                        "bright"
                    ],
                    "common_phrases": [
                        "dusty pink",
                        "dusty blue"
