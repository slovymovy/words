                "senses": [
                    {
                        "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                        "entry_id": "6a5fb76d-faea-3b7d-b648-d8788d21315e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a9ef40-2901-4d18-8792-6032d57bb166",
                                "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                                "text": "Frau Schebera ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "55fc041e-8ce7-42e0-b706-b6256e46acc5",
                                "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                                "text": "Herr Schebera wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "39c12d59-4663-463a-a3a7-2b1ef7e979b2",
                                "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                                "text": "Die Scheberas fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f17a2e2d-cb76-44b1-a2c2-1280bef2e0da",
                                "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                                "text": "Der Schebera trägt nie die Schals, die die Schebera ihm strickt."
                            },
                            {
                                "example_id": "86770f72-61f5-4167-916f-1927930ba1e4",
                                "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schebera kommt, geht der Herr Schebera.“"
                            },
                            {
                                "example_id": "366e5380-db37-49e9-8049-2a249b5e2f4b",
                                "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                                "text": "Schebera kommt und geht."
                            },
                            {
                                "example_id": "17ae82f3-e673-4cf7-bd4e-8ce2fd6e087d",
                                "sense_id": "966bd879-5c41-30e5-9ce1-c4fc71a294a4",
                                "text": "Scheberas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
