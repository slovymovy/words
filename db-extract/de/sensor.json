                        "target_lang_word": "sensor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                        "entry_id": "5cc1e4d1-b4a3-3d10-9529-4c5970dfc653",
                                        "glosses": [
                                            "A device or organ that detects certain external stimuli and responds in a distinctive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80691fb5-108c-4112-b236-e5cd4376e6d0",
                                                "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                                "text": "The smoke sensor triggered the alarm."
                                            },
                                            {
                                                "example_id": "1e888e6e-4ae3-48e3-a9e5-bac6bb7e0134",
                                                "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                                "text": "Modern phones contain a light sensor that adjusts brightness."
                                            },
                                            {
                                                "example_id": "dc9e4065-de49-4dde-9e46-b23e6f2baae0",
                                                "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                                "text": "A motion sensor detected movement in the empty room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "151bd643-1030-4ecc-9a90-60a4310f1f03",
                        "source_entry_id": "8a4e34c5-71e1-35a0-82b2-b7d1378bafde",
                        "source_sense_id": "63cc56ab-1fd6-3462-a210-f211ec19e37f",
                        "source_sense_description": "technischer Fühler",
                        "target_lang_word": "capteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df02d183-33f6-3c3f-a69f-7b31c0747e83",
                                        "entry_id": "4912144e-d0d2-3194-ba6f-93cfb6e3cbc0",
                                        "glosses": [
                                            "Qui capte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b07f141-68d4-4cea-947b-e750879b453c",
                                                "sense_id": "df02d183-33f6-3c3f-a69f-7b31c0747e83",
                                                "text": "Avec une bonté indulgente, capteuse, perspicace, avec une adresse presque maternelle qui force l’expansion cordiale, appelle les confidences, le Père de Marel l’interrogeait, et Sébastien s’abandonnait à l’impérieuse joie de lui répondre, au soulageant besoin d’ouvrir ce cœur, trop violenté, trop solitaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "capteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffa0067b-f903-3c37-a9cd-a1ebaf12931a",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Celui qui capte, qui capture, qui fait une prise."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f88be0-a87c-41b7-95af-452c4fbc49db",
                                                "sense_id": "ffa0067b-f903-3c37-a9cd-a1ebaf12931a",
                                                "text": "Butin et prisonniers étaient emmenés vers les contrées d’où l’expédition était partie, parce qu'ils ne pouvaient être partagés entre les capteurs et l’État qu’en terre musulmane."
                                            },
                                            {
                                                "example_id": "489fe7e1-2916-418a-8a52-0c56d49147eb",
                                                "sense_id": "ffa0067b-f903-3c37-a9cd-a1ebaf12931a",
                                                "text": "Un vaisseau capteur ou, substantivement, un capteur, bâtiment qui a fait une prise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05f713b-527d-3e0e-927b-de3779a3f3cb",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Appareil destiné à capter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53025799-a9de-4412-b183-253750c0272e",
                                                "sense_id": "a05f713b-527d-3e0e-927b-de3779a3f3cb",
                                                "text": "Capteur solaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19a55ea0-75a7-324a-bfe3-7934ff1c41cb",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Dispositif détectant une donnée physique de son environnement pour la transformer en signal émis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "217409de-605b-47fe-b043-432a1ab6c9ba",
                                                "sense_id": "19a55ea0-75a7-324a-bfe3-7934ff1c41cb",
                                                "text": "Cela est rendu réalisable par l’extension massive de capteurs sur toutes les surfaces possibles, du corps aux objets domestiques, conduisant à un traçage intégral de la vie."
                                            },
                                            {
                                                "example_id": "553a1834-172d-42b1-90a2-f38e02123743",
                                                "sense_id": "19a55ea0-75a7-324a-bfe3-7934ff1c41cb",
                                                "text": "Fort, également, de ses trois capteurs photo (50 mpx, 8 mpx ultra grand-angle et 2 mégapixels macro), le smartphone de Motorola, qui ne pèse que 184 g, est, par ailleurs, lesté d’un processeur à huit cœurs (Snapdragon 680, aussi présent sur les Oppo A96 et Realme 9I)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c432756-8481-37dc-b203-4368de572d08",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Instrument qui recueille de l’énergie radiative provenant de la scène visée et délivre un signal électrique correspondant et mesurable."
                                        ],
                                        "tags": [
                                            "Télédétection spatiale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4567f685-ab95-4d6a-83a6-fe400a8879eb",
                                                "sense_id": "1c432756-8481-37dc-b203-4368de572d08",
                                                "text": "La caméra utilisée est une Camelia 8M (ATMEL). Il s'agit d'une caméra haute résolution disposant d'un capteur de 2300x3500 pixels carrés de 10 µm de côté."
                                            },
                                            {
                                                "example_id": "c557f88d-0c9d-437f-af8b-90c0967fb697",
                                                "sense_id": "1c432756-8481-37dc-b203-4368de572d08",
                                                "text": "À cause de la diffraction, on ne peut pas diaphragmer notablement un objectif formant ses images sur un petit capteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4b2aec-69a7-3aba-a21b-310227e5926c",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Piège chimique."
                                        ],
