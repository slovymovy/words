        "fr-extract.jsonl": [
            {
                "entry_id": "f80ddb4f-514e-3513-bfaf-5000f9eb6646",
                "word": "mystérieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "54b2e527-81cb-3893-a948-5be6b83183a0",
                        "entry_id": "f80ddb4f-514e-3513-bfaf-5000f9eb6646",
                        "glosses": [
                            "Avec mystère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23557407-4bf7-48a9-844a-afe6c864c7d0",
                                "sense_id": "54b2e527-81cb-3893-a948-5be6b83183a0",
                                "text": "Les prophètes ont parlé mystérieusement."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd77e5ae-7f23-3345-ab03-799f80ba546e",
                        "entry_id": "f80ddb4f-514e-3513-bfaf-5000f9eb6646",
                        "glosses": [
                            "Avec secret, en se cachant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b85c959-b2dc-4041-b6f2-f0d9b2937f56",
                                "sense_id": "dd77e5ae-7f23-3345-ab03-799f80ba546e",
                                "text": "[…] Julie lui avait serré mystérieusement la main, soit pour le remercier du petit service qu’il venait de lui rendre, soit pour lui dire : - Enfin je vais donc vous voir !"
                            },
                            {
                                "example_id": "eb1501d2-ea50-4520-93ab-9a577e23b86e",
                                "sense_id": "dd77e5ae-7f23-3345-ab03-799f80ba546e",
                                "text": "Un matin, au milieu du mois de novembre, on vint dire à Louis Pasteur assez mystérieusement que quelqu'un le demandait. « La personne vous attend à quelques pas d'ici. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8437552-4592-462d-8118-b1302325711a",
                        "source_entry_id": "f80ddb4f-514e-3513-bfaf-5000f9eb6646",
                        "target_lang_word": "mysteriously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mysteriously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38eb496e-f71f-3040-96f4-c6e521807e16",
                                        "entry_id": "29d84d6b-3054-3606-bd55-f0286027e5cd",
                                        "glosses": [
                                            "In a mysterious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9a9fa7-91b3-4f44-8791-bf9bea1b726a",
                                                "sense_id": "38eb496e-f71f-3040-96f4-c6e521807e16",
                                                "text": "'Are there any hares about here?' I asked. 'Well, there are some left to be sure,' answered the peasant; 'on the Sukkestad-moor there is an old jack-hare, which many a hound and sportsman have been after, but he is not so easily killed, it appears.' And the worthy peasant shook his head somewhat mysteriously."
                                            },
                                            {
                                                "example_id": "2d1c9233-e1f4-46a3-9c6b-546a859edc01",
                                                "sense_id": "38eb496e-f71f-3040-96f4-c6e521807e16",
                                                "text": "I put my finger to the side of my nose and nodded mysteriously."
                                            },
                                            {
                                                "example_id": "c70a7d12-70b4-4d0c-bc06-721931a67ed2",
                                                "sense_id": "38eb496e-f71f-3040-96f4-c6e521807e16",
                                                "text": "At that moment a long, scraggy individual in a checked suit poked his head into the bar, looked around portentously, whistled mysteriously to my informant, and jerked his thumb and head in the direction of the door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e3d9f0d-9387-40bd-ac2a-d334a5974ed6",
                        "source_entry_id": "f80ddb4f-514e-3513-bfaf-5000f9eb6646",
