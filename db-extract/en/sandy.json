                    {
                        "translation_id": "832e3fec-a58f-4ff5-96d8-9d4f7b319d0c",
                        "source_entry_id": "6898dc7c-3856-3dac-a13b-342d252ea2a1",
                        "source_sense_description": "sand-coloured",
                        "target_lang_word": "zandkleurig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zandkleurig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "11e93a9f-b24d-31ad-bbb0-4dbe79085b9a",
                                        "entry_id": "968e84c6-b9ec-33ca-80c7-450385ed16fb",
                                        "glosses": [
                                            "een gelige kleur zoals die van zand bezittend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c0c0b1-9382-40da-bd41-76c316f5caf2",
                                                "sense_id": "11e93a9f-b24d-31ad-bbb0-4dbe79085b9a",
                                                "text": "Zijn zandkleurige haar maakte hem gemakkelijk te herkennen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "532368d4-4572-4ab3-a6e3-657cb55d34b9",
                        "source_entry_id": "6898dc7c-3856-3dac-a13b-342d252ea2a1",
                        "source_sense_description": "sand-coloured",
                        "target_lang_word": "sandfarben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandfarben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1bba60-ccfd-38e2-bb0b-565e412307ce",
                                        "entry_id": "cde39be8-e4cd-310e-b211-f6d85c50a5f9",
                                        "glosses": [
                                            "die Farbe von Sand habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cb702a9-4095-4f16-8d6e-fe50fb15a5df",
                                                "sense_id": "4e1bba60-ccfd-38e2-bb0b-565e412307ce",
                                                "text": "„Wells stand auf der Brücke, und vom Fluss her zauste ihm der Wind das schüttere, sandfarbene Haar.“"
                                            },
                                            {
                                                "example_id": "2f6a72fc-30f6-474e-bcf7-0f74d764e6df",
                                                "sense_id": "4e1bba60-ccfd-38e2-bb0b-565e412307ce",
                                                "text": "„Aber dieser hatte eine merkwürdige Farbe, grünlichgrau mit sandfarbenen Einsprengseln.“"
                                            },
                                            {
                                                "example_id": "f365e9ef-6aee-4da9-a606-337a3a4bd7cf",
                                                "sense_id": "4e1bba60-ccfd-38e2-bb0b-565e412307ce",
                                                "text": "„Er trug die Standarduniform mit dunkler Hose, weißem Anzughemd und schwarzer Kippa, hatte jedoch einen Stoppelbart, stylte sein sandfarbenes Haar wie ein Geschäftsmann und hatte seine Schläfenlocken schon vor vielen Jahren abgeschnitten.“"
                                            },
                                            {
                                                "example_id": "3e97cbc0-ac08-45ad-8598-ca8e6c1d3ecd",
                                                "sense_id": "4e1bba60-ccfd-38e2-bb0b-565e412307ce",
                                                "text": "„Hände und Füße waren lang und dünn und seine Gesichtszüge, die der flackernde Fackelschein im Profil kühn herausmeißelte, wirkten intelligent und wurden von einer hohen und breiten Stirn gekrönt, die eine Mähne sandfarbenen Haares bedeckte.“"
                                            },
                                            {
                                                "example_id": "14759419-814d-475d-98ec-53eb0a8997eb",
                                                "sense_id": "4e1bba60-ccfd-38e2-bb0b-565e412307ce",
                                                "text": "„Der kleinere, McDermott, ist weiß, hat ein missmutiges Gesicht, sandfarbenes Haar und auf dem einen Handrücken ein großes, hässliches Muttermal.“"
                                            },
                                            {
                                                "example_id": "16accd3c-0092-45f1-86f1-bda97dba7d79",
                                                "sense_id": "4e1bba60-ccfd-38e2-bb0b-565e412307ce",
                                                "text": "„Neben ihm saß eine Frau mit sandfarbenem Haar und einem Glas Wein in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
