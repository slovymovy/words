                                            {
                                                "example_id": "dd19a08a-877b-4dc5-9422-1d22d4aee423",
                                                "sense_id": "2b483c10-51f3-314e-952a-6e8313ac44ac",
                                                "text": "The cold was a foreboder of the nightmares of the winter that lay ahead."
                                            }
