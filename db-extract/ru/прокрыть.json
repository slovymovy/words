                        "examples": [
                            {
                                "example_id": "806f5114-b8e6-404e-af34-d93cb24456a9",
                                "sense_id": "a80ba286-dec5-3471-b196-0ab821413ce0",
                                "text": "Убежище от снарядов прокрыли настилом из брёвен, а сверху насыпали слой земли и обложили дёрном."
                            }
                        ]
                    },
