                "senses": [
                    {
                        "sense_id": "19f3777c-7406-31af-b888-abd87b435020",
                        "entry_id": "c3b0077e-5701-3ff3-84c2-9e6f64435985",
                        "glosses": [
                            "Theorie, in der alle Kräfte und Wechselwirkungen auf kleine vibrierende, supersymmetrische Strings zurückgeführt werden; sie enthält im Gegensatz zur bosonischen Stringtheorie Fermionen und ist somit supersymmetrisch"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3b3b8e-9d4f-45dc-abe1-c74793de556f",
                                "sense_id": "19f3777c-7406-31af-b888-abd87b435020",
                                "text": "„Die T-Dualität ist neben der S-Dualität in der Stringtheorie eine Herleitung zur M-Theorie, die versucht, die fünf Superstringtheorien miteinander zu vereinen.“"
                            },
                            {
                                "example_id": "360d39dd-4e6a-49f7-a896-315ac97dc07e",
                                "sense_id": "19f3777c-7406-31af-b888-abd87b435020",
                                "text": "„Ansätze zu einer Weltformel, zu einer Theorie von allem, gibt es längst, die Superstringtheorie. Die beschreibt alle Teilchen und Feldquanten – Feldquanten sind Teilchen, die für die Übertragung von Kräften zuständig sind – als winzige eindimensionale, vibrierende Fäden von unvorstellbarer Feinheit, 10⁻³⁵ Meter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
