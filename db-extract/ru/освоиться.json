                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf432c9c-357f-3daa-9296-0dd8a287b38f",
                        "entry_id": "148e475d-323e-3c6b-8eab-fcdc39fc317e",
                        "glosses": [
                            "стать освоенным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cccc6fe-394b-4fb9-b3ec-ebe833d99d37",
                                "sense_id": "bf432c9c-357f-3daa-9296-0dd8a287b38f",
                                "text": "Эти фонды могут освоиться за пару лет."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c164d22-df79-3d29-b2df-febff3de1026",
                        "entry_id": "148e475d-323e-3c6b-8eab-fcdc39fc317e",
                        "glosses": [
                            "приспособиться, привыкнуть к чему-либо новому; начать уверенно управляться с чем-либо ранее непривычным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63bedc25-03d4-461f-b613-dc7ae5f07aa6",
                                "sense_id": "3c164d22-df79-3d29-b2df-febff3de1026",
                                "text": "Старик Бахарев за эти дни успел настолько освоиться с своим положением, что казался совсем спокойным и обсуждал свои дела с хладнокровием совсем успокоившегося человека."
                            },
                            {
                                "example_id": "5a70887f-83ad-4deb-9449-f656ff5440bc",
                                "sense_id": "3c164d22-df79-3d29-b2df-febff3de1026",
                                "text": "Освоиться на новом месте жительства мне помог теплый, дружеский и вместе с тем уважительный прием со стороны Владимира."
                            }
                        ]
                    }
