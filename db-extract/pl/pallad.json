                                "target_senses": [
                                    {
                                        "sense_id": "c79f3156-0b39-3daa-8b96-c8d8b267013c",
                                        "entry_id": "af173435-2649-3394-a443-790d229987f5",
                                        "glosses": [
                                            "kovový chemický prvek s atomovým číslem 46 a chemickou značkou Pd"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "421a2b28-77c6-355f-a93a-f7d629010201",
                                        "entry_id": "af173435-2649-3394-a443-790d229987f5",
                                        "glosses": [
                                            "kultovní umělecký předmět, jenž má poskytovat ochranu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af8dcc8e-3cb0-443e-a183-90443b46a0f7",
                                                "sense_id": "421a2b28-77c6-355f-a93a-f7d629010201",
                                                "text": "Palladium země české je kovový reliéf Panny Marie a je uchováváno v Brandýse nad Labem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7423ce02-a6c3-4129-a6be-543f3b47bac3",
                        "source_entry_id": "09e28c17-11e2-3243-b6d9-8715cae83ede",
                        "source_sense_id": "2fa54d2c-bb7e-3dab-890f-46f9638f5e30",
                        "target_lang_word": "palladium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palladium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa14fd94-7314-3b2d-bc15-8e18c686a8fa",
                                        "entry_id": "2a0d57f9-6fbb-3dee-8970-f12ce0ccafed",
                                        "glosses": [
                                            "Ce qu’un peuple considère comme assurant sa protection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7e7d70-e2b0-42d8-b99e-b0cceff3296e",
                                                "sense_id": "fa14fd94-7314-3b2d-bc15-8e18c686a8fa",
                                                "text": "Avant que sa cathédrale devienne dans les mois qui suivent le symbole préfigurant l’unité allemande à venir, à la suite des vibrants appels de Goethe, la population de la ville de Cologne célébrait avec ferveur en ce même 18 octobre en procession le retour du Martyre de saint Pierre de Rubens, œuvre revendiquée dès 1800 et considérée de longue date comme le palladium de la cité – le peintre étant natif de la ville rhénane."
                                            },
                                            {
                                                "example_id": "d3c96561-e33c-480f-9008-35a4a4872a52",
                                                "sense_id": "fa14fd94-7314-3b2d-bc15-8e18c686a8fa",
                                                "text": "Mais cette tête torturée, trois fois déchirée par la hache, deviendra bientôt pour la Révolution un palladium de vengeance et une tête de Méduse pour ses meurtriers."
                                            },
                                            {
                                                "example_id": "57bd29bd-48e1-4604-92b3-83fe22aba790",
                                                "sense_id": "fa14fd94-7314-3b2d-bc15-8e18c686a8fa",
                                                "text": "Je me résume en un seul mot, messieurs : annualité de l’assemblée nationale ; annualité de l’armée ; annualité de l’impôt ; responsabilité des ministres ; et la sanction royale, sans restriction écrite, mais parfaitement limitée de fait, sera le Palladium de l’unité nationale, et le plus précieux exercice de la liberté du peuple."
                                            },
                                            {
                                                "example_id": "86b31c0d-bfcc-44d5-9491-15d408dc4d09",
                                                "sense_id": "fa14fd94-7314-3b2d-bc15-8e18c686a8fa",
                                                "text": "La loi civile est le palladium de la propriété."
                                            },
                                            {
                                                "example_id": "cd5c91e3-2449-4bc2-8a24-00773d59887c",
                                                "sense_id": "fa14fd94-7314-3b2d-bc15-8e18c686a8fa",
                                                "text": "Le bouclier sacré, qu’on croyait être tombé du ciel au temps de Numa, était le palladium de la puissance romaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "837752c3-150f-398d-80f1-cdb2ea5b7268",
                                        "entry_id": "2a0d57f9-6fbb-3dee-8970-f12ce0ccafed",
                                        "glosses": [
                                            "Ce qui est le garant de la conservation d’une chose, ou d’un individu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf7e5e9-1129-44ec-b5ff-1a3e9a6ad047",
                                                "sense_id": "837752c3-150f-398d-80f1-cdb2ea5b7268",
                                                "text": "Alors on le proclame à tout vent, le plus possible, en exorcisme ; on l’étale devant soi comme un palladium."
                                            },
                                            {
                                                "example_id": "23ff405d-ff11-4048-8644-d27f298f3710",
                                                "sense_id": "837752c3-150f-398d-80f1-cdb2ea5b7268",
                                                "text": "Enfin, le gilet de flanelle, cette sauvegarde, ce tuteur de la santé, ce palladium chéri de Bouvard et inhérent à Pécuchet, sans ambages ni crainte de l’opinion, des auteurs le déconseillent aux hommes pléthoriques et sanguins."
                                            },
                                            {
                                                "example_id": "a11332a8-2a90-4168-88a8-315ffe960c6b",
                                                "sense_id": "837752c3-150f-398d-80f1-cdb2ea5b7268",
                                                "text": "Attaquer son aptitude au travail, douter des quatorze heures que de jour ou de nuit, disait-il, il passait devant son bureau, c’était attaquer son palladium."
                                            },
                                            {
                                                "example_id": "ad85bda0-165e-445a-9bd3-123ffafe7b9b",
                                                "sense_id": "837752c3-150f-398d-80f1-cdb2ea5b7268",
                                                "text": "En Angleterre, on regarde l’acte d’Habeas corpus comme le palladium de la liberté individuelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "palladium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5124d1b4-16ff-30fb-a9c8-f859f08f21ce",
                                        "entry_id": "0538c2b2-443a-3c9f-a287-7c84c430197b",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 46 et de symbole Pd, qui fait partie de la série des métaux de transition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebd9ea04-c643-4416-b497-0da582a2c522",
                                                "sense_id": "5124d1b4-16ff-30fb-a9c8-f859f08f21ce",
                                                "text": "Fort heureusement, l’or du Brésil est caractérisé par la présence d’un platinoïde, le palladium (Pd) à forte teneur, nettement plus élevée que dans l’or monnayé européen du XVIIᵉ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53774ee1-f35a-3def-94e5-3878f3146260",
                                        "entry_id": "0538c2b2-443a-3c9f-a287-7c84c430197b",
                                        "glosses": [
                                            "Corps simple métal composé de cet élément chimique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e8dc8f8-99ca-4820-9835-324cd403d167",
                                                "sense_id": "53774ee1-f35a-3def-94e5-3878f3146260",
                                                "text": "Le palladium ne donnant pas des effets magnétiques bien intenses, il en résulte que les corrections dues à l’ampoule sont du même ordre de grandeur que les quantités à mesurer."
                                            },
                                            {
                                                "example_id": "0ef45cea-a102-47d0-9e26-1f0de2113a72",
                                                "sense_id": "53774ee1-f35a-3def-94e5-3878f3146260",
                                                "text": "La Russie est le premier producteur mondial de palladium."
                                            },
                                            {
                                                "example_id": "728cf43f-9bdd-451b-8917-f6b3176555a3",
                                                "sense_id": "53774ee1-f35a-3def-94e5-3878f3146260",
                                                "text": "Un expert en marketing qui porte des lunettes en palladium importées de Stóristakkur, une île située au large de l’Islande, a probablement découvert, après moult calculs, que Dominique Anglade était plus populaire que son parti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
