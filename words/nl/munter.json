                            {
                                "target_lang_word": "minter",
                                "target_lang_sense_clarification": "A person or machine that makes coins."
                            },
                            {
                                "target_lang_word": "moneyer",
                                "target_lang_sense_clarification": "A historical term for an official authorized to mint coins."
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "darphaneci",
