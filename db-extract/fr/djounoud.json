                "forms": [],
                "senses": [
                    {
                        "sense_id": "0523c1f1-f8f6-36dc-b7fe-1ebdd9a1b463",
                        "entry_id": "0db1b720-6467-364d-8a80-8fb4d44c1556",
                        "glosses": [
                            "Désignation d’un combattant de l’Armée de libération nationale, pendant la guerre d’Algérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "098af9a0-3b06-491e-8ed2-f94cd7e7aad3",
                                "sense_id": "0523c1f1-f8f6-36dc-b7fe-1ebdd9a1b463",
                                "text": "Il nous parlait de l’ALN, des djounoud (combattants), expliquant que les hommes de l’intérieur étaient les plus vrais, les plus purs."
                            },
                            {
                                "example_id": "2055dc3d-5940-44c7-832e-4de63c7deb69",
                                "sense_id": "0523c1f1-f8f6-36dc-b7fe-1ebdd9a1b463",
                                "text": "Aux cris, aux supplications, aux coups de feu, aux hurlements des djounoud déchaînés succède un silence pesant."
                            },
                            {
                                "example_id": "32ce2de9-399b-4dec-9274-6c12f2c263ee",
                                "sense_id": "0523c1f1-f8f6-36dc-b7fe-1ebdd9a1b463",
                                "text": "Et je t’ai dit qu’à cette époque-là on tuait beaucoup et dans le tas — l’OAS mais aussi des djounoud FLN de la dernière heure."
                            },
                            {
                                "example_id": "a527a69f-8404-4681-82ee-a604eec7a3b9",
                                "sense_id": "0523c1f1-f8f6-36dc-b7fe-1ebdd9a1b463",
                                "text": "Le thème de cette exposition est consacré à la \"kachabia\", habit traditionnel qui, au-delà de l’histoire, était très utilisé par les djounoud de l’Armée de libération nationale (ALN) qui en avaient fait un \"signe distinctif et une fierté nationale\"."
                            }
                        ]
                    }
