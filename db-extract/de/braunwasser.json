                ],
                "senses": [
                    {
                        "sense_id": "8ae4ad4c-2820-361d-b173-9dc0ef0ad45a",
                        "entry_id": "b1abb83d-042b-3c2c-bd91-62fee059659f",
                        "glosses": [
                            "ursächlich durch Kot und Toilettenpapier verschmutztes (fäkalienhaltiges) Abwasser ohne Grauwasser; Bestandteil des Schwarzwassers"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "f63bc1d7-06ee-4a0f-82a4-bd48a1614a84",
                                "sense_id": "8ae4ad4c-2820-361d-b173-9dc0ef0ad45a",
                                "text": "„Je nach Herkunft und Verschmutzung kann das häusliche Abwasser in verschiedene, “farbige” Teilströme unterteilt werden: mit Schwarzwasser wird das nährstoffreiche Toilettenspülwasser bezeichnet, das sich wiederum aus Gelbwasser (Urin) und Braunwasser (Fäkalien) zusammensetzt. Das restliche, weniger verschmutzte häusliche Abwasser wie Wasch-, Spül-, Küchen-, Dusch- und Badewasser wird als Grauwasser bezeichnet.“"
                            },
                            {
                                "example_id": "01982704-5e71-4eef-8ade-b789afd66310",
                                "sense_id": "8ae4ad4c-2820-361d-b173-9dc0ef0ad45a",
                                "text": "„Im Rahmen dieser Arbeit wird ein anaerobes mesophiles Behandlungsverfahren für den Teilstrom Braunwasser untersucht.“"
                            },
                            {
                                "example_id": "9adeb917-4324-4e04-a1c0-1e15abe200cd",
                                "sense_id": "8ae4ad4c-2820-361d-b173-9dc0ef0ad45a",
                                "text": "„ In Versuchen mit Braunwasser an einer Biogasanlage auf dem Klärwerk Stahnsdorf zeigte sich das große Energiepotenzial aus diesem Abwasserteilstrom.“"
                            },
                            {
                                "example_id": "b62d21c4-37ea-4eef-af16-3ac74a3cfdb0",
                                "sense_id": "8ae4ad4c-2820-361d-b173-9dc0ef0ad45a",
                                "text": "„Das Braunwasser (tatsächlich handelt es sich dabei fast um Feststoff, denn viele EcoSan-Klos kommen ohne Spülung aus) muss länger aus dem Verkehr gezogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef197371-78c4-3804-ace9-ace530e5c08e",
                        "entry_id": "b1abb83d-042b-3c2c-bd91-62fee059659f",
                        "glosses": [
                            "rostiges Wasser aus der Wasserleitung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a1ecb633-b0ae-4879-8298-aa6b2e218485",
                                "sense_id": "ef197371-78c4-3804-ace9-ace530e5c08e",
                                "text": "„Wegen geplanter Rohrnetzarbeiten im Bremer Osten kann es am heutigen Dienstag zu sogenanntem Braunwasser in den Stadtteilen Osterholz, Blockdiek und Vahr kommen, teilt der Bremer Energieversorger SWB mit.“"
                            },
                            {
                                "example_id": "04182ac5-6d4b-4de2-bceb-b3d5cc92d47b",
                                "sense_id": "ef197371-78c4-3804-ace9-ace530e5c08e",
                                "text": "„In der Woche vom 19. bis zum 24. August 2013 kann es im Bremer Stadtteil Osterholz-Tenever zu Trübungen oder sogenanntem \"Braunwasser\" im Trinkwasser kommen.“"
                            },
                            {
                                "example_id": "e541cf5a-28bf-4951-84e3-167f488c7339",
                                "sense_id": "ef197371-78c4-3804-ace9-ace530e5c08e",
                                "text": "„Bei der Verteilung von Wasser kann es zu Wasserverfärbungen, sogenanntem Braunwasser, kommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bcef4347-855f-38e4-8d7e-2046df61766d",
                        "entry_id": "b1abb83d-042b-3c2c-bd91-62fee059659f",
                        "glosses": [
                            "Bach- oder Flusslauf der einen sichtbar, bräunlichen Feststoffanteil mit sich führt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "659433e4-5fc1-4e1e-a5af-05ff81982d2f",
                                "sense_id": "bcef4347-855f-38e4-8d7e-2046df61766d",
                                "text": "„Zwei davon sind Waldbäche, die Braunwasser führen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
