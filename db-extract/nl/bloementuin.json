                        "glosses": [
                            "een tuin met veel bloemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22074495-9b1d-42f3-a2ca-8c5132077038",
                                "sense_id": "f6f1e970-5f83-3405-9a44-36efbd4fe05e",
                                "text": "Volgens mij zijn daar de restanten van een bloementuin."
                            },
                            {
                                "example_id": "0afb3a75-3aed-402d-93db-25d9c237a70a",
                                "sense_id": "f6f1e970-5f83-3405-9a44-36efbd4fe05e",
                                "text": "De opbrengst is een recordbedrag voor tekeningen van Van Gogh, meldt The Art Newspaper: zijn eerdere tekeningen Een Bloementuin (1888) en Olijfbomen met de Alpilles (1889) werden in de jaren 90 geveild voor respectievelijk 8,4 en 8,6 miljoen dollar. Christie's schatte de opbrengst van het werk vooraf op 7 à 10 miljoen dollar."
                            }
                        ]
                    }
                ],
