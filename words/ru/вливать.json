                {
                    "sense_id": "07d93300-fe2b-3dbc-aa47-1317ebfa4d5f",
                    "sense_definition": "Лить жидкость внутрь какого-либо сосуда или вместилища.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pouring_liquids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она аккуратно начала <w>вливать</w> молоко в тесто, постоянно помешивая его ложкой.",
                            "target_lang_translations": {
                                "en": "She carefully began to <w>pour</w> milk into the dough, stirring it constantly with a spoon."
                            }
                        },
                        {
                            "text": "Не стоит <w>вливать</w> воду в горячее масло, так как это может быть опасно.",
                            "target_lang_translations": {
                                "en": "You should not <w>pour</w> water into hot oil, as this can be dangerous."
                            }
                        }
                    ],
                    "synonyms": [
                        "наливать",
                        "заливать"
                    ],
                    "antonyms": [
                        "выливать"
                    ],
                    "common_phrases": [
                        "вливать воду",
                        "вливать по капле"
                    ],
                    "target_lang_definitions": {
                        "en": "To pour liquid into a container or vessel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pour in",
                                "target_lang_sense_clarification": "liquid into a container"
                            },
                            {
                                "target_lang_word": "pour",
                                "target_lang_sense_clarification": "liquid into something"
                            },
                            {
                                "target_lang_word": "infuse",
                                "target_lang_sense_clarification": "liquid or herbal mixture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cfcd533-ea17-347c-ab34-d4d7572c822b",
                    "sense_definition": "Переносно: внушать, возбуждать или вселять какие-либо чувства, силы или эмоции.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instilling_feelings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его тёплые слова поддержки смогли <w>вливать</w> надежду в сердца уставших людей.",
                            "target_lang_translations": {
                                "en": "His warm words of support were able to <w>instill</w> hope into the hearts of tired people."
                            }
                        },
                        {
                            "text": "Эта весёлая музыка продолжала <w>вливать</w> бодрость во всех присутствующих на празднике.",
                            "target_lang_translations": {
                                "en": "This cheerful music continued to <w>infuse</w> energy into everyone present at the celebration."
                            }
                        }
                    ],
                    "synonyms": [
                        "вселять",
                        "внушать",
                        "вселять"
                    ],
                    "common_phrases": [
                        "вливать мужество",
                        "вливать новые силы"
                    ],
                    "target_lang_definitions": {
                        "en": "Figuratively: to instill, inspire, or breathe feelings, strength, or emotions into someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "instill",
                                "target_lang_sense_clarification": "feelings, hope, or values"
                            },
                            {
                                "target_lang_word": "infuse",
                                "target_lang_sense_clarification": "energy, life, or courage"
                            },
                            {
                                "target_lang_word": "breathe",
                                "target_lang_sense_clarification": "new life or hope into something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fba2904e-69ec-36be-ad73-b3f2159f6eaf",
                    "sense_definition": "Переносно: направлять денежные средства, ресурсы или новые кадры на поддержку и обеспечение деятельности чего-либо.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "investing_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Государство решило <w>вливать</w> инвестиции в развитие сельских регионов страны.",
                            "target_lang_translations": {
                                "en": "The state decided to <w>inject</w> investments into the development of the country's rural regions."
                            }
                        },
                        {
                            "text": "Инвесторы продолжают <w>вливать</w> средства в этот перспективный технологический стартап.",
                            "target_lang_translations": {
                                "en": "Investors continue to <w>pour</w> funds into this promising tech startup."
                            }
                        }
                    ],
                    "synonyms": [
                        "инвестировать",
                        "вкладывать"
                    ],
                    "common_phrases": [
                        "вливать средства",
                        "вливать инвестиции"
                    ],
                    "target_lang_definitions": {
                        "en": "Figuratively: to direct funds, resources, or new personnel to support and sustain an activity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pour in",
                                "target_lang_sense_clarification": "money, funds, or resources"
                            },
                            {
                                "target_lang_word": "inject",
                                "target_lang_sense_clarification": "capital, funds, or resources"
                            },
                            {
                                "target_lang_word": "pump",
                                "target_lang_sense_clarification": "money or resources into something"
                            }
                        ]
                    }
                }
