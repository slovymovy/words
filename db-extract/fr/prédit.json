                    {
                        "sense_id": "8e34fb7d-73a9-3964-958a-e51ceabf614f",
                        "entry_id": "3237f87c-0edb-32a2-b4d2-f31b3a717e23",
                        "glosses": [
                            "Annoncé d’avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b540f7-0b5e-4f03-9f90-05e760fe4d22",
                                "sense_id": "8e34fb7d-73a9-3964-958a-e51ceabf614f",
                                "text": "Le monde ayant vieilli dans ses erreurs charnelles, Jésus-Christ est venu dans le temps prédit, mais non pas dans l’éclat attendu."
                            },
                            {
                                "example_id": "f8ea40f5-d553-408d-8ddf-1c82b3578073",
                                "sense_id": "8e34fb7d-73a9-3964-958a-e51ceabf614f",
                                "text": "Cette année 89 [1689], si prédite, si marquée, si annoncée pour de grands événements."
                            },
                            {
                                "example_id": "5b781f45-87d0-45d7-a7e4-7b110ce37a40",
                                "sense_id": "8e34fb7d-73a9-3964-958a-e51ceabf614f",
                                "text": "Pour qui… Vais-je y chercher [à Troie] la mort tant prédite à leur fils ?"
                            }
                        ]
                    }
                ],
