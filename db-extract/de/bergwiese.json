                ],
                "senses": [
                    {
                        "sense_id": "470d862c-f5bb-3f1d-88ea-dc6b16f4e137",
                        "entry_id": "725b8728-0102-33d5-a92a-27dc049d8302",
                        "glosses": [
                            "von Gras bewachsene Fläche in hohen gebirgigen Lagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e6cc9f-8062-43e4-bb0c-7062d46abe51",
                                "sense_id": "470d862c-f5bb-3f1d-88ea-dc6b16f4e137",
                                "text": "„Vor uns liegt eine sanft abfallende Bergwiese voll lila blühender, hoher Pflanzen.“"
                            },
                            {
                                "example_id": "f4372772-3f99-48ee-a7e8-ccc14a49a632",
                                "sense_id": "470d862c-f5bb-3f1d-88ea-dc6b16f4e137",
                                "text": "„Als sich der Abend näherte, wichen die Bäume einer Bergwiese, die von schroffen Felsklippen umgeben war.“"
                            },
                            {
                                "example_id": "aba92ae3-e32e-4268-8386-2de79506e133",
                                "sense_id": "470d862c-f5bb-3f1d-88ea-dc6b16f4e137",
                                "text": "„Weiter ziehen wir ins südlich gelegene Bergland – und hier ist die trockene Bergwiese.“"
                            },
                            {
                                "example_id": "d682c9be-7666-4227-bfb4-7a0e00c3f7d2",
                                "sense_id": "470d862c-f5bb-3f1d-88ea-dc6b16f4e137",
                                "text": "„Alte Grundmauern zeugen von der einst landwirtschaftlichen Nutzung der Bergwiesen.“"
                            },
                            {
                                "example_id": "928b6a34-ed2e-428b-ad55-103f6aa08fe7",
                                "sense_id": "470d862c-f5bb-3f1d-88ea-dc6b16f4e137",
                                "text": "„Es steht auf einer Bergwiese inmitten eines 130000 qm großen Naturgrundstücks – rundherum nur Wiesen und Wälder, in der Ferne eine leuchtende Bergkulisse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
