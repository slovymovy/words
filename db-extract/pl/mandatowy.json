                "translations": [
                    {
                        "translation_id": "b6a95973-6145-49a5-b5ca-51d105852272",
                        "source_entry_id": "bb96cc42-d492-3558-97cd-b9e61a848f2b",
                        "source_sense_id": "57b3f48e-9c3b-3520-b728-4a7109e5ad2c",
                        "target_lang_word": "mandatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                        "entry_id": "cb9fd76b-2445-305d-9e35-542d6339b48b",
                                        "glosses": [
                                            "obligatory; required or commanded by authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf56e05-3018-4861-bd97-b7e496b866d8",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "Attendance at a school is usually mandatory for children."
                                            },
                                            {
                                                "example_id": "6a7edbe2-80bc-4ff1-ab93-22a318313617",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "This kind of immediate control structure we take to be characteristic of the tribe, and it leads to a rather rigid type of system in which 'every action not mandatory is forbidden'."
                                            },
                                            {
                                                "example_id": "9cc34656-5287-4b7e-b22d-1f9574742324",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "It also discusses the access to legal instruments for enforcement with regard to mandatory disclosure of environmental information."
                                            },
                                            {
                                                "example_id": "83d6d55a-263c-43cb-9319-68915d9bb4b2",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "While in the most serious cases mounting an investigation is usually mandatory, there are other occasions where it is less clear-cut or when it is concluded that an investigation would not fulfil RAIB's objectives to improve safety or prevent future accidents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1c27ef8-a274-3048-8c3f-da4399bc82bc",
                                        "entry_id": "cb9fd76b-2445-305d-9e35-542d6339b48b",
                                        "glosses": [
                                            "Of, being or relating to a mandate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a92bb61-b8d7-40ce-9644-0705f290aa39",
                                                "sense_id": "c1c27ef8-a274-3048-8c3f-da4399bc82bc",
                                                "text": "Mandatory Palestine"
                                            }
                                        ]
                                    }
                                ]
                            },
