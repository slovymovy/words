                "senses": [
                    {
                        "sense_id": "fbd65d5c-5170-38ce-ae0b-f7a9063ec761",
                        "entry_id": "50d2410a-2e3f-305f-8ae5-79a290e3d7a0",
                        "glosses": [
                            "город в России, столица Республики Адыгея"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab984291-f370-4e53-a2b9-7dc5e93f48a4",
                                "sense_id": "fbd65d5c-5170-38ce-ae0b-f7a9063ec761",
                                "text": "На два дня мы задержались в Майкопе, где когда-то работала мать и где она встретила моего отца."
                            },
                            {
                                "example_id": "3a5b6868-8057-43b4-a71e-885df4d40b4c",
                                "sense_id": "fbd65d5c-5170-38ce-ae0b-f7a9063ec761",
                                "text": "Он не мог жить на деньги, полученные Натальей Николаевной, и был вынужден уезжать то в Майкоп, то в Астрахань, то в Ставрополь, где у него имелись небольшие предприятия."
                            }
                        ]
                    }
                ],
