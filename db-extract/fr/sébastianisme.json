                        "glosses": [
                            "Mythe messianique portugais, basé sur la croyance qui consiste à espérer le retour sur le trône du Portugal du jeune roi Sébastien iᵉʳ, disparu lors de la bataille des trois rois opposant Empire portugais au Sultanat Saadien du Maroc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcdf74d3-e421-490f-a456-f61d25fa26e2",
                                "sense_id": "7b3a777d-c8f5-3bdd-a8d7-92d4c0b1637b",
                                "text": "Il (Dominique de Roux) s’enthousiasma pour le sébastianisme au point de s’approprier le mythe du cinquième empire"
                            }
                        ]
                    }
                ],
