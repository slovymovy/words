                    },
                    {
                        "translation_id": "8e47e2a9-5b19-4ecb-87e8-430036a443d9",
                        "source_entry_id": "b7a34bd2-ea62-34c8-b863-9d57bd5544cb",
                        "source_sense_id": "d0f8d3a2-84d7-368a-8349-81c9ec311156",
                        "target_lang_word": "Durchmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                        "entry_id": "a3805785-8a68-3915-971e-6c3506997e89",
                                        "glosses": [
                                            "Entfernung zwischen den Schnittpunkten eines Kreises mit einer Geraden, die dessen Mittelpunkt schneidet"
                                        ],
                                        "tags": [
                                            "Mathematik, Geometrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75df5b1a-efd6-487a-b521-3f9b8f860a5c",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "Die Hälfte eines Durchmessers nennt man Radius (Halbmesser)."
                                            },
                                            {
                                                "example_id": "44299641-b368-4595-a6df-2d16e685ca17",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "„Den doppelten Radius eines Kreises nennt man Durchmesser.“"
                                            },
                                            {
                                                "example_id": "5fb64c71-e3fa-4acc-b905-0212489fee5b",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "„Das Augustus-Mausoleum mit 89 Meter Durchmesser sollte von der Dauerhaftigkeit des Imperiums künden.“"
                                            },
                                            {
                                                "example_id": "a225de47-c57a-49fc-be4d-773cb11c652d",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "„Die Erde hat einen Durchmesser von über 12.000 km, aber die Biosphäre misst an keiner Stelle mehr als rund 25 km.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be2657b0-b220-37d3-8960-90b670ff275e",
                                        "entry_id": "a3805785-8a68-3915-971e-6c3506997e89",
                                        "glosses": [
                                            "eine längstmögliche Sehne eines Kreises"
                                        ],
                                        "tags": [
                                            "Mathematik, Geometrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f0baa6d-43bb-4894-957e-a3fe95806004",
                                                "sense_id": "be2657b0-b220-37d3-8960-90b670ff275e",
                                                "text": "„Auch diese Strecke selbst wird gelegentlich als ein Durchmesser der Sphäre bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
