                "senses": [
                    {
                        "sense_id": "5c957b51-0bbf-30e2-8dd7-62ebbd4cc962",
                        "entry_id": "a16ff54c-1809-3f08-a967-0fb018952b0e",
                        "glosses": [
                            "Dans l'Antiquité romaine, titre que portaient certains magistrats de l’Empire chargés notamment de lever des impôts, gérer les bureaux de la chancellerie, gouverner certaines provinces."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "65916da6-62a0-430f-8874-d7a202b6948f",
                                "sense_id": "5c957b51-0bbf-30e2-8dd7-62ebbd4cc962",
                                "text": "Le procurateur de Judée."
                            }
                        ]
                    },
                    {
                        "sense_id": "72c5f05a-09ae-3dc9-bff1-a3f10a5ccfca",
                        "entry_id": "a16ff54c-1809-3f08-a967-0fb018952b0e",
                        "glosses": [
                            "Au Moyen Âge et dans les Temps modernes, nom donné, dans les républiques de Venise et de Gênes, à un magistrat investi d'une fonction administrative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120921c2-c9c2-4b0a-ab82-303c3f2a6413",
                                "sense_id": "72c5f05a-09ae-3dc9-bff1-a3f10a5ccfca",
                                "text": "À Venise, le procurateur de Saint-Marc était chargé de la gestion des dotations de la basilique Saint-Marc, de l'entretien et de l'embellissement des bâtiments de l'église."
                            },
                            {
                                "example_id": "6ef0794f-d445-4c1c-8574-e3e3b953af56",
                                "sense_id": "72c5f05a-09ae-3dc9-bff1-a3f10a5ccfca",
                                "text": "Tous les deux ans on élisait à Gênes deux procurateurs."
                            }
                        ]
                    }
                ],
