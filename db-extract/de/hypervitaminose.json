                        "sense_id": "1a04d3ad-858f-3366-b2e6-0a8d2f7829a0",
                        "entry_id": "53100bd3-befc-3aff-94d4-cce2b4e30ebd",
                        "glosses": [
                            "durch dauerhaft übermäßige Aufnahme eines bestimmten Vitamins hervorgerufene Krankheit beziehungsweise verschiedenartiger Krankheitszustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262b7cc6-21db-4a90-ad54-97b7e05f7e6a",
                                "sense_id": "1a04d3ad-858f-3366-b2e6-0a8d2f7829a0",
                                "text": "„Eisbärenleber ist für Menschen giftig, weil sie besonders viel Vitamin A anreichert. Diese Erfahrung mussten frühe Polarforscher machen, die Eisbärenleber gegessen hatten. Eskimos würden das nie tun. Das Krankheitsbild nennt sich Hypervitaminose. Die Symptome bestehen aus Schwindel, Übelkeit, Erbrechen und Nervenschädigungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
