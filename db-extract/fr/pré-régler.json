                        "sense_id": "48ce4b09-4b73-39a3-8182-b0d0aacb882e",
                        "entry_id": "0890a69e-fc3a-33d6-a610-f69fac6dfd7a",
                        "glosses": [
                            "Assurer un premier réglage (réglage par défaut)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0d6128c9-0294-4132-8d20-a9cb0396d09f",
                                "sense_id": "48ce4b09-4b73-39a3-8182-b0d0aacb882e",
                                "text": "Mais loin de pré-régler cette articulation politique, comme le laisserait entendre la métaphore du squelette, l’économie n’est que la matrice d’une domination, que la politique concentre et totalise comme rapport d’ensemble des classes."
                            },
                            {
                                "example_id": "0d0230c0-67df-47b6-8a16-b97c3f0eb1cd",
                                "sense_id": "48ce4b09-4b73-39a3-8182-b0d0aacb882e",
                                "text": "L’outil Trajet vectoriel vous permet également de pré-régler l’épaisseur et le type du trait (aérographe, aquarelle, feutre, huile vaporisateur, calligraphie, craie grasse…)."
                            }
                        ]
