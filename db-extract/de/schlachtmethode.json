                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c723a49-6fb6-44d4-a5b3-830babba840d",
                                "sense_id": "72a47aa7-8931-35bc-99ad-784e0462603d",
                                "text": "„Schlachtmethoden: Als Barbarei muss das sogenannte „Knicken“ bezeichnet werden, welches nach Äußerungen von Autoritäten eines gesetzlichen Verbotes würdig ist.“"
                            },
                            {
                                "example_id": "89dd99f6-1f69-4e64-95d9-71d51081ce2f",
                                "sense_id": "72a47aa7-8931-35bc-99ad-784e0462603d",
                                "text": "„Daran muss sich auch die Schlachtmethode orientieren.“"
                            },
                            {
                                "example_id": "618e47ae-66df-4c19-a14b-f969973ad408",
                                "sense_id": "72a47aa7-8931-35bc-99ad-784e0462603d",
                                "text": "„Der Grundgedanke bei all den Verbesserungen der Schlachtmethoden war immer ein möglichst schnelles und sicheres Töten der Tiere, und der Tierschutzgedanke spielte natürlich auch eine Rolle.“"
                            }
                        ],
