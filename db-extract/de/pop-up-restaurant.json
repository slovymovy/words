                "senses": [
                    {
                        "sense_id": "b639140e-86df-3ef9-a930-e9c9dbe449f9",
                        "entry_id": "83b0af89-e4a4-36d5-934b-a95ac019e26b",
                        "glosses": [
                            "temporär geöffnetes Restaurant, in dem von einem vorher nicht bekannten Koch an einem kurz zuvor bekanntgegebenen Ort ein sehr gutes Gastronomie-Angebot offeriert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf96ea0b-3c17-421f-b4dd-1ce3b1f834e8",
                                "sense_id": "b639140e-86df-3ef9-a930-e9c9dbe449f9",
                                "text": "„Es mutet geheimnisvoll an, sehr sogar: Da meldet man sich via zugesteckter E-Mail-Adresse für ein Nachtessen an und weiss weder wer kocht, was es zu essen gibt noch wo das Essen stattfinden soll. Doch der Koch soll sein Handwerk verstehen – mit Sternen gar ausgezeichnet sein – die Location aussergewöhnlich und die Preise moderat. Das alles sind typische Merkmale für Pop-up-Restaurants, die immer zahlreicher werden.“"
                            },
                            {
                                "example_id": "5dfd1613-6650-4d2a-81e2-563399bc8d3a",
                                "sense_id": "b639140e-86df-3ef9-a930-e9c9dbe449f9",
                                "text": "Ich würde mal gerne in ein Pop-up-Restaurant gehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
