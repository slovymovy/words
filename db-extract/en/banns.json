                    {
                        "sense_id": "d25af596-332b-3b86-92e3-83320bd880e5",
                        "entry_id": "da2c86cd-0ffa-32d2-92a5-80b50cbc848c",
                        "glosses": [
                            "The announcement of a forthcoming marriage (legally required for a church wedding in England and Wales and read on the three Sundays preceding the marriage)."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "aabe3144-9385-40f3-af36-26dc8d3aeb52",
                                "sense_id": "d25af596-332b-3b86-92e3-83320bd880e5",
                                "text": "VVhy the banns have been publiſhed, and nobody has forbidden them, 'tis true—but you know either of the parties may change their minds even after they enter the church."
                            }
                        ]
                    },
                    {
                        "sense_id": "1767cfae-bb1d-3007-b25a-eccc08c6eeab",
                        "entry_id": "da2c86cd-0ffa-32d2-92a5-80b50cbc848c",
                        "glosses": [
                            "Any public announcement of an upcoming event."
                        ],
                        "tags": [
                            "historical",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "4d0e8f5f-75c4-48f8-8f8e-b0bebb952262",
                                "sense_id": "1767cfae-bb1d-3007-b25a-eccc08c6eeab",
                                "text": "The Banes which are reade beefore the beginninge of the playes of Chester, 4 June, 1600."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e5e418-1264-4f89-8fb9-c31465686a09",
                        "source_entry_id": "da2c86cd-0ffa-32d2-92a5-80b50cbc848c",
                        "source_sense_description": "announcement of a forthcoming marriage",
                        "target_lang_word": "bans",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
