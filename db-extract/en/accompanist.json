                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e19374e-ccf7-43f3-acfe-56acb863d9c8",
                        "source_entry_id": "96a023ff-a511-34cc-aecb-c9dd72385726",
                        "source_sense_id": "e6588410-72e4-3ccd-87b9-a35c5b7e1090",
                        "source_sense_description": "performer who takes the accompanying part",
                        "target_lang_word": "Begleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "jemand, der jemanden begleitet; jemand, der gemeinsam mit jemandem irgendwo hingeht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f7bb203-1c6e-495d-b3c7-e6e0060c96a1",
                                                "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                                "text": "Der Wald ist nachts zu gefährlich, ohne Begleiter hineinzugehen."
                                            },
                                            {
                                                "example_id": "13a8b2a7-8b04-459c-a9ed-2cbff06d5b6f",
                                                "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                                "text": "„Da sein Begleiter so hartnäckig schwieg, wollte Schefold, wie es seine Gewohnheit war, die ersten Häuser von Winterspelt zum Bild machen.“"
                                            },
                                            {
                                                "example_id": "f3f6a7f4-8bc7-42eb-b002-52eae32999fa",
                                                "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                                "text": "„Mit gespaltenen Rohrstöcken bemühten sich die Begleiter, unter lauten Rufen die Straße frei zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a48967a2-3688-330d-ac41-d576fbccc292",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "Person, die einen Solisten auf einem Instrument begleitet"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af81dd67-e874-4686-bafe-3b2e5903e780",
                                                "sense_id": "a48967a2-3688-330d-ac41-d576fbccc292",
                                                "text": "Er war der Sängerin ein einfühlsamer Begleiter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0ba65c7b-5d12-3ae1-bfd4-40f9e153ddcb",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "deutsche Bezeichnung für Artikel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b09cd5a-2244-4a3d-8774-a694f740b5be",
                                                "sense_id": "0ba65c7b-5d12-3ae1-bfd4-40f9e153ddcb",
                                                "text": "„Der“ und „ein“ können als Begleiter verwendet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3d84f860-e76f-3b51-91a3-2e18e1322fd4",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "umschreibend für: Freund, Liebhaber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d77175-5328-4715-8503-ac1e1be76ff6",
                                                "sense_id": "3d84f860-e76f-3b51-91a3-2e18e1322fd4",
                                                "text": "Man sah sie erstmals mit ihrem Begleiter."
                                            },
                                            {
                                                "example_id": "f23881c3-2dad-42d4-ae59-9a0d4b1a7994",
                                                "sense_id": "3d84f860-e76f-3b51-91a3-2e18e1322fd4",
                                                "text": "„Das jüngere weibliche Wesen schwankte auf der Suche nach seinem Mantel und seinem Begleiter an ihnen vorüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "951250a2-4b53-3c02-b948-62101ca23d3f",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "Himmelskörper, der einen anderen umkreist oder die gleiche Bahn wie dieser verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ddbb7e-17da-466a-885d-8ee5d42782f1",
                                                "sense_id": "951250a2-4b53-3c02-b948-62101ca23d3f",
                                                "text": "„Die bekanntesten koorbitalen Begleiter sind die Trojaner des Jupiters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a402fc20-1fc5-46cf-a3b9-57ec0fe245bc",
                        "source_entry_id": "96a023ff-a511-34cc-aecb-c9dd72385726",
                        "source_sense_id": "e6588410-72e4-3ccd-87b9-a35c5b7e1090",
                        "source_sense_description": "performer who takes the accompanying part",
                        "target_lang_word": "Begleiterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begleiterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                        "entry_id": "590d85bb-af3a-344e-8459-a164f10bc151",
                                        "glosses": [
                                            "weibliche Person, die jemanden begleitet; weibliche Person, die gemeinsam mit jemandem irgendwo hingeht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075f7231-3a27-419e-a69f-6280298d282f",
                                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                                "text": "„Sie blickte die junge Begleiterin ihres alten Bekannten strahlend an, als erwartete sie sich von ihr eine Bestätigung, daß jene Affäre damals keine Zukunft gehabt hatte.“"
                                            },
                                            {
                                                "example_id": "f50613dc-2f1e-499d-b91c-445fb328c673",
                                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                                "text": "„Sie schnappte empört nach Luft und versuchte gleichzeitig, ihre Begleiterin entschuldigend anzulächeln.“"
                                            },
                                            {
                                                "example_id": "6279521d-e22b-48df-94e5-6f0317ee99b8",
                                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                                "text": "„Die Tante folgte mit ihren beiden Begleiterinnen auf dem Fuß nach.“"
                                            },
                                            {
                                                "example_id": "916bb483-44e6-437d-b745-7a44e9b437c4",
                                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                                "text": "„Sie ging mit einer Begeiterin hinaus, und ich folgte ihnen von fern.“"
                                            },
                                            {
                                                "example_id": "79a78e09-a411-4b5f-be9d-80d9ea417f34",
                                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                                "text": "„Fragend blickte Bond seine Begleiterin an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf8d5602-b468-3a29-a3c6-02cdcca0179b",
                                        "entry_id": "590d85bb-af3a-344e-8459-a164f10bc151",
                                        "glosses": [
                                            "weibliche Person, die einen Solisten auf einem Instrument begleitet"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20bd05c8-2bbe-4a52-ab25-4dd1039ca084",
                                                "sense_id": "bf8d5602-b468-3a29-a3c6-02cdcca0179b",
                                                "text": "„Auch Leon Szostakowski (12) musizierte den 1. Satz des Konzertes für Violoncello Nr. 4 in G-Dur ohne Schwierigkeiten und entpuppte sich sogar als Kavalier, als er seiner Begleiterin am Klavier im Nachhinein eine Rose schenkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
