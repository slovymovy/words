                                            {
                                                "example_id": "3125fb22-18d6-4a7e-9559-558d1afc5cbc",
                                                "sense_id": "76ae8301-bd35-3922-90f2-67c01cca9161",
                                                "text": "Another example of up-to-date practice is that all locomotives and rolling stock have automatic couplers."
                                            }
