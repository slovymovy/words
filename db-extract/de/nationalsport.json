                    {
                        "sense_id": "1f9c22cc-bec1-3566-9291-1f40d3cc995c",
                        "entry_id": "a4171f16-d358-3a47-b5c8-b7fdb5a7ae63",
                        "glosses": [
                            "Sport, der in einem bestimmten Land, in einer bestimmten Region, von einer bestimmten Bevölkerungsgruppe/Nation bevorzugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f14443b-24e1-4610-afcf-fce7e210cca2",
                                "sense_id": "1f9c22cc-bec1-3566-9291-1f40d3cc995c",
                                "text": "„Der amerikanische Nationalsport wird schlankweg »Football« genannt, als ob es kein anderes Fußballspiel gäbe, als ob es mit dem Fuß oder mit dem Ball etwas zu tun hätte.“"
                            },
                            {
                                "example_id": "bd3c1b2d-8d9a-4246-a50d-339f42327cf0",
                                "sense_id": "1f9c22cc-bec1-3566-9291-1f40d3cc995c",
                                "text": "„Mit neun Jahren begann Suryavanshi mit dem indischen Nationalsport, sein Vater trainierte ihn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
