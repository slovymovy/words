    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6992a9e8-0f46-36f3-920e-3d703aee9059",
                    "sense_definition": "A narrow area of water that stretches into the land from a sea, lake, or river.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small fishing boat sought shelter from the storm inside a quiet coastal <w>inlet</w>.",
                            "target_lang_translations": {
                                "ru": "Небольшая рыболовная лодка укрылась от шторма в тихой прибрежной <w>бухте</w>."
                            }
                        },
                        {
                            "text": "They decided to anchor their yacht in a secluded <w>inlet</w> surrounded by steep cliffs.",
                            "target_lang_translations": {
                                "ru": "Они решили бросить якорь своей яхты в уединенном <w>заливе</w>, окруженном отвесными скалами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coastal inlet",
                        "rocky inlet",
                        "sheltered inlet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая полоса воды, вдающаяся в сушу от моря, озера или реки; небольшая бухта или залив."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бухта",
                                "target_lang_sense_clarification": "небольшой залив"
                            },
                            {
                                "target_lang_word": "залив",
                                "target_lang_sense_clarification": "водное пространство, вдающееся в сушу"
                            },
                            {
                                "target_lang_word": "протока",
                                "target_lang_sense_clarification": "узкий водный проход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5ebd56d-6e3e-3916-8611-a06b344ce9f6",
                    "sense_definition": "An opening or passage through which fluid, air, or other matter enters a machine or system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Check that debris is not blocking the air <w>inlet</w> of the engine.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что мусор не перекрывает воздушное <w>впускное отверстие</w> двигателя."
                            }
                        },
                        {
                            "text": "Water flows into the filtration chamber through a wide pipe connected to the main <w>inlet</w>.",
                            "target_lang_translations": {
                                "ru": "Вода поступает в фильтрационную камеру через широкую трубу, соединенную с главным <w>входом</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "outlet"
                    ],
                    "common_phrases": [
                        "air inlet",
                        "inlet valve",
                        "inlet pipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отверстие или канал, через который жидкость, воздух или другое вещество поступает в механизм или систему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впускное отверстие",
                                "target_lang_sense_clarification": "отверстие для впуска жидкости или газа"
                            },
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "место впуска в систему"
                            },
                            {
                                "target_lang_word": "патрубок",
                                "target_lang_sense_clarification": "впускной элемент трубы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bffad661-85e7-3294-9e91-917390a59c00",
                    "sense_definition": "To allow to enter; to let in or admit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The valve mechanism was carefully engineered to <w>inlet</w> fuel only at precise intervals.",
                            "target_lang_translations": {
                                "ru": "Клапанный механизм был тщательно спроектирован так, чтобы <w>подавать</w> топливо только через строго определенные интервалы."
                            }
                        },
                        {
                            "text": "He adjusted the damper slightly to <w>inlet</w> fresh air into the sealed room.",
                            "target_lang_translations": {
                                "ru": "Он слегка отрегулировал заслонку, чтобы <w>впустить</w> свежий воздух в запертую комнату."
