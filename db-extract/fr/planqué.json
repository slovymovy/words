                "senses": [
                    {
                        "sense_id": "b7170fbf-b166-32a6-8df2-383d703031bf",
                        "entry_id": "e5d2cb25-b579-3206-9312-f0675de3bb05",
                        "glosses": [
                            "Personne qui s’arrange pour occuper un poste à l’abri ou sans risque."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ec059da0-1876-4e63-9012-9a70681db58a",
                                "sense_id": "b7170fbf-b166-32a6-8df2-383d703031bf",
                                "text": "Et c’est le moment, tout ce remue-ménage ça va faire de la place pour les gens qui veulent démarrer. Un comble serait de se faire gratter par les affectés spéciaux, planqués et serre-fesses ; vivement la classe, la classe !"
                            },
                            {
                                "example_id": "c5b777a9-ca74-4312-b347-0e1cd821df7a",
                                "sense_id": "b7170fbf-b166-32a6-8df2-383d703031bf",
                                "text": "— Ce salaud de petit planqué, dit Maillat."
                            },
                            {
                                "example_id": "fbb36fe4-7d63-4399-b308-7f2f38d388f5",
                                "sense_id": "b7170fbf-b166-32a6-8df2-383d703031bf",
                                "text": "Plus haut sont les baraques des services, des planqués, des gars d’un autre monde"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
