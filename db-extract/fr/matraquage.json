                        "examples": [
                            {
                                "example_id": "de66e4c4-e5be-4836-b8d7-f8b8263f7441",
                                "sense_id": "f7453021-0e04-331a-b54a-61fa56c1b1c6",
                                "text": "La scène violente du matraquage déclenche un flash-back chez Simeon, qui revit son propre matraquage par la police de Philadelphie."
                            },
                            {
                                "example_id": "63da12b2-9fe6-4acb-87f4-85670db21a80",
                                "sense_id": "f7453021-0e04-331a-b54a-61fa56c1b1c6",
                                "text": "Et là, il y a quand même eu une pléthore d’images de matraquage de cortèges pacifiques, de cet étudiant qui s’est fait rouler dessus par une moto de la Brav-M, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e5506a6-f0a4-39d4-8a90-7e98b0550418",
                        "entry_id": "ffade563-3b77-31c2-8fa9-8e1a97b73aca",
                        "glosses": [
                            "Le matraquage publicitaire."
