        "nl-extract.jsonl": [
            {
                "entry_id": "115ec972-e875-301d-a465-2e13983afb0f",
                "word": "toespitsen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b2184095-8ea8-3d12-8fd9-df5abdc95a2f",
                        "entry_id": "115ec972-e875-301d-a465-2e13983afb0f",
                        "glosses": [
                            "ruzies en conflicten erger maken dan ze al zijn"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d79738b5-3f4e-384b-acfd-5b7ecad7f369",
                        "entry_id": "115ec972-e875-301d-a465-2e13983afb0f",
                        "glosses": [
                            "toespitsen op: zich vooral richten op één bepaald iets"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "8e7af40b-7f95-4ca8-87ee-883b17c69d8b",
                                "sense_id": "d79738b5-3f4e-384b-acfd-5b7ecad7f369",
                                "text": "CNV zegt zich in de onderhandelingen eerst toe te willen spitsen op het zoveel mogelijk behouden van werkgelegenheid. Én pas daarna op een eerlijke compensatie voor het verlies van banen', aldus CNV. Bestuurder Gerard van der Molen van CNV Vakmensen wil graag op korte termijn om tafel met Siemens."
                            },
                            {
                                "example_id": "f6b85965-278e-4e8c-a4be-cf040d0d0dfe",
                                "sense_id": "d79738b5-3f4e-384b-acfd-5b7ecad7f369",
                                "text": "De Belgische professor Rik De Doncker, die doceert aan de universiteit in het Duitse Aken en al een hele tijd; pleitbezorger is van elektrisch rijden, wees er in een interview met deze krant ook al op dat de autobouwers zich veel te veel toespitsen op het vergroten van de actieradius."
                            },
                            {
                                "example_id": "287d4d32-975f-43b9-99f7-1787fdca84de",
                                "sense_id": "d79738b5-3f4e-384b-acfd-5b7ecad7f369",
                                "text": "Journaliste Myriam Francois onderzoekt hoe bedrijven in het westen zich in toenemende mate ook toespitsen op islamitische consumenten. Is er toekomst voor halal fastfood, ramadanafdelingen in de supermarkt of een burkini in kledingzaken?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0c7c563-9bbe-41c2-80d7-3d62509c2d02",
                        "source_entry_id": "115ec972-e875-301d-a465-2e13983afb0f",
                        "source_sense_id": "b2184095-8ea8-3d12-8fd9-df5abdc95a2f",
                        "source_sense_description": "van ruzies en conflicten deze verergeren",
                        "target_lang_word": "exacerbate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exacerbate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                        "entry_id": "3f03592f-17f9-30eb-8557-76bda1aecd40",
                                        "glosses": [
                                            "To make worse (a problem, bad situation, negative feeling, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266a8f59-7973-44da-9a85-e5ea845940b4",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "Near-synonym: worsen"
                                            },
                                            {
                                                "example_id": "b37955f1-8cba-45f6-bec7-6c0274d0c05c",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "The proposed shutdown would exacerbate unemployment problems."
                                            },
                                            {
                                                "example_id": "0b5f0a97-1778-4119-9d81-5e2fe2cc85c4",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "Sino-Soviet relations were exacerbated by a border incident on May 9. Beijing charged that thirty Soviet troops, supported by a helicopter and navy boats, crossed the Ussuri River into the Hulin area of Heilongjiang province."
                                            },
                                            {
                                                "example_id": "8d68bf77-81a7-4369-bbde-cf7dccc103ca",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "Liz: It's just with Ed here, it's no wonder I always bring my flat-mates out and then that only exacerbates things.\nShaun: What do you mean?\nLiz: Well you guys hardly get on, do you?\nShaun: No, what does \"exacerbate\" mean?"
                                            },
                                            {
                                                "example_id": "e99f7340-d99f-4394-a4cb-11cfaaa95dc8",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "The reasons for this growing disconnect are myriad and complex but the situation is exacerbated by the reality that those English players who do smash through our game's \"glass ceiling\" command radically inflated transfer fees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54927598-3c02-48e1-9de1-5c9c3b5c61e7",
                        "source_entry_id": "115ec972-e875-301d-a465-2e13983afb0f",
                        "source_sense_id": "b2184095-8ea8-3d12-8fd9-df5abdc95a2f",
                        "source_sense_description": "van ruzies en conflicten deze verergeren",
                        "target_lang_word": "sharpen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sharpen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                        "entry_id": "9fa63d35-9504-3981-b5d3-0d61fd261678",
                                        "glosses": [
                                            "To make sharp."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a53be8e-8305-4bc4-a7fe-b59a58d0d6aa",
                                                "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                                "text": "to sharpen a pencil or a knife or a musical note"
                                            },
                                            {
                                                "example_id": "1a127d15-6b60-4dd5-afe1-98864064d677",
                                                "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                                "text": "He that wrestles with us strengthens our nerves and sharpens our skill."
                                            },
                                            {
                                                "example_id": "8a40a1e7-3644-4d55-bd7d-3d8414ea2d1c",
                                                "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives.[…]who, if anyone, is policing their use. Such concerns were sharpened further by the continuing revelations about how the US National Security Agency (NSA) has been using algorithms to help it interpret the colossal amounts of data it has collected from its covert dragnet of international telecommunications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f112b54-de96-31e1-975c-639749fd8b55",
                                        "entry_id": "9fa63d35-9504-3981-b5d3-0d61fd261678",
                                        "glosses": [
                                            "To become sharp."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d50f42a-4f3e-42b7-85b8-f2b54ce51a05",
                                                "sense_id": "6f112b54-de96-31e1-975c-639749fd8b55",
                                                "text": "The organizers said they had found themselves \"more involved in the web of social convulsions and violence that is tormenting our country. The present economic crisis, the grave political instability and the rapidly sharpening violence have finally overtaken […] our wishes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9cdfa16-f007-4c28-81ce-13efb930f169",
                        "source_entry_id": "115ec972-e875-301d-a465-2e13983afb0f",
                        "source_sense_id": "b2184095-8ea8-3d12-8fd9-df5abdc95a2f",
