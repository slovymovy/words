{
    "word_family": [
        "видеть",
        "видимый",
        "видимость",
        "по-видимому",
        "невидимый",
        "увидеть",
        "предвидеть"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "98ccaf83-e47c-3b99-b111-ae546113b9b3",
                    "sense_definition": "Вводное слово, выражающее неуверенность или предположение; вероятно, по всей видимости.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "modal_word",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сам он, <w>видимо</w>, боялся: огарок в руке его дрожал, он побледнел.",
                            "target_lang_translations": {
                                "en": "He himself was <w>apparently</w> afraid: the candle stump in his hand trembled, and he turned pale.",
                                "zh": "他本人<w>看来</w>很害怕：手里拿的蜡烛头在颤抖，脸色也变得苍白。"
                            }
                        },
                        {
                            "text": "Мы, <w>видимо</w>, заблудились, потому что эта дорога мне совершенно незнакома.",
                            "target_lang_translations": {
                                "en": "We have <w>apparently</w> got lost, because this road is completely unfamiliar to me.",
                                "zh": "我们<w>看来</w>是迷路了，因为这条路我一点也不熟悉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "по-видимому",
                        "вероятно",
                        "очевидно",
                        "похоже",
                        "видно"
                    ],
                    "common_phrases": [
                        "видимо, так",
                        "видимо, зря",
                        "видимо, нет"
                    ],
                    "target_lang_definitions": {
                        "en": "A parenthetical word expressing uncertainty or assumption; probably, to all appearances.",
                        "zh": "用于表达不确定性或推测的插入语；大概，看来。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apparently",
                                "target_lang_sense_clarification": "based on what is seen or heard"
                            },
                            {
                                "target_lang_word": "evidently",
                                "target_lang_sense_clarification": "clearly inferred from evidence"
                            },
                            {
                                "target_lang_word": "probably",
                                "target_lang_sense_clarification": "very likely"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看来",
                                "target_lang_sense_clarification": "表示根据观察得出的推测"
                            },
                            {
                                "target_lang_word": "显然",
                                "target_lang_sense_clarification": "表示根据证据得出的推断"
                            },
                            {
                                "target_lang_word": "大概",
                                "target_lang_sense_clarification": "表示可能性很大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38cdbe4f-43b8-33da-925e-71876395149c",
                    "sense_definition": "Доступно для зрения, зрительно воспринимаемо; заметно.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ясно, что оно будет <w>видимо</w> простым глазом без специальных приборов.",
                            "target_lang_translations": {
                                "en": "It is clear that it will be <w>visible</w> to the naked eye without special instruments.",
                                "zh": "很明显，不用特殊仪器，肉眼也能<w>看见</w>它。"
                            }
                        },
                        {
                            "text": "Напряжение в комнате было почти <w>видимо</w> и ощущалось всеми присутствующими.",
                            "target_lang_translations": {
                                "en": "The tension in the room was almost <w>visible</w> and was felt by everyone present.",
                                "zh": "房间里的紧张气氛几乎是<w>可见</w>的，在场的所有人都感觉到了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "зримо",
                        "заметно",
                        "ощутимо"
                    ],
                    "antonyms": [
                        "незримо"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "в значении наречия образа действия"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Accessible to sight, visually perceivable; noticeably.",
                        "zh": "可以被看见的，视觉上可感知的；显而易见地。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "able to be seen"
                            },
                            {
                                "target_lang_word": "noticeably",
                                "target_lang_sense_clarification": "in a way that is easily seen or noticed"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可见",
                                "target_lang_sense_clarification": "能够被看见"
                            },
                            {
                                "target_lang_word": "显眼地",
                                "target_lang_sense_clarification": "以容易被注意到的方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9ef57519-5c57-3bf9-be77-15227c2192eb",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>видимый</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это созвездие хорошо <w>видимо</w> на ночном небе в ясную погоду.",
                            "target_lang_translations": {
                                "en": "This constellation is clearly <w>visible</w> in the night sky in clear weather.",
                                "zh": "天气晴朗时，在夜空中可以清楚地<w>看见</w>这个星座。"
                            }
                        },
                        {
                            "text": "На горизонте было <w>видимо</w> небольшое рыболовецкое судно.",
                            "target_lang_translations": {
                                "en": "A small fishing vessel was <w>visible</w> on the horizon.",
                                "zh": "地平线上<w>可见</w>一艘小型渔船。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "хорошо видимо",
                        "едва видимо"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткое прилагательное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form neuter singular of the adjective 'visible'.",
                        "zh": "形容词“可见的”的短尾形式，用于中性单数。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "perceptible by the eye"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可见",
                                "target_lang_sense_clarification": "能够被眼睛感知"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}