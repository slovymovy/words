                ],
                "senses": [
                    {
                        "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                        "entry_id": "d69dbcd6-cc84-3ff2-9c85-6e87740edb3d",
                        "glosses": [
                            "Qui est propre à convaincre, qui emporte la conviction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17fb9eca-e099-41d1-8aab-49cec5c34bec",
                                "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                                "text": "Ce qui a été réalisé jusqu’alors par le dirigeable est admirable, mais cependant pas convaincant : le dirigeable est plus à la merci d’un accident que l’avion."
                            },
                            {
                                "example_id": "ad386357-7a32-40d8-ace6-9a2f89b0d5d1",
                                "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                                "text": "11 décembre 1940 – J’ai refait trois fois ma première lettre d’amour. Elle me paraît assez convaincante. S’il suffisait pour vaincre de convaincre, l’affaire serait dans le sac."
                            },
                            {
                                "example_id": "1204004a-d17d-4c14-9383-ab336458128e",
                                "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                                "text": "Mais quand bien même serions-nous plus nombreux, arriverions-nous à obtenir des résultats convaincants ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1deac24-7c28-4821-94d6-f3dbd4476bbb",
                        "source_entry_id": "d69dbcd6-cc84-3ff2-9c85-6e87740edb3d",
                        "source_sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
