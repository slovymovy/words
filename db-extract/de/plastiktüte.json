                        "form": "die Plastiktüte"
                    },
                    {
                        "form_id": "4ebf2da5-3eb8-4cdd-9907-a293234860ca",
                        "entry_id": "fa9850e4-f358-392f-98a2-ccc359a388c4",
                        "tags": [
                            "accusative",
