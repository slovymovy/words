                        "source_sense_id": "5c44b99b-0176-3d18-9309-b7bc27c47ce1",
                        "source_sense_description": "gewas met een groot aantal variëteiten, waarvan keukenraap en meiraap...",
                        "target_lang_word": "turnip",
