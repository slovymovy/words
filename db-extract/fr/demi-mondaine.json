                ],
                "senses": [
                    {
                        "sense_id": "013890cd-97b3-3cab-ac8a-6159bf6e7941",
                        "entry_id": "89d7515c-e8d4-3c30-b5d2-f754643364d8",
                        "glosses": [
                            "Femme de mœurs légères appartenant au demi-monde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "121bc7e7-8fc8-42fd-8d36-e537af3f0e00",
                                "sense_id": "013890cd-97b3-3cab-ac8a-6159bf6e7941",
                                "text": "Les demi-mondaines du Second Empire."
                            },
                            {
                                "example_id": "a8c9cefc-257a-44ba-acef-2b7b9848f753",
                                "sense_id": "013890cd-97b3-3cab-ac8a-6159bf6e7941",
                                "text": "Le public du premier étage est éminemment pittoresque ; on y rencontre … les demi-mondaines de demi-luxe qui pullulent à Londres aux environs de Piccadilly."
                            },
                            {
                                "example_id": "13eacdc0-ec79-48ad-933b-6c046eec0e14",
                                "sense_id": "013890cd-97b3-3cab-ac8a-6159bf6e7941",
                                "text": "Il est piquant, au sortir d’un cabinet particulier du Sacher, de croiser l’Archiduc qui sort d’un autre entre deux vins et deux demi-mondaines."
                            },
                            {
                                "example_id": "4fd71e90-e784-4894-9c29-52ed0d7e5291",
                                "sense_id": "013890cd-97b3-3cab-ac8a-6159bf6e7941",
                                "text": "Ce sont des noms de demi-mondaines, maman."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "045e1f12-88bb-4566-a918-ba30f91f3b50",
                        "source_entry_id": "89d7515c-e8d4-3c30-b5d2-f754643364d8",
                        "source_sense_id": "013890cd-97b3-3cab-ac8a-6159bf6e7941",
                        "target_lang_word": "demimondaine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demimondaine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab17aae9-a5ce-3f42-b943-e0b06304d9bf",
                                        "entry_id": "2a8aa1f8-b1f7-34fa-830a-c90cb8ce39e1",
                                        "glosses": [
                                            "A sexually promiscuous woman (of the demimonde)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aac73f1-7233-4d98-89d0-d93930396457",
                                                "sense_id": "ab17aae9-a5ce-3f42-b943-e0b06304d9bf",
                                                "text": "However, terrible as it may seem to the tall maiden sisters of J.P.'s in Queen Anne houses with walled vegetable gardens, this courtesan, strumpet, harlot, whore, punk, fille de joie, street-walker, this trollop, this trull, this baggage, this hussy, this drab, skit, rig, quean, mopsy, demirep, demimondaine, this wanton, this fornicatress, this doxy, this concubine, this frail sister, this poor Queenie--did actually solicit me, did actually say 'coming home to-night, dearie' and my soul was not blasted enough to call a policeman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
