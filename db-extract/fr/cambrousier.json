                        "sense_id": "6a8c965f-106e-3ed0-bc69-9e806d76e226",
                        "entry_id": "07ead6f0-cba2-394f-add0-f4ee5f9c98ec",
                        "glosses": [
                            "Habitant de la cambrousse."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "be423a8c-e1ba-4e55-8597-9d816c703cdd",
                                "sense_id": "6a8c965f-106e-3ed0-bc69-9e806d76e226",
                                "text": "[…] il y a beau temps qu’elle ne produit plus un architecte ; les gens qui s’affublent de ce nom sont des cambrousiers, des maçons dénués de toute personnalité, de toute science."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5c3f5d9-8c98-38d9-8513-98a76aad91bf",
                        "entry_id": "07ead6f0-cba2-394f-add0-f4ee5f9c98ec",
                        "glosses": [
                            "Brocanteur."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0e3385cc-0f33-4415-af59-4bc3ec8644c3",
                                "sense_id": "f5c3f5d9-8c98-38d9-8513-98a76aad91bf",
                                "text": "Tu sais que je ne suis pas trop feignant, je n’ai pas du poil dans la main pour l’ouvrage… Puis, on pourrait voir à n’être pas toujours à travailler pour les autres, à prendre une boîte de cambrousier… Toi, si tu avais quelque chose de côté, ça aiderait… Nous nous mettrions ensemble gentiment, quitte à nous faire régulariser un jour devant M. le maire…"
                            }
                        ]
                    }
