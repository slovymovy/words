        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa5c0e24-b5ed-3742-8f8c-95f8612f0f91",
                    "sense_definition": "To introduce or discontinue something gradually over a period of time, typically used with 'in' or 'out'.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>phase</w> out the old computer systems by next year.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>постепенно вывести</w> из эксплуатации старые компьютерные системы к следующему году.",
                                "zh": "公司计划在明年之前<w>逐步淘汰</w>旧的计算机系统。"
                            }
                        },
                        {
                            "text": "We will <w>phase</w> in the new safety regulations over the coming months.",
                            "target_lang_translations": {
                                "ru": "Мы будем <w>поэтапно вводить</w> новые правила техники безопасности в течение ближайших месяцев.",
                                "zh": "我们将在未来几个月内<w>逐步引入</w>新的安全法规。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "phase in",
                        "phase out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить или прекращать что-либо постепенно в течение определенного периода времени.",
                        "zh": "在一段时间内逐步引入或逐步淘汰某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постепенно вводить",
                                "target_lang_sense_clarification": "внедрять поэтапно"
                            },
                            {
                                "target_lang_word": "постепенно выводить",
                                "target_lang_sense_clarification": "прекращать использование"
                            },
                            {
                                "target_lang_word": "осуществлять поэтапно",
                                "target_lang_sense_clarification": "распределять по фазам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逐步引入",
                                "target_lang_sense_clarification": "分阶段实施"
                            },
                            {
                                "target_lang_word": "逐步淘汰",
                                "target_lang_sense_clarification": "分阶段停止使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e6ca55-6609-3343-af34-0b3d8fdac115",
                    "sense_definition": "To pass through solid matter, often used in the context of science fiction or gaming.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fiction_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the video game, the character can <w>phase</w> through walls to escape enemies.",
                            "target_lang_translations": {
                                "ru": "В видеоигре персонаж может <w>проходить сквозь</w> стены, чтобы сбежать от врагов.",
                                "zh": "在游戏中，角色可以<w>穿过</w>墙壁以逃避敌人。"
                            }
                        },
                        {
                            "text": "The ghost appeared to <w>phase</w> directly into the locked room.",
                            "target_lang_translations": {
                                "ru": "Призрак, казалось, <w>прошел</w> прямо в запертую комнату.",
                                "zh": "鬼魂似乎直接<w>穿过</w>墙壁进入了锁着的房间。"
                            }
