                ],
                "senses": [
                    {
                        "sense_id": "8e6016fb-e4ff-3e1a-8230-d9c3bf3dae88",
                        "entry_id": "7015b4c1-eaac-3b71-937c-21ac3f6ccbec",
                        "glosses": [
                            "ein an einem Standort herrschender, für Lebewesen bedeutsamer Einfluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71378fdc-1755-416f-88b0-6528ac6654d9",
                                "sense_id": "8e6016fb-e4ff-3e1a-8230-d9c3bf3dae88",
                                "text": "„Die Kernfrage der Anpassung an die Umweltbedingungen klingt sehr einfach. Aber die Antwort darauf ist unheimlich kompliziert“, berichtet Schlötterer."
                            },
                            {
                                "example_id": "1bc73743-bea2-412b-b5c0-413128dbaa1f",
                                "sense_id": "8e6016fb-e4ff-3e1a-8230-d9c3bf3dae88",
                                "text": "„Dort gibt es stabile Umweltbedingungen und Schutz vor kosmischer Strahlung, ein idealer Rückzugsraum für zumindest bakterielles Leben.“"
                            },
                            {
                                "example_id": "30be37b8-4daa-48bb-a26b-89780ad1b716",
                                "sense_id": "8e6016fb-e4ff-3e1a-8230-d9c3bf3dae88",
                                "text": "Das stellt sicher, dass die Pflanze nur wächst oder keimt, wenn die Umweltbedingungen günstig sind, keine Energie unnötig vergeudet wird."
                            },
                            {
                                "example_id": "c592b68b-39e1-40c5-ae00-cb2e10e8a4e2",
                                "sense_id": "8e6016fb-e4ff-3e1a-8230-d9c3bf3dae88",
                                "text": "Dabei ging es ihnen darum, mögliche Zusammenhänge zwischen Körpergröße und Umweltbedingungen wie Temperatur, Kohlendioxidkonzentration der Luft und Niederschlag zu überprüfen."
                            },
                            {
                                "example_id": "1987c2f9-2f6d-4c76-9fc2-8911605472c6",
                                "sense_id": "8e6016fb-e4ff-3e1a-8230-d9c3bf3dae88",
                                "text": "Zuvor müssten mit Gentech-Pflanzen mehr Stress-Tests in Labors und Gewächshäusern stattfinden, in denen Pflanzen verschiedenen Umweltbedingungen ausgesetzt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
