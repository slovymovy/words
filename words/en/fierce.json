                            },
                            {
                                "target_lang_word": "грозный",
                                "target_lang_sense_clarification": "внушающий страх своим видом"
                            },
                            {
                                "target_lang_word": "устрашающий",
                                "target_lang_sense_clarification": "пугающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凶狠",
                                "target_lang_sense_clarification": "形容表情或眼神"
                            },
                            {
                                "target_lang_word": "狰狞",
                                "target_lang_sense_clarification": "形容令人恐惧的面貌"
                            },
                            {
                                "target_lang_word": "威严",
                                "target_lang_sense_clarification": "形容令人敬畏的姿态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1591829c-44f8-367e-842c-a80aeb4eed31",
                    "sense_definition": "Showing strong feeling or energetic activity; resolute and intense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I feel a <w>fierce</w> loyalty to my kin and will protect them.",
                            "target_lang_translations": {
                                "ru": "Я чувствую <w>сильную</w> преданность своему роду и буду защищать их.",
                                "zh": "我对家人怀有<w>强烈</w>的忠诚，我会保护他们。"
                            }
                        },
                        {
                            "text": "They made a <w>fierce</w> attempt to escape from the locked room.",
                            "target_lang_translations": {
                                "ru": "Они предприняли <w>яростную</w> попытку сбежать из запертой комнаты.",
                                "zh": "他们<w>拼命</w>尝试从锁着的房间里逃出去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incessive"
                    ],
                    "antonyms": [
                        "indifferent",
                        "weak"
                    ],
                    "common_phrases": [
                        "fierce loyalty",
                        "fierce determination",
                        "fierce independence"
                    ],
                    "target_lang_definitions": {
