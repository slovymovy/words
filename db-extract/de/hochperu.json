                                        "entry_id": "fde10c5c-5bd7-3452-8eb7-dbc8da6c95be",
                                        "glosses": [
                                            "Région de l’ancienne vice-royauté du Pérou qui correspond à l’actuel état de Bolivie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77b14dfa-b8b8-43e5-93d9-675088dab88c",
                                                "sense_id": "5db9a428-93b7-3aa5-aafe-fa4bf7f2ad36",
                                                "text": "En hommage au Libertador Simon Bolivar, on donne le nom de Bolivie à la nouvelle république qui naît en 1825 et remplace le « haut Pérou » de l’époque coloniale."
                                            }
                                        ]
                                    }
