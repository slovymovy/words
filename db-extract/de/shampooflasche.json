                ],
                "senses": [
                    {
                        "sense_id": "318bd0c4-34cd-3633-9ba3-274d414b093f",
                        "entry_id": "88702b23-a473-3735-9dc7-7dad46e3321c",
                        "glosses": [
                            "mit Shampoo gefüllte Flasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c7fe56-bb3c-4ef4-baba-f30dac27d8e0",
                                "sense_id": "318bd0c4-34cd-3633-9ba3-274d414b093f",
                                "text": "„Sie hat den Mantel sehr eng um die Taille geschnürt, unter ihrem Arm klemmt ein Handtuch und eine Shampooflasche.“"
                            },
                            {
                                "example_id": "47cc164e-0ba2-43a1-b9e9-bcf51115b5ef",
                                "sense_id": "318bd0c4-34cd-3633-9ba3-274d414b093f",
                                "text": "„Geschäftsführer Christian Hündgen greift eine zerquetschte Shampooflasche aus dem an dieser Stelle noch ziemlich wilden Stoffgemisch.“"
                            },
                            {
                                "example_id": "c36bf615-d485-4b3d-b93d-e9ea37e8ef1b",
                                "sense_id": "318bd0c4-34cd-3633-9ba3-274d414b093f",
                                "text": "„Ich stand wie vom Donner gerührt in der großen Dusche im Badezimmer von Bens Eltern und hielt eine Shampooflasche in der einen Hand, einen Klecks davon in der anderen, von dem mir genau dieser Duft entgegenströmte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
