                    "sense_id": "97e395c5-d72e-3dfe-89c7-aff1413fe1bb",
                    "sense_definition": "iets nog een keer of meerdere keren doen, zeggen of laten gebeuren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kon u niet goed verstaan, kunt u dat even <w>herhalen</w>?",
                            "target_lang_translations": {
                                "en": "I couldn't hear you well, could you <w>repeat</w> that for a moment?"
                            }
                        },
                        {
                            "text": "Het eerder uitgezonden programma wordt morgen op televisie <w>herhaald</w>.",
                            "target_lang_translations": {
                                "en": "The previously broadcast program will be <w>repeated</w> on television tomorrow."
                            }
                        },
                        {
                            "text": "We moeten de <w>woorden</w> <w>herhalen</w> om ze goed te kunnen onthouden.",
                            "target_lang_translations": {
                                "en": "We need to <w>repeat</w> the words to be able to remember them well."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>herhaalt</w> zich hetzelfde ritueel van koffie zetten en de krant lezen.",
                            "target_lang_translations": {
                                "en": "Every morning the same ritual of making coffee and reading the newspaper <w>repeats</w> itself."
                            }
                        }
                    ],
                    "synonyms": [
                        "repeteren"
                    ],
                    "common_phrases": [
                        "woorden herhalen",
                        "zich herhalen",
                        "een vraag herhalen",
                        "de geschiedenis herhaalt"
                    ],
                    "target_lang_definitions": {
