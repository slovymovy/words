                    {
                        "translation_id": "52f2c0fa-d5ad-4c60-b46b-0187b738d6ca",
                        "source_entry_id": "ed8a4d0e-50f9-3843-b5e9-051fd41ae38e",
                        "source_sense_description": "a pathological fear or hatred of strangers or foreigners",
                        "target_lang_word": "Xenophobie",
