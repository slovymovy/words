                        "glosses": [
                            "Person, die beruflich Krankenwagen fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15fd58d-7afc-4589-a964-a278bbd1f894",
                                "sense_id": "4d0df7ec-1abb-38cc-ab16-c806aa8b6ec4",
                                "text": "„Es stellt sich heraus, dass Davis zur Aushilfe Krankenwagenfahrer war.“"
                            },
                            {
                                "example_id": "6bbc5b8d-98be-4162-962c-9ce0e93c5b45",
                                "sense_id": "4d0df7ec-1abb-38cc-ab16-c806aa8b6ec4",
                                "text": "„Der Putzmann braucht seine Eindrücke jetzt nur noch einem Krankenwagenfahrer zu schildern, dessen Frau drei Fehlgeburten hatte, und die Nachricht verbreitet sich wie ein Lauffeuer, denn wenn so etwas einmal angefangen hat, entwickelt es eine Eigendynamik und pflanzt sich durch vom Glauben Abgefallene fort, die nur auf ein Zeichen gewartet haben, und erreicht die wahrhaft Bedürftigen, die es sich nicht leisten können, die Hoffnung zu verlieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
