                "senses": [
                    {
                        "sense_id": "8afd9c56-db1e-3fe3-9e86-10b60b0e8d56",
                        "entry_id": "02bb7192-9fba-3fcd-8c24-58018d5423a5",
                        "glosses": [
                            "Pflock aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61824518-64d2-4ab3-9d67-9463ce646670",
                                "sense_id": "8afd9c56-db1e-3fe3-9e86-10b60b0e8d56",
                                "text": "„Er gab keinen Laut von sich, als wir ihm Holzpflöcke durch die Hände trieben und ihn pfählten.“"
                            },
                            {
                                "example_id": "bca1f2c3-dab2-4d44-9f5d-a6498c52cf85",
                                "sense_id": "8afd9c56-db1e-3fe3-9e86-10b60b0e8d56",
                                "text": "„Und nach ihren mühsamen Ermittlungen hätten auch sie ein Recht darauf. Ein Recht darauf, dass Cassandra in den Zeugenstand trete und unter Tränen schildere, wie das Ungeheuer ihr die Finger abgeschnitten hatte. Ihr die Brust aufgeritzt hatte. Ihr einen Holzpflock in den hungrigen Arsch getrieben hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
