                "translations": [
                    {
                        "translation_id": "22fe6b15-23c6-4dd0-a755-038e412e95ff",
                        "source_entry_id": "a26e50f7-3f9c-311c-b5e7-2cf9f29807c4",
                        "source_sense_id": "68d061c2-bf45-3b91-9d0c-93014baab293",
                        "target_lang_word": "thorough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thorough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2743b61b-d054-389f-ae66-f94fc35a6756",
                                        "entry_id": "7db6fe6d-ff7b-3afd-8258-ee3406b3f7ab",
                                        "glosses": [
                                            "Painstaking and careful not to miss or omit any detail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31481f6-ff44-46d2-8f1c-46f0bb3eb3b1",
                                                "sense_id": "2743b61b-d054-389f-ae66-f94fc35a6756",
                                                "text": "The Prime Minister announced a thorough investigation into the death of a father-of-two in police custody."
                                            },
                                            {
                                                "example_id": "80d13b5b-8a82-492e-a1a9-fd8a550479b4",
                                                "sense_id": "2743b61b-d054-389f-ae66-f94fc35a6756",
                                                "text": "Not enough! Your work has to be thorougher than this."
                                            },
                                            {
                                                "example_id": "24beaadc-bf22-4e0b-9210-38e9e467b17c",
                                                "sense_id": "2743b61b-d054-389f-ae66-f94fc35a6756",
                                                "text": "It's the most thorough artwork I have ever seen!"
                                            },
                                            {
                                                "example_id": "9ecb9c41-935f-46d0-90b5-638c763763dc",
                                                "sense_id": "2743b61b-d054-389f-ae66-f94fc35a6756",
                                                "text": "The infested house needs a thorough cleansing before being inhabitable again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e02dfbe-ccb1-39c7-a9a0-eb53d6255398",
                                        "entry_id": "7db6fe6d-ff7b-3afd-8258-ee3406b3f7ab",
                                        "glosses": [
                                            "Utter; complete; absolute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f7f001-fdb8-48ee-9428-a29a698a9265",
                                                "sense_id": "8e02dfbe-ccb1-39c7-a9a0-eb53d6255398",
                                                "text": "Dr. Oldfield once said to me, 'You talk to me quite all right, but why is it that you never open your lips at a committee meeting? You are a drone.' I appreciated the banter. The bees are ever busy, the drone is a thorough idler."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thorough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6c62578-dd70-3ff0-a20b-582eb72c6086",
                                        "entry_id": "bbe09d9e-a740-369f-9ea6-3343650809d9",
                                        "glosses": [
                                            "Through."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7214b3ec-d879-4e92-98d0-1c5a3d228dca",
                                                "sense_id": "e6c62578-dd70-3ff0-a20b-582eb72c6086",
                                                "text": "Ye might haue ſeene the frothy billowes fry\n Vnder the ſhip, as thorough them ſhe went […]"
                                            },
                                            {
                                                "example_id": "63a6f5c4-bbfe-4cb5-b6c0-c121476f102e",
                                                "sense_id": "e6c62578-dd70-3ff0-a20b-582eb72c6086",
                                                "text": "You are contented to be led in triumph\n Thorough the streets of Rome?"
                                            },
                                            {
                                                "example_id": "1e8898d0-916c-4d80-b97c-1a49b77939a3",
                                                "sense_id": "e6c62578-dd70-3ff0-a20b-582eb72c6086",
                                                "text": "At length did cross an Albatross: / Thorough the fog it came; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thorough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53c03547-b9d2-3b06-983c-84c4e9309aab",
                                        "entry_id": "15206f35-70f5-38b1-94c2-5263a790c572",
                                        "glosses": [
                                            "A furrow between two ridges, to drain off the surface water."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "310521d8-07fb-4308-9325-b48df41a70c4",
                                                "sense_id": "53c03547-b9d2-3b06-983c-84c4e9309aab",
                                                "text": "The Ignorance and Idleness of the Plowman, who either goes so shallow, or plows his Thoroughs so wide, or misses Part of the Ground."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
