                                    },
                                    {
                                        "sense_id": "9f610a64-9953-348e-93dd-0a99353a4058",
                                        "entry_id": "197545f0-4e3b-3981-8eac-00e8dd1a3b20",
                                        "glosses": [
                                            "zadanie komuś klęski"
                                        ],
