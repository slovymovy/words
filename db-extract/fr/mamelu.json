                "senses": [
                    {
                        "sense_id": "b4a81b4d-4385-3c5f-b79e-ac769bee61da",
                        "entry_id": "d7f6eb21-2903-34a5-8bd5-4f022ec092ce",
                        "glosses": [
                            "Personne dotée de grosses mamelles."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c3bab237-610b-460e-821a-929514c910a2",
                                "sense_id": "b4a81b4d-4385-3c5f-b79e-ac769bee61da",
                                "text": "Oui, Bizozoro le roux, le musclé, le mamelu, le trop gorgé de viandes, le furonculeux, le garçon boucher au tablier sanglant."
                            },
                            {
                                "example_id": "e51d2e95-a0e6-4cc6-9aff-a8e7d98c8153",
                                "sense_id": "b4a81b4d-4385-3c5f-b79e-ac769bee61da",
                                "text": "Future mamelue, aucun doute… sans les restrictions, elle aurait peut-être déjà un cul à couver quatorze canards !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d93ba5ee-3ed1-4bf1-8e88-23ebe7cfe38c",
                        "source_entry_id": "d7f6eb21-2903-34a5-8bd5-4f022ec092ce",
                        "source_sense_id": "b4a81b4d-4385-3c5f-b79e-ac769bee61da",
