                                "target_senses": [
                                    {
                                        "sense_id": "9690d75d-391a-3d7d-bc2a-e904a42d67ce",
                                        "entry_id": "d5a8313b-77fd-3668-864b-ed0251a59334",
                                        "glosses": [
                                            "Vermittler von Vertragsgegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32191708-7b6e-4cd1-8cb8-22732bd4aefd",
                                                "sense_id": "9690d75d-391a-3d7d-bc2a-e904a42d67ce",
                                                "text": "Der Makler vermittelte ihm eine Immobilie."
                                            },
                                            {
                                                "example_id": "a3e1abf9-aa82-457c-9d6a-aef1e8bebaea",
                                                "sense_id": "9690d75d-391a-3d7d-bc2a-e904a42d67ce",
                                                "text": "„Können Zweifel nicht hundertprozentig durch den Makler oder Verkäufer ausgeräumt werden, sollte man über Alternativen nachdenken.“"
                                            },
                                            {
                                                "example_id": "906fd370-a08e-4aec-9d0e-ed88de836d28",
                                                "sense_id": "9690d75d-391a-3d7d-bc2a-e904a42d67ce",
                                                "text": "„Der Makler ging zum Schreibtisch und hob ein Modellflugzeug hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5eb5514a-320f-4793-b8be-9c8d98ecf8a4",
                        "source_entry_id": "197d0e08-2d31-3f8e-adf7-29bfcd54b047",
                        "source_sense_id": "0d76de33-35a9-3145-a2c5-5b135bf0b343",
                        "target_lang_word": "courtier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "196ec8da-90f4-36e0-a49e-ba0519d5ed63",
                                        "entry_id": "487a00d0-cd87-33d9-b691-0aa539629b66",
                                        "glosses": [
                                            "Mandataire (attention, pas au sens où le droit commercial l’entend) qui, moyennant une prime, s’entremet pour la vente ou l’achat de certaines marchandises, ou pour les affrètements, les assurances, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7850b33-ae2f-4594-8401-d5ae98e0581a",
                                                "sense_id": "196ec8da-90f4-36e0-a49e-ba0519d5ed63",
                                                "text": "Morel est maintenant courtier en pierres fines."
                                            },
                                            {
                                                "example_id": "7e98cb0c-b15c-4576-85cf-8b3f8e2718de",
                                                "sense_id": "196ec8da-90f4-36e0-a49e-ba0519d5ed63",
                                                "text": "Les expéditeurs sont à leur poste ; les courtiers des grandes maisons étrangères sont sur pied. Sans beaucoup de bruit, des cours s'établissent, des transactions s'effectuent, des chargements s'accomplissent."
                                            },
                                            {
                                                "example_id": "e75e956b-977b-4d50-8cf8-36e4717e8d2b",
                                                "sense_id": "196ec8da-90f4-36e0-a49e-ba0519d5ed63",
                                                "text": "— Les courtiers filaient doux avec elle. En voilà une qui savait limer un bordereau, toujours sans escompte ni courtage…"
                                            },
                                            {
                                                "example_id": "3dc5e85e-31dd-4649-a48d-715ecae24283",
                                                "sense_id": "196ec8da-90f4-36e0-a49e-ba0519d5ed63",
                                                "text": "Les courtiers de transport par terre et par eau constitués selon la loi ont seuls, dans les lieux où ils sont établis, le droit de faire le courtage des transports par terre et par eau. Ils ne peuvent cumuler leurs fonctions avec celles de courtiers de marchandises ou de courtiers conducteurs de navires, désignés à l'article L. 131-1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b123385-4d45-3155-a414-247d9cdd2244",
                                        "entry_id": "487a00d0-cd87-33d9-b691-0aa539629b66",
                                        "glosses": [
                                            "Intermédiaire qui agit sur les marchés financiers pour le compte de tiers ; intermédiaire qui met en relation deux parties pour qu’elles contractent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
