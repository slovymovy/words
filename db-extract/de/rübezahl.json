                        ],
                        "examples": [
                            {
                                "example_id": "25e66a17-fca6-44b9-93fc-f3e8bc7fa85b",
                                "sense_id": "36c6d439-40ef-3288-9d4c-91c855a24b37",
                                "text": "Entbinden nicht unsere Gesetze von solchen Schwüren? Macht das Kindern weiß, die den Rübezahl glauben. Es stecken andere Sachen dahinter."
                            }
                        ]
