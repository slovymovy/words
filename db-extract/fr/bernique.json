                ],
                "senses": [
                    {
                        "sense_id": "7678cf0b-0b8d-387d-86f3-520be4da0229",
                        "entry_id": "cf24a589-b23a-30d2-9026-5da88d332c13",
                        "glosses": [
                            "Patelle."
                        ],
                        "tags": [
                            "Ouest de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "be262e91-0bf4-4675-8b92-738b88959b62",
                                "sense_id": "7678cf0b-0b8d-387d-86f3-520be4da0229",
                                "text": "Dimanche, nous sommes allés à la pêche aux berniques près du Croisic."
                            },
                            {
                                "example_id": "efd6143f-44d5-49d1-9dc4-70a6266a9aea",
                                "sense_id": "7678cf0b-0b8d-387d-86f3-520be4da0229",
                                "text": "Au long de la grève que le jusant découvre, un pêcheur de berniques se hâte, et des mousses arrivent, en courant, les jambes nues, barbotent dans les flaques, soulèvent les pierres tapissées de goémon, à la recherche des loches et des cancres…"
                            }
                        ]
                    },
                    {
                        "sense_id": "a6d371a5-25dc-36be-9a01-8379935ed8e0",
                        "entry_id": "cf24a589-b23a-30d2-9026-5da88d332c13",
                        "glosses": [
                            "Personne collante, qui recherche abusivement le contact des autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ffd5c3f-d1d5-46e2-a502-8fdf47a60cd1",
                                "sense_id": "a6d371a5-25dc-36be-9a01-8379935ed8e0",
                                "text": "Quelle bernique, je me le suis coltiné toute la matinée !"
                            }
                        ]
                    }
                ],
