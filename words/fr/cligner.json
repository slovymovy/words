    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf5da84e-0e78-3102-9d97-a38906623875",
                    "sense_definition": "Fermer ou rétrécir les yeux à demi, notamment sous l'effet d'une lumière vive ou pour mieux distinguer quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ébloui par le soleil matinal, il a dû <w>cligner</w> des yeux pour distinguer la route."
                        },
                        {
                            "text": "Elle regardait au loin en <w>clignant</w> des yeux pour essayer de lire le panneau."
                        }
                    ],
                    "synonyms": [
                        "plisser"
                    ],
                    "common_phrases": [
                        "cligner des yeux",
                        "cligner des paupières"
                    ]
                },
                {
                    "sense_id": "7d71b356-dba5-3674-914b-808c0eb42447",
                    "sense_definition": "Fermer et rouvrir rapidement un œil pour faire un signe d'entente, de complicité ou de connivence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il m'a souri avant de <w>cligner</w> de l'œil pour me rassurer discrètement."
                        },
                        {
                            "text": "Elle a <w>cligné</w> de l'œil à son collègue pour lui donner le signal convenu."
                        }
                    ],
                    "common_phrases": [
                        "cligner de l'œil"
                    ]
                }
            ]
        }
    ]
}