                                "example_id": "9fabbb2d-cbf9-4a8d-98c1-a0d2b1a916f5",
                                "sense_id": "771774cf-d496-343c-8313-3b9627f4dd7c",
                                "text": "Zijn bekendheid met deze materie is een groot voordeel voor onze vereniging."
                            }
                        ]
                    },
                    {
                        "sense_id": "587386c5-e193-3ffd-9ad1-f7d07e53267a",
                        "entry_id": "1de38cc3-1e66-30e1-9ad0-d4a0a091c3c5",
                        "glosses": [
                            "iemand die bij velen bekend is"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "8f5c3042-a57f-431a-b1fe-8670e8ed4954",
                                "sense_id": "587386c5-e193-3ffd-9ad1-f7d07e53267a",
                                "text": "Hij is een bekendheid in Gouda en omstreken: de portier van de Goudse Schouwburg, Will Bos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a48de2c9-f3b8-4bc1-97f9-4d16c15aa828",
                        "source_entry_id": "1de38cc3-1e66-30e1-9ad0-d4a0a091c3c5",
                        "target_lang_word": "Bekanntheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bekanntheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                        "entry_id": "7c03cc56-d6ff-3591-8306-0c78f7cf42ad",
                                        "glosses": [
                                            "Umstand, von vielen gekannt zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50c59bc7-2b82-42aa-8a2f-d4a3f173c370",
                                                "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                                "text": "„Aber er kann helfen, die Bekanntheit eines Projekts zu steigern und einen Künstler bekannter zu machen.“"
                                            },
                                            {
                                                "example_id": "f199dd71-cb33-4ec2-9bcc-e41b3d0bedb6",
                                                "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                                "text": "„Mit der wachsenden Bekanntheit des Brunello hat auch der lokale Tourismus Auftrieb erhalten.“"
                                            },
                                            {
                                                "example_id": "edc1974e-32bd-456e-b6df-04c947e91f5b",
                                                "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                                "text": "„Die Bekanntheit und die, nach Wielands Urteil, verfehlten bisherigen Bearbeitungen sind ein Grund für seine Stoffwahl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e44a162-66d4-3544-8c56-d0051d9f2ed1",
                                        "entry_id": "7c03cc56-d6ff-3591-8306-0c78f7cf42ad",
                                        "glosses": [
                                            "prominente Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea8e0563-24b5-4d13-bb4e-d76501264c8a",
                                                "sense_id": "0e44a162-66d4-3544-8c56-d0051d9f2ed1",
                                                "text": "„Auch die Unerreichbarkeit, das Funkeln und die Distanz, die der Begriff Star beinhaltet, sind bei diesen Bekanntheiten nicht mehr vorhanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b5371ef-19e2-4ffd-bc6f-662016f0b785",
                        "source_entry_id": "1de38cc3-1e66-30e1-9ad0-d4a0a091c3c5",
                        "target_lang_word": "acquaintance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquaintance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee2d6858-d40d-3eee-b4af-adb577d7584d",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "A state of being acquainted with a person; originally indicating friendship, intimacy, but now suggesting a slight knowledge less deep than that of friendship; acquaintanceship."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c90bd7-715c-474c-bb07-50be25c1844d",
                                                "sense_id": "ee2d6858-d40d-3eee-b4af-adb577d7584d",
                                                "text": "I know of the man; but have no acquaintance with him."
                                            },
                                            {
                                                "example_id": "e6c47470-f2d0-427f-8e1e-4aa9742cf391",
                                                "sense_id": "ee2d6858-d40d-3eee-b4af-adb577d7584d",
                                                "text": "Contract no friendſhip, or even acquaintance, with a guileful man : he reſembles a coal, which when hot burneth the hand, and when cold blacketh it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08abc13d-b8c9-303c-bb0d-5c04ea76efda",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "A person or persons with whom one is acquainted."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800cf5f7-03ae-4cf1-a3cf-3240fb423cff",
                                                "sense_id": "08abc13d-b8c9-303c-bb0d-5c04ea76efda",
                                                "text": "Montgomery was an old acquaintance of Ferguson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd9e461d-0c7c-3a30-8c27-f563cbd47303",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "Such people collectively; one's circle of acquaintances (with plural concord)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dc6d8fe-1b31-4c2d-b82d-a1ba91491047",
                                                "sense_id": "bd9e461d-0c7c-3a30-8c27-f563cbd47303",
                                                "text": "Having therefore conſulted with my Wife, and ſome of my Acquaintance, I determined to go again to Sea."
                                            },
                                            {
                                                "example_id": "1dec4db0-c45d-4743-92aa-6e6b1af24591",
                                                "sense_id": "bd9e461d-0c7c-3a30-8c27-f563cbd47303",
                                                "text": "Their mother […] was busy in the mean time in keeping up her connections, as she termed a numerous acquaintance, lest her girls should want a proper introduction into the great world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca0d120-0062-3830-9c53-3ff305d83612",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "Personal knowledge (with a specific subject etc.)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd475233-6f9a-46b4-a38c-d81d56e957ca",
                                                "sense_id": "fca0d120-0062-3830-9c53-3ff305d83612",
                                                "text": "The words of these songs were either without meaning, or derived from an idiom with which Watt, a very fair linguist, had no acquaintance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a65e0bc7-94ae-4bba-bd9e-17ca55056b93",
                        "source_entry_id": "1de38cc3-1e66-30e1-9ad0-d4a0a091c3c5",
