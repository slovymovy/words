                    {
                        "form_id": "4741ae8b-a6e9-40cd-b1d0-50cb1fa3324e",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "tags": [],
                        "form": "vlagschip",
                        "note": "in 1924 nog in 6e druk Van Dale"
                    },
                    {
                        "form_id": "526b86d7-dcbb-4451-bed1-5c973db9f6b7",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "tags": [],
                        "form": "vlaggeschip",
                        "note": "voor 1995"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0676fcc6-7141-3fde-b56b-07209853c5ad",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "glosses": [
                            "schip waarop zich de bevelvoerder over een vloot of eskader bevindt (die bevoegd is een commandovlag te voeren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afadd5a1-1dee-4708-ba73-7a0f298b40f3",
                                "sense_id": "0676fcc6-7141-3fde-b56b-07209853c5ad",
                                "text": "De Engelse commandant lag met zijn vlaggenschip niet tegenover Zoutmans 'Admiraal De Ruyter' en daarom liet hij zijn schip in de richting van het Nederlandse vlaggenschip afzakken."
                            }
                        ]
                    },
                    {
                        "sense_id": "cafc5c1e-2221-34c6-aba2-fe1de1440a09",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "glosses": [
                            "type schip dat zich bij uitstek gelegenheid biedt om het bevel over een vloot of eskader te voeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbb2d059-c83b-4639-b7ba-2697fb6ad978",
                                "sense_id": "cafc5c1e-2221-34c6-aba2-fe1de1440a09",
                                "text": "De Koninklijke Marine beschikt over vier luchtverdedigings- en commandofregatten, ook wel de vlaggenschepen van de marine genoemd."
                            }
                        ]
                    },
                    {
                        "sense_id": "43b99f10-0372-3c52-a220-f50f04718b3f",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "glosses": [
                            "meest toonaangevende schip van een rederij; doorgaans het grootste, mooiste of nieuwste schip, dat een positief beeld van de hele rederij moet oproepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2ec2ed-0c7b-4356-94a7-41ec2fa55653",
                                "sense_id": "43b99f10-0372-3c52-a220-f50f04718b3f",
                                "text": "Het 290 meter lange cruiseschip Costa Concordia is het vlaggenschip van het Italiaanse Costa Cruises. Volgens dit bedrijf is er geen vergelijkbaar cruiseschip in Europa."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebf9d422-2e92-3df5-b61e-f71a94543f73",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "glosses": [
                            "meest toonaangevende vliegtuigtype van luchtvaartmaatschappij; doorgaans het snelste, grootste of nieuwste model dat een positief beeld over het hele bedrijf moet oproepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c43e74f-8140-41a0-8700-771242ab2ad1",
                                "sense_id": "ebf9d422-2e92-3df5-b61e-f71a94543f73",
                                "text": "De Constellation was jarenlang het vlaggenschip in de KLM-vloot en het eerste in serie gebouwde verkeersvliegtuig dat was voorzien van een drukcabine, waardoor op een grotere hoogte kon worden gevlogen dan voorheen."
                            }
                        ]
                    },
                    {
                        "sense_id": "366ed449-d6dd-3a60-a9e0-1e20805c68ab",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "glosses": [
                            "het meest toonaangevende product of onderdeel van een organisatie, dat een positief beeld van de hele organisatie moet oproepen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4ee7937d-2f65-4176-ac79-4859cd186415",
                                "sense_id": "366ed449-d6dd-3a60-a9e0-1e20805c68ab",
                                "text": "In Amsterdam zullen ook meer grote winkels komen, zoals het nieuwe vlaggenschip van H&M op de Dam, waarin ketens alles laten zien wat ze in huis hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "0feea0c9-8a9e-3be7-92ab-a896898701e0",
                        "entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "glosses": [
                            "het belangrijkste of meest positief gewaardeerde onderdeel van een geheel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "12144f3f-00df-4133-8938-6e52a9077a61",
                                "sense_id": "0feea0c9-8a9e-3be7-92ab-a896898701e0",
                                "text": "Wie gebruikt nog het woord 'integratie' dat decennia lang het vlaggenschip was van de toenadering tussen Vlaanderen en Nederland?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "718080d6-a47f-45fb-9901-7b3d229a2481",
                        "source_entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
                        "source_sense_id": "0676fcc6-7141-3fde-b56b-07209853c5ad",
                        "source_sense_description": "schip waarop zich de bevelvoerder over een vloot of eskader bevindt",
                        "target_lang_word": "Flaggschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flaggschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d33c06-e856-3200-a178-ae1bfa6a1fd3",
                                        "entry_id": "38f22572-0f20-3242-9c35-246fb3205387",
                                        "glosses": [
                                            "Führungsschiff eines Kriegsschiffverbandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be58e5b-f0b3-4d11-8ba1-b33682b52383",
                                                "sense_id": "d9d33c06-e856-3200-a178-ae1bfa6a1fd3",
                                                "text": "Das Flaggschiff führt einen Flottenverband an und ist daher meist das größte und kampfstärkste Schiff des Verbandes."
                                            },
                                            {
                                                "example_id": "4352216e-ee0c-476a-bfeb-4c952fa782a2",
                                                "sense_id": "d9d33c06-e856-3200-a178-ae1bfa6a1fd3",
                                                "text": "[Kieler Woche:] Angekündigt haben sich Marineeinheiten aus Spanien, Frankreich, Belgien, Norwegen, Dänemark, Irland, Niederlande, Lettland und Litauen - darunter sind Fregatten, Landungsschiffe, Minenjagdboote und Zerstörer. Flaggschiff ist der deutsche Einsatzgruppenversorger \"Frankfurt am Main\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35304693-34fb-376b-a1dd-2a7522a34a91",
                                        "entry_id": "38f22572-0f20-3242-9c35-246fb3205387",
                                        "glosses": [
                                            "Vorzeigeprodukt – bestes Modell eines Herstellers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3230042e-9b23-4618-848b-33f850259aea",
                                                "sense_id": "35304693-34fb-376b-a1dd-2a7522a34a91",
                                                "text": "Die Großraumlimousine X-12 ist das neue Flaggschiff des Automobilherstellers."
                                            },
                                            {
                                                "example_id": "1819335a-3e97-4745-b456-724a125dc1ba",
                                                "sense_id": "35304693-34fb-376b-a1dd-2a7522a34a91",
                                                "text": "Drei Tageszeitungen und ein Wochenblatt entstehen hier [in Pittsfield/Massachusetts] unter dem Dach von New England Newspapers Inc. Darunter das Flaggschiff \"The Berkshire Eagle\", dessen gedruckte Auflage im Laufe der Jahre auf täglich 20.000 Exemplare zusammengeschrumpft ist."
                                            },
                                            {
                                                "example_id": "94c602bb-3959-4356-8601-137bad258a03",
                                                "sense_id": "35304693-34fb-376b-a1dd-2a7522a34a91",
                                                "text": "In das Flaggschiff der EU-Forschungsförderung, Horizon Europe, sollen knapp 100 Milliarden Euro fließen."
                                            },
                                            {
                                                "example_id": "76c09b78-b8e8-4f53-9c90-579a6397e653",
                                                "sense_id": "35304693-34fb-376b-a1dd-2a7522a34a91",
                                                "text": "Rudern - Gold für den Deutschlandachter: Das Flaggschiff des Deutschen Ruderverbandes sichert sich bei den Weltmeisterschaften in Florida den Sieg."
                                            },
                                            {
                                                "example_id": "24c77f7f-4f27-4173-8e8a-fded703fa06a",
                                                "sense_id": "35304693-34fb-376b-a1dd-2a7522a34a91",
                                                "text": "Es war ruhig geworden um den Petersburger Dialog. Wird das einstige Flaggschiff der deutsch-russischen Freundschaft wieder flott gemacht?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dec21f92-e040-4f48-8220-70597413785a",
                        "source_entry_id": "37c6349d-674c-3f55-83f8-bea4c73fafe5",
