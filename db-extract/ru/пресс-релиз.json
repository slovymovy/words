                        "target_lang_word": "nota de prensa",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "876c3cdd-b5cd-4157-abdc-bbf6a066b5ce",
                        "source_entry_id": "825bab0e-bf11-3e6b-a56e-2140cf615c5a",
                        "source_sense_id": "bb1f8a7c-fb1c-342a-978f-b341cc7a1f9f",
                        "target_lang_word": "Pressemitteilung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pressemitteilung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62fca556-4ca9-3633-8519-f89d5ef75100",
                                        "entry_id": "9ed06f5d-cdf3-32e1-836c-70aa765609f6",
                                        "glosses": [
                                            "geschriebene oder aufgezeichnete Mitteilung, die von Unternehmen und staatlichen oder privaten Institutionen an Journalisten gerichtet sind und Ankündigungen, Dementis, Informationen über Produkte oder Veranstaltungen enthalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f0bce33-1105-4eb8-9539-fb22744f70f6",
                                                "sense_id": "62fca556-4ca9-3633-8519-f89d5ef75100",
                                                "text": "Einige Zeitungen drucken Pressemitteilungen von Unternehmen als Artikel getarnt ab, ohne selbst zu recherchieren."
                                            },
                                            {
                                                "example_id": "f25000ba-eeff-40e7-a194-8b1fc4508be6",
                                                "sense_id": "62fca556-4ca9-3633-8519-f89d5ef75100",
                                                "text": "Der DMMV hatte am 11. Januar in einer Pressemitteilung Werbe-E-Mails unter der Voraussetzung befürwortet, in der Betreff-Zeile ein deutliches \"Werbung\" als Warnsignal zu setzen."
                                            },
                                            {
                                                "example_id": "1d7db32b-5ca2-4c33-bc43-b632062d93be",
                                                "sense_id": "62fca556-4ca9-3633-8519-f89d5ef75100",
                                                "text": "\"Durch die Neuregelung bliebe Studierenden, die aufgrund der Fachhochschulreife mit falschen Voraussetzungen an die Universität kämen, ein womöglich frustrierender Studienablauf erspart\", heißt es in der Pressemitteilung."
                                            },
                                            {
                                                "example_id": "252be3c5-834f-4a4b-af3a-e32cfd005294",
                                                "sense_id": "62fca556-4ca9-3633-8519-f89d5ef75100",
                                                "text": "„In einigen Bereichen bemühen sich die Redaktionen sehr um originelle Reportagen, vor allem, wenn es um Parteipolitik geht, in anderen dagegen sehe ich selten Artikel, die nicht offensichtlich von Pressemitteilungen abgeschrieben wurden oder schlicht die Zusammenfassung offizieller Pressekonferenzen sind.“"
                                            },
                                            {
                                                "example_id": "a0b87532-7af7-42f6-ae40-42f43e6e8e8d",
                                                "sense_id": "62fca556-4ca9-3633-8519-f89d5ef75100",
                                                "text": "„Es war eine kurze Pressemitteilung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dae2be1-1162-4b1c-a419-c55401be64e9",
                        "source_entry_id": "825bab0e-bf11-3e6b-a56e-2140cf615c5a",
