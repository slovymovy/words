                "senses": [
                    {
                        "sense_id": "f4a95226-a5ca-31db-8d32-ba23fdc20295",
                        "entry_id": "d5213757-241c-3d42-9f93-bff115131ba5",
                        "glosses": [
                            "Maßzahl, die das Körpergewicht eines Menschen in Relation zu seiner Körpergröße setzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69203449-6b8b-425f-ad55-e0b18a753091",
                                "sense_id": "f4a95226-a5ca-31db-8d32-ba23fdc20295",
                                "text": "Der Body-Mass-Index wird berechnet, indem man die Körpermasse (in kg) durch das Quadrat der Körperlänge (in m) dividiert."
                            },
                            {
                                "example_id": "1361ade1-78e1-4856-9e9c-f8f9e466a279",
                                "sense_id": "f4a95226-a5ca-31db-8d32-ba23fdc20295",
                                "text": "Der Body-Mass-Index ist nur ein grober Richtwert für ein gesundes Körpergewicht, der heute aus verschiedenen Gründen kritisch gesehen wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
