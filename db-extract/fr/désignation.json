        "fr-extract.jsonl": [
            {
                "entry_id": "ebe405d1-e63b-3a70-a7fa-b9f4bbb5a262",
                "word": "désignation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "babec019-0c81-44de-923c-343c071a24e9",
                        "entry_id": "ebe405d1-e63b-3a70-a7fa-b9f4bbb5a262",
                        "tags": [
                            "plural"
                        ],
                        "form": "désignations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "306a012a-8c65-3023-862f-a4d60bb5a08b",
                        "entry_id": "ebe405d1-e63b-3a70-a7fa-b9f4bbb5a262",
                        "glosses": [
                            "Action de désigner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1ead17a-2feb-431a-bdd6-d44d656e552b",
                                "sense_id": "306a012a-8c65-3023-862f-a4d60bb5a08b",
                                "text": "L'important, pour le moment, est de constater que l’identification des musulmans est passée, pour assurer leur sécurité totale, de la désignation vague d'appartenance à un groupe (ahl) à celle, beaucoup plus précise, d'une kabila, symbolisée par un nom qui l’individualise durablement."
                            },
                            {
                                "example_id": "f31bfc4e-2ca6-474c-8e99-50c039ba4620",
                                "sense_id": "306a012a-8c65-3023-862f-a4d60bb5a08b",
                                "text": "Mais le populisme est un récit idéologique qui se met à l’abri des atteintes de la réalité, et se fonde sur la désignation d’un ennemi affublé de tous les vices, les élites du savoir et de la compétence."
                            }
                        ]
                    },
                    {
                        "sense_id": "d89e334b-f72b-365d-baef-f7fbf5d566b1",
                        "entry_id": "ebe405d1-e63b-3a70-a7fa-b9f4bbb5a262",
                        "glosses": [
                            "Action de désigner par avance celui qui doit remplir une fonction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f905c7-3b8c-4b7e-8e3f-49edaeaf2046",
                                "sense_id": "d89e334b-f72b-365d-baef-f7fbf5d566b1",
                                "text": "Avant de quitter ce poste il fit la désignation de son successeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28f47c15-6f6a-46e9-9736-18223db55214",
                        "source_entry_id": "ebe405d1-e63b-3a70-a7fa-b9f4bbb5a262",
                        "target_lang_word": "Benennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                        "entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                                        "glosses": [
                                            "Wort, sprachlicher Ausdruck für etwas Gemeintes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6280da4-a8d1-4786-872a-a15879b2bd74",
                                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                                "text": "„Dies führt oft zur Verwendung movierter und unmovierter Benennungen für das gleiche Denotat […].“"
                                            },
                                            {
                                                "example_id": "eea57daf-ea05-43de-8bb9-6ed0462cd57d",
                                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                                "text": "„Manchmal geraten nämlich auch Personen in Benennungen.“"
                                            },
                                            {
                                                "example_id": "894b4c99-49fa-4594-bb74-7088f30ffd00",
                                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                                "text": "„Bedenkt man aber, daß diese und andere Sippen, wie etwa der Rhabarber und der Spinat, ja gar nicht in den Gebieten des arabischen Reiches heimisch sein konnten, so stellt sich für den Etymologen die extrem schwierige Frage, woher denn diese arabischen Benennungen bezogen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                        "entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                                        "glosses": [
                                            "das Benennen, die öffentliche Nennung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ddb3f32-196b-4251-a6e0-25a8e1c03b01",
                                                "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                                "text": "„Dass die genaue Benennung eines echten Gründungsjahres so schwierig ist, liegt vor allem daran, dass es keine anerkannte Interpretation gibt, was eine Liga denn eigentlich ausmacht.“"
                                            },
                                            {
                                                "example_id": "11e3b1c7-f754-41c4-8204-dbcd3599a585",
                                                "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                                "text": "Die Benennung der Kandidaten erfolgt durch den Vorstand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5a9d54d-09ab-4251-8d07-310095f5115a",
                        "source_entry_id": "ebe405d1-e63b-3a70-a7fa-b9f4bbb5a262",
