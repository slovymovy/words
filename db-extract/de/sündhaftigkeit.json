                "senses": [
                    {
                        "sense_id": "15ada12b-af20-39fb-a75a-07bc4f6c40bb",
                        "entry_id": "d2a67f4a-eaf5-31b0-b9a2-ec957f7f40a1",
                        "glosses": [
                            "Eigenschaft, sündhaft zu sein, von Sünde belastet zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4de38ac-60fc-46e8-a23e-0ad901b15815",
                                "sense_id": "15ada12b-af20-39fb-a75a-07bc4f6c40bb",
                                "text": "„Aber der Rebbe von Nemirow ist kein Bontsche, die Sündhaftigkeit der Welt nimmt er nicht passiv hin, und mit Bußgebeten begnügt er sich nicht.“"
                            },
                            {
                                "example_id": "3d2a40a0-2cfe-4ac6-94a4-465448fc6482",
                                "sense_id": "15ada12b-af20-39fb-a75a-07bc4f6c40bb",
                                "text": "„Aber so groß war nun die Sündhaftigkeit des Volkes geworden, daß nicht einmal diese Stätte verschont blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
