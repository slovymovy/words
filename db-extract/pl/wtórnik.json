                    },
                    {
                        "sense_id": "7fef4ff8-3f14-38ad-9a91-05f04f037c4f",
                        "entry_id": "02b738bb-e8fa-37f5-b1a1-24ff0e52a5fc",
                        "glosses": [
                            "drugi egzemplarz dokumentu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7e54ab-8167-4022-837c-bc998a78d9e1",
                                "sense_id": "7fef4ff8-3f14-38ad-9a91-05f04f037c4f",
                                "text": "Najlepiej, jeśli wtórnik umowy weźmiesz do domu i uważnie zapoznasz się z jej treścią."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "334d409c-4d01-36b1-b3bb-85e26100ef61",
                        "entry_id": "02b738bb-e8fa-37f5-b1a1-24ff0e52a5fc",
                        "glosses": [
                            "kopia dokumentu posiadająca taką samą moc urzędową jak oryginał"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "fd9cc078-a051-4f47-a3ac-f2b14fa57a31",
                                "sense_id": "334d409c-4d01-36b1-b3bb-85e26100ef61",
                                "text": "Młody kierowca po przekroczeniu 20 punktów kierowany jest na kurs na prawo jazdy. Kierowcy doświadczeni muszą natomiast zaliczyć egzaminy państwowe (…). Natomiast o wtórnik prawa jazdy można wystąpić jedynie w przypadku zniszczenia, zagubienia lub kradzieży właściwego dokumentu."
                            }
                        ],
