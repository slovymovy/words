                "senses": [
                    {
                        "sense_id": "e72b2ab6-f2f2-35d0-a3e9-e91ac92ff1c7",
                        "entry_id": "0bfaf4de-8952-3727-8827-1121730ba336",
                        "glosses": [
                            "een lange wandeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb5d342-ecde-4e39-81de-ac42b6b92e24",
                                "sense_id": "e72b2ab6-f2f2-35d0-a3e9-e91ac92ff1c7",
                                "text": "Vanwege het mooie weer waren veel mensen een wandeltocht aan het maken."
                            },
                            {
                                "example_id": "38228c3f-9d8d-4a4b-b6d4-7182d0206740",
                                "sense_id": "e72b2ab6-f2f2-35d0-a3e9-e91ac92ff1c7",
                                "text": "In een oude National Geographic had ik ooit als kind een artikel over deze trail gelezen, 4.286 kilometer door Amerika. Dit heb ik altijd onthouden, maar ik had nooit gedacht dat zo’n lange wandeltocht voor mij weggelegd zou zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56667c91-2b92-4a12-9a7a-acfbbe3b61ff",
                        "source_entry_id": "0bfaf4de-8952-3727-8827-1121730ba336",
                        "source_sense_id": "e72b2ab6-f2f2-35d0-a3e9-e91ac92ff1c7",
                        "source_sense_description": "een lange wandeling",
                        "target_lang_word": "Wanderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wanderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "551524f4-a5e6-33fe-b384-29c43efcc159",
                                        "entry_id": "457ec0b8-8e93-31fe-abdb-2d522e564026",
                                        "glosses": [
                                            "Ausflug zu Fuß in der Natur, ausgedehnter als ein Spaziergang (oft mit Übernachtung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e448bbe-a340-4e70-be94-a51ab6f20171",
                                                "sense_id": "551524f4-a5e6-33fe-b384-29c43efcc159",
                                                "text": "Morgen machen wir eine Wanderung durch die Elbmarsch."
                                            },
                                            {
                                                "example_id": "ed3f4f6d-c996-4370-9cc1-73c80fd98088",
                                                "sense_id": "551524f4-a5e6-33fe-b384-29c43efcc159",
                                                "text": "„Schlegels Wanderung führte ihn dabei auch durch das Rheintal zwischen Koblenz und Bingen.“"
                                            },
                                            {
                                                "example_id": "47dfbba3-7e92-46fd-9988-224412153b4f",
                                                "sense_id": "551524f4-a5e6-33fe-b384-29c43efcc159",
                                                "text": "„Auf ihren vielfältigen Wanderungen der Liebe erkannte Sabina rasch den Widerhall größerer Lieben und Begierden.“"
                                            },
                                            {
                                                "example_id": "cb524018-aada-409d-b596-cbb7ca6c43ca",
                                                "sense_id": "551524f4-a5e6-33fe-b384-29c43efcc159",
                                                "text": "„Seine Wanderung kreuz und quer durch den Stadtteil führte ihn – wie so oft – an den Fluss.“"
                                            },
                                            {
                                                "example_id": "03930764-ceb3-4cb6-9d2a-6034dff4fe36",
                                                "sense_id": "551524f4-a5e6-33fe-b384-29c43efcc159",
                                                "text": "„Nach dem Frühstück sind Papa und ich dann zu unserer Wanderung aufgebrochen, wir sind aber diesmal nicht an der Mosel, sondern an der Eltz entlang gewandert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e6372f9-8117-3294-ade9-c755daff065f",
                                        "entry_id": "457ec0b8-8e93-31fe-abdb-2d522e564026",
                                        "glosses": [
                                            "gleichgerichteter Wechsel des Aufenthaltsorts einer größeren Anzahl von Individuen (mehr als einer Familie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3537128-6abc-4036-a151-6c0770cfa75c",
                                                "sense_id": "2e6372f9-8117-3294-ade9-c755daff065f",
                                                "text": "Die Wanderung der Lachse wird von den Bären schon sehnsüchtig erwartet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45b99909-ffa6-3fe5-920c-60d1f6585e8a",
