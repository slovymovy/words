                    "sense_id": "aee2e4be-8301-3cc6-9f25-6251454d4439",
                    "sense_definition": "sich durch die Schwerkraft unkontrolliert von oben nach unten bewegen oder zu Boden stürzen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der kleine Junge stolperte über einen Stein und <w>fiel</w> plötzlich zu Boden."
                        },
                        {
                            "text": "Im kalten Herbst <w>fallen</w> viele bunte Blätter von den hohen Bäumen."
                        }
                    ],
                    "synonyms": [
                        "herunterfallen",
                        "stürzen"
                    ],
                    "antonyms": [
                        "aufstehen"
                    ],
                    "common_phrases": [
                        "zu Boden fallen",
                        "vom Baum fallen"
                    ]
                },
                {
                    "sense_id": "88e9fa68-d942-31e0-9352-10b514805d53",
                    "sense_definition": "auf einen niedrigeren Wert oder Stand sinken",
