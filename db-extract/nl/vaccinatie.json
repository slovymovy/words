                ],
                "translations": [
                    {
                        "translation_id": "ef2bcf93-3319-4c7d-9021-d64a409b766b",
                        "source_entry_id": "0d457e24-ca13-3110-8ca2-af7d7ad51d57",
                        "source_sense_id": "7f66308b-5172-3811-a437-f1fe5ccd47c9",
                        "source_sense_description": "een inenting",
                        "target_lang_word": "Impfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Impfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1da583c9-ca0a-3d26-9da4-824116a7e964",
                                        "entry_id": "abdcdabc-5fb8-3626-80bc-fcf38965adf9",
                                        "glosses": [
                                            "Verabreichung eines biologisch oder gentechnisch hergestellten Antigens, meist bestehend aus Protein- oder Erbgutbruchstücken oder abgetöteten beziehungsweise abgeschwächten Erregern zur Erzeugung einer Immunität gegen eine Infektionskrankheit durch die Bildung von Antikörpern und spezialisierten T-Helferzellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9fa51c0-c7bc-45ac-95ee-0982abc43fea",
                                                "sense_id": "1da583c9-ca0a-3d26-9da4-824116a7e964",
                                                "text": "Nach Schätzung der WHO und der Global Alliance for Vaccines and Immunization (GAVI) starben weltweit allein im Jahr 2002 über zwei Millionen Menschen an Infektionskrankheiten, die durch eine Impfung hätten verhindert werden können."
                                            },
                                            {
                                                "example_id": "9bd6e514-f74d-4b61-bc84-9ed6a0efc62b",
                                                "sense_id": "1da583c9-ca0a-3d26-9da4-824116a7e964",
                                                "text": "Die subakute sklerosierende Panenzephalitis (SSPE), eine stets tödlich endende Spätkomplikation der Masern, ist mit einer rechtzeitigen Impfung vermeidbar!"
                                            },
                                            {
                                                "example_id": "e821878e-262f-49d4-8108-13ba9f26ef16",
                                                "sense_id": "1da583c9-ca0a-3d26-9da4-824116a7e964",
                                                "text": "„Jetzt aber hat mit dem Sommer auch die Epidemie ihren Höhepunkt längst überschritten, und die Impfung widerlegt sich selbst mit der Art, in der sie durchgeführt wird.“"
                                            },
                                            {
                                                "example_id": "ce75fc54-ca81-40ed-a8e7-5904df47a116",
                                                "sense_id": "1da583c9-ca0a-3d26-9da4-824116a7e964",
                                                "text": "[Corona-Impfung:] „»[…] es muss natürlich auch klar sein, wenn man sich jetzt aktiv gegen eine Impfung entscheidet, entscheidet man sich eigentlich auch aktiv für eine Infektion. […] Das heißt, irgendwann ist man dann halt fällig.«“"
                                            },
                                            {
                                                "example_id": "58d83fd8-9ef0-47b4-8519-51cf58707fc0",
                                                "sense_id": "1da583c9-ca0a-3d26-9da4-824116a7e964",
                                                "text": "„Er sah die kreisrunden hellen Stellen einer Imfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e14e8a64-43b1-3b7b-89c3-a19a1b6a52cc",
                                        "entry_id": "abdcdabc-5fb8-3626-80bc-fcf38965adf9",
                                        "glosses": [
                                            "das Einbringen/Aufbringen von Bakterien in/auf einen Untergrund/Nährboden/Boden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ffe00f1-932e-4743-9033-faa2a752e02b",
                                                "sense_id": "e14e8a64-43b1-3b7b-89c3-a19a1b6a52cc",
                                                "text": "„Während die direkte Impfung des Bodens mit dem Bakterium zur Bildung der antibiotischen Substanzen und Bekämpfung von R. solani führte, konnte dies bei der Anwendung als Saatgutbehandlung nicht beobachtet werden (Szczech and Shoda 2006).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "250a7aad-6a15-48ee-920e-caf9ef682921",
                        "source_entry_id": "0d457e24-ca13-3110-8ca2-af7d7ad51d57",
