                ],
                "senses": [
                    {
                        "sense_id": "866ea2f9-418d-3ed7-ba1a-b5bd0a0c477e",
                        "entry_id": "fe4891b8-17c6-3c00-a379-519dff28083e",
                        "glosses": [
                            "воен. насыпь в фортификационном сооружении, предназначенная для удобства стрельбы, защиты от пуль и снарядов, а также для укрытия от наблюдения противником"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc7b7756-df5b-4884-9555-92e58bd1883b",
                                "sense_id": "866ea2f9-418d-3ed7-ba1a-b5bd0a0c477e",
                                "text": "Они как зайцы бросились чрез бруствер, а оставшиеся во рву сдались."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1356b75-ac50-4a44-a4b5-8a9bc25797a8",
                        "source_entry_id": "fe4891b8-17c6-3c00-a379-519dff28083e",
                        "source_sense_id": "866ea2f9-418d-3ed7-ba1a-b5bd0a0c477e",
                        "target_lang_word": "breastwork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breastwork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9bd981d-d9ae-3826-91d7-4ad3b91c3627",
                                        "entry_id": "abe22ffd-9c32-3d46-9f84-25a410278936",
                                        "glosses": [
                                            "A fortification consisting of a breast-high bulwark; a parapet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d296f22-684e-43c0-9aec-f66dc16a36da",
                                                "sense_id": "f9bd981d-d9ae-3826-91d7-4ad3b91c3627",
                                                "text": "Before long we had flung enough sand-bags into place to make a low breastwork behind which the few men who were on this side of the position could lie down and fire."
                                            },
                                            {
                                                "example_id": "8a136977-e925-4f5f-bd27-c6e3458d07b6",
                                                "sense_id": "f9bd981d-d9ae-3826-91d7-4ad3b91c3627",
                                                "text": "A cannonproof breastwork, built during the previous war, extended along the beach from the hills to the rocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c7eee0-4bc6-3928-938b-7cf44385f63c",
                                        "entry_id": "abe22ffd-9c32-3d46-9f84-25a410278936",
                                        "glosses": [
                                            "A railing on the quarter-deck and forecastle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d372376-0fbc-4251-a496-695de663944f",
                                                "sense_id": "26c7eee0-4bc6-3928-938b-7cf44385f63c",
                                                "text": "The Independencia is a two-turreted, breastwork ship of 9,000 tons displacement. […] The central breastwork is 130 feet in length at the top of the belt, and extends to the upper deck, 11 feet above the water-line. This breastwork incloses the boiler and engine hatches, the scuttles to magazines and shell-rooms, the principal openings for ventilation, and the two turrets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "092fa105-5cbc-343c-88ae-9aca3410ff46",
                                        "entry_id": "abe22ffd-9c32-3d46-9f84-25a410278936",
                                        "glosses": [
                                            "A parapet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12be0c99-a748-411e-acae-4c566f5a1ec6",
                                                "sense_id": "092fa105-5cbc-343c-88ae-9aca3410ff46",
                                                "text": "A swarthy boy opened a book and propped it nimbly under the breastwork of his satchel. He recited jerks of verse with odd glances at the text: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8719caa-cee0-38c8-9e4b-8b4414155ec8",
                                        "entry_id": "abe22ffd-9c32-3d46-9f84-25a410278936",
                                        "glosses": [
                                            "Breast augmentation."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
