                    {
                        "sense_id": "eb8767c2-27de-3b25-912a-56c8d7c114d5",
                        "entry_id": "906d244a-7b47-3bd3-bfda-f7e193967bad",
                        "glosses": [
                            "one of a pair of traditional Russian felt boots, sg valenok, pl valenki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19a8f76-7d92-4831-8414-523e4073c282",
                                "sense_id": "eb8767c2-27de-3b25-912a-56c8d7c114d5",
                                "text": "- Дя́дя Микит, дя́дюшка, а дя́дюшка! - закрича́л сза́ди его́ то́неньким голоско́м торопли́во вы́бежавший из сене́й на двор семиле́тний ма́льчик в чёрном полушу́бочке, но́вых бе́лых ва́ленках и тёплой ша́пке\n- Djádja Mikit, djádjuška, a djádjuška! - zakričál szádi jevó tónenʹkim goloskóm toroplívo výbežavšij iz senéj na dvor semilétnij málʹčik v čórnom polušúbočke, nóvyx bélyx válenkax i tjóploj šápke"
                            }
                        ]
                    },
                    {
                        "sense_id": "0c95ffc7-4d46-336d-97f8-b97d74df6169",
                        "entry_id": "906d244a-7b47-3bd3-bfda-f7e193967bad",
                        "glosses": [
                            "clumsy or stupid person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dba9be0-9c66-4449-ab30-b0d18641b631",
                                "sense_id": "0c95ffc7-4d46-336d-97f8-b97d74df6169",
                                "text": "Тупо́й как ва́ленок.",
                                "translation": "Dumb as a boot.",
                                "english": "Dumb as a boot."
                            }
                        ]
                    },
