                                "target_senses": [
                                    {
                                        "sense_id": "c8bbac34-19b1-370c-a9e4-8c38dd892f10",
                                        "entry_id": "acf91a12-c5ad-3ce7-9889-c7de7d8e9da0",
                                        "glosses": [
                                            "Par manque d’attention, faute de prendre garde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "589c3803-affb-4095-b0c8-302b3f0dbc91",
                                                "sense_id": "c8bbac34-19b1-370c-a9e4-8c38dd892f10",
                                                "text": "Il a brisé ce vase par mégarde."
                                            },
                                            {
                                                "example_id": "97e99401-3bfa-441b-94ad-e2f3a2e4177e",
                                                "sense_id": "c8bbac34-19b1-370c-a9e4-8c38dd892f10",
                                                "text": "Il lui est arrivé par mégarde de blesser son ami."
                                            },
                                            {
                                                "example_id": "41f47080-2a27-488f-83bb-3736f72cbc2a",
                                                "sense_id": "c8bbac34-19b1-370c-a9e4-8c38dd892f10",
                                                "text": "Effectivement, l’arrivée en France a eu un effet assez stressant : il présente à nouveau des obsessions qui sont essentiellement la peur d’avaler des objets par mégarde."
                                            },
                                            {
                                                "example_id": "2f822ef6-9ea7-46b6-81c1-172f31138683",
                                                "sense_id": "c8bbac34-19b1-370c-a9e4-8c38dd892f10",
                                                "text": "Et quand par mégarde, une tête dépassait un peu trop, le sniper rouge se rappelait à leur bon souvenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "517329b2-8c0a-4e66-8b3b-31a6d2fa8158",
                        "source_entry_id": "f1758a9a-c536-367f-a001-714221579f06",
                        "source_sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
