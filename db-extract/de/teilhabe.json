                        ],
                        "form": "der Teilhabe"
                    },
                    {
                        "form_id": "a802bc98-f82c-4a86-8304-8be29b9a6acf",
                        "entry_id": "b4585e57-d86f-373e-a0c5-33c5f35f473c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Teilhabe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd32ca7f-f1a9-3028-91c7-7d91ff1e89cb",
                        "entry_id": "b4585e57-d86f-373e-a0c5-33c5f35f473c",
                        "glosses": [
                            "Möglichkeit, (an etwas) teilzunehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "438bb1be-8adc-48d9-9779-05f77be29727",
                                "sense_id": "bd32ca7f-f1a9-3028-91c7-7d91ff1e89cb",
                                "text": "„Das heutige Recht ist eine Aufforderung zur Teilhabe, keine Wunderwaffe gegen Diskriminierung.“"
                            },
                            {
                                "example_id": "35196928-c674-4f72-9d2b-0358d0f28841",
                                "sense_id": "bd32ca7f-f1a9-3028-91c7-7d91ff1e89cb",
                                "text": "„Sowohl die Lebenschancen als auch die soziale Teilhabe der Betroffenen seien auf Dauer eingeschränkt, im Laufe des Lebens nehme der materielle Mangel eher zu.“"
                            },
                            {
                                "example_id": "f3f5f54b-e421-49f1-9ef7-7dc77aafda2c",
                                "sense_id": "bd32ca7f-f1a9-3028-91c7-7d91ff1e89cb",
                                "text": "„Die kulturelle Teilhabe lässt sich deshalb auch durch ein geeignetes Informations- und Medienmanagement fördern.“"
                            },
                            {
                                "example_id": "53c55104-54c9-4de7-bc1b-d7378642ea5e",
                                "sense_id": "bd32ca7f-f1a9-3028-91c7-7d91ff1e89cb",
                                "text": "„Argumentiert wird, dass einfach zu viele von der politischen Teilhabe ausgeschlossen seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b25e141-627a-4b36-a568-65d95eafe6c9",
                        "source_entry_id": "b4585e57-d86f-373e-a0c5-33c5f35f473c",
                        "source_sense_id": "bd32ca7f-f1a9-3028-91c7-7d91ff1e89cb",
