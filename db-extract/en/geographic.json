                    {
                        "translation_id": "1e6f9b0d-a65e-47a7-8df8-c0f2452a4a9c",
                        "source_entry_id": "0b75ea48-3949-30d6-b16f-47069efaafe0",
                        "source_sense_description": "pertaining to geography",
