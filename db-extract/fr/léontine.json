                    }
                ],
                "senses": [
                    {
                        "sense_id": "d904f590-7946-3557-aee0-8b3428636c08",
                        "entry_id": "7a9dfd6c-7923-31ec-87c0-d6152ad009c3",
                        "glosses": [
                            "Chaîne de montre pour femme portée surtout au milieu du XIXᵉ siècle en France, attachée au col par une broche et qui descendait à la ceinture."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "786fed37-cdc0-4b74-a0b1-66f7451a6c34",
                                "sense_id": "d904f590-7946-3557-aee0-8b3428636c08",
                                "text": "Il a été perdu… une montre d’or… ainsi qu’une léontine, avec clef également en or."
                            },
                            {
                                "example_id": "10b2f39a-6804-4dd1-8d61-7ecbfad8a98a",
                                "sense_id": "d904f590-7946-3557-aee0-8b3428636c08",
                                "text": "Grandes fantaisies nouvelles en sautoirs, cordons, léontines, bracelets et colliers."
                            },
                            {
                                "example_id": "b4bb5ed2-26e6-418b-9e07-8ec76cf183c5",
                                "sense_id": "d904f590-7946-3557-aee0-8b3428636c08",
                                "text": "Mademoiselle Émérence, pour la dixième fois, tire sa montre accrochée à une léontine d’or qui lui vient de sa mère."
                            },
                            {
                                "example_id": "feffd405-2e3a-4d7b-be3f-b77b3c7f8f48",
                                "sense_id": "d904f590-7946-3557-aee0-8b3428636c08",
                                "text": "Une enveloppe anonyme contenant un objet en vieil argent, on aurait dit une léontine avec un couvercle et un fermoir."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "eb37c1b2-ed86-3392-8cd9-915bb2a2c34c",
