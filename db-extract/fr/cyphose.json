                                    {
                                        "sense_id": "274de319-a298-3181-9f46-5ada2be42d84",
                                        "entry_id": "e199040a-76ca-3b58-be0c-fe9d03b38621",
                                        "glosses": [
                                            "nach hinten (dorsal) konvexe Krümmung der Wirbelsäule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ad6b733-4894-4904-aa98-e687058a3925",
                                                "sense_id": "274de319-a298-3181-9f46-5ada2be42d84",
                                                "text": "Natürlicherweise kommt Kyphose im Brustbereich vor und am unteren Ende der Wirbelsäule als eine kleine Kyphose."
                                            },
                                            {
                                                "example_id": "09398f37-792b-4842-ba49-28f848b52ea3",
                                                "sense_id": "274de319-a298-3181-9f46-5ada2be42d84",
                                                "text": "„Bei einer verstärkten Kyphose bleibt eine Restkrümmung bestehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
