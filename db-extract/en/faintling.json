                        "sense_id": "17c39d03-274d-3ec1-bcf6-60475815ea92",
                        "entry_id": "34251c09-21a3-3338-8fb1-8bc7ad40a216",
                        "glosses": [
                            "One who is faint, feeble, or weak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "471c10e6-9b0d-4b59-8247-afb3c4ed356e",
                                "sense_id": "17c39d03-274d-3ec1-bcf6-60475815ea92",
                                "text": "And for a weak and peevish youth, a faintling, A boy of a girl's temper; one who shrinks Trembling and crouching at a look, a word, A lifted ringer, like a beaten hound."
                            },
                            {
                                "example_id": "c570294c-8495-4ab9-9261-64638a42136d",
                                "sense_id": "17c39d03-274d-3ec1-bcf6-60475815ea92",
                                "text": "Strong, strong, ever on, Strong in our hope increasing; Heed not the faintling's fall, Nor eyes that on ye look coldly."
                            },
                            {
                                "example_id": "492ce94a-d4b9-4725-85a9-bfa36cdb2d12",
                                "sense_id": "17c39d03-274d-3ec1-bcf6-60475815ea92",
                                "text": "The modem preacher takes a few tablets of the doctrine of Christ, dissolves them in a gallon or two of sentimental rose water, puts a little of the solution in an atomizer, and sprays the congregation to the tune of “sweet spirited” Christianity and the fragrance of a benevolent life if, by evaporation, the solution becomes too strong he always has an abundance of pink tea handy to revive the faintlings who may have been overcome by too strong a dose."
                            }
                        ]
                    }
