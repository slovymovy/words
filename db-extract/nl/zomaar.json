                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08271d1b-70d0-32a0-8d26-a253dc3920a7",
                        "entry_id": "5824f478-5066-34bf-9e21-334db7c761d2",
                        "glosses": [
                            "op willekeurige wijze, zonder nadenken of voorbereiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfdaa2b6-ee94-426c-a26b-c8995b04c9db",
                                "sense_id": "08271d1b-70d0-32a0-8d26-a253dc3920a7",
                                "text": "Je kunt toch niet zomaar op de stoel van een ander gaan zitten."
                            },
                            {
                                "example_id": "92e422c1-960b-4809-a550-84351ef308a9",
                                "sense_id": "08271d1b-70d0-32a0-8d26-a253dc3920a7",
                                "text": "Juffrouw Banetti, die ook voor het landleven was gekomen, had het ook zomaar kunnen zeggen, maar dan had het wel stom geklonken."
                            },
                            {
                                "example_id": "1d62a0a6-25f6-4b87-8b70-b4ae43bd9a1f",
                                "sense_id": "08271d1b-70d0-32a0-8d26-a253dc3920a7",
                                "text": "'En waarom ging Marjorie er zomaar ineens vandoor?' vroeg hij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfb3cc3a-e11a-4ed3-ac31-a23c6cf9fb66",
                        "source_entry_id": "5824f478-5066-34bf-9e21-334db7c761d2",
