{
    "word_family": [
        "socketed",
        "socketing",
        "unsocketed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fb9780b-6ab6-36ac-9272-6c3cc68695d7",
                    "sense_definition": "An opening or receptacle into which a plug, light bulb, or other connecting part is designed to fit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "receptacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please make sure the plug is pushed firmly into the <w>socket</w> before turning it on.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что вилка плотно вставлена в <w>розетку</w>, прежде чем включать прибор."
                            }
                        },
                        {
                            "text": "Each seat on the train must have a wall <w>socket</w> for passengers to charge their phones.",
                            "target_lang_translations": {
                                "ru": "У каждого сиденья в поезде должна быть <w>розетка</w>, чтобы пассажиры могли заряжать свои телефоны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wall socket",
                        "light bulb socket",
                        "electrical socket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отверстие или разъем, в который вставляется штекер, лампочка или другая соединительная деталь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "розетка",
                                "target_lang_sense_clarification": "электрическая"
                            },
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "разъем для подключения"
                            },
                            {
                                "target_lang_word": "патрон",
                                "target_lang_sense_clarification": "для лампочки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdc50ee-2fd5-3e4f-9ac6-f3d5fef6d565",
                    "sense_definition": "A natural hollow or cavity in a bone into which another part fits, such as an eye or a joint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that the ball of the hip bone fits perfectly into the <w>socket</w> of the pelvis.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что головка бедренной кости идеально входит в <w>впадину</w> таза."
                            }
                        },
                        {
                            "text": "He suffered a minor injury to his eye <w>socket</w> during the boxing match.",
                            "target_lang_translations": {
                                "ru": "Во время боксерского поединка он получил легкую травму <w>глазницы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eye socket",
                        "hip socket",
                        "joint socket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественное углубление или полость в кости, в которую входит другая часть, например, глаз или сустав."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазница",
                                "target_lang_sense_clarification": "для глаза"
                            },
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "суставная"
                            },
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "анатомическое углубление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ed247fb-dd9b-3257-ac2d-2cac0576e45e",
                    "sense_definition": "An endpoint of a communication link between two programs running on a network.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application failed to connect because the network <w>socket</w> was already in use by another process.",
                            "target_lang_translations": {
                                "ru": "Приложению не удалось подключиться, так как сетевой <w>сокет</w> уже использовался другим процессом."
                            }
                        },
                        {
                            "text": "Developers use a <w>socket</w> to enable real-time data exchange between the client and the server.",
                            "target_lang_translations": {
                                "ru": "Разработчики используют <w>сокет</w> для обеспечения обмена данными в реальном времени между клиентом и сервером."
                            }
                        }
                    ],
                    "synonyms": [
                        "network socket"
                    ],
                    "common_phrases": [
                        "open a socket",
                        "server socket"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конечная точка коммуникационного канала между двумя программами, работающими в сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокет",
                                "target_lang_sense_clarification": "программный интерфейс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c95fae7-5235-3a83-96fe-27a8e6195564",
                    "sense_definition": "A removable metal head used with a wrench to turn nuts and bolts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will need a ten-millimeter <w>socket</w> to remove the bolts from the car engine.",
                            "target_lang_translations": {
                                "ru": "Вам понадобится десятимиллиметровая <w>головка</w>, чтобы открутить болты в двигателе автомобиля."
                            }
                        },
                        {
                            "text": "He reached for his <w>socket</w> wrench to tighten the loose parts of the bicycle.",
                            "target_lang_translations": {
                                "ru": "Он потянулся за своим <w>торцевым</w> ключом, чтобы подтянуть расшатавшиеся детали велосипеда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "socket wrench",
                        "socket set"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сменная металлическая головка, используемая с ключом для закручивания гаек и болтов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торцевая головка",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "насадка",
                                "target_lang_sense_clarification": "для гаечного ключа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89f5ac36-638e-3b6d-93d6-e9aa40e215b9",
                    "sense_definition": "The hollow part of a candlestick that holds the candle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "receptacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candle burned down until only a small piece of wax remained in the <w>socket</w>.",
                            "target_lang_translations": {
                                "ru": "Свеча догорела до тех пор, пока в <w>гнезде</w> не остался лишь маленький кусочек воска."
                            }
                        },
                        {
                            "text": "She carefully cleaned the old wax out of the silver <w>socket</w> before inserting a new candle.",
                            "target_lang_translations": {
                                "ru": "Она тщательно вычистила старый воск из серебряного <w>гнезда</w>, прежде чем вставить новую свечу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "candlestick socket"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полая часть подсвечника, в которой удерживается свеча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "в подсвечнике"
                            },
                            {
                                "target_lang_word": "трубка",
                                "target_lang_sense_clarification": "подсвечника"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27423fd1-368a-39c8-855a-a44621a2c052",
                    "sense_definition": "To place, fit, or fix something into a socket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wooden beams were carefully <w>socketed</w> into the stone base to ensure stability.",
                            "target_lang_translations": {
                                "ru": "Деревянные балки были аккуратно <w>вставлены</w> в каменное основание для обеспечения устойчивости."
                            }
                        },
                        {
                            "text": "The artisan showed how the two pieces were <w>socketed</w> together without the need for nails.",
                            "target_lang_translations": {
                                "ru": "Мастер показал, как две детали были <w>соединены</w> друг с другом без использования гвоздей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать, вставлять или закреплять что-либо в гнезде или разъеме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставлять в гнездо",
                                "target_lang_sense_clarification": "плотно фиксировать"
                            },
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "пазовым способом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}