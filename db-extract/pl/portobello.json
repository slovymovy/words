                                        "entry_id": "532dd9c3-5310-38a3-a7e7-b8be24cfea42",
                                        "glosses": [
                                            "To grow quickly to a large size or rapidly increase in scope or scale."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e816ad31-2727-4bab-b2b7-b94ccc1f63fd",
                                                "sense_id": "423a036d-8168-3384-8f30-9a8197b4e49d",
                                                "text": "The town’s population mushroomed from 10,000 to 110,000 in five years."
                                            },
                                            {
                                                "example_id": "15fc4b66-6208-43da-bf60-de060adc047c",
                                                "sense_id": "423a036d-8168-3384-8f30-9a8197b4e49d",
                                                "text": "In Beilu Village of Liucun Town in Yaodu District, Linfen, abnormal illnesses continued to emerge, as a result of clusters of highly-polluting enterprises mushrooming in the vicinity."
                                            },
                                            {
                                                "example_id": "956d8531-95ea-46de-8152-dc37c5716d65",
                                                "sense_id": "423a036d-8168-3384-8f30-9a8197b4e49d",
                                                "text": "The world's population of ultra-high-net-worth individuals, a super-elite with assets of at least $30m, has now mushroomed beyond 250,000 people, all in need of somewhere to store their wealth."
                                            },
                                            {
                                                "example_id": "71ab18a1-e7a9-4578-83be-3b2d858853d8",
                                                "sense_id": "423a036d-8168-3384-8f30-9a8197b4e49d",
                                                "text": "It has its own global news gathering and sharing platforms, like Facebook, YouTube and Twitter. […] In recent years, all these platforms have mushroomed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afec17f4-2a28-3574-89f3-5aa53e25b8de",
                                        "entry_id": "532dd9c3-5310-38a3-a7e7-b8be24cfea42",
                                        "glosses": [
                                            "To gather mushrooms."
                                        ],
