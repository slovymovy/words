                                        "glosses": [
                                            "vězeňský dozorce"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ebdc1e-4593-4536-9c94-3591f3a13614",
                                                "sense_id": "93649610-2a18-30e2-95d7-54d7259d5607",
                                                "text": "Na chodbách bylo slyšet odměřený krok hlídek, občas otevřel se otvor ve dveřích a kukátkem se díval bachař."
                                            }
                                        ]
