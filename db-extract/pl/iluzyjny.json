                "senses": [
                    {
                        "sense_id": "71c1908a-c20f-30e6-b875-2e9f4d9fc8b8",
                        "entry_id": "5912c9ad-d9ae-3e11-8b68-7eac89b2210f",
                        "glosses": [
                            "będący rezultatem iluzji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d23ee51-759d-4e0e-9975-b13e613cc590",
                                "sense_id": "71c1908a-c20f-30e6-b875-2e9f4d9fc8b8",
                                "text": "Wpływ i władza tych kniaziów—namiestników były słabe i prawie iluzyjne"
                            },
                            {
                                "example_id": "6c3f1243-f159-45fd-9fdc-dc23585703ea",
                                "sense_id": "71c1908a-c20f-30e6-b875-2e9f4d9fc8b8",
                                "text": "Podatek z krwi, zwłaszcza w XVII stuleciu, były w gruncie rzeczy iluzyjnym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
