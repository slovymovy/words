            {
                "entry_id": "f223bf44-aeb1-3a68-bdaf-a9ad8eb76ac0",
                "word": "BMX",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f59a31ef-1aef-3df9-a806-fbcb45cc41e5",
                        "entry_id": "f223bf44-aeb1-3a68-bdaf-a9ad8eb76ac0",
                        "glosses": [
                            "Vélo tout-terrain, équipé de petites roues et dépourvu de dérailleur, qui est conçu pour la vitesse et l’acrobatie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3acc1629-30e2-4bdb-a870-631d5326f04c",
                                "sense_id": "f59a31ef-1aef-3df9-a806-fbcb45cc41e5",
                                "text": "Il a cassé son BMX au dernier saut, pas de chance…"
                            }
                        ]
                    },
                    {
                        "sense_id": "cea082e4-a9a6-3934-b2cd-33527c138c1a",
                        "entry_id": "f223bf44-aeb1-3a68-bdaf-a9ad8eb76ac0",
                        "glosses": [
                            "Sport cycliste se déroulant sur une piste en terre similaire à celle du motocross."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd4c89d-88dd-4267-94f9-b4a1c20b2595",
                                "sense_id": "cea082e4-a9a6-3934-b2cd-33527c138c1a",
                                "text": "Car en BMX on ne freine pas, on fonce."
                            },
                            {
                                "example_id": "4ef084d8-ad0d-41a5-b510-8514cfa0889e",
                                "sense_id": "cea082e4-a9a6-3934-b2cd-33527c138c1a",
                                "text": "Enfin, et à propos cette fois des championnats de France, Noa Allard, 14 ans, représentera le BMX Club Saintais aux côtés de Nolan Dejean."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfc58ac1-69e3-3c19-a747-ac674ffe8f0b",
                        "entry_id": "f223bf44-aeb1-3a68-bdaf-a9ad8eb76ac0",
                        "glosses": [
                            "Toute pratique sportive utilisant ce type de vélo."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b65df193-aa2c-4848-a8e6-bc86267ee56a",
                        "source_entry_id": "f223bf44-aeb1-3a68-bdaf-a9ad8eb76ac0",
                        "target_lang_word": "BMX",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "BMX",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c7fe8b-1540-316f-8bd5-d5bb59a478bf",
                                        "entry_id": "0b38b466-a99a-3dab-821a-7ca8f513fc80",
                                        "glosses": [
                                            "Bicycle motocross, a form of cycling on BMX bikes, originating in California in the 1970s."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f91cbde0-4536-423a-a648-02a0767579bc",
                                                "sense_id": "b0c7fe8b-1540-316f-8bd5-d5bb59a478bf",
                                                "text": "“When I was in Switzerland going through rehab, literally, I was like, ‘What’s the point? I’m going through so much pain right now and BMX has given me a lot of grief,’” said Sakakibara."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53482d02-4416-326e-bef7-c966b2d8a6b4",
                                        "entry_id": "0b38b466-a99a-3dab-821a-7ca8f513fc80",
                                        "glosses": [
                                            "A BMX bike."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc4638e-7084-4c17-8c2a-e16876da1429",
                                                "sense_id": "53482d02-4416-326e-bef7-c966b2d8a6b4",
                                                "text": "In the end, why not be happy with both, with the BMXes and the pentathlons, with the swans of synchro and the Quasimodos of wrestling? Sweet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "BMX",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b4b24e-6def-30f1-8947-62f021cdfaa2",
                                        "entry_id": "96f5ea9d-5ef5-3601-bb4f-7ecd1fe8cf5c",
                                        "glosses": [
                                            "To ride a BMX bike."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7955a76-1162-4661-8d56-153976890ae2",
                                                "sense_id": "f9b4b24e-6def-30f1-8947-62f021cdfaa2",
                                                "text": "I BMXed from 1978 (my first race) till not too long ago. Although I don't see too many freestylers in the net, I get in touch with quite a few ex-BMXers like myself on rec.bicycles.off-road (I'm cross-posting to it)."
                                            },
                                            {
                                                "example_id": "0b99dcfe-5866-4357-890d-b9de1661cba3",
                                                "sense_id": "f9b4b24e-6def-30f1-8947-62f021cdfaa2",
                                                "text": "Yeah, flippity trick things are fun. I've got a friend who has BMXed for 15-16 years! He rules, and he used to be sponsored."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
