                    {
                        "form_id": "0d05cf96-297e-4a70-b4c4-7fd8a49d5120",
                        "entry_id": "2272335a-7126-3acf-a364-ec4467b664e8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wasserkocher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a84323e7-839a-3a4b-84f9-dfb19074eb2a",
                        "entry_id": "2272335a-7126-3acf-a364-ec4467b664e8",
                        "glosses": [
                            "elektrisches Gerät zum Erhitzen von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b79a176c-f290-4057-8ca7-387f97167eac",
                                "sense_id": "a84323e7-839a-3a4b-84f9-dfb19074eb2a",
                                "text": "Der neue Wasserkocher steht in der Küche."
                            },
                            {
                                "example_id": "06b200b3-07c9-49b9-85fd-28cf5809b654",
                                "sense_id": "a84323e7-839a-3a4b-84f9-dfb19074eb2a",
                                "text": "„Dieser Wasserkocher ist nichts anderes als ein Stück Draht mit einem Elektrokabel.“"
                            },
                            {
                                "example_id": "a25d7ca6-8065-4a65-9102-f2b7ca1d4420",
                                "sense_id": "a84323e7-839a-3a4b-84f9-dfb19074eb2a",
                                "text": "„In der Küche räumte sie wortlos vier Stühle frei, riss die Tür zum überwucherten Kräutergarten auf und stellte den Wasserkocher an.“"
                            },
                            {
                                "example_id": "d5d1023e-bc2f-486d-9508-ae880c8be246",
                                "sense_id": "a84323e7-839a-3a4b-84f9-dfb19074eb2a",
                                "text": "„Elma wartete, bis der Wasserkocher ausging, und befüllte zwei Tassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8680590b-f794-4bbf-b3b9-0e5a1888e336",
                        "source_entry_id": "2272335a-7126-3acf-a364-ec4467b664e8",
                        "source_sense_id": "a84323e7-839a-3a4b-84f9-dfb19074eb2a",
                        "source_sense_description": "elektrisches Gerät zum Erhitzen von Wasser",
                        "target_lang_word": "electric kettle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7645c802-a759-4c6f-afa7-0531a64e7f10",
                        "source_entry_id": "2272335a-7126-3acf-a364-ec4467b664e8",
                        "source_sense_id": "a84323e7-839a-3a4b-84f9-dfb19074eb2a",
                        "source_sense_description": "elektrisches Gerät zum Erhitzen von Wasser",
                        "target_lang_word": "teakettle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teakettle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46986927-fd7d-34c4-a6a6-1aadfd4a2928",
                                        "entry_id": "050030ca-1b0d-33e0-a318-a4efef6a004c",
                                        "glosses": [
                                            "A vessel used to boil water for tea or other hot beverages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f30c19b-cc9a-4558-9f0f-ba6b0f78b498",
                                                "sense_id": "46986927-fd7d-34c4-a6a6-1aadfd4a2928",
                                                "text": "Phœbe and the fire that boiled the teakettle were equally bright, cheerful, and efficient, in their respective offices."
                                            },
                                            {
                                                "example_id": "5d7e2c85-6e84-4af3-a989-115c28ab5f5f",
                                                "sense_id": "46986927-fd7d-34c4-a6a6-1aadfd4a2928",
                                                "text": "“Such a cunning teakettle and saucepan, and a tete-a-tete set, and lots of good things to eat. Do have toast for tea, Polly, and let me make it with the new toasting fork; it's such fun to play cook.”"
                                            },
                                            {
                                                "example_id": "9bf91725-54e1-49bb-8c87-2eaaaf0f831b",
                                                "sense_id": "46986927-fd7d-34c4-a6a6-1aadfd4a2928",
                                                "text": "Or when you leave the house and remember half an hour later that you left a teakettle going on the stove."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "teakettle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cded143-bf68-3b59-a250-9c67db21c294",
                                        "entry_id": "0ede35b1-51fb-377e-83b0-9aade2bb95e9",
                                        "glosses": [
                                            "To make a shrill sound like a boiling teakettle."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8623c323-a1f7-41a0-ac39-f4e3d5389ce8",
                                                "sense_id": "0cded143-bf68-3b59-a250-9c67db21c294",
                                                "text": "The Carolina wrens love it too, and they were teakettling away around me."
                                            },
                                            {
                                                "example_id": "918ca2bc-ab33-4af9-a369-fb5b5cc390e9",
                                                "sense_id": "0cded143-bf68-3b59-a250-9c67db21c294",
                                                "text": "They'd been running hard and the only thing he could hear was his own heart pounding and his breath teakettling in and out of his lungs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f68b2c52-0bf1-46f6-ac55-5e9e4f6551c3",
                        "source_entry_id": "2272335a-7126-3acf-a364-ec4467b664e8",
