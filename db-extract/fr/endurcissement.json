        "fr-extract.jsonl": [
            {
                "entry_id": "9d924439-0746-3b14-8afa-e85927df7130",
                "word": "endurcissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b906892a-998d-4fe7-b44f-c8047546ed74",
                        "entry_id": "9d924439-0746-3b14-8afa-e85927df7130",
                        "tags": [
                            "plural"
                        ],
                        "form": "endurcissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85ae7e09-56a3-33a3-b32c-ccf909a83e81",
                        "entry_id": "9d924439-0746-3b14-8afa-e85927df7130",
                        "glosses": [
                            "État d’une âme qui a perdu tout sentiment de piété, de vertu, de bonté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667c8570-b082-4c15-abb2-ec304099421e",
                                "sense_id": "85ae7e09-56a3-33a3-b32c-ccf909a83e81",
                                "text": "Cela marque un grand endurcissement."
                            },
                            {
                                "example_id": "959b572e-dc44-46b3-8b83-70106a38a42c",
                                "sense_id": "85ae7e09-56a3-33a3-b32c-ccf909a83e81",
                                "text": "Tomber dans l’endurcissement, l’endurcissement de cœur."
                            },
                            {
                                "example_id": "2c49811c-dd5a-4c8c-b9dd-3d34f14aa107",
                                "sense_id": "85ae7e09-56a3-33a3-b32c-ccf909a83e81",
                                "text": "Ses parents l’avaient toujours traité avec barbarie. Elle aima mieux ne pas les revoir ; et ils ne firent aucune avance, par oubli, ou endurcissement de misérables."
                            },
                            {
                                "example_id": "e9f2e786-aea4-4053-8760-a584636c8415",
                                "sense_id": "85ae7e09-56a3-33a3-b32c-ccf909a83e81",
                                "text": "La volonté divine qui gouverne le monde et à laquelle l’Apôtre fait appel pour expliquer l’endurcissement actuel des Juifs, est justilfée dans ses actes, dans ses motifs, dans ses conséquences."
                            },
                            {
                                "example_id": "bd8baabb-3f39-4a3a-9672-4bff16be8f6e",
                                "sense_id": "85ae7e09-56a3-33a3-b32c-ccf909a83e81",
                                "text": "La directrice ne veut pas le menacer d’avertir ses parents ni d’appeler un sergent de ville ; son endurcissement de misère est tel qu’il resterait peut-être indifférent, ou bien il manifesterait non du repentir, mais davantage de sourde rancœur."
                            }
                        ]
                    }
                ],
