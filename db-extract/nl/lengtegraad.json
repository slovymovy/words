                                "target_senses": [
                                    {
                                        "sense_id": "199bfce9-0241-3107-818e-ba5ece0ba29b",
                                        "entry_id": "8a19a9d7-1052-3929-97cb-5454d69c26b3",
                                        "glosses": [
                                            "Meridian einer bestimmten geographischen Länge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf4c5e9c-d54a-4f99-a63b-86473e522538",
                                                "sense_id": "199bfce9-0241-3107-818e-ba5ece0ba29b",
                                                "text": "Der zehnte östliche Längengrad verläuft durch Hamburg."
                                            },
                                            {
                                                "example_id": "19548f86-315c-4428-a346-8e720fb81742",
                                                "sense_id": "199bfce9-0241-3107-818e-ba5ece0ba29b",
                                                "text": "„Um ihre jeweilige Position zu bestimmen, waren sie jetzt weniger auf die Errechnung von Längen- und Breitengrad angewiesen, sondern vielmehr in der Lage, sie mithilfe bestimmter Hügel, Dörfer oder auch Baumgruppen an Land zu ermitteln.“"
                                            },
                                            {
                                                "example_id": "919ffed1-2ac0-4a1b-a6b9-526dd0a7ba2b",
                                                "sense_id": "199bfce9-0241-3107-818e-ba5ece0ba29b",
                                                "text": "„Wenn die Sonne in einer Stunde 15 Längengrade durchläuft, dann lag die Insel 75 Längengrade weiter westlich von Washington, addiert mit der Lage Washingtons ergab sich eine Position auf dem 152. Längengrad westlich von Greenwich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0442f911-11d5-3de5-a2ec-2db9a26e10e0",
                                        "entry_id": "8a19a9d7-1052-3929-97cb-5454d69c26b3",
                                        "glosses": [
                                            "Streifen zwischen zwei 1° voneinander entfernten Meridianen, in dem die auf volle Grade gerundete Länge einen bestimmten Wert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8515e329-d45b-4486-82c5-211b4aa32ad9",
                                                "sense_id": "0442f911-11d5-3de5-a2ec-2db9a26e10e0",
                                                "text": "Samoa liegt am 172. westlichen Längengrad."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6ad6e8a-d3dd-4b96-942c-5ae3955c2f8c",
                        "source_entry_id": "c0cd362e-437c-332c-b9dd-6209fcd04658",
                        "source_sense_id": "809593f4-540b-3577-acf1-1257d839b34b",
