                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f49d9d-7a1c-4733-998f-539287af7da7",
                                "sense_id": "2f66e262-8545-31d9-9e8d-60695548f968",
                                "text": "„Drinnen, in der Backstube, zwei Stufen tiefer als der Bürgersteig, damit ein Ofen hineinpasst, bringt Gisela Ritter sofort einen Teller mit geschmierten Brötchenhälften, eine mit Käse, eine mit Salami, eine mit Pflaumenmarmelade.“"
                            },
                            {
                                "example_id": "a6c308c0-eb6a-47fa-9158-040e6620e297",
                                "sense_id": "2f66e262-8545-31d9-9e8d-60695548f968",
                                "text": "„Ein Hamburger besteht aus labbriger Brötchenhälfte und einem Happen Fleisch, der scheu hinter einem Salatblatt fragwürdigen Alters hervorschielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
