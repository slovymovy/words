        "fr-extract.jsonl": [
            {
                "entry_id": "581f6ae7-e10d-332d-8b15-70819b92a881",
                "word": "désensibilisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d07f849c-694a-4a01-8183-dacde9451953",
                        "entry_id": "581f6ae7-e10d-332d-8b15-70819b92a881",
                        "tags": [
                            "plural"
                        ],
                        "form": "désensibilisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2002f8fb-2acc-311a-82eb-b1f031a1ca58",
                        "entry_id": "581f6ae7-e10d-332d-8b15-70819b92a881",
                        "glosses": [
                            "Action de désensibiliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3015cc7-0572-4e80-9976-3cf0cee54fe4",
                                "sense_id": "2002f8fb-2acc-311a-82eb-b1f031a1ca58",
                                "text": "Dans l’hypersensibilité de type tuberculinique, la désensibilisation (?« tolérance ») est possible par des injections répétées et fréquentes de minuscules quantités d’antigène. Mais les résultats sont seulement temporaires et l’injection des doses désensibilisatrices comporte le risque de réactions focales marquées et parfois très sérieuses."
                            },
                            {
                                "example_id": "320b89a8-098a-4ff1-9a50-56c1113edef1",
                                "sense_id": "2002f8fb-2acc-311a-82eb-b1f031a1ca58",
                                "text": "La lidocaïne, par exemple, un anesthésique local qu’emploient les dentistes, procure une désensibilisation de durée variable."
                            },
                            {
                                "example_id": "919539cb-4e66-4d38-85d4-9f8f6acabb75",
                                "sense_id": "2002f8fb-2acc-311a-82eb-b1f031a1ca58",
                                "text": "Durant le processus de désensibilisation systématique, le patient apprend à réagir à des stimuli jusque-là anxiogènes par une réponse de relaxation conditionnée."
                            },
                            {
                                "example_id": "657734af-36ca-47c9-b1dc-1f20dca31cf9",
                                "sense_id": "2002f8fb-2acc-311a-82eb-b1f031a1ca58",
                                "text": "La désensibilisation n’est actuellement pas encore possible en cas d’allergie alimentaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8cf4d99-7570-4c8a-b04d-49e0cc5cc748",
                        "source_entry_id": "581f6ae7-e10d-332d-8b15-70819b92a881",
                        "source_sense_id": "2002f8fb-2acc-311a-82eb-b1f031a1ca58",
                        "target_lang_word": "desensitization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desensitization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "036af0ee-9071-308a-9b7d-a1164aab38db",
                                        "entry_id": "3da8a063-3172-3ac0-b43b-36c51c02891e",
                                        "glosses": [
                                            "The act or process of desensitizing, of reducing or eliminating sensitivity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29289b02-8906-48f2-8388-d44af487de90",
                                                "sense_id": "036af0ee-9071-308a-9b7d-a1164aab38db",
                                                "text": "Furthermore, the desensitization steps should be incremental so that the animal experiences little or no fear response during the sessions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
