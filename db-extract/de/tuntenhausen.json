                        "examples": [
                            {
                                "example_id": "b761f4f1-2c1c-404d-95da-9e4af1084032",
                                "sense_id": "3b41f489-feb8-36cc-920a-67a48b5b6059",
                                "text": "„Auf einer Versammlung des Bayerischen Bauernbundes in Tuntenhausen äußert der bayerische Ministerpräsident Eugen Ritter von Knilling \"ernste Bedenken\" gegen die Reichsregierung besonders wegen ihres \"sozialistische[n] Einschlag[s]\".“"
                            },
                            {
                                "example_id": "66f99a45-e44a-46ee-a306-168f2565b8ef",
                                "sense_id": "3b41f489-feb8-36cc-920a-67a48b5b6059",
                                "text": "„Die katholische Bauernschaft Oberbayerns erteilt auf ihrer traditionellen Herbstparade in Tuntenhausen dem Youngplan-Volksbegehren der Rechten eine Absage.“"
                            }
                        ],
