                ],
                "senses": [
                    {
                        "sense_id": "2da1cb4b-2fcd-36ff-bfae-5eabd3e81399",
                        "entry_id": "4b2c94d2-ab14-3bfc-969f-2f2f3b98032a",
                        "glosses": [
                            "Qui fait briller la fine poussière en suspension dans l’air, surtout en parlant du soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f87e2e3-cd78-4959-a831-d0cae1ba4bb7",
                                "sense_id": "2da1cb4b-2fcd-36ff-bfae-5eabd3e81399",
                                "text": "Quelques heures après nous passions sous la porte de Carmona, dont l’arc encadrait un fond de lumière poudroyante où se croisaient, dans des flots de vapeur dorée, des galères, des ânes, des mules et des chariots à bœuf, les uns allant, les autres venant."
                            },
                            {
                                "example_id": "6b1bbbad-7227-4f2f-95f5-06930e26a8fc",
                                "sense_id": "2da1cb4b-2fcd-36ff-bfae-5eabd3e81399",
                                "text": "Éros, te voici debout devant ma porte, hardi et tout poudroyant de soleil."
                            },
                            {
                                "example_id": "6a7b83b6-044b-46bb-95f4-b0fa63e6f784",
                                "sense_id": "2da1cb4b-2fcd-36ff-bfae-5eabd3e81399",
                                "text": "L’air était calme, et le ciel vide autour du soleil poudroyant."
                            },
                            {
                                "example_id": "a2a4f757-1566-494d-bdaf-6be87eef27ea",
                                "sense_id": "2da1cb4b-2fcd-36ff-bfae-5eabd3e81399",
                                "text": "Et il en venait toujours d’autres. Des colonnes poudroyantes, traversées de rais de soleil, suivaient et précédaient leur cheminement."
                            }
                        ]
                    }
                ],
