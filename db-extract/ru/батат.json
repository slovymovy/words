                "senses": [
                    {
                        "sense_id": "20ea0ca6-04b7-303f-992c-619133c8d76e",
                        "entry_id": "2f32d045-dc67-3066-9a19-fe6b7e2901f9",
                        "glosses": [
                            "вид клубнеплодных растений рода Ипомея семейства Вьюнковые"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42b19f2-dfd3-4de0-9324-60e4f5bf9bb9",
                                "sense_id": "20ea0ca6-04b7-303f-992c-619133c8d76e",
                                "text": "На острове выращивают батат, распространённый в Перу."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b529442-a818-3241-a08f-ab8cf7dbc067",
                        "entry_id": "2f32d045-dc67-3066-9a19-fe6b7e2901f9",
                        "glosses": [
                            "клубень такого растения, овощ"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5213941d-e116-45e3-afe5-812612c2fbd0",
                                "sense_id": "0b529442-a818-3241-a08f-ab8cf7dbc067",
                                "text": "Тут [на выставке] были бамбуки и эвкалипты, розовые бататы, мучнистые и сладкие .."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df4d3646-af1b-4d27-b7aa-ad6a369ed29f",
