                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bdeb4923-c2e4-433a-b47f-31eeaf03fa1a",
                        "entry_id": "52f9d203-82f0-384d-ad15-d36e82cc1f78",
                        "tags": [
                            "plural"
