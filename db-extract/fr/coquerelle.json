                "senses": [
                    {
                        "sense_id": "90a0a36d-abf3-3cf6-b8b9-b93fbc7eb965",
                        "entry_id": "3a6b1890-6de7-3bdd-9179-cf8e5aeef5bc",
                        "glosses": [
                            "Physalis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5860fb2-6c48-45cc-9815-48b94ca88d1f",
                                "sense_id": "90a0a36d-abf3-3cf6-b8b9-b93fbc7eb965",
                                "text": "L’alkékenge ou coqueret des vignes, cerise de vigne, herbe à cloques, coquerelle, physalis alkekengi, est une solanée qui croît spontanément et abondamment dans les vignobles du midi, de l’ouest et de l’est de la France."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1d497fe-1544-3d0e-bf1c-4743b8c2cd2a",
                        "entry_id": "3a6b1890-6de7-3bdd-9179-cf8e5aeef5bc",
                        "glosses": [
                            "Anémone pulsatille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46be386-c9d3-4b2c-ace3-2750339838da",
                                "sense_id": "f1d497fe-1544-3d0e-bf1c-4743b8c2cd2a",
                                "text": "L’anémone pulsatille (Pulsatilla vulgaris) est une plante vivace très rustique qui poussait dans les pelouses et prés secs des régions alpines mais elle se fait rare aujourd’hui. Une fois en place, la pulsatille, appelée aussi \"coquerelle\", n’aime pas être dérangée."
                            }
                        ]
                    },
                    {
                        "sense_id": "5efffcaa-a2cd-3588-9f13-f59055e097a0",
                        "entry_id": "3a6b1890-6de7-3bdd-9179-cf8e5aeef5bc",
                        "glosses": [
                            "Blatte."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "e98b2236-0eb6-4a18-b88f-60c564e481b2",
                                "sense_id": "5efffcaa-a2cd-3588-9f13-f59055e097a0",
                                "text": "Une douce chaleur commençait à envahir les pièces, réveillant plusieurs familles de coquerelles engourdies par le froid qui reprirent possession des lieux…"
                            },
                            {
                                "example_id": "f3bdb83d-0225-46d6-950f-b0eb8ddd1daf",
                                "sense_id": "5efffcaa-a2cd-3588-9f13-f59055e097a0",
                                "text": "… les appartements minuscules, insalubres et infestés de coquerelles, j’y suis entré et je peux vous dire que c’est pire que ce qu’on imagine!"
                            }
                        ]
                    }
                ],
