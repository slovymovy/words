                        "source_entry_id": "289b43fc-f1ec-3c3d-8944-71cdc476689b",
                        "source_sense_id": "ffffbd40-866e-3e91-ac4a-3f4ea4dfe6c3",
                        "target_lang_word": "flabbergasted",
