                ],
                "senses": [
                    {
                        "sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                        "entry_id": "49884b37-6675-39f6-8e1b-1a4458551af2",
                        "glosses": [
                            "Krankheit, die durch Erreger verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea17e64a-2a7b-444a-847a-06f6feae0dca",
                                "sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                                "text": "Die Lungenentzündung ist eine Infektionskrankheit."
                            },
                            {
                                "example_id": "d8a1f602-dbb7-48ee-b3f9-945016ce520f",
                                "sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                                "text": "„Die schlechte Versorgung vieler Menschen führte zu Unterernährung, wodurch die Anfälligkeit für Infektionskrankheiten stieg.“"
                            },
                            {
                                "example_id": "c5d1830b-6964-433e-b1aa-81357fd644ec",
                                "sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                                "text": "„Die wenigen überlebenden Indianer starben bald darauf an Infektionskrankheiten, welche die Europäer eingeschleppt hatten und gegen die sie keine Abwehrstoffe hatten.“"
                            },
                            {
                                "example_id": "f278d06d-cb31-4bf9-b18b-b3c83900c614",
                                "sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                                "text": "„Kein Wunder, dass die Behörden ihn zu Hilfe riefen, als sie sich mit unheimlichen tropischen Infektionskrankheiten konfrontiert sahen, die die Wirtschaft in den Kolonien gefährdeten.“"
                            },
                            {
                                "example_id": "75751fef-cb83-4be5-84c5-7c0ff4f7fa65",
                                "sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                                "text": "„Er rief seinen Cousin Sandy Kuvin an, einen bekannten Arzt für Infektionskrankheiten, und ließ sich von ihm ausführlich erklären, wie Polio übertragen wird und wie es in der Zeit vor dem Impfstoff behandelt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
