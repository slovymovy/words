                "word": "paleobiology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f272ec1-ecba-3144-b99f-df120e238658",
                        "entry_id": "03aebefd-c2a9-3145-a703-81af4e138ebc",
                        "glosses": [
                            "The branch of biology or paleontology concerned with the study of fossils of plants and animals"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b769952-7ae6-4d81-8eb2-1d4fd5282712",
                        "source_entry_id": "03aebefd-c2a9-3145-a703-81af4e138ebc",
                        "source_sense_id": "4f272ec1-ecba-3144-b99f-df120e238658",
                        "source_sense_description": "branch of study",
                        "target_lang_word": "Paläobiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paläobiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19a687b0-40ac-3543-add6-9cdc0dcb1723",
                                        "entry_id": "79af10a7-3f46-3cf4-8f1b-e672e1c833f9",
                                        "glosses": [
                                            "Forschungszweig, der sich mit vorzeitlichen tierischen und pflanzlichen Organismen, ihrer Lebensweise und ihrer gesamten Beziehungen zur Umwelt beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be9e288-d8b5-4247-8f7c-790957498cc8",
                                                "sense_id": "19a687b0-40ac-3543-add6-9cdc0dcb1723",
                                                "text": "Aufgabe der Paläobiologie, die Abel zunächst als Zweig der Zoologie bezeichnete, war primär die Erforschung der Anpassungen fossiler Organismen und damit die Ermittlung ihrer Lebensweise und ihrer Umwelt."
                                            },
                                            {
                                                "example_id": "8a2deffa-9567-48fc-9af8-5c228a92ffaa",
                                                "sense_id": "19a687b0-40ac-3543-add6-9cdc0dcb1723",
                                                "text": "In dem gemeinsamen Projekt der Arbeitsgruppe Keupp, Berlin/Bandel, Hamburg/Fischer, Hannover sollen die Untersuchungen zur Paläobiologie der Ammonoideen fortgesetzt werden."
                                            },
                                            {
                                                "example_id": "9fb13aef-065a-4ae4-831e-7c252768e33a",
                                                "sense_id": "19a687b0-40ac-3543-add6-9cdc0dcb1723",
                                                "text": "In der praktischen Arbeit der Paläobiologie bzw. -anthropologie wird allerdings häufig so verfahren, als wären Hypothesen und Modelle über Organisation und Lebensweise ausgestorbener und rezenter Formen - operational gesehen - äquivalent."
                                            },
                                            {
                                                "example_id": "99afc103-97ae-42e1-8cf7-cc5a285efdf5",
                                                "sense_id": "19a687b0-40ac-3543-add6-9cdc0dcb1723",
                                                "text": "Erst in neuerer Zeit ist der Zweig Paläobiologie der Naturforschung erstarkt und unter Führung von Forschern wie Walther, Abel u. A. nun im vollen Aufblühen."
                                            },
                                            {
                                                "example_id": "1b1ab094-592d-4155-a97d-1cdb909c8ac9",
                                                "sense_id": "19a687b0-40ac-3543-add6-9cdc0dcb1723",
                                                "text": "Potonié legt neuerdings wieder kurz dar, wie aus den fossilen Resten die Paläobiologie der karbonischen Pflanzenwelt erschlossen werden konnte und damit die Grundlage für die Theorie der Entstehung der Steinkohle, die trotzdem noch manche Rätsel birgt, geschaffen wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
