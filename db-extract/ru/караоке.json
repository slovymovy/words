                                        "sense_id": "7edac9fe-9a33-36b6-8df2-74f608d26939",
                                        "entry_id": "461965bd-3cbc-37bb-a6c7-8fb43eae05a8",
                                        "glosses": [
                                            "vorm van vermaak, waarbij muziek wordt afgespeeld van een lied, en de amateur zanger in een microfoon de tekst (die op een televisiescherm te lezen is) live zingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3df11b5-5f61-49ec-bb95-c1137b0ad00e",
                                                "sense_id": "7edac9fe-9a33-36b6-8df2-74f608d26939",
                                                "text": "Het weekend staat ook in het teken van karaoke. Speciale familiekaraokekamers zijn er per uur te huur, in verschillende groottes, afhankelijk van het aantal mensen dat komt zingen. Op een computer is aan te geven welke nummers gedraaid moeten worden, met een druk op de bel komt de bediening langs om bestellingen op te nemen. Zingen maar!"
                                            },
                                            {
                                                "example_id": "3200c6ee-690d-4ab6-b8d2-5bbecc9ac7a9",
                                                "sense_id": "7edac9fe-9a33-36b6-8df2-74f608d26939",
                                                "text": "\"Leuk om eens te doen\", denk je dan. Maar als je er wat langer over nadenkt, komt Karaoke nogal fantasieloos over."
                                            }
                                        ]
                                    }
                                ]
