                ],
                "senses": [
                    {
                        "sense_id": "c4c77603-b1f4-32c4-9af8-37467923aebc",
                        "entry_id": "edfdd69b-6a39-311c-8268-1b2e60683bce",
                        "glosses": [
                            "Verb, bei dem der erste Teil (die erste Konstituente) ein Präfix (Ableitungsmorphem) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2d4a39-2cd3-4f98-996e-9e23e008c735",
                                "sense_id": "c4c77603-b1f4-32c4-9af8-37467923aebc",
                                "text": "Das Verb \"zerreden\" ist ein Präfixverb. Das Präfix zer- kann bei keiner Wortstellung abgetrennt erscheinen."
                            },
                            {
                                "example_id": "d0b1a046-11e2-4ee1-af56-fb7e4b6d92b0",
                                "sense_id": "c4c77603-b1f4-32c4-9af8-37467923aebc",
                                "text": "Verben mit den Präfixen be-,ent-, er-, miss-, ver- und zer- sind Präfixverben."
                            },
                            {
                                "example_id": "110b4f4a-e65d-4fdb-90f4-f98bcd5571e7",
                                "sense_id": "c4c77603-b1f4-32c4-9af8-37467923aebc",
                                "text": "„Eine formale Unterscheidung der Partikel- von den Präfixverben ist problemlos möglich.“"
                            },
                            {
                                "example_id": "be86600a-be3e-4c77-9c57-13b8d592e5d4",
                                "sense_id": "c4c77603-b1f4-32c4-9af8-37467923aebc",
                                "text": "„Beide Determinativkomposita enthalten als erstes Glied das Morphem, das die Basis des gebräuchlichen Präfixverbs genießen mit der Bedeutung ‚Nutzen von etwas haben‘ bildet.“"
                            },
                            {
                                "example_id": "c8dcf5a8-d3fe-406a-b8af-f27cef8dcb52",
                                "sense_id": "c4c77603-b1f4-32c4-9af8-37467923aebc",
                                "text": "„Damit aber werden beide mit dem gleichen Präfix gebildeten Präfixverben auf die Bedeutungen ihrer Grundwörter zurückgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
