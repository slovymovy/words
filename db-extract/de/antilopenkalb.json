                "senses": [
                    {
                        "sense_id": "85633b47-efa8-334d-9d4f-1f655da899a0",
                        "entry_id": "5ea47b8a-9205-31fe-a31a-41e5b01ca1a6",
                        "glosses": [
                            "Jungtier einer Antilope"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfff2f74-1779-46e0-a75a-95d62e1b2c7e",
                                "sense_id": "85633b47-efa8-334d-9d4f-1f655da899a0",
                                "text": "„Es tropfte Blut aus seinem Maule; er hatte vorhin ein junges Antilopenkalb, das der Mutter nicht schnell genug zu folgen vermochte, zerrissen und die spitzen Zähne in den Leib des Opfers gewühlt.“"
                            },
                            {
                                "example_id": "d67dccf7-31e9-43d1-b080-2ef7b9c12ad5",
                                "sense_id": "85633b47-efa8-334d-9d4f-1f655da899a0",
                                "text": "„Andrerseits ist aber das Antilopenkalb schon genau so furchtsam und ängstlich wie seine Eltern, blökt auch wie ein Kalb, und die Mutter gibt ihm auf seine Rufe mit einem sanft blökenden Ton Antwort.“"
                            },
                            {
                                "example_id": "c9bde8ed-7ba9-4b99-94db-9900c088a632",
                                "sense_id": "85633b47-efa8-334d-9d4f-1f655da899a0",
                                "text": "„Herablassend, irgendwie angeekelt und abwägend, was sie wohl mit mir anstellen solle, beobachtete sie meine ungläubigen Reaktionen wie der Gepard das zwischen den Felsen eingekeilte Antilopenkalb.“"
                            },
                            {
                                "example_id": "9cdceb01-a3aa-4fe3-a579-1f05ef0ad2d0",
                                "sense_id": "85633b47-efa8-334d-9d4f-1f655da899a0",
                                "text": "„Sieh hin: der Tiger kost das Antilopenkalb. “"
                            },
                            {
                                "example_id": "82ce3793-3d84-485c-9788-b4e6f892056b",
                                "sense_id": "85633b47-efa8-334d-9d4f-1f655da899a0",
                                "text": "„Ein Fohlen mit struppiger Mähne stakst neugierig zu einem kleinen Antilopenkalb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
