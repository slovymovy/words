{
    "word_family": [
        "snore",
        "snorer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee508ad2-6a0b-3763-b1eb-23273df307b4",
                    "sense_definition": "The sound or act of breathing noisily while asleep due to the vibration of the soft palate.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>snoring</w> from the next room kept me awake all night.",
                            "target_lang_translations": {
                                "ru": "Громкий <w>храп</w> из соседней комнаты не давал мне уснуть всю ночь."
                            }
                        },
                        {
                            "text": "He tried to stop his <w>snoring</w> by sleeping on his side.",
                            "target_lang_translations": {
                                "ru": "Он пытался прекратить <w>храп</w>, засыпая на боку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loud snoring",
                        "stop snoring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук или процесс шумного дыхания во время сна, вызванный вибрацией мягкого нёба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "храп",
                                "target_lang_sense_clarification": "громкий горловой звук, издаваемый человеком во время сна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7ad9c5d-8d0c-360a-8e68-3789074634d1",
                    "sense_definition": "Present participle and gerund of <w>snore</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard him <w>snoring</w> peacefully in the armchair.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как он мирно <w>храпел</w> в кресле."
                            }
                        },
                        {
                            "text": "She is <w>snoring</w> because she is very tired after the long trip.",
                            "target_lang_translations": {
                                "ru": "Она <w>храпит</w>, потому что очень устала после долгой поездки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle and gerund form of the verb snore."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени и герундия от глагола «храпеть»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "храпящий",
                                "target_lang_sense_clarification": "причастие, описывающее человека, который храпит"
                            },
                            {
                                "target_lang_word": "храпеть",
                                "target_lang_sense_clarification": "глагол, обозначающий процесс издания храпа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}