                ],
                "senses": [
                    {
                        "sense_id": "02043c7e-a98b-369b-81ef-6492d673ded9",
                        "entry_id": "69e2ac7b-45bd-3d9e-b923-4405bbe56685",
                        "glosses": [
                            "разг. до поздней ночи не ложиться спать, бодрствовать, занимаясь чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91be7ba-bd1f-4553-9ff1-a3ac16ee39b0",
                                "sense_id": "02043c7e-a98b-369b-81ef-6492d673ded9",
                                "text": "Посторонний человек так рассудит: а вольно ж, мол, барину полуночничать, в полночь по Москве шататься, по балам да гостям."
                            },
                            {
                                "example_id": "8011198a-e5ec-4351-a618-a95a9fe2391c",
                                "sense_id": "02043c7e-a98b-369b-81ef-6492d673ded9",
                                "text": "Ты что же полуночничаешь? Где шатался?"
                            },
                            {
                                "example_id": "5d185e5f-01e2-4030-91db-ade2fe98a5aa",
                                "sense_id": "02043c7e-a98b-369b-81ef-6492d673ded9",
                                "text": "Но и керосинки завелись уже при ней, она хорошо помнит, как в детстве жгли лучину и полуночничали возле камелька,.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6a79922-9563-4aac-973c-bacae60faf3c",
                        "source_entry_id": "69e2ac7b-45bd-3d9e-b923-4405bbe56685",
                        "source_sense_id": "02043c7e-a98b-369b-81ef-6492d673ded9",
                        "target_lang_word": "burn the midnight oil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burn the midnight oil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "725bddae-5bf0-394f-a7a2-6b3f805e7edf",
                                        "entry_id": "e2ba45e0-3ec4-3cfb-925d-111a55979aaa",
                                        "glosses": [
                                            "To work studiously, especially late into the night."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943c254f-b7ba-4337-8fe1-c206d1cabe35",
                                                "sense_id": "725bddae-5bf0-394f-a7a2-6b3f805e7edf",
                                                "text": "Near-synonym: pull an all-nighter"
                                            },
                                            {
                                                "example_id": "6cfdb6c4-ff63-473a-8745-50dc6935502a",
                                                "sense_id": "725bddae-5bf0-394f-a7a2-6b3f805e7edf",
                                                "text": "He was burning the midnight oil to finish his paper."
                                            },
                                            {
                                                "example_id": "480156f1-4ecb-4a7d-bd1d-e1f2644ca120",
                                                "sense_id": "725bddae-5bf0-394f-a7a2-6b3f805e7edf",
                                                "text": "She was burning the midnight oil to finish her part of the project."
                                            },
                                            {
                                                "example_id": "60112050-36cc-499d-9d88-450394e36302",
                                                "sense_id": "725bddae-5bf0-394f-a7a2-6b3f805e7edf",
                                                "text": "You worked at whatever task you were engaged in — churning out steel nuts for the car companies or churning out essays in college — until you were done, even if you had to burn the midnight oil. No excuses, no whining, no cheating."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
