                "senses": [
                    {
                        "sense_id": "0a831e66-7a81-3358-8078-40d8a41ad936",
                        "entry_id": "14a0f806-09e4-3258-9539-fbd4be0de243",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der Förderung und Bildung an Sonderschulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8475ab05-0d83-4894-a174-1c54ee87ce83",
                                "sense_id": "0a831e66-7a81-3358-8078-40d8a41ad936",
                                "text": "„Vor drei Jahren (26. März 2009) trat die UN-Konvention in Kraft, die die Abkehr vom derzeitigen Sonderschulsystem vorschreibt.“"
                            },
                            {
                                "example_id": "0bc265cc-7229-4d9d-b4e0-b5ca2b4e101e",
                                "sense_id": "0a831e66-7a81-3358-8078-40d8a41ad936",
                                "text": "„Am hochdifferenzierten Sonderschulsystem will Stoch nicht grundsätzlich rütteln – trotz der UN-Konvention, die auch Deutschland zur Inklusion an Regelschulen verpflichtet.“"
                            },
                            {
                                "example_id": "3a0ca2e1-c315-4347-928a-3cca23701407",
                                "sense_id": "0a831e66-7a81-3358-8078-40d8a41ad936",
                                "text": "„Damit wäre das hessische Sonderschulsystem unterlaufen worden, für das in den letzten 20 Jahren rund 400 Millionen DM ausgegeben worden seien.“"
                            },
                            {
                                "example_id": "26631311-1f55-4c8a-a496-8378c817a788",
                                "sense_id": "0a831e66-7a81-3358-8078-40d8a41ad936",
                                "text": "„Das ‚segregierte Sonderschulsystem muss ebenso überwunden werden wie das segregierte Regelschulsystem‘, lautet ihr Credo.“"
                            },
                            {
                                "example_id": "0a2caef8-1bc9-4849-992b-8c223fa73a34",
                                "sense_id": "0a831e66-7a81-3358-8078-40d8a41ad936",
                                "text": "„Echte Sonderschularbeit kann nur geleistet werden, wenn große, leistungsfähige und vor allem optimal differenzierbare Sonderschulsysteme bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
