                        "examples": [
                            {
                                "example_id": "84343976-5225-433e-88f9-94ff565b15a1",
                                "sense_id": "723d29c3-3778-3b19-8068-e6e67c991111",
                                "text": "Een ander vindt het erotische verhaal niet helemaal geschikt voor het grote bioscoopscherm. \"Het is niet echt een film om in de bioscoop te zien. Eerder een film voor thuis, met je vriend.\""
                            },
                            {
                                "example_id": "3040eead-a5a2-4b79-9457-0878e731f9ae",
                                "sense_id": "723d29c3-3778-3b19-8068-e6e67c991111",
                                "text": "Ondertussen in een bioscoop in het centrum van Eindhoven. Daar kijken zo'n 180 man - biertje in de hand, dat wel - op een groot bioscoopscherm naar de wedstrijd. Hopend op een goede afloop, een \"romantische komedie met een goed einde\"."
                            }
                        ]
