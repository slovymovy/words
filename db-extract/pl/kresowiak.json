                "translations": [
                    {
                        "translation_id": "507e4fd8-9b94-4c2d-81ac-78999ecc503b",
                        "source_entry_id": "f809ab3e-ae8f-307c-b05d-95415c12adca",
                        "source_sense_id": "8a8b7929-c7f2-3108-8a46-9bb11ec5f40b",
                        "target_lang_word": "borderland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "borderland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6455203-aba4-37f0-be89-c714737de915",
                                        "entry_id": "6f9e719d-f3fa-36ce-bd32-67e688311768",
                                        "glosses": [
                                            "Land near a border; marches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f45d384-6f82-4a0f-8eb8-0dd674c6d839",
                                                "sense_id": "f6455203-aba4-37f0-be89-c714737de915",
                                                "text": "retaining Liddesdale and his other Borderlands and Offices in his owne person"
                                            },
                                            {
                                                "example_id": "16b63276-c8cb-433c-8e98-1c386bd35b1a",
                                                "sense_id": "f6455203-aba4-37f0-be89-c714737de915",
                                                "text": "1850, Charlotte Brontë, letter dated 16 March, 1850, in The Life of Charlotte Brontë by Elizabeth Gaskell, London: Smith, Elder, 1857, Volume 2, Chapter , p. ,\nsome of the ancient East Lancashire families, whose mansions lie on the hilly border-land between the two counties"
                                            },
                                            {
                                                "example_id": "46d9ed7e-e678-4d9d-9106-99208e19885e",
                                                "sense_id": "f6455203-aba4-37f0-be89-c714737de915",
                                                "text": "They came to the river that marked the very edge of the borderland of the Wild […]"
                                            },
                                            {
                                                "example_id": "988af7ba-39c8-410e-985b-e707d9dd84fa",
                                                "sense_id": "f6455203-aba4-37f0-be89-c714737de915",
                                                "text": "[…] he pieces together his tale: arson, cattle raids, the usual borderlands story, ending in destitution, the making of orphans."
                                            },
                                            {
                                                "example_id": "d68e371a-0c83-45fc-afb7-ae2e03b447d5",
                                                "sense_id": "f6455203-aba4-37f0-be89-c714737de915",
                                                "text": "Documentary filmmaker Cristina Ibarra is among the 25 fellows. Ibarra is known for creating narratives about Latino families living in borderland communities, the MacArthur website said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9edd6b53-a493-35af-9ffd-10a32b20c279",
                                        "entry_id": "6f9e719d-f3fa-36ce-bd32-67e688311768",
                                        "glosses": [
                                            "An intermediate state, category, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e21ee3f-4f86-4b79-b3e9-f81b1079438f",
                                                "sense_id": "9edd6b53-a493-35af-9ffd-10a32b20c279",
                                                "text": "Near-synonyms: twilight zone, shadowland"
                                            },
                                            {
                                                "example_id": "d30b91ef-cf0d-482a-8880-8f8e4edb00ed",
                                                "sense_id": "9edd6b53-a493-35af-9ffd-10a32b20c279",
                                                "text": "Is he [the Scotchman] orthodox—he has no doubts. Is he an infidel—he has none either. Between the affirmative and the negative there is no border-land with him. You cannot hover with him upon the confines of truth, or wander in the maze of a probable argument."
                                            },
                                            {
                                                "example_id": "37811bf4-db70-42f0-bf7c-6915e9ec514e",
                                                "sense_id": "9edd6b53-a493-35af-9ffd-10a32b20c279",
                                                "text": "“Mr. Alwyn, the line between virtue and foolishness is dim and wavering, and I should hate to see you lost in that marshy borderland. […]”"
                                            },
                                            {
                                                "example_id": "c20d16dd-fcf0-48c8-a251-610931ee797f",
                                                "sense_id": "9edd6b53-a493-35af-9ffd-10a32b20c279",
                                                "text": "But she did not look as if she were dying; she looked as if she might go on existing in this borderland between life and death for ever."
                                            },
                                            {
                                                "example_id": "6cc775cb-e340-43fa-8413-7e53175f75c6",
                                                "sense_id": "9edd6b53-a493-35af-9ffd-10a32b20c279",
                                                "text": "the subject lies in the misty borderlands of advancing knowledge"
                                            },
                                            {
                                                "example_id": "f5980de3-dd2d-4e54-aa7b-68aeb145ad39",
                                                "sense_id": "9edd6b53-a493-35af-9ffd-10a32b20c279",
                                                "text": "[…] he found himself in that frustrating mental state in which one is too exhausted to think productively and yet too alert to sleep, and in this restless borderland he lay for the remainder of the night […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c952844-9808-49eb-aaa1-ca3d2b040a0a",
                        "source_entry_id": "f809ab3e-ae8f-307c-b05d-95415c12adca",
                        "source_sense_id": "8a8b7929-c7f2-3108-8a46-9bb11ec5f40b",
                        "target_lang_word": "inhabitant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhabitant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                        "entry_id": "efe7aef3-5c28-34c1-aafa-c9138b42a8c3",
                                        "glosses": [
                                            "Someone or thing who lives in a place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49cdd6e6-5ae0-461b-bd6f-291622f983b2",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "I believed it in the same way one of you might believe there are inhabitants in the planet Mars. I knew once a Scotch sailmaker who was certain, dead sure, there were people in Mars."
                                            },
                                            {
                                                "example_id": "40efea68-9e75-47f0-8bdb-dd54294a74e3",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "It was obvious to the inhabitants of the small coastal town of Bridport that in the midst of these squabbles their need for a railway was going to be overlooked, and they decided to take the matter into their own hands."
                                            },
                                            {
                                                "example_id": "aec6b4bb-8b01-4f91-8f55-a6f272ecb234",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "About 98 per cent of Taiwan's inhabitants are Han Chinese, a diverse mix of ethnic and linguistic groups, including Hakka, Cantonese and Fujianese, who came from China's southern coast. Taiwan's other two per cent are from one of the nine indigenous tribes, which are scattered throughout the island but largely concentrated along the east coast and in the Central Mountain Range."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6085fa-edd5-35db-9008-5b7c7d07af97",
                                        "entry_id": "efe7aef3-5c28-34c1-aafa-c9138b42a8c3",
                                        "glosses": [
                                            "A possible value for a type."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c070f3b0-f6cd-4e56-b2b0-a4774281d711",
                                                "sense_id": "1c6085fa-edd5-35db-9008-5b7c7d07af97",
                                                "text": "One way to observe this connection with mathematics is by mapping each type to its cardinality, a count of the inhabitants of that type."
                                            }
                                        ]
                                    }
                                ]
                            },
