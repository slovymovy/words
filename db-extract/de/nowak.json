                ],
                "senses": [
                    {
                        "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                        "entry_id": "830feff3-6e4e-37dc-a4b4-3c3806a95773",
                        "glosses": [
                            "slawischsprachiger Familienname, Nachname; häufigster Nachname in Polen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a0d9f5-dd54-47c9-b96d-683da6be9c98",
                                "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                                "text": "Frau Nowak ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fc9778e7-9db8-4064-b726-87bed74f30eb",
                                "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                                "text": "Herr Nowak wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4a09a264-3c94-4d78-bcf3-5b92f115080f",
                                "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                                "text": "Die Nowaks fliegen heute nach Köln."
                            },
                            {
                                "example_id": "6f4356c9-0a1c-423c-bf25-c0308706fe33",
                                "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                                "text": "Der Nowak trägt nie die Pullover, die die Nowak ihm strickt."
                            },
                            {
                                "example_id": "3a4ae971-0694-45ae-ba6d-ede73e7db5cc",
                                "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nowak kommt, geht der Herr Nowak.“"
                            },
                            {
                                "example_id": "92068c6f-77ab-4613-a05e-f5b397f01c54",
                                "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                                "text": "Nowak kommt und geht."
                            },
                            {
                                "example_id": "57c0f0cd-b121-4005-ae62-8b5f2605c64b",
                                "sense_id": "f41eb6ed-b580-3915-abe5-160bc423f371",
                                "text": "Nowaks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
