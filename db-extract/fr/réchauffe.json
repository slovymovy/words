                        "sense_id": "25448c3d-8699-353c-b2af-8e9ece0304b8",
                        "entry_id": "33d0b98d-3b6d-3d52-8629-fb0f02a70851",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de réchauffer."
                        ],
                        "tags": [
