                "forms": [],
                "senses": [
                    {
                        "sense_id": "535c0e28-cea0-3397-b249-711340f23d61",
                        "entry_id": "44de0246-6e73-3152-bf56-345beea31475",
                        "glosses": [
                            "A form of Louisiana Creole music, characteristically performed by accordion and washboard bands, that combines Cajun and Creole roots music with elements of African American music."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "db4d38d7-7e9d-4229-a1ce-c5ef4a25d5e8",
                                "sense_id": "535c0e28-cea0-3397-b249-711340f23d61",
                                "text": "Sunpie—in real life, a park ranger and an accordionist who leads a good zydeco band—taunted Harrison […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87cb3fe8-a8dc-4129-b85e-34235340a59d",
                        "source_entry_id": "44de0246-6e73-3152-bf56-345beea31475",
                        "source_sense_id": "535c0e28-cea0-3397-b249-711340f23d61",
                        "source_sense_description": "form of Louisiana Creole music",
                        "target_lang_word": "zydéco",
