                "senses": [
                    {
                        "sense_id": "5508963e-6fa5-3169-9aa7-fc53aae740d1",
                        "entry_id": "786971d1-91ca-3018-9139-353d4c5b8eb5",
                        "glosses": [
                            "муз. гамма восходящих тонов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b04390-fbb7-4364-b70c-4c4b3410c0b7",
                                "sense_id": "5508963e-6fa5-3169-9aa7-fc53aae740d1",
                                "text": "Простые примеры вроде распространённой в барочном композиторском письме риторической фигуры анабазис (гамма наверх), означающей, помимо аффекта радости, вознесение Христа (и в духовных сочинениях использовавшейся при соответствующих текстах), говорят о многом."
                            }
                        ]
                    }
