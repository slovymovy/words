                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encouragement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5787c560-ae3b-33e3-9c85-9e38d90d9d9f",
                                        "entry_id": "e66856b1-37fd-3114-adda-1b6cfd567120",
                                        "glosses": [
                                            "The act of encouraging"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d78f5883-6532-3cd6-9655-ec09e0b70861",
                                        "entry_id": "e66856b1-37fd-3114-adda-1b6cfd567120",
                                        "glosses": [
                                            "Something that incites, supports, promotes, protects or advances; incentive"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a67402c-09c1-4dc6-9be3-4af2f53c2b71",
                                                "sense_id": "d78f5883-6532-3cd6-9655-ec09e0b70861",
                                                "text": "even their arch-enemy the gamekeeper is beginning reluctantly, but gradually, to acquiesce in the general belief of their innocence and utility, I cannot help indulging the hope that this bird will eventually meet with that general encouragement and protection to which its eminent services so richly entitle it."
                                            },
                                            {
                                                "example_id": "a6090bd6-4c2d-4daa-9c18-3e38dfdb4979",
                                                "sense_id": "d78f5883-6532-3cd6-9655-ec09e0b70861",
                                                "text": "The train was handed over 21 min. late at Salisbury, so there was every encouragement to Driver Moore, of Salisbury, to \"get a move on.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0a5329-d3fd-38d0-9ce6-fcbe2e004fc8",
                                        "entry_id": "e66856b1-37fd-3114-adda-1b6cfd567120",
                                        "glosses": [
                                            "Words or actions that increase someone's confidence"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2310dfba-b304-4852-b75b-aff5b30f3433",
                                                "sense_id": "1e0a5329-d3fd-38d0-9ce6-fcbe2e004fc8",
                                                "text": "7 January 2017, Adharanand Finn writing in The Guardian, The 24-hour race: 'It is a battle with your mind'\nDiana Celeiro has come all the way from Argentina for the race. It’s her second time here. Her husband, Gustavo, acts as her support crew. Most of the runners have someone who stands diligently by the track watching, offering encouragement, preparing snacks or helping with any issues that arise, from blisters to emotional breakdowns."
                                            },
                                            {
                                                "example_id": "101bc6d9-85a2-4e22-9139-4f023a601d9c",
                                                "sense_id": "1e0a5329-d3fd-38d0-9ce6-fcbe2e004fc8",
                                                "text": "If I live, an' please your honour, but once to get through it, I will never tell it again, quoth Trim, either to man, woman, or child--Poo--poo! said my uncle Toby--but with accents of such sweet encouragement did he utter it, that the corporal went on with his story with more alacrity than ever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94760d1d-86a4-37c8-af95-af7897e32033",
                                        "entry_id": "e66856b1-37fd-3114-adda-1b6cfd567120",
                                        "glosses": [
                                            "The feeling of being encouraged"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27b0a034-f8d5-4c9a-9d0f-48a2e7eb3f78",
                        "source_entry_id": "bb225bb0-f61f-3746-b2cb-849e89c00565",
                        "source_sense_id": "7d5c68df-be1d-3a8e-83fc-5dd4ff33f8b9",
                        "source_sense_description": "het inspreken van moed",
