        "fr-extract.jsonl": [
            {
                "entry_id": "306afbac-cb50-33c9-8afe-96209e8af7db",
                "word": "irrationalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c19519f3-2945-48c8-b8c4-026e995f6089",
                        "entry_id": "306afbac-cb50-33c9-8afe-96209e8af7db",
                        "tags": [
                            "plural"
                        ],
                        "form": "irrationalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c432c74f-b340-3ccc-8d78-9ac4e178c396",
                        "entry_id": "306afbac-cb50-33c9-8afe-96209e8af7db",
                        "glosses": [
                            "Caractère irrationnel de quelque chose ; absence de rationalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9297151c-ac07-46c9-b8e8-a8ab2da47c63",
                                "sense_id": "c432c74f-b340-3ccc-8d78-9ac4e178c396",
                                "text": "L’irrationalité ne peut se définir qu’en fonction d’une raison idéalement posée."
                            },
                            {
                                "example_id": "a94105df-8b7e-43b8-a1bb-ab3282ac1d0e",
                                "sense_id": "c432c74f-b340-3ccc-8d78-9ac4e178c396",
                                "text": "[…] et il est important que la population prenne conscience du véritable danger que représente cette course folle vers la connaissance de l’avenir à l’aide de méthodes qui, en général, ne reposent sur aucun élément tangible et qui font montre d’irrationalité la plus totale."
                            },
                            {
                                "example_id": "4cc67eeb-66c2-43d2-a985-696bd4129ec3",
                                "sense_id": "c432c74f-b340-3ccc-8d78-9ac4e178c396",
                                "text": "Comme il apparaît encore très souvent que le laid, l'imbécile, le fou et le chaotique sont intimement associés à l'irrationnalité!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ed670e23-5f55-3787-8609-a895cbaa4f87",
                        "entry_id": "306afbac-cb50-33c9-8afe-96209e8af7db",
                        "glosses": [
                            "État de ce qui est irrationnel, en parlant des nombres, des équations, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e00f49-5ca4-4488-859c-6c64eb41f829",
                                "sense_id": "ed670e23-5f55-3787-8609-a895cbaa4f87",
                                "text": "En 1900, Hilbert […] a posé toute une série de problèmes non résolus ; le septième concerne l’irrationalité et la transcendance de certains nombres."
                            },
                            {
                                "example_id": "56c77be2-dd6d-4efd-831d-4b7581b280e6",
                                "sense_id": "ed670e23-5f55-3787-8609-a895cbaa4f87",
                                "text": "Un autre cheminement est envisagé pour la première démonstration de l’irrationalité de √2. Il se fonde sur une remarque arithmétique : Le double d’un carré parfait n’est jamais un carré parfait"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b62cbfb-28d7-4068-9b22-d622848f41ca",
                        "source_entry_id": "306afbac-cb50-33c9-8afe-96209e8af7db",
                        "source_sense_id": "c432c74f-b340-3ccc-8d78-9ac4e178c396",
                        "source_sense_description": "Asence de rationalité",
