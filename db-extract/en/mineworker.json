                        "glosses": [
                            "One who works in a mine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b6e30a-54fb-44bb-baeb-b9914d0c2513",
                                "sense_id": "494832b1-06f3-32e2-a9ba-3ec32353f279",
                                "text": "Near-synonym: miner (usually coinstantial)"
                            },
                            {
                                "example_id": "82e26097-b2a2-483d-8fd7-f7fe9f457a02",
                                "sense_id": "494832b1-06f3-32e2-a9ba-3ec32353f279",
                                "text": "West Australian Liberal MP Mal Washer says many mineworkers are paid more than federal backbenchers, who receive $127,060."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44fc1f25-6b58-4bcf-91d4-5c151ed45d2d",
                        "source_entry_id": "af7f8389-0c9a-3ab2-9ff5-7b7b21afa2c4",
