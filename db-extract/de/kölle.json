                "senses": [
                    {
                        "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                        "entry_id": "ff294068-0163-38a6-bdec-e747b792b2fd",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "013e58ea-16f6-4c2d-bcce-d222c6ff7d93",
                                "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                                "text": "Herr Kölle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "77ac2f6c-41a6-4978-9ae0-53701af3aed4",
                                "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                                "text": "Die Kölles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9ef5239f-f1e2-41a9-bd49-648c179a03b2",
                                "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                                "text": "Frau Kölle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b3912463-2955-4ec1-8622-29b6e69dee39",
                                "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                                "text": "Der Kölle trägt nie die Schals, die die Kölle ihm strickt."
                            },
                            {
                                "example_id": "9ae03257-7421-428b-bacf-a01d4ee81c48",
                                "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kölle kommt, geht der Herr Kölle.“"
                            },
                            {
                                "example_id": "b8e94c4f-b0b8-48d3-a8a1-8814a8259156",
                                "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                                "text": "Kölle kommt und geht."
                            },
                            {
                                "example_id": "7a0f9a70-768b-4bcc-8559-e8bf67e54860",
                                "sense_id": "ebdfb262-7aab-32c7-a836-31b5041966d2",
                                "text": "Kölles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
