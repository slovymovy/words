                                        "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                        "entry_id": "6a08d493-5048-3581-bc0e-574af61b15ff",
                                        "glosses": [
                                            "A branch of the Indo-Iranian languages in the Indo-European language family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c05ef9-4d2a-48f2-b650-affd61193c5b",
                                                "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                                "text": "Such a situation is not unusual in the history of languages, but Indo-Aryan has a very virulent case of the disease."
                                            },
                                            {
                                                "example_id": "bd5d07a6-1869-4497-a6f6-b643cc33e8ac",
                                                "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                                "text": "This is another way in which a depiction of the historical developments in Indo-Aryan bears on the theory of phrase structure generally, and on the rise of adpositional phrases in Indo-European specifically, showing us alternative pathways of change."
                                            },
                                            {
                                                "example_id": "b765fb02-a07a-4011-aad2-e69f1603bc60",
                                                "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                                "text": "Indo-Aryan has a very long history of attestation, from around 1400 bc to the present […]"
                                            }
                                        ]
                                    }
                                ]
                            },
