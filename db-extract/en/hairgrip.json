                "senses": [
                    {
                        "sense_id": "77fb837d-4117-33ff-a73c-6c57157a0293",
                        "entry_id": "1ee328f0-0b28-3188-b494-cd474823ea14",
                        "glosses": [
                            "A flat hairpin having two prongs that hold bobbed hair together."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d993f7e-9c27-4789-9a93-31aff5b7197e",
                                "sense_id": "77fb837d-4117-33ff-a73c-6c57157a0293",
                                "text": "Eve had chewed the cushion tip from her hairgrip and had begun bending back one end of the stiff piece of metal."
                            },
                            {
                                "example_id": "ce572348-95c2-494a-b8fd-a1ca200b8435",
                                "sense_id": "77fb837d-4117-33ff-a73c-6c57157a0293",
                                "text": "Then she leant over towards the bedside table, selected a hairgrip from amongst the crusted trio littered beside her hairbrush, and tenderly inserted the looped end into her right ear, turning it delicately to dredge for wax."
                            },
                            {
                                "example_id": "18ab6592-6c8b-4461-ab3c-a195576fe095",
                                "sense_id": "77fb837d-4117-33ff-a73c-6c57157a0293",
                                "text": "“The hairgrip was in this envelope\", Ulrika Stenholm said, passing him another small plastic bag containing a white envelope."
                            }
                        ]
                    }
                ],
