                                "target_senses": [
                                    {
                                        "sense_id": "e5d82e14-f51b-36c7-b246-567ef80c4adc",
                                        "entry_id": "e09118a2-c11b-3228-8f9b-fce157bea9d4",
                                        "glosses": [
                                            "In a guilty manner; as if guilty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc03f65-7efe-45b8-ad15-6ad874c09ebe",
                                                "sense_id": "e5d82e14-f51b-36c7-b246-567ef80c4adc",
                                                "text": "Guiltily, from time to time, she took swift inquiring looks at Mina, who was dressed more carefully, and had fresh plaited her hair."
                                            },
                                            {
                                                "example_id": "df995f92-8f4c-4c04-93da-a0550e58f466",
                                                "sense_id": "e5d82e14-f51b-36c7-b246-567ef80c4adc",
                                                "text": "He was guiltily aware now that he had kept Podson in the dark about the state of his finances to secure that extra fortnight's painting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
