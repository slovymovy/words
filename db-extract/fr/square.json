                                "target_senses": [
                                    {
                                        "sense_id": "c14c2e9e-ad52-3872-94b5-2c5fb92479e0",
                                        "entry_id": "0291d3ca-8fde-311d-820c-cba2f5db770c",
                                        "glosses": [
                                            "пространство, предназначенное для какой-либо цели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f63a531-77e3-4240-afc1-2e2b9c6d3884",
                                                "sense_id": "c14c2e9e-ad52-3872-94b5-2c5fb92479e0",
                                                "text": "В городе ощущалась острая нехватка офисных и жилых площадей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0342def-6722-3b64-98ad-a112ebb50727",
                                        "entry_id": "0291d3ca-8fde-311d-820c-cba2f5db770c",
                                        "glosses": [
                                            "незастроенное ровное место в городе или другом населённом пункте, обычно — окружённое зданиями и специально оформленное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2790a50-1877-43fc-ac93-4dd51e007515",
                                                "sense_id": "d0342def-6722-3b64-98ad-a112ebb50727",
                                                "text": "Главный фасад Московского вокзала в Петербурге выходит на площадь Восстания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8862f34f-ac16-369c-ba3e-a47d883f54ce",
                                        "entry_id": "0291d3ca-8fde-311d-820c-cba2f5db770c",
                                        "glosses": [
                                            "геометр. мера величины геометрической фигуры на плоскости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d9068a-2915-4f8f-8f1d-38b0d2acd1c7",
                                                "sense_id": "8862f34f-ac16-369c-ba3e-a47d883f54ce",
                                                "text": "Чтобы получить площадь трапеции, надо умножить полусумму её оснований на высоту."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a169cce1-02a9-4fbc-bd2f-ae506cbf63b3",
                        "source_entry_id": "cb6c37af-c565-33c8-ba67-c42dc57c44d7",
                        "target_lang_word": "сквер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сквер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad6631a-13b1-3516-b985-127df09187a1",
                                        "entry_id": "aa2cc8cd-c49a-3266-b450-97124b2539e3",
                                        "glosses": [
                                            "небольшой озеленённый участок в населённом пункте, предназначенный для кратковременного отдыха пешеходов и декоративного оформления городских площадей, улиц, набережных, территорий у общественных зданий, пространств вокруг монументов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "768d2c47-3950-4817-9b0f-1f693ed9047e",
                                                "sense_id": "2ad6631a-13b1-3516-b985-127df09187a1",
                                                "text": "И часто на сквере или в саду, когда вблизи их никого не было, он вдруг привлекал её к себе и целовал страстно."
                                            },
                                            {
                                                "example_id": "f695a469-368b-4d0a-b487-be4969ce7fe9",
                                                "sense_id": "2ad6631a-13b1-3516-b985-127df09187a1",
                                                "text": "Потом мы молча прошли набережную и сели в сквере на скамью."
                                            },
                                            {
                                                "example_id": "b166cef0-0431-44ab-b92b-c1f9e9c9d461",
                                                "sense_id": "2ad6631a-13b1-3516-b985-127df09187a1",
                                                "text": "Здесь же, на площади, иждивением и заботливостью городской думы, устроен сквер."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
