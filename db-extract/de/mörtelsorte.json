                "senses": [
                    {
                        "sense_id": "fab66e80-80f8-353e-ae84-e7a78ca3f959",
                        "entry_id": "fec84e99-6714-3901-925d-498790158fc4",
                        "glosses": [
                            "bestimmte Art von Mörtel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba0ecad2-1dec-4675-86ba-c16fe56dab60",
                                "sense_id": "fab66e80-80f8-353e-ae84-e7a78ca3f959",
                                "text": "„Wegen des unterschiedlichen Saugverhaltens der Mauersteine muss die Mörtelsorte auf die Steine abgestimmt werden.“"
                            },
                            {
                                "example_id": "f8d18bc6-d0ad-4adc-b357-41ee53d2d055",
                                "sense_id": "fab66e80-80f8-353e-ae84-e7a78ca3f959",
                                "text": "„Diese Mörtelsorte sollte gewissermaßen einen Kompromiss zum Einsatz von Leichthochlochziegelmauerwerk darstellen.“"
                            },
                            {
                                "example_id": "e2cad082-7c22-4b0a-9122-128024ef2bb6",
                                "sense_id": "fab66e80-80f8-353e-ae84-e7a78ca3f959",
                                "text": "„Um Verluste durch Bruch, Beschädigung etc. auszugleichen und um den Karbonatisierungsfortschritt verfolgen zu können, wurde von jeder Mörtelsorte eine größere Anzahl Platten hergestellt.“"
                            },
                            {
                                "example_id": "b6128081-2900-4127-a90c-e4f2fb4aa590",
                                "sense_id": "fab66e80-80f8-353e-ae84-e7a78ca3f959",
                                "text": "„In einer der Sandgruben befindet sich ein Mörtelwerk, das aus dem Sand unter Zusatz von Kalk verschiedene Mörtelsorten vom feinkörnigen Putzmörtel bis zum grobkörnigen Mauermörtel herstellt.“"
                            },
                            {
                                "example_id": "38f1cc23-c9b9-4411-89de-fbb54ca57375",
                                "sense_id": "fab66e80-80f8-353e-ae84-e7a78ca3f959",
                                "text": "„Nach der Wärmeeinwirkung von 1400 °C haben alle Mörtelsorten mit Werten zwischen 635 und 525 kp/cm² ihre Ausgangsfestigkeit erreicht oder zum Teil bis zu 135 % überschritten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
