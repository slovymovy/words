                {
                    "sense_id": "7e08469d-f339-3df2-8886-cb510c5b192c",
                    "sense_definition": "Проявляющий ласку, нежность или любовь к кому-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "отношение_человека",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш кот очень <w>ласковый</w> и постоянно просит, чтобы его погладили.",
                            "target_lang_translations": {
                                "en": "Our cat is very <w>affectionate</w> and is always asking to be petted."
                            }
                        },
                        {
                            "text": "Она была заботливой и очень <w>ласковой</w> матерью для своих маленьких детей.",
                            "target_lang_translations": {
                                "en": "She was a caring and very <w>loving</w> mother to her young children."
                            }
                        }
                    ],
                    "synonyms": [
                        "нежный"
                    ],
                    "antonyms": [
                        "неласковый",
                        "строгий",
                        "сердитый"
                    ],
                    "common_phrases": [
                        "ласковый котёнок",
                        "ласковый ребёнок"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing affection, tenderness, or love towards someone (often of a person or pet)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affectionate",
                                "target_lang_sense_clarification": "readily showing fondness and tenderness"
                            },
                            {
                                "target_lang_word": "loving",
                                "target_lang_sense_clarification": "feeling or showing love and care"
                            },
                            {
                                "target_lang_word": "tender",
                                "target_lang_sense_clarification": "showing gentle warmth and care"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff959f59-b7aa-391d-9f15-1fd57f83b033",
                    "sense_definition": "Выражающий теплоту, любовь, заботу или нежность (о голосе, взгляде, словах).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "проявление_чувств",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка произнесла несколько <w>ласковых</w> слов, чтобы успокоить расстроенного внука.",
                            "target_lang_translations": {
                                "en": "Grandmother said a few <w>tender</w> words to comfort her upset grandson."
                            }
                        },
                        {
                            "text": "Его тёплый и <w>ласковый</w> взгляд сразу помог мне почувствовать себя увереннее.",
                            "target_lang_translations": {
                                "en": "His warm and <w>gentle</w> look immediately helped me feel more confident."
                            }
                        }
                    ],
                    "synonyms": [
                        "нежный"
                    ],
                    "antonyms": [
                        "сердитый",
                        "строгий",
                        "неприязненный"
                    ],
                    "common_phrases": [
