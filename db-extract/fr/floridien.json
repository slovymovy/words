                "senses": [
                    {
                        "sense_id": "42421a47-b3f8-37f5-90c5-d12d5ba0ecb2",
                        "entry_id": "dbd8007e-65ec-3b3c-bb30-109945dc3395",
                        "glosses": [
                            "Relatif à la Floride."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "706246bd-8ddb-4148-b849-1d7d938721a4",
                                "sense_id": "42421a47-b3f8-37f5-90c5-d12d5ba0ecb2",
                                "text": "La Groenplaats avait en effet brièvement accueilli un Hard Rock Cafe. Mais le franchisé avait fini par perdre les faveurs de la chaîne floridienne."
                            },
                            {
                                "example_id": "6e0e6e82-389e-4c60-ad8c-fe68e81f277f",
                                "sense_id": "42421a47-b3f8-37f5-90c5-d12d5ba0ecb2",
                                "text": "Des politiciens floridiens ont aussi exprimé leur déplaisir de voir l’État devenir une destination touristique antivirale."
                            }
                        ]
                    }
                ],
                "translations": [
