                    {
                        "sense_id": "e8d26e0e-4304-3b5b-9a6c-8185d06a3c87",
                        "entry_id": "70b38de8-1ffe-3385-a44e-1b6dc10842bb",
                        "glosses": [
                            "Sténographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3c85f76-48c4-41e6-bf5d-241fbfc2eb1d",
                                "sense_id": "e8d26e0e-4304-3b5b-9a6c-8185d06a3c87",
                                "text": "Il y a tellement de poissons qu’on aura fait la friture en moins de temps qu’il n’en faut pour écrire « à table ! » en sténo."
                            },
                            {
                                "example_id": "73c3e84a-79e4-4427-9d57-c26fd365ac6e",
                                "sense_id": "e8d26e0e-4304-3b5b-9a6c-8185d06a3c87",
                                "text": "Elle a réservé à son enfant une situation de demoiselle, c’est-à-dire qu’elle s’est saignée pour lui faire apprendre la sténo et la dactylographie."
                            }
                        ]
                    },
                    {
                        "sense_id": "65ec67fe-de75-3699-806d-b925fc399820",
                        "entry_id": "70b38de8-1ffe-3385-a44e-1b6dc10842bb",
