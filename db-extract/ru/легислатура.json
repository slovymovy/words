                "senses": [
                    {
                        "sense_id": "31c78a0a-7a5f-3812-b2df-f1f5542928b8",
                        "entry_id": "56a85ca0-2fa7-3d64-93a5-2fc05f2134fb",
                        "glosses": [
                            "юр. период деятельности законодательного органа одного созыва или выборного должностного лица, срок его законных полномочий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0caa837-9ab8-4447-a51e-86771b9200f8",
                                "sense_id": "31c78a0a-7a5f-3812-b2df-f1f5542928b8",
                                "text": "Новые выборы проводятся не ранее сорока шести и не позднее сорока восьми месяцев после начала легислатуры."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e440039-89a1-321d-8f12-de48851f275a",
                        "entry_id": "56a85ca0-2fa7-3d64-93a5-2fc05f2134fb",
                        "glosses": [
                            "юр. в некоторых государствах — законодательный орган"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b93729-bef3-4aab-af91-e1f1fbdf69f9",
                                "sense_id": "6e440039-89a1-321d-8f12-de48851f275a",
                                "text": "Депутат городской легислатуры — по-нашему, горсовета — только и ждёт случая, чтобы выдвинуть свою кандидатуру в Конгресс США."
                            }
                        ]
                    }
