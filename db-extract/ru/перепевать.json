                "senses": [
                    {
                        "sense_id": "71abadd3-9ad3-3eb9-9101-4adfe0d1570a",
                        "entry_id": "274fa982-8c5b-337e-a308-11ecd1f4dbd0",
                        "glosses": [
                            "петь всё или многое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea15c8b9-82ed-4800-90fc-95708ff89a6a",
                                "sense_id": "71abadd3-9ad3-3eb9-9101-4adfe0d1570a",
                                "text": "― Ежли б меня не брали на службу, не был бы я офицером… Ну, это длинная песня! ― И длинная и поганая песня. ― Зараз ее не перепевать, опоздано."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d6c830f-1986-3b5c-9510-3ee86487b80f",
                        "entry_id": "274fa982-8c5b-337e-a308-11ecd1f4dbd0",
                        "glosses": [
                            "петь снова или иначе"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "11d65156-79ce-37fe-88ce-febb67533851",
                        "entry_id": "274fa982-8c5b-337e-a308-11ecd1f4dbd0",
                        "glosses": [
                            "петь лучше, дольше кого-либо, превосходить кого-либо в пении"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3b636968-8682-3b0c-94e8-88a3fc57b925",
                        "entry_id": "274fa982-8c5b-337e-a308-11ecd1f4dbd0",
                        "glosses": [
                            "перен. повторять одно и то же, заимствуя из прежнего или у других"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c029ef2e-6ae3-4f3a-9895-da4df33d0d25",
                                "sense_id": "3b636968-8682-3b0c-94e8-88a3fc57b925",
                                "text": "В этот день мы выходили одни. На следующий день все газеты вынуждены были перепевать нас."
                            }
                        ]
                    }
