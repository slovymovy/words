                    "sense_id": "3a7f39e2-8555-3060-b5e8-8c993af75f96",
                    "sense_definition": "behoefte hebben aan rust of slaap na inspanning",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vermoeidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange dag op kantoor was hij erg <w>moe</w> van al het werk.",
                            "target_lang_translations": {
                                "en": "After a long day at the office, he was very <w>tired</w> from all the work."
                            }
                        },
                        {
                            "text": "Ik merk dat ik ineens <w>ontzettend moe</w> ben en wil graag gaan slapen.",
                            "target_lang_translations": {
                                "en": "I notice that I am suddenly <w>extremely tired</w> and would like to go to sleep."
                            }
                        }
                    ],
                    "synonyms": [
