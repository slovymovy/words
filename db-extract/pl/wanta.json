                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c5ac99-ff3d-3624-b2ce-aac4187688b0",
                                        "entry_id": "2927a109-3ded-3219-83ce-b2eff6fd98b9",
                                        "glosses": [
                                            "„Seil oder Stange zur seitlichen Verspannung eines Masts“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc76e8e7-459d-40d3-84bc-65d9f86e3bbf",
                                                "sense_id": "b9c5ac99-ff3d-3624-b2ce-aac4187688b0",
                                                "text": "„Im Handumdrehen kletterten die Matrosen die Wanten hoch und zurrten voll Eifer die Segel fest, wobei der Kapitän sie selbst mit einem Shanty anfeuerte.“"
                                            },
                                            {
                                                "example_id": "b42f4aad-669f-4043-b821-705d66b05eb7",
                                                "sense_id": "b9c5ac99-ff3d-3624-b2ce-aac4187688b0",
                                                "text": "„Die Besanmasten waren längst verschwunden, die Großmasten in vierzig Fuß Höhe abgebrochen, die Fockmasten zwar mehr oder weniger intakt, aber ihrer Wanten beraubt.“"
                                            },
                                            {
                                                "example_id": "ccf615da-0c7b-4c7b-85ff-f5b2f1d038e8",
                                                "sense_id": "b9c5ac99-ff3d-3624-b2ce-aac4187688b0",
                                                "text": "„Kurz nachdem wir geankert hatten, wurde Mr. Bogardus die Wanten hinaufgeschickt, um nach dem Feind Ausschau zu halten.“"
                                            },
                                            {
                                                "example_id": "d69025f8-50ce-458f-b9ad-5fa095e491b8",
                                                "sense_id": "b9c5ac99-ff3d-3624-b2ce-aac4187688b0",
                                                "text": "„Etwa 30 Mann Besatzung der Brigg hingen mittlerweile in den Wanten und sahen den Manövern des Kanus zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
