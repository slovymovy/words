                        "cross_references": [
                            {
                                "target_word": "Yinchuan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0eee360-83e7-3d7b-985d-26ac566862f6",
                                        "entry_id": "ece10720-2c2a-38ca-85b4-937856b6d932",
                                        "glosses": [
                                            "The capital city of the Ningxia Hui Autonomous Region, China"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "029e181b-952c-4f3b-927b-4568148c5925",
                                                "sense_id": "f0eee360-83e7-3d7b-985d-26ac566862f6",
                                                "text": "Peiping radio claimed tonight that Communists occupied Yinchuan, capital of Ninghsia Province in Central China two days ago."
                                            },
                                            {
                                                "example_id": "6d6f3df0-3bb7-4ac4-b086-4a1de2aa5158",
                                                "sense_id": "f0eee360-83e7-3d7b-985d-26ac566862f6",
                                                "text": "All the bigger towns in this vast area are to have new power stations. Yinchuan and Bayenhot in Ningsia province, Sining in Chinghai, Tienshui, Tunhchuan and Paochi in Shensi, and Tihua in Sinkiang have all been mentioned in Press reports.\nAt Yinchuan factories for machinery, woollen textiles and chemicals have been started, and two new textile mills are planned in the cotton-growing district of Kuanchung, in Shensi."
                                            },
                                            {
                                                "example_id": "7f0c83ce-23a3-450c-8461-e73a3efd499f",
                                                "sense_id": "f0eee360-83e7-3d7b-985d-26ac566862f6",
                                                "text": "On the trip out our car was full of railway workers, going out to work on the Lanchow-Sinkiang Railway which had already reached Yumen, China’s biggest oil field, and in 1960 will connect with the Soviet Union’s Turkestan-Siberia Railway; or to the Lanchow-Yinchuan section, which cuts through the Great Wall to reach Yinchuan, a major wool, hide and skin trading center in the Northwest."
                                            },
                                            {
                                                "example_id": "e1faa04f-ab55-42e5-93b7-e81b02f4080f",
                                                "sense_id": "f0eee360-83e7-3d7b-985d-26ac566862f6",
                                                "text": "Yinchuan, capital of the Ningsia Hui Autonomous Region, lies in the centre of the Ningsia Plain.",
                                                "translation": "A Concise Geography of China",
                                                "english": "A Concise Geography of China"
                                            },
                                            {
                                                "example_id": "2c0dfad3-fc30-4e72-bec1-3e328bb23dd2",
                                                "sense_id": "f0eee360-83e7-3d7b-985d-26ac566862f6",
                                                "text": "Mr. Ai had become obsessed with a red scribble that appeared on a planning document for an art show next month in Yinchuan, a city in northwest China. He decided to build a large sculpture modeled on the line that he would call “Redline” — a playful rumination on the idea of censorship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
