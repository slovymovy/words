    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "64ec72f7-d15f-31c5-b6e3-1a702b5c3dbd",
                "word": "undoubted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "598183c6-cbc5-4afe-be91-a3b540ee034f",
                        "entry_id": "64ec72f7-d15f-31c5-b6e3-1a702b5c3dbd",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more undoubted"
                    },
                    {
                        "form_id": "776ad1ed-66b3-4534-ad5c-36de8d59999c",
                        "entry_id": "64ec72f7-d15f-31c5-b6e3-1a702b5c3dbd",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most undoubted"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                        "entry_id": "64ec72f7-d15f-31c5-b6e3-1a702b5c3dbd",
                        "glosses": [
                            "Without doubt; without question; certain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860b26e9-932b-455e-b2b2-a29eb9063fe1",
                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                "text": "His undoubted skill meant that he was in much demand."
                            },
                            {
                                "example_id": "57a1193b-45a2-404a-9940-07c49e1e90a5",
                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                "text": "More should I question thee, and more I must,\nThough more to know could not be more to trust,\nFrom whence thou camest, how tended on: but rest\nUnquestion’d welcome and undoubted blest."
                            },
                            {
                                "example_id": "c70d615f-39de-43c5-b951-476ddd1db81f",
                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                "text": "Thou Spirit who ledſt this glorious Eremite\nInto the Deſert, his Victorious Field\nAgainſt the Spiritual Foe, and broughtſt him thence\nBy proof the undoubted Son of God, […]"
                            },
                            {
                                "example_id": "6bc5939d-c6da-4c4c-af97-16c492ec4a13",
                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                "text": "Of what he has particularly accused me I am ignorant; but of the truth of what I shall relate, I can summon more than one witness of undoubted veracity."
                            },
                            {
                                "example_id": "6c6bad98-f453-4a16-ac79-fe441b141225",
                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                "text": "The place of psychology in business is undoubted; whether it can prevail against more concrete and material facts, and if so, how long, remain debatable propositions."
                            },
                            {
                                "example_id": "60ee1453-e7f6-4ced-8f63-4e894fdf8302",
                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                "text": "Netherlands, one of the pre-tournament favourites, combined their undoubted guile, creativity, pace and attacking quality with midfield grit and organisation."
                            },
                            {
                                "example_id": "dea0fc23-719f-450c-b88a-ff31ca15dd18",
                                "sense_id": "e595e905-e195-3ca9-9176-897599eb184e",
                                "text": "The “recognition” before a 2,300-strong congregation of foreign royals, heads of state, former prime ministers, and charity and community representatives, saw him presented four times as “your undoubted king” to the compass points of the raised coronation theatre with no murmur of dissent."
                            }
                        ]
                    }
                ],
