                    {
                        "form_id": "8138fa21-4d66-45ae-bd8b-b6b72b8606e8",
                        "entry_id": "1b9261e4-430d-3e1e-aec7-4e4418917ba2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Stehlampen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
                        "entry_id": "1b9261e4-430d-3e1e-aec7-4e4418917ba2",
                        "glosses": [
                            "auf dem Fußboden oder auf einem Tisch stehende Lampe mit Standfuß und meist mit Lampenschirm und hohem Ständer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d65798-031b-4c6f-8d0b-fb3c004d98d7",
                                "sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
                                "text": "„Dimmer sind Lichtschalter, die neben dem Ein- und Ausschalten der Beleuchtung auch die Einstellung der Helligkeit der Beleuchtung über einen Drehregler erlauben. Sie sind auch häufig in Tisch- oder Stehlampen eingebaut.“"
                            },
                            {
                                "example_id": "0413a0a4-55e2-4bf7-b3b4-9845904faffa",
                                "sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
                                "text": "„Auf dem Weg zum Gerät blieb er an der Schraube der Stehlampe hängen und zog sich einen Faden aus dem Pullover.“"
                            },
                            {
                                "example_id": "0dffbef1-b60a-4cee-92eb-65df726ebadb",
                                "sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
                                "text": "„Ich hole mir auch ein Bier, knipse die Stehlampe im Wohnzimmer an und setze mich neben Jan auf die Couch.“"
                            },
                            {
                                "example_id": "b772616a-34ee-4c02-9baf-778c1b5714d2",
                                "sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
                                "text": "„Draußen stürmt und regnet es. Die Tage wollen nicht hell werden. Novemberwetter. Das Licht der Stehlampe lädt ein zum Lesen.“"
                            },
                            {
                                "example_id": "35bf8e1b-305d-44fa-a44e-d140038b05ab",
                                "sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
                                "text": "[Der Designer] „Diez liebt die funktionale Einfachheit industriell hergestellter Materialien, wie man sie auch im Baumarkt kaufen kann. Für eine grazile Stehlampe verwendet er schon mal billige netzartige Plastikhüllen, mit denen in Industrieanlagen Kabel gebündelt werden.“"
                            },
                            {
                                "example_id": "fcd5d095-2330-40fa-a06e-f63e130acec9",
                                "sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
                                "text": "„Stehlampen wie dieses Modell des begehrten Pariser Entwerfers Pierre Guariche von 1951 werden inzwischen so gekonnt nachgebaut, dass Original und Fälschung kaum mehr zu unterscheiden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a36419e4-d00d-4b6e-828a-d6f8f4f7f33f",
                        "source_entry_id": "1b9261e4-430d-3e1e-aec7-4e4418917ba2",
                        "source_sense_id": "61fe6641-3aaf-38c4-b4d8-86ddaf5f4db8",
