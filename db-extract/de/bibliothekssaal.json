                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c120342e-d039-4274-84a3-88ad253f8c77",
                                "sense_id": "e840d860-5480-3cb5-8bd2-5d442c0251ac",
                                "text": "„Um an der Seine und durch die Passagen zu flanieren, der existenziellen Sinnlosigkeit mit Trank (Pernod) und Tschick (Gitanes) zu trotzen, genügt eine Reise nach Lehen, wo zwar im Bibliothekssaal nicht gepofelt werden darf, aber mittels Textrezitationen, Filmprojektionen und Musik eine kulturgeschichtliche Epoche rekonstruiert wird.“"
                            },
                            {
                                "example_id": "6086c4a7-d71d-40bc-89ab-2d2c9e3e8e5e",
                                "sense_id": "e840d860-5480-3cb5-8bd2-5d442c0251ac",
                                "text": "„Man führte ihn in den Bibliothekssaal des Assessors.“"
                            }
                        ],
