                    {
                        "sense_id": "e27f2322-e583-3c55-b7b6-16d7812ba109",
                        "entry_id": "064c225d-d58d-3ce8-ad99-12486a360658",
                        "glosses": [
                            "einer der beiden Briefe des Apostels Paulus an die urchristliche Gemeinde im makedonischen Thessalonich"
                        ],
                        "tags": [
                            "Neutestamentliche Wissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "49ba5639-9489-4e66-a438-f567957e5387",
                                "sense_id": "e27f2322-e583-3c55-b7b6-16d7812ba109",
                                "text": "„Er verheißt schließlich ‚pax et securitas‘, Friede und Sicherheit, ein Wort aus dem zweiten Thessalonicherbrief, für die ihm unterworfene Erde.“"
                            },
                            {
                                "example_id": "b3b535ef-2c20-49ee-9297-ca0b8dca0dc7",
                                "sense_id": "e27f2322-e583-3c55-b7b6-16d7812ba109",
                                "text": "Beide Thessalonicherbriefe geben Zeugnis von der Endzeiterwartung, in der die urchristliche Gemeinde von Thessalonich lebte."
                            }
                        ],
                        "sense_index_json": "\"1\""
