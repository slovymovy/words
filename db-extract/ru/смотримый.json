                                                "example_id": "b6b981ae-470e-4868-b569-4e67ddb8571b",
                                                "sense_id": "6136c035-b10c-372b-a7cd-0e3f2c60ac94",
                                                "text": "Six months old, a half-season project, they are already more watchable and more coherent than the second phase of the title-winning team of two years ago; but not at the level of the luminous, steamrollering Mourinho Mk1 team, a rare concurrence of prime-cut talent and a manager in the sweet spot of his own powers."
                                            },
                                            {
                                                "example_id": "00345248-22e1-48b6-bbec-adc3b13ff851",
                                                "sense_id": "6136c035-b10c-372b-a7cd-0e3f2c60ac94",
                                                "text": "Interminable hocus pocus with a plethora of talk, seldom exciting but watchable because of its remarkable cast..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "watchable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e147a4-86e4-37a0-888c-6d3c06dca1f6",
                                        "entry_id": "a57fddf2-4a16-3303-ac8f-50190825eb48",
                                        "glosses": [
                                            "Something to be watched, or worth watching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aea7e26-77cc-4fde-aa60-331201f2418a",
                                                "sense_id": "a4e147a4-86e4-37a0-888c-6d3c06dca1f6",
                                                "text": "Telly Savalas, Robert Culp and James Mason are the watchables in 1975's The Golden Heist […]"
                                            },
                                            {
                                                "example_id": "42385a69-5a4d-4a07-82b1-f75254bedaaa",
                                                "sense_id": "a4e147a4-86e4-37a0-888c-6d3c06dca1f6",
                                                "text": "Each January, San Diego Magazine announces its list of San Diegans worth watching — and watching out for — in the coming year with its \"People To Watch\" cover story. The magazine fetes its 50 watchables with a VIP bash […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
