                        "tags": [],
                        "examples": [
                            {
                                "example_id": "392c6a2b-afff-4cbf-817a-ff36e0af5210",
                                "sense_id": "78fb8c30-619b-3a9d-867e-ff37cbf03628",
                                "text": "Les indés équipés avec des ions sont pour la plupart les indés qui se sont fait défactionner lors de la remise à zéro des factions donc on ne peut pas vraiment leur reprocher d'utiliser des ions."
                            },
                            {
                                "example_id": "3e68b640-c525-4248-815b-f25823c05bb7",
                                "sense_id": "78fb8c30-619b-3a9d-867e-ff37cbf03628",
                                "text": "Donc en 10 minutes tu peux te défactionner, remettre à 0 ton niveau de pilote, te refactionner et recommencer à grinder ton pilote."
                            }
                        ]
