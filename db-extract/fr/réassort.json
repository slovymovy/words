                                    {
                                        "sense_id": "448a62b7-44a7-3a62-a352-2fe1aee6f6bd",
                                        "entry_id": "b0bec43c-2617-3326-8d92-8d3f7f0192dd",
                                        "glosses": [
                                            "An act of replenishing stock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8204e827-c646-4f5b-8c45-5231df20abfa",
                                                "sense_id": "448a62b7-44a7-3a62-a352-2fe1aee6f6bd",
                                                "text": "The new product sold so rapidly that the shelves needed two restockings in a day."
                                            },
                                            {
                                                "example_id": "898ce82a-f44a-4405-ab94-c04a53027733",
                                                "sense_id": "448a62b7-44a7-3a62-a352-2fe1aee6f6bd",
                                                "text": "The latter three gave their presidential addresses on matters railway, with Gresley covering the LNER's streamlined trains, Stanier the restocking of the LMSR's motive power ranks, and Bulleid on his 'Merchant Navy' locomotives."
                                            }
                                        ]
