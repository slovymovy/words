                "senses": [
                    {
                        "sense_id": "951008f3-e778-3ed1-ae04-18037de38bce",
                        "entry_id": "8fce17e0-3fc6-30a6-84a3-29925c269a5f",
                        "glosses": [
                            "Keks aus/mit eingebackenen Haferflocken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8677f4ad-e18b-47e4-b9ce-5551190a990f",
                                "sense_id": "951008f3-e778-3ed1-ae04-18037de38bce",
                                "text": "„Ich löste zwei schokoladenbezogene Haferkekse aus der Packung und verschlang sie hungrig zu meinem Kaffee.“"
                            },
                            {
                                "example_id": "ec01ac1f-3ad1-4d6e-98fd-4ec35450083b",
                                "sense_id": "951008f3-e778-3ed1-ae04-18037de38bce",
                                "text": "„Als das Eis kam, holte er aus seiner Schreibtischschublade eine Packung Haferkekse und zerbröselte einen davon über dem Eis, um dem kühlen Genuss auf seiner Zunge noch eine knusprige Komponente hinzuzufügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
