    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee17d3e9-ad24-3e21-9b0a-4a0e0ba16a92",
                    "sense_definition": "zich verplaatsen van de ene naar de andere plek",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verplaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De slang <w>bewoog</w> zich bliksemsnel <w>voort</w> over het hete zand.",
                            "target_lang_translations": {
                                "fr": "Le serpent <w>se déplaçait</w> à une vitesse fulgurante sur le sable brûlant."
                            }
                        },
                        {
                            "text": "Het is moeilijk om je in een rolstoel <w>voort</w> te <w>bewegen</w> op dit zandpad.",
                            "target_lang_translations": {
                                "fr": "Il est difficile de <w>se déplacer</w> en fauteuil roulant sur ce chemin de sable."
                            }
                        }
                    ],
                    "synonyms": [
                        "verplaatsen",
                        "gaan",
                        "reizen"
                    ],
                    "common_phrases": [
                        "zich voortbewegen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se déplacer d'un endroit à un autre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se déplacer",
                                "target_lang_sense_clarification": "terme général pour changer de position ou de lieu"
                            },
                            {
                                "target_lang_word": "avancer",
                                "target_lang_sense_clarification": "aller vers l'avant ou progresser"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f712f4d-f670-35a3-9e68-1ef9a12ae31a",
                    "sense_definition": "iets in beweging brengen of houden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aandrijving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een stoommachine <w>beweegt</w> de wielen van de trein <w>voort</w>.",
                            "target_lang_translations": {
                                "fr": "Une machine à vapeur <w>propulse</w> les roues du train."
                            }
                        },
                        {
                            "text": "Het mechanisme wordt door een zwaar gewicht <w>voortbewogen</w>.",
                            "target_lang_translations": {
                                "fr": "Le mécanisme est <w>actionné</w> par un poids lourd."
                            }
                        }
                    ],
                    "synonyms": [
                        "aandrijven",
                        "voortstuwen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Mettre ou maintenir quelque chose en mouvement, souvent par une force mécanique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "propulser",
                                "target_lang_sense_clarification": "pousser vers l'avant avec force"
                            },
                            {
                                "target_lang_word": "actionner",
                                "target_lang_sense_clarification": "mettre en marche un mécanisme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
