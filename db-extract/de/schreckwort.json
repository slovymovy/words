                "senses": [
                    {
                        "sense_id": "48a6597e-5cf5-304e-9f1a-60059c2229b5",
                        "entry_id": "a00e0bac-de07-3f2d-a2a3-4d595d6bdcac",
                        "glosses": [
                            "Wort, mit dem bei dem Partner Schrecken ausgelöst werden soll oder auch unbeabsichtigt ausgelöst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4e9323-f109-4948-9058-68d1a68ba1ab",
                                "sense_id": "48a6597e-5cf5-304e-9f1a-60059c2229b5",
                                "text": "Ladendorf (1906) nennt „Klassenkampf“ als Schreckwort und gibt folgendes Zitat von Sombart (1901) wieder: „Das Schreckwort für alle Philister männlichen und weiblichen Geschlechts ist: K l a s s e n k a m p f.“"
                            },
                            {
                                "example_id": "0f185b6c-a10d-4983-90fa-f77ef06f47f4",
                                "sense_id": "48a6597e-5cf5-304e-9f1a-60059c2229b5",
                                "text": "Ob etwas als Schreckwort empfunden wird, liegt an der Einstellung des Hörers/ Lesers."
                            },
                            {
                                "example_id": "6d732f97-9321-4d84-a004-5d9bfe9f8208",
                                "sense_id": "48a6597e-5cf5-304e-9f1a-60059c2229b5",
                                "text": "„Das Wort Sozialfall erinnerte Helder auf unangenehme Weise an andere Wörter, die gerüchteweise sein Büro durchschwirrten: Rationalisierung, Umstrukturierung, Personalabbau. Lauter Drohworte, lauter Schreckworte.“"
                            },
                            {
                                "example_id": "e5de45bd-3d14-4bbf-981e-f683536495ee",
                                "sense_id": "48a6597e-5cf5-304e-9f1a-60059c2229b5",
                                "text": "„»Gas« wurde lange vor den KZ-Gaskammern zum Schreckwort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
