                "senses": [
                    {
                        "sense_id": "7cd170b3-2e98-3703-a13d-62f5d5e1fe66",
                        "entry_id": "764a7b44-d728-3d8d-a683-9d4ea6f10fa9",
                        "glosses": [
                            "Gesamtheit der Einrichtungen/Institutionen, die der Bildung/Ausbildung der Bevölkerung dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167536ab-f2ac-4c4e-b0ba-13ae4caca8f6",
                                "sense_id": "7cd170b3-2e98-3703-a13d-62f5d5e1fe66",
                                "text": "„Das deutsche Bildungssystem ist systemisch krank“"
                            },
                            {
                                "example_id": "7f6bc047-28ee-4a23-af34-d1a35e0e6343",
                                "sense_id": "7cd170b3-2e98-3703-a13d-62f5d5e1fe66",
                                "text": "„Das kapitalistische Bildungssystem unterscheidet sich sehr von den sozialistischen planwirtschaftlichen Schulen meiner Kindheit.“"
                            },
                            {
                                "example_id": "ddb91cd1-c3eb-4c68-ac48-609c85fda2b9",
                                "sense_id": "7cd170b3-2e98-3703-a13d-62f5d5e1fe66",
                                "text": "„Denn das Schädlichste am dreigliedrigen Bildungssystem ist, dass es die starre kaiserzeitliche »Oben/Unten«-Gesellschaftsordnung zementiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
