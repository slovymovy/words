                "senses": [
                    {
                        "sense_id": "637128d1-b7cd-34a8-b3ba-d9f3ec4d9445",
                        "entry_id": "335bf4fe-9cf8-3c0f-aad6-c31e90475dc5",
                        "glosses": [
                            "der Einstich in die Erde mithilfe eines Spatens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3852de5-a4ce-4f7a-aeca-4d5c08f81978",
                                "sense_id": "637128d1-b7cd-34a8-b3ba-d9f3ec4d9445",
                                "text": "Tausende von Spatenstichen später war die Baugrube ausgehoben."
                            },
                            {
                                "example_id": "496bd830-f481-46d0-a88e-7de6a4bd3cc6",
                                "sense_id": "637128d1-b7cd-34a8-b3ba-d9f3ec4d9445",
                                "text": "„Er fand den Ort, den die Frau ihm gezeigt hatte, und schon nach ein paar Spatenstichen stießen sie auf einen Klumpen.“"
                            },
                            {
                                "example_id": "e39746fb-7e87-4943-87f2-6029ad0d3869",
                                "sense_id": "637128d1-b7cd-34a8-b3ba-d9f3ec4d9445",
                                "text": "„Durch die beiden offenen Fenster drang zuweilen vom Garten her das Geräusch der Spatenstiche und das trockene Klappern der Stricknadeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a6f46653-0840-363d-8d04-d2edd3ef4c9c",
                        "entry_id": "335bf4fe-9cf8-3c0f-aad6-c31e90475dc5",
                        "glosses": [
                            "kurz für „erster Spatenstich“, symbolischer Akt zum Baubeginn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1397f7-0691-421f-bfae-3879aeb0a2c0",
                                "sense_id": "a6f46653-0840-363d-8d04-d2edd3ef4c9c",
                                "text": "Als endlich mit dem Bau begonnen wurde, lag der Spatenstich schon Jahre zurück."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
