    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7212b03-9596-3c9a-a62a-4d3de7b7c8b4",
                    "sense_definition": "Present participle and gerund of <w>restrain</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had difficulty <w>restraining</w> the angry crowd outside the courthouse.",
                            "target_lang_translations": {
                                "ru": "Полиции с трудом удавалось <w>сдерживать</w> разъярённую толпу возле здания суда."
                            }
                        },
                        {
                            "text": "He took a deep breath, <w>restraining</w> himself from saying something he might regret.",
                            "target_lang_translations": {
                                "ru": "Он глубоко вздохнул, <w>сдерживая себя</w>, чтобы не сказать то, о чём потом пожалеет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "restraining order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола restrain: сдерживающий, сдерживая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдерживающий",
                                "target_lang_sense_clarification": "причастие, ограничивающий силу или движение"
                            },
                            {
                                "target_lang_word": "сдерживая",
                                "target_lang_sense_clarification": "деепричастие, контролируя эмоции или действия"
                            },
                            {
                                "target_lang_word": "удерживающий",
                                "target_lang_sense_clarification": "причастие, удерживающий силой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9b8ff82-2593-334d-a728-036c132bd98b",
                    "sense_definition": "The act of holding back, checking, or controlling someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient required constant <w>restraining</w> to prevent him from pulling out the medical tubes.",
                            "target_lang_translations": {
                                "ru": "Пациент требовал постоянного <w>удержания</w>, чтобы не дать ему выдернуть медицинские трубки."
                            }
                        },
                        {
                            "text": "Such continuous <w>restraining</w> of natural impulses can often lead to emotional exhaustion.",
                            "target_lang_translations": {
                                "ru": "Такое постоянное <w>подавление</w> естественных порывов часто приводит к эмоциональному истощению."
                            }
                        }
                    ],
                    "synonyms": [
                        "restraint",
                        "suppression",
                        "curbing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по удержанию, ограничению или контролю кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдерживание",
                                "target_lang_sense_clarification": "порывов, эмоций или развития"
                            },
                            {
                                "target_lang_word": "удержание",
                                "target_lang_sense_clarification": "физическая фиксация или контроль"
                            },
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "лишение свободы действий"
                            },
                            {
                                "target_lang_word": "подавление",
                                "target_lang_sense_clarification": "импульсов или естественных реакций"
                            }
                        ]
                    }
                }
            ]
        }
    ]
