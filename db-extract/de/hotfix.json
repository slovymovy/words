                                                "example_id": "ff27fa09-9e98-48f8-a2f6-f7ce49642920",
                                                "sense_id": "e3399b62-33c1-3d51-accd-9046fe354ab0",
                                                "text": "When you extract the files in a hotfix, you'll generally find the following."
                                            },
