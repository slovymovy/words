                "senses": [
                    {
                        "sense_id": "997f9ac6-77dd-3e4c-9641-8448a06c6c68",
                        "entry_id": "fe44a4a9-be31-32db-95cb-38b0c178c218",
                        "glosses": [
                            "Angehöriger der Post, der für den Postbetrieb in einem bestimmten Bereich zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01888cf2-7f3a-4b42-a5ae-2c8af43e95a4",
                                "sense_id": "997f9ac6-77dd-3e4c-9641-8448a06c6c68",
                                "text": "„Wilhelm Krogel, der Postmeister von Bodendorf, war ein Mann von hemmungsloser Schlampigkeit.“"
                            },
                            {
                                "example_id": "cc165b02-6435-4bdb-b7cb-d12057889e59",
                                "sense_id": "997f9ac6-77dd-3e4c-9641-8448a06c6c68",
                                "text": "„Der Postmeister, denn der war es, kam näher, seine Augen mit vorgehaltenem Arm schützend.“"
                            },
                            {
                                "example_id": "6f535213-a001-4988-b49f-1770290a770c",
                                "sense_id": "997f9ac6-77dd-3e4c-9641-8448a06c6c68",
                                "text": "„Bis dahin bestand auch die Möglichkeit, Handstempel dafür einzusetzen, was vielen Postmeistern bequemer erschien.“"
                            },
                            {
                                "example_id": "45d7af8f-3f84-455f-b2c7-6e2671aee871",
                                "sense_id": "997f9ac6-77dd-3e4c-9641-8448a06c6c68",
                                "text": "„Als ich nach dem Abendessen schlafen ging, war ich entschlossen, den Sohn des Postmeisters nach Florenz zu schicken, wenn meine Leute nicht während der Nacht ankämen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
