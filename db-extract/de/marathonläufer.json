                ],
                "senses": [
                    {
                        "sense_id": "a0777b2a-73e7-3b32-891a-f2cf73e639bf",
                        "entry_id": "e696adbd-ba8d-3857-8ac2-f41c737c315b",
                        "glosses": [
                            "Teilnehmer an einem Marathon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ecf31a-c114-442e-81ff-3953ace3f261",
                                "sense_id": "a0777b2a-73e7-3b32-891a-f2cf73e639bf",
                                "text": "Die Marathonläufer erreichten erschöpft das Ziel."
                            },
                            {
                                "example_id": "7b380059-6a05-47a4-9c19-bcc03a902642",
                                "sense_id": "a0777b2a-73e7-3b32-891a-f2cf73e639bf",
                                "text": "„Der Kenianer ist Olympiasieger und einer der besten, wenn nicht der beste Marathonläufer der Geschichte.“"
                            },
                            {
                                "example_id": "78dfe17d-69c6-4711-a846-453764f56a53",
                                "sense_id": "a0777b2a-73e7-3b32-891a-f2cf73e639bf",
                                "text": "„Als Marathonläufer weiß ich, was es heißt, sich gezielt vorzubereiten, diszipliniert zu trainieren, konzentriert an den Start zu gehen und auch dann noch durchzuhalten, wenn es einmal schwerfällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
