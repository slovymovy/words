                        "examples": [
                            {
                                "example_id": "973beaa8-3fa5-4335-9ca3-ef8c330c970a",
                                "sense_id": "579e4f9f-86df-3461-ac72-1c2996c8753f",
                                "text": "La bulbiculture (ou culture de grossissement de bulbes) est une spécialité néerlandaise, les Pays-Bas étant le 1ᵉʳ producteur mondial et le 1ᵉʳ exportateur (...). En France la bulbiculture s'effectue principalement en Anjou (50% des surfaces)."
                            },
                            {
                                "example_id": "88b7762c-894e-4134-93b8-734a929e690e",
                                "sense_id": "579e4f9f-86df-3461-ac72-1c2996c8753f",
                                "text": "Les terrains sablonneux situés au pied des dunes de Hollande sont le domaine d'élection de la bulbiculture. Les Hollandais s'efforcent cependant d'étendre ailleurs la superficie bulbicole en déblayant des dunes."
                            }
                        ]
                    }
