                    "sense_id": "0e7cc2f7-71b4-37fa-9d1c-23d1e57ee82a",
                    "sense_definition": "Niet stelselmatig of regelmatig voorkomend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frequentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is zeker <w>incidenteel</w>, dus we hoeven het niet zwaar te bestraffen.",
                            "target_lang_translations": {
                                "it": "Questo è sicuramente <w>occasionale</w>, quindi non dobbiamo punirlo severamente."
                            }
                        },
                        {
                            "text": "Er zijn slechts <w>incidentele</w> gevallen van vertraging op deze route.",
                            "target_lang_translations": {
                                "it": "Ci sono solo <w>sporadici</w> casi di ritardo su questa tratta."
                            }
                        }
                    ],
                    "synonyms": [
                        "sporadisch",
                        "af en toe"
                    ],
                    "antonyms": [
                        "structureel",
                        "stelselmatig"
                    ],
                    "common_phrases": [
                        "incidentele gevallen"
                    ],
                    "target_lang_definitions": {
                        "it": "Che non avviene in modo sistematico o regolare; che accade solo di tanto in tanto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "occasionale",
                                "target_lang_sense_clarification": "Che accade di tanto in tanto, non regolarmente."
                            },
                            {
                                "target_lang_word": "sporadico",
                                "target_lang_sense_clarification": "Che si verifica raramente o in modo isolato."
                            },
                            {
                                "target_lang_word": "saltuario",
