                    {
                        "sense_id": "db575233-9044-3865-a23e-95ba28db448d",
                        "entry_id": "4581e6d1-019f-3709-8a23-1d9f9a9a6487",
                        "glosses": [
                            "Qui écrase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a59e3d8-6d36-478b-b141-c9a2e15e93d2",
                                "sense_id": "db575233-9044-3865-a23e-95ba28db448d",
                                "text": "Il convient alors de faire passer les matières épaillées, encore chaudes, dans une batterie écraseuse, sans quoi l'on s'expose à des mécomptes."
                            },
                            {
                                "example_id": "d70939ff-0d95-4748-890e-80bf7f11e0a4",
                                "sense_id": "db575233-9044-3865-a23e-95ba28db448d",
                                "text": "Le Bon Dieu ne permettrait pas... il mettrait une pierre devant la roue écraseuse, il verserait le chariot dans le fossé... Il y aurait un accident, un choc sauveur..."
                            }
                        ]
                    }
                ],
