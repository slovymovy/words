                ],
                "senses": [
                    {
                        "sense_id": "fd65861e-9e4c-357c-98d8-b06b2dcebcee",
                        "entry_id": "e26d56be-b94e-3aa7-9bfb-5d5cba351ea0",
                        "glosses": [
                            "Prominenter"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "766657a4-cb55-4ad1-92a4-aa1198ee436e",
                                "sense_id": "fd65861e-9e4c-357c-98d8-b06b2dcebcee",
                                "text": "Auf der Gala konnte man viele Promis sehen."
                            },
                            {
                                "example_id": "cf6572e8-be80-4338-82fc-2a50f3407b15",
                                "sense_id": "fd65861e-9e4c-357c-98d8-b06b2dcebcee",
                                "text": "„Der Promi sucht naturgemäß Kontakt zum Promi.“"
                            },
                            {
                                "example_id": "c76c2f7e-acde-4696-96b7-44be11baa8d5",
                                "sense_id": "fd65861e-9e4c-357c-98d8-b06b2dcebcee",
                                "text": "„Die Zeit war gekommen, dass ein Promi sich Sorgen macht um das viele Leid überall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a11ed1b-4908-4651-9dba-d683f9807f71",
                        "source_entry_id": "e26d56be-b94e-3aa7-9bfb-5d5cba351ea0",
                        "source_sense_id": "fd65861e-9e4c-357c-98d8-b06b2dcebcee",
                        "source_sense_description": "kurz für: Prominenter",
                        "target_lang_word": "celeb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celeb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5fcfb0b-2a9d-30d3-a855-63c516c327dc",
                                        "entry_id": "4afae452-93ee-3e6a-8709-424c516b13b8",
                                        "glosses": [
                                            "A celebrity; a famous person, a one who is celebrated."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ab7b4f-5a58-40f2-a509-b1ef9b0cb087",
                                                "sense_id": "a5fcfb0b-2a9d-30d3-a855-63c516c327dc",
                                                "text": "Just in case you thought celebs stay famous on their own, think again. There's a whole pack of people who help a star each day"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe2ff63-28c2-468f-96fa-0c79eb142b25",
                        "source_entry_id": "e26d56be-b94e-3aa7-9bfb-5d5cba351ea0",
                        "source_sense_id": "fd65861e-9e4c-357c-98d8-b06b2dcebcee",
                        "source_sense_description": "kurz für: Prominenter",
                        "target_lang_word": "célébrité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "célébrité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fa62f6a-6720-3d7e-8e64-1df1c47dc66e",
                                        "entry_id": "80998cf9-411c-353b-9cff-8923a06119a0",
                                        "glosses": [
                                            "Solennité d'une fête, d'un évènement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e11e34ea-8a1e-3a56-8d3f-1d96e01001b4",
                                        "entry_id": "80998cf9-411c-353b-9cff-8923a06119a0",
                                        "glosses": [
                                            "Réputation qui s’étend au loin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "024e1562-9a89-46fe-8311-8dce4fb4a73d",
                                                "sense_id": "e11e34ea-8a1e-3a56-8d3f-1d96e01001b4",
                                                "text": "Célébrité : l'avantage d'être connu de ceux que vous ne connaissez pas."
                                            },
                                            {
                                                "example_id": "ef7272e5-8d03-4dbf-894c-3b934c04a890",
                                                "sense_id": "e11e34ea-8a1e-3a56-8d3f-1d96e01001b4",
                                                "text": "Aucune période n’avait vu, avant les trente dernières années qui viennent de s’écouler, un aussi grand nombre d’individus parvenir, par toutes sortes de voies, à une célébrité spontanée."
                                            },
                                            {
                                                "example_id": "0a440c00-b2a4-4139-84c7-3bf79105ef7b",
                                                "sense_id": "e11e34ea-8a1e-3a56-8d3f-1d96e01001b4",
                                                "text": "[…], ils obtenaient les profits moraux et maté­riels que procure la célébrité à tous les virtuoses, dans une société qui est habituée à payer cher ce qui l'amuse."
                                            },
                                            {
                                                "example_id": "7281e5ee-8545-42a9-805f-9e7a88202fd0",
                                                "sense_id": "e11e34ea-8a1e-3a56-8d3f-1d96e01001b4",
                                                "text": "Dévoiler la Joconde ? C'est l'objectif lascif d'une équipe scientifique, associée au Louvre pour percer le mystère du sfumato, qui a fait la célébrité de Léonard de Vinci."
                                            },
                                            {
                                                "example_id": "bf44460d-1892-4273-85c9-be17259a474e",
                                                "sense_id": "e11e34ea-8a1e-3a56-8d3f-1d96e01001b4",
                                                "text": "Le chat persan complète ce portrait glamour et tendance, mais fait également ressortir des notions telles que la célébrité, la séduction ou le désir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7504edc-f0ca-31fb-ace4-17101e1da632",
                                        "entry_id": "80998cf9-411c-353b-9cff-8923a06119a0",
                                        "glosses": [
                                            "Personne célèbre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276a8a79-a122-47e9-ae95-d995a4feec73",
                                                "sense_id": "c7504edc-f0ca-31fb-ace4-17101e1da632",
                                                "text": "Cette âme généreuse était Mᵐᵉ Lancereaux, veuve du docteur Lancereaux, qui fut une célébrité médicale à Paris et était décédé en 1910. Elle s'intéressait particulièrement aux Ardennes en souvenir de son mari qui était né à Brécy-Brières."
                                            },
                                            {
                                                "example_id": "b7aaecb1-9527-42f9-bd2b-ced048aa948b",
                                                "sense_id": "c7504edc-f0ca-31fb-ace4-17101e1da632",
                                                "text": "En effet, en dehors des tossafistes, qui illustrèrent le rabbinat français au XIIᵉ et XIIIᵉ siècle, la famille de Raschi a fourni au judaïsme maintes célébrités."
                                            },
                                            {
                                                "example_id": "c713602e-dd4a-4b72-83ab-dfb5f33e55e6",
                                                "sense_id": "c7504edc-f0ca-31fb-ace4-17101e1da632",
                                                "text": "Élégante et raffinée, la station balnéaire bretonne aux accents british continue de séduire un monde de célébrités qui recherche avant tout la tranquillité et la discrétion que leur offrent les Dinardais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bccf4c3-9057-4f04-9475-b8eafea7159c",
                        "source_entry_id": "e26d56be-b94e-3aa7-9bfb-5d5cba351ea0",
                        "source_sense_id": "fd65861e-9e4c-357c-98d8-b06b2dcebcee",
