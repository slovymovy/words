                        "examples": [
                            {
                                "example_id": "9417c49e-90ef-45d5-8eef-46606e2f7015",
                                "sense_id": "5a032f0a-d891-30ff-a786-9ed6630a3fc5",
                                "text": "Some great examples we find in story , and their names are remembered in honour ; but we can make no judgment of them , but that their zeal was reprovable for its intemperance , though it had excellency in the matter of the passion"
                            },
                            {
                                "example_id": "e53cf8e6-aebc-4a4e-bae3-3bb3dd25f4e9",
                                "sense_id": "5a032f0a-d891-30ff-a786-9ed6630a3fc5",
                                "text": "Feeling hungry, she wanted to ask for food (an unthinkable action in conscious behavior) and so knocked on the door, but when nobody answered she entered the house (again a reprovable action) and saw a bearded man sitting in the single room."
                            }
                        ]
