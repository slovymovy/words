    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b97669ee-f166-310f-b682-2ca364804987",
                    "sense_definition": "A quick violent robbery of a person, usually in a public place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "robbery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There have been three <w>muggings</w> in this street in the past week.",
                            "target_lang_translations": {
                                "ru": "За последнюю неделю на этой улице произошло три <w>уличных ограбления</w>."
                            }
                        },
                        {
                            "text": "The police are trying to prevent street <w>mugging</w> by increasing patrols in the area.",
                            "target_lang_translations": {
                                "ru": "Полиция пытается предотвратить <w>уличные грабежи</w>, увеличивая патрулирование в этом районе."
                            }
                        }
                    ],
                    "synonyms": [
                        "robbery",
                        "assault"
                    ],
                    "common_phrases": [
                        "street mugging",
                        "victim of mugging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое уличное ограбление с применением насилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уличный грабёж",
                                "target_lang_sense_clarification": "нападение на улице с целью ограбления"
                            },
                            {
                                "target_lang_word": "разбойное нападение",
                                "target_lang_sense_clarification": "нападение с применением насилия"
                            },
                            {
                                "target_lang_word": "гоп-стоп",
                                "target_lang_sense_clarification": "жаргонное обозначение уличного грабежа"
                            }
                        ]
                    }
                }
            ]
        },
        {
