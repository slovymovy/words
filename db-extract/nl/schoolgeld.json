                                        "entry_id": "dda3779f-52ee-33b0-ae0c-3bdf4cbafb00",
                                        "glosses": [
                                            "The training or instruction provided by a teacher or tutor."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d82bfd2-45f0-4917-8842-b11714db9584",
                                                "sense_id": "9335abd9-13d7-3d9d-88ed-ed827afe88ce",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16.[…]There are no inspectors, no exams until the age of 18, no school league tables, no private tuition industry, no school uniforms. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e075ab4-9885-3403-9cf1-0801796e96ba",
                                        "entry_id": "dda3779f-52ee-33b0-ae0c-3bdf4cbafb00",
                                        "glosses": [
                                            "Paid private classes taken outside of formal education; tutoring. (also used attributively)"
                                        ],
                                        "tags": [
                                            "Australia",
                                            "India",
                                            "Malaysia",
                                            "Singapore",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3445d4e9-709d-4ec2-90ec-70d9edc49fd5",
                                                "sense_id": "4e075ab4-9885-3403-9cf1-0801796e96ba",
                                                "text": "tuition classes"
                                            },
                                            {
                                                "example_id": "157f9196-acd0-42f0-9c08-b34fe836aae7",
                                                "sense_id": "4e075ab4-9885-3403-9cf1-0801796e96ba",
                                                "text": "Tuition in the past was like taking medicine and you sent children for it only if they were doing poorly in a subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0ab8d1-a7e5-3aca-9144-b501f52c1de7",
                                        "entry_id": "dda3779f-52ee-33b0-ae0c-3bdf4cbafb00",
                                        "glosses": [
                                            "A sum of money paid for instruction (such as in a private school, boarding school, university, or college)."
                                        ],
