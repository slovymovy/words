                {
                    "sense_id": "c65de341-5eac-3c74-8821-aa061e7e4fe2",
                    "sense_definition": "In schijn, alsof het echt zo is maar in werkelijkheid niet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek me met een <w>quasi</w> boze blik aan, maar ik zag dat hij moest lachen.",
                            "target_lang_translations": {
