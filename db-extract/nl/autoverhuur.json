                        "glosses": [
                            "het tegen een financiële vergoeding voor een korte tijd beschikbaar stellen van een auto aan een huurder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2b30fe-1999-4db9-8bf4-d01376c50ced",
                                "sense_id": "57eda6fb-328e-3bad-a2ce-c7fa970bac94",
                                "text": "\"Het is een enorme puinhoop in Frankrijk\", zegt correspondent Frank Renout in het NOS Radio 1 Journaal. \"Mensen moeten alternatieven zoeken omdat ze de trein niet kunnen nemen. De autoverhuur piekt. Gisteravond ontstonden er al enorme files en de verwachting is dat dat vandaag ook gebeurt.\""
                            }
                        ]
                    },
