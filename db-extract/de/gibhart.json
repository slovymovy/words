                ],
                "senses": [
                    {
                        "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                        "entry_id": "b5b20297-4c78-391d-a522-9f76b4edaf94",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05965f5e-425d-4589-925c-d434da7a81f0",
                                "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                                "text": "Frau Gibhart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b2b043f3-dc40-4083-8802-a25d0eec4100",
                                "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                                "text": "Herr Gibhart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "551c8b0c-a5c2-46fd-88a0-4a2b82aebf78",
                                "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                                "text": "Die Gibharts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a16af611-3b9b-4562-8b5e-cd1a80a9a076",
                                "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                                "text": "Der Gibhart trägt nie die Schals, die die Gibhart ihm strickt."
                            },
                            {
                                "example_id": "ed8c911c-70cf-48db-874d-68aa60940c28",
                                "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gibhart kommt, geht der Herr Gibhart.“"
                            },
                            {
                                "example_id": "179eea39-6d3f-4ac4-bfef-a860f3e9b605",
                                "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                                "text": "Gibhart kommt und geht."
                            },
                            {
                                "example_id": "acbd56ac-a5c1-4918-8959-3a7db9988665",
                                "sense_id": "8690d05d-cbdd-38fb-a47d-8133423741b2",
                                "text": "Gibharts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
