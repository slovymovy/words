                ],
                "senses": [
                    {
                        "sense_id": "060b9af9-37d1-3cad-8ce8-a879332d2779",
                        "entry_id": "692a31f7-e871-37a7-989d-78b2d15e08fd",
                        "glosses": [
                            "The state of being alone; solitude, isolation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "54f46a82-d77c-4593-959a-1affe954672f",
                                "sense_id": "060b9af9-37d1-3cad-8ce8-a879332d2779",
                                "text": "Suddenly, [...] he saw all this as romantic — the last legionary, his aloneness, the lost cause really lost — and instinctively he pulled in his paunch, stroked down his hair to cover the naked part of the scalp, and wiped the sweat off his cheeks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f485073-a4c6-4eb1-97fd-28f21732ab58",
                        "source_entry_id": "692a31f7-e871-37a7-989d-78b2d15e08fd",
                        "source_sense_id": "060b9af9-37d1-3cad-8ce8-a879332d2779",
                        "source_sense_description": "the state of being alone",
                        "target_lang_word": "Alleinsein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alleinsein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                                        "entry_id": "aa48b730-d8e1-3d6c-8ed5-9c252478247b",
                                        "glosses": [
                                            "Zustand, in dem jemand für sich allein oder zumindest keine unerwünschte Person anwesend ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf10eeb-7f4e-4b38-8e9c-6791bfb54c79",
                                                "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                                                "text": "„In Wahrheit aber lag ihr weniger an dem Arzt als an einem Alleinsein und einer Aussprache mit dem geliebten Kinde.“"
                                            },
                                            {
                                                "example_id": "cc1e7659-433e-4c16-a70d-8386022d8613",
                                                "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                                                "text": "„Sie hatte die Nacht in dem vollen Schlafsaal mit den vierzig bis fünfzig Kameradinnen wie immer zubringen müssen, statt endlich einmal das Alleinsein zu genießen.“"
                                            },
                                            {
                                                "example_id": "44641831-8bc7-4c16-869a-746d73d22e71",
                                                "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                                                "text": "„Ich konnte das Alleinsein nicht mehr ertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61a81afc-0db7-489a-864f-6b2cc4ccd0e4",
                        "source_entry_id": "692a31f7-e871-37a7-989d-78b2d15e08fd",
