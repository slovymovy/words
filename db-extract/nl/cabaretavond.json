                    {
                        "sense_id": "f93e1da6-ca74-386b-b418-3475b2b6a01e",
                        "entry_id": "e55ecf0a-11fa-3a76-9a03-c20726ab90b1",
                        "glosses": [
                            "een avond met kleinkunstoptredens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1067bc32-fae3-49a4-a3bd-b2e4a255682d",
                                "sense_id": "f93e1da6-ca74-386b-b418-3475b2b6a01e",
                                "text": "Youp van 't Hek wil nu geen vragen van de NOS beantwoorden over Flappie: \"Met auteursrechten houdt Youp zich helemaal niet bezig\", zegt het management. In een eerder interview vertelde hij verslaggever Jeroen Schutijser: \"Flappie is geschreven voor mijn zusje. Ze had een cabaretavond. Ik zei tegen mijn zusje: het kan overal over gaan, ook over je kerstkonijn. En toen heb ik het liedje geschreven. Een vriendinnetje van haar zong het en toen werd die zaal afgebroken. Toen dacht ik: dit ga ik in mijn eigen cabaretje halen.\""
                            },
                            {
                                "example_id": "f405f4e6-4c55-43b7-a65f-fee098659baa",
                                "sense_id": "f93e1da6-ca74-386b-b418-3475b2b6a01e",
                                "text": "Wederom kregen we gisteravond een smakelijke cabaretavond voorgeschoteld en werden we als kijker gedwongen te kiezen. Op Nederland 1 konden we Jochem Myjer bewonderen met zijn voorstelling De Rust Zelve. Op RTL4 zagen we Brigitte Kaandorp met haar show Cabaret voor Beginners. And the winner is? Brigitte Kaandorp!"
                            }
                        ]
                    }
