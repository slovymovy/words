                "translations": [
                    {
                        "translation_id": "c120e39b-67d8-4460-8ff4-8bf007e98008",
                        "source_entry_id": "4f657f09-7733-3469-ae42-3485f5fea7ad",
                        "source_sense_id": "d4c60de3-a7b7-3d33-a833-df9cd774f4c2",
                        "target_lang_word": "Potemkin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Potemkin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce51a968-c51a-3e04-8c61-4b507b064841",
                                        "entry_id": "9c138628-6af5-3227-944d-a26f67f14de2",
                                        "glosses": [
                                            "A transliteration of the Russian surname Потёмкин (Potjómkin)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a30db16-be93-31b2-bd0e-2b13241f4a8c",
                                        "entry_id": "9c138628-6af5-3227-944d-a26f67f14de2",
                                        "glosses": [
                                            "Resembling a Potemkin village; fake, facade."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "093ab204-867b-4f5b-b9d1-38523a1153bc",
                                                "sense_id": "5a30db16-be93-31b2-bd0e-2b13241f4a8c",
                                                "text": "These Potemkin demonstrations depict a universe of happy devices, all seamlessly interoperating, tossing media back and forth to one another in a superbly orchestrated fashion."
                                            },
                                            {
                                                "example_id": "d1aa0f09-e2d1-4a4b-9bae-a1a97f2c3539",
                                                "sense_id": "5a30db16-be93-31b2-bd0e-2b13241f4a8c",
                                                "text": "After more than a year of denial that they even existed, the Chinese Communist Party at last admitted, last fall, that it was holding people in camps in Xinjiang. It describes these as “reeducation” camps focused on potential terrorists or job training and takes carefully selected groups on Potemkin tours to visit them."
                                            },
                                            {
                                                "example_id": "3741bc50-7804-46e9-b595-0e9dfcddb67a",
                                                "sense_id": "5a30db16-be93-31b2-bd0e-2b13241f4a8c",
                                                "text": "President Emmanuel Macron vowed an economic revival, but as he seeks re-election, a Potemkin factory in the town where he was raised shows just how hard that can be."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
