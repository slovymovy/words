                ],
                "senses": [
                    {
                        "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                        "entry_id": "b4e15cea-016e-3162-94f9-2abf563144f0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570e82f8-a0c0-4a42-b728-2a587fd278ec",
                                "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                                "text": "Frau Kümmerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fbbb354b-3dbf-4b34-8c1c-67a4a07bc51e",
                                "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                                "text": "Herr Kümmerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f37ab6dd-693a-4ddd-b5d6-eb457ca6fcca",
                                "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                                "text": "Die Kümmerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3517ec4a-b5a0-4d15-b5be-3fc9ee8181da",
                                "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                                "text": "Der Kümmerle trägt nie die Schals, die die Kümmerle ihm strickt."
                            },
                            {
                                "example_id": "8e67fd53-6334-4971-bcef-70f36e914ed8",
                                "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kümmerle kommt, geht der Herr Kümmerle.“"
                            },
                            {
                                "example_id": "2bb3fe60-a79b-4bda-a524-7151ba2a1b8a",
                                "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                                "text": "Kümmerle kommt und geht."
                            },
                            {
                                "example_id": "1898db5a-6717-4849-ba63-2fe47c6f313e",
                                "sense_id": "bcf3c40d-334e-315d-8385-6783e68d74de",
                                "text": "Kümmerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
