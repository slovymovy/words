                                        "entry_id": "b17fdb9e-ba9a-397b-aa1e-ba1045de8bd5",
                                        "glosses": [
                                            "Angry; upset; severely annoyed."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cea7a457-d8a7-4217-acd1-16b210ce5a5c",
                                                "sense_id": "4e300eab-2f40-328d-9d8b-6e30925b8fd3",
                                                "text": "Terrific fun it was. My best mate saved me, and the teacher was filthy."
                                            }
                                        ]
