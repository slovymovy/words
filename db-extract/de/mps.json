                        "sense_id": "26aa12a5-82ac-3c37-af9e-7d8af4c057a0",
                        "entry_id": "4be50c98-d657-3a15-864f-cbb721e4f7db",
                        "glosses": [
                            "Max-Planck-Institut für Sonnensystemforschung"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "7dd467b2-744a-4db3-9fb1-3099397f6ef8",
                                "sense_id": "26aa12a5-82ac-3c37-af9e-7d8af4c057a0",
                                "text": "Die Planetenforscher untersuchen seither den planetaren Zwerg mithilfe der Bordkameras vom Göttinger Max-Planck-Institut für Sonnensystemforschung (MPS)."
                            },
                            {
                                "example_id": "16d5bb17-a64f-4a7e-934e-e41ebbfe2db1",
                                "sense_id": "26aa12a5-82ac-3c37-af9e-7d8af4c057a0",
                                "text": "„Damit hatten wir nicht gerechnet“, sag MPS-Astronom Martin Hoffmann, der die Fotos eingehend analysierte.1"
                            },
                            {
                                "example_id": "faf0cde3-fe89-4d66-8209-0dc9f835e76a",
                                "sense_id": "26aa12a5-82ac-3c37-af9e-7d8af4c057a0",
                                "text": "Wissenschaftler der Universität von Alberta (Kanada) und des MPS nutzten umfangreiche Computersimulationen für ihre Forschungen, über die sie jetzt in der Fachzeitschrift \"Nature Geoscience\" berichten."
                            }
                        ],
                        "sense_index_json": "\"1\""
