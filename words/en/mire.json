{
    "word_family": [
        "miry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02caa7e0-1f2e-3ee8-8ea3-8c4617063605",
                    "sense_definition": "Deep, soft, or wet mud.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy truck got stuck in the deep <w>mire</w> after the storm.",
                            "target_lang_translations": {
                                "ru": "После бури тяжелый грузовик застрял в глубокой <w>грязи</w>."
                            }
                        },
                        {
                            "text": "Walking through the <w>mire</w> ruined my new leather boots.",
                            "target_lang_translations": {
                                "ru": "Прогулка по <w>грязи</w> испортила мои новые кожаные сапоги."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокая, мягкая или вязкая грязь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "глубокая, вязкая масса"
                            },
                            {
                                "target_lang_word": "топь",
                                "target_lang_sense_clarification": "вязкое, труднопроходимое место"
                            },
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "топкое, засасывающее место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d7e1374-1007-37f0-982a-438e81400ee1",
                    "sense_definition": "A wetland area, such as a bog or fen, where peat is actively forming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers studied the carbon emissions from the northern <w>mire</w>.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили выбросы углерода из северного <w>болота</w>."
                            }
                        },
                        {
                            "text": "Many rare plants grow only in the acidic soil of a <w>mire</w>.",
                            "target_lang_translations": {
                                "ru": "Многие редкие растения растут только на кислой почве <w>болот</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "peatland",
                        "quag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заболоченная местность, болото, где активно образуется торф."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болото",
                                "target_lang_sense_clarification": "торфяник, топкое место"
                            },
                            {
                                "target_lang_word": "топь",
                                "target_lang_sense_clarification": "болотистая местность"
                            },
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "топкое болото"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d84fb789-5573-3d3b-9d95-a1edbf090bce",
                    "sense_definition": "A difficult or unpleasant situation that is hard to escape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is struggling to pull itself out of a financial <w>mire</w>.",
                            "target_lang_translations": {
                                "ru": "Компания изо всех сил пытается выбраться из финансовой <w>трясины</w>."
                            }
                        },
                        {
                            "text": "Political scandals have dragged the entire administration into a deep <w>mire</w>.",
                            "target_lang_translations": {
                                "ru": "Политические скандалы затянули всю администрацию в глубокое <w>болото</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "into the mire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложная или неприятная ситуация, из которой трудно выбраться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "перен. обстановка бесперспективности или застоя"
                            },
                            {
                                "target_lang_word": "болото",
                                "target_lang_sense_clarification": "перен. вязкая, неприятная ситуация"
                            },
                            {
                                "target_lang_word": "омут",
                                "target_lang_sense_clarification": "перен. пучина проблем или неприятностей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b06bec44-540f-37b3-a723-2218024c3178",
                    "sense_definition": "To cause someone or something to become stuck in mud.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain will <w>mire</w> the vehicles on the dirt road.",
                            "target_lang_translations": {
                                "ru": "Проливной дождь <w>затянет</w> машины в грязь на грунтовой дороге."
                            }
                        },
                        {
                            "text": "Do not <w>mire</w> the wagon in the soft ground near the river.",
                            "target_lang_translations": {
                                "ru": "Смотри, чтобы повозка не <w>завязла</w> в мягкой почве у реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemire",
                        "enmire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить к застреванию кого-либо или чего-либо в грязи или болоте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засасывать",
                                "target_lang_sense_clarification": "о трясине, грязи"
                            },
                            {
                                "target_lang_word": "затягивать",
                                "target_lang_sense_clarification": "в грязь или топь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e65e99ec-7369-3bb4-b2aa-90fea90e9f68",
                    "sense_definition": "To weigh down or hinder progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bureaucratic delays continue to <w>mire</w> the project in endless paperwork.",
                            "target_lang_translations": {
                                "ru": "Бюрократические проволочки продолжают <w>топить</w> проект в бесконечной бумажной волоките."
                            }
                        },
                        {
                            "text": "The legal dispute will <w>mire</w> the company for several years.",
                            "target_lang_translations": {
                                "ru": "Судебный спор <w>свяжет руки</w> компании на несколько лет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тормозить развитие, обременять или препятствовать прогрессу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затягивать",
                                "target_lang_sense_clarification": "вовлекать в трудную ситуацию, мешая прогрессу"
                            },
                            {
                                "target_lang_word": "погрязнуть",
                                "target_lang_sense_clarification": "оказываться связанным трудностями (в страд. значении)"
                            },
                            {
                                "target_lang_word": "сковывать",
                                "target_lang_sense_clarification": "мешать развитию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "02b4871d-55a3-3a96-b549-52ab873b4b1e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by Dr. <w>Mire</w>.",
                            "target_lang_translations": {
                                "ru": "Исследовательская статья была написана доктором <w>Майром</w>."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Mire</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции я встретил человека по фамилии мистер <w>Майр</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Майр",
                                "target_lang_sense_clarification": "фамилия"
                            },
                            {
                                "target_lang_word": "Мир",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}