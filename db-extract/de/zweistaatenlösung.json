                "senses": [
                    {
                        "sense_id": "fdbef029-abe4-31b6-83b4-79c5a9ef2420",
                        "entry_id": "bf17d10c-cb17-3c50-960e-4ce1698aea16",
                        "glosses": [
                            "Gründung eines autonomen Palästinenserstaates, der den Gaza-Streifen und das Westjordanland umfasst, als mögliche Lösung des Nahostkonflikts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f0bd34-23de-413f-98f8-ae05c479717c",
                                "sense_id": "fdbef029-abe4-31b6-83b4-79c5a9ef2420",
                                "text": "„Seit Abbas den Schulterschluss mit Hamas sucht, glauben 95 Prozent der Israelis nicht mehr an eine Zweistaatenlösung.“"
                            },
                            {
                                "example_id": "f8dc17a4-df65-4752-8550-846f7fe7d9c9",
                                "sense_id": "fdbef029-abe4-31b6-83b4-79c5a9ef2420",
                                "text": "„Die Mehrheit der Israelis zieht zwar die Zweistaatenlösung einer Einstaatenlösung vor. So recht an einen Frieden glauben will man aber spätestens seit dem Gaza-Abzug 2005 nicht mehr.“"
                            },
                            {
                                "example_id": "a901699b-0890-4836-9eee-150a5bdcdd3c",
                                "sense_id": "fdbef029-abe4-31b6-83b4-79c5a9ef2420",
                                "text": "„Bereits im Wahlkampf hatte der Amerikaner den israelischen Hardlinern Avancen gemacht – den Siedlungsbau unterstützt und sich gegen eine Zweistaatenlösung ausgesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c728d9d7-8b11-4124-8d6e-75d2eb35626b",
                        "source_entry_id": "bf17d10c-cb17-3c50-960e-4ce1698aea16",
