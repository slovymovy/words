                    }
                ],
                "senses": [
                    {
                        "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                        "entry_id": "96b9fc31-4b79-30c5-bc7f-42a07f8c3e81",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117202cf-d256-4c12-8509-11f845b1c244",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "Frau Stabe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "af2fa2f2-c5fa-4002-a21f-34ab4c7546cc",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "Herr Stabe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "064be45e-5922-433d-9936-ed60a86eed8a",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "Die Stabes kommen heute aus Heidelberg."
                            },
                            {
                                "example_id": "fe9792d1-9478-46ba-b022-a363e74b8d62",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "Der Stabe trägt nie die Schals, die die Stabe ihm strickt."
                            },
                            {
                                "example_id": "5d055285-c940-4e87-9e65-c895ff449e38",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stabe kommt, geht der Herr Stabe.“"
                            },
                            {
                                "example_id": "d8b7c089-aa7c-4492-b1fb-672fd44a29f6",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "Stabe kommt und geht."
                            },
                            {
                                "example_id": "1fb78d47-ec19-49e1-bde1-e75c378274cf",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "Stabes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "22196ef6-2770-4a65-be29-9fe6da52e25b",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "An verregneten Herbsttagen ist Familie Stabes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "6f1983aa-4426-4d20-a296-2c6b99df976e",
                                "sense_id": "37b31e23-f884-3946-a361-e5d24f08be02",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Stabe das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
