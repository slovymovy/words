                ],
                "senses": [
                    {
                        "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                        "entry_id": "e8d7d1f7-5c79-3530-aada-46ae0e5ffb13",
                        "glosses": [
                            "Insigne"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dea9a654-0dd3-4e4c-be4d-166980c9dfa0",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Aus dieser Insignie dürfte sich die Ferula als Herrscherstab der Päpste entwickelt haben.“"
                            },
                            {
                                "example_id": "f3acfef5-7034-4a98-bf3c-8709ae7557ea",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Weniger bekannt ist, dass auch Präsidenten und Rektoren von Universitäten eine Kette als Insignie tragen.“"
                            },
                            {
                                "example_id": "aaddd72b-ee6c-4847-9973-fe7e9fc78654",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Nach Macrobius (Sat. I 6, 9) war die praetexta, ehe sie die Knaben übernahmen, eine Insignie der Beamten, die bulla dagegen der Triumphatoren, die sie ihrerseits von den Königen übernommen hätten.“"
                            },
                            {
                                "example_id": "96b9625f-279a-4d09-bd69-938aeec99de8",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Daneben stellt sich die ganz allgemeine Frage: Was bringt die Insignie als Quelle dem Historiker?“"
                            },
                            {
                                "example_id": "1dcca732-6e71-42f3-b469-8e190174f84f",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Man wird dieses Phänomen wohl nur damit erklären können, daß Konstantin die neue Insignie bald nach 315 in den Hintergrund gestellt hat.“"
                            },
                            {
                                "example_id": "4a139a93-6c60-45b7-b32d-e91a2585157c",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Ein Helm als Insignie der Vorherrschaft - das ist neu und ziemlich albern.“"
                            },
                            {
                                "example_id": "6b37d627-b29c-4e2a-bc00-6c3b16d8db78",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Insignie seines Daseins ist die alte Schreibmaschine, die er nachts an den Bettpfosten kettet, damit sie ihm nicht im Schlaf gestohlen wird.“"
                            },
                            {
                                "example_id": "76daded7-c3cc-4751-acb0-015ae9052b60",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„An dem aus Silber getriebenen Sockel, auf dem ein den Himmel(sglobus) tragender Herkules steht, findet sich eine englische, erstmals 1661 benützte, Krone – samt der Insignie des Hosenbandordens (noch heute der höchste Orden des Vereinigten Königreichs) und ein darin eingraviertes Jakobskreuz.“"
                            },
                            {
                                "example_id": "62035dda-9d4e-4116-b5c0-94abf196cf7a",
                                "sense_id": "1aad1e38-e380-3b29-a3e3-f2a11eea5c79",
                                "text": "„Alexander der Große soll ihn von seinen Feldzügen aus Kasachstan mitgebracht haben, von dort schlich er sich in die griechische Mythologie, in germanische Sagen und deutsche Märchen, er fand seinen fixen Platz in Schweizer Heldenmythen, märchenhaften Erweckungsmomenten und Paradiesvertreibungen, er wurde zur Insignie diverser Kaiser, zum Spitznamen der vielleicht tollsten Stadt der Welt und zum Firmenzeichen des zweitprofitabelsten Computerkonzerns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
