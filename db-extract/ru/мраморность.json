                        "glosses": [
                            "свойство или состояние по значению прилагательного мраморный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c9a904-2c97-470c-b045-af8a52df3e42",
                                "sense_id": "7ae05e7d-f40e-39e3-986c-43faf5f4eb85",
                                "text": "Мраморность этого камня выделяет его среди других материалов для строительства."
                            },
                            {
                                "example_id": "0afe0026-8073-423b-abe8-aec99dabc2a3",
                                "sense_id": "7ae05e7d-f40e-39e3-986c-43faf5f4eb85",
                                "text": "Воздушность стана, мраморность лица, при сильной, точно накрашенной, алости прелестного рта, льдистая синева глаз и сказочно обильные пепельно-золотые кудри, в которые можно было завернуться, как в покрывало."
                            }
                        ]
                    }
