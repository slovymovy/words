                "senses": [
                    {
                        "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                        "entry_id": "5b75dead-be72-3c8c-ab93-72e5a5ebac76",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4a9ce5-0541-45cf-9b87-a7356f9da080",
                                "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                                "text": "Frau Deinhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "14fc23ff-1934-4198-8d16-640ff73cc22f",
                                "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                                "text": "Herr Deinhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2befffbc-83c3-40aa-ac0d-6e7fb92c73d2",
                                "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                                "text": "Die Deinhardts fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "5df25439-bc27-4488-9df0-f009e2cc24ad",
                                "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                                "text": "Der Deinhardt trägt nie die Pullover, die die Deinhardt ihm strickt."
                            },
                            {
                                "example_id": "d0a71fef-266b-4d2c-bf40-1a5d6f20b6fe",
                                "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Deinhardt kommt, geht der Herr Deinhardt.“"
                            },
                            {
                                "example_id": "97e06828-dbd8-4143-96e3-c4b4dd7dc618",
                                "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                                "text": "Deinhardt kommt und geht."
                            },
                            {
                                "example_id": "2f176942-4216-425c-9002-26eab01a08c8",
                                "sense_id": "8f9c73f2-a079-3dc0-b8f1-63c5ea908dff",
                                "text": "Deinhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
