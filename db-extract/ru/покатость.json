                "senses": [
                    {
                        "sense_id": "52749e54-746a-3012-a5df-dae9bc13d325",
                        "entry_id": "a13f867a-7528-3b84-bc91-713293f2a78f",
                        "glosses": [
                            "свойство по значению прилагательного покатый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e3c0054-3f27-4401-89f4-98cf6aac0902",
                                "sense_id": "52749e54-746a-3012-a5df-dae9bc13d325",
                                "text": "Он был в военной форме, и погоны придавали его плечам какую-то неестественную покатость."
                            }
                        ]
                    },
                    {
                        "sense_id": "7614575a-063c-3c59-91c2-a661cd9260e9",
                        "entry_id": "a13f867a-7528-3b84-bc91-713293f2a78f",
                        "glosses": [
                            "покатая поверхность, пологий спуск"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff74bb03-cc9c-4937-9c8f-de8392996e07",
                                "sense_id": "7614575a-063c-3c59-91c2-a661cd9260e9",
                                "text": "Ровная покатость, по которой мне до сих пор приходилось бежать, перешла в низменное водянистое болото, поросшее редким сосновым лесом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9139e5cc-08bc-4da8-a2ce-af821f056b33",
                        "source_entry_id": "a13f867a-7528-3b84-bc91-713293f2a78f",
                        "source_sense_description": "свойство",
                        "target_lang_word": "declivity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "declivity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                        "entry_id": "60906004-a597-3507-b0e1-15077517e294",
                                        "glosses": [
                                            "The downward slope of a curve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d076848-5f7c-479c-b510-892faed6955e",
                                                "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                                "text": "The Declivity was ſo ſmall, that I walked near a mile before I got to the Shore, which I conjectur'd was about eight a-clock in the Evening."
                                            },
                                            {
                                                "example_id": "fc50b1d3-2994-4826-baaf-4aeca388c34c",
                                                "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                                "text": "1780, Theodore Augustine Mann, A Treatise on Rivers and Canals, Philosophical Transactions of the Royal Society of London, Volume 69: For the Year 1779, Part II, 582,\nThe velocity of flowing waters is very far from being in proportion to the quantity of declivity in their bed: […] ."
                                            },
                                            {
                                                "example_id": "a08d17bc-648f-45d5-9a41-57b8bea34187",
                                                "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                                "text": "[…]whoever takes the trouble of observing how the water runs longitudinally in the ruts on a convex road, although the declivity down the sides be incomparably greater than in the direction which it is compelled to take in the ruts, will soon see the propriety of constructing roads so as to have the water rim length-ways upon them, instead of attempting to gain a declivity, by making it run from the middle to the sides."
                                            },
                                            {
                                                "example_id": "b514352b-c162-458e-b5fc-e357d39d3490",
                                                "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                                "text": "[…]a line was measured down the hill on the right of 420, and the angle of declivity is 23°, which shortens the line 33 links;[…]."
                                            },
                                            {
                                                "example_id": "0662e726-eb1d-40e6-b39c-59804fd00041",
                                                "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                                "text": "A rocky cliff appeared, mounds of turned–up earth by the shore, houses on a hill, others with iron roofs, amongst a waste of excavations, or hanging to the declivity."
                                            },
                                            {
                                                "example_id": "7b29e578-d158-4390-a2a2-1f0c9dd431d6",
                                                "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                                "text": "1908 [Charles Griffin & Company], John Harvard Biles, The Design and Construction of Ships, Volume I: Calculations and Strength, 2009, Europāischer Hochschulverlag (Salzwasser-Verlag), page 216,\nThe declivity of the keel blocks varies slightly with the size of the vessel. The larger the vessel, the less the declivity."
                                            },
                                            {
                                                "example_id": "6af764fa-af47-4136-bcde-4588f9b6dc0c",
                                                "sense_id": "9416f52d-e629-3198-8595-6dab53c09e4a",
                                                "text": "Companion woodcut of \"inclined plane on the railway from South Hetton to Seaham Harbour, showing the manner in which a loaded train of waggons pulls an empty one up the declivity\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b88070-de98-3906-bbf3-f57a791c2eaf",
                                        "entry_id": "60906004-a597-3507-b0e1-15077517e294",
                                        "glosses": [
                                            "A downward bend in a path."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dfc97a4-a8b4-3171-b6a8-c918f4ed3589",
                                        "entry_id": "60906004-a597-3507-b0e1-15077517e294",
                                        "glosses": [
                                            "An inward curve of the exoskeleton of an insect, such as between body segments; a segment of an insect's body where the exoskeleton curves inward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9621957-b365-420c-b856-361e19125040",
                                                "sense_id": "8dfc97a4-a8b4-3171-b6a8-c918f4ed3589",
                                                "text": "1979, Entomology Circular, Issue 200, Part 366, Division of Plant Industry, page number not shown,\nMales of all species have more developed armature of the elytral declivity than females (Figs. S, 6, 8, 9, 11-14)."
                                            },
                                            {
                                                "example_id": "21f68f68-7c2e-4ec7-824d-4616845efa31",
                                                "sense_id": "8dfc97a4-a8b4-3171-b6a8-c918f4ed3589",
                                                "text": "Propodeum in profile with upper lobe of declivity elongate and narrow, subspiniform, almost as long as lower lobe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
