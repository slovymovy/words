                "senses": [
                    {
                        "sense_id": "6c3291e1-c982-3af9-bef9-173a195e062a",
                        "entry_id": "5ff9bb3c-b874-386b-b414-3b00328fe481",
                        "glosses": [
                            "The sharp, atonal sound of a liquid or soft solid hitting a solid surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c060006-d05a-4f83-b6a9-6ea09259354d",
                                "sense_id": "6c3291e1-c982-3af9-bef9-173a195e062a",
                                "text": "I didn't see the egg fall, but I heard the splat when it hit the floor."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2be5e52-95d6-3109-ac00-d2b359b67bb9",
                        "entry_id": "5ff9bb3c-b874-386b-b414-3b00328fe481",
                        "glosses": [
                            "The irregular shape of a viscous liquid or soft solid which has hit a solid surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20df772d-872a-4f59-b0b2-fb363e801ef0",
                                "sense_id": "c2be5e52-95d6-3109-ac00-d2b359b67bb9",
                                "text": "The canvas was covered by seemingly careless splats of paint."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e2338fb-01c1-3c7d-a4f0-4f444c8cd180",
