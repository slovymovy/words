                    },
                    {
                        "translation_id": "fd823299-c313-4b92-8f5e-311a00a5f35a",
                        "source_entry_id": "9630ac6c-46eb-31e8-af51-42d6e3e67417",
                        "source_sense_id": "291468de-a9ca-323e-9b9a-3a3d0b24c459",
                        "target_lang_word": "tenement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "371686da-4db4-3739-ad1d-388995f01a4c",
                                        "entry_id": "c6ae7bc4-90bc-3afc-a462-584b26a80541",
                                        "glosses": [
                                            "A building that is rented to multiple tenants, especially a low-rent, run-down one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03446eb9-9989-4e1d-ab3d-22590dc89740",
                                                "sense_id": "371686da-4db4-3739-ad1d-388995f01a4c",
                                                "text": "He turned into Cumberland street and, going on some paces, halted in the lee of the station wall. No-one. Meade’s timberyard. Piled balks. Ruins and tenements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689991d3-9bef-3dd6-b092-7eece8383160",
                                        "entry_id": "c6ae7bc4-90bc-3afc-a462-584b26a80541",
                                        "glosses": [
                                            "Any form of property that is held by one person from another, rather than being owned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ade143e-63d9-4db4-a542-68c096a42ad7",
                                                "sense_id": "689991d3-9bef-3dd6-b092-7eece8383160",
                                                "text": "The island of Brecqhou is a tenement of Sark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26c8d89-212f-3f16-b50f-558153ec7c91",
                                        "entry_id": "c6ae7bc4-90bc-3afc-a462-584b26a80541",
                                        "glosses": [
                                            "A dwelling; abode; habitation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c7f56c-5710-4ce2-b851-9215ee3b35be",
                                                "sense_id": "f26c8d89-212f-3f16-b50f-558153ec7c91",
                                                "text": "Who has informed us that a rational soul can inhabit no tenement, unless it has just such a sort of frontispiece?"
                                            },
                                            {
                                                "example_id": "a588c955-f650-4c20-858f-cba9bb6998fa",
                                                "sense_id": "f26c8d89-212f-3f16-b50f-558153ec7c91",
                                                "text": "Where she came from no man could tell. There were some said she was no woman, but a ghost haunting some mortal tenement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
