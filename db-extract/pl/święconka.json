                        "entry_id": "f8d58c89-140c-3a79-98f8-0d4a8fa2da3e",
                        "glosses": [
                            "traditional Polish Easter celebration where baskets full of Easter food are blessed"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "5896ae15-b014-4608-8cad-8d670a709989",
                                "sense_id": "1a325764-2997-3d68-8cb1-e710ce16b7d1",
                                "text": "Lat temu dziesięć, lub może dużo dawniej, do kościoła ze święconką szły dwie małe dziewczynki (same lub z nianią), po uprzedniej zażartej kłótni, która z nas ma nieść koszyczek.",
                                "translation": "Ten years ago, or perhaps many more, two little girls (alone or with their nanny) were walking to church with their Easter basket meal after a prior heated argument about who was supposed to carry the basket.",
                                "english": "Ten years ago, or perhaps many more, two little girls (alone or with their nanny) were walking to church with their Easter basket meal after a prior heated argument about who was supposed to carry the basket."
                            }
                        ]
