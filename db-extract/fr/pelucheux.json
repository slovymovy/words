                ],
                "senses": [
                    {
                        "sense_id": "effd8671-2701-3563-a956-077cfb5d78a8",
                        "entry_id": "6168a930-9e51-3e7d-8390-5b6b46729801",
                        "glosses": [
                            "Qui donne au toucher la sensation de la peluche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e5153e-72c7-4ace-a744-d8b06dab8a67",
                                "sense_id": "effd8671-2701-3563-a956-077cfb5d78a8",
                                "text": "Ce volume, petit in-32, semblable à un Annuaire du Bureau des Longitudes, est recouvert de drap pelucheux comme un bréviaire de chanoine."
                            },
                            {
                                "example_id": "edc9686a-4f82-4a3f-a97b-749d2bf9d78d",
                                "sense_id": "effd8671-2701-3563-a956-077cfb5d78a8",
                                "text": "Des hommes au bonnet pelucheux."
                            },
                            {
                                "example_id": "4f662f56-2e39-41fa-8d92-979bb39fa878",
                                "sense_id": "effd8671-2701-3563-a956-077cfb5d78a8",
                                "text": "Alors Simon prit son porte-plume, et, son crâne blanc penché sur le papier pelucheux de court format, grossièrement ligné, il écrivit : […]"
                            },
                            {
                                "example_id": "20b25022-d2f8-4946-a84a-77c7a8b14c94",
                                "sense_id": "effd8671-2701-3563-a956-077cfb5d78a8",
                                "text": "Oui, la tragédie des espadrilles mouillées, avec ce nœud pelucheux qui s’ébouriffe juste au coin, cette raideur de la semelle ankylosée, cette hostilité coupante du tissu."
                            }
                        ]
                    }
                ],
