                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01558a4-99ba-4ac7-9b28-3fb7a034a4bb",
                                "sense_id": "818ccfa0-464d-3555-9ff1-86e8f61ee51f",
                                "text": "„Ferris wusste genau, dass diese Jovialität beiderseits nichts als Verzögerungstaktik war, bevor sie endlich auf den Grund zu sprechen kamen, weshalb Hoffman von Washington hierhergereist war.“"
                            },
                            {
                                "example_id": "888c8243-1d18-49b9-927d-3fb6851ae501",
                                "sense_id": "818ccfa0-464d-3555-9ff1-86e8f61ee51f",
                                "text": "„Während dieser ganzen Zeit setzte Goldberg seine Verzögerungstaktik fort.“"
                            }
                        ],
