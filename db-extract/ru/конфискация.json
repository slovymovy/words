                "senses": [
                    {
                        "sense_id": "0152f572-caaa-3b9c-a01f-270ed0d95fe4",
                        "entry_id": "10f29310-0363-3a8e-8c07-59a8ea72cd16",
                        "glosses": [
                            "действие по значению гл. конфисковать; принудительное и безвозмездное изъятие в собственность государства по постановлению судебной власти всего или части имущества"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "13656d45-874c-32bd-b7e8-5b3a6870d279",
                        "entry_id": "10f29310-0363-3a8e-8c07-59a8ea72cd16",
                        "glosses": [
                            "изъятие из обращения по решению власти печатной продукции"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c56d1af3-d8fa-4b64-b992-22bae500830d",
                        "source_entry_id": "10f29310-0363-3a8e-8c07-59a8ea72cd16",
                        "source_sense_description": "действие по значению гл. конфисковать",
                        "target_lang_word": "Konfiskation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfiskation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                        "entry_id": "e9e6dd43-4b65-3c1d-8c3c-692c3675addb",
                                        "glosses": [
                                            "amtliche Beschlagnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dfb69a3-472c-4a60-b55e-ffe69e2649a8",
                                                "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                                "text": "„Es handelte sich um Darstellungen höchst unanständiger Szenen von Leda mit dem Schwan, von Pan und den Nymphen, von Susanna im Bade und ähnlichen Sachen, die schon längst zur Konfiskation der Bibel, der Mythologie und der gesamten Kunstgeschichte hätte führen müssen, wenn sich alles nach der Berliner Polizei richten würde.“"
                                            },
                                            {
                                                "example_id": "385a98ef-b82e-4739-830a-028595a3028a",
                                                "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                                "text": "„Prügel, Konfiskationen und Gefangennahmen waren bald an der Tagesordnung.“"
                                            },
                                            {
                                                "example_id": "95bb0e5e-3ecf-4c2e-a9c8-b6589fc86ebc",
                                                "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                                "text": "„Gegen solche Konfiskationen ist de Sade so machtlos wie Direktor Coulmier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
