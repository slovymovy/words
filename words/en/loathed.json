    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7cf73965-b1f4-3e4e-b9ae-8da319ca0f4e",
                    "sense_definition": "simple past and past participle of <w>loathe</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>loathed</w> the way his boss treated the junior staff members.",
                            "target_lang_translations": {
                                "nl": "Hij <w>haatte</w> de manier waarop zijn baas de junior medewerkers behandelde."
                            }
                        },
                        {
                            "text": "She had always <w>loathed</w> the cold winter weather in this city.",
                            "target_lang_translations": {
                                "nl": "Zij had altijd een <w>hekel aan</w> het koude winterweer in deze stad."
                            }
                        }
                    ],
                    "synonyms": [
                        "hated",
                        "detested",
                        "abhorred"
                    ],
                    "antonyms": [
                        "loved",
                        "adored"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een intense afkeer of haat voelen voor iemand of iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "haatte",
                                "target_lang_sense_clarification": "verleden tijd van haten, duidt op een sterke afkeer"
                            },
                            {
                                "target_lang_word": "verfoeide",
                                "target_lang_sense_clarification": "een formeler woord voor een diepe afkeer hebben"
                            },
                            {
                                "target_lang_word": "had een hekel aan",
                                "target_lang_sense_clarification": "idiomatische uitdrukking voor een sterke afkeer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50e6d13c-d9fe-30c0-a130-cb1edeac7930",
                    "sense_definition": "Nonstandard form of <w>loath</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reluctance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>loathed</w> to change the schedule on such short notice.",
                            "target_lang_translations": {
                                "nl": "De manager was <w>onwillig</w> om het rooster op zo'n korte termijn te wijzigen."
                            }
                        },
                        {
                            "text": "They were <w>loathed</w> to admit that the project had failed completely.",
                            "target_lang_translations": {
                                "nl": "Zij waren <w>aarzelend</w> om toe te geven dat het project volledig was mislukt."
                            }
                        }
                    ],
                    "synonyms": [
                        "reluctant",
                        "unwilling",
                        "hesitant"
                    ],
                    "antonyms": [
                        "eager",
                        "willing"
                    ],
                    "common_phrases": [
                        "loathed to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a nonstandard usage often confused with the verb loathe."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet bereid of aarzelend om iets te doen (niet-standaard gebruik)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onwillig",
                                "target_lang_sense_clarification": "niet bereid om actie te ondernemen"
                            },
                            {
                                "target_lang_word": "aarzelend",
                                "target_lang_sense_clarification": "terughoudend om iets te doen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}