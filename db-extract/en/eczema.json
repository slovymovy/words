                    {
                        "translation_id": "edddf4c7-9fb5-4e5a-a6f4-7a3d4a47158d",
                        "source_entry_id": "9da63067-6deb-3470-b6c3-7467298af764",
                        "source_sense_description": "acute or chronic inflammation of the skin",
                        "target_lang_word": "eczéma",
