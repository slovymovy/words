{
    "word_family": [
        "represent",
        "representation",
        "representational",
        "misrepresent",
        "unrepresentative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cadb020-8f62-3b73-b89f-fcacd18befbe",
                    "sense_definition": "A company agent who visits potential purchasers or handles customer needs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "agent_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sales <w>representative</w> will visit our office tomorrow to demonstrate the new software.",
                            "target_lang_translations": {
                                "ru": "Торговый <w>представитель</w> посетит наш офис завтра, чтобы продемонстрировать новое программное обеспечение.",
                                "zh": "销售<w>代表</w>明天会来我们办公室演示这款新软件。"
                            }
                        },
                        {
                            "text": "Please contact a customer service <w>representative</w> if you have any problems with your order.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, свяжитесь с <w>представителем</w> службы поддержки клиентов, если у вас возникнут проблемы с заказом.",
                                "zh": "如果您的订单有问题，请联系客户服务<w>代表</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rep",
                        "agent",
                        "salesperson"
                    ],
                    "common_phrases": [
                        "sales representative",
                        "customer service representative",
                        "company representative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Агент компании, который работает с клиентами или посещает потенциальных покупателей.",
                        "zh": "代表公司与客户沟通或拜访潜在买家的工作人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представитель",
                                "target_lang_sense_clarification": "компании, торговый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代表",
                                "target_lang_sense_clarification": "公司职员或销售人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "693701ef-5999-381d-ac7f-f47ff12f0449",
                    "sense_definition": "One who speaks for or acts on behalf of another in a particular official capacity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "agent_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will send a <w>representative</w> to work out the details of the contract next week.",
                            "target_lang_translations": {
                                "ru": "На следующей неделе я пришлю <w>представителя</w>, чтобы согласовать детали контракта.",
                                "zh": "下周我会派一名<w>代表</w>去商定合同细节。"
                            }
                        },
                        {
                            "text": "As a union <w>representative</w>, he negotiates better working conditions for the staff.",
                            "target_lang_translations": {
                                "ru": "Как профсоюзный <w>представитель</w>, он договаривается о лучших условиях труда для сотрудников.",
                                "zh": "作为工会<w>代表</w>，他为员工争取更好的工作条件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rep"
                    ],
                    "common_phrases": [
                        "legal representative",
                        "union representative",
                        "personal representative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто говорит или действует от имени другого лица в официальном качестве.",
                        "zh": "以官方身份代表他人发言或行事的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представитель",
                                "target_lang_sense_clarification": "доверенное лицо"
                            },
                            {
                                "target_lang_word": "уполномоченный",
                                "target_lang_sense_clarification": "официальное лицо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代表",
                                "target_lang_sense_clarification": "代理人或受托人"
                            },
                            {
                                "target_lang_word": "代理人",
                                "target_lang_sense_clarification": "受权行事者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c6ce16b-75a1-3a33-8085-371e8cc0f1c6",
                    "sense_definition": "Someone who represents others as a member of a legislative or governing body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She served four terms as a <w>representative</w> of her local district in the state parliament.",
                            "target_lang_translations": {
                                "ru": "Она четыре срока служила <w>представителем</w> своего местного округа в парламенте штата.",
                                "zh": "她曾在州议会担任了四届当地选区的<w>议员</w>。"
                            }
                        },
                        {
                            "text": "All <w>representatives</w> face re-election every two years to keep their seats.",
                            "target_lang_translations": {
                                "ru": "Все <w>представители</w> проходят переизбрание каждые два года, чтобы сохранить свои места.",
                                "zh": "所有<w>代表</w>每两年都要面临一次改选以保住席位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elected representative",
                        "House of Representatives",
                        "government representative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член законодательного или руководящего органа, представляющий интересы избирателей.",
                        "zh": "作为立法或管理机构成员代表他人利益的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представитель",
                                "target_lang_sense_clarification": "выборное лицо"
                            },
                            {
                                "target_lang_word": "член палаты представителей",
                                "target_lang_sense_clarification": "законодатель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "议员",
                                "target_lang_sense_clarification": "立法机构成员"
                            },
                            {
                                "target_lang_word": "代表",
                                "target_lang_sense_clarification": "选区或团体的代表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db73e271-64eb-3b6d-8aa8-5bfcf0a1bbfd",
                    "sense_definition": "Something regarded as typical of its class; a type.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "example_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This painting is a fine <w>representative</w> of the artist's early work.",
                            "target_lang_translations": {
                                "ru": "Эта картина — прекрасный <w>представитель</w> раннего творчества художника.",
                                "zh": "这幅画是这位艺术家早期作品的<w>典型</w>之作。"
                            }
                        },
                        {
                            "text": "The museum has a preserved specimen that is a perfect <w>representative</w> of the species.",
                            "target_lang_translations": {
                                "ru": "В музее есть сохранившийся экземпляр, который является идеальным <w>представителем</w> этого вида.",
                                "zh": "博物馆里有一个保存完好的标本，是该物种的完美<w>代表</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "representative of",
                        "sole representative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Типичный образец своего класса или вида.",
                        "zh": "某类事物中具有典型特征的样本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представитель",
                                "target_lang_sense_clarification": "образец вида"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "典型",
                                "target_lang_sense_clarification": "具有代表性的事物"
                            },
                            {
                                "target_lang_word": "代表",
                                "target_lang_sense_clarification": "某类事物的样本"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "62a05f84-79b1-3a9b-a8b6-3802be6f743b",
                    "sense_definition": "Typical; having the same properties or interest as a larger group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "typical_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you sure this paper is <w>representative</w> of your child's usual writing style?",
                            "target_lang_translations": {
                                "ru": "Вы уверены, что эта работа <w>показательна</w> для обычного стиля письма вашего ребенка?",
                                "zh": "你确定这篇文章能<w>代表</w>你孩子平时的写作风格吗？"
                            }
                        },
                        {
                            "text": "We need to select a <w>representative</w> sample of the population for the survey to be accurate.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выбрать <w>репрезентативную</w> выборку населения, чтобы опрос был точным.",
                                "zh": "我们需要选取一个<w>有代表性的</w>人口样本，以确保调查结果准确。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unrepresentative",
                        "atypical"
                    ],
                    "common_phrases": [
                        "representative sample",
                        "representative group",
                        "representative body"
                    ],
                    "target_lang_definitions": {
                        "ru": "Типичный; обладающий теми же свойствами или интересами, что и большая группа.",
                        "zh": "典型的；具有与更大群体相同属性或利益的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репрезентативный",
                                "target_lang_sense_clarification": "о выборке, статистике"
                            },
                            {
                                "target_lang_word": "типичный",
                                "target_lang_sense_clarification": "характерный"
                            },
                            {
                                "target_lang_word": "показательный",
                                "target_lang_sense_clarification": "демонстрирующий свойства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有代表性的",
                                "target_lang_sense_clarification": "能反映整体特征的"
                            },
                            {
                                "target_lang_word": "典型的",
                                "target_lang_sense_clarification": "具有代表特征的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}