                "senses": [
                    {
                        "sense_id": "1b5e1526-aaf4-3ad5-9f31-5305a3eb0e14",
                        "entry_id": "5840b834-e0e5-3c67-ad50-8878ec1d2c49",
                        "glosses": [
                            "sexuelle Begierde, die auf Personen und/oder Gegenstände ausgerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea52a009-a0ca-4cfd-ad73-1e369a6f40aa",
                                "sense_id": "1b5e1526-aaf4-3ad5-9f31-5305a3eb0e14",
                                "text": "„Er hält solange an, bis das Ich beginnt, die Vorstellungen von Objekten mit Libido zu besetzen, narzisstische Libido in Objekt-Libido umzusetzen.“"
                            },
                            {
                                "example_id": "8b79d175-81c1-4c8d-9bee-0e3572b4e2e6",
                                "sense_id": "1b5e1526-aaf4-3ad5-9f31-5305a3eb0e14",
                                "text": "„Narzißtische Libido setzt sich also fortwährend in Objekt-Libido um und umgekehrt.“"
                            },
                            {
                                "example_id": "0ba356e3-7778-44db-9581-feb1dfe8eb57",
                                "sense_id": "1b5e1526-aaf4-3ad5-9f31-5305a3eb0e14",
                                "text": "„Positiven Narzissmus beschreibt er als Faktor, der aus dem Ich abgeleitet ist und dessen Ziel es ist, den Konflikt in der Beziehung zwischen Ich-Libido und Objekt-Libido zu lösen. Er hat folglich eine Tendenz, Einheit herzustellen.“"
                            },
                            {
                                "example_id": "a5588feb-04d6-491a-b80e-326d86492a50",
                                "sense_id": "1b5e1526-aaf4-3ad5-9f31-5305a3eb0e14",
                                "text": "„Bei der Geburt des Individuums gibt es kein Ich; statt dessen gibt es Triebe, und diese unterscheiden sich noch nicht nach Objekt-Libido und Ich-Libido.“"
                            },
                            {
                                "example_id": "a254c26c-283d-439c-9dcd-a7731ef546c1",
                                "sense_id": "1b5e1526-aaf4-3ad5-9f31-5305a3eb0e14",
                                "text": "„Kindheitssexualität ist also ein Lustgefühl (‚Libido‘), das nicht auf ein anderes Objekt bezogen ist (‚Objekt-Libido‘), sondern auf das eigene Ich bezogen bleibt (‚Ich-Libido‘).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
