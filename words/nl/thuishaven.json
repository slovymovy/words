    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c1ec720-9a68-3b50-977b-410c4a819c25",
                    "sense_definition": "De plaats waar iemand zich thuis voelt of waar iets van oudsher thuishoort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange reis vonden ze eindelijk een veilige <w>thuishaven</w> in het kleine dorpje. والسلام",
                            "target_lang_translations": {
                                "fr": "Après un long voyage, ils ont enfin trouvé un <w>havre de paix</w> sûr dans le petit village."
                            }
                        },
                        {
                            "text": "Het stadion is al jaren de vaste <w>thuishaven</w> voor de plaatselijke voetbalclub. والسلام",
                            "target_lang_translations": {
                                "fr": "Le stade est depuis des années le <w>fief</w> permanent du club de football local."
                            }
                        }
                    ],
                    "synonyms": [
                        "thuis"
                    ],
                    "common_phrases": [
                        "vaste thuishaven",
                        "een veilige thuishaven"
                    ],
                    "target_lang_definitions": {
                        "fr": "Le lieu où l'on se sent chez soi ou auquel on appartient traditionnellement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "port d'attache",
                                "target_lang_sense_clarification": "lieu où l'on revient toujours et où l'on se sent chez soi"
                            },
                            {
                                "target_lang_word": "havre de paix",
                                "target_lang_sense_clarification": "lieu sûr et tranquille"
                            },
                            {
                                "target_lang_word": "fief",
                                "target_lang_sense_clarification": "lieu de prédilection ou base pour une équipe, un club"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efb4457d-59ad-34d8-9dae-064006c8dad0",
                    "sense_definition": "De haven waar een schip geregistreerd staat of gebaseerd is.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip keerde na een maandenlange tocht op zee terug naar zijn <w>thuishaven</w>. والسلام",
                            "target_lang_translations": {
                                "fr": "Le navire est retourné à son <w>port d'attache</w> après un voyage en mer de plusieurs mois."
                            }
                        },
                        {
                            "text": "In de <w>thuishaven</w> werden de nodige reparaties aan de boot uitgevoerd. والسلام",
                            "target_lang_translations": {
                                "fr": "Dans le <w>port d'attache</w>, les réparations nécessaires ont été effectuées sur le bateau."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terugkeren naar de thuishaven"
                    ],
                    "target_lang_definitions": {
                        "fr": "Le port où un navire est enregistré ou basé."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "port d'attache",
                                "target_lang_sense_clarification": "port d'immatriculation d'un navire"
                            },
                            {
                                "target_lang_word": "port d'attachement",
                                "target_lang_sense_clarification": "port de base d'un bateau"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}