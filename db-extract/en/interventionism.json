                        "cross_references": [
                            {
                                "target_word": "interventionisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c55855ae-85bd-3b87-8069-87373134285d",
                                        "entry_id": "664b67d3-a8f3-3e8d-8761-d6c62daaa378",
                                        "glosses": [
                                            "opvatting dat het dikwijls nodig is dat een overheid de werking van de markt beïnvloedt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e117444-eab7-4b3f-9ed4-999b45ef7318",
                                                "sense_id": "c55855ae-85bd-3b87-8069-87373134285d",
                                                "text": "Zijn belofte om de economie te liberaliseren heeft plaatsgemaakt voor populisme, angstzaaierij en interventionisme."
                                            },
                                            {
                                                "example_id": "cb935e93-ea84-453d-b87d-b8fa080ebee2",
                                                "sense_id": "c55855ae-85bd-3b87-8069-87373134285d",
                                                "text": "De regering is bezig met een ‘proyecto’ waarbij het privatiseringsbeleid van de jaren negentig plaats maakt voor een politiek van interventionisme door de overheid. De nationale luchtvaartmaatschappij Aerolineas Argentinas en de grootste oliemaatschappij YPF – die twintig jaar terug in Spaanse handen kwamen – werden geconfisqueerd. De regering probeert prijzen strikt te controleren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d97dd5-5f38-3272-a6ca-8f9d23e72eab",
                                        "entry_id": "664b67d3-a8f3-3e8d-8761-d6c62daaa378",
                                        "glosses": [
                                            "opvatting die rechtvaardigt dat een staat zich desnoods zelfs gewapenderhand bemoeit met kwesties in of tussen andere landen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae72bab-2176-4919-89f0-6fb88f316185",
                                                "sense_id": "b4d97dd5-5f38-3272-a6ca-8f9d23e72eab",
                                                "text": "Het conflict van de VS met het links-nationalistische regime van de Venezolaanse president Hugo Chavez en zijn opvolger Maduro wordt veroorzaakt door een mix van alle ergernissen die het Amerikaans interventionisme in Latijns-Amerika de afgelopen eeuwen hebben vormgegeven."
                                            },
                                            {
                                                "example_id": "75fa9325-ab44-4108-b9af-dd5863b61ba0",
                                                "sense_id": "b4d97dd5-5f38-3272-a6ca-8f9d23e72eab",
                                                "text": "Ook buiten Syrië heeft westers interventionisme tegen tirannen (met te veel ruimte?) tot ellende geleid. In Irak werd Saddam Hoessein van de troon gestoten, waar niemand om treurt, maar daar brak eveneens een verwoestende burgeroorlog uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c336bc63-3f70-4534-813d-cb96f61985a6",
                        "source_entry_id": "c25709a3-0fb1-3475-b5d0-50bda6b0fcfe",
                        "source_sense_description": "political practice",
                        "target_lang_word": "interventionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interventionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae7fb1c-1a67-3e6b-a719-926ff80ceccc",
                                        "entry_id": "5f7ab549-9427-36d1-af7d-8e7475c58f82",
                                        "glosses": [
                                            "Doctrine politique et économique qui prône l’ingérence de l’État pour l’intérêt public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c73d6b-1184-4253-80a6-927d49679060",
                                                "sense_id": "8ae7fb1c-1a67-3e6b-a719-926ff80ceccc",
                                                "text": "Il faut réduire l’interventionnisme de l’État dans l’économie, ouvrir à la concurrence les monopoles publics et donner plus de souplesse aux entreprises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e786263-9c85-34fa-bf47-f7915aa22c72",
                                        "entry_id": "5f7ab549-9427-36d1-af7d-8e7475c58f82",
                                        "glosses": [
                                            "Doctrine qui prône l’intervention dans un conflit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed575d2e-9621-4f80-8213-20d0d711ae7b",
                                                "sense_id": "0e786263-9c85-34fa-bf47-f7915aa22c72",
                                                "text": "Certains voient en 24 heures chrono un message politique qui soutient l’interventionnisme américain, justifie la torture et fait passer Amnesty International (renommée Amnesty Global) pour une organisation qui donne l’impunité aux terroristes et gêne ceux qui les empêchent de nuire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a643660-d596-3f64-9a88-cfd28a32fd4e",
                                        "entry_id": "5f7ab549-9427-36d1-af7d-8e7475c58f82",
                                        "glosses": [
                                            "Médicalisation excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584e0d5c-c6e0-486e-86f4-0dd0ee59b4bf",
                                                "sense_id": "9a643660-d596-3f64-9a88-cfd28a32fd4e",
                                                "text": "On peut s’interroger sur l’interventionnisme médical lors de l’accouchement et insister sur l’importance de notre vécu personnel dans la façon de vivre sa maternité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
