                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa48ec8c-8ece-40b9-8ac3-ef31ac81d914",
                                "sense_id": "6391649d-4a06-3534-bb97-b6fef0d14505",
                                "text": "„So ging Roger mit seiner Tochter also zum Kommissariat von La Baule, öffnete seine Hose, hielt sie mit einer Hand zusammen und tat so, als quäle ihn eine schwere Darmkolik, als sie das Revier betraten.“"
                            },
                            {
                                "example_id": "11a30dd9-f267-4d28-90ae-603e80f5ccc1",
                                "sense_id": "6391649d-4a06-3534-bb97-b6fef0d14505",
                                "text": "„Die Kranken klagten über Schmerzen, sie litten unter Darmkoliken, einige konnten nicht mehr sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
