                "senses": [
                    {
                        "sense_id": "9e2b1237-1bf6-3c76-8e6d-ea81bed979b6",
                        "entry_id": "9fe33620-fada-3917-9477-92ea5fe5726e",
                        "glosses": [
                            "Rendre existentiel, considérer d'un point de vue existentiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "529c4eb9-909e-472b-852e-26f5ad21572e",
                                "sense_id": "9e2b1237-1bf6-3c76-8e6d-ea81bed979b6",
                                "text": "Psychanalyser Racine, existentialiser Pascal, ce n'est donc en aucun cas commettre un anachronisme, ou leur faire violence."
                            },
                            {
                                "example_id": "18269923-2842-4606-bfc8-303cc7e10b81",
                                "sense_id": "9e2b1237-1bf6-3c76-8e6d-ea81bed979b6",
                                "text": "Par ailleurs, les traducteurs ont tendance à «existentialiser» le texte: chaque occurrence de Sein est rendue par exister."
                            }
                        ]
                    }
