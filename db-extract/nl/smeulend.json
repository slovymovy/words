                                    {
                                        "sense_id": "796a2bff-51a1-3c29-afe8-c31967c3cf16",
                                        "entry_id": "a4fd34a3-b19f-3b0e-b294-e01e81fb62d5",
                                        "glosses": [
                                            "Burning slowly, producing smoke but no flame."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1454967-9411-4a5f-b56c-c74d59ee243f",
                                                "sense_id": "796a2bff-51a1-3c29-afe8-c31967c3cf16",
                                                "text": "And if we meet again, some evil chance / Will make the smouldering scandal break and blaze / Before the people, and our lord the King."
                                            },
                                            {
                                                "example_id": "ce7abfcf-2521-4f73-9913-14585e75b0bc",
                                                "sense_id": "796a2bff-51a1-3c29-afe8-c31967c3cf16",
                                                "text": "The burnt and bleeding man staggered to his feet, dazed and unbelieving, and asked the startled townspeople who came running whether his fireman and guard were safe. He was kept away from the smouldering crater where his engine had been, and taken to hospital."
                                            }
                                        ]
                                    }
                                ]
