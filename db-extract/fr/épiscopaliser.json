                        "sense_id": "dd97a38c-0b7e-3d90-aafe-39f442719b93",
                        "entry_id": "6c5932cd-1fc0-30c2-bf61-a1ddad4d86aa",
                        "glosses": [
                            "Donner un caractère épiscopal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d68e5c9c-c57f-4843-94a6-58097c13320a",
                                "sense_id": "dd97a38c-0b7e-3d90-aafe-39f442719b93",
                                "text": "Wipszycka pense qu’il a délibérément entrepris d’épiscopaliser la chôra face à l’opposition des prêtres."
                            },
                            {
                                "example_id": "25789aa6-c998-460b-b201-4ee09b501f42",
                                "sense_id": "dd97a38c-0b7e-3d90-aafe-39f442719b93",
                                "text": "L'Église, qui avait, un moment, “ épiscopalisé ” la fonction royale, changea d'attitude lors de la querelle du sacerdoce et de l'Empire."
                            },
                            {
                                "example_id": "23425d3d-3a02-4e14-b602-4d28edb251d8",
                                "sense_id": "dd97a38c-0b7e-3d90-aafe-39f442719b93",
                                "text": "“C'est un ministère qui “s'épiscopalise”."
                            }
                        ]
                    }
