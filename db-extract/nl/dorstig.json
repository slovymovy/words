                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9688b313-3caf-40c2-975c-3229f3775d09",
                        "source_entry_id": "4280b095-ec80-352e-8b12-8343087d5212",
                        "source_sense_id": "074f8d85-06cc-395f-b85f-97c5f96b8de4",
                        "source_sense_description": "Durst habend",
                        "target_lang_word": "durstig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durstig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "839a45f9-54fa-34e0-9051-864ba3f4813b",
                                        "entry_id": "f4a51a2b-1d24-3527-ac78-415ea52e8111",
                                        "glosses": [
                                            "Bedürfnis nach Flüssigkeit habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69636103-c413-4247-afea-3510493f4289",
                                                "sense_id": "839a45f9-54fa-34e0-9051-864ba3f4813b",
                                                "text": "Bei den hohen Temperaturen draußen wird man schnell durstig."
                                            },
                                            {
                                                "example_id": "7c1bc7fa-0f28-4409-8311-f7668d428371",
                                                "sense_id": "839a45f9-54fa-34e0-9051-864ba3f4813b",
                                                "text": "Das herrliche Wetter hat am heutigen Mittwoch Hunderte von durstigen Kehlen zum \"Tag des Bieres\" auf den Freisinger Marienplatz gelockt."
                                            },
                                            {
                                                "example_id": "2d86460c-0bf7-4e84-99ce-cc9f6c322135",
                                                "sense_id": "839a45f9-54fa-34e0-9051-864ba3f4813b",
                                                "text": "Die Durstige Liese ist ein Kuchen, der leicht gelingt. Backen und dann Orangen- und Zitronensaft verrühren und den Kuchen damit beträufeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4143c40-85be-4300-85e5-a96061ec6593",
                        "source_entry_id": "4280b095-ec80-352e-8b12-8343087d5212",
                        "source_sense_id": "074f8d85-06cc-395f-b85f-97c5f96b8de4",
                        "source_sense_description": "Durst habend",
                        "target_lang_word": "thirsty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thirsty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9f1c79e-3195-330a-b807-b8406fa2550b",
                                        "entry_id": "19b6e05b-54df-3316-83dc-e14a0fc82394",
                                        "glosses": [
                                            "Needing to drink water or any liquid that can supply water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b31ec44-d019-4891-ba7d-70f798ce587e",
                                                "sense_id": "f9f1c79e-3195-330a-b807-b8406fa2550b",
                                                "text": "After all that work in the hot sun, I am really thirsty."
                                            },
                                            {
                                                "example_id": "ac64bb0a-80e6-4cf6-b0b0-1490b88dd3fb",
                                                "sense_id": "f9f1c79e-3195-330a-b807-b8406fa2550b",
                                                "text": "Then Egil said, ‘That happens if you eat dulse, it makes you even thirstier.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b362ae-ce8d-3093-be70-96fd6a9a86f8",
                                        "entry_id": "19b6e05b-54df-3316-83dc-e14a0fc82394",
                                        "glosses": [
                                            "Craving alcohol; especially, experiencing some alcohol withdrawal."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86dfca1a-5b8a-42bb-a8e9-d77c3a02ea8d",
                                                "sense_id": "95b362ae-ce8d-3093-be70-96fd6a9a86f8",
                                                "text": "After all that work on a stupidly maintained spreadsheet, I am really thirsty."
                                            },
                                            {
                                                "example_id": "bf972406-4faf-4a7b-88dc-547d5b9ca253",
                                                "sense_id": "95b362ae-ce8d-3093-be70-96fd6a9a86f8",
                                                "text": "Q: What's with John today? He seems off his game. A: He's pretty thirsty, I think."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f4a0e73-c7e3-35d7-b2ec-7230253cb40a",
                                        "entry_id": "19b6e05b-54df-3316-83dc-e14a0fc82394",
                                        "glosses": [
                                            "Causing thirst; giving one a need to drink."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2044f956-5af1-4448-b30a-fef928984fc2",
                                                "sense_id": "9f4a0e73-c7e3-35d7-b2ec-7230253cb40a",
                                                "text": "Marching is thirsty work."
                                            },
                                            {
                                                "example_id": "2c07feaf-91dc-4c32-856b-58d397390d3d",
                                                "sense_id": "9f4a0e73-c7e3-35d7-b2ec-7230253cb40a",
                                                "text": "I had for dinner, or rather supper, a chicken done up some way with red pepper, which was very good but thirsty."
                                            },
                                            {
                                                "example_id": "f8fba764-9129-4cbc-a37d-9cd910dfe1ad",
                                                "sense_id": "9f4a0e73-c7e3-35d7-b2ec-7230253cb40a",
                                                "text": "Invest in a water bottle: cycling can be thirsty work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b35d8c1c-d4a1-3332-b729-16d326b636a2",
                                        "entry_id": "19b6e05b-54df-3316-83dc-e14a0fc82394",
                                        "glosses": [
                                            "Craving something immaterial."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f43f96d-cc1c-4de2-abf4-a8c3a08bf6af",
                                                "sense_id": "b35d8c1c-d4a1-3332-b729-16d326b636a2",
                                                "text": "thirsty for knowledge"
                                            },
                                            {
                                                "example_id": "27870bbe-b369-4042-9668-058363786c66",
                                                "sense_id": "b35d8c1c-d4a1-3332-b729-16d326b636a2",
                                                "text": "thirsty for attention"
                                            },
                                            {
                                                "example_id": "118fb99c-440e-454b-8971-3708f1c4f870",
                                                "sense_id": "b35d8c1c-d4a1-3332-b729-16d326b636a2",
                                                "text": "After the president left office, the nation was thirsty for change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b8cd197-58c6-3d10-983c-1fd950adf430",
                                        "entry_id": "19b6e05b-54df-3316-83dc-e14a0fc82394",
                                        "glosses": [
                                            "Craving something immaterial.",
                                            "Craving or desiring sex."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f73c42-88db-407a-a060-d95b5e067808",
                                                "sense_id": "9b8cd197-58c6-3d10-983c-1fd950adf430",
                                                "text": "This is the third time that girl brought up her crush. She must really be thirsty for him."
                                            },
                                            {
                                                "example_id": "67356e3c-b66e-4df8-9692-d2d58824b2ea",
                                                "sense_id": "9b8cd197-58c6-3d10-983c-1fd950adf430",
                                                "text": "The relentless thrill of “Do You Want to Come Over?” is not the only time Britney Spears’s new album Glory makes you feel like you’re being hit on via thirsty text message."
                                            },
                                            {
                                                "example_id": "6ad1014a-35ae-4fb8-bcc8-f52548147f3a",
                                                "sense_id": "9b8cd197-58c6-3d10-983c-1fd950adf430",
                                                "text": "Nin was reviled throughout her life and afterward for writing candidly about her desires — something few women are allowed to do without being branded an open wound — and was only recently divested of her status as one of the thirstiest women of the 20th century."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thirsty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "796aebdb-0738-350a-8843-7f6e980dfacf",
                                        "entry_id": "531fc178-9daa-3194-af86-92dc6b435571",
                                        "glosses": [
                                            "One who is thirsty (for a drink, sex, alcohol, etc.)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a6b2f08-0c1c-4cbd-82de-82ad2f626154",
                                                "sense_id": "796aebdb-0738-350a-8843-7f6e980dfacf",
                                                "text": "The most interesting thing to the \"chicken fanciers\"—and the thirsty also—was an ice cream parlor in Morrison. Before we left […] the town ran short on all brands of beer (near, Root, etc.), and the thirsties of the crowd were reduced to the tamer pastime of eating oranges and cracking peanuts."
                                            },
                                            {
                                                "example_id": "b3409212-85ef-4374-b9bf-66ad4d2ed4e2",
                                                "sense_id": "796aebdb-0738-350a-8843-7f6e980dfacf",
                                                "text": "A thirsty looking for a draught of water finds a welcome sea of water."
                                            },
                                            {
                                                "example_id": "583e834e-6dee-485b-bb16-750228cbc73d",
                                                "sense_id": "796aebdb-0738-350a-8843-7f6e980dfacf",
                                                "text": "Another way to limit the use of thirsty plants […] Here small beds of flowers, azaleas, and other \"thirsties\" could be grown satisfactorily."
                                            },
                                            {
                                                "example_id": "54759c5f-2018-45ee-b3ee-fad5122ec57f",
                                                "sense_id": "796aebdb-0738-350a-8843-7f6e980dfacf",
                                                "text": "You are like a stream of water to a thirsty in a desert."
                                            },
                                            {
                                                "example_id": "312300ae-d7bc-4a04-9203-45372268522e",
                                                "sense_id": "796aebdb-0738-350a-8843-7f6e980dfacf",
                                                "text": "Young Duchess watched the two accomplices, she seemed a thirsty who tastes clear and fresh water after having longed for it: for a moment she preserves an expression that expresses disbelief, as if she had discovered a completely new ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcdd9054-bb4f-3ef7-b5d5-d1122060a977",
                                        "entry_id": "531fc178-9daa-3194-af86-92dc6b435571",
                                        "glosses": [
                                            "Thirst."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a733f25f-ae30-4e14-a915-3e51fe797ecd",
                                                "sense_id": "bcdd9054-bb4f-3ef7-b5d5-d1122060a977",
                                                "text": "There is a thirsty that is not for the belly. There is a thirsty for land that belong to we.\""
                                            },
                                            {
                                                "example_id": "522b3ad2-ada8-4427-a3a4-b10ed0fd5941",
                                                "sense_id": "bcdd9054-bb4f-3ef7-b5d5-d1122060a977",
                                                "text": "The captain would have to spend all his fortune trying to quench the Dark tenant's thirsty. A thirsty that has spanned thousands of years and never been quenched. Provide for his lusts!"
                                            },
                                            {
                                                "example_id": "b73f4155-4ea3-4639-8f60-fa94f5358beb",
                                                "sense_id": "bcdd9054-bb4f-3ef7-b5d5-d1122060a977",
                                                "text": "Afterwards Marguerite declared herself super-hungry, and also thirsty. 'Not super-thirsty, Regular thirsty. Let's say a thirsty that has worked out, learned martial arts and designed its own bat-suit. But definitely super-hunggry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
