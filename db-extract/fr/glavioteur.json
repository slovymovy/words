                        "sense_id": "a7efa359-8afd-3ae6-8466-7b7b1cf54150",
                        "entry_id": "e69634eb-5921-3a14-9d9a-4f58260f4d0a",
                        "glosses": [
                            "Qui projette des glaviots."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "748bc5a0-99e0-4747-a5b5-14aa6fadc32c",
                                "sense_id": "a7efa359-8afd-3ae6-8466-7b7b1cf54150",
                                "text": "J'admire la hardiesse de cette publicité, lorsqu'une espèce de petite toux sèche et glavioteuse retentit à l'autre bout de la place. On dirait qu'on vient de frotter une gigantesque allumette sur un non moins gigantesque grattoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ab03fe9-17ae-3d17-a727-1b975a7d52be",
                        "entry_id": "e69634eb-5921-3a14-9d9a-4f58260f4d0a",
                        "glosses": [
                            "Qui a l'aspect des glaviots."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5d04edd0-5f80-4edb-ae43-a9b7edb4b8d4",
                                "sense_id": "4ab03fe9-17ae-3d17-a727-1b975a7d52be",
                                "text": "— Mais je ne l'ai pas tué, dit le père Filoutier. Aussi vrai que ces cuisse de dinde sont de premier choix.\n— Elle n'en ont pas l'air, dit Mme Wallance. Carbonisées et ratatinées pour les unes, bleues et glavioteuses pour les autres, c'est criminel de traiter la nourriture comme ça."
                            }
                        ]
                    }
