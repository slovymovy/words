                "senses": [
                    {
                        "sense_id": "0174c3a9-d90b-38f0-833c-9815aa7a8df3",
                        "entry_id": "18affd6f-80f9-3075-b5ee-004f80afab92",
                        "glosses": [
                            "Celui qui aime la radio ou les émissions radiodiffusées"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32b98adb-d7b8-4099-b80b-4b05621ca991",
                                "sense_id": "0174c3a9-d90b-38f0-833c-9815aa7a8df3",
                                "text": "Dès 1926, en effet, avaient lieu les premières émissions locales, grâce à un fervent radiophile, M. Charles Jollivet, qui avait obtenu le monopole de la radio-diffusion à Maurice."
                            },
                            {
                                "example_id": "a4cec9c5-8ccb-4a33-9059-92b4843d16d7",
                                "sense_id": "0174c3a9-d90b-38f0-833c-9815aa7a8df3",
                                "text": "Il s’agit tout au plus d'un divertissement honnête que les radiophiles et les téléspectateurs ont bien le droit de s’offrir. Pourquoi refuser ce plaisir au grand public?"
                            }
                        ]
                    }
