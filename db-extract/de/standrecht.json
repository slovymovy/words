                "senses": [
                    {
                        "sense_id": "6b63143a-887c-3d3c-b8af-97dffe3be058",
                        "entry_id": "76083533-fc1e-3f5a-9cb7-ee74d9efd596",
                        "glosses": [
                            "in Ausnahmezuständen erklärter Rechtszustand, in dem die Gerichtsbarkeit von Standgerichten ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af648cf-460d-4373-a993-6e38867a12f3",
                                "sense_id": "6b63143a-887c-3d3c-b8af-97dffe3be058",
                                "text": "Im Standrecht wurden zahlreiche Todesurteile gefällt."
                            },
                            {
                                "example_id": "b340d821-4aac-446c-a7fc-08e5eae7f424",
                                "sense_id": "6b63143a-887c-3d3c-b8af-97dffe3be058",
                                "text": "Das Verfahren im Standrecht wird von dem ältesten der drei Richter aus dem Civilstande geleitet."
                            },
                            {
                                "example_id": "cc6dd0e7-ea28-42af-8fbe-1298b1b336e5",
                                "sense_id": "6b63143a-887c-3d3c-b8af-97dffe3be058",
                                "text": "„Da kam die nächste Nachricht: Dollfuß hatte das Standrecht über Wien verhängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "341fde9c-5398-3a1f-b8b0-fcc3cc5725c4",
                        "entry_id": "76083533-fc1e-3f5a-9cb7-ee74d9efd596",
                        "glosses": [
                            "ein kleineres Kriegsgericht"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "ba184967-a3e1-41b7-b775-92ea4aae0100",
                                "sense_id": "341fde9c-5398-3a1f-b8b0-fcc3cc5725c4",
                                "text": "Auch sind diese 3 Tage erst von der Zeit an zu rechnen, wo der oder die Beschuldigten vor das Standrecht gestellt worden sind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
