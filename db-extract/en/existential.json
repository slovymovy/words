                                    },
                                    {
                                        "sense_id": "3d446c23-bc5b-3a16-9e94-3847ef830c1c",
                                        "entry_id": "0d588a49-8e12-3e17-840f-2fc889c57bc7",
                                        "glosses": [
                                            "das menschliche Dasein hinsichtlich seines Wesens betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c504f5-1959-4ab1-a173-793bd5ee9bc5",
                                                "sense_id": "3d446c23-bc5b-3a16-9e94-3847ef830c1c",
                                                "text": "Der Mensch mit seinem existentiellen Persönlichkeitskern spielt viele unterschiedliche soziale Rollen, in denen er verschiedenste Eigenschaften vorführt."
                                            },
                                            {
                                                "example_id": "3f2fbba6-fc89-4437-8a3d-05426b11fd0e",
                                                "sense_id": "3d446c23-bc5b-3a16-9e94-3847ef830c1c",
                                                "text": "„Die Getrenntheit der Subjekte ist existentiell, unüberwindbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
