                "senses": [
                    {
                        "sense_id": "b9b00482-16d3-30e3-8090-fdcd2cbd7b0e",
                        "entry_id": "13590921-6aed-306a-83e1-12c0116f2594",
                        "glosses": [
                            "Coucher en terre les jeunes pousses d’une plante, après y avoir fait une entaille, afin qu’elles prennent racine et qu’il s’en forme d’autres rejetons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bfb402-fabd-4d6e-8b02-6cc09cd92862",
                                "sense_id": "b9b00482-16d3-30e3-8090-fdcd2cbd7b0e",
                                "text": "On peut la proviner comme la vigne."
                            },
                            {
                                "example_id": "96848f3e-ce74-4323-84a3-1b4bd3228cc7",
                                "sense_id": "b9b00482-16d3-30e3-8090-fdcd2cbd7b0e",
                                "text": "La maniere de proviner & de tailler la vigne est tracée ici dans le plus grand détail."
                            },
                            {
                                "example_id": "95efb05f-56ad-4db9-a21d-b5c2bfbc4bb1",
                                "sense_id": "b9b00482-16d3-30e3-8090-fdcd2cbd7b0e",
                                "text": "A l’époque où la vigne du Pillon produisait encore du vin fort passable, il arriva que le propriétaire se trouva à court d’ouvriers au moment où il était urgent de proviner."
                            }
                        ]
                    },
