                                    {
                                        "sense_id": "716860b6-bb79-3170-952a-6f1d10778b31",
                                        "entry_id": "ee12b591-0f59-34df-bbf8-6b9fd5ec247b",
                                        "glosses": [
                                            "Able to be measured using a common standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9692068-f9b0-4622-a231-300f1501ecf7",
                                                "sense_id": "716860b6-bb79-3170-952a-6f1d10778b31",
                                                "text": "A yard and a foot are commensurable, as both may be measured by inches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f59c91-f95c-3144-b344-1762ec0b0141",
                                        "entry_id": "ee12b591-0f59-34df-bbf8-6b9fd5ec247b",
                                        "glosses": [
                                            "Related in size or scale; commensurate or proportionate."
