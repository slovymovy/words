                                "target_senses": [
                                    {
                                        "sense_id": "eefbaf8a-fd8a-38a0-8e28-ee93af817612",
                                        "entry_id": "0a6dde16-bf61-3a4a-9a18-824da2438b93",
                                        "glosses": [
                                            "Not straight; having one or more bends or angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b6ee6fe-3836-404f-8591-7804fb0b5f00",
                                                "sense_id": "eefbaf8a-fd8a-38a0-8e28-ee93af817612",
                                                "text": "We walked up the crooked path to the top of the hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da491dd-3f4d-316f-89bb-34886dfe85cd",
                                        "entry_id": "0a6dde16-bf61-3a4a-9a18-824da2438b93",
                                        "glosses": [
                                            "Set at an angle; not vertical or square."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df6d741-8c8e-4f8a-97e3-dea6c3ae0ae2",
                                                "sense_id": "5da491dd-3f4d-316f-89bb-34886dfe85cd",
                                                "text": "That picture is crooked - could you straighten it up for me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e873a6-0e4a-33c4-bb13-7aebc375a65d",
                                        "entry_id": "0a6dde16-bf61-3a4a-9a18-824da2438b93",
                                        "glosses": [
                                            "Dishonest or illegal; corrupt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "082a5cab-fba3-4f37-acf7-a00bb30b9460",
                                                "sense_id": "c5e873a6-0e4a-33c4-bb13-7aebc375a65d",
                                                "text": "He was trying to interest me in another one of his crooked deals."
                                            },
                                            {
                                                "example_id": "0b965518-ff3a-42a6-9a31-a59ef60decff",
                                                "sense_id": "c5e873a6-0e4a-33c4-bb13-7aebc375a65d",
                                                "text": "During the height of Italian immigration in the United States and in New York City, gangs flourished not only because of poverty but also because of political and social corruption. Policemen and politicians were often as crooked as the gang leaders themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a257405-6228-32aa-9795-7d0fe1a93dd8",
                                        "entry_id": "0a6dde16-bf61-3a4a-9a18-824da2438b93",
                                        "glosses": [
                                            "ill-tempered; grumpy; cranky."
                                        ],
                                        "tags": [
                                            "Newfoundland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17223e06-b692-4e38-894f-179ec55fa0b0",
                                                "sense_id": "8a257405-6228-32aa-9795-7d0fe1a93dd8",
                                                "text": "I wouldn't try to talk to him just now, b'y! He's some crooked today!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8daa730-ba6a-438d-9042-8a1d08a82133",
                        "source_entry_id": "91a3e1cf-c0c3-3b6e-99f1-98dbf93d8f80",
                        "source_sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
                        "target_lang_word": "twisted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twisted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdac2aec-b710-36b8-8555-1f32018a77b3",
                                        "entry_id": "5a31b473-cd7a-3e3b-8adb-cc45bd4009ce",
                                        "glosses": [
                                            "Consisting of two or more threads, strands or the like intertwined; formed by twisting or twining."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adf0c7e3-92e8-3935-ac8b-bb9ec00f91df",
                                        "entry_id": "5a31b473-cd7a-3e3b-8adb-cc45bd4009ce",
                                        "glosses": [
                                            "Mentally or emotionally distorted or unsound; perverted."
                                        ],
                                        "tags": [
                                            "also",
                                            "with-up"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e36f4ef-9161-4ed7-84d9-db80bd12387a",
                                                "sense_id": "adf0c7e3-92e8-3935-ac8b-bb9ec00f91df",
                                                "text": "twisted sense of humor"
                                            },
                                            {
                                                "example_id": "976d9350-18c1-4226-a988-d67238b1692a",
                                                "sense_id": "adf0c7e3-92e8-3935-ac8b-bb9ec00f91df",
                                                "text": "The murders were committed by a twisted sociopath."
                                            },
                                            {
                                                "example_id": "0a14a3a5-b5a6-4f0f-9dcf-64428cddd1cd",
                                                "sense_id": "adf0c7e3-92e8-3935-ac8b-bb9ec00f91df",
                                                "text": "I was a hard niggah, but not twisted enough to eat and socialize with my peeps knowing I was planning on robbing them before the night was over."
                                            },
                                            {
                                                "example_id": "ac1bf56e-4391-4ad9-9adb-18a9b26920bc",
                                                "sense_id": "adf0c7e3-92e8-3935-ac8b-bb9ec00f91df",
                                                "text": "It was almost noon, and we still had more than a hundred miles to go. They would be tough miles. Very soon, I knew, we would both be completely twisted. But there was no going back, and no time to rest. We would have to ride it out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98ab7a8-64ed-36be-a7f9-f11c336a736e",
                                        "entry_id": "5a31b473-cd7a-3e3b-8adb-cc45bd4009ce",
                                        "glosses": [
                                            "Bent out of shape or out of place; distorted; contorted.",
                                            "Having the intended meaning altered or misrepresented; misunderstood."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9df357a-56d6-4535-bc13-3edb0cb64d62",
                                                "sense_id": "a98ab7a8-64ed-36be-a7f9-f11c336a736e",
                                                "text": "Don't get this twisted. Just because I don't hate you doesn't mean we're friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d27c46d9-f1ac-3128-b14b-1fd08100c089",
                                        "entry_id": "5a31b473-cd7a-3e3b-8adb-cc45bd4009ce",
                                        "glosses": [
                                            "Bent out of shape or out of place; distorted; contorted.",
                                            "Distorted or contorted by tensing the facial muscles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fc314cb-d315-34f2-8408-a83dfe23e085",
                                        "entry_id": "5a31b473-cd7a-3e3b-8adb-cc45bd4009ce",
                                        "glosses": [
                                            "Under heavy influence of intoxicants, usually alcohol and marijuana; very intoxicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bfc67b8-b662-4320-9c85-a4e62540f875",
                                                "sense_id": "7fc314cb-d315-34f2-8408-a83dfe23e085",
                                                "text": "Dude I’m so twisted right now."
                                            },
                                            {
                                                "example_id": "14021d6c-19b1-469c-aa3f-f8cf6fc0b702",
                                                "sense_id": "7fc314cb-d315-34f2-8408-a83dfe23e085",
                                                "text": "\"Man is he high!\" someone whispered. \"Man, he's twisted! But on what? On what?\""
                                            }
