                "forms": [
                    {
                        "form_id": "ffb78368-3d10-4b23-bff0-ab94643df91f",
                        "entry_id": "adc9e3de-e57a-324a-a576-e11ddb34df79",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anatomiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c35a83e9-ff3e-3044-8f79-c456953bd4ee",
                        "entry_id": "adc9e3de-e57a-324a-a576-e11ddb34df79",
                        "glosses": [
                            "Qui a rapport à l’anatomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9cdfba7-562a-49a4-9272-3796cad2e6c8",
                                "sense_id": "c35a83e9-ff3e-3044-8f79-c456953bd4ee",
                                "text": "Observations, recherches, travaux anatomiques. Préparations, démonstrations anatomiques. Sujet anatomique."
                            },
                            {
                                "example_id": "d372e44b-0c49-4f86-ba8c-b9d5f2c27add",
                                "sense_id": "c35a83e9-ff3e-3044-8f79-c456953bd4ee",
                                "text": "La constitution anatomique du cerveau, son architecture, sa structure nous sont en partie connues aujourd’hui."
                            },
                            {
                                "example_id": "a9343033-c1f4-476a-b49c-6ed50f1d885e",
                                "sense_id": "c35a83e9-ff3e-3044-8f79-c456953bd4ee",
                                "text": "— À cette foire de Bordeaux, je suis entré un jour au « musée Dupuytren ». C’étaient des pièces anatomiques en cire."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c565d1d-86d4-396f-9781-1205854689bd",
                        "entry_id": "adc9e3de-e57a-324a-a576-e11ddb34df79",
                        "glosses": [
                            "Qui s'adapte à la forme du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfa7c30-ae39-4902-a031-7a6aa5f092de",
                                "sense_id": "3c565d1d-86d4-396f-9781-1205854689bd",
                                "text": "Une semelle anatomique. Un oreiller anatomique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "714f3636-990f-4625-96af-7e2dc3322dc8",
                        "source_entry_id": "adc9e3de-e57a-324a-a576-e11ddb34df79",
                        "target_lang_word": "anatomisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anatomisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a51813-3c9a-3711-b43c-e90a6ca30e43",
                                        "entry_id": "d96232ea-127b-3e2d-ad16-b71b7622cf1e",
                                        "glosses": [
                                            "sich auf Anatomie beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed4ecaa-635d-476f-87b4-aa5462cf5fae",
                                                "sense_id": "c6a51813-3c9a-3711-b43c-e90a6ca30e43",
                                                "text": "Der anatomische Name des Gefäßes ist „Arteria subclavia“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7be4a57c-1d90-3783-b719-786bce6805f2",
                                        "entry_id": "d96232ea-127b-3e2d-ad16-b71b7622cf1e",
                                        "glosses": [
                                            "in der Anatomie Verwendung findend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d8efc4-2326-4c80-a78b-e66def182424",
                                                "sense_id": "7be4a57c-1d90-3783-b719-786bce6805f2",
                                                "text": "Eine anatomische Pinzette ist eine Pinzette, deren Haltebacken durch Querrillen gekennzeichnet ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10221631-9cc2-4645-92ad-360f3181d785",
