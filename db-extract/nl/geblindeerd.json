                        "examples": [
                            {
                                "example_id": "d572aa2f-b842-4993-8a8f-e87578ba7dcf",
                                "sense_id": "dd8b406d-f3d0-37e2-b706-d72eaf6a471e",
                                "text": "\"Je gaat het bankgebouw binnen en opent met je bankpinpas de speciale kluiskamer. De deur gaat automatisch open en sluit automatisch als je binnen bent. Dan wordt het glas in de deur geblindeerd, zodat je privacy hebt. Er gaat geen bankmedewerker mee naar binnen. In de kamer staat een vierkant blok waarmee je de cassette opvraagt. Dat doe je met je pinpas én een vingerafdruk. De cassette komt omhoog, de schuif in het blok gaat open en met je sleutel draai je de bovenkant van het stalen kluisje open. Als je klaar bent, sluit je de cassette en geef je de robot opdracht die terug in de kelder te sturen.\""
                            }
                        ]
                    }
