                            }
                        ]
                    },
                    {
                        "translation_id": "099c2557-b70e-4a6b-9aa8-0b306e34dc22",
                        "source_entry_id": "24dcf072-6e4e-30e0-80ec-e7f9be3323ab",
                        "source_sense_id": "a5f0f877-e98e-30cd-84f6-9352c3e6ebf3",
                        "source_sense_description": "Militär: leichtes Gewehr",
                        "target_lang_word": "автомат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "автомат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "70d7cbc4-b1b9-38c2-8d3e-2a22e99b4fbe",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "схема или устройство, которое работает по программе и выполняет поставленные перед ним задачи без непосредственного участия человека, лишь под его контролем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "049b47e7-5cf7-4e4d-ae7d-214bea1a17d8",
                                                "sense_id": "70d7cbc4-b1b9-38c2-8d3e-2a22e99b4fbe",
                                                "text": "Игровой автомат."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1540ad3-b413-30b9-8c3e-ded0d6ce00d9",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "воен. то же, что автоматический карабин; ручное оружие для стрельбы очередями, работающее на промежуточных патронах (больше пистолетного и меньше винтовочного)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb88a55-3d63-454c-bd4a-56d1b921d9c6",
                                                "sense_id": "e1540ad3-b413-30b9-8c3e-ded0d6ce00d9",
                                                "text": "Огромный инкрустированный самоцветами сундук волокли из бронированной инкассаторской машины к подъезду академии на Керченской улице двое омоновцев: в касках, в плотных чёрных масках и с автоматами наперевес."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6cf58cb-8f17-3210-a3dd-9b773036da54",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "матем. математическая абстракция, использующаяся в теории автоматов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851cf8cd-2169-4ce3-831e-57898ba1dbd0",
                                                "sense_id": "e6cf58cb-8f17-3210-a3dd-9b773036da54",
                                                "text": "Конечные автоматы Мили и Мура являются классическими моделями функционирования дискретных устройств и широко используются в практике проектирования."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b041c5a-970c-30d6-a8c4-ddfe3028de7e",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "техн. жарг. эл.-техн. то же, что автоматический выключатель; предохранитель, отключающий электричество за счёт обратимых явлений наподобие теплового расширения, в противоположность плавкому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e17a2537-133b-4583-b6dd-6f353e930690",
                                                "sense_id": "2b041c5a-970c-30d6-a8c4-ddfe3028de7e",
                                                "text": "При неработающем преобразователе провод 44 (+50 В) подключён к средней точке батареи через автомат Q31."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd2dcd90-1f3f-3196-84e1-0e1c2f38f509",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "то же, что торговый автомат; машина для продажи чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1489a524-683a-4808-a039-0d59b83d2c2a",
                                                "sense_id": "fd2dcd90-1f3f-3196-84e1-0e1c2f38f509",
                                                "text": "Кормились из милости поваров тем, что оставалось от постояльцев, живших по-человечески. Ломали, не скрою, автоматы с пивом. Денег Хонма-сан не платил не только нам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1448f87f-99bb-3576-ade1-af6523af31c7",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "то же, что игровой автомат; машина, являющаяся противником в игре"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a3d2f9-5f22-4516-b1ff-b47e03fba124",
                                                "sense_id": "1448f87f-99bb-3576-ade1-af6523af31c7",
                                                "text": "Во время ужина то и дело кто-либо из нашей компании вскакивал и бежал в эту комнату сыграть с «одноруким бандитом» — такое прозвище у автоматов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3cd78a-f0f5-3112-bbb4-5b221dc6353b",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "устар. то же, что телефон-автомат; телефон, работающий от монеты или платёжной карточки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd546dec-7193-483e-88d2-5254f65ef811",
                                                "sense_id": "6e3cd78a-f0f5-3112-bbb4-5b221dc6353b",
                                                "text": "Первым делом я всё-таки позвонил Мышкину — из ближайшего автомата."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43737fda-4365-30b3-b3c1-ed424475cd6c",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "студ. жарг. то же, что автоматический зачёт; зачёт учебного предмета по результатам семестра, без сдачи экзамена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48932533-2c36-4099-812a-5ab065660497",
                                                "sense_id": "43737fda-4365-30b3-b3c1-ed424475cd6c",
                                                "text": "И, кстати, я уже получила два автомата по экзаменам, так что надо будет сдать ещё два."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553a24c9-1371-31af-bbe6-61c004926980",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "разг. автоматика, автоматическая работа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d6f4e3b-8d62-4605-a1ee-bf9906d46a99",
                                                "sense_id": "553a24c9-1371-31af-bbe6-61c004926980",
                                                "text": "Для хмурого и замкнутого астронома, персонажа Олега Борисова, моментом истины станет разговор с «матерью»: все звёзды открыты, все слова сказаны, для нас нет ни великой войны, ни Великой депрессии, мы живём на автомате."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c3aea0-3bfb-337a-b21a-d622a6081c6b",
                                        "entry_id": "632923db-8f26-3b47-8d17-21c8d5bdb3ed",
                                        "glosses": [
                                            "автомоб. жарг. то же, что автоматическая коробка передач; коробка передач, переключающаяся автоматически, без участия водителя (в более узком смысле — автоматическая коробка традиционной гидромеханической схемы, в отличие от робота и вариатора)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
