                    },
                    {
                        "translation_id": "fe0063a2-6e0b-4a6f-8452-2f6f3ab670f9",
                        "source_entry_id": "32634c40-787a-3e71-b93f-590437f67263",
                        "source_sense_id": "c09aa130-b81d-3449-b3d7-e6ecfadb2409",
                        "source_sense_description": "Saft, der durch das Pressen von Orangen hergestellt wird",
                        "target_lang_word": "jus d’orange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jus d’orange",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f1686ae-4278-3d80-91f6-f87339d54607",
                                        "entry_id": "467360d2-f3ad-3507-8c14-1ef8e0b5e87b",
                                        "glosses": [
                                            "Jus extrait de l’orange utilisé comme boisson, soit directement, soit après avoir été concentré puis reconstitué par addition d’eau."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3880931-791e-4852-85b6-d240f48bae4f",
                                                "sense_id": "5f1686ae-4278-3d80-91f6-f87339d54607",
                                                "text": "Camille demanda à ses hôtes ce qu'ils buvaient, chercha les alcools avec des hésitations qu'on pouvait prendre pour de la distraction, puis s'assit avec un verre de jus d’orange, la mit en veilleuse et écouta."
                                            },
                                            {
                                                "example_id": "14dde1f1-89a7-4c79-999e-aa22d9cfd208",
                                                "sense_id": "5f1686ae-4278-3d80-91f6-f87339d54607",
                                                "text": "Il suffit d'un petit geste. Et comme je ne suis pas un mec bien qu’à moitié, je ne me contente pas de la poubelle jaune, non, je jette aussi la bouteille du jus d’orange dans un conteneur pour le verre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab435d54-b9c0-3eba-9c3f-122692b38356",
                                        "entry_id": "467360d2-f3ad-3507-8c14-1ef8e0b5e87b",
                                        "glosses": [
                                            "Portion de ce jus pour une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc93b1fc-9c29-4806-9c7a-ec2d49e5fcc4",
                                                "sense_id": "ab435d54-b9c0-3eba-9c3f-122692b38356",
                                                "text": "Garçon, deux jus d’orange, s’il vous plaît !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
