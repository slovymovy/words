{
    "word_family": [
        "weaponry",
        "weaponize",
        "weaponization",
        "weaponless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb5163f1-2847-3c18-b831-f0f4185826f0",
                    "sense_definition": "An instrument of attack or defense in combat or hunting, such as a gun, missile, or sword.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer drew his <w>weapon</w> when the suspect tried to run away.",
                            "target_lang_translations": {
                                "ru": "Полицейский достал своё <w>оружие</w>, когда подозреваемый попытался убежать.",
                                "zh": "当嫌疑人试图逃跑时，警察拔出了他的<w>武器</w>。"
                            }
                        },
                        {
                            "text": "He was arrested for carrying a concealed <w>weapon</w> without a permit.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за ношение скрытого <w>оружия</w> без разрешения.",
                                "zh": "他因无证携带隐蔽<w>武器</w>而被捕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arm",
                        "armament"
                    ],
                    "common_phrases": [
                        "nuclear weapon",
                        "murder weapon",
                        "deadly weapon",
                        "concealed weapon",
                        "biological weapon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Орудие нападения или защиты в бою или на охоте, например, пистолет, ракета или меч.",
                        "zh": "用于战斗或狩猎的攻击或防御工具，例如枪支、导弹或剑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оружие",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "武器",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "兵器",
                                "target_lang_sense_clarification": "侧重于军事或格斗器械"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0686e1c-b7b7-3d9a-9bfb-6df0053da0fa",
                    "sense_definition": "An instrument or means used to harm, convince, or exert control over others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education is the most powerful <w>weapon</w> which you can use to change the world.",
                            "target_lang_translations": {
                                "ru": "Образование — это самое мощное <w>оружие</w>, которое можно использовать, чтобы изменить мир.",
                                "zh": "教育是你用来改变世界最强大的<w>武器</w>。"
                            }
                        },
                        {
                            "text": "Humor was his secret <w>weapon</w> during the tense negotiations.",
                            "target_lang_translations": {
                                "ru": "Юмор был его секретным <w>оружием</w> во время напряженных переговоров.",
                                "zh": "在紧张的谈判中，幽默是他的秘密<w>武器</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "secret weapon",
                        "political weapon",
                        "main weapon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средство или способ, используемые для нанесения вреда, убеждения или контроля над другими.",
                        "zh": "用于伤害、说服或控制他人的手段或工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оружие",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "武器",
                                "target_lang_sense_clarification": "比喻用法"
                            },
                            {
                                "target_lang_word": "手段",
                                "target_lang_sense_clarification": "指达成目的的方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07ea3fbd-2f20-32f6-9239-6244e4268cf4",
                    "sense_definition": "A tool or object used for a specific task, often referred to humorously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For this difficult repair job, my <w>weapon</w> of choice is a heavy hammer.",
                            "target_lang_translations": {
                                "ru": "Для этой сложной ремонтной работы моё <w>оружие</w> выбора — тяжелый молоток.",
                                "zh": "对于这项困难的修理工作，我首选的<w>工具</w>是一把大锤。"
                            }
                        },
                        {
                            "text": "He picked up the guitar, ready to play his <w>weapon</w> on stage.",
                            "target_lang_translations": {
                                "ru": "Он взял гитару, готовый сыграть на своём <w>оружии</w> на сцене.",
                                "zh": "他拿起吉他，准备在舞台上展示他的<w>利器</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "weapon of choice",
                        "choose your weapon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often humorous"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент или предмет, используемый для выполнения конкретной задачи (часто употребляется в шутку).",
                        "zh": "用于执行特定任务的工具或物品（常用于幽默语境）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оружие",
                                "target_lang_sense_clarification": "шутливо о предмете"
                            },
                            {
                                "target_lang_word": "орудие",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工具",
                                "target_lang_sense_clarification": "指完成工作的器具"
                            },
                            {
                                "target_lang_word": "利器",
                                "target_lang_sense_clarification": "比喻得心应手的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91b87ff6-fe17-327b-8851-70ab2451f53b",
                    "sense_definition": "A foolish, incompetent, or annoying person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>weapon</w> and listen to the instructions properly.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>тупицей</w> и слушай инструкции внимательно.",
                                "zh": "别像个<w>笨蛋</w>一样，好好听指令。"
                            }
                        },
                        {
                            "text": "He acted like a total <w>weapon</w> when he forgot the tickets at home.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как полный <w>идиот</w>, когда забыл билеты дома.",
                                "zh": "他把票忘在家里，简直像个<w>蠢货</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moron",
                        "arse"
                    ],
                    "common_phrases": [
                        "absolute weapon",
                        "total weapon"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, некомпетентный или раздражающий человек.",
                        "zh": "指愚蠢、无能或令人讨厌的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупица",
                                "target_lang_sense_clarification": "разг., оскорбительное"
                            },
                            {
                                "target_lang_word": "идиот",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "口语，贬义"
                            },
                            {
                                "target_lang_word": "蠢货",
                                "target_lang_sense_clarification": "口语，粗鲁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "119f6072-de9e-345a-8c05-38f948dc3cf2",
                    "sense_definition": "A very skilled, capable, or impressive person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an absolute <w>weapon</w> on the tennis court and rarely loses a match.",
                            "target_lang_translations": {
                                "ru": "Она настоящая <w>машина</w> на теннисном корте и редко проигрывает матчи.",
                                "zh": "她在网球场上简直是个<w>高手</w>，很少输掉比赛。"
                            }
                        },
                        {
                            "text": "The new player is a <w>weapon</w> who scores in almost every game.",
                            "target_lang_translations": {
                                "ru": "Новый игрок — просто <w>зверь</w>, он забивает почти в каждой игре.",
                                "zh": "这位新球员是个<w>猛将</w>，几乎每场比赛都能得分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legend",
                        "champion",
                        "unit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "positive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень умелый, способный или впечатляющий человек.",
                        "zh": "指非常熟练、有能力或令人印象深刻的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "сленг, о спортсмене"
                            },
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "сленг, одобрительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高手",
                                "target_lang_sense_clarification": "指技艺高超的人"
                            },
                            {
                                "target_lang_word": "猛将",
                                "target_lang_sense_clarification": "指表现强悍的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74287c04-01f4-3ad8-83eb-b9ebb045e706",
                    "sense_definition": "The human genitals, usually referring to the male organ.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian made a crude joke about his <w>weapon</w> during the show.",
                            "target_lang_translations": {
                                "ru": "Комик отпустил грубую шутку про свой <w>ствол</w> во время шоу.",
                                "zh": "喜剧演员在演出中讲了一个关于他<w>命根子</w>的粗俗笑话。"
                            }
                        },
                        {
                            "text": "He was arrested for exposing his <w>weapon</w> in a public park.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за то, что он оголил свое <w>хозяйство</w> в общественном парке.",
                                "zh": "他因在公园里暴露<w>下体</w>而被捕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "genitals",
                        "private parts",
                        "junk"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человеческие гениталии, обычно мужской половой орган.",
                        "zh": "指人类生殖器，通常指男性器官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "хозяйство",
                                "target_lang_sense_clarification": "эвфемизм"
                            },
                            {
                                "target_lang_word": "агрегат",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "命根子",
                                "target_lang_sense_clarification": "俚语，戏称"
                            },
                            {
                                "target_lang_word": "下体",
                                "target_lang_sense_clarification": "委婉语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea155dcd-7aab-390d-a14f-87597c13c7fc",
                    "sense_definition": "To equip or supply someone with weapons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general focused on <w>weaponing</w> the troops for the upcoming battle.",
                            "target_lang_translations": {
                                "ru": "Генерал сосредоточился на том, чтобы <w>вооружить</w> войска перед предстоящей битвой.",
                                "zh": "将军专注于为即将到来的战斗<w>武装</w>部队。"
                            }
                        },
                        {
                            "text": "They were accused of <w>weaponing</w> the rebels against the government.",
                            "target_lang_translations": {
                                "ru": "Их обвинили в том, что они <w>вооружали</w> повстанцев против правительства.",
                                "zh": "他们被指控<w>武装</w>叛军以对抗政府。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать или обеспечивать кого-либо оружием.",
                        "zh": "为某人配备或提供武器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вооружать",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "武装",
                                "target_lang_sense_clarification": "提供武器装备"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}