                                        "glosses": [
                                            "Involving reflection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5bfb3c0-950a-34df-bc88-3ccb3e78a36d",
                                        "entry_id": "947161ed-e310-3f16-b27d-75c51c54fa9c",
                                        "glosses": [
                                            "By means of reflection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ff67a3-b0eb-4c1f-b421-4f4ba4cfc445",
                                                "sense_id": "b5bfb3c0-950a-34df-bc88-3ccb3e78a36d",
                                                "text": "In JIT compilation, the running program is reflectively modified by an embedded compiler, which only uses two reflective operations […]"
