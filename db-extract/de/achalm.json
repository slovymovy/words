                "senses": [
                    {
                        "sense_id": "837e80b8-f061-3288-a7bc-06d898d998bf",
                        "entry_id": "69f73aff-73fd-3667-a20f-6c4fb2c41760",
                        "glosses": [
                            "ein Berg (Gipfel 707 m über NN) vor dem Trauf der Schwäbischen Alb auf dem Stadtgebiet von Reutlingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe46c3f7-026e-4103-b5b6-ffb61ab7c60e",
                                "sense_id": "837e80b8-f061-3288-a7bc-06d898d998bf",
                                "text": "Die Achalm ist ein Zeugenberg des nördlichen Vorlandes der Schwäbischen Alb."
                            },
                            {
                                "example_id": "b18530fa-0dfd-4cb6-aa40-3cec38ac10c7",
                                "sense_id": "837e80b8-f061-3288-a7bc-06d898d998bf",
                                "text": "Nun erzählte der Herzog mit Auflodern, die Reutlinger hätten seinen Vogt von Achalm erschlagen, was Berthold schon wußte, bloß weil er in ihrer Stadt über einen Reutlinger gespottet hatte, den der Herzog vorher hinrichten lassen."
                            },
                            {
                                "example_id": "60df8da9-8be8-4dce-aca7-8ba4b90522b7",
                                "sense_id": "837e80b8-f061-3288-a7bc-06d898d998bf",
                                "text": "Man feierte das Leichenfest des Kaisers zu Stuttgart in der Burg, als dem Herzog die Kunde kam, daß Reutlingen, eine Reichsstadt, die in seinem Gebiet lag, seinen Waldvogt auf Achalm erschlagen habe."
                            },
                            {
                                "example_id": "933f41c1-35d1-49e7-86b8-e1f0643c1bba",
                                "sense_id": "837e80b8-f061-3288-a7bc-06d898d998bf",
                                "text": "Die Sonne war dem Untergehen nahe und tauchte scheidend den Gipfel der Achalm in einen Heiligenschein von Purpur und Gold."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
