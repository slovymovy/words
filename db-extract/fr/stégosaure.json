                                "target_senses": [
                                    {
                                        "sense_id": "69c37762-5f8c-31eb-930f-e0fb7fbbd5a9",
                                        "entry_id": "5b37a1af-44c0-38b3-a0ca-ad192b3860c9",
                                        "glosses": [
                                            "que diz respeito aos estegossauros"
                                        ],
                                        "tags": [
                                            "Brazil"
                                        ],
                                        "examples": []
