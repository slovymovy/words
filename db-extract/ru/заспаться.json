                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182af9b1-6751-417a-a7d6-a2bc937946d4",
                                "sense_id": "0cf8a3a5-98ce-3e0d-ad49-b5b94f945ddd",
                                "text": "— Что это ты, мой дружок, как заспался, — сказала Анна Павловна, — даже личико отекло?"
                            },
                            {
                                "example_id": "f15dc2e7-d142-41e0-a4c0-8e7b2b3f103c",
                                "sense_id": "0cf8a3a5-98ce-3e0d-ad49-b5b94f945ddd",
                                "text": "Все уже бодрствовали, только я один заспался."
                            },
                            {
                                "example_id": "0f3962fc-5b43-43fc-bc71-5789b940ea76",
                                "sense_id": "0cf8a3a5-98ce-3e0d-ad49-b5b94f945ddd",
                                "text": "Мы слишком много выпили и заспались!"
                            }
                        ]
                    }
