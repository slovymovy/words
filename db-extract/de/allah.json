                ],
                "senses": [
                    {
                        "sense_id": "7050bc18-1aca-3aec-9f17-f58bec4c7e46",
                        "entry_id": "334acccc-b736-3558-be0d-c1ad8af08a55",
                        "glosses": [
                            "der Name Gottes"
                        ],
                        "tags": [
                            "islamische"
                        ],
                        "examples": [
                            {
                                "example_id": "e24fac97-4ffa-4a69-b299-c99f7231bc5f",
                                "sense_id": "7050bc18-1aca-3aec-9f17-f58bec4c7e46",
                                "text": "Allah ist der Schöpfer der Welten, jedoch ist er kein Teil der materiellen Welt."
                            },
                            {
                                "example_id": "8b8b6125-c540-4ec0-8967-235ab6e8f242",
                                "sense_id": "7050bc18-1aca-3aec-9f17-f58bec4c7e46",
                                "text": "„Es gibt ein Plakat mit den 99 Namen Allahs, woanders steht ein selbstgebasteltes Modell von Mekka, an einer Wand hängen Koranverse und Regeln zu deren Auslegung.“"
                            },
                            {
                                "example_id": "99ed253f-6d73-44d7-8188-9569986eb3b2",
                                "sense_id": "7050bc18-1aca-3aec-9f17-f58bec4c7e46",
                                "text": "„Bekannt ist, dass Persiankiwi an eben dem Mittwoch, an dem er verschwunden ist, an einer Demonstration gegen den Wahlsieg von Mahmoud Ahmadinejad auf dem Teheraner Baharestan-Platz teilnahm. Von dort sendete er Tweets, vor seinem allerletzten Gruss an Allah, die nichts Gutes vermuten lassen.\n5.23 Uhr: «Sie hieven die Toten in Lastwagen – wie in einer Fabrik – kein Mensch kann so etwas tun – Allah möge uns retten.»\n[…]\n5.39 Uhr: «Allah – du bist der Schöpfer von allem, und alles kehrt zu dir zurück – Gott ist gross.»“"
                            },
                            {
                                "example_id": "4e6665c9-7359-4a94-b850-6416eb152a07",
                                "sense_id": "7050bc18-1aca-3aec-9f17-f58bec4c7e46",
                                "text": "„Im Islam gilt der Koran als sprachliches Wunder, es ist schließlich die Botschaft von Allah höchstpersönlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411e2900-d1a7-40d4-91c3-2e25f9c7b54d",
