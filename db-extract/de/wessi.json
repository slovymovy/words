                        "form": "den Wessis"
                    },
                    {
                        "form_id": "dad06d64-6406-492d-9ee7-35c27992143b",
                        "entry_id": "3e41df2d-253e-30b9-9560-9fced1b8b3cc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Wessi"
                    },
                    {
                        "form_id": "866e2057-1c07-491c-a644-5495363eb4f1",
                        "entry_id": "3e41df2d-253e-30b9-9560-9fced1b8b3cc",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wessis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                        "entry_id": "3e41df2d-253e-30b9-9560-9fced1b8b3cc",
                        "glosses": [
                            "Westdeutscher"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "de50c23e-afff-460b-b7d2-26f8a474c200",
                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                "text": "„Gemeint ist nicht, dass Ossis mehr jammern als andere, sondern, dass sie jammern, obwohl sie nicht – in Gegensatz zu den Wessis – das Recht dazu haben.“"
                            },
                            {
                                "example_id": "4ceb60fc-51f7-47d8-884d-f23b48f95fb1",
                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                "text": "„Die Ossis und die Wessis sprachen dieselbe Sprache.“"
                            },
                            {
                                "example_id": "de406815-37b2-42ae-9b56-f4f560d406cb",
                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                "text": "„Später waren sie verwundert und enttäuscht, wie bieder und prüde die Wessis waren, viel verklemmter als in Woodstock.“"
                            },
                            {
                                "example_id": "75981cbc-2443-41be-a83c-be13e1a97a67",
                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                "text": "„An seiner Kleidung, und offenbar auch an seinem Gehabe ist zu sehen, dass er ein Wessi ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
