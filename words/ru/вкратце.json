                    "sense_definition": "В сжатой форме, используя немного слов; кратко.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>вкратце</w> рассказал нам о своих планах на будущее.",
                            "target_lang_translations": {
                                "en": "He told us <w>briefly</w> about his plans for the future.",
                                "de": "Er hat uns <w>kurz</w> von seinen Zukunftsplänen erzählt."
                            }
                        },
                        {
                            "text": "Если <w>вкратце</w>, то фильм мне совсем не понравился.",
                            "target_lang_translations": {
                                "en": "<w>In short</w>, I didn't like the movie at all.",
                                "de": "<w>Kurz gesagt</w>, der Film hat mir überhaupt nicht gefallen."
                            }
                        }
                    ],
                    "synonyms": [
                        "кратко",
                        "конспективно"
                    ],
                    "antonyms": [
                        "подробно",
                        "детально",
                        "обстоятельно"
                    ],
                    "common_phrases": [
                        "рассказать вкратце",
