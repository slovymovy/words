                                        "glosses": [
                                            "Celle qui conduit, qui mène un déplacement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b97450c4-e0e7-44e6-9e09-026a77384c22",
                                                "sense_id": "7d653e0e-2bef-3754-8e95-559b0a62a4e6",
                                                "text": "Tout cela fournissait à la conductrice de quoi occuper et amuser les enfants toute la journée, et de la matière à jaser."
                                            },
                                            {
                                                "example_id": "7e882c2a-f36a-447f-ba12-56db8db3c04c",
                                                "sense_id": "7d653e0e-2bef-3754-8e95-559b0a62a4e6",
                                                "text": "Le duc de Guise suivit sa conductrice, qui n’était rien moins que la fille de Jacques de Matignon maréchal de France ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da517343-be3b-3d84-b27d-752059b7cf61",
