                                        "examples": []
                                    },
                                    {
                                        "sense_id": "174f0896-5aae-36c6-9c33-a4aa6bd9cf77",
                                        "entry_id": "b68f409b-900b-3110-95ab-09f185019e2e",
                                        "glosses": [
                                            "Relating to a study of the whole instead of a separation into parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a327bf4f-dd23-42d5-bd91-8108f976bbf9",
                                                "sense_id": "174f0896-5aae-36c6-9c33-a4aa6bd9cf77",
                                                "text": "Our holistic study of these modern-day traces suggests it to be a complex trace arising from domichnial, fodinichnial and possibly pascichnial behavior of polychaetes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd04d640-57fd-4818-88e7-9f8071784114",
                        "source_entry_id": "38b11f83-071c-30bd-a2cb-53beb7ccd334",
                        "source_sense_id": "a0fd718f-eecd-3ecd-a4cd-91226a22ff07",
                        "target_lang_word": "wholistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wholistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07dbfc4b-10f5-3959-8b1c-2e3dc0031735",
                                        "entry_id": "40339fa7-45af-3fb2-b0ab-0f830c7705d4",
                                        "glosses": [
                                            "Alternative form of holistic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cf912c0-23de-40a6-b980-9eccb4dd5fd3",
                                                "sense_id": "07dbfc4b-10f5-3959-8b1c-2e3dc0031735",
                                                "text": "Illness is a wholistic reality, just as health is wholistic, and healing is the process of moving from illness to health."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "045d5aa4-384a-43f0-ad32-1293b148dd09",
                        "source_entry_id": "38b11f83-071c-30bd-a2cb-53beb7ccd334",
                        "source_sense_id": "a0fd718f-eecd-3ecd-a4cd-91226a22ff07",
                        "target_lang_word": "holistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05aae50c-33de-3653-848c-f6db4241a4cc",
                                        "entry_id": "704b7123-c03f-3ff8-8fa3-56ed4d7fc9b2",
                                        "glosses": [
                                            "das Ganze betreffend"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fbced5b-6a54-4bab-97ef-f8c13d12ffe8",
                                                "sense_id": "05aae50c-33de-3653-848c-f6db4241a4cc",
                                                "text": "Der französische Jesuitenpater und Evolutionsbiologe Teilhard de Chardin vertritt ein durch und durch holistisches Weltbild."
                                            },
                                            {
                                                "example_id": "3c73ed9b-8d3d-49f6-8358-434440df3e15",
                                                "sense_id": "05aae50c-33de-3653-848c-f6db4241a4cc",
                                                "text": "„Wie kann selbst der holistischste Objektivismus sie ins Bezugssystem seiner Theorie einbeziehen wie sie sind?“"
                                            },
                                            {
                                                "example_id": "069474b4-4a57-4dfa-8b11-a6adb33add38",
                                                "sense_id": "05aae50c-33de-3653-848c-f6db4241a4cc",
                                                "text": "„Digitale Werkzeuge können durch Automatisierung Zeit sparen, die dann für analogen Unterricht und holistischere Prüfungsformen genutzt werden kann.“"
                                            }
                                        ],
