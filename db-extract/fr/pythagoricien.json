                "senses": [
                    {
                        "sense_id": "5ce29de0-ab5f-33ce-8c7a-25de6e119dda",
                        "entry_id": "0a1b27d3-3483-360d-bd73-d196065c2690",
                        "glosses": [
                            "Relatif à Pythagore."
                        ],
                        "tags": [
                            "generically"
                        ],
                        "examples": [
                            {
                                "example_id": "df7a59f2-239a-41d0-ac3f-46bd64a2a44e",
                                "sense_id": "5ce29de0-ab5f-33ce-8c7a-25de6e119dda",
                                "text": "Ceux qui se réclament de lui, en effet, suivent un mode de vie qu’ils appellent pythagoricien, et ce fait les rend manifestement différents aux yeux des autres."
                            },
                            {
                                "example_id": "2c5a9e6f-e67c-4a59-afbd-bb74d56985df",
                                "sense_id": "5ce29de0-ab5f-33ce-8c7a-25de6e119dda",
                                "text": "Ce texte a fait l’objet d’une bibliographie considérable, et il a en particulier inspiré de nombreux mathématiciens et informaticiens qui ont été fascinés par l’idée qu’une méthode générale pour la génération des triplets pythagoriciens ait pu avoir été inventée plus de mille ans avant Pythagore."
                            }
                        ]
                    },
                    {
                        "sense_id": "13cac36f-eaa5-3187-a28c-19fc516d31cb",
                        "entry_id": "0a1b27d3-3483-360d-bd73-d196065c2690",
                        "glosses": [
                            "Qui appartient à une école de philosophes géomètres, dont Pythagore était le chef."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b59001ae-d7d5-430c-9d14-6b2f8cda0708",
                                "sense_id": "13cac36f-eaa5-3187-a28c-19fc516d31cb",
                                "text": "historiens plus curieux et plus méthodiques de reconstituer l'histoire pythagoricienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "b509e771-d592-3f94-8f27-da4676f249b4",
                        "entry_id": "0a1b27d3-3483-360d-bd73-d196065c2690",
                        "glosses": [
                            "Qui a rapport à l’école de Pythagore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46307177-96eb-41c2-8d88-c1a2c8b90c4f",
                                "sense_id": "b509e771-d592-3f94-8f27-da4676f249b4",
                                "text": "Diodore de Sicile a confondu l’opinion que les gaulois avoient d’une autre vie avec la métempsychose égyptienne & pythagoricienne […]"
                            }
                        ]
                    }
                ],
