                "senses": [
                    {
                        "sense_id": "98f85cfb-6c59-3c7d-94e2-3377f6c0de82",
                        "entry_id": "ab8aa3cf-4c62-3c7d-a6d9-4c400c81a631",
                        "glosses": [
                            "мед. нож для хирургических операций"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fcf4dcc-17df-436a-ab2a-647083ae801b",
                                "sense_id": "98f85cfb-6c59-3c7d-94e2-3377f6c0de82",
                                "text": "На всю больницу было только два скальпеля и ни одного термометра, в ваннах держали картофель."
                            },
                            {
                                "example_id": "06c4acf4-25e9-43f3-ad78-18f82cc62bb8",
                                "sense_id": "98f85cfb-6c59-3c7d-94e2-3377f6c0de82",
                                "text": "Вторгаясь в живое тело, хирургический скальпель не только разрезает ткань, но и травмирует близлежащие участки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "def97683-ad9d-4418-a41c-89ccb093103f",
                        "source_entry_id": "ab8aa3cf-4c62-3c7d-a6d9-4c400c81a631",
                        "source_sense_id": "98f85cfb-6c59-3c7d-94e2-3377f6c0de82",
                        "target_lang_word": "scalpel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scalpel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd08541-a54e-3351-aac0-f46538627b5f",
                                        "entry_id": "04ccab81-1a11-309d-a7b5-92bdea95e4fb",
                                        "glosses": [
                                            "A small straight knife with a very sharp blade used for surgery, dissection and craftwork."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69dd63c-3a88-48ac-ba8a-1fd0a1bbde59",
                                                "sense_id": "1dd08541-a54e-3351-aac0-f46538627b5f",
                                                "text": "He feels a tingling behind his ears, anticipating the scalpel and the drill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4631bf33-8328-4676-ae57-303cec74fd96",
                        "source_entry_id": "ab8aa3cf-4c62-3c7d-a6d9-4c400c81a631",
                        "source_sense_id": "98f85cfb-6c59-3c7d-94e2-3377f6c0de82",
                        "target_lang_word": "knife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8efd62dc-efb0-3f7f-9ac2-2d77cb1b4c29",
                                        "entry_id": "5a2c694f-ae41-3d4c-976c-47715dc2c5a2",
                                        "glosses": [
                                            "To cut with a knife."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdcd30ba-2cb4-3c66-8433-2276dbec9796",
                                        "entry_id": "5a2c694f-ae41-3d4c-976c-47715dc2c5a2",
                                        "glosses": [
                                            "To use a knife to injure or kill by stabbing, slashing, or otherwise using the sharp edge of the knife as a weapon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a955c616-ae11-4354-af4f-323b8c6c7bb8",
                                                "sense_id": "cdcd30ba-2cb4-3c66-8433-2276dbec9796",
                                                "text": "She was repeatedly knifed in the chest."
                                            },
                                            {
                                                "example_id": "eeab8cf0-928c-4ae0-b868-9163eee73836",
                                                "sense_id": "cdcd30ba-2cb4-3c66-8433-2276dbec9796",
                                                "text": "One day his sergeant began to cane him, on which, seizing his knife, he knifed the sergeant : he knifed the privates : he knifed until he was finally overpowered, and, brought before a court-martial, was condemned to fifteen years at the galleys."
                                            },
                                            {
                                                "example_id": "fd57b9e3-602f-4e36-beb9-9eb7c941cc09",
                                                "sense_id": "cdcd30ba-2cb4-3c66-8433-2276dbec9796",
                                                "text": "The plane has been hijacked. They've already knifed a guy."
                                            },
                                            {
                                                "example_id": "1a4079cc-231b-4482-a5d6-ba8b06857dab",
                                                "sense_id": "cdcd30ba-2cb4-3c66-8433-2276dbec9796",
                                                "text": "Naw, they found him in the pissery of some gin mill near the Mohawk West terminal—he'd been knifed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14428846-7fab-3939-970f-b5b39c0504ee",
                                        "entry_id": "5a2c694f-ae41-3d4c-976c-47715dc2c5a2",
                                        "glosses": [
                                            "To cut through as if with a knife."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd6d10bc-62ed-46a5-8132-77d41eaad871",
                                                "sense_id": "14428846-7fab-3939-970f-b5b39c0504ee",
                                                "text": "The boat knifed through the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3679ad26-17e3-30f9-a097-6bdd03153fc1",
                                        "entry_id": "5a2c694f-ae41-3d4c-976c-47715dc2c5a2",
                                        "glosses": [
                                            "To betray, especially in the context of a political slate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01b48817-bdd0-33af-a6b7-8992dd531e65",
                                        "entry_id": "5a2c694f-ae41-3d4c-976c-47715dc2c5a2",
                                        "glosses": [
                                            "To positively ignore, especially in order to denigrate; compare cut."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "145b65a5-0b0b-35de-957e-bcf8c226fef5",
                                        "entry_id": "b284902b-021f-3e7d-8ea5-36657767dc60",
                                        "glosses": [
                                            "A utensil or a tool designed for cutting, consisting of a flat piece of hard material, usually steel or other metal (the blade), usually sharpened on one edge, attached to a handle. The blade may be pointed for piercing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97b0456-e512-4ca7-b208-3ab04f0a853d",
                                                "sense_id": "145b65a5-0b0b-35de-957e-bcf8c226fef5",
                                                "text": "He was looking for a knife to chop some steak."
                                            },
                                            {
                                                "example_id": "7faab6f2-3997-4274-8cc4-bf210b8b47e6",
                                                "sense_id": "145b65a5-0b0b-35de-957e-bcf8c226fef5",
                                                "text": "Jeff was bent low over the backboard, working with the knife, a steady sawing motion, his shirt soaked through with sweat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68a9fd8a-cdcc-31c9-839b-af9972a4dc2a",
                                        "entry_id": "b284902b-021f-3e7d-8ea5-36657767dc60",
                                        "glosses": [
                                            "A weapon designed with the aforementioned specifications intended for slashing or stabbing but too short to be called a sword; a dagger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f2fbc6a-edc8-32a1-a8a6-370c3c4bdb12",
                                        "entry_id": "b284902b-021f-3e7d-8ea5-36657767dc60",
                                        "glosses": [
                                            "Any blade-like part in a tool or a machine designed for cutting, such as that of a chipper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0b4c69a-5d78-4fab-93a2-83aba79aedb2",
                        "source_entry_id": "ab8aa3cf-4c62-3c7d-a6d9-4c400c81a631",
                        "source_sense_id": "98f85cfb-6c59-3c7d-94e2-3377f6c0de82",
                        "target_lang_word": "Skalpell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skalpell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                        "entry_id": "0316e079-21ec-3be1-ab66-1b3f49d10339",
                                        "glosses": [
                                            "in der Chirurgie eingesetztes, kleines Messer zum Durchtrennen von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6108bfe0-781c-49b9-872e-42c96fdac327",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "Die OP-Schwester reichte dem Chirurgen das benötigte Skalpell."
                                            },
                                            {
                                                "example_id": "ac339410-24c7-4e65-8998-8cd6ed8142e8",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "„Er möchte nämlich eine Trepanation durchführen und mit dem Skalpell eine bestimmte Partie des rechten Gehirnlappens einritzen.“"
                                            },
                                            {
                                                "example_id": "0e1d1751-4755-4656-82cc-80a5cb8c75f9",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "„Dann holte er plötzlich mit einem kühnen Schwung aus, wobei die Spitze des Skalpells ihre Haut nur gerade eben berührte.“"
                                            },
                                            {
                                                "example_id": "6a469e42-22a7-4ff2-8bf8-84a95d922563",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "„Das scharf bestrahlte Gesicht im Spiegel wurde fremd wie eine belebte Maske, als die Hände nach den Skalpells der Pinsel griffen wie nach den Waffen eines Chirurgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
