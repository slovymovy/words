                                        "sense_id": "d9c7e330-efe9-3061-80de-c2f01ec76184",
                                        "entry_id": "53af2602-f450-38f9-aa29-2eafd9d7a932",
                                        "glosses": [
                                            "A dialect of Italian spoken in parts of Trentino around the Non Valley."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
