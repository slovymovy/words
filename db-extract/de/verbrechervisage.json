                "senses": [
                    {
                        "sense_id": "44525b15-e24f-33a4-8221-265c16dc0b1f",
                        "entry_id": "68f0f721-12e0-34fe-8e20-b1aaa1d17258",
                        "glosses": [
                            "für einen Kriminellen typisches Gesicht"
                        ],
                        "tags": [
                            "casual",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "61a56e35-747e-421d-9f98-ec26f9ce66f5",
                                "sense_id": "44525b15-e24f-33a4-8221-265c16dc0b1f",
                                "text": "„Der Verdächtige hat eine Verbrechervisage wie früher nur Horst Frank.“"
                            },
                            {
                                "example_id": "1d5e9f80-37b5-4800-8ad5-85ece5fbb3b4",
                                "sense_id": "44525b15-e24f-33a4-8221-265c16dc0b1f",
                                "text": "„1922/23 erscheint in einer 10 000er-Auflage ‚Ecce Homo‘, wobei er auf dem Umschlag nicht Christus, sondern einen Zuhälter mit Verbrechervisage darstellt.“"
                            },
                            {
                                "example_id": "81ff0d8b-044c-4726-b144-cf29d6bad16f",
                                "sense_id": "44525b15-e24f-33a4-8221-265c16dc0b1f",
                                "text": "„‚Wenn ich dich erwische, du mit deiner Verbrechervisage!‘, rief er in Anspielung auf einige Narben im Gesicht Löhners, ‚mache ich Hackfleisch aus dir!‘“"
                            },
                            {
                                "example_id": "43f9ae20-cf56-4500-a03a-2f3781f58763",
                                "sense_id": "44525b15-e24f-33a4-8221-265c16dc0b1f",
                                "text": "„Schon vor der Schussverletzung hatte er eine richtige Verbrechervisage gehabt.“"
                            },
                            {
                                "example_id": "ce802ccc-7945-4217-856e-ce58cfdca4cf",
                                "sense_id": "44525b15-e24f-33a4-8221-265c16dc0b1f",
                                "text": "„Eine Verbrechervisage, in der man jedoch Intelligenz, Verschlagenheit und im Grunde eine gewisse Eleganz erkannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
