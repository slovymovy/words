{
    "word_family": [
        "rocker",
        "rocky",
        "rockiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "478a7d79-525f-3066-b22c-2c3a17b45df5",
                    "sense_definition": "Present participle and gerund of <w>rock</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "motion_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat by the window, gently <w>rocking</w> the baby in her arms.",
                            "target_lang_translations": {
                                "ru": "Она сидела у окна, нежно <w>укачивая</w> ребенка на руках.",
                                "zh": "她坐在窗边，怀里抱着婴儿，轻轻<w>摇着</w>他。"
                            }
                        },
                        {
                            "text": "The boat was <w>rocking</w> violently in the stormy sea.",
                            "target_lang_translations": {
                                "ru": "Лодка сильно <w>раскачивалась</w> в штормовом море.",
                                "zh": "小船在波涛汹涌的海面上剧烈<w>摇晃</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rocking the boat",
                        "keep rocking"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола rock.",
                        "zh": "动词 rock 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укачивающий",
                                "target_lang_sense_clarification": "успокаивающий ребенка"
                            },
                            {
                                "target_lang_word": "раскачивающий",
                                "target_lang_sense_clarification": "сильно качающий"
                            },
                            {
                                "target_lang_word": "качание",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇着",
                                "target_lang_sense_clarification": "作动词现在分词，表示正在摇动、晃动"
                            },
                            {
                                "target_lang_word": "摇晃",
                                "target_lang_sense_clarification": "使某物前后晃动"
                            },
                            {
                                "target_lang_word": "摇动",
                                "target_lang_sense_clarification": "轻轻来回摇动，常用于婴儿等"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf69980e-02f0-3c9c-b10e-dab6966091a1",
                    "sense_definition": "Shaking, swaying, or moving back and forth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motion_desc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man fell asleep in his favorite <w>rocking</w> chair on the porch.",
                            "target_lang_translations": {
                                "ru": "Старик заснул в своем любимом кресле-<w>качалке</w> на веранде.",
                                "zh": "老人坐在门廊上他最喜欢的<w>摇椅</w>里睡着了。"
                            }
                        },
                        {
                            "text": "A <w>rocking</w> motion can help soothe a crying infant.",
                            "target_lang_translations": {
                                "ru": "<w>Укачивающее</w> движение может помочь успокоить плачущего младенца.",
                                "zh": "<w>摇晃</w>的动作有助于安抚哭闹的婴儿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swaying",
                        "oscillating",
                        "swinging"
                    ],
                    "antonyms": [
                        "still",
                        "steady"
                    ],
                    "common_phrases": [
                        "rocking chair",
                        "rocking horse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качающийся, ритмично движущийся взад-вперед.",
                        "zh": "摇晃的，摆动的，或来回移动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качающийся",
                                "target_lang_sense_clarification": "движущийся"
                            },
                            {
                                "target_lang_word": "качальный",
                                "target_lang_sense_clarification": "для мебели (кресло-качалка)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇晃的",
                                "target_lang_sense_clarification": "来回晃动的"
                            },
                            {
                                "target_lang_word": "摇摆的",
                                "target_lang_sense_clarification": "前后摆动的"
                            },
                            {
                                "target_lang_word": "摇椅式的",
                                "target_lang_sense_clarification": "用于家具，如 rocking chair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc0f4cc4-64f4-307b-bac1-379a1ba5bc3e",
                    "sense_definition": "Excellent or great.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>rocking</w> time at the concert last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>потрясающе</w> провели время на концерте вчера вечером.",
                                "zh": "昨晚我们在音乐会上玩得<w>特别嗨</w>。"
                            }
                        },
                        {
                            "text": "That was a <w>rocking</w> party with amazing music and food.",
                            "target_lang_translations": {
                                "ru": "Это была <w>потрясающая</w> вечеринка с удивительной музыкой и едой.",
                                "zh": "那真是一场<w>超棒的</w>派对，音乐和食物都很惊艳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "amazing",
                        "fantastic"
                    ],
                    "antonyms": [
                        "terrible",
                        "boring"
                    ],
                    "common_phrases": [
                        "rocking good time"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, великолепный или очень крутой.",
                        "zh": "极好的；很棒的；非常赞的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "восхитительный"
                            },
                            {
                                "target_lang_word": "драйвовый",
                                "target_lang_sense_clarification": "энергичный (сленг)"
                            },
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超棒的",
                                "target_lang_sense_clarification": "口语，表示很棒、很赞"
                            },
                            {
                                "target_lang_word": "很赞的",
                                "target_lang_sense_clarification": "口语，表示非常精彩"
                            },
                            {
                                "target_lang_word": "很嗨的",
                                "target_lang_sense_clarification": "口语，气氛很热烈、让人兴奋"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87d9ed83-b368-34ad-8da4-0605616cb96e",
                    "sense_definition": "The motion of something that rocks.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "motion_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>rocking</w> of the ship made several passengers feel ill.",
                            "target_lang_translations": {
                                "ru": "Постоянная <w>качка</w> корабля вызвала тошноту у нескольких пассажиров.",
                                "zh": "船只持续的<w>摇晃</w>让几名乘客感到恶心。"
                            }
                        },
                        {
                            "text": "Sudden <w>rockings</w> of the ground warned us of the approaching earthquake.",
                            "target_lang_translations": {
                                "ru": "Внезапные <w>колебания</w> земли предупредили нас о приближающемся землетрясении.",
                                "zh": "地面的突然<w>晃动</w>提醒我们地震正在逼近。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swaying",
                        "oscillation"
                    ],
                    "antonyms": [
                        "stillness",
                        "stability"
                    ],
                    "common_phrases": [
                        "gentle rocking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение предмета, который качается или колеблется.",
                        "zh": "某物摇晃或摆动时产生的运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качка",
                                "target_lang_sense_clarification": "судна"
                            },
                            {
                                "target_lang_word": "качание",
                                "target_lang_sense_clarification": "движение"
                            },
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "земли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇晃",
                                "target_lang_sense_clarification": "物体来回晃动这一动作或状态"
                            },
                            {
                                "target_lang_word": "晃动",
                                "target_lang_sense_clarification": "较轻微的摇动、摆动"
                            },
                            {
                                "target_lang_word": "摇摆",
                                "target_lang_sense_clarification": "反复摆动、震荡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48689cb8-49dd-389a-b969-6cc245dd5bc5",
                    "sense_definition": "The abrading of a copper plate with a rocker, preparatory to mezzotinting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist spent hours on the <w>rocking</w> of the plate to ensure a rich texture.",
                            "target_lang_translations": {
                                "ru": "Художник потратил часы на <w>зернение</w> пластины, чтобы обеспечить богатую текстуру.",
                                "zh": "为了确保丰富的肌理，这位艺术家花了好几个小时进行铜版的<w>摇刀打毛</w>。"
                            }
                        },
                        {
                            "text": "Proper <w>rocking</w> is essential for creating the deep blacks in a mezzotint.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>зернение</w> необходимо для создания глубокого черного цвета в меццо-тинто.",
                                "zh": "要在美柔汀版画中做出浓重的黑色，正确的<w>摇刀打毛</w>至关重要。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обработка медной пластины специальным инструментом (качалкой) для подготовки к меццо-тинто.",
                        "zh": "美柔汀制版前，用摇刀处理铜版表面的工序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зернение",
                                "target_lang_sense_clarification": "создание фактуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇刀打毛",
                                "target_lang_sense_clarification": "版画技法中，用摇刀把铜版表面打毛的处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1bd8b50-7530-3f7d-b395-305693f469de",
                    "sense_definition": "The motion by which the design on a steel mill is transferred to a copper cylinder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_print",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine controls the <w>rocking</w> to transfer the intricate pattern precisely.",
                            "target_lang_translations": {
                                "ru": "Машина контролирует <w>накатывание</w>, чтобы точно перенести сложный узор.",
                                "zh": "机器控制<w>滚压转印</w>过程，以便精确转移复杂的纹样。"
                            }
                        },
                        {
                            "text": "Any error in the <w>rocking</w> process can ruin the copper cylinder.",
                            "target_lang_translations": {
                                "ru": "Любая ошибка в процессе <w>накатывания</w> может испортить медный цилиндр.",
                                "zh": "<w>滚压转印</w>过程中任何差错都可能毁掉这个铜制滚筒。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение, при котором рисунок со стального валика переносится на медный цилиндр.",
                        "zh": "把钢辊上的图案转移到铜制滚筒上的那种滚压运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накатывание",
                                "target_lang_sense_clarification": "перенос изображения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滚压转印",
                                "target_lang_sense_clarification": "将钢辊上的纹样转到铜制滚筒上的过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}