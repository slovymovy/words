                "forms": [],
                "senses": [
                    {
                        "sense_id": "2470ce05-9658-31fc-925e-b2c0216d4fa5",
                        "entry_id": "50241a96-9322-372b-90ed-1073f3cc2c55",
                        "glosses": [
                            "vervangt met het"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e92176-81d4-48da-8e36-94111189d858",
                                "sense_id": "2470ce05-9658-31fc-925e-b2c0216d4fa5",
                                "text": "Je zou ermee getrouwd zijn!"
                            },
                            {
                                "example_id": "41355be6-edc4-4a5f-a2d7-fda559e9c7eb",
                                "sense_id": "2470ce05-9658-31fc-925e-b2c0216d4fa5",
                                "text": "Hoe gaat het ermee? Met mij gaat het goed."
                            },
                            {
                                "example_id": "e08ddcfc-51d9-4a82-8a5b-c5a9708a2cf2",
                                "sense_id": "2470ce05-9658-31fc-925e-b2c0216d4fa5",
                                "text": "Ik was aan het ontbijten aan een picknicktafel toen er een man genaamd Josh bij me kwam zitten. Hij at een hamburger, dronk een Budweiser en vertelde me toen plompverloren dat hij ermee ophield. Na bijna twee maanden was zijn PCT over en uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dea7360-0ffb-4ace-a3bc-51303b3fd0cb",
                        "source_entry_id": "50241a96-9322-372b-90ed-1073f3cc2c55",
                        "source_sense_id": "2470ce05-9658-31fc-925e-b2c0216d4fa5",
                        "source_sense_description": "vervangt met het",
                        "target_lang_word": "damit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damit",
                                "target_lang_code": "de",
