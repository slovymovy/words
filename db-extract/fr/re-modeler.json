                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0c3e83-e99a-4d49-a217-3aac4ddf6e02",
                                "sense_id": "81827dc0-5699-3cbe-8cf9-e913bb9fba18",
                                "text": "Le second, en revanche, a désormais l'aptitude à re-modeler, re-façonner par l'imagination et l'intelligence, l'univers dans lequel il vit."
                            },
                            {
                                "example_id": "dae09c1b-2465-4651-a46e-5821f8d7e26b",
                                "sense_id": "81827dc0-5699-3cbe-8cf9-e913bb9fba18",
                                "text": "Jouer à faire “comme si” pour re-modeler le monde est sans aucun doute la plus grande magie que le théâtre peut nous offrir."
                            }
                        ]
