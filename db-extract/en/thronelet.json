                        "examples": [
                            {
                                "example_id": "4c4e069c-85f1-415d-b517-8a3424095196",
                                "sense_id": "a33c4495-0441-3178-a2db-3209a781f8f1",
                                "text": "I have been told that many people have coveted the poor little thronelet of Navarre."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb908d30-fd7f-3d7b-91c6-cbf26514ba6c",
                        "entry_id": "4a51a917-93e9-3db5-8839-4d1eb7d8284b",
                        "glosses": [
                            "A small throne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f44515f8-c696-4322-8990-89ccc902ad76",
                                "sense_id": "eb908d30-fd7f-3d7b-91c6-cbf26514ba6c",
                                "text": "It was just Sid and me sitting there, he on his throne and me on my thronelet."
                            },
                            {
                                "example_id": "721d5d88-eb0a-4b0b-83b5-2481feb19e1c",
                                "sense_id": "eb908d30-fd7f-3d7b-91c6-cbf26514ba6c",
                                "text": "He reaches for a sword that is slung, still in its scabbard and belt, over the back of the thronelet."
                            },
                            {
                                "example_id": "2f690a46-9031-4420-9168-05d65959b7fc",
                                "sense_id": "eb908d30-fd7f-3d7b-91c6-cbf26514ba6c",
                                "text": "Before replying. the prince slowly climbed the three stairs and tried to sit down on the thronelet left vacant by the dead viceroy."
