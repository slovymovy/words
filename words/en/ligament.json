    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5a0b27b-338b-3451-8bf6-e0068e7725f9",
                    "sense_definition": "A band of strong, flexible fibrous connective tissue that connects two bones or cartilages or holds together a joint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete suffered a serious injury when he tore a <w>ligament</w> in his knee during the final match.",
                            "target_lang_translations": {
                                "ru": "Спортсмен получил серьезную травму, когда порвал <w>связку</w> в колене во время финального матча."
                            }
                        },
                        {
                            "text": "Doctors explained that a torn <w>ligament</w> often takes much longer to heal than a broken bone.",
                            "target_lang_translations": {
                                "ru": "Врачи объяснили, что разрыв <w>связки</w> часто заживает гораздо дольше, чем перелом кости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "torn ligament",
                        "knee ligament",
                        "ligament damage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоска прочной, гибкой волокнистой соединительной ткани, которая соединяет две кости или хряща или удерживает сустав."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связка",
                                "target_lang_sense_clarification": "анатомическая структура"
                            },
                            {
                                "target_lang_word": "лигамент",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e111a0e-1f87-3d7d-be3c-491c5de539e8",
                    "sense_definition": "A tie or bond that connects or holds things together metaphorically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shared language served as a strong <w>ligament</w> between the two diverse communities.",
                            "target_lang_translations": {
                                "ru": "Общий язык служил прочным <w>связующим звеном</w> между двумя разными сообществами."
                            }
                        },
                        {
                            "text": "Justice is the <w>ligament</w> which holds civilized beings and civilized nations together in peace.",
                            "target_lang_translations": {
                                "ru": "Справедливость — это те <w>узы</w>, которые удерживают цивилизованных существ и цивилизованные народы вместе в мире."
                            }
                        }
                    ],
                    "synonyms": [
                        "bond",
                        "tie",
                        "link"
                    ],
                    "common_phrases": [
                        "social ligament"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связь или узы, которые метафорически соединяют или удерживают вещи вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связующее звено",
