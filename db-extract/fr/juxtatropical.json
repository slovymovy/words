                        "glosses": [
                            "Subtropical ; qui environne les tropiques."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "094572d1-c310-4cc6-b84b-ca94925062a5",
                                "sense_id": "583881c5-59eb-3b57-817f-aa0bb9158494",
                                "text": "Répandues assez généralement dans les régions tropicales ou juxtatropicales, très peu dans l’Asie tempérée et dans l’Europe , aucune en Amérique en deçà du tropique du Cancer."
                            },
                            {
                                "example_id": "20f6b975-d1ea-4607-9946-6b57ef9a075b",
                                "sense_id": "583881c5-59eb-3b57-817f-aa0bb9158494",
                                "text": "Le calendrier chinois a été formé pour la vallée du Houang-ho, fleuve Jaune, latitude Nord 34 à 35 degrés, ayant un climat plus froid que celui de Paris. Ceux de Columelle, d’Harib, d’Al-Scharky pour l’Espagne, par 36°—43', 39°—51', 37°—05' de latitude Nord, jouissent d’un climat juxtatropical, quoique sous une latitude un peu plus élevée, parce que les côtes occidentales de l’Europe, à latitude égale, ont une température moyenne plus élevées que les côtes orientales."
                            }
                        ]
                    }
