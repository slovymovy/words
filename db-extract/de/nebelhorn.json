                                "sense_id": "351f1868-bcec-3806-9e57-4cdee2e65b65",
                                "text": "„Zwar hörte man auf der Cimbria das Nebelhorn eines anderen Schiffes, konnte dieses aber nicht lokalisieren.“"
                            },
                            {
                                "example_id": "7689aaa9-dbfa-4d16-bb16-95157d058b7c",
                                "sense_id": "351f1868-bcec-3806-9e57-4cdee2e65b65",
                                "text": "„Von weitem ertönte ein Nebelhorn.“"
                            }
