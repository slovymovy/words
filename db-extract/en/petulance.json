    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                "word": "petulance",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e9a28ed1-4f29-481a-ba7d-61ce5a349a46",
                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                        "tags": [
                            "plural"
                        ],
                        "form": "petulances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a51e95ff-6942-38ea-8925-24cf125ad491",
                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                        "glosses": [
                            "Rudeness, insolence."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d22997c9-8039-4e84-9023-36fa4112f111",
                                "sense_id": "a51e95ff-6942-38ea-8925-24cf125ad491",
                                "text": "[W]ise men knew, that that, which looked like pride in some, and like petulance in others, would, by experience in affairs, and conversation amongst men, both of which most of them wanted, be in time wrought off […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "bcf07f82-4a5d-399e-9988-37834b2acfd5",
                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                        "glosses": [
                            "An insolent remark or act."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "74b156f3-6fd8-4b89-a495-6b307f34f235",
                                "sense_id": "bcf07f82-4a5d-399e-9988-37834b2acfd5",
                                "text": "I believe I was guilty of a petulance, which nothing but my uneasy situation can excuse; if that can."
                            }
                        ]
                    },
                    {
                        "sense_id": "df425096-93ee-332e-9c5c-21146bef2633",
                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                        "glosses": [
                            "Childish impatience or sulkiness; testiness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ed5670-0531-4248-b4c1-1c27de6c4f31",
                                "sense_id": "df425096-93ee-332e-9c5c-21146bef2633",
                                "text": "She […] had shown herself angry and sore, and was now ashamed of her own petulance, and yet unable to discontinue it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2352340e-a62a-43d1-a95f-d6cd5fb24b4e",
                        "source_entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                        "source_sense_description": "childish impatience or sulkiness",
                        "target_lang_word": "Gereiztheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gereiztheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                        "entry_id": "ded93f93-8d97-37af-ae6b-9e3466fcdef5",
                                        "glosses": [
                                            "Zustand nervlich angespannter Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d728877-dd6c-4bb1-8868-5826beef17ba",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "Am Ende des Arbeitstages schleppte er den Stress und die Gereiztheit oft mit nach Hause."
                                            },
                                            {
                                                "example_id": "59841b73-b480-470a-8598-4fbca3cec0fc",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Bruni bemerkt, dass Isoldes depressive Gereiztheit zunimmt, äußert sie ihre Vermutung, dass es für Percys Reserviertheit neben der Nibelungentreue noch handfestere Gründe geben könnte, wogegen halt schärfere Aphrodisiaka eingesetzt werden müssten.“"
                                            },
                                            {
                                                "example_id": "0fbd59f4-5239-4f89-9b90-b8ea44a946ac",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Alle ihre Gereiztheit war plötzlich verschwunden, und ihre unruhigen, fragenden Augen hafteten in gieriger Erwartung an seinem Gesicht.“"
                                            },
                                            {
                                                "example_id": "81f7df7e-bb1f-43b2-8275-fc2405916b40",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Sie lachte herzlich, denn der Ton, in dem St. Armaud dies sagte, klang durchaus liebenswürdig und jedenfalls ebenso frei von Gereiztheit wie Tadel.“"
                                            },
                                            {
                                                "example_id": "9fe2e779-d03a-4b43-b29f-874837c33d3f",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Wenn Karl Emonds eine Siebenzimmerwohnung hätte, wäre die Gereiztheit, das Gehetztsein nicht mehr unumgänglich.“"
                                            },
                                            {
                                                "example_id": "a6a04519-9fe0-48f3-9724-46b95a17fc01",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Ferris sein Büro betrat, musterte Hoffman ihn über den Rand seiner Lesebrille hinweg mit einer Mischung aus Gereiztheit und Erstaunen, als habe er total vergessen, dass er Ferris herbestellt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
