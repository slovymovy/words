                ],
                "senses": [
                    {
                        "sense_id": "90f7e9c2-b222-315e-a660-094f8b899b2b",
                        "entry_id": "5586b04c-7c28-3514-ab54-1d4828a7c019",
                        "glosses": [
                            "Enlever le hourdis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "542029ef-c819-4227-9fe2-66a929246400",
                                "sense_id": "90f7e9c2-b222-315e-a660-094f8b899b2b",
                                "text": "A l'extrême fin de septembre 1642, les maçons et les manouvriers commencèrent à « déhourdir », opération qui se termina en octobre."
                            }
                        ]
                    },
                    {
                        "sense_id": "33fea45e-c1ef-36d7-89ae-5cafe1133279",
                        "entry_id": "5586b04c-7c28-3514-ab54-1d4828a7c019",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d39b67ad-c00e-4456-a543-24b57d057511",
                                "sense_id": "33fea45e-c1ef-36d7-89ae-5cafe1133279",
                                "text": "Je vais d’abord te déhourdir proprement et demain tu recevras une bonne sanglade d’étrivières avant que je ne te remette à l’alguazil pour répondre du meurtre du corregidor !"
                            },
                            {
                                "example_id": "c49e5e85-2802-4aa8-83b7-5eca04a4939a",
                                "sense_id": "33fea45e-c1ef-36d7-89ae-5cafe1133279",
                                "text": "C’est que nous avons laissé à bord du Santander un de nos bons compagnons qui, malgré sa jeunesse, n’est pas le dernier à déhourdir au premier signal."
                            }
                        ]
                    }
                ],
