                ],
                "senses": [
                    {
                        "sense_id": "5cfdf2c7-5e7a-3121-afad-747f3019ad57",
                        "entry_id": "b3cc155c-337d-3e7f-9726-55fd8d851164",
                        "glosses": [
                            "Marcher un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b8c78b-460e-4549-bc56-eff4dc88182b",
                                "sense_id": "5cfdf2c7-5e7a-3121-afad-747f3019ad57",
                                "text": "Après avoir passé des heures et des heures à marchouiller – oui vous savez, quand on marche, mais que cela n'avance pas –, je ne peux retenir un gémissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "90132279-4781-3ed1-be50-e739e9083ddf",
                        "entry_id": "b3cc155c-337d-3e7f-9726-55fd8d851164",
                        "glosses": [
                            "Marcher (fonctionner) un peu, mais pas très bien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2d69f0d-a7ec-4daf-9f0c-21d8c35e7279",
                                "sense_id": "90132279-4781-3ed1-be50-e739e9083ddf",
                                "text": "Ça commence par le single “ Regarde ”, qui marchouille gentiment au printemps 74"
                            },
                            {
                                "example_id": "5f981912-4988-4f93-9ea9-9b47417c2560",
                                "sense_id": "90132279-4781-3ed1-be50-e739e9083ddf",
                                "text": "Ou bien les statistiques fonctionnent et alors, l'astrologie est sans limite ou alors, « ça marchouille » et mieux vaut passer à autre chose."
                            }
                        ]
                    }
                ],
