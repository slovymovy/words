                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c0e86c5-4abe-4347-adcc-54c77ecabd76",
                        "source_entry_id": "e030bb82-c1ba-3c42-aa6f-97374d28f7bd",
                        "target_lang_word": "Stoizismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoizismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16eea414-7891-3e12-b296-5dfc1a09f31d",
                                        "entry_id": "5d93feeb-ab16-3015-8879-78cc2135710c",
                                        "glosses": [
                                            "griechisch-römische Philosophenschule von etwa 300 v.Chr. bis 200 n.Chr, deren Ideal der Weise, der der Natur gemäß lebt, die Affekte beherrscht, Leiden stoisch, gefasst trägt und mit der Tugend als einziger Quelle der Glückseligkeit zufrieden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d171e0a3-995f-43c7-bbd2-60e19a13ed6b",
                                                "sense_id": "16eea414-7891-3e12-b296-5dfc1a09f31d",
                                                "text": "„Der Stoizismus lehrt fast durchweg einen materialistischen Pantheismus: Gott trage als eine Art Weltseele die Keimkräfte alles Geschehens in sich […]. Der Stoizismus lehrt ferner die Gleichheit aller Menschen und einen gewissen Kosmopolitismus.“"
                                            },
                                            {
                                                "example_id": "331453dd-e8c2-4aad-bfe3-ff8afc8f0138",
                                                "sense_id": "16eea414-7891-3e12-b296-5dfc1a09f31d",
                                                "text": "„Der Stoizismus sollte später für die römische Kultur große Bedeutung erlangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62879431-19b5-3efa-8684-516fba3ef43c",
                                        "entry_id": "5d93feeb-ab16-3015-8879-78cc2135710c",
                                        "glosses": [
                                            "Haltung, die durch Gleichmut, Gelassenheit geprägt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e322e9a2-1133-4f30-94e9-6d5d3c3d316a",
                                                "sense_id": "62879431-19b5-3efa-8684-516fba3ef43c",
                                                "text": "„So sehr der englische Stoizismus von Elias Canetti bewundert wurde; irgendwann hat man von dem Heroismus genug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8645ef9-e3e5-4226-8890-4e4872f404f9",
                        "source_entry_id": "e030bb82-c1ba-3c42-aa6f-97374d28f7bd",
                        "target_lang_word": "Stoa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24126dd3-1b00-360c-bff2-539f6daa1d37",
                                        "entry_id": "59cd7178-dda1-3082-9d20-6dbcdcb5a9cd",
                                        "glosses": [
                                            "die griechische Bezeichnung für eine lange, schmale Säulenhalle"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f14afe03-df41-44c8-9c5d-4d04cf2f8a17",
                                                "sense_id": "24126dd3-1b00-360c-bff2-539f6daa1d37",
                                                "text": "„In Heiligtümern wie dem Heraion von Samos diente eine Stoa zur Aufbewahrung und Ausstellung von Weihgeschenken, an der Agora als Wandelhalle und städtisches Kommunikationszentrum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b43a185-42b8-3f95-9b96-7592e94d43b0",
                                        "entry_id": "59cd7178-dda1-3082-9d20-6dbcdcb5a9cd",
                                        "glosses": [
                                            "eine weit verbreitete Strömung der altgriechischen Philosophie, die um 300 vor Christus von Zenon von Kition gegründet wurde"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feded7b1-d01d-4775-b1bc-d0bb2a22d979",
                                                "sense_id": "8b43a185-42b8-3f95-9b96-7592e94d43b0",
                                                "text": "Von Kleanthes, einem berühmten Vertreter der Älteren Stoa, stammt der Ausspruch: „In ihm leben, weben und sind wir.“, den der Apostel Paulus in Athen zitiert."
                                            },
                                            {
                                                "example_id": "070fd4c6-c067-40da-b976-bcaa7a9e8025",
                                                "sense_id": "8b43a185-42b8-3f95-9b96-7592e94d43b0",
                                                "text": "„In der Kaiserzeit war die Stoa eine Art ethischer Religion des römischen Volkes geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
