    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eb17d6b-0d55-3507-85c9-2f0575bbf399",
                    "sense_definition": "Внесение изменений, исправлений или дополнений в готовый или почти готовый продукт, проект или документ с целью его улучшения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот проект требует существенной <w>доработки</w>, прежде чем мы сможем представить его клиенту.",
                            "target_lang_translations": {
                                "pl": "Ten projekt wymaga znacznego <w>dopracowania</w>, zanim będziemy mogli zaprezentować go klientowi."
                            }
                        },
                        {
                            "text": "После тестирования программы разработчики отправили её на <w>доработку</w> для устранения мелких ошибок.",
                            "target_lang_translations": {
                                "pl": "Po przetestowaniu programu programiści odesłali go do <w>poprawki</w> w celu usunięcia drobnych błędów."
                            }
                        }
                    ],
                    "synonyms": [
                        "улучшение",
                        "исправление",
                        "модификация",
                        "корректировка"
                    ],
                    "common_phrases": [
                        "требует доработки",
                        "отправить на доработку",
                        "существенная доработка"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wprowadzanie zmian, poprawek lub uzupełnień do gotowego lub prawie gotowego produktu, projektu lub dokumentu w celu jego ulepszenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dopracowanie",
                                "target_lang_sense_clarification": "projektu, szczegółów"
                            },
                            {
                                "target_lang_word": "modyfikacja",
                                "target_lang_sense_clarification": "wprowadzanie zmian"
                            },
                            {
                                "target_lang_word": "poprawka",
                                "target_lang_sense_clarification": "nanoszenie poprawek"
                            },
                            {
                                "target_lang_word": "udoskonalenie",
                                "target_lang_sense_clarification": "ulepszenie produktu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7993f46f-c657-32d9-ab60-9b16481f82b2",
                    "sense_definition": "Действие по значению глагола <w>доработать</w>; завершение работы над чем-либо или работа в течение определённого дополнительного времени.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему осталась <w>доработка</w> до пенсии всего два года, и он очень ждал этого момента.",
                            "target_lang_translations": {
                                "pl": "Zostało mu tylko dwa lata <w>przepracowania</w> do emerytury i bardzo czekał na ten moment."
                            }
                        },
                        {
                            "text": "Полная <w>доработка</w> деталей заняла у мастера всю оставшуюся часть вечера.",
                            "target_lang_translations": {
                                "pl": "Pełne <w>wykończenie</w> detali zajęło rzemieślnikowi całą pozostałą część wieczoru."
                            }
                        }
                    ],
                    "synonyms": [
                        "завершение",
                        "окончание"
                    ],
                    "common_phrases": [
                        "доработка до пенсии"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dokończenie pracy nad czymś lub przepracowanie określonego dodatkowego czasu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przepracowanie",
                                "target_lang_sense_clarification": "określonego czasu, np. do emerytury"
                            },
                            {
                                "target_lang_word": "wykończenie",
                                "target_lang_sense_clarification": "dokończenie pracy nad detalem"
                            },
                            {
                                "target_lang_word": "dokończenie",
                                "target_lang_sense_clarification": "sfinalizowanie pracy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}