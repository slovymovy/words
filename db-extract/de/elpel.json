                ],
                "senses": [
                    {
                        "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                        "entry_id": "bcf53c42-f7d5-331a-a4ae-1a8ecf489b1b",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6b253d-89d6-4119-a087-d84005c3d2dd",
                                "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                                "text": "Frau Elpel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "896519f0-1677-4d68-8bba-9d1e73ee39c7",
                                "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                                "text": "Herr Elpel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "86f47afd-0c00-42c9-973a-1dd0b0b04485",
                                "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                                "text": "Die Elpels kommen heute von Amrum."
                            },
                            {
                                "example_id": "b53d6d86-0dd6-41f1-b4bf-6960da11b6dc",
                                "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                                "text": "Der Elpel trägt nie die Schals, die die Elpel ihm strickt."
                            },
                            {
                                "example_id": "fd83f689-2467-46de-a266-d533a0bb1d1f",
                                "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Elpel kommt, geht der Herr Elpel.“"
                            },
                            {
                                "example_id": "918ee18e-eaa1-494f-8283-c61f7e9595e8",
                                "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                                "text": "Elpel kommt und geht."
                            },
                            {
                                "example_id": "171ef251-72bf-4b9f-883b-738c24ab71d9",
                                "sense_id": "65224645-c08a-3f44-b1cb-fcd36296f591",
                                "text": "Elpels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
