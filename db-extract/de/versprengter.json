                "senses": [
                    {
                        "sense_id": "e34d06c6-78b0-3e72-8b56-31b5c4cd0928",
                        "entry_id": "2a95bacc-f968-3bf0-a668-e1761325f82d",
                        "glosses": [
                            "Soldat, der von seiner Einheit getrennt ist oder in die Flucht geschlagen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f3e542a-68cd-4b15-b9fe-9879305c9492",
                                "sense_id": "e34d06c6-78b0-3e72-8b56-31b5c4cd0928",
                                "text": "„Keiner scheint zu den aufgerufenen Einheiten zu gehören. Die meisten sind Versprengte, die ihren Haufen verloren haben.“"
                            },
                            {
                                "example_id": "b577d1ab-267a-484b-864a-b425fc1ff525",
                                "sense_id": "e34d06c6-78b0-3e72-8b56-31b5c4cd0928",
                                "text": "„Fliegende Standgerichte urteilen verdächtige Versprengte ab.“"
                            },
                            {
                                "example_id": "b82d2c8c-3b2f-4197-a49b-90dc722878cb",
                                "sense_id": "e34d06c6-78b0-3e72-8b56-31b5c4cd0928",
                                "text": "„Versprengte und Leichtverwundete kehrten einfach nicht mehr zu ihrem Truppenteil zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
