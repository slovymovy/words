                "senses": [
                    {
                        "sense_id": "50ec9383-23b6-392e-97be-c98a862ac1a1",
                        "entry_id": "eda1303c-db9d-326d-8d87-c9e930c3f7fe",
                        "glosses": [
                            "Fachsprache des Heeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2ca29f-3345-43ea-bcdb-5f700f9faa71",
                                "sense_id": "50ec9383-23b6-392e-97be-c98a862ac1a1",
                                "text": "„Der Wortschatz der Heeressprache (…) wurde durch die letzten Kriege in weite Kreise getragen.“"
                            },
                            {
                                "example_id": "0ed81b1b-9b89-4f3d-a65a-4f3f53f8bd48",
                                "sense_id": "50ec9383-23b6-392e-97be-c98a862ac1a1",
                                "text": "„Natürlich bemächtigte die LTI sich auch, und sogar mit besonderer Energie, des Heeres; aber zwischen Heeressprache und LTI liegt eine Wechselwirkung vor, genauer: erst hat die Heeressprache auf die LTI gewirkt, und dann ist die Heeressprache von der LTI korrumpiert worden.“"
                            },
                            {
                                "example_id": "3e461ea6-a7a2-4519-98f1-2123bc72d6ef",
                                "sense_id": "50ec9383-23b6-392e-97be-c98a862ac1a1",
                                "text": "„Auf alten Sprachschichten beruht die Heeressprache, die später im Zeitalter der Landsknechte und europäischen Söldnerheere als Standes- und Fachsprache freilich stark überfremdet wird.“"
                            },
                            {
                                "example_id": "dac7bf27-9d0b-425e-88fa-f7ea928bfb12",
                                "sense_id": "50ec9383-23b6-392e-97be-c98a862ac1a1",
                                "text": "„Das Bestehen übernationaler Gemeinsamkeiten in allen Heeressprachen wird durch Dauzats Entdeckung eines überall durch die Argotbildung erfolgten Stilverfahrens noch schärfer beleuchtet.“"
                            },
                            {
                                "example_id": "ca196f45-d5b3-4cc2-9e5c-0f0aeb94146e",
                                "sense_id": "50ec9383-23b6-392e-97be-c98a862ac1a1",
                                "text": "„Wir Preussen besitzen in der Heeressprache ebenfalls noch Ausdrücke, welche für zwei Begriffe gebraucht werden:…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
