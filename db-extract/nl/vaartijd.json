                        "examples": []
                    },
                    {
                        "sense_id": "984f956e-3a22-3fb0-a751-6185c539a34a",
                        "entry_id": "57f1bf07-1338-3259-8ad8-0be32a96b10e",
                        "glosses": [
                            "duur van de periode dat iemand in zijn leven gevaren heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315e48c7-29b4-4baf-af51-fdc4142359aa",
                                "sense_id": "984f956e-3a22-3fb0-a751-6185c539a34a",
                                "text": "Even leek er gevaren te kunnen worden in de vaart bij het clubhuis, waar je in ieder geval nog de overkant kon zien: het jeugdteam van de Keelboat Academy ging onder leiding van Wietze de boot omvaren, gevolgd door het jonge team van Phoenixsee uit Duitsland. Voor de jonge zeilers was er toch nog wat vaartijd."
                            }
                        ]
                    }
