                                "target_senses": [
                                    {
                                        "sense_id": "f42be40c-25ba-3414-afa7-e9fa0bc95498",
                                        "entry_id": "5e992b5c-f28e-397f-b149-9165cb0b40b3",
                                        "glosses": [
                                            "vor allem aus west- und zentralnorwegischen Dialekten konstruierte Sprachvarietät der norwegischen Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d87a94-dbd7-4965-974d-329fd40e280c",
                                                "sense_id": "f42be40c-25ba-3414-afa7-e9fa0bc95498",
                                                "text": "„Nynorsk hingegen hat mehr Gemeinsamkeiten mit den westskandinavischen Sprachen Färöisch und Isländisch als Bokmål, Dänisch und Schwedisch.“"
                                            },
                                            {
                                                "example_id": "54d6609c-0549-43c0-8eda-813a2cabca35",
                                                "sense_id": "f42be40c-25ba-3414-afa7-e9fa0bc95498",
                                                "text": "„In Westnorwegen dominiert Nynorsk in den Ortschaften, hat sich aber auch Eingang in einige Städte verschafft.“"
                                            },
                                            {
                                                "example_id": "3aa1ae32-ff72-4d23-9a5b-e6c6c569a2a7",
                                                "sense_id": "f42be40c-25ba-3414-afa7-e9fa0bc95498",
                                                "text": "„Vergleicht man die syntaktischen Verhältnisse im Bokmål mit denen des Nynorsk, ergeben sich nur einige wenige Unterschiede.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f43a9c8-adad-4efe-a317-f8d9dfe7a487",
                        "source_entry_id": "06e6f804-f429-3d82-aae1-1bd763de3e18",
