                                        ]
                                    },
                                    {
                                        "sense_id": "ad88b946-9974-34eb-a67e-0fe37a6696f0",
                                        "entry_id": "2952a3ba-515d-366b-be3d-08d555609268",
                                        "glosses": [
                                            "Synonym of season (“one of the groups of episodes that together make up a whole series”)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ebfafbf-dee6-4493-8c9c-13f8f84c11d9",
                                                "sense_id": "ad88b946-9974-34eb-a67e-0fe37a6696f0",
                                                "text": "I enjoyed the third series of “Friends”."
