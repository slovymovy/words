{
    "word_family": [
        "onverstoorbaarheid",
        "verstoren",
        "verstoring",
        "verstoorbaar"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3189ec94-0ce7-3b6b-9733-51899261106a",
                    "sense_definition": "niet uit het evenwicht te brengen of af te leiden; kalm blijvend onder alle omstandigheden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rustig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft een vrij <w>onverstoorbare</w> houding, zelfs tijdens de hevigste discussies.",
                            "target_lang_translations": {
                                "fr": "Il a une attitude plutôt <w>imperturbable</w>, même lors des discussions les plus vives."
                            }
                        },
                        {
                            "text": "De ervaren kapitein bleef volkomen <w>onverstoorbaar</w> toen de storm opstak.",
                            "target_lang_translations": {
                                "fr": "Le capitaine expérimenté est resté parfaitement <w>imperturbable</w> lorsque la tempête s'est levée."
                            }
                        }
                    ],
                    "synonyms": [
                        "ijzerenheinig"
                    ],
                    "antonyms": [
                        "verstoorbaar"
                    ],
                    "common_phrases": [
                        "onverstoorbare rust"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui ne se laisse pas troubler ni déconcerter ; qui reste calme en toutes circonstances."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "imperturbable",
                                "target_lang_sense_clarification": "qui garde son sang-froid, que rien n'émeut"
                            },
                            {
                                "target_lang_word": "impassible",
                                "target_lang_sense_clarification": "qui ne montre aucune émotion"
                            },
                            {
                                "target_lang_word": "serein",
                                "target_lang_sense_clarification": "calme et tranquille"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "57197c0a-a371-390b-bb44-f9dd5dadb7f0",
                    "sense_definition": "op een kalme wijze, zonder zich te laten afleiden of verstoren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rustig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks het harde lawaai van de buren ging zij <w>onverstoorbaar</w> door met studeren.",
                            "target_lang_translations": {
                                "fr": "Malgré le fort bruit des voisins, elle a continué à étudier <w>imperturbablement</w>."
                            }
                        },
                        {
                            "text": "Hij zat <w>onverstoorbaar</w> te lezen toen de kast met een klap omviel.",
                            "target_lang_translations": {
                                "fr": "Il lisait <w>imperturbablement</w> lorsque l'armoire est tombée avec fracas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "onverstoorbaar doorgaan",
                        "onverstoorbaar blijven kijken"
                    ],
                    "target_lang_definitions": {
                        "fr": "D'une manière calme, sans se laisser distraire, émouvoir ni interrompre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "imperturbablement",
                                "target_lang_sense_clarification": "sans se laisser troubler ni dévier"
                            },
                            {
                                "target_lang_word": "impassiblement",
                                "target_lang_sense_clarification": "sans manifester d'émotion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}