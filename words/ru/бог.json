    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "73e582f8-91b0-3c3b-881c-5e90b3f3a1a8",
                    "sense_definition": "Единое верховное существо, создавшее мир и управляющее им (в монотеистических религиях).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deity_concept",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Верующие люди каждый день молятся <w>Богу</w> о здоровье близких.",
                            "target_lang_translations": {
                                "en": "Believers pray to <w>God</w> every day for the health of their loved ones.",
                                "zh": "信徒们每天都向<w>上帝</w>祈求亲人的健康。"
                            }
                        },
                        {
                            "text": "Слава <w>Богу</w>, мы успели на последний автобус и вернулись домой.",
                            "target_lang_translations": {
                                "en": "Thank <w>God</w>, we caught the last bus and returned home.",
                                "zh": "谢天谢地，我们赶上了最后一班公交车回到了家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Господь",
                        "Творец",
                        "Всевышний"
                    ],
                    "antonyms": [
                        "Сатана",
                        "дьявол"
                    ],
                    "common_phrases": [
                        "слава Богу",
                        "ради Бога",
                        "не дай Бог",
                        "с нами Бог",
                        "побойся Бога"
                    ],
                    "target_lang_definitions": {
                        "en": "The single supreme being who created the world and rules it (in monotheistic religions).",
                        "zh": "在单神教中，创造并主宰宇宙的唯一至高存在。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "God",
                                "target_lang_sense_clarification": "Supreme Being in monotheism"
                            },
                            {
                                "target_lang_word": "Lord",
                                "target_lang_sense_clarification": "religious title for God"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上帝",
                                "target_lang_sense_clarification": "单神教中的至高神"
                            },
                            {
                                "target_lang_word": "神",
                                "target_lang_sense_clarification": "对神灵的通用称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b69c09c-4f8a-3e99-adf2-3c256b1b677b",
                    "sense_definition": "Высшее сверхъестественное существо, объект поклонения в политеистических религиях и мифологии.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deity_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Древние греки строили величественные храмы своим <w>богам</w>.",
                            "target_lang_translations": {
                                "en": "Ancient Greeks built majestic temples for their <w>gods</w>.",
                                "zh": "古希腊人为他们的<w>神</w>建造了宏伟的庙宇。"
                            }
                        },
                        {
                            "text": "Марс — это римский <w>бог</w> войны, которого боялись и почитали.",
                            "target_lang_translations": {
                                "en": "Mars is the Roman <w>god</w> of war, whom people feared and revered.",
                                "zh": "玛尔斯是罗马的战<w>神</w>，人们对他既敬畏又崇拜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "божество"
                    ],
                    "antonyms": [
                        "человек"
                    ],
                    "common_phrases": [
                        "греческие боги",
                        "языческий бог",
                        "верить в богов"
                    ],
                    "target_lang_definitions": {
                        "en": "A higher supernatural being, an object of worship in polytheistic religions and mythology.",
                        "zh": "多神教或神话中，被崇拜的超自然存在。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "god",
                                "target_lang_sense_clarification": "deity in mythology"
                            },
                            {
                                "target_lang_word": "deity",
                                "target_lang_sense_clarification": "divine being"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神",
                                "target_lang_sense_clarification": "神话或多神教中的神灵"
                            },
                            {
                                "target_lang_word": "神祇",
                                "target_lang_sense_clarification": "对神灵的正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d27ea1a-3d3f-3209-b32c-cf2a8953156d",
                    "sense_definition": "Мастер высшей квалификации; человек, который делает что-то гениально.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой друг просто <w>бог</w> в программировании, он может решить любую задачу.",
                            "target_lang_translations": {
                                "en": "My friend is simply a <w>god</w> at programming; he can solve any task.",
                                "zh": "我朋友简直是编程界的<w>大神</w>，他能解决任何难题。"
                            }
                        },
                        {
                            "text": "Она готовит как <w>бог</w>, это самый вкусный ужин в моей жизни.",
                            "target_lang_translations": {
                                "en": "She cooks like a <w>god</w>; this is the most delicious dinner of my life.",
                                "zh": "她做饭简直是<w>神</w>一般的水平，这是我这辈子吃过最美味的晚餐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "спец",
                        "дока"
                    ],
                    "antonyms": [
                        "профан",
                        "дилетант"
                    ],
                    "common_phrases": [
                        "ты просто бог",
                        "бог кулинарии",
                        "играть как бог"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A highly qualified master; a person who does something brilliantly.",
                        "zh": "指在某领域技艺极其高超、达到天才级别的人。"
                    },
