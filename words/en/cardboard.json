{
    "word_family": [
        "card"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f0922a0b-fc9b-3ae8-8ca7-3d0562179fb1",
                    "sense_definition": "A stiff, thick paper material used for making boxes and signs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We packed all our books into a large <w>cardboard</w> box.",
                            "target_lang_translations": {
                                "cs": "Všechny naše knihy jsme zabalili do velké <w>kartonové</w> krabice."
                            }
                        },
                        {
                            "text": "The artist painted a beautiful landscape on a piece of <w>cardboard</w>.",
                            "target_lang_translations": {
                                "cs": "Umělec namaloval krásnou krajinu na kus <w>kartonu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "paperboard"
                    ],
                    "common_phrases": [
                        "cardboard box",
                        "cardboard carton"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pevný, silný papírový materiál používaný k výrobě krabic a cedulí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "karton",
                                "target_lang_sense_clarification": "běžný materiál pro výrobu obalů"
                            },
                            {
                                "target_lang_word": "lepenka",
                                "target_lang_sense_clarification": "silnější vrstvený papírový materiál"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4c5bcc3-c41a-359a-9c10-71f7dcfc8944",
                    "sense_definition": "Something that lacks depth, substance, or realism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain in the movie felt like a <w>cardboard</w> cutout with no real personality.",
                            "target_lang_translations": {
                                "cs": "Padouch ve filmu působil jako <w>kartonová</w> figurína bez skutečné osobnosti."
                            }
                        },
                        {
                            "text": "Without proper character development, the protagonist became nothing more than <w>cardboard</w>.",
                            "target_lang_translations": {
                                "cs": "Bez řádného vývoje postavy se hlavní hrdina stal jen <w>plochou figurkou</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "insubstantial",
                        "shallow"
                    ],
                    "antonyms": [
                        "realistic",
                        "complex"
                    ],
                    "common_phrases": [
                        "cardboard cutout"
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco, co postrádá hloubku, podstatu nebo realističnost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plochý",
                                "target_lang_sense_clarification": "přeneseně o postavě bez hloubky"
                            },
                            {
                                "target_lang_word": "bezbarvý",
                                "target_lang_sense_clarification": "postrádající charakter a zajímavost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                    "sense_definition": "Made of or resembling cardboard; lacking depth or flavor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor gave a <w>cardboard</w> performance that failed to move the audience.",
                            "target_lang_translations": {
                                "cs": "Herec podal <w>neživý</w> výkon, který diváky nedokázal dojmout."
                            }
                        },
                        {
                            "text": "The script was filled with <w>cardboard</w> characters who had no believable motivations.",
                            "target_lang_translations": {
                                "cs": "Scénář byl plný <w>plochých</w> postav, které neměly žádné uvěřitelné motivace."
                            }
                        }
                    ],
                    "synonyms": [
                        "stiff",
                        "lifeless"
                    ],
                    "antonyms": [
                        "vivid",
                        "lively"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyrobený z kartonu nebo připomínající karton; postrádající hloubku či živost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kartonový",
                                "target_lang_sense_clarification": "doslovný význam, vyrobený z kartonu"
                            },
                            {
                                "target_lang_word": "neživý",
                                "target_lang_sense_clarification": "přeneseně o výkonu nebo postavě"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}