                "senses": [
                    {
                        "sense_id": "f3e1f23a-c00f-399b-8804-ef5a92e2c970",
                        "entry_id": "cd7d4d70-c1d5-3b95-b0fe-c4468da5a385",
                        "glosses": [
                            "der elektrische Waren produzierende Teil der Wirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e5c65f-3b24-4e0b-ac4e-3e7d5eb7a9ec",
                                "sense_id": "f3e1f23a-c00f-399b-8804-ef5a92e2c970",
                                "text": "„Mehr als die Hälfte der Weltproduktion an metallenem Kupfer geht in die Elektroindustrie, vor allem zur Herstellung von Leitungen sowie in den Schalter-, Generatoren-, Motoren- und Transformatorenbau.“"
                            },
                            {
                                "example_id": "d44947f1-d7bc-4fba-9c7f-96893f136c1f",
                                "sense_id": "f3e1f23a-c00f-399b-8804-ef5a92e2c970",
                                "text": "„Die Eisen- und Stahlindustrie war demgegenüber eine alte Branche, deren Innovationspotential nicht mit dem Automobilbau, aber auch nicht mit dem der Chemie- oder der Elektroindustrie vergleichbar war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
