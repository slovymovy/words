                "senses": [
                    {
                        "sense_id": "f1e8200a-5219-3464-ba61-d2182ff9cf94",
                        "entry_id": "35a84e1d-417d-3c1b-8450-b188c92d4ff5",
                        "glosses": [
                            "alle fünf Minuten tritt etwas neu ein; alle fünf Minuten wiederholt sich etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0af946-430d-4aa4-a770-15f07d23ba17",
                                "sense_id": "f1e8200a-5219-3464-ba61-d2182ff9cf94",
                                "text": "„Nach Östermalm nimmt er die Tunnelbana, mit der man im Fünfminutentakt jeden Ort auf dem Stadtarchipel rasch erreicht.“"
                            },
                            {
                                "example_id": "9b473534-7cb6-48a3-b17e-49fcf2078920",
                                "sense_id": "f1e8200a-5219-3464-ba61-d2182ff9cf94",
                                "text": "„Klassische Adrenalinschübe (Bootstrip zum Weißen Hai!) wechseln sich im Fünfminutentakt mit idyllischer Ruhe ab, denn auch im wildesten Hinterland Südafrikas steht immer ein frisch dekorierter Tisch mit gestärkter Decke und Rosenblättern herum, auf dem eisgekühlter Champagner wartet.“"
                            },
                            {
                                "example_id": "fc33fe7c-dd4a-4746-afc0-17a4218997f0",
                                "sense_id": "f1e8200a-5219-3464-ba61-d2182ff9cf94",
                                "text": "„Irgendwo harrt bereits eine treue Lesergemeinde der skurrilen Wortwechsel, die sie gleich im Fünfminutentakt durch das Internet jagen wird.“"
                            },
                            {
                                "example_id": "f8d8e5d8-3100-4189-ba4d-70e507e8001e",
                                "sense_id": "f1e8200a-5219-3464-ba61-d2182ff9cf94",
                                "text": "„[..] Anders ausgedrückt: Wenn Schulmediziner ihre Patienten im Fünfminutentakt durch die Behandlungszimmer schleusen und ihnen nur wenig Aufmerksamkeit widmen, verschenken sie einen wesentlichen Teil ihrer therapeutischen Wirkung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
