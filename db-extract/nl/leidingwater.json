                        "source_sense_id": "7656861c-fb20-342e-8c63-d474fca9fe05",
                        "target_lang_word": "Leitungswasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leitungswasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                                        "entry_id": "b267da8a-27f5-3a24-8df4-6816a62b692b",
                                        "glosses": [
                                            "Wasser, das aus der Leitung kommt beziehungsweise dorthin eingeleitet wird und sich darin befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfb5652-2efc-4517-956f-2a68836d9a79",
                                                "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                                                "text": "Sind die Leitungsrohre schlecht saniert, so kann man nicht nur mit einem Verlust von rund 30 Prozent an Leitungswasser rechnen, sondern auch mit dessen Verschmutzung durch das Eindringen von Bodensubstanzen in die Rohre."
                                            },
                                            {
                                                "example_id": "e90cb5b5-fd66-4574-8eda-553b3d84e088",
                                                "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                                                "text": "„Bei akuten Verbrennungen ist das wichtigste Gegenmittel kaltes Leitungswasser.“"
                                            },
                                            {
                                                "example_id": "9aebe32c-8e31-4201-a38a-35baff4b231c",
                                                "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                                                "text": "„Im Harz ist das Leitungswasser eher weich, im Teutoburger Wald eher hart.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1b05019-e4ab-4e7a-bbb4-fb3b62effa82",
                        "source_entry_id": "1a6eeb7e-0f5f-3b11-8b73-921564f7bf98",
                        "source_sense_id": "7656861c-fb20-342e-8c63-d474fca9fe05",
                        "target_lang_word": "tap water",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tap water",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aad19bfe-632e-3fa3-91d5-e98e85647d31",
                                        "entry_id": "78f29050-6cb6-30ae-88a3-d82e39629775",
                                        "glosses": [
                                            "Water that comes from a tap."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae65059f-ecaa-4fe0-8b16-a7167399f81b",
                                                "sense_id": "aad19bfe-632e-3fa3-91d5-e98e85647d31",
                                                "text": "Near-synonym: drinking water"
                                            },
                                            {
                                                "example_id": "6b70b0b7-5fbb-4290-973d-b57a785df198",
                                                "sense_id": "aad19bfe-632e-3fa3-91d5-e98e85647d31",
                                                "text": "We all want tap water always to be potable water, but ensuring this equivalence takes work and commitment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbda6b0f-421c-3bcb-ac80-710231e5a2d0",
                                        "entry_id": "78f29050-6cb6-30ae-88a3-d82e39629775",
                                        "glosses": [
                                            "The state of having water available from taps."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5621d161-c70b-4515-9f34-2c69ae410898",
                                                "sense_id": "dbda6b0f-421c-3bcb-ac80-710231e5a2d0",
                                                "text": "Although we lived in the city, we didn't have tap water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7932e84a-34fa-4707-aaba-d121b87ab8a3",
                        "source_entry_id": "1a6eeb7e-0f5f-3b11-8b73-921564f7bf98",
                        "source_sense_id": "7656861c-fb20-342e-8c63-d474fca9fe05",
                        "target_lang_word": "eau du robinet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau du robinet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b95e2a26-7343-38b4-9f18-9ea4b75d7fa4",
                                        "entry_id": "d165fff1-d384-31f5-95b5-c1548f5229a4",
                                        "glosses": [
                                            "Eau potable distribuée par un réseau de canalisations depuis le captage jusqu’aux utilisateurs finaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94549fc0-7afa-4741-83fb-9efd685fc408",
                                                "sense_id": "b95e2a26-7343-38b4-9f18-9ea4b75d7fa4",
                                                "text": "Il nous faut donc boire au minimum 1,5 litre d’eau par jour sous quelque forme que ce soit ( eau du robinet, thé, café, eau gazeuse… ) pour compenser les pertes hydriques. Boire abondamment est essentiel pour la santé et la forme."
                                            },
                                            {
                                                "example_id": "fc66abf5-b912-4318-b81a-3522d9a6042e",
                                                "sense_id": "b95e2a26-7343-38b4-9f18-9ea4b75d7fa4",
                                                "text": "La consommation d’eau en bouteille ne cesse de croître depuis plusieurs années, dans un contexte où la qualité de l’eau du robinet, telle qu’elle est perçue par le consommateur, se dégrade."
                                            }
                                        ]
                                    }
                                ]
                            }
