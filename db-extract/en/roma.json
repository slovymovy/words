                    {
                        "sense_id": "9fc165b6-66a4-32fe-9feb-cb289db5d39f",
                        "entry_id": "ccf28a5c-874c-33cc-9de5-23e17f0fed03",
                        "glosses": [
                            "Alternative form of Rome:",
                            "A major city, the capital of Italy and the Italian region of Lazio, located on the Tiber River; the ancient capital of the Roman Empire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b030f41e-00a5-4eef-b5af-d4ff7904e755",
                                "sense_id": "9fc165b6-66a4-32fe-9feb-cb289db5d39f",
                                "text": "But it would have been so nice to have a private income, and to be able sometimes to go to Venezia, Firenze, Roma, those places with the beautiful names."
                            },
                            {
                                "example_id": "f4eb8ced-9751-4834-9a2c-7ae3e62fd41e",
                                "sense_id": "9fc165b6-66a4-32fe-9feb-cb289db5d39f",
                                "text": "At Neapolis there was chaos as those who could flee Roma came to this port seeking escape."
                            }
                        ]
