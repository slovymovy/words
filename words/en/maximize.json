{
    "word_family": [
        "maximum",
        "maximal",
        "maximization",
        "maximizer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ebeaea84-5a9f-3a25-aa3a-0738b22dab9b",
                    "sense_definition": "To increase something to the greatest possible amount, degree, or importance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is looking for new ways to <w>maximize</w> profits this quarter.",
                            "target_lang_translations": {
                                "ru": "Компания ищет новые способы <w>максимизировать</w> прибыль в этом квартале."
                            }
                        },
                        {
                            "text": "You should try to <w>maximize</w> efficiency by organizing your workspace better.",
                            "target_lang_translations": {
                                "ru": "Вам следует постараться <w>максимально повысить</w> эффективность, лучше организовав свое рабочее пространство."
                            }
                        },
                        {
                            "text": "Athletes often use specific training programs to <w>maximize</w> potential and reach their peak performance.",
                            "target_lang_translations": {
                                "ru": "Спортсмены часто используют специальные программы тренировок, чтобы <w>максимально раскрыть</w> свой потенциал и достичь пика формы."
                            }
                        }
                    ],
                    "synonyms": [
                        "optimize",
                        "increase",
                        "boost"
                    ],
                    "antonyms": [
                        "minimize"
                    ],
                    "common_phrases": [
                        "maximize profits",
                        "maximize efficiency",
                        "maximize potential",
                        "maximize impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать что-либо до максимально возможного количества, степени или значимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "максимизировать",
                                "target_lang_sense_clarification": "доводить до максимума"
                            },
                            {
                                "target_lang_word": "увеличивать максимально",
                                "target_lang_sense_clarification": "делать как можно больше"
                            },
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "улучшать показатели или эффективность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce282fb7-ea40-316e-a505-85e5516a6c53",
                    "sense_definition": "To expand a window on a computer screen so that it fills the entire display area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the text is too small, you can <w>maximize</w> the window to see it more clearly.",
                            "target_lang_translations": {
                                "ru": "Если текст слишком мелкий, вы можете <w>развернуть</w> окно, чтобы видеть его четче."
                            }
                        },
                        {
                            "text": "Please <w>maximize</w> screen space by closing any applications you are not currently using.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>максимизируйте</w> экранное пространство, закрыв все приложения, которыми вы сейчас не пользуетесь."
                            }
                        },
                        {
                            "text": "I usually <w>maximize</w> the browser so that the desktop background is no longer visible.",
                            "target_lang_translations": {
                                "ru": "Обычно я <w>разворачиваю</w> браузер на весь экран, чтобы фон рабочего стола больше не был виден."
                            }
                        }
                    ],
                    "synonyms": [
                        "expand"
                    ],
                    "antonyms": [
                        "minimize"
                    ],
                    "common_phrases": [
                        "maximize the window",
                        "maximize screen space"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Развернуть окно на экране компьютера так, чтобы оно заполнило всю область дисплея."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разворачивать",
                                "target_lang_sense_clarification": "окно на весь экран"
                            },
                            {
                                "target_lang_word": "развернуть",
                                "target_lang_sense_clarification": "компьютерное окно"
                            },
                            {
                                "target_lang_word": "максимизировать",
                                "target_lang_sense_clarification": "в интерфейсе программ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}