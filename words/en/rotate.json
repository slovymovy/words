{
    "word_family": [
        "rotation",
        "rotational",
        "rotator",
        "rotatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40469875-d81f-355e-a049-3a36e4870be8",
                    "sense_definition": "To turn or spin around a central point or axis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "turning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Earth <w>rotates</w> on its axis once every twenty-four hours.",
                            "target_lang_translations": {
                                "ru": "Земля <w>вращается</w> вокруг своей оси каждые двадцать четыре часа.",
                                "zh": "地球每二十四小时绕其轴线<w>旋转</w>一周。"
                            }
                        },
                        {
                            "text": "He <w>rotated</w> slowly in his chair to face the window.",
                            "target_lang_translations": {
                                "ru": "Он медленно <w>повернулся</w> в кресле лицом к окну.",
                                "zh": "他坐在椅子上慢慢<w>转动</w>，面向窗户。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revolve"
                    ],
                    "common_phrases": [
                        "rotate on axis",
                        "slowly rotate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращаться или крутиться вокруг центральной точки или оси.",
                        "zh": "围绕中心点或轴线转动或旋转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враща́ться",
                                "target_lang_sense_clarification": "совершать круговое движение вокруг оси"
                            },
                            {
                                "target_lang_word": "верте́ться",
                                "target_lang_sense_clarification": "находиться в круговом движении"
                            },
                            {
                                "target_lang_word": "крути́ться",
                                "target_lang_sense_clarification": "двигаться по кругу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旋转",
                                "target_lang_sense_clarification": "物体围绕一个轴或中心点做圆周运动"
                            },
                            {
                                "target_lang_word": "转动",
                                "target_lang_sense_clarification": "物体绕某一点或轴线运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae48717e-8610-3d26-8cd4-350586e58732",
                    "sense_definition": "To move or turn something around a fixed point.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "turning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>rotate</w> the dial to the right to increase the volume.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>поверните</w> ручку вправо, чтобы увеличить громкость.",
                                "zh": "请向右<w>转动</w>旋钮以调大音量。"
                            }
                        },
                        {
                            "text": "You can <w>rotate</w> the image on your screen using the mouse.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>вращать</w> изображение на экране с помощью мыши.",
                                "zh": "你可以使用鼠标<w>旋转</w>屏幕上的图像。"
                            }
                        }
                    ],
                    "synonyms": [
                        "circumvolve"
                    ],
                    "common_phrases": [
                        "rotate the dial",
                        "rotate the image"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать или поворачивать что-либо вокруг фиксированной точки.",
                        "zh": "使某物围绕固定点移动或转动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враща́ть",
                                "target_lang_sense_clarification": "приводить в круговое движение"
                            },
                            {
                                "target_lang_word": "повора́чивать",
                                "target_lang_sense_clarification": "менять положение объекта в пространстве"
                            },
                            {
                                "target_lang_word": "верте́ть",
                                "target_lang_sense_clarification": "крутить в разные стороны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转动",
                                "target_lang_sense_clarification": "使物体绕轴心运动"
                            },
                            {
                                "target_lang_word": "旋转",
                                "target_lang_sense_clarification": "改变物体在空间中的方向或位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb26fa46-963b-31d3-b88e-d62ddd5d5550",
                    "sense_definition": "To change or take turns in a regular, repeating order.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The staff <w>rotate</w> shifts every month to ensure everyone works weekends.",
                            "target_lang_translations": {
                                "ru": "Сотрудники <w>меняются</w> сменами каждый месяц, чтобы все работали по выходным.",
                                "zh": "员工每月<w>轮换</w>一次班次，以确保每个人都能轮到周末工作。"
                            }
                        },
                        {
                            "text": "We <w>rotate</w> duties so that no one has to do the same job every day.",
                            "target_lang_translations": {
                                "ru": "Мы <w>чередуем</w> обязанности, чтобы никому не приходилось делать одну и ту же работу каждый день.",
                                "zh": "我们<w>轮换</w>职责，这样就没人需要每天做同样的工作了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revolve"
                    ],
                    "common_phrases": [
                        "rotate shifts",
                        "rotate duties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меняться или чередоваться в регулярном, повторяющемся порядке.",
                        "zh": "按规律或重复的顺序轮换或交替。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сменя́ться",
                                "target_lang_sense_clarification": "чередоваться по очереди"
                            },
                            {
                                "target_lang_word": "чередова́ться",
                                "target_lang_sense_clarification": "следовать один за другим по кругу"
                            },
                            {
                                "target_lang_word": "рабо́тать по сме́нам",
                                "target_lang_sense_clarification": "о графике работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮换",
                                "target_lang_sense_clarification": "按顺序交替进行"
                            },
                            {
                                "target_lang_word": "交替",
                                "target_lang_sense_clarification": "轮流替换"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cf2502c-8378-36bd-b352-884ab6cfa88a",
                    "sense_definition": "To move older items to the front so they are used before newer ones.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to <w>rotate</w> stock in the pantry to avoid food waste.",
                            "target_lang_translations": {
                                "ru": "Важно <w>ротировать</w> запасы в кладовой, чтобы избежать порчи продуктов.",
                                "zh": "为了避免食物浪费，对食品储藏室的库存进行<w>轮换</w>非常重要。"
                            }
                        },
                        {
                            "text": "The grocery store employees <w>rotate</w> the milk cartons daily.",
                            "target_lang_translations": {
                                "ru": "Сотрудники продуктового магазина ежедневно <w>переставляют</w> пакеты с молоком.",
                                "zh": "杂货店员工每天都会对牛奶盒进行<w>轮换</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rotate stock",
                        "rotate inventory"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in retail and inventory management"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещать старые товары вперед, чтобы они были использованы раньше новых.",
                        "zh": "将旧的库存移到前面，以便先于新产品使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роти́ровать",
                                "target_lang_sense_clarification": "проводить ротацию товаров"
                            },
                            {
                                "target_lang_word": "обновля́ть",
                                "target_lang_sense_clarification": "переставлять товары для соблюдения сроков годности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮换",
                                "target_lang_sense_clarification": "指库存商品的周转管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b9fd9c5-dbc2-337b-a546-153e1e64cd6a",
                    "sense_definition": "To grow different types of crops in the same area in sequential seasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers <w>rotate</w> crops to keep the soil healthy and fertile.",
                            "target_lang_translations": {
                                "ru": "Фермеры <w>чередуют</w> культуры, чтобы почва оставалась здоровой и плодородной.",
                                "zh": "农民通过<w>轮作</w>来保持土壤健康和肥沃。"
                            }
                        },
                        {
                            "text": "If you <w>rotate</w> your vegetables, you will have fewer pests in the garden.",
                            "target_lang_translations": {
                                "ru": "Если вы будете <w>чередовать</w> овощи, в саду будет меньше вредителей.",
                                "zh": "如果你对蔬菜进行<w>轮作</w>，花园里的害虫就会减少。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rotate crops"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in agricultural contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выращивать различные виды сельскохозяйственных культур на одном и том же участке в последовательные сезоны.",
                        "zh": "在同一区域内按季节顺序种植不同类型的农作物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чередова́ть",
                                "target_lang_sense_clarification": "менять культуры на поле"
                            },
                            {
                                "target_lang_word": "соблюда́ть севооборо́т",
                                "target_lang_sense_clarification": "сельскохозяйственный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮作",
                                "target_lang_sense_clarification": "农业术语，指在同一块土地上按顺序种植不同作物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e734c9c0-0991-37b7-8649-5ac899d021e5",
                    "sense_definition": "To lift the nose of an aircraft during the takeoff roll.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot began to <w>rotate</w> the plane as it reached the required speed.",
                            "target_lang_translations": {
                                "ru": "Пилот начал <w>поднимать нос</w> самолета, когда тот достиг необходимой скорости.",
                                "zh": "飞机达到规定速度时，飞行员开始<w>抬前轮</w>。"
                            }
                        },
                        {
                            "text": "The aircraft <w>rotates</w> at sixty knots just before leaving the ground.",
                            "target_lang_translations": {
                                "ru": "Самолет <w>отрывает нос</w> на скорости шестьдесят узлов непосредственно перед взлетом.",
                                "zh": "飞机在离地前一刻以六十节的速度<w>抬前轮</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rotate for takeoff"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Technical term used in aviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать нос самолета во время разбега при взлете.",
                        "zh": "飞机在起飞滑跑时抬起机头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднима́ть нос",
                                "target_lang_sense_clarification": "в авиации при взлете"
                            },
                            {
                                "target_lang_word": "выполня́ть рота́цию",
                                "target_lang_sense_clarification": "технический термин взлета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抬前轮",
                                "target_lang_sense_clarification": "航空术语，指起飞时抬起机头"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e237e8d-7239-3045-845d-5eb4c77418bf",
                    "sense_definition": "Having parts that spread out from a center like the spokes of a wheel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist identified the flower by its distinct <w>rotate</w> corolla.",
                            "target_lang_translations": {
                                "ru": "Ботаник идентифицировал цветок по его характерному <w>колесовидному</w> венчику.",
                                "zh": "植物学家通过其独特的<w>轮状</w>花冠识别出了这种花。"
                            }
                        },
                        {
                            "text": "Under the microscope, the <w>rotate</w> scale appeared perfectly symmetrical.",
                            "target_lang_translations": {
                                "ru": "Под микроскопом <w>лучевидная</w> чешуйка казалась идеально симметричной.",
                                "zh": "在显微镜下，这片<w>轮状</w>鳞片看起来非常对称。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rotate corolla"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Technical term used in botany and biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий части, расходящиеся от центра, подобно спицам колеса.",
                        "zh": "具有从中心向外扩散的部分，类似于车轮的辐条。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колесови́дный",
                                "target_lang_sense_clarification": "о форме венчика цветка"
                            },
                            {
                                "target_lang_word": "лучево́й",
                                "target_lang_sense_clarification": "расходящийся из центра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮状",
                                "target_lang_sense_clarification": "形容形状像轮子一样向外辐射"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}