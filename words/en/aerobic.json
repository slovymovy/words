{
    "word_family": [
        "aerobics",
        "aerobically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92d38003-d446-3ab6-88a3-d8ebe40ba295",
                    "sense_definition": "Relating to physical exercises that increase the heart rate and oxygen consumption.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She does <w>aerobic</w> exercise three times a week.",
                            "target_lang_translations": {
                                "zh": "她每周做三次<w>有氧</w>运动。"
                            }
                        },
                        {
                            "text": "He joined an <w>aerobic</w> fitness class at the gym.",
                            "target_lang_translations": {
                                "zh": "他在健身房参加了一个<w>有氧</w>健身班。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "aerobic exercise",
                        "aerobic class"
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过增加心率和氧气消耗来锻炼身体的运动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有氧的",
                                "target_lang_sense_clarification": "形容与有氧运动相关的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10eab95c-c7d2-344b-ab1e-da2488c8e2dd",
                    "sense_definition": "Requiring or occurring in the presence of oxygen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bacteria require an <w>aerobic</w> environment to grow.",
                            "target_lang_translations": {
                                "zh": "这种细菌需要在<w>需氧</w>环境下才能生长。"
                            }
                        },
                        {
                            "text": "These organisms are strictly <w>aerobic</w> and cannot survive without oxygen.",
                            "target_lang_translations": {
                                "zh": "这些生物是严格<w>需氧</w>的，没有氧气就无法生存。"
                            }
                        }
                    ],
                    "antonyms": [
                        "anaerobic"
                    ],
                    "target_lang_definitions": {
                        "zh": "指需要氧气或在有氧气存在的情况下发生的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "需氧的",
                                "target_lang_sense_clarification": "生物学中指必须在有氧环境下生存的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}