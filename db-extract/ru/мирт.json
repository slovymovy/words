                    {
                        "translation_id": "f5742bcb-e45e-4457-a282-f2a176e5430d",
                        "source_entry_id": "a4c6637d-768f-30bb-a618-be8056968621",
                        "source_sense_description": "растение",
                        "target_lang_word": "myrte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myrte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cbabc53-f864-384b-beff-a33752257d7b",
                                        "entry_id": "f9ded7d6-5e3e-3af6-9cd8-9a7f8e042dda",
                                        "glosses": [
                                            "Nom vulgaire des arbrisseaux du genre Myrtus, de la famille des Myrtacées (Myrtaceae)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23e42285-e035-34b9-b522-2445c6265ecd",
                                        "entry_id": "f9ded7d6-5e3e-3af6-9cd8-9a7f8e042dda",
                                        "glosses": [
                                            "Nom usuel de Myrtus communis — myrte commun —, arbuste originaire du pourtour méditerranéen dont le fruits nommé myrte est comestible."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf2a1dd5-97dc-46fc-8f3d-6e4dd6b8babd",
                                                "sense_id": "23e42285-e035-34b9-b522-2445c6265ecd",
                                                "text": "Par dessus les buissons de myrte on apercevait des moissonneurs bleus dans les céréales de cuivre et des passantes sur la route."
                                            },
                                            {
                                                "example_id": "7c43b7d8-4630-4379-ad0e-cceb7dd1227e",
                                                "sense_id": "23e42285-e035-34b9-b522-2445c6265ecd",
                                                "text": "Voilà pourquoi nous nous tenions tous, à ce moment, près de la haie des myrtes qui séparait la cour de la grande allée du parc, domptant notre timidité pour admirer, avec une impudence voulue, les étrangères."
                                            },
                                            {
                                                "example_id": "399b9483-a404-4864-aaa4-6126e0175b2e",
                                                "sense_id": "23e42285-e035-34b9-b522-2445c6265ecd",
                                                "text": "Là-dessus, elle me contait, avec l’accent de la passion, comment elle avait découvert parmi les personnages peints aux flancs d’une loutrophore un joueur de flûte couronné de myrte et comment ce myrte portait des boutons à fleur, ce qui créait un fait nouveau dans l’histoire du myrte considéré comme le symbole de la gloire."
                                            },
                                            {
                                                "example_id": "9410f697-c68f-423e-bc91-015ec6b3f38d",
                                                "sense_id": "23e42285-e035-34b9-b522-2445c6265ecd",
                                                "text": "Entre les hauts-plateaux et les massifs montagneux de l'intérieur et le sahel côtier, où les steppes de palmiers nains alternaient avec de vastes maquis de lentisques, de jujubiers, de myrtes et de genêts, les plaines subatlantiques déployaient leur immense paillasson poussiéreux, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee1fe9d8-4fc1-3e51-9c6c-f335391068be",
                                        "entry_id": "f9ded7d6-5e3e-3af6-9cd8-9a7f8e042dda",
                                        "glosses": [
                                            "Nom donné à de nombreux arbrisseaux et arbustes généralement à feuilles persistantes et aromatiques sans que ceux-ci ne soient du genre Myrtus ni même de la famille des Myrtaceae (Myrtacées), en regarder la liste ci-dessous au chapitre «dérivés»."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48d09f24-d97d-3ff0-aa51-7e5d0ee54a31",
                                        "entry_id": "f9ded7d6-5e3e-3af6-9cd8-9a7f8e042dda",
                                        "glosses": [
                                            "L’amour, du fait que le myrte, chez les anciens, était consacré à Vénus."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "941d3890-09e7-4c49-baf5-bf57a76e0217",
                                                "sense_id": "48d09f24-d97d-3ff0-aa51-7e5d0ee54a31",
                                                "text": "Plante d’Aphrodite, symbole d’amour et de désir, le myrte était dans la Grèce antique le symbole des amoureux mais aussi du pouvoir."
                                            },
                                            {
                                                "example_id": "c55cd317-a649-4ffe-98dc-7047298dbdab",
                                                "sense_id": "48d09f24-d97d-3ff0-aa51-7e5d0ee54a31",
                                                "text": "Votre époux à son myrte ajoute ce laurier."
                                            },
                                            {
                                                "example_id": "8ab3bff9-65bb-4449-9f61-abc96e6a44a9",
                                                "sense_id": "48d09f24-d97d-3ff0-aa51-7e5d0ee54a31",
                                                "text": "Va du myrte amoureux ceindre sa tête altière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b8067a-8a8f-3abe-94c1-42f2c7b25594",
                                        "entry_id": "f9ded7d6-5e3e-3af6-9cd8-9a7f8e042dda",
                                        "glosses": [
                                            "Liqueur violacée extraite des baies de myrte ou de ses feuilles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01f95997-f4c6-386e-90b2-d5eed365a535",
                                        "entry_id": "f9ded7d6-5e3e-3af6-9cd8-9a7f8e042dda",
                                        "glosses": [
                                            "Alcool blanc ou légèrement teinté, fabriqué en Corse et en Sardaigne à base de baies de myrte et titrant généralement 30°."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
