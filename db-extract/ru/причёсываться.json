                "senses": [
                    {
                        "sense_id": "609988ea-684c-32dc-a2ea-3e0078c7d53b",
                        "entry_id": "25e2e16f-528a-30ae-be6c-782fa21be661",
                        "glosses": [
                            "причёсывать себе волосы; делать себе причёску"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b49cf3f4-20c5-4018-a48b-cad36dde29f2",
                                "sense_id": "609988ea-684c-32dc-a2ea-3e0078c7d53b",
                                "text": "По петухам встаёшь, по солнцу ложишься, сосновой шишкой причёсываешься."
                            },
                            {
                                "example_id": "94cd9bfa-6de6-477a-aa15-ebc4b1202031",
                                "sense_id": "609988ea-684c-32dc-a2ea-3e0078c7d53b",
                                "text": "Волосы послушно укладываются, когда я причёсываюсь."
                            },
                            {
                                "example_id": "f81a61b1-9ea2-458c-82fd-bd27f68e1548",
                                "sense_id": "609988ea-684c-32dc-a2ea-3e0078c7d53b",
                                "text": "Я умылся. Причёсываясь перед зеркалом, всмотрелся в отражение. Красные глаза, опухшие веки."
                            }
                        ]
                    },
