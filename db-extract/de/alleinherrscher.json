                        "form": "dem Alleinherrscher"
                    },
                    {
                        "form_id": "3dc3c88d-c8d5-4781-bae4-adab4d7ee81b",
                        "entry_id": "579897f5-f03c-3441-b910-cea96d6f3f0f",
                        "tags": [
                            "dative",
