                        "inférieur à la moyenne"
                    ]
                },
                {
                    "sense_id": "890a344e-cbfe-3732-aa8e-2c9b5101a534",
                    "sense_definition": "Qui est plus petit ou égal par rapport à une valeur numérique donnée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nombre choisi par le joueur doit être strictement <w>inférieur</w> à cent."
                        },
                        {
                            "text": "Le score final est resté <w>inférieur</w> ou égal au niveau attendu."
