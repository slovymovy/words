                "senses": [
                    {
                        "sense_id": "7a6c7123-ee95-3fcc-8364-afc35e41b264",
                        "entry_id": "61dc7d06-983e-3325-92b4-3844a6a80439",
                        "glosses": [
                            "Qui veut tout."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "note": "cet adjectif sert généralement à qualifier une divinité, un dieux",
                        "examples": [
                            {
                                "example_id": "abee854e-24b6-438d-b3cb-76e6d26f9c61",
                                "sense_id": "7a6c7123-ee95-3fcc-8364-afc35e41b264",
                                "text": "Dieu est omniscient et omnipuissant, mais il n'est pas, à proprement parler , « omnivoulant » , car la volonté divine désigne une causalité actuelle."
                            },
                            {
                                "example_id": "6ce7b106-1925-482b-aefe-19007fdedd67",
                                "sense_id": "7a6c7123-ee95-3fcc-8364-afc35e41b264",
                                "text": "En conséquence, Dieu est quelqu’un qui légifère, qui est omnipotent, omniscient, omnivoulant, qui est maître absolu du bien et du mal, le bien et mal n’ayant pas de réalité ontologique, puisque c’est Dieu qui donne aux actes leur coloration de bonté ou de malice."
                            },
                            {
                                "example_id": "8ce03baf-c926-4dc7-b24c-611d8b59c702",
                                "sense_id": "7a6c7123-ee95-3fcc-8364-afc35e41b264",
                                "text": "O rodomontades de l’argile ! l’homme qui prétend à l’action par ses deux livres de matière pensantes, écrasée à tout moment par cette volonté omnivoulante."
                            }
                        ]
                    }
