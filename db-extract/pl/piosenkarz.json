                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a079b80-ee0e-4ab8-8a5f-2c9971766b74",
                        "source_entry_id": "6a0d821f-8b86-338a-936f-048c92e7bf37",
                        "source_sense_id": "6163497a-5ed9-3818-80fe-ca1fa6de2576",
                        "target_lang_word": "Sänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                        "entry_id": "681c4869-1d0e-3efd-82cd-f91a6f12c897",
                                        "glosses": [
                                            "jemand, der singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85ff160-b948-47ce-9c51-080ca90014aa",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "Wer war nochmal der Sänger von diesem Lied?"
                                            },
                                            {
                                                "example_id": "540e7a85-7672-4227-ac99-d011955a010f",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "Es gibt nicht so viele Rapper, Sänger und Bands, die positive Werte vertreten."
                                            },
                                            {
                                                "example_id": "e21f7da2-6e1f-47fe-badb-7dd999d0b99a",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "„Herausforderung für die Sänger […] Zurzeit hat der Kammerchor 35 Sängerinnen und Sänger. Für das neue Projekt werden weitere gesucht. ‚Mein Traum wäre es, wenn wir 48 Sänger zusammenbekommen‘, sagt Lehmann.“"
                                            },
                                            {
                                                "example_id": "7705b044-8c3e-4aff-b1a7-54046b6f198e",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "„Der Trommler, ein hagerer, gut aussehender Soldat von etwa vierzig Jahren, brach bei den letzten Worten nach soldatischer Art kurz ab, machte eine Handbewegung, als schleudere er etwas auf die Erde, warf den übrigen Sängern einen strengen Blick zu und schloss für einen Moment die Augen.“"
                                            },
                                            {
                                                "example_id": "9ff678a9-ebe3-4805-92f1-97f573a76250",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "„Ein Sänger singt bei einem Agenten eine Arie vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04f9f7ba-d8fc-3724-bfc6-7d293ed8ce9d",
                                        "entry_id": "681c4869-1d0e-3efd-82cd-f91a6f12c897",
                                        "glosses": [
                                            "ein Vogel, der singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f7a943-00a2-4a60-9c86-d0bbf9aeefe9",
                                                "sense_id": "04f9f7ba-d8fc-3724-bfc6-7d293ed8ce9d",
                                                "text": "Zebrafinken: Laute Sänger haben bei Weibchen Vorteile."
                                            },
                                            {
                                                "example_id": "8278ddcc-13fa-4318-a2b3-6ecca19006d0",
                                                "sense_id": "04f9f7ba-d8fc-3724-bfc6-7d293ed8ce9d",
                                                "text": "Sie ist die Königin der Sänger, die Nachtigall."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01223d43-8070-4b24-8922-4d4c041bd21d",
                        "source_entry_id": "6a0d821f-8b86-338a-936f-048c92e7bf37",
                        "source_sense_id": "6163497a-5ed9-3818-80fe-ca1fa6de2576",
                        "target_lang_word": "певец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "певец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53760c7b-ba1a-3035-b87b-b99ec5f6cfce",
                                        "entry_id": "fa08cffd-aeca-3eb1-a2eb-f85b2c85b2a0",
                                        "glosses": [
                                            "тот, кто поёт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e4507f-0064-4d9c-8f72-0f5b46063bce",
                                                "sense_id": "53760c7b-ba1a-3035-b87b-b99ec5f6cfce",
                                                "text": "В тех местах, где жаворонков много, от трелей невидимых певцов точно звенит и журчит само голубое небо."
                                            },
                                            {
                                                "example_id": "e93c5cf2-c1fd-4a56-b5e5-fd225f873ecb",
                                                "sense_id": "53760c7b-ba1a-3035-b87b-b99ec5f6cfce",
                                                "text": "Не обрывая песни, немного пригасив голос, певец улыбнулся нам, но мы не обратили на его улыбку никакого внимания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868cc1d0-28ea-3ab5-a2e9-4d8702f30dd9",
                                        "entry_id": "fa08cffd-aeca-3eb1-a2eb-f85b2c85b2a0",
                                        "glosses": [
                                            "артист, выступающий в вокальном жанре"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c9fc16-146b-4ef8-accd-a9ead67b0839",
                                                "sense_id": "868cc1d0-28ea-3ab5-a2e9-4d8702f30dd9",
                                                "text": "В коллективе шесть инструменталистов, два певца и десять танцовщиков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed85a778-d223-3b2f-a2d1-264a98a5db45",
                                        "entry_id": "fa08cffd-aeca-3eb1-a2eb-f85b2c85b2a0",
                                        "glosses": [
                                            "перен., с род. п. человек, который воспевает, прославляет, хвалит кого-либо или что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff14f85-a81e-4a76-8702-554a99ec8df0",
                                                "sense_id": "ed85a778-d223-3b2f-a2d1-264a98a5db45",
                                                "text": "Киплинга многие считали певцом колониализма."
                                            },
                                            {
                                                "example_id": "88d8a701-d555-4017-82bb-4d0b096ca8e5",
                                                "sense_id": "ed85a778-d223-3b2f-a2d1-264a98a5db45",
                                                "text": "Певец свободы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d11257-eb23-372f-9945-b969fbff4fb1",
                                        "entry_id": "fa08cffd-aeca-3eb1-a2eb-f85b2c85b2a0",
                                        "glosses": [
                                            "трад.-поэт. тот, кто воспевает, прославляет кого-, что-либо в своих произведениях; поэт"
                                        ],
