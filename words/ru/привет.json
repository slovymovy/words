{
    "word_family": [
        "приветствовать",
        "приветствие",
        "приветливый",
        "приветливо"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "1f5d8688-2132-386c-a143-6fcf771387a4",
                    "sense_definition": "Неформальное дружеское приветствие, которое говорят при встрече.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Привет</w>, я так рад тебя видеть!",
                            "target_lang_translations": {
                                "en": "<w>Hi</w>, I am so glad to see you!",
                                "zh": "<w>你好</w>，见到你真高兴！"
                            }
                        },
                        {
                            "text": "<w>Привет</w>, как прошли твои выходные?",
                            "target_lang_translations": {
                                "en": "<w>Hi</w>, how was your weekend?",
                                "zh": "<w>你好</w>，你的周末过得怎么样？"
                            }
                        }
                    ],
                    "synonyms": [
                        "здра́вствуй",
                        "здоро́во",
                        "салют"
                    ],
                    "antonyms": [
                        "пока",
                        "до встречи"
                    ],
                    "common_phrases": [
                        "всем привет",
                        "большой привет"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used with friends, family, or peers"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal friendly greeting used when meeting someone.",
                        "zh": "一种非正式的、友好的见面问候语。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hi",
                                "target_lang_sense_clarification": "informal greeting"
                            },
                            {
                                "target_lang_word": "hello",
                                "target_lang_sense_clarification": "standard greeting"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "你好",
                                "target_lang_sense_clarification": "通用问候语"
                            },
                            {
                                "target_lang_word": "嘿",
                                "target_lang_sense_clarification": "非正式问候语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c298e7d-30e6-3702-8076-52496241ec36",
                    "sense_definition": "Слова, выражающие дружелюбие и добрые пожелания, часто передаваемые кому-либо через другого человека.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не забудь передать <w>привет</w> своей сестре.",
                            "target_lang_translations": {
                                "en": "Don't forget to say <w>hello</w> to your sister.",
                                "zh": "别忘了替我向你妹妹<w>问好</w>。"
                            }
                        },
                        {
                            "text": "Он прислал мне тёплый <w>привет</w> в письме.",
                            "target_lang_translations": {
                                "en": "He sent me warm <w>greetings</w> in the letter.",
                                "zh": "他在信中向我表达了亲切的<w>问候</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "передать привет",
                        "пламенный привет",
                        "шлю привет"
                    ],
                    "target_lang_definitions": {
                        "en": "Words expressing friendliness and good wishes, often conveyed to someone through another person.",
                        "zh": "表达友好和良好祝愿的话语，通常通过他人转达。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regards",
                                "target_lang_sense_clarification": "good wishes sent to someone"
                            },
                            {
                                "target_lang_word": "greetings",
                                "target_lang_sense_clarification": "message of friendliness"
                            },
                            {
                                "target_lang_word": "hello",
                                "target_lang_sense_clarification": "used in phrases like 'say hello to'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问候",
                                "target_lang_sense_clarification": "表达友好的信息"
                            },
                            {
                                "target_lang_word": "代好",
                                "target_lang_sense_clarification": "转达问候"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}