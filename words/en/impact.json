{
    "word_family": [
        "impaction",
        "impactor",
        "impactive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9559e9d-1ced-30ec-b431-3b9c5d19c6db",
                    "sense_definition": "A significant or strong influence or effect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our choice of concrete will have a tremendous <w>impact</w> on the building's mechanical performance.",
                            "target_lang_translations": {
                                "ru": "Наш выбор бетона окажет огромное <w>влияние</w> на механические характеристики здания.",
                                "tr": "Beton seçimimiz binanın mekanik performansı üzerinde büyük bir <w>etki</w> yaratacaktır."
                            }
                        },
                        {
                            "text": "One way to reduce the environmental <w>impact</w> of meat eating is to make livestock more productive.",
                            "target_lang_translations": {
                                "ru": "Один из способов снизить <w>воздействие</w> потребления мяса на окружающую среду — повысить продуктивность животноводства.",
                                "tr": "Et yemenin çevresel <w>etkisini</w> azaltmanın bir yolu, hayvancılığı daha verimli hale getirmektir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have an impact",
                        "significant impact",
                        "environmental impact",
                        "negative impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное влияние или воздействие на кого-либо или что-либо.",
                        "tr": "Güçlü bir etki, tesir veya sonuç."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влияние",
                                "target_lang_sense_clarification": "действие, оказываемое на кого-либо или что-либо"
                            },
                            {
                                "target_lang_word": "воздействие",
                                "target_lang_sense_clarification": "сильное, активное влияние"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "etki",
                                "target_lang_sense_clarification": "bir şeyin başka bir şey üzerindeki gücü veya sonucu"
                            },
                            {
                                "target_lang_word": "tesir",
                                "target_lang_sense_clarification": "etki, nüfuz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a70b3b65-56e7-3da2-bef0-60fd417103ae",
                    "sense_definition": "The striking of one body against another; collision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hatchet cut the wood on <w>impact</w>.",
                            "target_lang_translations": {
                                "ru": "Топор разрубил дерево при <w>ударе</w>.",
                                "tr": "Nacak, <w>çarpma</w> anında odunu kesti."
                            }
                        },
                        {
                            "text": "The car was completely destroyed upon <w>impact</w> with the wall.",
                            "target_lang_translations": {
                                "ru": "Автомобиль был полностью уничтожен при <w>столкновении</w> со стеной.",
                                "tr": "Araba duvara <w>çarpma</w> anında tamamen tahrip oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "percussion"
                    ],
                    "common_phrases": [
                        "on impact",
                        "point of impact",
                        "survive the impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Столкновение одного тела с другим; физический удар.",
                        "tr": "Bir cismin diğerine şiddetle çarpması; çarpışma veya vuruş."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "резкий толчок при столкновении"
                            },
                            {
                                "target_lang_word": "столкновение",
                                "target_lang_sense_clarification": "соприкосновение предметов в движении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çarpma",
                                "target_lang_sense_clarification": "iki nesnenin birbirine vurması veya çarpışması"
                            },
                            {
                                "target_lang_word": "vuruş",
                                "target_lang_sense_clarification": "şiddetli temas, darbe"
                            },
                            {
                                "target_lang_word": "darbe",
                                "target_lang_sense_clarification": "çarpışma sonucu oluşan fiziksel etki"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ffd15e4-c18e-3976-b28c-dac0c18614ba",
                    "sense_definition": "To significantly or strongly influence or affect.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can make the changes, but it will <w>impact</w> the schedule.",
                            "target_lang_translations": {
                                "ru": "Я могу внести изменения, но это <w>повлияет</w> на график.",
                                "tr": "Değişiklikleri yapabilirim ama bu programı <w>etkileyecektir</w>."
                            }
                        },
                        {
                            "text": "The new regulations will directly <w>impact</w> how small businesses operate.",
                            "target_lang_translations": {
                                "ru": "Новые правила напрямую <w>повлияют</w> на то, как работает малый бизнес.",
                                "tr": "Yeni düzenlemeler küçük işletmelerin nasıl faaliyet gösterdiğini doğrudan <w>etkileyecek</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "impact the environment",
                        "impact the outcome",
                        "impact the economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать сильное влияние или воздействие.",
                        "tr": "Önemli ölçüde veya güçlü bir şekilde etkilemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влиять",
                                "target_lang_sense_clarification": "оказывать воздействие"
                            },
                            {
                                "target_lang_word": "сказываться",
                                "target_lang_sense_clarification": "иметь последствия, отражаться на чем-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "etkilemek",
                                "target_lang_sense_clarification": "üzerinde etki veya değişiklik oluşturmak"
                            },
                            {
                                "target_lang_word": "tesir etmek",
                                "target_lang_sense_clarification": "etki göstermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfa7afba-7b40-32c3-8748-ac6c97b70b12",
                    "sense_definition": "To collide or strike with force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the hammer <w>impacts</w> the nail, it bends.",
                            "target_lang_translations": {
                                "ru": "Когда молоток <w>ударяет</w> по гвоздю, тот гнется.",
                                "tr": "Çekiç çiviye <w>vurduğunda</w> çivi bükülür."
                            }
                        },
                        {
                            "text": "The asteroid is predicted to <w>impact</w> the planet in the distant future.",
                            "target_lang_translations": {
                                "ru": "Прогнозируется, что астероид <w>столкнется</w> с планетой в далеком будущем.",
                                "tr": "Asteroidin uzak gelecekte gezegene <w>çarpacağı</w> tahmin ediliyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "impact the surface",
                        "impact the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударяться или сталкиваться с силой.",
                        "tr": "Şiddetle çarpmak veya vurmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударяться",
                                "target_lang_sense_clarification": "биться обо что-то"
                            },
                            {
                                "target_lang_word": "сталкиваться",
                                "target_lang_sense_clarification": "врезаться при движении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çarpmak",
                                "target_lang_sense_clarification": "bir şeye şiddetle vurmak veya değmek"
                            },
                            {
                                "target_lang_word": "vurmak",
                                "target_lang_sense_clarification": "darbe indirmek, hızlıca değmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}