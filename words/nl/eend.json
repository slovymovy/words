                {
                    "sense_id": "4c2b6cf2-2699-370c-80c5-74e5a7ba0a9c",
                    "sense_definition": "Het vrouwtje van een eendensoort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lente kun je de woerd en de <w>eend</w> makkelijk uit elkaar houden door hun kleuren.",
                            "target_lang_translations": {
                                "ru": "Весной можно легко отличить селезня от <w>утки</w> по их окраске.",
                                "en": "In spring, you can easily tell the drake and the <w>duck</w> apart by their colors.",
                                "pl": "Wiosną można łatwo odróżnić kaczora od <w>kaczki</w> po ich ubarwieniu.",
                                "de": "Im Frühling kann man den Erpel und die <w>Ente</w> leicht an ihren Farben voneinander unterscheiden.",
                                "fr": "Au printemps, on peut facilement distinguer le canard mâle et la <w>cane</w> grâce à leurs couleurs.",
                                "it": "In primavera si possono facilmente distinguere il maschio e l' <w>anatra</w> dai loro colori.",
                                "cs": "Na jaře můžete kačera a <w>kachnu</w> snadno rozeznat podle jejich barev.",
                                "tr": "İlkbaharda yeşilbaş ile <w>dişi ördeği</w> renklerinden dolayı birbirinden kolayca ayırt edebilirsiniz.",
                                "es": "En primavera se puede distinguir fácilmente al ánade macho de la <w>pata</w> por sus colores."
                            }
                        },
                        {
                            "text": "De <w>eend</w> zorgt voor de kuikens terwijl het mannetje de wacht houdt.",
                            "target_lang_translations": {
                                "ru": "<w>Утка</w> заботится о птенцах, пока самец стоит на страже.",
                                "en": "The <w>duck</w> takes care of the chicks while the male keeps watch.",
                                "pl": "<w>Kaczka</w> opiekuje się pisklętami, podczas gdy samiec stoi na straży.",
                                "de": "Die <w>Ente</w> sorgt für die Küken, während das Männchen Wache hält.",
                                "fr": "La <w>cane</w> s'occupe des canetons pendant que le mâle fait le guet.",
                                "it": "L' <w>anatra</w> si prende cura dei pulcini mentre il maschio fa la guardia.",
                                "cs": "<w>Kachna</w> se stará o mláďata, zatímco samec hlídá.",
                                "tr": "Erkek nöbet tutarken, <w>dişi ördek</w> yavrularla ilgilenir.",
                                "es": "La <w>pata</w> cuida de los polluelos mientras el macho vigila."
                            }
                        }
                    ],
