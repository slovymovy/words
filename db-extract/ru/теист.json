                    }
                ],
                "senses": [
                    {
                        "sense_id": "70971b5f-32ff-3166-902e-8852743d505b",
                        "entry_id": "028dae66-0546-3eb7-986f-72678db23e33",
                        "glosses": [
                            "филос. последователь теизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7af24b8f-4226-4997-8322-086b014b8504",
                                "sense_id": "70971b5f-32ff-3166-902e-8852743d505b",
                                "text": "Религию имеют и атеисты, хотя, конечно, вероисповедание их другое, чем у теистов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25e7cef7-1a4c-401f-9ac9-2da300493d22",
                        "source_entry_id": "028dae66-0546-3eb7-986f-72678db23e33",
                        "source_sense_id": "70971b5f-32ff-3166-902e-8852743d505b",
                        "target_lang_word": "theist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                        "entry_id": "6012326d-a607-3e0a-8cd8-92aefda75ff9",
                                        "glosses": [
                                            "One who believes in the existence of a god or gods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e132cce2-61b4-423b-b13b-0a61cb2e1424",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "The term stands in contradistinction to theism which, in its widest sense, means belief in a personal god, goddess, gods and /or goddesses."
                                            },
                                            {
                                                "example_id": "e0dbafb1-555c-4574-bffa-1c5739220175",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "The theist is a man firmly persuaded of the existence of a Supreme Being as good as He is powerful, who has formed all beings with extension, vegetating, sentient and reflecting; who perpetuates their species, who punishes crimes without cruelty, and rewards virtuous actions with kindness."
                                            },
                                            {
                                                "example_id": "556b1f78-27d3-42f7-954c-9339f89fdc07",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "[…] and I call him a theist who believes in any God."
                                            },
                                            {
                                                "example_id": "4c4c9f02-d0ee-4228-9bb9-e708597183b9",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "No one is to be called a Theist, who does not believe in a Personal God, whatever difficulty there may be in defining the word \"Personal.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ea1b8b5-58a0-4461-8269-8746198f8b79",
                        "source_entry_id": "028dae66-0546-3eb7-986f-72678db23e33",
