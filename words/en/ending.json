{
    "word_family": [
        "end",
        "endless",
        "unending"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "188277b3-fa4f-361d-a86e-553aa7a4e0f6",
                    "sense_definition": "The last part of a story, film, event, or life.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie had a very happy <w>ending</w>.",
                            "target_lang_translations": {
                                "ru": "У фильма был очень счастливый <w>конец</w>.",
                                "zh": "这部电影有一个非常快乐的<w>结局</w>。"
                            }
                        },
                        {
                            "text": "I did not expect the surprise <w>ending</w> of the book.",
                            "target_lang_translations": {
                                "ru": "Я не ожидал такой неожиданной <w>концовки</w> книги.",
                                "zh": "我没想到这本书会有这样一个出人意料的<w>结尾</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "end",
                        "finale",
                        "conclusion",
                        "finish"
                    ],
                    "antonyms": [
                        "beginning",
                        "start"
                    ],
                    "common_phrases": [
                        "happy ending",
                        "sad ending",
                        "surprise ending"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последняя часть истории, фильма, события или жизни.",
                        "zh": "故事、电影、事件或生命的最后部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конец",
                                "target_lang_sense_clarification": "общий термин; завершение истории или жизни"
                            },
                            {
                                "target_lang_word": "концовка",
                                "target_lang_sense_clarification": "заключительная часть сюжета книги или фильма"
                            },
                            {
                                "target_lang_word": "финал",
                                "target_lang_sense_clarification": "завершение события или произведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结局",
                                "target_lang_sense_clarification": "故事或电影的最后情节"
                            },
                            {
                                "target_lang_word": "结尾",
                                "target_lang_sense_clarification": "作品或事件的最后部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b28ea14-f65e-384d-98c5-a810cbcaa194",
                    "sense_definition": "A termination or conclusion of a process or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>ending</w> of the contract caused problems.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>прекращение</w> контракта вызвало проблемы.",
                                "zh": "合同的突然<w>终止</w>引发了问题。"
                            }
                        },
                        {
                            "text": "We celebrated the <w>ending</w> of the long project.",
                            "target_lang_translations": {
                                "ru": "Мы отпраздновали <w>завершение</w> долгого проекта.",
                                "zh": "我们庆祝了这个长期项目的<w>结束</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "termination",
                        "conclusion"
                    ],
                    "antonyms": [
                        "beginning",
                        "inception"
                    ],
                    "common_phrases": [
                        "abrupt ending",
                        "sudden ending"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращение или завершение процесса или ситуации.",
                        "zh": "过程或情况的终止或结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершение",
                                "target_lang_sense_clarification": "доведение дела или процесса до конца"
                            },
                            {
                                "target_lang_word": "окончание",
                                "target_lang_sense_clarification": "истечение срока; формальное завершение"
                            },
                            {
                                "target_lang_word": "прекращение",
                                "target_lang_sense_clarification": "остановка действия или процесса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "过程或状态的终结"
                            },
                            {
                                "target_lang_word": "终止",
                                "target_lang_sense_clarification": "正式或突然的停止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b11427e-6468-3f58-bc0d-e936cdac1226",
                    "sense_definition": "The last part of a word, added to a base to make an inflected form.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must add the correct <w>ending</w> to the verb.",
                            "target_lang_translations": {
                                "ru": "Вы должны добавить к глаголу правильное <w>окончание</w>.",
                                "zh": "你必须给动词加上正确的<w>词尾</w>。"
                            }
                        },
                        {
                            "text": "In English, the plural <w>ending</w> is usually 's'.",
                            "target_lang_translations": {
                                "ru": "В английском языке <w>окончание</w> множественного числа — это обычно 's'.",
                                "zh": "在英语中，复数<w>词尾</w>通常是“s”。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suffix"
                    ],
                    "antonyms": [
                        "prefix"
                    ],
                    "common_phrases": [
                        "verb ending",
                        "plural ending"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последняя часть слова, добавляемая к основе для образования словоформы.",
                        "zh": "词语的最后部分，加在词根上以构成变体形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окончание",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "词尾",
                                "target_lang_sense_clarification": "语法上的词语末尾部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e818be25-6397-3166-a025-64fd15c26dad",
                    "sense_definition": "Present participle and gerund of <w>end</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert is <w>ending</w> right now.",
                            "target_lang_translations": {
                                "ru": "Концерт прямо сейчас <w>заканчивается</w>.",
                                "zh": "音乐会现在就要<w>结束</w>了。"
                            }
                        },
                        {
                            "text": "He is <w>ending</w> the call with a goodbye.",
                            "target_lang_translations": {
                                "ru": "Он <w>завершает</w> звонок прощанием.",
                                "zh": "他正以一句再见来<w>结束</w>通话。"
                            }
                        }
                    ],
                    "antonyms": [
                        "starting",
                        "beginning"
                    ],
                    "common_phrases": [
                        "ending soon",
                        "never-ending"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>end</w>.",
                        "zh": "动词 end 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заканчивать",
                                "target_lang_sense_clarification": "доводить до конца"
                            },
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "оканчивать выполнение чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "使某事停止"
                            },
                            {
                                "target_lang_word": "终止",
                                "target_lang_sense_clarification": "使某过程停止"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}