        "fr-extract.jsonl": [
            {
                "entry_id": "3c345ed7-4308-36ff-a34d-7e3da010baf8",
                "word": "stérilisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "015a4898-9e31-47c0-bdb6-eb78e38de6fc",
                        "entry_id": "3c345ed7-4308-36ff-a34d-7e3da010baf8",
                        "tags": [
                            "plural"
                        ],
