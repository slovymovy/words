                    {
                        "sense_id": "948b8a88-d993-3b28-8c7d-033f0ac88c4b",
                        "entry_id": "6440d2ea-7ee6-310b-9624-3de911a4f051",
                        "glosses": [
                            "der Wunsch oder das Verlangen nach Vorsicht, so dass nichts Unerwünschtes geschehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86979380-34cb-4bc2-be5a-88c2464e5344",
                                "sense_id": "948b8a88-d993-3b28-8c7d-033f0ac88c4b",
                                "text": "„Mit meinem Sicherheitsbedürfnis hatte ich mich schnell als Deutsche geoutet, die allzeit auf das Schlimmste gefasst oder zumindest darauf vorbereitet sein will.“"
                            },
                            {
                                "example_id": "d8ce82ff-d229-4663-bf23-26871b63386f",
                                "sense_id": "948b8a88-d993-3b28-8c7d-033f0ac88c4b",
                                "text": "„Ich vermute stark, dass auch das geliebte Sicherheitsbedürfnis der Deutschen mehr und mehr in den Hintergrund treten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
