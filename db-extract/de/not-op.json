                "senses": [
                    {
                        "sense_id": "8ed4dfb8-a60b-3d02-a63c-7863361f0d9f",
                        "entry_id": "16e9bd00-eb18-3b52-b284-e41e2d24127c",
                        "glosses": [
                            "kurz für Notoperation/Not-Operation; hastig eingeleitete OP (Operation), um einer Person im letzten Moment das Leben zu retten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64b8d70-22c9-405e-ab77-089916399ffa",
                                "sense_id": "8ed4dfb8-a60b-3d02-a63c-7863361f0d9f",
                                "text": "„Das blutende Opfer kommt mit Messerwunden in eine Klinik, ihm wird in einer Not-OP das Leben gerettet.“"
                            },
                            {
                                "example_id": "a993f784-31c5-4107-b3d2-f055c397bd78",
                                "sense_id": "8ed4dfb8-a60b-3d02-a63c-7863361f0d9f",
                                "text": "„Fieber, künstliche Ernährung, entzündeter Darm: James Last musste sich einer dreistündigen Not-OP unterziehen.“"
                            },
                            {
                                "example_id": "fe2b568e-7355-4148-b7e3-54b4ea53ea1b",
                                "sense_id": "8ed4dfb8-a60b-3d02-a63c-7863361f0d9f",
                                "text": "„Geplante Operationen seien abgesagt worden, Not-OPs werde es aber geben, teilte Verdi mit.“"
                            },
                            {
                                "example_id": "3f024bad-fe21-4327-a5cf-f6f257c382cf",
                                "sense_id": "8ed4dfb8-a60b-3d02-a63c-7863361f0d9f",
                                "text": "„Heutzutage wird eine Vollnarkose beim Kaiserschnitt nur dann eingesetzt, wenn es sich um eine Not-OP handelt oder wenn bei den Müttern aus anderen Gründen eine Regionalanästhesie (entweder als sogenannte Periduralanästhesie PDA oder Spinalanästhesie) nicht in Frage kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
