                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d50a870-05ff-4080-9243-a3961e56ceb0",
                                "sense_id": "2c6407c7-8506-323b-b242-485b74042a66",
                                "text": "Hoewel er in het Nieuwe Testament vaak sprake is van het ”zoeken van de vrede”, is ook dit gedeelte van het Woord van God niet antimilitaristisch. Paulus acht het een goddelijke verplichting dat een overheid „het zwaard draagt”, en dat is niet tevergeefs (zonder reden)."
                            },
                            {
                                "example_id": "e8df2af5-a04c-45e8-990d-7ae45e3641bf",
                                "sense_id": "2c6407c7-8506-323b-b242-485b74042a66",
                                "text": "Deze antimilitaristische partij met een gematigd socialistisch karakter ging na de Tweede Wereldoorlog, in 1946, grotendeels op in de Partij van de Arbeid."
                            }
                        ]
