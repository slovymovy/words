{
    "word_family": [
        "ель",
        "еловый",
        "ельник"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a5706ea-9f0f-3aa8-b470-b11b7dc26955",
                    "sense_definition": "Высокое хвойное вечнозелёное дерево с конусообразной кроной и шишками",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В лесу росла высокая <w>ёлка</w>.",
                            "target_lang_translations": {
                                "de": "Im Wald wuchs eine hohe <w>Tanne</w>."
                            }
                        },
                        {
                            "text": "Зимой <w>ёлка</w> остаётся зелёной.",
                            "target_lang_translations": {
                                "de": "Im Winter bleibt die <w>Tanne</w> grün."
                            }
                        }
                    ],
                    "synonyms": [
                        "ель"
                    ],
                    "common_phrases": [
                        "стройная ёлка",
                        "зелёная ёлка"
                    ],
                    "target_lang_definitions": {
                        "de": "Hoher, immergrüner Nadelbaum mit kegelförmiger Krone und Zapfen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Tanne",
                                "target_lang_sense_clarification": "Allgemeine Bezeichnung für Nadelbäume dieser Art."
                            },
                            {
                                "target_lang_word": "Fichte",
                                "target_lang_sense_clarification": "Die botanisch präzisere Entsprechung für die russische 'ель'."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2accdf9-a32f-3134-9710-4b22454e69d5",
                    "sense_definition": "Дерево, украшенное к празднику Нового года или Рождества",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети нарядили <w>ёлку</w> яркими игрушками.",
                            "target_lang_translations": {
                                "de": "Die Kinder schmückten den <w>Weihnachtsbaum</w> mit bunten Anhängern."
                            }
                        },
                        {
                            "text": "Под <w>ёлкой</w> лежали подарки для всей семьи.",
                            "target_lang_translations": {
                                "de": "Unter dem <w>Weihnachtsbaum</w> lagen Geschenke für die ganze Familie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "наряжать ёлку",
                        "новогодняя ёлка"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Baum, der zu Weihnachten oder Neujahr festlich geschmückt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Weihnachtsbaum",
                                "target_lang_sense_clarification": "Der übliche Begriff für einen geschmückten Baum zu Weihnachten."
                            },
                            {
                                "target_lang_word": "Tannenbaum",
                                "target_lang_sense_clarification": "Synonym für Weihnachtsbaum, oft in Liedern oder im allgemeinen Sprachgebrauch verwendet."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffbfe852-4825-384d-9f57-75ff499cb970",
                    "sense_definition": "Детский праздник с танцами и играми вокруг украшенной ели",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы пошли с детьми на праздничную <w>ёлку</w> в театр.",
                            "target_lang_translations": {
                                "de": "Wir gingen mit den Kindern zu einer <w>Weihnachtsfeier</w> ins Theater."
                            }
                        },
                        {
                            "text": "На <w>ёлке</w> было много весёлых конкурсов и подарков.",
                            "target_lang_translations": {
                                "de": "Auf der <w>Weihnachtsfeier</w> gab es viele lustige Wettbewerbe und Geschenke."
                            }
                        }
                    ],
                    "common_phrases": [
                        "пойти на ёлку",
                        "детская ёлка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи для обозначения мероприятия"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine festliche Veranstaltung für Kinder mit Tanz und Spielen rund um einen geschmückten Baum."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Weihnachtsfeier",
                                "target_lang_sense_clarification": "Allgemeine Bezeichnung für eine Feier anlässlich des Weihnachtsfestes."
                            },
                            {
                                "target_lang_word": "Kinderweihnachtsfeier",
                                "target_lang_sense_clarification": "Spezifische Bezeichnung für eine Weihnachtsfeier, die speziell für Kinder ausgerichtet ist."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}