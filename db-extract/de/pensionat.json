                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5164bdec-ae8f-402b-a628-5a826af17fe2",
                        "source_entry_id": "3fe2486e-b098-3f20-9e8d-806ae36bd3b8",
                        "source_sense_id": "1ee3cd01-71a8-3c29-86d5-b7f7e0ab9d20",
                        "source_sense_description": "Lehranstalt mit Unterbringungsmöglichkeit; Schule mit angeschlossenem Internat",
                        "target_lang_word": "pensionnat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pensionnat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efde0bf8-d23e-37f0-89c2-c19657ec05d9",
                                        "entry_id": "98928b0e-4e99-37d6-ba5d-d359f61c09c7",
                                        "glosses": [
                                            "Établissement particulier où l’on prend en pension des enfants de l’un ou de l’autre sexe pour les instruire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f0959c-05ee-4870-a95c-d80b7ab60a79",
                                                "sense_id": "efde0bf8-d23e-37f0-89c2-c19657ec05d9",
                                                "text": "Pensionnat de jeunes filles."
                                            },
                                            {
                                                "example_id": "0e75f8b3-201b-43c5-a0f9-6ceaf5fae0bd",
                                                "sense_id": "efde0bf8-d23e-37f0-89c2-c19657ec05d9",
                                                "text": "L’hôtel Béraud, bâti vers le commencement du dix-septième siècle, était une de ces constructions carrées (…) qu’on loue à des pensionnats, à des fabricants d’eau de Seltz, à des entrepositaires de vins et d’alcools"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9777cf4a-215e-3b3e-bb16-690c650a456c",
                                        "entry_id": "98928b0e-4e99-37d6-ba5d-d359f61c09c7",
                                        "glosses": [
                                            "Ensemble des élèves de cet établissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce9717c8-9f46-43eb-9b40-231f97b99749",
                                                "sense_id": "9777cf4a-215e-3b3e-bb16-690c650a456c",
                                                "text": "La chapelle était presque pleine ; un pensionnat de jeunes filles voilées de blanc emplissait un côté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
