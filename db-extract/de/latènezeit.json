                ],
                "senses": [
                    {
                        "sense_id": "0647e5f2-3730-3ee9-a0a3-5f107209f00e",
                        "entry_id": "0a7ae87e-7b7f-3392-a15b-6e6a4e8f32a9",
                        "glosses": [
                            "Epoche der Menschheitsgeschichte, etwa vom 5. bis 1. Jahrhundert vor Christus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b706c4d1-28cf-4f62-a8a5-5fd3e3d6d370",
                                "sense_id": "0647e5f2-3730-3ee9-a0a3-5f107209f00e",
                                "text": "„Die in Hallstatt bzw. in La Tène gemachten Funde waren so typisch für ihre Zeit, daß die Namen Hallstatt- und Latènezeit auch auf weitere Funde außerhalb dieser beiden Orte übertragen wurden.“"
                            },
                            {
                                "example_id": "0d39a3bc-2c27-4ebb-a054-e232757715e6",
                                "sense_id": "0647e5f2-3730-3ee9-a0a3-5f107209f00e",
                                "text": "„Die Latènezeit hat ihren Namen nach einer Fundstelle im Neuenburger See in der Schweiz.“"
                            },
                            {
                                "example_id": "bcf728cd-b0b5-4e79-8dc3-0e2c257be76a",
                                "sense_id": "0647e5f2-3730-3ee9-a0a3-5f107209f00e",
                                "text": "„In den Jahren 2009 und 2010 kamen im Zuge von Renaturierungsmaßnahmen am Flussbett Fibeln vom Ende der Hallstattzeit und vom Beginn der Latènezeit zutage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
