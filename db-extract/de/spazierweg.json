                "senses": [
                    {
                        "sense_id": "22166c40-48b9-3d26-93fc-65639ccfd986",
                        "entry_id": "f9e4b79c-16e0-3669-9147-903367f50d6f",
                        "glosses": [
                            "angenehmer Weg (in reizvoller Umgebung), der zu Spaziergängen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b6af29-bdbe-4005-b9c5-e9219eca23c3",
                                "sense_id": "22166c40-48b9-3d26-93fc-65639ccfd986",
                                "text": "„Auf der anderen Seite, hinter dem Zaun, gehen zwei Frauen mit ihren Hunden auf dem Spazierweg Richtung Geltow vorbei.“"
                            },
                            {
                                "example_id": "36e5f9c9-7286-4bec-97bd-3c5eca53ed03",
                                "sense_id": "22166c40-48b9-3d26-93fc-65639ccfd986",
                                "text": "„Bei bürgerlichen Preisen und günstigen klimatischen Verhältnissen in Sommer und Winter bieten sich Spazierwege von mehreren tausend Kilometern Länge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
