                "senses": [
                    {
                        "sense_id": "9e96bd50-f72c-3145-a423-80e343c05806",
                        "entry_id": "2a801029-0138-3ace-aecc-a284ef57f88f",
                        "glosses": [
                            "Heft mit Comicgeschichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf0d6922-d7c5-4593-93ae-1553c36c9468",
                                "sense_id": "9e96bd50-f72c-3145-a423-80e343c05806",
                                "text": "„Wie eine Gedankenblase in einem Comicheft hängt dort der Herzdefibrillator.“"
                            },
                            {
                                "example_id": "8fc5e95b-725d-49f9-8816-4c7f4887443d",
                                "sense_id": "9e96bd50-f72c-3145-a423-80e343c05806",
                                "text": "„Ich bin kein missverstandener Mutant aus einem Comicheft oder Horrorfilm, obwohl mancher mich als solchen behandelt hat.“"
                            },
                            {
                                "example_id": "65bb84b5-642f-4eea-b668-48f5e5cf4cfe",
                                "sense_id": "9e96bd50-f72c-3145-a423-80e343c05806",
                                "text": "„Sie verhätschelte sie und lobte sie schon für so einfache Dinge wie das Aufschlagen eines Comicheftes.“"
                            },
                            {
                                "example_id": "828efa5a-a0eb-43c9-9d3a-c8eb33f1170e",
                                "sense_id": "9e96bd50-f72c-3145-a423-80e343c05806",
                                "text": "„Er umklammerte sein Comicheft wie eine Schmusedecke, rollte es zusammen und quetschte es, bis die Seiten ganz zerknittert waren und das Titelblatt einriss.“"
                            },
                            {
                                "example_id": "eb157f9e-7908-4b81-9749-f32b38fb2da0",
                                "sense_id": "9e96bd50-f72c-3145-a423-80e343c05806",
                                "text": "„›Superman, Sonderheft zum fünfundzwanzigjährigen Jubiläum? Ganz billig!‹ sagte er und hielt Chin ein zerfleddertes Comicheft vor die Nase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
