                        "translation_id": "45b8eab1-edbc-415c-aac7-da9a25274d07",
                        "source_entry_id": "2450b817-92e8-346c-a407-949f2e2ccf62",
                        "source_sense_description": "pertaining to Shakespeare or his works",
                        "target_lang_word": "shakespearien",
