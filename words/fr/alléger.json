    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea0591cc-2d37-38b6-8dd2-2aa754935db1",
                    "sense_definition": "Rendre moins lourd en ôtant une partie du poids ou de la charge matérielle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>alléger</w> nos bagages avant d'embarquer pour ce long voyage."
                        },
                        {
                            "text": "L'équipage a jeté de la cargaison à la mer pour <w>alléger</w> le navire en détresse."
                        }
                    ],
                    "synonyms": [
                        "désalourdir"
                    ],
                    "antonyms": [
                        "alourdir"
                    ],
                    "common_phrases": [
                        "alléger la charge",
                        "alléger le sac"
                    ]
                },
                {
                    "sense_id": "7204b3ad-ec40-3b54-9762-e10cf5e62d24",
                    "sense_definition": "Rendre moins pénible, atténuer ou diminuer une contrainte morale, physique ou financière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attenuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce traitement médical permet d'<w>alléger</w> la douleur des patients après une intervention chirurgicale."
                        },
                        {
                            "text": "Le gouvernement a décidé d'<w>alléger</w> les impôts pour stimuler la consommation des ménages."
                        }
                    ],
                    "synonyms": [
                        "atténuer",
                        "soulager"
                    ],
                    "antonyms": [
                        "alourdir"
                    ],
                    "common_phrases": [
                        "alléger la douleur",
                        "alléger les impôts"
                    ]
                },
                {
                    "sense_id": "08bb585d-f867-39af-aa99-a5dea28802b5",
                    "sense_definition": "Rendre un cheval plus léger de l'avant ou de l'arrière selon l'assiette du cavalier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En se penchant légèrement vers l'avant, la cavalière parvient à <w>alléger</w> le dos du cheval."
                        },
                        {
                            "text": "Le cavalier ajuste sa position sur la selle afin d'<w>alléger</w> l'avant-main de sa monture."
                        }
                    ]
                }
            ]
        }
