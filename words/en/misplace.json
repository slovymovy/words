{
    "word_family": [
        "misplacement",
        "placement",
        "place"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16c8d85f-b75b-39ba-835c-5bdd58e94546",
                    "sense_definition": "To put something somewhere and then forget its location",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "losing items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I often <w>misplace</w> my keys when I am in a hurry to leave the house.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>закладываю</w> куда-то ключи, когда спешу выйти из дома."
                            }
                        },
                        {
                            "text": "If you <w>misplace</w> your wallet, you should check the pockets of your jacket first.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>положили не на место</w> свой кошелек, сначала проверьте карманы куртки."
                            }
                        }
                    ],
                    "synonyms": [
                        "mislay"
                    ],
                    "antonyms": [
                        "find",
                        "locate"
                    ],
                    "common_phrases": [
                        "misplace my keys",
                        "misplace your wallet",
                        "misplace the remote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить вещь куда-либо и забыть, где она находится"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заложить",
                                "target_lang_sense_clarification": "положить вещь и забыть куда"
                            },
                            {
                                "target_lang_word": "засунуть",
                                "target_lang_sense_clarification": "положить так, что трудно найти"
                            },
                            {
                                "target_lang_word": "затерять",
                                "target_lang_sense_clarification": "потерять среди других вещей"
                            },
                            {
                                "target_lang_word": "положить не на место",
                                "target_lang_sense_clarification": "оставить вещь в непривычном месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb0e3ef2-720a-3d0e-8e56-6abc5e344c20",
                    "sense_definition": "To put something in the wrong location or position",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incorrect positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>misplace</w> a comma in a long and complex sentence.",
                            "target_lang_translations": {
                                "ru": "В длинном и сложном предложении легко <w>неправильно поставить</w> запятую."
                            }
                        },
                        {
                            "text": "The librarian noticed that someone had <w>misplaced</w> the book on the wrong shelf.",
                            "target_lang_translations": {
                                "ru": "Библиотекарь заметил, что кто-то <w>поставил</w> книгу <w>не на ту</w> полку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "misplace a comma",
                        "misplace the accent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить что-либо в неправильное место или положение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставить не туда",
                                "target_lang_sense_clarification": "о предметах на полках или в ряду"
                            },
                            {
                                "target_lang_word": "перепутать место",
                                "target_lang_sense_clarification": "о расположении элементов"
                            },
                            {
                                "target_lang_word": "неправильно поставить",
                                "target_lang_sense_clarification": "о знаках препинания или ударении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38b52492-5911-3a1f-bd58-cf511d67d86f",
                    "sense_definition": "To direct or apply one's feelings, trust, or talents inappropriately",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "misdirected application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He realized too late that he had <w>misplaced</w> his trust in a dishonest partner.",
                            "target_lang_translations": {
                                "ru": "Он слишком поздно понял, что <w>напрасно доверился</w> нечестному партнеру."
                            }
                        },
                        {
                            "text": "The critic argued that the director had <w>misplaced</w> his talents on such a weak script.",
                            "target_lang_translations": {
                                "ru": "Критик утверждал, что режиссер <w>растратил</w> свой талант на такой слабый сценарий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "misplace your trust",
                        "misplace your confidence",
                        "misplaced sense of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять чувства, доверие или таланты на неподходящий объект"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрасно довериться",
                                "target_lang_sense_clarification": "о неоправданном доверии"
                            },
                            {
                                "target_lang_word": "растрачивать",
                                "target_lang_sense_clarification": "о талантах, примененных неверно"
                            },
                            {
                                "target_lang_word": "ошибочно направить",
                                "target_lang_sense_clarification": "о чувствах или усилиях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}