                                        "glosses": [
                                            "A supporter or follower of François-Noël Babeuf or his ideas, including universal equal income and the abolition of private property."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2873d3bc-aa95-4130-b508-2416e59f887a",
                                                "sense_id": "ce6bfc6e-652d-3efc-a78e-d14005fcb0a1",
                                                "text": "At the end of the month, Merlin ordered the disbanding of the Police Legion, which had been infiltrated by the Babouvists."
                                            }
                                        ]
