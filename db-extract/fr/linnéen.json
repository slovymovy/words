                                    {
                                        "sense_id": "927d7186-da97-3de0-b7e6-5f30e0766aa1",
                                        "entry_id": "81a8df3b-616e-3264-bcc0-399d76477d34",
                                        "glosses": [
                                            "Of or relating to Carolus Linnaeus, Swedish naturalist, either personally or in a wider sense, to the era influenced by him."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f159b0e7-8e25-32b8-9348-854413718c4b",
                                        "entry_id": "81a8df3b-616e-3264-bcc0-399d76477d34",
                                        "glosses": [
                                            "Of or relating to the binomial nomenclature originated by him"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6edacde4-a32a-4b56-898a-d30eeac8483b",
                                                "sense_id": "f159b0e7-8e25-32b8-9348-854413718c4b",
                                                "text": "Nowhere was the victory of Linnaeanism more complete than in Britain. When William Hudson's Flora Anglica, organized in the Linnaean manner, appeared in 1762, it displaced all previous floras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d5437a-4ae3-39f6-b620-84289a538ddc",
                                        "entry_id": "81a8df3b-616e-3264-bcc0-399d76477d34",
                                        "glosses": [
                                            "Relating to the nomenclature Codes that have their starting point in a work by Linnaeus or are derived from such a Code. This includes the idea of a ranked taxonomy, which was not initiated by Linnaeus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
