            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b58537d7-404d-3aa1-aaa8-05b47a795046",
                    "sense_definition": "pierwsza osoba liczby pojedynczej czasu teraźniejszego czasownika <w>mieć</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mam</w> na imię Anna i pochodzę z Krakowa.",
                            "target_lang_translations": {
                                "ru": "Меня <w>зовут</w> Анна, и я из Кракова.",
                                "en": "<w>My name is</w> Anna and I come from Krakow."
                            }
                        },
                        {
                            "text": "<w>Mam</w> nadzieję, że jutro nie będzie padać deszcz.",
                            "target_lang_translations": {
                                "ru": "<w>Надеюсь</w>, что завтра не будет дождя.",
                                "en": "I <w>hope</w> that it will not rain tomorrow."
                            }
                        },
                        {
                            "text": "Niestety nie <w>mam</w> teraz czasu na rozmowę.",
                            "target_lang_translations": {
                                "ru": "К сожалению, у меня сейчас <w>нет</w> времени на разговор.",
                                "en": "Unfortunately, I <w>do not have</w> time for a conversation right now."
                            }
                        }
                    ],
                    "synonyms": [
                        "posiadam"
                    ],
                    "common_phrases": [
                        "mam na imię",
                        "mam nadzieję",
                        "mam rację",
                        "mam dość",
                        "mam czas"
                    ],
                    "target_lang_definitions": {
                        "ru": "1-е лицо единственного числа настоящего времени глагола <w>иметь</w>",
                        "en": "First-person singular present tense of the verb 'to have'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имею",
                                "target_lang_sense_clarification": "форма глагола 'иметь'"
                            },
                            {
                                "target_lang_word": "у меня есть",
                                "target_lang_sense_clarification": "конструкция обладания"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "possession or state"
                            },
                            {
                                "target_lang_word": "am",
                                "target_lang_sense_clarification": "used in specific phrases like 'I am named'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9e22383-161a-3d50-8cff-ed5b983e1d67",
                    "sense_definition": "druga osoba liczby pojedynczej trybu rozkazującego czasownika <w>mamić</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie <w>mam</w> mnie wizją łatwego zarobku, bo w to nie wierzę.",
                            "target_lang_translations": {
                                "ru": "Не <w>мани</w> меня видением легкого заработка, потому что я в это не верю.",
                                "en": "Do not <w>lure</w> me with the vision of easy money, because I do not believe in it."
                            }
                        },
                        {
                            "text": "Nie <w>mam</w> ludzi obietnicami, których nie możesz spełnić.",
                            "target_lang_translations": {
                                "ru": "Не <w>обманывай</w> людей обещаниями, которые не можешь выполнить.",
                                "en": "Do not <w>delude</w> people with promises you cannot keep."
                            }
                        }
                    ],
                    "synonyms": [
                        "łudź",
                        "zwódź",
                        "kusi"
                    ],
                    "target_lang_definitions": {
                        "ru": "2-е лицо единственного числа повелительного наклонения глагола <w>манить</w> / <w>обманывать</w>",
                        "en": "Second-person singular imperative of the verb 'to delude' or 'to lure'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мани",
                                "target_lang_sense_clarification": "привлекай, соблазняй"
                            },
                            {
                                "target_lang_word": "обманывай",
                                "target_lang_sense_clarification": "вводи в заблуждение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lure",
                                "target_lang_sense_clarification": "to tempt or entice"
                            },
                            {
                                "target_lang_word": "delude",
                                "target_lang_sense_clarification": "to deceive or mislead"
                            }
                        ]
                    }
                }
            ]
        },
