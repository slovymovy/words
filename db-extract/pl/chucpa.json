                                    },
                                    {
                                        "sense_id": "183fc4b6-f22f-3814-ae91-ba91a06f8504",
                                        "entry_id": "d159f4be-39af-378a-b884-20e64c3543fa",
                                        "glosses": [
                                            "„anmaßender, nicht sehr kecker Mensch“"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acce3b0f-0c6c-493a-92c3-79c1a8560831",
                                                "sense_id": "183fc4b6-f22f-3814-ae91-ba91a06f8504",
                                                "text": "„‚Jobber und Bänkeljulen, Chuzpen und Luden‘ trafen sich bei ‚Hurentorte mit Sodomitensahne: alle Skalen‘ tosten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
