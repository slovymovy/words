                        ],
                        "examples": [
                            {
                                "example_id": "f0fd74d1-28b1-4cda-9c01-e87e4e80b257",
                                "sense_id": "41f9dbc2-481c-3740-bd42-29799f1505c5",
                                "text": "Ну и пе́кло на у́лице!",
                                "translation": "What a scorcher outside!",
                                "english": "What a scorcher outside!"
                            }
                        ]
                    },
                    {
                        "sense_id": "8c9b5820-3cfb-3581-8e71-1076c55669e1",
                        "entry_id": "f1597179-011f-34c4-9af4-5fa87fb8b0d6",
                        "glosses": [
