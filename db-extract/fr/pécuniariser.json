                "senses": [
                    {
                        "sense_id": "83ba88d4-d298-3477-9027-dca563bbf5ed",
                        "entry_id": "db83e01b-c4aa-37ab-b386-3503c1b9d8be",
                        "glosses": [
                            "Donner un caractère pécuniaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094bc372-2915-4374-bd53-8cd903aceea6",
                                "sense_id": "83ba88d4-d298-3477-9027-dca563bbf5ed",
                                "text": "Elle reste prisonnière d’une logique naturaliste qui aime à concevoir les aliments comme une prestation à fournir en nature, entre proches, directe et informelle, alors que leur régime particulièrement «pécuniarisé» - et l’existence même de leur encadrement juridique - devrait suffire à faire pièce de cette vision angélique des obligations alimentaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1ffcc7f-dc01-3984-8ebe-357a9a98146e",
                        "entry_id": "db83e01b-c4aa-37ab-b386-3503c1b9d8be",
                        "glosses": [
                            "Exploiter d’un point de vue pécuniaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e20a9479-a861-4aed-a296-18f18a75b91c",
                                "sense_id": "e1ffcc7f-dc01-3984-8ebe-357a9a98146e",
                                "text": "On ne s'interdit pas non plus de pécuniariser un patrimoine foncier disproportionné et parfois de grande valeur quand il est en centre-ville."
                            }
                        ]
                    }
