{
    "word_family": [
        "stick",
        "sticker",
        "stickiness",
        "stickily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4efcbbd-c91a-370e-bcd1-d83f27ed6730",
                    "sense_definition": "Tending to stick or able to adhere to surfaces, often due to a viscous or glue-like substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The back of the tape is very <w>sticky</w> and will stay on the wall.",
                            "target_lang_translations": {
                                "ru": "Обратная сторона ленты очень <w>липкая</w> и будет держаться на стене."
                            }
                        },
                        {
                            "text": "My hands are <w>sticky</w> because I just ate a piece of candy.",
                            "target_lang_translations": {
                                "ru": "У меня <w>липкие</w> руки, потому что я только что съел конфету."
                            }
                        }
                    ],
                    "synonyms": [
                        "adhesive",
                        "glutinous",
                        "claggy"
                    ],
                    "antonyms": [
                        "non-stick",
                        "dry",
                        "smooth"
                    ],
                    "common_phrases": [
                        "sticky tape",
                        "sticky fingers",
                        "sticky rice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий свойство прилипать к поверхностям, часто из-за вязкого или клейкого вещества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "липкий",
                                "target_lang_sense_clarification": "о поверхности или веществе"
                            },
                            {
                                "target_lang_word": "клейкий",
                                "target_lang_sense_clarification": "обладающий адгезией"
                            },
                            {
                                "target_lang_word": "вязкий",
                                "target_lang_sense_clarification": "густой и тягучий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98be1419-6461-33f1-ae8d-7e28b811b154",
                    "sense_definition": "Describing weather that is hot, humid, and windless, making people feel damp from sweat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sticky</w> weather in August made it very hard to sleep at night.",
                            "target_lang_translations": {
                                "ru": "<w>Липкая</w> жара в августе мешала спать по ночам."
                            }
                        },
                        {
                            "text": "It was a hot and <w>sticky</w> afternoon in the tropical jungle.",
                            "target_lang_translations": {
                                "ru": "Это был жаркий и <w>влажный</w> день в тропических джунглях."
                            }
                        }
                    ],
                    "synonyms": [
                        "muggy",
                        "sultry",
                        "close"
                    ],
                    "antonyms": [
                        "fresh",
                        "breezy",
                        "dry"
                    ],
                    "common_phrases": [
                        "sticky weather",
                        "hot and sticky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает жаркую, влажную и безветренную погоду, вызывающую испарину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "липкий",
                                "target_lang_sense_clarification": "о жаре или влажности"
                            },
                            {
                                "target_lang_word": "душный",
                                "target_lang_sense_clarification": "о погоде"
                            },
                            {
                                "target_lang_word": "влажный",
                                "target_lang_sense_clarification": "о климате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8611798f-39e4-32f8-943a-6ad6851b2b6f",
                    "sense_definition": "Difficult, awkward, or complicated to deal with.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are in a <w>sticky</w> situation and need to find a solution quickly.",
                            "target_lang_translations": {
                                "ru": "Мы попали в <w>щекотливую</w> ситуацию, и нам нужно быстро найти решение."
                            }
                        },
                        {
                            "text": "The reporter asked several <w>sticky</w> questions that the politician did not want to answer.",
                            "target_lang_translations": {
                                "ru": "Репортер задал несколько <w>неприятных</w> вопросов, на которые политик не хотел отвечать."
                            }
                        }
                    ],
                    "synonyms": [
                        "tenacious",
                        "claggy"
                    ],
                    "antonyms": [
                        "easy",
                        "simple",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "sticky situation",
                        "sticky problem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe social or logistical problems"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный, неловкий или сложный в разрешении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щекотливый",
                                "target_lang_sense_clarification": "о ситуации или вопросе"
                            },
                            {
                                "target_lang_word": "неприятный",
                                "target_lang_sense_clarification": "о проблеме"
                            },
                            {
                                "target_lang_word": "затруднительный",
                                "target_lang_sense_clarification": "о положении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "894d2ec1-f7da-32d9-94e7-0612a0a97fbf",
                    "sense_definition": "Compelling or engaging enough to keep visitors on a website for a long time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team is trying to make the website more <w>sticky</w> to increase sales.",
                            "target_lang_translations": {
                                "ru": "Отдел маркетинга пытается сделать сайт более <w>удерживающим</w>, чтобы увеличить продажи."
                            }
                        },
                        {
                            "text": "A <w>sticky</w> website usually has high-quality content that keeps users clicking.",
                            "target_lang_translations": {
                                "ru": "<w>Привлекательный</w> сайт обычно имеет качественный контент, который заставляет пользователей кликать дальше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sticky website",
                        "sticky content"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business and technology jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Достаточно привлекательный или увлекательный, чтобы удерживать посетителей на веб-сайте долгое время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удерживающий",
                                "target_lang_sense_clarification": "о контенте или сайте"
                            },
                            {
                                "target_lang_word": "привлекательный",
                                "target_lang_sense_clarification": "для пользователей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e512907c-a2d3-3c2b-98c2-e34d7d150899",
                    "sense_definition": "Tending to remain at the same level or resistant to change, especially in economics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists noted that <w>sticky</w> wages did not drop even during the recession.",
                            "target_lang_translations": {
                                "ru": "Экономисты отметили, что <w>негибкие</w> зарплаты не снизились даже во время рецессии."
                            }
                        },
                        {
                            "text": "The <w>sticky</w> price of the product meant it stayed expensive for months.",
                            "target_lang_translations": {
                                "ru": "<w>Жесткая</w> цена на товар означала, что он оставался дорогим в течение нескольких месяцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "tenacious"
                    ],
                    "antonyms": [
                        "flexible",
                        "volatile"
                    ],
                    "common_phrases": [
                        "sticky prices",
                        "sticky wages"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical economic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий тенденцию оставаться на том же уровне или сопротивляться изменениям, особенно в экономике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "негибкий",
                                "target_lang_sense_clarification": "о ценах или зарплатах"
                            },
                            {
                                "target_lang_word": "вязкий",
                                "target_lang_sense_clarification": "в экономическом контексте"
                            },
                            {
                                "target_lang_word": "жесткий",
                                "target_lang_sense_clarification": "устойчивый к изменениям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8684b18-f170-343f-bca3-454077ebd435",
                    "sense_definition": "Describing a death that is unpleasant, violent, or grisly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain in the movie finally came to a <w>sticky</w> end.",
                            "target_lang_translations": {
                                "ru": "Злодей в фильме в конце концов встретил свой <w>скверный</w> конец."
                            }
                        },
                        {
                            "text": "History is full of kings who met a <w>sticky</w> end during a rebellion.",
                            "target_lang_translations": {
                                "ru": "История полна королей, которые нашли <w>ужасную</w> смерть во время восстаний."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sticky end"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually in the phrase 'come to a sticky end'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает неприятную, насильственную или ужасную смерть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "о конце или смерти"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "о трагическом финале"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4573205a-8889-357d-aaee-6910e9a813ad",
                    "sense_definition": "A small piece of paper with a strip of adhesive on the back, used for writing short notes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stationery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I left a <w>sticky</w> on the fridge to remind you about the meeting.",
                            "target_lang_translations": {
                                "ru": "Я оставил <w>стикер</w> на холодильнике, чтобы напомнить тебе о встрече."
                            }
                        },
                        {
                            "text": "Her computer monitor is covered in colorful <w>stickies</w>.",
                            "target_lang_translations": {
                                "ru": "Ее монитор обклеен разноцветными <w>стикерами</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "yellow stickies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal name for a sticky note"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой листок бумаги с клейкой полоской на обороте для коротких заметок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стикер",
                                "target_lang_sense_clarification": "наклейка для заметок"
                            },
                            {
                                "target_lang_word": "липучка",
                                "target_lang_sense_clarification": "разговорное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e16e743-2896-3947-8b25-64b4b41ea0d8",
                    "sense_definition": "A post or thread in an online forum that is fixed to the top of the list.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the <w>sticky</w> at the top of the forum before posting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте <w>закреп</w> в верхней части форума перед публикацией."
                            }
                        },
                        {
                            "text": "The moderator made the rules thread a <w>sticky</w> so everyone could see it.",
                            "target_lang_translations": {
                                "ru": "Модератор сделал тему с правилами <w>закрепленной</w>, чтобы все могли ее видеть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "forum sticky"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщение или тема на онлайн-форуме, закрепленная в верхней части списка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закреп",
                                "target_lang_sense_clarification": "закрепленная тема"
                            },
                            {
                                "target_lang_word": "важное",
                                "target_lang_sense_clarification": "в контексте форума"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22104b9a-25c0-3876-8a2f-ce5336bb08e1",
                    "sense_definition": "To fix a discussion thread at the top of a list in an online forum.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The admin will <w>sticky</w> the announcement so it stays visible.",
                            "target_lang_translations": {
                                "ru": "Админ <w>закрепит</w> объявление, чтобы оно оставалось на виду."
                            }
                        },
                        {
                            "text": "I asked the moderator to <w>sticky</w> my guide for new players.",
                            "target_lang_translations": {
                                "ru": "Я попросил модератора <w>закрепить</w> мое руководство для новых игроков."
                            }
                        }
                    ],
                    "synonyms": [
                        "adhesive"
                    ],
                    "common_phrases": [
                        "sticky a thread"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрепить тему обсуждения в верхней части списка на онлайн-форуме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрепить",
                                "target_lang_sense_clarification": "тему на форуме"
                            },
                            {
                                "target_lang_word": "прикрепить",
                                "target_lang_sense_clarification": "сообщение наверху"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}