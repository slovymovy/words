                "senses": [
                    {
                        "sense_id": "70ac36b0-a1e1-3363-9eed-caab8e126097",
                        "entry_id": "8a7addf0-0873-3620-b0b8-1bbac8bc0ac0",
                        "glosses": [
                            "Devenir vieux dans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e77e2d-3b43-4772-9cbe-4d3b8d2ab435",
                                "sense_id": "70ac36b0-a1e1-3363-9eed-caab8e126097",
                                "text": "La rigueur de ses lois, après tant de licence, Redonnera le coeur à la faible innocence Que dedans la misère on faisait envieillir."
                            }
                        ]
                    },
                    {
                        "sense_id": "acbe9e08-80f7-33b7-b577-9d6221f4d266",
                        "entry_id": "8a7addf0-0873-3620-b0b8-1bbac8bc0ac0",
                        "glosses": [
                            "Faire paraître vieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bdef302-9480-4903-ad51-cdba9317e91e",
                                "sense_id": "acbe9e08-80f7-33b7-b577-9d6221f4d266",
                                "text": "Cette coiffure l’envieillit."
                            },
                            {
                                "example_id": "0e6a2700-3d18-440d-a203-c37416c81c53",
                                "sense_id": "acbe9e08-80f7-33b7-b577-9d6221f4d266",
                                "text": "Le couvent, placé au bord du chemin, s’envieillissait d’un quinconce d’ormes du temps de Jean V de Bretagne."
                            }
                        ]
                    }
