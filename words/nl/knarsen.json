{
    "word_family": [
        "knarsing",
        "geknars"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "829c799e-e97a-3fb0-8044-98409a2391a4",
                    "sense_definition": "Het hard over elkaar wrijven van de tanden, vaak onbewust of uit spanning.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met je tanden <w>knarsen</w> in je slaap geeft een naar geluid en is slecht voor je gebit.",
                            "target_lang_translations": {
                                "en": "<w>Grinding</w> your teeth in your sleep makes a nasty sound and is bad for your teeth."
                            }
                        },
                        {
                            "text": "Hij begon nerveus met zijn tanden te <w>knarsen</w> toen hij het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "He nervously began to <w>grind</w> his teeth when he heard the bad news."
                            }
                        }
                    ],
                    "synonyms": [
                        "tandenknarsen"
                    ],
                    "common_phrases": [
                        "met tanden knarsen"
                    ],
                    "target_lang_definitions": {
                        "en": "The hard rubbing together of teeth, often unconsciously or out of tension."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "teeth"
                            },
                            {
                                "target_lang_word": "gnash",
                                "target_lang_sense_clarification": "teeth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f6decc8-d69d-3137-8183-d7e3b7250b27",
                    "sense_definition": "Een schurend of krakend geluid maken door wrijving tussen twee harde voorwerpen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het oude scharnier van de deur <w>knarste</w> luid toen hij de kamer binnenkwam.",
                            "target_lang_translations": {
                                "en": "The old hinge of the door <w>creaked</w> loudly as he entered the room."
                            }
                        },
                        {
                            "text": "Ik hoorde de wielen van de trein op het spoor <w>knarsen</w>.",
                            "target_lang_translations": {
                                "en": "I heard the wheels of the train <w>grate</w> on the track."
                            }
                        }
                    ],
                    "synonyms": [
                        "schuren",
                        "kraken"
                    ],
                    "common_phrases": [
                        "het zand laat knarsen"
                    ],
                    "target_lang_definitions": {
                        "en": "Making a scraping or creaking sound due to friction between two hard objects."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crunch",
                                "target_lang_sense_clarification": "sound of sand, gravel, or wheels"
                            },
                            {
                                "target_lang_word": "creak",
                                "target_lang_sense_clarification": "hinges or wood"
                            },
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "metal or hard surfaces"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}