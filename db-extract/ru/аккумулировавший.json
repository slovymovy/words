                        "sense_id": "23b17fa5-3257-329b-83d2-616c987ac217",
                        "entry_id": "7a294f6d-6bd5-349f-adab-3f3f48bd58b3",
                        "glosses": [
                            "действ. прич. прош. вр. от аккумулировать"
                        ],
