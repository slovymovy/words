        "fr-extract.jsonl": [
            {
                "entry_id": "d3adf2d1-3127-3acf-9995-2e6ea2accc41",
                "word": "exclamer",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "67e34138-3e39-4516-970d-0ca23309831a",
                        "entry_id": "d3adf2d1-3127-3acf-9995-2e6ea2accc41",
                        "tags": [
                            "pronominal"
                        ],
                        "form": "s’exclamer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a6f6a23-668c-3d23-96f6-733a777c963e",
                        "entry_id": "d3adf2d1-3127-3acf-9995-2e6ea2accc41",
                        "glosses": [
                            "Pousser des exclamations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de41ded3-d421-43f6-ac17-b2f69b8eb17c",
                                "sense_id": "3a6f6a23-668c-3d23-96f6-733a777c963e",
                                "text": "Qu’ont-ils donc à s’exclamer ?"
                            },
                            {
                                "example_id": "25792710-359a-40d4-a0dc-d7c44014c261",
                                "sense_id": "3a6f6a23-668c-3d23-96f6-733a777c963e",
                                "text": "Il n’y a pas tant à s’exclamer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "181bb469-6b11-47b8-9127-d2932c38c0d2",
                        "source_entry_id": "d3adf2d1-3127-3acf-9995-2e6ea2accc41",
                        "source_sense_id": "3a6f6a23-668c-3d23-96f6-733a777c963e",
                        "target_lang_word": "exclaim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exclaim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd778872-3504-3a7d-8fdb-ea610d20617d",
                                        "entry_id": "b0b37d88-5438-30ff-8324-d7d5d603ec8a",
                                        "glosses": [
                                            "To cry out suddenly, from some strong emotion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06fe4a7e-12c2-4595-bdf4-7fdf02b908b9",
                                                "sense_id": "fd778872-3504-3a7d-8fdb-ea610d20617d",
                                                "text": "I am a soldier, and unapt to weep,\nOr to exclaim on fortune’s fickleness."
                                            },
                                            {
                                                "example_id": "b877a6e6-9db0-434d-828b-beee18ff299e",
                                                "sense_id": "fd778872-3504-3a7d-8fdb-ea610d20617d",
                                                "text": "Very grave and good Women exclaimed against Men who begot Children and then disowned them."
                                            },
                                            {
                                                "example_id": "85096606-c667-43fe-9eb6-bd0cf3e5a65c",
                                                "sense_id": "fd778872-3504-3a7d-8fdb-ea610d20617d",
                                                "text": "This wretched note was the finale of Emma’s breakfast. When once it had been read, there was no doing any thing, but lament and exclaim."
                                            },
                                            {
                                                "example_id": "044ea128-2bfd-444d-85b2-370106d66bd4",
                                                "sense_id": "fd778872-3504-3a7d-8fdb-ea610d20617d",
                                                "text": "[…] he could remember Sally tearing off a rose, stopping to exclaim at the beauty of the cabbage leaves in the moonlight […]"
                                            },
                                            {
                                                "example_id": "c3a4e4ee-2a46-4d30-a231-84a5d3b2769c",
                                                "sense_id": "fd778872-3504-3a7d-8fdb-ea610d20617d",
                                                "text": "[…] at the front door below a few guests were leaving, and the bright rectangle widened and narrowed as they slipped out into the night, laughing and exclaiming about the weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e1b27ea-740e-318c-9900-426cd569840c",
                                        "entry_id": "b0b37d88-5438-30ff-8324-d7d5d603ec8a",
                                        "glosses": [
                                            "To say suddenly and with strong emotion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db7aeea-c053-4394-a9de-929482c2633e",
                                                "sense_id": "0e1b27ea-740e-318c-9900-426cd569840c",
                                                "text": "Must she be forc’d, t’exclaime th’iniurious wrong?\nOffred by him, whom she hath lou’d so long?\nNay, I will tell, and I durst almost sweare,\nEdward will blush, when he his fault shall heare."
                                            },
                                            {
                                                "example_id": "59abd041-5e06-4295-8a0b-b74e8a734d84",
                                                "sense_id": "0e1b27ea-740e-318c-9900-426cd569840c",
                                                "text": "[…] her aunt, after having stared at me a good while with a look of amazement, exclaimed, “In the name of heaven! Who art thou?”—"
                                            },
                                            {
                                                "example_id": "44ede912-90f8-411b-9f9e-b8bea28bbf9f",
                                                "sense_id": "0e1b27ea-740e-318c-9900-426cd569840c",
                                                "text": "Without returning any direct reply, Miss Squeers, all at once, fell into a paroxysm of spiteful tears, and exclaimed that she was a wretched, neglected, miserable castaway."
                                            },
                                            {
                                                "example_id": "d587963d-2178-4a5c-ad7d-eadbfd3b70aa",
                                                "sense_id": "0e1b27ea-740e-318c-9900-426cd569840c",
                                                "text": "“Heavens!” exclaimed Nina, “the blue-stocking and the fogy!—and yours are pale blue, Eileen!—you’re about as self-conscious as Drina—slumping there with your hair tumbling à la Mérode! Oh, it's very picturesque, of course, but a straight spine and good grooming is better.[…]”"
                                            },
                                            {
                                                "example_id": "6ce7efed-fae1-4265-9d48-805fdd2eaadf",
                                                "sense_id": "0e1b27ea-740e-318c-9900-426cd569840c",
                                                "text": "You never pump your arm when you score, you never exclaim anything, you don’t even smile when you fire a perfect backhand straight down the line."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exclaim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b80452-1af4-3819-b0ae-0ade595a8ff1",
                                        "entry_id": "4979ae4d-5d6f-3aef-9643-f1e6d41d83d9",
                                        "glosses": [
                                            "Exclamation; outcry, clamor."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "523f9a59-ae67-4b43-ba24-42648784ea49",
                                                "sense_id": "b1b80452-1af4-3819-b0ae-0ade595a8ff1",
                                                "text": "Foul devil, for God’s sake, hence, and trouble us not;\nFor thou hast made the happy earth thy hell,\nFill’d it with cursing cries and deep exclaims."
                                            },
                                            {
                                                "example_id": "fadbbf3e-4314-4ad0-becd-2f0cbf2e39e8",
                                                "sense_id": "b1b80452-1af4-3819-b0ae-0ade595a8ff1",
                                                "text": "Oh fortune, thou’rt not worth my least exclame [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2142f9b7-f2bd-43f5-8de3-143c07c82d43",
                        "source_entry_id": "d3adf2d1-3127-3acf-9995-2e6ea2accc41",
                        "source_sense_id": "3a6f6a23-668c-3d23-96f6-733a777c963e",
                        "target_lang_word": "exclamar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exclamar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "68749f89-ac91-3622-89f9-e2e76acb8b2a",
                                        "entry_id": "b4ab6c52-78b2-3c4c-9fb1-d8982c0933b9",
                                        "glosses": [
                                            "Emitir palabras con énfasis o vehemencia para expresar alguna emoción intensa o para dar vigor y eficacia a lo que se dice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e8efaf-9d09-49a2-b4ed-a404725aeb8c",
                                                "sense_id": "68749f89-ac91-3622-89f9-e2e76acb8b2a",
                                                "text": "¡Tú, casada!¡tú, hermana!—exclamó con extrañeza Violante"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
