                "senses": [
                    {
                        "sense_id": "1b31d7c4-0ba0-35cc-ad64-ebda00769810",
                        "entry_id": "4aee9d95-059d-3e03-9834-2f9fd43b53c7",
                        "glosses": [
                            "Se suffire à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc6b79cf-b9db-4835-8f09-258f9d9e021b",
                                "sense_id": "1b31d7c4-0ba0-35cc-ad64-ebda00769810",
                                "text": "L'auto-suffisance de la vie factice signifie qu'elle n'a pas besoin de sortir de soi-même pour s'auto-suffire."
                            },
                            {
                                "example_id": "b986f5b6-4527-4a98-871f-ab66c59fae99",
                                "sense_id": "1b31d7c4-0ba0-35cc-ad64-ebda00769810",
                                "text": "Ses partisans se focalisent sur les méfaits du système et posent en priorité absolue de s'auto-suffire sans savoir comment ils pourraient y parvenir dans leur stérile état d'isolement."
                            }
                        ]
                    }
