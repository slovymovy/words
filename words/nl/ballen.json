                            },
                            {
                                "target_lang_word": "шары",
                                "target_lang_sense_clarification": "круглые предметы"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "balls",
                                "target_lang_sense_clarification": "plural of ball"
