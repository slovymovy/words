                "senses": [
                    {
                        "sense_id": "5c40dae8-b73d-3dd8-8aef-8240a039a745",
                        "entry_id": "1a70dca8-a0b2-3c87-821b-1a267ef1ab07",
                        "glosses": [
                            "Élaboration de la bile, au niveau du foie, ou de pigments biliaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "349e4b5e-3b11-48e3-bcce-05a5cfd22ad5",
                                "sense_id": "5c40dae8-b73d-3dd8-8aef-8240a039a745",
                                "text": "Les ecchymoses sont des lésions évolutives qui suivent la chronologie de la biligenèse locale."
                            },
                            {
                                "example_id": "ea5ebac4-f1b4-4fad-a5d9-f62540af8d9b",
                                "sense_id": "5c40dae8-b73d-3dd8-8aef-8240a039a745",
                                "text": "La structure à différentes échelles, la biochimie et le fonctionnement du foie ont fait l'objet de nombreuses recherches. La biligenèse, singulièrement l'origine des pigments à partir de l'hémoglobine, a pu être élucidée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
