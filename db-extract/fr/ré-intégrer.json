                "senses": [
                    {
                        "sense_id": "61781636-5d91-3138-8e3d-e6ddd2d249ba",
                        "entry_id": "a2a2acf7-67b3-3381-9105-d181d96ced68",
                        "glosses": [
                            "Variante orthographique, plus rare, de réintégrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6850cd01-a249-46d0-b167-110977f2351e",
                                "sense_id": "61781636-5d91-3138-8e3d-e6ddd2d249ba",
                                "text": "C’est en fait une façon de mettre à jour dynamiquement l’application, sans avoir besoin de tout recompiler, et surtout de tout ré-intégrer (mais il faut tout de même valider)."
                            },
                            {
                                "example_id": "1033dc9d-8f23-43d0-947e-2cf23184ac62",
                                "sense_id": "61781636-5d91-3138-8e3d-e6ddd2d249ba",
                                "text": "Ainsi, pour les mystiques chinois et hindous, le but n’est pas de recommencer une nouvelle existence ici-bas, sur la terre comme on le croit trop souvent, mais de \"revenir en arrière\" et de ré-intégrer le Grand-Un primordial (l’Oeuf)."
                            }
                        ]
                    }
