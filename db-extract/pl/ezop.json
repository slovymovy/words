                                        "entry_id": "2decd44c-5772-394d-a935-618bd888f1a3",
                                        "glosses": [
                                            "Célèbre fabuliste de la Grèce antique, qui a notamment servi d’inspiration à Jean de La Fontaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c6f390-0557-4824-b966-c0224c275d8c",
                                                "sense_id": "3f16a6ce-6f6b-3e41-8ac8-04fb992226f9",
                                                "text": "Vers la fin du siècle dernier, le vélocifère, prédécesseur de la diligence et des messageries, débarquait à Paris un provençal, plein de verve et d'entrain, né dans la ville d'Aix, et bossu, comme Ésope, par devant et par derrière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
