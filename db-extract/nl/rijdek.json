                    {
                        "sense_id": "3a8b8372-73b7-3512-906a-d8af3bbac550",
                        "entry_id": "d6718071-1fab-3325-98aa-5526b1123a5d",
                        "glosses": [
                            "deel van een brug waarover het verkeer kan rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444782d3-0db6-48ca-b887-ce4bf9fa1056",
                                "sense_id": "3a8b8372-73b7-3512-906a-d8af3bbac550",
                                "text": "De gemeente Alphen aan den Rijn kan maandagmiddag eindelijk de Koningin Julianabrug in gebruik nemen. De brug kwam vorig jaar landelijk in het nieuws toen de kranen instortten bij de plaatsing van het rijdek."
                            },
                            {
                                "example_id": "225abcd1-9965-481c-a485-ff82887f9b80",
                                "sense_id": "3a8b8372-73b7-3512-906a-d8af3bbac550",
                                "text": "Daarna was het wachten op het transport van het composieten rijdek. Dat zou volgens planning aan het eind van de avond op de Auke Vleerstraat aankomen, maar dat werd een paar uurtjes later."
                            },
                            {
                                "example_id": "b6a0c2b1-cad3-468e-baf9-dda59bd96459",
                                "sense_id": "3a8b8372-73b7-3512-906a-d8af3bbac550",
                                "text": "Het systeem meldt zelf wanneer inspectie of reparatie noodzakelijk is. Vlak voor de zomer zijn daartoe sensoren geplaatst en volgens TNO zijn de meetresultaten daarvan veelbelovend. De metingen zijn voor TNO een pilot om uit te vinden of met sensoren mogelijke scheurvorming in het stalen rijdek kunnen worden gemonitord."
                            }
                        ]
                    },
