                                    {
                                        "sense_id": "0b63b6ce-10ce-3b4e-9db9-54157f528bff",
                                        "entry_id": "bb387e57-e068-3797-b0e7-06617c02281a",
                                        "glosses": [
                                            "Jeune fille se révoltant contre les interdits, dont le caractère rappelle celui d’Antigone, fille d’Œdipe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b502f68-aa62-4270-a8bc-8b7771c5c7dd",
                                                "sense_id": "0b63b6ce-10ce-3b4e-9db9-54157f528bff",
                                                "text": "Coronavirus : l’écrivaine Fang Fang, Antigone de Wuhan\nInstallée dans la capitale de la province du Hubei d’où est partie l’épidémie due au coronavirus, elle est attaquée de toutes parts pour avoir écrit son journal du confinement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dcf94a9-0fb3-3cf4-9012-19f748f64d1e",
                                        "entry_id": "bb387e57-e068-3797-b0e7-06617c02281a",
                                        "glosses": [
                                            "Jeune fille guidant une personne aveugle, comme Antigone l'aurait fait pour son père Œdipe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0e25e0-bedb-4f77-8c9e-b3c563283b33",
                                                "sense_id": "6dcf94a9-0fb3-3cf4-9012-19f748f64d1e",
                                                "text": "Je comprends que mademoiselle ait renoncé à certains projets pour se consacrer entièrement à son père : c’est une Antigone."
                                            },
                                            {
                                                "example_id": "67349687-ed5d-46c9-9c9e-d2662c198094",
                                                "sense_id": "6dcf94a9-0fb3-3cf4-9012-19f748f64d1e",
                                                "text": "« C’est vrai, dit-il, que tu es une Antigone pour moi, et même plus, puisque Antigone, fille du malheureux Œdipe, devait ses soins et sa tendresse à son père. »"
                                            },
                                            {
                                                "example_id": "7daf37f1-b5aa-4b32-8646-881b46b123d0",
                                                "sense_id": "6dcf94a9-0fb3-3cf4-9012-19f748f64d1e",
                                                "text": "Le chanoine Z., hercule aveugle de quatre-vingt-deux ans, fait quatorze kilomètres tous les jours, appuyé au bras d’une Antigone de vingt-cinq ans, qui porte son bréviaire et un petit sac à linge."
                                            }
                                        ]
                                    }
                                ]
                            }
