                "senses": [
                    {
                        "sense_id": "829df7ef-2147-3128-918f-a62962888567",
                        "entry_id": "74baa7d0-ac63-3b24-809c-17f7a7a8a89c",
                        "glosses": [
                            "auf die Einsparung von Geld ausgerichtetes Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21de0866-2c42-4f51-8815-c49c95bcabc2",
                                "sense_id": "829df7ef-2147-3128-918f-a62962888567",
                                "text": "„Auch die unter amerikanischen Beobachtern umstrittene Sparpolitik, die in Europa den Krisenländern auferlegt wird, wurde von europäischer Seite verteidigt.“"
                            },
                            {
                                "example_id": "c9417524-3fb8-4911-8f7b-f5093fdd9ebc",
                                "sense_id": "829df7ef-2147-3128-918f-a62962888567",
                                "text": "„Acht Jahre Sparpolitik haben das Land ausgezehrt.“"
                            },
                            {
                                "example_id": "f7d900cf-1be8-42cd-9835-b48c035ab93d",
                                "sense_id": "829df7ef-2147-3128-918f-a62962888567",
                                "text": "„Die deutsche Sparpolitik soll die strauchelnden Länder der EU stabiler machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
