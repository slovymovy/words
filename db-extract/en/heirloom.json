                                                "sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                                                "text": "Dieser Tisch ist ein besonders schönes Erbstück."
                                            },
                                            {
                                                "example_id": "0da5c773-174a-4633-96b1-9a8f43fd9778",
                                                "sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                                                "text": "„Außer einem verlegenen Lächeln zeigte er keinerlei Wirkung angesichts der kostbaren Erbstücke.“"
                                            },
                                            {
                                                "example_id": "477cb637-8891-4d8b-ac9a-a208b0f1cf2d",
                                                "sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                                                "text": "„Elf Personen, zählte ich, saßen um den ovalen Tisch herum, ein schönes Möbel, sicher ein Erbstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
