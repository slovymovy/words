                "senses": [
                    {
                        "sense_id": "4b64f319-ca01-3903-b82e-6b59d922a8cc",
                        "entry_id": "45314537-46a8-39d9-a1d8-b8e6ca0ca387",
                        "glosses": [
                            "niewielki dwór właścicieli ziemskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2442c554-8aa9-4c85-875d-8ecae6fac5a5",
                                "sense_id": "4b64f319-ca01-3903-b82e-6b59d922a8cc",
                                "text": "W pięknej dolinie górskim przerzniętej ruczajem / otoczone lipami świecą dworku ściany, / patrząc oknem na góry, na lasy, na łany…"
                            },
                            {
                                "example_id": "ac7c2945-b35c-4123-a519-aefa8b2ea985",
                                "sense_id": "4b64f319-ca01-3903-b82e-6b59d922a8cc",
                                "text": "Złożono Władka na wozie pułkownika i nocą puścili się leśną drożyną na losy ku temu dworkowi…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
