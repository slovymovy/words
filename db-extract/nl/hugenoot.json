                                        "entry_id": "0697dcb6-ea09-344d-8315-24f18b6a5323",
                                        "glosses": [
                                            "A member of the Protestant Reformed Church of France during the 16th and 17th century."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0e2e4c-8d4a-403a-96a7-4003bb99618c",
                                                "sense_id": "d88a3a94-ac27-31d9-9b3a-3bbe168a6ec5",
                                                "text": "The village was once well known for its paper-milling, founded by Huguenot immigrants in 1648, which produced high-quality hand-made paper until 1952."
                                            }
                                        ]
                                    }
                                ]
                            },
