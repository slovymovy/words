                ],
                "senses": [
                    {
                        "sense_id": "780ea1bb-90c2-3788-9538-58e8fb4d18be",
                        "entry_id": "03f04b6f-e54d-3b25-9c79-d764539bb506",
                        "glosses": [
                            "laufbedingte körperliche Beschwerde; körperliches Unwohlsein oder Schmerz, der während oder infolge des Laufens auftritt"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf69782-ba57-4990-8c19-fba79f080089",
                                "sense_id": "780ea1bb-90c2-3788-9538-58e8fb4d18be",
                                "text": "„Ein 56-jähriger Ultraläufer mit funktionellen Laufbeschwerden, dessen Schmerzen bis ca. 40 km ‚aushaltbar‘ sind, möchte das Laufschuhmodell im Vor- und Mittelfußbereich für eine 250 km Strecke optimieren.“"
                            },
                            {
                                "example_id": "98d06de3-b682-4c9c-bf09-0f4971f167b2",
                                "sense_id": "780ea1bb-90c2-3788-9538-58e8fb4d18be",
                                "text": "„So soll dieses Phänomen dafür sorgen, dass hartnäckige Laufbeschwerden und langwierige Verletzungen, die sich auch im Rumpf bemerkbar machen können, von der ausübenden Person ferngehalten werden.“"
                            },
                            {
                                "example_id": "81885293-296b-4c21-8f74-172ca5b15ccd",
                                "sense_id": "780ea1bb-90c2-3788-9538-58e8fb4d18be",
                                "text": "„Durch die vielen neuen Perspektiven konnte ich meinen Laufbeschwerden auf den Grund gehen und weiß nun, was mir hilft und was mein Körper braucht.“"
                            },
                            {
                                "example_id": "0f542082-750d-4a77-b3c4-783ffe3d6292",
                                "sense_id": "780ea1bb-90c2-3788-9538-58e8fb4d18be",
                                "text": "„Als erstes ist zu sagen, dass die Laufbeschwerden überwunden sind.“"
                            },
                            {
                                "example_id": "ea5a13a8-a9dc-493a-9805-bbcb6d478e95",
                                "sense_id": "780ea1bb-90c2-3788-9538-58e8fb4d18be",
                                "text": "„Du leidest unter wiederkehrenden Laufbeschwerden (Knieprobleme, Achillessehnenprobleme, Hüftprobleme, Rückenprobleme, …)?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
