                    "frequency": "VeryLow",
                    "semantic_group_id": "afval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger werd het <w>karwei</w> van het geslachte varken vaak nog nuttig gebruikt.",
                            "target_lang_translations": {
                                "en": "In the past, the <w>offal</w> from the slaughtered pig was often still put to good use."
                            }
