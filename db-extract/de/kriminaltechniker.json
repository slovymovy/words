                "senses": [
                    {
                        "sense_id": "7b568388-2648-31f9-88f1-180ab1f2af17",
                        "entry_id": "8b718402-5070-3a1a-a9d3-1c2345df859a",
                        "glosses": [
                            "Fachmann auf dem Gebiet der Kriminaltechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83419f7c-a1db-4f8a-bf9c-35c014410207",
                                "sense_id": "7b568388-2648-31f9-88f1-180ab1f2af17",
                                "text": "„Kriminaltechniker, so hieß es, hätten bestätigt, dass Sprengstoff und Zündmechanismus der Bombe bis ins Detail denen anderer in Istanbul explodierter Sprengsätze glichen.“"
                            },
                            {
                                "example_id": "f83b910e-1d61-4e45-9a0a-47955ac465b2",
                                "sense_id": "7b568388-2648-31f9-88f1-180ab1f2af17",
                                "text": "„Im Garten des viktorianischen Hauses, bei den drei Turnschuhabdrücken im weichen Boden, hielt Jimmy, der große, magere Kriminaltechniker, die Plastiktüte mit dem Zahnarztzement auf und sah zu, wie der dicke Arnold vorsichtig das abgemessene Wasser hineingoss.“"
                            },
                            {
                                "example_id": "3e8ed176-75f0-4c24-b9c3-5264a682636e",
                                "sense_id": "7b568388-2648-31f9-88f1-180ab1f2af17",
                                "text": "„Neville folgte ihrem Kollegen und stellte erstaunt fest, dass oben zwei ihrer besten Kriminaltechniker auf sie warteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
