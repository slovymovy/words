                            {
                                "example_id": "5b8ff6b5-33b2-43c2-bc7d-7743663d32ab",
                                "sense_id": "9018b2f8-9c34-30b9-89f0-627a1e1157ee",
                                "text": "W razie wykorzystania globulek dopochwowych osłonowo podaje się antybiotyk"
                            }
