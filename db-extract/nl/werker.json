                            {
                                "example_id": "5a6a85a7-25c3-4335-89bf-6691cea6d0ee",
                                "sense_id": "9152a74a-68da-3c50-ab8a-7e3fe3705e0f",
                                "text": "De werkers op het bouwterrein werken hard om het project op tijd af te krijgen.",
                                "translation": "The workers at the construction site are working hard to finish the project on time.",
                                "english": "The workers at the construction site are working hard to finish the project on time."
                            },
                            {
                                "example_id": "0b24dc1c-4190-4535-b89e-f73973a9830f",
                                "sense_id": "9152a74a-68da-3c50-ab8a-7e3fe3705e0f",
                                "text": "De fabriek heeft een team van bekwame werkers die de productielijn draaiende houden.",
                                "translation": "The factory has a team of skilled workers who keep the production line running.",
                                "english": "The factory has a team of skilled workers who keep the production line running."
                            },
                            {
                                "example_id": "c3312ac0-372a-423a-a792-2c07f346d60e",
                                "sense_id": "9152a74a-68da-3c50-ab8a-7e3fe3705e0f",
                                "text": "De werkers eisten betere arbeidsvoorwaarden en hogere lonen.",
                                "translation": "The workers demanded better working conditions and higher wages.",
                                "english": "The workers demanded better working conditions and higher wages."
                            }
                        ]
                    }
