                        "sense_id": "2ec7f2fc-a9e0-30a2-8ff9-ba463f9a5ab2",
                        "entry_id": "cda5c09c-b951-3dda-95b1-90462f97f899",
                        "glosses": [
                            "Qui est rendu par l’âge ou les blessures incapable de continuer le service militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0befddd1-15ed-4681-90e3-558093b3c6f4",
                                "sense_id": "2ec7f2fc-a9e0-30a2-8ff9-ba463f9a5ab2",
                                "text": "Les officiers, les soldats invalides."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd544500-070f-3807-b21e-badf7b0a1802",
                        "entry_id": "cda5c09c-b951-3dda-95b1-90462f97f899",
                        "glosses": [
                            "Qui est atteint dans sa santé, au point de ne plus pouvoir exercer une activité normale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "38331417-30a0-329c-8855-4c1cbaba9e2c",
                        "entry_id": "cda5c09c-b951-3dda-95b1-90462f97f899",
                        "glosses": [
                            "Qui n’a pas les conditions requises par les lois pour produire son effet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78e84164-589e-4b8c-884a-b37cd6f457fc",
                                "sense_id": "38331417-30a0-329c-8855-4c1cbaba9e2c",
                                "text": "Acte invalide. — Cette donation est nulle et invalide."
                            },
                            {
                                "example_id": "cac629be-667b-42fe-ba9f-ecff03c58f0c",
                                "sense_id": "38331417-30a0-329c-8855-4c1cbaba9e2c",
                                "text": "Ce qui rend le mariage invalide, c’est le défaut d’une condition essentielle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae336779-dbca-4037-aa3f-34f5cf952043",
