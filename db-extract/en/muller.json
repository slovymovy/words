                        "entry_id": "6e6f6fd6-9df1-34a5-8d69-7592ad83a1f1",
                        "glosses": [
                            "A surname from German [in turn originating as an occupation]."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2ef56e-74c7-4602-bc58-12c90b8720f2",
                                "sense_id": "8e1a26ca-05e8-347d-8a0b-929cadbe038e",
                                "text": "“In the past you had to pick your battles, you had limited resources and limited attorneys, so you picked the things that you thought would have the biggest stakes,” Muller said. Now, election litigators don’t have to be so “choosy.”"
                            }
                        ]
                    }
