                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afbeae39-9a85-4367-8f44-ec8736a0e3c1",
                                                "sense_id": "b5294083-87ad-30cd-b0d6-6cfbd17bd154",
                                                "text": "Mike works for the local brewery."
