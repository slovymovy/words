                "translations": [
                    {
                        "translation_id": "6b1914b5-ec00-4aac-840e-1e7a26157f07",
                        "source_entry_id": "c2ca8d1e-1523-3db0-81e4-2117609c8305",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Arnoud",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arnoud",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d7669fd3-17a8-3cc2-95e6-d97a2355bc53",
                                        "entry_id": "30bae8aa-edb0-3274-bdaa-a7d08664e14d",
                                        "glosses": [
                                            "jongensnaam"
                                        ],
                                        "tags": [
                                            "masculine",
                                            "name"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "623e0a53-da15-4225-9dfd-76b73bf0392f",
                                                "sense_id": "d7669fd3-17a8-3cc2-95e6-d97a2355bc53",
                                                "text": "Boven de deur ziet Nella een reliëf met twee suikerbroden en de naam Arnoud Maakvrede."
                                            },
                                            {
                                                "example_id": "617155c1-9af1-4b9c-a31c-0f10266a7f17",
                                                "sense_id": "d7669fd3-17a8-3cc2-95e6-d97a2355bc53",
                                                "text": "Door de boog ziet ze Arnoud, die de weerbarstige karamelbrokken uit de afgekoelde bakblikken probeert te slaan, en ondertussen probeert ze te luisteren naar Hanna en Cornelia, die zachtjes met elkaar praten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed7edfb1-116d-40f9-a38e-f2e3669c4489",
                        "source_entry_id": "c2ca8d1e-1523-3db0-81e4-2117609c8305",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Arnaud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arnaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac8e3988-61b9-3acd-ab37-e5ed1a3daf36",
                                        "entry_id": "ab6e6910-fd01-3a82-85bf-9ace33a0fba8",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "807d2b46-67ed-4bec-aaae-8d756ddfe0f8",
                                                "sense_id": "ac8e3988-61b9-3acd-ab37-e5ed1a3daf36",
                                                "text": "En partenariat avec l’association Son ar Mein de Guimaëc, l’Association pour la sauvegarde de l’ancienne église du XVIᵉ siècle de Henvic a invité, mercredi, Victorien Disse et Étienne Galletier, musiciens aux théorbes et guitares baroques, accompagnés de Caroline Arnaud, soprano."
                                            },
                                            {
                                                "example_id": "3ee0f5b5-c02a-4103-b33a-2946ca823e2f",
                                                "sense_id": "ac8e3988-61b9-3acd-ab37-e5ed1a3daf36",
                                                "text": "« Dans cette saison 2, on essaie d’explorer la liberté de pensée des années 1980, associée à cette envie de capitalisme… Comment jongler avec des deux quêtes presque antinomiques ? », analyse Emmanuel Poulain-Arnaud, cocréateur et coauteur de la série."
                                            },
                                            {
                                                "example_id": "97e1b391-3366-4468-8d74-d53e78b6ea67",
                                                "sense_id": "ac8e3988-61b9-3acd-ab37-e5ed1a3daf36",
                                                "text": "Avec : Romain Arnaud-Kneisky, Swan Starosta et Alexandre Cattez."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Arnaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51edf695-3fdb-3c4c-8620-360600253426",
                                        "entry_id": "0b253033-0c90-3606-9aad-3e46758c5169",
                                        "glosses": [
                                            "Prénom masculin français, assez répandu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a73021ee-5ae0-4eed-ac3c-3398ed60ac1e",
                                                "sense_id": "51edf695-3fdb-3c4c-8620-360600253426",
                                                "text": "La seule version chantée récente de l’hymne britannique God Save the King disponible actuellement sur les plateformes de streaming a été enregistrée en 2017 par le chanteur et professeur d’opéra français Arnaud Kientz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c79ab1bf-3b88-4e82-bd80-73182128e987",
                        "source_entry_id": "c2ca8d1e-1523-3db0-81e4-2117609c8305",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Arnold",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arnold",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50f2a3da-cdad-3eef-b2a2-d0360d7f45de",
                                        "entry_id": "5c03e425-5dc7-33eb-91d1-a552be8d0320",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44d70702-7fd1-43bf-b74c-765cf962d699",
                                                "sense_id": "50f2a3da-cdad-3eef-b2a2-d0360d7f45de",
                                                "text": "Arnold Mustermann ist ein schöner Junge."
                                            },
                                            {
                                                "example_id": "9e252112-5fcb-427a-812b-ce3a25e7b029",
                                                "sense_id": "50f2a3da-cdad-3eef-b2a2-d0360d7f45de",
                                                "text": "Arnold ist 20 Jahre alt."
                                            },
                                            {
                                                "example_id": "3b9f4b3a-111a-4a1a-9298-262a4f19a3d2",
                                                "sense_id": "50f2a3da-cdad-3eef-b2a2-d0360d7f45de",
                                                "text": "Grüß bitte Arnold Mustermann herzlich von mir."
                                            },
                                            {
                                                "example_id": "5f27f552-3795-4363-8fba-448b64471a5e",
                                                "sense_id": "50f2a3da-cdad-3eef-b2a2-d0360d7f45de",
                                                "text": "Arnold hat ein schwieriges Jahr hinter sich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Arnold",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                        "entry_id": "349f1fd1-0cb2-326f-8e9f-b4ccf308d832",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname; Vorkommen in Deutschland flächendeckend, größte Dichte in Hessen, im nördlichen Baden-württemberg und in Sachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9545fa6-fc30-4eb5-8ce6-a3842b1db194",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Die Arnolds haben das größte Haus im Dorf."
                                            },
                                            {
                                                "example_id": "5259f0c5-7929-4060-ac80-743af8d5d92d",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Frau Arnold geht manchmal mit ihrer Katze spazieren."
                                            },
                                            {
                                                "example_id": "d2e0d934-2553-46aa-878f-1f1ea494782c",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Frau Arnold ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "33cfe737-0f06-42e5-ac2a-c8b3a78308a6",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Herr Arnold wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "5f27d3ce-0739-45a3-93a2-bdecbdc4df9e",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Die Arnolds fliegen heute nach Oslo."
                                            },
                                            {
                                                "example_id": "e005d64a-3129-4627-9afa-0790c1561153",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Der Arnold trägt nie die Pullover, die die Arnold ihm strickt."
                                            },
                                            {
                                                "example_id": "04d14102-c46a-4889-8029-3da89d6c9ee4",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Arnold kommt, geht der Herr Arnold.“"
                                            },
                                            {
                                                "example_id": "94ce4440-52c7-4e9d-97f0-60aaf26c9ec4",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Arnold kommt und geht."
                                            },
                                            {
                                                "example_id": "7744408f-19bd-40a7-92c0-cac6ca5a4c57",
                                                "sense_id": "ba7d0bef-aa1b-34fe-aca8-b1e14ac41372",
                                                "text": "Arnolds kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
