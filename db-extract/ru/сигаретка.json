                        "glosses": [
                            "уменьш. к сигарета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51fdb512-6701-49f3-9ccb-6d0da52e864f",
                                "sense_id": "30c27a6e-e039-3bc1-8994-b0dcd4933836",
                                "text": "В колком свете голой лампочки призрачно поблескивала отрихтованными боками допотопная «Победа», собранная из металлолома и выточенных в свободное от работы время недостающих узлов и деталей: сигаретка в зубах, матерок, прибауточки, руки по локоть в машинном масле и солидоле, «подсобляй, Лексеич», ― и он подсоблял, пытаясь уверить себя, что вся эта возня под капотом ему нравится."
                            }
                        ]
                    }
