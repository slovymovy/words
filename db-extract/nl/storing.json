                                "target_senses": [
                                    {
                                        "sense_id": "f70d1fac-cd6b-3a17-ac12-6a9983e766bd",
                                        "entry_id": "4a788ca2-7073-3422-a5c4-a8d63e96ed4a",
                                        "glosses": [
                                            "The act of disturbing, being disturbed."
                                        ],
