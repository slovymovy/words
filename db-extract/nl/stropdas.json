                                        "sense_id": "7865c8e9-e3b0-36f1-b8d2-b593c89ff6a8",
                                        "entry_id": "2cf8b89e-4291-3def-9bbd-6544f3271f47",
                                        "glosses": [
                                            "A strip of cloth worn around the neck and tied in the front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b87adb7-badd-4814-94e2-c4f4dd009b4e",
                                                "sense_id": "7865c8e9-e3b0-36f1-b8d2-b593c89ff6a8",
                                                "text": "Oh I have been to Ludlow fair / And left my necktie God knows where / And carried half way home, or near, / Pints and quarts of Ludlow beer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d17b3cfd-5a44-4ab9-b702-b0c328ead82f",
                        "source_entry_id": "6b1e8135-d93f-36ad-8e6f-4e43e68d747a",
