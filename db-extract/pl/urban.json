                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                        "entry_id": "e00192b5-25c0-3816-9ff4-12f95c1f38db",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f5a044-87ed-4748-bbff-1af4a8aa98d4",
                                                "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                                "text": "Frau Urban ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "fbc8fa95-5b33-4447-9f53-0f062df937d1",
                                                "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                                "text": "Herr Urban wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6449422e-f71e-4d29-b290-42eb9f9e58b9",
                                                "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                                "text": "Die Urbans fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "3e17a162-5e16-4865-90fb-ab496b32f287",
                                                "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                                "text": "Der Urban trägt nie die Schals, die die Urban ihm strickt."
                                            },
                                            {
                                                "example_id": "2836acc5-4f8a-49b4-97fd-54fb0adf22be",
                                                "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Urban kommt, geht der Herr Urban.“"
                                            },
                                            {
                                                "example_id": "d430f408-a1fb-43c1-8888-73009321e5e0",
                                                "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                                "text": "Urban kommt und geht."
                                            },
                                            {
                                                "example_id": "e7e762cd-ca7e-4933-a186-f5c8dcf025cb",
                                                "sense_id": "e8a30ce4-9138-3b5b-9510-738778d323e8",
                                                "text": "Urbans kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e71d148-3f72-4afb-9802-79235fb0be8c",
                        "source_entry_id": "1a3e9732-64f7-3e01-ba41-b661668ffdd3",
