    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f59916c4-5714-3b88-946e-a4a85dc3353c",
                    "sense_definition": "Cavité naturelle et profonde dans la roche, dans une montagne ou sous terre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cavité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spéléologues ont exploré une immense <w>caverne</w> cachée sous la falaise."
                        },
                        {
                            "text": "Pendant la tempête, les randonneurs ont trouvé refuge à l'entrée d'une <w>caverne</w>."
                        }
                    ],
                    "synonyms": [
                        "antre",
                        "creûte",
                        "grotte"
                    ],
                    "common_phrases": [
                        "homme des cavernes",
                        "caverne d'Ali Baba"
                    ]
                },
                {
                    "sense_id": "b07b8c30-1b30-39fd-8ed7-8ebb389994f5",
                    "sense_definition": "Lieu mal famé ou dangereux où l'on risque de se faire dépouiller ou agresser.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lieu_dangereux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refusait d'entrer dans cette auberge sombre qu'il considérait comme une véritable <w>caverne</w>."
                        },
                        {
                            "text": "La police a finalement démantelé cette <w>caverne</w> de malfaiteurs au fond de l'impasse."
                        }
                    ],
                    "synonyms": [
                        "antre"
                    ],
                    "common_phrases": [
                        "caverne de voleurs"
                    ]
                },
                {
                    "sense_id": "e6b03011-cd69-34c7-8fea-ba0fbf4aa7c8",
                    "sense_definition": "Cavité anormale creusée dans un organe, en particulier le poumon, à la suite de la destruction de tissus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "médecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La radiographie a révélé la présence d'une <w>caverne</w> pulmonaire liée à la tuberculose."
                        },
                        {
                            "text": "Le médecin surveille attentivement l'évolution de ces <w>cavernes</w> chez le patient infecté."
                        }
                    ],
                    "common_phrases": [
                        "caverne pulmonaire"
                    ]
                }
            ]
        }
    ]
