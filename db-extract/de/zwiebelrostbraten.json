                "senses": [
                    {
                        "sense_id": "198fc106-8466-3973-af8a-18a79b6722fd",
                        "entry_id": "104336a5-9bee-3aa8-b5f5-5f446e59f378",
                        "glosses": [
                            "gebratenes Fleischstück von der Rinderlende mit gebräunten Zwiebelringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6eede81-2b15-40c7-9f9a-cdaee33ec2a4",
                                "sense_id": "198fc106-8466-3973-af8a-18a79b6722fd",
                                "text": "Mir schmeckt ein Zwiebelrostbraten am besten mit Bratkartoffeln."
                            },
                            {
                                "example_id": "adbce211-b96a-4840-9eb0-6241140efbf9",
                                "sense_id": "198fc106-8466-3973-af8a-18a79b6722fd",
                                "text": "„Es gibt Gulasch, Kalbsbeuschel und Paprikahuhn. Zwiebelrostbraten, Schopfbraten (Schweinekamm) mit Sauerkraut und Knödel, geröstete Leber, ‚Blunzen-Gröschtl‘ (gebratene Blutwurst), Ochsenbraten oder Schinkenfleckerl. Auch Innereien werden offeriert.“"
                            },
                            {
                                "example_id": "fca8317a-a5d4-4deb-bcb9-aa932bf35250",
                                "sense_id": "198fc106-8466-3973-af8a-18a79b6722fd",
                                "text": "„Dann gingen wir zu zweit Zwiebelrostbraten mit Spätzle essen, so wie wir das schon getan hatten, als ich klein war und bei meinen Großeltern die Sommerferien verbrachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
