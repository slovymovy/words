    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                    "sense_definition": "Causing laughter or providing entertainment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film has some <w>amusing</w> moments, but it is unlikely to make you laugh out loud.",
                            "target_lang_translations": {
                                "ru": "В фильме есть несколько <w>забавных</w> моментов, но вряд ли он заставит вас смеяться в голос.",
                                "es": "La película tiene algunos momentos <w>divertidos</w>, pero es poco probable que te haga reír a carcajadas.",
                                "fr": "Le film a quelques moments <w>amusants</w>, mais il est peu probable qu'il vous fasse rire aux éclats."
                            }
                        },
                        {
                            "text": "He told us an <w>amusing</w> story about his recent holiday in France.",
                            "target_lang_translations": {
                                "ru": "Он рассказал нам <w>забавную</w> историю о своем недавнем отпуске во Франции.",
                                "es": "Nos contó una historia <w>graciosa</w> sobre sus recientes vacaciones en Francia.",
                                "fr": "Il nous a raconté une histoire <w>amusante</w> sur ses récentes vacances en France."
                            }
                        }
                    ],
                    "synonyms": [
                        "funny",
                        "entertaining",
                        "humorous",
                        "witty",
                        "comical"
                    ],
                    "antonyms": [
                        "boring"
                    ],
                    "common_phrases": [
                        "amusing story",
                        "find amusing",
                        "highly amusing",
                        "amusing incident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий смех или развлекающий; смешной или интересный.",
                        "es": "Que causa risa, resulta entretenido o hace pasar un rato agradable.",
                        "fr": "Qui provoque le rire ou procure du divertissement ; drôle ou plaisant."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забавный",
                                "target_lang_sense_clarification": "вызывающий улыбку, потешный"
                            },
                            {
                                "target_lang_word": "смешной",
                                "target_lang_sense_clarification": "вызывающий смех"
                            },
                            {
                                "target_lang_word": "занятный",
                                "target_lang_sense_clarification": "интересный, увлекательный"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "divertido",
                                "target_lang_sense_clarification": "que entretiene o hace pasar un buen rato"
                            },
                            {
                                "target_lang_word": "gracioso",
                                "target_lang_sense_clarification": "que causa risa o tiene gracia"
                            },
                            {
                                "target_lang_word": "entretenido",
                                "target_lang_sense_clarification": "que mantiene el interés o distrae gratamente"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "amusant",
                                "target_lang_sense_clarification": "qui divertit ou prête à sourire"
                            },
                            {
                                "target_lang_word": "drôle",
                                "target_lang_sense_clarification": "qui fait rire, comique"
                            },
                            {
                                "target_lang_word": "divertissant",
                                "target_lang_sense_clarification": "qui distrait agréablement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d578877-ecef-3472-8b48-819b6b3d2de5",
                    "sense_definition": "The present participle and gerund of <w>amuse</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street performer was <w>amusing</w> the crowd with his magic tricks.",
                            "target_lang_translations": {
                                "ru": "Уличный артист <w>развлекал</w> толпу своими фокусами.",
                                "es": "El artista callejero estaba <w>entreteniendo</w> a la multitud con sus trucos de magia.",
                                "fr": "L'artiste de rue <w>amusait</w> la foule avec ses tours de magie."
                            }
                        },
                        {
                            "text": "She is <w>amusing</w> herself by reading a comic book while she waits.",
                            "target_lang_translations": {
                                "ru": "Она <w>развлекает</w> себя чтением комиксов, пока ждет.",
                                "es": "Se está <w>divirtiendo</w> leyendo un cómic mientras espera.",
                                "fr": "Elle <w>s'amuse</w> à lire une bande dessinée en attendant."
                            }
                        }
                    ],
                    "traits": [
