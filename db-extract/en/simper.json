                        ],
                        "form": "simpering"
                    },
                    {
                        "form_id": "e5c6017c-5f9d-4ba6-b60a-a37dc0ad412a",
                        "entry_id": "f1151075-433d-338d-aa1a-3c7fba9a8530",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "simpered"
                    },
                    {
                        "form_id": "b93b7434-0455-4990-9556-41ed304a0f8c",
                        "entry_id": "f1151075-433d-338d-aa1a-3c7fba9a8530",
                        "tags": [
                            "past"
                        ],
                        "form": "simpered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc88a791-b4fc-3041-b901-0c460fd983e4",
                        "entry_id": "f1151075-433d-338d-aa1a-3c7fba9a8530",
                        "glosses": [
                            "To smile in a foolish, frivolous, self-conscious, coy, obsequious, or smug manner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "80a82cf0-5e0b-4536-839a-5ae740b03801",
                                "sense_id": "fc88a791-b4fc-3041-b901-0c460fd983e4",
                                "text": "How the fools kotowed and simpered while I looked over their jewels and speculated upon how much I could get for them!"
                            },
                            {
                                "example_id": "0e95f47e-3493-4c81-9727-d3a7159cc248",
                                "sense_id": "fc88a791-b4fc-3041-b901-0c460fd983e4",
                                "text": "a whimpering, simpering child"
                            },
                            {
                                "example_id": "3026f378-a517-4460-b645-e9573026f841",
                                "sense_id": "fc88a791-b4fc-3041-b901-0c460fd983e4",
                                "text": "But where daft Nell simpers at him and tries to muss his slicked hair and pull it forward over his broad, Christian brow, my little Dot is looking nowhere but at the ground, still praying, praying even while she stands, and Rick has actually to touch her forearm with his finger in order to alert her to his Godlike nearness."
                            }
                        ]
                    },
                    {
                        "sense_id": "572445a9-66f5-3892-85b0-892aed068ecf",
                        "entry_id": "f1151075-433d-338d-aa1a-3c7fba9a8530",
                        "glosses": [
                            "To glimmer; to twinkle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5d91b103-4e29-41f7-bb27-8bb3a3a04698",
                                "sense_id": "572445a9-66f5-3892-85b0-892aed068ecf",
                                "text": "Yet can I mark how stars above / Simper and shine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9180df2f-6423-476f-99f9-65780f0e7848",
                        "source_entry_id": "f1151075-433d-338d-aa1a-3c7fba9a8530",
                        "source_sense_description": "To smile in a frivolous manner",
                        "target_lang_word": "minauder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minauder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adc10ed4-d64d-3569-a090-ac7575a86516",
                                        "entry_id": "519d8907-bda0-3684-9e01-7e19ca9fd8f7",
                                        "glosses": [
                                            "Faire certaines mines, affecter certaines manières pour plaire et paraître plus agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02be72a1-d91f-4686-9609-ad15dc4439be",
                                                "sense_id": "adc10ed4-d64d-3569-a090-ac7575a86516",
                                                "text": "Moqueur, minauda-t-elle, vous jouez-vous à me distraire ?"
                                            },
                                            {
                                                "example_id": "4587d2bf-2a44-4115-b1ef-a52560e55f30",
                                                "sense_id": "adc10ed4-d64d-3569-a090-ac7575a86516",
                                                "text": "Il y avait sur la pendule un petit Cupidon de bronze, qui minaudait en arrondissant les bras sous une guirlande dorée."
                                            },
                                            {
                                                "example_id": "1c3f152f-33e6-4f0e-a0ee-3f76c0f5d42d",
                                                "sense_id": "adc10ed4-d64d-3569-a090-ac7575a86516",
                                                "text": "Suzanne, en minaudant, me parle d’un manteau de fourrure, véritable occasion pour cet hiver et qu’il ne faudrait pas laisser passer !"
                                            },
                                            {
                                                "example_id": "b05282aa-5ee6-42ad-87ca-f9bb693ddf41",
                                                "sense_id": "adc10ed4-d64d-3569-a090-ac7575a86516",
                                                "text": "Anna s’épanouissait à l’école maternelle et continuait d’être très gâtée par Christian dont elle supportait mal les niaiseries et « gagatismes » car il lui parlait et minaudait comme un bébé… ce qui me confortait davantage dans mon projet de départ."
                                            },
                                            {
                                                "example_id": "9bb41457-05db-4b24-b774-05195db68aa9",
                                                "sense_id": "adc10ed4-d64d-3569-a090-ac7575a86516",
                                                "text": "Toute différente était l'impression produite par la grande femme maigre et minaudante qui, dans une étrange confusion de rayures, de franges, d'écharpes flottantes, défilait au bras de Mr.Mingott."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
