                "forms": [],
                "senses": [
                    {
                        "sense_id": "c59b064e-b045-39da-9bb5-21ea6f207d22",
                        "entry_id": "476079ae-732c-39c2-9609-be9aab6c8814",
                        "glosses": [
                            "stopień wyższy od: wcześnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17e6e8ae-d991-409a-825e-42ae33ceace1",
                                "sense_id": "c59b064e-b045-39da-9bb5-21ea6f207d22",
                                "text": "Dziś byłem w biurze wcześniej niż wczoraj."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "95df46c5-203a-3932-8f23-d4c7ad3d2a2c",
                        "entry_id": "476079ae-732c-39c2-9609-be9aab6c8814",
                        "glosses": [
                            "przed upływem pewnego określonego czasu; przed jakimś wydarzeniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53f2c3f9-b4f5-49a0-b2bd-fa24d063fe3b",
                                "sense_id": "95df46c5-203a-3932-8f23-d4c7ad3d2a2c",
                                "text": "Spóźniłem się, bo autobus odjechał dwie minuty wcześniej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "c55dc8a0-fab8-3742-a38a-99ff192da442",
                        "entry_id": "476079ae-732c-39c2-9609-be9aab6c8814",
                        "glosses": [
                            "poprzednio lub dawniej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad680cf-547d-480c-9938-1f961a1ea582",
                                "sense_id": "c55dc8a0-fab8-3742-a38a-99ff192da442",
                                "text": "Znam to miejsce – byłem tu już wcześniej."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3a51eb7-b80d-4495-ac55-1352b03c4053",
                        "source_entry_id": "476079ae-732c-39c2-9609-be9aab6c8814",
                        "source_sense_id": "95df46c5-203a-3932-8f23-d4c7ad3d2a2c",
                        "target_lang_word": "ago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                        "entry_id": "5b91c62b-d8e0-3ab1-8f9c-501d8f2368af",
                                        "glosses": [
                                            "Before now, before the present time"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b674c7a9-b0d6-4aaa-97f0-ae4cce6a97d7",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "I got married ten years ago."
                                            },
                                            {
                                                "example_id": "de73bf0f-02f0-4a97-ba4c-0bbd0eabab6a",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "Two years ago a pair of scientists sparked fears of a devastating virus."
                                            },
                                            {
                                                "example_id": "8f97ab66-f181-464d-85d8-9a29c9e9de94",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "When they first met in 2000, my dad told my mom how he had gotten the money. The story begins 20 years ago."
                                            },
                                            {
                                                "example_id": "ff9fda4f-2c37-44d4-8118-987ced96aeb5",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "It was two weeks ago that I saw her last."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37540545-e4df-30f9-ac98-be0724e474b6",
                                        "entry_id": "50c4964a-bafc-3554-8a92-8c889e661a61",
                                        "glosses": [
                                            "Gone; gone by; gone away; passed; passed away."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031ed60e-77e8-491c-936a-cb337552ae9a",
                                                "sense_id": "37540545-e4df-30f9-ac98-be0724e474b6",
                                                "text": "in days ago / in days agone"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ec11e7-0a12-345d-ac65-08fb893eddbc",
                                        "entry_id": "50c4964a-bafc-3554-8a92-8c889e661a61",
                                        "glosses": [
                                            "Nearly gone; dead. (used in Devonshire at the turn of the 19th century)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9625d9-9d5f-49de-bd4c-cda1a7deb663",
                                                "sense_id": "13ec11e7-0a12-345d-ac65-08fb893eddbc",
                                                "text": "Woe the day—she is agone!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f49a9ad-5d68-4908-8265-584eeb7612c7",
