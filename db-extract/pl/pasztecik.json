                    },
                    {
                        "sense_id": "97c8b7f0-6c16-3a55-bd13-f55ea02783bd",
                        "entry_id": "c3736782-71b0-3053-b750-0cc705991918",
                        "glosses": [
                            "pieczony pierożek z ciasta francuskiego, drożdżowego lub kruchego, napełniony farszem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a21cc67-b661-40ec-9733-e03e299554f9",
                                "sense_id": "97c8b7f0-6c16-3a55-bd13-f55ea02783bd",
                                "text": "Uwielbiam paszteciki mojej babci."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a8fe335-a65a-40d2-9384-7fd281b85102",
                        "source_entry_id": "c3736782-71b0-3053-b750-0cc705991918",
                        "source_sense_id": "97c8b7f0-6c16-3a55-bd13-f55ea02783bd",
                        "target_lang_word": "pasty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97c43826-5818-388c-91bb-6a3d893f576c",
                                        "entry_id": "702d119e-4213-3edb-b2b8-9f8d08fdf4c7",
                                        "glosses": [
                                            "Like paste, sticky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad279c99-5e4f-4b46-b766-59e1b8f57345",
                                                "sense_id": "97c43826-5818-388c-91bb-6a3d893f576c",
                                                "text": "These mashed potatoes aren’t cooked well; they are very pasty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e488f13a-5cb3-36f1-8646-ddd77866497e",
                                        "entry_id": "702d119e-4213-3edb-b2b8-9f8d08fdf4c7",
                                        "glosses": [
                                            "Pale, lacking colour, having a pallor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57235528-ec57-4307-9b9e-1861e0599941",
                                                "sense_id": "e488f13a-5cb3-36f1-8646-ddd77866497e",
                                                "text": "He is pasty-faced."
                                            },
                                            {
                                                "example_id": "075fe9a3-22ce-4b3a-ba80-a48237dffe25",
                                                "sense_id": "e488f13a-5cb3-36f1-8646-ddd77866497e",
                                                "text": "(figuratively) He was feeling pasty."
                                            },
                                            {
                                                "example_id": "0e736217-a7e1-4dcc-95da-19d8dbde4602",
                                                "sense_id": "e488f13a-5cb3-36f1-8646-ddd77866497e",
                                                "text": "Are you feeling OK? You look a bit pasty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51babfca-f0b3-348a-9939-8e0cfb29b2e9",
                                        "entry_id": "702d119e-4213-3edb-b2b8-9f8d08fdf4c7",
                                        "glosses": [
                                            "Whiteskinned."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "offensive",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9935d34-a3ba-4f1b-a25e-9d91b9e48470",
                                                "sense_id": "51babfca-f0b3-348a-9939-8e0cfb29b2e9",
                                                "text": "He smoothed his tailored suit and red tie. \"Boy, does it look like I ain't rich now? My pockets are already full of paper! Why the fuck would I want to risk doing business with some pasty cracker? For all I know, you a cop!\""
                                            },
                                            {
                                                "example_id": "11a22f24-d61b-457d-9b54-2436b6cf4e34",
                                                "sense_id": "51babfca-f0b3-348a-9939-8e0cfb29b2e9",
                                                "text": "“So, snow bunny, what should black women do? How do we...oh, how do I say this... cure our brothas of this widespread, pasty disease?” I didn't reply. Again, I tried to step away. Again, she grabbed my arm."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688375bc-a4b6-395c-9731-303197d6eba6",
                                        "entry_id": "b4dff7c6-25e8-3957-9557-6a86220874e4",
                                        "glosses": [
                                            "A type of seasoned meat and vegetable hand pie, usually of a semicircular shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f14f2f64-632f-30c9-b9bd-bd0a768700f2",
                                        "entry_id": "ff558365-f8f8-3b2b-991b-35797d04b5ea",
                                        "glosses": [
                                            "Alternative spelling of pastie (“a small item of clothing that conceals little more than the nipple of a woman's breast, primarily worn by female exotic dancers”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e8b6ac4-d124-42f2-aa5a-4c917c201914",
                                                "sense_id": "f14f2f64-632f-30c9-b9bd-bd0a768700f2",
                                                "text": "Nonchalantly she bared one succulent pasty-topped breast."
                                            },
                                            {
                                                "example_id": "fdfead60-1869-4584-ae9b-0d8b734944e8",
                                                "sense_id": "f14f2f64-632f-30c9-b9bd-bd0a768700f2",
                                                "text": "One of the experienced dancers dabbed a bit of rubber cement inside a silver-sequinned pasty and told Betty to place it over her nipple"
                                            },
                                            {
                                                "example_id": "e908e82a-59ee-40c8-9dd4-b44d61b3177c",
                                                "sense_id": "f14f2f64-632f-30c9-b9bd-bd0a768700f2",
                                                "text": "There really is no other purpose for wearing a pasty than to avoid being arrested for indecency."
                                            },
                                            {
                                                "example_id": "d48d4cd6-8a25-46c6-9b34-666a1260b567",
                                                "sense_id": "f14f2f64-632f-30c9-b9bd-bd0a768700f2",
                                                "text": "\"What's a pasty?\" ¶ \"That's what strippers and showgirls used to wear to cover their nipples in teh old, tamer days of yore. They were round paper disks with spangles on one side and paste on the other; hence the term pasty.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
