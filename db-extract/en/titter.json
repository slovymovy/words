        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7feda17a-0302-3fb3-8041-5174918ca7f7",
                "word": "titter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4c03e832-9f38-4d0e-865d-edb9c92abafb",
                        "entry_id": "7feda17a-0302-3fb3-8041-5174918ca7f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "titters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df4119c6-ff3f-3d65-ac3f-c2834c440cab",
                        "entry_id": "7feda17a-0302-3fb3-8041-5174918ca7f7",
                        "glosses": [
                            "A woman's breast."
                        ],
                        "tags": [
                            "in-plural",
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "be297cf9-3307-4750-a066-0b02b4aa8b13",
                                "sense_id": "df4119c6-ff3f-3d65-ac3f-c2834c440cab",
                                "text": "Flesh Gordon 2 - I remember that this one was chock full of big titters. Many of them looked like the natural variety, as well."
                            },
                            {
                                "example_id": "62ac7a04-3337-481d-8855-b3f2ed3457eb",
                                "sense_id": "df4119c6-ff3f-3d65-ac3f-c2834c440cab",
                                "text": "there was an old lady from raleigh\nwho was so doggone nasty by golly\njust squeezin her titters\nyou'd pick up some critters\nand bathe twice in one month for your folly"
                            },
                            {
                                "example_id": "41ba6367-7336-4914-810e-9805d016ec43",
                                "sense_id": "df4119c6-ff3f-3d65-ac3f-c2834c440cab",
                                "text": "“The poor dear, even her titters are weighted down with melancholy,” Pearle said to Mable.\n“I don't know what you're talking about. Her titters look perky enough to me,” Mable replied."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "78cecfdb-a6dd-3bba-8707-66077cad8808",
                "word": "titter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "43208782-7ab0-400d-ae5f-f83774e4e8d8",
                        "entry_id": "78cecfdb-a6dd-3bba-8707-66077cad8808",
                        "tags": [
                            "plural"
                        ],
                        "form": "titters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72a6cae8-ee59-3c3c-b88e-5f428bf1d7c3",
                        "entry_id": "78cecfdb-a6dd-3bba-8707-66077cad8808",
                        "glosses": [
                            "A nervous or somewhat repressed giggle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb68dacf-7845-4768-ad04-c1df84be07bb",
                                "sense_id": "72a6cae8-ee59-3c3c-b88e-5f428bf1d7c3",
                                "text": "April 21, 1811, Samuel Taylor Coleridge, Table Talk\nThere was a titter of […] delight on his countenance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e96dbe12-1ea9-439e-b6c0-dbc86599c7d9",
                        "source_entry_id": "78cecfdb-a6dd-3bba-8707-66077cad8808",
                        "source_sense_id": "72a6cae8-ee59-3c3c-b88e-5f428bf1d7c3",
                        "source_sense_description": "nervous or repressed giggle",
                        "target_lang_word": "ricanement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ricanement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3bf77ec-468a-3fc2-bef2-a7d9aee1dc04",
                                        "entry_id": "1b54c193-5ed3-3abd-908a-37ce9955f128",
                                        "glosses": [
                                            "Action de ricaner ; bruit que fait cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f5e116-115c-4c23-acb5-df1769715af7",
                                                "sense_id": "f3bf77ec-468a-3fc2-bef2-a7d9aee1dc04",
                                                "text": "Toute la nuit, des gens louvoient sous mes fenêtres, vocifèrent, gambadent, font entendre de longs ricanements. […]. Quelle est cette interminable bamboche, cette effrénée descente de la Courtille ?"
                                            },
                                            {
                                                "example_id": "4010cd16-26f8-42bd-a86e-b1dbe48b256f",
                                                "sense_id": "f3bf77ec-468a-3fc2-bef2-a7d9aee1dc04",
                                                "text": "Gabriel le savait déjà. Il savait aussi que chez certaines êtres l’humour – voire le ricanement – est une forme de pudeur."
                                            },
                                            {
                                                "example_id": "47901c10-ee20-445a-af24-7e34ead153e1",
                                                "sense_id": "f3bf77ec-468a-3fc2-bef2-a7d9aee1dc04",
                                                "text": "Jamais les spectres des morts du 6 Février ne quitteront plus ces hommes, malgré leurs fanfaronnades, leurs plastronnades, leurs mensonges, leurs ricanements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fafa34c-493e-3f79-9aad-09f027d4d0a3",
                                        "entry_id": "1b54c193-5ed3-3abd-908a-37ce9955f128",
                                        "glosses": [
                                            "Cri de la hyène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f915c07-2308-4f9f-82ca-10d509aa884f",
                                                "sense_id": "9fafa34c-493e-3f79-9aad-09f027d4d0a3",
                                                "text": "Quant à la hyène, sa forme étrange, ses allures mystérieuses, son invisibilité le jour et les ricanements sinistres par lesquels elle annonce sa présence la nuit, en font pour l’indigène une espèce de vampire ou de loup-garou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10310c25-c0f2-469e-bf41-178129f4cf47",
                        "source_entry_id": "78cecfdb-a6dd-3bba-8707-66077cad8808",
