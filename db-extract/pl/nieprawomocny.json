                                        "examples": [
                                            {
                                                "example_id": "691c41fa-ab5c-48bb-b733-ca26ea433d82",
                                                "sense_id": "4f901494-7161-336c-a7a7-cfabe7e298d9",
                                                "text": "Klein diagnoses impressively what hasn’t worked. No more claptrap about fracked gas as a bridge to renewables. Enough already of the international summit meetings that produce sirocco-quality hot air, and nonbinding agreements that bind us all to more emissions."
                                            },
                                            {
                                                "example_id": "7e97f666-3a4a-4c1a-be9b-01d6585c363b",
                                                "sense_id": "4f901494-7161-336c-a7a7-cfabe7e298d9",
                                                "text": "Such is the alarm about the fragility of French in Quebec that a few years ago the provincial government passed a nonbinding resolution calling for shop attendants to replace “bonjour hi” — a common greeting in bilingual, tourist-friendly Montreal — with just “bonjour.”"
                                            }
