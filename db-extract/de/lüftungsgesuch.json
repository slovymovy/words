                "senses": [
                    {
                        "sense_id": "b14c7219-bd90-345a-90a1-41c6d2559594",
                        "entry_id": "43f5be6d-bd23-32f7-9704-a38085e9ed48",
                        "glosses": [
                            "Schreiben, das jemand an eine Behörde gerichtet hat, um eine baurechtliche Genehmigung oder Bewilligung für eine Lüftungstechnik zu erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bc1eec-b5b2-4824-833b-bacc743b9c21",
                                "sense_id": "b14c7219-bd90-345a-90a1-41c6d2559594",
                                "text": "„Das Lüftungsgesuch mit allen enthaltenen Luftbehandlungsgeräten haben wir im Mai 2006 in 7-facher Ausfertigung an die Untere Bauaufsichtbehörde zur Weiterleitung an die fachlich beteiligten Ämter eingereicht.“"
                            },
                            {
                                "example_id": "7da25940-3ff0-4835-a395-7307ff4eb4df",
                                "sense_id": "b14c7219-bd90-345a-90a1-41c6d2559594",
                                "text": "„Dieses Lüftungsgesuch ist Teil der Baugenehmigung und daher für die Errichtung dieser Anlagen unentbehrlich.“"
                            },
                            {
                                "example_id": "abb1eadb-e297-40f3-b018-07ea4d2a9944",
                                "sense_id": "b14c7219-bd90-345a-90a1-41c6d2559594",
                                "text": "„In den Ausführungen im „Lüftungsgesuch\", welches Bestandteil des Bauantrages ist, war die geschossübergreifende Entrauchung bereits nicht auszuschließen.“"
                            },
                            {
                                "example_id": "0ba4f7c9-1712-45c5-a73e-40771892a0b1",
                                "sense_id": "b14c7219-bd90-345a-90a1-41c6d2559594",
                                "text": "„Bei Sonderbauten wie z.B. Krankenhäusern, Altenheimen, Versammlungsstätten, etc. gelangt ein zur Genehmigungsplanung erstelltes Lüftungsgesuch als Bestandteil des Bauantrags immer höheren Stellenwert.“"
                            },
                            {
                                "example_id": "1fadfe31-bc61-487e-b638-99a74718a5e1",
                                "sense_id": "b14c7219-bd90-345a-90a1-41c6d2559594",
                                "text": "„In weiteren Bauvorlagen wie z.B. das Lüftungsgesuch wird der Brandschutz an Lüftungsanlagen/RLT im einzelnen verifiziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
