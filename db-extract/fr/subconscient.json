                    {
                        "sense_id": "54fe9159-6808-33c8-8bcc-0ae9985316e0",
                        "entry_id": "45d8303b-897b-3bb6-8571-ea0da33ee9dc",
                        "glosses": [
                            "Synonyme courant de inconscient; ce qui échappe à la conscience claire, mais la nourrit cependant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5882df-9906-4437-af55-67a4d03c3807",
                                "sense_id": "54fe9159-6808-33c8-8bcc-0ae9985316e0",
                                "text": "Alfred de Vigny se fiait au subconscient du soin de mûrir ses idées; mûres, il les retrouvait; elles venaient d'elles-mêmes s'offrir, riches de toutes leurs conséquences."
                            },
                            {
                                "example_id": "47326b44-8c99-49a7-a1bb-e6a81c9fbd3b",
                                "sense_id": "54fe9159-6808-33c8-8bcc-0ae9985316e0",
                                "text": "Bien sûr les programmes de divertissement ne s'adressent pas directement au subconscient du téléspectateur. Mais il est sûr qu'au-delà du téléspectateur, c'est bien le consommateur qu'on cherche à atteindre."
                            }
                        ]
                    }
