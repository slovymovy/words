                "forms": [
                    {
                        "form_id": "bf0fa202-1352-4451-9e3a-32702cf88831",
                        "entry_id": "85e03e2f-b789-346a-996e-648f08915fb3",
                        "tags": [
                            "plural"
                        ],
                        "form": "kirpans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86bb3c87-abb0-3c78-ab67-942892b4ef3f",
                        "entry_id": "85e03e2f-b789-346a-996e-648f08915fb3",
                        "glosses": [
                            "Arme symbolique s’apparentant à un poignard, portée par les Sikhs orthodoxes pour rappeler le besoin de lutter contre l’oppression et l’injustice."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "3e1cfe67-9485-4318-af23-183c0521629a",
                                "sense_id": "86bb3c87-abb0-3c78-ab67-942892b4ef3f",
                                "text": "Et pourtant, tristement, selon la formulation de leur culte, le kirpan représente leur « droit » (concret ou abstrait, factuel ou ritualisé) à une forme féodale et spadassine d’autoprotection."
                            },
                            {
                                "example_id": "ac4735bd-1a60-4544-92f1-509ba8af8ea6",
                                "sense_id": "86bb3c87-abb0-3c78-ab67-942892b4ef3f",
                                "text": "Notons qu’en 2011, le geste de la WSOC avait été perçu comme de la provocation dans la mesure où la délégation avait été avertie qu’elle ne pourrait entrer avec des kirpans."
                            },
                            {
                                "example_id": "d3778fbe-84be-402b-b750-3c1a4295ac0d",
                                "sense_id": "86bb3c87-abb0-3c78-ab67-942892b4ef3f",
                                "text": "Lundi dernier, l’homme avait été convoqué comme juré à la cour de la couronne de Birmingham, au Royaume-Uni, au moment où un garde de sécurité lui aurait interdit l’entrée avec son kirpan, un couteau religieux porté en signe de foi, après la pause du dîner."
                            }
                        ]
                    }
                ],
