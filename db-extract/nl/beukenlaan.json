                        "examples": [
                            {
                                "example_id": "2091bcc6-c1ab-4db1-8e32-ddc6dc72f8fa",
                                "sense_id": "276eef61-1ddf-32ba-8542-b7e3ea23750e",
                                "text": "Dit is een boswandeling volgens de regels van de kunst. Met beukenlanen, beukenpaden, beukenwegjes. Beuken maken mooi bos. Ze houden het transparant omdat ze geen struiken onder zich dulden. Ze houden het intiem omdat ze niet kaal worden, ze bewaren hun blad verdord aan hun takken tot ze nieuw hebben. Niettemin verzorgen ze een dikke laag oud blad op de vloer, dof bobbelgoud dat de duizenden jonge groene topjes in het mos opjut om op te vallen."
                            }
                        ]
                    }
