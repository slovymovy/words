                            }
                        },
                        {
                            "text": "He looked <w>blankly</w> into the distance, unable to process the terrible news.",
                            "target_lang_translations": {
                                "zh": "他<w>呆呆地</w>望着远方，无法接受这个可怕的噩耗。"
                            }
                        }
