                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "384347ce-8387-3722-afae-c73b5cb51f79",
                                        "entry_id": "e4c08f7b-3443-3fbd-a7f6-eee0be06ee2b",
                                        "glosses": [
                                            "nicht eindeutig bestimmbar, nicht genau zuordenbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2efc4e84-3935-4c08-8a8c-30f9895317a4",
                                                "sense_id": "384347ce-8387-3722-afae-c73b5cb51f79",
                                                "text": "In dem Fass befand sich irgendeine undefinierbare Pampe."
                                            },
                                            {
                                                "example_id": "3aed3e24-efe2-4971-836c-7a4342fc4144",
                                                "sense_id": "384347ce-8387-3722-afae-c73b5cb51f79",
                                                "text": "„Endlich ging die Tür auf. Doch es war nur eine rothaarige Krankenschwester, die ohne einen Blick auf die Besucher zu einer anderen Tür eilte und dann mit einem undefinierbaren Gegenstand zurückkehrte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05764a69-8b8a-40df-8105-85bcbe968611",
                        "source_entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
