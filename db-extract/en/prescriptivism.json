                        "source_sense_id": "786f7fb9-3a29-33f8-a7e4-804dc51b94c2",
                        "source_sense_description": "prescribing idealistic language norms",
                        "target_lang_word": "prescriptivisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prescriptivisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79da0b8b-d132-37bd-a89c-c5925364e99d",
                                        "entry_id": "73eb0cdb-6269-361a-8876-2baf2e84bf98",
                                        "glosses": [
                                            "Conception d’une langue en fonction d’une norme idéale et standard déterminée par un ensemble de règles strictes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "824aa707-82b7-4e85-92ad-1d203768bded",
                                                "sense_id": "79da0b8b-d132-37bd-a89c-c5925364e99d",
                                                "text": "Mon parcours métalinguistique de cette mauvaise langue montrera que le prescriptivisme procède d’une prolifération des types à partir d’une occurrence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "977e6c93-e673-4df8-8960-aa37588aef28",
                        "source_entry_id": "c170b0b1-e06e-3757-9f42-7fd160e09201",
                        "source_sense_id": "786f7fb9-3a29-33f8-a7e4-804dc51b94c2",
                        "source_sense_description": "prescribing idealistic language norms",
                        "target_lang_word": "normativisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normativisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef526b0-2902-3643-a0c1-cd3611254f2f",
                                        "entry_id": "13343ba7-e786-338c-8ca2-91baaf4befec",
                                        "glosses": [
                                            "Attitude normative systématique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cef1e0d-2e5a-457a-8766-e5c2074cf7f1",
                                                "sense_id": "7ef526b0-2902-3643-a0c1-cd3611254f2f",
                                                "text": "Loin de tout normativisme et de toute prophétie, je constate, sans plus, dans des cas importants et non douteux, la réalité d'un profit."
                                            },
                                            {
                                                "example_id": "94900387-6b66-4901-84a1-0444639c8284",
                                                "sense_id": "7ef526b0-2902-3643-a0c1-cd3611254f2f",
                                                "text": "Le normativisme logiciste a abusé de l'opposition kantienne de l'être et du devoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7045d6b9-615c-34e9-b70a-ec9e5dbb0244",
                                        "entry_id": "13343ba7-e786-338c-8ca2-91baaf4befec",
                                        "glosses": [
                                            "Théorie du droit développée par Hans Kelsen, qui énonce un système juridique fondé sur la hiérarchie des normes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b424c25c-87c0-4117-844b-88ed096677a0",
                                                "sense_id": "7045d6b9-615c-34e9-b70a-ec9e5dbb0244",
                                                "text": "Dans le normativisme, une norme n'appartient à l'ordre juridique que parce qu'elle a été créée conformément aux dispositions d'une norme supérieure du même ordre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
