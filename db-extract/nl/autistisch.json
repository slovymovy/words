                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3651fcf7-beaf-3dfd-a064-dc8d80915139",
                        "entry_id": "6deae50b-8574-3f9b-9a90-e864f11be48d",
                        "glosses": [
                            "van gedrag dat het lijkt op dat van iemand met autisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99c31bc-b85e-4601-8253-67afe8aa330b",
                                "sense_id": "3651fcf7-beaf-3dfd-a064-dc8d80915139",
                                "text": "Ik nam me voor veel flexibeler te worden en mijn plannen vaker los te laten. Misschien ligt het aan mij, maar veel mannen worden met het verstrijken van de jaren star en steeds minder flexibel. Een groot aantal van hen lijkt wel lichtelijk autistisch te worden en kan steeds moeilijker tegen onverwachte veranderingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "814dfb71-1898-45f4-9067-f992e7914e4a",
                        "source_entry_id": "6deae50b-8574-3f9b-9a90-e864f11be48d",
                        "source_sense_id": "149e40e1-beaa-3600-ad43-7c7f03113845",
                        "source_sense_description": "lijdend aan autisme",
                        "target_lang_word": "autistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e235c9ce-3b4f-3285-875a-1c19df5350bb",
                                        "entry_id": "06e709cb-23c3-3810-9ac9-d5a1e91cda5a",
                                        "glosses": [
                                            "den Autismus betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6ff241-8eb5-48c9-aae9-be9f6a58aba3",
                                                "sense_id": "e235c9ce-3b4f-3285-875a-1c19df5350bb",
                                                "text": "Sein Verhalten trägt autistische Züge."
                                            },
                                            {
                                                "example_id": "517d9277-d154-488c-be2a-841a693a726c",
                                                "sense_id": "e235c9ce-3b4f-3285-875a-1c19df5350bb",
                                                "text": "„Microsoft-Gründer Bill Gates werden autistische Züge zugeschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7003b8a-3e7b-30cf-b2c0-c9182d90b68e",
                                        "entry_id": "06e709cb-23c3-3810-9ac9-d5a1e91cda5a",
                                        "glosses": [
                                            "Autismus habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6927257-2b0f-46d8-a75d-ca9b33e18af5",
                                                "sense_id": "a7003b8a-3e7b-30cf-b2c0-c9182d90b68e",
                                                "text": "Das autistische Kind spielt alleine."
                                            },
                                            {
                                                "example_id": "822a3467-4ec8-4794-b63c-9360731d491e",
                                                "sense_id": "a7003b8a-3e7b-30cf-b2c0-c9182d90b68e",
                                                "text": "„Laut Bleuler liege vielmehr eine relativ späte Entstehung der autistischen Funktion vor, und es gebe keine biologische Haltbarkeit für die Annahme, daß das autistische Denken das primäre sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "728a087f-5242-402a-b772-5f55442c9b5d",
                        "source_entry_id": "6deae50b-8574-3f9b-9a90-e864f11be48d",
                        "source_sense_id": "149e40e1-beaa-3600-ad43-7c7f03113845",
                        "source_sense_description": "lijdend aan autisme",
                        "target_lang_word": "autistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1debd59b-82a2-3573-8ebf-6b87499d30d5",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Having autism, or pertaining to autism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b344ac0-b08f-4f64-a4b2-eb1cae634213",
                                                "sense_id": "1debd59b-82a2-3573-8ebf-6b87499d30d5",
                                                "text": "Barry is... well, what? Borderline autistic and obsessive-compulsive, with serious anger management issues and a dangerous behavioural disorder that in the real world would get him a one-way ticket to the rubber room."
                                            },
                                            {
                                                "example_id": "d8c8e215-361f-4a78-9306-8cdf9a790c76",
                                                "sense_id": "1debd59b-82a2-3573-8ebf-6b87499d30d5",
                                                "text": "Yet because of the history and proliferation of the supercrip in films in television shows – not only with autism but supercrips with other disabilities as well – viewers are primed for the supercrip autistic and are therefore not expecting (in some ways) a view of autism that comes across to many in the autism community as more realistic or honest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c81da4d-0108-3c19-b3f0-f201328243a9",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Socially inept, self-absorbed, or stupid."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96570c4c-41c6-37cd-89ae-b281edf31ee0",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Characterized by abnormal and unhealthy focus or persistence, and unhealthy hatred of opposition or criticism. Obsessive."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b506d28-409b-491f-8441-8b0f3844e295",
                                                "sense_id": "96570c4c-41c6-37cd-89ae-b281edf31ee0",
                                                "text": "imagine being this autistic over a fictional character"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b99ff04-869b-39d8-b429-609aa7a7c91e",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Lame, uncool, stupid."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "autistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9873ae36-4522-30ba-bd05-8fdd79177281",
                                        "entry_id": "f4e565f3-8adf-3b1d-a29a-3232a0b0849a",
                                        "glosses": [
                                            "A person who has autism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83dfaf13-65da-4fc2-b5a3-75c2c74895b9",
                                                "sense_id": "9873ae36-4522-30ba-bd05-8fdd79177281",
                                                "text": "If our definition of empathy were to require we take the human cognitive norm (overwhelmingly influenced by neurotypical cognition) as the absolute standard by which to measure empathy, then indeed we would have to conclude autistics do not instinctively possess a good sense of empathy."
                                            },
                                            {
                                                "example_id": "b68c7966-17a9-47e0-956b-f9f6f76fc479",
                                                "sense_id": "9873ae36-4522-30ba-bd05-8fdd79177281",
                                                "text": "After reading this book, medical professionals should be able to develop an understanding of some of the challenges that autistics are experiencing during the COVID-19 pandemic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7992b6a9-e875-4dd0-acef-4bf1d47f4132",
                        "source_entry_id": "6deae50b-8574-3f9b-9a90-e864f11be48d",
