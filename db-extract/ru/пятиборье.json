                                "target_senses": [
                                    {
                                        "sense_id": "0547252f-8083-3417-a327-241543164f85",
                                        "entry_id": "aa2e43dc-9d9c-3e3b-805b-f9cbcff1c0ae",
                                        "glosses": [
                                            "An ancient athletics discipline, featuring five events: stadion, wrestling, long jump, javelin and discus"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b58f755a-7c83-3f1c-b83b-91d722ce27ec",
                                        "entry_id": "aa2e43dc-9d9c-3e3b-805b-f9cbcff1c0ae",
                                        "glosses": [
                                            "Ellipsis of women's pentathlon (“a 20th-century athletics discipline for women, the women's counterpart of the men's decathlon, the predecessor to the women's heptathlon, featuring five events: hurdles, shot put, high jump, long jump, and a run”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                        "entry_id": "aa2e43dc-9d9c-3e3b-805b-f9cbcff1c0ae",
                                        "glosses": [
                                            "Ellipsis of modern pentathlon, a discipline with five events based on late-19th century basic military skills."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7491e692-63b2-4335-8477-5d5304c06f2c",
                                                "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                                "text": "In the end, why not be happy with both, with the BMXes and the pentathlons, with the swans of synchro and the Quasimodos of wrestling? Sweet."
                                            },
                                            {
                                                "example_id": "e204fa0c-9692-474c-9f55-09be299120aa",
                                                "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                                "text": "Dwindling interest and a reputation for being outdated couldn’t change modern pentathlon. A brief video clip of a coach punching a horse at the Tokyo Olympics has altered it forever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
