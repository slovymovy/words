                "senses": [
                    {
                        "sense_id": "d239ed9a-2676-3f8a-8bfe-6c27a54a9506",
                        "entry_id": "d3dda32f-6511-30fa-95de-e3ee12ae4d09",
                        "glosses": [
                            "betrekking hebbend op aangeboren gedrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c36d730-277b-4463-a8f5-83028963a935",
                                "sense_id": "d239ed9a-2676-3f8a-8bfe-6c27a54a9506",
                                "text": "Isaacson ten slotte: 'Was Jobs intelligent? Nee, niet buitengewoon. Maar hij was wel geniaal. De sprongen die hij in zijn verbeelding maakte waren instinctmatig, onverwacht en soms magisch.'"
                            },
                            {
                                "example_id": "f01ace00-befa-49f5-b90e-4fbc8ed6021e",
                                "sense_id": "d239ed9a-2676-3f8a-8bfe-6c27a54a9506",
                                "text": "Directeur Adler zei geschokt te zijn. Hij vindt dat de tijger geen blaam treft. „Het dier zag een indringer in zijn territorium en viel instinctmatig aan.”"
                            }
                        ]
                    }
                ],
