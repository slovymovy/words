    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "481878c0-3806-309e-b9e4-2586ef3fd3ae",
                    "sense_definition": "Qui prête à rire ou choque par son extravagance, son absurdité ou son caractère ridicule.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ridicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette proposition de loi est tellement <w>grotesque</w> que personne ne la prend au sérieux."
                        },
                        {
                            "text": "Il portait un chapeau tout à fait <w>grotesque</w> lors de cette cérémonie officielle."
                        }
                    ],
                    "synonyms": [
                        "ridicule",
                        "burlesque",
                        "cocasse",
                        "absurde"
                    ],
                    "antonyms": [
                        "sérieux",
                        "digne",
                        "sobre"
                    ],
                    "common_phrases": [
                        "situation grotesque",
                        "personnage grotesque"
                    ]
                },
                {
                    "sense_id": "640afa5c-59e3-3cdc-9c00-77b9008d84d3",
                    "sense_definition": "Bizarre, extravagant ou invraisemblable au point de déconcerter.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "etrange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une histoire aussi <w>grotesque</w> ne pouvait convaincre les juges réunis pour l'audience."
                        },
                        {
                            "text": "Le peintre créait des créatures <w>grotesques</w> inspirées de ses cauchemars les plus sombres."
                        }
                    ],
                    "synonyms": [
                        "extravagant",
                        "bizarre",
                        "invraisemblable"
                    ],
                    "antonyms": [
                        "ordinaire",
                        "vraisemblable"
                    ],
                    "common_phrases": [
                        "forme grotesque"
                    ]
                },
                {
                    "sense_id": "6904b832-7f58-315e-87f3-8fc94ff5dadd",
                    "sense_definition": "Relatif aux ornements de la Renaissance mêlant feuillages fantastiques et figures humaines ou animales inspirées de l'Antiquité.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le plafond était orné de peintures <w>grotesques</w> typiques de la Renaissance italienne."
                        },
                        {
                            "text": "Les motifs <w>grotesques</w> sculptés sur ce meuble ancien témoignent d'une remarquable maîtrise technique."
                        }
                    ],
                    "common_phrases": [
                        "décor grotesque",
                        "peinture grotesque"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "666579e2-0e11-3e24-9721-b421acb3f31b",
                    "sense_definition": "Caractère de ce qui est ridicule, outré ou saugrenu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ridicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son comportement confinait au <w>grotesque</w> tant il en faisait trop devant ses collègues."
                        },
                        {
                            "text": "La pièce de théâtre bascule du drame vers le <w>grotesque</w> dans sa deuxième partie."
                        }
                    ],
                    "synonyms": [
