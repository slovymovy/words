                                        "examples": [
                                            {
                                                "example_id": "a2caf91b-7df5-46dc-a637-562184368854",
                                                "sense_id": "2c71d5ad-af98-370c-821a-3a6bd72a6a58",
                                                "text": "Après huit des vingt spéciales au programme de l’épreuve asphaltée, le pilote Hyundai devance son équipier estonien Ott Tänak et la Toyota du Britannique Elfyn Evans de respectivement 2 et 13 secondes."
                                            },
                                            {
                                                "example_id": "265d5b11-5254-4167-9935-bcb734dcf3e6",
                                                "sense_id": "2c71d5ad-af98-370c-821a-3a6bd72a6a58",
                                                "text": "Doublé Hyundai au Japon : le Belge Thierry Neuville a terminé en beauté sa saison 2022, devançant l’Estonien Ott Tanäk et le local de l’étape Takamoto Katsuta."
                                            },
                                            {
                                                "example_id": "3fb5982d-0330-4a5e-aee9-4ecb67e073be",
                                                "sense_id": "2c71d5ad-af98-370c-821a-3a6bd72a6a58",
                                                "text": "Son copilote, James Fulton, en est sorti indemne, a annoncé l’écurie Hyundai."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
