{
    "word_family": [
        "up",
        "land"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd4f14bb-57bf-3760-bb20-593d2d6fc3f0",
                    "sense_definition": "The area in the interior of a country with a generally higher elevation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>upland</w> region is known for its rugged terrain and cooler climate.",
                            "target_lang_translations": {
                                "zh": "<w>高地</w>地区以其崎岖的地形和凉爽的气候而闻名。"
                            }
                        },
                        {
                            "text": "Many rare plants grow in the <w>upland</w> areas of the mountain range.",
                            "target_lang_translations": {
                                "zh": "许多稀有植物生长在山脉的<w>高地</w>区域。"
                            }
                        }
                    ],
                    "synonyms": [
                        "highland",
                        "upcountry"
                    ],
                    "antonyms": [
                        "lowland"
                    ],
                    "common_phrases": [
                        "upland region",
                        "upland area"
                    ],
                    "target_lang_definitions": {
                        "zh": "指内陆地区海拔较高的地带。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高地",
                                "target_lang_sense_clarification": "指地势较高的区域。"
                            },
                            {
                                "target_lang_word": "丘陵地带",
                                "target_lang_sense_clarification": "指起伏的较高地势区域。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20d057b7-f4f5-3344-9309-59049116ade4",
                    "sense_definition": "The country, as contrasted with the town.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They moved to the <w>upland</w> to escape the noise of the city.",
                            "target_lang_translations": {
                                "zh": "他们搬到了<w>乡下</w>以躲避城市的喧嚣。"
                            }
                        },
                        {
                            "text": "Life in the <w>upland</w> is much slower than in the busy city.",
                            "target_lang_translations": {
                                "zh": "<w>乡下</w>的生活节奏比繁忙的城市慢得多。"
                            }
                        }
                    ],
                    "antonyms": [
                        "city",
                        "town",
                        "conurbation"
                    ],
                    "target_lang_definitions": {
                        "zh": "指远离城镇的乡村地区。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乡村",
                                "target_lang_sense_clarification": "指与城市相对的农村地区。"
                            },
                            {
                                "target_lang_word": "乡下",
                                "target_lang_sense_clarification": "指远离城市喧嚣的居住地。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ec81e97-b6d5-3544-a44a-ef7a6f830518",
                    "sense_definition": "Of, relating to, or situated in the uplands.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>upland</w> farmers rely on rainfall for their crops.",
                            "target_lang_translations": {
                                "zh": "<w>高地</w>的农民依靠降雨来灌溉农作物。"
                            }
                        },
                        {
                            "text": "We hiked through the <w>upland</w> meadows during our summer vacation.",
                            "target_lang_translations": {
                                "zh": "暑假期间，我们在<w>高地</w>草甸中徒步旅行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "upland forest",
                        "upland meadow"
                    ],
                    "target_lang_definitions": {
                        "zh": "与高地有关的，或位于高地的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高地的",
                                "target_lang_sense_clarification": "形容词，指位于高地的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ce4d554f-c6d9-3fbb-bb76-a2df6817c5a5",
                    "sense_definition": "A city in San Bernardino County, California.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "locations",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to relocate their business to <w>Upland</w> last year.",
                            "target_lang_translations": {
                                "zh": "他们去年决定将业务搬迁到<w>阿普兰</w>。"
                            }
                        },
                        {
                            "text": "The climate in <w>Upland</w> is typical of Southern California.",
                            "target_lang_translations": {
                                "zh": "<w>阿普兰</w>的气候是典型的南加州气候。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美国加利福尼亚州圣贝纳迪诺县的一座城市。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿普兰",
                                "target_lang_sense_clarification": "加州城市名译名。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}