                                "target_lang_sense_clarification": "разговорное, очень много"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "百万",
                                "target_lang_sense_clarification": "表示数量极大"
                            },
                            {
                                "target_lang_word": "无数",
                                "target_lang_sense_clarification": "表示数量极多"
                            }
                        ]
                    }
                }
