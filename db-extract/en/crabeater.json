                    {
                        "sense_id": "bf3e80be-ba7f-3c09-972e-4b79faaa12f1",
                        "entry_id": "684f05f3-6ca1-354b-98f9-d1b6d70ecc58",
                        "glosses": [
                            "An Antarctic seal (Lobodon carcinophagus) that feeds on krill."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b8a4a8-dc17-43fe-83de-71245a16f86c",
                                "sense_id": "bf3e80be-ba7f-3c09-972e-4b79faaa12f1",
                                "text": "Although crabeaters often gather on the ice in large numbers, pupping takes place in small groups."
                            },
                            {
                                "example_id": "e87ff3ce-b03c-4222-866f-accbcb0659f6",
                                "sense_id": "bf3e80be-ba7f-3c09-972e-4b79faaa12f1",
                                "text": "Although few observations have been made of feeding crabeaters, it is assumed that they take bites from a swarm of krill, extracting one or two. Crabeaters sometimes feed collectively, which may increase the efficiency of their hunt."
                            },
                            {
                                "example_id": "ff76b24b-af57-42ec-85e7-fe7e7fa58184",
                                "sense_id": "bf3e80be-ba7f-3c09-972e-4b79faaa12f1",
                                "text": "Also distinguishing them is that crabeaters often have moderate scaring around the head and chest from fights with conspecifics and deep scaring along the body resulting from close encounters with leopard seals."
                            }
                        ]
                    }
