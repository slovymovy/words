                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion_inquietude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La propagation soudaine de la maladie a répandu une vive <w>alarme</w> dans toute la région."
                        },
                        {
                            "text": "Cette annonce imprévue a jeté une grande <w>alarme</w> parmi les employés de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "affolement",
                        "angoisse",
                        "frayeur",
                        "inquiétude"
                    ],
                    "antonyms": [
                        "calme",
                        "sérénité",
                        "tranquillité"
                    ],
                    "common_phrases": [
