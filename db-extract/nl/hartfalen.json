                "senses": [
                    {
                        "sense_id": "2ccf5bbd-4b37-3d08-8c02-e590615ea378",
                        "entry_id": "a4c4f098-60c0-3032-a289-bf5ddb815f25",
                        "glosses": [
                            "een aandoening waarbij het hart niet meer in staat is om voldoende bloed uit te pompen om aan de behoeften van de weefsels te voldoen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c087d08d-711b-45ad-8f94-79669388cc8c",
                                "sense_id": "2ccf5bbd-4b37-3d08-8c02-e590615ea378",
                                "text": "Vooral bij ouderen die al een chronische ziekte hebben, zoals hartfalen, longaandoeningen en suikerziekte, kan een longontsteking grote complicaties geven."
                            },
                            {
                                "example_id": "e31c4c96-9901-4f41-9684-99ad2043fe9b",
                                "sense_id": "2ccf5bbd-4b37-3d08-8c02-e590615ea378",
                                "text": "Elk glaasje wijn verhoogt de kans op beroerte, hartfalen en hoge bloeddruk. Een 40-jarige man wordt gemiddeld anderhalf jaar ouder als hij niet drinkt, berekenden de onderzoekers, dan wanneer hij een glaasje per dag nuttigt. Voor vrouwen ligt dat getal op 1,3 jaar."
                            },
                            {
                                "example_id": "489f8e59-0d0d-4059-bbd2-df16c4b916be",
                                "sense_id": "2ccf5bbd-4b37-3d08-8c02-e590615ea378",
                                "text": "Het kunsthart werd vorig jaar november door artsen van het UMC Utrecht geplaatst bij een 54-jarige man met zeer ernstig hartfalen. Onduidelijk was toen wat de langetermijneffecten van het kunsthart zouden zijn."
                            }
                        ]
                    }
