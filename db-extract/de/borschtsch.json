                                                "sense_id": "de4fabb8-9434-3f17-8e7e-f9471d61d33f",
                                                "text": "Najbardziej lubię barszcz cioci Danuty."
                                            },
                                            {
                                                "example_id": "45f070fe-92e5-4f4a-9945-96688cb41f62",
                                                "sense_id": "de4fabb8-9434-3f17-8e7e-f9471d61d33f",
