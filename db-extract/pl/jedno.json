                        "entry_id": "00e18187-c0d6-3e0b-9e93-55e14e48c186",
                        "glosses": [
                            "one thing (only this)"
                        ],
                        "tags": [
                            "neuter",
                            "noun-from-verb"
                        ],
                        "examples": [
                            {
                                "example_id": "a4d86582-3661-4ed1-968e-028cc6f2b575",
                                "sense_id": "9191ad63-3867-37e7-a3c3-d9bba8723e7b",
                                "text": "jedno za drugim",
                                "translation": "one after the other",
                                "english": "one after the other"
                            },
                            {
                                "example_id": "652c746f-f1ca-45bd-bbc3-588b5ffab355",
                                "sense_id": "9191ad63-3867-37e7-a3c3-d9bba8723e7b",
                                "text": "To może oznaczać tylko jedno.",
                                "translation": "This can mean only one thing.",
                                "english": "This can mean only one thing."
                            },
                            {
                                "example_id": "acb70619-58db-43f2-ad17-1f51f3a2b057",
                                "sense_id": "9191ad63-3867-37e7-a3c3-d9bba8723e7b",
                                "text": "Co jedno to gorsze.",
                                "translation": "Each one is worse than the last.",
                                "english": "Each one is worse than the last."
                            },
                            {
                                "example_id": "17537fdd-ebba-4fa7-aa0b-d633368b233d",
                                "sense_id": "9191ad63-3867-37e7-a3c3-d9bba8723e7b",
                                "text": "Jedno to mówić, drugie to działać",
                                "translation": "It's one thing to speak, it's another to act.",
                                "english": "It's one thing to speak, it's another to act."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d383c09-12ae-335a-94cb-07679afea9ac",
                        "entry_id": "00e18187-c0d6-3e0b-9e93-55e14e48c186",
                        "glosses": [
                            "one thing (entirety; something that is perceived as a whole even though it is made up of more than one element)"
                        ],
