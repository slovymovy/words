                "translations": [
                    {
                        "translation_id": "3ee0e703-b49a-4b72-af87-c8142d3b15b3",
                        "source_entry_id": "e3946281-7d0e-323f-904c-1cde2fc953f7",
                        "target_lang_word": "géomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b243d958-16bb-3b00-8e09-7a5b34754707",
                                        "entry_id": "a2ef9829-f837-3db8-9a5e-bd5903a52d2a",
                                        "glosses": [
                                            "Expert en géométrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423740c2-a66b-43a8-a4b4-0d4f57a5ff6d",
                                                "sense_id": "b243d958-16bb-3b00-8e09-7a5b34754707",
                                                "text": "Pour la représenter, il fit mouvoir la lune, sur un épicicle porté par un excentrique, suivant la méthode attribuée au géomètre appollonius, et dont hipparque avoit fait usage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb53c36a-9765-3135-a0ef-5646304f58c4",
                                        "entry_id": "a2ef9829-f837-3db8-9a5e-bd5903a52d2a",
                                        "glosses": [
                                            "Dieu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc0d94df-60dd-47b4-b6d1-0996dd78aea4",
                                                "sense_id": "cb53c36a-9765-3135-a0ef-5646304f58c4",
                                                "text": "C’est avec ce ressort que Dieu, appelé par Platon l’éternel géomètre, et que j’appelle ici l’éternel machiniste, a animé et embelli la nature: les passions sont les roues qui font aller toutes ces machines."
                                            },
                                            {
                                                "example_id": "86f3ee3f-3319-4e8c-b245-17110db9ca77",
                                                "sense_id": "cb53c36a-9765-3135-a0ef-5646304f58c4",
                                                "text": "Dieu est le Grand Géomètre, il est le Grand Architecte, le Grand Mathématicien, le Grand Artiste ; il est surtout le Grand Poète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc239a66-ac42-32b7-963f-26fdd2356f08",
                                        "entry_id": "a2ef9829-f837-3db8-9a5e-bd5903a52d2a",
                                        "glosses": [
                                            "Il s’applique à ceux qui cultivent les sciences mathématiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cd53d0-fa51-4479-a9aa-13fb9834c447",
                                                "sense_id": "dc239a66-ac42-32b7-963f-26fdd2356f08",
                                                "text": "Lagrange et Laplace ont été deux grands géomètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "765aeec7-c7b9-372a-985d-328c5c8f15fe",
                                        "entry_id": "a2ef9829-f837-3db8-9a5e-bd5903a52d2a",
                                        "glosses": [
                                            "Arpenteur qui s’occupe du levé des plans et du nivellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1557b66b-d6aa-43b4-bc2a-a84a4b609cf5",
                                                "sense_id": "765aeec7-c7b9-372a-985d-328c5c8f15fe",
                                                "text": "Un reporter qui ne précise pas, c’est un géomètre qui néglige de pousser ses calculs jusqu’à la dixième décimale."
                                            },
                                            {
                                                "example_id": "4f3e15f6-941d-48c8-b92a-759d4d0115ec",
                                                "sense_id": "765aeec7-c7b9-372a-985d-328c5c8f15fe",
                                                "text": "[…] ; ce terme est très fréquent dans toute la microtoponymie du Mâconnais ; il est même tellement vivant que les géomètres des cadastres l'ont considéré comme une forme correcte; […]."
                                            },
                                            {
                                                "example_id": "5078b65f-5112-4652-b9ee-cd24ae45538d",
                                                "sense_id": "765aeec7-c7b9-372a-985d-328c5c8f15fe",
                                                "text": "Ils mesuraient et cadastraient pour l'État les terres non limitées régulièrement; pour le propriétaire ils étaient géomètres, conservaient ou retrouvaient les limites du fundus assigné. Ils marquaient ces limites sur les terres indivises , […]."
                                            },
                                            {
                                                "example_id": "7812e980-f598-4bd4-944a-c9c89021a2f3",
                                                "sense_id": "765aeec7-c7b9-372a-985d-328c5c8f15fe",
                                                "text": "Par apposition, Arpenteur géomètre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e59d7133-f186-4b88-a2ca-9678194744e1",
                        "source_entry_id": "e3946281-7d0e-323f-904c-1cde2fc953f7",
                        "target_lang_word": "arpenteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arpenteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93a93cd1-a366-3cb7-8fb2-4a1751696273",
                                        "entry_id": "3828bd0a-0080-3d49-890d-17770e0c7282",
                                        "glosses": [
                                            "Qui arpente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93fd450-0ec5-499c-812d-09ca525197a1",
                                                "sense_id": "93a93cd1-a366-3cb7-8fb2-4a1751696273",
                                                "text": "Une chenille arpenteuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arpenteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                                        "entry_id": "62a22f5a-8db8-3751-bb7e-a8b27460dfd0",
                                        "glosses": [
                                            "Celui qui arpente, qui mesure les terres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06221c53-46f9-4ab2-a8c6-bc810d28b844",
                                                "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                                                "text": "Des arpenteurs avec de longues chaînes allaient mesurant le terrain ; des arbitres établissaient les premières propriétés."
                                            },
                                            {
                                                "example_id": "1bedf719-6923-418e-bbb2-7b65080727bd",
                                                "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                                                "text": "M. Gauthier, loin de voler, vivait tout juste de son métier d’arpenteur attaché au cadastre."
                                            },
                                            {
                                                "example_id": "c87ea4b9-0f70-4f07-bc14-d1a09639b8a0",
                                                "sense_id": "1bbd293b-d8bc-35d9-a28b-8a97cddd8414",
                                                "text": "Les mesures agraires de Quarré, avant la Révolution (elles persistent aujourd'hui), n'avaient pas de base fixe. Un journal de champ, une « soiture » de pré oscillaient entre vingt-deux et trente-cinq ares de nos mesures métriques. L’arpenteur a besoin de passer par là avant les transactions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
