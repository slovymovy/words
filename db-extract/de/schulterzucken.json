                "senses": [
                    {
                        "sense_id": "2eac6813-3164-30fc-85d7-5e6a6a87a0d6",
                        "entry_id": "5bf0f0bb-4361-3ff4-b938-fc1a14464722",
                        "glosses": [
                            "kurzes Anheben einer oder beider Schultern (oft als Geste der Gleichgültigkeit oder Unwissenheit über etwas)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107cb1f5-a13e-4786-8814-917cd0a93531",
                                "sense_id": "2eac6813-3164-30fc-85d7-5e6a6a87a0d6",
                                "text": "„Mit einem Schulterzucken schüttelte er das unbehagliche Gefühl ab und ging um das Hotel herum und über die Rampe in die Garage hinunter.“"
                            },
                            {
                                "example_id": "8a2b1a08-2467-4d97-a664-926b2b987a0b",
                                "sense_id": "2eac6813-3164-30fc-85d7-5e6a6a87a0d6",
                                "text": "„Aber Ambly war tot, und der Arzt, der mitgekommen war, stellte es fest und bestätigte es mit einem bedauernden Schulterzucken.“"
                            },
                            {
                                "example_id": "b480b05b-cdb9-4f2a-93b6-21e0d4ee0593",
                                "sense_id": "2eac6813-3164-30fc-85d7-5e6a6a87a0d6",
                                "text": "„Nachdem er auf seine Fragen nach ihrer Zukunft nur ein vages Schulterzucken zur Antwort erhalten hatte, bot er ihr beim Tanz einfach an, sie am nächsten Tag zu der Schauspielschule mitzunehmen, die er sei kurzem besuchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a72cea2-e7b7-46b8-81e2-4819081f50a3",
                        "source_entry_id": "5bf0f0bb-4361-3ff4-b938-fc1a14464722",
                        "source_sense_id": "2eac6813-3164-30fc-85d7-5e6a6a87a0d6",
                        "source_sense_description": "kurzes Anheben einer oder beider Schultern",
                        "target_lang_word": "shrug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d71dadb-c050-3965-a3ed-49a3dc536ee4",
                                        "entry_id": "b2b7b3ed-d0e7-32db-88ab-e5683a28dae9",
                                        "glosses": [
                                            "A lifting of the shoulders to signal indifference or a casual lack of knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67d267b-17aa-498c-842b-ad17d8cee3d6",
                                                "sense_id": "1d71dadb-c050-3965-a3ed-49a3dc536ee4",
                                                "text": "He dismissed my comment with a shrug."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35444622-19df-3e52-8b51-00429e129e44",
                                        "entry_id": "b2b7b3ed-d0e7-32db-88ab-e5683a28dae9",
                                        "glosses": [
                                            "A cropped, cardigan-like garment with short or long sleeves, typically knitted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shrug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                        "entry_id": "bd5e31b5-6b5d-348e-bea2-6dcd30fd6896",
                                        "glosses": [
                                            "To raise (the shoulders) to express uncertainty, lack of concern, (formerly) dread, etc."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca91abe-7538-4bf0-9ff1-765ef6b6c42b",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "I asked him for an answer and he just shrugged."
                                            },
                                            {
                                                "example_id": "6b70f9f0-90c9-4e87-a869-79ee967d8714",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "When he saw the problem, he just shrugged and started fixing it."
                                            },
                                            {
                                                "example_id": "d4f052aa-7fcd-4b92-8411-b492e9e5f23e",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "He[…] shrugs his shoulders when you talk of securities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
