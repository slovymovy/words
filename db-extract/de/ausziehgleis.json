                "senses": [
                    {
                        "sense_id": "d8679d62-f162-31b8-8528-b7f3f47bbcea",
                        "entry_id": "bd97b5ad-1bfc-34f8-a5c4-6cfd92124120",
                        "glosses": [
                            "meist parallel zu einem Streckengleis in Bahnhöfen verlegtes Stumpfgleis zum Rangieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05ea8d8d-efa4-4345-bd44-8306e7e168c9",
                                "sense_id": "d8679d62-f162-31b8-8528-b7f3f47bbcea",
                                "text": "„Sie montierten in aller Eile ein Ausziehgleis, koppelten die Lok ab und setzten sie um.“"
                            },
                            {
                                "example_id": "a66b01e6-f7c0-4a29-b322-18b7065549d5",
                                "sense_id": "d8679d62-f162-31b8-8528-b7f3f47bbcea",
                                "text": "„Auf Bahnhöfen zweigleisiger Strecken ist, wenn kein Ausziehgleis benutzt werden kann, möglichst auf dem Ausfahrgleis auszuziehen.“"
                            },
                            {
                                "example_id": "290092ee-3903-4e19-9aff-b7e42b66332b",
                                "sense_id": "d8679d62-f162-31b8-8528-b7f3f47bbcea",
                                "text": "„Ein Ausziehgleis liegt bis zur Kohlfurther Brücke, dort endet heute die Strecke.“"
                            },
                            {
                                "example_id": "85f3095e-d3a6-4758-9be3-73f8daf05a0a",
                                "sense_id": "d8679d62-f162-31b8-8528-b7f3f47bbcea",
                                "text": "„Auf der Brücke lagen die beiden Hauptgleise der Strecke Köln–Aachen, ein Überholungsgleis und ein Ausziehgleis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
