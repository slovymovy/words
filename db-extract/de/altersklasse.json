                ],
                "senses": [
                    {
                        "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                        "entry_id": "08375553-9511-3acb-a9f5-0eed022cad78",
                        "glosses": [
                            "Gruppe von Personen (oder auch anderen Lebewesen) gleichen Alters/gleicher Altersspanne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6c9034-95f2-4947-bab7-0d4e644eda33",
                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                "text": "„Da es mit 560 Athleten auch die vollste Altersklasse war, kam Hoffnung auf, dass ich mit etwas Glück einen Slotfür dieIronman-70.“"
                            },
                            {
                                "example_id": "713907b5-4001-4797-84d4-348f254bfce0",
                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                "text": "„Diese Größe drückt jene Wahrscheinlichkeit aus, die Individuen der jeweiligen Altersklasse haben, innerhalb dieser Zeitspanne zu sterben.“"
                            },
                            {
                                "example_id": "8467c43d-7722-4240-8913-ba763a753013",
                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                "text": "„Die Unterschiede machen sich besonders bei den mittleren und höheren Altersklassen bemerkbar.“"
                            },
                            {
                                "example_id": "d5e0590c-ff63-464b-815b-57d92591bd60",
                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                "text": "„Wie aus der Tabelle 8 zu entnehmen ist, erreichen in der Altersklasse von 16–30 Jahren die Ak-Mengen bei den HL-Ak den höchsten Wert überhaupt.“"
                            },
                            {
                                "example_id": "13997817-6db0-4b91-8c1e-df1b8589855a",
                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                "text": "„Zum anderen sollte ermittelt werden, aus welcher Altersklasse diese Kundinnen mehrheitlich stammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
