                ],
                "senses": [
                    {
                        "sense_id": "11106e23-2c5b-3cfa-b254-d4ff0d88774c",
                        "entry_id": "7c00ace5-3874-36af-ba16-de293d80d1af",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным запой; свойственный, характерный для запоя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3505112-9781-4a36-bca9-1d98087b7d95",
                                "sense_id": "11106e23-2c5b-3cfa-b254-d4ff0d88774c",
                                "text": "Но с другого человека со всякого я готов и могу запойную страсть в одну минуту свести."
                            },
                            {
                                "example_id": "5f480a7f-44cd-4a8a-8f70-12390ea6bb94",
                                "sense_id": "11106e23-2c5b-3cfa-b254-d4ff0d88774c",
                                "text": "Он приходил теперь в редакцию с красными глазами, опухшим лицом и запойным туманом в голове."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c2d425a-eeb9-36f4-ab7d-ae7587027478",
                        "entry_id": "7c00ace5-3874-36af-ba16-de293d80d1af",
                        "glosses": [
                            "разг. пьющий запоем, подверженный запою (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34c947a-a7b5-48ce-98a9-af4e2ea9145e",
                                "sense_id": "6c2d425a-eeb9-36f4-ab7d-ae7587027478",
                                "text": "― Слабость имеет большую: пьяница, говорят, и пьяница-то запойная."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0455729-6087-3617-95db-192da916a814",
                        "entry_id": "7c00ace5-3874-36af-ba16-de293d80d1af",
                        "glosses": [
                            "перен., разг. совершаемый, происходящий запоем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa7c1a5-50dc-4bf3-924d-9f0699e55f8c",
                                "sense_id": "f0455729-6087-3617-95db-192da916a814",
                                "text": "Я жил, хмелея и валясь с ног от запойной работы ― по десять-двенадцать лекционных часов в день."
                            }
                        ]
                    }
                ],
