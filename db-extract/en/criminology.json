                                        "entry_id": "68ffb1e4-786e-3c3e-af47-6d59e81465ea",
                                        "glosses": [
                                            "Science de l’étude du comportement criminel et son impact sur les lois et le comportement humain ; également considérée comme la science des causes du crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e3afba-330f-49e0-8fc3-610f9b7e5511",
                                                "sense_id": "2805bbe1-5edf-3672-8ded-4bc9c546540d",
                                                "text": "Une lecture cohérente, documentée, réflexive de près de deux siècles d’apports scientifiques en matière de criminologie offerte par des historiens, psychologues, sociologues et psychiatres."
                                            }
                                        ]
                                    }
