                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63ff74a5-1761-3d74-b88e-f36f15f95a5e",
                                        "entry_id": "e4f74b62-639c-3614-b1cd-99bcdc1ff2a7",
