                    {
                        "translation_id": "e4b11194-da2e-4f91-89f9-86707f5f0560",
                        "source_entry_id": "c7568b71-57d5-3c23-93c5-640595c4f93b",
                        "source_sense_description": "to cause to appear foolish",
                        "target_lang_word": "veralbern",
