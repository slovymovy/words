                                                "example_id": "ad9c943f-f888-47c5-ac73-4d793721f69a",
                                                "sense_id": "31ccea3c-e70e-359d-8a9a-d72be49b81ae",
                                                "text": "He wet his thumb with saliva pressing on the tongue, ran it up and down faster over the letter 'I' of 'TOILET', the 'LADIES TOILET' was transformed into 'LADIES TO LET' in no time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c611db1-817d-312e-8420-f4dd9a7bc526",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "A room, enclosed area or single-purpose building containing a fixture or fixtures used for urination and defecation; a bathroom or water closet.",
                                            "A small secondary lavatory having a fixture used for urination and defecation and sink but no bathtub or shower."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Hong-Kong",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae27badc-448f-3fd5-8b38-74842e8ba877",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "A fixture used for urination and defecation, particularly one with a large bowl and ring-shaped seat which uses water to flush the waste material into a septic tank or sewer system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366d92ef-7298-45f4-a4fa-8a88804c12c7",
                                                "sense_id": "ae27badc-448f-3fd5-8b38-74842e8ba877",
                                                "text": "My toilet got clogged. Now the bathroom's flooded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34b8816-dc20-35cb-8c06-176a13c07724",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "A very shabby or dirty place."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8552ce42-30fd-4e39-a99a-bbaab3918856",
                                                "sense_id": "f34b8816-dc20-35cb-8c06-176a13c07724",
                                                "text": "Mr. Gaunt was urbane and smiling again, not a hair out of place. \"Do you like this little town? Do you love it? […]\" / […] \"I hate this fucking toilet,\" he said to Leland Gaunt."
                                            },
                                            {
                                                "example_id": "45b47762-e47e-4501-9579-6618620b9b42",
                                                "sense_id": "f34b8816-dc20-35cb-8c06-176a13c07724",
                                                "text": "Look around you. It's a toilet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51553f78-c06c-3b1c-a679-06dcedb75056",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "A covering of linen, silk, or tapestry, spread over a dressing table in a chamber or dressing room."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a89c592-3c65-3b74-934f-58f03d1e351c",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "The table covered by such a cloth; a dressing table."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3afe48-562e-410a-bb3e-3ec18a7e6752",
                                                "sense_id": "9a89c592-3c65-3b74-934f-58f03d1e351c",
                                                "text": "And now, unveil’d, the toilet stands display’d, / Each silver vase in mystic order laid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154313eb-d444-34cf-824e-9cde7cf78f21",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "Personal grooming; the process of washing, dressing and arranging the hair."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde01c29-d1f5-4658-922e-66ad5917670e",
                                                "sense_id": "154313eb-d444-34cf-824e-9cde7cf78f21",
                                                "text": "Against that short evening her toilet was consulted the whole day […]."
                                            },
                                            {
                                                "example_id": "350fffb7-0427-496e-9c6b-e6d8d6307a9e",
                                                "sense_id": "154313eb-d444-34cf-824e-9cde7cf78f21",
                                                "text": "Come as you are, tarry not over your toilet."
                                            },
                                            {
                                                "example_id": "104ab1fb-af16-48d0-a9f3-9f81f302a2d8",
                                                "sense_id": "154313eb-d444-34cf-824e-9cde7cf78f21",
                                                "text": "Three women got down and standing on the curb they made unabashed toilets, smoothing skirts and stockings, brushing one another's back, opening parcels and donning various finery."
                                            },
                                            {
                                                "example_id": "e303d8cc-53b8-4556-a3e5-fd773b693bfb",
                                                "sense_id": "154313eb-d444-34cf-824e-9cde7cf78f21",
                                                "text": "Here, at night, a lonely but brilliantly neon-illuminated figure, I performed my toilet, watched incuriously by the Burmese seated at the tables of the tea-shops below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6d88f0a-5499-3801-b21d-1b5e37c1c89b",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "One's style of dressing: dress, outfit."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a5e0b13-25bf-4dd0-ab6e-b5adccdcb2c0",
                                                "sense_id": "c6d88f0a-5499-3801-b21d-1b5e37c1c89b",
                                                "text": "It is so painful in you, Celia, that you will look at human beings as if they were merely animals with a toilette, and never see the great soul in a man's face."
                                            },
                                            {
                                                "example_id": "cb0d68ac-d2e4-4512-82df-b78a35b77bda",
                                                "sense_id": "c6d88f0a-5499-3801-b21d-1b5e37c1c89b",
                                                "text": "\"It is a quarter-past two,\" he said. \"Your telegram was dispatched about one. But no one can glance at your toilet and attire without seeing that your disturbance dates from the moment of your waking.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6e0a640-9b36-38fa-9e10-8e9fc30b7745",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "A dressing room."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2365242b-62d1-3540-8f55-f99249fe7d60",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "A chamber pot."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cca01e4-bd2c-3146-acdc-e2051accf723",
                                        "entry_id": "e41e0beb-a1fc-369b-8d7d-d3591f5faadd",
                                        "glosses": [
                                            "A woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3fe97a3-0685-4634-b634-abb997059b2c",
                                                "sense_id": "9cca01e4-bd2c-3146-acdc-e2051accf723",
                                                "text": "I’m not interested in toilets and I don’t think a gf [Girlfriend] is needed to live a fulfilling life."
                                            },
                                            {
                                                "example_id": "a904b136-18b5-4c9a-8242-c79b05d2b796",
                                                "sense_id": "9cca01e4-bd2c-3146-acdc-e2051accf723",
                                                "text": "A user, @blacklister, concludes that “toilets are as vacuous as their value besides pleasing men”, with a remark on how women should be handed out by the state to every man to minimise inceldom."
                                            },
                                            {
                                                "example_id": "649cb0cc-cf5d-4c77-a186-baca7d129ffa",
                                                "sense_id": "9cca01e4-bd2c-3146-acdc-e2051accf723",
                                                "text": "I can’t bare listening to a toilet talk. I don’t wanna listen to toilet songs,or watch them in movies. They have nothing to offer other than sexuality"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
