        "fr-extract.jsonl": [
            {
                "entry_id": "4a9a958f-1207-3302-8512-0e0c8c5f1ae1",
                "word": "blanc-seing",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "13935bc6-7330-4092-8444-d4648f80f838",
                        "entry_id": "4a9a958f-1207-3302-8512-0e0c8c5f1ae1",
                        "tags": [
                            "plural"
                        ],
                        "form": "blancs-seings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b456295-d7b5-3237-adc9-87dcc54aa02a",
                        "entry_id": "4a9a958f-1207-3302-8512-0e0c8c5f1ae1",
                        "glosses": [
                            "Mandat, feuille en blanc au bas de laquelle est apposée une signature, et que l’on confie à quelqu’un pour qu’il le remplisse à sa volonté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fffe5f7e-4f43-41bc-b3e3-5034777c5561",
                                "sense_id": "6b456295-d7b5-3237-adc9-87dcc54aa02a",
                                "text": "— Tenez, monsieur, dit le cardinal au jeune homme, je vous ai pris un blanc-seing et je vous en rends un autre. Le nom manque sur ce brevet : vous l’écrirez vous-même."
                            },
                            {
                                "example_id": "ba972b69-8653-4803-bbba-c8ff07ddf352",
                                "sense_id": "6b456295-d7b5-3237-adc9-87dcc54aa02a",
                                "text": "Ce paquet contenait six blancs-seings et un double de l’ordre formel donné par le roi à tous les officiers de l’armée, quels que fussent leur grade et leur ancienneté, d’obéir à M. de Choiseul."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fc917b3-db20-3e4c-8764-196095a4be41",
                        "entry_id": "4a9a958f-1207-3302-8512-0e0c8c5f1ae1",
                        "glosses": [
                            "Faculté laissée ou donnée à quelqu’un d'agir, de décider à sa guise."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "afc96588-6176-44e6-820c-5a6693649e27",
                                "sense_id": "6fc917b3-db20-3e4c-8764-196095a4be41",
                                "text": "La différence entre une menace et une autorisation est que la première vous permet de rassembler le vocabulaire du public dans votre propre chasse gardée. Il est temps d’arrêter de donner aux tyrans des marques déposées un blanc-seing sur le sens de nos propres mots. Il est temps de reprendre possession des marques déposées."
                            },
                            {
                                "example_id": "303a49b6-9de8-47b7-a321-aee1a18879da",
                                "sense_id": "6fc917b3-db20-3e4c-8764-196095a4be41",
                                "text": "Refusant de donner « un blanc-seing » au gouvernement, les sénateurs ont ramené l’échéance du passeport sanitaire du 31 juillet au 28 février, date de suspension prévue des travaux parlementaires avant les élections présidentielle et législatives du printemps 2022."
                            },
                            {
                                "example_id": "6d97a64c-8fbb-473e-888b-f834288eac57",
                                "sense_id": "6fc917b3-db20-3e4c-8764-196095a4be41",
                                "text": "Ils ont donné leurs blancs-seings à leurs élus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8d1c82b-7384-44e9-84c8-d4e65920f1fd",
                        "source_entry_id": "4a9a958f-1207-3302-8512-0e0c8c5f1ae1",
                        "target_lang_word": "Blankovollmacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blankovollmacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50188b48-f8b8-3f63-b0fb-5855f796fd5e",
                                        "entry_id": "b91693a7-cac9-3839-8c71-576ec14e9c47",
                                        "glosses": [
                                            "Vollmacht, die keinen Einschränkungen unterliegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30be0e4-8c32-4625-8ddd-16b70901ed97",
                                                "sense_id": "50188b48-f8b8-3f63-b0fb-5855f796fd5e",
                                                "text": "„Sollte es jemals zu einem Prozess kommen, könnten sich die Angeklagten auf ein Memo des Justizministeriums berufen, in dem gleichsam eine Art Blankovollmacht für Folterungen erteilt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ce6f989-28b2-4483-8cc1-36f72e3cb88d",
                        "source_entry_id": "4a9a958f-1207-3302-8512-0e0c8c5f1ae1",
                        "target_lang_word": "Freibrief",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freibrief",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05738640-6215-37fc-ae9f-bfd19f6bd6e9",
                                        "entry_id": "8215715d-a96c-35b1-9c8d-348ee70da45f",
                                        "glosses": [
                                            "Urkunde über eine Erlaubnis; über eine Befreiung von einem Verbot; oder über die Entlassung aus der Leibeigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f40133f-86f9-4caa-99f1-cf88af2ab68c",
                                                "sense_id": "05738640-6215-37fc-ae9f-bfd19f6bd6e9",
                                                "text": "Trotz Hunger im Land erteilte der König dem Handelsmann einen Freibrief zur Ausfuhr von Lebensmitteln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30474beb-d501-375e-8dc0-42024596d3e9",
                                        "entry_id": "8215715d-a96c-35b1-9c8d-348ee70da45f",
                                        "glosses": [
                                            "die Erlaubnis für etwas üblicherweise Unerlaubtes"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee09424a-1b14-4ca0-a575-c113b1591fa0",
                                                "sense_id": "30474beb-d501-375e-8dc0-42024596d3e9",
                                                "text": "„Die Nichtöffentlichkeit von Gerichtsverfahren ist \"für viele Richter und Anwälte ein Freibrief, schalten und walten zu können, wie es ihnen passt\".“"
                                            },
                                            {
                                                "example_id": "656d3609-940e-4f3d-b7c5-c4d40f854d72",
                                                "sense_id": "30474beb-d501-375e-8dc0-42024596d3e9",
                                                "text": "„Deutsche Offiziere schärften ihren Untergebenen ein, es müssten »Boxernester ausgeräuchert« werden – ein Freibrief für Terror gegen die Bevölkerung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0030690d-e52d-4565-b79f-ef71b6cd98c1",
                        "source_entry_id": "4a9a958f-1207-3302-8512-0e0c8c5f1ae1",
