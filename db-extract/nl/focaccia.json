                "senses": [
                    {
                        "sense_id": "af98f109-14ac-33b2-ae4f-1e31472b6598",
                        "entry_id": "630854fb-d845-34c5-9641-5d088fcaca9b",
                        "glosses": [
                            "plat Italiaans brood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6e68fbc-0d9a-47f1-9d20-f0cde5b8b0f2",
                                "sense_id": "af98f109-14ac-33b2-ae4f-1e31472b6598",
                                "text": "Zeker in Genua en de rest van Ligurië is het not done, omdat er meestal focaccia wordt gegeven waarin al olijfolie zit. En de uitbater beschouwt het als een grote ergernis en een kostenpost dat zijn dure extra vergine met liters tegelijk uit borden wordt gesopt."
                            },
                            {
                                "example_id": "bfa30305-8e2c-48a7-bdc1-40805519db25",
                                "sense_id": "af98f109-14ac-33b2-ae4f-1e31472b6598",
                                "text": "Een borrelplank met daarop zelf gemaakte pesto en een focaccia kan echt genieten zijn. Chef-kok Danny legt je uit hoe je lekkere en niet te bittere pesto maakt."
                            },
                            {
                                "example_id": "ebad759f-0fb7-4977-8327-4faec8aa17a5",
                                "sense_id": "af98f109-14ac-33b2-ae4f-1e31472b6598",
                                "text": "Mediterrane broodsoorten, zoals stokbrood, focaccia en ciabatta, lenen zich hier uitstekend voor."
                            }
                        ]
                    }
                ],
