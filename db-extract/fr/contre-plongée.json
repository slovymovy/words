                        "examples": [
                            {
                                "example_id": "e510529d-c528-45fd-b19a-64ec28cdb4a1",
                                "sense_id": "f331a85a-639e-3fd6-bfa1-a3f0445f73da",
                                "text": "On voyait surtout en contre-plongée tout un ballet de jambes si bronzées, les chaussures et les socquettes nimbées d’une poussière abricot."
                            },
                            {
                                "example_id": "37ebfee6-da30-4e58-b6e8-e022e20fee13",
                                "sense_id": "f331a85a-639e-3fd6-bfa1-a3f0445f73da",
                                "text": "Tandis que Lambert, qui avait garé sa Simca un peu plus loin, achevait de discuter avec un homme en bleu de chauffe, Hélène braqua son appareil vers la hauteur, choisissant spontanément l'angle le plus écrasant, la contre-plongée maximale."
                            }
                        ]
                    }
