                    },
                    {
                        "translation_id": "0e6befd5-532f-4c70-ab13-79c0d9e6bb9b",
                        "source_entry_id": "9f7dd59e-751c-320e-a071-f37660320b88",
                        "source_sense_id": "6c948440-c457-3e23-a922-527193ed8c78",
                        "target_lang_word": "Ulan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ulan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2031b887-3051-33f2-854d-14bc8cf7af42",
                                        "entry_id": "a3a7eb6c-735a-3e00-9db3-5fa9a4052db0",
                                        "glosses": [
                                            "früher „mit einer Lanze bewaffneter Reiter“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da088b9-a1da-4eb2-b36d-8fbe61dafb48",
                                                "sense_id": "2031b887-3051-33f2-854d-14bc8cf7af42",
                                                "text": "„Sportsboote fuhren vorbei, und dann liefen Torpedoboote und ein großer, mit abgekämpften Ulanen und Dragonern überfüllter Transportdampfer ein.“"
                                            },
                                            {
                                                "example_id": "08cf452f-75e8-4fd2-91cf-2c56e3b11262",
                                                "sense_id": "2031b887-3051-33f2-854d-14bc8cf7af42",
                                                "text": "„Als er der Kolonne immer näher kam, ritten ein paar Ulanen auf ihn zu, mit Lanzen und Fähnchen, auf denen die Nummer des Regiments in grellen Farben stand, sie winkten ihm, daß er sich entfernen solle.“"
                                            },
                                            {
                                                "example_id": "322342a1-9fbb-4066-bffb-80927518627f",
                                                "sense_id": "2031b887-3051-33f2-854d-14bc8cf7af42",
                                                "text": "„Am Ufer rastete ein Trupp polnischer Ulanen.“"
                                            },
                                            {
                                                "example_id": "3805a1d9-2533-41e9-b3b2-2c7948791380",
                                                "sense_id": "2031b887-3051-33f2-854d-14bc8cf7af42",
                                                "text": "„Die Ulanen klammerten sich aneinander, und viele von ihnen rutschten von den Sätteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebc93bb4-bd59-478a-bb02-e0569b0eb05e",
                        "source_entry_id": "9f7dd59e-751c-320e-a071-f37660320b88",
                        "source_sense_id": "6c948440-c457-3e23-a922-527193ed8c78",
                        "target_lang_word": "ułan",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ułan",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "51d73626-7b1d-3806-a6d0-c0016682b94a",
                                        "entry_id": "d93da139-f2f5-3d94-a3bc-a1de8b133da7",
                                        "glosses": [
                                            "żołnierz lekkiej kawalerii utworzonej w Polsce w XVIII w.; ; zob. też ułan w Encyklopedii staropolskiej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8235233-764a-478a-9e4e-8c62b0c77abf",
                                                "sense_id": "51d73626-7b1d-3806-a6d0-c0016682b94a",
                                                "text": "Przybyli ułani pod okienko, • Pukają, wołają: – Puść, panienko!"
                                            },
                                            {
                                                "example_id": "ebbb2195-a85f-447f-aa9a-d45ccf43597e",
                                                "sense_id": "51d73626-7b1d-3806-a6d0-c0016682b94a",
                                                "text": "Serce struchlałego dziecka łomoce pod mundurem ułana i niewymowna trwoga żelaznymi obcęgi ściska piersi, gdy wchodzą tłumem szumnym w progi kościoła."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59028fdc-1630-4f84-b173-eb8433131de6",
                        "source_entry_id": "9f7dd59e-751c-320e-a071-f37660320b88",
                        "source_sense_id": "6c948440-c457-3e23-a922-527193ed8c78",
                        "target_lang_word": "uhlan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uhlan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c75ce0d3-0ca1-376c-9d42-8ee0a9d56d7a",
                                        "entry_id": "8ad8b563-8a3f-3a4b-838f-01f9966f0a87",
                                        "glosses": [
                                            "Qui est propre aux uhlans."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f496d18b-af69-4f33-8711-d06dbf1f75bc",
                                                "sense_id": "c75ce0d3-0ca1-376c-9d42-8ee0a9d56d7a",
                                                "text": "En empêchant les vedettes uhlanes de passer la rivière et de porter leurs reconnaissances au delà, vers les lignes en préparation, elles avaient accompli tout ce qu’on pouvait attendre d’elles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uhlan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9b1c8e-2026-3ca4-abcf-af463ab0bb0a",
                                        "entry_id": "2623ee0b-27a5-3cdc-bc41-d996e8fcc8bd",
                                        "glosses": [
                                            "Nom que portaient les lanciers dans les armées germaniques ou slaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f313b83-5e3a-4bcd-b750-bd0bbb51dd3e",
                                                "sense_id": "ab9b1c8e-2026-3ca4-abcf-af463ab0bb0a",
                                                "text": "Cette poussière qui roule tout là-bas, c’est des uhlans ; plus on en tue, plus il y en a."
                                            },
                                            {
                                                "example_id": "a7d051da-013d-4d3e-bf03-4cf4057a27a5",
                                                "sense_id": "ab9b1c8e-2026-3ca4-abcf-af463ab0bb0a",
                                                "text": "Le uhlan mettait pied à terre, ouvrait tranquillement une carte ou un calepin, prenait des notes."
                                            },
                                            {
                                                "example_id": "23af5f63-5300-4ac8-a995-581190319d7f",
                                                "sense_id": "ab9b1c8e-2026-3ca4-abcf-af463ab0bb0a",
                                                "text": "Des traînards occupaient seuls des maisons, s’entassaient aux granges, sourds hagards, insensibles aux menaces, aux prières. Ils aimaient mieux se faire prendre, bétail humain, par les uhlans à leur poursuite."
                                            },
                                            {
                                                "example_id": "8871866f-dcc4-407d-9d11-9e3c76dfb85b",
                                                "sense_id": "ab9b1c8e-2026-3ca4-abcf-af463ab0bb0a",
                                                "text": "Trente uhlans pénètrent à Quaremont, chez un vieux paysan nommé De Poorter, et demandent du fourrage."
                                            },
                                            {
                                                "example_id": "24a44ebd-d4f9-4075-8be7-7502f4ac214d",
                                                "sense_id": "ab9b1c8e-2026-3ca4-abcf-af463ab0bb0a",
                                                "text": "Par la belle route en pente douce qui longe sous d’épais ombrages le « ru » de Toury, les uhlans descendaient vers Talus-Saint-Prix, patrouillaient le village, puis se glissaient vers le pont du Petit-Morin qu’ils franchissaient librement : […]."
                                            },
                                            {
                                                "example_id": "b154088f-a0b3-4c27-915e-484194a91737",
                                                "sense_id": "ab9b1c8e-2026-3ca4-abcf-af463ab0bb0a",
                                                "text": "O Prussien parmi nous circulant, / des héros tu mérites la pomme. / Chacun de nous t’estime en tant qu’homme, / mais chacun te hait en tant qu’uhlan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c70a7dc-4e6f-4c39-8024-f49e3512d2a5",
