        "fr-extract.jsonl": [
            {
                "entry_id": "c74ef8d4-addc-379f-ab39-e52161555479",
                "word": "essaimage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c74e213c-0727-4150-a724-efc44e20db55",
                        "entry_id": "c74ef8d4-addc-379f-ab39-e52161555479",
                        "tags": [
                            "plural"
                        ],
                        "form": "essaimages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02ca1934-bb7b-3cf5-bc6f-8a411863eca3",
                        "entry_id": "c74ef8d4-addc-379f-ab39-e52161555479",
                        "glosses": [
                            "Action d’essaimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2db0fcc1-f369-4511-b0c7-aa74eaf0e4f0",
                                "sense_id": "02ca1934-bb7b-3cf5-bc6f-8a411863eca3",
                                "text": "La marche de la miellée exerce sur l’essaimage une influence considérable, et les apiculteurs disent communément qu'une année riche en miel est pauvre en essaims."
                            },
                            {
                                "example_id": "d12566f1-10f5-4ee5-abff-ca57d0f74d6d",
                                "sense_id": "02ca1934-bb7b-3cf5-bc6f-8a411863eca3",
                                "text": "Au nord-est des États-Unis, dans l’État de New York, trois études dirigées par Michael Burgett, Richard Fell et Thomas Seeley ont montré que la saison de l’essaimage s’étendait de début mai à fin septembre, avec 84 % des essaims entre le 1ᵉʳ mai et le 15 juillet, et le pic vers le 10 juin."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2937bc2-3557-374e-947e-4b717c73aa45",
                        "entry_id": "c74ef8d4-addc-379f-ab39-e52161555479",
                        "glosses": [
                            "Époque de l’année où les abeilles essaiment."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "42956335-3d43-4a8b-a1d5-475271688ed3",
                                "sense_id": "f2937bc2-3557-374e-947e-4b717c73aa45",
                                "text": "Au sud-ouest des États-Unis, d’après J. Schmidt et R. Hurley, l’essaimage commence en Arizona la dernière semaine de mars et se prolonge jusqu’à la première semaine de juin."
                            }
                        ]
                    },
                    {
                        "sense_id": "abcfa6bd-ed30-3c85-b986-094c784134b1",
                        "entry_id": "c74ef8d4-addc-379f-ab39-e52161555479",
                        "glosses": [
                            "Pratique par laquelle une entreprise incite ses salariés à créer leur propre entreprise."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3c67be93-a763-3d76-a606-8259fb7107bc",
                        "entry_id": "c74ef8d4-addc-379f-ab39-e52161555479",
                        "glosses": [
                            "Action d'essaimer, de se répandre, de se diffuser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0f97b0-4521-450d-8f52-e6d6e7bccfb9",
                                "sense_id": "3c67be93-a763-3d76-a606-8259fb7107bc",
                                "text": "Le phénomène d’essaimage est net et contraste avec le discours dominant, qui encense l'innovation et l'originalité managériales. Nous assistons à l'inverse à la banalisation des produits du « prêt à manager »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd3ee799-7850-415b-9346-c3d11ce1a415",
                        "source_entry_id": "c74ef8d4-addc-379f-ab39-e52161555479",
                        "source_sense_description": "Action d'essaimer",
                        "target_lang_word": "sciamatura",
