                "translations": [
                    {
                        "translation_id": "5bc5869f-add8-49fc-9639-1d24167a8baa",
                        "source_entry_id": "23af3de6-47f3-3eea-8cc8-a6039fcacc61",
                        "source_sense_id": "f6107c4d-c874-312e-85d0-ef96b334689e",
                        "target_lang_word": "Margarine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Margarine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                        "entry_id": "3d154b32-ac1f-3712-8ea2-bc2aeecd7301",
                                        "glosses": [
                                            "butterähnliches Nahrungsmittel, das (vorwiegend) aus pflanzlichen Fetten hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9ce0229-3ab3-4a40-a1e7-648504d74ee3",
                                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                                "text": "Butter habe ich keine im Haus, du musst Margarine nehmen."
                                            },
                                            {
                                                "example_id": "8531d76e-a075-4a7f-90fb-edd149dbab27",
                                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                                "text": "Anstelle von Butter kann man auch mit Margarine braten und backen."
                                            },
                                            {
                                                "example_id": "8060b1b7-e9af-4d2d-a551-16b431d3563c",
                                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                                "text": "„Meine Großmutter war gegen Margarine und begründete dies mit Argumenten, von denen sie nicht mehr abließ.“"
                                            },
                                            {
                                                "example_id": "929b5d3f-ced7-463e-9253-4e50af609063",
                                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                                "text": "„Ich esse mein Brot mit Margarine und Pflaumenmarmelade.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95e6da35-5610-43a5-a399-d3e3d86ad982",
                        "source_entry_id": "23af3de6-47f3-3eea-8cc8-a6039fcacc61",
                        "source_sense_id": "f6107c4d-c874-312e-85d0-ef96b334689e",
                        "target_lang_word": "margarine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margarine",
