                "senses": [
                    {
                        "sense_id": "55cde72e-3326-319d-9fbf-b955e3281553",
                        "entry_id": "65eee65d-bc82-3adb-bfe0-54f0c32ecd6c",
                        "glosses": [
                            "weibliche Person, die einen Hubschrauber steuert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a5121b1-4435-4f8a-b323-d714547975cf",
                                "sense_id": "55cde72e-3326-319d-9fbf-b955e3281553",
                                "text": "Hubschrauberpilotinnen üben einen gefährlichen Beruf aus."
                            },
                            {
                                "example_id": "cbce662e-62c1-4a49-bfe5-b7794f33bd29",
                                "sense_id": "55cde72e-3326-319d-9fbf-b955e3281553",
                                "text": "„Die Hubschrauberpilotin wurde weit über die Grenzen der Ukraine hinaus bekannt, als sie auf dem Höhepunkt des Krieges in der Ostukraine im Sommer 2014 von prorussischen Separatisten gefangen genommen und nach Russland entführt wurde.“"
                            },
                            {
                                "example_id": "bddee3d5-cd39-4ff5-acba-e96bf5941b43",
                                "sense_id": "55cde72e-3326-319d-9fbf-b955e3281553",
                                "text": "„Die gelernte Kampfpilotin wurde im Irak als Hubschrauberpilotin eingesetzt und verlor beim Beschuss ihrer Maschine (sie war Kopilotin) beide Beine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
