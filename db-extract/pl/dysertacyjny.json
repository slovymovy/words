                        "examples": [
                            {
                                "example_id": "55506dcf-ece0-4eab-a12c-585d3eff55bb",
                                "sense_id": "1f585cb2-ea62-38de-9d6a-46154e9df0d5",
                                "text": "Trzecią formą jest program badań własnych finansowany dość skromnie ze środków Uczelni. Dotyczy on głównie prac dysertacyjnych, ale również innych – uwzględniając w miarę możliwości zainteresowania szerokiego grona pracowników"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
