                        "form": "den Knackpunkt"
                    },
                    {
                        "form_id": "d172e0a6-7002-4180-9def-b9a7db797164",
                        "entry_id": "879bb3bb-8f45-3e5d-9376-36cfeeb297a1",
                        "tags": [
                            "accusative",
