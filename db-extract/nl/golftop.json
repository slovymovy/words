                "senses": [
                    {
                        "sense_id": "2bfcd736-896a-3b8e-a1fd-06e4cb9d3067",
                        "entry_id": "02b6677d-5624-3e99-9bb4-ee68b68f6cf9",
                        "glosses": [
                            "hoogste punt van een golf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e5e08ad-81ba-4899-adaf-aad40f003338",
                                "sense_id": "2bfcd736-896a-3b8e-a1fd-06e4cb9d3067",
                                "text": "Zijn woorden “ready for hoist” komen maar net boven de huilende wind uit. We varen aan de wind. De boot stampt wild op en neer. Elke keer als de romp van een golftop afklettert of als er een zeil wordt getrimd klinken er apocalyptische geluiden door het binnenste van de 65 voet lange carbon romp."
                            }
                        ]
                    },
                    {
                        "sense_id": "e37c2420-271e-35d6-8d65-5a2fd9c9a014",
                        "entry_id": "02b6677d-5624-3e99-9bb4-ee68b68f6cf9",
                        "glosses": [
                            "groep van de beste golfspelers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d250d92-3da7-4764-824f-9097fc11f66c",
                                "sense_id": "e37c2420-271e-35d6-8d65-5a2fd9c9a014",
                                "text": "Woods sloot 2017 af als nummer 656 van de wereld. Hij keerde vorig jaar fit en scherp terug op de PGA Tour en onderstreepte op de Masters zijn terugkeer aan de golftop. De zege van Woods leverde hem zelfs felicitaties op van president Donald Trump en diens voorganger Barack Obama."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b9c2fb2-4d8f-3474-b831-91dc53b19b22",
                        "entry_id": "02b6677d-5624-3e99-9bb4-ee68b68f6cf9",
                        "glosses": [
                            "bijeenkomst op het hoogste niveau van leiders van de Golfstaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0bc54b-9457-424d-92f3-2637be493470",
                                "sense_id": "7b9c2fb2-4d8f-3474-b831-91dc53b19b22",
                                "text": "Qatar krijgt uitnodiging Golftop van Saudi’s: De emir van Qatar, sjeik Tamim bin Hamad al-Thani, heeft een schriftelijke uitnodiging ontvangen van de Saudische koning Salman om de jaarlijkse top van Golfstaten bij te wonen. Deze wordt op 9 december gehouden in de Saudische hoofdstad Riyad. Dat meldde het Qatarese persbureau."
                            }
                        ]
                    }
