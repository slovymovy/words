                    {
                        "sense_id": "35a3039c-a43f-3f7f-9f17-3e275bf8bb9f",
                        "entry_id": "2c0e02ba-a3b3-3e6a-a9c1-84a5b2215cc2",
                        "glosses": [
                            "Activité du charcutier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4323b78d-74d6-4542-af2d-2503545d0f6f",
                                "sense_id": "35a3039c-a43f-3f7f-9f17-3e275bf8bb9f",
                                "text": "Dans une espèce qui a donné lieu à un arrêt de la Cour de Lyon du 5 mai 1966 (D., 1966.547) il était reproché à un charcutier d'avoir confectionné des produits de charcuterie, en l’espèce saucissons, saucisses ou godiveaux, contenant des matières grasses supérieures à un taux de 50%, ce qui l’avait mis en l’état infractionnel, eu égard aux usages locaux, loyaux et constants."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bc05140-282e-3b87-9f26-dc4204c79f89",
                        "entry_id": "2c0e02ba-a3b3-3e6a-a9c1-84a5b2215cc2",
                        "glosses": [
                            "Boutique où se fait le commerce du charcutier."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69357b20-10d3-312e-b20f-1ec4e71cf319",
                        "entry_id": "2c0e02ba-a3b3-3e6a-a9c1-84a5b2215cc2",
                        "glosses": [
                            "Viande de porc préparée par les charcutiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a8b5d3-49b9-4bca-b900-a5d8fb03d54a",
                                "sense_id": "69357b20-10d3-312e-b20f-1ec4e71cf319",
                                "text": "L’équipe montre pour la première fois, in vivo chez le rat, qu'une charcuterie modèle riche en hème (…), salée, additionnée de nitrites, cuite et oxydée était promotrice du développement du cancer colorectal."
                            }
                        ]
                    }
