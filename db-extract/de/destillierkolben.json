                "senses": [
                    {
                        "sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                        "entry_id": "9470bfc7-4790-3614-9826-3662573d51c9",
                        "glosses": [
                            "Glasgefäß, das man zur Destillation benutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534458df-c1b4-4e39-8bdf-bdadf42c412a",
                                "sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                                "text": "Die zu untersuchende Flüssigkeit wurde in einem beheizten Destillierkolben destilliert."
                            },
                            {
                                "example_id": "68f59285-72d4-4f64-be6e-269f4beb2ae7",
                                "sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                                "text": "Ende des 18. Jahrhunderts gab es auf Mallorca rund 180 Destillierkolben zur Herstellung von Schnaps, ca. 750.000 Liter wurden schon damals produziert, 60 Prozent davon für den Konsum auf der Insel Mallorca."
                            },
                            {
                                "example_id": "13839bd6-1cf9-42bb-85d8-f4942b5713d7",
                                "sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                                "text": "„Auch daß ich Hunger hatte, daß eine leichte Übelkeit in mir kreiste wie Flüssigkeit in einem Destillierkolben – das alles geschah neben mir.“"
                            },
                            {
                                "example_id": "39a7222e-74e1-4e7a-a49e-09e0b2186f44",
                                "sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                                "text": "„Sie erstanden die Geräte eines verkrachten Destillateurs, und bald kamen Siebe, Fäßchen, Trichter, Schaumlöffel, Filtrierbeutel und Waagen ins Haus, ohne eine Schleifschale mit Kugel und einen Destillierkolben mitzuzählen, der einen Schmelzofen mit Rauchfang erforderlich machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a331e65f-93d9-4132-9b34-f14abd2d4095",
                        "source_entry_id": "9470bfc7-4790-3614-9826-3662573d51c9",
