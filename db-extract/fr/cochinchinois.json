                        "glosses": [
                            "Habitant ou originaire de la Cochinchine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0999a704-739c-4919-af3c-604f8b0781a0",
                                "sense_id": "1ad6d32a-b4fa-3544-b21f-2ba039c49fb7",
                                "text": "Devant une foule de Cochinchinois ébahis, plutôt hilares parce que ce peuple a de l’humour, nous annoncions notre précieuse arrivée : « maréchal, nous voilà »!"
                            },
                            {
                                "example_id": "1f712cda-8878-45b9-af29-c41d76c136ee",
                                "sense_id": "1ad6d32a-b4fa-3544-b21f-2ba039c49fb7",
                                "text": "Les soins qu’ils mettent à imiter ces derniers donne aux Cochinchinois et surtout aux Tonquinois un grand avantage dans les arts utiles, sur les nations plus occidentales."
                            }
                        ]
                    }
