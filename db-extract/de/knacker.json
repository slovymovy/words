                        ],
                        "form": "die Knacker"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cc44c42-477d-34f3-aae2-30512ccda128",
                        "entry_id": "89dff101-b826-3fa4-afd4-b24a09fd3f92",
                        "glosses": [
                            "alter Mann"
                        ],
                        "tags": [
                            "casual",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "9eb3fcbd-968a-4f57-add9-5165c8c52c4a",
                                "sense_id": "3cc44c42-477d-34f3-aae2-30512ccda128",
                                "text": "Im Park sitzen immer die alten Knacker und füttern die Enten."
                            },
                            {
                                "example_id": "ac1eaedc-f3f0-4be0-a480-8d19a8d4bda1",
                                "sense_id": "3cc44c42-477d-34f3-aae2-30512ccda128",
                                "text": "„Die beiden alten Knacker sahen mich von der Seite an.“"
                            },
                            {
                                "example_id": "5b8ff171-5f65-4f9e-bfde-b33b76b79316",
                                "sense_id": "3cc44c42-477d-34f3-aae2-30512ccda128",
                                "text": "„Mit diesen zynischen alten Knackern verstand ich mich ganz gut, ich hatte nichts mit ihnen zu tun, mit chinesischen Mandarinen hätte ich mich genausogut verstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bc746749-1e2b-3626-8031-834a31f313ff",
                        "entry_id": "89dff101-b826-3fa4-afd4-b24a09fd3f92",
                        "glosses": [
                            "je nach Region unterschiedlich zubereitete Wurst; in siedendem Wasser gekochte Wurst (Brühwurst) oder Rohwurst"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "d2ebed1b-9574-4b58-b707-870903e63b24",
                                "sense_id": "bc746749-1e2b-3626-8031-834a31f313ff",
                                "text": "Wir haben heute frische Knacker im Angebot."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "271c2207-8064-3cb0-90ef-e7b042062fd7",
                        "entry_id": "89dff101-b826-3fa4-afd4-b24a09fd3f92",
                        "glosses": [
                            "jemand oder etwas, der oder das etwas (auf)knackt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2116b04f-95ec-4e32-9486-3f6f48709092",
                                "sense_id": "271c2207-8064-3cb0-90ef-e7b042062fd7",
                                "text": "„Letzterer ist gar nicht so leicht freizulegen, da verbiegt sich mancher Knacker.“"
                            },
                            {
                                "example_id": "7f2c60ba-8c7e-4e6f-a2aa-cf6ec559ca81",
                                "sense_id": "271c2207-8064-3cb0-90ef-e7b042062fd7",
                                "text": "„Die anderen Versicherer hingegen messen dem keine Bedeutung zu: Schliesslich öffnen Knacker die meisten Autos innert Sekunden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
