                    {
                        "translation_id": "b51b7725-5d56-4fbb-bac0-b79413086001",
                        "source_entry_id": "4e9ba22e-5c89-36bd-8767-f635b38ee539",
                        "source_sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
