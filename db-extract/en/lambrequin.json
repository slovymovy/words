    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                "word": "lambrequin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9925fa3e-fee4-4677-ae68-218d3393cbec",
                        "entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                        "tags": [
                            "plural"
                        ],
                        "form": "lambrequins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "baba989b-3372-3216-9bdd-fa68090813ef",
                        "entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                        "glosses": [
                            "A scarf or other piece of material used as a covering for a helmet."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "13786f38-647e-4e6e-b8d3-6075690c125e",
                                "sense_id": "baba989b-3372-3216-9bdd-fa68090813ef",
                                "text": "'Twere as easy to woo the snow-dame that we shaped last winter in our castle yard. I did but ask her yesternight for her green veil, that I might bear it as a token or lambrequin upon my helm."
                            },
                            {
                                "example_id": "d753e78b-ebc7-4de4-be36-75c578377152",
                                "sense_id": "baba989b-3372-3216-9bdd-fa68090813ef",
                                "text": "A dead man (he had, I think, been suffocated with a lambrequin, there being those who practice that art) lay at the corner."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e105024-e2b8-393e-9f18-8162ae181d76",
                        "entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                        "glosses": [
                            "A heraldic representation of such an item, often used as drapery around a coat of arms."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3cd49d56-58b6-3418-872f-2a8599e98509",
                        "entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                        "glosses": [
                            "A short decorative drapery for a shelf edge or for the top of a window casing."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "433f7a5a-0692-4816-a616-888c4911254e",
                                "sense_id": "3cd49d56-58b6-3418-872f-2a8599e98509",
                                "text": "Lambrequins dependent from gaudy boxings of beaten tin, gilded."
                            },
                            {
                                "example_id": "31443e40-42ff-45d4-b4d0-b66956bf2c30",
                                "sense_id": "3cd49d56-58b6-3418-872f-2a8599e98509",
                                "text": "[…]the mirror over the mantel rested on a fringed mantel-cover of green reps, and heavy curtains of that stuff hung from gilt lambrequin frames at the window; […]."
                            },
                            {
                                "example_id": "e760bea9-060a-4fe9-a414-155e7a9d8b26",
                                "sense_id": "3cd49d56-58b6-3418-872f-2a8599e98509",
                                "text": "A suite in Paris, immense high grave rooms, with lambrequins and a balcony."
                            }
                        ]
                    },
                    {
                        "sense_id": "336b9029-1a41-310c-b4d4-665529e97b38",
                        "entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                        "glosses": [
                            "A decorative architectural element placed along the eaves of a roof, the edges of an overhang, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8abdb3ae-633f-3745-8c77-e3d17b3f8967",
                        "entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                        "glosses": [
                            "A border pattern with draped effect."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "971b46a2-a1be-4306-a5df-1b4a3845458f",
                        "source_entry_id": "59bf28c7-b949-3c44-be8f-aa8996e8240a",
                        "source_sense_description": "A short decorative drapery for a shelf edge or for the top of a window casing",
                        "target_lang_word": "ламбрекен",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ламбрекен",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "63ab7b5b-6e7b-381f-abc5-2b293eff938e",
                                        "entry_id": "f3e57526-5302-3b3e-a4c7-a91a03ddec39",
                                        "glosses": [
                                            "архит. резное деревянное или лепное украшение по краю навеса, крыши, над дверями и окнами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcdf5e9c-2b68-4e1b-8790-deaee8fcee42",
                                                "sense_id": "63ab7b5b-6e7b-381f-abc5-2b293eff938e",
                                                "text": "Они ведь с ней только-только наладили быт, купили стиральную машину-автомат, исполнили мечту Веры Николаевны и повесили (сто лет про это она думала!) на окна деревянные ламбрекены, которые тут же повысили в статусе саму квартиру."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6a5e87-7f46-30eb-899c-00d58205879b",
                                        "entry_id": "f3e57526-5302-3b3e-a4c7-a91a03ddec39",
                                        "glosses": [
                                            "спец. декоративная драпировка верхней части проёма окна, двери или алькова в виде короткой горизонтальной занавески во всю ширину карниза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da2387ff-195e-4e72-b548-9105a97c10ee",
                                                "sense_id": "1d6a5e87-7f46-30eb-899c-00d58205879b",
                                                "text": "Их смущал широкий образ жизни командора, смущали золочёные ламбрекены, ковры, сиявшие яркими химическими колерами, и гравюра «Явление Христа народу»."
                                            },
                                            {
                                                "example_id": "3e893899-760b-4fb8-b423-44543afb5113",
                                                "sense_id": "1d6a5e87-7f46-30eb-899c-00d58205879b",
                                                "text": "День был яркий, беспечно зажигающий шелестящие ламбрекенами матерчатые полосатые зонтики, сверкающий в окнах, шумящий всеми звуками сразу, как оркестр перед концертом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
