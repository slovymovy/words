                    {
                        "translation_id": "b3585431-e259-40f3-b987-6e76366c3c17",
                        "source_entry_id": "6033ed82-e250-3fe2-a20c-cdc8159283ba",
                        "source_sense_id": "a2cd7c6b-556a-349f-b0d0-c1c4248848af",
