                            {
                                "example_id": "3e5a9af4-80e9-4717-a1b3-8dad6f9cbe24",
                                "sense_id": "75372dba-408e-32cc-9d99-92ae3e135829",
                                "text": "Amadeus’ neue Freundin ist eine rücksichtslose Karrieristin."
                            },
                            {
                                "example_id": "e493ab91-b4a3-4820-99b9-f6f9b3c9442a",
                                "sense_id": "75372dba-408e-32cc-9d99-92ae3e135829",
                                "text": "Die Kinder waren heute mit Onkel Amadeus im Wald und haben Tannenzapfen gesammelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cad2c9d-fcaf-47c9-9c4b-3c85a6242f8c",
                        "source_entry_id": "4bc228d4-e785-36b3-abc5-cc5a7c90ce44",
