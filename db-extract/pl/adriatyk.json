                                        "entry_id": "a3a8a896-9536-3321-b93b-1645dfb3e901",
                                        "glosses": [
                                            "část Středozemního moře mezi Apeninským a Balkánským poloostrovem"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bfb1edb-e97c-43d8-b596-4aee4113c093",
                        "source_entry_id": "bb02c615-80eb-38ee-99b2-402528ff76a9",
                        "source_sense_id": "247a3152-f425-34cf-b506-f0dfeb3f4e6f",
