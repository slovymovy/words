                "senses": [
                    {
                        "sense_id": "7bf3050d-89d4-3aa2-b178-5557bf92b00c",
                        "entry_id": "8bcca608-8130-3486-8afe-2a8b1503299d",
                        "glosses": [
                            "Zustand eines hohen Wassergehaltes oder in oder auf dem Boden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09e6192-0ddc-4a92-92e3-c529b3479ee4",
                                "sense_id": "7bf3050d-89d4-3aa2-b178-5557bf92b00c",
                                "text": "„So kann z.B. Wasser aus dem Hangbereich einer Braunerde zur verstärkten Vernässung und zur Entwicklung eines Stagnogleys führen.“"
                            },
                            {
                                "example_id": "1cd9cb10-2127-4538-92f1-5224372291da",
                                "sense_id": "7bf3050d-89d4-3aa2-b178-5557bf92b00c",
                                "text": "„Anhaltende Vernässung über einem stark verdichteten Sd-Horizont führt zur Reduktion und lateralen Verlagerung von pedogenen Oxiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e5dc1477-0299-3c4b-9c55-983850283768",
                        "entry_id": "8bcca608-8130-3486-8afe-2a8b1503299d",
                        "glosses": [
                            "Erhöhung der Bodennässe durch natürliche Prozesse oder menschliches Handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9e8888-8bb5-4da2-b0c6-a7c4a34a1c86",
                                "sense_id": "e5dc1477-0299-3c4b-9c55-983850283768",
                                "text": "„Bereits kultivierter Boden geht oft durch Übernutzung, Vernässung, Versalzung und Verwüstung wieder verloren, manchmal für immer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
