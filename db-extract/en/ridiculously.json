                        "target_lang_word": "lächerlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lächerlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                        "entry_id": "85a483e5-9080-37a3-9913-9a6346a0d58b",
                                        "glosses": [
                                            "zum Lachen bringend; besonders seltsam, unsinnig oder ärgerlich wirkend"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e48ef29-d117-4753-bae6-41e062e2f8bb",
                                                "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                                "text": "Es war ein lächerlicher Auftritt, direkt peinlich."
                                            },
                                            {
                                                "example_id": "081857c0-132f-4211-b658-662db2ed3013",
                                                "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                                "text": "„Die Maske machte ein unaufhörlich lächerliches Gesicht.“"
                                            },
                                            {
                                                "example_id": "e1292d41-5f86-433f-a45b-d3456c98c2c1",
                                                "sense_id": "74752099-93d0-3170-a626-3b816b4754b7",
                                                "text": "„Die aufklärerische Fetischisierung der Nützlichkeit wurde nicht erst von den Romantikern lächerlich gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a007e1d-ca7e-3d18-aa51-04c84066f3ee",
                                        "entry_id": "85a483e5-9080-37a3-9913-9a6346a0d58b",
                                        "glosses": [
                                            "gering; (ärgerlich) klein"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77add001-7585-40e3-a785-9d4603960dd2",
                                                "sense_id": "3a007e1d-ca7e-3d18-aa51-04c84066f3ee",
                                                "text": "Die lächerliche Gehaltserhöhung ist praktisch null."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d966bb0c-6ccc-31ce-bd50-36cd9841fe99",
                                        "entry_id": "85a483e5-9080-37a3-9913-9a6346a0d58b",
                                        "glosses": [
                                            "besonders, in hohem Maße"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c574e2f-ec53-43db-9b32-20ccbd0e5c7c",
                                                "sense_id": "d966bb0c-6ccc-31ce-bd50-36cd9841fe99",
                                                "text": "„Aber die hatte vortreffliche Beziehungen in Deutschland, sie behielt keine fertige Tafel lange im Hause; und zweitens brauchte sie lächerlich wenig Geld.“"
                                            },
                                            {
                                                "example_id": "e226f38a-3a06-4b1e-94cc-1b0865724897",
                                                "sense_id": "d966bb0c-6ccc-31ce-bd50-36cd9841fe99",
                                                "text": "„Sie trägt eine kostbare Abendrobe und auf dem blonden Haar verwegen ein lächerlich kleines Hütchen, das bei jedem Schritt wippt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
