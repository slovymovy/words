                "senses": [
                    {
                        "sense_id": "d0406805-79f8-35c8-9bde-ff9f87b704a9",
                        "entry_id": "e507ae3f-e99f-3919-b0bf-e736faa6b63d",
                        "glosses": [
                            "Umzug von Kindern im Herbst, bei dem sie nach Einbrechen der Dunkelheit singend mit einer Laterne durch die Straßen ziehen"
                        ],
                        "tags": [
                            "Volksbrauch"
                        ],
                        "examples": [
                            {
                                "example_id": "205c230c-eff4-494c-a169-f8c6143c0dd7",
                                "sense_id": "d0406805-79f8-35c8-9bde-ff9f87b704a9",
                                "text": "„Das Laternenlaufen ist ein herbstlicher Brauch, bei dem Kinder nach Einbrechen der Dunkelheit singend mit einer Laterne von Haus zu Haus ziehen oder an einem Laternenumzug durch die Straßen teilnehmen.“"
                            },
                            {
                                "example_id": "f3613748-2eea-4cc3-b4a7-46933a4bceec",
                                "sense_id": "d0406805-79f8-35c8-9bde-ff9f87b704a9",
                                "text": "„Der Grenzkorridor ist nur zwei Autospuren breit, wird aber geachtet. »Hier waren wir ja noch nie«, sagen Eltern aus den Wohnsilos, wenn sie beim Laternelaufen mitmachen und von Erzieherinnen des Kindergartens auf die andere Seite geführt werden. In Tobuschats Siedlung imprägnieren Bewohner Jägerzäune, lackieren in Vorgärten Segelschiffchen oder setzen Blumenzwiebeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
