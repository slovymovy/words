                        "entry_id": "f00856d2-f739-37b0-b80e-bd2fef904db3",
                        "glosses": [
                            "a Christmas wreath (ring-shaped ornament fashioned from plant materials, decorated in Christmas style)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "e5d1c022-e5c2-4783-b8f2-28bb17d6f999",
                                "sense_id": "9d3abc87-70a0-3fc4-8368-a296a0034a27",
                                "text": "We hebben een kerstkrans aan de voordeur gehangen.",
                                "translation": "We hung a Christmas wreath on the front door.",
                                "english": "We hung a Christmas wreath on the front door."
                            },
                            {
                                "example_id": "ff556571-2166-4ac8-9362-3b82ca12604d",
                                "sense_id": "9d3abc87-70a0-3fc4-8368-a296a0034a27",
                                "text": "Ze maakte elk jaar een kerstkrans van verse dennentakken.",
                                "translation": "She made a Christmas wreath from fresh pine branches every year.",
                                "english": "She made a Christmas wreath from fresh pine branches every year."
                            }
                        ]
                    },
                    {
                        "sense_id": "d72cb5a0-ebab-332d-9788-2f7a7b5e6611",
                        "entry_id": "f00856d2-f739-37b0-b80e-bd2fef904db3",
                        "glosses": [
                            "a sweet/piece of candy in the shape of a Christmas wreath; often a biscuit, piece of chocolate or schuim"
                        ],
                        "tags": [
                            "diminutive",
                            "masculine",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "eff4ce91-db37-4eda-aa36-84d575f0f06d",
                                "sense_id": "d72cb5a0-ebab-332d-9788-2f7a7b5e6611",
                                "text": "De kinderen versierden de kerstkransen met gekleurde hagelslag.",
                                "translation": "The children decorated the Christmas wreath candies with colored sprinkles.",
                                "english": "The children decorated the Christmas wreath candies with colored sprinkles."
                            },
                            {
                                "example_id": "1e975db1-76a1-4b77-b8d3-7828c9618cdd",
                                "sense_id": "d72cb5a0-ebab-332d-9788-2f7a7b5e6611",
                                "text": "Ik kocht een doos met chocolade kerstkransen voor het feest.",
                                "translation": "I bought a box of chocolate Christmas wreath candies for the party.",
                                "english": "I bought a box of chocolate Christmas wreath candies for the party."
                            }
                        ]
                    }
