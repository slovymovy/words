                                        "glosses": [
                                            "A female tree spirit."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b97206c8-9f0b-4e30-8cfd-2e1fed70c0c9",
                                                "sense_id": "f9392e85-8a1e-3a8b-a307-112939392ea8",
                                                "text": "There it had stood for years, close beside a mighty oak, under which sat often the kindly old priest, who told stories to the listening children. The young chestnut tree listened with them: the Dryad inside it, who was still a child, could remember the time when the tree was so small that it only reached a little higher than the ferns and long blades of grass."
                                            }
                                        ]
