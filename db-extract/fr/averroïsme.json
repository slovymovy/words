                "entry_id": "afb0d791-653d-35e6-a9d0-c0192ff725f8",
                "word": "averroïsme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fdb992ae-8b83-42cb-a1b6-09a4b1cf921b",
                        "entry_id": "afb0d791-653d-35e6-a9d0-c0192ff725f8",
                        "tags": [
