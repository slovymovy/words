                                        "examples": [
                                            {
                                                "example_id": "df855e18-ba37-4851-a757-8a61706c6d58",
                                                "sense_id": "7db02f57-3714-3b2f-82a6-2d444396d066",
                                                "text": "puta vieja, beuda y loca,\nque fazéis los vinos caros,\neso me da de besaros\nen el culo que en la boca."
                                            },
                                            {
                                                "example_id": "1d16ba52-5ed4-4764-96a7-10191566535b",
                                                "sense_id": "7db02f57-3714-3b2f-82a6-2d444396d066",
                                                "text": "Vos pedáis tan por compás,\nsalbo honor del consonante,\nque no pesa un grano más\nvuestro culo cara tras\nque vuestras tetas delante."
                                            }
                                        ],
