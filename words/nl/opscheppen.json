            "senses": [
                {
                    "sense_id": "bb97958c-245c-3c05-bc71-123cf48638ea",
                    "sense_definition": "voedsel uit een pan of schaal op een bord doen om het te serveren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedsel serveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zal ik voor jou ook een beetje extra soep <w>opscheppen</w>?",
                            "target_lang_translations": {
                                "en": "Shall I <w>serve</w> you a little extra soup as well?"
                            }
                        },
                        {
                            "text": "Je mag zelf <w>opscheppen</w> hoeveel rijst je wilt eten vanavond.",
                            "target_lang_translations": {
                                "en": "You can <w>dish up</w> as much rice as you want to eat tonight yourself."
                            }
                        }
                    ],
                    "synonyms": [
                        "opdienen",
                        "serveren"
                    ],
                    "common_phrases": [
                        "eten opscheppen",
                        "een bord opscheppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to put food from a pan or dish onto a plate to serve it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "to put food onto a plate"
                            },
                            {
                                "target_lang_word": "dish up",
                                "target_lang_sense_clarification": "to serve food from a pot or pan"
                            },
                            {
                                "target_lang_word": "ladle",
                                "target_lang_sense_clarification": "specifically for soup or liquids"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6745bf6f-6fe6-3619-b969-01056fde4498",
                    "sense_definition": "overdreven positief over jezelf of je bezittingen praten om indruk te maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pochen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij houdt ervan om over zijn nieuwe, dure auto te <w>opscheppen</w> tegenover zijn vrienden.",
                            "target_lang_translations": {
                                "en": "He loves to <w>brag</w> about his new, expensive car to his friends."
                            }
                        },
                        {
                            "text": "Zit niet zo te <w>opscheppen</w> over je goede cijfers, want we weten dat je hard hebt gestudeerd.",
                            "target_lang_translations": {
                                "en": "Don't <w>boast</w> so much about your good grades, because we know you studied hard."
                            }
                        }
                    ],
                    "synonyms": [
                        "pochen",
                        "bluffen",
                        "dik doen"
                    ],
                    "common_phrases": [
                        "vreselijk opscheppen",
                        "zitten te opscheppen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in informele gesprekken over iemands gedrag"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to talk excessively positively about yourself or your possessions to make an impression"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brag",
                                "target_lang_sense_clarification": "to boast about achievements or possessions"
                            },
                            {
                                "target_lang_word": "boast",
                                "target_lang_sense_clarification": "to speak with excessive pride"
                            },
                            {
                                "target_lang_word": "show off",
                                "target_lang_sense_clarification": "to behave in a way intended to attract attention"
                            }
                        ]
                    }
                }
            ]
        }
    ]
