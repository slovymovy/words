                        "source_entry_id": "a13017cf-df8a-385b-a15c-8e4c9a5feb0a",
                        "source_sense_id": "be7b00ea-d51c-35cb-b51a-ff0270e733ed",
                        "target_lang_word": "schizoide",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schizoide",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b3bb9b-44cb-3ae0-a484-301c52bc1647",
                                        "entry_id": "d8072788-e7d7-306b-99df-b9ae09d40179",
                                        "glosses": [
                                            "che riguarda la schizoidia"
                                        ],
                                        "tags": [],
