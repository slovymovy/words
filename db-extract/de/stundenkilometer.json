                "senses": [
                    {
                        "sense_id": "4e308cea-c87f-3753-a8b5-85b42ff6acb2",
                        "entry_id": "7f6b3853-d470-3f27-a20e-74dffdee09da",
                        "glosses": [
                            "Kilometer pro Stunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74e98400-d04d-4fb8-a01f-b3196f1074cb",
                                "sense_id": "4e308cea-c87f-3753-a8b5-85b42ff6acb2",
                                "text": "Er fuhr mit 100 Stundenkilometern."
                            },
                            {
                                "example_id": "86d583d0-e0b6-4b0d-bd4c-ab296f2dbb5f",
                                "sense_id": "4e308cea-c87f-3753-a8b5-85b42ff6acb2",
                                "text": "„Außerhalb der Ortschaften sind 80 Stundenkilometer erlaubt, aber maximal 57 möglich.“"
                            },
                            {
                                "example_id": "55031b0e-4418-4d6d-bd5a-501260f604c1",
                                "sense_id": "4e308cea-c87f-3753-a8b5-85b42ff6acb2",
                                "text": "„Ich bin sowohl Automobilist als auch Fußgänger und entschlossen, mich genau an die Höchstgeschwindigkeit von 50 Stundenkilometern zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
