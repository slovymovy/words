        "fr-extract.jsonl": [
            {
                "entry_id": "c7d6c007-123d-3de5-bfd7-f6b4ffc610c4",
                "word": "incontestablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bfb1f60e-3089-3cbe-a543-408bcc8ad43d",
                        "entry_id": "c7d6c007-123d-3de5-bfd7-f6b4ffc610c4",
                        "glosses": [
                            "D’une manière incontestable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bde5aa5-c37e-43f5-94ad-800c280ece78",
                                "sense_id": "bfb1f60e-3089-3cbe-a543-408bcc8ad43d",
                                "text": "Montesquieu reproche à Dubos qu’il ne saurait montrer l’existence de la république armorique : cependant Dubos l’a prouvée incontestablement par plusieurs monuments et surtout par cette citation exacte de l’historien Zozime."
                            },
                            {
                                "example_id": "7f6fd90d-ede9-49c9-82a9-94f3d88802d6",
                                "sense_id": "bfb1f60e-3089-3cbe-a543-408bcc8ad43d",
                                "text": "Un enfant, dépourvu de force et d’intelligence, a incontestablement un droit naturel à la subsistance, fondé sur le devoir prescrit par la nature au pere et à la mere."
                            }
                        ]
                    },
                    {
                        "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                        "entry_id": "c7d6c007-123d-3de5-bfd7-f6b4ffc610c4",
                        "glosses": [
                            "Sans conteste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfcb867-fb79-4111-aa53-9fc5cf4d79c6",
                                "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                                "text": "S’il est un pays le mieux préparé que tout autre pour entreprendre cette tâche et la mener à bonne fin, c’est incontestablement la France."
                            },
                            {
                                "example_id": "b667bfe0-cc56-452f-b44a-a888f274a4b1",
                                "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                                "text": "L’origine des bauxites, dit M. Coquand, se rattache incontestablement à l’intervention de sources minérales qui ont apporté, soit dans les lacs, soit à la surface des sols immergés, les aluminates de fer et les diaspores qui constituent les minerais de bauxite."
                            },
                            {
                                "example_id": "dfe868b9-69ec-47c1-b9d7-43db21481a2d",
                                "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                                "text": "Charles le Bel, qui s’était opposé à la loi salique, prit incontestablement la couronne et exclut les filles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
