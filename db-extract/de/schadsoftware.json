                    {
                        "sense_id": "e527c174-4246-302b-8b19-47886a5011d2",
                        "entry_id": "b5b667e2-4504-337b-b4a9-34bbc76967e2",
                        "glosses": [
                            "Programm, das auf fremden Computersystemen Schaden verursachen oder unerwünschte Funktionen ausführen soll"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "3baebb2e-6be1-4879-a344-e9aae15218f4",
                                "sense_id": "e527c174-4246-302b-8b19-47886a5011d2",
                                "text": "Die Schadsoftware infizierte nach offiziellen iranischen Angaben auch Systeme im Atomkraftwerk Buschehr."
                            },
                            {
                                "example_id": "effff308-be64-48ab-b1bc-dccba3fc74c7",
                                "sense_id": "e527c174-4246-302b-8b19-47886a5011d2",
                                "text": "Ungeschützte Windows-Rechner gebe es so viele, dass Schadsoftware fast ausschließlich für Windows programmiert werde."
                            },
                            {
                                "example_id": "b968f0b1-8df0-44f7-9e6f-0728df13f544",
                                "sense_id": "e527c174-4246-302b-8b19-47886a5011d2",
                                "text": "Virenscanner können das Einschleusen von Schadsoftware verhindern."
                            }
                        ],
                        "sense_index_json": "\"1\""
