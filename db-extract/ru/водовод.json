                ],
                "translations": [
                    {
                        "translation_id": "a71708d8-2848-4f02-886e-ed4095fb683a",
                        "source_entry_id": "f7abfde7-8f1b-39be-afb2-e7186f9ab73d",
                        "source_sense_id": "0ef2b280-00ae-3fc9-a906-ec45e5a4b9ba",
                        "target_lang_word": "aqueduct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aqueduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "349be4af-a623-34f1-8e70-cdd9a771d435",
                                        "entry_id": "2c53edc6-592b-3f9e-b21c-3fb732928093",
                                        "glosses": [
                                            "An artificial channel that is constructed to convey water from one location to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "345c580f-b02e-390c-b447-534e3def1362",
                                        "entry_id": "2c53edc6-592b-3f9e-b21c-3fb732928093",
                                        "glosses": [
                                            "A structure carrying water over a river or depression, especially an ancient structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca8b71a-463a-4252-b05e-902bc178ffe2",
                                                "sense_id": "345c580f-b02e-390c-b447-534e3def1362",
                                                "text": "All the years he’d been down there in the traffic he’d taken this aqueduct for just another bridge, nothing to tell you that canal boats and waterfowl were being carried along above your head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f81fe94-8dbc-3267-92a5-779faaad4c6b",
                                        "entry_id": "2c53edc6-592b-3f9e-b21c-3fb732928093",
                                        "glosses": [
                                            "A structure conveying fluid, such as the cerebral aqueduct or vestibular aqueduct."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7c3741a-4291-4c0d-80d2-443d9bfe9a84",
                        "source_entry_id": "f7abfde7-8f1b-39be-afb2-e7186f9ab73d",
                        "source_sense_id": "0ef2b280-00ae-3fc9-a906-ec45e5a4b9ba",
                        "target_lang_word": "aqueduc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aqueduc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47a574ac-a70f-308c-a0ce-b25e2b99c89a",
                                        "entry_id": "6300d578-b649-332a-83a7-207aaafa2588",
                                        "glosses": [
                                            "Canal ou conduite en maçonnerie (visible quand elle est surélevée) destinée à apporter de l’eau potable dans une ville, malgré la distance et la dénivelée entre la source et la ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324eb4fc-6b82-471d-9eba-e0fdf801565b",
                                                "sense_id": "47a574ac-a70f-308c-a0ce-b25e2b99c89a",
                                                "text": "L’aqueduc du Pont du Gard s’élève à près de 50 mètres au-dessus du Gardon."
                                            },
                                            {
                                                "example_id": "bd35f439-eeec-4bca-8c56-4931b978dcd5",
                                                "sense_id": "47a574ac-a70f-308c-a0ce-b25e2b99c89a",
                                                "text": "Elle s’y rencontre le long de l’aqueduc qui amène de Moutrépalayam à Pondichéry l’eau qui alimente cette dernière ville."
                                            },
                                            {
                                                "example_id": "0f720765-5890-484f-9d2e-68ad1413a042",
                                                "sense_id": "47a574ac-a70f-308c-a0ce-b25e2b99c89a",
                                                "text": "Si les vieux Ruthènes, ont été aussi réfractaires que nous le supposons à l’influence latine, d’où vient donc que nous rencontrons dans l’Aveyron tant d’importants travaux romains, à commencer par cet aqueduc qui, même aujourd’hui, donne encore à boire aux habitants du chef-lieu ?"
                                            },
                                            {
                                                "example_id": "cc77613d-5921-4bbb-aab9-85a66c9a5e2a",
                                                "sense_id": "47a574ac-a70f-308c-a0ce-b25e2b99c89a",
                                                "text": "Un aqueduc du IIᵉ siècle, long de 3 km amenait l’eau de la fontaine Bonnet pour alimenter des thermes gallo-romains, situés à un carrefour des voies antiques près de l’actuel presbytère d’Arthon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f604f8-149e-3152-a859-667cb32f3327",
                                        "entry_id": "6300d578-b649-332a-83a7-207aaafa2588",
                                        "glosses": [
                                            "Château d'eau. ^([1]) (Note : à Québec on prononce /akə.dyk/)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a6d4f79-4325-38b9-a808-5e9d42f7d6f0",
                                        "entry_id": "6300d578-b649-332a-83a7-207aaafa2588",
                                        "glosses": [
                                            "Réseau de distribution d'eau courante. ^([1]) ^([2]) (Note : à Québec on prononce /akə.dyk/)"
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e80536d5-9971-421e-a170-dcabf4efeff2",
                                                "sense_id": "1a6d4f79-4325-38b9-a808-5e9d42f7d6f0",
                                                "text": "Une maison reliée à l'aqueduc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "718057b1-5e09-31c0-97a4-a1ee50ba0f69",
                                        "entry_id": "6300d578-b649-332a-83a7-207aaafa2588",
                                        "glosses": [
                                            "Canal qui fait communiquer entre elles certaines parties de l’organisme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a8020f-7d69-4375-8bfa-74f69dd44beb",
                                                "sense_id": "718057b1-5e09-31c0-97a4-a1ee50ba0f69",
                                                "text": "Dans l’oreille : l’aqueduc du vestibule, du limaçon."
                                            },
                                            {
                                                "example_id": "5b5e4e67-f01b-466e-aa2e-d54b86a31e89",
                                                "sense_id": "718057b1-5e09-31c0-97a4-a1ee50ba0f69",
                                                "text": "En neurologie : Aqueduc du mésencéphale ou de Sylvius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea9cd16a-017a-31b4-85fa-694777f5c6a5",
                                        "entry_id": "6300d578-b649-332a-83a7-207aaafa2588",
                                        "glosses": [
                                            "Meuble représentant l’ouvrage d’art du même nom dans les armoiries. Il suit les règles de blasonnement des ponts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b860ed60-5b97-4daa-a7e3-be4d53a0ea69",
                                                "sense_id": "ea9cd16a-017a-31b4-85fa-694777f5c6a5",
                                                "text": "Coupé au premier d’azur, à un aqueduc à huit arches d’or maçonné de sable ; au deuxième de gueules, à une massette de carrier d’or emmanchée d’argent, mise en pal la tête en bas, adextrée d’un fer de moulin d’or et sénestrée d’un rencontre de bélier d’argent accornée d’or, qui est de la commune de Le Syndicat des Vosges → voir illustration « armoiries avec un aqueduc »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c54915ac-32f0-3860-8f59-f98d1107ce93",
                                        "entry_id": "6300d578-b649-332a-83a7-207aaafa2588",
                                        "glosses": [
                                            "Buse ou tunnel permettant le passage d’un fossé ou d’un ruisseau par un chemin."
                                        ],
                                        "tags": [
                                            "Lorraine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90da122b-4cba-4b97-8fc3-ec13f54d8dea",
                                                "sense_id": "c54915ac-32f0-3860-8f59-f98d1107ce93",
                                                "text": "Si tu veux que ton engin puisse passer le fossé, tu devras d’abord poser un aqueduc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
