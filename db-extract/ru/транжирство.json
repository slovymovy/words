                "senses": [
                    {
                        "sense_id": "1746ed0c-1a9a-3a9a-a2b8-f5279976962b",
                        "entry_id": "8bf1b9f4-795e-3cea-99b1-59e8d676d192",
                        "glosses": [
                            "разг. неразумная трата денег"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d4728e-4527-47f1-8c88-50a95115d885",
                                "sense_id": "1746ed0c-1a9a-3a9a-a2b8-f5279976962b",
                                "text": "Расточительная и мелочная, она вобрала в себя характерное свойство русских барынь ― транжирство с грошовым расчётом и полным отсутствием правильной оценки вещей."
                            },
                            {
                                "example_id": "bad8d492-8b97-4d64-8ed1-000dc8b386a5",
                                "sense_id": "1746ed0c-1a9a-3a9a-a2b8-f5279976962b",
                                "text": "Главное ― двигаться, нерешительность чревата транжирством энергетических ресурсов (на обычном топливе большинство живёт, только одиночки, один из ста тысяч, учатся использовать бесконечную энергию солнца-ветра и человеческой доброты-злобы)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7234141-0ae4-473c-8653-a84012926439",
                        "source_entry_id": "8bf1b9f4-795e-3cea-99b1-59e8d676d192",
                        "source_sense_id": "1746ed0c-1a9a-3a9a-a2b8-f5279976962b",
                        "target_lang_word": "Veruntreuung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veruntreuung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                        "entry_id": "a54ab8de-7c69-328e-8b8b-88f93e7765e2",
                                        "glosses": [
                                            "rechtswidrige Aneignung fremden Eigentums, das sich bereits im eigenen Besitz befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d9174c-9d16-45ac-8168-52adcc888390",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Die Veruntreuung wurde im Rahmen der seit Herbst verstärkten Kontrollen festgestellt.“"
                                            },
                                            {
                                                "example_id": "5aebfca2-89aa-44e0-9af1-253bb88d0496",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Eigenmächtige und vertragswidrige Ausdehnung der Mietdauer allein begründet nicht Veruntreuung eines Mietwagens.“"
                                            },
                                            {
                                                "example_id": "43eac837-bda0-426e-baf7-f2f1e5f58ed0",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Der Verdacht lautet auf Betrug, ungetreue Geschäftsbesorgung, Geldwäscherei und Veruntreuung.“"
                                            },
                                            {
                                                "example_id": "b6d7d8b5-5085-4cd6-a2bf-5f6312ca6413",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„So lese ich gerade, dass Middelhoff zu drei Jahren Haft wegen Veruntreuung verurteilt worden ist, wegen umgerechnet 750.000 Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19a64a81-cefd-46c5-98f5-0668d1908672",
                        "source_entry_id": "8bf1b9f4-795e-3cea-99b1-59e8d676d192",
                        "source_sense_id": "1746ed0c-1a9a-3a9a-a2b8-f5279976962b",
                        "target_lang_word": "Verschwendung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschwendung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                        "entry_id": "d2f5cc18-a4b0-3c1a-a312-55527038eebb",
                                        "glosses": [
                                            "unnötiger oder sinnloser Verbrauch von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443ceb17-3659-4f62-ab6c-7a120eb67b2c",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "Geiz ist Grausamkeit gegen die Dürftigen und die Verschwendung ist es nicht weniger."
                                            },
                                            {
                                                "example_id": "ba7e0206-ffd4-40bd-b1d2-3106aff2f6a7",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "Wo die Barmherzigkeit und Klugheit ist, da ist nicht Verschwendung noch Täuschung."
                                            },
                                            {
                                                "example_id": "54e79c73-1db1-4cbc-a4a9-bd0aa4011e4a",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "Du kannst doch nicht den halben Salat wegwerfen, nur weil er nicht so hübsch gekräuselt ist! Was für eine Verschwendung!"
                                            },
                                            {
                                                "example_id": "23a7838e-dbe0-4839-af79-415d650d4e50",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "„Die Ausbildung war die reinste Verschwendung von Zeit, Geld und Einsatz gewesen.“"
                                            },
                                            {
                                                "example_id": "dd8c0ea6-dd19-4219-a1d2-265769de949f",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "„Ich kann nicht behaupten, dass diese Verschwendung meiner Geldmittel mir irgendeine wesentliche Befriedigung verschaffte.“"
                                            },
                                            {
                                                "example_id": "ca48e427-ee5e-4440-9af9-acd28c338ce5",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "„Es herrschte dort der Überfluß, oder vielmehr die Verschwendung, die man in Paris bei allen Leuten dieser Klasse findet: große Gesellschaft, hohes Kartenspiel, prachtvolles Essen und ungezwungene Heiterkeit bei Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef1c37ce-33b8-45cd-91e0-5c23e7e90018",
                        "source_entry_id": "8bf1b9f4-795e-3cea-99b1-59e8d676d192",
                        "source_sense_id": "1746ed0c-1a9a-3a9a-a2b8-f5279976962b",
                        "target_lang_word": "dilapidation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dilapidation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63a6cab9-b07b-3d5f-871f-83b125821b08",
                                        "entry_id": "8c58d08a-9a73-3bdc-8365-c4c77e3f451c",
                                        "glosses": [
                                            "Action de dilapider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e306b5aa-1d12-417b-961c-48c55fa64140",
                                                "sense_id": "63a6cab9-b07b-3d5f-871f-83b125821b08",
                                                "text": "Lui, le père Henrouille, il avait été petit clerc chez un notaire au boulevard Sébastopol pendant cinquante ans. Aussi, en connaissait-il des histoires de dilapidations de fortunes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9c4387b-73e5-4b3b-8c08-c704e05d621f",
                        "source_entry_id": "8bf1b9f4-795e-3cea-99b1-59e8d676d192",
                        "source_sense_id": "1746ed0c-1a9a-3a9a-a2b8-f5279976962b",
                        "target_lang_word": "gaspillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaspillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e40b5bd-eb3c-3c96-b4ae-bb56f44ee5ef",
                                        "entry_id": "ec875557-a4d7-3f0c-9895-b511dc3a463b",
                                        "glosses": [
                                            "Action de gaspiller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b765fd6-ac1a-4f31-b5b9-c6e2767eddff",
                                                "sense_id": "7e40b5bd-eb3c-3c96-b4ae-bb56f44ee5ef",
                                                "text": "\"Moi au début, si je me suis tournée vers FeedBack, c'était pour éviter le gaspillage alimentaire et parce qu'ils redonnaient à la communauté, mais aujourd'hui, je pense qu'il y a beaucoup de gens qui le font par nécessité financière\", affirme-t-elle."
                                            },
                                            {
                                                "example_id": "2642edd0-f5b3-408d-87d6-07ab0c344a9a",
                                                "sense_id": "7e40b5bd-eb3c-3c96-b4ae-bb56f44ee5ef",
                                                "text": "Tout est au gaspillage dans cette maison."
                                            },
                                            {
                                                "example_id": "7da131de-f6f5-43c6-80b5-6442255182db",
                                                "sense_id": "7e40b5bd-eb3c-3c96-b4ae-bb56f44ee5ef",
                                                "text": "Il y a du gaspillage dans cette administration."
                                            },
                                            {
                                                "example_id": "07f330dd-a23e-4144-9373-3fab5aa4b05a",
                                                "sense_id": "7e40b5bd-eb3c-3c96-b4ae-bb56f44ee5ef",
                                                "text": "Comme ça, il n’y a pas de gaspillage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
