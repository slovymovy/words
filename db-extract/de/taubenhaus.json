                ],
                "senses": [
                    {
                        "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                        "entry_id": "84dd07c4-8c2c-375d-b1ec-4e2f02dadbb0",
                        "glosses": [
                            "Verschlag zur Haltung von Haustauben in Form eines Häuschens, das auf einer Säule steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b1ab8a-e065-4245-ad00-110bbb9578ca",
                                "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                                "text": "„Weshalb setzen wir ein Taubenhaus auf eine himmelhohe Stange? – Um die jeder Verteidigung fast unfähigen Insassen vor dem Marder zu schützen. Er kommt aber doch hinein.“"
                            },
                            {
                                "example_id": "09e04637-6b1a-4848-a450-32736e376954",
                                "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                                "text": "„Das Dach ist voller Technik: Überall sind Lüftungen, Bauten für die Klimaanlage des Kaufhauses. Dazwischen steht unauffällig ein Taubenhaus, 15 Quadratmeter Fläche, etwa zwei Meter hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14fe32b5-9144-4391-8e05-ceebf8b4cf86",
                        "source_entry_id": "84dd07c4-8c2c-375d-b1ec-4e2f02dadbb0",
                        "source_sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                        "source_sense_description": "Verschlag zur Haltung von Haustauben in Form eines Häuschens, das auf einer Säule steht",
                        "target_lang_word": "dovecote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dovecote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                        "entry_id": "fe9e8bc8-15a4-380f-84ff-7f5293126354",
                                        "glosses": [
                                            "A small house or box, often raised to a considerable height above the ground, and having compartments (pigeonholes), in which domestic pigeons breed; a dove house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38c7b1e-dcb6-4641-a84a-8c5b794d5438",
                                                "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                                "text": "If you haue writ your Annales true, 'tis there, / That like an Eagle in a Doue-cote, I / Flutter'd your Volcians in Corioles."
                                            },
                                            {
                                                "example_id": "f961b99d-6304-472c-a1c7-28ca94773621",
                                                "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                                "text": "she could see the malt-house with its dovecote"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de14b183-4683-34cb-a204-c18ad8e58b12",
                                        "entry_id": "fe9e8bc8-15a4-380f-84ff-7f5293126354",
                                        "glosses": [
                                            "In medieval Europe, a round or square structure of stone or wood, free-standing or built into a tower, in which pigeons were kept."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
