                        "entry_id": "d69e8886-6084-3b78-a934-850feb27aa82",
                        "glosses": [
                            "A long, white robe worn by priests and other ministers, underneath most of the other vestments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be5becfd-f6d3-4b3d-8366-4ae12d52f5cd",
                                "sense_id": "5a9ac37d-c421-3404-af26-57b5dc57ceb6",
                                "text": "‘The confidence of the very rich,’ thought Father Carter watching Binkie shaking out albs and cottas and calling rather loudly to the organist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adf5f162-3d73-4763-91e2-6f30d844613a",
