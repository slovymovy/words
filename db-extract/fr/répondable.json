                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d2fcb1b-b187-3716-a038-7a39e61ab862",
                                        "entry_id": "7b55e7b2-9248-343e-89e3-e28fbc531ea4",
                                        "glosses": [
                                            "Required to justify one's actions (to somebody); accountable, responsible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8393139-3b7f-4efa-a9e3-488498534591",
                                                "sense_id": "0d2fcb1b-b187-3716-a038-7a39e61ab862",
                                                "text": "1731, Jonathan Swift, “The Sentiments of a Church-of-England Man, with respect to Religion and Government” in Miscellanies, London: Benjamin Motte and Charles Bathurst, Volume I, Section 2, p. 91,\nShould any Man argue, that […] he cannot be justly punished, but is answerable only to God […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c620a0a-7366-3cba-a0e2-a1d27764eb52",
                                        "entry_id": "7b55e7b2-9248-343e-89e3-e28fbc531ea4",
                                        "glosses": [
                                            "Able to be answered."
                                        ],
                                        "tags": [
                                            "of a question"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5bdf5b9-6f20-40b3-9ddc-256dbdd61c1d",
                                                "sense_id": "6c620a0a-7366-3cba-a0e2-a1d27764eb52",
                                                "text": "Is my question answerable on basis of the reading alone or does it go outside the information given in the story?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71282079-1804-357e-9d17-85c0aa09436a",
                                        "entry_id": "7b55e7b2-9248-343e-89e3-e28fbc531ea4",
                                        "glosses": [
                                            "Correspondent, in accordance; comparable (to)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7775f47e-baa7-4914-b577-c3c3464b7774",
                                                "sense_id": "71282079-1804-357e-9d17-85c0aa09436a",
                                                "text": "What wit and policie of man is answerable to their discreet and orderly course?"
                                            },
                                            {
                                                "example_id": "43ea20b7-4a90-4a08-add9-5afe5ff2b818",
                                                "sense_id": "71282079-1804-357e-9d17-85c0aa09436a",
                                                "text": "To this revelation he assented the sooner, as he confesses, because it was answerable to that of the Apostle to the Thessalonians, Prove all things, hold fast that which is good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "367c1da3-d547-3535-bec0-e77976dc08cd",
                                        "entry_id": "7b55e7b2-9248-343e-89e3-e28fbc531ea4",
                                        "glosses": [
                                            "Proportionate; commensurate in amount; suitable."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04e1f201-ba9a-4828-a48e-693890c0599f",
                                                "sense_id": "367c1da3-d547-3535-bec0-e77976dc08cd",
                                                "text": "[…] at my farm / I have a hundred milch-kine to the pail, / Six score fat oxen standing in my stalls, / And all things answerable to this portion."
                                            },
                                            {
                                                "example_id": "a65396cf-47d5-4695-919c-6e099a7f3090",
                                                "sense_id": "367c1da3-d547-3535-bec0-e77976dc08cd",
                                                "text": "By my other wife I had a daughter, so hard favoured, so foule and ill faced, that I thinke a grove full of golden trees; and the leaves of Rubies and Dyamonds, would not bee a dowrie aunswerable to her deformitie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41fec78f-89f2-30f9-b6c8-6706edc28e52",
                                        "entry_id": "7b55e7b2-9248-343e-89e3-e28fbc531ea4",
                                        "glosses": [
                                            "Of an argument: capable of being answered or refuted; admitting a satisfactory answer."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6c5091-91cd-4101-b637-c6e6f5f75d52",
                                                "sense_id": "41fec78f-89f2-30f9-b6c8-6706edc28e52",
                                                "text": "[T]he argument, though ſubtle, is yet anſwerable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
