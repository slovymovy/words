                                        "sense_id": "f799f056-ae0d-3dff-8b29-f73feb6f6558",
                                        "entry_id": "8e3e878d-cdad-3b8f-9045-aeb064262375",
                                        "glosses": [
                                            "eine organische Verbindung, die nur aus Kohlenstoff und Wasserstoff besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aecbbfa6-fadb-4d5c-8d1d-1d7f4d464545",
                                                "sense_id": "f799f056-ae0d-3dff-8b29-f73feb6f6558",
                                                "text": "Propan ist ein Kohlenwasserstoff."
                                            },
                                            {
                                                "example_id": "c9d20cb1-4b9e-4811-8d8d-13f71fa51111",
                                                "sense_id": "f799f056-ae0d-3dff-8b29-f73feb6f6558",
                                                "text": "„Bei den acyclischen oder aliphatischen Kohlenwasserstoffen sind die Kohlenstoffatome in geraden oder verzweigten Ketten miteinander verbunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
