                "senses": [
                    {
                        "sense_id": "130b0fec-5298-3e20-9a48-f520a13494ef",
                        "entry_id": "272f5613-11a9-3682-9372-7c6c4fb66c3b",
                        "glosses": [
                            "urządzenie instalowane na budynkach lub obok nich, aby chronić je przed bezpośrednim uderzeniem pioruna"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5673fbb6-72c5-45a8-879e-930ee4bc65d1",
                        "source_entry_id": "272f5613-11a9-3682-9372-7c6c4fb66c3b",
                        "source_sense_id": "130b0fec-5298-3e20-9a48-f520a13494ef",
                        "target_lang_word": "lightning rod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lightning rod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87376d3b-69cd-38f7-9d24-95a975806439",
                                        "entry_id": "d473b459-baac-3d0c-a803-312e6695bca1",
                                        "glosses": [
                                            "A metallic conductor that is attached to a high point of a building and leads to the ground to protect the building from damage by lightning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec86fdf-a5d0-4c78-8101-42df109bc3f4",
                                                "sense_id": "87376d3b-69cd-38f7-9d24-95a975806439",
                                                "text": "\"My special business is to travel the country for orders for lightning-rods. This is my specimen rod;\" tapping his staff; \"I have the best of references\"-fumbling in his pockets. \"In Criggan last month, I put up three-and-twenty rods on only five buildings.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31b58496-0e6b-3eae-9f9f-613781ef217c",
                                        "entry_id": "d473b459-baac-3d0c-a803-312e6695bca1",
                                        "glosses": [
                                            "A person or thing that is a target for negative reactions and distracts criticism from another target."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8909cca-efbd-44e4-b8d3-bfd28c6c98fb",
                                                "sense_id": "31b58496-0e6b-3eae-9f9f-613781ef217c",
                                                "text": "Another factor was that when the two governments changed Stormont’s rules in 2006 they left the dual premiership as the “lightning rod for other difficulties”, said [Brendan] O’Leary."
                                            },
                                            {
                                                "example_id": "11eeba3d-d1a6-4117-b0a3-292d42373e39",
                                                "sense_id": "31b58496-0e6b-3eae-9f9f-613781ef217c",
                                                "text": "Though hardly a novel claim nowadays[…] it made [Jean] Twenge a lightning rod in the research world, where some academics remain skeptical of the panic over smartphones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15de4ed9-b358-487c-85be-32680258d265",
                        "source_entry_id": "272f5613-11a9-3682-9372-7c6c4fb66c3b",
                        "source_sense_id": "130b0fec-5298-3e20-9a48-f520a13494ef",
                        "target_lang_word": "lightning conductor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lightning conductor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6d5af1b-9650-3f36-b712-a9dec164099f",
                                        "entry_id": "5ecf65ef-10c3-3359-a231-c8e247320461",
                                        "glosses": [
                                            "A metallic conductor that is attached to a high point of a building and leads to the ground and protects the building from damage by lightning."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1390cbf-a345-4b86-a47a-37e0d240e710",
                        "source_entry_id": "272f5613-11a9-3682-9372-7c6c4fb66c3b",
                        "source_sense_id": "130b0fec-5298-3e20-9a48-f520a13494ef",
                        "target_lang_word": "paratonnerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paratonnerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95b54eda-6b5a-337d-98c2-139842c54a9c",
                                        "entry_id": "6e899802-8400-30bf-a76c-aa632504a607",
                                        "glosses": [
                                            "Tige métallique ou système de tiges que l’on fait communiquer avec la terre humide ou avec l’eau, et qui est dressée sur un édifice pour le préserver des effets de la foudre, soit en neutralisant l’électricité des nuages, soit en attirant l’électricité de la foudre et en la conduisant dans le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8754e5bd-2ddc-4a51-9212-a5b6747fc2bb",
                                                "sense_id": "95b54eda-6b5a-337d-98c2-139842c54a9c",
                                                "text": "Le toit, chargé de ces ornements, surmonté encore de galeries de plomb découpées, de deux paratonnerres et de quatre énormes cheminées symétriques, sculptées comme le reste, semblait être le bouquet de ce feu d’artifice architectural."
                                            },
                                            {
                                                "example_id": "feb4c71b-ad76-4768-b1d4-3e8b9839ad69",
                                                "sense_id": "95b54eda-6b5a-337d-98c2-139842c54a9c",
                                                "text": "Je suis seule et j'ai peur, ouvrez-moi, par pitié,\nMon époux vient de partir faire son dur métier,\nPauvre malheureux mercenaire,\nContraint de coucher dehors quand il fait mauvais temps,\nPour la bonne raison qu'il est représentant\nD'une maison de paratonnerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5010a059-abcd-3704-83ce-a7a496bbac24",
                                        "entry_id": "6e899802-8400-30bf-a76c-aa632504a607",
                                        "glosses": [
                                            "Personne ou entité qui supporte tous les coups, de son plein gré ou non, dans le cadre d'un combat (elle est devenue la cible unique sur laquelle se concentrent les attaques)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4fda1c3-c9b3-41a6-a214-0be3d1abadde",
                                                "sense_id": "5010a059-abcd-3704-83ce-a7a496bbac24",
                                                "text": "Ce père, M. de Pontlevé, passait sa vie à avoir peur d’un nouveau 93 et à songer à la fortune de sa fille, qui était son paratonnerre contre ce malheur trop certain."
                                            },
                                            {
                                                "example_id": "44ca004a-b40e-4e71-bd5a-ebb4e9e5b884",
                                                "sense_id": "5010a059-abcd-3704-83ce-a7a496bbac24",
                                                "text": "La Corée et le Vietnam sont rapidement devenus les paratonnerres de la guerre froide entre les États-Unis et l'URSS."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "231e6522-ec06-41a9-ba5c-fb70517cbbb4",
                        "source_entry_id": "272f5613-11a9-3682-9372-7c6c4fb66c3b",
                        "source_sense_id": "130b0fec-5298-3e20-9a48-f520a13494ef",
                        "target_lang_word": "pararrayos",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pararrayos",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "253748b1-98c1-31c4-8d0f-5426891142cb",
                                        "entry_id": "222061ae-5516-3fed-82a0-99cb2c854671",
                                        "glosses": [
                                            "Instrumento cuyo objetivo es conducir la descarga eléctrica de un rayo hacia tierra, de modo tal que no cause daños a construcciones o personas. Este artilugio fue inventado en 1753 por Benjamín Franklin mientras efectuaba una serie de experimentos sobre la propiedad que tienen las puntas agudas conductoras de la electricidad, puestas en contacto con la tierra, de descargar los cuerpos electrizados situados en su proximidad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cf5e312-0522-47a4-8482-616be2ad4072",
                        "source_entry_id": "272f5613-11a9-3682-9372-7c6c4fb66c3b",
                        "source_sense_id": "130b0fec-5298-3e20-9a48-f520a13494ef",
                        "target_lang_word": "Blitzableiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blitzableiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89119257-334e-3bcb-bfe7-56eb58d943f1",
                                        "entry_id": "46a394ed-e085-3508-9d9e-e1b05e89217b",
                                        "glosses": [
                                            "technische Schutzeinrichtung an Gebäuden, die äußerlich einen Blitzeinschlag ins Erdreich ableitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c635c380-9d24-4ac0-86d1-c7c92f94eca7",
                                                "sense_id": "89119257-334e-3bcb-bfe7-56eb58d943f1",
                                                "text": "Benjamin Franklin leitete im Juni 1752 während eines Gewitters mittels eines Drachen, an den er Schlüssel gebunden hatte, einen Blitz zur Erde ab und entdeckte so das Prinzip des Blitzableiters."
                                            },
                                            {
                                                "example_id": "d5feff74-13a4-4fa5-9198-e19da3ebbac4",
                                                "sense_id": "89119257-334e-3bcb-bfe7-56eb58d943f1",
                                                "text": "„Diese Brücke ist sehr primitiv. Jenseits derselben aber steigt das Herrenhaus auf, ein gelbgetünchter Bau mit hohem Dach und zwei Blitzableitern.“"
                                            },
                                            {
                                                "example_id": "11c78e05-5abc-4a4f-b278-04313bf87e40",
                                                "sense_id": "89119257-334e-3bcb-bfe7-56eb58d943f1",
                                                "text": "„Vielleicht sind diese Gespräche der Grund, weshalb sich in Franken die Blitzableiter am spätesten durchsetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1c00276-4d7c-43e7-b9f2-f009f3f3d551",
                        "source_entry_id": "272f5613-11a9-3682-9372-7c6c4fb66c3b",
