                        ],
                        "examples": [
                            {
                                "example_id": "d1b894c6-6b36-440f-8724-2486c775ad37",
                                "sense_id": "d5f49aff-d770-335a-b85c-e2678dd33ff1",
                                "text": "Was hast du denn da all für Plünnen in deinem Schuppen? Fahrräder, alte Ofenrohre, Fenster, Milchkannen…"
                            },
                            {
                                "example_id": "1445fe83-6595-43ce-b912-7b7329b16c12",
                                "sense_id": "d5f49aff-d770-335a-b85c-e2678dd33ff1",
                                "text": "Waldemar hat heute von den Plünnen, die er in seinem Garten gelagert hatte, allerlei zum Schrottplatz gebracht."
                            },
                            {
                                "example_id": "12d8558f-3eb0-4beb-8445-27bb718ad566",
                                "sense_id": "d5f49aff-d770-335a-b85c-e2678dd33ff1",
                                "text": "Räum mal die Bücher und diese ganzen Plünnen da vom Sofa weg."
                            }
                        ],
                        "sense_index_json": "\"2\""
