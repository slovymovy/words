                    {
                        "sense_id": "c4f55663-b832-30b9-ae09-bbb273a415ed",
                        "entry_id": "f21c5f94-61fc-350b-a131-ec1c3743a839",
                        "glosses": [
                            "передаёт звук собачьего лая"
