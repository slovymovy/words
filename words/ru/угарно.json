            "senses": [
                {
                    "sense_id": "523cee68-08b7-3a19-832a-efd245e12da6",
                    "sense_definition": "Очень смешно, забавно, вызывающе веселье.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы вчера так <w>угарно</w> посидели в кафе, что до сих пор смеёмся.",
                            "target_lang_translations": {
                                "en": "We had such a <w>hilarious</w> time at the cafe yesterday that we are still laughing."
                            }
                        },
                        {
                            "text": "Этот фильм был настолько <w>угарно</w> снят, что зал постоянно хохотал.",
                            "target_lang_translations": {
                                "en": "This film was shot so <w>hilariously</w> that the audience was constantly roaring with laughter."
                            }
                        }
                    ],
                    "synonyms": [
                        "смешно",
                        "забавно",
                        "весело"
                    ],
                    "antonyms": [
                        "скучно",
                        "грустно"
                    ],
                    "common_phrases": [
                        "было угарно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Используется в разговорной речи."
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Молодежный сленг."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Very funny, amusing, or causing laughter; used in informal or slang contexts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hilariously",
                                "target_lang_sense_clarification": "In a way that is extremely funny."
                            },
                            {
                                "target_lang_word": "funnily",
                                "target_lang_sense_clarification": "In a humorous or amusing manner."
                            }
                        ]
                    }
                }
            ]
        },
        {
