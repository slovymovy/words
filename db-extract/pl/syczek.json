                        "source_sense_id": "ded795d6-c2ba-3931-bbe8-5deb309163ba",
                        "target_lang_word": "сплюшка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сплюшка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a1cfb413-2f11-32b1-9763-9e682c38d61e",
                                        "entry_id": "b520841b-c188-345b-8838-740350cf8593",
                                        "glosses": [
                                            "орнитол. небольшая птица семейства совиные, рыжеватой, серой или бурой окраски; совка (Otus scops)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef54b06-7b5a-4b8b-b3ae-8d24ce2b3935",
                                                "sense_id": "a1cfb413-2f11-32b1-9763-9e682c38d61e",
                                                "text": "В саду где-то начала летать маленькая сплюшка и плакала."
                                            },
                                            {
                                                "example_id": "9727ae3d-182d-4d7c-8329-5cc5cd3ca3e0",
                                                "sense_id": "a1cfb413-2f11-32b1-9763-9e682c38d61e",
                                                "text": "Сплюшка ― небольшой сыч; водится в южных районах Советского Союза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57fd2847-5486-3f2d-9769-8ef393ff2a8c",
                                        "entry_id": "b520841b-c188-345b-8838-740350cf8593",
                                        "glosses": [
                                            "м. и ж., разг., детск. или шутл. любитель поспать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5c219d-2aef-49c5-9348-89858da8993c",
                                                "sense_id": "57fd2847-5486-3f2d-9769-8ef393ff2a8c",
                                                "text": "У нас дождь, а это значит, что я — сплюшка. Снова проснулась около 5 утра, уснула перед будильником и никак не могу раскачаться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
