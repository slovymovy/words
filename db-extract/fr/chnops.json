                ],
                "senses": [
                    {
                        "sense_id": "36f5d7ad-80e3-33fb-8c33-b6bae8c6f371",
                        "entry_id": "75ddfa92-5620-3cd2-b9d6-54c2554ddb87",
                        "glosses": [
                            "Variante de CHONSP."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6235d5bb-3b1d-4113-ab65-944a8fdb5785",
                                "sense_id": "36f5d7ad-80e3-33fb-8c33-b6bae8c6f371",
                                "text": "La liste des éléments chimiques les plus abondants de la biosphère peut se résumer symboliquement par la formule CHNOPS (carbone, hydrogène, azote, oxygène, phosphore et soufre)."
                            },
                            {
                                "example_id": "296104c4-08fc-4f8f-b86d-f370f245ddeb",
                                "sense_id": "36f5d7ad-80e3-33fb-8c33-b6bae8c6f371",
                                "text": "Les astronomes du Sloan Digital Sky Survey (SDSS), un programme de relevé des objets célestes lancé en 2000, ont utilisé le spectrographe APOGEE du télescope de 2,5 mètres installé au Nouveau-Mexique pour mesurer la distribution des CHNOPS sur près de 165,000 étoiles réparties au sein de la Voie Lactée."
                            },
                            {
                                "example_id": "d81c6fc7-3c36-43c6-8899-1a9a0aeb1de8",
                                "sense_id": "36f5d7ad-80e3-33fb-8c33-b6bae8c6f371",
                                "text": "Ces 6 atomes, qu’on appelle la bande des CHNOPS (carbone, hydrogène, azote, oxygène, phosphore et soufre), font l’unanimité parmi tout ce qui vit et sont présents pratiquement partout."
                            },
                            {
                                "example_id": "bff1bc25-ff92-4a0f-9061-0c2d6ec45883",
                                "sense_id": "36f5d7ad-80e3-33fb-8c33-b6bae8c6f371",
                                "text": "Outre les composants biochimiques de base nécessaires à la vie (désignés par CHNOPS d’après leur symbole chimique), d’autres espèces, telles que le sodium, le magnésium, le calcium, le fer et le potassium, jouent un rôle important."
                            },
                            {
                                "example_id": "9355de45-1f71-4fb0-8569-19b5ff0db10f",
                                "sense_id": "36f5d7ad-80e3-33fb-8c33-b6bae8c6f371",
                                "text": "Déterminer si un corps céleste contient « CHNOPS » constitue une approche complémentaire à celle consistant à chercher s’il s’y trouve de l’eau liquide."
                            }
                        ]
                    }
                ],
