                    {
                        "translation_id": "d212b7dc-49c9-4c1e-900c-82f50759a476",
                        "source_entry_id": "b9bbef12-1783-3b64-afb5-bca548ec87bf",
                        "source_sense_id": "d8eab9f5-f1f5-3d51-9e23-8186f3ff3ce2",
                        "source_sense_description": "een eilandengroep",
                        "target_lang_word": "archipelago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archipelago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83e5af21-4115-342f-ae3d-4f01730251e6",
                                        "entry_id": "032663df-5b83-334a-a5c8-22a83ca9f293",
                                        "glosses": [
                                            "A group of islands."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30af9637-80e6-441c-8036-797be5355d82",
                                                "sense_id": "83e5af21-4115-342f-ae3d-4f01730251e6",
                                                "text": "For many years past the whaleship has been the pioneer in ferreting out the remotest and least known parts of the earth. She has explored seas and archipelagoes which had no chart, where no Cook or Vancouver had ever sailed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7df22d55-09ae-30b9-869c-e7651647e4a6",
                                        "entry_id": "032663df-5b83-334a-a5c8-22a83ca9f293",
                                        "glosses": [
                                            "The Aegean Sea."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef00c5a-a3ef-44ea-a164-1c45786beeb5",
                                                "sense_id": "7df22d55-09ae-30b9-869c-e7651647e4a6",
                                                "text": "[I]n his imagination he had settled his route, through Holland and France to Sicily, which he had long wished to see, and from thence to the Archipelago […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5356a01e-8002-3f54-b754-4538a2501ddb",
                                        "entry_id": "032663df-5b83-334a-a5c8-22a83ca9f293",
                                        "glosses": [
                                            "Something scattered around like an archipelago."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2404a32-aec9-4313-8702-bd756d99b8c3",
                                                "sense_id": "5356a01e-8002-3f54-b754-4538a2501ddb",
                                                "text": "The Gulag Archipelago"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "archipelago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7dc9547-c529-3777-962a-3dcbd574ad5b",
                                        "entry_id": "81ec296b-ffed-3449-9ddd-b3a139b98b0a",
                                        "glosses": [
                                            "To scatter or be scattered so as to resemble a group of islands."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3335cae3-8839-479d-a9f7-d44a434e9174",
                                                "sense_id": "d7dc9547-c529-3777-962a-3dcbd574ad5b",
                                                "text": "As the seas level, as the seas / Swept into ripples by the breeze, / And archipelagoed by trees, / Majestic spreading oaks, that rise / Like island walls against the skies."
                                            },
                                            {
                                                "example_id": "8471a839-25f6-464f-bb59-08b09f102568",
                                                "sense_id": "d7dc9547-c529-3777-962a-3dcbd574ad5b",
                                                "text": "There is no debating that there is a Gardener whose gardens are spontaneous as a sunup, no crimson and purple clouds archipelagoing the morning skies."
                                            },
                                            {
                                                "example_id": "66f37d10-f3c9-47c4-8a8a-7603cd7a62e2",
                                                "sense_id": "d7dc9547-c529-3777-962a-3dcbd574ad5b",
                                                "text": "Crevasse! The word which describes the frightful chasm into which nature's mighty stresses break glaciers, the people of the Lower Mississippi applied to the river when its destruction burst upon the land. It meant a rush of water which might be fifteen feet high and a hundred feet wide the first hour, four hundred the next, and half a mile the next day; and which hurled itself upon towns and plantations, to gouge vast cavities and carry destruction fifty miles a day; the current sweeping away everything in its immediate path, but losing its violence farther away in the placidity of a vast sea archipelagoed by tree tops and house roofs and beaconed by factory chimneys."
                                            },
                                            {
                                                "example_id": "bd1cae63-1f97-45a7-89bf-8a9e536c0bed",
                                                "sense_id": "d7dc9547-c529-3777-962a-3dcbd574ad5b",
                                                "text": "For a long time he had kept a pet crow called Topsy; it ate gobbets of cheese from his hand and archipelagoed the floor of his hut with droppings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23567c5c-5ffd-46e8-ac37-0e79e963d2ae",
                        "source_entry_id": "b9bbef12-1783-3b64-afb5-bca548ec87bf",
                        "source_sense_id": "d8eab9f5-f1f5-3d51-9e23-8186f3ff3ce2",
