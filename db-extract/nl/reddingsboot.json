                                    {
                                        "sense_id": "953d273a-d38b-3d43-84f1-fd0852ae2195",
                                        "entry_id": "df05981f-e05e-31d5-9a24-2e6b96507122",
                                        "glosses": [
                                            "kleines Beiboot eines Schiffes, zur Rettung der an Bord befindlichen Personen im Falle einer Havarie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1f3e34-b4ed-48c4-8877-54804f88ce58",
                                                "sense_id": "953d273a-d38b-3d43-84f1-fd0852ae2195",
                                                "text": "Alle Mann in die Rettungsboote!"
                                            },
                                            {
                                                "example_id": "d4b63b73-604e-4545-8d3c-21fe8000876d",
                                                "sense_id": "953d273a-d38b-3d43-84f1-fd0852ae2195",
                                                "text": "„Im Rettungsboot gondelte Luckner daraufhin 2300 Seemeilen durch die Südsee, bis er in neuseeländische Kriegsgefangenschaft geriet.“"
                                            },
                                            {
                                                "example_id": "8ff6a9ee-5015-4ab4-9726-b277f6a07de5",
                                                "sense_id": "953d273a-d38b-3d43-84f1-fd0852ae2195",
                                                "text": "„Am nächsten Morgen hielt das Rettungsboot mit der Mutter erneut auf die Küste zu.“"
                                            },
                                            {
                                                "example_id": "bcfd0473-cadf-4383-9d4f-a4150ebf4695",
                                                "sense_id": "953d273a-d38b-3d43-84f1-fd0852ae2195",
                                                "text": "„Und dann hat Mutter mit ihrem Blick, der nichts ausläßt, gesehen, daß die Davits, Blöcke und Halterungen der backbord und steuerbord festgezurrten Rettungsboote und deren über Rollen geführtes Tauwerk vereist waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
