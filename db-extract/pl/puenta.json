                        "sense_id": "29a5d56c-c8d0-3940-b01a-de68d667905b",
                        "entry_id": "17147dee-25bb-3d43-a86b-c3489d303b7c",
                        "glosses": [
                            "myśl kończąca czyjąś wypowiedź lub utwór literacki"
                        ],
                        "tags": [],
                        "examples": [
                            {
