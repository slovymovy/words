{
    "word_family": [
        "threat",
        "threateningly",
        "threatener"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64bb4f5b-c099-36b9-af0d-53a545d29d30",
                    "sense_definition": "To state one's intention to take hostile action against someone in retribution for something done or not done.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hostile_intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>threatened</w> me with a knife during the argument.",
                            "target_lang_translations": {
                                "ru": "Во время спора он <w>угрожал</w> мне ножом."
                            }
                        },
                        {
                            "text": "The manager <w>threatened</w> dismissal if the employees did not follow the new safety protocols.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>пригрозил</w> увольнением, если сотрудники не будут соблюдать новые протоколы безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidate",
                        "menace",
                        "browbeat"
                    ],
                    "antonyms": [
                        "promise"
                    ],
                    "common_phrases": [
                        "threatened dismissal",
                        "threaten with violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать намерение совершить враждебные действия в отношении кого-либо в качестве наказания за что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "обещать причинить вред"
                            },
                            {
                                "target_lang_word": "грозить",
                                "target_lang_sense_clarification": "выражать враждебные намерения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18716a12-c771-30fb-ae5b-be9fb8bf589e",
                    "sense_definition": "To be a source of danger to something or to put something at risk.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp rocks <w>threatened</w> the ship's survival as it drifted toward the shore.",
                            "target_lang_translations": {
                                "ru": "Острые скалы <w>угрожали</w> самому существованию корабля, когда его несло к берегу."
                            }
                        },
                        {
                            "text": "Pollution <w>threatens</w> the survival of many rare species in this river.",
                            "target_lang_translations": {
                                "ru": "Загрязнение <w>ставит под угрозу</w> выживание многих редких видов в этой реке."
                            }
                        }
                    ],
                    "synonyms": [
                        "endanger",
                        "imperil",
                        "jeopardize"
                    ],
                    "common_phrases": [
                        "threaten the survival",
                        "threaten the environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть источником опасности для чего-либо или подвергать что-либо риску."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "создавать риск или опасность"
                            },
                            {
                                "target_lang_word": "ставить под угрозу",
                                "target_lang_sense_clarification": "подвергать опасности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3de39aa1-d18e-3ccd-bdbe-863157193ae9",
                    "sense_definition": "To give a warning sign of something unpleasant or unwanted that is likely to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "portend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds <w>threatened</w> heavy rain, so we decided to stay indoors.",
                            "target_lang_translations": {
                                "ru": "Темные тучи <w>предвещали</w> сильный дождь, поэтому мы решили остаться дома."
                            }
                        },
                        {
                            "text": "Economic indicators <w>threatened</w> a recession by the end of the fiscal year.",
                            "target_lang_translations": {
                                "ru": "Экономические показатели <w>сулили</w> рецессию к концу финансового года."
                            }
                        }
                    ],
                    "synonyms": [
                        "portend",
                        "foreshadow",
                        "augur"
                    ],
                    "common_phrases": [
                        "threaten heavy rain",
                        "threaten a storm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить предупреждающим знаком чего-то неприятного или нежелательного, что может произойти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвещать",
                                "target_lang_sense_clarification": "быть признаком скорого наступления чего-либо"
                            },
                            {
                                "target_lang_word": "грозить",
                                "target_lang_sense_clarification": "о вероятности наступления беды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce4e940-e175-3a38-b1cc-113b751c90a2",
                    "sense_definition": "To challenge or call into question the validity of a belief, idea, or established system.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "challenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new scientific evidence <w>threatened</w> our original hypothesis about the planet's formation.",
                            "target_lang_translations": {
                                "ru": "Новые научные данные <w>поставили под сомнение</w> нашу первоначальную гипотезу о формировании планеты."
                            }
                        },
                        {
                            "text": "Radical new ideas often <w>threaten</w> the status quo of traditional institutions.",
                            "target_lang_translations": {
                                "ru": "Радикальные новые идеи часто <w>угрожают</w> статусу-кво традиционных институтов."
                            }
                        }
                    ],
                    "synonyms": [
                        "challenge",
                        "undermine",
                        "question"
                    ],
                    "common_phrases": [
                        "threaten the status-quo",
                        "threaten a hypothesis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оспаривать или ставить под сомнение обоснованность убеждения, идеи или устоявшейся системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "подрывать основы или статус-кво"
                            },
                            {
                                "target_lang_word": "ставить под сомнение",
                                "target_lang_sense_clarification": "оспаривать правильность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d34c4fc6-0691-3bcc-a334-a01e27978100",
                    "sense_definition": "To be close to equaling or surpassing a specific record or achievement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surpassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete <w>threatened</w> the world record during the qualifying rounds.",
                            "target_lang_translations": {
                                "ru": "Молодой атлет <w>покусился</w> на мировой рекорд во время отборочных туров."
                            }
                        },
                        {
                            "text": "Sales figures this month <w>threatened</w> the all-time high set last summer.",
                            "target_lang_translations": {
                                "ru": "Показатели продаж в этом месяце <w>приблизились</w> к рекордному уровню, установленному прошлым летом."
                            }
                        }
                    ],
                    "synonyms": [
                        "approach",
                        "rival"
                    ],
                    "common_phrases": [
                        "threaten the record",
                        "threaten the all-time high"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть близким к тому, чтобы сравняться с определенным рекордом или достижением или превзойти его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покушаться",
                                "target_lang_sense_clarification": "пытаться побить рекорд"
                            },
                            {
                                "target_lang_word": "приближаться",
                                "target_lang_sense_clarification": "быть близким к достижению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}