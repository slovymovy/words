                ],
                "senses": [
                    {
                        "sense_id": "bca6081c-f430-3c57-b7f4-7fe0f262e500",
                        "entry_id": "3ea69da7-226e-320b-ad99-e2895e70ea49",
                        "glosses": [
                            "ein vom Landtag (Parlament) eines (Bundes-)Landes verabschiedetes Gesetz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a77d538e-d7d5-454e-ace7-efeae2d17f6a",
                                "sense_id": "bca6081c-f430-3c57-b7f4-7fe0f262e500",
                                "text": "Ein Landesgesetz ist eine von der Landesgesetzgebung verabschiedetes Gesetz für eines der Länder in Österreich."
                            },
                            {
                                "example_id": "977b51e0-2e33-45b8-bd94-cd6c1c2788c7",
                                "sense_id": "bca6081c-f430-3c57-b7f4-7fe0f262e500",
                                "text": "„Landesgesetze, Verordnungen und Kundmachungen des Landes Oberösterreich können hier abgerufen werden.“"
                            },
                            {
                                "example_id": "75a86604-3076-44d1-9c19-c5a4759b215c",
                                "sense_id": "bca6081c-f430-3c57-b7f4-7fe0f262e500",
                                "text": "„Die Geschäftsführung des Landtages erfolgt auf Grund eines besonderen Landesgesetzes (Geschäftsordnung des Landtages). Dieses Gesetz kann vom Landtag nur mit einer Mehrheit von zwei Dritteln der abgegebenen Stimmen beschlossen oder geändert werden.“"
                            },
                            {
                                "example_id": "8a7e9047-6fdd-4f41-a411-942ab568aa80",
                                "sense_id": "bca6081c-f430-3c57-b7f4-7fe0f262e500",
                                "text": "„Wie das Gericht am Donnerstagabend mitteilte, entspricht das Landesgesetz den jüngsten Vorgaben des Bundesverfassungsgerichts und ist eine ausreichende Rechtsgrundlage, das Unterrichten mit Kopftuch zu untersagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
