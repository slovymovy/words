                        "form": "*"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d1acf4d-de65-37a0-b8eb-02d93eaa869a",
                        "entry_id": "23dc7560-d686-3124-bbc9-01abb23d9176",
                        "glosses": [
                            "трансп. предназначенный для передвижения с высокой скоростью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ead96b5-53b5-45e5-852e-20f1e64f82db",
                                "sense_id": "2d1acf4d-de65-37a0-b8eb-02d93eaa869a",
                                "text": "Таково ближайшее будущее реактивных двигателей больших высокоскоростных самолётов."
                            },
                            {
                                "example_id": "c261886b-c5d1-4cf8-a562-7c4ee0a1d6aa",
                                "sense_id": "2d1acf4d-de65-37a0-b8eb-02d93eaa869a",
                                "text": "Турбопоездам удалось то, чего нельзя даже ожидать от привычных для нас поездов и локомотивов, ― они и высокоскоростные, и экономичные."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a8acc5b-96e8-3abb-811b-aafdcf5f57d2",
                        "entry_id": "23dc7560-d686-3124-bbc9-01abb23d9176",
                        "glosses": [
                            "спец. двигающийся с высокой скоростью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9511b58-c3f3-419e-a82c-bef39e7c709b",
                                "sense_id": "5a8acc5b-96e8-3abb-811b-aafdcf5f57d2",
                                "text": "Высокоскоростная струя такой плазмы, образованная мощным электрическим разрядом через литиевую проволоку, прорывала диафрагму и устремлялась в разгонную трубу."
                            },
                            {
                                "example_id": "e3383a04-98e5-4ab8-968b-c9cc8f777a4b",
                                "sense_id": "5a8acc5b-96e8-3abb-811b-aafdcf5f57d2",
                                "text": "При меньшей, чем у зарубежных собратьев того же класса, массе танк Т-80 имеет мощное бронирование, защищающее от высокоскоростных бронебойно-подкалиберных снарядов, стабилизированных оперением, а также кумулятивных снарядов и противотанковых ракет."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7efadb2-9c51-3258-972c-7f410c6fc83f",
                        "entry_id": "23dc7560-d686-3124-bbc9-01abb23d9176",
                        "glosses": [
                            "спец. характеризующийся высокой скоростью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98fd5d25-29c2-4195-b7a8-cf0e7b2c53ca",
                                "sense_id": "b7efadb2-9c51-3258-972c-7f410c6fc83f",
                                "text": "Гораздо важнее то, что разработан и проверен на растениях разных видов и семейств эффективный и высокоскоростной способ селекции, способ получения новых сортов, который без особого труда может быть введён в широкий научный и практический обиход."
                            },
                            {
                                "example_id": "b84a48a8-4eca-467e-891b-32c931b37d84",
                                "sense_id": "b7efadb2-9c51-3258-972c-7f410c6fc83f",
                                "text": "До сих пор при съёмке полёта птиц даже высокоскоростной камерой чрезвычайно трудно проследить совершенство полёта с точки зрения законов аэродинамики."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2139ee2-3a8c-4629-b6c3-237526c683b9",
                        "source_entry_id": "23dc7560-d686-3124-bbc9-01abb23d9176",
                        "target_lang_word": "high-speed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "high-speed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "324a8210-3894-3c01-867f-2145e53f798d",
                                        "entry_id": "8141e428-f0db-3a7a-8877-c3290083ec05",
                                        "glosses": [
                                            "That operates, moves or takes place at a greater than normal speed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796bf7d7-5a75-4028-b2ea-79f82ffd16d6",
                                                "sense_id": "324a8210-3894-3c01-867f-2145e53f798d",
                                                "text": "Dead-man's handle, automatic train stop, quick-acting compressed-air brake specially suited for high-speed working, and regenerative braking are among the features of the new locomotives."
                                            },
                                            {
                                                "example_id": "9aee9eca-b323-4abe-940a-1c4d08440a60",
                                                "sense_id": "324a8210-3894-3c01-867f-2145e53f798d",
                                                "text": "Less important lines of plain double track carrying a mixture of passenger and freight traffic cannot be given ultra-fast expresses, and where alternative routes exist, as for example between London and the West Riding, the specially high-speed trains must be restricted to one of them only."
                                            },
                                            {
                                                "example_id": "5e093d40-4e6b-4a18-ab28-960e1fda307b",
                                                "sense_id": "324a8210-3894-3c01-867f-2145e53f798d",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails.[…]This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "501bd0a1-61c0-462a-9f5c-5602225e40a3",
                                                "sense_id": "324a8210-3894-3c01-867f-2145e53f798d",
                                                "text": "In retrospect, it was small wonder that Railtrack found its finances under pressure, as with ever increasing demand there was an inevitable effect on infrastructure renewals. Matters came to a head with the Hatfield accident on October 17 2000, when there was a high-speed derailment as a result of deferred track maintenance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a3a721f-df65-46dd-b77c-cacf168cb389",
                        "source_entry_id": "23dc7560-d686-3124-bbc9-01abb23d9176",
                        "target_lang_word": "ad alta velocità",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "939e3b7a-0915-4135-bc48-ca4db200ff1b",
                        "source_entry_id": "23dc7560-d686-3124-bbc9-01abb23d9176",
                        "target_lang_word": "hochdrehzahlig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "68d97dc2-3ff5-4f15-9c85-9c1989bda425",
                        "source_entry_id": "23dc7560-d686-3124-bbc9-01abb23d9176",
                        "target_lang_word": "ultra-rapide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultra-rapide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4011e18-cb4d-3c8d-b245-61997b52db33",
                                        "entry_id": "ab2b27ef-2b37-3cd6-b6ce-99c4151a781c",
                                        "glosses": [
                                            "Extrêmement rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3593068-bf2a-4c69-8660-8eb670e76636",
                                                "sense_id": "a4011e18-cb4d-3c8d-b245-61997b52db33",
                                                "text": "Dans un avis rendu le 16 juin, il a mis les points sur les « i » : les réacteurs fragilisés doivent soit être mis à l’arrêt, soit faire l’objet d’une remise en état ultra-rapide…"
                                            },
                                            {
                                                "example_id": "ef1e1a95-c446-4a9e-b30d-adfd93a24435",
                                                "sense_id": "a4011e18-cb4d-3c8d-b245-61997b52db33",
                                                "text": "Quelques vedettes ultra-rapides, à moteur silencieux, pourvues d’un dispositif de lance-torpilles, devaient, en cas de débarquement, attaquer de nuit les vaisseaux de guerre au mouillage, non loin de là, et les faire sauter sans grande peine, puisque les Alliés ne pouvaient pas connaître l’existence de cette cale de départ, adroitement camouflée."
                                            },
                                            {
                                                "example_id": "38a9f68f-e461-49af-9c21-94a5f45adef6",
                                                "sense_id": "a4011e18-cb4d-3c8d-b245-61997b52db33",
                                                "text": "Les observations en cinématographie ultra-rapide confirment que l’angle du plan de cisaillement avec la direction de déplacement de l’outil est, pour ces valeurs d’angle d’attaque, très voisin de 60° (fig. 7b)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
