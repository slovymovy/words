                        "sense_id": "e75c7292-ed39-3a32-acce-e46e39b64251",
                        "entry_id": "d6386373-9042-38dc-a768-4b91fe149c08",
                        "glosses": [
                            "εναλλακτικά, ισότιμα, με τρόπο που μπορεί να εναλλάσσεται, ειδικά χωρίς να επηρεάζεται ο τρόπος με τον οποίο λειτουργεί κάτι"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed1f558-af2d-42a8-86ff-dc07b6731801",
                                "sense_id": "e75c7292-ed39-3a32-acce-e46e39b64251",
                                "text": "These terms are used interchangeably in the text.",
                                "translation": "Αυτοί οι όροι χρησιμοποιούνται εναλλακτικά στο κείμενο."
                            },
                            {
                                "example_id": "e35ddb43-d474-4721-8609-b92cd701161e",
                                "sense_id": "e75c7292-ed39-3a32-acce-e46e39b64251",
                                "text": "The words “big” and “large” are often used interchangeably in English.",
                                "translation": "Οι λέξεις “big” και “large” χρησιμοποιούνται συχνά εναλλακτικά στα Αγγλικά."
                            },
                            {
                                "example_id": "f6977b99-202f-4864-ae5f-9a5c78dd6ce1",
                                "sense_id": "e75c7292-ed39-3a32-acce-e46e39b64251",
                                "text": "The two ingredients can be used interchangeably in the recipe.",
                                "translation": "Τα δύο συστατικά μπορούν να χρησιμοποιηθούν εναλλακτικά στη συνταγή."
                            },
                            {
                                "example_id": "b11a6099-cc60-4528-b9b9-d7b2bb54a34e",
                                "sense_id": "e75c7292-ed39-3a32-acce-e46e39b64251",
                                "text": "Many times speakers use the two terms interchangeably.",
                                "translation": "Πολλές φορές οι ομιλητές χρησιμοποιούν τους δύο όρους ισότιμα."
                            },
                            {
                                "example_id": "56e709e0-2f37-4a92-899c-afb6cc575db0",
                                "sense_id": "e75c7292-ed39-3a32-acce-e46e39b64251",
                                "text": "True synonyms can be used interchangeably.",
                                "translation": "Τα αληθινά συνώνυμα εναλλάσονται."
                            }
                        ]
                    }
