                                        "entry_id": "50adc2c1-dc91-337d-ba6d-c15a97b1399e",
                                        "glosses": [
                                            "To go to one or more public houses."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c76bc42-0817-3215-a750-08b20cbf09fb",
                                        "entry_id": "a8dab4e6-d8c8-3e22-aa44-bc782d89f16d",
                                        "glosses": [
                                            "A public server."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0430ceb9-40b1-4b0c-8324-91f7db8850b3",
                                                "sense_id": "4c76bc42-0817-3215-a750-08b20cbf09fb",
                                                "text": "Well there's private servers and then there's pubs that do their best to make sure everyone plays fair. The second option will be a lot easier to find."
                                            }
                                        ]
