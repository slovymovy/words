                        "glosses": [
                            "Twilight, when poultry would be shut in for the night."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c4dba2e-8c22-4a6b-8021-654bcfb71ce0",
                                "sense_id": "bfc63d61-caed-3cf3-9aa6-8c650477fb5c",
                                "text": "Sir Richard Ratcliff: Thomas the Earl of Surrey, and himself,\nMuch about cock-shut time, from troop to troop\nWent through the army, cheering up the soldiers."
                            },
                            {
                                "example_id": "c9d70092-8b0b-4019-b840-f18d26225399",
                                "sense_id": "bfc63d61-caed-3cf3-9aa6-8c650477fb5c",
                                "text": "1 Fai.: Mistress, this is only spite:\nFor you would not yesternight\nKiss him in the cock-shut light."
                            },
                            {
                                "example_id": "13030432-4483-4367-b5a8-55ea063d3d31",
                                "sense_id": "bfc63d61-caed-3cf3-9aa6-8c650477fb5c",
                                "text": "In the quiet cockshut after a heavy darg, a boonfellow likes to croodle with her fanger (or he with his bellibone) as they watch the sunset through the eyethurl."
                            }
                        ]
                    }
