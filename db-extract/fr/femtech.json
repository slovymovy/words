                    }
                ],
                "senses": [
                    {
                        "sense_id": "63ed49f3-2a68-3234-aef3-7a6ec22af982",
                        "entry_id": "8abd3ee9-135d-3dd2-8a26-265577850038",
                        "glosses": [
                            "Ensemble des technologies, produits et services (souvent numériques ou biomédicaux) destinés à la santé et au bien-être des femmes (suivi menstruel, fertilité/contraception, grossesse, ménopause, santé pelvienne, etc.)."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "2ac4df3f-52da-4ebc-885e-2c842c08cb72",
                                "sense_id": "63ed49f3-2a68-3234-aef3-7a6ec22af982",
                                "text": "De nombreuses femmes prennent aussi le sujet à bras-le-corps notamment à travers le développement de la Femtech, dont les startups sont à 96 % des fondatrices."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5b555e2-b4ab-3251-937f-a3f50e5beabb",
                        "entry_id": "8abd3ee9-135d-3dd2-8a26-265577850038",
                        "glosses": [
                            "Entreprise travaillant pour ce secteur d’activité"
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "35c6ffb6-1591-45bb-a949-124a36e6d725",
                                "sense_id": "c5b555e2-b4ab-3251-937f-a3f50e5beabb",
                                "text": "Les entrepreneuses des Femtech (contraction de female technology) sont régulièrement confrontées à ce genre de remarques de la part d’investisseurs condescendants."
                            },
                            {
                                "example_id": "6b4cbf90-bf08-4cd5-a615-24df2e3a0326",
                                "sense_id": "c5b555e2-b4ab-3251-937f-a3f50e5beabb",
                                "text": "La Femtech rassemble aujourd’hui de nombreuses innovations qui accompagnent les femmes sur des sujets auparavant tabous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4272d514-b48c-4f93-830a-643f4ebd079e",
                        "source_entry_id": "8abd3ee9-135d-3dd2-8a26-265577850038",
                        "target_lang_word": "femtech",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femtech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d13c3de8-add8-3bfe-bf84-daf5801481f0",
                                        "entry_id": "63e39c33-b113-3a85-b982-18579e52802f",
                                        "glosses": [
                                            "Technology oriented towards women, especially reproductive health technology."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c6c21d-af19-47af-b501-ff7b5e3e903d",
                                                "sense_id": "d13c3de8-add8-3bfe-bf84-daf5801481f0",
                                                "text": "As well as companies selling menstrual protection, the femtech sector includes fertility apps, maternal health and sexual wellbeing products."
                                            },
                                            {
                                                "example_id": "a2baa074-c175-47d5-b343-03a102d2ec94",
                                                "sense_id": "d13c3de8-add8-3bfe-bf84-daf5801481f0",
                                                "text": "The current major players in the femtech industry - period apps - have demonstrated that it is profitable to target women and gather their data."
                                            },
                                            {
                                                "example_id": "9006ea32-ff5d-42d9-aa17-05f86d410057",
                                                "sense_id": "d13c3de8-add8-3bfe-bf84-daf5801481f0",
                                                "text": "With $800m of funding going to the femtech startups in 2019 alone, there couldn’t be a better time for ohne to enter the market."
                                            },
                                            {
                                                "example_id": "4f977f6e-ad1c-49e9-bbca-653f1335a9c1",
                                                "sense_id": "d13c3de8-add8-3bfe-bf84-daf5801481f0",
                                                "text": "The scientific study of perimenopause has been going on for decades, and the cultural discussion of this mind and body shift has reached something of a new fever pitch, with several books on the subject coming out this spring and a gaggle of “femtech” companies vowing to disrupt perimenopause."
                                            },
                                            {
                                                "example_id": "20d84616-3924-45e3-bcff-6b5e23064ae1",
                                                "sense_id": "d13c3de8-add8-3bfe-bf84-daf5801481f0",
                                                "text": "Mr. Thiel, who once suggested women’s suffrage was bad for America, did not seem like a natural investor in femtech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
