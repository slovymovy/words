                    {
                        "translation_id": "bafc4d95-2da8-4bff-ab0b-a9cf5b69fcde",
                        "source_entry_id": "1952720a-00ac-32ed-8598-8c06a880b7b5",
                        "source_sense_description": "Reptile saurien",
                        "target_lang_word": "iguana",
                        "target_lang_code": "es",
