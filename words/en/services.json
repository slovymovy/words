                    "sense_definition": "Plural of <w>service</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel offers excellent guest <w>services</w> to all visitors.",
                            "target_lang_translations": {
