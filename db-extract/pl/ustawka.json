                "senses": [
                    {
                        "sense_id": "78684c5b-54c5-383d-84be-2dde417fc1a5",
                        "entry_id": "d8723267-77bd-3a83-a7fd-9417a6b30e71",
                        "glosses": [
                            "pre-arranged fighting (e.g. football hooligan fights)"
                        ],
                        "tags": [
                            "feminine",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c4d38685-6a06-484d-9507-39483d6b4670",
                                "sense_id": "78684c5b-54c5-383d-84be-2dde417fc1a5",
                                "text": "W nocy z soboty na niedzielę ul. Kościuszki w Dębicy doszło do bijatyki. Policja twierdzi, że byli to pseudokibice dwóch dębickich klubów Igloopolu i Wisłoki. - To była tzw. ustawka - mówią funkcjonariusze.",
                                "translation": "At night, from Saturday to Sunday on Kośiuszki street in Dębica it came to fists. The police claim that they were pseudofans of the two local clubs Igloopolu and Wisłoki. \"It was a so-called set-up,\" officers say.",
                                "english": "At night, from Saturday to Sunday on Kośiuszki street in Dębica it came to fists. The police claim that they were pseudofans of the two local clubs Igloopolu and Wisłoki. \"It was a so-called set-up,\" officers say."
                            },
                            {
                                "example_id": "1861a218-fb9b-4ee1-b44a-294a773aae7f",
                                "sense_id": "78684c5b-54c5-383d-84be-2dde417fc1a5",
                                "text": "Młodzież organizuje nieraz tzw. ustawki - umówione bijatyki, z których słyną pseudokibice.",
                                "translation": "The youth are organizing sometimes the so-called set-ups - scheduled fights that pseudofans are famous for.",
                                "english": "The youth are organizing sometimes the so-called set-ups - scheduled fights that pseudofans are famous for."
                            }
                        ]
