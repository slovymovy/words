                ],
                "translations": [
                    {
                        "translation_id": "43584fae-bdfd-44d7-8dba-d9eab5f26a89",
                        "source_entry_id": "3a115fbc-f352-3744-a7b4-64ea5fbb7bd5",
                        "source_sense_id": "bef995f3-b413-3a00-886b-fbf91725e0bf",
                        "target_lang_word": "Mandaism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mandaism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "223c580e-ec98-3daa-b07b-8d6b9fb58cd7",
                                        "entry_id": "364a2a16-ebe5-35e9-add7-79b83a412661",
                                        "glosses": [
                                            "Alternative spelling of Mandaeism (“monotheistic religion laying emphasis on John the Baptist”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f682ae6c-f8e2-48ae-a10b-1eef8e3139b5",
                                                "sense_id": "223c580e-ec98-3daa-b07b-8d6b9fb58cd7",
                                                "text": "M. Matter has given the meaning of Manda, the origin of Mandaism in the word Gnosis."
                                            },
                                            {
                                                "example_id": "997f8f75-11e1-432f-b266-fadc20832d5a",
                                                "sense_id": "223c580e-ec98-3daa-b07b-8d6b9fb58cd7",
                                                "text": "The former of these hymns is a most curious document, and savours rather of Gnosticism or Mandaism than of genuine Christianity."
                                            },
                                            {
                                                "example_id": "80bab909-c51b-4cab-9bd2-5257a99206c5",
                                                "sense_id": "223c580e-ec98-3daa-b07b-8d6b9fb58cd7",
                                                "text": "He is otherwise inclined to place confidence in Theodor's information as to the person of the founder of Mandaism, […]"
                                            },
                                            {
                                                "example_id": "9555ab11-11e2-46e2-b7d4-fd118745fa22",
                                                "sense_id": "223c580e-ec98-3daa-b07b-8d6b9fb58cd7",
                                                "text": "Gnosticism, Manichaism, and Mandaism found numerous adherents; […]"
                                            },
                                            {
                                                "example_id": "7b11472e-bed6-44aa-a703-855ce09680fe",
                                                "sense_id": "223c580e-ec98-3daa-b07b-8d6b9fb58cd7",
                                                "text": "Mandaism is best understood as fundamentally a Gnostic system, comparable though not identical with various Gnostic systems known to us, which combine elements drawn in varying degrees from Iranian, Babylonian, Egyptian, Jewish and Christian sources, with Greek philosophy somewhere in the background (in Mandaism very much in the background)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mandaism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd332931-061b-3c2f-b322-7002183ee4eb",
                                        "entry_id": "9a3d9553-41c5-3154-9f73-c2acad9df15a",
                                        "glosses": [
                                            "An idiom or other feature borrowed from Mandaic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c519dd-0d56-4a95-90cc-23909fdd75cf",
                                                "sense_id": "bd332931-061b-3c2f-b322-7002183ee4eb",
                                                "text": "For other similar Mandaisms we may note: […]"
                                            },
                                            {
                                                "example_id": "b431571c-420c-4cc3-a3eb-da32d90a5b40",
                                                "sense_id": "bd332931-061b-3c2f-b322-7002183ee4eb",
                                                "text": "As to the Syriac bowls, Montgomery had already referred to Mandaisms in the Syriac texts […]"
                                            },
                                            {
                                                "example_id": "3a0a540c-bf73-49f9-88c3-ecf8097b0145",
                                                "sense_id": "bd332931-061b-3c2f-b322-7002183ee4eb",
                                                "text": "Montgomery, owing to the limited knowledge of Babylonian Jewish Aramaic in his time, interpreted many of the features simply as Mandaisms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
