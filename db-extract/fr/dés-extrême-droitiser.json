                "senses": [
                    {
                        "sense_id": "9a424701-92b9-338c-8ca9-48a93d5c28ea",
                        "entry_id": "4fd95d0b-8e32-370f-bcb0-3cb34ff1a941",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère d’extrême-droite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94cd7d6e-02f9-4f80-8187-e51eafa2cd72",
                                "sense_id": "9a424701-92b9-338c-8ca9-48a93d5c28ea",
                                "text": "Les sorties ouvertement xénophobes et racistes embarrassent régulièrement Forza Italia, le parti de Silvio Berlusconi, lui aussi parti de la coalition avec Frères d'Italie, forcé de tenter de calmer le jeu et de «dés-extrême-droitiser » la coalition."
                            },
                            {
                                "example_id": "73c0f323-6a82-4d26-8343-3ac8b344bb13",
                                "sense_id": "9a424701-92b9-338c-8ca9-48a93d5c28ea",
                                "text": "On pourrait dés-extrême-droitiser le forum pour pouvoir vivre dans le respect et la tolérance des différences qui font de nous des humains civilisés"
                            }
                        ]
                    }
