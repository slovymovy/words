                        "glosses": [
                            "Personne qui, par aquoibonisme, refuse de s’engager dans l’action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a91c09a-aa4b-4fd6-a055-54d05898f766",
                                "sense_id": "1423e00e-ede7-32fd-b2d7-f9337ddd4111",
                                "text": "C’est un aquoiboniste\nUn faiseur de plaisantristes\nQui dit toujours à quoi bon\nA quoi bon"
                            },
                            {
                                "example_id": "1dde2280-3777-4da6-b82f-cb94556398fa",
                                "sense_id": "1423e00e-ede7-32fd-b2d7-f9337ddd4111",
                                "text": "A quoi reconnait-on un aquoiboniste ? Principalement à son attitude découragée par avance, son incrédulité devant un projet, son fatalisme quand il s’agit de s’indigner ou de changer les choses."
                            }
                        ]
                    }
