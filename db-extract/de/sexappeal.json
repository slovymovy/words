                        "entry_id": "ad48bcd3-43e0-36d4-a1e7-3e390ef0bf20",
                        "glosses": [
                            "die positive, sexuelle Ausstrahlung eines Menschen. Ob jemand Sexappeal besitzt oder nicht, ist immer von den persönlichen Schönheitsidealen abhängig."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e29f86f-8992-4fe2-ac61-0e852d39dad7",
                                "sense_id": "e16fa5d2-fc3b-336d-b00e-475257d9c126",
                                "text": "„Sexappeal ist das, was Männer nur mit ihren Händen beschreiben können.“ - Uschi Glas"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85706ee4-ef6a-4c35-971d-75c886df5130",
                        "source_entry_id": "ad48bcd3-43e0-36d4-a1e7-3e390ef0bf20",
                        "source_sense_id": "e16fa5d2-fc3b-336d-b00e-475257d9c126",
