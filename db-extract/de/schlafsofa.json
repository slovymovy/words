                        "source_sense_description": "Sofa, auf dem man schlafen kann",
                        "target_lang_word": "canapé-lit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canapé-lit",
