{
    "word_family": [
        "exhibition",
        "exhibitionnisme",
        "exhibitionniste"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2742183-cfa3-3147-bdc2-bc69ba24f681",
                    "sense_definition": "Montrer quelque chose avec complaisance ou ostentation dans l'intention d'attirer l'attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "montrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il aime <w>exhiber</w> sa richesse devant ses collègues en achetant des voitures de luxe."
                        },
                        {
                            "text": "Elle refuse d'<w>exhiber</w> ses trophées dans le salon par souci de modestie."
                        }
                    ],
                    "synonyms": [
                        "étaler",
                        "afficher",
                        "parader"
                    ],
                    "antonyms": [
                        "cacher",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "exhiber sa richesse",
                        "exhiber fièrement"
                    ]
                },
                {
                    "sense_id": "493d01d2-3061-323d-ab61-904d1e6e7d76",
                    "sense_definition": "Se donner en spectacle ou montrer son corps de manière impudique ou provocante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "montrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette célébrité passe son temps à s'<w>exhiber</w> sur les réseaux sociaux pour faire parler d'elle."
                        },
                        {
                            "text": "Un homme a été interpellé hier soir pour s'être <w>exhibé</w> dans un lieu public."
                        }
                    ],
                    "synonyms": [
                        "se faire remarquer"
                    ],
                    "antonyms": [
                        "s'effacer",
                        "se cacher"
                    ],
                    "common_phrases": [
                        "s'exhiber en public"
                    ]
                },
                {
                    "sense_id": "0590dc3b-4153-3bd7-aaee-deda9a347753",
                    "sense_definition": "Présenter ou soumettre des titres, des pièces ou des documents officiels à une autorité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyageur a dû <w>exhiber</w> ses papiers dès son arrivée au contrôle douanier."
                        },
                        {
                            "text": "Le tribunal a ordonné au responsable d'<w>exhiber</w> les contrats originaux lors de l'audience."
                        }
                    ],
                    "synonyms": [
                        "produire",
                        "présenter"
                    ],
                    "common_phrases": [
                        "exhiber ses papiers",
                        "exhiber un contrat"
                    ]
                }
            ]
        }
    ]
}