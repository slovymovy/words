                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "шате́нках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05c985d7-5288-3917-b523-679b07486d3f",
                        "entry_id": "92ae2c5d-3bfb-3e54-abfc-a986a053a4a0",
                        "glosses": [
                            "женск. к шатен; лицо женского пола с волосами каштанового цвета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5402ec6b-ea38-429d-95db-39db5c209251",
                                "sense_id": "05c985d7-5288-3917-b523-679b07486d3f",
                                "text": "Я только теперь рассмотрел ее хорошенько: шатенка, среднего роста, в коричневом платье не первой молодости, которое не скрывало очень солидных форм."
                            },
                            {
                                "example_id": "d53d4d33-27cc-44d4-8947-f5ae724245b2",
                                "sense_id": "05c985d7-5288-3917-b523-679b07486d3f",
                                "text": "Юля говорит, что из довольно объемистой брюнетки я превратилась в тоненькую шатенку, потому что от постоянной темноты, в который мы живем, мои волосы посветлели."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48d72390-4f41-4dc3-a805-3829198fbb84",
                        "source_entry_id": "92ae2c5d-3bfb-3e54-abfc-a986a053a4a0",
                        "source_sense_id": "05c985d7-5288-3917-b523-679b07486d3f",
                        "target_lang_word": "Braunhaarige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aed856c5-75d6-4a99-87eb-ad959f9bdfe3",
                        "source_entry_id": "92ae2c5d-3bfb-3e54-abfc-a986a053a4a0",
                        "source_sense_id": "05c985d7-5288-3917-b523-679b07486d3f",
                        "target_lang_word": "châtaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "châtaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9380ba8-1527-361b-83d2-848ef1a8cdf7",
                                        "entry_id": "c5105a83-7ab9-32bb-8f42-da2f033809e5",
                                        "glosses": [
                                            "Femme, fille dont les cheveux sont de couleur châtain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cba48f-e661-455f-81e4-9e563569e107",
                                                "sense_id": "c9380ba8-1527-361b-83d2-848ef1a8cdf7",
                                                "text": "[…]\nElle est changeante, ma châtaine,\nComme les reflets du lézard\n[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "châtaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ead3cd6d-3cfa-30e2-a1ff-1d92cd242dc1",
                                        "entry_id": "ec9f55b4-623c-3685-87a7-5d9cc7878b61",
                                        "glosses": [
                                            "Féminin singulier de châtain."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e42ebc-7fee-424b-8325-2c051607982c",
                                                "sense_id": "ead3cd6d-3cfa-30e2-a1ff-1d92cd242dc1",
                                                "text": "C’était vendredi le lendemain, et pour ne pas participer à la profanation de cette journée de pénitence, M. d’Hocquincourt, jeune homme de vingt-huit ans aux belles moustaches châtaines, s’était allé coucher longtemps avant minuit."
                                            },
                                            {
                                                "example_id": "d3975c29-3eba-49bd-ac72-b42bf123579a",
                                                "sense_id": "ead3cd6d-3cfa-30e2-a1ff-1d92cd242dc1",
                                                "text": "Il s’approcha de la fenêtre, et, penché sur son reflet, ajusta une paire de moustaches châtaines, à peine un peu plus claires que ses cheveux, coupées au ras de la lèvre."
                                            },
                                            {
                                                "example_id": "7712fc83-d768-4ca3-8d26-cbffcc0febd3",
                                                "sense_id": "ead3cd6d-3cfa-30e2-a1ff-1d92cd242dc1",
                                                "text": "Et Wioletta, émue, caressait doucement la longue tresse châtaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
