                    {
                        "sense_id": "a3a1b2c7-ee29-3e74-9338-89f1ff6755cf",
                        "entry_id": "025a8f4f-b218-37cd-80d0-ced4add7c95f",
                        "glosses": [
                            "Öffnung in der Küchenwand, so dass man Speisen, Getränke, Geschirr und anderes zum Esszimmer (oder zurück) herübergeben kann, ohne den entsprechenden Weg machen zu müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9911b68a-cafa-43b5-8dbb-0dacfc5ea1c7",
                                "sense_id": "a3a1b2c7-ee29-3e74-9338-89f1ff6755cf",
                                "text": "„Er stellte zwei Schälchen Bratkartoffeln dazu und schloss die Durchreiche zur Küche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
