                        "précautions infinies"
                    ]
                },
                {
                    "sense_id": "51748b84-24aa-3e53-acc1-8aa6edc125ad",
                    "sense_definition": "Qui comprend un nombre d'éléments supérieur à tout entier naturel, en parlant d'un ensemble mathématique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ensemble des nombres pairs forme un ensemble <w>infini</w> bien connu."
                        },
                        {
                            "text": "Les mathématiciens étudient les propriétés de différentes suites <w>infinies</w>."
                        }
                    ],
                    "antonyms": [
                        "fini"
                    ],
                    "common_phrases": [
                        "ensemble infini"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d9c1c9a-cf85-3a0f-9123-cdff74fa8c8b",
                    "sense_definition": "Ce qui ne présente aucune limite perceptible ou concevable, immensité sans fin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "immensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En regardant le ciel nocturne, elle s'est sentie minuscule devant l'<w>infini</w>."
                        },
                        {
                            "text": "Cette route droite semblait se prolonger jusqu'à l'<w>infini</w> sans jamais tourner."
                        }
                    ],
                    "synonyms": [
                        "éternité"
                    ],
                    "antonyms": [
                        "fini"
                    ],
                    "common_phrases": [
                        "à l'infini",
                        "jusqu'à l'infini"
                    ]
                },
                {
                    "sense_id": "d5ab9f63-5149-3a04-a261-e49f1089bdbe",
                    "sense_definition": "Grandeur ou quantité idéale supérieure à tout nombre réel, généralement représentée par le symbole ∞.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concept_mathematique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lorsque la variable augmente, la fonction tend vers l'<w>infini</w> de façon continue."
                        },
                        {
                            "text": "Le symbole mathématique de l'<w>infini</w> ressemble à un huit couché horizontalement."
                        }
                    ],
                    "common_phrases": [
                        "tendre vers l'infini"
                    ]
                }
            ]
        }
    ]
