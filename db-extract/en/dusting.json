                    {
                        "sense_id": "240ac5f6-3688-3061-9695-4592cd95c75b",
                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                        "glosses": [
                            "A light snowfall."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "244007cf-583e-4fd9-a406-4e9dc7a09d08",
                                "sense_id": "240ac5f6-3688-3061-9695-4592cd95c75b",
                                "text": "The rooves are covered with a dusting of snow."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f1eb0a3-d01d-3e06-80c1-2531baeffa29",
                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                        "glosses": [
                            "A light covering of something."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "5179ce5c-e3aa-46cb-bc0e-c159cb047d7b",
                                "sense_id": "7f1eb0a3-d01d-3e06-80c1-2531baeffa29",
                                "text": "Cover the cake with a dusting of confectioner's sugar."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc5879d5-22f3-3d44-bb2e-c085deff67d5",
                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                        "glosses": [
                            "The act of removing dust from the furniture, as a household chore."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "39cfa074-c83f-470e-a4ef-f80b5aaea277",
                                "sense_id": "fc5879d5-22f3-3d44-bb2e-c085deff67d5",
                                "text": "Tuesday is the day when I do the dusting."
                            },
                            {
                                "example_id": "5bf1f7eb-0ee2-486e-81f0-69915d217b6c",
                                "sense_id": "fc5879d5-22f3-3d44-bb2e-c085deff67d5",
                                "text": "Strict orders had been given by Mrs. Breen the night before that certain dustings and arrangings of furniture should take place, the spacious stairs swept, and the hectic hired palms in their great china pots watered."
                            }
                        ]
                    },
                    {
                        "sense_id": "897d9c01-ab52-3f20-a656-440bc00f088b",
                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                        "glosses": [
                            "A beating."
                        ],
                        "tags": [
                            "colloquial",
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "67cb877c-0864-36e8-b5b9-39053c9dc95b",
                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                        "glosses": [
                            "A maintenance or comfort behaviour in which a bird flushes fine dirt through the feathers; dustbathing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f86e959c-47ce-43c1-ab82-93b043f346dd",
                        "source_entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                        "source_sense_description": "light covering",
                        "target_lang_word": "saupoudrage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saupoudrage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b19475e-f2a2-3f11-afee-1b13585a7378",
                                        "entry_id": "91d8c950-e1f1-3486-b8fe-da4f12760df1",
                                        "glosses": [
                                            "Action de répandre sur quelque chose une petite quantité d’une substance sous forme de poudre, de paillettes ou de petits grains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c9689c-b704-42e4-828d-78f261fbe12b",
                                                "sense_id": "5b19475e-f2a2-3f11-afee-1b13585a7378",
                                                "text": "La farine de seigle introduite dans Paris sert surtout à la fabrication du pain d’épices et au fleurage, c’est-à-dire au saupoudrage des panetons où l’on met la pâte au four ; cette opération a pour but de prévenir l’adhérence de la pâte."
                                            },
                                            {
                                                "example_id": "589a3a77-1d1a-4664-97e4-76dcf242a3c8",
                                                "sense_id": "5b19475e-f2a2-3f11-afee-1b13585a7378",
                                                "text": "Il faut renouveler le saupoudrage [de pyrèthre] pour atteindre les insectes au sortir de l’œuf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28540ed8-3659-3952-83c2-7038fda9680e",
                                        "entry_id": "91d8c950-e1f1-3486-b8fe-da4f12760df1",
                                        "glosses": [
                                            "Action démagogique consistant à adopter des mesures ayant peu d’efficacité réelle, mais donnant à l’électorat l’impression que les gouvernants agissent."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b6c0d2d-43b4-497b-afb7-68701dca2ef7",
                                                "sense_id": "28540ed8-3659-3952-83c2-7038fda9680e",
                                                "text": "C’est de l’esbroufe, des effets d’annonces, du saupoudrage, on dirait même que c’est de la provocation."
                                            },
                                            {
                                                "example_id": "95c02a68-45f3-49f8-84a1-29a02204cbc3",
                                                "sense_id": "28540ed8-3659-3952-83c2-7038fda9680e",
                                                "text": "La France a incontestablement besoin de financer de grands projets d’avenir pour s’adapter aux transformations en cours et moderniser ses services publics, afin de gagner en efficacité. Mais il serait dangereux de céder à la tentation du saupoudrage, qui ne fait que nourrir les frustrations et les revendications sans fin, sans pour autant régler les problèmes sur le long terme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
