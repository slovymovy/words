                        ],
                        "examples": [
                            {
                                "example_id": "e9da63b1-dc26-48d9-8b58-de4efd388775",
                                "sense_id": "909de5f4-bcba-3cb0-8ac6-335f5b76a608",
                                "text": "„Das zeigt die Ausstellung am Beispiel der traditionell schwierigen Beziehung zum Wolf, des Hundes wildem Verwandten. Fangeisen, Jagdgewehre, eine so genannte Wolfsangel Waffen statt Worten. Wenn die Furcht voreinander regiert, kommt keine Verständigung zustande.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
