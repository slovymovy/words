                        "sense_id": "1f4ebb61-0e3f-37cf-bd33-4f5b64b65bc3",
                        "entry_id": "d13235cf-7376-3ec8-b2fb-80825b38b7b1",
                        "glosses": [
                            "To watch (a film or TV series) using the Internet streaming media provider Netflix."
                        ],
                        "tags": [
                            "Internet",
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "73fb8fc7-e0fa-47b0-b847-ce1f03a83836",
                                "sense_id": "1f4ebb61-0e3f-37cf-bd33-4f5b64b65bc3",
                                "text": "He used to Netflix for 5 hours a day."
                            },
                            {
                                "example_id": "554368d4-01d7-4ad6-a24f-ff77baf21ce4",
                                "sense_id": "1f4ebb61-0e3f-37cf-bd33-4f5b64b65bc3",
                                "text": "We started with Buffy, which had us completely sucked in by the time Xander's buddies ate Principle Flutie. Then, after Netflixing Buffy all the way to the end, we started on Angel."
                            },
                            {
                                "example_id": "23133e44-2f14-4074-ab13-bab1c1ea64b0",
                                "sense_id": "1f4ebb61-0e3f-37cf-bd33-4f5b64b65bc3",
                                "text": "I'm Netflixing the series now (for their fish-faced, airplane-launched Lunar Module shuttle, alas a bit beyond reality, even if you discount the airplane doing Harrier Jump Jet takeoffs as mere technological bravura)."
                            },
                            {
                                "example_id": "bb8b871c-76b2-4d3a-ab99-b1ad447e2b90",
                                "sense_id": "1f4ebb61-0e3f-37cf-bd33-4f5b64b65bc3",
                                "text": "I was surprised to see Jeffrey Tambor in this movie, as I've only recently discovered him when I Netflixed Arrested Development and the Larry Sanders show."
                            }
                        ]
                    }
