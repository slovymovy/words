{
    "word_family": [
        "deflect",
        "deflector",
        "deflective"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4856a9a-6e0d-3c06-986a-70cb908ea134",
                    "sense_definition": "The act of changing the direction of an object, or the state of being turned aside from a straight course.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper made a brilliant save after a wicked <w>deflection</w> off the defender's leg.",
                            "target_lang_translations": {
                                "ru": "Вратарь совершил блестящий сейв после коварного <w>рикошета</w> от ноги защитника."
                            }
                        },
                        {
                            "text": "A slight <w>deflection</w> of the bullet caused it to miss the target completely.",
                            "target_lang_translations": {
                                "ru": "Небольшое <w>отклонение</w> пули привело к тому, что она полностью промахнулась мимо цели."
                            }
                        }
                    ],
                    "synonyms": [
                        "deviation",
                        "divergence"
                    ],
                    "common_phrases": [
                        "wicked deflection",
                        "slight deflection",
                        "take a deflection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт изменения направления движения объекта или состояние отклонения от прямого курса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рикошет",
                                "target_lang_sense_clarification": "в спорте или при столкновении"
                            },
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "изменение траектории"
                            },
                            {
                                "target_lang_word": "преломление",
                                "target_lang_sense_clarification": "изменение направления лучей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6f1090e-f638-321b-bd68-2b5336995c83",
                    "sense_definition": "The psychological or rhetorical tactic of avoiding a difficult question or criticism by changing the subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavioral_tactic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician used <w>deflection</w> to avoid answering the reporter's question about the budget cuts.",
                            "target_lang_translations": {
                                "ru": "Политик использовал <w>уклонение</w>, чтобы не отвечать на вопрос репортера о сокращении бюджета."
                            }
                        },
                        {
                            "text": "His constant <w>deflection</w> of blame made it impossible to have a serious conversation about his mistakes.",
                            "target_lang_translations": {
                                "ru": "Его постоянный <w>отвод</w> обвинений сделал невозможным серьезный разговор о его ошибках."
                            }
                        }
                    ],
                    "synonyms": [
                        "diversion",
                        "evasion"
                    ],
                    "common_phrases": [
                        "deflection of blame",
                        "tactic of deflection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психологическая или риторическая тактика уклонения от сложного вопроса или критики путем смены темы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклонение",
                                "target_lang_sense_clarification": "от темы или ответственности"
                            },
                            {
                                "target_lang_word": "перевод темы",
                                "target_lang_sense_clarification": "риторический прием"
                            },
                            {
                                "target_lang_word": "отвод",
                                "target_lang_sense_clarification": "критики или обвинений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da1675a6-ace0-3564-a534-d29dd179311b",
                    "sense_definition": "The movement of a pointer or needle on a measuring instrument away from its zero point.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compass showed a significant <w>deflection</w> when it was placed near the large magnet.",
                            "target_lang_translations": {
                                "ru": "Компас показал значительное <w>отклонение</w>, когда его поместили рядом с большим магнитом."
                            }
                        },
                        {
                            "text": "Engineers monitored the needle <w>deflection</w> to ensure the pressure remained within safe limits.",
                            "target_lang_translations": {
                                "ru": "Инженеры следили за <w>отклонением</w> стрелки, чтобы убедиться, что давление остается в безопасных пределах."
                            }
                        }
                    ],
                    "synonyms": [
                        "displacement"
                    ],
                    "common_phrases": [
                        "needle deflection",
                        "rudder deflection"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение указателя или стрелки измерительного прибора в сторону от нулевой отметки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "стрелки прибора"
                            },
                            {
                                "target_lang_word": "девиация",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25bae337-cc21-338d-90c0-e28673b98065",
                    "sense_definition": "The degree to which a structural element is displaced or deformed under a specific load.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridge was designed to withstand a certain amount of <w>deflection</w> during heavy traffic.",
                            "target_lang_translations": {
                                "ru": "Мост был спроектирован так, чтобы выдерживать определенный <w>прогиб</w> при интенсивном движении."
                            }
                        },
                        {
                            "text": "Excessive <w>deflection</w> in the floor joists can lead to cracks in the ceiling below.",
                            "target_lang_translations": {
                                "ru": "Чрезмерный <w>прогиб</w> балок перекрытия может привести к появлению трещин в потолке снизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "bending",
                        "deformation"
                    ],
                    "common_phrases": [
                        "maximum deflection",
                        "structural deflection"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "engineering and physics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень смещения или деформации элемента конструкции под воздействием определенной нагрузки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогиб",
                                "target_lang_sense_clarification": "конструкции под нагрузкой"
                            },
                            {
                                "target_lang_word": "деформация",
                                "target_lang_sense_clarification": "изменение формы"
                            },
                            {
                                "target_lang_word": "смещение",
                                "target_lang_sense_clarification": "конструктивного элемента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9c90fd8-c835-39dd-b358-d44268005b0c",
                    "sense_definition": "A tactic in chess that forces an opponent's piece to leave a square it is defending.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster won the game by using a clever <w>deflection</w> sacrifice to lure the queen away.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер выиграл партию, использовав искусную жертву на <w>отвлечение</w>, чтобы увести ферзя."
                            }
                        },
                        {
                            "text": "In this puzzle, you must find the <w>deflection</w> that leaves the king unprotected.",
                            "target_lang_translations": {
                                "ru": "В этой задаче вы должны найти <w>отвлечение</w>, которое оставит короля без защиты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deflection sacrifice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chess terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тактика в шахматах, заставляющая фигуру противника покинуть поле, которое она защищает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвлечение",
                                "target_lang_sense_clarification": "шахматный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}