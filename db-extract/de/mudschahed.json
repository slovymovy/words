                        "form": "die Mudschaheddin"
                    },
                    {
                        "form_id": "739cec7b-4320-4bde-9b43-47d4e25930bb",
                        "entry_id": "e72dfe52-06e3-39c0-970e-8fee35eb2b4f",
                        "tags": [
                            "accusative",
