                ],
                "senses": [
                    {
                        "sense_id": "1aed608c-cf54-342f-bde8-321ec81f8339",
                        "entry_id": "f644ce50-af49-358a-b32a-2460b5c9848c",
                        "glosses": [
                            "met te veel zeil voor de weersomstandigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc0b833-fb1a-4fd4-8fd8-9048a230b727",
                                "sense_id": "1aed608c-cf54-342f-bde8-321ec81f8339",
                                "text": "Te veel helling en roerdruk zijn het gevolg van een overtuigd schip en een verkeerde stand van de zeilen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4fd97e6-5f2a-3e59-8b45-4dd37c97d445",
                        "entry_id": "f644ce50-af49-358a-b32a-2460b5c9848c",
                        "glosses": [
                            "zeker in zijn denkwijze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f623bae7-46d1-4b44-b208-5d05f1c12d4b",
                                "sense_id": "c4fd97e6-5f2a-3e59-8b45-4dd37c97d445",
                                "text": "Hij is daar een overtuigde aanhanger van."
                            }
                        ]
                    }
                ],
                "translations": [],
