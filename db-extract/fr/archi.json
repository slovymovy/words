                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "super",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                                        "entry_id": "e264356d-368e-3f9a-8bb8-15203c0260aa",
                                        "glosses": [
                                            "Very; extremely (used like the prefix super-)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9efb6c14-3e17-4225-b7aa-4a113c0a5ca1",
                                                "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                                                "text": "The party was super awesome."
                                            },
                                            {
                                                "example_id": "9a1a5aba-93f1-4ff3-bce9-590a68349a2b",
                                                "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                                                "text": "The job is super interesting for a person who enjoys a hardware environment and communicating with people."
                                            },
                                            {
                                                "example_id": "680f5f56-67c8-4dcf-8c02-44d3e29c3a53",
                                                "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                                                "text": "“The best people are staying, so I’m not super worried,” he tweeted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867b2517-02a0-30b4-bd40-f9abbaade967",
                                        "entry_id": "e264356d-368e-3f9a-8bb8-15203c0260aa",
                                        "glosses": [
                                            "Absolutely; utterly."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c823f5a3-41c5-4607-acaf-2129d370ade7",
                                                "sense_id": "867b2517-02a0-30b4-bd40-f9abbaade967",
                                                "text": "I super don't care about that."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "super",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c4aab3c-17e3-35d1-9ae6-1c1dc8db5087",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
                                            "Clipping of superannuation."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6f90427-3faf-4abf-bda7-88fbc931e4e6",
                                                "sense_id": "9c4aab3c-17e3-35d1-9ae6-1c1dc8db5087",
                                                "text": "Jane looked forward to collecting a large super payout when she retired."
                                            },
                                            {
                                                "example_id": "82a0ab0b-12c9-45d4-9256-980feaab807e",
                                                "sense_id": "9c4aab3c-17e3-35d1-9ae6-1c1dc8db5087",
                                                "text": "“I want to make it clear, compassionate release of super should only be considered as a last resort, where all other options of paying for the eligible expenses have been exhausted,” she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a165fee7-ff9b-3020-a780-a2fd89b754ef",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
                                            "Clipping of supercomputer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c69b393-6ffa-49e1-9471-b241aef84856",
                                                "sense_id": "a165fee7-ff9b-3020-a780-a2fd89b754ef",
                                                "text": "The performances and cost ranges of three classes of commercial supercomputers are given in Table 2.1. The full-scale supers are the most expensive class, represented by Cray, ETA, and Fujitsu systems, for example."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd4428b-ab82-34d9-8b4d-a38c16882e31",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
                                            "Clipping of superhero."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392c4af8-99b3-4999-9895-88d9e2db4e89",
                                                "sense_id": "efd4428b-ab82-34d9-8b4d-a38c16882e31",
                                                "text": "For quotations using this term, see Citations:super."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb83889c-9bba-35dd-8b97-b8f1ac3dfdc5",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
                                            "Clipping of superhive."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f8803cd-8601-4d83-8650-b423592041f9",
                                                "sense_id": "eb83889c-9bba-35dd-8b97-b8f1ac3dfdc5",
                                                "text": "There may be thirty to fifty supers in every outyard, and we have only about half an hour to get them off the hives, stacked and covered before the bees get really cross about what we are doing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa017bb-e638-3be0-bfff-47bcb7649723",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
                                            "Clipping of superintendent, especially, a building's resident manager (sometimes clarified as “building super”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "564e6532-bffb-390f-8485-86d8b8c2d29e",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
                                            "Clipping of supernaturalist, especially as distinguished from bright."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
