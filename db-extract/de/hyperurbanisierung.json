                ],
                "senses": [
                    {
                        "sense_id": "9c0c07fc-9512-3fff-a412-e6d8e1b80f85",
                        "entry_id": "eb1e1617-eaa9-3432-86fa-7e4a7a29f23c",
                        "glosses": [
                            "Verstädterung eines Landes, die höher ist als die wirtschaftliche Entwicklung und damit die Zahl der Arbeitsplätze und Wohnräume"
                        ],
                        "tags": [
                            "Geographie",
                            "Demografie"
                        ],
                        "examples": [
                            {
                                "example_id": "2861f749-9060-49fb-a43d-2f9a3ae7fcf7",
                                "sense_id": "9c0c07fc-9512-3fff-a412-e6d8e1b80f85",
                                "text": "„Die chilenische Stadtentwicklung ist […] durch die Prozesse der Hyperurbanisierung und der Metropolisierung gekennzeichnet […].“"
                            },
                            {
                                "example_id": "58951299-2728-4dd3-8009-3fb79e44f9b3",
                                "sense_id": "9c0c07fc-9512-3fff-a412-e6d8e1b80f85",
                                "text": "„Sie führte zu einer Hyperurbanisierung und Ruralisierung der sowjetischen Hauptstadt […]“"
                            },
                            {
                                "example_id": "2fcd2ec5-32b9-4daa-908d-0d4ea3928440",
                                "sense_id": "9c0c07fc-9512-3fff-a412-e6d8e1b80f85",
                                "text": "“Das Phänomen der Hyperurbanisierung, der (Über-)Konzentration von wirtschaftlichen Aktivitäten und städtischen Funktionen auf einige wenige Städte, besteht aber weiter fort: […].“"
                            },
                            {
                                "example_id": "5b433809-ffaa-4f58-86c3-8a010c36a661",
                                "sense_id": "9c0c07fc-9512-3fff-a412-e6d8e1b80f85",
                                "text": "„Auch wenn jüngere Tendenzen der Metropolenentwicklung in Lateinamerika nicht mehr so klar in Richtung einer fortschreitenden Hyperurbanisierung weisen wie noch vor wenigen Jahrzehnten […], reicht das Wachstum aus, um die Zahl der Marginalsiedlungen weiter steigen zu lassen.“"
                            },
                            {
                                "example_id": "71bb9cab-f08d-483d-aa20-306666067b28",
                                "sense_id": "9c0c07fc-9512-3fff-a412-e6d8e1b80f85",
                                "text": "“Allein zwischen 1926 und 1937 wächst Moskau jährlich etwa um 162.000 Menschen, die Gesamtbevölkerung von 2 auf 3,6 Millionen. Mosche Lewin hat das Hyperurbanisierung genannt […].“"
                            },
                            {
                                "example_id": "8016668c-bc7b-4ac0-a83b-6cb030725755",
                                "sense_id": "9c0c07fc-9512-3fff-a412-e6d8e1b80f85",
                                "text": "Hyperurbanisierung gibt es sowohl in Industriestaaten als auch Entwicklungsländern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
