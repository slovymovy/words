                    {
                        "sense_id": "f31b4653-0b73-3f83-89ba-70c0fca976c4",
                        "entry_id": "5e23bf4d-b53c-3d2a-9411-798e2b74d46c",
                        "glosses": [
                            "Qui peut être administré ; que l’on peut administrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff416e5-6128-4d26-839e-ee5fff6b685e",
                                "sense_id": "f31b4653-0b73-3f83-89ba-70c0fca976c4",
                                "text": "Contre la blennorrhagie, quand le copahu n’est pas administrable par la bouche."
                            },
                            {
                                "example_id": "e0387b91-512a-45b9-869b-6e75f11a5ec2",
                                "sense_id": "f31b4653-0b73-3f83-89ba-70c0fca976c4",
                                "text": "Nous pouvons en conclure qu’un territoire très peuplé est administrable à condition d’être composé d’une population dense vivant sous une économie rurale agricole et organisée sur une base traditionnelle."
                            },
                            {
                                "example_id": "cdc728db-1981-4abd-9ed8-c8540ab2550e",
                                "sense_id": "f31b4653-0b73-3f83-89ba-70c0fca976c4",
                                "text": "Un Switch manageable, appelé aussi « administrable », lui, va offrir des possibilités de configuration qui permettent de modifier et de gérer son fonctionnement: VLAN, CLI, SNMP, routage IP, QoS, etc."
                            }
                        ]
                    }
                ],
                "translations": [
