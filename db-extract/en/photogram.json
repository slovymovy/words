    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aef5a4b8-b360-3a17-ab07-ce117964be89",
                "word": "photogram",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a241f692-53fb-4862-b577-bd4a9eb72ec1",
                        "entry_id": "aef5a4b8-b360-3a17-ab07-ce117964be89",
                        "tags": [
                            "plural"
                        ],
                        "form": "photograms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17403295-fd5e-3eb1-99ee-ca01a87e003a",
                        "entry_id": "aef5a4b8-b360-3a17-ab07-ce117964be89",
                        "glosses": [
                            "A photograph made without using a camera; normally by placing an object in contact with photosensitive paper and exposing it to light"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcd00fb1-4c83-4b82-85dd-1e189da26c5a",
                        "source_entry_id": "aef5a4b8-b360-3a17-ab07-ce117964be89",
                        "source_sense_id": "17403295-fd5e-3eb1-99ee-ca01a87e003a",
                        "source_sense_description": "a photograph made without using a camera",
                        "target_lang_word": "photogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "236cc772-5fc5-3211-ae17-a1d32f53f480",
                                        "entry_id": "e5390349-80c9-3bbf-b822-acc7efcbd5ee",
                                        "glosses": [
                                            "Chacune des images d’un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fad486e-2b17-42e4-b448-2aa7df070d90",
                                                "sense_id": "236cc772-5fc5-3211-ae17-a1d32f53f480",
                                                "text": "Un film déroule généralement 24 photogrammes par seconde, moins pour les dessins animés, davantage pour les ShowScan."
                                            },
                                            {
                                                "example_id": "75d4b7ef-2377-48a3-890e-e0e0aff5a3fe",
                                                "sense_id": "236cc772-5fc5-3211-ae17-a1d32f53f480",
                                                "text": "Gonzalo avait scruté chaque photogramme, en effet, obsédé par l’idée de retrouver l’ordinateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b90b776-e303-3e38-ac99-a919925e479c",
                                        "entry_id": "e5390349-80c9-3bbf-b822-acc7efcbd5ee",
                                        "glosses": [
                                            "Image photographique obtenue sans emploi d’objectif en plaçant un objet devant ou sur un papier photographique sensible et en éclairant l’ensemble d’une lumière orientée ou modulée → voir photocalque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f30b2d-7af7-45a4-8106-6c2485586d4d",
                                                "sense_id": "9b90b776-e303-3e38-ac99-a919925e479c",
                                                "text": "Les photogrammes de Moholy Nagy et de Man Ray."
                                            },
                                            {
                                                "example_id": "16bd67c7-59ff-4246-8d86-14dc99cbe2ea",
                                                "sense_id": "9b90b776-e303-3e38-ac99-a919925e479c",
                                                "text": "En 1803, Wedgwood […] obtint la silhouette de feuilles d’arbre et de dentelles après les avoir placées sur un papier sensibilisé ; il aurait même réussi à copier une gravure par transparence. Cependant ces images étaient fugitives : une forte lumière les effaçait. On peut aujourd’hui fixer ces images que l’on nomme communément des photogrammes (le peintre photographe Man Ray en fit de nombreuses)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0b0110-3412-34a1-9802-282b720aa07d",
                                        "entry_id": "e5390349-80c9-3bbf-b822-acc7efcbd5ee",
                                        "glosses": [
                                            "Photographie produite par une chambre métrique, permettant d’effectuer des mesures précises."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a6946d-7508-4709-a86d-73df6423bee6",
                                                "sense_id": "5f0b0110-3412-34a1-9802-282b720aa07d",
                                                "text": "Sur la détermination, d’après un photogramme, du point principal et de la distance de l’image."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64188dfe-8d5a-4823-84cd-25b916294f0d",
                        "source_entry_id": "aef5a4b8-b360-3a17-ab07-ce117964be89",
                        "source_sense_id": "17403295-fd5e-3eb1-99ee-ca01a87e003a",
                        "source_sense_description": "a photograph made without using a camera",
                        "target_lang_word": "φωτογράφημα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "φωτογράφημα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "90d3a314-978a-3fe5-a09a-13e51c539414",
                                        "entry_id": "e7810ef0-942d-35f8-865f-d1a869b97c94",
                                        "glosses": [
                                            "φωτόγραμμα, φωτογραφική εικόνα που παράγεται, με την άμεση τοποθέτηση αντικειμένων στην επιφάνεια ενός φωτοευαίσθητου υλικού, όπως το φωτογραφικό χαρτί και κατόπιν την έκθεσή του στο φως (χωρίς φωτογραφική μηχανή)"
                                        ],
                                        "tags": [
                                            "φωτογραφία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bacab55-6ba8-4b7c-8843-f0b1b0bd138b",
                                                "sense_id": "90d3a314-978a-3fe5-a09a-13e51c539414",
                                                "text": "※ Η ηλιογραφία είναι διαφορετική από τα φωτογραφήματα που περιγράψαμε στο προηγούμενο κεφάλαιο. Ένα φωτογράφημα μπορεί να αποδώσει ένα αποτύπωμα του αντικειμένου παρά μόνο όταν είναι απευθείας τοποθετημένο πάνω σε φωτοευαίσθητο χαρτί. (Η Γυναικεία Οπτική: Αποτυπώνοντας τον έξω κόσμο, europeana.eu, ανακτήθηκε στις 26/7/2026 https://www.europeana.eu/el/exhibitions/a-female-lens/capturing-the-outside-world)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d290782b-7955-3490-a06c-1be5fbb5f79a",
                                        "entry_id": "e7810ef0-942d-35f8-865f-d1a869b97c94",
                                        "glosses": [
                                            "φωτογραφία"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "463f7cbb-b98d-464e-ab14-4f2d31d7a21a",
                                                "sense_id": "d290782b-7955-3490-a06c-1be5fbb5f79a",
                                                "text": "※ Φωτογράφημα καὶ πανομοιότυπον τῆς ἐπιγραφῆς ἐστάλησαν πρὸς τὸν καθηγητὴν Γεώργιον STEPHENS, τὸν διάσημον ἀρχαιοδίφην, ὅστις πλήρη ἔχων τὸν νοῦν του τῶν βορείων ἀρχαιοτήτων ἀπεφάνθη ὅτι ἡ ἐπιγραφὴ συνίσταται ἐκ 12 ῥουνικῶν στίχων (Έσπερος: σύγγραμμα περιοδικόν μετά εικόνων δις του μηνός, 1884, σελ. 51)"
                                            },
                                            {
                                                "example_id": "81fe1078-3ec6-42e0-9b3e-84abf0e00220",
                                                "sense_id": "d290782b-7955-3490-a06c-1be5fbb5f79a",
                                                "text": "※ Τό φωτογράφημα τοῦτο μοὶ ἐδωρήθη ὑπὸ τῆς βασιλόπαιδος Σοφίας, τις δέ ποτε ἤθελε πιστεύσει (Ι. Βαρλαάμ, Ο Βολεσλάος ή Ο κλέπτης των ανακτόρων (μετάφρασις εκ του Ιταλικού), τυπογρ. Φιλοκαλίας, Λάρνακι (Κύπρου), 1892, σελ. 168)"
                                            },
                                            {
                                                "example_id": "d235bf32-a4b5-44b4-9a5f-ed2fbf39ac79",
                                                "sense_id": "d290782b-7955-3490-a06c-1be5fbb5f79a",
                                                "text": "※ Φωτογράφημα πιστὸν τῆς εἰκόνος ταύτης, ἐξ ἧς ὡς ἐκ τῆς καταστάσεως τοῦ πρωτοτύπου ὀλίγα δύναταί τις νὰ ἐξαγάγῃ, ἔχομεν ὑπ ̓ ὄψιν ἡμῶν. (Δημήτριος Γρ. Καμπούρογλου, Ιστορία των Αθηναίων, Τουρκοκρατία, περίοδος πρώτη 1458-1687, τόμος δεύτερος, Αθήνα, Βιβλιοπωλείο της Εστίας, 1890, σελ. 182)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
