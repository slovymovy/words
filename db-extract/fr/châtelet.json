                    {
                        "sense_id": "27c6ceea-53ce-3181-aba7-2ddedec456f7",
                        "entry_id": "da99ea25-b64f-3278-b44a-f47ae5e4f000",
                        "glosses": [
                            "Ancienne forteresse et par extension nom donné aux tribunaux et juridictions qui y avaient leur siège."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20cd55f2-88b1-48f7-ace9-1eedeb5c2ab9",
                                "sense_id": "27c6ceea-53ce-3181-aba7-2ddedec456f7",
                                "text": "Le tribunal du châtelet, tribunal de prévôté, acquit à partir de Saint Louis une très grande importance et avait presque un rang de parlement."
                            }
                        ]
                    },
                    {
                        "sense_id": "6488ece3-e1ed-32c3-9ed1-067aadcfc7e6",
                        "entry_id": "da99ea25-b64f-3278-b44a-f47ae5e4f000",
                        "glosses": [
                            "Petit château établi à la tête d’un pont ou sur une route à l’entrée d’une ville pour mettre les habitants à l’abri des incursions ennemies."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "dac24ac8-0975-4cd7-a6ff-51c0c05108bc",
                                "sense_id": "6488ece3-e1ed-32c3-9ed1-067aadcfc7e6",
                                "text": "Un châtelet, qui peut être isolé de la barbacane, la précède, à cheval sur le pont qui était composé de deux tabliers mobiles en bois, dont les tourillons sont encore à leur place."
                            }
                        ]
                    },
                    {
                        "sense_id": "359164bf-82a9-3094-8984-64f34f602da2",
                        "entry_id": "da99ea25-b64f-3278-b44a-f47ae5e4f000",
                        "glosses": [
                            "Partie du métier de rubanier, qui soutenait les hautes lices."
                        ],
