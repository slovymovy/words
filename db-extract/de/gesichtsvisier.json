                "senses": [
                    {
                        "sense_id": "fd49dccc-4d19-3033-9f28-38b819b3c451",
                        "entry_id": "82d0cd47-c7ab-3627-937e-47be04b6ffe8",
                        "glosses": [
                            "gewölbte, durchsichtige Plastikscheibe, die mit einer Kopfhalterung befestigt wird und von oberhalb der Augen bis unterhalb des Kinns reicht; sie soll Augen und Atemwege schützen und besonders einen Schutz gegen eine Tröpfcheninfektion bieten"
                        ],
                        "tags": [
                            "Arbeitsschutz",
                            "Schutzausrüstung"
                        ],
                        "examples": [
                            {
                                "example_id": "ae0f8575-8ef3-474d-b6fd-9a811e471cdf",
                                "sense_id": "fd49dccc-4d19-3033-9f28-38b819b3c451",
                                "text": "Die transparenten Gesichtsvisiere haben den Vorteil, dass man die Mimik des Gegenübers erkennen kann."
                            },
                            {
                                "example_id": "f23167c6-d56d-4be0-8474-fc54125ea216",
                                "sense_id": "fd49dccc-4d19-3033-9f28-38b819b3c451",
                                "text": "Bei der Arbeit ist entweder eine Schutzbrille oder ein Gesichtsvisier zu verwenden."
                            },
                            {
                                "example_id": "d0debeef-b6c1-4659-ba46-72e4396dbb69",
                                "sense_id": "fd49dccc-4d19-3033-9f28-38b819b3c451",
                                "text": "„Um die Plastikvisiere gibt es in Rheinland-Pfalz seit Tagen ein Hin und Her. Erst am Freitag hatte das Ministerium offiziell klar gestellt, dass Gesichtsvisiere grundsätzlich nicht als gleichwertiger Mundschutz anzusehen sind - nachdem Wirtschaftsverbände eine Klarstellung gefordert hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
