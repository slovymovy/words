                "senses": [
                    {
                        "sense_id": "e0dfd428-9773-30c7-bafb-adfc3cb5941d",
                        "entry_id": "50420680-8948-379b-97aa-a1f14be6b52c",
                        "glosses": [
                            "związany z mionami, dotyczący mionów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa0cc8c-e04a-40a8-8026-d9b45e14fb8e",
                                "sense_id": "e0dfd428-9773-30c7-bafb-adfc3cb5941d",
                                "text": "Większość eksperymentów jest nastawiona na mierzenie neutrin elektronowych, a więc jeśli one w locie ze Słońca zmienią się w neutrina mionowe, to wyjaśnia ich deficyt na powierzchni Ziemi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
