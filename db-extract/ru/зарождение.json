                ],
                "senses": [
                    {
                        "sense_id": "c8b4882d-50d0-3f3f-ac60-193296702256",
                        "entry_id": "ac949f26-d7e3-3cf2-bf55-9ba424e9dcd5",
                        "glosses": [
                            "действие по значению гл. зародить"
                        ],
