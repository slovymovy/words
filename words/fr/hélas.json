    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5fe5132f-8dba-32f5-85b5-7ec0d442d276",
                    "sense_definition": "Exprime le regret, la tristesse ou la déception face à une situation malheureuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous voulions partir en vacances cette semaine, mais <w>hélas</w>, la météo est exécrable."
                        },
                        {
                            "text": "J'espérais obtenir une promotion cette année, mais <w>hélas</w>, mon projet n'a pas été retenu."
                        }
                    ],
                    "synonyms": [
                        "las",
                        "malheureusement"
                    ],
                    "common_phrases": [
                        "hélas non",
                        "hélas oui",
                        "mais hélas"
                    ]
                },
                {
                    "sense_id": "42bdaa9a-503b-32d5-8134-e1be1462a31d",
                    "sense_definition": "Exprime le désespoir, la résignation ou un sentiment d'impuissance face au destin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hélas</w>, malgré tous nos efforts acharnés, personne ne peut plus rien faire pour sauver l'entreprise."
                        },
                        {
                            "text": "Les médecins ont tenté l'impossible pour le soigner, mais <w>hélas</w>, son état s'est rapidement dégradé."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0fb87329-8f0f-3853-9dae-3f1a5ae34074",
                    "sense_definition": "Plainte, soupir ou lamentation exprimée par l'exclamation hélas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme poussait de longs <w>hélas</w> en repensant tristement à sa jeunesse perdue."
                        },
                        {
                            "text": "Face aux mesures financières annoncées, toute l'assemblée n'a répondu que par de timides <w>hélas</w>."
                        }
                    ],
                    "common_phrases": [
                        "faire de grands hélas"
                    ]
                },
                {
                    "sense_id": "e503d2c3-26fb-3a92-aba6-e6c546be2804",
                    "sense_definition": "Bruit, vacarme ou retentissement sonore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au milieu de la nuit, un étrange <w>hélas</w> troubla soudainement le calme de la vallée."
                        },
                        {
                            "text": "On entendait résonner dans le lointain le terrible <w>hélas</w> des vagues sur la falaise."
                        }
                    ],
                    "synonyms": [
                        "bruit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96e06ecd-c88e-3bd1-838b-3e219359752e",
                    "sense_definition": "Deuxième personne du singulier du passé simple du verbe <w>héler</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lorsque le navire s'approcha du port, tu <w>hélas</w> les marins pour obtenir des secours."
                        },
                        {
                            "text": "Dès que tu aperçus ton guide dans la foule, tu l'<w>hélas</w> pour lui faire signe."
                        }
                    ]
                }
            ]
        }
    ]
}