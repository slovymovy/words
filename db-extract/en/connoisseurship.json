                        "examples": [
                            {
                                "example_id": "8d1e4a18-bab2-4cb1-82d0-8f7cf7ca83e2",
                                "sense_id": "48767151-56fd-32f6-be5e-cad652a688a6",
                                "text": "Reluctantly Bradly unrolled the canvas, which the trooper took from him to hold at arm's length, shutting one eye and crocking his neck sideways in a severe exercise of connoisseurship. Not satisfied with that system of inspecting a view, he had Cooley hold it against a biscuit tin, which required Cooley to cock an eye sideways to inspect it."
                            },
                            {
                                "example_id": "8a331cd9-6c5d-4358-8ebd-2a53d3f2df98",
                                "sense_id": "48767151-56fd-32f6-be5e-cad652a688a6",
                                "text": "In an economy where niche markets multiply as rapidly as Internet spam, the capacity for new, competitive connoisseurship is endless. Is that bread artisanal and part of the slow-food movement?"
                            }
                        ]
                    }
