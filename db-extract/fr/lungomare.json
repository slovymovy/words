                        "sense_id": "cd64493c-b97d-3783-85fc-2d925c5f1e81",
                        "entry_id": "f49f3a8b-ceff-392f-913c-b498c4b65f5f",
                        "glosses": [
                            "Rue longeant la mer, en Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1351592-5e07-4aff-a96f-79b1d7e3effc",
                                "sense_id": "cd64493c-b97d-3783-85fc-2d925c5f1e81",
                                "text": "Ce « lungomare » ne manque pas d’allure."
                            },
                            {
                                "example_id": "b99e2477-b8eb-4d64-82fb-81b29627dec3",
                                "sense_id": "cd64493c-b97d-3783-85fc-2d925c5f1e81",
                                "text": "Courant parallèlement au lungomare Marconi, la via Sandro Gallo relie le Piazzale Santa Maria Elisabetta à Malamocco, situé entre mer et lagune."
                            },
                            {
                                "example_id": "27f285d0-5af5-42ef-af93-d63f20086284",
                                "sense_id": "cd64493c-b97d-3783-85fc-2d925c5f1e81",
                                "text": "Dans la ville morte, où la tornade a brisé les énormes ficus et les palmiers alanguis du lungomare, l’étranger cherche vainement à apercevoir un bout de l’Etna, noyé dans la neige et dans la brume, sur cette Sicile « d’en face », séparée de l’ultime pointe de la botte italienne par quelques brasses d’eau grise."
                            }
                        ]
                    }
