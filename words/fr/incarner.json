            "senses": [
                {
                    "sense_id": "890135d7-7d22-31ca-aa18-f48649aed16d",
                    "sense_definition": "Interpréter ou jouer le rôle d'un personnage au théâtre ou au cinéma.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'actrice va <w>incarner</w> une reine célèbre dans son prochain long-métrage historique."
                        },
                        {
                            "text": "Il a réussi à <w>incarner</w> un personnage difficile avec beaucoup de justesse."
                        }
                    ],
                    "synonyms": [
                        "interpréter",
                        "jouer"
                    ],
                    "common_phrases": [
                        "incarner un rôle",
                        "incarner un personnage"
                    ]
                },
                {
                    "sense_id": "ee49b969-68f4-3e35-ae2f-8732ad09acb0",
                    "sense_definition": "Représenter concrètement ou personnifier une idée, une valeur ou un idéal abstrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune militant politique cherche à <w>incarner</w> le renouveau souhaité par les citoyens."
                        },
                        {
                            "text": "Par son dévouement remarquable, cette bénévole <w>incarne</w> l'espoir pour tout le quartier."
                        }
                    ],
                    "synonyms": [
                        "personnifier",
                        "symboliser",
                        "matérialiser"
                    ],
                    "common_phrases": [
                        "incarner l'espoir",
                        "incarner le renouveau"
                    ]
                },
                {
                    "sense_id": "3c85ede1-47a8-389a-a1d7-a49e78a9426a",
                    "sense_definition": "Prendre une forme humaine ou corporelle, en parlant d'un esprit ou d'une divinité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette mythologie, la déesse a choisi de s'<w>incarner</w> sous une apparence mortelle."
                        },
                        {
                            "text": "Certains textes religieux affirment que le divin s'est <w>incarné</w> parmi les êtres humains."
                        }
                    ],
                    "common_phrases": [
                        "s'incarner dans un corps"
                    ]
                },
                {
                    "sense_id": "61b95f36-bf99-3716-96e1-19fe15ed789d",
                    "sense_definition": "Pénétrer et pousser dans les tissus de la chair, en parlant d'un ongle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu coupes trop court cet ongle, il risque de s'<w>incarner</w> douloureusement."
                        },
                        {
                            "text": "Le médecin a retiré un ongle qui s'était profondément <w>incarné</w> dans son orteil."
                        }
                    ],
                    "common_phrases": [
                        "ongle incarné"
                    ]
                }
            ]
        }
    ]
