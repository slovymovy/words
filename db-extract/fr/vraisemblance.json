        "fr-extract.jsonl": [
            {
                "entry_id": "1609da8f-22f8-3ccc-91b7-5c88c404f49a",
                "word": "vraisemblance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "24dc21bf-26a2-4247-a3a5-8f1f5452a6a8",
                        "entry_id": "1609da8f-22f8-3ccc-91b7-5c88c404f49a",
                        "tags": [
                            "plural"
                        ],
                        "form": "vraisemblances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                        "entry_id": "1609da8f-22f8-3ccc-91b7-5c88c404f49a",
                        "glosses": [
                            "Apparence de vérité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1ac7b65-97d6-4116-9d53-6bf725a4029a",
                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                "text": "Cela choque la vraisemblance."
                            },
                            {
                                "example_id": "58c8611d-fd0e-4df7-abd4-e9a513eb04ab",
                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                "text": "Contre toute vraisemblance."
                            },
                            {
                                "example_id": "5e6b6dc3-1591-4d95-85a1-2bfcf51089d8",
                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                "text": "Malheureusement nous avons rarement des éléments suffisants pour reconstituer cette histoire avec vraisemblance. Les documents fossiles tertiaires sont assez rares […]."
                            },
                            {
                                "example_id": "7877055d-d37f-4eef-bdaa-4531a9cc2ba8",
                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                "text": "Faute de pouvoir faire toute la lumière désirable sur ce fait énigmatique, nous réunirons ici le faisceau de vraisemblances et de témoignages qui peuvent seuls nous éclairer pour le moment."
                            },
                            {
                                "example_id": "f799ab3c-04a2-4a91-93c6-067c73e2b88a",
                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                "text": "Il n’y a pas de vraisemblance à ce que vous dites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdcca63c-c331-4ab7-863d-2363d0a2c612",
                        "source_entry_id": "1609da8f-22f8-3ccc-91b7-5c88c404f49a",
                        "source_sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                        "target_lang_word": "Wahrscheinlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrscheinlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                        "entry_id": "2e301bed-7c58-3581-a271-2b32c0d467e1",
                                        "glosses": [
                                            "Grad von Möglichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9866c5-3f18-428a-9e86-0599dd22835c",
                                                "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                                "text": "Die Wahrscheinlichkeit, eine Sechs zu würfeln, beträgt im Idealfall 1/6, d. h. etwa 16,67 %."
                                            },
                                            {
                                                "example_id": "89ad1367-7fd1-448d-ac1a-1696726296e9",
                                                "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                                "text": "„Doch die Regeln der Wahrscheinlichkeit, fuhr Gauß fort, während er die Hände auf seinen schmerzenden Rücken preßte, gälten nicht zwingend.“"
                                            },
                                            {
                                                "example_id": "cbda7b8c-2915-4b92-983b-190a64274b24",
                                                "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                                "text": "„Mein Exemplar ist mit großer Wahrscheinlichkeit für einen Brief von einem Angehörigen der Marine an seine Familie im Heimatland genutzt worden.“"
                                            },
                                            {
                                                "example_id": "46b9a5c6-3279-42a1-b72e-c8a5ece5548e",
                                                "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                                "text": "„»Man kann mit großer Wahrscheinlichkeit sagen, dass es im vergangenen Vierteljahrtausend keine vergleichbare Dürre-Situation in Mitteleuropa gegeben hat.«“"
                                            },
                                            {
                                                "example_id": "148edc24-a0c4-443d-b614-a180cec04ba0",
                                                "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                                "text": "„»Anders als bei Passwörtern - die richtig oder falsch sind - gibt es bei Biometrie nur Wahrscheinlichkeiten der Übereinstimmung«, sagt Starbug [vom Chaos Computer Club].“"
                                            },
                                            {
                                                "example_id": "954e2162-df15-48d6-a560-abcb0e67df53",
                                                "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                                "text": "„Alle diese Behauptungen bauten sich nur auf Wahrscheinlichkeiten auf, doch man wird sehen, daß ich richtig geraten hatte.“"
                                            },
                                            {
                                                "example_id": "c5a08e51-c2ff-4fc1-90fa-abe899273237",
                                                "sense_id": "dab1b521-e04f-3c24-9b42-b44cdbedae34",
                                                "text": "„Die Studien zeigen aber vor allem eines: Klimaforscher arbeiten immer mit Wahrscheinlichkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ae05502-7d4f-462b-aa0c-4d1a7f1c3602",
                        "source_entry_id": "1609da8f-22f8-3ccc-91b7-5c88c404f49a",
                        "source_sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
