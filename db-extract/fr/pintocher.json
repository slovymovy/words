                        ],
                        "examples": [
                            {
                                "example_id": "234c7bec-8dd4-4a8e-a676-b0435ba7917e",
                                "sense_id": "54769fd7-8e98-374f-9035-c49b48172eb8",
                                "text": "Parole de Jos Violon, j'ai vu pintocher ben des fois dans ma profession de voyageur; et ben, ça me faisait chambranler rien qu'à le regarder faire."
                            },
                            {
                                "example_id": "b271bcc6-781a-4d6a-92ed-d0d7ed7abf60",
                                "sense_id": "54769fd7-8e98-374f-9035-c49b48172eb8",
                                "text": "il s'était même diverti, comme qui dirait, à pintocher tant soit peu avec ses connaissances de la Pointe- Lévis: il aimait un peu la goutte, le brave et honnête homme! à telle fin qu'il portait toujours, quand il voyageait, un flacon d'eau-de-vie dans son sac de loup-marin ;"
                            }
                        ]
                    }
