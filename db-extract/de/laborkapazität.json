                "senses": [
                    {
                        "sense_id": "6aeb208b-134f-330f-bab5-6eef2f8a92c2",
                        "entry_id": "d8e3f8a4-ec0a-3bd6-aedf-594e289a2ad9",
                        "glosses": [
                            "räumliche, zeitliche, finanzielle, organisatorische Möglichkeit und Ressourcen, abgleichende Untersuchungen (in einem Labor) durchzuführen"
                        ],
                        "tags": [
                            "Diagnostik",
                            "Analytik"
                        ],
                        "examples": [
                            {
                                "example_id": "e2b7805e-1071-47f2-b886-bf0032959972",
                                "sense_id": "6aeb208b-134f-330f-bab5-6eef2f8a92c2",
                                "text": "„Sollten die bislang gesteigerten Testkapazitäten im Verlauf wieder deutlich mehr in Anspruch genommen werden („zweite Welle“, Ausweitung von Reihentestungen im Zuge der Lockerung von Maßnahmen) sind aus Sicht der AG ggf. folgende Optionen zur weiteren Erhöhung der Testkapazitäten denkbar: Einbeziehung veterinärmedizinischer Labors […] für den Fall, dass die humanmedizinischen Laborkapazitäten nicht ausreichen.“"
                            },
                            {
                                "example_id": "0b980fb5-a169-48f6-ba9c-4cf05fc4b95f",
                                "sense_id": "6aeb208b-134f-330f-bab5-6eef2f8a92c2",
                                "text": "„Spätestens seit die Weltgesundheitsorganisation den Slogan „Test, Test, Test“ im Kampf gegen das Coronavirus ausgerufen hatte, gelten ausreichende Laborkapazitäten als Gradmesser im Kampf gegen die Pandemie.“"
                            },
                            {
                                "example_id": "399d5a83-f5a9-40aa-83ee-a263b7de2936",
                                "sense_id": "6aeb208b-134f-330f-bab5-6eef2f8a92c2",
                                "text": "„Eingehende Analysenaufträge werden dann nach Prioritäten bearbeitet, wobei die Verfügbarkeiten von Laborkapazität und Mitarbeitern zu berücksichtigen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
