                "senses": [
                    {
                        "sense_id": "c892f049-a2ea-334c-93c8-7834726c28a8",
                        "entry_id": "6daeb35c-d036-3c61-a40d-eed2fd9b653e",
                        "glosses": [
                            "свойство по значению прилагательного импозантный; способность кого-либо, чего-либо производить впечатление, внушать почтение; представительность, внушительность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "928a51e8-b621-4d7c-bd2d-9c5508491a89",
                                "sense_id": "c892f049-a2ea-334c-93c8-7834726c28a8",
                                "text": "Он производил впечатление своею импозантностью, спокойствием своих манер и крайнею, с одной стороны, твердостью, а с другой стороны — благодушием в лице"
                            },
                            {
                                "example_id": "0d07dbb6-51f1-458f-a0ca-9117df0afb3b",
                                "sense_id": "c892f049-a2ea-334c-93c8-7834726c28a8",
                                "text": "Однако видно было, что этому зданию не удастся господствовать в пейзаже: импозантности недоставало."
                            }
                        ]
                    }
