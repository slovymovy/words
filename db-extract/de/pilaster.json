                    {
                        "sense_id": "4302869b-ba6d-327e-bd05-cd76c93ee35d",
                        "entry_id": "e6a5107b-ec38-3e72-a862-8ec213bef54d",
                        "glosses": [
                            "teilweise in den Mauerverbund integrierter Pfeiler mit Basis und Kapitell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d9bb00-06b2-46c7-b214-4ff2b423cc52",
                                "sense_id": "4302869b-ba6d-327e-bd05-cd76c93ee35d",
                                "text": "„Zur Wandgestaltung und -gliederung wurden Pilaster bereits in der antiken griechischen Architektur verwendet […].“"
                            },
                            {
                                "example_id": "4a84f24a-84a8-489c-8015-e02f1e05a993",
                                "sense_id": "4302869b-ba6d-327e-bd05-cd76c93ee35d",
                                "text": "„An den steinernen Pilastern waren in mittlerer Höhe eiserne Kanzeln angebracht, auf denen kommissarische Verwalter in der städtischen Amtstracht standen, die den Gang des lärmenden Getriebes überwachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
