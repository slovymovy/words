                        ],
                        "examples": [
                            {
                                "example_id": "55bdf45c-e789-4aa2-a9c8-7c4caf511b4b",
                                "sense_id": "5c2d0667-722d-3f02-8c40-af5307a3d1fe",
                                "text": "Predikanten en ouderlingen hebben volgens hun ambt zitting in het consistorie."
                            }
                        ]
                    },
                    {
                        "sense_id": "c278f6fd-6cd9-35c0-9c2c-350d1a9a058c",
