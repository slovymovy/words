                        "glosses": [
                            "An earthworm, used as or destined to be used as bait to catch fish."
                        ],
                        "tags": [
                            "Northern-US"
                        ],
                        "examples": [
                            {
                                "example_id": "c014bd36-fad1-4262-b209-c5558ef0d1c8",
                                "sense_id": "7fb417f3-e8a4-3ac8-bdfd-d3d8f61ea934",
                                "text": "A bird came down the walk : / He did not know I saw ; / He bit an angle-worm in halves / And ate the fellow, raw."
                            },
                            {
                                "example_id": "7d206a22-8083-4e5e-a2e5-4799b93d9240",
                                "sense_id": "7fb417f3-e8a4-3ac8-bdfd-d3d8f61ea934",
                                "text": "He turned again to where his clan\nIn one astounding tangle\nWith eager haste together ran\nTo slay the helpless angle"
                            }
                        ]
                    }
