                    {
                        "translation_id": "7632b531-c1e0-4ad4-816f-add89039ddb5",
                        "source_entry_id": "d9557c44-5978-3927-9ae4-43bf2c440cc2",
                        "source_sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                        "source_sense_description": "study of molluscs",
                        "target_lang_word": "malacologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malacologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31be6cf7-a458-3378-9461-f68c6483a70e",
                                        "entry_id": "38b45346-5e7a-33d9-a96e-44b0f1cbbd31",
                                        "glosses": [
                                            "Branche de la zoologie consacrée à l’étude des mollusques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c613417-4590-4744-921b-380ff03a5c90",
                                                "sense_id": "31be6cf7-a458-3378-9461-f68c6483a70e",
                                                "text": "En échange de mes menus services, il m’initiait à la malacologie et me donnait quantité de coquilles de mollusques terrestres et d’eau douce pour que je fasse chez moi une collection en règle."
                                            },
                                            {
                                                "example_id": "664a76c5-02df-42ba-bdad-cb94a8ddbb98",
                                                "sense_id": "31be6cf7-a458-3378-9461-f68c6483a70e",
                                                "text": "Ces premiers éléments de connaissance ont été présentés lors du colloque national de malacologie continentale qui s’est tenu à Laon fin mars et seront publiés dans le journal Malaco."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7eca2142-978f-45f3-9441-2b231d31b1c6",
                        "source_entry_id": "d9557c44-5978-3927-9ae4-43bf2c440cc2",
                        "source_sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                        "source_sense_description": "study of molluscs",
                        "target_lang_word": "Malakologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Malakologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3542c235-8dec-3ce1-84a4-5c64bddabffd",
                                        "entry_id": "4e112404-5eea-3531-88ae-d434081ccc48",
                                        "glosses": [
                                            "die wissenschaftliche Lehre von und die Beschäftigung mit den Weichtieren oder Mollusken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f27fa3e-3257-4fc0-b183-e5e559099b1f",
                                                "sense_id": "3542c235-8dec-3ce1-84a4-5c64bddabffd",
                                                "text": "„Mein alter Lehrer der Malakologie war ein begeisterter Verehrer Lamarcks, aber er riet uns dringend von seinen verderblichen philosophischen Neigungen ab.“"
                                            },
                                            {
                                                "example_id": "3284c7fb-d52b-4e8a-9808-fefdd55e1919",
                                                "sense_id": "3542c235-8dec-3ce1-84a4-5c64bddabffd",
                                                "text": "„Der von den Colonisten begangene Strand erschien mit unzähligen Muscheln bedeckt, deren einige Arten einem Liebhaber der Malakologie.“"
                                            },
                                            {
                                                "example_id": "224397e1-04cb-4d05-b8ee-c1c140e4fc86",
                                                "sense_id": "3542c235-8dec-3ce1-84a4-5c64bddabffd",
                                                "text": "„Aber zur Einführung in das Studium der Malakologie bietet das Buch eine ausreichende, tüchtige und nirgends einseitige Grundlage, und der Vorgeschrittene wird noch viele Anregung darin finden.“"
                                            },
                                            {
                                                "example_id": "583f1ca4-e529-40b1-8709-b6aef091b20e",
                                                "sense_id": "3542c235-8dec-3ce1-84a4-5c64bddabffd",
                                                "text": "„Ein Liebhaber der Malakologie hätte seine Sternstunde erlebt, wenn er mit den Siedlern über den Strand spaziert wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
