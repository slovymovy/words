                        "entry_id": "d9ef8659-5f43-3e26-9208-382ac5b765b4",
                        "glosses": [
                            "Of a writing system in which a particular symbol represents more than one possible sound."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a91d3d5d-c6fa-4736-92a8-ba018668a069",
                                "sense_id": "0e6007c6-0d7e-3d8c-9991-e5e10e3f524d",
                                "text": "In English. many letters are heterographic."
                            },
                            {
                                "example_id": "36272169-e420-47c3-a025-d32655495ce7",
                                "sense_id": "0e6007c6-0d7e-3d8c-9991-e5e10e3f524d",
                                "text": "Quite often, more than one heterographic monosyllable […] can represent the same mononym in particular contexts if they are semantically indifferentiable."
                            },
                            {
                                "example_id": "67989658-c133-4faa-b33d-8d5a01af2268",
                                "sense_id": "0e6007c6-0d7e-3d8c-9991-e5e10e3f524d",
                                "text": "English has few such heterophonic homographs, hence much of the work in English (and French) examining orthography-phonology consistency effects at the whole-word level has focused on heterographic homophones."
                            }
                        ]
                    }
