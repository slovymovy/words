                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0952d262-9397-3bea-ac20-f899fffb558d",
                                        "entry_id": "3ebdca52-0655-3174-9c7c-861757a0ffc7",
                                        "glosses": [
                                            "Pièce de verre concave utilisée pour peser de petits volumes de solide (quelques cm³) ou pour couvrir un bécher de taille adaptée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aef8b34e-8f63-459b-8205-0353276ec40e",
                                                "sense_id": "0952d262-9397-3bea-ac20-f899fffb558d",
                                                "text": "Je n’ai jamais vu manquer cet effet avec quelque variété de pus que ce fût ; l’opération se fait très-commodément dans des verres de montre."
                                            },
                                            {
                                                "example_id": "90d43b63-ab46-4ef1-8945-a76e24c8d653",
                                                "sense_id": "0952d262-9397-3bea-ac20-f899fffb558d",
                                                "text": "Après refroidissement, ajouter 5 ml d’acide nitrique concentré, couvrir d’un verre de montre et remettre le bécher sur la plaque chauffante en maintenant un doux reflux."
                                            }
                                        ]
                                    }
                                ]
                            }
