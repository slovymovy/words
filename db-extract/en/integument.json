                    {
                        "translation_id": "eefd9028-8b45-465c-9498-c9f5cfa23ea3",
                        "source_entry_id": "100725e1-4968-31eb-bf07-6d3f6442c7de",
                        "source_sense_description": "outer protective covering of body",
                        "target_lang_word": "huid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c0b83e-1fa6-3030-adec-e34705a2ef3d",
                                        "entry_id": "8558c4ef-42ed-363b-a5b1-7792fe207c27",
                                        "glosses": [
                                            "vel, de buitenste laag weefsel die het lichaam bedekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f345d3ae-795a-4db9-9410-de3ca33c7d71",
                                                "sense_id": "d0c0b83e-1fa6-3030-adec-e34705a2ef3d",
                                                "text": "' Hij drukt zijn lippen tegen mijn voorhoofd, waarbij ik zijn baard voel kriebelen tegen mijn huid."
                                            },
                                            {
                                                "example_id": "b84d35ed-cf9e-4709-baf2-49343002c502",
                                                "sense_id": "d0c0b83e-1fa6-3030-adec-e34705a2ef3d",
                                                "text": "Met een huid als een panter zigzagde hij door het water."
                                            },
                                            {
                                                "example_id": "a2d908d4-76ab-4a02-86a5-87f24438e36f",
                                                "sense_id": "d0c0b83e-1fa6-3030-adec-e34705a2ef3d",
                                                "text": "Door het zweet en constante wrijving werd mijn huid tussen mijn dijen en billen bij elke stap opengeschuurd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5fdd4e0-53c9-30dd-b2e1-164ed5e1b6c5",
                                        "entry_id": "8558c4ef-42ed-363b-a5b1-7792fe207c27",
                                        "glosses": [
                                            "afgestroopt vel om bont of leer van te maken"
                                        ],
                                        "tags": [
                                            "materiaalkunde"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bbdaa6b-bea5-3d75-b150-e7705b921712",
                                        "entry_id": "8558c4ef-42ed-363b-a5b1-7792fe207c27",
                                        "glosses": [
                                            "de buitenbekleding van een schip"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f77ab7ae-84f3-4d93-b757-b08562abf9f9",
                        "source_entry_id": "100725e1-4968-31eb-bf07-6d3f6442c7de",
                        "source_sense_description": "outer protective covering of body",
                        "target_lang_word": "tégument",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tégument",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                        "entry_id": "2e8d3507-9628-3e0e-b0af-7d3fdeaa96c1",
                                        "glosses": [
                                            "Tissu organique qui recouvre le corps des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d143c6bc-5405-4316-8213-4ee0633e9fba",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Que l'on considère l'homme, les animaux quadrupèdes, les oiseaux, les cétacées, les poissons, les amphibies, les reptiles; quelle prodigieuse variété dans la figure, dans la proportion de leur corps, dans le nombre et dans la position de leurs membres, dans la substance de leur chair, de leurs os, de leurs téguments !"
                                            },
                                            {
                                                "example_id": "b93e6acd-e04a-4a49-b700-89dd16aaa739",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Mais ne pouvant penser à la fois à ce que j’étais et à ce que je serais, je pensais avec désespoir à tout ce tégument de caresses, de baisers, de sommeils amis, dont il faudrait bientôt me laisser dépouiller pour jamais."
                                            },
                                            {
                                                "example_id": "06ac431f-d065-4430-8f53-87b98398ee6d",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Cette larve peut vivre deux jours. Elle doit trouver une limnée (petit gastéropode aquatique) et pénétrer activement à travers son tégument."
                                            },
                                            {
                                                "example_id": "dff7ba26-ce48-4080-bc15-938a9803f6cf",
                                                "sense_id": "450de327-2b7b-36ed-be5e-c7213ba2c1a5",
                                                "text": "Vous me prenez pour un con, a fait encore observer le commanditaire en pâlissant - ce qui renforçait le contraste entre ses lunettes sombres et son tégument blême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0d0ac90-bd30-3af9-9b5f-e81ceb540dc5",
                                        "entry_id": "2e8d3507-9628-3e0e-b0af-7d3fdeaa96c1",
                                        "glosses": [
                                            "Enveloppe de l’ovule ou de la graine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e90f5b4-ec24-4872-80cf-60ce68d1f57f",
                                                "sense_id": "a0d0ac90-bd30-3af9-9b5f-e81ceb540dc5",
                                                "text": "C’est au niveau du tégument que se réalise une partie des échanges de matières et d’informations entre l’organisme et le milieu qui l’entoure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3e7fa39-e135-40fa-8740-9c69f8e40544",
                        "source_entry_id": "100725e1-4968-31eb-bf07-6d3f6442c7de",
                        "source_sense_description": "outer protective covering of body",
                        "target_lang_word": "покро́в",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "покро́в",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "651843cf-14f9-37e9-8f76-76a8926dab82",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "верхний наружный слой, покрывающий что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e750f981-35aa-4497-8f54-bf52249e2f81",
                                                "sense_id": "651843cf-14f9-37e9-8f76-76a8926dab82",
                                                "text": "На всём лежал холодный матовый покров ещё падавшей, не освещённой солнцем росы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac485588-e247-3f9d-a8f0-b2ea65adb72d",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "анат. оболочка, покрывающая организм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e330841a-fc49-4e1e-aad0-23757af5b860",
                                                "sense_id": "ac485588-e247-3f9d-a8f0-b2ea65adb72d",
                                                "text": "Волосяной покров"
                                            },
                                            {
                                                "example_id": "e4fabef7-b4c3-4a10-8613-85369a07ca0f",
                                                "sense_id": "ac485588-e247-3f9d-a8f0-b2ea65adb72d",
                                                "text": "Для зрелой кожи выбирайте маску с лифтинговым действием, чтобы укрепить и поддержать кожный покров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd69cc6-350e-36ff-a227-2ccd59a66929",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "устар. покровительство, защита"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce359f4-8a22-4079-bd34-ade0867975e2",
                                                "sense_id": "dcd69cc6-350e-36ff-a227-2ccd59a66929",
                                                "text": "Мальчишки разогнали псов, // Взяв барышню под свой покров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4501fb7b-febf-3e5b-9ae4-f8bfa1f3a7dc",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "устар. то же, что покрывало"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b908561-d84f-467b-8171-d53df83ed6c8",
                                                "sense_id": "4501fb7b-febf-3e5b-9ae4-f8bfa1f3a7dc",
                                                "text": "Иудушка притворялся чуть живым, шаркал по коридору, заходил к «покойничку», умилялся, поправлял на гробе покров и шептался с становым приставом, который составлял описи и прикладывал печати."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4013c49b-c6e5-303e-b885-d62b95fe4b08",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "устар. большой платок, которым покрывают голову невесты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0be732-68f0-47c5-a5e6-7d653a56e54c",
                                                "sense_id": "4013c49b-c6e5-303e-b885-d62b95fe4b08",
                                                "text": "Покров богат — парчу вы рассмотрели? // У брата моего прошедшею весной // На гробе был точь-в-точь такой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c2630d-4549-33c8-a404-c61d8ad70026",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "то, что укрывает собою что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e886ae-6522-432a-9b87-af160fe5fe2f",
                                                "sense_id": "54c2630d-4549-33c8-a404-c61d8ad70026",
                                                "text": "Под покровом тайны"
                                            },
                                            {
                                                "example_id": "f285d48b-50de-4fce-9103-a289746fe123",
                                                "sense_id": "54c2630d-4549-33c8-a404-c61d8ad70026",
                                                "text": "Под покровом ночи"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
