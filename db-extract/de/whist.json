                                            {
                                                "example_id": "aa497652-b16d-493a-9291-ecec95b2e5cc",
                                                "sense_id": "93d0590a-aae1-3669-a91a-6daeb0464dc6",
                                                "text": "Скоро всё общество разделилось на четвёртые партии в вист и расселось в разных углах генеральских комнат."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e29d6f9-3dce-33bc-bdde-6d5b1471be49",
                                        "entry_id": "60fdac0b-a560-3964-a37b-fcd3dee8cd79",
                                        "glosses": [
                                            "карт. в некоторых карточных играх (например, в преферанс) взятка вистующего игрока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13eb0f35-2d20-4e81-81c2-550abfb8fadf",
                                                "sense_id": "6e29d6f9-3dce-33bc-bdde-6d5b1471be49",
                                                "text": "На семерной игре вистующим надо взять два виста, а не три."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bea359-4d4c-3e1a-b7c0-d5959831d101",
                                        "entry_id": "60fdac0b-a560-3964-a37b-fcd3dee8cd79",
                                        "glosses": [
                                            "карт. (обычно во мн. ч.) место для записи очков игрока в преферанс, набранных на вистах [2] против другого игрока"
                                        ],
