                "senses": [
                    {
                        "sense_id": "227e4950-b4c8-3cbe-8235-72a4f97383e2",
                        "entry_id": "dd84aa45-24c6-380e-bcf7-77cbc62cb1ac",
                        "glosses": [
                            "innerer Bereich eines Hauses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2e3428-abff-4cec-9178-afb0bf547e85",
                                "sense_id": "227e4950-b4c8-3cbe-8235-72a4f97383e2",
                                "text": "„Ich wollte wissen, mit wem ich es zu tun hatte, bevor ich seinen fachmännischen Blick auf mein Hausinneres zuließ.“"
                            },
                            {
                                "example_id": "3930080f-df38-4101-a866-85fb3fbfae76",
                                "sense_id": "227e4950-b4c8-3cbe-8235-72a4f97383e2",
                                "text": "„Das Bühnenbild zeigt ein Hausinneres, das gleichzeitig als Wohnraum, Laden und Ausstellungsraum dient.“"
                            },
                            {
                                "example_id": "19555fca-f2ba-4fc2-9124-77581cce29b2",
                                "sense_id": "227e4950-b4c8-3cbe-8235-72a4f97383e2",
                                "text": "„Karstadt will sein Hausinneres umstrukturieren: Die bisherige Fläche werde in zwei halbe Zentren aufgegliedert, die sich das Unternehmen eventuell mit einer anderen Firma teilen werde, sagte Ziegler.“"
                            },
                            {
                                "example_id": "e3161453-21f2-4b2d-b59f-b3bd6804602c",
                                "sense_id": "227e4950-b4c8-3cbe-8235-72a4f97383e2",
                                "text": "„Beklommen suchte ich mit den Augen das Hausinnere zu durchdringen, das nachtschwarz wie ein Bergwerk ins Ungewisse ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
