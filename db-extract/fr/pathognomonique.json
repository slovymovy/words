                        "entry_id": "75921478-7092-33df-9979-9c366a3cff50",
                        "glosses": [
                            "Caractéristique d’une maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd228ef7-b650-4767-99e0-68b8ca410d38",
                                "sense_id": "64503600-4dc0-3f40-a3d1-90102539d9d3",
                                "text": "Les symptômes pathognomoniques de la fluxion périodique ne se révélant souvent que dans un temps indéterminé et parfois très-éloigné, des fourrières interminables et des procès ruineux en sont la conséquence."
                            },
                            {
                                "example_id": "37caeea4-14f4-4f5e-8c9d-f8288a5f8890",
                                "sense_id": "64503600-4dc0-3f40-a3d1-90102539d9d3",
                                "text": "L’auscultation cardiaque recherche la pathognomonique vibrance péricardique, témoignant de la calcification péricardique."
                            },
                            {
                                "example_id": "638750d9-4485-4240-b6c5-8cc1b2fcf356",
                                "sense_id": "64503600-4dc0-3f40-a3d1-90102539d9d3",
                                "text": "En aucun cas par conséquent l’auto-mutilation en elle-même ne peut être le signe pathognomonique d’une affection mentale déterminée."
                            },
                            {
                                "example_id": "74428e3b-18e7-4d8d-aa9f-0964e042b712",
                                "sense_id": "64503600-4dc0-3f40-a3d1-90102539d9d3",
                                "text": "Les taches de Koplik … précèdent souvent l'exanthème généralisé et sont pathognomoniques de la rougeole."
                            }
                        ]
                    }
                ],
