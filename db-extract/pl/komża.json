                                        "sense_id": "8d9dc651-3061-3186-9fb2-3544f1ae63aa",
                                        "entry_id": "187dca41-65f6-31e5-818b-91163bcd4eb7",
                                        "glosses": [
                                            "část oděvu, kterou nosí osoby přisluhující při církevních obřadech"
                                        ],
                                        "tags": [],
