                            {
                                "target_lang_word": "zogend",
                                "target_lang_sense_clarification": "als tegenwoordig deelwoord van zogen"
                            },
                            {
                                "target_lang_word": "de borst gevend",
                                "target_lang_sense_clarification": "melk gevend aan een jong of kind"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c512dfa-fa8e-3e5c-b1e5-a68478deaea7",
                    "sense_definition": "A young mammal that has not yet been weaned and is still feeding on its mother's milk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "young_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef ordered a roasted <w>suckling</w> pig for the holiday banquet.",
                            "target_lang_translations": {
                                "nl": "De chef-kok bestelde een geroosterd <w>speenvarken</w> voor het feestbanket."
                            }
                        },
                        {
                            "text": "The wolves kept a close watch over every vulnerable <w>suckling</w> in the den.",
                            "target_lang_translations": {
                                "nl": "De wolven hielden elke kwetsbare <w>zuigeling</w> in het hol nauwlettend in de gaten."
                            }
                        }
                    ],
                    "antonyms": [
                        "weanling"
                    ],
                    "common_phrases": [
                        "suckling pig"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een jong zoogdier dat nog niet is gespeend en zich nog voedt met moedermelk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuigeling",
                                "target_lang_sense_clarification": "jong dier dat nog melk drinkt"
                            },
                            {
                                "target_lang_word": "speenvarken",
                                "target_lang_sense_clarification": "specifiek voor een jong varken ('suckling pig')"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7c8adcf-ad3e-3dee-8aae-bb346aa53af2",
                    "sense_definition": "A very young baby that is still being breastfed by its mother.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "infant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the historical novel, the woman carried her helpless <w>suckling</w> across the snowy border.",
                            "target_lang_translations": {
                                "nl": "In de historische roman droeg de vrouw haar hulpeloze <w>zuigeling</w> over de besneeuwde grens."
                            }
                        },
                        {
                            "text": "Ancient texts often spoke of protecting mothers and each fragile <w>suckling</w> during times of famine.",
                            "target_lang_translations": {
                                "nl": "Oude teksten spraken er vaak over om moeders en elk kwetsbaar <w>borstkind</w> te beschermen in tijden van hongersnood."
                            }
                        }
                    ],
                    "synonyms": [
                        "infant",
                        "babe",
                        "nursling"
                    ],
                    "common_phrases": [
                        "babes and sucklings"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used chiefly in older or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een heel jong kind of baby dat nog borstvoeding krijgt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuigeling",
                                "target_lang_sense_clarification": "baby die nog gezoogd wordt"
                            },
                            {
                                "target_lang_word": "borstkind",
                                "target_lang_sense_clarification": "kind dat borstvoeding krijgt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b7930fd-cc6a-3c71-87d0-f2e1a1271dca",
                    "sense_definition": "The act of nursing or feeding young with milk from the breast or udder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nursing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The zoologist recorded the frequent <w>suckling</w> of the newborn calves during their first week.",
                            "target_lang_translations": {
                                "nl": "De zoöloog legde het frequente <w>zogen</w> van de pasgeboren kalveren tijdens hun eerste week vast."
                            }
                        },
                        {
                            "text": "Successful <w>suckling</w> is essential for delivering vital nutrients and antibodies to young animals.",
                            "target_lang_translations": {
                                "nl": "Succesvol <w>zuigen</w> is essentieel voor het overbrengen van vitale voedingsstoffen en antilichamen naar jonge dieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "nursing",
                        "lactation",
                        "breastfeeding"
                    ],
                    "antonyms": [
                        "weaning"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het zogen of het voeden van jongen met melk uit de borst of uier."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zogen",
                                "target_lang_sense_clarification": "het geven van melk"
                            },
                            {
                                "target_lang_word": "zuigen",
                                "target_lang_sense_clarification": "het drinken aan de borst/uier"
                            }
                        ]
                    }
                }
            ]
        }
    ]
