                                "target_senses": [
                                    {
                                        "sense_id": "fa54af1b-87fd-3da2-b7e1-b060233cd7ca",
                                        "entry_id": "fc6d1649-e207-347b-a29d-d828026b016d",
                                        "glosses": [
                                            "Cérémonie ou prestation réservée à un nouvel arrivant, consistant généralement à lui souhaiter la bienvenue et à l’aider dans son intégration ou ses démarches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7276fe75-bb0e-4155-b06a-460397bca9f2",
                                                "sense_id": "fa54af1b-87fd-3da2-b7e1-b060233cd7ca",
                                                "text": "Nous réservâmes aux nouveaux venus un accueil qui fut cordial et empressé, mais le temps n’était pas aux effusions et d’un commun avis, il fallait agir vite."
                                            },
                                            {
                                                "example_id": "ea87930f-ccbc-45c7-a900-4aa4d29c73d0",
                                                "sense_id": "fa54af1b-87fd-3da2-b7e1-b060233cd7ca",
                                                "text": "Partout elle avait trouvé bon accueil, prompt assentiment, mais elle se propose d’aller plus outre."
                                            },
                                            {
                                                "example_id": "9de4ed00-bb2a-46fe-b338-8fcf17580f1d",
                                                "sense_id": "fa54af1b-87fd-3da2-b7e1-b060233cd7ca",
                                                "text": "Notre hôte, absent au moment de notre arrivée, ne tarde pas à paraître et me fait l’accueil auquel je m'attendais de sa part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc2d0bb1-4f9c-3843-85d8-7c80df3e6b73",
                                        "entry_id": "fc6d1649-e207-347b-a29d-d828026b016d",
                                        "glosses": [
                                            "Lieu où sont accueillies les personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf1ba50-1f8c-4242-97d8-9dc60df07186",
                                                "sense_id": "fc2d0bb1-4f9c-3843-85d8-7c80df3e6b73",
                                                "text": "À l’accueil, ils t’expliqueront comment aller à son bureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fc775cc-4ddf-366c-a9b3-dd3e49ab518b",
                                        "entry_id": "fc6d1649-e207-347b-a29d-d828026b016d",
                                        "glosses": [
                                            "Fait d’accueillir ou héberger."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ce03f7-248e-4bfe-b9ac-1fc735816a1c",
                                                "sense_id": "1fc775cc-4ddf-366c-a9b3-dd3e49ab518b",
                                                "text": "Le Maire rappelle au conseil municipal que l’accueil périscolaire aura lieu à la rentrée de septembre 2008–2009 dans la salle de réunions et le petit local attenant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e1e2389-0cda-3c5f-ae70-c26360a1ced8",
                                        "entry_id": "fc6d1649-e207-347b-a29d-d828026b016d",
