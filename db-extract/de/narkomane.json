                        "source_sense_id": "79c9c966-c4e1-3238-8d08-d8ae838d9978",
                        "source_sense_description": "Medizin: Person, die nach Schlafmitteln oder Betäubungsmitteln süchtig ist, an Narkomanie leidet",
                        "target_lang_word": "addict",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
