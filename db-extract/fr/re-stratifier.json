                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de restratifier (stratifier à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d83f7a0-4f0f-4215-bd37-9d316ec75c49",
                                "sense_id": "ab45a235-1a85-3544-87cc-d084fa7f554b",
                                "text": "Des écritures mathématiques se font axiomatiser, c’est-à-dire re-stratifier, re-sémiotiser ; des flux matériels se font rephysicaliser."
                            },
                            {
                                "example_id": "7ecbbb91-fb68-428c-aca9-e62e0f79d1bd",
                                "sense_id": "ab45a235-1a85-3544-87cc-d084fa7f554b",
                                "text": "Coup de Skype avec l’expert de l'assurance et avec le chantier Wauquiez (Merci encore Wim !) : pas très grave dans la mesure où cette stratification n’est pas structurelle, mais il faut descendre complètement la quille pour re-poncer le fond de coque, re-stratifier et re-coller."
                            }
                        ]
                    }
