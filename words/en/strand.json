{
    "word_family": [
        "stranded",
        "stranding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "788aca8d-ea1d-3c98-816e-6e823c4cdc0a",
                    "sense_definition": "An individual length of any fine, string-like substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "string_like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully brushed a single <w>strand</w> of hair away from her face.",
                            "target_lang_translations": {
                                "ru": "Она осторожно убрала с лица одну <w>прядь</w> волос.",
                                "de": "Sie strich sich vorsichtig eine einzelne <w>Strähne</w> aus dem Gesicht."
                            }
                        },
                        {
                            "text": "The chef served a long <w>strand</w> of spaghetti to test if it was cooked.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар подал длинную <w>нитку</w> спагетти, чтобы проверить, готова ли она.",
                                "de": "Der Koch servierte einen langen <w>Faden</w> Spaghetti, um zu prüfen, ob sie gar waren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strand of hair",
                        "strand of spaghetti"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная нить или волокно любого тонкого, похожего на веревку вещества.",
                        "de": "Ein einzelner, dünner, fadenartiger Teil einer Substanz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прядь",
                                "target_lang_sense_clarification": "волос"
                            },
                            {
                                "target_lang_word": "нитка",
                                "target_lang_sense_clarification": "спагетти или тонкое волокно"
                            },
                            {
                                "target_lang_word": "волосок",
                                "target_lang_sense_clarification": "один волос"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strähne",
                                "target_lang_sense_clarification": "für Haare"
                            },
                            {
                                "target_lang_word": "Faden",
                                "target_lang_sense_clarification": "für dünne Fasern oder Lebensmittel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2171e908-d9d4-3241-bbee-55d79c1d9816",
                    "sense_definition": "Each of the strings which, twisted together, make up a yarn, rope or cord.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "string_like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick rope was made of several smaller <w>strands</w> of hemp.",
                            "target_lang_translations": {
                                "ru": "Толстая веревка была сделана из нескольких более мелких конопляных <w>прядей</w>.",
                                "de": "Das dicke Seil bestand aus mehreren kleineren <w>Strängen</w> aus Hanf."
                            }
                        },
                        {
                            "text": "If one <w>strand</w> breaks, the entire cable might lose its strength.",
                            "target_lang_translations": {
                                "ru": "Если одна <w>жила</w> порвется, весь кабель может потерять прочность.",
                                "de": "Wenn ein <w>Strang</w> reißt, könnte das gesamte Kabel an Festigkeit verlieren."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждая из нитей, которые при скручивании вместе образуют пряжу, канат или шнур.",
                        "de": "Jeder der Fäden, die miteinander verzwirnt ein Garn, ein Seil oder ein Kabel bilden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прядь",
                                "target_lang_sense_clarification": "составная часть троса"
                            },
                            {
                                "target_lang_word": "жила",
                                "target_lang_sense_clarification": "проволока в кабеле"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "составляющая веревки"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strang",
                                "target_lang_sense_clarification": "Bestandteil eines Seils"
                            },
                            {
                                "target_lang_word": "Litze",
                                "target_lang_sense_clarification": "elektrischer Leiter oder Seilbestandteil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44615ef9-a19a-3b7b-8b32-87b84883c340",
                    "sense_definition": "The shore or beach of the sea or ocean.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipwrecked sailors were finally washed up on a lonely <w>strand</w>.",
                            "target_lang_translations": {
                                "ru": "Потерпевших кораблекрушение моряков в конце концов выбросило на пустынный <w>берег</w>.",
                                "de": "Die schiffbrüchigen Matrosen wurden schließlich an einen einsamen <w>Strand</w> gespült."
                            }
                        },
                        {
                            "text": "They walked along the sandy <w>strand</w> as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Они гуляли по песчаному <w>пляжу</w>, когда солнце начало садиться.",
                                "de": "Sie gingen am sandigen <w>Strand</w> entlang, als die Sonne unterging."
                            }
                        }
                    ],
                    "synonyms": [
                        "beach"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often used in literary or poetic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Берег или пляж моря или океана (часто в поэтическом контексте).",
                        "de": "Das Ufer oder der Sandbereich am Meer oder Ozean."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "берег",
                                "target_lang_sense_clarification": "морской"
                            },
                            {
                                "target_lang_word": "пляж",
                                "target_lang_sense_clarification": "песчаный"
                            },
                            {
                                "target_lang_word": "взморье",
                                "target_lang_sense_clarification": "поэтическое"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strand",
                                "target_lang_sense_clarification": "allgemein"
                            },
                            {
                                "target_lang_word": "Küste",
                                "target_lang_sense_clarification": "geografischer Küstenstreifen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53607cf4-e91e-3296-b69e-e82ec066bbf0",
                    "sense_definition": "An element in a composite whole; a sequence of linked events or facts; a logical thread.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_thread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective tried to follow every <w>strand</w> of truth in the witness's story.",
                            "target_lang_translations": {
                                "ru": "Детектив пытался проследить за каждой <w>нитью</w> правды в рассказе свидетеля.",
                                "de": "Der Detektiv versuchte, jedem <w>Faden</w> der Wahrheit in der Geschichte des Zeugen zu folgen."
                            }
                        },
                        {
                            "text": "There is a common <w>strand</w> of thought running through all his novels.",
                            "target_lang_translations": {
                                "ru": "Через все его романы проходит общая <w>линия</w> мысли.",
                                "de": "Ein gemeinsamer <w>Strang</w> zieht sich durch alle seine Romane."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strand of truth",
                        "strand of the story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент сложного целого; последовательность связанных событий или фактов; логическая нить.",
                        "de": "Ein Element eines Ganzen; eine Abfolge von Ereignissen oder eine logische Verbindung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "повествования или рассуждения"
                            },
                            {
                                "target_lang_word": "линия",
                                "target_lang_sense_clarification": "сюжетная"
                            },
                            {
                                "target_lang_word": "аспект",
                                "target_lang_sense_clarification": "составляющая часть"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strang",
                                "target_lang_sense_clarification": "logische oder erzählerische Linie"
                            },
                            {
                                "target_lang_word": "Faden",
                                "target_lang_sense_clarification": "im Sinne von 'den Faden verlieren'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bddaf1c4-a515-3c5a-8c78-1305f83412fa",
                    "sense_definition": "A nucleotide chain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "string_like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "DNA is composed of two <w>strands</w> that form a double helix.",
                            "target_lang_translations": {
                                "ru": "ДНК состоит из двух <w>цепей</w>, образующих двойную спираль.",
                                "de": "DNA besteht aus zwei <w>Strängen</w>, die eine Doppelhelix bilden."
                            }
                        },
                        {
                            "text": "Scientists are studying how a single <w>strand</w> of RNA replicates itself.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают, как одна <w>цепочка</w> РНК воспроизводит себя.",
                                "de": "Wissenschaftler untersuchen, wie sich ein einzelner <w>Strang</w> RNA selbst repliziert."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нуклеотидная цепь.",
                        "de": "Eine Kette aus Nukleotiden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепь",
                                "target_lang_sense_clarification": "ДНК или РНК"
                            },
                            {
                                "target_lang_word": "цепочка",
                                "target_lang_sense_clarification": "генетическая"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "биологическая"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strang",
                                "target_lang_sense_clarification": "biologisch, z.B. DNA-Strang"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "273aee8c-5683-3439-ad0f-cdc4670f3b80",
                    "sense_definition": "To leave someone in a difficult situation; to abandon or desert.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abandonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline strike will <w>strand</w> thousands of passengers at the airport.",
                            "target_lang_translations": {
                                "ru": "Забастовка авиакомпании <w>оставит</w> тысячи пассажиров в аэропорту без возможности улететь.",
                                "de": "Der Streik der Fluggesellschaft wird Tausende Passagiere am Flughafen <w>stranden</w> lassen."
                            }
                        },
                        {
                            "text": "Do not <w>strand</w> your friends in a strange city without a map.",
                            "target_lang_translations": {
                                "ru": "Не <w>бросайте</w> своих друзей в чужом городе без карты.",
                                "de": "Lass deine Freunde nicht in einer fremden Stadt ohne Karte <w>im Stich</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "desert",
                        "maroon",
                        "leave behind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставить кого-либо в трудной ситуации; бросить или покинуть.",
                        "de": "Jemanden in einer schwierigen Lage zurücklassen; im Stich lassen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросить",
                                "target_lang_sense_clarification": "в беде"
                            },
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "без помощи"
                            },
                            {
                                "target_lang_word": "подставить",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "im Stich lassen",
                                "target_lang_sense_clarification": "jemanden verlassen"
                            },
                            {
                                "target_lang_word": "stranden lassen",
                                "target_lang_sense_clarification": "jemanden hilflos zurücklassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7939205f-eaaf-38d3-948d-f4e9ee3bcc29",
                    "sense_definition": "To run aground; to beach.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high tide might <w>strand</w> the small boat on the rocks.",
                            "target_lang_translations": {
                                "ru": "Прилив может <w>выбросить</w> лодку на камни.",
                                "de": "Die Flut könnte das kleine Boot auf den Felsen <w>stranden</w> lassen."
                            }
                        },
                        {
                            "text": "Strong winds can <w>strand</w> a vessel if the captain is not careful.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер может заставить судно <w>сесть на мель</w>, если капитан не будет осторожен.",
                                "de": "Starke Winde können ein Schiff <w>stranden</w> lassen, wenn der Kapitän nicht vorsichtig ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "beach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сесть на мель; выбросить на берег.",
                        "de": "Auf Grund laufen oder an Land gespült werden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сесть на мель",
                                "target_lang_sense_clarification": "о судне"
                            },
                            {
                                "target_lang_word": "выбросить на берег",
                                "target_lang_sense_clarification": "о волнах или ветре"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stranden",
                                "target_lang_sense_clarification": "mit einem Schiff"
                            },
                            {
                                "target_lang_word": "auf Grund laufen",
                                "target_lang_sense_clarification": "mit einem Schiff"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "34b4d03e-ff02-3d64-bc8f-366d35da9007",
                    "sense_definition": "A street in Westminster running from Trafalgar Square to Fleet Street.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "london_location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We walked down the <w>Strand</w> to see the famous theaters and hotels.",
                            "target_lang_translations": {
                                "ru": "Мы прошлись по <w>Стрэнду</w>, чтобы посмотреть на знаменитые театры и отели.",
                                "de": "Wir gingen den <w>Strand</w> entlang, um die berühmten Theater und Hotels zu sehen."
                            }
                        },
                        {
                            "text": "The <w>Strand</w> is one of the busiest thoroughfares in central London.",
                            "target_lang_translations": {
                                "ru": "<w>Стрэнд</w> — одна из самых оживленных магистралей в центре Лондона.",
                                "de": "Der <w>Strand</w> ist eine der belebtesten Hauptstraßen im Zentrum Londons."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Улица в Вестминстере, идущая от Трафальгарской площади до Флит-стрит.",
                        "de": "Eine Straße in Westminster, die vom Trafalgar Square zur Fleet Street führt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стрэнд",
                                "target_lang_sense_clarification": "название улицы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strand",
                                "target_lang_sense_clarification": "Name der Straße in London"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb74c85-bbc6-3c66-bcc5-7ea4edf04b86",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Strand</w> has been working at the law firm for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Странд</w> работает в юридической фирме уже более двадцати лет.",
                                "de": "Herr <w>Strand</w> arbeitet seit über zwanzig Jahren in der Anwaltskanzlei."
                            }
                        },
                        {
                            "text": "The author's last name is <w>Strand</w>, which is quite common in some regions.",
                            "target_lang_translations": {
                                "ru": "Фамилия автора — <w>Странд</w>, она довольно распространена в некоторых регионах.",
                                "de": "Der Nachname des Autors ist <w>Strand</w>, was in einigen Regionen recht häufig vorkommt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Странд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strand",
                                "target_lang_sense_clarification": "Nachname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}