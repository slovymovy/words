                    },
                    {
                        "sense_id": "6aedf0e1-c690-37bb-8036-e281c9c96b0d",
                        "entry_id": "5845c76b-9c7f-3fea-812c-3419d1cbb600",
                        "glosses": [
                            "ein Druck, der durch Lithografie^([1]) hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28dcfb6e-0ff9-4c76-bd10-9b1a03f28b67",
                                "sense_id": "6aedf0e1-c690-37bb-8036-e281c9c96b0d",
                                "text": "„In einem spießbürgerlich möblierten Esszimmer servierte man ihr Avocados, an den Wänden hingen Lithografien mit englischen Landschaften.“"
                            },
                            {
                                "example_id": "47f10697-9eec-4266-bfaa-14ab282d213b",
                                "sense_id": "6aedf0e1-c690-37bb-8036-e281c9c96b0d",
                                "text": "„Auch Mourlot hatte erkannt, welches Geschäft mit Lithografien zu machen war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
