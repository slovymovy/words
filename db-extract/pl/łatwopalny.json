                                    {
                                        "sense_id": "e6f4679f-a036-3e94-a4b1-538e2a71c431",
                                        "entry_id": "d917bc86-3ee7-388e-83fb-ca15f9b4479d",
                                        "glosses": [
                                            "Easily set on fire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85a904d0-56cf-3e51-b0b2-5083e47220ea",
                                        "entry_id": "d917bc86-3ee7-388e-83fb-ca15f9b4479d",
                                        "glosses": [
                                            "Easily set on fire.",
                                            "Subject to easy ignition and rapid flaming combustion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6bdd68c-922a-3a88-accc-6b53f3753131",
                                        "entry_id": "d917bc86-3ee7-388e-83fb-ca15f9b4479d",
                                        "glosses": [
                                            "Very likely to cause fighting or controversy; extremely contentious."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e38d20b5-af05-45a6-9f4a-fddb85ac4c6b",
                                                "sense_id": "c6bdd68c-922a-3a88-accc-6b53f3753131",
                                                "text": "In considering the possible commitment of U.S. forces to South Vietnam , the Joint Chiefs of Staff have reviewed the overall critical situation in Southeast Asia with particular emphasis upon the present highly flammable situation in South Vietnam."
                                            },
                                            {
                                                "example_id": "b7a6cc94-2c80-4916-a8e6-2a62f6e9c418",
                                                "sense_id": "c6bdd68c-922a-3a88-accc-6b53f3753131",
                                                "text": "They could stuff their ears with cotton, but they could not, after all, fight such flammable ideas ( at least not in the public squares where Attucks's war whoops could still be heard )."
                                            },
                                            {
                                                "example_id": "1816a1e1-66ef-4e3e-8292-4752684bacc2",
                                                "sense_id": "c6bdd68c-922a-3a88-accc-6b53f3753131",
                                                "text": "With her play Diamond Lil, she discovered a way to sneak her flammable subject matter past the censors."
                                            },
                                            {
                                                "example_id": "45b0264f-9883-4782-9497-5936529a4268",
                                                "sense_id": "c6bdd68c-922a-3a88-accc-6b53f3753131",
                                                "text": "King's words touch on a higher law of leadership, that the solution to a sensitive and highly contentious and even flammable situation often lies in doing the opposite of what is expected and even perceived as normal or 'natural'."
                                            },
                                            {
                                                "example_id": "ef3e7fe4-08be-431b-8d37-dda58fe46def",
                                                "sense_id": "c6bdd68c-922a-3a88-accc-6b53f3753131",
                                                "text": "Evelyn realized that Adam's flammable words and angry eyes were only the form of his untold pain, holding the strongest words of his heart, unspoken."
                                            }
                                        ]
                                    }
                                ]
                            },
