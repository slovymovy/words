                "forms": [],
                "senses": [
                    {
                        "sense_id": "920a2b02-79e8-316a-91bf-2bc402ccd687",
                        "entry_id": "0269855b-7674-34a0-9f84-e059dd5f9733",
                        "glosses": [
                            "scheuren van de rand naar het midden van een voorwerp"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b8af7a14-d715-4550-bdd9-f8591d86f123",
                                "sense_id": "920a2b02-79e8-316a-91bf-2bc402ccd687",
                                "text": "Soms ga ik slapen met een Verspreid Geschrift van Robert Fruin. Daar zijn er een kleine honderd van, die begin 20ste eeuw door leerlingen van de historicus zijn gebundeld in tien delen Historische Opstellen. Het zijn niet de handzaamste banden voor in bed. Ze zijn zwaar, en met het oude, uitgedroogde papier moet je oppassen dat de bladzijden niet inscheuren bij het omslaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3e4eb9e-a933-3180-b0f1-f0be99426efb",
                        "entry_id": "0269855b-7674-34a0-9f84-e059dd5f9733",
                        "glosses": [
                            "kapot gaan van de vrouwelijke geslachtsdelen bij de baring"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "66fa48e1-3fc8-407b-a74a-dbd2b0046ced",
                                "sense_id": "e3e4eb9e-a933-3180-b0f1-f0be99426efb",
                                "text": "Wie kent het verschijnsel niet: vrienden die in vreemden veranderen op het moment dat ze kinderrijker worden? Gesprekken die geleidelijk aan steeds vaker lijken te gaan over fruithapjes, luiersoorten, uierzalven; inscheuren, doorslapen en weinig seks?..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7fd86b4-a395-472b-a052-41e10656cd02",
                        "source_entry_id": "0269855b-7674-34a0-9f84-e059dd5f9733",
                        "source_sense_id": "920a2b02-79e8-316a-91bf-2bc402ccd687",
                        "source_sense_description": "overgankelijk scheuren van de rand naar het midden van een voorwerp",
                        "target_lang_word": "tear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
