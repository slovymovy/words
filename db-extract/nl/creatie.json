                                                "sense_id": "82fa1740-1a5f-3fa7-8f2e-dad640f4526c",
                                                "text": "I think the manufacturer was so ashamed of its creation that it didn't put its name on it!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12072e57-7e22-36a8-b06c-f199cbbe632d",
                                        "entry_id": "1501cf77-8cd9-3b30-97a5-4180d76c7d12",
                                        "glosses": [
                                            "The act of creating something."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1598479-4aa4-4fa4-9cc7-8b5cb3e169ad",
                                                "sense_id": "12072e57-7e22-36a8-b06c-f199cbbe632d",
                                                "text": "The restructure resulted in the creation of a number of shared services."
                                            },
                                            {
                                                "example_id": "265cc7ca-e3d7-4a57-939a-2976e247142e",
                                                "sense_id": "12072e57-7e22-36a8-b06c-f199cbbe632d",
                                                "text": "the creation of passwords is done by a computer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84d1e29-2f78-3b61-a1ff-81de53294e42",
                                        "entry_id": "1501cf77-8cd9-3b30-97a5-4180d76c7d12",
                                        "glosses": [
                                            "All which exists."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68178a65-4dc4-4819-a879-e3fc03c7ae13",
                                                "sense_id": "c84d1e29-2f78-3b61-a1ff-81de53294e42",
                                                "text": "Let us pray to Christ, the King of all creation."
                                            }
                                        ]
