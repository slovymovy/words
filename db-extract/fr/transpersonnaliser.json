                "senses": [
                    {
                        "sense_id": "84ea679c-9211-3e01-885d-6b5f7a2898f9",
                        "entry_id": "590ce0a6-cf80-3744-963b-c31e0c365466",
                        "glosses": [
                            "Donner un caractère transpersonnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95493759-05d6-4d0b-ad17-2af009506582",
                                "sense_id": "84ea679c-9211-3e01-885d-6b5f7a2898f9",
                                "text": "Mais si on exagère la réalité des personnes morales on s’expose, bien au delà de Durkheim, à hypostasier la conscience sociale, et tout près de Hegel, à transpersonnaliser l’État."
                            },
                            {
                                "example_id": "93bb8398-b3cb-42cd-80fe-d480ae66be9a",
                                "sense_id": "84ea679c-9211-3e01-885d-6b5f7a2898f9",
                                "text": "Je n’ose pas dire le « transpersonnaliser », et pourtant ! « Transfigurer », cela veut bien dire : manifester à travers la figure, la forme, un au-delà, une lumière incréée, présence infinie au cœur même du fini (cf. Grégoire Palamas et la tradition philocalique)."
                            }
                        ]
                    }
                ],
