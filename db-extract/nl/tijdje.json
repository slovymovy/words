                        "examples": [
                            {
                                "example_id": "99e94afc-1ab9-4ba9-bc33-7de8000840a2",
                                "sense_id": "79e68360-0e92-3cd6-b1df-5448c0e60de7",
                                "text": "Na een tijdje merkte ik duidelijk aan mijn oren dat we van zeeniveau naar duizend meter hoogte aan het klimmen waren."
                            },
                            {
                                "example_id": "f9313dc2-7bcb-4716-acd6-1cdb94c68ac9",
                                "sense_id": "79e68360-0e92-3cd6-b1df-5448c0e60de7",
                                "text": "Ik heb haar een tijdje terug nog met die jongen zien praten."
                            },
                            {
                                "example_id": "afd8a8a3-f0f8-434a-88e5-fc7f597d3277",
                                "sense_id": "79e68360-0e92-3cd6-b1df-5448c0e60de7",
                                "text": "Pas na een tijdje viel me op dat we vaak de enigen in de ruimte waren die om exact hetzelfde in grinniken uitbarstten."
                            }
                        ]
                    }
