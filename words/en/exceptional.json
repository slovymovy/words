        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b7ab4f4-cc6e-3fd8-bb9f-b8e67ec0c137",
                    "sense_definition": "An item, person, or thing that is considered an exception or has exceptional value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Among the standard products, there were a few <w>exceptionals</w> worth noting.",
                            "target_lang_translations": {
                                "ru": "Среди стандартных продуктов было несколько <w>исключений</w>, заслуживающих внимания.",
                                "tr": "Standart ürünler arasında dikkat çekmeye değer birkaç <w>istisna</w> vardı."
                            }
                        },
                        {
                            "text": "The report listed the <w>exceptionals</w> separately from the main group.",
                            "target_lang_translations": {
                                "ru": "В отчете <w>исключения</w> были перечислены отдельно от основной группы.",
                                "tr": "Rapor, <w>istisnaları</w> ana gruptan ayrı olarak listeledi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, человек или вещь, которые считаются исключением или имеют исключительную ценность.",
                        "tr": "İstisna olarak kabul edilen veya olağanüstü değere sahip olan öge, kişi veya şey."
                    },
                    "translations": {
                        "ru": [
