                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ea2fbd4-878a-3ba3-9403-f1a6fa38ef2f",
                        "entry_id": "2a2a90e7-2134-3993-8787-6eb6ab7e70b5",
                        "glosses": [
                            "Having no interest or involvement in politics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb6dba8-8128-44be-b134-3a4a587e3d87",
                                "sense_id": "1ea2fbd4-878a-3ba3-9403-f1a6fa38ef2f",
                                "text": "The Queen is an apolitical figure."
                            }
                        ]
                    },
                    {
                        "sense_id": "a51a7d89-bd29-3229-858a-f7038aa7ccd5",
                        "entry_id": "2a2a90e7-2134-3993-8787-6eb6ab7e70b5",
                        "glosses": [
                            "Having no political relevance or function."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "516915e6-a324-4271-878b-b306388e8c7c",
                                "sense_id": "a51a7d89-bd29-3229-858a-f7038aa7ccd5",
                                "text": "The PM's visit to the school was entirely apolitical."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                        "entry_id": "2a2a90e7-2134-3993-8787-6eb6ab7e70b5",
                        "glosses": [
                            "Politically neutral, unbiased, non-aligned, free from party politics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f4a0651-f33f-44e0-85be-2540b42aaa03",
                                "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                                "text": "My colleagues and I come to this task with open minds, we are apolitical and independent of any political party."
                            },
                            {
                                "example_id": "a5c71672-a8be-4ea9-8e6b-42c67ec47dfa",
                                "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                                "text": "What, exactly, the criteria for this designation will be remains unclear but the ultimate aim, some analysts suspect, is to purge officers deemed insufficiently loyal to Mr. Trump – a litmus test, they warn, that’s incompatible with an apolitical military."
                            },
                            {
                                "example_id": "36d46942-af9e-4334-a4d9-d442ce89b00a",
                                "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                                "text": "But like so much in the Trump administration, what was once considered apolitical is now labeled political."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43c1a10e-fe8c-4177-8cf4-ead6bef9c4f1",
                        "source_entry_id": "2a2a90e7-2134-3993-8787-6eb6ab7e70b5",
                        "source_sense_description": "Having no interest or involvement in politics",
                        "target_lang_word": "apolitický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ef3879a4-19b2-4ea8-9e6e-089768ca5c49",
                        "source_entry_id": "2a2a90e7-2134-3993-8787-6eb6ab7e70b5",
                        "source_sense_description": "Having no interest or involvement in politics",
                        "target_lang_word": "apolitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apolitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4558e4bb-80b7-3e13-abda-6175722c7cd2",
                                        "entry_id": "a803144f-8b1f-3bc6-94e8-a430455d83b6",
                                        "glosses": [
                                            "Indifférent à la politique, qui se situe en dehors de la politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88defe97-76d8-43a7-b842-7afb71991bbb",
                                                "sense_id": "4558e4bb-80b7-3e13-abda-6175722c7cd2",
                                                "text": "On ne s'étonnera pas que (…) l'Église aujourd'hui, non seulement insiste comme elle l'a toujours fait sur son indifférence à l'égard des diverses formes de gouvernement légitime, mais prenne elle-même une attitude de plus en plus apolitique ou plutôt supra-politique."
                                            },
                                            {
                                                "example_id": "84b68907-85c3-4969-8a22-be8d167d406e",
                                                "sense_id": "4558e4bb-80b7-3e13-abda-6175722c7cd2",
                                                "text": "Mon père était, par nature, un « animal antipolitique » et même « apolitique » ainsi que disaient, au siècle dernier, les individualistes, précurseurs de Nietsche."
                                            },
                                            {
                                                "example_id": "848a19b4-df0a-471c-9bba-ce6066cc214b",
                                                "sense_id": "4558e4bb-80b7-3e13-abda-6175722c7cd2",
                                                "text": "Aide Médicale Internationale est une ONG médicale apolitique créée en 1979."
                                            },
                                            {
                                                "example_id": "291a8faa-481e-414d-bf92-71ea82ec8218",
                                                "sense_id": "4558e4bb-80b7-3e13-abda-6175722c7cd2",
                                                "text": "Les 21 ministres, dont deux femmes, sont des personnalités réputées indépendantes et apolitiques."
                                            },
                                            {
                                                "example_id": "dc2fe400-9d9f-4e71-b069-7858d33b70e7",
                                                "sense_id": "4558e4bb-80b7-3e13-abda-6175722c7cd2",
                                                "text": "Il importe en effet de maintenir une posture critique vis-à-vis des « nécessités », des solutions techniques ou apolitiques et, surtout, de ces conceptions qui promeuvent l'exclusion de catégories entières de la population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc97ceca-b91d-321b-8cf6-a4c45a457aeb",
                                        "entry_id": "a803144f-8b1f-3bc6-94e8-a430455d83b6",
                                        "glosses": [
                                            "Relatif au citoyen n'exerçant pas son droit civique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a1a23e-c4fd-4f0e-96c6-b4e3ee52f1bb",
                                                "sense_id": "dc97ceca-b91d-321b-8cf6-a4c45a457aeb",
                                                "text": "L'abstention est un geste théoriquement apolitique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
