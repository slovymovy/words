                    {
                        "translation_id": "635d7051-682b-44ff-a7f8-1f07838fcf94",
                        "source_entry_id": "65222987-e909-31ff-adc1-0e596341aba8",
                        "target_lang_word": "Job",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Job",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f058c73-5484-3b48-bb7a-2eeba6ea68e4",
                                        "entry_id": "93274413-a1f9-313e-954f-277f61735e68",
                                        "glosses": [
                                            "Arbeitsplatz, Stellung (Anstellung) für eine (vorübergehende) einträgliche Beschäftigung zum Zweck des Gelderwerbs"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec28a68-63af-4921-afb4-14fe998e4d84",
                                                "sense_id": "0f058c73-5484-3b48-bb7a-2eeba6ea68e4",
                                                "text": "Dieser Job war nicht einfach."
                                            },
                                            {
                                                "example_id": "bd86160d-206c-4b2b-a3d9-0fbded2baf23",
                                                "sense_id": "0f058c73-5484-3b48-bb7a-2eeba6ea68e4",
                                                "text": "„Wenn eine wie Cathy ihren Job verliert, geht es schnell hinab in einer Stadt ohne Netz, und tief.“"
                                            },
                                            {
                                                "example_id": "34eca360-21ed-4abc-a415-7acf47cc1d25",
                                                "sense_id": "0f058c73-5484-3b48-bb7a-2eeba6ea68e4",
                                                "text": "„Ich hatte einen Job in Zürich und mußte dann und wann auf die Bank.“"
                                            },
                                            {
                                                "example_id": "519dab83-bb74-4312-b97a-214daff6ed5b",
                                                "sense_id": "0f058c73-5484-3b48-bb7a-2eeba6ea68e4",
                                                "text": "„Ohne Amerikas Jobs wiederum wäre Mexiko noch ein Land der dritten Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3fe6630-cfa5-3a51-8a00-2010778c0c6d",
                                        "entry_id": "93274413-a1f9-313e-954f-277f61735e68",
                                        "glosses": [
                                            "Arbeit oder berufliche Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5ada0d-a6be-4f84-80d4-127d3b4495f8",
                                                "sense_id": "d3fe6630-cfa5-3a51-8a00-2010778c0c6d",
                                                "text": "Er macht seinen Job gern."
                                            },
                                            {
                                                "example_id": "30003dc1-f803-4d52-8c83-df70b6df185b",
                                                "sense_id": "d3fe6630-cfa5-3a51-8a00-2010778c0c6d",
                                                "text": "„Louis Armstrong, das Idol ihrer Kindheit, steht mit ihr auf dem Programm der Show, aber eine Lebensmittelvergiftung zwingt Billie, den Job aufzugeben.“"
                                            },
                                            {
                                                "example_id": "9f2aeab5-6ab6-419e-a9fa-b6630c0df9b7",
                                                "sense_id": "d3fe6630-cfa5-3a51-8a00-2010778c0c6d",
                                                "text": "„Er gibt seinen Job in der Brauerei auf, ist nun professioneller Politiker, der erste seiner Partei.“"
                                            },
                                            {
                                                "example_id": "a8481b00-1020-4ba5-819e-02a98867378e",
                                                "sense_id": "d3fe6630-cfa5-3a51-8a00-2010778c0c6d",
                                                "text": "„Er machte als Maschinenbauingenieur einen ordentlichen Job in einem mittelständischen Zuliefererbetrieb.“"
                                            },
                                            {
                                                "example_id": "6621795b-98f1-4f87-8cd2-6f7ca7376cc9",
                                                "sense_id": "d3fe6630-cfa5-3a51-8a00-2010778c0c6d",
                                                "text": "„Man lernt beim WDR und bekommt einen Job bei RTL oder umgekehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Job",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                        "entry_id": "ec0dc6b3-7303-32de-bb80-defa04aa7d04",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937f67ed-db62-491f-b485-d8020f4e2ff1",
                                                "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                                "text": "Frau Job ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "7a1f25df-010d-4ccd-99bd-61c4d33d34c0",
                                                "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                                "text": "Herr Job wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6f4cce09-6f08-4f21-8944-935f8558e8a3",
                                                "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                                "text": "Die Jobs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "d46a8e07-2594-4264-b8c6-2b9cfc4ef81a",
                                                "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                                "text": "Der Job trägt nie die Schals, die die Job ihm strickt."
                                            },
                                            {
                                                "example_id": "ec80e6d8-53c7-410d-bb9b-358ee8fc6f3a",
                                                "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Job kommt, geht der Herr Job.“"
                                            },
                                            {
                                                "example_id": "a801c5b1-bba8-4b37-8a48-3d2b4b2356bf",
                                                "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                                "text": "Job kommt und geht."
                                            },
                                            {
                                                "example_id": "fa4430e6-b887-4e08-8a89-afefd6be55f8",
                                                "sense_id": "e03afc50-2158-3ae2-ab3a-4a6130b14c12",
                                                "text": "Jobs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
