                        "target_lang_word": "месторождение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "месторождение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79e97e5f-4418-39c4-b67e-3d4cd79a61c6",
                                        "entry_id": "512f557c-e163-3f7a-bc29-545c92efd59e",
                                        "glosses": [
                                            "устар. место рождения, появления кого-либо, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d308f730-c990-4b77-a4d7-23dc9b861934",
                                                "sense_id": "79e97e5f-4418-39c4-b67e-3d4cd79a61c6",
                                                "text": "Опять мы рассматривали и расспрашивали, с помощью миссионера, чёрных о их именах, племени, месторождении."
                                            },
                                            {
                                                "example_id": "9855464c-3630-4973-a767-715215dce060",
                                                "sense_id": "79e97e5f-4418-39c4-b67e-3d4cd79a61c6",
                                                "text": "Семь греческих городов спорили о месторождении слепого Омира; наберется, вероятно, столько же изыскателей колыбели русского народа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1d947b2-ea36-3f2d-a273-d658917dc8ea",
                                        "entry_id": "512f557c-e163-3f7a-bc29-545c92efd59e",
                                        "glosses": [
                                            "геол. скопление полезных ископаемых в земной коре; местонахождение полезных ископаемых в количестве, пригодном для промышленного использования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a86bca-f097-4d66-b904-8882bd74d49b",
                                                "sense_id": "b1d947b2-ea36-3f2d-a273-d658917dc8ea",
                                                "text": "Вечером я посетил еще раз кладоискателя, получил список известных ему месторождений золота, угля и асфальта и даже с их оценкой, довольно фантастической, как мне показалось."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
