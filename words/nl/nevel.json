        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c900d338-4bac-365e-b4e3-39680f76e27d",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>nevelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>nevel</w> de planten elke dag met een beetje water.",
                            "target_lang_translations": {
                                "ru": "Я <w>опрыскиваю</w> растения каждый день небольшим количеством воды.",
                                "en": "I <w>mist</w> the plants every day with a little water.",
                                "fr": "Je <w>brumise</w> les plantes tous les jours avec un peu d'eau."
                            }
                        },
                        {
                            "text": "Als ik mijn haar doe, <w>nevel</w> ik er wat haarlak overheen.",
                            "target_lang_translations": {
                                "ru": "Когда я укладываю волосы, я <w>распыляю</w> на них немного лака.",
                                "en": "When I do my hair, I <w>spray</w> some hairspray over it.",
                                "fr": "Quand je me coiffe, je <w>vaporise</w> un peu de laque dessus."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "1-е лицо ед. ч. настоящего времени от глагола nevelen (распылять, опрыскивать).",
                        "en": "First person singular present tense of nevelen (to mist, to spray).",
                        "fr": "Première personne du singulier du présent de l'indicatif de nevelen (brumiser, vaporiser)."
                    },
                    "translations": {
