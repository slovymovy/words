                        "glosses": [
                            "Opposition à l’antifascisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e164df28-60b5-4868-b9ef-5e15ef66939d",
                                "sense_id": "548c2c96-6011-3372-9354-a5855b4c079b",
                                "text": "Il glisse successivement de l’antisoviétisme à l’anticommunisme, de l’anticommunisme à l’anti-antifascisme et de l’anti-antifascisme au fascisme."
                            },
                            {
                                "example_id": "adad02c9-d1ed-4a41-a91f-5f855c99cf4d",
                                "sense_id": "548c2c96-6011-3372-9354-a5855b4c079b",
                                "text": "Dans son éditorial du 22 juillet 1991, la Frankfurter Allgemeine Zeitung écrivait qu’« il n’y a pas d’antifascisme qui ne soit pas coupable » et annonçait les années quatre-vingt-dix comme une nouvelle ère d’« anti-antifascisme »."
                            }
                        ]
                    }
