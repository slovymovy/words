                                        "examples": [
                                            {
                                                "example_id": "79a3ae07-e2eb-4287-8693-db584f716ca6",
                                                "sense_id": "2c54938d-1026-3dff-b598-618f4a33027b",
                                                "text": "The difficulty in reaching a unanimously acceptable decision is reflected in particular by a document submitted by the Japanese delegation to the same Working Group (Japanese non-paper),"
                                            },
                                            {
                                                "example_id": "d5ba5de4-1600-4b2d-bf49-5322f458a120",
                                                "sense_id": "2c54938d-1026-3dff-b598-618f4a33027b",
                                                "text": "Here I was up to my armpits in bodies, and the DPKO was reduced to presenting a non-paper in order to garner possible support for a mandate debate."
                                            },
                                            {
                                                "example_id": "c0979377-b788-4f83-aaca-d3845167398f",
                                                "sense_id": "2c54938d-1026-3dff-b598-618f4a33027b",
                                                "text": "The Attorney General reports that the Austrian Presidency circulated an alternative, more general, text as a \"non-paper\" which was discussed at informal working group meetings in April and May and at the June JHA council."
                                            }
