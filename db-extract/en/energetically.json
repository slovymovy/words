                "senses": [
                    {
                        "sense_id": "e7bb73c9-7cd3-37e2-bb0c-dc84ee5fc0dd",
                        "entry_id": "b0782b57-20fe-35ac-a296-b68556865d0d",
                        "glosses": [
                            "In an energetic manner; with great energy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e59ffc-da3e-4d98-a259-a3f8c64ec574",
                                "sense_id": "e7bb73c9-7cd3-37e2-bb0c-dc84ee5fc0dd",
                                "text": "With a stride, the doctor reached the bed, and seizing her arms worked them energetically, applying what I knew to be artificial respiration."
                            }
                        ]
                    },
                    {
                        "sense_id": "24eae641-1bed-3101-99d3-28e61e715abd",
                        "entry_id": "b0782b57-20fe-35ac-a296-b68556865d0d",
                        "glosses": [
                            "By means of energy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f716cef-736f-448f-a7ef-e297206ba641",
                                "sense_id": "24eae641-1bed-3101-99d3-28e61e715abd",
                                "text": "Reiki attempts to heal the body energetically."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cb3d10f-6d21-4ade-8c00-c72fabda6ea6",
                        "source_entry_id": "b0782b57-20fe-35ac-a296-b68556865d0d",
                        "source_sense_description": "in an energetic manner",
                        "target_lang_word": "énergiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "énergiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                        "entry_id": "4fde6d43-fc4d-36b5-b098-c2ec1dbf1acf",
                                        "glosses": [
                                            "Avec énergie, force ; activement, avec entrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac1c2ae-76dc-49f2-bfa6-29ba85e49931",
                                                "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                                "text": "[…], d’Ablancourt supprimait énergiquement les lettres doubles et mettait i pour y à peu près partout."
                                            },
                                            {
                                                "example_id": "aa98abd7-6999-4c87-b679-6cac9c2a9343",
                                                "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                                "text": "Tétas, qui avait sans doute à se plaindre de procédés aussi violents, se rebellait non moins énergiquement entre les mains de Camus."
                                            },
                                            {
                                                "example_id": "c675bfcc-5f16-4de0-b564-b5e011c992cd",
                                                "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                                "text": "Sa taille grande, mais un peu forte, caractérisait énergiquement la jeunesse et le bonheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "699f51ce-da9f-3de5-b7b3-b8c33dbbc36c",
                                        "entry_id": "4fde6d43-fc4d-36b5-b098-c2ec1dbf1acf",
                                        "glosses": [
                                            "Avec véhémence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3503a6-3413-418b-bd8d-034ca9eb2023",
                                                "sense_id": "699f51ce-da9f-3de5-b7b3-b8c33dbbc36c",
                                                "text": "Le Courrier français, qui n'y allait pas par quatre chemins, demanda énergiquement que la circulation fût interdite sur le chemin de fer du Nord tant que la sécurité des voyageurs n'y serait pas assurée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af488ce4-21a8-4c77-9e24-10e14a95faec",
                        "source_entry_id": "b0782b57-20fe-35ac-a296-b68556865d0d",
                        "source_sense_description": "in an energetic manner",
                        "target_lang_word": "energetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "energetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23c2ac1e-85d8-3727-ad27-5796bb659665",
                                        "entry_id": "d33cbd8f-3c4e-38c4-92f5-fad40ea4b614",
                                        "glosses": [
                                            "in Bezug auf die Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f63e9d-4ef1-48df-8890-3d6a2fd479f3",
                                                "sense_id": "23c2ac1e-85d8-3727-ad27-5796bb659665",
                                                "text": "Stofflich ist die Bilanz ausgeglichen, aber energetisch ist sie positiv."
                                            },
                                            {
                                                "example_id": "7740eaea-2054-4e12-ad84-d10740ff6924",
                                                "sense_id": "23c2ac1e-85d8-3727-ad27-5796bb659665",
                                                "text": "„Im Zuge der bundesdeutschen Energiewende steht eine riesige Zahl von Bestandsimmobilien vor einer energetischen Sanierung.“"
                                            },
                                            {
                                                "example_id": "90301340-950c-4c2e-a04e-a25aea280155",
                                                "sense_id": "23c2ac1e-85d8-3727-ad27-5796bb659665",
                                                "text": "[Rund ein Drittel der Altbauten muss] „erst umfassend energetisch saniert werden, bevor eine Erdwärmeheizung installiert werden kann.“"
                                            },
                                            {
                                                "example_id": "0d99477d-ddf1-4ec2-9116-e78e89687254",
                                                "sense_id": "23c2ac1e-85d8-3727-ad27-5796bb659665",
                                                "text": "[Deutschland:] „2023 wurden gut 73 Millionen Kubikmeter Holz geerntet. Davon wurden knapp 50 Millionen Kubikmeter stofflich genutzt (Bauholz, Papierindustrie, Chemieindustrie, Möbel), der Rest energetisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
