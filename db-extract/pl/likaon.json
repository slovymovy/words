                "senses": [
                    {
                        "sense_id": "0767c506-04af-3727-b5c3-d70603db4235",
                        "entry_id": "13b282e1-7316-36e2-bdd8-d4f2a7d8c31b",
                        "glosses": [
                            "Lycaon pictus, gatunek drapieżnego ssaka z rodziny psowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c723a60-b089-4257-b630-e44155a35baf",
                                "sense_id": "0767c506-04af-3727-b5c3-d70603db4235",
                                "text": "Likaony zamieszkują suche obszary na południe od Sahary."
                            },
                            {
                                "example_id": "279b28a9-bb96-4cb9-8134-ae68615736e3",
                                "sense_id": "0767c506-04af-3727-b5c3-d70603db4235",
                                "text": "Pysk i zewnętrzne części uszu likaona są czarne."
                            },
                            {
                                "example_id": "8ceaf51f-191e-4dd0-8a72-44d5ca069af9",
                                "sense_id": "0767c506-04af-3727-b5c3-d70603db4235",
                                "text": "Blisko 80 procent wszystkich polowań likaonów kończy się sukcesem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
