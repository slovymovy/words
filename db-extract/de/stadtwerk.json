                        "source_sense_description": "kommunales Unternehmen, das Leistungen für die Versorgung, den öffentlichen Verkehr und Anderes erbringt",
                        "target_lang_word": "utility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
