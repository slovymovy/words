                                            {
                                                "example_id": "2104105d-37c8-44db-905e-7930e65b7266",
                                                "sense_id": "d55fa1d3-8c5d-3184-bb87-6734b378ae0f",
                                                "text": "Cabaretier Thijs Kemperink uit Albergen is getroffen door een keelontsteking en acute wondroos, een ontsteking van de huid. De cabaretier heeft zijn drie shows voor komend weekend afgezegd."
                                            },
                                            {
                                                "example_id": "153f4c74-d3fd-4d93-8bfa-4e53ddc4e1d1",
                                                "sense_id": "d55fa1d3-8c5d-3184-bb87-6734b378ae0f",
                                                "text": "Zijn spasme gaat gepaard met nog een aantal nare bijkomstigheden, zoals wondroos en diarree. In zijn huurhuis aan de Duithof in Dommelen heeft hij beneden een aangepast toilet. Nu hij ouder wordt en zijn lichamelijke gesteldheid achteruit gaat, heeft hij een extra toiletvoorziening boven nodig."
                                            }
