                        "underneath the surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "В или в направлении позиции непосредственно ниже или под чем-то другим.",
                        "zh": "处于某物正下方的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под",
