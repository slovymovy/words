                    "sense_definition": "het vermogen om te spreken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vermogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij ernstig hersenletsel kan de <w>spraak</w> van een patiënt nadelig beïnvloed worden.",
                            "target_lang_translations": {
                                "en": "In cases of severe brain injury, a patient's <w>speech</w> can be adversely affected.",
                                "ru": "При серьезном повреждении мозга <w>речь</w> пациента может серьезно пострадать."
                            }
                        },
                        {
                            "text": "Na het ongeluk was hij tijdelijk zijn <w>spraak</w> verloren en kon hij niet communiceren.",
                            "target_lang_translations": {
                                "en": "After the accident, he had temporarily lost his <w>speech</w> and was unable to communicate.",
                                "ru": "После аварии он временно потерял <w>речь</w> и не мог общаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "spreekvermogen"
                    ],
                    "common_phrases": [
                        "spraak verliezen",
                        "het herstel van de spraak"
                    ],
                    "target_lang_definitions": {
                        "en": "the ability to speak; the faculty of uttering words or articulate sounds",
                        "ru": "способность говорить; способность произносить слова или членораздельные звуки"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "speech",
                                "target_lang_sense_clarification": "the faculty or power of speaking"
                            }
                        ],
