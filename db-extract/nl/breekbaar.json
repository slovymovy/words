                    }
                ],
                "senses": [
                    {
                        "sense_id": "500ba01b-a200-36ef-9d1e-971cd60b07af",
                        "entry_id": "16994e77-c15f-3176-abf5-20ae2089887e",
                        "glosses": [
                            "de eigenschap hebbend gemakkelijk te breken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a2ec48b-5fb8-49fa-9fae-30c6e08d80ed",
                                "sense_id": "500ba01b-a200-36ef-9d1e-971cd60b07af",
                                "text": "Die elegante glazen zijn nu eenmaal breekbare dingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4fff219-775f-35e1-a2f4-bdf93cf3486c",
                        "entry_id": "16994e77-c15f-3176-abf5-20ae2089887e",
                        "glosses": [
                            "makkelijk te kwetsen, makkelijk te verstoren"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bf65b618-ba75-4e49-9cb9-8220de686309",
                                "sense_id": "c4fff219-775f-35e1-a2f4-bdf93cf3486c",
                                "text": "De harpiste maakte mooie breekbare muziek."
                            },
                            {
                                "example_id": "bcb11f1a-6389-4825-9ccb-9f3cc010916f",
                                "sense_id": "c4fff219-775f-35e1-a2f4-bdf93cf3486c",
                                "text": "Hoewel alles wat ik zag hier al eeuwen stond, maakte het een breekbare indruk op mij, als een mirage gebouwd op zee die bij de geringste rimpeling van het water gefragmenteerd zou raken tot onsamenhangende herinneringen op miljoenen foto's."
                            },
                            {
                                "example_id": "eca68842-b977-4eb5-aad9-3352fd3a6655",
                                "sense_id": "c4fff219-775f-35e1-a2f4-bdf93cf3486c",
                                "text": "Breekbaar, maar aan kracht winnend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0531d9c2-dc2c-4e67-9c4c-8b7f5ec44ce3",
                        "source_entry_id": "16994e77-c15f-3176-abf5-20ae2089887e",
                        "target_lang_word": "zerbrechlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerbrechlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00a09313-784c-32e1-8396-4cdd63b13743",
                                        "entry_id": "b9b3c2ef-0189-37e4-b959-ec8437ceccb3",
                                        "glosses": [
                                            "einen solchen Zustand habend, dass es leicht entzweigehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502f369b-433f-4a15-820b-96eedd05b76e",
                                                "sense_id": "00a09313-784c-32e1-8396-4cdd63b13743",
                                                "text": "„Das Grabmal ist von unerwarteter Monumentalität und wirkt dabei fast zerbrechlich.“"
                                            },
                                            {
                                                "example_id": "354748c8-b1dd-4529-9d2b-e2a7855ba01f",
                                                "sense_id": "00a09313-784c-32e1-8396-4cdd63b13743",
                                                "text": "„Knalliges Rot und eine Vielzahl an Rüschen machen aus dem ohnehin zierlichen Model eine zerbrechliche Porzellanpuppe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aabfd712-8192-3670-aa83-ed489420761a",
                                        "entry_id": "b9b3c2ef-0189-37e4-b959-ec8437ceccb3",
                                        "glosses": [
                                            "einen sehr zarten, grazilen Körperbau habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8c6ab0-6655-4a04-948c-41e8bd60220c",
                                                "sense_id": "aabfd712-8192-3670-aa83-ed489420761a",
                                                "text": "„Sie musterte Cindy forschend, von Kopf bis Fuß, und auf einmal sah sie gar nicht mehr aus wie eine zerbrechliche alte Dame, sondern wie eine durchaus energische Person.“"
                                            },
                                            {
                                                "example_id": "6e55f834-33c9-4e03-a285-1e9838930527",
                                                "sense_id": "aabfd712-8192-3670-aa83-ed489420761a",
                                                "text": "„Viktor dagegen war ein zerbrechlicher alter Mann, der kaum die Kraft hatte, von einem Ende des Zentrums zum anderen zu gehen, und auch in Rauhas Gesicht hatten die Jahre ihre Spuren hinterlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2a124670-a050-3f85-9850-dfcb9336845c",
                                        "entry_id": "b9b3c2ef-0189-37e4-b959-ec8437ceccb3",
                                        "glosses": [
                                            "zart, so dass es zerstört oder verletzt werden kann"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b2c03b-dbdb-4284-8395-586f19dc7542",
                                                "sense_id": "2a124670-a050-3f85-9850-dfcb9336845c",
                                                "text": "„Unser geliebter Tim war eine zerbrechliche Seele auf der Suche nach Antworten auf existenzielle Fragen.“"
                                            },
                                            {
                                                "example_id": "92032f8e-0471-4b53-bd56-aa1bd2ec4642",
                                                "sense_id": "2a124670-a050-3f85-9850-dfcb9336845c",
                                                "text": "„Tanja Liedtke war lustig, verrückt[,] hatte Hinreißendes und Mitreißendes, aber sie plagte sich ebenso sehr mit Selbstzweifeln. Wie alle starken Menschen hatte sie eine zerbrechliche Seite, meint der britische Choreograf Lloyd Newson.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4a53221-41f5-4002-b5a9-fd7eef4e0dd4",
                        "source_entry_id": "16994e77-c15f-3176-abf5-20ae2089887e",
                        "target_lang_word": "breakable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breakable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb3317a-2eb3-37f7-90e1-a22442285f74",
                                        "entry_id": "d945fd70-bc48-3edd-925f-5fbbdca84d89",
                                        "glosses": [
                                            "Able to break or be broken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "426f0859-b279-4fe0-9130-ab4beec8853b",
                                                "sense_id": "9cb3317a-2eb3-37f7-90e1-a22442285f74",
                                                "text": "The accident was also one of several since Clapham […] that demonstrated the role of breakable windows in the death toll. RSSB research would later confirm and reinforce the need for laminated glass to protect passengers and increase survivability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b4b79f1-821b-3966-84e5-cdfaf21b97d9",
                                        "entry_id": "d945fd70-bc48-3edd-925f-5fbbdca84d89",
                                        "glosses": [
                                            "Fragile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a770472-1350-47ba-bde2-2c66fc20245b",
                                                "sense_id": "9b4b79f1-821b-3966-84e5-cdfaf21b97d9",
                                                "text": "Next Christmas she sent us bisque dolls, very lovely but too breakable to hug; we could not even kiss them but they cracked."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "breakable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30d131f6-3153-3e57-8054-b7215d91b520",
                                        "entry_id": "762959b5-a15a-3e29-9e17-f6b4c1deeeb9",
                                        "glosses": [
                                            "Something that is (easily) breakable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09921826-8f99-4258-8b4b-dc5f9a3d5897",
                                                "sense_id": "30d131f6-3153-3e57-8054-b7215d91b520",
                                                "text": "We had to wrap all the breakables before the movers arrived."
                                            },
                                            {
                                                "example_id": "653cb803-e720-4922-835d-ca6b65d7ed6e",
                                                "sense_id": "30d131f6-3153-3e57-8054-b7215d91b520",
                                                "text": "She was, she wrote, “impatient and absent-minded, prone to drop things intentionally or through clumsiness, even breakables like dishes and love affairs; a woman who is perennially on the move, changing jobs and homes at the drop of a hat and inventing reasons afterward while she is packing; a person who runs away as soon as she gets nervous, long before she smells danger.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44f2863d-b6a1-3aaf-926f-505529412b12",
                                        "entry_id": "762959b5-a15a-3e29-9e17-f6b4c1deeeb9",
                                        "glosses": [
                                            "A set of customized hardware that is part of a drum kit. Breakables typically consist of: the drummer's cymbals including high-hats, the snare drum, the kick pedal and the drummer's stool."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d0d7b49-af7a-41ac-af5b-0f33e7fc9f53",
                        "source_entry_id": "16994e77-c15f-3176-abf5-20ae2089887e",
                        "target_lang_word": "fragile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui se rompt ou se brise facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359a154d-582c-4490-8a87-22402ae9e962",
                                                "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                                "text": "Le verre est une structure rigide, fragile en raison de tensions internes; des vibrations, un léger choc, un échauffement ponctuel peuvent suffire à provoquer une rupture."
                                            },
                                            {
                                                "example_id": "101b6f25-10df-4f9c-b4a1-c7251ecdc5ef",
                                                "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                                "text": "Il faut noter qu'à l'issue de l'opération de dégourdi, la céramique est très fragile et difficile à manipuler, car formée uniquement d'un agglomérat de grains pas ou peu liés entre eux."
                                            },
                                            {
                                                "example_id": "c4f0833b-8fd0-4011-b2fb-26128640e5b5",
                                                "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                                "text": "Elle sursauta, voulut pivoter dans sa direction, et son coude heurta la fragile pyramide de gâteaux à la broche qui s’effondra dans un bruit sourd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui manque de robustesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab4118b-1842-43e8-9cd6-720a836b8873",
                                                "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                                "text": "Un froid mouillé touchait sa paume, le mince corps se tordait au béement de la gueule translucide, si fragile que l'hameçon dont elle était percée semblait un croc de bronze monstrueux."
                                            },
                                            {
                                                "example_id": "3294b016-6371-4b28-85aa-ca2fb9b3c28a",
                                                "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                                "text": "Mais c’était une jeune fille d’environ vingt-deux, vingt-quatre ans, fine, svelte, de taille moyenne, d’une apparence un peu fragile, peut-être, dans ce ciré noir et luisant au col relevé et à la ceinture serrée sur une taille de guêpe."
                                            },
                                            {
                                                "example_id": "9d6c55db-128a-43b5-8603-4423f6d4c343",
                                                "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                                "text": "Tout incitait donc un auteur de romans, à l'époque où Jane Austen commençait à écrire les siens, à dépeindre une héroïne à la santé fragile et à la beauté délicate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui n’est pas solidement établi, qui peut aisément être détruit."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce43bba8-0c35-4bdf-847d-4f80e0983ab7",
                                                "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                                "text": "Le développement de la société occidentale était le triomphe de l’indépendance de l’homme et de sa puissance. Et voilà que soudain, au XXᵉ siècle, on a vu — avec quelle netteté ! — que cette société était fragile et bâtie sur des précipices."
                                            },
                                            {
                                                "example_id": "a5bc35a9-91aa-4f26-8bf2-1d96561a1d39",
                                                "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                                "text": "La mémoire est fragile, car elle est sujette à des troubles, notamment dans le cadre des maladies de la mémoire ; mais la mémoire normale est aussi fragile par essence, car la représentation de l'événement est destinée à être modifiée, au fil du temps, […]."
                                            },
                                            {
                                                "example_id": "fc6038f4-de06-4d28-ba43-c919e68f0df4",
                                                "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                                "text": "La définition de l’OCDE est particulièrement topique, […]. Dans son rapport de 2011, il est écrit qu’un État fragile est celui qui « n’a qu’une faible capacité à effectuer les fonctions essentielles qui consistent à gouverner une population et son territoire et n’a pas la capacité de développer des relations constructives et mutuellement avantageuses avec la société. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui est sujet à tomber en faute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ccf7d86-43c5-4181-8ba5-86f8fb75c598",
                                                "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                                "text": "Aujourd'hui, on voit apparaître la notion d'enfant fragile, une notion très large et pouvant englober beaucoup de choses en rapport avec un enfant qui découvre le monde et qui a besoin d'être soutenu et accompagné."
                                            },
                                            {
                                                "example_id": "e9f13948-0118-4e01-84e3-9963ad9d6818",
                                                "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                                "text": "On a voulu distinguer hors les villes une gamme continue de types d'espaces de la banlieue aux espaces fragiles en passant par les campagnes dynamiques et les campagnes profondes."
                                            },
                                            {
                                                "example_id": "05eca8ff-dd74-4867-a526-f5809ab9cba2",
                                                "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                                "text": "Esprit fragile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fragile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                        "entry_id": "3b039500-d196-3fef-b529-9884884a7408",
                                        "glosses": [
                                            "Personne considérée comme émotive à l’excès."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e22236-1359-4dd1-bd60-92a5e70e356d",
                                                "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                                "text": "Azzedine est un jeune homme sensible et émotif. Largué par sa copine alors même qu’il la demandait en mariage, il est effondré malgré les tentatives de ses copains de lui remonter le moral. \"Toi t’es un fragile\", lui répètent-ils."
                                            },
                                            {
                                                "example_id": "b2557307-d82c-4d59-b491-4107d67ebc4d",
                                                "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                                "text": "T’es qu’un, t’es qu’un, t’es qu’un fragile\nT’es pas un mec, t’es pas viril"
                                            },
                                            {
                                                "example_id": "a3bbad1a-dbc5-438a-a376-4c48187534ac",
                                                "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                                "text": "Tous les films où j’ai pleuré comme un fragile (ou plus sérieusement, eu une bonne larme à l’œil), mais j’assume totalement !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
