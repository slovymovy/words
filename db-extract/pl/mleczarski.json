                ],
                "senses": [
                    {
                        "sense_id": "01fa4e14-886d-3317-9b3f-afee36a76dd0",
                        "entry_id": "2b2c4d33-17e4-3703-aab8-dd284f7ac9a0",
                        "glosses": [
                            "związany z mleczarstwem, dotyczący mleczarstwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40c38ad7-47f5-455d-9c3d-d1a0f2cdc86d",
                                "sense_id": "01fa4e14-886d-3317-9b3f-afee36a76dd0",
                                "text": "Zaprezentowane zostaną również różne produkty: mięsne, mleczarskie, piekarnicze oraz niskoalkoholowe, połączone z degustacją."
                            },
                            {
                                "example_id": "60ba7957-47eb-488f-8703-f1c6a6d06e7f",
                                "sense_id": "01fa4e14-886d-3317-9b3f-afee36a76dd0",
                                "text": "W Unii Europejskiej producenci nie mogą nazywać mleka roślinnego mlekiem, ponieważ przemysł mleczarski posiada patent na to słowo (z wyjątkiem mleka kokosowego)."
                            },
                            {
                                "example_id": "6967c2f2-8476-4af2-ab1b-0374368393ac",
                                "sense_id": "01fa4e14-886d-3317-9b3f-afee36a76dd0",
                                "text": "Swoją fermę mleczarską w Bilewie Matka oparła na krowach sprowadzanych z Holandii i Bawarii (rasa algawska)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
