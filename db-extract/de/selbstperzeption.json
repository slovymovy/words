                ],
                "senses": [
                    {
                        "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                        "entry_id": "4988c1ec-27dd-3c00-b57b-70786bb129c1",
                        "glosses": [
                            "Wahrnehmung der eigenen Person, also von sich selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e580ae-4d47-4cb0-aa72-875e1487da98",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Die historisch geprägte Fremdperzeption kollidiert dabei gelegentlich mit der deutschen Selbstperzeption in der Gegenwart, was wiederum zu Missverständnissen und Konflikten führt.“"
                            },
                            {
                                "example_id": "544ff975-ec75-411e-89f2-6e57b9379fae",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Es kann also vorpersonal gar nicht um Selbstperzeption gehen, auch nicht um eine väterliche Selbstkonstitution, sondern nur um ein reines Insein des göttlichen Wesens im göttlichen Wesen.“"
                            },
                            {
                                "example_id": "c15cbf9d-fbd8-4b1c-8689-5bcee5d33ca8",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Effizientes Handeln, im Sinne einer optimalen Versicherungsentscheidung, erfordert nicht nur Selbstperzeption und -kognition, sondern auch eine zieladäquate Wahrnehmung und kognitive Verarbeitung der immer mitgegebenen Situation.“"
                            },
                            {
                                "example_id": "ccbbe4bd-6336-440a-9df4-d3ca398639a1",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Die Ausblendung des Körpers und des prekären Lebens korrespondiert mit letztlich neoliberalen Techniken der Selbstperzeption und der Selbstführung.“"
                            },
                            {
                                "example_id": "50f38814-1d96-4f04-812a-934c3b87dafa",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Der Wandel der Selbstperzeption schlägt sich nicht nur in internen Strukturen nieder, sondern er beeinflusst ebenso stark das Eintreten in den und Auftreten im öffentlichen Raum.“"
                            },
                            {
                                "example_id": "56774fc0-4151-4f13-9328-e1dae945526d",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Die Verbindung zwischen Gedanken, Gefühlswelten und dem Handeln zeigt eine statistisch-mathematische Rechenoperation besser als die Selbstperzeption des Befragten.“"
                            },
                            {
                                "example_id": "79022953-6528-4f42-b3c5-38ef0e21261e",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Immer ist ein Vorgang der Selbstperzeption und der Wahrnehmung anderer im Spiel.“"
                            },
                            {
                                "example_id": "b1d22c43-e445-4d62-8a48-dee3deebe6e8",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Im neuen Konsens der russischen Außenpolitik steht die Selbstperzeption Russlands als Großmacht im Vordergrund.“"
                            },
                            {
                                "example_id": "0a6e8815-61df-473f-9736-46fe0d3fcf75",
                                "sense_id": "88b0ddc3-c4f0-399a-a7b7-b62c7fff8ded",
                                "text": "„Bei einer einfachen Selbstperzeption schwankt nicht nur die Selbstbewertung stärker, sondern auch die allgemeine Lebensstimmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
