                    {
                        "sense_id": "c1ab5ccb-b30c-376c-9557-d0c727380864",
                        "entry_id": "5bd3cb56-ea0c-30ca-8197-2aa489130ed9",
                        "glosses": [
                            "een plechtige verklaring iets voortaan te zullen doen of na te zullen laten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0960ab-2209-4fa0-9a00-9993dd9087e2",
                                "sense_id": "c1ab5ccb-b30c-376c-9557-d0c727380864",
                                "text": "Bij zijn toetreden tot de orde legde hij een gelofte van armoede af ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c4099ed-5d93-4899-853d-38509415b765",
                        "source_entry_id": "5bd3cb56-ea0c-30ca-8197-2aa489130ed9",
                        "source_sense_id": "c1ab5ccb-b30c-376c-9557-d0c727380864",
                        "source_sense_description": "een plechtige verklaring iets voortaan te zullen doen of na te zullen laten",
                        "target_lang_word": "vow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "455b6720-8af8-3ba6-b640-bcd7bb2b4437",
                                        "entry_id": "30b1bba8-9ace-3d19-8ff5-e0cd19ad07e7",
                                        "glosses": [
                                            "A solemn promise to perform some act, or behave in a specified manner, especially a promise to live and act in accordance with the rules of a religious order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7536b8-d513-46e6-acb4-bf5f9306050a",
                                                "sense_id": "455b6720-8af8-3ba6-b640-bcd7bb2b4437",
                                                "text": "The old hermit, up in the mountains, took a vow of silence."
                                            },
                                            {
                                                "example_id": "32a8740d-926f-4405-9240-aa7e2b2a078a",
                                                "sense_id": "455b6720-8af8-3ba6-b640-bcd7bb2b4437",
                                                "text": "And Moses spake vnto the heads of the tribes, concerning the children of Israel, saying, This is the thing which the Lord hath commanded.\nIf a man vowe a vow vnto the Lord, or sweare an othe to bind his soule with a bond: he shall not breake his word, hee shall doe according to all that proceedeth out of his mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7ee6b27-0552-38fe-bfe9-b179ce94fc90",
                                        "entry_id": "30b1bba8-9ace-3d19-8ff5-e0cd19ad07e7",
                                        "glosses": [
                                            "A declaration or assertion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6fd00d-a9ce-44f5-b2db-374162afa89a",
                                                "sense_id": "b7ee6b27-0552-38fe-bfe9-b179ce94fc90",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths. Consider for a moment the origins of almost any word we have for bad language – \"profanity\", \"curses\", \"oaths\" and \"swearing\" itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9dd60a7-2385-3a66-a4b3-7f35a74185f5",
                                        "entry_id": "30b1bba8-9ace-3d19-8ff5-e0cd19ad07e7",
                                        "glosses": [
                                            "A votive offering."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efec1fa8-1a38-47c0-b99f-32e2c6ffd4fa",
                                                "sense_id": "f9dd60a7-2385-3a66-a4b3-7f35a74185f5",
                                                "text": "There are also waxen vows, that represent other parts of the body mixed with them; but of these there are few in comparison of the number of the Priapi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1673876c-ed66-3538-8b50-dccdc4661851",
                                        "entry_id": "5ea35a69-a073-3c46-a24a-4e2cac81e3c6",
                                        "glosses": [
                                            "To make a vow; to promise."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4faca29a-41e3-491c-a3ba-622630c4c8f0",
                                                "sense_id": "1673876c-ed66-3538-8b50-dccdc4661851",
                                                "text": "When thou vowest a vow unto God, defer not to pay it."
                                            },
                                            {
                                                "example_id": "897fcc01-9575-4ca5-b667-3a246da9d737",
                                                "sense_id": "1673876c-ed66-3538-8b50-dccdc4661851",
                                                "text": "We do not vow that we will never sin, nor neglect a duty (nor ought we to do so)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50692a18-6952-3dec-b563-053951cd6064",
                                        "entry_id": "5ea35a69-a073-3c46-a24a-4e2cac81e3c6",
                                        "glosses": [
                                            "To make a vow regarding (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61cf989e-a036-4e59-8375-52253f3bd522",
                                                "sense_id": "50692a18-6952-3dec-b563-053951cd6064",
                                                "text": "The wronged woman vowed revenge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25cb4ff3-de6b-3025-a696-b8dc6b5cec96",
                                        "entry_id": "5ea35a69-a073-3c46-a24a-4e2cac81e3c6",
                                        "glosses": [
                                            "To declare publicly that one has made a vow, usually to show one's determination or to announce an act of retaliation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bdc51cf-52d2-4666-bba4-e104c9ccd565",
                                                "sense_id": "25cb4ff3-de6b-3025-a696-b8dc6b5cec96",
                                                "text": "The rebels vowed to continue their fight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
