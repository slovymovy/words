{
    "word_family": [
        "trappen",
        "trap",
        "trapper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29d9693f-e04a-37c4-b1b0-9f408b026dc9",
                    "sense_definition": "Met de voeten treden en daardoor beschadigen of vernielen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_beschadigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doordat ze er bij het voetballen niet op letten, <w>vertrappen</w> de jongens alle bloemen.",
                            "target_lang_translations": {
                                "en": "Because they don't pay attention while playing football, the boys <w>trample</w> all the flowers."
                            }
                        },
                        {
                            "text": "Pas op dat je de jonge plantjes in de tuin niet per ongeluk gaat <w>vertrappen</w>.",
                            "target_lang_translations": {
                                "en": "Be careful not to accidentally <w>trample</w> the young plants in the garden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bloemen vertrappen",
                        "het gras vertrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To step on something with your feet, thereby damaging or destroying it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trample",
                                "target_lang_sense_clarification": "to tread heavily on something, crushing it"
                            },
                            {
                                "target_lang_word": "trample down",
                                "target_lang_sense_clarification": "to flatten or destroy by stepping on"
                            },
                            {
                                "target_lang_word": "tread on",
                                "target_lang_sense_clarification": "to step on and damage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d4dbd22-6311-3348-99b8-b6f48fdd36a1",
                    "sense_definition": "Op een grove manier schenden, negeren of vernederen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_schenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze demagogen <w>vertrappen</w> onze grondwet en de mensenrechten.",
                            "target_lang_translations": {
                                "en": "These demagogues <w>trample on</w> our constitution and human rights."
                            }
                        },
                        {
                            "text": "Het is onacceptabel hoe zij de rechten van minderheden in dat land <w>vertrappen</w>.",
                            "target_lang_translations": {
                                "en": "It is unacceptable how they <w>trample</w> the rights of minorities in that country."
                            }
                        }
                    ],
                    "synonyms": [
                        "met voeten treden"
                    ],
                    "common_phrases": [
                        "mensenrechten vertrappen",
                        "de grondwet vertrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To violate, ignore, or humiliate in a harsh or disrespectful manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trample on",
                                "target_lang_sense_clarification": "to treat rights, feelings, or laws with contempt"
                            },
                            {
                                "target_lang_word": "trample underfoot",
                                "target_lang_sense_clarification": "to completely disregard or crush rights or values"
                            },
                            {
                                "target_lang_word": "violate",
                                "target_lang_sense_clarification": "to fail to respect or to disregard laws or rights"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}