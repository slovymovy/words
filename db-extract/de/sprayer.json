                "senses": [
                    {
                        "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                        "entry_id": "4f3e481b-0e6d-3316-9fd1-957a5883cf6d",
                        "glosses": [
                            "jemand, der mit Sprühfarben Graffiti erstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb42dc0c-2241-4ba8-8a5f-4cca4637997e",
                                "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                                "text": "Die Polizei hat in der Nacht einige jugendliche Sprayer auf frischer Tat ertappt."
                            },
                            {
                                "example_id": "2764e28a-f680-4dbb-868e-276becec8b71",
                                "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                                "text": "„Warum hat der philosophische Sprayer seinen Satz nicht vollendet?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8db5190-2924-49a9-917a-7b6f4063ab4d",
                        "source_entry_id": "4f3e481b-0e6d-3316-9fd1-957a5883cf6d",
                        "source_sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                        "source_sense_description": "jemand, der mit Sprühfarben Graffiti erstellt",
                        "target_lang_word": "bombeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bombeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c704e6fd-1515-3dae-b224-8cba2b28037f",
                                        "entry_id": "6c88e0f6-2c92-3c6b-a592-946ce92e387a",
                                        "glosses": [
                                            "Celui qui fabrique des verres bombés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "124eb18a-3e46-42a1-9cea-e62a154acab2",
                                                "sense_id": "c704e6fd-1515-3dae-b224-8cba2b28037f",
                                                "text": "Il menait vers des échoppes qui auraient pu illustrer un livre sur les petits métiers en voie de disparition : il y avait là un cordonnier, un bombeur de verre et peut-être un rémouleur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bombeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                                        "entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                                        "glosses": [
                                            "Homme qui peint des tags."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d48255-7d2e-4617-8cc7-535be2d46efe",
                                                "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                                                "text": "Jean-Michel Basquiat, un « bombeur » haïtien, qui se trouva propulsé par ses graffiti sur portières de métro au firmament du show-business grâce au flair de quelques nez creux, avant de tomber dans le néant auquel, déjà, le promettait la nullité, Jean-Michel Basquiat, donc, y figurait par une œuvre bouleversante, succession de graffiti hagards […]."
                                            },
                                            {
                                                "example_id": "68fd21d3-88e1-4ff5-aea4-ae7007246091",
                                                "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                                                "text": "L'échec de la diffusion de ce message en dehors des limites géographiques et chronologiques indiquées montre que l'ensemble de la population des bombeurs corses n'a pas jugé pertinente sa reproduction."
                                            },
                                            {
                                                "example_id": "4fa140ff-39cc-4572-a1e3-930ef8a802c2",
                                                "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                                                "text": "Puis, c'est au tour des « bombeurs » de Bastia - Oliva, Christofari et Léoni. Déjà en prison depuis plusieurs mois pour de simples graffitis, ils écopent de peines de deux ans de prison avec sursis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b320435d-80a5-4f46-a25a-665c8039cd54",
                        "source_entry_id": "4f3e481b-0e6d-3316-9fd1-957a5883cf6d",
                        "source_sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                        "source_sense_description": "jemand, der mit Sprühfarben Graffiti erstellt",
                        "target_lang_word": "graffeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graffeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ab1a9f4-88fe-36a3-9284-4d2f6c66b857",
                                        "entry_id": "d22b0862-5e40-3fb7-b235-7c357e4a7519",
                                        "glosses": [
                                            "Celui qui, seul ou en groupe, réalise des graffitis sur les murs, les trottoirs ou le mobilier urbain."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04bf56a3-c280-4d56-a5da-9c2fc8c77db7",
                                                "sense_id": "4ab1a9f4-88fe-36a3-9284-4d2f6c66b857",
                                                "text": "Si son atelier est aux Lilas (93) – pas loin de la station de métro rendue célèbre par Gainsbourg –, Jonone n’a rien d’un poinçonneur : c’est un graffeur."
                                            },
                                            {
                                                "example_id": "a301a0f7-8219-45bb-836f-2c961b74e6ef",
                                                "sense_id": "4ab1a9f4-88fe-36a3-9284-4d2f6c66b857",
                                                "text": "Pour les graffeurs, le train est moins une source d’inspiration qu’une matière première : un support particulier tant par ses proportions et sa texture que par sa mobilité au sein d’un réseau surveillé."
                                            },
                                            {
                                                "example_id": "c84c97ae-77b8-4caf-9946-e04501107804",
                                                "sense_id": "4ab1a9f4-88fe-36a3-9284-4d2f6c66b857",
                                                "text": "Graffeurs en pleine action, initiations et concerts ponctueront cet évènement dévolu à la culture urbaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7510c6ed-95a2-428e-85fe-f9ef2d0711c6",
                        "source_entry_id": "4f3e481b-0e6d-3316-9fd1-957a5883cf6d",
                        "source_sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                        "source_sense_description": "jemand, der mit Sprühfarben Graffiti erstellt",
                        "target_lang_word": "graffiteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graffiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d4dfba-2c80-3d22-a2ae-a8b853981c25",
                                        "entry_id": "333f1f52-ed2e-3a24-a3e0-f88c31aa0e22",
                                        "glosses": [
                                            "Personne qui fait des graffitis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c678a4ae-d69b-4f3a-8813-beeb9d0f668f",
                                                "sense_id": "a2d4dfba-2c80-3d22-a2ae-a8b853981c25",
                                                "text": "En effet, l’arrondissement a pris la décision d’augmenter les amendes attribuées aux graffiteurs majeurs (18 ans et plus) qui laissent leur signature sur les bâtiments privés ou publics."
                                            },
                                            {
                                                "example_id": "e5c931f2-1bae-4783-9c35-e8e365cb496f",
                                                "sense_id": "a2d4dfba-2c80-3d22-a2ae-a8b853981c25",
                                                "text": "En hommage au passé de graffiteur de Basquiat sous le pseudonyme SAMO, Zilon entamait, le lundi 1ᵉʳ mars, dans le grand foyer culturel de la Place des Arts, une œuvre participative accessible jusqu’au 27 mars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
