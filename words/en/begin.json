                                "pl": "<w>Zacząłem</w> grać na pianinie w wieku pięciu lat.",
                                "de": "Ich <w>begann</w> im Alter von fünf Jahren Klavier zu spielen.",
                                "fr": "J'ai <w>commencé</w> à jouer du piano à l'âge de cinq ans.",
                                "it": "Ho <w>cominciato</w> a suonare il pianoforte all'età di cinque anni.",
                                "cs": "<w>Začal jsem</w> hrát na klavír v pěti letech.",
                                "tr": "Beş yaşındayken piyano çalmaya <w>başladım</w>.",
                                "es": "<w>Empecé</w> a tocar el piano a los cinco años.",
                                "zh": "我五岁时<w>开始</w>弹钢琴。",
                                "ja": "私は五歳のときにピアノを弾き<w>始めました</w>。",
                                "pt": "<w>Comecei</w> a tocar piano aos cinco anos."
                            }
                        },
                        {
                            "text": "We should <w>begin</w> with a brief introduction of the team.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>начать</w> с краткого представления команды.",
                                "nl": "We moeten <w>beginnen</w> met een korte introductie van het team.",
                                "pl": "Powinniśmy <w>zacząć</w> od krótkiego przedstawienia zespołu.",
                                "de": "Wir sollten mit einer kurzen Vorstellung des Teams <w>beginnen</w>.",
                                "fr": "Nous devrions <w>commencer</w> par une brève présentation de l'équipe.",
                                "it": "Dovremmo <w>iniziare</w> con una breve presentazione del team.",
                                "cs": "Měli bychom <w>začít</w> krátkým představením týmu.",
                                "tr": "Ekibin kısa bir tanıtımıyla <w>başlamalıyız</w>.",
                                "es": "Deberíamos <w>comenzar</w> con una breve presentación del equipo.",
                                "zh": "我们应该从团队的简短介绍<w>开始</w>。",
                                "ja": "私たちは、チームの簡単な紹介から<w>始める</w>べきです。",
                                "pt": "Devíamos <w>começar</w> por uma breve apresentação da equipa."
                            }
                        },
                        {
                            "text": "The program <w>begins</w> at 9 o’clock on the dot.",
                            "target_lang_translations": {
                                "ru": "Программа <w>начинается</w> ровно в 9 часов.",
                                "nl": "Het programma <w>begint</w> stipt om 9 uur.",
                                "pl": "Program <w>zaczyna się</w> punktualnie o dziewiątej.",
                                "de": "Das Programm <w>beginnt</w> pünktlich um 9 Uhr.",
                                "fr": "Le programme <w>commence</w> à 9 heures pile.",
                                "it": "Il programma <w>inizia</w> alle 9 in punto.",
                                "cs": "Program <w>začíná</w> přesně v 9 hodin.",
                                "tr": "Program tam saat 9'da <w>başlıyor</w>.",
                                "es": "El programa <w>empieza</w> a las 9 en punto.",
                                "zh": "节目九点整<w>开始</w>。",
                                "ja": "プログラムは9時ちょうどに<w>始まります</w>。",
                                "pt": "O programa <w>começa</w> às 9 horas em ponto."
                            }
                        }
