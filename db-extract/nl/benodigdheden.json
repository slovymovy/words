                    {
                        "translation_id": "0e508826-2acd-49de-ad53-d18e54c55277",
                        "source_entry_id": "9af44ebf-e625-3e79-8877-4c83bff2bfb9",
                        "target_lang_word": "necessaries",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necessaries",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c94cd5f2-d1e8-3a9c-8462-9e5f98e538c4",
                                        "entry_id": "c90756e2-72d6-3521-8187-4e8dcd142861",
                                        "glosses": [
                                            "Necessary or indispensable items."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b9bb65-1bc2-4c63-a215-3d70e65f6362",
                                                "sense_id": "c94cd5f2-d1e8-3a9c-8462-9e5f98e538c4",
                                                "text": "These exclamations continued till they were interrupted by the lady, who now proceeded to execute the commission given her by her brother, and gave orders for providing all necessaries for the child, appointing a very good room in the house for his nursery."
                                            },
                                            {
                                                "example_id": "b419b872-86fd-4e29-8738-9f928a96dd90",
                                                "sense_id": "c94cd5f2-d1e8-3a9c-8462-9e5f98e538c4",
                                                "text": "Life is full of strange contrasts; and who that could have seen—weary, yet walking as fast as she could, for she had a long way to go; faint, for of late she had debarred herself common necessaries; cold, for the rain soon pierced her thin cloak—who would have believed that she was the brilliant actress who, not an hour since, was the gaze of every eye, while the whole house rang with applause?"
                                            },
                                            {
                                                "example_id": "fe84d02e-4eaf-4632-ac79-2ddef1cc5a8f",
                                                "sense_id": "c94cd5f2-d1e8-3a9c-8462-9e5f98e538c4",
                                                "text": "Mechanically he returned home, gathered together a few small necessaries and special treasures he was fond of, and put them in a satchel; acting with slow deliberation, moving about the room like a sleep-walker; listening ever with parted lips."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
