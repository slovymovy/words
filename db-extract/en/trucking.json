                        ],
                        "examples": [
                            {
                                "example_id": "9a8a9ac4-fc88-4377-80b3-8f09eb3b6491",
                                "sense_id": "9b6d562b-067a-3535-9c9c-d0e24457bc23",
                                "text": "This they were wont to use also for hatchets, but now by trucking they have plentie of the same forme of yron."
                            }
                        ]
                    },
                    {
                        "sense_id": "8811d75f-4e86-37bb-8973-50a4e752cfad",
                        "entry_id": "ee1e7bbc-c5c2-39cd-8a4b-1b06c633d6bc",
