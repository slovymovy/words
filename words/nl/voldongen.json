                        "beslist"
                    ],
                    "antonyms": [
                        "onvoldongen"
                    ],
                    "common_phrases": [
                        "voldongen feit"
                    ],
                    "target_lang_definitions": {
                        "en": "Definitively decided and no longer subject to change."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accomplished",
                                "target_lang_sense_clarification": "as in fait accompli"
                            },
                            {
