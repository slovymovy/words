                "senses": [
                    {
                        "sense_id": "e9c01ce5-0ce3-3a8b-a50c-646c453cf8f2",
                        "entry_id": "d732d588-6103-3c97-b1b7-98fce076968e",
                        "glosses": [
                            "Radicaliser de façon extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc64e702-bb2e-456c-a7e5-aa4a5434f518",
                                "sense_id": "e9c01ce5-0ce3-3a8b-a50c-646c453cf8f2",
                                "text": "Selon le spécialiste du terrorisme, \"il est présent sur le théâtre d’opération depuis un an et demi, où il s’est ultra-radicalisé et formé au maniement des armes”."
                            },
                            {
                                "example_id": "1ced5769-557a-4d25-a246-c45b96d26b55",
                                "sense_id": "e9c01ce5-0ce3-3a8b-a50c-646c453cf8f2",
                                "text": "C'est la politique américaine antibolivarienne dans la droite ligne de l'installation des dictatures en Amériquedu Sud, mais une nouvelle version, qui a ultra-radicalisé les FARC."
                            },
                            {
                                "example_id": "6cf23312-c0e6-440f-837b-d2a9aa4d721a",
                                "sense_id": "e9c01ce5-0ce3-3a8b-a50c-646c453cf8f2",
                                "text": "La droite et l’extrême droite réunies, absorbant le courant catholique ultra-radicalisé de la « Manif pour tous », peuvent gagner bien des villes."
                            }
                        ]
                    }
