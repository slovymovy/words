                    {
                        "translation_id": "b84d6a85-faa9-4bf7-89ac-99967eed1e24",
                        "source_entry_id": "13239824-25f0-3f28-9803-060911c476a2",
                        "source_sense_id": "f57a2108-8cd7-3514-a4b7-22986ac06eb3",
                        "source_sense_description": "een rinkelend geluid maken",
                        "target_lang_word": "clang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e611a254-1795-3f7a-803c-e18527046e18",
                                        "entry_id": "f9bc46bf-e88d-3afe-8865-4f96bb0ece9c",
                                        "glosses": [
                                            "To strike (objects) together so as to produce a clang."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb01b818-2004-43a9-9a62-525372a15fde",
                                                "sense_id": "e611a254-1795-3f7a-803c-e18527046e18",
                                                "text": "Around, the first Curetes (order solemn / To thy foreknowing mother!) trod tumultuous / Their mystic dance, and clanged their sounding arms; [...]"
                                            },
                                            {
                                                "example_id": "ab8e3755-5a76-48be-a7e5-bf5f8ae7f0e1",
                                                "sense_id": "e611a254-1795-3f7a-803c-e18527046e18",
                                                "text": "A dented metal punching bag waiting to be clanged; a solitary object in the rhino's cage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                        "entry_id": "f9bc46bf-e88d-3afe-8865-4f96bb0ece9c",
                                        "glosses": [
                                            "To give out a clang; to resound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10fee94d-2d6e-481d-9a37-fae7fcc189c6",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "Middlesbrough will wonder whether it might have been different if the volley that Jelle Vossen slashed towards John Ruddy’s net after nine minutes had been a couple inches lower rather than clanging off the crossbar. They should not dwell on that moment too long, however."
                                            },
                                            {
                                                "example_id": "638113f4-85fc-4933-9ccf-49fbd4e811ac",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "A cell door clanged metallically and Wentworth was flung inside. He tripped, collapsed upon the concrete floor."
                                            },
                                            {
                                                "example_id": "761714eb-cdca-40c6-bbdb-91037b3d5657",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "The clanging and groaning of the train came nearer, and it staggered slowly into the station like a prey- laden monster into its lair."
                                            },
                                            {
                                                "example_id": "32904c64-6179-408a-9458-274f74a09498",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "Then the sparks flew from the anvil while the great hammer clanged on the metal, shaping it, and Henry begged to be allowed to try it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18160406-d0c1-3b62-82f8-5e79b07dde84",
                                        "entry_id": "f9bc46bf-e88d-3afe-8865-4f96bb0ece9c",
                                        "glosses": [
                                            "To utter a word or phrase linked only by sound and not by meaning, characteristic of some mental disorders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a6a17c-cf59-33b2-8933-b9b9cef42ccb",
                                        "entry_id": "58a02a62-5d83-3e6c-8675-c2fd4825a9e7",
                                        "glosses": [
                                            "Imitative of a loud metallic ringing sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51a2f2da-6386-3d70-9efa-917f86f5b9b5",
                                        "entry_id": "58a02a62-5d83-3e6c-8675-c2fd4825a9e7",
                                        "glosses": [
                                            "Said after someone has name-dropped (mentioned a famous person with whom they are acquainted)."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ebc155a-2dc7-3ec2-8585-5caa94d7c3ee",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "A loud, ringing sound, like that made by free-hanging metal objects striking each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ece275-70de-4919-b4e7-e4c44f6ff44d",
                                                "sense_id": "2ebc155a-2dc7-3ec2-8585-5caa94d7c3ee",
                                                "text": "Bang, bang, Maxwell's silver hammer\nCame down upon her head\nClang, clang, Maxwell's silver hammer\nMade sure that she was dead"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a655f86-b936-39b3-b6e7-5bbbbfe10e22",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "Quality of tone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f2beffc-a12e-3ce8-995d-361d87786ff8",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "The cry of some birds, including the crane and the goose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c47c502-984d-3c7f-b34e-ffeb3b72751b",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "A word or phrase linked only by sound and not by meaning, characteristic of some mental disorders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb50578c-6797-409c-985c-c0b5b7968a09",
                                                "sense_id": "5c47c502-984d-3c7f-b34e-ffeb3b72751b",
                                                "text": "For much of this day, Mrs Y. wrote in her diary, covering page after page in a rapid scrawl full of paligraphic repetitions, puns, clangs, and violent, perseverative crossings-out […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed4232cc-b104-3f4b-8a31-988015a8be83",
                                        "entry_id": "1be1adf7-766f-3b82-98b4-261994c0e8d6",
                                        "glosses": [
                                            "Alternative form of klang."
                                        ],
