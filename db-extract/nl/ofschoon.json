                    {
                        "translation_id": "431ae2e6-4b9d-4437-803e-6cbf142eb54a",
                        "source_entry_id": "01fa36ff-e619-3ff7-936d-60a425ea71f6",
                        "source_sense_id": "e2ff2779-e3aa-3b3b-9408-aa4ee598051c",
