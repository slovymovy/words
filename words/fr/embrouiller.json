                {
                    "sense_id": "fb77f9c1-2dc1-34f7-b674-518dba442512",
                    "sense_definition": "Provoquer, importuner ou chercher une dispute avec quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conflit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet individu agressif a commencé à <w>embrouiller</w> les passants sans aucune raison.",
                            "target_lang_translations": {
                                "en": "This aggressive person started <w>tangling</w> with passers-by for no reason.",
                                "ru": "Этот агрессивный тип без всякой причины начал <w>задирать</w> прохожих.",
                                "de": "Dieser aggressive Typ hat ohne jeden Grund Passanten <w>angepöbelt</w>.",
                                "es": "Este individuo agresivo empezó a <w>provocar</w> a los transeúntes sin ningún motivo.",
                                "zh": "这个好斗的家伙无缘无故地开始<w>招惹</w>路人。"
                            }
                        },
                        {
                            "text": "Ils ont failli se battre après s'être <w>embrouillés</w> pour une simple place de parking.",
                            "target_lang_translations": {
                                "en": "They almost came to blows after <w>tangling</w> over a mere parking space.",
                                "ru": "Они чуть не подрались, после того как <w>поцапались</w> из-за простого парковочного места.",
                                "de": "Sie hätten sich fast geprügelt, nachdem sie <w>sich</w> wegen eines einfachen Parkplatzes <w>angelegt</w> hatten.",
                                "es": "Estuvieron a punto de pelearse tras <w>enzarzarse</w> por un simple sitio para aparcar.",
                                "zh": "他们为一个停车位的小事互相<w>找茬儿</w>，结果差点打起来。"
                            }
                        }
