                "senses": [
                    {
                        "sense_id": "a6712bc4-1b84-3600-9d8e-fd2e29f4ef12",
                        "entry_id": "97913d97-ed5d-3ad2-8193-37d14320a55b",
                        "glosses": [
                            "Servir de paranymphe et prononcer l'éloge du docteur qu'on reçoit."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3b82b48a-ed08-3a9b-bd6d-8527e52ed362",
                        "entry_id": "97913d97-ed5d-3ad2-8193-37d14320a55b",
                        "glosses": [
                            "Louer avec solennité."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e9025eb5-a3d7-462a-999e-f6bafe92f804",
                                "sense_id": "3b82b48a-ed08-3a9b-bd6d-8527e52ed362",
                                "text": "C’est ainsi que les lois de l’histoire obligent ceux qui l’écrivent à donner connaissance de ce qu’il y a de bon et de mauvais en chaque chose, sans faire difficulté de vespériser les mêmes personnes qu’ils ont déjà paranymphées"
                            },
                            {
                                "example_id": "67750908-01d5-44d7-ac57-f43f3496656e",
                                "sense_id": "3b82b48a-ed08-3a9b-bd6d-8527e52ed362",
                                "text": "Les louanges lui étaient bonnes [à Balzac], de quelque part qu’elles vinssent, et jamais il n’étoit assez paranymphé à sa fantaisie"
                            }
                        ]
                    }
