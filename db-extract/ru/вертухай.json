                        "cross_references": [
                            {
                                "target_word": "maton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f73b53b-62dc-3496-86d6-bf0a59ce8c5a",
                                        "entry_id": "c946b8d9-df49-3013-97c0-c8d6502be611",
                                        "glosses": [
                                            "Lait caillé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa0e6f7a-02fc-44d4-a2d3-d53856d1bec9",
                                                "sense_id": "5f73b53b-62dc-3496-86d6-bf0a59ce8c5a",
                                                "text": "L’Union européenne a accordé officiellement à la Mattentaart (tarte au maton) de Grammont, en Flandre orientale le statut de \"produit européen du terroir\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db3c9de7-8106-3722-ad75-e8376206138c",
                                        "entry_id": "c946b8d9-df49-3013-97c0-c8d6502be611",
                                        "glosses": [
                                            "Petite masse agglomérée de certaines matières, qui se forme par accident lors de la fabrication."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7317fd-6824-4339-abe3-f30d6093a7ae",
                                                "sense_id": "db3c9de7-8106-3722-ad75-e8376206138c",
                                                "text": "Un maton de pâte à papier."
                                            },
                                            {
                                                "example_id": "03c1a1d3-59f0-4740-a897-63d7fc56d608",
                                                "sense_id": "db3c9de7-8106-3722-ad75-e8376206138c",
                                                "text": "Un maton de laine s’est formé lors du cardage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2265e475-5905-3327-979b-cb4a001fa5fd",
                                        "entry_id": "69df9c36-7737-3b4b-b5be-6fa58da6c20c",
                                        "glosses": [
                                            "Gardien de prison."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcab7923-bf48-4e61-b7d0-3ead711dddff",
                                                "sense_id": "2265e475-5905-3327-979b-cb4a001fa5fd",
                                                "text": "On a beau lutter contre, les clichés nous habitent. « Gardien de prison », par exemple : cette profession n’évoquait que modérément, pour moi, l’humanisme. C’est une fraternité qu’on ressent, pourtant, chez Luc Rody, maton à la maison d’arrêt d’Amiens et délégué CGT (syndicat majoritaire)."
                                            }
                                        ]
                                    }
                                ]
                            }
