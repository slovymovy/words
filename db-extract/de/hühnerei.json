                ],
                "senses": [
                    {
                        "sense_id": "07d38ea3-3c19-3177-b216-23422db48360",
                        "entry_id": "5cca3884-f57f-33b1-af32-f9391fd8ba2e",
                        "glosses": [
                            "Ei, das von einem Huhn stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbd80ea-0d92-4c9b-ab46-1505ae9b8d18",
                                "sense_id": "07d38ea3-3c19-3177-b216-23422db48360",
                                "text": "„Zur Herstellung werden rohe Enteneier oder auch – seltener – Hühnereier für etwa drei Monate in einem Brei aus Holzkohle, gebranntem Kalk, Salz und Wasser eingelegt.“"
                            },
                            {
                                "example_id": "dc9c1469-c431-4d4d-9122-e56b1dc42609",
                                "sense_id": "07d38ea3-3c19-3177-b216-23422db48360",
                                "text": "„Jeder hatte einen Revolver in der Hand, und der Dünne hielt in der Rechten außerdem noch einen Gegenstand, der wie ein sehr großes schwarzes Hühnerei aussah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
