                "senses": [
                    {
                        "sense_id": "0f6d760e-dcc4-3d27-93b2-28350ca3d651",
                        "entry_id": "ed314fc4-1e55-3a04-ab08-c615139eae52",
                        "glosses": [
                            "kürzeste Dauer eines sich zeitlich periodisch wiederholenden Vorgangs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d36a4906-dbee-499b-88ea-647f83b1f394",
                                "sense_id": "0f6d760e-dcc4-3d27-93b2-28350ca3d651",
                                "text": "Die Periodendauer der Netzfrequenz beträgt 20 ms."
