                                                "sense_id": "85ded802-5829-3ea7-8d8a-fadae21276d0",
                                                "text": "Konstruktiv gesehen kann das Gebäude als gelungen betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5039ba67-fed7-3463-973e-40c3ce5f9515",
                                        "entry_id": "19a14810-cc64-3bfc-a907-d326f7883c8a",
                                        "glosses": [
                                            "eine förderliche, positive Haltung einnehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e81973-58ea-4b69-84cb-0d184868cc7c",
                                                "sense_id": "5039ba67-fed7-3463-973e-40c3ce5f9515",
                                                "text": "Er liefert immer wieder sehr konstruktive Beiträge zu unserem Vereinsleben."
                                            },
                                            {
                                                "example_id": "44f9a134-d8cb-45e5-a6c1-a3816523e5a7",
                                                "sense_id": "5039ba67-fed7-3463-973e-40c3ce5f9515",
                                                "text": "Er wurde durch ein konstruktives Misstrauensvotum gestürzt."
                                            }
                                        ],
