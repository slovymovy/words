                "senses": [
                    {
                        "sense_id": "b3341a85-0f72-3b1c-892f-2d7cc6613ef6",
                        "entry_id": "3886998c-b7c0-33a0-a4b7-164cbd4fb71b",
                        "glosses": [
                            "Séparation entre deux éléments de prononciation (phonèmes, etc.), qui est pertinente pour la compréhension d’une langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6f7281f-1d34-48d1-a866-b547f763e3ba",
                                "sense_id": "b3341a85-0f72-3b1c-892f-2d7cc6613ef6",
                                "text": "La joncture (« Junktur » ou « Junktion » en allemand) est l’endroit où deux morphèmes se rencontrent. Il peut y avoir alors des phénomènes d’assimilation ou de différenciation. En français, par exemple, il est caractéristique d’éliminer autant que possible toute joncture de deux voyelle. Suivant les cas, cela est réalisé par l’élision […] ou par la liaison […].\nLe phénomène de joncture le plus important en allemand est à tendance inverse. Au lieu de supprimer les ruptures marquées entre les mots, l’allemand les accentue pour donner son autonomie articulatoire à chacun d’eux. L’instrument qu’il y emploie est le coup de glotte […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52943a3d-1b72-4b41-b5cc-526dbc4a74cb",
                        "source_entry_id": "3886998c-b7c0-33a0-a4b7-164cbd4fb71b",
                        "source_sense_id": "b3341a85-0f72-3b1c-892f-2d7cc6613ef6",
                        "target_lang_word": "Junktur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Junktur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                                        "entry_id": "717373c1-c36a-3b42-9720-599f60cdc623",
                                        "glosses": [
                                            "suprasegmentales Merkmal, das eine Morphem- oder Wortgrenze anzeigt"
                                        ],
                                        "tags": [
                                            "speziell Phonologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5e66df2-3da2-4956-90ca-ac569de7d962",
                                                "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                                                "text": "„Erst, wenn man einen Ausschnitt der Lautfolge isoliert, kann man leichter bestimmen, ob ein fester oder ein loser Anschluß - linguistisch gesprochen: eine geschlossene oder offene Junktur - vorliegt.“"
                                            },
                                            {
                                                "example_id": "436c4166-483a-4127-8dbd-8acf0a1108a4",
                                                "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                                                "text": "Die Wortfolgen „Ski fliegen“ und „schief liegen“ unterscheiden sich phonologisch nur durch die unterschiedliche Junktur."
                                            },
                                            {
                                                "example_id": "3730b4e8-e15a-4249-8888-5cd157eaa049",
                                                "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                                                "text": "„Wir vermeiden damit Formulierungen wie: Junktur markiert Fuge zwischen zwei Morphemen, was umgekehrt keineswegs immer der Fall ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
