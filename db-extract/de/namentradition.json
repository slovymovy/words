                "senses": [
                    {
                        "sense_id": "7f89cb83-1ab2-39f5-877c-77c76f856581",
                        "entry_id": "0b896049-6929-38b1-a7ac-89948ee7e494",
                        "glosses": [
                            "herkömmliche Gewohnheit, bestimmte Namen zu wählen, zu bevorzugen oder auch zu meiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f8a25b8-9d0f-4f4b-bc07-0b592d1509a1",
                                "sense_id": "7f89cb83-1ab2-39f5-877c-77c76f856581",
                                "text": "„Parallel zu den internationalen Trends spielt in manchen europäischen Regionen die eigene Namentradition eine wichtige Rolle.“"
                            },
                            {
                                "example_id": "9d4e9002-85ae-4661-80bf-ef2eb3cd2025",
                                "sense_id": "7f89cb83-1ab2-39f5-877c-77c76f856581",
                                "text": "„Dabei soll das Interesse vor allem auf die Flurnamen und die aus ihnen abgeleiteten sekundären Siedlungsnamen gerichtet werden, da man diesen Materialkategorien auf Grund der speziellen Bedingungen der Namentradition und des archaischen Charakters des landwirtschaftlichen Sachwortschatzes eine besondere Nähe zur sprachlichen Grundschicht unterstellen kann.“"
                            },
                            {
                                "example_id": "56a333a6-cb1a-492c-8520-e9bd4bafe0a6",
                                "sense_id": "7f89cb83-1ab2-39f5-877c-77c76f856581",
                                "text": "„Schon damals hat es mich fasziniert, aus Namentraditionen Familienzusammenhänge zu erschließen.“"
                            },
                            {
                                "example_id": "3aa1e5cd-96a5-4215-84fb-250e0c3cdf89",
                                "sense_id": "7f89cb83-1ab2-39f5-877c-77c76f856581",
                                "text": "„So etwa ergeben sich aus der onomastischen Analyse der Personennamen Rückschlüsse auf Namentraditionen in Aschkenas.“"
                            },
                            {
                                "example_id": "2a7b2b0a-33be-4ddc-aa12-aa2ad81fa037",
                                "sense_id": "7f89cb83-1ab2-39f5-877c-77c76f856581",
                                "text": "„Da viele User nicht von Windows 8 überzeugt werden konnten und nach wie vor mit dem Vorgänger Windows 7 arbeiten, kann dieser Bruch in der Namentradition darauf hinweisen, dass die Nutzer Neues erwartet.“"
                            }
                        ],
