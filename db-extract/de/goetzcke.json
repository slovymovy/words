                ],
                "senses": [
                    {
                        "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                        "entry_id": "05b8f8e3-9f29-38a2-9084-7b1c7f3918d5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ddac6a-9730-4c2c-aab0-29a96d4277e1",
                                "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                                "text": "Frau Goetzcke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0bbe6f14-15d6-48af-99a5-3b0196974da4",
                                "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                                "text": "Herr Goetzcke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c71777c1-5ee1-44bb-9d61-97d91af8b5a7",
                                "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                                "text": "Die Goetzckes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "08605880-6563-4dfc-b72a-5cc3b26c49c5",
                                "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                                "text": "Der Goetzcke trägt nie die Schals, die die Goetzcke ihm strickt."
                            },
                            {
                                "example_id": "56cbe7be-459b-488a-a31d-cc8a6062a36b",
                                "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Goetzcke kommt, geht der Herr Goetzcke.“"
                            },
                            {
                                "example_id": "c162cd10-b9df-46d8-b806-377fda1e80aa",
                                "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                                "text": "Goetzcke kommt und geht."
                            },
                            {
                                "example_id": "e3e70e40-4afc-4353-b9a2-c71e0842bf5f",
                                "sense_id": "4ee38675-7bb4-32f6-8998-c1cd4fb05fde",
                                "text": "Goetzckes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
