                "senses": [
                    {
                        "sense_id": "57dd15e4-d7ce-3e17-a919-76b4a5528ca2",
                        "entry_id": "72d470d2-1e2e-34fe-b7a3-b6f262fd7190",
                        "glosses": [
                            "international vereinbarte Kennziffern oder Kennbuchstaben zur Identifikation der Länder in verschiedenen Bereichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5810963-e1a0-4552-9cde-5bf283e6d263",
                                "sense_id": "57dd15e4-d7ce-3e17-a919-76b4a5528ca2",
                                "text": "Gekaufte DVDs mit Spielfilmen sind mit einem Ländercode versehen."
                            },
                            {
                                "example_id": "d3979ed0-e944-4726-bcc1-2bf2af5a13c2",
                                "sense_id": "57dd15e4-d7ce-3e17-a919-76b4a5528ca2",
                                "text": "Der Ländercode auf den Euro-Banknoten gibt Auskunft über die zum Druck beauftragte Notenbank."
                            },
                            {
                                "example_id": "fcf5c26e-5ce2-4a80-bdf6-972849ee5d1c",
                                "sense_id": "57dd15e4-d7ce-3e17-a919-76b4a5528ca2",
                                "text": "Mit \".com\", \".net\", \".org\" oder einem Ländercode enden Internetdomains bisher."
                            },
                            {
                                "example_id": "2c94efba-63e2-40e7-b865-c554e9b7556a",
                                "sense_id": "57dd15e4-d7ce-3e17-a919-76b4a5528ca2",
                                "text": "Hat eine jetzige deutsche Nummer beispielsweise neun Ziffern, kämen in Zukunft 13 weitere hinzu, weil ein Ländercode, zwei Sicherheitsziffern und die Bankleitzahl eingefügt werden."
                            },
                            {
                                "example_id": "d49f58b5-948a-486a-a2a5-433aef4c3b5a",
                                "sense_id": "57dd15e4-d7ce-3e17-a919-76b4a5528ca2",
                                "text": "[…] Ganze zehn Tage brauchte das Fedex-Paket, da der Kurierfahrer bei der Abholung in seinen Computer als Zielland statt des internationalen Ländercodes \"HV\" für Kroatien \"CR\" eingegeben hatte, den Ländercode für Costa Rica."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
