                "senses": [
                    {
                        "sense_id": "e1a24374-2e82-3d36-afa3-9efc6bf811a2",
                        "entry_id": "1b2f8928-01ca-3a26-8cb2-cbaee83b9723",
                        "glosses": [
                            "Écumer de façon insuffisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2e9036-d6a7-4f8b-ad76-973678c9d225",
                                "sense_id": "e1a24374-2e82-3d36-afa3-9efc6bf811a2",
                                "text": "A noter que je n'ai pas l'intention de surécumer mais encore moins de sous-écumer."
                            },
                            {
                                "example_id": "749b87af-b4da-44c3-aa02-0032da248ee1",
                                "sense_id": "e1a24374-2e82-3d36-afa3-9efc6bf811a2",
                                "text": "J'ai tendance toujours a surdimensionner l'écumeur, je préfère en effet sur-écumer que sous-écumer :))"
                            },
                            {
                                "example_id": "16a28f8b-2096-43c0-bba7-9559497dd94d",
                                "sense_id": "e1a24374-2e82-3d36-afa3-9efc6bf811a2",
                                "text": "ne pas surpeupler, ne pas sous-écumer, sous-brasser, sous-éclairer, sur-nourrir, etc."
                            }
                        ]
                    }
