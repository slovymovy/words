            "senses": [
                {
                    "sense_id": "3915427c-9b80-3290-ad77-0eaaf06704f0",
                    "sense_definition": "Een traditionele muts, vaak gedragen als onderdeel van klederdracht door boerinnen of nonnen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude vrouw droeg nog dagelijks haar witte <w>hul</w> bij haar klederdracht.",
                            "target_lang_translations": {
                                "en": "The old woman still wore her white <w>cap</w> with her folk costume every day."
                            }
                        },
                        {
                            "text": "In het museum zagen we een historische <w>hul</w> uit de negentiende eeuw.",
                            "target_lang_translations": {
                                "en": "In the museum, we saw a historical <w>bonnet</w> from the nineteenth century."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Verwijst naar historische klederdracht."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A traditional cap, often worn as part of folk costume by peasant women or nuns."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cap",
                                "target_lang_sense_clarification": "A traditional or historical head covering."
                            },
                            {
                                "target_lang_word": "bonnet",
                                "target_lang_sense_clarification": "A type of headgear often associated with historical or folk attire."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3b216c6-2b14-3af3-945e-fa625ab730c0",
                    "sense_definition": "Een verhoging in het landschap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "landschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanaf de kleine <w>hul</w> in het weiland kon je het hele dorp zien liggen.",
                            "target_lang_translations": {
                                "en": "From the small <w>hill</w> in the meadow, you could see the whole village."
                            }
                        },
                        {
                            "text": "De kinderen renden vrolijk de groene <w>hul</w> op en af.",
                            "target_lang_translations": {
                                "en": "The children ran happily up and down the green <w>mound</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "heuvel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Wordt vooral in bepaalde regio's gebruikt."
