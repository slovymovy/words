            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c343b2f-fac2-3c42-a549-c3e4620e235f",
                    "sense_definition": "Punir une infraction, un manquement ou une faute en appliquant une peine ou une pénalité.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "punition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre n'a pas hésité à <w>sanctionner</w> cette faute dangereuse d'un carton rouge."
                        },
                        {
                            "text": "Le tribunal a décidé de <w>sanctionner</w> sévèrement les entreprises qui polluent la rivière."
                        }
                    ],
                    "synonyms": [
                        "punir",
                        "pénaliser",
                        "réprimer"
                    ],
                    "antonyms": [
                        "récompenser",
                        "pardonner"
                    ],
                    "common_phrases": [
                        "sanctionner une faute",
                        "sanctionner les abus",
                        "sanctionner les infractions"
                    ]
                },
                {
                    "sense_id": "891f6941-1314-334b-9312-4e1c8ba06d70",
                    "sense_definition": "Confirmer ou valider solennellement un texte, une loi ou un usage en lui conférant une force obligatoire ou reconnue.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "approbation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parlement doit encore <w>sanctionner</w> ce texte de loi avant son application définitive."
                        },
                        {
                            "text": "Ce mot d'argot a fini par être <w>sanctionné</w> par l'usage et par les dictionnaires."
                        }
                    ],
                    "synonyms": [
                        "entériner",
                        "ratifier",
                        "valider",
                        "approuver"
                    ],
                    "antonyms": [
                        "invalider",
                        "rejeter",
                        "abroger"
                    ],
                    "common_phrases": [
                        "sanctionner une loi",
                        "sanctionner un usage"
                    ]
                }
            ]
        }
