                "translations": [
                    {
                        "translation_id": "ce20d14f-03cd-4000-8b51-a4a26402f6d6",
                        "source_entry_id": "be9c7999-26ec-3074-91aa-d4400c0aed37",
                        "source_sense_id": "feeeb452-56de-38e5-97ad-4710570a00a1",
                        "target_lang_word": "agnostic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agnostic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa05943e-7485-3713-bd90-512ee11cea07",
                                        "entry_id": "59404a62-92b3-34c6-aa15-fb6889784c89",
                                        "glosses": [
                                            "Doubtful or uncertain about the existence or demonstrability of God or other deity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26411019-de37-472f-9c42-4a63eac2b666",
                                                "sense_id": "aa05943e-7485-3713-bd90-512ee11cea07",
                                                "text": "She left the church when she had become agnostic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7e814be-7fd7-3896-aa58-5d6733d74caf",
                                        "entry_id": "59404a62-92b3-34c6-aa15-fb6889784c89",
                                        "glosses": [
                                            "Having no firmly held opinions on something."
                                        ],
                                        "tags": [
                                            "informal",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d1bd0a-4ff9-429a-99f2-9316b531cd4d",
                                                "sense_id": "c7e814be-7fd7-3896-aa58-5d6733d74caf",
                                                "text": "I'm agnostic on whether ethanol is a green fuel."
                                            },
                                            {
                                                "example_id": "aac9e9a3-51e8-4c43-a4cc-f55dc4ed0d63",
                                                "sense_id": "c7e814be-7fd7-3896-aa58-5d6733d74caf",
                                                "text": "He says he's agnostic concerning the Secretary's claims."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f1cd480-d8db-332e-bc8b-0ee9c6411464",
                                        "entry_id": "59404a62-92b3-34c6-aa15-fb6889784c89",
                                        "glosses": [
                                            "Of or relating to agnosticism or its adherents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcd568e-a38c-416a-87c6-4861c78f8c2d",
                                                "sense_id": "6f1cd480-d8db-332e-bc8b-0ee9c6411464",
                                                "text": "His agnostic viewpoint is summarized in his book."
                                            },
                                            {
                                                "example_id": "9a6de1d3-a3f9-474e-a43b-0d1e69dc26ef",
                                                "sense_id": "6f1cd480-d8db-332e-bc8b-0ee9c6411464",
                                                "text": "In matters of the intellect do not pretend that conclusions are certain which are not demonstrated or demonstrable. That I take to be the agnostic faith, which if a man keep whole and undefiled, he shall not be ashamed to look the universe in the face, whatever the future may have in store for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eabd3c78-eb3f-3b81-ab30-b7e54c6cf2bd",
                                        "entry_id": "59404a62-92b3-34c6-aa15-fb6889784c89",
                                        "glosses": [
                                            "Unaware or noncommittal regarding the specific nature of the components or input with which it interacts."
                                        ],
                                        "tags": [
                                            "of a software component etc."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "401d5599-a433-4221-aee6-cceb789eccc3",
                                                "sense_id": "eabd3c78-eb3f-3b81-ab30-b7e54c6cf2bd",
                                                "text": "The socket communications layer is agnostic with regard to its underlying transport mechanism—it is “transport-agnostic”."
                                            },
                                            {
                                                "example_id": "5051f14d-6056-41a1-8ff1-f30586462829",
                                                "sense_id": "eabd3c78-eb3f-3b81-ab30-b7e54c6cf2bd",
                                                "text": "The software's registration key is platform agnostic and will work on both x86 and ARM processors."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agnostic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83a45564-386f-3f35-bcd8-63591f96a985",
                                        "entry_id": "a9089963-7332-3e2b-aed9-58483f597018",
                                        "glosses": [
                                            "A person who holds to a form of agnosticism, especially uncertainty of the existence of a deity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d58fe11-e55a-468c-b3ea-62f507177587",
                                                "sense_id": "83a45564-386f-3f35-bcd8-63591f96a985",
                                                "text": "The Agnostic is one who asserts—what no one denies—that there are limits to the sphere of human intelligence."
                                            },
                                            {
                                                "example_id": "87be8d72-3f76-41e9-99d0-979fa17a439a",
                                                "sense_id": "83a45564-386f-3f35-bcd8-63591f96a985",
                                                "text": "An agnostic thinks it impossible to know the truth in matters such as God and the future life with which Christianity and other religions are concerned."
                                            },
                                            {
                                                "example_id": "74548792-ad2e-428e-8ac8-fab1c60e150c",
                                                "sense_id": "83a45564-386f-3f35-bcd8-63591f96a985",
                                                "text": "When I say I'm an agnostic, I only mean that the evidence isn't in. There isn't compelling evidence that God exists — at least your kind of god — and there isn't compelling evidence that he doesn't."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f789587-f62b-42f4-8de4-97acb957b148",
                        "source_entry_id": "be9c7999-26ec-3074-91aa-d4400c0aed37",
                        "source_sense_id": "feeeb452-56de-38e5-97ad-4710570a00a1",
