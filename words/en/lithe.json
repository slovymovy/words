                },
                {
                    "sense_id": "5bf1461b-cc05-3d63-b135-4a6afa91d8ea",
                    "sense_definition": "To make soft, mild, or pliable; to soothe or mitigate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The herbal balm helped to <w>lithe</w> the inflamed skin on his hands.",
                            "target_lang_translations": {
                                "it": "Il balsamo alle erbe aiutò a <w>lenire</w> la pelle infiammata delle sue mani."
                            }
                        },
                        {
                            "text": "She spoke gently in an attempt to <w>lithe</w> his bitter resentment.",
                            "target_lang_translations": {
                                "it": "Parlò con dolcezza nel tentativo di <w>placare</w> il suo amaro risentimento."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in general use"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Rendere morbido o flessibile; lenire o mitigare (arcaico, obsoleto)."
