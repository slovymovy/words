                "senses": [
                    {
                        "sense_id": "ec4183d7-cc9f-394b-abd8-d14e8c293a4e",
                        "entry_id": "79ca0e30-e066-34c7-94f5-269b113e228f",
                        "glosses": [
                            "Transférer des gènes dans une cellule par l’intermédiaire d’un virus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f9751d1-0660-4d4e-be10-5c11cbca558e",
                                "sense_id": "ec4183d7-cc9f-394b-abd8-d14e8c293a4e",
                                "text": "Utiliser toutes sortes d'énergies même les résistances pour transformer, pour transducter, changer une forme d'énergie en une autre forme d'énergie."
                            },
                            {
                                "example_id": "0916212d-6002-44a7-83be-c4f73c6eb0a7",
                                "sense_id": "ec4183d7-cc9f-394b-abd8-d14e8c293a4e",
                                "text": "Adéquat, il est transducté en activité biochimique pour une parfaite recopie des cellules."
                            },
                            {
                                "example_id": "0bb5b46c-9c2e-4d3d-97ca-940a9f0e2ac9",
                                "sense_id": "ec4183d7-cc9f-394b-abd8-d14e8c293a4e",
                                "text": "Tout stimulus possède en lui-même une certaine énergie et le récepteur utilise cette énergie incidente pour la transducter en énergie électrique et générer au niveau de l'afférence primaire des potentiels d'action."
                            }
                        ]
                    }
