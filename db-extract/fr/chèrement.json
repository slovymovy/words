                "entry_id": "96c3ac93-3dba-3cbc-9137-5c438a42bdd1",
                "word": "chèrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24229441-99d7-32bb-81c2-388b1e3e46a5",
                        "entry_id": "96c3ac93-3dba-3cbc-9137-5c438a42bdd1",
                        "glosses": [
                            "Tendrement, avec beaucoup d’affection, avec beaucoup d’amour."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "49e3451b-d6f8-41b6-8aaf-aa7a7cad8b20",
                                "sense_id": "24229441-99d7-32bb-81c2-388b1e3e46a5",
                                "text": "Je l’aime chèrement. Je conserve cela chèrement."
                            }
                        ]
                    },
                    {
                        "sense_id": "86d33b54-a069-3eca-a6fb-d25d621ca2f6",
                        "entry_id": "96c3ac93-3dba-3cbc-9137-5c438a42bdd1",
                        "glosses": [
                            "Plutôt à haut prix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e923e6-bf90-4258-8c9d-5aecd99eb586",
                                "sense_id": "86d33b54-a069-3eca-a6fb-d25d621ca2f6",
                                "text": "Sa personne fut exposée en vente dans la place publique, ainsi que celle de son compagnon de voyage […] mais le valet, plus propre à la fatigue, fut vendu bien plus chèrement que le maître."
                            },
                            {
                                "example_id": "6ebfec8b-b7e6-4a57-8ad7-fd3a1150e452",
                                "sense_id": "86d33b54-a069-3eca-a6fb-d25d621ca2f6",
                                "text": "Acheter chèrement. Vendre, payer chèrement sa marchandise."
                            },
                            {
                                "example_id": "d0241eaa-0e74-4d70-b8ec-58c7b05a0905",
                                "sense_id": "86d33b54-a069-3eca-a6fb-d25d621ca2f6",
                                "text": "Il paya chèrement sa victoire. Il me vendit chèrement cette faveur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6964ad65-e161-4320-bff6-be0485fa2b22",
                        "source_entry_id": "96c3ac93-3dba-3cbc-9137-5c438a42bdd1",
                        "target_lang_word": "dearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e72aaa6f-e052-3ab9-8e77-607935252878",
                                        "entry_id": "b5f9b4da-c75e-38fa-af19-38bfcc58375f",
                                        "glosses": [
                                            "In a dear or precious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a69840-0ec5-4769-af54-687451dce7ed",
                                                "sense_id": "e72aaa6f-e052-3ab9-8e77-607935252878",
                                                "text": "the funeral of our dearly beloved sister"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbf6602d-436e-372f-82f9-77e7e9f458fb",
                                        "entry_id": "b5f9b4da-c75e-38fa-af19-38bfcc58375f",
                                        "glosses": [
                                            "In a dear or expensive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd005b5-1375-48bb-ad92-9fc4008514d1",
                                                "sense_id": "dbf6602d-436e-372f-82f9-77e7e9f458fb",
                                                "text": "a dearly priced item"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b443881f-4222-3df4-bb89-c503ce3aad25",
                                        "entry_id": "b5f9b4da-c75e-38fa-af19-38bfcc58375f",
                                        "glosses": [
                                            "At great expense; dear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7bee61a-25b3-4849-aa93-536233e8b13e",
                                                "sense_id": "b443881f-4222-3df4-bb89-c503ce3aad25",
                                                "text": "He paid dearly for his mistake."
                                            },
                                            {
                                                "example_id": "ab83a065-7c3c-4857-833f-ec4ed794489b",
                                                "sense_id": "b443881f-4222-3df4-bb89-c503ce3aad25",
                                                "text": "But I take solace in the fact that the public has seen the enormous mountain of evidence proving what Fox did, and Fox paid dearly for it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
