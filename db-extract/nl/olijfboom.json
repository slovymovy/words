                                                "sense_id": "8e05fb23-5c8c-3ae9-afee-779621d6a318",
                                                "text": "„Der Schatten des Olivenbaumes wirkte entspannend.“"
                                            },
                                            {
                                                "example_id": "0b11d045-2471-4ed8-9ba3-f1bb4c8fd5ae",
                                                "sense_id": "8e05fb23-5c8c-3ae9-afee-779621d6a318",
                                                "text": "„Die Geschichte von Kostas, dem Vater meiner Mutter, dreht sich tatsächlich um einen Olivenbaum und lässt mich gleich träumen.“"
                                            },
                                            {
                                                "example_id": "8ef03020-63d1-432b-a56b-e236ae556a62",
                                                "sense_id": "8e05fb23-5c8c-3ae9-afee-779621d6a318",
                                                "text": "„Schon sehr früh kultivierten die Kreter an bevorzugten Hanglagen Olivenbäume und Reben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
