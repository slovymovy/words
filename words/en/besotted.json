            "senses": [
                {
                    "sense_id": "0dc177e8-c768-3ea1-96f4-2cbc41d1d4d9",
                    "sense_definition": "Strongly infatuated or obsessed with someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infatuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was completely <w>besotted</w> with his new girlfriend and could not stop talking about her.",
                            "target_lang_translations": {
                                "ru": "Он был совершенно <w>без ума</w> от своей новой девушки и не мог перестать говорить о ней.",
                                "nl": "Hij was compleet <w>stapelverliefd</w> op zijn nieuwe vriendin en kon niet ophouden over haar te praten."
                            }
                        },
                        {
                            "text": "The audience was <w>besotted</w> by the singer's charming performance on stage.",
                            "target_lang_translations": {
                                "ru": "Публика была <w>очарована</w> обаятельным выступлением певца на сцене.",
                                "nl": "Het publiek was <w>betoverd</w> door het charmante optreden van de zanger op het podium."
                            }
                        }
                    ],
                    "synonyms": [
                        "infatuated",
                        "smitten",
                        "enamored",
                        "love-struck",
                        "captivated",
                        "head over heels"
                    ],
                    "antonyms": [
                        "indifferent",
                        "uninterested"
                    ],
                    "common_phrases": [
