                "senses": [
                    {
                        "sense_id": "e7092a7b-c672-3ec5-8c16-5ebd7a615def",
                        "entry_id": "df762c99-68a4-3e54-8802-a1b1088d4a20",
                        "glosses": [
                            "Nom usuel de Manilkara bidentata, arbre de la famille des Sapotacées (Sapotaceae) qui fournit un fruit comestible, ainsi qu'un latex (la gutta-balata) et un bois précieux (le massaranduba) à multiples usages commerciaux, il est originaire de la forêt amazonienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf123b4a-e88b-42fa-965e-11c964c1c148",
                                "sense_id": "e7092a7b-c672-3ec5-8c16-5ebd7a615def",
                                "text": "Le balata sert pour le charronnage et les roues de moulin."
                            },
                            {
                                "example_id": "d14fadda-bcd9-4852-851a-957e2f0abb98",
                                "sense_id": "e7092a7b-c672-3ec5-8c16-5ebd7a615def",
                                "text": "Et ils eurent la joie de voir Chéri-Bibi s’arrêter au pied d’un immense balata (arbre à caoutchouc), soulever une roche et creuser la terre à la pointe de son bâton de bois canon."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8975c7e-98c2-3ef1-8f90-6421ece02eb1",
                        "entry_id": "df762c99-68a4-3e54-8802-a1b1088d4a20",
                        "glosses": [
                            "Gomme produite par cet arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d105a53-bbda-4d7d-8e44-637b22c4cb58",
                                "sense_id": "c8975c7e-98c2-3ef1-8f90-6421ece02eb1",
                                "text": "Des cales assuraient leur stabilité et une couche de déchet de balata complétait la suspension."
                            }
                        ]
                    }
                ],
