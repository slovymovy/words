                        "sense_id": "066cceb5-eb0d-3fea-bc54-4e55d5fb45fc",
                        "entry_id": "7523903f-b89f-3421-a046-30a2249b50f3",
                        "glosses": [
                            "Qui avertit d’avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed79b68-8774-45db-ba24-a8de713e1700",
                                "sense_id": "066cceb5-eb0d-3fea-bc54-4e55d5fb45fc",
                                "text": "Les signes prémonitoires d’une guerre, d’une avalanche, d’un malheur quelconque."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddebcb70-0132-3121-a64e-1fb121d82f48",
                        "entry_id": "7523903f-b89f-3421-a046-30a2249b50f3",
                        "glosses": [
                            "Qualifie un signe ou une période qui précède l’apparition d’une maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e293e4e2-4902-4b8d-a7f8-27d9d6d234d3",
                                "sense_id": "ddebcb70-0132-3121-a64e-1fb121d82f48",
                                "text": "Une phase, un symptôme, une diarrhée prémonitoires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c765f9c1-f8f0-443d-b956-753d7a6e2d70",
