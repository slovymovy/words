                "senses": [
                    {
                        "sense_id": "611409aa-b661-37c7-9e60-2ac7053ee34a",
                        "entry_id": "411cc3c0-c14d-3e00-a43b-28de8a8871f6",
                        "glosses": [
                            "cecha tego, co banalne"
                        ],
                        "tags": [],
