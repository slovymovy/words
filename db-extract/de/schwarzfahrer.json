                                                "sense_id": "77b6b2dd-a32c-398d-99bd-da090e1eab70",
                                                "text": "Hij is een gewiekste zwartrijder."
                                            },
                                            {
                                                "example_id": "660fe68b-edd0-4613-b197-04698e23c95a",
                                                "sense_id": "77b6b2dd-a32c-398d-99bd-da090e1eab70",
