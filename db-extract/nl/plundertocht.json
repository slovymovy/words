                        "glosses": [
                            "een tocht die als doel heeft goederen wederrechtelijk te verwerven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4311db-1d5c-44b1-971e-7e114bba50cd",
                                "sense_id": "8fda8dd8-8d3e-3828-8e37-d3ec695e6a1a",
                                "text": "Het duo heeft een criminele plundertocht door het noorden, zuiden en oosten ondernomen, van de eerste gijzeling op 10 februari 2014 in het Drentse Echten tot hun arrestatie in een hotel-steekhouse in het Duitse Schwerte, woensdag 26 februari 2014."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca8e7353-40ea-317c-86f0-128c43486150",
                        "entry_id": "d1b5cf65-f763-3f0c-bf78-df119c7a655a",
                        "glosses": [
                            "een tocht die als doel heeft goederen te verwerven"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c5c91e61-8eef-42a1-a610-c490e5cf26d0",
                                "sense_id": "ca8e7353-40ea-317c-86f0-128c43486150",
                                "text": "De kreten van de rondcirkelende meeuwen droegen bij aan het rumoer terwijl er flessen wijn en bier uit de mand werden gehaald en Cameron complimenten kreeg voor zijn plundertocht. De spanning verdween te midden van het gelach toen vingers en scheermesjes schilferige stukken vis van de vettige stenen pakten, en Emily veegde met de rug van haar hand haar kin af en verklaarde dat ze nog nooit zoiets lekkers had gegeten."
                            }
                        ]
                    }
