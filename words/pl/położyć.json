                            "target_lang_translations": {
                                "ru": "Врач решил, что его нужно <w>положить</w> в больницу на обследование.",
                                "en": "The doctor decided that he needed to be <w>admitted</w> to the hospital for observation.",
                                "nl": "De arts besloot dat hij ter observatie in het ziekenhuis moet worden <w>opgenomen</w>."
                            }
