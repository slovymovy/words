                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a24ccc5-6b56-3df5-8902-07cd15ef9eea",
                        "entry_id": "01879736-19d6-3112-8867-faea656f1e30",
                        "glosses": [
                            "Commune française du département de la Côte-d’Or."
                        ],
                        "tags": [],
