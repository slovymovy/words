                ],
                "senses": [
                    {
                        "sense_id": "4e3e03ec-dae7-35ec-9894-50f6d6a3336a",
                        "entry_id": "bdff8f6b-a388-3483-a1ac-2024bd509332",
                        "glosses": [
                            "zonder (voldoende) werking om het gewilde resultaat op te leveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b5335d-8d3a-49be-89d1-6d8b8cb1cbd3",
                                "sense_id": "4e3e03ec-dae7-35ec-9894-50f6d6a3336a",
                                "text": "Bij ineffectief warmteverlies speelt een aantal factoren een belangrijke rol. Het doet zich doorgaans voor onder warme, vochtige omstandigheden. Het dragen van zware, dichte, waterbestendige kleding die niet ademt (en dus moeilijk lucht of vocht doorlaat), voorkomt dat transpiratievocht op de huid kan verdampen en bemoeilijkt daardoor de afkoeling."
                            },
                            {
                                "example_id": "3b5f1e9c-2d82-49c9-ab2d-91cbddea3e52",
                                "sense_id": "4e3e03ec-dae7-35ec-9894-50f6d6a3336a",
                                "text": "Sociale media en websites censureren is ondemocratisch, ineffectief en kortzichtig. Online informatie die overheden wil onderdrukken dringt dankzij buitenlandse sites en VPN software toch wel binnen. Een vrije pers en factchecken zijn veel betere methoden tegen nepnieuws."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b9ed35d-0760-4696-8704-09811c9f7a7f",
                        "source_entry_id": "bdff8f6b-a388-3483-a1ac-2024bd509332",
                        "source_sense_id": "4e3e03ec-dae7-35ec-9894-50f6d6a3336a",
                        "source_sense_description": "zonder (voldoende) werking om het gewilde resultaat op te leveren",
                        "target_lang_word": "ineffective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ineffective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab1c67c-bde0-327c-9254-7e8b2b0977b4",
                                        "entry_id": "13199a8c-19e8-3cc7-ba1a-ae20f6139daa",
                                        "glosses": [
                                            "Not having the desired effect; ineffectual; otiose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34612349-f7c9-36af-8b46-f0a4f2d6b678",
                                        "entry_id": "13199a8c-19e8-3cc7-ba1a-ae20f6139daa",
                                        "glosses": [
                                            "Lacking in ability; incompetent or inadequate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c22a5b9c-2f9d-40fd-9854-9f4924e01f60",
                                                "sense_id": "34612349-f7c9-36af-8b46-f0a4f2d6b678",
                                                "text": "Fire ants circumvented the problem of an ineffective sting by having an unusual and highly effective venom that when daubed or sprayed on other ants penetrates their waxy protective integumental barrier and kills or disables them."
                                            },
                                            {
                                                "example_id": "b38abff8-e1f0-4085-a3aa-5e35fed110b1",
                                                "sense_id": "34612349-f7c9-36af-8b46-f0a4f2d6b678",
                                                "text": "Their use was “impermissible not because it is unwise or ineffective, but because [federal law]^([sic]) does not allow it”, the decision explained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
