{
    "word_family": [
        "vlaagje",
        "windvlaag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8739a09c-0e42-31db-8eff-6a61e6537777",
                    "sense_definition": "Een plotselinge, hevige windstoot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "natuurverschijnsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een koude <w>vlaag</w> blies de bladeren van de bomen.",
                            "target_lang_translations": {
                                "en": "A cold <w>gust</w> blew the leaves off the trees."
                            }
                        },
                        {
                            "text": "Tijdens de storm werd de fietser verrast door een krachtige <w>vlaag</w>.",
                            "target_lang_translations": {
                                "en": "During the storm, the cyclist was surprised by a powerful <w>gust</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "windstoot",
                        "rukwind"
                    ],
                    "common_phrases": [
                        "krachtige vlaag",
                        "koude vlaag"
                    ],
                    "target_lang_definitions": {
                        "en": "A sudden, violent gust of wind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gust",
                                "target_lang_sense_clarification": "a strong, abrupt rush of wind"
                            },
                            {
                                "target_lang_word": "burst",
                                "target_lang_sense_clarification": "a sudden, intense manifestation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7db1c977-a463-37d0-9440-d9c79ed78766",
                    "sense_definition": "Een plotselinge en hevige opwelling van een emotie of gedachte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In een <w>vlaag</w> van verstandsverbijstering kocht hij een veel te dure auto.",
                            "target_lang_translations": {
                                "en": "In a <w>fit</w> of temporary insanity, he bought a car that was far too expensive."
                            }
                        },
                        {
                            "text": "Zij voelde plotseling een <w>vlaag</w> van jaloezie toen ze hem met iemand anders zag.",
                            "target_lang_translations": {
                                "en": "She suddenly felt a <w>pang</w> of jealousy when she saw him with someone else."
                            }
                        }
                    ],
                    "synonyms": [
                        "opwelling",
                        "bui",
                        "vlaag van verstandsverbijstering"
                    ],
                    "common_phrases": [
                        "vlaag van woede",
                        "vlaag van jaloezie"
                    ],
                    "target_lang_definitions": {
                        "en": "A sudden and intense surge of an emotion or thought."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fit",
                                "target_lang_sense_clarification": "a sudden outburst of emotion or activity"
                            },
                            {
                                "target_lang_word": "bout",
                                "target_lang_sense_clarification": "a period of something unpleasant or intense"
                            },
                            {
                                "target_lang_word": "surge",
                                "target_lang_sense_clarification": "a sudden powerful forward or upward movement"
                            },
                            {
                                "target_lang_word": "pang",
                                "target_lang_sense_clarification": "a sudden sharp pain or painful emotion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}