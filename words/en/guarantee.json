{
    "word_family": [
        "guarantor",
        "guaranty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f01e51e-a2d1-3173-a878-d30280e8ba78",
                    "sense_definition": "To promise formally that something is true or will happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_promise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>guarantee</w> that you will love this movie.",
                            "target_lang_translations": {
                                "ru": "Я <w>гаранти́рую</w>, что этот фильм тебе понравится.",
                                "zh": "我<w>保证</w>你会喜欢这部电影。"
                            }
                        },
                        {
                            "text": "We cannot <w>guarantee</w> that the package will arrive by tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мы не можем <w>гаранти́ровать</w>, что посылка прибудет к завтрашнему дню.",
                                "zh": "我们无法<w>保证</w>包裹能在明天之前送达。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assure",
                        "promise",
                        "ensure"
                    ],
                    "common_phrases": [
                        "guarantee satisfaction",
                        "personally guarantee",
                        "guarantee results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать официальное обещание, что что-то является правдой или обязательно произойдет.",
                        "zh": "正式承诺某事属实或一定会发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гаранти́ровать",
                                "target_lang_sense_clarification": "давать обещание"
                            },
                            {
                                "target_lang_word": "руча́ться",
                                "target_lang_sense_clarification": "обещать с уверенностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保证",
                                "target_lang_sense_clarification": "做出正式承诺"
                            },
                            {
                                "target_lang_word": "担保",
                                "target_lang_sense_clarification": "对某事负责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f327ddab-aa83-3970-bfe6-e3b234b293a9",
                    "sense_definition": "To make a specific outcome certain or inevitable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_ensure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hard work does not always <w>guarantee</w> success.",
                            "target_lang_translations": {
                                "ru": "Упорный труд не всегда <w>гаранти́рует</w> успех.",
                                "zh": "努力工作并不总是能<w>保证</w>成功。"
                            }
                        },
                        {
                            "text": "The heavy rain will <w>guarantee</w> a good harvest this year.",
                            "target_lang_translations": {
                                "ru": "Проливные дожди <w>гаранти́руют</w> хороший урожай в этом году.",
                                "zh": "大雨将<w>确保</w>今年有个好收成。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "guarantee success",
                        "guarantee safety",
                        "virtually guarantee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать определенный результат несомненным или неизбежным.",
                        "zh": "使某种结果变得确定或不可避免。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гаранти́ровать",
                                "target_lang_sense_clarification": "обеспечивать результат"
                            },
                            {
                                "target_lang_word": "обеспе́чивать",
                                "target_lang_sense_clarification": "делать неизбежным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保证",
                                "target_lang_sense_clarification": "确保结果"
                            },
                            {
                                "target_lang_word": "确保",
                                "target_lang_sense_clarification": "使必然发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58708579-7e7e-3c36-82e4-8c7e2466c40a",
                    "sense_definition": "To accept legal responsibility for another person's debt or obligation if they fail to pay or perform.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His father agreed to <w>guarantee</w> the loan for the new business.",
                            "target_lang_translations": {
                                "ru": "Его отец согласился <w>гаранти́ровать</w> (поручиться за) кредит для нового бизнеса.",
                                "zh": "他父亲同意为这项新业务的贷款提供<w>担保</w>。"
                            }
                        },
                        {
                            "text": "The bank refused to <w>guarantee</w> the payment without more security.",
                            "target_lang_translations": {
                                "ru": "Банк отказался <w>гаранти́ровать</w> платеж без дополнительного обеспечения.",
                                "zh": "银行拒绝在没有更多抵押的情况下<w>担保</w>这笔付款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warrant"
                    ],
                    "common_phrases": [
                        "guarantee a loan",
                        "guarantee a debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать на себя юридическую ответственность за долг или обязательство другого лица.",
                        "zh": "为他人的债务或义务承担法律责任。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поруча́ться",
                                "target_lang_sense_clarification": "брать ответственность за кого-то"
                            },
                            {
                                "target_lang_word": "гаранти́ровать",
                                "target_lang_sense_clarification": "выступать гарантом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "担保",
                                "target_lang_sense_clarification": "承担法律责任"
                            },
                            {
                                "target_lang_word": "作保",
                                "target_lang_sense_clarification": "为他人提供保证"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70844d11-f6dd-3379-85d9-755f9bb6398d",
                    "sense_definition": "A written promise by a company to repair or replace a product if it breaks within a specific period.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_warranty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new washing machine is still under <w>guarantee</w>.",
                            "target_lang_translations": {
                                "ru": "Новая стиральная машина все еще на <w>гара́нтии</w>.",
                                "zh": "这台新洗衣机还在<w>保修</w>期内。"
                            }
                        },
                        {
                            "text": "This watch comes with a two-year <w>guarantee</w> against defects.",
                            "target_lang_translations": {
                                "ru": "Эти часы имеют двухлетнюю <w>гара́нтию</w> от дефектов.",
                                "zh": "这款手表提供两年的防缺陷<w>保修</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warranty"
                    ],
                    "common_phrases": [
                        "under guarantee",
                        "money-back guarantee",
                        "lifetime guarantee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменное обязательство компании отремонтировать или заменить товар в случае поломки.",
                        "zh": "公司提供的书面承诺，若产品在特定期限内损坏则负责维修或更换。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гара́нтия",
                                "target_lang_sense_clarification": "на товар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保修",
                                "target_lang_sense_clarification": "针对产品维修"
                            },
                            {
                                "target_lang_word": "保修期",
                                "target_lang_sense_clarification": "指代期限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdf192b6-8030-3172-8742-bf7aadd97002",
                    "sense_definition": "A formal assurance that a certain condition will be fulfilled or an outcome will occur.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>guarantee</w> that the weather will be nice for the picnic.",
                            "target_lang_translations": {
                                "ru": "Нет никакой <w>гара́нтии</w>, что погода будет хорошей для пикника.",
                                "zh": "没有人能<w>保证</w>野餐时的天气会很好。"
                            }
                        },
                        {
                            "text": "He gave me a personal <w>guarantee</w> that the work would be finished on time.",
                            "target_lang_translations": {
                                "ru": "Он дал мне личную <w>гара́нтию</w>, что работа будет закончена вовремя.",
                                "zh": "他向我个人<w>保证</w>工作会按时完成。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "no guarantee",
                        "personal guarantee",
                        "ironclad guarantee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заверение в том, что определенное условие будет выполнено.",
                        "zh": "关于某项条件将得到满足或某结果将发生的正式保证。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гара́нтия",
                                "target_lang_sense_clarification": "заверение"
                            },
                            {
                                "target_lang_word": "руча́тельство",
                                "target_lang_sense_clarification": "подтверждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保证",
                                "target_lang_sense_clarification": "正式的承诺"
                            },
                            {
                                "target_lang_word": "担保",
                                "target_lang_sense_clarification": "确切的凭证"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fc5ccb2-0deb-3261-9daa-1cba739d7231",
                    "sense_definition": "Something valuable given as security to ensure a promise or obligation is fulfilled.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house served as a <w>guarantee</w> for the bank loan.",
                            "target_lang_translations": {
                                "ru": "Дом служил <w>гара́нтией</w> (залогом) банковского кредита.",
                                "zh": "这栋房子被用作银行贷款的<w>抵押</w>。"
                            }
                        },
                        {
                            "text": "They demanded a financial <w>guarantee</w> before signing the contract.",
                            "target_lang_translations": {
                                "ru": "Они потребовали финансовую <w>гара́нтию</w> перед подписанием контракта.",
                                "zh": "他们在签署合同前要求提供财务<w>担保</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "provide a guarantee",
                        "bank guarantee",
                        "financial guarantee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценность или обязательство, предоставляемые в качестве обеспечения выполнения обещания.",
                        "zh": "为确保履行承诺或义务而提供的有价值的抵押物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гара́нтия",
                                "target_lang_sense_clarification": "обеспечение"
                            },
                            {
                                "target_lang_word": "зало́г",
                                "target_lang_sense_clarification": "имущественное обеспечение"
                            },
                            {
                                "target_lang_word": "поручи́тельство",
                                "target_lang_sense_clarification": "ответственность за другого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抵押",
                                "target_lang_sense_clarification": "作为担保的财物"
                            },
                            {
                                "target_lang_word": "担保",
                                "target_lang_sense_clarification": "作为保障的凭证"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}