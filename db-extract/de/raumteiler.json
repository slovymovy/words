                        "entry_id": "4d9b68ad-dae4-31ee-b4c7-4f549f6835e1",
                        "glosses": [
                            "ein Möbel, ein Vorhang oder eine spanische Wand, womit ein Raum (Zimmer) in verschiedene Bereiche unterteilt oder abgeschirmt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f0acec-e6d8-4de5-b3c2-9f9147ab4dfe",
                                "sense_id": "b6883d7c-530f-3bc1-8303-43745f038035",
                                "text": "„Mitte Februar bauten Handwerker den Raumteiler zwischen Küche und Wohnzimmer ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
