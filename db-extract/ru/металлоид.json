                                            {
                                                "example_id": "527d35f9-8eff-4572-906d-a428253cdc43",
                                                "sense_id": "27970330-8f6e-3a18-8cec-56c1894e644d",
                                                "text": "Die Metalloide lassen sich nicht ohne Weiteres von den Metallen und Nichtmetallen unterscheiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
