                "senses": [
                    {
                        "sense_id": "dad54c34-3938-3c4e-982d-0a1405b8e05a",
                        "entry_id": "54f077cb-53ff-3958-abf0-179de7b119a6",
                        "glosses": [
                            "Immuniser avec ses propres anticorps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fd1d278-4a8d-459b-9270-faec61ca837c",
                                "sense_id": "dad54c34-3938-3c4e-982d-0a1405b8e05a",
                                "text": "Il n'en reste pas moins qu'on est parvenu à auto-immuniser des cobayes en leur injectant leur propre cristallin; on ne put d'ailleurs mettre en évidence les anticorps ainsi formés qu'à l'aide des méthodes les plus sensibles de l'anaphylaxie."
                            },
                            {
                                "example_id": "1a441d62-1172-49a6-82a6-a7d503d9ad20",
                                "sense_id": "dad54c34-3938-3c4e-982d-0a1405b8e05a",
                                "text": "L'édile parle dans le bulletin municipal d'une «minorité frauduleuse qui veut s'auto-immuniser des impôts communaux »."
                            }
                        ]
                    }
