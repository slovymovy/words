                                                "sense_id": "55ecdf18-0098-37af-8a80-e2e161ddbba8",
                                                "text": "I ordered a glass of lemonade and a coffee scroll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184820be-6cc0-3759-8ece-4611000ca54f",
                                        "entry_id": "c64ca8b7-1e22-3408-b48c-c63511c9bfb1",
                                        "glosses": [
                                            "The incremental movement of graphics on a screen, removing one portion to show the next."
                                        ],
                                        "tags": [],
