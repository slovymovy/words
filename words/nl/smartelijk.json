{
    "word_family": [
        "smart",
        "smarten"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e467452-e325-3239-8678-8eecfa7efd89",
                    "sense_definition": "Pijnlijk of verdrietig, vaak gepaard gaand met groot leed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het verlies van haar beste vriendin was een <w>smartelijke</w> ervaring.",
                            "target_lang_translations": {
                                "en": "The loss of her best friend was a <w>grievous</w> experience."
                            }
                        },
                        {
                            "text": "Hij moest een <w>smartelijk</w> verlies verwerken na het ongeluk.",
                            "target_lang_translations": {
                                "en": "He had to process a <w>painful</w> loss after the accident."
                            }
                        }
                    ],
                    "synonyms": [
                        "pijnlijk",
                        "kwellend"
                    ],
                    "antonyms": [
                        "smarteloos"
                    ],
                    "common_phrases": [
                        "smartelijk verlies"
                    ],
                    "target_lang_definitions": {
                        "en": "Painful or sorrowful, often accompanied by great suffering or distress."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "painful",
                                "target_lang_sense_clarification": "causing physical or emotional suffering"
                            },
                            {
                                "target_lang_word": "grievous",
                                "target_lang_sense_clarification": "very severe or damaging, often used for losses or injuries"
                            },
                            {
                                "target_lang_word": "distressing",
                                "target_lang_sense_clarification": "causing anxiety, sorrow, or pain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed031073-0945-3108-a192-fefd4b8876a2",
                    "sense_definition": "Gevoelens van diepe droefheid of rouw uitdrukkend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verdriet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rouw om een kind is een zeer <w>smartelijke</w> beproeving.",
                            "target_lang_translations": {
                                "en": "Mourning a child is a very <w>sorrowful</w> ordeal."
                            }
                        },
                        {
                            "text": "Zij keek met een <w>smartelijke</w> blik naar de lege stoel.",
                            "target_lang_translations": {
                                "en": "She looked at the empty chair with a <w>mournful</w> gaze."
                            }
                        }
                    ],
                    "synonyms": [
                        "gekweld"
                    ],
                    "common_phrases": [
                        "smartelijke beproeving"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing feelings of deep sadness, grief, or mourning."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sorrowful",
                                "target_lang_sense_clarification": "feeling or showing deep distress"
                            },
                            {
                                "target_lang_word": "mournful",
                                "target_lang_sense_clarification": "expressing grief or sadness"
                            },
                            {
                                "target_lang_word": "wistful",
                                "target_lang_sense_clarification": "having a feeling of vague or regretful longing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21aaa5e6-48b3-3d64-bb1f-3da18ea93cdb",
                    "sense_definition": "Gekenmerkt door een intens verlangen of hunkering.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verlangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij uitte een <w>smartelijke</w> roep om zijn verre geliefde weer te zien.",
                            "target_lang_translations": {
                                "en": "He let out a <w>yearning</w> cry to see his distant beloved again."
                            }
                        },
                        {
                            "text": "Er klonk een <w>smartelijk</w> verlangen in zijn stem tijdens het zingen.",
                            "target_lang_translations": {
                                "en": "A <w>pining</w> longing sounded in his voice while singing."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Characterized by an intense longing, yearning, or pining."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yearning",
                                "target_lang_sense_clarification": "a feeling of intense longing for something"
                            },
                            {
                                "target_lang_word": "pining",
                                "target_lang_sense_clarification": "suffering a mental and physical decline because of a broken heart or longing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}