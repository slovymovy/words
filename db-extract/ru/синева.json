                        "form": "*синева́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e57b95fe-dc13-328a-8199-b1ef7105643e",
                        "entry_id": "63f8f490-a892-33e7-8015-1a8e697025c2",
                        "glosses": [
                            "яркий синий цвет чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3402284c-a089-407a-8e9c-b9249c4214f2",
                                "sense_id": "e57b95fe-dc13-328a-8199-b1ef7105643e",
                                "text": "Но вот художник набрал тонкой кистью каплю белил и в самой середине картины на лаковой синеве только что написанного моря поставил маленькую выпуклую запятую."
                            }
                        ]
                    },
                    {
                        "sense_id": "370f46ab-2a47-315d-9238-b15fdf7b7669",
                        "entry_id": "63f8f490-a892-33e7-8015-1a8e697025c2",
                        "glosses": [
                            "синеватый оттенок чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "165f4dd9-910e-4ea3-a6e4-d07337b2a033",
                                "sense_id": "370f46ab-2a47-315d-9238-b15fdf7b7669",
                                "text": "Долго простоял я неподвижно, глядя на мутную синеву этих привольных лугов."
                            },
                            {
                                "example_id": "6acd3225-9812-4e44-ba36-e4ce04a6616b",
                                "sense_id": "370f46ab-2a47-315d-9238-b15fdf7b7669",
                                "text": "Кровь стекала по пальцам палача, и лицо головы быстро и ровно покрывалось восковой синевой."
                            },
                            {
                                "example_id": "823e203b-eab3-4b23-be39-a5c233144c9f",
                                "sense_id": "370f46ab-2a47-315d-9238-b15fdf7b7669",
                                "text": "Нежное продолговатое лицо его было красиво и дивно от особенной синевы глаз."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc82c0e2-48af-3f04-957b-224da65f8ddd",
                        "entry_id": "63f8f490-a892-33e7-8015-1a8e697025c2",
                        "glosses": [
                            "небесный свод, ясное, синее небо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85496d13-bbfa-48b9-bd61-4de5a986b131",
                                "sense_id": "fc82c0e2-48af-3f04-957b-224da65f8ddd",
                                "text": "Арарат безоблачный возвышается до синевы во всей красе."
                            },
                            {
                                "example_id": "4585ff56-e5af-4667-9495-245d3bd99d21",
                                "sense_id": "fc82c0e2-48af-3f04-957b-224da65f8ddd",
                                "text": "Над головами, из-за бегущих белых, едва окрашивающихся туч, виднелась бледная синева; налево облака были светлы, легки и подвижны."
                            },
                            {
                                "example_id": "4ed3c7ce-1767-4e1d-b538-bb2dba4abf74",
                                "sense_id": "fc82c0e2-48af-3f04-957b-224da65f8ddd",
                                "text": "А наутро солнце опять взошло в ясной синеве."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae8b17f8-a454-3ae3-ab50-14c47bb99387",
                        "entry_id": "63f8f490-a892-33e7-8015-1a8e697025c2",
                        "glosses": [
                            "спец. болезнь древесины, вызывающая её потемнение и гниение"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2615a863-97b2-4cf9-9065-b1af9f36ef35",
                        "source_entry_id": "63f8f490-a892-33e7-8015-1a8e697025c2",
                        "source_sense_description": "яркий синий цвет",
                        "target_lang_word": "Bläue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bläue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7764992-f455-3db7-982e-84ed5ca83680",
                                        "entry_id": "a4a2cc86-50c4-33be-9767-5997c180286f",
                                        "glosses": [
                                            "die blaue Farbe von etwas, die Eigenschaft blau zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58f6073-8026-45da-a267-b1dca6c5469f",
                                                "sense_id": "a7764992-f455-3db7-982e-84ed5ca83680",
                                                "text": "Die Bläue des Himmels erstrahlte über dem Grün der Wiesen."
                                            },
                                            {
                                                "example_id": "d6a2d808-fd65-44c9-91f8-e98d77f04ac2",
                                                "sense_id": "a7764992-f455-3db7-982e-84ed5ca83680",
                                                "text": "„Seineabwärts liegt im Talausschnitt ein breiter Streifen türkisfarbener Bläue, der sich in der nassen Straße spiegelt: Es hat zu regnen begonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e6f8261-3c82-37b1-a4a7-662cc911f14e",
                                        "entry_id": "a4a2cc86-50c4-33be-9767-5997c180286f",
                                        "glosses": [
                                            "durch Pilze verursachte Blaufärbung des Holzes"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ffcef7-e794-4ac7-b20d-03cc0bb9f485",
                                                "sense_id": "2e6f8261-3c82-37b1-a4a7-662cc911f14e",
                                                "text": "Die Stabilität des Holzes wird durch die Bläue nicht beeinträchtigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
