                            {
                                "example_id": "ec191eed-6f17-445f-83b8-16b75c0b2c4e",
                                "sense_id": "4235fd23-3e22-3b48-957e-6e83bc3cad2a",
                                "text": "Ale hip-hop jako muzyka pokoju? To brzmi mało wiarygodnie, że gatunek często utożsamany z gloryfikowaniem przemocy mógłby pomóc w szerzeniu przekazu typu „daj szansę pokojowi”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7285151a-106f-4ee5-93aa-dfd354b16228",
                        "source_entry_id": "f518c8e1-6410-370a-bf64-f99e37bbf108",
                        "source_sense_id": "4235fd23-3e22-3b48-957e-6e83bc3cad2a",
                        "target_lang_word": "credibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "credibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd20ae7-e2a0-34f3-8037-5f2b4e05a204",
                                        "entry_id": "79db3fe0-a58f-3e66-807e-6b255f4ae8c3",
                                        "glosses": [
                                            "In a credible manner; believably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aefdca2-10de-4275-bc31-4ffe2e48c486",
                                                "sense_id": "7dd20ae7-e2a0-34f3-8037-5f2b4e05a204",
                                                "text": "A suitor can credibly signal his love for a woman by offering her an expensive and extravagant gift."
                                            },
                                            {
                                                "example_id": "b1047198-9476-4ddd-8b6a-0901456da9ed",
                                                "sense_id": "7dd20ae7-e2a0-34f3-8037-5f2b4e05a204",
                                                "text": "He was in a position to commit to a credibly conservative monetary policy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c47aad-e5bc-3073-8560-8cb7474b09c7",
                                        "entry_id": "79db3fe0-a58f-3e66-807e-6b255f4ae8c3",
                                        "glosses": [
                                            "Used to report the speaker's assessment of the credibility of a reported statement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a340c75-a56c-42c1-b1eb-37ee2cded6a7",
                                                "sense_id": "a5c47aad-e5bc-3073-8560-8cb7474b09c7",
                                                "text": "He [Mayor Koch] says he better understands the limits of government; less credibly, he says he has mellowed."
                                            },
                                            {
                                                "example_id": "ccf42d37-8e30-4a41-8c32-9262a84547b4",
                                                "sense_id": "a5c47aad-e5bc-3073-8560-8cb7474b09c7",
                                                "text": "His deep-set eyes and expression of general despair lend him a look of utter dissolution—very credibly, he is dying from sexual desire."
                                            },
                                            {
                                                "example_id": "a5e2e386-4937-4cfd-aa09-5207b4d219d1",
                                                "sense_id": "a5c47aad-e5bc-3073-8560-8cb7474b09c7",
                                                "text": "Perhaps less credibly she assumes that, as a necessary consequence of this move from the public space of the theatre to the private space of the closet, 'the emphasis shifted to subjective interpretation'"
                                            },
                                            {
                                                "example_id": "2f9ff9d9-cb16-4725-99b9-481b8e0d40af",
                                                "sense_id": "a5c47aad-e5bc-3073-8560-8cb7474b09c7",
                                                "text": "In his eyes, if he allowed things to continue as before, he would be little better than a male prostitute. All too credibly, he could imagine himself aging into the superannuated gigolo of Juvenal's satire."
                                            },
                                            {
                                                "example_id": "887c0656-49d1-46cf-8fef-009856540160",
                                                "sense_id": "a5c47aad-e5bc-3073-8560-8cb7474b09c7",
                                                "text": "Perhaps, and more credibly, he meant that, had he been at the department, he would have ensured that the president expressly cleared that instruction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
