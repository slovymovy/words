                ],
                "senses": [
                    {
                        "sense_id": "a24f9e69-946e-3d41-8e8e-f78140cd1117",
                        "entry_id": "dc237396-84c5-35ba-9d02-05d0ee6bcab3",
                        "glosses": [
                            "Vorgang, durch den Adolf Hitler 1933 Reichskanzler wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030ab446-53cb-4a87-8504-494f92d713fa",
                                "sense_id": "a24f9e69-946e-3d41-8e8e-f78140cd1117",
                                "text": "„Dann begann - wie jüngst im Internet gefeiert - mit dreimal verfluchtem Datum das Jahr der Machtergreifung.“"
                            },
                            {
                                "example_id": "318a2466-bd8a-49dd-9c09-3d22b64efade",
                                "sense_id": "a24f9e69-946e-3d41-8e8e-f78140cd1117",
                                "text": "„Derartige Freizügigkeiten wurden mit der Machtergreifung der Nationalsozialisten undenkbar.“"
                            },
                            {
                                "example_id": "bf2d4181-d51c-41b7-9653-fa794b2524b4",
                                "sense_id": "a24f9e69-946e-3d41-8e8e-f78140cd1117",
                                "text": "„Nach der Machtergreifung im Januar 1933 startete Hitler unmittelbar eine Kampagne für die antipolnischen Kräfte in Danzig.“"
                            },
                            {
                                "example_id": "337faabb-1632-4923-8117-49c6eebf8c92",
                                "sense_id": "a24f9e69-946e-3d41-8e8e-f78140cd1117",
                                "text": "„Arp lässt sich nach der Machtergreifung der Nazis mit Jean Arp anreden, seine Gedichte schreibt er fortan auf Französisch.“"
                            },
                            {
                                "example_id": "1a639f8a-44d6-4460-b7b0-93605667d780",
                                "sense_id": "a24f9e69-946e-3d41-8e8e-f78140cd1117",
                                "text": "[Über das Abschneiden der NSDAP bei den Landtagswahlen 1932 in Thüringen:] „1932, am Vorabend der Machtergreifung, bekam sie hier gut 43 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a41911b2-f079-35f9-a8bb-910137057e60",
                        "entry_id": "dc237396-84c5-35ba-9d02-05d0ee6bcab3",
                        "glosses": [
                            "Vorgang, durch den jemand an die Macht kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc340704-c15b-4e78-bc83-deb550150ce4",
                                "sense_id": "a41911b2-f079-35f9-a8bb-910137057e60",
                                "text": "„Die Polen aber sind keine Sieger, sondern deren Gefolgschaft. Darum hat ihre Machtergreifung eine andere Qualität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
