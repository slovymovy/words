                                ]
                            },
                            {
                                "target_word": "lapse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3312f1c7-ec92-36fb-89db-7ea8d27e235d",
                                        "entry_id": "6ad816cd-4e04-3b97-a0a3-e2c8b425c41e",
                                        "glosses": [
                                            "To fall away gradually; to subside."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6b0f1d2-1745-41aa-bcbf-905446d10671",
                                                "sense_id": "3312f1c7-ec92-36fb-89db-7ea8d27e235d",
                                                "text": "This perpetual disposition to shorten our words by retrenching the vowels, is nothing else but a tendency to lapse into the barbarity of those northern nations from whom we are descended"
                                            },
                                            {
                                                "example_id": "fbc51781-677d-44a5-9ae5-969513cca84d",
                                                "sense_id": "3312f1c7-ec92-36fb-89db-7ea8d27e235d",
                                                "text": "Homer, however, in his characters of Vulcan and Thersites, in his story of Mars and Venus, in his behaviour of Irus and in other passages has been observed to have lapsed into the Burlesque character, and to have departed from that serious Air which seems essential to the magnificence of an Epic Poem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71974e59-dc2b-3805-9440-79fdf8d55784",
                                        "entry_id": "6ad816cd-4e04-3b97-a0a3-e2c8b425c41e",
                                        "glosses": [
                                            "To fall into error or heresy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b21ae5d2-830a-4404-b7f6-6eb326787710",
                                                "sense_id": "71974e59-dc2b-3805-9440-79fdf8d55784",
                                                "text": "To lapſe in Fullneſſe / Is ſorer, than to lye for Neede: and Falſhood / Is worſe in Kings, than Beggers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d1751f-4f9d-3293-9cdc-b537e5a275cf",
                                        "entry_id": "6ad816cd-4e04-3b97-a0a3-e2c8b425c41e",
                                        "glosses": [
                                            "To slip into a bad habit that one is trying to avoid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f8d523b-0bbc-32e4-aa54-dd3460d76f70",
                                        "entry_id": "6ad816cd-4e04-3b97-a0a3-e2c8b425c41e",
                                        "glosses": [
                                            "To become void."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "336cdacd-a3ff-4f73-bd8b-2f31f4f2c311",
                                                "sense_id": "4f8d523b-0bbc-32e4-aa54-dd3460d76f70",
                                                "text": "The connections at Lewisham were never built, and the powers of the Act lapsed; but the spur at Nunhead was partly constructed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087b1918-dfc7-3172-a983-ac9b1df733ad",
                                        "entry_id": "6ad816cd-4e04-3b97-a0a3-e2c8b425c41e",
                                        "glosses": [
                                            "To fall or pass from one proprietor to another, or from the original destination, by the omission, negligence, or failure of somebody, such as a patron or legatee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c31576-dba1-41b8-b500-4afa85a2affe",
                                                "sense_id": "087b1918-dfc7-3172-a983-ac9b1df733ad",
                                                "text": "...and if the archbishop shall not fill it up within six Months ensuing, it lapses to the King, but according to the Canon Law to the Pope."
                                            }
                                        ]
                                    }
