                    },
                    {
                        "translation_id": "adebd559-6239-467e-95da-24f941b9773c",
                        "source_entry_id": "4c6967b7-dd0d-361c-be60-477c396e7f1d",
                        "source_sense_id": "6bb67a80-2ec8-3f68-90f9-922852fb551f",
                        "target_lang_word": "antiradar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiradar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25d3fb0f-db3f-3eac-94b8-39ca45ad477b",
                                        "entry_id": "8699efb4-194d-3c07-b438-442d64a517ba",
                                        "glosses": [
                                            "Opposé aux radars routiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b24202-da52-4c6a-8a92-9c127bd3f014",
                                                "sense_id": "25d3fb0f-db3f-3eac-94b8-39ca45ad477b",
                                                "text": "L’artificier antiradars pris à son piège. Le mystère des attentats contre des détecteurs de vitesse est sans doute résolu. Hier, un postier s’est grièvement blessé avec la bombe qu’il manipulait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7848c50-d13e-31c4-8b40-73b25a1196c9",
                                        "entry_id": "8699efb4-194d-3c07-b438-442d64a517ba",
                                        "glosses": [
                                            "Qui brouille les radars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7934129c-c6d0-4ee2-bd33-9b6ef72437b8",
                                                "sense_id": "b7848c50-d13e-31c4-8b40-73b25a1196c9",
                                                "text": "Le brouillage peut être intentionnel (un dispositif antiradars dans le cas d’une guerre électronique) ou non voulu (par exemple dans le cas de forces alliées utilisant du matériel qui émet dans la même gamme de fréquences)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24995a37-d18b-3751-bee3-fd384af5371b",
                                        "entry_id": "8699efb4-194d-3c07-b438-442d64a517ba",
                                        "glosses": [
                                            "Destiné à supprimer les radars ennemis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f84d5f7-609d-4ada-a9c4-90966da42eac",
                                                "sense_id": "24995a37-d18b-3751-bee3-fd384af5371b",
                                                "text": "Un missile antiradar."
                                            },
                                            {
                                                "example_id": "99cd4452-9e83-4b20-ab82-39f03a02852c",
                                                "sense_id": "24995a37-d18b-3751-bee3-fd384af5371b",
                                                "text": "Dans le cadre de la lutte antiradar, l’armée de l’air française déploie des moyens classiques (bombes guidées laser, missiles air-surface) en collaboration étroite avec des systèmes de renseignement électromagnétique. (Wikipédia, Wild Weasel)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiradar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1614f5-35ce-349a-96f9-a957f680fbec",
                                        "entry_id": "0049e7a7-a55d-3dd5-b341-1d9557ee4db5",
                                        "glosses": [
                                            "Détecteur ou avertisseur de radars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ab6430-1de1-4044-bbac-5a8852433ea1",
                                                "sense_id": "4d1614f5-35ce-349a-96f9-a957f680fbec",
                                                "text": "Les antiradars contournent la loi ? La loi interdit les détecteurs installés dans les voitures, mais pas les dispositifs qui annoncent les contrôles routiers par téléphone."
                                            },
                                            {
                                                "example_id": "476a2c76-1e1b-4e22-9a74-df4d17f7f4c5",
                                                "sense_id": "4d1614f5-35ce-349a-96f9-a957f680fbec",
                                                "text": "Pour éviter les flashs indésirables, de plus en plus d’automobilistes s’équipent d’un antiradar."
                                            },
                                            {
                                                "example_id": "1c045afc-fda7-4213-abf4-1a0138dcd4e6",
                                                "sense_id": "4d1614f5-35ce-349a-96f9-a957f680fbec",
                                                "text": "Pour leur permettre l’ivresse nocturne d’une pointe à 190 km/h sur une autoroute à l’abri d’un antiradar secret ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
