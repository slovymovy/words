    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffc2c723-e69c-3482-b786-1563a287ead8",
                    "sense_definition": "doprowadzić kogoś lub organizm do skrajnego osłabienia, utraty sił lub wyczerpania",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zmęczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Długa i ciężka choroba zupełnie <w>wycieńczyła</w> jego organizm.",
                            "target_lang_translations": {
                                "ru": "Долгая и тяжёлая болезнь совершенно <w>истощила</w> его организм."
                            }
                        },
                        {
                            "text": "Wielogodzinny marsz przez pustynię może śmiertelnie <w>wycieńczyć</w> nawet doświadczonych wędrowców.",
                            "target_lang_translations": {
                                "ru": "Многочасовой переход через пустыню может смертельно <w>изнурить</w> даже опытных путников."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyczerpać",
                        "wykończyć",
                        "zmęczyć"
                    ],
                    "common_phrases": [
                        "wycieńczyć organizm"
                    ],
                    "target_lang_definitions": {
                        "ru": "довести кого-либо или организм до крайнего ослабления, потери сил или истощения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истощить",
                                "target_lang_sense_clarification": "лишить сил, энергии, ресурсов (организм, человека)"
                            },
                            {
                                "target_lang_word": "изнурить",
                                "target_lang_sense_clarification": "довести до крайнего утомления"
                            },
                            {
                                "target_lang_word": "обессилить",
                                "target_lang_sense_clarification": "лишить физических сил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc9d1a4-6987-32b0-88fc-4c35be4a7cb7",
                    "sense_definition": "stracić siły, ulec skrajnemu zmęczeniu lub osłabieniu (zwykle w formie się)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zmęczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pracował bez żadnej przerwy i w końcu zupełnie się <w>wycieńczył</w>.",
                            "target_lang_translations": {
                                "ru": "Он работал без перерыва и в итоге совершенно <w>обессилел</w>."
                            }
                        },
                        {
                            "text": "Jeśli nie zwolnisz tempa, <w>wycieńczysz</w> się przed samym końcem projektu.",
                            "target_lang_translations": {
                                "ru": "Если ты не сбавишь темп, ты <w>истощишься</w> прямо перед самым окончанием проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyczerpać",
                        "wykończyć",
                        "zmęczyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "потерять силы, крайне переутомиться или ослабеть (обычно с «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истощиться",
                                "target_lang_sense_clarification": "полностью лишиться сил"
                            },
                            {
                                "target_lang_word": "изнуриться",
                                "target_lang_sense_clarification": "крайне переутомиться"
                            },
                            {
                                "target_lang_word": "обессилеть",
                                "target_lang_sense_clarification": "стать бессильным от перенапряжения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}