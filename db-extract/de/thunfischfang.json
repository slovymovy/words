                "senses": [
                    {
                        "sense_id": "836e8666-cc03-39e3-b647-4ebe10928e8d",
                        "entry_id": "9cc43efd-6a8e-327f-9e0d-852919c72c36",
                        "glosses": [
                            "das Fangen von Thunfischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85de8073-626d-42f2-967a-45301c20acad",
                                "sense_id": "836e8666-cc03-39e3-b647-4ebe10928e8d",
                                "text": "„Thunfischfang im großen Maßstab betrieben auch die Marseiller, Ligurer, Sarden und vor allem Sizilianer.“"
                            },
                            {
                                "example_id": "66ddbfae-9776-46e3-8eb8-5bb693d8c367",
                                "sense_id": "836e8666-cc03-39e3-b647-4ebe10928e8d",
                                "text": "„Concarneau gehörte einst zu den größten Fischereihäfen Frankreichs, und was den Thunfischfang betraf, war der Hafen die Nummer eins.“"
                            },
                            {
                                "example_id": "a0b28a30-d2e9-4916-be8e-2784dd5e21c9",
                                "sense_id": "836e8666-cc03-39e3-b647-4ebe10928e8d",
                                "text": "„Als der Thunfischfang wichtig wurde, standen zur Fangzeit Späher auf hohen Leitern oder steilen Küstenfelsen und gaben Alarm, wenn ein Schwarm nahte.“"
                            },
                            {
                                "example_id": "af2cc0aa-3ebc-49d6-bafa-e674e5d33bc1",
                                "sense_id": "836e8666-cc03-39e3-b647-4ebe10928e8d",
                                "text": "„Die meisten Thunfischfänge von amerikanischen Schiffen werden jedoch außerhalb der USA angelandet; 1995 waren dies 85 % der US-Fänge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
