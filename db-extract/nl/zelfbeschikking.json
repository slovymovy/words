                        "examples": []
                    },
                    {
                        "sense_id": "2d64ce15-f7e1-3faf-8d45-da8778627371",
                        "entry_id": "0b1a8cfb-527a-3b5a-b8f7-0daeb8f2b2b6",
                        "glosses": [
                            "de mogelijkheid voor een individu om over zijn of haar levenseinde te beslissen"
                        ],
                        "tags": [
                            "in euthanasie-discussies"
                        ],
                        "examples": [
                            {
                                "example_id": "b989e2c0-9b0d-47a6-abdc-2a4eb9cdffbb",
                                "sense_id": "2d64ce15-f7e1-3faf-8d45-da8778627371",
                                "text": "Uitgangspunt van de Coöperatie Laatste Wil is de autonomie, het recht op zelfbeschikking van de mens over zijn leven"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c0a828a-e97d-4eab-aa9d-4e94846d9577",
                        "source_entry_id": "0b1a8cfb-527a-3b5a-b8f7-0daeb8f2b2b6",
                        "source_sense_id": "1be86787-db48-31f0-b019-b6f67fa69e7e",
                        "source_sense_description": "wilsvrijheid van het individu",
                        "target_lang_word": "Selbstbestimmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbestimmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                                        "glosses": [
                                            "Verfügung einer Person oder eines Landes über die eigene Existenz; Freiheit in der persönlichen Willensbildung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0fa38d1-97df-4696-90e3-ce594c0688bf",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Es waren deutsche Schulen und Universitäten, die mir ein Leben in Selbstbestimmung ermöglicht haben.“"
                                            },
                                            {
                                                "example_id": "2b598680-64d2-4f09-a13b-e21f92024364",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Präsident Charles de Gaulle lässt schließlich ein Referendum zu – mit eindeutigem Ergebnis: Mehr als 95 Prozent der wahlbeteiligten Algerier votieren für die Selbstbestimmung des Landes.“"
                                            },
                                            {
                                                "example_id": "eaf3cc34-b8e2-44c0-9335-dff31b65716b",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Nach 1945 fordern sie als Belohnung für ihren Einsatz die politische Selbstbestimmung.“"
                                            },
                                            {
                                                "example_id": "e6380834-5a86-4296-8aee-5b1547fdb96d",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Individuelle Freiheit als Selbstbestimmung und Entgrenzung ist dabei das Leitmotiv.“"
                                            },
                                            {
                                                "example_id": "925b7caa-9568-436d-8e5c-ca68eac91bb3",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Die Freiheit des Einzelnen bedeutete für den britischen Philosophen John Stuart Mill auch ein Recht auf Selbstbestimmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                                        "glosses": [
                                            "eine Definition des eigenen Selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf10d79d-a5a8-42f6-b0d1-d59dca9ed7e4",
                                                "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                                                "text": "Entgegen gängiger Selbstbestimmungen von moderner Zeit als unendlichem Fortschreiten oder technischer Beschleunigung fragt das von Barbara Gronau (Professorin für Theorie und Geschichte des Theaters an der Universität der Künste Berlin) geleitete Symposium nach einem anderen Zeitdiskurs der Künste, welcher Unterbrechung, Stillstellung und Verlangsamung als kritisch-utopische Suchmomente beschreibt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1003e29d-7924-49ec-9d09-224370e4bf5a",
                        "source_entry_id": "0b1a8cfb-527a-3b5a-b8f7-0daeb8f2b2b6",
                        "source_sense_id": "1be86787-db48-31f0-b019-b6f67fa69e7e",
                        "source_sense_description": "wilsvrijheid van het individu",
                        "target_lang_word": "autonomie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonomie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "État de ce qui est autonome, qui n’obéit pas à la loi ou à la règle d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ba4b1b-ee1f-4833-aa67-a12eb89eb027",
                                                "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                                "text": "C’est à ces sentiments nettement latins et fédéralistes tout ensemble de l’École de Marseille qu’il faut rattacher la manifestation à laquelle se livrèrent quelques Félibres, qui, par une déclaration solennelle, publiée le 22 février 1892, se déclaraient partisans de l’autonomie et de la fédération des provinces françaises."
                                            },
                                            {
                                                "example_id": "cfa8c7c3-9675-4b2f-9915-e2f0c45cea9b",
                                                "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                                "text": "Aujourd’hui, on fait grief à la France de ne pas concéder à l’Alsace cette même autonomie que l’Allemagne avait accordée au Reichsland. Mais quelle était donc cette autonomie ? […] Somme toute, l’Alsace n’exerçait son autonomie que pour des dispositions ménagères."
                                            },
                                            {
                                                "example_id": "b6456ee0-f2c3-4b75-8c97-63465898ea21",
                                                "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                                "text": "Il faut un contexte social et politique tout à fait particulier pour que ces mêmes pouvoirs initient des réformes importantes, comme le fit Atatürk dans la Turquie des années 1920 ou, dans les années 1990, les pays turcophones ayant recouvré leur autonomie après la chute de l’URSS."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12125494-6a8b-39a8-876d-6f59f8583428",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "Capacité à gérer seule sa vie quotidienne en parlant d’une personne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e57a8c-7cda-4888-9dad-49ccac1419ae",
                                                "sense_id": "12125494-6a8b-39a8-876d-6f59f8583428",
                                                "text": "Les années quatre-vingt ont consacré l’enfant-roi mais aussi travaillé en profondeur les mentalités vers toujours plus d’individualisme, cet état ambivalent de l’autonomie et de l’hypersolitude."
                                            },
                                            {
                                                "example_id": "2cc38844-ac95-4920-bfdf-a715721e7088",
                                                "sense_id": "12125494-6a8b-39a8-876d-6f59f8583428",
                                                "text": "Un enfant est dit mineur par la loi : son jeune âge fait présumer que l’autonomie n’est pas acquise, qu’il doit donc être protégé et que le statut juridique de l’incapacité est une protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "352c5082-9a21-33aa-b4ae-51dbeb0d4b65",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "Temps de fonctionnement d'une machine, en particulier Distance que peut parcourir un véhicule, avec le plein en énergie ou en produit indispensable au fonctionnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c718e0f1-0252-40bd-8119-a05a7a8bcc44",
                                                "sense_id": "352c5082-9a21-33aa-b4ae-51dbeb0d4b65",
                                                "text": "Ces écouteurs résistent à la poussière et à l’eau, peuvent se connecter à un smartphone et à un ordinateur sans avoir à les repairer et revendiquent aussi jusqu’à 36 heures d’autonomie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab30ab8d-2049-3e2c-84ae-ee4749e7a496",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "Statut politique spécial avec délégation accrue de pouvoirs, plus grande que dans un fédéralisme symétrique, mais sans obtenir la souveraineté (indépendance juridique)."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1526a3-e174-4b1e-82f7-e83f493c9d27",
                                                "sense_id": "ab30ab8d-2049-3e2c-84ae-ee4749e7a496",
                                                "text": "[L’indépendance] est le contraire politique de l’autonomie, même si, sur un plan historique, on peut la considérer comme son prolongement. Il n’y a rien de commun entre un séparatiste et un autonomiste : l’un veut la sécession du Québec, l’autre veut sa participation, plus ou moins intégrée, à la Confédération."
                                            },
                                            {
                                                "example_id": "ed2d8882-f152-4471-9b2d-0f422f92f752",
                                                "sense_id": "ab30ab8d-2049-3e2c-84ae-ee4749e7a496",
                                                "text": "« En plaçant le principe de l’autonomie au cœur de son projet politique, la CAQ s’inscrit dans une lignée qui, au cours de l’histoire, a fait de la défense des intérêts vitaux du Québec une priorité absolue. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
