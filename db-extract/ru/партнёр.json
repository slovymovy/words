                                                "sense_id": "ba7ef5d0-5e85-379c-b6b7-5904e5105e84",
                                                "text": "Sterbehilfe Trauerhuber – ihr Partner für Bestattungen."
                                            },
                                            {
                                                "example_id": "7aeb0bad-8d84-4d42-96f0-69f7fa8bf417",
                                                "sense_id": "ba7ef5d0-5e85-379c-b6b7-5904e5105e84",
                                                "text": "„BMW ist darauf angewiesen, dass sich seine Partner an die vertraglich fixierten Sozial- und Umweltstandards halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e487f27d-ac94-3806-a6b8-79832d75ced1",
                                        "entry_id": "ac3969b7-875d-3dee-a8bf-bf04a600951e",
                                        "glosses": [
                                            "einer von zwei Menschen, die eine feste Beziehung führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98637384-7f2f-4baf-a512-f3ac9e6a98cc",
                                                "sense_id": "e487f27d-ac94-3806-a6b8-79832d75ced1",
                                                "text": "Bei dem Schwangerschaftsvorbereitungskurs erschienen zwölf Frauen mit ihren Partnern."
                                            },
                                            {
                                                "example_id": "bb18a976-2e5e-43de-90d7-16d791ef420f",
                                                "sense_id": "e487f27d-ac94-3806-a6b8-79832d75ced1",
                                                "text": "„Zweck der Übung: Nicht der Partner soll die Partnerin umwerben, sondern die Partnerin den Partner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
