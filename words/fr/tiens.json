                },
                {
                    "sense_id": "8bb36e9b-f736-30b9-b9ff-b22572c9f5ae",
                    "sense_definition": "Mot qui sert à attirer l'attention de l'interlocuteur ou à insister sur ce qu'on dit, un peu comme « écoute ».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "D'ailleurs, <w>tiens</w>, il faut que je te raconte ce qui m'est arrivé hier."
                        },
                        {
                            "text": "Tu as peur de tout, toi ! Rembourse-moi tout de suite, <w>tiens</w>, si tu es si sûr de toi."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier, surtout à l'oral"
                        }
                    ]
                },
                {
                    "sense_id": "6e034b74-96a8-3800-af31-c6f3571fd5aa",
                    "sense_definition": "Mot qu'on lance en frappant quelqu'un ou en commettant un acte violent contre lui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "coup",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tiens</w>, prends ça ! cria l'enfant en jouant au chevalier avec son épée en bois."
                        },
                        {
                            "text": "Et <w>tiens</w> ! Et encore un coup de poing pour la route !"
                        }
                    ],
                    "common_phrases": [
                        "tiens prends ça"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier"
                        }
                    ]
                },
                {
                    "sense_id": "b662e343-a301-3d18-b490-fd35061f04d8",
                    "sense_definition": "Mot qu'on lance pour infliger à quelqu'un un coup moral, une réplique blessante ou humiliante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coup",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu te moques de mon accent ? Eh bien <w>tiens</w>, dans les dents : j'ai gagné le concours !"
                        },
                        {
                            "text": "Tu disais que je n'y arriverais jamais ? Et <w>tiens</w>, voilà mon diplôme !"
