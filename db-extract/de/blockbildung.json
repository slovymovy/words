                ],
                "senses": [
                    {
                        "sense_id": "777ffc84-efb5-3eb5-8021-ab9397becfe5",
                        "entry_id": "787a4591-be70-3bf0-8f43-cd50e0700fc0",
                        "glosses": [
                            "Erweiterung eines nominalen Satzgliedes durch Attribute"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eccaced4-2e81-4b90-bdaf-d509cbe7fde6",
                                "sense_id": "777ffc84-efb5-3eb5-8021-ab9397becfe5",
                                "text": "„Zur Blockbildung kommt es dann, wenn ein oder mehrere ein Satzglied ausweiten.“"
                            },
                            {
                                "example_id": "513c980e-cce9-428a-a727-329f43df93c7",
                                "sense_id": "777ffc84-efb5-3eb5-8021-ab9397becfe5",
                                "text": "„Man spricht hier von Blockbildung; häufige zusätzliche Erweiterungen eines nominalen Satzgliedes sind: Genitivattribute (die Beschäftigten der Metallindustrie), Präpositionalattribute (der Tarifvertrag für die Metallindustrie), erweiterte Partizipialattribute (ein am Produktionszuwachs orientiertes Angebot).“"
                            },
                            {
                                "example_id": "d5556133-e8cc-47ce-8a34-581fa9e10fa3",
                                "sense_id": "777ffc84-efb5-3eb5-8021-ab9397becfe5",
                                "text": "„Noch viel häufiger, wichtiger und für unsere heutige Sprache in hohem Maße kennzeichnend ist aber eine andere Erscheinung, die ich als »Blockbildung« bezeichne: …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8e454399-25da-3149-a4ec-6f9a4c800914",
                        "entry_id": "787a4591-be70-3bf0-8f43-cd50e0700fc0",
                        "glosses": [
                            "Bildung eines politisch organisierten Blocks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17b519d-a54a-449b-be63-368edf9a6fdb",
                                "sense_id": "8e454399-25da-3149-a4ec-6f9a4c800914",
                                "text": "„Wann hört die Blockbildung Ost-West auf?“"
                            },
                            {
                                "example_id": "bc1bce2b-7e2f-4a68-bd21-b15cf5f2fc28",
                                "sense_id": "8e454399-25da-3149-a4ec-6f9a4c800914",
                                "text": "„Wir leben in einer Epoche der neuen Blockbildung alter imperialistischer Zentren: China, Russland, die USA, Europa.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9b4fcbb1-b365-39c3-8c18-aeebc0504e35",
                        "entry_id": "787a4591-be70-3bf0-8f43-cd50e0700fc0",
                        "glosses": [
                            "Zusammensetzung eines Teils einer Mannschaft aus Spielern gleicher Herkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e3d5be-e8f2-48c4-8005-152b88a8398a",
                                "sense_id": "9b4fcbb1-b365-39c3-8c18-aeebc0504e35",
                                "text": "„Im Interview spricht der Bundestrainer über die Entscheidungskriterien, den Kampf um die Nummer 1 im deutschen WM-Tor und die Blockbildung in der Nationalelf.“"
                            },
                            {
                                "example_id": "0ecacc4d-85e0-4718-a145-1793517a457d",
                                "sense_id": "9b4fcbb1-b365-39c3-8c18-aeebc0504e35",
                                "text": "„Erfolgreicher Münchner: Mit einer Blockbildung von Bayern wie Franz Beckenbauer (rechts) und Gladbachern wie Berti Vogts (links) wurde Deutschland 1974 Weltmeister gegen Johann Cruffs Holländer.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
