{
    "word_family": [
        "freckly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec7712ec-a0ba-3025-aab7-1e9cff01a399",
                    "sense_definition": "A small brownish or reddish spot on the skin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "skin_spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has many small <w>freckles</w> across her nose.",
                            "target_lang_translations": {
                                "cs": "Na nose má mnoho malých <w>pih</w>."
                            }
                        },
                        {
                            "text": "The sun caused a new <w>freckle</w> to appear on his arm.",
                            "target_lang_translations": {
                                "cs": "Slunce způsobilo, že se mu na paži objevila nová <w>piha</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ephelis",
                        "lentigo"
                    ],
                    "common_phrases": [
                        "covered in freckles"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá hnědavá nebo načervenalá skvrnka na kůži."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "piha",
                                "target_lang_sense_clarification": "malá pigmentová skvrna na kůži"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9751ca3e-f03f-33ec-a9c4-8c1d8ce25876",
                    "sense_definition": "Any small spot or discoloration.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old paper had a <w>freckle</w> of ink near the corner.",
                            "target_lang_translations": {
                                "cs": "Starý papír měl u rohu <w>skvrnku</w> od inkoustu."
                            }
                        },
                        {
                            "text": "A tiny <w>freckle</w> of rust appeared on the metal surface.",
                            "target_lang_translations": {
                                "cs": "Na kovovém povrchu se objevila malá <w>skvrnka</w> rzi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Jakákoli malá skvrna nebo změna zabarvení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skvrnka",
                                "target_lang_sense_clarification": "malá skvrna nebo tečka obecně, nejen na kůži"
                            },
                            {
                                "target_lang_word": "tečka",
                                "target_lang_sense_clarification": "drobná tečka nebo flíček"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84a21205-5bae-3b5e-9ba8-1156ddcfcfce",
                    "sense_definition": "A small flat chocolate candy covered in colorful sprinkles.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "candy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child enjoyed eating a sweet chocolate <w>freckle</w>.",
                            "target_lang_translations": {
                                "cs": "Dítě si pochutnávalo na sladkém <w>čokoládovém bonbonu s barevným zdobením</w>."
                            }
                        },
                        {
                            "text": "She bought a bag of <w>freckles</w> at the local candy shop.",
                            "target_lang_translations": {
                                "cs": "V místním obchodě se sladkostmi si koupila sáček <w>čokoládových bonbonů s barevným zdobením</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá plochá čokoládová bonbónová sladkost pokrytá barevným zdobením."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čokoládový bonbon s barevným zdobením",
                                "target_lang_sense_clarification": "australská sladkost; malý plochý čokoládový bonbon s barevným zdobením"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9587407-45c3-3ffd-966d-a5b8f50a67ac",
                    "sense_definition": "The anus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term is sometimes used as a vulgar <w>freckle</w> reference.",
                            "target_lang_translations": {
                                "cs": "Tento výraz se někdy používá jako vulgární označení pro <w>řitní otvor</w>."
                            }
                        },
                        {
                            "text": "He used a crude word for his <w>freckle</w> during the argument.",
                            "target_lang_translations": {
                                "cs": "Během hádky použil hrubé slovo pro svůj <w>řitní otvor</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar slang term."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Řitní otvor."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "řitní otvor",
                                "target_lang_sense_clarification": "vulgární slangové označení"
                            },
                            {
                                "target_lang_word": "prdel",
                                "target_lang_sense_clarification": "velmi vulgární hovorové označení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdcf04d8-7b1d-31b5-93e4-e2c0e04edfa7",
                    "sense_definition": "To cause someone or something to have spots.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "skin_spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot summer sun will <w>freckle</w> your fair skin.",
                            "target_lang_translations": {
                                "cs": "Horké letní slunce ti <w>posype pihami</w> světlou kůži."
                            }
                        },
                        {
                            "text": "Years of sun exposure began to <w>freckle</w> his shoulders.",
                            "target_lang_translations": {
                                "cs": "Po letech na slunci se mu ramena začala <w>pokrývat pihami</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, aby někdo nebo něco mělo skvrny či pihy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "posypat pihami",
                                "target_lang_sense_clarification": "způsobit, že se objeví pihy nebo drobné skvrny"
                            },
                            {
                                "target_lang_word": "pokrýt skvrnkami",
                                "target_lang_sense_clarification": "pokrýt skvrnkami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "985da178-d0c4-3842-8b59-6228168b7e85",
                    "sense_definition": "To develop spots on the skin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "skin_spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face tends to <w>freckle</w> whenever she spends time outdoors.",
                            "target_lang_translations": {
                                "cs": "Kdykoli tráví čas venku, její obličej má sklon se <w>pokrývat pihami</w>."
                            }
                        },
                        {
                            "text": "Children often <w>freckle</w> after playing in the bright sun.",
                            "target_lang_translations": {
                                "cs": "Dětem se po hraní na ostrém slunci často <w>dělají pihy</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokryt se pihami nebo skvrnami na kůži."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokrývat se pihami",
                                "target_lang_sense_clarification": "začít mít pihy; pokrývat se pihami"
                            },
                            {
                                "target_lang_word": "dělat se pihovat",
                                "target_lang_sense_clarification": "na kůži se začnou objevovat pihy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}