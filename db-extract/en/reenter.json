                                    {
                                        "sense_id": "e671144f-f354-3830-9bba-9ffa152ae418",
                                        "entry_id": "074328a7-6884-34a8-bea8-aa994062fee9",
                                        "glosses": [
                                            "entrare di nuovo"
                                        ],
                                        "tags": [],
