                                        "entry_id": "1454bbdd-ee3e-3645-b317-9528c41246ae",
                                        "glosses": [
                                            "een regel die in de meeste gevallen opgaat en als standaard in beginsel wordt aangehouden."
                                        ],
                                        "tags": [],
