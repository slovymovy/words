                            "accusative",
                            "plural"
                        ],
                        "form": "die Prokaryoten"
                    },
                    {
                        "form_id": "20e1e229-0f20-4c0e-a4b3-25d4e630ad18",
                        "entry_id": "527d7337-7bf5-3d11-9e32-1cbd95b39f3c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Prokaryota"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39f6a39d-bedf-3b3b-98d9-e0fb8323c127",
                        "entry_id": "527d7337-7bf5-3d11-9e32-1cbd95b39f3c",
                        "glosses": [
                            "Lebewesen, das aus Zellen ohne einen echten, von einer Kernmembran vom Cytoplasma abgegrenzten Zellkern besteht"
                        ],
                        "tags": [
                            "Zytologie"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2fe1567-9970-3b3c-8477-612c1cd5f871",
                        "entry_id": "527d7337-7bf5-3d11-9e32-1cbd95b39f3c",
                        "glosses": [
                            "eine heute nicht mehr gebräuchliche Domäne, die alle Lebewesen umfasst, die keinen echten Zellkern aufweisen"
                        ],
                        "tags": [
                            "Biologische Taxonomie",
                            "im Plural (Prokaryoten",
                            "Prokaryota)"
                        ],
                        "examples": [
                            {
                                "example_id": "6b02a354-3bdc-4302-9556-da741609e197",
                                "sense_id": "b2fe1567-9970-3b3c-8477-612c1cd5f871",
                                "text": "Die Prokaryoten werden heute taxonomisch in die neuen Domänen der Bakterien und der Archaeen (Archäbakterien) differenziert."
                            },
                            {
                                "example_id": "56baa6aa-caa7-4f26-aa45-a2ee52c2230b",
                                "sense_id": "b2fe1567-9970-3b3c-8477-612c1cd5f871",
                                "text": "Die Prokaryoten werden als entwicklungsgeschichtlich älter eingestuft als die Eukaryoten."
                            },
                            {
                                "example_id": "20f68c7f-02c1-41cd-9568-331d55007494",
                                "sense_id": "b2fe1567-9970-3b3c-8477-612c1cd5f871",
                                "text": "„Dabei werden die Ur-Bakterien (Archaebacteria), Bakterien, Blaualgen und Ur-Grünalgen (Prochlorophyta), welche (noch) keinen echten Zellkern besitzen, gewöhnlich als Prokaryota den übrigen, als Eukaryota bezeichneteten Gruppen vorangestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5e05a6a-5899-48cb-b834-84df82bc80ca",
                        "source_entry_id": "527d7337-7bf5-3d11-9e32-1cbd95b39f3c",
                        "source_sense_id": "39f6a39d-bedf-3b3b-98d9-e0fb8323c127",
                        "target_lang_word": "prokaryote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prokaryote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af057c75-df26-37c9-bba8-95e6d610ff82",
                                        "entry_id": "aa49fc6f-b72d-39a4-a638-925aea2d388c",
                                        "glosses": [
                                            "An organism whose cell (or cells) are characterized by the absence of a nucleus or any other membrane-bound organelles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf17e785-24e0-37ef-85b4-24b9f639b9cd",
                                        "entry_id": "aa49fc6f-b72d-39a4-a638-925aea2d388c",
                                        "glosses": [
                                            "In the two-empire system of biological taxonomy, an organism of the kingdom Prokaryotae (now superseded)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e99d3722-6637-4540-b9b7-8d6f6eb75e33",
                        "source_entry_id": "527d7337-7bf5-3d11-9e32-1cbd95b39f3c",
                        "source_sense_id": "39f6a39d-bedf-3b3b-98d9-e0fb8323c127",
                        "target_lang_word": "procaryote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procaryote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7315222-1483-3f20-9ecb-f4c397b399a4",
                                        "entry_id": "0d018ea2-9d48-3004-af30-9d2e2854781f",
                                        "glosses": [
                                            "Organisme vivant unicellulaire sans organites et en particulier dont le matériel génétique cellulaire n’est pas contenu dans un noyau, formant un taxon paraphylétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eeb477b-87e5-4446-8f33-c7cb66da4a15",
                                                "sense_id": "f7315222-1483-3f20-9ecb-f4c397b399a4",
                                                "text": "En conclusion, on peut dire que la cellule ancestrale était un procaryote assez typique, que l’on pourrait très bien confondre, si on venait à le rencontrer aujourd’hui, avec une bactérie actuelle."
                                            },
                                            {
                                                "example_id": "0d300667-cf29-43b0-a706-151b57d6df83",
                                                "sense_id": "f7315222-1483-3f20-9ecb-f4c397b399a4",
                                                "text": "Le monde bactériel, c'est le monde des procaryotes, comme cellule fondamentale, sans noyau. Ces procaryotes sont les formes de vie qui s'approchent probablement le plus des premières formes de vie (par leur simplicité de structure, même si leurs relations sont complexes)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "procaryote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ce6cae-cee9-3a58-b521-cbef4fa95bec",
                                        "entry_id": "c727084b-e55c-3630-8446-ce24597d843d",
                                        "glosses": [
                                            "Qui possède les caractéristiques d’un procaryote ; relatif à celui-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a1322b-115e-4989-bcc9-c5e798cdadb8",
                                                "sense_id": "b2ce6cae-cee9-3a58-b521-cbef4fa95bec",
                                                "text": "Les gènes procaryotes sont exprimés différemment de ceux des eucaryotes."
                                            },
                                            {
                                                "example_id": "dd52daca-7705-4574-a3a8-4017124068fb",
                                                "sense_id": "b2ce6cae-cee9-3a58-b521-cbef4fa95bec",
                                                "text": "La cellule du type qui existe chez les bactéries et les algues bleues est une cellule procaryote ; la cellule du type qui existe chez les autres organismes, est une cellule eucaryote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
