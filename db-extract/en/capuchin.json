                    {
                        "translation_id": "486aae65-d4a9-404c-84dd-8522ebde6ef1",
                        "source_entry_id": "0d9c735a-9697-3941-86fb-309e72c53bd4",
                        "source_sense_id": "272066af-7f1b-38b0-82d9-fd9da916cdc6",
                        "source_sense_description": "a member of the Roman Catholic order",
                        "target_lang_word": "капуци́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "капуци́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a24aa24b-be7f-30eb-8df8-1d74ed168cfb",
                                        "entry_id": "36881d90-9b17-3df9-9a78-6f4d8fa91d37",
                                        "glosses": [
                                            "представитель одной из ветвей католического монашеского ордена францисканцев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab0c43d-10e6-4c55-a85a-89f34005ad97",
                                                "sense_id": "a24aa24b-be7f-30eb-8df8-1d74ed168cfb",
                                                "text": ".. Орден капуцинов, более близкий к народу своим образом жизни, оказавший некогда папам великие услуги, но потом, загрубелый и одичалый, сделался в полной форме представителем католического монашества."
                                            },
                                            {
                                                "example_id": "e20bc4bf-f5c2-4a83-ac44-ede646854134",
                                                "sense_id": "a24aa24b-be7f-30eb-8df8-1d74ed168cfb",
                                                "text": ".. Рим и в палящий зной // Такой же Рим. Вон те же капуцины // Бредут попарно с чётками в руках .."
                                            },
                                            {
                                                "example_id": "fdce2e10-a5a7-4d02-8ebe-882ae9fce874",
                                                "sense_id": "a24aa24b-be7f-30eb-8df8-1d74ed168cfb",
                                                "text": "Когда спустились сумерки, в замок пришёл монах капуцин с чётками в руках, с мешком на спине и с опущенным на лицо капюшоном. Он по своему обыкновению просил подаяния на монастырь."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "капуци́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b734ff1e-2691-30e2-a5d2-bfe1dfff63b0",
                                        "entry_id": "66741b30-f0e0-3501-9623-2d9eb4632b19",
                                        "glosses": [
                                            "зоол. род цепкохвостых обезьян (лат. Cebus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8923e8db-cbfa-4bfc-b420-3e71e92f84aa",
                                                "sense_id": "b734ff1e-2691-30e2-a5d2-bfe1dfff63b0",
                                                "text": "Капуцины — маленькие обезьянки, родина их обитания — тропическая Америка. Живут они в кронах гигантских деревьев, а питаются, хочется сказать, — чем придётся. Я имею в виду, что меню у них достаточно разнообразное — от различных плодов, семян, сочных побегов, орехов до насекомых, лягушек и даже мелких пичуг. Селятся они группами — до тридцати особей."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "капуци́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0b722d-73ff-3e46-98fa-3cb706360e54",
                                        "entry_id": "04e1def5-9b6a-306a-bb18-07f59cf3c92b",
                                        "glosses": [
                                            "ботан. растение семейства Капустоцветные (лат. Tropaeolum), цветок которого напоминает капюшон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088b8271-46b9-4342-bc6c-7d0973915254",
                                                "sense_id": "ab0b722d-73ff-3e46-98fa-3cb706360e54",
                                                "text": "В окнах миткалевые занавески и горшки с бальзамином, капуцином и стручковым перцем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
