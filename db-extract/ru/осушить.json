                        "entry_id": "2465c80e-3647-384d-be32-e884d619e3c2",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "осуши́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93c5a404-f773-3279-a08d-302e5ec4c06e",
                        "entry_id": "2465c80e-3647-384d-be32-e884d619e3c2",
                        "glosses": [
                            "сделать сухим, отведя ненужную воду, удалив лишнюю влагу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca24c973-1c80-42cc-8a55-43d2a0ad9628",
                                "sense_id": "93c5a404-f773-3279-a08d-302e5ec4c06e",
                                "text": "Платком он пытался осушить нос."
                            },
                            {
                                "example_id": "73018311-34fc-4554-9d07-8bbea129b537",
                                "sense_id": "93c5a404-f773-3279-a08d-302e5ec4c06e",
                                "text": "Впрочем, это был не участок, а кусок болота. Чтобы его осушить, стали возить сюда песок"
                            }
                        ]
                    },
                    {
                        "sense_id": "57c77d83-1e70-3150-b7dc-0566a87e3695",
                        "entry_id": "2465c80e-3647-384d-be32-e884d619e3c2",
                        "glosses": [
                            "выпить без остатка содержимое чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc5c6a76-9e61-49f6-9016-49f59c665e13",
                                "sense_id": "57c77d83-1e70-3150-b7dc-0566a87e3695",
                                "text": "Сергиевский, смущённо улыбаясь, принял бокал из рук профессора и, не колеблясь, осушил до дна"
                            },
                            {
                                "example_id": "b719102f-1b5a-4712-95d9-fb126c1028df",
                                "sense_id": "57c77d83-1e70-3150-b7dc-0566a87e3695",
                                "text": "После того, как мастер осушил второй стакан, его глаза стали живыми и осмысленными"
                            },
                            {
                                "example_id": "81c49eb6-c126-452a-a987-381016fbfbb1",
                                "sense_id": "57c77d83-1e70-3150-b7dc-0566a87e3695",
                                "text": "Я думал умереть; это было невозможно: я ещё не осушил чаши страданий, и теперь чувствую, что мне ещё долго жить."
                            }
                        ]
                    }
                ],
