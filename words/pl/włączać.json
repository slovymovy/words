{
    "word_family": [
        "włącznik",
        "włączenie",
        "łączyć",
        "złącze",
        "przełącznik"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1445b11-8bab-3ec9-a740-b0d42ed72218",
                    "sense_definition": "Uruchamiać urządzenie, mechanizm, instalację lub system, sprawiając, że zaczyna działać.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawsze <w>włączam</w> światło, kiedy wchodzę do ciemnego pokoju.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>включаю</w> свет, когда вхожу в тёмную комнату."
                            }
                        },
                        {
                            "text": "Tata codziennie rano <w>włącza</w> radio, żeby posłuchać wiadomości.",
                            "target_lang_translations": {
                                "ru": "Папа каждое утро <w>включает</w> радио, чтобы послушать новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "uruchamiać",
                        "aktywować",
                        "zapalać"
                    ],
                    "antonyms": [
                        "wyłączać"
                    ],
                    "common_phrases": [
                        "włączać światło",
                        "włączać telewizor",
                        "włączać komputer",
                        "włączać silnik"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить в действие устройство, механизм, установку или систему, заставляя их работать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "свет, прибор, механизм"
                            },
                            {
                                "target_lang_word": "запускать",
                                "target_lang_sense_clarification": "двигатель, систему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6875fbc7-49f2-3066-ac25-c845ab2dc443",
                    "sense_definition": "Dodawać kogoś lub coś do jakiejś grupy, zbioru lub całości; uwzględniać jako element składowy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel zawsze <w>włącza</w> nowych uczniów do pracy w grupach.",
                            "target_lang_translations": {
                                "ru": "Учитель всегда <w>включает</w> новых учеников в работу в группах."
                            }
                        },
                        {
                            "text": "Coraz więcej szkół <w>włącza</w> naukę programowania do planu lekcji.",
                            "target_lang_translations": {
                                "ru": "Всё больше школ <w>включают</w> программирование в учебный план."
                            }
                        }
                    ],
                    "synonyms": [
                        "dołączać",
                        "uwzględniać"
                    ],
                    "antonyms": [
                        "wykluczać"
                    ],
                    "common_phrases": [
                        "włączać do zespołu",
                        "włączać do diety",
                        "włączać do programu",
                        "włączać do oferty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять кого-то или что-то в группу, набор или целое; учитывать как составную часть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "в состав, в список"
                            },
                            {
                                "target_lang_word": "присоединять",
                                "target_lang_sense_clarification": "добавлять к чему-либо"
                            },
                            {
                                "target_lang_word": "причислять",
                                "target_lang_sense_clarification": "относить к числу кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15c2e46f-1232-3010-b5a3-5de2be2c4c8e",
                    "sense_definition": "Zaczynać brać udział w czymś, co już trwa, np. w rozmowie lub ruchu drogowym (używane z zaimkiem zwrotnym \"się\").",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierowca musi bardzo ostrożnie <w>włączać</w> się do ruchu na autostradzie.",
                            "target_lang_translations": {
                                "ru": "Водитель должен очень осторожно <w>вливаться</w> в поток на автомагистрали."
                            }
                        },
                        {
                            "text": "Chciałbym <w>włączyć</w> się do dyskusji i przedstawić swoje zdanie na ten temat.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>включиться</w> в дискуссию и высказать свое мнение по этому вопросу."
                            }
                        }
                    ],
                    "synonyms": [
                        "dołączać"
                    ],
                    "common_phrases": [
                        "włączać się do dyskusji",
                        "włączać się do ruchu",
                        "włączać się do akcji"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "wymaga zaimka \"się\""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать участвовать в чем-то происходящем, например, в разговоре или движении (используется с возвратным местоимением)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включаться",
                                "target_lang_sense_clarification": "в разговор, в процесс"
                            },
                            {
                                "target_lang_word": "присоединяться",
                                "target_lang_sense_clarification": "к группе, к дискуссии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}