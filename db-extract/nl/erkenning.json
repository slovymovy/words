                            "waardering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db68aa1a-8557-40f2-b08b-a70df0594c89",
                                "sense_id": "9d405a95-2b54-3612-a367-5b67914ab854",
                                "text": "Professor Feringa heeft vandaag erkenning gehad voor zijn baanbrekend werk in de chemie door het ontvangen van de Nobelprijs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41e1a027-6cf1-41e6-a739-3d04e2b11bda",
                        "source_entry_id": "bd84343c-d9de-37e4-acb8-a86633b9cb7e",
                        "source_sense_id": "a0230799-d84e-3e5c-96c8-dd86f3671429",
                        "source_sense_description": "een bevestiging van de juistheid of geldigheid van iets",
                        "target_lang_word": "Anerkennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anerkennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76a85227-cf46-303f-94b8-d6d2ba5bf93f",
                                        "entry_id": "937cd177-2e86-3382-ac18-1eae8e19b19a",
                                        "glosses": [
                                            "die Bekanntgabe einer lobenden Würdigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8674a5-5351-4a2d-8ee1-384d6bed0bea",
                                                "sense_id": "76a85227-cf46-303f-94b8-d6d2ba5bf93f",
                                                "text": "In Anerkennung für Ihre Arbeit verleihe ich Ihnen diese Urkunde."
                                            },
                                            {
                                                "example_id": "f5667017-ae9a-43fb-9149-66c0f860966c",
                                                "sense_id": "76a85227-cf46-303f-94b8-d6d2ba5bf93f",
                                                "text": "„In der Stimme des Konservators schwingt echte Anerkennung für den mittelalterlichen Bischof Azelin mit.“"
                                            },
                                            {
                                                "example_id": "8d5a6669-ee75-41fc-9bd8-e047c0301d0f",
                                                "sense_id": "76a85227-cf46-303f-94b8-d6d2ba5bf93f",
                                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                                            },
                                            {
                                                "example_id": "835dacb9-eb0a-4c65-93cf-c560dede5acf",
                                                "sense_id": "76a85227-cf46-303f-94b8-d6d2ba5bf93f",
                                                "text": "„Es ist nur zu verständlich, daß Galileo Galilei sich in diesem Lichte allseitiger Anerkennung sonnt.“"
                                            },
                                            {
                                                "example_id": "692ac04b-9d3f-4802-8cbd-36c4c044c7eb",
                                                "sense_id": "76a85227-cf46-303f-94b8-d6d2ba5bf93f",
                                                "text": "„Am 20. Januar 1772 wurde de Sades erstes Schauspiel hier aufgeführt, und wenn es auch noch geraume Zeit dauern sollte, bevor die Comédie-Française ein Stück von ihm herausbrachte, hielt er sich seit 1772 für einen großen Bühnenautor und hat sich auch die erdenklichste Mühe gegeben, als solcher Anerkennung bei seinen Zeitgenossen zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98e284d6-290e-3bb8-aa44-123d374bb9c7",
                                        "entry_id": "937cd177-2e86-3382-ac18-1eae8e19b19a",
                                        "glosses": [
                                            "ein Rechtsvorgang, in dem ein Anerkenntnis, eine rechtskräftige Bestätigung erteilt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242fe80d-e8db-4cd9-8042-a696a0a9cedc",
                                                "sense_id": "98e284d6-290e-3bb8-aa44-123d374bb9c7",
                                                "text": "Die Anerkennung seines Abschlusszeugnis steht noch aus."
                                            },
                                            {
                                                "example_id": "a10b133b-7c74-43af-bea0-f85775f13ca7",
                                                "sense_id": "98e284d6-290e-3bb8-aa44-123d374bb9c7",
                                                "text": "Der politische Schwung für eine Anerkennung Palästinas ist vom Europaparlament abgebremst worden. Die Abgeordneten in Straßburg sprachen sich zwar grundsätzlich für einen [sic!] Anerkennung der Palästinensergebiete als Staat aus, machten aber eine Wiederaufnahme der festgefahrenen Friedensgespräche zur Bedingung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5a85b98-9c2f-488f-9cf6-e65f580c37f0",
                        "source_entry_id": "bd84343c-d9de-37e4-acb8-a86633b9cb7e",
                        "source_sense_id": "a0230799-d84e-3e5c-96c8-dd86f3671429",
                        "source_sense_description": "een bevestiging van de juistheid of geldigheid van iets",
                        "target_lang_word": "recognition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recognition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "The act of recognizing or the condition of being recognized (matching a current observation with a memory of a prior observation of the same entity)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799d8e72-8873-4678-858c-3dd2077de378",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "He looked at her for ten full minutes before recognition dawned."
                                            },
                                            {
                                                "example_id": "781bcd52-d5aa-422b-95f1-510ee59c0e95",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "Warwick observed, as they passed through the respectable quarter, that few people who met the girl greeted her, and that some others whom she passed at gates or doorways gave her no sign of recognition; from which he inferred that she was possibly a visitor in the town and not well acquainted."
                                            },
                                            {
                                                "example_id": "ff6d133f-1f42-425b-9df1-1ff02e1271b3",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "December 20, 2021, ETSC, New rules on major EU roads should improve infrastructure safety\nOne omission is any language on getting roads ready for automated systems in transport. ETSC had called for provisions on ensuring that road markings, signs and infrastructure take into account the specific needs of e.g. traffic sign recognition and automated lane keeping systems."
                                            },
                                            {
                                                "example_id": "c80995c4-2f2e-4565-8391-04378ed9a1df",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "The freight market has changed beyond all recognition from when RAIL was first published. Coal, the then-dominant traffic, has all but disappeared. Instead, maritime intermodal flows have shown steady growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b691e73c-ad43-306b-bdc6-4d66bcf185be",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "Acceptance as valid or true."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f1f8a0-feba-4ae6-8d72-1cb4b5cd7fa3",
                                                "sense_id": "b691e73c-ad43-306b-bdc6-4d66bcf185be",
                                                "text": "The law was a recognition of their civil rights."
                                            },
                                            {
                                                "example_id": "bac347e9-4c0f-48da-9a50-07d3144520be",
                                                "sense_id": "b691e73c-ad43-306b-bdc6-4d66bcf185be",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd7ab0ad-53e3-3e08-b1f6-42aa3b2476c8",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "Official acceptance of the status of a new government by that of another country."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e02a0196-51a0-3d77-abe3-b6aa4e61ddc9",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "Honour, favourable note, or attention."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93ecadb1-b9e3-482a-9ccf-37c076193fc7",
                                                "sense_id": "e02a0196-51a0-3d77-abe3-b6aa4e61ddc9",
                                                "text": "The charity gained plenty of recognition for its efforts, but little money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "583da5c0-77b3-3ec1-a3c7-00969fe955c0",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "The propriety consisting for antibodies to bind to some specific antigens and not to others."
                                        ],
                                        "tags": [
