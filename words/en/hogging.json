                    "target_lang_definitions": {
                        "cs": "Provádění hrubého řezu za účelem rychlého odstranění velkého množství materiálu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hrubování",
                                "target_lang_sense_clarification": "technický termín pro obrábění"
