                "translations": [
                    {
                        "translation_id": "762969f1-8a01-4fbc-9750-c1462c749b69",
                        "source_entry_id": "05fbfc43-3443-34fa-b601-b4a156822c18",
                        "source_sense_id": "b526577b-9b09-308c-93e2-664505e54391",
