                                "target_senses": [
                                    {
                                        "sense_id": "28eed58c-05ab-3fa1-899f-cca1d36a92ce",
                                        "entry_id": "28ccbd05-eaa9-30ce-9fa4-9144a9dc4271",
                                        "glosses": [
                                            "воен., истор. оборонительный доспех из продетых друг в друга железных колец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dc5dcb6-7435-4249-920d-226340905a6b",
                                                "sense_id": "28eed58c-05ab-3fa1-899f-cca1d36a92ce",
                                                "text": "Особенно много дошло до нас кольчуг Х века в дружинных курганах."
                                            },
                                            {
                                                "example_id": "2e749b8d-c29d-474e-82b6-b4a626c63a00",
                                                "sense_id": "28eed58c-05ab-3fa1-899f-cca1d36a92ce",
                                                "text": "В этот вечер Казбич был угрюмее, чем когда-нибудь, и я заметил, что у него под бешметом надета кольчуга."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb4e5c6-09da-3f07-8f7c-a09a9b09556a",
                                        "entry_id": "28ccbd05-eaa9-30ce-9fa4-9144a9dc4271",
                                        "glosses": [
                                            "материал подобного вида"
                                        ],
