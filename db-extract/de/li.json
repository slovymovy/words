                "senses": [
                    {
                        "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                        "entry_id": "6ca9d2b4-efe7-3454-b4f3-cf7712547b90",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd03bd62-0ae8-4f4e-a564-27e579638f4e",
                                "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                                "text": "Frau Li ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5df5397e-f9b6-47ce-a8c5-be22ba913186",
                                "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                                "text": "Herr Li wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "212dc391-d8d1-4f50-852c-6dbb09d01513",
                                "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                                "text": "Die Lis fahren heute nach Hamburg."
                            },
                            {
                                "example_id": "6715885d-e805-4e71-9020-a8dd8fc74756",
                                "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                                "text": "Der Li trägt nie die Schals, die die Li ihm strickt."
                            },
                            {
                                "example_id": "2d6ac7c9-dc2e-429a-a285-7b184403a249",
                                "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Li kommt, geht der Herr Li.“"
                            },
                            {
                                "example_id": "9ffa7351-42e0-4791-a8b9-2d32902ddd26",
                                "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                                "text": "Li kommt und geht."
                            },
                            {
                                "example_id": "08404308-21c9-4a0d-952c-17e1266ae81c",
                                "sense_id": "99f5f383-67ff-3e50-b436-773bfe20ac37",
                                "text": "Lis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
