                        "form": "die Halsschmerzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                        "entry_id": "0a30961d-dcee-3820-9358-dcc66d7dcf50",
                        "glosses": [
                            "unangenehmes Gefühl (Schmerz) am Hals oder im Rachen aufgrund einer Entzündung"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "785f5715-8aae-4ccb-b1ab-8265a92d48a3",
                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                "text": "In vielen Fällen verschwinden Halsschmerzen auch ohne Behandlung wieder ganz von selbst."
                            },
                            {
                                "example_id": "af9d3053-2416-428f-90f9-78d92b2a03c3",
                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                "text": "„Dean hat Halsschmerzen, und sie hustet auch ein wenig.“"
                            },
                            {
                                "example_id": "154f58a0-abe3-4c05-b405-465993181960",
                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                "text": "„Auch Allergien, trockene Luft, Luftverschmutzung und der Rückfluss von Magensäure verursachen Halsschmerzen.“"
                            },
                            {
                                "example_id": "8870fa60-f839-4ba4-9db9-87ef987dd4c5",
                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                "text": "„Erkältungen beginnen oft mit einem Kratzen im Rachen bis hin zu Halsschmerzen und Schluckbeschwerden.“"
                            },
                            {
                                "example_id": "484327a9-56ae-4e29-9ea7-c57d4588517d",
                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                "text": "„Sie würde nicht weinend hier sitzen, wenn es eine Grippe oder Halsschmerzen wären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
