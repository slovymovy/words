                        "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                        "entry_id": "b7cc245e-121a-3ff9-8d16-7d7266325b9a",
                        "glosses": [
                            "Inspired by or showing patriotism; done out of love of one's country; zealously and unselfishly devoted to the service of one's country"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe74a66c-6b42-4040-9826-bca521821de7",
                                "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                                "text": "a patriotic statesman"
                            },
                            {
                                "example_id": "166ab878-cbfd-4c4e-9b24-994dc76b3862",
                                "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                                "text": "a patriotic song"
                            },
                            {
                                "example_id": "c8f872a0-82de-4aea-9541-e729a882f111",
                                "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                                "text": "But if patriotic sentiment is wanted,\nI've patriotic ballads cut and dried;\nFor where'er our country's banner may be planted,\nAll other local banners are defied!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfd26432-11e2-4d30-a418-52c7de6671d5",
