                "senses": [
                    {
                        "sense_id": "6cf0f9a9-0b46-342a-907d-07a9ee14b480",
                        "entry_id": "6d86b76e-2b09-3edc-bd2b-5ba423c48560",
                        "glosses": [
                            "(künstlerisch gestaltete) dreidimensionale Darstellung eines Heiligen/einer Heiligen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd00404-7e84-4860-ae0d-415ab1be8828",
                                "sense_id": "6cf0f9a9-0b46-342a-907d-07a9ee14b480",
                                "text": "„Wer in der Karwoche spanische Städte besucht, kann sich der merkwürdigen Faszination kaum entziehen. Vermummte Gestalten leiten unter dumpfen Trommelschlägen Prozessionen durch die Straßen; freiwillige Träger brechen unter der Last oft tonnenschwerer Heiligenfiguren schier zusammen.“"
                            },
                            {
                                "example_id": "86b5f946-19ac-4243-a7e3-977f85654cb6",
                                "sense_id": "6cf0f9a9-0b46-342a-907d-07a9ee14b480",
                                "text": "„Kopf und Schultern des Kommissars ragten so in den Türrahmen hinein, daß er wie die im Vordergrund thronende Heiligenfigur eines großen mittelalterlichen Gemäldes wirkte.“"
                            },
                            {
                                "example_id": "d44619a3-b979-42ef-9c30-161e47c0cc40",
                                "sense_id": "6cf0f9a9-0b46-342a-907d-07a9ee14b480",
                                "text": "„In der Ecke lagen die Reste der beiden Heiligenfiguren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
