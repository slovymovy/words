                "senses": [
                    {
                        "sense_id": "c15c137a-f0b0-3ec8-b105-d7184f5ae735",
                        "entry_id": "fc23f6f7-d14a-397f-907c-56a3140ea1b6",
                        "glosses": [
                            "einfacher Satz, der nur ein Prädikat enthält"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "cc9e7189-c4b9-420c-bb96-66afab5889a5",
                                "sense_id": "c15c137a-f0b0-3ec8-b105-d7184f5ae735",
                                "text": "„Was den Satzbau betrifft, sind die abnehmende durchschnittliche Satzlänge und die Tendenz zur sogenannten Parataxe, das heißt zur Nebenordnung von Einfachsätzen, wichtige Phänomene des aktuellen Sprachwandels.“"
                            },
                            {
                                "example_id": "c60422c8-72c2-4924-bf9c-27630decd48f",
                                "sense_id": "c15c137a-f0b0-3ec8-b105-d7184f5ae735",
                                "text": "„Methodischer Ausgangspunkt ist dabei zunächst die Unterscheidung der vier Kategorien ‚Setzung‘, ‚Einfachsatz‘, ‚Reihe‘, ‚Gefüge‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf78d17d-43f1-3a28-9110-0a4ee55ad5c0",
                        "entry_id": "fc23f6f7-d14a-397f-907c-56a3140ea1b6",
                        "glosses": [
                            "Berechnungsgrundlage für Honorarabrechnungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "001d97ec-470c-468c-877f-4f39f7e6500f",
                                "sense_id": "bf78d17d-43f1-3a28-9110-0a4ee55ad5c0",
                                "text": "„Durch Multiplikation des Einfachsatzes mit dem 3,5-fachen Steigerungsfaktor ergibt sich der höchstmögliche Satz gemäß § 5 GOZ berechnet werden kann, sofern keine Gebührenvereinbarung gemäß § 2 GOZ vor Beginn der Behandlung abgeschlossen wurde.“"
                            },
                            {
                                "example_id": "957b81f4-94ae-459c-8b73-75aa648a8490",
                                "sense_id": "bf78d17d-43f1-3a28-9110-0a4ee55ad5c0",
                                "text": "„Der Arzt kann nun diesen Einfachsatz mit einem Faktor bewerten, der von der Schwierigkeit und dem Zeitaufwand der Behandlung abhängt (Regelhöchstsatz): …“"
                            },
                            {
                                "example_id": "80fb3fe0-9a59-483e-a729-040899bbf0ba",
                                "sense_id": "bf78d17d-43f1-3a28-9110-0a4ee55ad5c0",
                                "text": "„Dazu sind Steigerungsfaktoren angegeben, mit denen der Einfachsatz multipliziert wird.“"
                            },
                            {
                                "example_id": "d157a0dc-c292-4296-9bea-03d12c8cf383",
                                "sense_id": "bf78d17d-43f1-3a28-9110-0a4ee55ad5c0",
                                "text": "„Bei der Berechnung des Einfachsatzes ist die Punktzahl der Leistung mit dem neuen Punktwert in Cent zu multiplizieren.“"
                            },
                            {
                                "example_id": "1619f24a-4fa4-4801-8ed4-07a28cfecdad",
                                "sense_id": "bf78d17d-43f1-3a28-9110-0a4ee55ad5c0",
                                "text": "„PKV und Beihilfe dagegen hätten den Einfachsatz zur conditio sine qua non erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
