                "entry_id": "f78293a9-e78a-382e-8bd3-d48a0c48ccb5",
                "word": "Deborah",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8b36ec01-c8a2-4288-b24a-eca5c3fd6461",
                        "entry_id": "f78293a9-e78a-382e-8bd3-d48a0c48ccb5",
                        "tags": [
                            "plural"
                        ],
                        "form": "Deborahs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58cea844-8d37-38f3-acb9-b3e778255b22",
                        "entry_id": "f78293a9-e78a-382e-8bd3-d48a0c48ccb5",
                        "glosses": [
                            "A judge of Israel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb1b0ddc-c378-4ca4-b626-9b58ab9b695e",
                                "sense_id": "58cea844-8d37-38f3-acb9-b3e778255b22",
                                "text": "And Deborah, a prophetess, the wife of Lapidoth, she judged Israel at that time."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7b1f6b4-e143-3edc-9ca0-7446c3c279eb",
                        "entry_id": "f78293a9-e78a-382e-8bd3-d48a0c48ccb5",
                        "glosses": [
                            "A nurse of Rebecca."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "02d38702-445c-3190-bd44-fddc8fcf3af3",
                        "entry_id": "f78293a9-e78a-382e-8bd3-d48a0c48ccb5",
                        "glosses": [
                            "A female given name from Hebrew, popular from the 1940s to the 1970s, first in the USA, then in the UK."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29dd47c8-ca44-4b5e-a586-0b80bf3f3233",
                                "sense_id": "02d38702-445c-3190-bd44-fddc8fcf3af3",
                                "text": "Rapier. Heigho! Deborah! it's an ugly name, a damnable name - the name I mean! - it sounds like Gomorrah! Deb! Debby! - worse still - sounded sharp now I rather like it! - Deborah! Deborah! Deborah!"
                            },
                            {
                                "example_id": "32a586a7-990f-4a14-9a12-9ba9ea3d1426",
                                "sense_id": "02d38702-445c-3190-bd44-fddc8fcf3af3",
                                "text": "He hadn't known, for example, that her middle name was Deborah. It was a name he liked: plucky, Midwestern and reliable-sounding. He was willing to bet that if you went through every women's prison in America, you wouldn't find a half-dozen Deborahs."
                            },
                            {
                                "example_id": "53e49993-451d-41a1-98bf-a3c2dca6de7a",
                                "sense_id": "02d38702-445c-3190-bd44-fddc8fcf3af3",
                                "text": "Your name is Deborah, Deborah / It never suited ya"
                            }
                        ]
                    }
                ],
