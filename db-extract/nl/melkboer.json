                        "glosses": [
                            "iemand die langs de deur ging met voornamelijk melk en zuivelproducten, en eventueel een winkel dreef"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "c045172f-af80-4fa0-896d-adbaa4a3512b",
                                "sense_id": "ec78c701-5724-38a3-9b25-98f2e289c794",
                                "text": "De melkboer bracht de melk bij ons aan de deur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d4ca083-05a8-4ad2-b436-bd3d6b5ad460",
                        "source_entry_id": "b9e1ecf5-f34f-3a0e-ba8b-d1125855aeee",
