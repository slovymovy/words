                ],
                "senses": [
                    {
                        "sense_id": "05462f78-2534-35a0-a5fc-3b2cb61bc92c",
                        "entry_id": "57923be3-7385-3248-8f2a-c52aebf4edab",
                        "glosses": [
                            "Wasserbad, das vornehmlich dazu dient, Speisen warm zu halten beziehungsweise bestimmte Speisen langsam zu erwärmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5626ee5-b8e2-4fa6-bad8-86d913b7e9a3",
                                "sense_id": "05462f78-2534-35a0-a5fc-3b2cb61bc92c",
                                "text": "„Das Bain-Marie wird in der Gastronomie nicht nur zum Erwärmen von Speisen (Elektro Wasserbad) eingesetzt, was die traditionelle Anwendung ist sondern vorallem [sic!] zum Warmhalten von Speisen, etwa in der Speisenausgabe und hier vorallem [sic!] in Form einer Vitrine (Heiße Theke, Wärmetheke).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac9d3264-40b1-46e3-b57a-a785883daa57",
                        "source_entry_id": "57923be3-7385-3248-8f2a-c52aebf4edab",
                        "source_sense_id": "05462f78-2534-35a0-a5fc-3b2cb61bc92c",
                        "source_sense_description": "Wasserbad, das vornehmlich dazu dient, Speisen warm zu halten",
                        "target_lang_word": "bain-marie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bain-marie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4896db3e-6a55-3789-a5ae-7344b9139408",
                                        "entry_id": "93e4493f-1e32-3894-9c2c-216591ee54e7",
                                        "glosses": [
                                            "A large pan containing hot water, into which other smaller pans are set in order to cook food slowly, or to keep food warm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "338d46da-1ceb-47bb-9315-a0c1f4822af0",
                                                "sense_id": "4896db3e-6a55-3789-a5ae-7344b9139408",
                                                "text": "Steam tables, bains marie, and chaffing dishes require that an accurate external probe thermometer be used."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa16f8c-5803-3073-9165-7be9f0939520",
                                        "entry_id": "93e4493f-1e32-3894-9c2c-216591ee54e7",
                                        "glosses": [
                                            "A unit comprising an array of such pans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a93925eb-bd31-4d50-94e8-b9df8528e7b7",
                        "source_entry_id": "57923be3-7385-3248-8f2a-c52aebf4edab",
                        "source_sense_id": "05462f78-2534-35a0-a5fc-3b2cb61bc92c",
                        "source_sense_description": "Wasserbad, das vornehmlich dazu dient, Speisen warm zu halten",
                        "target_lang_word": "bain-marie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bain-marie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                        "entry_id": "15d7d4fc-8395-35d2-bc96-4a046ca43181",
                                        "glosses": [
                                            "Récipient partiellement rempli d’un liquide qui est généralement de l’eau ou de l’huile, sur lequel on place un autre récipient contenant une préparation à cuire ou à réchauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfca3b8d-b1a7-4958-ab5f-c56ba3933918",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "La coloration des crayons était autrefois presque uniquement obtenue avec le racine d’orcanette restant, au bain-marie, en contact avec la matière grasse."
                                            },
                                            {
                                                "example_id": "ee3e3313-6a8c-475c-9bc3-7a96d3973a3e",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "On les fait tiédir ou non au bain-marie, suivant l’état de tolérance du malade, les eaux froides pouvant subir cette préparation aussi bien que les eaux chaudes. — (Louis Caillon, Guide du malade à Vichy, Tunis, 1929, page 15)"
                                            },
                                            {
                                                "example_id": "62920f19-d890-40e2-95e7-eb145032be89",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "Quatre fours, six bouches, deux tables chauffantes, des bains-marie de cinquante litres, un foyer sous hotte où rôtir à l’aise les marcassins par douze."
                                            },
                                            {
                                                "example_id": "c82173a1-a274-496e-b13d-df2ff22c200f",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "Un cassoulet qui cuit au bain-marie, ça ne risque rien, sot!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d67eb9-6e06-308f-9ce5-458193575fb9",
                                        "entry_id": "15d7d4fc-8395-35d2-bc96-4a046ca43181",
                                        "glosses": [
                                            "Dans une situation problématique, bouillante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea18415c-a960-483a-ae64-a8f826baa62d",
                                                "sense_id": "b2d67eb9-6e06-308f-9ce5-458193575fb9",
                                                "text": "Rien ne va changer. Une humanité au bain-marie, des dévastations, des convulsions, beaucoup de bla-bla, presque plus de littérature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
