                "senses": [
                    {
                        "sense_id": "05036881-74b3-3420-aa9f-134c5149cfee",
                        "entry_id": "eefdbf20-3c16-3f86-978f-a224714e4d8e",
                        "glosses": [
                            "drizzly, drizzling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d43303c-8a63-4e40-973a-a2081436db8e",
                                "sense_id": "05036881-74b3-3420-aa9f-134c5149cfee",
                                "text": "Wieczór był ciemny, prawie jesienny, chłodny i mżysty. Wilgoć przejmowała po kościach; na czarnem niebie nie świeciła ani jedna gwiazda...",
                                "translation": "The evening was dark, almost autumnal, chilly and drizzly. The wetness seized one's bones; not a single star shone on the black sky...",
                                "english": "The evening was dark, almost autumnal, chilly and drizzly. The wetness seized one's bones; not a single star shone on the black sky..."
                            },
                            {
                                "example_id": "31723554-1574-429b-89d6-2d63586412ab",
                                "sense_id": "05036881-74b3-3420-aa9f-134c5149cfee",
                                "text": "Deszcze stają się coraz mżystsze...",
                                "translation": "The rains are becoming ever more drizzly...",
                                "english": "The rains are becoming ever more drizzly..."
                            }
                        ]
                    }
