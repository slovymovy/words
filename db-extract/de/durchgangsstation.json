                ],
                "senses": [
                    {
                        "sense_id": "0d6156c2-75bd-32c3-88c3-703cec05c460",
                        "entry_id": "62807103-444f-307f-aede-4c765b332c05",
                        "glosses": [
                            "Station, von der man aus (in mehrere Richtungen) weiterreisen kann, im Gegensatz zur Endstation"
                        ],
                        "tags": [
                            "Bahnverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "f094d7bf-84ec-4b2c-a2dd-c12d61f91581",
                                "sense_id": "0d6156c2-75bd-32c3-88c3-703cec05c460",
                                "text": "„Bei „Stuttgart 21“ wird der Hauptbahnhof für 4,1 Milliarden Euro vom Kopfbahnhof zu einer unterirdischen Durchgangsstation umgestaltet und an eine neuzubauende Hochgeschwindigkeitstrasse in Richtung Ulm angebunden.“"
                            },
                            {
                                "example_id": "86d6f959-923d-462c-ad68-99f1ba047803",
                                "sense_id": "0d6156c2-75bd-32c3-88c3-703cec05c460",
                                "text": "„Der [neue] Bahnhof [in Wien] ist als Durchgangsstation konzipiert, nicht mehr als Kopfbahnhof.“"
                            },
                            {
                                "example_id": "bf002bad-df5d-4b72-9e97-55d2d9f7aba5",
                                "sense_id": "0d6156c2-75bd-32c3-88c3-703cec05c460",
                                "text": "„Der Bahnhof auf der Bodenseeinsel in Lindau soll erhalten und zusätzlich eine Durchgangsstation für den Fernverkehr Zürich–München auf dem Festland angelegt werden.“"
                            },
                            {
                                "example_id": "25b7fa62-9172-4022-b356-1467bc878175",
                                "sense_id": "0d6156c2-75bd-32c3-88c3-703cec05c460",
                                "text": "„Das Projekt Stuttgart 21 sieht den Umbau des Kopfbahnhofs in eine unterirdische Durchgangsstation und deren Anbindung an die geplante ICE-Neubaustrecke nach Ulm vor.“"
                            },
                            {
                                "example_id": "07781a72-cbf3-49c7-90df-041175ec4d90",
                                "sense_id": "0d6156c2-75bd-32c3-88c3-703cec05c460",
                                "text": "„Zuletzt war von einer Milliarde Euro Mehrausgaben für den Umbau des Stuttgarter Hauptbahnhofs in eine unterirdische Durchgangsstation samt Anbindung an eine neue Schnellstrecke die Rede.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "499eb86d-c7b1-376c-b1be-1e423eb0940e",
                        "entry_id": "62807103-444f-307f-aede-4c765b332c05",
                        "glosses": [
                            "Ort, an dem man auf seiner Reise nur einen Zwischenstopp macht, der also nicht das Endziel ist"
                        ],
                        "tags": [
                            "auch übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "d0af5d1c-a483-45a4-8496-f00a373abf78",
                                "sense_id": "499eb86d-c7b1-376c-b1be-1e423eb0940e",
                                "text": "„Für die Afghanen ist die Türkei eine Durchgangsstation.“"
                            },
                            {
                                "example_id": "3f3c643b-37b9-49f1-b02c-77e75849422f",
                                "sense_id": "499eb86d-c7b1-376c-b1be-1e423eb0940e",
                                "text": "„Troja liegt an der Meerenge der Dardanellen, die zwischen Europa und Asien liegt, und war nach Erkenntnissen Korfmanns jahrhundertelang eine wichtige Durchgangsstation zwischen den beiden Kontinenten.“"
                            },
                            {
                                "example_id": "d3849b84-cf8f-434f-bf71-4aad557f3600",
                                "sense_id": "499eb86d-c7b1-376c-b1be-1e423eb0940e",
                                "text": "„Griechenland dient den meisten Flüchtlingen nur als Durchgangsstation.“"
                            },
                            {
                                "example_id": "892848bd-3696-4bff-b0af-7791d5388010",
                                "sense_id": "499eb86d-c7b1-376c-b1be-1e423eb0940e",
                                "text": "„Für viele Container ist der Hamburger Hafen nur eine Durchgangsstation.“"
                            },
                            {
                                "example_id": "5af322a5-0880-492b-9b7e-61c5ea111d41",
                                "sense_id": "499eb86d-c7b1-376c-b1be-1e423eb0940e",
                                "text": "„In einer Stellungnahme des Schweizer Bundesrats zum Emigrantenproblem im Lande wird darauf hingewiesen, dass die Schweiz kein Erwerbsland für Einwanderer sein könne, sondern nur eine Durchgangsstation für die Weiterreise nach Übersee.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
