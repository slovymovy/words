                        "entry_id": "a4acab36-aaf9-34bb-926b-d18e5d6fc1ef",
                        "glosses": [
                            "sprachliche Äußerung unwahren Charakters, um negative Folgen für sich selbst zu vermeiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2952b51a-d9ae-40c4-9a5e-4d5126154e4c",
                                "sense_id": "7b721124-9ca3-3cfd-92e1-9399d74fe18f",
                                "text": "Ihm war bewusst, dass es sich dabei erst einmal um eine Schutzbehauptung handeln musste, bis er Näheres in Erfahrung bringen konnte."
                            },
                            {
                                "example_id": "7f055304-2720-4077-b939-71d6caa638f1",
                                "sense_id": "7b721124-9ca3-3cfd-92e1-9399d74fe18f",
                                "text": "„Sich mit Schutzbehauptungen und Tricks durch den nationalsozialistischen Dschungel laviert zu haben ist kein Verbrechen, und Kästners Drehbuch ist künstlerisch und ideologisch nicht zu beanstanden.“"
                            }
                        ],
