                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e79bb578-26d5-4c49-adf1-e062d25cd953",
                        "source_entry_id": "c2842f57-2cb6-389c-974e-377295e011d8",
                        "source_sense_id": "7a244890-7780-37a8-9852-4260eeea30b7",
                        "target_lang_word": "Ziegelbrenner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziegelbrenner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25580e4a-7eba-33eb-94b5-44c2a0545ccf",
                                        "entry_id": "2c2eac9a-85a0-3131-90e0-62e4d8e838ed",
                                        "glosses": [
                                            "Handwerker, der Ziegel herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ab0aed-53fb-45f2-9880-47702cce30b0",
                                                "sense_id": "25580e4a-7eba-33eb-94b5-44c2a0545ccf",
                                                "text": "„Wenn man die Erzeugnisse der Ziegelpatscher und Ziegelbrenner jedoch in einer gut aufgestellten Museumsabteilung erzählen lässt, wissen sie plötzlich von zahlreichen interessanten Begebenheiten zu berichten: Von dem Ziegelprivileg beispielsweise, das Adel und Klöster, Städte und Märkte bis ins 18. Jahrhundert hinein mit Zähnen und Klauen verteidigten, weil es ihnen ungefährdete Einnahmequellen sicherte, jedoch den Verfall der Bausubstanz besonders auf dem Land nach sich zog und zu einer empfindlichen Holzknappheit führte.“"
                                            },
                                            {
                                                "example_id": "f7c1c04f-4acb-4ec2-886c-e98dd5f057c4",
                                                "sense_id": "25580e4a-7eba-33eb-94b5-44c2a0545ccf",
                                                "text": "„Als substantieller erwies sich die in Literatenkreisen der Weimarer Republik geäußerte Vermutung, dass Traven mit dem nicht minder geheimnisvollen Herausgeber der individual-anarchistischen Zeitschrift „Der Ziegelbrenner“ und Funktionär der Münchner Räterepublik Ret Marut identisch sei, dessen Spur sich 1919 mit der Flucht aus Bayern verlor. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7a591db-8ca1-4d40-a207-d9157c893594",
                        "source_entry_id": "c2842f57-2cb6-389c-974e-377295e011d8",
                        "source_sense_id": "7a244890-7780-37a8-9852-4260eeea30b7",
                        "target_lang_word": "кирпичник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кирпичник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d02e80ee-c704-3a7c-8624-828bd01030cc",
                                        "entry_id": "89849b71-6bc8-3ab6-b888-7eda0edcfea4",
                                        "glosses": [
                                            "тот, кто делает кирпичи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d578684-e7ac-4632-afe3-0e134cf5bff9",
                                                "sense_id": "d02e80ee-c704-3a7c-8624-828bd01030cc",
                                                "text": ".. копаю в лесу камень, нанял кирпичников (покупной кирпич никуда не годен) .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26426865-b322-37f9-b8f1-9aadeffae9f7",
                                        "entry_id": "89849b71-6bc8-3ab6-b888-7eda0edcfea4",
                                        "glosses": [
                                            "тот, кто занимается кирпичной кладкой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44bf5081-353c-4215-900a-1580e6f8a1d3",
                                                "sense_id": "26426865-b322-37f9-b8f1-9aadeffae9f7",
                                                "text": "— Милушкин, кирпичник! мог поставить печь в каком угодно доме."
                                            }
                                        ]
                                    }
                                ]
