                ],
                "senses": [
                    {
                        "sense_id": "86ddf0a3-6486-37c0-88c6-9ad59f7165b2",
                        "entry_id": "9ada9b63-2223-3af9-897a-83ab035c23e4",
                        "glosses": [
                            "Frau, die Medizin studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5872086-e12c-49db-950e-e4280cf4fe81",
                                "sense_id": "86ddf0a3-6486-37c0-88c6-9ad59f7165b2",
                                "text": "Jede Medizinstudentin muss sich im Laufe ihres Studiums mit der Pathologie beschäftigen."
                            },
                            {
                                "example_id": "b19a1ff1-84ec-4556-b26a-78c040aee9e5",
                                "sense_id": "86ddf0a3-6486-37c0-88c6-9ad59f7165b2",
                                "text": "„Eine Medizinstudentin im höheren Semester nimmt sich ihrer schließlich an und bringt sie zu sich nach Hause.“"
                            },
                            {
                                "example_id": "3f5c4349-0e75-4de0-a11b-05243f30e556",
                                "sense_id": "86ddf0a3-6486-37c0-88c6-9ad59f7165b2",
                                "text": "„Von dort kam Dr. Döblin ins Berliner Urban-Krankenhaus, wo er der Medizinstudentin Erna Reiss, seiner späteren Frau, begegnete, die vorerst nach Jena ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
