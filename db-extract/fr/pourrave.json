                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                        "entry_id": "814719e0-252c-3ebb-a89f-1aedd84af2ef",
                                        "glosses": [
                                            "von geringer Qualität oder Quantität"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b3d0c9f-9782-4e48-b8c2-4784846eb054",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "Dieses popelige Geschenk hätte sie sich gleich sparen können!"
                                            },
                                            {
                                                "example_id": "3b7d562c-1e7e-4dcc-9ee2-677ac8cba978",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "Das Einkommen von Otto Normalverbraucher ist so popelig im Vergleich zu den Kapitalerträgen von Milliardären."
                                            },
                                            {
                                                "example_id": "16a382f6-830a-4238-a6e3-5795b595b251",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "Ein popeliger Urlaub an einem See in Mecklenburg? Ich fliege dieses Jahr nach Neuseeland."
                                            },
                                            {
                                                "example_id": "229507dd-48d2-4f28-8e97-fb010a60565c",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "Wir sind tatsächlich ein popeliger kleiner Verein mit nur 30 Mitgliedern, die sind aber sehr nett und freundlich."
                                            },
                                            {
                                                "example_id": "55aa35ca-d929-4dcb-a3fa-b3ad49336599",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "Die KEF schlug 2019 vor, dass der Rundfunkbeitrag nach zehn Jahren konstantem Beitrag um popelige 86 Cent auf dann 18,35 Euro steigen sollte."
                                            },
                                            {
                                                "example_id": "4d0f7260-af7a-4310-83e5-ec95a19f6811",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "„Eigentlich geht es um popelige 150 Meter Radweg. Um die streiten die Stadt Hannover und das Land Niedersachsen nun aber schon seit einem Jahr oder zweieinhalb Wahlkämpfen.“"
                                            },
                                            {
                                                "example_id": "54aaebd0-a8c6-4ef7-9d52-8949e60b5f38",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "Ich will in dem Film nicht irgendeine popelige Nebenrolle spielen, ich will die Hauptrolle."
                                            },
                                            {
                                                "example_id": "8c883058-1994-4913-89d6-a2635066a1f9",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "[Friedrich Merz/CDU:] „Alles unter Vorsitzender war ihm offenbar zu popelig.“"
                                            },
                                            {
                                                "example_id": "8bcbc379-d091-4810-8c1b-3e430e998658",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "[Umweltschutz:] „Selbst im popeligen Monaco gibt sich Fürst Albert als grüner Potentat.“"
                                            },
                                            {
                                                "example_id": "99730dd5-c6d2-43f3-a6da-449278452483",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "„Als in Hamburg Henning Voscherau 1997 hingeschmissen hatte, weil ihm das SPD-Ergebnis von 36,2 Prozent zu popelig schien, war Ortwin Runde eingesprungen, der linke Sozialdemokrat und anerkannte Finanzpolitiker.“"
                                            },
                                            {
                                                "example_id": "d206f661-2b37-4b77-bc3c-63ca3b2342fd",
                                                "sense_id": "d8b0b098-0ce6-3d77-9642-ebf2b5bf360d",
                                                "text": "„Wir wollen diverser werden, hieß es 2021 aus vielen Redaktionen. Zu Recht. Hat doch jeder vierte Mensch in Deutschland hat einen Migrationshintergrund. In den Chefetagen der reichweitenstärksten deutschen Medienhäuser hingegen sind es popelige sechs Prozent (die Hälfte davon aus dem deutschsprachigen Nachbarland).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
