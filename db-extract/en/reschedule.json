                "senses": [
                    {
                        "sense_id": "6f1d77ab-4270-3247-80cd-b1c47937a1f9",
                        "entry_id": "78a421e2-10ca-303e-ae80-55e7806dceb5",
                        "glosses": [
                            "To schedule again or at a different time."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5f30bf00-32c0-40d5-be68-8b80f215b0f9",
                                "sense_id": "6f1d77ab-4270-3247-80cd-b1c47937a1f9",
                                "text": "We'll have to reschedule next Monday's meeting because of the public holiday."
                            },
                            {
                                "example_id": "8ad4d96f-727e-4acc-b2b4-4976e60f123d",
                                "sense_id": "6f1d77ab-4270-3247-80cd-b1c47937a1f9",
                                "text": "Network Rail says it has also rescheduled repairs and renewals work to coincide with the closures, including a full bridge replacement at Postwick and track renewals at Lowestoft, Acle and Hassingham, along with additional maintenance to the swing bridges at Reedham and Somerleyton."
                            },
                            {
                                "example_id": "8d1c88f8-9d6b-4280-9853-6521c282fe69",
                                "sense_id": "6f1d77ab-4270-3247-80cd-b1c47937a1f9",
                                "text": "Seek so much as a kernel of advice on the internet in 2024 about conflicts in a relationship, a situationship or even an affair, and you may find yourself inundated with recommendations to \"stand on business.\" A Hinge match asks to reschedule your first date with 30 minutes' notice? Stand on business. Your ex continues to hit you up months after the breakup? Stand on business."
                            }
                        ]
                    },
                    {
                        "sense_id": "3afd0f9c-eeba-3e76-8f1d-529c14328ca9",
                        "entry_id": "78a421e2-10ca-303e-ae80-55e7806dceb5",
                        "glosses": [
                            "To reclassify; to change the schedule (division into which something is classified) of."
                        ],
                        "tags": [
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "056083ea-be2c-434a-9302-314dcc803d77",
                                "sense_id": "3afd0f9c-eeba-3e76-8f1d-529c14328ca9",
                                "text": "Judge Young had been considering a petition filed to have marijuana rescheduled under federal law."
                            },
                            {
                                "example_id": "41b32514-c8b8-4f7a-96bb-f0badc4f6c01",
                                "sense_id": "3afd0f9c-eeba-3e76-8f1d-529c14328ca9",
                                "text": "Moreover, marijuana could only be brought to market if it were rescheduled to acknowledge its “accepted medical use,” according to DEA standards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05f1e950-792c-4b6b-ac0b-a44ffbc04236",
                        "source_entry_id": "78a421e2-10ca-303e-ae80-55e7806dceb5",
