                "senses": [
                    {
                        "sense_id": "ca4d45e2-b87d-3a06-ad1b-15864801c805",
                        "entry_id": "4700db8b-bafb-3a35-ac7f-aa6529529c92",
                        "glosses": [
                            "über dem Herd anzubringende, technische Vorrichtung, die beim Kochen entstehenden Wrasen (Küchendunst) ansaugt, filtert und anschließend die gereinigte Luft wieder in den Raum zurückleitet, wobei ein Luftkreislauf erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ffe98a7-2618-4852-8cee-589922293ec2",
                                "sense_id": "ca4d45e2-b87d-3a06-ad1b-15864801c805",
                                "text": "Da die Küche über eine Dunstabzugshaube, genauer gesagt eine Umlufthaube, verfügte, nahmen die Gäste keinerlei störende Gerüche war."
                            },
                            {
                                "example_id": "842107bf-151b-4fad-8402-1ea388ad0b6b",
                                "sense_id": "ca4d45e2-b87d-3a06-ad1b-15864801c805",
                                "text": "Eine Umlufthaube hilft, im Winter Energie zu sparen, da wertvolle Wärme nicht nach außen geleitet wird."
                            },
                            {
                                "example_id": "4a2c5b21-2bb8-4e95-a39d-921e971f4f50",
                                "sense_id": "ca4d45e2-b87d-3a06-ad1b-15864801c805",
                                "text": "Beim Kauf entschied er sich für eine Umlufthaube, da aufgrund gesetzlicher Beschränkungen die Installation einer Ablufthaube nicht möglich war."
                            },
                            {
                                "example_id": "33f8ef06-e947-480e-9871-96e9541ca36b",
                                "sense_id": "ca4d45e2-b87d-3a06-ad1b-15864801c805",
                                "text": "„Umlufthauben können Gerüche nur teilweise und Feuchtigkeit überhaupt nicht beseitigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
