            "senses": [
                {
                    "sense_id": "72a55c1c-994c-3b42-9feb-58f5ed5fa344",
                    "sense_definition": "A hard protective outer covering or shell, especially the dorsal shield of animals like turtles, crabs, and insects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The turtle retreated into its thick <w>carapace</w> as soon as the predator approached."
                        },
                        {
                            "text": "Biologists examined the cracked <w>carapace</w> of the giant crab to determine its age."
                        }
                    ],
                    "synonyms": [
                        "shell"
                    ],
                    "common_phrases": [
                        "turtle carapace"
                    ]
                },
                {
                    "sense_id": "4d416e48-b8e1-3852-9979-2376244d964b",
                    "sense_definition": "A tough protective barrier or facade, especially an emotional or psychological one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Behind her cynical <w>carapace</w>, she hid a deep vulnerability and fear of rejection."
                        },
                        {
                            "text": "It was difficult for the therapist to pierce his emotional <w>carapace</w> and reach the trauma underneath."
                        }
                    ],
                    "synonyms": [
                        "shield",
                        "armor"
                    ],
                    "common_phrases": [
                        "emotional carapace",
                        "protective carapace"
                    ]
                }
            ]
        }
