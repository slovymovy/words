                                "example_id": "3e325808-4e53-470c-bbf7-4729572f289b",
                                "sense_id": "7b6fa921-92bd-39f9-a9bf-df44d31b4a4c",
                                "text": "„Und tatsächlich, fünf Minuten später war die Funkstreife da.“"
                            }
                        ],
