                "senses": [
                    {
                        "sense_id": "77a1ec78-9a3f-35f6-b616-252e0d2d8b90",
                        "entry_id": "fdcbb351-7ff2-3250-be17-8fd91e2b85c0",
                        "glosses": [
                            "oddając mocz, zmoczyć kogoś lub coś"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "b42071bf-e73b-4c77-bdb0-0e404e3c799b",
                                "sense_id": "77a1ec78-9a3f-35f6-b616-252e0d2d8b90",
                                "text": "Wiem, co się u was o Sovro mawia: że bez łapówki to tyci i pies ciżmy nie oszcza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ada607f4-dcd4-49c0-b420-e86bd8159f9e",
                        "source_entry_id": "fdcbb351-7ff2-3250-be17-8fd91e2b85c0",
                        "source_sense_id": "77a1ec78-9a3f-35f6-b616-252e0d2d8b90",
                        "target_lang_word": "обоссать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обоссать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                        "entry_id": "650c61ee-4b3f-3214-85e4-4f1923bc5ca8",
                                        "glosses": [
                                            "вульг. облить, залить мочой что-либо, кого-либо в процессе мочеиспускания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7853cc85-f813-409c-aa4c-4274bd1be543",
                                                "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                                "text": "«Опять всю лестницу обоссали, засранцы!»"
                                            },
                                            {
                                                "example_id": "f9b75010-f1f1-4da0-b796-c823b6afe057",
                                                "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                                "text": "Мне сегодня хочется очень // Из окошка луну обоссать."
                                            },
                                            {
                                                "example_id": "6093fdc9-668d-48c3-8d10-1ec4bb67dd58",
                                                "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                                "text": "Маршал берёт документ, рвёт его в клочья и рявкает охране: — Избить, обоссать и бросить в канаву! ❬…❭ Многие расписывались на Рейхстаге или считали своим долгом обоссать его стены."
                                            },
                                            {
                                                "example_id": "cdb73960-392f-4448-9065-a446d32098cf",
                                                "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                                "text": "— Порубал небось ноги да обоссал — косит, сука, в больничку захотелося, масло хавать. — Кто его обоссать научил? Ты, сержант?"
                                            },
                                            {
                                                "example_id": "49c43a6d-9f5b-463b-897d-b0b57eb029e6",
                                                "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                                "text": "Он и на морозе спал, в болоте спал, на лесоповале его как-то ночью обоссали, ко всему привычен, — он готов спать в сарае."
                                            },
                                            {
                                                "example_id": "4aeea654-a7e1-45ee-b166-dfdb8b79d291",
                                                "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                                "text": "Тракторина Петровна даже руками всплеснула. — Обоссала всю кровать!"
                                            },
                                            {
                                                "example_id": "c21936f8-4046-4b7b-af92-1552b5752458",
                                                "sense_id": "0e5657f6-f834-3c40-8397-34240a80b54c",
                                                "text": "— Давай обоссым его, — говорит Вэк. ❬…❭ — Тогда обоссы его хотя бы, — говорит Клок. ❬…❭ — Зря ты его обоссал, Вэк, — говорит Бык."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
