                    {
                        "translation_id": "b353bacb-361d-4510-bdfa-c4056fbd728d",
                        "source_entry_id": "4e519bc2-a44f-36a2-b1e7-d1e0fc13bb95",
                        "source_sense_id": "9cd66b3e-d8e5-36ea-8278-2fc0e6b4c710",
