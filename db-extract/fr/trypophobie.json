                        "entry_id": "bd741fbc-3473-39fd-b476-0847bbcf84df",
                        "glosses": [
                            "Peur phobique des successions de petits trous, y compris de leurs représentations photographiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777797b9-2b1c-4dc6-a19a-d971920a40e0",
                                "sense_id": "7e08ff97-550f-33e5-b300-054c9cdf8634",
                                "text": "Identifiée en 2005, la trypophobie se traduirait donc par une peur panique des petits trous, comme on peut en voir dans la fleur de lotus, un nid d’abeille, ou la tenue portée par Doja Cat en ce début de semaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53bd7ada-960a-470a-90fa-e17e32bf1545",
                        "source_entry_id": "bd741fbc-3473-39fd-b476-0847bbcf84df",
                        "source_sense_id": "7e08ff97-550f-33e5-b300-054c9cdf8634",
                        "target_lang_word": "trypophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trypophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc68392d-9b3f-3dd9-b6e1-ddd95f717862",
                                        "entry_id": "40a43f12-5412-38bb-b92c-97b25727cdec",
                                        "glosses": [
                                            "An irrational or obsessive fear of irregular patterns or clusters of small holes, such as those found in honeycombs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93e1bff-b376-4f6e-8598-aab5cf48f1fa",
                                                "sense_id": "fc68392d-9b3f-3dd9-b6e1-ddd95f717862",
                                                "text": "Images of lotus seed heads are often reported as inducing trypophobia. Sufferers of trypophobia report that it is the visual percept that is particularly aversive."
                                            },
                                            {
                                                "example_id": "d24bd045-43b5-49c2-87b0-921790e08a33",
                                                "sense_id": "fc68392d-9b3f-3dd9-b6e1-ddd95f717862",
                                                "text": "2015, Irena Milosevic, Trypophobia (Fear of Holes), Irena Milosevic, Randi E. McCabe (editors), Phobias: The Psychology of Irrational Fear, ABC-CLIO (Greenwood), page 401,\nIn particular, individuals with trypophobia are fearful of clusters of holes that are found in a variety of objects and matter such as skin, coral, honeycombs, seed pods, and even aerated chocolate."
                                            }
                                        ]
                                    }
