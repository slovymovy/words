                    {
                        "sense_id": "4b4602e2-842c-33b7-bad0-14f8c70e7db3",
                        "entry_id": "5dc20f5c-85e8-35e1-92d6-4381f2207e72",
                        "glosses": [
                            "element stroju liturgicznego w katolicyzmie w formie płóciennej chusty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbc603b-107c-4288-8eee-1a4827e9ff6f",
                                "sense_id": "4b4602e2-842c-33b7-bad0-14f8c70e7db3",
                                "text": "Niektórzy zakonnicy zakładają nieco większy humerał na swój kaptur, tak aby nie był on widoczny."
                            },
                            {
                                "example_id": "16d888a6-ba7d-4095-8d25-7bc4de63f739",
                                "sense_id": "4b4602e2-842c-33b7-bad0-14f8c70e7db3",
                                "text": "Zakonnice wyhaftowały na humerałach ozdobny chrystogram IHS."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
