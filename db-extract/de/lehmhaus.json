                "senses": [
                    {
                        "sense_id": "d39f436a-a8f3-3df5-8e4b-ff897881ad2c",
                        "entry_id": "ad178cf1-3f11-347b-bd36-fe808dac36b5",
                        "glosses": [
                            "Haus, das überwiegend aus Lehm besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "992e0d9c-19eb-47e7-8b1a-198aac3eca76",
                                "sense_id": "d39f436a-a8f3-3df5-8e4b-ff897881ad2c",
                                "text": "„Auch im Lehmhaus lässt sich’s leben“ (Buchtitel von René Gardi)"
                            },
                            {
                                "example_id": "a602e907-1f4a-42c2-ba96-ceb704a20a03",
                                "sense_id": "d39f436a-a8f3-3df5-8e4b-ff897881ad2c",
                                "text": "„Er drängte uns in eines der Lehmhäuser: sein Laden.“"
                            },
                            {
                                "example_id": "c2485d1b-89c2-44e5-b0fb-2c61a05b3e4a",
                                "sense_id": "d39f436a-a8f3-3df5-8e4b-ff897881ad2c",
                                "text": "„Für die Konstruktion ihrer Lehmhäuser brauchten die Neuankömmlinge die Stämme der Kiefern – viele davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
