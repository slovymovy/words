                    {
                        "sense_id": "dd61ffd1-5fc0-3e47-abc3-45fefe1a2d05",
                        "entry_id": "025838f2-7742-34bc-a5d6-94148db2a9a9",
                        "glosses": [
                            "Hammer, der zum Tischlern verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d337d4-7e15-4429-973e-0e69a82d2a91",
                                "sense_id": "dd61ffd1-5fc0-3e47-abc3-45fefe1a2d05",
                                "text": "„Am Osterwochenende ging Kemper, während seine Mutter schlief, in ihr Zimmer und schlug wiederholt mit einem Tischlerhammer auf sie ein, bis sie tot war.“"
                            },
                            {
                                "example_id": "5ce3689f-e282-4945-b7e9-48392518d1d1",
                                "sense_id": "dd61ffd1-5fc0-3e47-abc3-45fefe1a2d05",
                                "text": "„Das Herz hämmerte in seiner Brust, der Griff des Tischlerhammers in seiner Linken war schweißnass, ebenso das krumme, gezackte Tauchermesser in der Rechten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
