                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7177e5e-98b3-3fd0-a817-71797a97a52f",
                                        "entry_id": "44d2db56-e3cc-37fb-ada7-8882023e9807",
                                        "glosses": [
                                            "Nonsense; humbug."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c93aff-e5b5-4fac-ade6-db5b2a189b3c",
                                                "sense_id": "e7177e5e-98b3-3fd0-a817-71797a97a52f",
                                                "text": "And this, without more slum began, / Over a flowing pot-house can, / To settle, without botheration, / The rigs of this here tip-top nation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc471bf5-d98b-4bae-aedc-f4b4d217eb70",
                        "source_entry_id": "983d84f9-a568-3949-87ea-ea374a4b8b74",
                        "source_sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
