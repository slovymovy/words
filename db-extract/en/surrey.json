                                            },
                                            {
                                                "example_id": "a70b3e10-8c13-4968-b51c-005b6751ebf7",
                                                "sense_id": "5fe53cf3-a14d-3327-92f6-c46063bf7a65",
                                                "text": "감자 서리."
                                            },
                                            {
                                                "example_id": "fccc73e5-d7cc-40a9-bfaa-7cb2ea0d4f6b",
