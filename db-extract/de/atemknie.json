                                        "glosses": [
                                            "Homme bossu, vilain."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de7914c-f490-4391-87a3-8dbd9c233a5e",
                                                "sense_id": "78d95323-9b3f-3964-b6f5-ba5dd64264b7",
                                                "text": "Le justicier, le vilain boscoyo, haussait à nouveau les épaules."
                                            }
                                        ]
                                    }
                                ]
                            }
