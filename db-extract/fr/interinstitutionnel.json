                "senses": [
                    {
                        "sense_id": "f0af7bab-7dcc-3db3-bd25-eaba522b9e35",
                        "entry_id": "761e13af-c3aa-3898-9956-6babaf7ccfb8",
                        "glosses": [
                            "Relatif à l’interaction entre plusieurs institutions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f65abb2-d19b-4eeb-b04a-fced043007c2",
                                "sense_id": "f0af7bab-7dcc-3db3-bd25-eaba522b9e35",
                                "text": "Enfin notons que d’après le Groupement Local « tout ceci prouve que la convergence des moyens employés aux différents niveaux, départemental, communal, interinstitutionnel s’avère particulièrement payante et mène à se poser la question de l’après. »"
                            },
                            {
                                "example_id": "cb562477-b2e0-4900-93b9-165b850a6cf6",
                                "sense_id": "f0af7bab-7dcc-3db3-bd25-eaba522b9e35",
                                "text": "Seuls les journalistes accrédités (ayant une accréditation interinstitutionnelle de l’UE ou une accréditation auprès du Parlement) auront accès aux locaux du Parlement le soir des élections."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a79ab4b-d1f4-4609-bddd-91435c362c6f",
                        "source_entry_id": "761e13af-c3aa-3898-9956-6babaf7ccfb8",
                        "source_sense_id": "f0af7bab-7dcc-3db3-bd25-eaba522b9e35",
                        "target_lang_word": "interinstitutionell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interinstitutionell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c668a645-8738-34fd-8d7a-a55a212196aa",
                                        "entry_id": "7bb9e98d-e25e-3b38-89cd-24636546724a",
                                        "glosses": [
                                            "Beziehungen zwischen Institutionen betreffend (insbesondere solchen der Europäischen Union)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb919d3-589e-462c-b10a-5eb181ecffcd",
                                                "sense_id": "c668a645-8738-34fd-8d7a-a55a212196aa",
                                                "text": "„Um die interinstitutionelle Zusammenarbeit im Übersetzungsbereich zu stärken, wurde 1995 der Bereich, in dem das Übersetzungszentrum Leistungen erbringen kann, durch eine Änderung der Gründungsverordnung offiziell erweitert.“"
                                            },
                                            {
                                                "example_id": "726b62d7-e3e0-406b-89e3-a2072ba3fea0",
                                                "sense_id": "c668a645-8738-34fd-8d7a-a55a212196aa",
                                                "text": "„Zweck der Interinstitutionellen Vereinbarung nach Artikel 295 des Vertrags über die Arbeitsweise der Europäischen Union (AEUV) ist die Umsetzung der Haushaltsdisziplin, die Verbesserung der Funktionsweise des jährlichen Haushaltsverfahrens und die Verbesserung der Zusammenarbeit zwischen den Organen im Haushaltsbereich sowie die Gewährleistung einer wirtschaftlichen Haushaltsführung.“"
                                            },
                                            {
                                                "example_id": "c0af6e6f-3a1a-47bb-a86e-04a884c02606",
                                                "sense_id": "c668a645-8738-34fd-8d7a-a55a212196aa",
                                                "text": "„Die Interinstitutionelle Vereinbarung wird sicherstellen, dass die Rechtsvorschriften der Union auf die Bereiche fokussiert werden, in denen sie den größten Mehrwert für die europäischen Bürger haben, und dass Rechtsvorschriften einfach und klar sind.“"
                                            },
                                            {
                                                "example_id": "96417087-22f8-407e-96e7-f47b8c82e6c6",
                                                "sense_id": "c668a645-8738-34fd-8d7a-a55a212196aa",
                                                "text": "„Das Heidelberg Research Centre for Molecular Medicine – eine Kooperation der Universität mit dem EMBL – ist ein weiteres Beispiel für erfolgreiche interinstitutionelle Zusammenarbeit am Wissenschaftsstandort.“"
                                            },
                                            {
                                                "example_id": "415fd012-666a-46c2-87f2-0afe05291fef",
                                                "sense_id": "c668a645-8738-34fd-8d7a-a55a212196aa",
                                                "text": "„Die interinstitutionelle Zusammenarbeit (IIZ) soll hier den Zugang zu den optimalen Massnahmen gewährleisten und Drehtüreffekte verhindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
