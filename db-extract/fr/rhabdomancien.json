                ],
                "senses": [
                    {
                        "sense_id": "de54aa25-97c2-3b66-ac14-0a127fb53cee",
                        "entry_id": "073830a5-d5f3-3bbd-9c2f-4836d4ddbc77",
                        "glosses": [
                            "Sourcier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a73a33d-0d2e-4704-8d5a-4dbe42c3fe67",
                                "sense_id": "de54aa25-97c2-3b66-ac14-0a127fb53cee",
                                "text": "C’est à un grand sourcier, un rhabdomancien, comme on les appelait à l’époque que l’on doit la découverte, des nombreuses et abondantes sources qui devaient alimenter Trianon."
                            },
                            {
                                "example_id": "f4126054-79b5-4e5d-b4f3-3c2b0a668031",
                                "sense_id": "de54aa25-97c2-3b66-ac14-0a127fb53cee",
                                "text": "Pourtant, le commissaire compare le plus souvent lʼactivité policière à celle dʼun rhabdomancien qui exercerait son art au Sahara."
                            },
                            {
                                "example_id": "8ba7338e-6abd-447b-a57f-eda386163217",
                                "sense_id": "de54aa25-97c2-3b66-ac14-0a127fb53cee",
                                "text": "Elle ressemblait plus à une robuste paysanne qu’à l’image que Bérénice se faisait d’une rhabdomancienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "490d407d-14df-47fa-b6fc-c8d456c65911",
                        "source_entry_id": "073830a5-d5f3-3bbd-9c2f-4836d4ddbc77",
                        "source_sense_id": "de54aa25-97c2-3b66-ac14-0a127fb53cee",
                        "target_lang_word": "Wünschelrutengänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wünschelrutengänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62416153-7c2e-397d-b87e-42e1c0154b04",
                                        "entry_id": "5a8ac8a8-ee4a-30e6-b4b3-254244f19dab",
                                        "glosses": [
                                            "(männliche^☆) Person (mit besonderer Fähigkeit), der mit einer Wünschelrute umgehen kann und damit geht/sucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c40ccd8-6d87-4aab-a6da-d335bea4a267",
                                                "sense_id": "62416153-7c2e-397d-b87e-42e1c0154b04",
                                                "text": "Der Wünschelrutengänger brauchte nicht lange zu gehen, bis er die Wasserader für den neuen Brunnen gefunden hatte."
                                            },
                                            {
                                                "example_id": "fc7a43fc-0cb6-450c-b97d-0593ddea4017",
                                                "sense_id": "62416153-7c2e-397d-b87e-42e1c0154b04",
                                                "text": "„Der Wünschelrutengänger beantwortet jede Frage gern und mit Ruhe, schließlich brauche er sich nicht vorzubereiten, die Rute sage ihm alles.“"
                                            },
                                            {
                                                "example_id": "e3f60632-71b7-4b64-818b-67925f6423d6",
                                                "sense_id": "62416153-7c2e-397d-b87e-42e1c0154b04",
                                                "text": "„In Verbindung mit den Resultaten früherer Brunnenbohrungen -- die oft als Familienwissen von einer Generation an die nächste weitergegeben werden -- ist es daher nicht erstaunlich, daß Wünschelrutengänger in ihnen vertrauten Gebieten tatsächlich immer wieder gute Bohrlöcher für Brunnen finden.“"
                                            },
                                            {
                                                "example_id": "b4627140-db70-4467-84da-246e473c15c8",
                                                "sense_id": "62416153-7c2e-397d-b87e-42e1c0154b04",
                                                "text": "„Nun könnte man natürlich davon ausgehen, das die Wünschelrutengänger die Wasserader selbst bemerken und die Bewegung der Rute nur ein äußeres Zeichen dieser Wahrnehmung ist.“"
                                            },
                                            {
                                                "example_id": "57a48df7-cb10-4fbb-8329-b9e1bfc79848",
                                                "sense_id": "62416153-7c2e-397d-b87e-42e1c0154b04",
                                                "text": "„Wünschelrutengänger Peter Kirschbaum aus Warburg zum Beispiel hat durch seine Fähigkeiten schon mehrfach gestandene Archäologen verblüfft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45716828-0ba4-43cd-942c-3dd9a5b249f6",
                        "source_entry_id": "073830a5-d5f3-3bbd-9c2f-4836d4ddbc77",
