                "senses": [
                    {
                        "sense_id": "80d7a5c4-0742-3ff8-a6b4-8ee561d9f806",
                        "entry_id": "e1d4bc5c-8e3c-3d36-aba6-3f39a4d69432",
                        "glosses": [
                            "информ. программа или комплекс программ, предназначенные для организации многопрограммного режима работы вычислительной системы"
