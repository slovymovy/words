        "fr-extract.jsonl": [
            {
                "entry_id": "a7576172-f4c7-32c7-b723-06714dd66800",
                "word": "tête-à-queue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "841dd14e-d6c0-3053-9118-51f9d5e04680",
                        "entry_id": "a7576172-f4c7-32c7-b723-06714dd66800",
                        "glosses": [
                            "Mouvement d’un quadrupède qui pivote brusquement sur lui-même et fait demi-tour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50427afe-7341-4dd5-a8a3-29d08041662e",
                                "sense_id": "841dd14e-d6c0-3053-9118-51f9d5e04680",
                                "text": "Un cheval fait un tête à queue, quand, par peur ou pour quitter la direction que lui donne son cavalier, il se retourne brusquement et se trouve, dans ce mouvement, avoir la tête précisément où se trouvait sa queue, quelques secondes auparavant. Le tête à queue est une résistance plutôt qu’une défense […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "506aa7e1-8199-3ea2-9057-4e72e0e5efdc",
                        "entry_id": "a7576172-f4c7-32c7-b723-06714dd66800",
                        "glosses": [
                            "Mouvement d’un véhicule qui, généralement à la suite d’un dérapage, se retrouve orienté en sens contraire de son sens de déplacement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5e30bbd8-78ed-437a-814c-16b725497015",
                                "sense_id": "506aa7e1-8199-3ea2-9057-4e72e0e5efdc",
                                "text": "La piste mouillée a notamment été fatale à l’auteur de la pole Sebastian Vettel, qui réalisait un cavalier seul en tête, mais qui est parti en tête-à-queue tout seul au 26ᵉ tour."
                            },
                            {
                                "example_id": "38f5bc83-9f32-4ec2-b1b4-bab8a12d2491",
                                "sense_id": "506aa7e1-8199-3ea2-9057-4e72e0e5efdc",
                                "text": "En découvrant la forme allongée tapie au milieu de la chaussée, les filles poussèrent un cri. Sauf Nadine, qui freina, amorça un tête-à-queue, contrebraqua, redonna un peu de gomme, puis freina à nouveau en rétrogradant."
                            },
                            {
                                "example_id": "ddcc60c3-ad6d-469e-a220-de4f34f0312d",
                                "sense_id": "506aa7e1-8199-3ea2-9057-4e72e0e5efdc",
                                "text": "Effectuant un tête-à-queue, la Tesla est venu percuter un camion avant de s'immobiliser contre les glissières de sécurité."
                            }
                        ]
                    },
                    {
                        "sense_id": "cee72c8d-2847-3a1a-a1f8-709949947c6c",
                        "entry_id": "a7576172-f4c7-32c7-b723-06714dd66800",
                        "glosses": [
                            "Retournement, complet et soudain, de situation ou de position."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "80665386-7e4f-4f84-9945-81dd5f104e96",
                                "sense_id": "cee72c8d-2847-3a1a-a1f8-709949947c6c",
                                "text": "Voulant éviter d’être désarçonné par un de ces tête-à-queue qu’il excellait à agencer aux temps où, dirigeant lui-même l’extrême gauche, il s’accordait avec la droite pour culbuter cabinet sur cabinet, il essaya de s’attacher à demi les conservateurs."
                            },
                            {
                                "example_id": "c73a8683-778d-4aa6-a63f-a18d27f868b6",
                                "sense_id": "cee72c8d-2847-3a1a-a1f8-709949947c6c",
                                "text": "Depuis un mois, François Fillon et ses avocats changent d’avis comme de chemise à propos de la justice en général, et du parquet national financier (PNF) en particulier. Petite chronologie des tête-à-queue du pilote de course Fillon…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91aabbc9-cae4-4ab6-8332-96a647c3faca",
                        "source_entry_id": "a7576172-f4c7-32c7-b723-06714dd66800",
                        "source_sense_description": "Mouvement d’un quadrupède qui pivote sur lui-même et fait demi-tour",
                        "target_lang_word": "wheel around",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wheel around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16c5d963-41b3-3ce8-8d7e-9b07da36b665",
                                        "entry_id": "a7df683f-fd20-3ed5-8334-a76031d71c6b",
                                        "glosses": [
                                            "To transport someone or something to various locations by pushing a wheeled transporter such as a wheelchair, wheelbarrow or trolley."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642dd0df-c8fa-4271-bd2b-e80b6c99f1d2",
                                                "sense_id": "16c5d963-41b3-3ce8-8d7e-9b07da36b665",
                                                "text": "[…] meals consisted of sandwiches and Victory Coffee wheeled round on trolleys by attendants from the canteen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a816235-0e39-330a-9a8d-2856c2c51507",
                                        "entry_id": "a7df683f-fd20-3ed5-8334-a76031d71c6b",
                                        "glosses": [
                                            "To change direction quickly, turn, pivot, whirl around."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bde9e59-ff54-473f-866c-f3d019011817",
                                                "sense_id": "6a816235-0e39-330a-9a8d-2856c2c51507",
                                                "text": "The pony made a moment’s pause; but, as if it occurred to him that to stop when he was required might be to establish an inconvenient and dangerous precedent, he immediately started off again, rattled at a fast trot to the street corner, wheeled round, came back, and then stopped of his own accord."
                                            },
                                            {
                                                "example_id": "55773b10-f0c6-46aa-870a-2abed044fd1d",
                                                "sense_id": "6a816235-0e39-330a-9a8d-2856c2c51507",
                                                "text": "At the next corner a shrill whistle sounded in Sam’s ear. He wheeled around and saw a black-browed villain scowling at him over peanuts heaped on a steaming machine."
                                            },
                                            {
                                                "example_id": "0288751c-77cf-4471-b499-9c2a0f96232a",
                                                "sense_id": "6a816235-0e39-330a-9a8d-2856c2c51507",
                                                "text": "The tide was out, and we drew up amid the strong bracing smell of seaweed, with gulls screeching, wheeling around, and gliding on the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e38fbd6a-1b0d-3487-8a15-daba1c22e30f",
                                        "entry_id": "a7df683f-fd20-3ed5-8334-a76031d71c6b",
                                        "glosses": [
                                            "To cause to change direction quickly, turn."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5cfbe82-fb29-4f68-8ee9-83196de8dfaa",
                                                "sense_id": "e38fbd6a-1b0d-3487-8a15-daba1c22e30f",
                                                "text": "1834, “Burnes’s Travels into Bokhara” in The Quarterly Review, London: John Murray, Volume 52, August and November, 1834, p. 387,\nThe river of Cabool was crossed on a raft supported on inflated skins […] Its rapidity, formed into eddies, wheeled them round, and they had the agreeable satisfaction of being told that, if carried some way down, there was a whirlpool round which, if once enclosed in its circle, they might revolve, in hunger and giddiness, for a whole day."
                                            },
                                            {
                                                "example_id": "e63b70ea-7dff-42e5-8942-9dae99ed1e18",
                                                "sense_id": "e38fbd6a-1b0d-3487-8a15-daba1c22e30f",
                                                "text": "As soon as the crossing was effected, the general’s face suddenly took on an expression of deliberation and seriousness; he wheeled his horse around, and at full gallop rode across the wide forest-surrounded field which spread before us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6520252b-5b6a-3746-8ace-a5ab34b78f0f",
                                        "entry_id": "a7df683f-fd20-3ed5-8334-a76031d71c6b",
                                        "glosses": [
                                            "In dancing, when a couple, holding hands, turns around 180 degrees, with the left hand dancer moving backward and the right hand dancer moving forward."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "318ae01a-ffe0-45e5-9b00-ae50ce3179b9",
                                                "sense_id": "6520252b-5b6a-3746-8ace-a5ab34b78f0f",
                                                "text": "1950, Lee Owens and Viola Ruth, Advanced Square Dance Figures of the West and Southwest, Palo Alto, CA: Pacific Books, “The Do-Si-Do Shuffle,” p. 108,\nWhen in Opposites’ positions, the two Head Couples dance a Right and Left Through to their home place where they wheel around to face the center."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
