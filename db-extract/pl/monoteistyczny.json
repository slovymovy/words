                                "target_senses": [
                                    {
                                        "sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
                                        "entry_id": "6b7316c5-dd49-3ce7-97c8-9eca7ec712df",
                                        "glosses": [
                                            "Relatif au monothéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b334d3f-d6d9-4211-895a-167817e79cc2",
                                                "sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
                                                "text": "Affichant non sans panache un athéisme militant, il appelle à en finir avec une certaine tolérance envers les religions monothéistes, intrinsèquement intolérantes et pétries de haine."
                                            },
                                            {
                                                "example_id": "e7dad415-3648-43c0-8dc8-a9781b9cfdda",
                                                "sense_id": "0b198308-90a7-3968-b41b-1ea756e1f459",
                                                "text": "Paradoxe du discours monothéiste : il proclame le dieu unique et exacerbe (le mot est faible) depuis trois mille ans les différences."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monothéiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51adb6de-b2c6-39b7-9f03-ff2f4b9ffa71",
                                        "entry_id": "03efed7d-7827-3732-89d1-d02d58db0f95",
                                        "glosses": [
                                            "Celui qui adore un seul Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236875ee-eedd-4d03-8599-03a17d8a18a1",
                                                "sense_id": "51adb6de-b2c6-39b7-9f03-ff2f4b9ffa71",
                                                "text": "Les apôtres n'avaient pas besoin de prêcher l'unité de Dieu aux Juifs, qui étaient de fervents monothéistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97253b11-8b9b-4647-b655-b2cd720720e8",
