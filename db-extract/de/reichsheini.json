                "senses": [
                    {
                        "sense_id": "2e3db265-1b28-3241-8140-ddceb5eb597b",
                        "entry_id": "d890573e-a29f-383d-8af0-c775bc429247",
                        "glosses": [
                            "Reichsführer SS Heinrich Himmler"
                        ],
                        "tags": [
                            "spöttisch"
                        ],
                        "examples": [
                            {
                                "example_id": "80076091-f5ed-44e9-943d-936dcba42af4",
                                "sense_id": "2e3db265-1b28-3241-8140-ddceb5eb597b",
                                "text": "„Hart setzte der leibliche Schwager des »Reichsheinis« sein Kognakglas auf den Tisch.“"
                            },
                            {
                                "example_id": "027132e2-cbad-4698-80c4-5acb7c9afa2e",
                                "sense_id": "2e3db265-1b28-3241-8140-ddceb5eb597b",
                                "text": "„«Der Radiot sieht aus wie unser‹ Reichsheini›! »“"
                            },
                            {
                                "example_id": "f4c8a25c-b893-49da-81f7-0922985397ea",
                                "sense_id": "2e3db265-1b28-3241-8140-ddceb5eb597b",
                                "text": "„Sie war schlau genug zu begreifen, daß sie in der Schule und in der Kükengruppe nicht von London erzählen noch die spaßigen Namen Reichsheini und Marschall Meier wiederholen durfte, die Dr. Peterson gebrauchte, worauf Frau Linkerhand den Finger an die Lippen legte und ihm beschwörende Blicke zuwarf - Onkel Peterson, der Franziskas dürren Brustkorb beklopfte und Geschichten von seinem Nachbarn erzählte, etwa: Denk dir, Fränzchen, mein Nachbar hat jetzt einen Hund, der hat ein riesengroßes Maul und heißt Nazi…“"
                            },
                            {
                                "example_id": "010265b9-5c43-44a9-ac17-ffd85e2a60d9",
                                "sense_id": "2e3db265-1b28-3241-8140-ddceb5eb597b",
                                "text": "„‚Reichsheini‘, so nannte man Heinrich Himmler im Dritten Reich - in Anlehnung an seine offizielle Dienstbezeichnung Reichsführer SS.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
