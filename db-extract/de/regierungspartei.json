                    }
                ],
                "senses": [
                    {
                        "sense_id": "c28a815e-149c-3958-8354-ff9cb4f8178c",
                        "entry_id": "d2be444f-6f84-34a9-babd-26b24f36c706",
                        "glosses": [
                            "Partei, die die Regierung bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7a6477-0526-4ced-ad50-eff039b0b722",
                                "sense_id": "c28a815e-149c-3958-8354-ff9cb4f8178c",
                                "text": "Wie erwartet liegt die Regierungspartei ANC nach den ersten Hochrechnungen deutlich in Führung."
                            },
                            {
                                "example_id": "6a1f4a47-5150-4342-a61e-2e8fbc61ab84",
                                "sense_id": "c28a815e-149c-3958-8354-ff9cb4f8178c",
                                "text": "Im Senat verlor die Regierungspartei nach Auszählung von drei Vierteln der Stimmen vier Sitze."
                            },
                            {
                                "example_id": "2b84b976-f32e-4a1d-b7e8-fd72ca019dd2",
                                "sense_id": "c28a815e-149c-3958-8354-ff9cb4f8178c",
                                "text": "„›Was liegt, das pickt‹, sagt ÖVP-Generalsekretär Gernot Blümel zum Koalitionspakt – und daran müssten sich jetzt beide Regierungsparteien halten.“"
                            },
                            {
                                "example_id": "a3321a83-f7cd-4b09-8d74-2d4ed3bed8ff",
                                "sense_id": "c28a815e-149c-3958-8354-ff9cb4f8178c",
                                "text": "„Die sprichwörtliche Feindschaft zwischen PPP und PML von 1988 bis 1999 verdeutlicht die überaus negative Einstellung der jeweiligen Regierungspartei gegenüber der Opposition.“"
                            },
                            {
                                "example_id": "3a5dfe82-ff91-48d4-a737-849cf23b8a07",
                                "sense_id": "c28a815e-149c-3958-8354-ff9cb4f8178c",
                                "text": "„Unter seiner tatkräftigen Führung wurde auch die Regierungspartei reich, die 1992 umgerechnet etwa 75 Millionen US-Dollar besaß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
