                {
                    "sense_id": "ddb373c9-2e20-38d1-bdf4-30191586e5a9",
                    "sense_definition": "To use magical or supernatural methods to predict the future or see distant events, often using a crystal ball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic_vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fortune teller claimed she could <w>scry</w> into the future using her crystal ball."
                        },
                        {
                            "text": "Many legends tell of powerful wizards who <w>scry</w> to discover the secrets of their enemies."
                        }
                    ],
                    "synonyms": [
                        "divine",
                        "foresee"
                    ],
                    "common_phrases": [
