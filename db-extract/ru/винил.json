                                                "sense_id": "863dc7cb-b8c2-3101-9ab3-fc83b8d1bc52",
                                                "text": "Un disque vinyle."
                                            },
                                            {
                                                "example_id": "a52784fd-e4e7-4170-bdfa-e760d49e43b2",
                                                "sense_id": "863dc7cb-b8c2-3101-9ab3-fc83b8d1bc52",
                                                "text": "Une imprimante vinyle destinée aux peintres en lettres et aux sérigraphes."
