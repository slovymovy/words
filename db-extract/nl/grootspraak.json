                        "source_sense_id": "c21e5fa4-789c-3b68-8587-bc9818894c38",
                        "target_lang_word": "Großtuerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großtuerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b5a8044-2e84-3b8c-b73d-b9a118e8d33a",
                                        "entry_id": "94b45bf9-4fa3-3fb1-8a5b-86c4a76bbb63",
                                        "glosses": [
                                            "Verhalten, das durch übertriebene Hervorhebung der eigenen Stärken, Verdienste gekennzeichnet ist"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c53ebb-1e74-4d87-914d-0bcf30c96e11",
                                                "sense_id": "5b5a8044-2e84-3b8c-b73d-b9a118e8d33a",
                                                "text": "„Kritiker brauchen immer etwas, was sie kritisieren können; und der Unterschied zwischen gutem Geschmack (dem eigenen) und vulgärer Großtuerei (der anderen) ist zwangsläufig subjektiv.“"
                                            },
                                            {
                                                "example_id": "a434fb29-53a9-4244-9e68-177c4a56d1ef",
                                                "sense_id": "5b5a8044-2e84-3b8c-b73d-b9a118e8d33a",
                                                "text": "„Bei allem Diensteifer und bei aller Großtuerei mit seiner Geschäftskenntnis konnte er es doch nicht dahin bringen, seine Stellung sicher zu befestigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11ccfda2-f7c0-3346-812d-c713557a5ad9",
                                        "entry_id": "94b45bf9-4fa3-3fb1-8a5b-86c4a76bbb63",
                                        "glosses": [
                                            "angeberisches Tun oder Gerede"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b4a20c-8237-4a35-8c6c-284f6d639d2c",
                                                "sense_id": "11ccfda2-f7c0-3346-812d-c713557a5ad9",
                                                "text": "„Ein anderes Mal beschwert sie sich darüber, sie hätte Stephanies charakteristische Eigenlobreden und Großtuereien mit gläubiger Miene anhören müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
