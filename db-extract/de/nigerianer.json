                ],
                "senses": [
                    {
                        "sense_id": "1ff27b4f-5b1e-3a61-94f5-92b588e4fc22",
                        "entry_id": "8b95c328-2427-3dfb-9e9c-d9a3dd046f78",
                        "glosses": [
                            "Staatsbürger von Nigeria"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d627fb-271f-49eb-a408-f73943be66b2",
                                "sense_id": "1ff27b4f-5b1e-3a61-94f5-92b588e4fc22",
                                "text": "Diese beiden Nigerianer sind die Bauern, von denen wir Waren für unser Geschäft in Berlin beziehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b152176-59de-4ed6-a6f1-39ea3a9ab112",
                        "source_entry_id": "8b95c328-2427-3dfb-9e9c-d9a3dd046f78",
                        "source_sense_id": "1ff27b4f-5b1e-3a61-94f5-92b588e4fc22",
                        "source_sense_description": "Staatsbürger von Nigeria",
                        "target_lang_word": "Nigerian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nigerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb1cc710-db5e-34b0-9583-05769c76fc91",
                                        "entry_id": "f4a921ab-d672-3c1b-9f02-7542e498c914",
                                        "glosses": [
                                            "A person from Nigeria or of Nigerian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f09db15d-38cd-44b2-aa55-8f682768a206",
                                                "sense_id": "fb1cc710-db5e-34b0-9583-05769c76fc91",
                                                "text": "For the same reasons that many Nigerians troop to churches in recent times, many also seek spiritual intervention through African traditional religions."
                                            },
                                            {
                                                "example_id": "4e2dd519-5e83-4e9e-8369-7d8416e9bc2a",
                                                "sense_id": "fb1cc710-db5e-34b0-9583-05769c76fc91",
                                                "text": "'No meat!' The Nigerian, who grew up knowing that ponmo or cowskin was popular on the menu list back home, heard the Chadians carry on, and pretending there was nothing scary about the promotion of ponmo as a national delicacy, replied suavely, 'Meat certainly is not all a man lives for, or is it, gentlemen?'"
                                            },
                                            {
                                                "example_id": "505cc214-e161-4e5c-9f80-7415f19d8857",
                                                "sense_id": "fb1cc710-db5e-34b0-9583-05769c76fc91",
                                                "text": "He added that Nigerians were also pained watching their leaders live in luxury while they struggled to make ends meet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Nigerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb3efa7-d3c1-35e7-8894-ff3aec83e6ea",
                                        "entry_id": "58220f9d-a436-3ecf-b48a-810816a250fd",
                                        "glosses": [
                                            "Of, from, or pertaining to Nigeria, the Nigerian people or culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada5a73e-00c5-4c98-a88f-669ce0b52b23",
                                                "sense_id": "bdb3efa7-d3c1-35e7-8894-ff3aec83e6ea",
                                                "text": "There was some languidness latent in the Nigerian atmosphere that made her forget the meaning of time passing."
                                            },
                                            {
                                                "example_id": "daa44107-6433-497a-aad8-8a1d48ab19d4",
                                                "sense_id": "bdb3efa7-d3c1-35e7-8894-ff3aec83e6ea",
                                                "text": "One protester in the Nigerian capital told the national Channels Television that he was forced to join the Thursday protests due to hunger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7c443c5-9e4b-48d8-a73e-71105f30c0d5",
                        "source_entry_id": "8b95c328-2427-3dfb-9e9c-d9a3dd046f78",
                        "source_sense_id": "1ff27b4f-5b1e-3a61-94f5-92b588e4fc22",
                        "source_sense_description": "Staatsbürger von Nigeria",
                        "target_lang_word": "Nigérien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nigérien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76ca06e6-a2e7-3030-9e0f-a80fba7642ab",
                                        "entry_id": "cd3ffc6e-d704-35b6-8004-3e88997071a4",
                                        "glosses": [
                                            "Habitant du Niger ^([1]) ^([2])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9773dbf0-4afe-4e37-a582-bd5cc4dcefe7",
                                                "sense_id": "76ca06e6-a2e7-3030-9e0f-a80fba7642ab",
                                                "text": "[…], enfin Moussa, jeune Nigérien, bavard et sympathique. Il fera ma cuisine et me servira d’interprète dans ce pays où l'on parle le haoussa principalement et d'autres dialectes, mais non l’arabe, à part quelques chefs et quelques marabouts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2be89c0-c50f-42b7-a1a4-8430d1d62fb4",
