                                "target_senses": [
                                    {
                                        "sense_id": "84088a7c-67ca-3a92-adb7-357eb856c010",
                                        "entry_id": "517fb962-4196-31e9-b037-abf8e27ef462",
                                        "glosses": [
                                            "филол. стихотворный размер, упорядоченное чередование ударных и безударных слогов в стихе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab6c2cb1-ed3b-4e87-85e3-8185c7309ae5",
                                                "sense_id": "84088a7c-67ca-3a92-adb7-357eb856c010",
                                                "text": "Верлибр имеет свои преимущества: не заставляя отвлекаться на рифму, не гипнотизируя ритмами и метрами, он позволяет погрузиться непосредственно в образную ткань стихотворения."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "метр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c68c7856-5e26-30f0-8a90-339516b334c5",
