                        "examples": [
                            {
                                "example_id": "726e317d-1091-48a9-8023-e45fda48af26",
                                "sense_id": "7a46f2b2-8055-3477-b009-6a80b66785e0",
                                "text": "Я отковырял несколько кусочков синей глины и попробовал потереть ею мокрые руки."
                            },
                            {
                                "example_id": "db920fab-7fd9-4de7-aa99-6ec16e4e3341",
                                "sense_id": "7a46f2b2-8055-3477-b009-6a80b66785e0",
                                "text": "Он ногтем отковырял от доски несколько старых кнопок, стал вешать расписание."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9b982ce-c72d-3aac-953f-a70ac9b712e5",
