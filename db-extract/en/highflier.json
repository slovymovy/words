                "senses": [
                    {
                        "sense_id": "aceb79e3-6990-345f-b109-b468f1b3c4a5",
                        "entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "glosses": [
                            "A person who or a type of aircraft that flies at high elevations."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6a3b27b-39c5-3b42-901a-d3c33cd16e6c",
                        "entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "glosses": [
                            "An ambitious person, especially one who takes risks or has an extravagant lifestyle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "682779bf-e997-4878-8756-4d3db4fb7331",
                                "sense_id": "b6a3b27b-39c5-3b42-901a-d3c33cd16e6c",
                                "text": "under the appellations of Tory, Jacobite, highflier, and other cant words"
                            },
                            {
                                "example_id": "7924793b-e6d1-4498-827c-49bd385ca332",
                                "sense_id": "b6a3b27b-39c5-3b42-901a-d3c33cd16e6c",
                                "text": "A beautiful woman juggled expensive shopping bags while taking a call; friends gathered clinking glasses in celebration; a young man coyly slurped noodles; a gaggle of suited highfliers shook hands over a boardroom with views across the city. Everything screamed: “We are no longer in recession! We are a beating heart of London’s future!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "af6ca52e-00b2-3f23-ad42-53395fc72fb5",
                        "entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "glosses": [
                            "A vertical pole used in commercial fishing to locate the beginning and end of a long fishing line."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b93d79f-77eb-3c0b-8f01-f278d1684033",
                        "entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "glosses": [
                            "A glamorous stock that potentially offers high returns to investors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e38e6dbc-ab28-46c8-b4da-33371ed4e59a",
                                "sense_id": "2b93d79f-77eb-3c0b-8f01-f278d1684033",
                                "text": "Virtually all highfliers that I have seen over all these years of trading have crumbled at some point."
                            },
                            {
                                "example_id": "a558899b-c436-4bf6-b870-534a4f2c5eb8",
                                "sense_id": "2b93d79f-77eb-3c0b-8f01-f278d1684033",
                                "text": "I like Canadian stocks and have done quite well investing in them, but you are typically better off buying a stock on the Toronto Stock Exchange, Canada's leading exchange, than some of the highfliers in Vancouver."
                            }
                        ]
                    },
                    {
                        "sense_id": "58a12c23-d1ae-3fe3-84b6-5c732e9db491",
                        "entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "glosses": [
                            "A swingboat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88e2eeeb-9de0-47e0-9b38-de5e700ed266",
                                "sense_id": "58a12c23-d1ae-3fe3-84b6-5c732e9db491",
                                "text": "[…] and high-flyer boat-swings, full of half-drunken men and half-mad, screaming girls, swing up to perilous heights, and all but whirl over, as if to shoot out the whole of their frantic cargoes!"
                            },
                            {
                                "example_id": "34c07ebf-d29e-4475-940c-af80b0e44589",
                                "sense_id": "58a12c23-d1ae-3fe3-84b6-5c732e9db491",
                                "text": "A small copper-plate representation of Frost Fair […] Among the activities shown are Letterpress Printing, Copperplate Printing, a Sheep to be roasted, Ballad Singers, Swinging (in boat-shaped swings called the 'high Flyer'), playing at Skittles, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "298bee2d-e62f-335f-9c61-032f467bcdd7",
                        "entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "glosses": [
                            "A writer of begging letters."
                        ],
                        "tags": [
                            "UK",
                            "obsolete",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c48a92f5-dd73-3172-9a0c-4f1c7838a031",
                        "entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "glosses": [
                            "A type of phaeton carriage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7562549d-3f3f-4fb5-9947-51c83e1a2df8",
                                "sense_id": "c48a92f5-dd73-3172-9a0c-4f1c7838a031",
                                "text": "The emotions of those who journeyed for the first time on a railway at a speed four times as great as that of the swiftest High-flier that ever devoured the road are forgotten by this generation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9230268c-6f0a-4e7c-af70-379b44153b07",
                        "source_entry_id": "87c2bb6b-2839-33dd-bfc5-3bf0daaff42b",
                        "source_sense_description": "figurative: an ambitious person",
                        "target_lang_word": "Überflieger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überflieger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c99c3117-6424-3261-a61d-4e4a3e9072d4",
                                        "entry_id": "4d4cee49-661e-3843-b6a4-f67cc3009b9a",
                                        "glosses": [
                                            "Person, die anderen mit ihren geistigen oder körperlichen Fähigkeiten weit überlegen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2176ab-75dc-4990-9642-50ca84bb77fa",
                                                "sense_id": "c99c3117-6424-3261-a61d-4e4a3e9072d4",
                                                "text": "„In diesem Jahr wäre der Überflieger 100 Jahre alt geworden.“"
                                            },
                                            {
                                                "example_id": "a89e768a-6575-4795-9e16-a4d688d2f847",
                                                "sense_id": "c99c3117-6424-3261-a61d-4e4a3e9072d4",
                                                "text": "„Im Jahr 2005 war Noam Chomsky der Überflieger.“"
                                            },
                                            {
                                                "example_id": "b4e41fcb-0749-4f9d-b5ef-f3098d1a9782",
                                                "sense_id": "c99c3117-6424-3261-a61d-4e4a3e9072d4",
                                                "text": "Von den 30.000 New Yorker Achtklässlern, welche die dreistündige Aufnahmeprüfung absolvieren, werden nur die 5.000 aufgenommen, die am besten abschneiden. Über die Hälfte der Überflieger stammen aus asiatischen Elternhäusern."
                                            },
                                            {
                                                "example_id": "86ed614b-6bb3-4847-9ff5-853c5c8cd8b3",
                                                "sense_id": "c99c3117-6424-3261-a61d-4e4a3e9072d4",
                                                "text": "„Wenn der Lehrer im Unterricht sich um die ein, zwei Überflieger, um die Leistungsstarken kümmert, muss er dann nicht die anderen zwangsläufig vernachlässigen und verliert vielleicht die Schwachen aus dem Blick?“"
                                            },
                                            {
                                                "example_id": "ee82a03f-61e4-4d3b-b6ea-e22f009f007d",
                                                "sense_id": "c99c3117-6424-3261-a61d-4e4a3e9072d4",
                                                "text": "[Eisschnelllaufen:] Ted-Jan Bloemen ist ja im Moment der Überflieger. Er hat den Weltrekord über 10.000 Meter und 5.000 Meter mit seinem Namen verziert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e99cceb-08d5-339a-b429-ad363221d41f",
                                        "entry_id": "4d4cee49-661e-3843-b6a4-f67cc3009b9a",
                                        "glosses": [
                                            "spezielle Verbindungsrampe bei Autobahnkreuzen, die beide Autobahnen überquert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e93a5fa-50d8-443b-b81b-3ced298d6256",
                                                "sense_id": "3e99cceb-08d5-339a-b429-ad363221d41f",
                                                "text": "„Während der 32-monatigen Bauarbeiten waren das alte Kreuzungsbauwerk abgerissen, im Dreiecksbereich drei so genannte Überflieger errichtet sowie 5,7 Kilometer Strecke auf der A 10 und 2 Kilometer Strecke auf der A 115 ausgebaut worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29975233-4026-4df1-aa87-85415644cebe",
