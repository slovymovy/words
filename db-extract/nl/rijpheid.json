                "senses": [
                    {
                        "sense_id": "af8d6139-00c2-3c54-a014-c225ecde57d6",
                        "entry_id": "f133236c-353f-35a3-aa76-0a8dda6fa00e",
                        "glosses": [
                            "van vruchten: de mate van optimale ontwikkeling voordat de rotting begint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05405327-7e23-4549-9d0e-c0cd8f897830",
                                "sense_id": "af8d6139-00c2-3c54-a014-c225ecde57d6",
                                "text": "De rijpheid van appelen kun je zien aan de kleur van de schil."
                            },
                            {
                                "example_id": "4034f08b-c97b-4d9d-9a2e-53428d9dc50f",
                                "sense_id": "af8d6139-00c2-3c54-a014-c225ecde57d6",
                                "text": "Check het suikergehalte en de rijpheid van de appels met de laser-robot, gebruik alleen de rijpste exemplaren."
                            }
                        ]
                    },
                    {
                        "sense_id": "58677cc4-da8d-3191-9eb7-963370a45bf3",
                        "entry_id": "f133236c-353f-35a3-aa76-0a8dda6fa00e",
                        "glosses": [
                            "van mensen en dieren: de mate waarin het organisme tot volledige (volwassen) ontwikkeling is gekomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f73c135-317f-4b03-932d-789d0da1f416",
                                "sense_id": "58677cc4-da8d-3191-9eb7-963370a45bf3",
                                "text": "Deze jonge knaap heeft de rijpheid van de volwassen man nog lang niet bereikt."
                            },
                            {
                                "example_id": "6c26eaaf-685f-40ce-8d93-49d1f0e93956",
                                "sense_id": "58677cc4-da8d-3191-9eb7-963370a45bf3",
                                "text": "En Pitt? Hem ging het best goed: als acteur en als producer van – onder meer – 12 Years a Slave en Selma. Maar er sloop iets vreugdeloos in zijn optreden. Toen hij in 2011 in Cannes de promotie van arthousefilm The Tree of Life deed, straalde hij met zijn baard en hoedje net iets te ijverig nieuwe rijpheid uit. Vaderschap had hem veranderd, zei Pitt: als lid van team Brangelina reisde hij tegenwoordig met een stoet assistenten, privédocenten en kindermeisjes over de wereld, liefst ’s nachts om de paparazzi te ontlopen: zijn zes kinderen waren experts in het in- en uitpakken. Hij zocht nu andere rollen. Geen sexy of leeghoofdige rebellen, maar mannen met waardigheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "3063efc0-f056-3b43-8b61-c7b4846758f0",
                        "entry_id": "f133236c-353f-35a3-aa76-0a8dda6fa00e",
                        "glosses": [
                            "van gedachten: dat ze zijn ontstaan door overdenken, overleggen, overwegen, beraadslagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3388b78-0f2a-4c23-bb76-5f92d9cd79da",
                                "sense_id": "3063efc0-f056-3b43-8b61-c7b4846758f0",
                                "text": "Zijn plannen hebben na vele jaren van denken eindelijk een stadium van rijpheid bereikt dat ze geschikt maakt om uitgevoerd te worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f8685e4-ba99-3383-a498-b4a64070842a",
                        "entry_id": "f133236c-353f-35a3-aa76-0a8dda6fa00e",
                        "glosses": [
                            "het product van verhardingstijd en betontemperatuur bij het verharden van beton"
                        ],
                        "tags": [],
                        "examples": []
                    }
