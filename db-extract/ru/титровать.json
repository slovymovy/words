                "senses": [
                    {
                        "sense_id": "83ba9938-c46d-38ad-9a93-2b9a5b4159f7",
                        "entry_id": "69c11083-c241-34be-8bf8-216f665740b6",
                        "glosses": [
                            "хим. определять титр какого-либо раствора путём сравнения его реакций с реакциями раствора, концентрация которого известна"
                        ],
                        "tags": [],
