{
    "word_family": [
        "sustainable",
        "sustainability",
        "sustenance",
        "sustainer",
        "sustained"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5bf071d5-52b2-3882-9cfe-5bac005b9692",
                    "sense_definition": "To maintain or keep something in existence over a period of time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "maintenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor had trouble <w>sustaining</w> students' interest until the end of her long lectures.",
                            "target_lang_translations": {
                                "ru": "Профессору было трудно <w>поддерживать</w> интерес студентов до конца своих длинных лекций."
                            }
                        },
                        {
                            "text": "It is difficult to <w>sustain</w> growth in such a competitive and volatile market.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>сохранять</w> рост на таком конкурентном и нестабильном рынке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sustain interest",
                        "sustain growth",
                        "sustain momentum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать или сохранять что-либо в течение определенного периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "сохранять состояние или уровень"
                            },
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "не давать прекратиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "171f69ca-10fe-37d9-8b92-eab44ac52ec9",
                    "sense_definition": "To experience or suffer something unpleasant, such as an injury or damage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic building <w>sustained</w> major damage during the powerful earthquake last night.",
                            "target_lang_translations": {
                                "ru": "Историческое здание <w>получило</w> серьезные повреждения во время сильного землетрясения прошлой ночью."
                            }
                        },
                        {
                            "text": "The athlete had to <w>sustain</w> an injury to his knee before retiring from the race.",
                            "target_lang_translations": {
                                "ru": "Атлету пришлось <w>перенести</w> травму колена, прежде чем он сошел с дистанции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sustain an injury",
                        "sustain damage",
                        "sustain losses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать или переносить что-то неприятное, например, травму или ущерб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получить",
                                "target_lang_sense_clarification": "о травме или повреждении"
                            },
                            {
                                "target_lang_word": "понести",
                                "target_lang_sense_clarification": "об убытках или потерях"
                            },
                            {
                                "target_lang_word": "претерпеть",
                                "target_lang_sense_clarification": "подвергнуться изменениям или разрушениям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c303ef-ccd5-3aed-8d54-690566820884",
                    "sense_definition": "To provide the necessities of life, such as food and water, to keep someone or something alive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nourishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small village was <w>sustained</w> by a single well during the long summer drought.",
                            "target_lang_translations": {
                                "ru": "Маленькую деревню <w>поддерживал</w> единственный колодец во время долгой летней засухи."
                            }
                        },
                        {
                            "text": "They carried enough provisions to <w>sustain</w> life while crossing the vast desert.",
                            "target_lang_translations": {
                                "ru": "Они несли достаточно припасов, чтобы <w>поддерживать</w> жизнь при переходе через огромную пустыню."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sustain life",
                        "sustain an army"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать жизненно важные потребности (еда, вода), чтобы поддерживать жизнь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "давать силы для жизни"
                            },
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "снабжать необходимым"
                            },
                            {
                                "target_lang_word": "прокормить",
                                "target_lang_sense_clarification": "обеспечить пищей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b396593-50de-3228-b227-8ab077051b2b",
                    "sense_definition": "To allow or accept something, such as a legal objection, as valid or justified.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>sustain</w> the objection raised by the defense attorney.",
                            "target_lang_translations": {
                                "ru": "Судья решил <w>удовлетворить</w> возражение, выдвинутое адвокатом защиты."
                            }
                        },
                        {
                            "text": "If the court chooses to <w>sustain</w> the motion, the trial will be delayed.",
                            "target_lang_translations": {
                                "ru": "Если суд решит <w>поддержать</w> ходатайство, процесс будет отложен."
                            }
                        }
                    ],
                    "antonyms": [
                        "overrule"
                    ],
                    "common_phrases": [
                        "objection sustained"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать или принимать что-либо (например, юридическое возражение) как обоснованное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворить",
                                "target_lang_sense_clarification": "принять протест или ходатайство"
                            },
                            {
                                "target_lang_word": "поддержать",
                                "target_lang_sense_clarification": "согласиться с возражением в суде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50bf27f0-e287-36fe-beca-f9485960f196",
                    "sense_definition": "To support the weight of something or keep it from falling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden beams were no longer strong enough to <w>sustain</w> the weight of the roof.",
                            "target_lang_translations": {
                                "ru": "Старые деревянные балки были уже недостаточно прочными, чтобы <w>выдерживать</w> вес крыши."
                            }
                        },
                        {
                            "text": "A solid concrete foundation <w>sustains</w> the entire weight of the skyscraper.",
                            "target_lang_translations": {
                                "ru": "Прочный бетонный фундамент <w>несет</w> на себе весь вес небоскреба."
                            }
                        }
                    ],
                    "synonyms": [
                        "hold"
                    ],
                    "common_phrases": [
                        "sustain a load",
                        "sustain the weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдерживать вес чего-либо или удерживать от падения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдерживать",
                                "target_lang_sense_clarification": "справляться с нагрузкой"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "служить опорой"
                            },
                            {
                                "target_lang_word": "нести",
                                "target_lang_sense_clarification": "о нагрузке или весе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de23016b-ace3-3be5-9da2-39e0e531e7b9",
                    "sense_definition": "The ability of a musical instrument to continue a sound, or the mechanism that allows this.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist used a special pedal to increase the <w>sustain</w> of the long notes.",
                            "target_lang_translations": {
                                "ru": "Гитарист использовал специальную педаль, чтобы увеличить <w>сустейн</w> длинных нот."
                            }
                        },
                        {
                            "text": "The piano has a rich <w>sustain</w> that allows the chords to ring out beautifully.",
                            "target_lang_translations": {
                                "ru": "У пианино богатый <w>сустейн</w>, который позволяет аккордам звучать очень красиво."
                            }
                        }
                    ],
                    "common_phrases": [
                        "natural sustain",
                        "sustain pedal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность музыкального инструмента продолжать звучание ноты или механизм, обеспечивающий это."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сустейн",
                                "target_lang_sense_clarification": "длительность звучания ноты"
                            },
                            {
                                "target_lang_word": "длительность",
                                "target_lang_sense_clarification": "продолжительность звука"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}