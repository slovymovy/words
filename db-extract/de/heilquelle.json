                        "entry_id": "d2353681-9419-3fb2-a0b3-bb1a6eb2220a",
                        "glosses": [
                            "Quelle, die medizinisch wirksames Wasser ausschüttet"
                        ],
                        "tags": [
                            "Hydrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e13262fe-6dd4-46c9-8548-ed88d6d6d965",
                                "sense_id": "b1c7da2a-a9e8-36a7-8c60-bdd74bfcb284",
                                "text": "„Das warme, salzhaltige Meerwasser hat bei ihr die Wirkung einer Heilquelle.“"
                            },
                            {
                                "example_id": "027e8c17-6d5d-48f2-abbb-0327186add10",
                                "sense_id": "b1c7da2a-a9e8-36a7-8c60-bdd74bfcb284",
                                "text": "„Dort fand ich eine reizende Straßburgerin namens Salzmann und drei oder vier Spieler, die angeblich wegen der Heilquellen gekommen waren und mir weibliche Gesellschaft verhießen, die der Leser im folgenden Kapitel kennenlernen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
