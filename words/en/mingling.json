                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mingling</w> of different cultures created a unique local tradition.",
                            "target_lang_translations": {
                                "fr": "Le <w>brassage</w> de différentes cultures a créé une tradition locale unique."
                            }
                        },
                        {
                            "text": "There was a strange <w>mingling</w> of emotions in her voice.",
                            "target_lang_translations": {
