{
    "word_family": [
        "exposition",
        "expositor",
        "expository",
        "expounder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a15a586a-acb2-3ade-91b7-dace5426908c",
                    "sense_definition": "To explain, interpret, or set out the meaning of something in detail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explain_at_length",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor will <w>expound</w> the complex theory during his lecture tomorrow.",
                            "target_lang_translations": {
                                "ru": "Профессор подробно <w>изложит</w> сложную теорию во время своей завтрашней лекции."
                            }
                        },
                        {
                            "text": "She was asked to <w>expound</w> her views on the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Ее попросили <w>разъяснить</w> свои взгляды на экономический кризис."
                            }
                        }
                    ],
                    "synonyms": [
                        "spell out"
                    ],
                    "common_phrases": [
                        "expound a theory",
                        "expound views"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробно объяснять, толковать или излагать значение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "последовательно выражать мысли или теорию"
                            },
                            {
                                "target_lang_word": "разъяснять",
                                "target_lang_sense_clarification": "делать понятным, подробно объяснять"
                            },
                            {
                                "target_lang_word": "изложить",
                                "target_lang_sense_clarification": "завершить подробное объяснение"
                            },
                            {
                                "target_lang_word": "разъяснить",
                                "target_lang_sense_clarification": "сделать ясным, растолковать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24b05a18-2b97-3892-a226-1c45a3dea7d5",
                    "sense_definition": "To make a statement or speak at length about a particular subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explain_at_length",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would often <w>expound</w> on the dangers of political corruption.",
                            "target_lang_translations": {
                                "ru": "Он часто подолгу <w>рассуждал</w> о опасностях политической коррупции."
                            }
                        },
                        {
                            "text": "The guest speaker began to <w>expound</w> on his latest research findings.",
                            "target_lang_translations": {
                                "ru": "Приглашенный спикер начал подробно <w>излагать</w> результаты своих последних исследований."
                            }
                        }
                    ],
                    "common_phrases": [
                        "expound on the subject",
                        "expound at length"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать заявление или подробно и пространно высказываться по какому-либо вопросу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пространно рассуждать",
                                "target_lang_sense_clarification": "подробно высказываться на тему"
                            },
                            {
                                "target_lang_word": "излагать свои мысли",
                                "target_lang_sense_clarification": "подробно делиться мнением"
                            },
                            {
                                "target_lang_word": "разъяснять",
                                "target_lang_sense_clarification": "подробно объяснять свою позицию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}