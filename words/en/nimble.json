{
    "word_family": [
        "nimbleness",
        "nimbly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2489507-92bc-3935-90e0-387a83ccbd4e",
                    "sense_definition": "Quick and light in movement or action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_agility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete was so <w>nimble</w> that he easily escaped the grasp of the defenders.",
                            "target_lang_translations": {
                                "ru": "Молодой атлет был настолько <w>проворным</w>, что легко ускользнул от защитников."
                            }
                        },
                        {
                            "text": "She showed <w>nimble</w> footwork while dancing across the stage during the final performance.",
                            "target_lang_translations": {
                                "ru": "Она продемонстрировала <w>ловкую</w> работу ног, танцуя на сцене во время финального выступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "agile",
                        "sprightly",
                        "lithe"
                    ],
                    "antonyms": [
                        "sluggish"
                    ],
                    "common_phrases": [
                        "nimble footwork",
                        "nimble movements"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый и легкий в движениях или действиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проворный",
                                "target_lang_sense_clarification": "быстрый и легкий"
                            },
                            {
                                "target_lang_word": "ловкий",
                                "target_lang_sense_clarification": "умелый в движениях"
                            },
                            {
                                "target_lang_word": "юркий",
                                "target_lang_sense_clarification": "быстрый и увертливый"
                            },
                            {
                                "target_lang_word": "шустрый",
                                "target_lang_sense_clarification": "подвижный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76aa094d-25cf-364a-814d-a7dac62751dc",
                    "sense_definition": "Adept and skillful at taking, grasping, or manipulating objects with the hands.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_agility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist used her <w>nimble</w> fingers to play the complex concerto without making a single mistake.",
                            "target_lang_translations": {
                                "ru": "Пианистка использовала свои <w>ловкие</w> пальцы, чтобы исполнить сложный концерт без единой ошибки."
                            }
                        },
                        {
                            "text": "With <w>nimble</w> fingers, the craftsman carefully assembled the tiny parts of the antique watch.",
                            "target_lang_translations": {
                                "ru": "<w>Проворными</w> пальцами мастер аккуратно собрал крошечные детали старинных часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "dexterous",
                        "deft",
                        "handy"
                    ],
                    "common_phrases": [
                        "nimble fingers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусный и умелый в обращении с предметами или их захвате руками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловкий",
                                "target_lang_sense_clarification": "умелый в манипуляциях"
                            },
                            {
                                "target_lang_word": "проворный",
                                "target_lang_sense_clarification": "быстрый в работе руками"
                            },
                            {
                                "target_lang_word": "цепкий",
                                "target_lang_sense_clarification": "способный крепко держать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3e468bf-dd70-305b-80c5-30fc27019c03",
                    "sense_definition": "Quick-witted, alert, and able to think or understand things very quickly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_agility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>nimble</w> mind and can improvise a solution in almost any difficult situation.",
                            "target_lang_translations": {
                                "ru": "У него <w>живой</w> ум, и он может найти решение практически в любой сложной ситуации."
                            }
                        },
                        {
                            "text": "The job requires you to be <w>nimble</w> in your thinking to keep up with the fast-paced environment.",
                            "target_lang_translations": {
                                "ru": "Работа требует от вас <w>гибкости</w> мышления, чтобы успевать за быстро меняющейся обстановкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "quick-witted",
                        "sharp",
                        "astute"
                    ],
                    "common_phrases": [
                        "nimble mind",
                        "nimble thinking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообразительный, бдительный и способный очень быстро понимать вещи или думать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообразительный",
                                "target_lang_sense_clarification": "быстро понимающий"
                            },
                            {
                                "target_lang_word": "находчивый",
                                "target_lang_sense_clarification": "способный быстро найти решение"
                            },
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "о гибком уме"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f403a70-3037-3d6b-85db-27f5cb275e4e",
                    "sense_definition": "To move in a quick, light, and agile manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_agility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small cleaner shrimp <w>nimble</w> in and out of the predator's mouth to remove parasites.",
                            "target_lang_translations": {
                                "ru": "Маленькие креветки-чистильщики <w>снуют</w> в пасти хищника и обратно, удаляя паразитов."
                            }
                        },
                        {
                            "text": "The mountain goats <w>nimbled</w> across the rocky ledge with surprising ease and speed.",
                            "target_lang_translations": {
                                "ru": "Горные козлы <w>ловко перемещались</w> по скалистому выступу с удивительной легкостью и скоростью."
                            }
                        }
                    ],
                    "synonyms": [
                        "scurry",
                        "dart"
                    ],
                    "common_phrases": [
                        "nimble in and out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться быстро, легко и ловко."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сновать",
                                "target_lang_sense_clarification": "быстро двигаться туда-сюда"
                            },
                            {
                                "target_lang_word": "юркнуть",
                                "target_lang_sense_clarification": "быстро и ловко переместиться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}