                "senses": [
                    {
                        "sense_id": "de465512-baba-360b-affb-8e3df0e55cdd",
                        "entry_id": "6e54f0c0-50f4-39e5-bd64-6e9a454d1290",
                        "glosses": [
                            "Pivoter de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225772af-a2cc-40e4-8065-d62ac50486df",
                                "sense_id": "de465512-baba-360b-affb-8e3df0e55cdd",
                                "text": "Afin d'empêcher une élévation de vitesse de rotation nuisible, en cas de perturbation par une onde de pression (\" explosion extérieure\"), survenant en produisant de grands efforts d'écoulement sur les pales (3 ou 4) du ventilateur, il est proposé, en cas de perturbation, grâce à la force de l'air (F\"1 ou F\"2) résultante agissant à chaque fois sur les pales en sens inverse, de laisser autopivoter des pales (3 ou 4) d'une position d'exploitation, définie par repos contre une première butée (6 ou 8), à une position de cas de perturbation."
                            },
                            {
                                "example_id": "648a51a8-4fdd-45fa-a90d-ec4301e74813",
                                "sense_id": "de465512-baba-360b-affb-8e3df0e55cdd",
                                "text": "Brassage : 1 Eden 228 autopivotante (qui autopivote plus), une Stream 6000, une nanoStream"
                            }
                        ]
                    },
