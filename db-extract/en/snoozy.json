                        "entry_id": "86924cf7-8a65-35d7-9851-3f52470cbb67",
                        "glosses": [
                            "Sleep-inducing; tedious."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7040ec8b-359d-4a7d-98b5-e49abb1b90c8",
                                "sense_id": "c1cc7139-ecb4-3983-a377-72c2019d3897",
                                "text": "While the basic automatic-transmission 528xi takes a snoozy 7.6 seconds to reach 60 miles an hour, the 535xi blazes there in 5.6 seconds, a remarkable two-second advantage."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4da9067-c6c2-3e58-a428-d0f356995f4f",
                        "entry_id": "86924cf7-8a65-35d7-9851-3f52470cbb67",
                        "glosses": [
                            "Sleepy; drowsy."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3017a7a1-5d25-417b-bc0c-f398cc3a800a",
                                "sense_id": "e4da9067-c6c2-3e58-a428-d0f356995f4f",
                                "text": "She places the snoozy child in the car seat at her feet."
                            }
                        ]
