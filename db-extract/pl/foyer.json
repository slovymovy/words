                        "translation_id": "4e953f7b-932a-47cb-8d23-2cc7a49cc1c9",
                        "source_entry_id": "4b0066ee-be24-3f2e-b4fa-965fe829c41d",
                        "source_sense_id": "5a0f9dc8-6fd8-3aa5-8079-5d029c3402c9",
