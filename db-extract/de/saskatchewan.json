                        "cross_references": [
                            {
                                "target_word": "Saskatchewan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5318fc3b-6d26-36e6-9ba0-f6e57a5856ff",
                                        "entry_id": "07336859-ecaa-38e5-8adb-f6eccfaa9a61",
                                        "glosses": [
                                            "Province du Canada (symbole postal SK), bordée par les Territoires du Nord-Ouest au nord, le Manitoba à l’est, les États-Unis au sud, et l’Alberta à l’ouest. Sa capitale est Regina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbcee500-898e-462f-ab83-c32514a68fb6",
                                                "sense_id": "5318fc3b-6d26-36e6-9ba0-f6e57a5856ff",
                                                "text": "Paul Durand imaginait-il que les froids de l’Athabaska-Mackensie dépassent de beaucoup en rigueur ceux déjà si cruels du nord-est de la Saskatchewan ?"
                                            },
                                            {
                                                "example_id": "ddc66932-aa17-4371-8d90-c525711f233f",
                                                "sense_id": "5318fc3b-6d26-36e6-9ba0-f6e57a5856ff",
                                                "text": "Située au centre du Canada, la Saskatchewan est la plus vaste des quatre provinces qui forment l’Ouest du pays."
                                            },
                                            {
                                                "example_id": "be9ad0d3-f6c1-4549-93b1-0df9d9595b30",
                                                "sense_id": "5318fc3b-6d26-36e6-9ba0-f6e57a5856ff",
                                                "text": "La répression de la Rébellion de la Rivière-Rouge a contribué à la dispersion des Métis et a renforcé la migration vers le Saskatchewan et l’Alberta, territoires encore plus ouverts et éloignés des difficultés manitobaines (mais territoires qui, à leur tour connaîtront des problèmes semblables)."
                                            },
                                            {
                                                "example_id": "c63813e0-38c8-4668-8972-0bc9197e83fd",
                                                "sense_id": "5318fc3b-6d26-36e6-9ba0-f6e57a5856ff",
                                                "text": "Le Saskatchewan créera un nouveau fonds de stabilisation des recettes de 400 millions de dollars canadiens grâce au produit du transfert non récurrent de bénéfices non distribués de la Saskatchewan Liquor and Gaming Authority."
                                            },
                                            {
                                                "example_id": "65f85e48-6f4f-4317-ab24-c8e810a4b6c5",
                                                "sense_id": "5318fc3b-6d26-36e6-9ba0-f6e57a5856ff",
                                                "text": "J’habite en Saskatchewan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2229104-7976-3b83-ba6a-6431b5c18db9",
                                        "entry_id": "07336859-ecaa-38e5-8adb-f6eccfaa9a61",
                                        "glosses": [
                                            "Rivière du Canada central se jetant dans le lac Winnipeg."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
