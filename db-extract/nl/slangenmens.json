                    {
                        "sense_id": "e58f35c5-836f-3962-b720-b02a92620873",
                        "entry_id": "d5c69324-2d48-3167-853f-7fe243a5f242",
                        "glosses": [
                            "iemand die heel lenig is, lenige acrobaat"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "f4f55c92-d277-4a9d-9e45-9602e31b407e",
                                "sense_id": "e58f35c5-836f-3962-b720-b02a92620873",
                                "text": "Aisa, op haar beurt, trok haar mouwloze T-shirt strak, haar borsten accentuerend, en bewoog zich draaiend als een slangenmens naar Marina toe."
                            },
                            {
                                "example_id": "d847b39d-7f32-4d22-8c13-c5e13a91d019",
                                "sense_id": "e58f35c5-836f-3962-b720-b02a92620873",
                                "text": "Weinig danseressen zijn zo intrigerend zijn als Sabine Molenaar, een Nederlandse die in Brussel woont. Met haar lenige ledematen en halsbrekende stunts lijkt ze een slangenmens. Ze beweegt sensueel vrouwelijk, maar tegelijk heeft haar tengere lichaam ook iets androgyns. En ze mikt op je buik in plaats van je hersenen."
                            }
                        ]
                    }
