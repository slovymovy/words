                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12376c6f-ca59-496f-a0ab-71063d94e163",
                        "source_entry_id": "09042b9e-479c-3ded-a8b9-92f6572b9888",
                        "source_sense_id": "1a7c9561-b77c-3eb9-835a-eb2dc82d96ea",
                        "target_lang_word": "Bison",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bison",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a2cc780-c858-3139-9eea-759bc4487ad8",
                                        "entry_id": "8e604647-28a2-3908-9c74-f830ab8ee852",
                                        "glosses": [
                                            "eine Gattung europäischer und nordamerikanischer Wildrinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b923e967-d3de-4ce5-a454-0315ce7656b4",
                                                "sense_id": "9a2cc780-c858-3139-9eea-759bc4487ad8",
                                                "text": "Aus dem Steppenwisent entwickelten sich zwei Arten des Bisons, die in zwei aufeinander folgenden Einwanderungswellen die südlicheren Teile des Kontinents eroberten."
                                            },
                                            {
                                                "example_id": "f33ebc22-1dc0-4a63-98a1-d2663598c145",
                                                "sense_id": "9a2cc780-c858-3139-9eea-759bc4487ad8",
                                                "text": "„In dieser misslichen Lage erreicht uns die Nachricht, dass in Tschernobyl ein Bison gestorben ist, der einst dorthin verbracht wurde, um das Gras in der Todeszone kurz zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "391b6f65-f850-30ae-9db3-017ee9c9640d",
                                        "entry_id": "8e604647-28a2-3908-9c74-f830ab8ee852",
                                        "glosses": [
                                            "eine Art aus dieser Gattung, der Amerikanische Bison (Bison bison)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc342089-cd0e-4b6f-9e8f-bb9eac5fa188",
                                                "sense_id": "391b6f65-f850-30ae-9db3-017ee9c9640d",
                                                "text": "Der Bison war die Lebensgrundlage der Prärie-Indianer."
                                            },
                                            {
                                                "example_id": "653bc097-fcc0-4142-8e09-313c17d7dca5",
                                                "sense_id": "391b6f65-f850-30ae-9db3-017ee9c9640d",
                                                "text": "„Womöglich waren sie eine leichtere Beute für die Steinzeitbewohner als die mächtigen Bisons.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79b0423f-1a46-4ed8-a4c1-6421661ce9be",
                        "source_entry_id": "09042b9e-479c-3ded-a8b9-92f6572b9888",
                        "source_sense_id": "1a7c9561-b77c-3eb9-835a-eb2dc82d96ea",
                        "target_lang_word": "бизон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бизон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f3ed2ef1-8f10-315e-ba0b-46f57955b4c2",
                                        "entry_id": "dba5928a-3431-36d4-ad04-e62beffc4316",
                                        "glosses": [
                                            "зоол. крупное животное семейства полорогих (род животных)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd31f85b-ab94-408a-b54b-d61e9abd75b8",
                                                "sense_id": "f3ed2ef1-8f10-315e-ba0b-46f57955b4c2",
                                                "text": "В Йеллоустонском парке, оставив на дороге машину, мы прошли километра два на пригорок, где пасся старый бизон. Подходили мы осторожно, старались не напугать зверя. Да и сами, признаться, побаивались ― что на уме у мрачного великана? Однако бизон проявил полное равнодушие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
