{
    "word_family": [
        "стоянка",
        "стойка",
        "стояк",
        "стоячий",
        "стоящий",
        "постой"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c12d6b77-1aa4-398d-915c-ed81ee0f0505",
                    "sense_definition": "Находиться в вертикальном положении на поверхности.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ваза <w>стоит</w> на столе.",
                            "target_lang_translations": {
                                "en": "The vase <w>stands</w> on the table."
                            }
                        },
                        {
                            "text": "Человек <w>стоит</w> посреди комнаты.",
                            "target_lang_translations": {
                                "en": "A man <w>is standing</w> in the middle of the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "находиться"
                    ],
                    "antonyms": [
                        "лежать"
                    ],
                    "common_phrases": [
                        "стоять на столе",
                        "стоять посреди комнаты"
                    ],
                    "target_lang_definitions": {
                        "en": "To be in an upright position on a surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand",
                                "target_lang_sense_clarification": "To be positioned physically in an erect position."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "013e773c-9725-3811-adee-6da0190e9365",
                    "sense_definition": "Выражает требование остановиться или прекратить движение.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Стой</w>, ты же навредишь себе!",
                            "target_lang_translations": {
                                "en": "<w>Stop</w>, you'll hurt yourself!"
                            }
                        },
                        {
                            "text": "Водитель крикнул: <w>стой</w>!",
                            "target_lang_translations": {
                                "en": "The driver shouted: <w>stop</w>!"
                            }
                        }
                    ],
                    "antonyms": [
                        "идти",
                        "двигаться"
                    ],
                    "common_phrases": [
                        "стой на месте"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses a command to stop or cease movement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "To cease movement or action."
                            },
                            {
                                "target_lang_word": "halt",
                                "target_lang_sense_clarification": "A formal or emphatic command to stop."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca0000e5-a1c4-34e3-8f7b-fb4072dcc36a",
                    "sense_definition": "Бездействовать, быть в состоянии неисправности или простоя.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Машины <w>стоят</w> из-за поломки.",
                            "target_lang_translations": {
                                "en": "The cars <w>are standing idle</w> due to a breakdown."
                            }
                        },
                        {
                            "text": "Часы <w>стоят</w> уже неделю.",
                            "target_lang_translations": {
                                "en": "The clock <w>has been stopped</w> for a week."
                            }
                        }
                    ],
                    "synonyms": [
                        "бездействовать"
                    ],
                    "antonyms": [
                        "работать"
                    ],
                    "common_phrases": [
                        "часы стоят",
                        "заводы стоят"
                    ],
                    "target_lang_definitions": {
                        "en": "To be inactive, out of order, or idle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand idle",
                                "target_lang_sense_clarification": "To be in a state of inactivity or non-operation."
                            },
                            {
                                "target_lang_word": "be out of order",
                                "target_lang_sense_clarification": "To be broken or not functioning."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "011bd040-1c1b-315c-bb65-79316ff3f8ab",
                    "sense_definition": "Находиться в очереди.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>стоял</w> за хлебом с двух часов.",
                            "target_lang_translations": {
                                "en": "I <w>had been standing</w> in line for bread since two o'clock."
                            }
                        },
                        {
                            "text": "Он <w>стоит</w> в очереди на операцию.",
                            "target_lang_translations": {
                                "en": "He <w>is standing</w> in line for surgery."
                            }
                        }
                    ],
                    "common_phrases": [
                        "стоять в очереди"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be waiting in a line."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand in line",
                                "target_lang_sense_clarification": "To wait in a queue (US)."
                            },
                            {
                                "target_lang_word": "queue",
                                "target_lang_sense_clarification": "To wait in a line (UK)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7ad43f6-2d39-3201-8d86-7bc02d7a90b4",
                    "sense_definition": "Располагаться, находиться (о городе или крупном объекте).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Париж <w>стоит</w> на Сене.",
                            "target_lang_translations": {
                                "en": "Paris <w>stands</w> on the Seine."
                            }
                        },
                        {
                            "text": "Город <w>стоит</w> на берегу реки.",
                            "target_lang_translations": {
                                "en": "The city <w>stands</w> on the river bank."
                            }
                        }
                    ],
                    "synonyms": [
                        "находиться"
                    ],
                    "common_phrases": [
                        "город стоит"
                    ],
                    "target_lang_definitions": {
                        "en": "To be located or situated (of a city or large object)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand",
                                "target_lang_sense_clarification": "To be situated or located in a specific place."
                            },
                            {
                                "target_lang_word": "be located",
                                "target_lang_sense_clarification": "To have a specific geographical position."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a0c42b-4c39-30e7-bc79-74eabf31d25c",
                    "sense_definition": "Твёрдо придерживаться какого-либо мнения или принципа.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он упорно <w>стоял</w> на своём.",
                            "target_lang_translations": {
                                "en": "He stubbornly <w>stood</w> his ground."
                            }
                        },
                        {
                            "text": "Мы <w>стоим</w> на принципе равенства.",
                            "target_lang_translations": {
                                "en": "We <w>stand</w> by the principle of equality."
                            }
                        }
                    ],
                    "common_phrases": [
                        "стоять на своём"
                    ],
                    "target_lang_definitions": {
                        "en": "To firmly maintain an opinion or principle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand one's ground",
                                "target_lang_sense_clarification": "To maintain a position firmly against opposition."
                            },
                            {
                                "target_lang_word": "stick to",
                                "target_lang_sense_clarification": "To remain committed to a belief or principle."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23c700c4-c43b-3f6c-9eba-21ee8bd6d7b0",
                    "sense_definition": "Выдерживать, сохраняться, не поддаваться трудностям.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом бою они <w>стояли</w> насмерть.",
                            "target_lang_translations": {
                                "en": "In this battle, they <w>stood</w> to the death."
                            }
                        },
                        {
                            "text": "Крепость <w>стояла</w> под натиском врага.",
                            "target_lang_translations": {
                                "en": "The fortress <w>withstood</w> the enemy's assault."
                            }
                        }
                    ],
                    "common_phrases": [
                        "стоять насмерть"
                    ],
                    "target_lang_definitions": {
                        "en": "To endure, persist, or resist difficulties."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "withstand",
                                "target_lang_sense_clarification": "To remain firm against pressure or attack."
                            },
                            {
                                "target_lang_word": "hold out",
                                "target_lang_sense_clarification": "To continue to resist or survive under difficult conditions."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}