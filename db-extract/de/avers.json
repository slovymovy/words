                                        "sense_id": "09ca72d2-b2f2-3cbf-9a3d-17f11ce7ba83",
                                        "entry_id": "a5fa0c4f-d14c-3ae2-acb7-7c3b97c20874",
                                        "glosses": [
                                            "Turned or facing toward the observer."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55dfee1e-7465-422f-9a5a-6e97dab43dde",
                                                "sense_id": "09ca72d2-b2f2-3cbf-9a3d-17f11ce7ba83",
                                                "text": "The obverse side of the gravestone has the inscription."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8215ef1-bf75-3908-9129-ce7a8f9a8aa9",
                                        "entry_id": "a5fa0c4f-d14c-3ae2-acb7-7c3b97c20874",
                                        "glosses": [
                                            "Corresponding; complementary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1495eee7-4118-4051-a5e7-9495d47a556d",
                                                "sense_id": "a8215ef1-bf75-3908-9129-ce7a8f9a8aa9",
                                                "text": "When you speak clearly, people understand you. If you don't mumble, the obverse effect is observed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1f12cdf-3830-3985-afa9-d2818966fbfa",
                                        "entry_id": "a5fa0c4f-d14c-3ae2-acb7-7c3b97c20874",
                                        "glosses": [
                                            "Having the base, or end next to the attachment, narrower than the top."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d184237-2702-4de6-85c2-777de89c8b98",
                                                "sense_id": "a1f12cdf-3830-3985-afa9-d2818966fbfa",
                                                "text": "an obverse leaf"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ef0a78-6428-3c98-8fac-38e30db0b4c5",
                                        "entry_id": "6728f9d1-98e6-3fe6-8c47-4e8fc3fb7c45",
                                        "glosses": [
                                            "The heads side of a coin, or the side of a medal or badge that has the principal design."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d792d9f-87e1-4971-82a9-b21efa7d338f",
                                                "sense_id": "c8ef0a78-6428-3c98-8fac-38e30db0b4c5",
                                                "text": "The medal had a cross on the obverse and had a name inscribed on the reverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d553c2a8-ce76-32df-bb80-99aa7e8faa06",
                                        "entry_id": "6728f9d1-98e6-3fe6-8c47-4e8fc3fb7c45",
                                        "glosses": [
                                            "A proposition obtained by obversion, e.g. All men are mortal => No man is immortal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbeca03c-3473-4cfe-821a-4c953569e13d",
                        "source_entry_id": "a105a8ea-8985-3a99-8173-a5bffa9ed8e0",
                        "source_sense_id": "03169aba-b7bd-3cb4-a3ad-9b755c155d57",
                        "source_sense_description": "Numismatik: die Vorderseite einer Münze, Medaille oder Ähnlichem",
                        "target_lang_word": "avers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca9ebf5-5297-37da-8373-97e602c60595",
                                        "entry_id": "5edfdf4b-daef-3933-980e-80d771166c41",
                                        "glosses": [
                                            "Côté face d’une pièce de monnaie ou d’une médaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf48f56-3d3f-4b39-be35-54e7a573afd5",
                                                "sense_id": "4ca9ebf5-5297-37da-8373-97e602c60595",
                                                "text": "Si l'on ne se définit qu'en s'opposant, j'étais l'indéfini en chair et en os ; si l'amour et la haine sont l'avers et le revers de la même médaille, je n'aimais rien ni personne."
                                            },
                                            {
                                                "example_id": "a35738bc-35d0-42bf-9720-8c244a1ce38a",
                                                "sense_id": "4ca9ebf5-5297-37da-8373-97e602c60595",
                                                "text": "Le revers de la médaille - à supposer qu’il y ait un avers - c’est que Flair Hickory allait avoir plus de temps pour préparer la contre-offensive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95495ab2-ca3d-30c5-9270-728f68d31867",
                                        "entry_id": "5edfdf4b-daef-3933-980e-80d771166c41",
                                        "glosses": [
                                            "Dessus."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7c88e67-fda9-4c31-921e-9948bbbe2cc4",
                                                "sense_id": "95495ab2-ca3d-30c5-9270-728f68d31867",
                                                "text": "Rabatel est toujours assis en face de moi ; ses doigts, non plus que les miens, n’ont pas quitté les bords de l’ardoise. Il le fait aussitôt constater. — Vous le voyez, personne n’a pu écrire sur cette ardoise. Cependant, vous allez y lire la réponse à la question écrite sur l’avers."
                                            },
                                            {
                                                "example_id": "27cbfb21-2937-413e-8ddc-67f0b1cb6585",
                                                "sense_id": "95495ab2-ca3d-30c5-9270-728f68d31867",
                                                "text": "Le 15 mai 1979, la Banque Centrale a publié un nouveau billet, plus petit que son prédécesseur, avec un nouveau design dominé par des tons marron, à l’avers on trouve l’image de la mosquée du sultan Qaïtbay avec un fond de décoration arabe, et à l’envers on trouve celle du temple d’Abou Simbel, et deux cartouches pharaoniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "203fbe19-c9bc-3bd3-91b1-7904dc66be7d",
                                        "entry_id": "5edfdf4b-daef-3933-980e-80d771166c41",
                                        "glosses": [
                                            "Face principale d’un pavillon. Cette face est celle dont le guindant se trouve en début de ligne dans le sens d’écriture du pays considéré. En France, le guindant est donc à gauche, tandis qu’en Arabie Saoudite, il sera à droite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
