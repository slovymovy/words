                        ],
                        "examples": [
                            {
                                "example_id": "b099fb6f-d9c2-4f34-bad3-bc02635e61f0",
                                "sense_id": "db9bcf8e-e52f-3d2f-ab0f-c0f66fc24a63",
                                "text": "„Vor allem im Westen werden Spezialisten für Energietechnik sowie im Bereich Klempnerei, Sanitär, Heizung und Klimatechnik gesucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                        "entry_id": "7170c301-50c7-30f2-b137-e5cbe7a0af99",
                        "glosses": [
                            "Arbeitsstätte eines Klempners"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03b97710-1f17-4ef8-8e09-962d284cc6fb",
                                "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                                "text": "„In seiner Klempnerei in der Bramfelder Straße züchtete er vor allem Drogen-Hanf!“"
                            },
                            {
                                "example_id": "32363dbb-1d30-429f-98b4-960e4e8a7c0b",
                                "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                                "text": "„In der alten Klempnerei stellt sich Florian Haver einen Indoorspielplatz vor.“"
                            },
                            {
                                "example_id": "16c7ed43-fafd-420f-bb3d-a396523e58d1",
                                "sense_id": "66de94e6-c7fb-3d60-b1fa-aba01c3af122",
                                "text": "„Die Klempnerei, die in den vergangenen Jahrzehnten das Dach der Philharmonie mitbaute und das der Akademie der Künste, hat heute noch sieben Beschäftigte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
