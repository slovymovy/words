                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "731bfd4c-4841-31b4-8c12-4bd0a4f53438",
                                        "entry_id": "c3315d3f-00eb-39a9-8858-cc72b1225c4a",
                                        "glosses": [
                                            "Furnished with a seat."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e773d9e1-2d58-4c93-b966-8bd551bed044",
                                                "sense_id": "731bfd4c-4841-31b4-8c12-4bd0a4f53438",
                                                "text": "There was a rush-seated chair with a hole in the seat, — and that […] seemed to be all that the room contained."
                                            }
