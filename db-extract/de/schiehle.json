                "senses": [
                    {
                        "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                        "entry_id": "15371279-5a95-3d56-a75c-cd3577355e49",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d9b5e7-03e1-495d-b72b-1b9e6f53a42f",
                                "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                                "text": "Frau Schiehle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7075e7b1-f13f-4c21-a9cb-2a9f6c49e3ba",
                                "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                                "text": "Herr Schiehle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9df8aec8-ff1f-43d9-b4ef-545edfcd73ac",
                                "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                                "text": "Die Schiehles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "31be39d9-e82e-4b95-9723-5703acd57df1",
                                "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                                "text": "Der Schiehle trägt nie die Schals, die die Schiehle ihm strickt."
                            },
                            {
                                "example_id": "35282dc1-677e-4405-a58b-d92d441ed502",
                                "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schiehle kommt, geht der Herr Schiehle.“"
                            },
                            {
                                "example_id": "685f58bc-91be-42a8-af71-5bdbb2d2a5b1",
                                "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                                "text": "Schiehle kommt und geht."
                            },
                            {
                                "example_id": "cdd14fab-4873-4a8d-b286-7a2d0c8e0af3",
                                "sense_id": "c0a1c21e-cfa5-3ddf-ad68-6539884bd926",
                                "text": "Schiehles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
