                "translations": [
                    {
                        "translation_id": "ad0cc80b-7400-4a9b-bd76-1676404e83ea",
                        "source_entry_id": "daea8fe7-3d16-36e1-8904-525f8c21a4c6",
                        "source_sense_id": "6a88e8cc-597b-3e7d-9686-1770261df482",
                        "target_lang_word": "zänkisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zänkisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f78daf63-580a-3ff9-bf45-02bd2740be67",
                                        "entry_id": "87a61869-191b-33c8-be07-6e1fb387d2f7",
                                        "glosses": [
                                            "streitsüchtig, Streit suchend, Zank und Ärger verbreitend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0408beb7-062f-4991-9425-b5eabbd095b8",
                                                "sense_id": "f78daf63-580a-3ff9-bf45-02bd2740be67",
                                                "text": "„Ziazaa, nach dem Aberglauben des Mittelalters ein Wunderstein von verschiedener Farbe, sollte die Eigenschaft haben denjenigen, welcher ihn bei sich trägt, zänkisch zu machen und ihm schwere Träume zu bereiten.“"
                                            },
                                            {
                                                "example_id": "73ca6466-6c49-4854-8080-2b1bf39b95d7",
                                                "sense_id": "f78daf63-580a-3ff9-bf45-02bd2740be67",
                                                "text": "Als besonders Beispiel gilt die Gattin des Sokrates, die Xanthippe, da sie gewöhnlich als sehr mürrisch und zänkisch geschildert und von ihr mehre ungünstige Anekdoten erzählt werden, sprüchwörtlich eine böse, zanksüchtige Ehefrau."
                                            },
                                            {
                                                "example_id": "ef464ec2-c967-4178-9ba8-26f87459589f",
                                                "sense_id": "f78daf63-580a-3ff9-bf45-02bd2740be67",
                                                "text": "„Fritz war so zänkisch, daß er sich mit Niemanden vertrug.“"
                                            },
                                            {
                                                "example_id": "b49b42c8-5090-4869-a49e-9cadad4166a4",
                                                "sense_id": "f78daf63-580a-3ff9-bf45-02bd2740be67",
                                                "text": "Deutschland, das sind 16 Bundesländer. Und wenn es ums Geld geht, wird aus der föderalen Gemeinschaft ganz schnell eine zänkische Familie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
