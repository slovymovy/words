                        "glosses": [
                            "Person, die den Holocaust lebend überstanden hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cecc9725-2291-44fc-a2a7-0b2fcd13f5da",
                                "sense_id": "aab7b018-4d8f-344b-b730-3fdb799e0feb",
                                "text": "Manche Holocaustüberlebende werden noch heute von Alpträumen geplagt."
                            },
                            {
                                "example_id": "2916292b-79c8-4afe-b798-47c8d9a43097",
                                "sense_id": "aab7b018-4d8f-344b-b730-3fdb799e0feb",
                                "text": "„Ein anderer Zeuge der Gräuel war der Königsberger Michael Wieck, ein Holocaustüberlebender, dessen Eltern vor dem Krieg als Mitglieder des Königsberger Streichquartetts einen überregionalen Ruf genossen hatten.“"
                            }
                        ],
