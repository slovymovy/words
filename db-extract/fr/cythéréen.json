                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13830c09-8c6d-43b4-a6e1-ae192eb021ae",
                                "sense_id": "3ab56efe-4ac4-3fee-9c42-8136fc15c764",
                                "text": "La liste mutilée de Tégée, qui contient peut-être des noms de mercenaires, cite quatre Lacédémoniens et un Cythéréen"
                            },
                            {
                                "example_id": "389d1b64-6986-4248-b887-6a1b492978ea",
                                "sense_id": "3ab56efe-4ac4-3fee-9c42-8136fc15c764",
                                "text": "Toute cette évolution créa un héritage culturel riche, dotant les Cythéréens d’un identité particulière, et donnant naissance à une très grande variété de mentalités."
                            }
                        ]
                    }
