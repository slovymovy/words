                ],
                "senses": [
                    {
                        "sense_id": "0195527c-5484-3bf3-a6e9-ab0a77c7c018",
                        "entry_id": "03315067-9251-3e3e-8db6-d90d325e9ad8",
                        "glosses": [
                            "Réconcilier, rabibocher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbfe17e0-76ef-4643-bf8f-b275310d687d",
                                "sense_id": "0195527c-5484-3bf3-a6e9-ab0a77c7c018",
                                "text": "Rapapilloté avec son légitime crampon, il était obsédé par la pensée de courir vers d'autres amours plus juvéniles."
                            },
                            {
                                "example_id": "eadf04c7-8ebc-46df-bdce-474dc7f8cc00",
                                "sense_id": "0195527c-5484-3bf3-a6e9-ab0a77c7c018",
                                "text": "Rien de mieux que de trinquer un bon coup pour rapapilloter les gens."
                            },
                            {
                                "example_id": "cdc19823-363c-41d8-ae2d-1514c61e1b8f",
                                "sense_id": "0195527c-5484-3bf3-a6e9-ab0a77c7c018",
                                "text": "Et moi mon rôle était de les rapapilloter, elle et Dolly."
                            }
                        ]
                    }
