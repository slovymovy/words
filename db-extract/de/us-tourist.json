                    {
                        "sense_id": "8839e167-a5f7-3601-9c25-0a7406cdcb04",
                        "entry_id": "29dfa7eb-0e68-39ed-bc90-ce5297dc261b",
                        "glosses": [
                            "ein aus den Vereinigten Staaten von Amerika stammender Tourist; ein US-Amerikaner, der ein anderes Land besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d0bdb0d-48ce-47df-ad88-3f03ed7d11c6",
                                "sense_id": "8839e167-a5f7-3601-9c25-0a7406cdcb04",
                                "text": "„Ein US-Tourist hat versucht, konservierte Körperteile aus Thailand mit der Post nach Hause zu schicken – darunter ein Kinderkopf, ein Babyfuß und ein Herz mit einer Messerwunde.“"
                            },
                            {
                                "example_id": "3de7520a-3ffc-43dc-b178-e44d95625376",
                                "sense_id": "8839e167-a5f7-3601-9c25-0a7406cdcb04",
                                "text": "„Weil er nicht aufhörte zu singen, ist ein US-Tourist im Süden Thailands erstochen worden.“"
                            },
                            {
                                "example_id": "a3f48006-cc45-42f9-8c5c-8f8df5ae7d2c",
                                "sense_id": "8839e167-a5f7-3601-9c25-0a7406cdcb04",
                                "text": "„Für die 28-Jährige sind ohnehin die US-Touristen die besten Freier: „Die haben Geld in der Tasche und sind spendabel.““"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
