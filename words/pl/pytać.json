{
    "word_family": [
        "pytanie",
        "pytajnik",
        "zapytanie",
        "dopytać",
        "odpytać",
        "przepytać",
        "zapytać",
        "podpytać",
        "wypytać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db01dd37-da72-32f9-abb3-5e715d869784",
                    "sense_definition": "zwracać się do kogoś ze słowami wymagającymi odpowiedzi; zadawać pytanie",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pytanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Często <w>pytam</w> nauczyciela o trudne słowa po polsku.",
                            "target_lang_translations": {
                                "en": "I often <w>ask</w> the teacher about difficult Polish words."
                            }
                        },
                        {
                            "text": "Turysta <w>pytał</w> na ulicy o drogę do najbliższego dworca.",
                            "target_lang_translations": {
                                "en": "The tourist <w>was asking</w> on the street for directions to the nearest station."
                            }
                        }
                    ],
                    "synonyms": [
                        "zadawać pytanie"
                    ],
                    "antonyms": [
                        "odpowiadać"
                    ],
                    "common_phrases": [
                        "pytać o drogę",
                        "pytać o zdanie",
                        "pytać o radę"
                    ],
                    "target_lang_definitions": {
                        "en": "to address someone with words requesting an answer; to ask a question"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ask",
                                "target_lang_sense_clarification": "to inquire or put a question"
                            },
                            {
                                "target_lang_word": "inquire",
                                "target_lang_sense_clarification": "to seek information"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57bf6dc7-67e1-33bb-a0ad-ef4350691ddb",
                    "sense_definition": "sprawdzać stan wiedzy ucznia lub studenta poprzez zadawanie pytań",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "edukacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel historii zawsze <w>pyta</w> na początku każdej lekcji.",
                            "target_lang_translations": {
                                "en": "The history teacher always <w>quizzes</w> students at the beginning of each class."
                            }
                        },
                        {
                            "text": "Bardzo się denerwowałam, kiedy profesor <w>pytał</w> mnie przy tablicy.",
                            "target_lang_translations": {
                                "en": "I was very nervous when the professor <w>was testing</w> me at the blackboard."
                            }
                        }
                    ],
                    "synonyms": [
                        "przepytywać",
                        "odpytywać"
                    ],
                    "common_phrases": [
                        "pytać przy tablicy"
                    ],
                    "target_lang_definitions": {
                        "en": "to test a pupil's or student's knowledge by asking questions orally"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "test",
                                "target_lang_sense_clarification": "to quiz or examine a student orally"
                            },
                            {
                                "target_lang_word": "quiz",
                                "target_lang_sense_clarification": "to examine a student on lesson material"
                            },
                            {
                                "target_lang_word": "question",
                                "target_lang_sense_clarification": "to test knowledge through questioning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbda2641-f882-39c7-90b0-20330caf3c9a",
                    "sense_definition": "w konstrukcjach przeczących: nie dbać o coś, nie przywiązywać do czegoś wagi lub nie zważać na konsekwencje",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dbanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On w ogóle nie <w>pyta</w> o koszty i kupuje najdroższe rzeczy.",
                            "target_lang_translations": {
                                "en": "He does not <w>care</w> about the cost at all and buys the most expensive things."
                            }
                        },
                        {
                            "text": "Mężczyzna nie <w>pytał</w> o niebezpieczeństwo i natychmiast ruszył na pomoc tonącemu.",
                            "target_lang_translations": {
                                "en": "The man didn't <w>give a thought to</w> the danger and immediately rushed to help the drowning person."
                            }
                        }
                    ],
                    "synonyms": [
                        "uważać"
                    ],
                    "common_phrases": [
                        "nie pytać o koszty",
                        "nie pytać o nic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w wyrażeniach potocznych"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "in negative constructions: to not care about something, attach no importance to it, or ignore the consequences"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "care",
                                "target_lang_sense_clarification": "used with negatives: to not care or worry about something"
                            },
                            {
                                "target_lang_word": "ask",
                                "target_lang_sense_clarification": "used with negatives: not to inquire or mind"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}