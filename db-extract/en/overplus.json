                    {
                        "sense_id": "a1fafbab-c22e-388d-9e72-02bc9432009e",
                        "entry_id": "9a008f05-104a-36a7-96a6-e9ad1a533706",
                        "glosses": [
                            "That which remains beyond what is necessary or required; a surplus."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "425fbcba-74b9-469b-b542-158daaf9b087",
                                "sense_id": "a1fafbab-c22e-388d-9e72-02bc9432009e",
                                "text": "Where some for an over-plus, or supererogation have added this necessaity, that they must necessarily accompany them, as well in death, as in life."
                            },
                            {
                                "example_id": "06a4bf33-552b-4352-9585-1cbe34803575",
                                "sense_id": "a1fafbab-c22e-388d-9e72-02bc9432009e",
                                "text": "Thou hast thy Will, And Will too boote, and Will in ouer-plus."
                            },
                            {
                                "example_id": "c711fbd6-1b25-4b30-8f0d-e644e4db3755",
                                "sense_id": "a1fafbab-c22e-388d-9e72-02bc9432009e",
                                "text": "I proposed that the two referees should retire and consider for themselves how much should be allowed for the boy's board and lodging, deducting at the rate of sixpence a day for what advantage was gained by his going on errands; and that the overplus should be restored."
                            }
                        ]
                    }
