                                "target_senses": [
                                    {
                                        "sense_id": "b7dd03ac-b894-3e02-8138-c7d8f379e9c1",
                                        "entry_id": "245e9bd0-0c5e-3ce8-9f86-26a4ae583bef",
                                        "glosses": [
                                            "Maßnahmen in einem Unternehmen, die den Absatz fördern; Konzept zur marktorientierten Führung eines Unternehmens, mit dem Ziel alle betrieblichen Funktionen auf den Markt (kundenorientiert, wettbewerbsorientiert) auszurichten; Verkaufsorientierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b12b8ba5-fc91-42ff-a25f-6a5410d04f2a",
                                                "sense_id": "b7dd03ac-b894-3e02-8138-c7d8f379e9c1",
                                                "text": "Marketing umfasst mehr als nur Zeitungsanzeigen und Fernsehwerbespots für ein Produkt."
                                            },
                                            {
                                                "example_id": "97893ce8-501c-43de-99f2-a20926415f7c",
                                                "sense_id": "b7dd03ac-b894-3e02-8138-c7d8f379e9c1",
                                                "text": "Es gibt verschiedene Entwicklungsphasen des Marketing."
                                            },
                                            {
                                                "example_id": "c65dabdf-3187-4e10-84cb-2f66bb4945a2",
                                                "sense_id": "b7dd03ac-b894-3e02-8138-c7d8f379e9c1",
                                                "text": "„Und ein gutes Marketing kann auch bei künstlerischen Produkten folgenreich sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b798131-b706-4aaf-b453-a52749280e52",
