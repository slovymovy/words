                ],
                "senses": [
                    {
                        "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                        "entry_id": "67276a60-e7a1-3790-9371-cf4fa25dda3f",
                        "glosses": [
                            "Geruchswahrnehmung, die von einer Birne/einem Birnbaum stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d14fde4-a77c-4c58-a075-950e19262a50",
                                "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                                "text": "„Der Geschmack ist sehr gut, beruhend auf einem saftig schmelzenden Fruchtfleisch und einem sortentypischen Birnengeruch.“"
                            },
                            {
                                "example_id": "fc6133bf-de88-411a-9f34-cf5103144e87",
                                "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                                "text": "„Ihr Fazit: Etliche Getränke schmeckten weder nach Äpfeln noch rochen sie entsprechend. Stattdessen fanden die Fruchtsaftexperten Bananen- und Birnengeruch sowie andere Fremdtöne.“"
                            },
                            {
                                "example_id": "058a3337-1502-4635-be26-687b23d33057",
                                "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                                "text": "„Der abdestillierte Ester ist farblos und riecht nach Birne-Banane (ganz witzig: wenn man die Geruchsprobe von nahem nimmt, überwiegt der Birnengeruch, wenn die Nase etwas weiter entfernt ist, überwiegt dahingegen der Bananengeruch).“"
                            },
                            {
                                "example_id": "12989a64-88be-408e-999d-9d33495be9d6",
                                "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                                "text": "„Ein süßlicher Birnengeruch war eindeutig wahrnehmbar.“"
                            },
                            {
                                "example_id": "dce8fe6d-99a9-42a8-bdd2-5926bfd36279",
                                "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                                "text": "„Der Geruch ist ein eindeutiger Birnengeruch, der nicht zu verwechseln ist. Farblich sieht er auch schon Birnengelb aus, auch wenn sie ein bisschen \"dreckiger\" wirkt als bei dem Granini.“"
                            },
                            {
                                "example_id": "819678c1-e725-43fa-8f63-b166d1bba7fe",
                                "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                                "text": "„Die Luft ist flirrend und von Birnengeruch gesättigt.“"
                            },
                            {
                                "example_id": "0d35c42b-afad-414e-be76-0032de3380a1",
                                "sense_id": "38887908-96e5-30ba-8cc8-ff7472fd5ae7",
                                "text": "„Er erzählt von Blumen und Märkten, die vom Birnengeruch beherrscht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
