                                                "sense_id": "8308f0ea-d0c1-394a-94ae-bba05c596329",
                                                "text": "Die Modedesignerin Jacqueline de Ribes trug den Titel Vicomtesse bis ihr Ehemann zum Grafen ernannt wurde."
                                            }
