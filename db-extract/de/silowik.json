                                        "entry_id": "90562309-0154-3892-8f1c-31ddd1f6ebb2",
                                        "glosses": [
                                            "A member of the Russian military, law enforcement, or intelligence services (the KGB or FSB), or a politician with a background in such services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a274e1-6bcd-49e7-985d-a3964a9ead83",
                                                "sense_id": "156d30eb-7c07-38c0-a367-6fa5fe2972b5",
                                                "text": "[T]he so-called siloviki have installed themselves deep inside the country’s boss class – something that did not happen to anything like the same degree during the Cold War."
                                            }
                                        ]
                                    }
                                ]
