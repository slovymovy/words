                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3d2393a7-492a-3fed-a6ae-a56792733615",
                        "entry_id": "cec8daf5-7879-32fb-8245-ec1edd6eb295",
                        "glosses": [
                            "Ville, capitale et commune du canton de Vaud en Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7fff26f-3ecc-49e7-bf98-b5d0ea8e341d",
                                "sense_id": "3d2393a7-492a-3fed-a6ae-a56792733615",
                                "text": "Depuis le mois de janvier, en effet, la bonne société de Lausanne se pressait dans les salons du poëte, qu'elle encourageait et récompensait par ses bravos, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02f66c94-c5e9-406d-9bca-17fe11e8004e",
                        "source_entry_id": "cec8daf5-7879-32fb-8245-ec1edd6eb295",
                        "target_lang_word": "Lausanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lausanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b0ee9d0-fb3b-34d9-a527-4c9c703e62d7",
                                        "entry_id": "edfc97d9-c3af-388d-8b0b-f0c5a061312f",
                                        "glosses": [
                                            "eine schweizerische Stadt am Genfer See"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877d0a17-c7da-43ce-ae21-bff40d7f7ffe",
                                                "sense_id": "9b0ee9d0-fb3b-34d9-a527-4c9c703e62d7",
                                                "text": "\"Das Bundesgericht (BGer) hat in Lausanne seinen Sitz, ebenso der Internationale Sportgerichtshof (TAS). Zudem haben in Lausanne verschiedene Sportweltverbände, darunter das Internationale Olympische Komitee (IOC), ihren Hauptsitz.“"
                                            },
                                            {
                                                "example_id": "f997c982-7969-46b7-bcc7-eeb8fa67ac62",
                                                "sense_id": "9b0ee9d0-fb3b-34d9-a527-4c9c703e62d7",
                                                "text": "\"Lausanne liegt an einem steilen Ufer des Genfersees. Das Stadtgebiet, das sich über eine Differenz von mehr als 300 Höhenmeter erstreckt, wird durch die Bäche Louve und Flon in drei Quartiere zerschnitten, die durch teilweise aufwändige Brücken miteinander verbunden sind.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
