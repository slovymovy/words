                    },
                    {
                        "translation_id": "fc1ba580-1db8-4dd1-9e50-463e3f385ebd",
                        "source_entry_id": "d65a1cc6-0245-3929-883d-742b9e11efa4",
                        "source_sense_id": "fca952cb-b86d-3eda-82ef-04f9cffde6c9",
