                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缩水",
                                "target_lang_sense_clarification": "洗涤后衣物变小"
                            },
                            {
                                "target_lang_word": "变窄",
                                "target_lang_sense_clarification": "道路等变得狭窄"
                            },
                            {
                                "target_lang_word": "缩小",
                                "target_lang_sense_clarification": "体积或尺寸变小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "574a918b-0314-3840-88fc-7222118ec745",
                    "sense_definition": "Rendre plus étroit ou réduire les dimensions de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diminution_taille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le couturier a dû <w>rétrécir</w> ce pantalon pour qu'il convienne parfaitement.",
                            "target_lang_translations": {
                                "en": "The tailor had to <w>take</w> this pair of trousers <w>in</w> so that they fit perfectly.",
                                "ru": "Портному пришлось <w>ушить</w> эти брюки, чтобы они идеально сидели.",
                                "de": "Der Schneider musste diese Hose <w>verschmälern</w>, damit sie perfekt sitzt.",
                                "es": "El sastre tuvo que <w>estrechar</w> este pantalón para que le sentara perfectamente.",
                                "zh": "裁缝不得不把这条裤子<w>改小</w>，好让它穿起来非常合身。"
                            }
                        },
                        {
                            "text": "La ville a choisi de <w>rétrécir</w> la chaussée pour ajouter une piste cyclable.",
                            "target_lang_translations": {
                                "en": "The city has chosen to <w>narrow</w> the roadway to add a cycle lane.",
                                "ru": "Город решил <w>сузить</w> проезжую часть, чтобы добавить велосипедную дорожку.",
                                "de": "Die Stadt hat sich entschieden, die Fahrbahn zu <w>verengen</w>, um einen Radweg anzulegen.",
                                "es": "La ciudad ha decidido <w>estrechar</w> la calzada para añadir un carril bici.",
                                "zh": "这座城市决定<w>收窄</w>路面，以增设一条自行车道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resserrer",
                        "diminuer"
                    ],
                    "antonyms": [
                        "élargir",
                        "agrandir"
                    ],
                    "common_phrases": [
                        "rétrécir un vêtement",
                        "rétrécir la chaussée"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something narrower or reduce its dimensions.",
                        "ru": "Делать более узким или уменьшать размеры чего-либо.",
                        "de": "Etwas schmaler machen oder in seinen Abmessungen verringern.",
                        "es": "Hacer más estrecho algo o reducir sus dimensiones.",
                        "zh": "使某物变窄，或减小其尺寸。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "narrow",
                                "target_lang_sense_clarification": "making a road less wide"
                            },
                            {
                                "target_lang_word": "shrink",
                                "target_lang_sense_clarification": "making clothing or fabric smaller"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сужать",
                                "target_lang_sense_clarification": "дорогу, проход, улицу"
                            },
                            {
                                "target_lang_word": "ушивать",
                                "target_lang_sense_clarification": "одежду, убрать лишнее по ширине"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verengen",
                                "target_lang_sense_clarification": "Fahrbahnen, Straßenbreite"
                            },
                            {
                                "target_lang_word": "verschmälern",
                                "target_lang_sense_clarification": "Kleidung, besonders Hosen"
                            },
                            {
                                "target_lang_word": "verkleinern",
                                "target_lang_sense_clarification": "Flächen, Bauteile, Abmessungen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "estrechar",
                                "target_lang_sense_clarification": "calles, pasillos o pantalones"
                            },
                            {
                                "target_lang_word": "entallar",
                                "target_lang_sense_clarification": "prendas de vestir, ajustando la talla"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收窄",
                                "target_lang_sense_clarification": "道路、通道等变窄"
                            },
                            {
                                "target_lang_word": "改小",
                                "target_lang_sense_clarification": "修改衣物使尺寸变小"
                            },
                            {
                                "target_lang_word": "缩小",
                                "target_lang_sense_clarification": "缩减物体的尺寸或面积"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30d46f4e-d442-3711-ac26-fc1c85a7ea46",
                    "sense_definition": "Rendre plus borné ou plus limité au niveau intellectuel ou moral.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "limitation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet isolement prolongé a fini par <w>rétrécir</w> ses horizons culturels.",
                            "target_lang_translations": {
                                "en": "This prolonged isolation ended up <w>narrowing</w> their cultural horizons.",
                                "ru": "Затянувшаяся изоляция в конце концов <w>сузила</w> культурные горизонты.",
                                "de": "Diese langanhaltende Isolation hat seine kulturellen Horizonte schließlich <w>eingeengt</w>.",
                                "es": "Este aislamiento prolongado acabó por <w>estrechar</w> sus horizontes culturales.",
                                "zh": "这种长期的隔绝最终<w>限制</w>了他的文化视野。"
                            }
                        },
                        {
                            "text": "Ces certitudes rigides ont tendance à <w>rétrécir</w> la pensée.",
                            "target_lang_translations": {
                                "en": "These rigid certainties tend to <w>narrow</w> thinking.",
                                "ru": "Такие жёсткие убеждения склонны <w>ограничивать</w> мышление.",
                                "de": "Solche starren Gewissheiten neigen dazu, das Denken <w>einzuengen</w>.",
                                "es": "Estas certezas rígidas tienden a <w>limitar</w> el pensamiento.",
                                "zh": "这些僵化的固有观念往往会<w>局限</w>人的思维。"
                            }
                        }
                    ],
                    "synonyms": [
                        "borner",
                        "limiter"
                    ],
                    "antonyms": [
                        "élargir",
                        "développer"
                    ],
                    "common_phrases": [
                        "rétrécir les horizons"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone's outlook more limited, intellectually or morally.",
                        "ru": "Делать чей-либо кругозор или мышление более ограниченным в интеллектуальном или нравственном отношении.",
                        "de": "Den geistigen oder moralischen Horizont eines Menschen einschränken.",
                        "es": "Hacer que alguien tenga una visión más limitada, intelectual o moralmente.",
                        "zh": "使人在智识或道德上的眼界变得更加狭隘。"
                    },
