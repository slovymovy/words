                        "form": "die R-Gespräche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f5a862a-5bd4-308c-b054-a7bafa99c704",
                        "entry_id": "bdcd8c85-af00-3edb-9f64-a8a2d254a842",
                        "glosses": [
                            "Telefonat, bei dem der Angerufene die Kosten des Anrufs übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e515e1f-d09c-453f-abf9-2c3f8cf75975",
                                "sense_id": "8f5a862a-5bd4-308c-b054-a7bafa99c704",
                                "text": "„Leute rufen von weither an, und die Vermittlung fragt, ob ich die Gebühren für ein R-Gespräch, für den Hilferuf irgendeines Menschen übernehmen möchte.“"
                            },
                            {
                                "example_id": "3691ebdf-d1d3-4747-88c6-1dc648712dca",
                                "sense_id": "8f5a862a-5bd4-308c-b054-a7bafa99c704",
                                "text": "„Am nächsten Tag, als Bob Smith seine letzten Vereinbarungen mit dem Bestattungsunternehmen wegen der Beerdigung seiner Tochter traf, rief der Mörder wieder an, diesmal per R-Gespräch, und verlangte, mit Dawn zu sprechen.“"
                            },
                            {
                                "example_id": "a2081e6f-a368-4af8-8c71-d53e0195fc06",
                                "sense_id": "8f5a862a-5bd4-308c-b054-a7bafa99c704",
                                "text": "„Sie sagt: ›Wenn ich per R-Gespräch anrufe, übernimmst du dann die Kosten?‹“"
                            },
                            {
                                "example_id": "f450911a-47d7-40d6-97ef-53f6f51e9e06",
                                "sense_id": "8f5a862a-5bd4-308c-b054-a7bafa99c704",
                                "text": "„Kaum war Stacy Hubka aus dem kleinen abgeteilten Raum, meldete Starling ein R-Gespräch nach Washington an, um die Neuigkeiten zu erfahren.“"
                            },
                            {
                                "example_id": "88f05c30-e757-4190-a296-8592afcc7724",
                                "sense_id": "8f5a862a-5bd4-308c-b054-a7bafa99c704",
                                "text": "„Als sich die Vermittlung meldete, sagte Raymond Yu: ›Ich möchte ein R-Gespräch mit Voranmeldung führen, und zwar mit Mr. Fulvio Varvesi in Chicago.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
