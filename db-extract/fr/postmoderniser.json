                "senses": [
                    {
                        "sense_id": "b8dd54d3-86b7-3fc0-8ed4-9cb26961d06a",
                        "entry_id": "4ce39865-0cea-34e5-8c55-79c101025573",
                        "glosses": [
                            "Donner un caractère postmoderne à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd0a211-c4e5-4a77-864f-afbef49cef61",
                                "sense_id": "b8dd54d3-86b7-3fc0-8ed4-9cb26961d06a",
                                "text": "On croit ainsi introduire des changements structurels, mais on réussit tout au plus à « postmoderniser » la présentation de contenus assez vieux."
                            },
                            {
                                "example_id": "c0bead00-b188-40d0-b892-2119b2efe80e",
                                "sense_id": "b8dd54d3-86b7-3fc0-8ed4-9cb26961d06a",
                                "text": "La science, au contraire, ne peut s’en passer : elle ne peut pas se « postmoderniser »."
                            }
                        ]
                    }
