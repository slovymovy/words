{
    "word_family": [
        "transitional",
        "transit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a39d5b7f-2b60-3945-a815-d60e6af2d7d2",
                    "sense_definition": "The process or period of changing from one form, state, style, or place to another.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is undergoing a major <w>transition</w> to a new management style.",
                            "target_lang_translations": {
                                "ru": "Компания переживает серьезный <w>переход</w> к новому стилю управления.",
                                "zh": "公司正在经历向新管理风格的重大<w>过渡</w>。"
                            }
                        },
                        {
                            "text": "We hope for a smooth <w>transition</w> from the old system to the new one.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся на плавный <w>переход</w> от старой системы к новой.",
                                "zh": "我们希望从旧系统到新系统能有一个平稳的<w>过渡</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "stagnation"
                    ],
                    "common_phrases": [
                        "smooth transition",
                        "period of transition",
                        "in transition",
                        "make a transition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или период изменения из одной формы, состояния, стиля или места в другое.",
                        "zh": "从一种形式、状态、风格或地点改变为另一种的过程或时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "процесс изменения"
                            },
                            {
                                "target_lang_word": "переходный период",
                                "target_lang_sense_clarification": "период времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过渡",
                                "target_lang_sense_clarification": "过程或时期"
                            },
                            {
                                "target_lang_word": "转变",
                                "target_lang_sense_clarification": "状态或形式的改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a0fba88-1507-36f2-8289-8ad1840774ca",
                    "sense_definition": "The process of changing one's gender presentation or physical characteristics to accord with one's internal sense of gender identity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gender_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She documented her <w>transition</w> on social media to help others.",
                            "target_lang_translations": {
                                "ru": "Она документировала свой <w>переход</w> в социальных сетях, чтобы помочь другим.",
                                "zh": "她在社交媒体上记录了自己的<w>性别转换</w>过程，以帮助他人。"
                            }
                        },
                        {
                            "text": "Support from family is very important during a gender <w>transition</w>.",
                            "target_lang_translations": {
                                "ru": "Поддержка семьи очень важна во время гендерного <w>перехода</w>.",
                                "zh": "在<w>性别转换</w>期间，家人的支持非常重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gender transition"
                    ],
                    "common_phrases": [
                        "medical transition",
                        "social transition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс изменения гендерной презентации или физических характеристик в соответствии с внутренним ощущением гендерной идентичности.",
                        "zh": "为了符合内在的性别认同，改变性别表现或身体特征的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "гендерный"
                            },
                            {
                                "target_lang_word": "смена пола",
                                "target_lang_sense_clarification": "медицинский или социальный процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "性别转换",
                                "target_lang_sense_clarification": "跨性别过程"
                            },
                            {
                                "target_lang_word": "变性",
                                "target_lang_sense_clarification": "医学或社会层面的改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c552ed4-4431-3440-afdc-dada75f9ec21",
                    "sense_definition": "A word or phrase that connects one part of a text or speech to another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should use a <w>transition</w> to connect these two paragraphs smoothly.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать <w>связку</w>, чтобы плавно соединить эти два абзаца.",
                                "zh": "你应该使用一个<w>过渡词</w>来平滑地连接这两个段落。"
                            }
                        },
                        {
                            "text": "Words like 'however' and 'therefore' act as a <w>transition</w> between ideas.",
                            "target_lang_translations": {
                                "ru": "Слова вроде «однако» и «следовательно» действуют как <w>связка</w> между идеями.",
                                "zh": "像“然而”和“因此”这样的词在观点之间起到了<w>衔接</w>作用。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово или фраза, связывающая одну часть текста или речи с другой.",
                        "zh": "连接文本或演讲中不同部分的词语或短语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связка",
                                "target_lang_sense_clarification": "соединительный элемент"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "между частями текста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过渡词",
                                "target_lang_sense_clarification": "连接上下文的词汇"
                            },
                            {
                                "target_lang_word": "衔接语",
                                "target_lang_sense_clarification": "连接段落的短语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0abee42f-0ead-315a-84a1-7c7241a7cf47",
                    "sense_definition": "A musical passage that connects two different themes or sections.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer wrote a complex <w>transition</w> between the slow and fast movements.",
                            "target_lang_translations": {
                                "ru": "Композитор написал сложный <w>переход</w> между медленной и быстрой частями.",
                                "zh": "作曲家在慢板和快板乐章之间写了一段复杂的<w>过渡段</w>。"
                            }
                        },
                        {
                            "text": "A sudden <w>transition</w> leads the melody into a completely new key.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>переход</w> переводит мелодию в совершенно новую тональность.",
                                "zh": "一段突然的<w>转调</w>将旋律带入了一个全新的调性。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный фрагмент, соединяющий две разные темы или части.",
                        "zh": "连接两个不同主题或乐章的音乐片段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "музыкальный"
                            },
                            {
                                "target_lang_word": "модуляция",
                                "target_lang_sense_clarification": "смена тональности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过渡段",
                                "target_lang_sense_clarification": "音乐连接部分"
                            },
                            {
                                "target_lang_word": "转调",
                                "target_lang_sense_clarification": "音乐调性转换"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98dbfb65-823c-375c-b998-ae2f26d0f498",
                    "sense_definition": "A change from defense to attack, or from attack to defense, in sports.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team is excellent at the <w>transition</w> from defense to offense.",
                            "target_lang_translations": {
                                "ru": "Команда отлично выполняет <w>переход</w> от обороны к атаке.",
                                "zh": "这支球队在从防守到进攻的<w>攻守转换</w>方面表现出色。"
                            }
                        },
                        {
                            "text": "They lost the game because their <w>transition</w> was too slow.",
                            "target_lang_translations": {
                                "ru": "Они проиграли игру, потому что их <w>переход</w> был слишком медленным.",
                                "zh": "他们输掉了比赛，因为他们的<w>攻守转换</w>太慢了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смена тактики от обороны к атаке или от атаки к обороне в спорте.",
                        "zh": "体育运动中从防守转为进攻，或从进攻转为防守的战术转换。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "смена тактики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "攻守转换",
                                "target_lang_sense_clarification": "体育战术切换"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62fc2f97-40ab-3365-9456-0f58cb7a075c",
                    "sense_definition": "The passing from life into death.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family gathered to mark the anniversary of her <w>transition</w>.",
                            "target_lang_translations": {
                                "ru": "Семья собралась, чтобы отметить годовщину её <w>ухода</w>.",
                                "zh": "家人们聚在一起纪念她<w>离世</w>周年。"
                            }
                        },
                        {
                            "text": "He spoke of death as a peaceful <w>transition</w> to another place.",
                            "target_lang_translations": {
                                "ru": "Он говорил о смерти как о мирном <w>переходе</w> в другое место.",
                                "zh": "他将死亡描述为通往另一个地方的平静<w>过渡</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уход из жизни; смерть (эвфемизм).",
                        "zh": "从生到死的转变；死亡（委婉语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "смерть"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "в мир иной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离世",
                                "target_lang_sense_clarification": "死亡的委婉说法"
                            },
                            {
                                "target_lang_word": "归天",
                                "target_lang_sense_clarification": "宗教或文学上的过渡"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28af86ed-9324-3fa9-a9cb-a8887f9c64ca",
                    "sense_definition": "To change or move from one state, stage, or place to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The business successfully <w>transitioned</w> to a remote work model.",
                            "target_lang_translations": {
                                "ru": "Бизнес успешно <w>перешел</w> на модель удаленной работы.",
                                "zh": "该企业成功<w>转型</w>为远程办公模式。"
                            }
                        },
                        {
                            "text": "It can be difficult to <w>transition</w> from being a student to an employee.",
                            "target_lang_translations": {
                                "ru": "Бывает трудно <w>перейти</w> от статуса студента к статусу работника.",
                                "zh": "从学生身份<w>过渡</w>到职员身份可能会很困难。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "transition to",
                        "transition from",
                        "transition into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Менять или перемещаться из одного состояния, стадии или места в другое.",
                        "zh": "从一种状态、阶段或地点改变或移动到另一种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "менять состояние"
                            },
                            {
                                "target_lang_word": "перестраиваться",
                                "target_lang_sense_clarification": "адаптироваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过渡",
                                "target_lang_sense_clarification": "改变状态"
                            },
                            {
                                "target_lang_word": "转型",
                                "target_lang_sense_clarification": "改变模式或结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50cb7024-a961-35b4-a77f-58f76983e1c7",
                    "sense_definition": "To undergo the process of changing one's gender presentation or physical characteristics.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gender_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>transitioned</w> several years ago and is much happier now.",
                            "target_lang_translations": {
                                "ru": "Он <w>совершил переход</w> несколько лет назад и теперь намного счастливее.",
                                "zh": "他几年前<w>完成了性别转换</w>，现在快乐多了。"
                            }
                        },
                        {
                            "text": "They decided to <w>transition</w> socially before considering medical steps.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>совершить социальный переход</w> до рассмотрения медицинских шагов.",
                                "zh": "他们决定在考虑医疗手段之前先<w>进行社会性别转换</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить процесс изменения гендерной презентации или физических характеристик.",
                        "zh": "经历改变性别表现或身体特征的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершить переход",
                                "target_lang_sense_clarification": "гендерный"
                            },
                            {
                                "target_lang_word": "сменить пол",
                                "target_lang_sense_clarification": "физически или социально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行性别转换",
                                "target_lang_sense_clarification": "跨性别过程"
                            },
                            {
                                "target_lang_word": "变性",
                                "target_lang_sense_clarification": "改变性别"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}