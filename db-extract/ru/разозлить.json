                                        "sense_id": "f181cede-0fc1-3141-bb9c-83d46799668b",
                                        "entry_id": "1ad3448a-12aa-32aa-b80b-8ab9aff458cd",
                                        "glosses": [
                                            "Fâcher quelqu’un, déclencher la colère de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e314840-4e8e-4111-a94e-83d0ff0f9165",
                                                "sense_id": "f181cede-0fc1-3141-bb9c-83d46799668b",
                                                "text": "Pour autant, les chiffres publiés récemment par les autorités montrent une « surmortalité exceptionnelle » dans le département de la Seine-Saint-Denis. Ces chiffres doivent encore faire l’objet d’analyse mais ils nous mettent en colère."
                                            },
                                            {
                                                "example_id": "74e2a675-c964-4170-a0cf-32a1ceac0f44",
                                                "sense_id": "f181cede-0fc1-3141-bb9c-83d46799668b",
                                                "text": "Ce retard de bus m’a mis en colère : à cause de lui, j’ai également manqué mon train."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
