                    "sense_id": "c35035ac-534b-3eaf-9937-3e3030e2eed9",
                    "sense_definition": "Very pleased, happy, or satisfied.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleased",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was absolutely <w>chuffed</w> when she found out she had passed her driving test.",
                            "target_lang_translations": {
                                "tr": "Direksiyon sınavını geçtiğini öğrendiğinde kesinlikle <w>çok memnun olmuştu</w>."
                            }
                        },
                        {
                            "text": "He looked really <w>chuffed</w> to bits with his new birthday present.",
                            "target_lang_translations": {
                                "tr": "Yeni doğum günü hediyesi karşısında gerçekten <w>havalara uçmuş</w> gibi görünüyordu."
                            }
                        }
                    ],
                    "synonyms": [
