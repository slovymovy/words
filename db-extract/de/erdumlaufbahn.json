                "senses": [
                    {
                        "sense_id": "25a1dfbd-40bf-3619-9595-63cb93dd70d4",
                        "entry_id": "170c506a-7f83-3c4f-ab34-ac19fc27d3c0",
                        "glosses": [
                            "Bahnkurve, auf der ein Satellit die Erde umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88f80fe8-cca2-4364-b7af-e3dad0ac55ec",
                                "sense_id": "25a1dfbd-40bf-3619-9595-63cb93dd70d4",
                                "text": "Der erste Satellit hatte den Namen „Sputnik“ und wurde am 4. Oktober 1957 in eine Erdumlaufbahn geschossen."
                            },
                            {
                                "example_id": "d4a01747-25eb-4ee5-95ae-243a724adef4",
                                "sense_id": "25a1dfbd-40bf-3619-9595-63cb93dd70d4",
                                "text": "Die Erdumlaufbahn der internationalen Raumstation ist in etwa 350 km Höhe."
                            },
                            {
                                "example_id": "785beb50-834f-49ce-b6d5-37313c82e104",
                                "sense_id": "25a1dfbd-40bf-3619-9595-63cb93dd70d4",
                                "text": "„Die zweite Astronautik eines Hundes, die am 3. November 1957 stattfand, endete wie die erste: Laika erstickte in der Erdumlaufbahn, nachdem der Sauerstoff in der Kapsel zu Ende gegangen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
