                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e08c993-13eb-46a5-94e8-15c0ec7f05e8",
                                                "sense_id": "a1801ba9-cb8c-3531-b6a2-220811ffa5bf",
                                                "text": "Anodynia (anorectal pain) most frequently occurs together with other pain syndromes, like vulvodynia or phallodynia, but sometimes it may be isolated."
                                            }
                                        ]
