{
    "word_family": [
        "babyhood",
        "babyish",
        "babysit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b3b9de8-e529-3ea6-8b4f-9140ab7b51d9",
                    "sense_definition": "A very young human, particularly from birth to a couple of years old or until walking is fully mastered.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "young_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>baby</w> started crying because he was hungry.",
                            "target_lang_translations": {
                                "ru": "<w>Малыш</w> заплакал, потому что был голоден.",
                                "pl": "<w>Dziecko</w> zaczęło płakać, ponieważ było głodne."
                            }
                        },
                        {
                            "text": "She held the sleeping <w>baby</w> in her arms.",
                            "target_lang_translations": {
                                "ru": "Она держала спящего <w>младенца</w> на руках.",
                                "pl": "Trzymała śpiące <w>niemowlę</w> w ramionach."
                            }
                        }
                    ],
                    "synonyms": [
                        "infant",
                        "babe",
                        "bairn"
                    ],
                    "antonyms": [
                        "adult",
                        "grown-up"
                    ],
                    "common_phrases": [
                        "new baby",
                        "baby boy",
                        "baby girl",
                        "crying baby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленький ребёнок, от рождения до нескольких лет.",
                        "pl": "Bardzo małe dziecko, od urodzenia do około drugiego roku życia lub do momentu, gdy zacznie stabilnie chodzić."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "младенец",
                                "target_lang_sense_clarification": "грудной ребёнок"
                            },
                            {
                                "target_lang_word": "малыш",
                                "target_lang_sense_clarification": "маленький ребёнок"
                            },
                            {
                                "target_lang_word": "ребёнок",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niemowlę",
                                "target_lang_sense_clarification": "bardzo małe dziecko, które jeszcze nie mówi"
                            },
                            {
                                "target_lang_word": "niemowlak",
                                "target_lang_sense_clarification": "potocznie o niemowlęciu"
                            },
                            {
                                "target_lang_word": "maluch",
                                "target_lang_sense_clarification": "potocznie o małym dziecku"
                            },
                            {
                                "target_lang_word": "dziecko",
                                "target_lang_sense_clarification": "ogólne określenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94e12eb6-0434-390c-8000-f14f7d780a19",
                    "sense_definition": "A person's romantic partner; a term of endearment used to refer to one's girlfriend, boyfriend, or spouse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "endearment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love you so much, <w>baby</w>.",
                            "target_lang_translations": {
                                "ru": "Я так сильно люблю тебя, <w>малыш</w>.",
                                "pl": "Tak bardzo cię kocham, <w>kochanie</w>."
                            }
                        },
                        {
                            "text": "Hey <w>baby</w>, do you want to go to the movies tonight?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>детка</w>, хочешь пойти в кино сегодня вечером?",
                                "pl": "Hej <w>mała</w>, chcesz iść dziś wieczorem do kina?"
                            }
                        }
                    ],
                    "synonyms": [
                        "sweetheart",
                        "love",
                        "babe",
                        "honey",
                        "darling"
                    ],
                    "common_phrases": [
                        "my baby",
                        "hey baby"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a term of affection"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к любимому человеку (девушке или парню).",
                        "pl": "Partner romantyczny; czułe określenie używane w stosunku do dziewczyny, chłopaka lub małżonka."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малыш",
                                "target_lang_sense_clarification": "обращение к парню или девушке"
                            },
                            {
                                "target_lang_word": "детка",
                                "target_lang_sense_clarification": "разговорное, обычно к девушке"
                            },
                            {
                                "target_lang_word": "крошка",
                                "target_lang_sense_clarification": "разговорное, ласковое"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kochanie",
                                "target_lang_sense_clarification": "czuły zwrot do ukochanej osoby"
                            },
                            {
                                "target_lang_word": "skarb",
                                "target_lang_sense_clarification": "czułe określenie bliskiej osoby"
                            },
                            {
                                "target_lang_word": "mała",
                                "target_lang_sense_clarification": "potocznie i poufale do kobiety"
                            },
                            {
                                "target_lang_word": "bejbe",
                                "target_lang_sense_clarification": "slangowo, spolszczone zapożyczenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ef250b3-c4c6-364d-96aa-bf93f76d9432",
                    "sense_definition": "A very young human, even if not yet born.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "young_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt the <w>baby</w> kick for the first time yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера она впервые почувствовала, как <w>ребёнок</w> толкается.",
                                "pl": "Wczoraj po raz pierwszy poczuła ruchy <w>dziecka</w>."
                            }
                        },
                        {
                            "text": "When is your <w>baby</w> due?",
                            "target_lang_translations": {
                                "ru": "Когда у тебя родится <w>ребёнок</w>?",
                                "pl": "Na kiedy masz termin porodu <w>dziecka</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a baby",
                        "baby is due"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ещё не родившийся ребёнок.",
                        "pl": "Bardzo młody człowiek, nawet jeśli jeszcze się nie narodził."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ребёнок",
                                "target_lang_sense_clarification": "в утробе матери"
                            },
                            {
                                "target_lang_word": "малыш",
                                "target_lang_sense_clarification": "ласково о будущем ребёнке"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dziecko",
                                "target_lang_sense_clarification": "w łonie matki"
                            },
                            {
                                "target_lang_word": "dzidziuś",
                                "target_lang_sense_clarification": "pieszczotliwie o nienarodzonym lub nowo narodzonym dziecku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03db69e5-24dc-31f9-bd34-6e44a5274ad3",
                    "sense_definition": "Any very young animal.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "young_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a <w>baby</w> elephant at the zoo.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>детёныша</w> слона в зоопарке.",
                                "pl": "Widzieliśmy <w>małego</w> słonia w zoo."
                            }
                        },
                        {
                            "text": "The mother bird was feeding her <w>baby</w> in the nest.",
                            "target_lang_translations": {
                                "ru": "Птица-мать кормила своего <w>птенца</w> в гнезде.",
                                "pl": "Matka ptak karmiła swoje <w>pisklę</w> w gnieździe."
                            }
                        }
                    ],
                    "synonyms": [
                        "young"
                    ],
                    "common_phrases": [
                        "baby bird",
                        "baby animal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детёныш животного.",
                        "pl": "Każde bardzo młode zwierzę."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детёныш",
                                "target_lang_sense_clarification": "общее название для животных"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "młode",
                                "target_lang_sense_clarification": "potomek zwierzęcia"
                            },
                            {
                                "target_lang_word": "maluch",
                                "target_lang_sense_clarification": "potocznie o małym zwierzęciu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c28c7f59-2867-35fb-a150-2f0fec6615d4",
                    "sense_definition": "A person who is immature, infantile, or feeble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop complaining and don't be such a <w>baby</w>.",
                            "target_lang_translations": {
                                "ru": "Хватит жаловаться, не будь таким <w>ребёнком</w>.",
                                "pl": "Przestań narzekać i nie bądź takim <w>dzieciuchem</w>."
                            }
                        },
                        {
                            "text": "He is acting like a <w>baby</w> just because he lost the game.",
                            "target_lang_translations": {
                                "ru": "Он ведёт себя как <w>маленький</w>, просто потому что проиграл.",
                                "pl": "Zachowuje się jak <w>dziecko</w> tylko dlatego, że przegrał grę."
                            }
                        }
                    ],
                    "synonyms": [
                        "big baby"
                    ],
                    "common_phrases": [
                        "such a baby",
                        "don't be a baby"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведёт себя инфантильно или капризно.",
                        "pl": "Osoba niedojrzała, zachowująca się dziecinnie lub słaba psychicznie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ребёнок",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "дитя",
                                "target_lang_sense_clarification": "ироничное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dzieciuch",
                                "target_lang_sense_clarification": "dorosły zachowujący się niedojrzale"
                            },
                            {
                                "target_lang_word": "dziecko",
                                "target_lang_sense_clarification": "przenośnie o osobie niedojrzałej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "175831e0-128c-3551-b08f-a835120204af",
                    "sense_definition": "The lastborn of a family; the youngest sibling, irrespective of age.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "family_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though he is thirty, he is still the <w>baby</w> of the family.",
                            "target_lang_translations": {
                                "ru": "Хоть ему и тридцать, он всё ещё <w>малыш</w> в семье.",
                                "pl": "Mimo że ma trzydzieści lat, nadal jest <w>najmłodszy</w> w rodzinie."
                            }
                        },
                        {
                            "text": "My sister is the <w>baby</w>, so she gets away with everything.",
                            "target_lang_translations": {
                                "ru": "Моя сестра — <w>самая младшая</w>, поэтому ей всё сходит с рук.",
                                "pl": "Moja siostra jest <w>najmłodsza</w>, więc wszystko uchodzi jej na sucho."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baby of the family"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый младший ребёнок в семье.",
                        "pl": "Najmłodsze dziecko w rodzinie, niezależnie od jego obecnego wieku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "младшенький",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "малыш",
                                "target_lang_sense_clarification": "в контексте семьи"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "najmłodszy",
                                "target_lang_sense_clarification": "najmłodsze dziecko w rodzinie"
                            },
                            {
                                "target_lang_word": "beniaminek",
                                "target_lang_sense_clarification": "najmłodszy, często rozpieszczany członek rodziny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c83be271-ccf9-3455-9fa2-d376a878ca68",
                    "sense_definition": "A pet project or responsibility.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should talk to the manager about that project because it is his <w>baby</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит поговорить с менеджером об этом проекте, потому что это его <w>детище</w>.",
                                "pl": "Powinieneś porozmawiać z menedżerem o tym projekcie, bo to jego <w>dziecko</w>."
                            }
                        },
                        {
                            "text": "This new software design is my <w>baby</w>, and I want it to be perfect.",
                            "target_lang_translations": {
                                "ru": "Этот новый дизайн программы — моё <w>детище</w>, и я хочу, чтобы он был идеальным.",
                                "pl": "Ten nowy projekt oprogramowania to moje <w>dziecko</w> i chcę, żeby był idealny."
                            }
                        }
                    ],
                    "common_phrases": [
                        "his baby",
                        "my baby"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "metaphorical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любимое дело, проект или идея, которые человек опекает.",
                        "pl": "Własny, ważny projekt, przedsięwzięcie lub odpowiedzialność, o którą się bardzo dba."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детище",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dziecko",
                                "target_lang_sense_clarification": "przenośnie o własnym dziele lub projekcie"
                            },
                            {
                                "target_lang_word": "dzieło życia",
                                "target_lang_sense_clarification": "bardzo ważny, osobisty projekt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                    "sense_definition": "Like or pertaining to a baby, in size or youth; small, young.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adjectival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has such a smooth <w>baby</w> face.",
                            "target_lang_translations": {
                                "ru": "У неё такое гладкое <w>детское</w> личико.",
                                "pl": "Ma taką gładką, <w>dziecięcą</w> twarz."
                            }
                        },
                        {
                            "text": "We need to buy some <w>baby</w> clothes for the shower gift.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить <w>детскую</w> одежду в подарок.",
                                "pl": "Musimy kupić jakieś ubranka <w>niemowlęce</w> na prezent z okazji narodzin."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baby clothes",
                        "baby face",
                        "baby teeth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к младенцу; маленький или детский.",
                        "pl": "Przypominający niemowlę lub odnoszący się do niego pod względem wielkości lub wieku; dziecięcy, mały."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детский",
                                "target_lang_sense_clarification": "принадлежащий ребёнку"
                            },
                            {
                                "target_lang_word": "младенческий",
                                "target_lang_sense_clarification": "свойственный младенцу"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dziecięcy",
                                "target_lang_sense_clarification": "odnoszący się do dzieci lub niemowląt"
                            },
                            {
                                "target_lang_word": "niemowlęcy",
                                "target_lang_sense_clarification": "właściwy niemowlęciu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89d7d804-9a5a-32f8-a4bf-a5d9029682f1",
                    "sense_definition": "Picked when small and immature (as in vegetables).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adjectival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to put <w>baby</w> spinach in my salad.",
                            "target_lang_translations": {
                                "ru": "Я люблю класть <w>молодой</w> шпинат в салат.",
                                "pl": "Lubię dodawać <w>młody</w> szpinak do sałatki."
                            }
                        },
                        {
                            "text": "The recipe calls for fresh <w>baby</w> carrots.",
                            "target_lang_translations": {
                                "ru": "В рецепте нужна свежая <w>молодая</w> морковь.",
                                "pl": "Przepis wymaga świeżych, <w>młodych</w> marchewek."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baby corn",
                        "baby carrots",
                        "baby potatoes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой, мелкий (об овощах).",
                        "pl": "Zbierany, gdy jest jeszcze mały i niedojrzały (np. o warzywach)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодой",
                                "target_lang_sense_clarification": "раннего сбора"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "młody",
                                "target_lang_sense_clarification": "o warzywach wczesnego zbioru"
                            },
                            {
                                "target_lang_word": "mini",
                                "target_lang_sense_clarification": "o małych odmianach warzyw"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2bd32da-5efb-3391-bcec-46034dd1e1cd",
                    "sense_definition": "To coddle; to pamper somebody like an infant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is old enough to take care of himself, so stop <w>babying</w> him.",
                            "target_lang_translations": {
                                "ru": "Он достаточно взрослый, чтобы позаботиться о себе, так что перестань с ним <w>нянчиться</w>.",
                                "pl": "Jest już na tyle dorosły, by o siebie zadbać, więc przestań go <w>niańczyć</w>."
                            }
                        },
                        {
                            "text": "She loves to be <w>babied</w> when she is feeling sick.",
                            "target_lang_translations": {
                                "ru": "Она любит, когда с ней <w>сюсюкаются</w>, когда она болеет.",
                                "pl": "Lubi, gdy się nad nią <w>rozczulają</w>, kiedy źle się czuje."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop babying"
                    ],
                    "target_lang_definitions": {
                        "ru": "Няньчиться, чрезмерно опекать кого-то.",
                        "pl": "Rozpieszczać, traktować kogoś nadopiekuńczo jak małe dziecko."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нянчиться",
                                "target_lang_sense_clarification": "опекать"
                            },
                            {
                                "target_lang_word": "сюсюкаться",
                                "target_lang_sense_clarification": "проявлять излишнюю нежность"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "nianńczyć",
                                "target_lang_sense_clarification": "nadmiernie się kimś opiekować"
                            },
                            {
                                "target_lang_word": "rozpieszczać",
                                "target_lang_sense_clarification": "traktować z przesadną pobłażliwością"
                            }
                        ]
                    }
