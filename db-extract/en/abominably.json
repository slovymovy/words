                                        "examples": [
                                            {
                                                "example_id": "3f7d43da-5dd7-4985-9801-37431b25fa65",
                                                "sense_id": "5c99ab69-1051-312a-8e9c-454941963fb9",
                                                "text": "Je n’en ai pas voulu parce qu’outre qu’il louchait abominablement ; il aurait fallu me séparer de ma fille, et, de fait, je ne m’en souciais pas."
                                            },
                                            {
                                                "example_id": "64bd2c69-25c0-4f93-ba71-17db3402c0e8",
                                                "sense_id": "5c99ab69-1051-312a-8e9c-454941963fb9",
                                                "text": "Pibrac y avait déjeuné aussi, quoi qu'il se fût abominablement grisé au Grand-Quinze, mais il ne paraissait pas encore très bien remis des excès de ce souper […]."
                                            },
                                            {
                                                "example_id": "775e1a0b-1c61-4ecb-a04d-0313d616211a",
                                                "sense_id": "5c99ab69-1051-312a-8e9c-454941963fb9",
                                                "text": "Il se conduit abominablement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c944477-5966-3eaf-afd6-7c09e3a76fc1",
                                        "entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                                        "glosses": [
                                            "Il se dit aussi par exagération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1822a832-91d4-4b50-a5e0-05f9089f04e9",
                                                "sense_id": "3c944477-5966-3eaf-afd6-7c09e3a76fc1",
                                                "text": "Il chante, il écrit abominablement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
