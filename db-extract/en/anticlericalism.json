                        "entry_id": "256c0dea-3373-3d29-9dd6-755051526302",
                        "glosses": [
                            "The opposition to political influence of clerics."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7210ed2-4f0d-447b-959a-1c73ec6aade0",
                                "sense_id": "5e0d0842-83dd-311a-b61f-6ce587457831",
                                "text": "But contacts of this kind between a senior politician of the Republic and the Catholic Church were matters of the greatest delicacy in pre-1914 France, where anticlericalism was the default setting of the political culture."
                            }
                        ]
