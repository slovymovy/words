                        "examples": [
                            {
                                "example_id": "45ae99ce-1664-4315-8958-7949cfab8ba8",
                                "sense_id": "ab5cf9d0-d817-3eda-a050-a5bf5be197b6",
                                "text": "Catharina-Amalia Beatrix Carmen Victoria, zoals Amalia volledig heet, heeft sinds de inhuldiging van haar vader de titel prinses van Oranje. Ze is de eerste in de lijn van troonopvolging. Amalia werd op 7 december 2003 in Den Haag geboren."
                            },
                            {
                                "example_id": "5fe1aa97-4e01-49ec-a6f1-7371bf177eee",
                                "sense_id": "ab5cf9d0-d817-3eda-a050-a5bf5be197b6",
                                "text": "Overigens had Harry een groter probleem dan de titel van zijn vrouw gehad als er in 2015 geen hervormingen in de troonopvolging waren doorgevoerd."
                            }
                        ]
                    }
