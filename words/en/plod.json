{
    "word_family": [
        "plodder",
        "ploddingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e57c6f2-11b2-311a-ba3d-dcc5f297a68e",
                    "sense_definition": "To walk or move slowly and heavily or laboriously.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired hiker continued to <w>plod</w> through the deep snow.",
                            "target_lang_translations": {
                                "zh": "疲惫的徒步旅行者继续在深雪中<w>蹒跚</w>前行。"
                            }
                        },
                        {
                            "text": "We had to <w>plod</w> along the muddy path after the heavy rain.",
                            "target_lang_translations": {
                                "zh": "大雨过后，我们不得不沿着泥泞的小路<w>艰难地走</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plod along",
                        "plod through"
                    ],
                    "target_lang_definitions": {
                        "zh": "指沉重、缓慢地行走或移动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蹒跚",
                                "target_lang_sense_clarification": "形容走路缓慢摇摆的样子。"
                            },
                            {
                                "target_lang_word": "沉重地走",
                                "target_lang_sense_clarification": "强调步履沉重。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22999a47-b01e-3c44-a0b4-fc6d4cd9737a",
                    "sense_definition": "To work or study in a slow, laborious, and patient manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>plod</w> through hundreds of pages of research for her thesis.",
                            "target_lang_translations": {
                                "zh": "为了论文，她不得不<w>埋头苦读</w>数百页的研究资料。"
                            }
                        },
                        {
                            "text": "Even when the work became boring, he continued to <w>plod</w> away at his desk.",
                            "target_lang_translations": {
                                "zh": "即使工作变得枯燥，他依然在书桌前<w>埋头苦干</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plod away"
                    ],
                    "target_lang_definitions": {
                        "zh": "指以缓慢、费力且耐心的方式工作或学习。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "埋头苦干",
                                "target_lang_sense_clarification": "形容刻苦钻研或工作。"
                            },
                            {
                                "target_lang_word": "啃",
                                "target_lang_sense_clarification": "口语中指费力地攻克难懂的资料。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85d2e2e1-eaf5-3352-b452-dd05b43126a7",
                    "sense_definition": "To travel across or through a specific area with difficulty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers had to <w>plod</w> the frozen fields during the winter campaign.",
                            "target_lang_translations": {
                                "zh": "在冬季战役中，士兵们不得不<w>跋涉</w>过冰封的田野。"
                            }
                        },
                        {
                            "text": "They had to <w>plod</w> the long, dusty road to reach the village by nightfall.",
                            "target_lang_translations": {
                                "zh": "他们必须<w>跋涉</w>过漫长而尘土飞扬的道路，才能在天黑前到达村庄。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指艰难地穿越某地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跋涉",
                                "target_lang_sense_clarification": "形容长途跋涉，路途艰辛。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01dd4fb2-8cc4-37a3-a12d-38adc4590746",
                    "sense_definition": "To process material like soap or margarine by forcing it through a die plate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is designed to <w>plod</w> the soap mixture into uniform bars.",
                            "target_lang_translations": {
                                "zh": "这台机器旨在将肥皂混合物<w>挤压</w>成均匀的条状。"
                            }
                        },
                        {
                            "text": "Workers must <w>plod</w> the margarine to ensure the correct texture before packaging.",
                            "target_lang_translations": {
                                "zh": "工人在包装前必须将人造黄油<w>挤压</w>以确保其质地正确。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过模具挤压加工肥皂或人造黄油等材料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挤压",
                                "target_lang_sense_clarification": "工业加工中的挤压成型。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c57aa351-e59f-33bc-b370-2e1f5d45692d",
                    "sense_definition": "A slow or labored walk or movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long race, his walk turned into a tired <w>plod</w>.",
                            "target_lang_translations": {
                                "zh": "长跑结束后，他的步伐变成了疲惫的<w>蹒跚</w>。"
                            }
                        },
                        {
                            "text": "The heavy <w>plod</w> of boots echoed through the empty hallway.",
                            "target_lang_translations": {
                                "zh": "靴子沉重的<w>脚步声</w>在空荡荡的走廊里回响。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指沉重或缓慢的步伐。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉重的脚步",
                                "target_lang_sense_clarification": "形容走路缓慢且沉重。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f627dd0-5ced-32af-bc0e-a1b7b08211bd",
                    "sense_definition": "The police force or police officers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>plod</w> arrived at the scene shortly after the alarm was raised.",
                            "target_lang_translations": {
                                "zh": "警报响起后不久，<w>警察</w>就到达了现场。"
                            }
                        },
                        {
                            "text": "He tried to avoid the <w>plod</w> while running through the city center.",
                            "target_lang_translations": {
                                "zh": "他在穿过市中心时试图避开<w>警察</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "police"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English, derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指警察部队（英国俚语，贬义）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "警察",
                                "target_lang_sense_clarification": "指代执法人员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55bd8a0e-55cc-35a4-acd3-74811820d892",
                    "sense_definition": "A police officer, especially one of low rank.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>plod</w> was patrolling the neighborhood on foot.",
                            "target_lang_translations": {
                                "zh": "当地的<w>警员</w>正在社区里徒步巡逻。"
                            }
                        },
                        {
                            "text": "He was stopped by a <w>plod</w> for a minor traffic violation.",
                            "target_lang_translations": {
                                "zh": "他因轻微交通违规被一名<w>警员</w>拦下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "police officer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English, derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指警察，尤指低阶警员（英国俚语，贬义）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "警员",
                                "target_lang_sense_clarification": "指代具体的警察个人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87f049e0-7015-37ab-8e2c-355649983c6c",
                    "sense_definition": "A puddle of water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child jumped into a muddy <w>plod</w> after the storm.",
                            "target_lang_translations": {
                                "zh": "暴风雨过后，孩子跳进了一个泥泞的<w>水坑</w>里。"
                            }
                        },
                        {
                            "text": "His shoes were soaked after stepping into a deep <w>plod</w>.",
                            "target_lang_translations": {
                                "zh": "他踩进一个深<w>水坑</w>后，鞋子全湿了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指水坑（方言用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "水坑",
                                "target_lang_sense_clarification": "地面上的积水。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}