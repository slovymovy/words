{
    "word_family": [
        "impend",
        "impendence",
        "impendency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d4cb63f4-b772-3ef5-9766-32967bbbf249",
                    "sense_definition": "Approaching; drawing near; about to happen or expected to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "approaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team worked hard to prepare for the <w>impending</w> deadline.",
                            "target_lang_translations": {
                                "de": "Das Team arbeitete hart, um sich auf die <w>bevorstehende</w> Frist vorzubereiten."
                            }
                        },
                        {
                            "text": "Everyone felt nervous about the <w>impending</w> storm.",
                            "target_lang_translations": {
                                "de": "Jeder war nervös wegen des <w>drohenden</w> Sturms."
                            }
                        }
                    ],
                    "synonyms": [
                        "imminent",
                        "forthcoming",
                        "upcoming"
                    ],
                    "antonyms": [
                        "happening"
                    ],
                    "common_phrases": [
                        "impending doom",
                        "impending danger",
                        "impending deadline"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das kurz bevorsteht oder in naher Zukunft erwartet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bevorstehend",
                                "target_lang_sense_clarification": "allgemein für Ereignisse, die bald eintreten"
                            },
                            {
                                "target_lang_word": "drohend",
                                "target_lang_sense_clarification": "speziell für negative Ereignisse oder Gefahren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c543c930-b565-3556-bf6c-8a94dbe49c8e",
                    "sense_definition": "Something that impends or threatens; an expected event.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "approaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Animals often seem to sense natural <w>impendings</w> like earthquakes before they occur.",
                            "target_lang_translations": {
                                "de": "Tiere scheinen oft natürliche <w>drohende Ereignisse</w> wie Erdbeben zu spüren, bevor sie eintreten."
                            }
                        },
                        {
                            "text": "She tried to remain calm despite her fear of future <w>impendings</w>.",
                            "target_lang_translations": {
                                "de": "Sie versuchte trotz ihrer Angst vor zukünftigen <w>drohenden Ereignissen</w> ruhig zu bleiben."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Ereignis, das sich ankündigt oder droht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "drohendes Ereignis",
                                "target_lang_sense_clarification": "ein Ereignis, das sich ankündigt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0da87d5-0ab0-30f2-afa6-63a9b20ee1d9",
                    "sense_definition": "Present participle and gerund of <w>impend</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "approaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds were <w>impending</w> over the valley all afternoon.",
                            "target_lang_translations": {
                                "de": "Die dunklen Wolken <w>drohten</w> den ganzen Nachmittag über dem Tal."
                            }
                        },
                        {
                            "text": "A sense of dread was <w>impending</w> throughout the entire meeting.",
                            "target_lang_translations": {
                                "de": "Ein Gefühl der Beklemmung <w>drohte</w> während des gesamten Treffens."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb impend."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das Partizip Präsens des Verbs 'impend' (drohen, bevorstehen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "drohend",
                                "target_lang_sense_clarification": "als Partizip oder Adjektiv verwendet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}