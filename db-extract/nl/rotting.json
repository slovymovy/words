                                "example_id": "5d30244f-6309-4778-88e1-7341a30ad704",
                                "sense_id": "72d2c768-c80a-3870-b3a4-0842a22ae1c3",
                                "text": "In dit practicum ga je onderzoeken hoe specifiek de relatie is tussen veroorzakers van rotting in verschillende soorten fruit en groenten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6acf48ca-af1e-4a4b-b04e-ae184406b8cf",
