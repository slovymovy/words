                        "portée symbolique",
                        "valeur symbolique"
                    ]
                },
                {
                    "sense_id": "f78fb4f9-9855-3896-afac-c26fdd0bb9ed",
                    "sense_definition": "Qui a une valeur purement représentative ou minime, sans rapport avec la valeur réelle.",
