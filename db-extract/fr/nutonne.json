                        "glosses": [
                            "Femme du nuton, petite créature du folklore et des croyances populaires des Ardennes françaises et de la Belgique, très proche du lutin."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "7ee509c1-8065-4b6a-b483-79d15f0d5d77",
                                "sense_id": "af2e57b7-650b-39b1-a49d-55bcebd596dd",
                                "text": "Les nutonnes, elles, portaient de jolis bonnets plissés, tandis qu’on n'est pas bien fixé sur la tenue de leurs hommes, sans doute vêtus d’un pantalon et d’une vareuse plus ou moins ajustée et peut-être d’une cape."
                            }
                        ]
                    }
