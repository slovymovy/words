                                                "sense_id": "e74e452a-522f-30f6-8b99-d3919ca0b3d4",
                                                "text": "She kissed him sexually."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3daaa3a1-b17d-3375-8538-e99a0062dff0",
                                        "entry_id": "827c1173-b97c-30f4-8c95-3b673346b627",
                                        "glosses": [
                                            "With respect to sex (either of the two divisions of organisms)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9a4a6f9-30c4-4fba-be26-eb543d511641",
                                                "sense_id": "3daaa3a1-b17d-3375-8538-e99a0062dff0",
                                                "text": "The firm discriminated sexually in its hiring and retention practices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa45599c-a3ab-3995-afbb-fe04862133df",
                                        "entry_id": "827c1173-b97c-30f4-8c95-3b673346b627",
                                        "glosses": [
                                            "With respect to sexual intercourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e487f6b9-95e9-4d9f-9c53-ee92b9804a0c",
                                                "sense_id": "aa45599c-a3ab-3995-afbb-fe04862133df",
                                                "text": "He was sexually active by the age of fifteen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae37a94-b8e0-3955-9688-3144f5e6610a",
                                        "entry_id": "827c1173-b97c-30f4-8c95-3b673346b627",
                                        "glosses": [
                                            "By means of sexual intercourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab35f28-3509-4e4b-828c-cf9c2374a7b4",
                                                "sense_id": "4ae37a94-b8e0-3955-9688-3144f5e6610a",
                                                "text": "AIDS and gonorrhea are sexually transmitted diseases."
                                            },
                                            {
                                                "example_id": "053be14f-cd38-466a-b634-9ee5a6ac0480",
                                                "sense_id": "4ae37a94-b8e0-3955-9688-3144f5e6610a",
                                                "text": "A parrot is a sexually reproducing organism."
                                            },
                                            {
                                                "example_id": "e6297387-69e7-4d1e-b824-9703e1dd0836",
                                                "sense_id": "4ae37a94-b8e0-3955-9688-3144f5e6610a",
                                                "text": "NBC, never shy about exploiting a celebrity tragedy, overproduced and overpromoted her film in “Farrah’s Story,” but never made the public service point that, besides abstinence, the HPV vaccine is the most promising form of prevention against this type of cancer, which in most cases is sexually acquired."
                                            }
                                        ]
