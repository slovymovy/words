                "senses": [
                    {
                        "sense_id": "7b625eca-c037-39f5-b1f3-2c11a6b3eba7",
                        "entry_id": "96d2b7b9-7b45-3fd7-9534-56d539d0aa4e",
                        "glosses": [
                            "Verkaufsoption"
                        ],
                        "tags": [
                            "Börse"
                        ],
                        "examples": [
                            {
                                "example_id": "8b12a277-caa3-4992-899f-db62d7d39f61",
                                "sense_id": "7b625eca-c037-39f5-b1f3-2c11a6b3eba7",
                                "text": "„Der Käufer eines put [sic!] rechnet mit fallenden Kursen und profitiert daran durch die Option überproportional.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f57bf42-4686-4699-a9e5-62225f77e14d",
                        "source_entry_id": "96d2b7b9-7b45-3fd7-9534-56d539d0aa4e",
                        "source_sense_id": "7b625eca-c037-39f5-b1f3-2c11a6b3eba7",
                        "source_sense_description": "Wirtschaft, Börse: Verkaufsoption",
                        "target_lang_word": "put",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "put",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0996222-8676-3f68-9c44-050ad48efa0f",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To physically place (something or someone somewhere)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5204735-2d65-43bb-87c0-58a53aad6330",
                                                "sense_id": "c0996222-8676-3f68-9c44-050ad48efa0f",
                                                "text": "She put her books on the table."
                                            },
                                            {
                                                "example_id": "990ada86-4066-4971-9198-de8e95766fbf",
                                                "sense_id": "c0996222-8676-3f68-9c44-050ad48efa0f",
                                                "text": "The police put him in a cell."
                                            },
                                            {
                                                "example_id": "d77ad2d7-9468-433d-a139-63391c045bbc",
                                                "sense_id": "c0996222-8676-3f68-9c44-050ad48efa0f",
                                                "text": "They put the new motorway right through the national park."
                                            },
                                            {
                                                "example_id": "3be8c803-bc05-40f7-99eb-e0fb514a7d8a",
                                                "sense_id": "c0996222-8676-3f68-9c44-050ad48efa0f",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            },
                                            {
                                                "example_id": "77dda9e9-3606-49a9-a7e5-0e8a0e40dd83",
                                                "sense_id": "c0996222-8676-3f68-9c44-050ad48efa0f",
                                                "text": "‘No. I only opened the door a foot and put my head in. The street lamps shine into that room. I could see him. He was all right. Sleeping like a great grampus. Poor, poor chap.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff9f60f-d859-3a4b-86e2-4e6b4cf70bd5",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To place in abstract; to attach or attribute; to assign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c9eb62-890f-4792-b5e7-f43351d7405c",
                                                "sense_id": "4ff9f60f-d859-3a4b-86e2-4e6b4cf70bd5",
                                                "text": "The government put restrictions on vehicle imports."
                                            },
                                            {
                                                "example_id": "0d50ebeb-2732-48ed-8e74-247f95508681",
                                                "sense_id": "4ff9f60f-d859-3a4b-86e2-4e6b4cf70bd5",
                                                "text": "I put £100 on the winning horse."
                                            },
                                            {
                                                "example_id": "7064ff21-74bc-4c42-8db7-342266ee0022",
                                                "sense_id": "4ff9f60f-d859-3a4b-86e2-4e6b4cf70bd5",
                                                "text": "Don't put the blame on me."
                                            },
                                            {
                                                "example_id": "196428b9-60fe-4ab6-aaf3-9e8efa8d3b59",
                                                "sense_id": "4ff9f60f-d859-3a4b-86e2-4e6b4cf70bd5",
                                                "text": "What answer did you put for question 3?"
                                            },
                                            {
                                                "example_id": "a061a2dd-7313-4aab-9ccf-1ac115a13c29",
                                                "sense_id": "4ff9f60f-d859-3a4b-86e2-4e6b4cf70bd5",
                                                "text": "to put a wrong construction on an act or expression"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To bring or set (into a certain relation, state or condition)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845accb7-47b7-4f37-8d1e-fce4c8470c28",
                                                "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                                "text": "Theſe Verſes Originally Greek, were put in Latin,"
                                            },
                                            {
                                                "example_id": "dfdaf801-d1d4-452b-b8f9-b054bdfcaa01",
                                                "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                                "text": "Put your house in order!"
                                            },
                                            {
                                                "example_id": "dd791c34-b2b0-4bf0-bec8-d52ce73f9c9d",
                                                "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                                "text": "He is putting all his energy into this one task."
                                            },
                                            {
                                                "example_id": "a9eb123b-39a6-4633-a213-f2b5cbce6e6c",
                                                "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                                "text": "She tends to put herself in dangerous situations."
                                            },
                                            {
                                                "example_id": "22646b20-31fe-4b8d-87bd-1a943af7ce18",
                                                "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                                "text": "The doctor's put me on a strict diet."
                                            },
                                            {
                                                "example_id": "3480ed6a-7ff9-4f33-bf49-e2c547ad70b3",
                                                "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                                "text": "Put the following sentences into the past tense."
                                            },
                                            {
                                                "example_id": "55831b47-82b1-457f-9348-659142234eb2",
                                                "sense_id": "e01958ad-d89e-3811-b308-69d5d40def25",
                                                "text": "put to bed; put to shame; put to death; put into practice; put one's mind to it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2f9d19-8323-30a5-b699-82c917a20bc1",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To express (something in a certain manner)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "489759c1-21a3-4c76-9525-579c8fb19b1e",
                                                "sense_id": "ca2f9d19-8323-30a5-b699-82c917a20bc1",
                                                "text": "When you put it that way, I guess I can see your point."
                                            },
                                            {
                                                "example_id": "d51838ad-e978-44e9-a1f9-70cf8938bba5",
                                                "sense_id": "ca2f9d19-8323-30a5-b699-82c917a20bc1",
                                                "text": "To put it bluntly, he's an idiot."
                                            },
                                            {
                                                "example_id": "a66fd487-9ace-4d41-9327-641809e23e3a",
                                                "sense_id": "ca2f9d19-8323-30a5-b699-82c917a20bc1",
                                                "text": "All this is ingeniously and ably put."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe282048-0cf2-30a3-8e97-f07426ae1a54",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To set before one for judgment, acceptance, or rejection; to bring to the attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f29031ed-5124-4138-a43f-a7ca9b93ca9c",
                                                "sense_id": "fe282048-0cf2-30a3-8e97-f07426ae1a54",
                                                "text": "I put it to you, Sir, that you are a thief and a liar."
                                            },
                                            {
                                                "example_id": "7b00fa22-d4d7-4a23-bb41-66230ee8aba1",
                                                "sense_id": "fe282048-0cf2-30a3-8e97-f07426ae1a54",
                                                "text": "to put a question; to put a case"
                                            },
                                            {
                                                "example_id": "434d9c1a-a54d-4ce2-bdac-81321a01732f",
                                                "sense_id": "fe282048-0cf2-30a3-8e97-f07426ae1a54",
                                                "text": "1708-1710, George Berkeley, Philosophical Commentaries or Common-Place Book\nPut the perceptions and you put the mind."
                                            },
                                            {
                                                "example_id": "7acb4062-7f10-4eff-b704-b489d2dd1011",
                                                "sense_id": "fe282048-0cf2-30a3-8e97-f07426ae1a54",
                                                "text": "Now if there was one thing that the animals were completely certain of, it was that they did not want Jones back. When it was put to them in this light, they had no more to say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bebd97d7-7207-3b4c-a0a4-4f835f953322",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To set as a calculation or estimate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45325bb-149e-4c7d-b77f-b7396e004eab",
                                                "sense_id": "bebd97d7-7207-3b4c-a0a4-4f835f953322",
                                                "text": "They have put the cost of repairs at around £10 million."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21897bc3-47e5-3729-b6db-746dc5264d58",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To steer; to direct one's course; to go."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a32bda6-cdce-4b4e-8076-fa6eb02d0ced",
                                                "sense_id": "21897bc3-47e5-3729-b6db-746dc5264d58",
                                                "text": "to put to sea"
                                            },
                                            {
                                                "example_id": "5fdf6fac-b5d3-46d6-b472-33f57cbd32c4",
                                                "sense_id": "21897bc3-47e5-3729-b6db-746dc5264d58",
                                                "text": "His fury thus appeased, he puts to land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e569f32-db7b-31b0-a0ba-3b93d1c8c079",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To sell (assets) under the terms of a put option."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bb8488-9b5d-427a-a912-e148de158794",
                                                "sense_id": "8e569f32-db7b-31b0-a0ba-3b93d1c8c079",
                                                "text": "He got out of his Procter and Gamble bet by putting his shares at 80."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9449a4a4-ba5c-336b-9cde-e87891c0ea13",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To throw with a pushing motion, especially in reference to the sport of shot put. (Do not confuse with putt.)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c317c79f-32c7-4685-b047-6512feadccb1",
                                                "sense_id": "9449a4a4-ba5c-336b-9cde-e87891c0ea13",
                                                "text": "He put the shot out beyond the 20-metre mark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12f3abec-2214-38a0-a0ac-868ff839e5b9",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To play a card or a hand in the game called \\\"put\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da4d8f2c-cf4d-372e-a713-6f4bd3c7df01",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To lay down; to give up; to surrender."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d6d369-0e40-445d-880f-098c477ad0da",
                                                "sense_id": "da4d8f2c-cf4d-372e-a713-6f4bd3c7df01",
                                                "text": "No man hath more love than this, that a man put his life for his friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dee7214-21af-3c21-b874-1a47e96fd43c",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To incite; to entice; to urge; to constrain; to oblige."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a84dd3-8e8f-4df3-bad1-971c8f1de365",
                                                "sense_id": "4dee7214-21af-3c21-b874-1a47e96fd43c",
                                                "text": "These wretches put us upon all mischief."
                                            },
                                            {
                                                "example_id": "08ff3516-3e98-4411-aacf-0d999d3414fe",
                                                "sense_id": "4dee7214-21af-3c21-b874-1a47e96fd43c",
                                                "text": "Thank him who puts me loath to this revenge"
                                            },
                                            {
                                                "example_id": "35be54ba-39f5-45a3-bc82-9d49af772336",
                                                "sense_id": "4dee7214-21af-3c21-b874-1a47e96fd43c",
                                                "text": "Put me not to use the carnal weapon in my own defence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e34bb98-3299-3f66-b64c-05ba1b87e520",
                                        "entry_id": "4986de34-cdd0-3150-ac62-185259398697",
                                        "glosses": [
                                            "To convey coal in the mine, as for example from the working to the tramway."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "put",
                                "target_lang_code": "en",
                                "target_senses": [
