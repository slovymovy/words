        "fr-extract.jsonl": [
            {
                "entry_id": "c1a35806-6814-35c9-b611-9bd2c62f2202",
                "word": "encombrement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f749341f-ff60-494d-880e-17dfe5911329",
                        "entry_id": "c1a35806-6814-35c9-b611-9bd2c62f2202",
                        "tags": [
                            "plural"
                        ],
                        "form": "encombrements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1643f878-84df-3134-b865-009a997f7775",
                        "entry_id": "c1a35806-6814-35c9-b611-9bd2c62f2202",
                        "glosses": [
                            "Action d’encombrer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50bc6fa2-db32-465e-aa47-0f6088b42889",
                                "sense_id": "1643f878-84df-3134-b865-009a997f7775",
                                "text": "[…], il s’achemina vers le grand escalier, et, malgré l’encombrement formé dans toutes les voies par les pages et les écuyers, il parvint jusqu’aux appartements …."
                            },
                            {
                                "example_id": "2fb002bb-639a-4cd3-80a5-65e993185f55",
                                "sense_id": "1643f878-84df-3134-b865-009a997f7775",
                                "text": "[…], et l'attention des sages se fixait de préférence sur celles dont la grâce n'était pas altérée par l'artifice des ceintures et l'encombrement des bijoux."
                            }
                        ]
                    },
                    {
                        "sense_id": "33bf7db7-4858-3ad7-aa49-0c1c780a20a0",
                        "entry_id": "c1a35806-6814-35c9-b611-9bd2c62f2202",
                        "glosses": [
                            "Embouteillage dans la circulation ; bouchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1a436b-c6fb-4e03-b6f1-de40d5f4a28e",
                                "sense_id": "33bf7db7-4858-3ad7-aa49-0c1c780a20a0",
                                "text": "Au retour, dans l’encombrement des voitures qui rentraient par le bord du lac, la calèche dut marcher au pas."
                            },
                            {
                                "example_id": "ec4543fc-7fd5-42cb-919d-512e551f9399",
                                "sense_id": "33bf7db7-4858-3ad7-aa49-0c1c780a20a0",
                                "text": "L’autobus roule et s’arrête, roule et s’arrête, à cause des encombrements, des feux rouges, des arrêts obligatoires."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1547199-0073-3967-9cc7-92ccebe50bcc",
                        "entry_id": "c1a35806-6814-35c9-b611-9bd2c62f2202",
                        "glosses": [
                            "Place ou volume occupé par une machine."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "aeb08a3b-9c74-4f68-bdfa-da5326ba9869",
                                "sense_id": "c1547199-0073-3967-9cc7-92ccebe50bcc",
                                "text": "Victor Horta trouve dans le hall octogonal de l'hôtel Tassel une solution élégante au problème posé par l’encombrement des radiateurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b901d9c4-949e-4d6b-b726-00802b863200",
                        "source_entry_id": "c1a35806-6814-35c9-b611-9bd2c62f2202",
                        "target_lang_word": "cluttering",
