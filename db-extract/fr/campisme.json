                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "573e5e4c-91c8-3f1c-abb4-03ef2da9436d",
                                        "entry_id": "a4217166-2549-3cf9-bd68-aaa8d78dd40a",
                                        "glosses": [
                                            "An \\\"us-and-them\\\" ideology by which people are regarded as belonging to opposing camps."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d9f646a-fb63-4c77-adc8-3883fd10a5c5",
                                                "sense_id": "573e5e4c-91c8-3f1c-abb4-03ef2da9436d",
                                                "text": "Campism – the claim that you are this and so this is who your friends are – in this context is cis."
                                            },
                                            {
                                                "example_id": "28aed5e2-2f05-43c1-8e6e-7fd0265d3877",
                                                "sense_id": "573e5e4c-91c8-3f1c-abb4-03ef2da9436d",
                                                "text": "Do not get too caught up in individual campism. The Most-High sent your spirits back on earth to fix yourselves, come together and wake up our people, so do your dam job and stop letting your fleshly desires control you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
