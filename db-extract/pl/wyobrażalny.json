                "senses": [
                    {
                        "sense_id": "e1a3f841-bf20-3257-b549-dac0aba09a1a",
                        "entry_id": "e7da7ed8-a505-388c-9f45-b3b8d8308699",
                        "glosses": [
                            "możliwy do wyobrażenia sobie; dający się zrozumieć, pojąć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05825d33-8a48-4c30-b4e1-3cde6382223a",
                                "sense_id": "e1a3f841-bf20-3257-b549-dac0aba09a1a",
                                "text": "Współcześnie taka rola obyczajów nie jest ani możliwa, ani wyobrażalna, ani nawet konieczna"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fc6e80f-d711-4ff3-a671-0e796d1a72b5",
                        "source_entry_id": "e7da7ed8-a505-388c-9f45-b3b8d8308699",
                        "source_sense_id": "e1a3f841-bf20-3257-b549-dac0aba09a1a",
                        "target_lang_word": "imaginable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imaginable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                        "entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                                        "glosses": [
                                            "Able to be imagined; conceivable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6937a28-93e5-4d96-9d7a-f4183905f9ab",
                                                "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                                "text": "While running, they were exposed to the most hideous bespawling imaginable."
                                            },
                                            {
                                                "example_id": "2d1e449c-1047-4a57-962d-bbf6782ee3dd",
                                                "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                                "text": "By the early 1980s, Gucci was overlicensed, with its logo on every product imaginable from headscarves to key rings to lighters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d853c3-c4b0-38a9-b0d9-6b1fd252aa74",
                                        "entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                                        "glosses": [
                                            "Able to be imagined; conceivable.",
                                            "Within the realm of consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e480eac8-343d-4988-8362-2f754047bae5",
                                                "sense_id": "b2d853c3-c4b0-38a9-b0d9-6b1fd252aa74",
                                                "text": "Nevertheless, even if these forms do not directly go back to Lat. autumnus, influence of this word is imaginable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d06229b-a775-4e91-9fdd-16ed78227aa0",
                        "source_entry_id": "e7da7ed8-a505-388c-9f45-b3b8d8308699",
                        "source_sense_id": "e1a3f841-bf20-3257-b549-dac0aba09a1a",
                        "target_lang_word": "imaginable",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f5d94393-35d9-4edd-ad52-af3b269707bc",
                        "source_entry_id": "e7da7ed8-a505-388c-9f45-b3b8d8308699",
                        "source_sense_id": "e1a3f841-bf20-3257-b549-dac0aba09a1a",
                        "target_lang_word": "concebible",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4f45ff5b-f7b7-4d71-a8e4-0da42c2c24b4",
                        "source_entry_id": "e7da7ed8-a505-388c-9f45-b3b8d8308699",
                        "source_sense_id": "e1a3f841-bf20-3257-b549-dac0aba09a1a",
                        "target_lang_word": "vorstellbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorstellbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                        "entry_id": "ee61d281-6521-30a4-bf51-2804922ddff5",
                                        "glosses": [
                                            "sich etwas vorstellen können, sich ein Bild von etwas machen können; Verwendung: häufig negativ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad8cb469-b727-4399-948e-9138585067bb",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Dass Herr Meier unser neuer Abteilungsleiter wird, ist durchaus vorstellbar."
                                            },
                                            {
                                                "example_id": "e0bf8d7f-abbb-4006-96d2-c047dbf5bad1",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Es ist für kaum vorstellbar, dass wir in diesem Jahr von Umweltkatastrophen verschont bleiben werden."
                                            },
                                            {
                                                "example_id": "40182d86-0973-4ea8-bb24-97d4bc5176e0",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Ein Profisportler, egal ob Radfahrer, Fußballer oder Basketballer, ist heute kaum noch vorstellbar ohne Werbung irgendwo auf der Kleidung. Aber wenn man Bilder aus den 50er und 60ern sieht, wird man eines besseren belehrt."
                                            },
                                            {
                                                "example_id": "34584982-0768-420f-aca3-2edc528f58da",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Noch vor wenigen Monaten war es kaum vorstellbar: Jetzt erlaubt die US-Regierung zum ersten Mal seit über 50 Jahren einige Importe aus Kuba."
                                            },
                                            {
                                                "example_id": "b4b529fb-6f26-4266-8d8c-8ae65f2933af",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Es schien eigentlich kaum vorstellbar, dass es zwischen Deutschland und Israel nach dem Holocaust noch \"normale\" Beziehungen geben könne. Und doch gibt es Normalität in der Anormalität, meint Alexander Kudascheff."
                                            },
                                            {
                                                "example_id": "fc632778-ca9d-4af8-a79a-e5cf7e8ae826",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Ein Rockkonzert, ohne die Musik zu hören? Für die meisten ist das nicht vorstellbar. Doch Laura Schwengber macht durch Zeichensprache, Bewegung und Tanz auch für Gehörlose ein lebendiges Konzerterlebnis möglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
