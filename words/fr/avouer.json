            "senses": [
                {
                    "sense_id": "cbd11495-22d7-3cbc-9406-8b26fae17528",
                    "sense_definition": "Déclarer ou reconnaître pour vrai un fait, une faute ou un sentiment que l'on cachait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un long interrogatoire, le suspect a fini par tout <w>avouer</w> aux enquêteurs."
                        },
                        {
                            "text": "Je dois <w>avouer</w> que cette proposition inattendue me surprend beaucoup."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "confesser",
                        "reconnaître"
                    ],
                    "antonyms": [
                        "contester",
                        "démentir",
                        "dissimuler",
                        "nier"
                    ],
                    "common_phrases": [
                        "tout avouer",
                        "avouer une faute",
                        "avouer la vérité"
                    ]
                },
                {
                    "sense_id": "b02dfff8-a2ae-3eec-abd3-0fbfd7fefe29",
                    "sense_definition": "Se reconnaître soi-même dans un état donné, en particulier de faiblesse ou d'échec.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la difficulté de la course, elle refuse de s'<w>avouer</w> vaincue avant la ligne d'arrivée."
                        },
                        {
                            "text": "Face aux preuves accablantes présentées au tribunal, l'accusé a fini par s'<w>avouer</w> coupable."
                        }
                    ],
                    "synonyms": [
