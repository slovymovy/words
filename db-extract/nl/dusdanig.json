                "senses": [
                    {
                        "sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
                        "entry_id": "1354866e-2d49-31c5-8154-6f3dadff3d18",
                        "glosses": [
                            "als antecedent: in die mate dat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb427eca-f2f3-4540-a2e8-7a1e3ed6346b",
                                "sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
                                "text": "Hij was dusdanig geschrokken dat hij maar naar huis ging."
                            },
                            {
                                "example_id": "84606ef4-92a0-46ca-98cb-d83039b613dd",
                                "sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
                                "text": "Het horloge was dusdanig kostbaar dat hij het niet kon betalen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b63df106-f383-4fcc-9208-ee113938dd1b",
                        "source_entry_id": "1354866e-2d49-31c5-8154-6f3dadff3d18",
                        "source_sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
                        "source_sense_description": "in die mate",
                        "target_lang_word": "derart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "774fe266-c453-3339-a9a4-1132ce99f047",
                                        "entry_id": "41a6ddd4-71a6-34cf-b50c-7d9978fa7f1e",
                                        "glosses": [
                                            "auf solche Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32dff5dd-de52-47db-a4d2-8af5b080af52",
                                                "sense_id": "774fe266-c453-3339-a9a4-1132ce99f047",
                                                "text": "Das Schriftstück ist derart zerstört, dass man es kaum noch lesen kann."
                                            },
                                            {
                                                "example_id": "a39a600a-49bb-480c-8786-2bd45328942f",
                                                "sense_id": "774fe266-c453-3339-a9a4-1132ce99f047",
                                                "text": "„Die Wikinger sind die besten Seefahrer ihrer Zeit, doch die Reise nach Island ist derart gefährlich, dass viele Schiffe ihr Ziel nicht erreichen.“"
                                            },
                                            {
                                                "example_id": "080b4be4-9c43-470d-b8a5-e6bf2ac7f397",
                                                "sense_id": "774fe266-c453-3339-a9a4-1132ce99f047",
                                                "text": "„Für das Verbrechen ihrer Abstammung wurden Millionen von Menschen mitten im zwanzigsten Jahrhundert im Herzen Europas – Gottes Festung – in einen derart kalkulierten, derart abscheulichen, derart lang andauernden Tod geschickt, wie ihn sich keine Epoche vor dieser aufgeklärten hätte ausmalen, geschweige denn ausführen und verzeichnen können.“"
                                            },
                                            {
                                                "example_id": "495f517c-2ee2-4fe1-993d-7eea22e4a170",
                                                "sense_id": "774fe266-c453-3339-a9a4-1132ce99f047",
                                                "text": "„Moste mit derart hohen Zuckergehalten können von den Hefen nur sehr mühsam zu Wein vergoren werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f226600-f8bc-4ad4-bfc5-cdf3323e22eb",
                        "source_entry_id": "1354866e-2d49-31c5-8154-6f3dadff3d18",
                        "source_sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
                        "source_sense_description": "in die mate",
                        "target_lang_word": "dermaßen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dermaßen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f4ae55-e6cf-3374-93f2-06276f628054",
                                        "entry_id": "40b605a0-9b1a-3205-9db5-d30cdde97d31",
                                        "glosses": [
                                            "so sehr; in so hohem Maße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f062211-8f8c-40f0-87b8-34fd2e03f486",
                                                "sense_id": "c6f4ae55-e6cf-3374-93f2-06276f628054",
                                                "text": "Eine Laufmasche im Strumpf ist kein Grund, sich dermaßen aufzuregen."
                                            },
                                            {
                                                "example_id": "fef4697d-ec4e-4bd3-a2bc-3c5037955837",
                                                "sense_id": "c6f4ae55-e6cf-3374-93f2-06276f628054",
                                                "text": "Paul war dermaßen betrunken, dass er es nicht mehr allein nach Hause schaffte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "dermaßen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08e52971-d0bf-3a00-ad36-4c0e8d4e2bce",
                                        "entry_id": "516ed951-b5e7-383a-82c0-b3f3c5d711af",
                                        "glosses": [
                                            "in solch hohem Maße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c4e49e-4c49-4bd4-b4a6-2332db4aff55",
                                                "sense_id": "08e52971-d0bf-3a00-ad36-4c0e8d4e2bce",
                                                "text": "„Geiz und eine dermaßene Fixierung aufs Aussehen wären für mich unerträglich.“"
                                            },
                                            {
                                                "example_id": "ca655295-80ff-40f3-a480-5706e8850a18",
                                                "sense_id": "08e52971-d0bf-3a00-ad36-4c0e8d4e2bce",
                                                "text": "„Genau wie nach Nine-Eleven herrschte dort ein dermaßenes Chaos, dass man den Ermittlungen im Fall des Gelegenheitsverbrechers Rigaudeau keine höhere Priorität beimaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9486a38c-116d-4239-9ac6-48052390e00a",
                        "source_entry_id": "1354866e-2d49-31c5-8154-6f3dadff3d18",
                        "source_sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
                        "source_sense_description": "in die mate",
                        "target_lang_word": "so much",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c14a9bed-4fb4-3108-86eb-b981bcecf810",
                                        "entry_id": "0fea3541-ec57-3995-8f73-637288d6cf4b",
                                        "glosses": [
                                            "A particular amount, often a large or excessive amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea43a571-def2-4a92-862a-483d52f40b51",
                                                "sense_id": "c14a9bed-4fb4-3108-86eb-b981bcecf810",
                                                "text": "How could you eat so much?"
                                            },
                                            {
                                                "example_id": "ed6dca37-a1c3-48ca-b3e1-d68ba0a87959",
                                                "sense_id": "c14a9bed-4fb4-3108-86eb-b981bcecf810",
                                                "text": "There is only so much you can remember."
                                            },
                                            {
                                                "example_id": "bd128089-14f9-47b0-acf4-8b45ce6d1f90",
                                                "sense_id": "c14a9bed-4fb4-3108-86eb-b981bcecf810",
                                                "text": "I've got so much to do, but so little time."
                                            },
                                            {
                                                "example_id": "20ae675c-b772-4381-86f0-be30b3e7ae2d",
                                                "sense_id": "c14a9bed-4fb4-3108-86eb-b981bcecf810",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f1c3e3-3b71-30f7-a165-df31231c0c64",
                                        "entry_id": "0fea3541-ec57-3995-8f73-637288d6cf4b",
                                        "glosses": [
                                            "A demonstrated amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c29cb0-5287-444b-b4b0-5207e91378e8",
                                                "sense_id": "88f1c3e3-3b71-30f7-a165-df31231c0c64",
                                                "text": "\"So much\", he replied, sprinkling a small pile of the powder on the table."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "so much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f13e666-bf31-339b-813b-faf1c1aeb096",
                                        "entry_id": "d0c9cfda-695a-3499-a5ce-0e919b7e3260",
                                        "glosses": [
                                            "To a certain degree or extent"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea34c599-b01f-408e-ad65-e6028db44c56",
                                                "sense_id": "8f13e666-bf31-339b-813b-faf1c1aeb096",
                                                "text": "Identical twins are so much alike, it is difficult to identify them."
                                            },
                                            {
                                                "example_id": "a7328818-62b0-4474-9b43-8d2078a09c18",
                                                "sense_id": "8f13e666-bf31-339b-813b-faf1c1aeb096",
                                                "text": "I feel so much better."
                                            },
                                            {
                                                "example_id": "9031bcff-ac56-42c8-bc1c-60922201fd7c",
                                                "sense_id": "8f13e666-bf31-339b-813b-faf1c1aeb096",
                                                "text": "It wasn't so much that I don’t want to, but I just didn't have the time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "so much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "316ce434-5a86-3ae1-84e1-11284b0fc5bc",
                                        "entry_id": "f96d8b22-522f-3cce-bc10-b13fb7d37f12",
                                        "glosses": [
                                            "To such a quantity, degree etc."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "312feb66-e35d-4cc6-8eb7-3ad4b69ac1c3",
                                                "sense_id": "316ce434-5a86-3ae1-84e1-11284b0fc5bc",
                                                "text": "There has been so much snow, I can't open the door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0af96502-725e-46c9-afce-dd6caacb42e6",
                        "source_entry_id": "1354866e-2d49-31c5-8154-6f3dadff3d18",
                        "source_sense_id": "5e7053ca-3ae7-3d61-a676-acbb08ff4e62",
                        "source_sense_description": "in die mate",
                        "target_lang_word": "tellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33ac035b-3eb1-3a9e-81e6-ec8cfa36488d",
                                        "entry_id": "014731c3-a963-3d92-9a8b-6414fd2a3cf3",
                                        "glosses": [
                                            "De telle manière ; à un tel point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72554e0a-da7c-4627-a928-fa50fb02c1d5",
                                                "sense_id": "33ac035b-3eb1-3a9e-81e6-ec8cfa36488d",
                                                "text": "La Mole fit un mouvement tellement brusque de stupeur et d’effroi que la reine sourit."
                                            },
                                            {
                                                "example_id": "d35a2369-1e91-4627-a0ee-d896e4c9aed7",
                                                "sense_id": "33ac035b-3eb1-3a9e-81e6-ec8cfa36488d",
                                                "text": "La fromentelle est un calcaire jaunâtre, très-dur, coquillier, passant presque à la lumachelle. Les coquilles y sont tellement agrégées qu’il n’est guère possible d’en déterminer même le genre."
                                            },
                                            {
                                                "example_id": "d375ccef-1fed-4561-968c-6bcb7fce1c47",
                                                "sense_id": "33ac035b-3eb1-3a9e-81e6-ec8cfa36488d",
                                                "text": "L’agriculture y est d'un maigre profit : le sol est, en effet, tellement rocailleux, qu'il faut le cultiver avec la houe."
                                            },
                                            {
                                                "example_id": "6ff1a98e-2b80-4a5d-a7a9-4aa9923cd0b6",
                                                "sense_id": "33ac035b-3eb1-3a9e-81e6-ec8cfa36488d",
                                                "text": "Les Russes sont tellement imitateurs, que toutes les maladies de la civilisation se répercutent chez eux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5783b661-f90b-3e14-b030-72f425ee40a4",
                                        "entry_id": "014731c3-a963-3d92-9a8b-6414fd2a3cf3",
                                        "glosses": [
                                            "Tant ; en une telle quantité."
                                        ],
                                        "tags": [],
                                        "note": "S’emploie aussi avec que comme corrélatif. Un certain haut niveau de qualité dans la proposition précédente résulte à la proposition suivante",
                                        "examples": [
                                            {
                                                "example_id": "096bde12-e280-4116-be35-1db0fe1c9391",
                                                "sense_id": "5783b661-f90b-3e14-b030-72f425ee40a4",
                                                "text": "La grand-mère, tellement vieille qu’on ne voyait plus ses yeux, dormait dans un antique fauteuil, au haut duquel perchait une pie."
                                            },
                                            {
                                                "example_id": "8d153491-ed38-4c88-ab6b-8a14785623bd",
                                                "sense_id": "5783b661-f90b-3e14-b030-72f425ee40a4",
                                                "text": "Le système de raréfaction des naissances est ici tellement ancré dans les esprits, qu’il finit par être jugé comme le signe d’une vie raisonnable […]"
                                            },
                                            {
                                                "example_id": "fa6c4343-8e1d-4997-a6fb-55f842929dd0",
                                                "sense_id": "5783b661-f90b-3e14-b030-72f425ee40a4",
                                                "text": "C'était la terreur. Un sacré tord-boyaux de frousse tellement on avait peur qu'un des deux se viandât méchamment cinq mètres plus bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023036c6-5ebd-34b9-84e2-6fdf9a81ae7e",
                                        "entry_id": "014731c3-a963-3d92-9a8b-6414fd2a3cf3",
                                        "glosses": [
                                            "Un tel nombre de ; une telle quantité de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc583eb0-5662-4709-ab1c-dd2058a67e1d",
                                                "sense_id": "023036c6-5ebd-34b9-84e2-6fdf9a81ae7e",
                                                "text": "Pendant longtemps ils se virent poursuivis par le roi, suivi d’une troupe nombreuse d’hommes armés, mais qui ne purent lutter contre des chevaux fées ; le char volait toujours avec rapidité ; les chevaux redoublaient tellement de vitesse qu’ils finirent par faire cent lieues à l’heure."
                                            },
                                            {
                                                "example_id": "a34425db-884a-4cd9-9588-6bbe89b59447",
                                                "sense_id": "023036c6-5ebd-34b9-84e2-6fdf9a81ae7e",
                                                "text": "L'Union européenne est un colosse, impliqué dans tellement de choses que même les plus fervents partisans de la politique ont du mal à suivre."
                                            },
                                            {
                                                "example_id": "447e3dcd-bb05-4b77-90ec-6340d37ada60",
                                                "sense_id": "023036c6-5ebd-34b9-84e2-6fdf9a81ae7e",
                                                "text": "Dieu a tellement aimé le monde qu’il a donné son fils unique pour nous racheter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
