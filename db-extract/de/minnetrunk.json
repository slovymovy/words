                "senses": [
                    {
                        "sense_id": "aa820063-8d7a-31b8-bf1d-c199537407e3",
                        "entry_id": "647f101f-cd20-3c30-bfba-20ccf303cf60",
                        "glosses": [
                            "altgermanischer Brauch, zu Ehren einer Gottheit oder zum Gedächtnis an einen Verstorbenen das Methorn zu leeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeab7d3f-0efd-4041-8fc7-2bd17ad17fd3",
                                "sense_id": "aa820063-8d7a-31b8-bf1d-c199537407e3",
                                "text": "„Der vom Christentum anfangs als »Teufelsminne« verabscheute Trunk wurde im 9. Jahrhundert mit dem ehrenden Erinnern an Kirchenheilige in Verbindung gebracht. Die offizielle Übernahme des Minnetrunks durch das Christentum erfolgte im Hochmittelalter, als Kreuzzüge, Ostkolonisation und Fernhandel starke Bevölkerungsbewegungen auslösten; so wurde vor dem Antritt langer Reisen z. B. die Johannisminne getrunken.“"
                            },
                            {
                                "example_id": "4ec2d638-9fa5-4452-be89-0500b19e3bee",
                                "sense_id": "aa820063-8d7a-31b8-bf1d-c199537407e3",
                                "text": "„Der Minnetrunk selbst ist einer älteren Kultsitte entsprungen und war von Anfang an ein Abschiedstrunk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
