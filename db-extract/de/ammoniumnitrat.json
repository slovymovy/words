                        "target_lang_word": "ammonitrate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ammonitrate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6144bd4b-1f20-3fae-a478-36b9a1f8264e",
                                        "entry_id": "eb5658c8-d530-3759-9b14-775661d6eea7",
                                        "glosses": [
                                            "Engrais azoté à base de nitrate d’ammonium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec8b5a6-0c6f-43ef-b180-e626928cee84",
                                                "sense_id": "6144bd4b-1f20-3fae-a478-36b9a1f8264e",
                                                "text": "Environ 300 tonnes d’ammonitrate, nitrate d'ammonium pour usage d'engrais, étaient stockés dans un hangar. Pour une raison encore indéterminée (vraisemblablement erreur humaine), environ 500 kg de dichloro-isocyanurate de sodium DCCNa contenus dans un sac plastique, se sont trouvés en contact avec l’ammonitrate."
                                            },
                                            {
                                                "example_id": "263769c3-a1c7-46c3-a104-48e2888a362e",
                                                "sense_id": "6144bd4b-1f20-3fae-a478-36b9a1f8264e",
                                                "text": "Les doses d'engrais peuvent atteindre 200 à 400 kg d’ammonitrates à 30 ou 33% d'azote et 100 à 300 kg de superphosphates à 16% de P₂O₅ dans le cas de production intensive."
                                            }
                                        ]
                                    }
                                ]
                            }
