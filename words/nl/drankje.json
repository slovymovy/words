                {
                    "sense_id": "b234ab15-9087-3ce8-b7a7-dbe0f119186e",
                    "sense_definition": "Een vloeistof die bedoeld is om te drinken, vaak in een kleine hoeveelheid. (Verkleinwoord van <w>drank</w>)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op het terras bestelden we een koud <w>drankje</w> tegen de dorst.",
                            "target_lang_translations": {
                                "en": "On the terrace, we ordered a cold <w>drink</w> for our thirst.",
                                "ru": "На террасе мы заказали холодный <w>напиток</w>, чтобы утолить жажду.",
                                "fr": "Sur la terrasse, nous avons commandé une <w>boisson</w> fraîche pour étancher notre soif."
                            }
                        },
                        {
                            "text": "Wil je misschien een warm <w>drankje</w> voordat je naar bed gaat?",
                            "target_lang_translations": {
                                "en": "Would you perhaps like a hot <w>drink</w> before you go to bed?",
                                "ru": "Может быть, ты хочешь горячий <w>напиток</w> перед сном?",
                                "fr": "Veux-tu éventuellement une <w>boisson</w> chaude avant d'aller te coucher ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "drank",
                        "drinken"
                    ],
                    "common_phrases": [
                        "een koud drankje",
                        "een warm drankje",
                        "fris drankje"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutive"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A liquid intended for drinking, often in a small quantity. (Diminutive of <w>drank</w>)",
                        "ru": "Жидкость, предназначенная для питья, часто в небольшом количестве (уменьшительное от \"напиток\").",
                        "fr": "Un liquide destiné à être bu, souvent en petite quantité. (Diminutif de « drank »)"
                    },
                    "translations": {
