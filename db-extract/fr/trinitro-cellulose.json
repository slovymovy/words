                        "glosses": [
                            "Forme de nitro-cellulose à forte proportion de nitrate, pour laquelle il existe divers usages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe34bb23-ecd1-4b5c-8b82-5189aa8e115c",
                                "sense_id": "ffd525d9-3e44-31d3-85e2-f16181a199b9",
                                "text": "La trinitro-cellulose est obtenue comme suit : on traite du coton pendant trois jours par un mélange convenable de NaOH et NH₃ : on essore, on lave, on sèche puis on ouvre les fibres par cardage. Le coton ainsi préparé est traité par une solution de salpêtre et d'acide sulfurique à la température de 85°. Le produit obtenu est lavé à l'eau, séché à l'étuve puis dissous à l'acide acétique cristallisable."
                            }
                        ]
                    }
