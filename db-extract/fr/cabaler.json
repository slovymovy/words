                ],
                "senses": [
                    {
                        "sense_id": "b6407a4f-466b-38fb-99c1-d6055ab201db",
                        "entry_id": "77bb1d71-fa83-3e43-808c-339dc0270cd5",
                        "glosses": [
                            "Faire une cabale, être d’une cabale."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "74eda19d-8fec-4482-bbce-9609c131e191",
                                "sense_id": "b6407a4f-466b-38fb-99c1-d6055ab201db",
                                "text": "On était justement indisposé de voir des religieux, voués par état à l’humilité, à la retraite et au silence, diriger la conscience des rois, élever la noblesse du royaume, cabaler à la cour, à la ville et dans les provinces."
                            },
                            {
                                "example_id": "a56a2a97-fbaa-4001-a436-6d1f098f9066",
                                "sense_id": "b6407a4f-466b-38fb-99c1-d6055ab201db",
                                "text": "Tu auras beau cabaler avec tous les calotins pour empêcher l’organisation du clergé, tu ne réussiras jamais."
                            },
                            {
                                "example_id": "e32b8031-f362-4125-8b21-c805361a9264",
                                "sense_id": "b6407a4f-466b-38fb-99c1-d6055ab201db",
                                "text": "Qu’allez-vous faire dans les coulisses, monsieur ? Est-ce là votre place ? Vous donné-je des appointements pour cabaler avec les acteurs ?"
                            },
                            {
                                "example_id": "412d0689-670b-4ac3-aa10-24586ae38dfe",
                                "sense_id": "b6407a4f-466b-38fb-99c1-d6055ab201db",
                                "text": "Il se demande tout haut s’ils « cabalent ». Peut-être même « briguent-ils » ? Sinon à quoi servent, ajoute-t-il, ces baisers entre gens qui se voient tout le temps ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "bfd5f0a3-8142-3705-8452-08857ebbc389",
                        "entry_id": "77bb1d71-fa83-3e43-808c-339dc0270cd5",
                        "glosses": [
                            "Intriguer pour accroître un parti."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "87a35caf-5711-466b-bb46-3be638937e73",
                                "sense_id": "bfd5f0a3-8142-3705-8452-08857ebbc389",
                                "text": "Machut.\nJe cabale pour ton maître. C’est juste, j’ai la pratique de la maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "c00a5c8e-7506-3328-b2f6-1e292d4e294d",
                        "entry_id": "77bb1d71-fa83-3e43-808c-339dc0270cd5",
                        "glosses": [
                            "Faire de sourdes menées."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd900018-878b-41c2-a54e-5c6a571e2d36",
                        "source_entry_id": "77bb1d71-fa83-3e43-808c-339dc0270cd5",
