                "senses": [
                    {
                        "sense_id": "edb1aef2-4026-398f-be59-f5967838249c",
                        "entry_id": "9438cfdd-a814-3054-bec7-2e562560e355",
                        "glosses": [
                            "unüberlegte, in Affekt begangene Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096ddc0a-3bb5-407e-8c59-c0b316f46f71",
                                "sense_id": "edb1aef2-4026-398f-be59-f5967838249c",
                                "text": "„Demnach sei der Einsatz von Chemiewaffen eher eine Kurzschlusshandlung des jüngeren Bruders von Assad gewesen als eine strategische Entscheidung.“"
                            },
                            {
                                "example_id": "1a03f395-c674-4aaf-952b-8bffc8162282",
                                "sense_id": "edb1aef2-4026-398f-be59-f5967838249c",
                                "text": "„Ein gezielter Suizid als Momentlaune, als Wollkürakt oder als Kurzschlusshandlung aus heiterem Himmel machte keinen befriedigenden Sinn, ergab keine nachvollziehbare Erklärung.“"
                            },
                            {
                                "example_id": "7e1dce37-4938-4690-bd79-e75cc7ba8c1a",
                                "sense_id": "edb1aef2-4026-398f-be59-f5967838249c",
                                "text": "„Möglicherweise bereute sie ihre Kurzschlusshandlung gar nicht, denn sie hatte nichts zu verlieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9397f008-53c9-4a4b-aedf-e8c00e60c75b",
