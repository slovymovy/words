                "senses": [
                    {
                        "sense_id": "064188d9-8f81-3ab8-a5aa-77be76d32fa0",
                        "entry_id": "1ff493a5-97d8-3924-8b96-11ec44c94857",
                        "glosses": [
                            "äußere Begrenzung eines Gerichts der italienischen Küche, welches aus einem Fladenbrot aus Hefeteig, das vor dem Backen mit Tomatensauce bestrichen und mit weiteren Zutaten wie z.B. Mozzarella belegt wird, besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5997b52-9c23-41d5-a6da-80b1f9c99cdd",
                                "sense_id": "064188d9-8f81-3ab8-a5aa-77be76d32fa0",
                                "text": "Darin beschreibt der experimentierfreudige Brite detailgenau, wie er mit Muammar al-Gaddafi 1979 in dessen Beduinenzelt auf der Wiese hinter der Autogrill-Station Zugliano Est einen Pizzarand in der Wasserpfeife geraucht hat. Richards: \"F…, danach glühst du wie ein Holzofen!\""
                            },
                            {
                                "example_id": "9d58bf83-6b0f-4a7b-b037-d547d8c07906",
                                "sense_id": "064188d9-8f81-3ab8-a5aa-77be76d32fa0",
                                "text": "Und mit meiner Leidenschaft für Pizzarand meine ich übrigens nicht diesen abgefahrenen Cheesy-Crust (also den Rand mit Käsefüllung, der eine Zeit lang in dieser einen Pizza-Kette der Renner war)."
                            },
                            {
                                "example_id": "9369987e-8043-4a4a-b96c-0d9dade0a12c",
                                "sense_id": "064188d9-8f81-3ab8-a5aa-77be76d32fa0",
                                "text": "Alle Modelle können mit einem oberen Teller ausgestattet werden, der durch die besondere Formgebung, einen schönen, dickeren Pizzarand bildet, oder mit einem ganz glatten oberen Teller, für einen flachen, regelmäßigen Teigboden."
                            },
                            {
                                "example_id": "60b84944-5a37-45b3-ad42-5c2a3028b318",
                                "sense_id": "064188d9-8f81-3ab8-a5aa-77be76d32fa0",
                                "text": "Mein Gedanke lies mich grinsen und er sah mich fragend an. \"Du magst keinen Pizzarand\" grinste ich."
                            },
                            {
                                "example_id": "5d053f98-2a3d-40d3-a0f0-fdea03a172f1",
                                "sense_id": "064188d9-8f81-3ab8-a5aa-77be76d32fa0",
                                "text": "Bewegen Sie dazu Ihre Hände kreisförmig auf den Teig, sodass automatisch ein Pizzarand entsteht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
