                ],
                "senses": [
                    {
                        "sense_id": "b19e9900-a9d4-32ac-add5-72d5fd47e8a6",
                        "entry_id": "2cba9616-869b-3106-b9d4-7870d5c5bce8",
                        "glosses": [
                            "дорогой изукрашенный ящичек с крышкой для хранения разных вещей (обычно драгоценностей)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5df27dc-72fd-4215-b985-0dd7c37c03e9",
                                "sense_id": "b19e9900-a9d4-32ac-add5-72d5fd47e8a6",
                                "text": "Он странно мне близок, угадчик-певец, // Я помню столетий минувших апрели, // Близ птицы в себе ощутил я ларец, // В волшебном сокровища звуков звенели."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c52b67b-890a-330d-ac8f-eaf80549179e",
                        "entry_id": "2cba9616-869b-3106-b9d4-7870d5c5bce8",
                        "glosses": [
                            "небольшой сундучок"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40c7536c-ba83-490f-9fb5-d1a4dbb4f9a5",
                        "source_entry_id": "2cba9616-869b-3106-b9d4-7870d5c5bce8",
                        "target_lang_word": "coffret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b00cab-8c1c-3741-a112-ab8f23667cda",
                                        "entry_id": "91abad69-7a8c-3d86-9e69-a75cac90397e",
                                        "glosses": [
                                            "Petit coffre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a095bec6-66f1-44b2-9099-b3b0549d187a",
                                                "sense_id": "c8b00cab-8c1c-3741-a112-ab8f23667cda",
                                                "text": "Coffret d’écaille."
                                            },
                                            {
                                                "example_id": "6ce577fc-981d-4bc3-8b18-cf292cac3be7",
                                                "sense_id": "c8b00cab-8c1c-3741-a112-ab8f23667cda",
                                                "text": "Coffret garni d’argent."
                                            },
                                            {
                                                "example_id": "a03fabf7-59dd-4fc5-bc86-021d3067b308",
                                                "sense_id": "c8b00cab-8c1c-3741-a112-ab8f23667cda",
                                                "text": "Il tenait entre ses mains un coffret, son fameux coffret qui l’avait tellement perturbé et dont il pensait en avoir rêvé l’existence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "913d5d2f-721c-4600-8626-6891fb2f4444",
                        "source_entry_id": "2cba9616-869b-3106-b9d4-7870d5c5bce8",
                        "target_lang_word": "écrin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écrin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2728dd70-2c91-3b0d-b979-647f21732cc8",
                                        "entry_id": "12321c31-3ab8-3993-91c3-05753eecde0f",
                                        "glosses": [
                                            "Petit coffret ou étui où l’on met des bagues, des pierreries et des objets précieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9fe8e6-7b51-4f11-9847-96eeb6ef6838",
                                                "sense_id": "2728dd70-2c91-3b0d-b979-647f21732cc8",
                                                "text": "Elle range ses bijoux dans un écrin."
                                            },
                                            {
                                                "example_id": "ccf61ba4-35be-4b22-bd24-2fb50474cd5b",
                                                "sense_id": "2728dd70-2c91-3b0d-b979-647f21732cc8",
                                                "text": "Accroche-cœur –\nAux larmes de cendre,\nelle regarda\nla rouflaquette de l’écrin,\nsouvenir\nd’une époque crépusculaire,\npeu avant le début\n…\nde sa chimiothérapie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5023adaf-32ad-3546-b863-db143ac43123",
                                        "entry_id": "12321c31-3ab8-3993-91c3-05753eecde0f",
                                        "glosses": [
                                            "Ensemble des joyaux contenus dans ce coffret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fa8481-35b4-4b6d-8490-6ec591506626",
                                                "sense_id": "5023adaf-32ad-3546-b863-db143ac43123",
                                                "text": "Un riche écrin."
                                            },
                                            {
                                                "example_id": "e8a4616a-b8c3-4835-a471-17e41da2b442",
                                                "sense_id": "5023adaf-32ad-3546-b863-db143ac43123",
                                                "text": "L’écrin de la Reine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eacdbf7b-238c-3661-9255-8c4f71d0f358",
                                        "entry_id": "12321c31-3ab8-3993-91c3-05753eecde0f",
                                        "glosses": [
                                            "Boite spécialement étudiée pour y ranger un objet spécifique et généralement vendu avec l'objet en question (bijou, montre, médaille, objet de valeur, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e4e8c8e-26dd-3b1f-a659-7ef15af72e3c",
                                        "entry_id": "12321c31-3ab8-3993-91c3-05753eecde0f",
                                        "glosses": [
                                            "Contenant, entourage, d’une chose précieuse ou jolie."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "690d5ad2-4ac1-441e-84f7-b91e0c6cadba",
                                                "sense_id": "2e4e8c8e-26dd-3b1f-a659-7ef15af72e3c",
                                                "text": "Dans la feuillée, écrin vert taché d’or,\nDans la feuillée incertaine et fleurie…"
                                            },
                                            {
                                                "example_id": "33a47d08-826a-49ed-8dc7-8ed23e596c91",
                                                "sense_id": "2e4e8c8e-26dd-3b1f-a659-7ef15af72e3c",
                                                "text": "Et, dans l’écrin du souvenir\nPrécieusement enfermée,\nPerle que rien ne peut ternir,\nTu demeures la plus aimée."
                                            },
                                            {
                                                "example_id": "9f673ec0-8ba2-416a-8a14-d863f5331ce6",
                                                "sense_id": "2e4e8c8e-26dd-3b1f-a659-7ef15af72e3c",
                                                "text": "Dans le splendide écrin de sa bouche écarlate\nDe ses trente-deux dents l’émail luisant éclate."
                                            },
                                            {
                                                "example_id": "f39452e2-cc7d-434c-aa3e-9922e23115e9",
                                                "sense_id": "2e4e8c8e-26dd-3b1f-a659-7ef15af72e3c",
                                                "text": "Il le met, comme Jésus, sur le pinacle du temple, et lui montre tous les joyaux de la terre, l’écrin du mal…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
