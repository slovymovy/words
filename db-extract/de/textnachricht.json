                ],
                "senses": [
                    {
                        "sense_id": "ada39e47-8ea2-3168-a8f0-178b6a214347",
                        "entry_id": "0e2fb2cc-8322-3892-a635-f16281b4c407",
                        "glosses": [
                            "als Text über einen Messenger oder Ähnliches geschriebene Mitteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb7cfe4-79c1-4e32-b562-6266861b24f5",
                                "sense_id": "ada39e47-8ea2-3168-a8f0-178b6a214347",
                                "text": "Weil Max seine Schwester nicht telefonisch erreichen konnte, schickte er eine Textnachricht auf ihr Handy."
                            },
                            {
                                "example_id": "7d1b08a4-e697-4190-918b-9fbe9a159024",
                                "sense_id": "ada39e47-8ea2-3168-a8f0-178b6a214347",
                                "text": "„Textnachrichten mit Punkt wurden als weniger aufrichtig, enthusiastisch oder warmherzig aufgefasst, zum Teil sogar als passiv-aggressiv.“"
                            },
                            {
                                "example_id": "c9fddb88-d000-4fae-accb-1b2d06561c12",
                                "sense_id": "ada39e47-8ea2-3168-a8f0-178b6a214347",
                                "text": "„Es gab keine Fotos, nur Textnachrichten, aber die erzählten eine Geschichte, die so schaurig war, dass Ari eine Gänsehaut bekam.“"
                            },
                            {
                                "example_id": "a4a56378-f972-4d1a-ab5e-0e17a0a11c1a",
                                "sense_id": "ada39e47-8ea2-3168-a8f0-178b6a214347",
                                "text": "„Danach stand ich auf und trocknete mich ab, legte mich ins Bett und schickte Ola eine Textnachricht, auf die er sofort antwortete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caebfea7-2c8a-47df-ae9b-fde035812393",
                        "source_entry_id": "0e2fb2cc-8322-3892-a635-f16281b4c407",
                        "source_sense_id": "ada39e47-8ea2-3168-a8f0-178b6a214347",
                        "source_sense_description": "als Text über einen Messenger oder Ähnliches geschriebene Mitteilung",
                        "target_lang_word": "text message",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "text message",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                        "entry_id": "d1fe3ea3-12d5-3562-86e2-ea066f7be492",
                                        "glosses": [
                                            "A brief electronic message sent between mobile phones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89f9200-3a27-4c01-a58d-df6da0217e45",
                                                "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                                "text": "After the kitten had died, Robins sent a text message to Knutton saying: \"Remember the saying: 'What goes around comes around?' It has started already to bite you in the arse. The cat? Karma.\""
                                            },
                                            {
                                                "example_id": "8fdb036b-a21a-44f7-b0d2-5f8cfc685579",
                                                "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            },
                                            {
                                                "example_id": "c23a123d-3c11-42f7-8417-e4dd62663456",
                                                "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                                "text": "Similarly, Fingilish usually refers to transliterated Farsi in chatrooms, text messages, and the like."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "text message",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38519088-75f9-3386-955e-0f1604f1e033",
                                        "entry_id": "06a070f7-db92-3d42-bf72-a53aa7e5712d",
                                        "glosses": [
                                            "To transmit a text message."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7efeecfc-ba67-43d4-9ad2-329f0299f626",
                                                "sense_id": "38519088-75f9-3386-955e-0f1604f1e033",
                                                "text": "I told him to text message you when he's finished."
                                            },
                                            {
                                                "example_id": "571a6ba3-2d5c-4c3c-9988-6774ad1d3321",
                                                "sense_id": "38519088-75f9-3386-955e-0f1604f1e033",
                                                "text": "Please text message the directions to me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
