{
    "word_family": [
        "penman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b4ed6fb-fb8b-33b5-8704-d66f8069e24c",
                    "sense_definition": "The style or quality of a person's handwriting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "writing_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher praised the student for his neat <w>penmanship</w> on the final exam.",
                            "target_lang_translations": {
                                "zh": "老师表扬了该学生在期末考试中工整的<w>字迹</w>。"
                            }
                        },
                        {
                            "text": "Her <w>penmanship</w> was so messy that I could barely read the letter she sent.",
                            "target_lang_translations": {
                                "zh": "她的<w>字迹</w>太潦草了，我几乎读不懂她寄来的信。"
                            }
                        }
                    ],
                    "synonyms": [
                        "handwriting or chirography",
                        "one's own style of writing"
                    ],
                    "common_phrases": [
                        "neat penmanship",
                        "poor penmanship"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一个人的书写风格或字迹的好坏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "字迹",
                                "target_lang_sense_clarification": "指书写的字形，侧重于书写的效果。"
                            },
                            {
                                "target_lang_word": "书写",
                                "target_lang_sense_clarification": "指书写的动作或书写的质量。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "393de1dc-5f8d-3e95-a4a7-5262d7c175d0",
                    "sense_definition": "The art or skill of producing beautiful or decorative handwriting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She studied traditional <w>penmanship</w> to create elegant wedding invitations by hand.",
                            "target_lang_translations": {
                                "zh": "她学习了传统<w>书法</w>，以便亲手制作优雅的结婚请柬。"
                            }
                        },
                        {
                            "text": "The old manuscript is a beautiful example of historical <w>penmanship</w> from the eighteenth century.",
                            "target_lang_translations": {
                                "zh": "这份古老的手稿是十八世纪历史<w>书法</w>的精美范例。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calligraphy"
                    ],
                    "common_phrases": [
                        "artistic penmanship"
                    ],
                    "target_lang_definitions": {
                        "zh": "指创作美观或装饰性文字的艺术或技巧。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "书法",
                                "target_lang_sense_clarification": "美观书写的艺术，不限于汉字"
                            },
                            {
                                "target_lang_word": "书写艺术",
                                "target_lang_sense_clarification": "书写的技艺"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}