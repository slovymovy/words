                "senses": [
                    {
                        "sense_id": "ac382536-776b-3bd5-94aa-a8787dcf558f",
                        "entry_id": "b7fa2408-d9fd-36e8-bb69-00e1cac932f4",
                        "glosses": [
                            "van iets dat het al lange tijd tot de kern van iemands identiteit hoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b69ac3-51a8-434c-bc7a-4c782674a54a",
                                "sense_id": "ac382536-776b-3bd5-94aa-a8787dcf558f",
                                "text": "Onderworpen aan haar hartstocht voor koppelarij, die zo diepgeworteld is in de Romaanse aard, was mademoiselle altijd blij als ze hen beiden samen aantrof, stak dan veelbetekenend een dreigend vingertje naar hen op en knipoogde schalks."
                            },
                            {
                                "example_id": "2d075e1d-fbdc-4dcc-bdb0-45714045bc90",
                                "sense_id": "ac382536-776b-3bd5-94aa-a8787dcf558f",
                                "text": "Gyarmati, die nog altijd vloeiend Nederlands spreekt, denkt dat bepaalde opvattingen in Hongarije te diepgeworteld zijn voor grote veranderingen. \"Mensen die op dit gebied heel conservatief zijn, gaan echt niet veranderen als ze overal regenboogkleuren zien. Misschien beschouwen zij de acties juist als een soort agressieve druk.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8509b310-2568-4366-a7be-c35c491cd175",
                        "source_entry_id": "b7fa2408-d9fd-36e8-bb69-00e1cac932f4",
                        "source_sense_id": "ac382536-776b-3bd5-94aa-a8787dcf558f",
                        "source_sense_description": "van iets dat het al lange tijd tot de kern van iemands identiteit hoort",
                        "target_lang_word": "deep-rooted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deep-rooted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8023f4ca-3817-3b05-898c-97073b2f920b",
                                        "entry_id": "0e9e52b0-f9c5-3acd-a9c0-1d4847dbb82e",
                                        "glosses": [
                                            "Of a plant, having deep roots; (of a non-living object) deeply and firmly embedded (in the ground, etc.)."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e19bf814-0955-4ad9-b9e2-48ec7b94596a",
                                                "sense_id": "8023f4ca-3817-3b05-898c-97073b2f920b",
                                                "text": "He observed the leaves of trees there abouts more deeply green then else∣where, the Oakes broad-spreading, but not deep-rooted;"
                                            },
                                            {
                                                "example_id": "ae445acb-476d-4462-8e5a-f0e07c2175ae",
                                                "sense_id": "8023f4ca-3817-3b05-898c-97073b2f920b",
                                                "text": "1726, Jonathan Swift (translator), “Horace, Book I, Ode XIV” in Miscellanies in Prose and Verse, London: T. Woodward and Charles Davis, 1736, Volume 5, p. 193,\nPoor floating Isle, tost on ill Fortune’s Waves,\nOrdain’d by Fate to be the Land of Slaves;\nShall moving Delos now deep-rooted stand,\nThou, fixt of old, be now the moving Land?"
                                            },
                                            {
                                                "example_id": "f8b382dc-985e-4f30-8350-9e153bc16f1a",
                                                "sense_id": "8023f4ca-3817-3b05-898c-97073b2f920b",
                                                "text": "1791, William Cowper (translator), The Odyssey, Book 13, in The Iliad and Odyssey of Homer, London: J. Johnson, Volume 2, p. 302,\nAnd now the flying bark full near approach’d,\nWhen Neptune, meeting her, with out-spread palm\nDepress’d her at a stroke, and she became\nDeep-rooted stone."
                                            },
                                            {
                                                "example_id": "ca3fcd55-bdac-460d-868e-eb83e4e16dc0",
                                                "sense_id": "8023f4ca-3817-3b05-898c-97073b2f920b",
                                                "text": "[His love was] as impossible to restore to growth as a deep-rooted plant torn from its bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c57872b-b2e0-3b26-a7aa-32105eefe3fa",
                                        "entry_id": "0e9e52b0-f9c5-3acd-a9c0-1d4847dbb82e",
                                        "glosses": [
                                            "Firmly established in thought or behavior and difficult to change."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e999db0e-2031-4044-b0ec-93463b3c4d6a",
                                                "sense_id": "7c57872b-b2e0-3b26-a7aa-32105eefe3fa",
                                                "text": "They avoid conflict at all costs because of their deep-rooted fear of upsetting people."
                                            },
                                            {
                                                "example_id": "af1620a2-470b-444c-8772-99d81a31f483",
                                                "sense_id": "7c57872b-b2e0-3b26-a7aa-32105eefe3fa",
                                                "text": "[…] Temporarie faith keeping residence only in the out-face of the heart, is ouerswayed & ouerborn in temptation by euery strong desire, or deep-rooted passion."
                                            },
                                            {
                                                "example_id": "401d249e-c628-4b7c-9228-8c6dd42a45e3",
                                                "sense_id": "7c57872b-b2e0-3b26-a7aa-32105eefe3fa",
                                                "text": "Notwithstanding the deep-rooted notion, even amongst the majority of painters themselves, that time is a great improver of good pictures, I will undertake to shew, that nothing can be more absurd."
                                            },
                                            {
                                                "example_id": "e6b758da-dbab-4d28-8192-57a005213426",
                                                "sense_id": "7c57872b-b2e0-3b26-a7aa-32105eefe3fa",
                                                "text": "1850, Charlotte Brontë, letter to Elizabeth Gaskell dated 27 August, , in Elizabeth Gaskell, The Life of Charlotte Brontë, London: Smith, Elder, 1857, Volume 2, p. 177,\nCertainly there are evils which our own efforts will best reach; but as certainly there are other evils—deep-rooted in the foundations of the social system—which no efforts of ours can touch:"
                                            },
                                            {
                                                "example_id": "8cefc3c0-1a46-4eb8-8e6d-5c1bd17a2e56",
                                                "sense_id": "7c57872b-b2e0-3b26-a7aa-32105eefe3fa",
                                                "text": "“He may be very well okay as a person. But other workers are not happy with him. Already they are coming to me with complaints. You see, comrade, from local standpoint, these caste issues are very deep-rooted.”"
                                            },
                                            {
                                                "example_id": "a7ca5d74-9080-4897-b5ac-c12b9de314a1",
                                                "sense_id": "7c57872b-b2e0-3b26-a7aa-32105eefe3fa",
                                                "text": "The installation of new pipes should resolve deep-rooted flooding problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d46df9d2-8f6e-4029-b37b-eb85b12d2359",
                        "source_entry_id": "b7fa2408-d9fd-36e8-bb69-00e1cac932f4",
