                ],
                "senses": [
                    {
                        "sense_id": "f54de520-b4d6-3032-a9b0-bf433a510a0b",
                        "entry_id": "1d14fb8b-cfd1-34e2-810d-08c4e101da57",
                        "glosses": [
                            "произносить грубые, оскорбительные, бранные слова; браниться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ddb8079-d59a-4459-b251-52eec1995c15",
                                "sense_id": "f54de520-b4d6-3032-a9b0-bf433a510a0b",
                                "text": "Фёдор напился и ругался непотребными словами."
                            }
                        ]
                    },
                    {
                        "sense_id": "63d9f425-67c8-3499-b1bc-81362faee4a0",
                        "entry_id": "1d14fb8b-cfd1-34e2-810d-08c4e101da57",
                        "glosses": [
                            "вести с кем-либо разговор, высказывая упрёки в грубом тоне и с использованием грубых выражений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c507286c-d7b2-4d69-9e0c-9c07a5f1b67c",
                                "sense_id": "63d9f425-67c8-3499-b1bc-81362faee4a0",
                                "text": "Супруги ссорились и ругались и дело у них шло к разводу."
                            }
                        ]
                    },
                    {
                        "sense_id": "b80cc023-8e93-3c66-a1f2-9b18d0f8ac2e",
                        "entry_id": "1d14fb8b-cfd1-34e2-810d-08c4e101da57",
                        "glosses": [
                            "упрекать, ругать кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2ca8011-72a2-4168-b0e9-1453658e32bd",
                                "sense_id": "b80cc023-8e93-3c66-a1f2-9b18d0f8ac2e",
                                "text": "В конце вечеринки Таня сказала: давайте помоем за собой посуду и приберём в комнате, а то мама будет ругаться."
                            },
                            {
                                "example_id": "e991c23a-5bd1-415e-bc99-aa2fd875ab56",
                                "sense_id": "b80cc023-8e93-3c66-a1f2-9b18d0f8ac2e",
                                "text": "Все ругались, что начальство не умеет толком организовать работу."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
