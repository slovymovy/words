                    },
                    {
                        "translation_id": "1d01efb5-3fcd-4909-9226-f4ef2534ee4a",
                        "source_entry_id": "6c6927ea-cc9a-322d-9b9e-a36565bdf4ba",
                        "source_sense_id": "3d2f16e3-3d75-399f-a449-49d67d171568",
                        "target_lang_word": "wortlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wortlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                        "entry_id": "687011ca-1500-3a5a-8da8-e61670a40246",
                                        "glosses": [
                                            "ohne Worte, ohne etwas zu sagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ec77e8-38c8-498b-a57c-b4d09ba55891",
                                                "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                                "text": "Er schlich wortlos an mir vorbei."
                                            },
                                            {
                                                "example_id": "d055202d-6074-4d04-9688-97302ba5d6ba",
                                                "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                                "text": "Der Angeklagte hat das Urteil wortlos und regungslos hingenommen."
                                            },
                                            {
                                                "example_id": "bcfbbaf8-f62a-4d84-9ce0-8cfa38156768",
                                                "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                                "text": "„Wortlos kam sie jeder seiner Anweisungen nach, die manchmal so knapp und herrisch waren, daß sie wie Befehle klangen.“"
                                            },
                                            {
                                                "example_id": "de22e7be-6f7d-4976-8853-0369dc2c55b2",
                                                "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                                "text": "„Wortlos ging Ericson an seinen Wandschrank, schenkte ein Glas Whisky ein und gab es Gregg!“"
                                            },
                                            {
                                                "example_id": "0e8106f0-160e-4bfd-a7e7-f3b10868eb72",
                                                "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                                "text": "„Finnen ziehen aus diesen Fragen die richtigen Schlüsse und beginnen ihr Mahl in der Regel wortlos.“"
                                            },
                                            {
                                                "example_id": "eb5b2508-ab85-482c-9a0e-9fa61c268a56",
                                                "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                                "text": "„Nachdem John sein Frühstück wortlos verzehrt hatte, ging er, den Frost und das bläulich flimmernde Mondlicht verfluchend, fort.“"
                                            },
                                            {
                                                "example_id": "ca5bcb9a-5253-4591-9fe3-7dd6d57c1604",
                                                "sense_id": "ffab4775-16a1-39e6-a1e3-26dfea04dd79",
                                                "text": "„Später hören wir, dass er zu drei Jahren Gefängnis verurteilt worden ist und die Strafe wortlos angenommen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
