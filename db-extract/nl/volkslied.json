                "senses": [
                    {
                        "sense_id": "1bbb8075-3ff1-3b73-9c45-a5013661e837",
                        "entry_id": "fe3232f1-bdd7-361b-b6ad-a213321862c8",
                        "glosses": [
                            "een lied dat dienst doet als symbool voor een volk of een natie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc74a9f2-9515-4bd2-856f-1e5f21a8337c",
                                "sense_id": "1bbb8075-3ff1-3b73-9c45-a5013661e837",
                                "text": "Bij de huldiging werd het volkslied van Nederland gezongen."
                            },
                            {
                                "example_id": "d0631f42-f22b-454d-a33d-76520894a61b",
                                "sense_id": "1bbb8075-3ff1-3b73-9c45-a5013661e837",
                                "text": "Een blaasorkest speelde ons volkslied en iets wat het Hongaarse volkslied moest zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0fb3e48-ea11-306f-979b-188b9ef2259f",
                        "entry_id": "fe3232f1-bdd7-361b-b6ad-a213321862c8",
                        "glosses": [
                            "oud, overgeleverd populair lied"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eafec1b-ec74-453d-b25e-c3e1cca659e6",
                        "source_entry_id": "fe3232f1-bdd7-361b-b6ad-a213321862c8",
                        "source_sense_id": "1bbb8075-3ff1-3b73-9c45-a5013661e837",
                        "source_sense_description": "een lied dat dienst doet als symbool voor een volk of een natie",
                        "target_lang_word": "Nationalhymne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nationalhymne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10a109b4-6b14-3059-9cfc-d1fbf384c05c",
                                        "entry_id": "7eea2c4d-fe0e-39d1-8141-4f35f69df243",
                                        "glosses": [
                                            "die in der Regel offizielle Hymne einer Nation, oft wird auch eine Staatshymne als Nationalhymne bezeichnet, auch wenn der entsprechende Staat mehr als eine Nation umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee92a713-827c-42f6-aa04-aec819590c65",
                                                "sense_id": "10a109b4-6b14-3059-9cfc-d1fbf384c05c",
                                                "text": "Die Marseillaise ist die Nationalhymne der Franzosen."
                                            },
                                            {
                                                "example_id": "67b58208-8eb4-485f-bc7b-375789a1576e",
                                                "sense_id": "10a109b4-6b14-3059-9cfc-d1fbf384c05c",
                                                "text": "Es ist Anstand, sich zu Ehren einer Nationalhymne zu erheben und das Haupt zu entblößen."
                                            },
                                            {
                                                "example_id": "a57f9d59-e9c8-4519-8a75-51e8fca9e64b",
                                                "sense_id": "10a109b4-6b14-3059-9cfc-d1fbf384c05c",
                                                "text": "„Eine Nationalhymne läßt sich schlecht am Reißbrett entwerfen und oktroyieren.“"
                                            },
                                            {
                                                "example_id": "ecfe0748-2070-43c2-8bbe-a0dff736c03b",
                                                "sense_id": "10a109b4-6b14-3059-9cfc-d1fbf384c05c",
                                                "text": "„Dieses Lied wurde zu einer Art inoffizieller Nationalhymne.“"
                                            },
                                            {
                                                "example_id": "ab8bfc8b-bb3f-49ae-960c-6d7825602255",
                                                "sense_id": "10a109b4-6b14-3059-9cfc-d1fbf384c05c",
                                                "text": "„Das war das Zeichen, die italienische Nationalhymne anzustimmen.“"
                                            },
                                            {
                                                "example_id": "144b4834-0da2-4bc8-a70c-d853ad84e358",
                                                "sense_id": "10a109b4-6b14-3059-9cfc-d1fbf384c05c",
                                                "text": "„Harry, überglücklich wegen der Bilder, sang die amerikanische Nationalhymne, und auch mir ging das Deutschlandlied durch den Sinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2be3be54-74e0-4e34-b6f9-34acd01c1c4f",
                        "source_entry_id": "fe3232f1-bdd7-361b-b6ad-a213321862c8",
