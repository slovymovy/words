                ],
                "senses": [
                    {
                        "sense_id": "00057db3-273e-3425-a787-172f72641420",
                        "entry_id": "1042f47c-fd65-31ad-8c68-228ba5631e97",
                        "glosses": [
                            "wahrnehmbarer Geruch nach Urin in der Umgebungsluft, an sich selbst oder an Materialien; durch das Geruchsorgan wahrgenommene Ausdünstung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4607bda-d0f4-43c7-bde0-fc0a99f566ae",
                                "sense_id": "00057db3-273e-3425-a787-172f72641420",
                                "text": "„Die Assoziation zwischen Harnwegsinfekt und unangenehmem Uringeruch blieb auch signifikant, wenn sie um die Faktoren Geschlecht und vesikouretralen Reflux bereinigt wurde.“"
                            },
                            {
                                "example_id": "a30ff088-f165-4bd9-b631-9bd8b54c95b3",
                                "sense_id": "00057db3-273e-3425-a787-172f72641420",
                                "text": "„Das Amtsgericht Berlin-Mitte (Urt.v. 12.9.2013, 7 C 90/12) sprach einem Mieter 7 % Mietminderung zu, der in einer Kneipengegend wohnt und den beißenden Uringeruch im Treppenhaus beanstandete.“"
                            },
                            {
                                "example_id": "0b3cfec2-d44f-4cc6-8eb9-c9f23cb432aa",
                                "sense_id": "00057db3-273e-3425-a787-172f72641420",
                                "text": "„Jeder Zweite (50 Prozent) beklagt diesen Umstand, durch den sowohl ein Sicherheitsrisiko im Haus entsteht als auch das Problem mit dem Uringeruch verschärft wird.“"
                            },
                            {
                                "example_id": "c9a81cc6-f248-4bcf-be6a-7f2e1f6de9ad",
                                "sense_id": "00057db3-273e-3425-a787-172f72641420",
                                "text": "„Ich ekelte mich vor dem beißenden Uringeruch, der besonders an warmen Tagen förmlich im Treppenhaus stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
