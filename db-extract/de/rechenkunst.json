                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2fa4f21-90c9-3785-860b-8ad0544da9d3",
                        "entry_id": "093615af-fed9-353c-8747-309d94396b6c",
                        "glosses": [
                            "Synonym zu Arithmetik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f3ce19f-f9fa-4a03-8ac4-60f82dba8755",
                                "sense_id": "c2fa4f21-90c9-3785-860b-8ad0544da9d3",
                                "text": "„Die Arithmetik (Rechenkunst) ist die Wissenschaft von der Construction der Zahlen.“"
                            },
                            {
                                "example_id": "4afbc1f5-6316-4d98-a8a4-5b16e72f4e1b",
                                "sense_id": "c2fa4f21-90c9-3785-860b-8ad0544da9d3",
                                "text": "„Er stammt in gerader Linie, um das einzige anekdotische Glanzlicht anzubringen, das mir unter seinen nüchternen biographischen und familiären Daten bekannt wurde, von dem häufig zitierten altdeutschen Rechenmeister Adam Riese ab, der sich auch Ries und Ris schrieb und von 1492 bis 1559 lebte und das erste deutsche Lehrbuch der Rechenkunst verfaßte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7dd41cb-3390-405b-97bf-e9e3f0db9542",
                        "source_entry_id": "093615af-fed9-353c-8747-309d94396b6c",
                        "source_sense_id": "c2fa4f21-90c9-3785-860b-8ad0544da9d3",
                        "source_sense_description": "Synonym zu Arithmetik",
                        "target_lang_word": "arithmetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arithmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90bb4480-5573-326f-82d3-39c6765e11de",
                                        "entry_id": "c68c4465-e669-3494-929a-bb9e828a3c32",
                                        "glosses": [
                                            "The mathematics of numbers (integers, rational numbers, real numbers, or complex numbers) under the operations of addition, subtraction, multiplication, and division."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e6f7014-89fe-45f9-b335-88db6c9462b5",
                                                "sense_id": "90bb4480-5573-326f-82d3-39c6765e11de",
                                                "text": "Note that all correctly rounding arithmetics satisfy property A1, as do those with properly truncating addition. All faithful binary arithmetics and all arithmetics with either properly truncating or correctly chopping addition satisfy property A2."
                                            },
                                            {
                                                "example_id": "012aa134-8e92-4dee-b966-6027eedfad87",
                                                "sense_id": "90bb4480-5573-326f-82d3-39c6765e11de",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across.[…]Closer examination showed that some of these pits did, indeed, contain bacteria, and that in several cases these bacteria were dividing and thus, by the perverse arithmetic of biological terminology, multiplying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cec554e-215b-35f5-a2fd-aa9e8a3ca12c",
                                        "entry_id": "c68c4465-e669-3494-929a-bb9e828a3c32",
                                        "glosses": [
                                            "Number theory"
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arithmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62c47d61-72df-349d-87f6-d7ad42c78e92",
                                        "entry_id": "e9d41b7e-ada6-39c6-929f-430fcef13937",
                                        "glosses": [
                                            "Increasing or decreasing by an arithmetic progression."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85dbbc0b-5ae6-4d81-9a9d-42ea451563fe",
                                                "sense_id": "62c47d61-72df-349d-87f6-d7ad42c78e92",
                                                "text": "Near-synonym: linear"
                                            },
                                            {
                                                "example_id": "582f61b1-eb9f-49ca-9780-f9e0515efba9",
                                                "sense_id": "62c47d61-72df-349d-87f6-d7ad42c78e92",
                                                "text": "Growth in the most mature markets is likely to be arithmetic; on what rational basis could one hope for exponential growth there?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arithmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f33d540c-6a9e-3c6b-8418-5b85dd0d91bd",
                                        "entry_id": "c48c3152-e13b-3c08-af15-2e569f066bc5",
                                        "glosses": [
                                            "Of, relating to, or using arithmetic; arithmetical."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c16dd7b-75b2-4855-994e-8945fd640523",
                                                "sense_id": "f33d540c-6a9e-3c6b-8418-5b85dd0d91bd",
                                                "text": "arithmetic geometry"
                                            },
                                            {
                                                "example_id": "b10577ba-f8e7-4466-91fa-a23ba077c7c1",
                                                "sense_id": "f33d540c-6a9e-3c6b-8418-5b85dd0d91bd",
                                                "text": "Moreover, the latest work of Katz, involving the so-called 'Larsen alternative', provides new criteria, of a very arithmetic nature, to (almost) determine the rational monodromy group"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb4b4e2-8ebb-3721-8f22-8bd8b3bf8544",
                                        "entry_id": "c48c3152-e13b-3c08-af15-2e569f066bc5",
                                        "glosses": [
                                            "Of a progression, mean, etc, computed solely using addition."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56e86825-d1e8-4c81-80cb-2b16ad47d687",
                                                "sense_id": "bdb4b4e2-8ebb-3721-8f22-8bd8b3bf8544",
                                                "text": "arithmetic progression"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c06bb613-9f4c-4f5d-b22d-6b926e9c1a0d",
                        "source_entry_id": "093615af-fed9-353c-8747-309d94396b6c",
                        "source_sense_id": "c2fa4f21-90c9-3785-860b-8ad0544da9d3",
                        "source_sense_description": "Synonym zu Arithmetik",
                        "target_lang_word": "arithmétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arithmétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7652419c-79eb-359b-bb2c-99a07093ec8d",
                                        "entry_id": "c304ab4c-a27c-326a-9db9-08bda344c7f0",
                                        "glosses": [
                                            "Qui est fondé sur les nombres, sur les quantités ; qui est selon les règles de l’arithmétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a98d5a-3979-4bee-931e-1f0df80d3413",
                                                "sense_id": "7652419c-79eb-359b-bb2c-99a07093ec8d",
                                                "text": "En plus de sa machine arithmétique, la première contribution importante de Leibniz aurait été, aux yeux de Huygens, la quadrature arithmétique du cercle, dont Leibniz avait rédigé le premier brouillon en octobre 1674."
                                            },
                                            {
                                                "example_id": "781d763e-96dd-4db6-b70a-e529feb6b091",
                                                "sense_id": "7652419c-79eb-359b-bb2c-99a07093ec8d",
                                                "text": "[La commande expr] peut évaluer des expressions arithmétiques, des comparaisons numériques ou de chaînes de caractères, des opérations booléennes, des opérations sur des chaînes de caractères, et des comparaisons de chaînes de caractères avec des expressions régulières."
                                            },
                                            {
                                                "example_id": "ef4fc21c-27e8-416b-8b30-1990164e2b9e",
                                                "sense_id": "7652419c-79eb-359b-bb2c-99a07093ec8d",
                                                "text": "Marie-Louise Lévesque utilise 4 opérations arithmétiques dans la même phrase: Au restaurant, on peut se diviser l’addition mais on ne peut pas s’y soustraire même si l’on multiplie les compliments. Trop fort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arithmétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd840e67-9727-3b88-8db1-55f8c4199035",
                                        "entry_id": "92673cfe-c400-3dca-9737-cec6715789da",
                                        "glosses": [
                                            "Science des nombres ; art de calculer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47300342-5eb1-401b-acc2-c5a551f52af5",
                                                "sense_id": "dd840e67-9727-3b88-8db1-55f8c4199035",
                                                "text": "Arithmétique spéculative. — Arithmétique pratique. — Les quatre règles de l’arithmétique."
                                            },
                                            {
                                                "example_id": "46e0270f-3d07-4b7b-945d-9ec94541911a",
                                                "sense_id": "dd840e67-9727-3b88-8db1-55f8c4199035",
                                                "text": "Et comme toute l’arithmétique n’est composée que de quatre ou cinq opérations, qui sont, l’addition, la soustraction, la multiplication, la division, et l’extraction des racines, qu’on peut prendre pour une espèce de division […]"
                                            },
                                            {
                                                "example_id": "a70ffa29-f3d7-4ee6-9918-2c400810c729",
                                                "sense_id": "dd840e67-9727-3b88-8db1-55f8c4199035",
                                                "text": "Les arithmétiques commerciales proposent une construction ordonnée du savoir, des questions pratiques nécessaires au commerce à des problèmes qui s’en abstraient."
                                            },
                                            {
                                                "example_id": "7754e5cc-85e8-4263-b05b-5a861e13a40f",
                                                "sense_id": "dd840e67-9727-3b88-8db1-55f8c4199035",
                                                "text": "L’arithmétique et l’algèbre ont toujours mêlé deux traditions, théorique et pratique, que l'on peut symboliser par les noms d’Eudoxe et de Diophante, bien que leurs origines soient sans doute antérieures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810fa044-6a8e-350a-9fbb-385ef7819a08",
                                        "entry_id": "92673cfe-c400-3dca-9737-cec6715789da",
                                        "glosses": [
                                            "Résultat de calcul, de statistique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a691ffa-ab91-4840-a86f-d637d4e439ed",
                                                "sense_id": "810fa044-6a8e-350a-9fbb-385ef7819a08",
                                                "text": "Dans ce domaine, la maussade arithmétique vous a des éloquences qu’on ne saurait contredire."
                                            },
                                            {
                                                "example_id": "936232cd-6a43-4ca7-b33f-adbf63efb2ac",
                                                "sense_id": "810fa044-6a8e-350a-9fbb-385ef7819a08",
                                                "text": "L’arithmétique, au total, domine les hommes; ils espèrent, ils s’efforcent, ils travaillent, ils triomphent pour l’arithmétique. De quoi s’agit-il ?\nIl s’agit d’arriver une minute, une seconde, un quart de seconde plus tôt ; de s’élever seulement de cinquante mètres, de dix mètres, d’un mètre, plus haut […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f672266-fc9b-334b-82b3-42f346324e6f",
                                        "entry_id": "92673cfe-c400-3dca-9737-cec6715789da",
                                        "glosses": [
                                            "Ouvrage qui traite de cette science."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfaf19aa-3b4e-4e2e-b548-2130a3b7dd09",
                                                "sense_id": "3f672266-fc9b-334b-82b3-42f346324e6f",
                                                "text": "La collection de problèmes qui figurent dans ce texte, semblable à celles que l’on trouve dans beaucoup d’autres arithmétiques commerciales de la fin du Moyen Âge, présente des cas résolus qui utilisent les opérations élémentaires des quatre premières espeçias (27 %), la règle de trois (14 %), les proportions (8 %) et même des racines carrées (3 %), et souligne le grand nombre de problèmes dont la résolution exigeait l’utilisation des fractions (35 %)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
