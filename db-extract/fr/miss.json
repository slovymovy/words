        "fr-extract.jsonl": [
            {
                "entry_id": "3a2f0e7b-7ebc-3182-bc8b-417882cf2cb0",
                "word": "miss",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9be5d236-3b40-45ec-b81c-8fad36cdd3d1",
                        "entry_id": "3a2f0e7b-7ebc-3182-bc8b-417882cf2cb0",
                        "tags": [
                            "plural"
                        ],
                        "form": "misses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13ebfa42-a489-3692-8bba-bc1af54deb51",
                        "entry_id": "3a2f0e7b-7ebc-3182-bc8b-417882cf2cb0",
                        "glosses": [
                            "Mademoiselle en Angleterre ou dans le monde anglo-saxon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e543dd4-4b49-4f73-808d-27bef135c8af",
                                "sense_id": "13ebfa42-a489-3692-8bba-bc1af54deb51",
                                "text": "Fulk Ephrinell s’entretient avec miss Horatia Bluett, et je comprends qu’il y ait eu rapprochement entre ces deux natures si parfaitement anglo-saxonnes."
                            },
                            {
                                "example_id": "524312e1-ac3d-406e-8465-87979206e329",
                                "sense_id": "13ebfa42-a489-3692-8bba-bc1af54deb51",
                                "text": "J’eus le plaisir d’y admirer miss Gertrude Ederle, Ailen Riggin et Helen Wainwright, qui vinrent faire une démonstration de plongeons et de nages modernes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6b92969-edff-3eb6-91ee-ae5b4dfce11a",
                        "entry_id": "3a2f0e7b-7ebc-3182-bc8b-417882cf2cb0",
                        "glosses": [
                            "Lauréate d’un concours de beauté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f344eec-cc84-42c1-9b7d-b5ff35df225c",
                                "sense_id": "f6b92969-edff-3eb6-91ee-ae5b4dfce11a",
                                "text": "C’est sur sa tête qu’a été posée — de traviole comme il se doit — la couronne : Flora Coquerel, 19 ans, a été élue Miss France 2014, samedi soir."
                            }
                        ]
                    },
                    {
                        "sense_id": "a24c9bbe-60dd-3ad5-a9ec-474333e84193",
                        "entry_id": "3a2f0e7b-7ebc-3182-bc8b-417882cf2cb0",
                        "glosses": [
                            "Fille un peu simplette."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "95db64a2-6d4f-4d97-973b-1a735ea2aee3",
                                "sense_id": "a24c9bbe-60dd-3ad5-a9ec-474333e84193",
                                "text": "Hé ! miss monde, qui est-ce qui t’as mis ces idées simplistes en tête ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "190f6815-bcdc-4287-947c-5b4ede0ed81a",
                        "source_entry_id": "3a2f0e7b-7ebc-3182-bc8b-417882cf2cb0",
                        "source_sense_description": "Titre de courtoisie pour une jeune fille anglophone",
                        "target_lang_word": "Miss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Miss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6640998-ed2f-3f78-9cf8-d68997c03a83",
                                        "entry_id": "5be4a9a1-f9d3-3a07-a41d-1d390eeb6c18",
                                        "glosses": [
                                            "A form of address, now used chiefly for an unmarried woman; used chiefly of girls before the mid-1700s, and thereafter used also of adult women without regard to marital status.",
                                            "With a surname."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9011fa-4c73-4447-8a67-fc4d5e0d22d5",
                                                "sense_id": "d6640998-ed2f-3f78-9cf8-d68997c03a83",
                                                "text": "These are the two young ladies that I wanted you to meet, Miss Jones and Miss Robinson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a5f6d97-f8ef-38ae-b733-a3a032c977aa",
                                        "entry_id": "5be4a9a1-f9d3-3a07-a41d-1d390eeb6c18",
                                        "glosses": [
                                            "A form of address, now used chiefly for an unmarried woman; used chiefly of girls before the mid-1700s, and thereafter used also of adult women without regard to marital status.",
                                            "With a full name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "594c75fc-5433-4a13-ad44-871402494e04",
                                                "sense_id": "8a5f6d97-f8ef-38ae-b733-a3a032c977aa",
                                                "text": "The victim was named as Miss Jane Doe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b90d4928-3d6f-3aa8-af06-680d31814435",
                                        "entry_id": "5be4a9a1-f9d3-3a07-a41d-1d390eeb6c18",
                                        "glosses": [
                                            "A form of address, now used chiefly for an unmarried woman; used chiefly of girls before the mid-1700s, and thereafter used also of adult women without regard to marital status.",
                                            "With a first name only."
                                        ],
                                        "tags": [
                                            "dated",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f733af0-2e4f-48be-8b39-09f25885d503",
                                                "sense_id": "b90d4928-3d6f-3aa8-af06-680d31814435",
                                                "text": "Excuse me Ma'am, will Miss Julia and Miss Emily be staying for tea?"
                                            },
                                            {
                                                "example_id": "e41ef930-3667-4947-8706-0c0e65720f05",
                                                "sense_id": "b90d4928-3d6f-3aa8-af06-680d31814435",
                                                "text": "She was so mad she wouldn't speak to me for quite a spell, but at last I coaxed her into going up to Miss Emmeline's room and fetching down a tintype of the missing Deacon man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39798413-2984-3639-9f33-108b10ef5f82",
                                        "entry_id": "5be4a9a1-f9d3-3a07-a41d-1d390eeb6c18",
                                        "glosses": [
                                            "A form of address, now used chiefly for an unmarried woman; used chiefly of girls before the mid-1700s, and thereafter used also of adult women without regard to marital status.",
                                            "Used alone."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c7c285-7dd0-492d-9e55-27c48770dce5",
                                                "sense_id": "39798413-2984-3639-9f33-108b10ef5f82",
                                                "text": "Good morning, Miss. May I help you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4138a1f6-ee20-34b2-96d3-19a6e2770821",
                                        "entry_id": "5be4a9a1-f9d3-3a07-a41d-1d390eeb6c18",
                                        "glosses": [
                                            "A form of address for a female teacher or a waitress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f11d15-fec7-4cd0-8921-5c6ffd9bfeb5",
                                                "sense_id": "4138a1f6-ee20-34b2-96d3-19a6e2770821",
                                                "text": "Excuse me, Miss, Donny's been pinching my pencils again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "675b86db-b8bd-3d65-bdf4-297856dd5878",
                                        "entry_id": "5be4a9a1-f9d3-3a07-a41d-1d390eeb6c18",
                                        "glosses": [
                                            "Used in title of the (female) winner of a beauty contest, or certain other types of contest, prefixing the country or other region that she represents, or the category of contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c4ef69-2e22-4838-8164-a3ebb7ae4733",
                                                "sense_id": "675b86db-b8bd-3d65-bdf4-297856dd5878",
                                                "text": "Ladies and gentlemen, please give a round of applause to our lovely new Miss Yorkshire!"
                                            },
                                            {
                                                "example_id": "b23dcf2c-7f3f-4442-83da-694a8af8fa34",
                                                "sense_id": "675b86db-b8bd-3d65-bdf4-297856dd5878",
                                                "text": "And I can now announce that this year's Miss Personality is ... Doris Miggins!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7924d5a5-ba81-36a1-a77f-8b01ae0d17ea",
                                        "entry_id": "5be4a9a1-f9d3-3a07-a41d-1d390eeb6c18",
                                        "glosses": [
                                            "Used in a mock title to point out some quality, or alleged quality, of a girl or woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4f0437-d314-4c5b-a48c-c41b7b8c42dd",
                                                "sense_id": "7924d5a5-ba81-36a1-a77f-8b01ae0d17ea",
                                                "text": "Don't ask me, ask Miss know-it-all over there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
