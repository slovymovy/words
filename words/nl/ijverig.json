    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "32c8d3ba-b00c-3a8c-9342-347692335e6a",
                    "sense_definition": "bereid om met veel inzet en aandacht hard te werken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkhouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>ijverige</w> meisje had al haar woordjes voor de toets goed geleerd.",
                            "target_lang_translations": {
                                "en": "The <w>diligent</w> girl had learned all her words for the test well."
                            }
                        },
                        {
                            "text": "Zij is een <w>ijverige</w> student die elke dag uren in de bibliotheek studeert.",
                            "target_lang_translations": {
                                "en": "She is an <w>industrious</w> student who studies for hours in the library every day."
                            }
                        }
                    ],
                    "synonyms": [
                        "naarstig",
                        "vlijtig"
                    ],
                    "antonyms": [
                        "lui",
                        "traag"
                    ],
                    "common_phrases": [
                        "een ijverige student",
                        "ijverig aan het werk"
                    ],
                    "target_lang_definitions": {
                        "en": "willing to work hard with a lot of effort and attention"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "diligent",
                                "target_lang_sense_clarification": "showing care and conscientiousness in work"
                            },
                            {
                                "target_lang_word": "industrious",
                                "target_lang_sense_clarification": "hard-working and energetic"
                            },
                            {
                                "target_lang_word": "hard-working",
                                "target_lang_sense_clarification": "putting a lot of effort into a job"
                            },
                            {
                                "target_lang_word": "assiduous",
                                "target_lang_sense_clarification": "showing great care and perseverance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30c9d1df-fbd8-345b-9d63-9145579cb96a",
                    "sense_definition": "gevoelens van afgunst of wedijver ervarend tegenover anderen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emoties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten wordt het woord soms gebruikt om een <w>ijverig</w> persoon te beschrijven die jaloers is op andermans succes.",
                            "target_lang_translations": {
                                "en": "In old texts, the word is sometimes used to describe a <w>jealous</w> person who is envious of others' success."
                            }
                        },
                        {
                            "text": "De goden waren <w>ijverig</w> op hun eer en duldde geen concurrentie van stervelingen.",
                            "target_lang_translations": {
                                "en": "The gods were <w>jealous</w> of their honor and tolerated no competition from mortals."
                            }
                        }
                    ],
                    "synonyms": [
                        "naarstig"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze betekenis van jaloers is in het modern Nederlands nagenoeg verdwenen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "experiencing feelings of envy or rivalry towards others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jealous",
                                "target_lang_sense_clarification": "feeling or showing envy of someone or their achievements"
                            },
                            {
                                "target_lang_word": "envious",
                                "target_lang_sense_clarification": "feeling or showing envy"
                            },
                            {
                                "target_lang_word": "zealous",
                                "target_lang_sense_clarification": "in an archaic sense of being fiercely protective or envious"
                            }
                        ]
                    }
                }
            ]
        }
    ]
