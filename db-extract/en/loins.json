                                "target_senses": [
                                    {
                                        "sense_id": "05ecc8e9-730b-3bc0-93b6-b57ecd385225",
                                        "entry_id": "2e453656-cac1-3a26-92f8-eb1a7d5c3a7a",
                                        "glosses": [
                                            "Parties musculaires, situées en arrière de l’abdomen, à droite et à gauche de la colonne vertébrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b48cf6-6bda-4c06-838d-e6677e190149",
                                                "sense_id": "05ecc8e9-730b-3bc0-93b6-b57ecd385225",
                                                "text": "Vos meilleures amies sont unanimes à vanter le galbe de vos lombes, la souplesse de vos hanches et, en général, le classicisme de votre académie."
                                            },
                                            {
                                                "example_id": "0cb7ec0d-e106-49ba-b629-2e620378e16c",
                                                "sense_id": "05ecc8e9-730b-3bc0-93b6-b57ecd385225",
                                                "text": "Le buste penché, l’avant-bras replié sur les lombes, il arpentait la moquette d’une enjambée soucieuse."
                                            },
                                            {
                                                "example_id": "30a9af7a-708c-485d-aa2e-a663957efc59",
                                                "sense_id": "05ecc8e9-730b-3bc0-93b6-b57ecd385225",
                                                "text": "tu caresses mes lombes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ed73401-0135-4b79-9b66-981112f6e864",
                        "source_entry_id": "db8f7113-fbe1-31cf-95fa-a69a66aac9b4",
