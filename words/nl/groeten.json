                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat <w>groette</w> zijn officier strak en formeel.",
                            "target_lang_translations": {
                                "en": "The soldier <w>saluted</w> his officer stiffly and formally.",
                                "ru": "Солдат четко и формально <w>отдал честь</w> своему офицеру.",
                                "pl": "Żołnierz sztywno i formalnie <w>zasalutował</w> swojemu oficerowi.",
                                "de": "Der Soldat <w>salutierte</w> stramm und formell vor seinem Offizier.",
                                "fr": "Le soldat a <w>salué</w> son officier de manière rigide et formelle.",
                                "it": "Il soldato ha <w>salutato</w> il suo ufficiale in modo rigido e formale.",
                                "cs": "Voják svého důstojníka stroze a formálně <w>pozdravil</w>.",
                                "tr": "Asker, subayına sert ve resmi bir şekilde <w>selam durdu</w>.",
                                "es": "El soldado <w>saludó</w> a su oficial de manera rígida y formal.",
                                "zh": "士兵严肃而正式地向长官<w>敬礼</w>。"
                            }
                        },
                        {
                            "text": "Tijdens de ceremonie <w>groetten</w> alle militairen tegelijk.",
                            "target_lang_translations": {
                                "en": "During the ceremony, all soldiers <w>saluted</w> at the same time.",
                                "ru": "Во время церемонии все военные одновременно <w>отдали честь</w>.",
                                "pl": "Podczas ceremonii wszyscy żołnierze jednocześnie <w>oddali honory</w>.",
                                "de": "Während der Zeremonie <w>salutierten</w> alle Soldaten gleichzeitig.",
                                "fr": "Pendant la cérémonie, tous les militaires ont <w>salué</w> en même temps.",
                                "it": "Durante la cerimonia, tutti i militari hanno <w>salutato</w> contemporaneamente.",
                                "cs": "Během ceremoniálu všichni vojáci současně <w>salutovali</w>.",
                                "tr": "Tören sırasında tüm askerler aynı anda <w>selam durdu</w>.",
                                "es": "Durante la ceremonia, todos los militares <w>saludaron</w> al mismo tiempo.",
                                "zh": "仪式期间，所有军人同时<w>敬礼</w>。"
                            }
