                        "entry_id": "24331194-99f2-3bb7-91f0-5208433067f3",
                        "glosses": [
                            "Relatif à la période préhistorique de transition entre le Néolithique et l’âge du bronze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ec3797-0a6b-4a32-ab4b-c5aa06b3a9ae",
                                "sense_id": "01a54489-d4ab-324c-b610-0e4f14d5aa5a",
                                "text": "Les fouilles d’urgence ont révélé la présence de vestiges chalcolithiques."
                            },
                            {
                                "example_id": "4ab21e36-bcb9-4f36-bad2-ba177a0dbff9",
                                "sense_id": "01a54489-d4ab-324c-b610-0e4f14d5aa5a",
                                "text": "L’âge du cuivre, nommé chalcolithique, est donc le premier l’âge des métaux avant l’invention du bronze."
                            }
                        ]
                    },
                    {
