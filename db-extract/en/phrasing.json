                "forms": [
                    {
                        "form_id": "1d29ff45-0d26-43fe-a833-395480e04880",
                        "entry_id": "d6408a9e-8b4c-3ac0-b2cb-6ddcfc60b129",
                        "tags": [
                            "plural"
                        ],
                        "form": "phrasings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffa4388d-5f39-302d-9f6b-dc6eb8abb18a",
                        "entry_id": "d6408a9e-8b4c-3ac0-b2cb-6ddcfc60b129",
                        "glosses": [
                            "The way a statement is put together, particularly in matters of style and word choice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f549752e-ba64-474d-8683-670955d2e533",
                                "sense_id": "ffa4388d-5f39-302d-9f6b-dc6eb8abb18a",
                                "text": "But for the Sir Walter disease, the character of the Southerner -- or Southron, according to Sir Walter's starchier way of phrasing it -- would be wholly modern, in place of modern and medieval mixed, and the South would be fully a generation further advanced than it is."
                            }
                        ]
                    },
                    {
                        "sense_id": "1443ea47-4ed5-3a68-a795-aa3510a4884f",
                        "entry_id": "d6408a9e-8b4c-3ac0-b2cb-6ddcfc60b129",
                        "glosses": [
                            "The way the musical phrases are put together in a composition or in its interpretation, with changes in tempo, volume, or emphasizing one or more instruments over others."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb323d4-c3f7-4543-a86f-9f6bdadce908",
                                "sense_id": "1443ea47-4ed5-3a68-a795-aa3510a4884f",
                                "text": "I found myself truly moved by a stage event for the first time in years. I found myself humming tunes that one might not rightfully call tunes. Days later, I still remember these musical phrasings in little swatches of sound."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1a4382b-9789-46cd-9ef8-70260a349e62",
                        "source_entry_id": "d6408a9e-8b4c-3ac0-b2cb-6ddcfc60b129",
                        "source_sense_description": "the way a statement is put together",
                        "target_lang_word": "bewoording",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewoording",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8bf03797-48ee-31f1-8960-26d749ae2837",
                                        "entry_id": "0b333882-6437-3b7a-b6bc-cc1aed5bb7a3",
                                        "glosses": [
                                            "een beschrijving in woorden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a556176-a679-486a-becc-1878fcbcc12f",
                                                "sense_id": "8bf03797-48ee-31f1-8960-26d749ae2837",
                                                "text": "Voor die prachtige daad was geen bewoording goed genoeg."
                                            },
                                            {
                                                "example_id": "c9a77adc-5185-4f0b-86c9-db6b41dbbd0f",
                                                "sense_id": "8bf03797-48ee-31f1-8960-26d749ae2837",
                                                "text": "Zo'n beetje het laatste plekje in Turkije waar hij zijn vakantie door wilde brengen, al zou hij zich natuurlijk tegen de sympathieke Utrechters in geheel andere bewoordingen uitlaten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ea92e8-65c7-3b38-b3dc-e786b6f51fff",
                                        "entry_id": "0b333882-6437-3b7a-b6bc-cc1aed5bb7a3",
                                        "glosses": [
                                            "de woorden waarmee je iets vertelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6679d058-c8c8-4213-b231-b4e136a90a05",
                                                "sense_id": "05ea92e8-65c7-3b38-b3dc-e786b6f51fff",
                                                "text": "Zijn bewoording van het probleem was kort- en bondig en voor iedereen begrijpelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a840761b-4302-41a1-a279-7324bf0de14f",
                        "source_entry_id": "d6408a9e-8b4c-3ac0-b2cb-6ddcfc60b129",
                        "source_sense_description": "the way a statement is put together",
                        "target_lang_word": "formulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formulation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddbd5809-4c5d-3b55-9caf-20c3c50ec6e8",
                                        "entry_id": "e7e7b4e6-c06c-3423-ba49-5d4481765cb7",
                                        "glosses": [
                                            "Action de formuler, de mettre en forme ou en mots ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c6504a-b356-45d7-aaa7-83c812c92c8e",
                                                "sense_id": "ddbd5809-4c5d-3b55-9caf-20c3c50ec6e8",
                                                "text": "La foule se retire peu à peu du cimetière, et il reste seul dans le grand silence intérieur face à l’appel emmuré des siens, insensible aux tapes amicales qui empoignent maladroitement son épaule, aux mots d’encouragement qui se résument pour la plupart, devant la vanité des paroles, à la formulation de son prénom."
                                            },
                                            {
                                                "example_id": "cfb05bbd-f14c-4d9a-aa70-5100188641a3",
                                                "sense_id": "ddbd5809-4c5d-3b55-9caf-20c3c50ec6e8",
                                                "text": "Je passai les heures qui suivirent à rédiger des missives à ce joueur de golf. Monsieur Saito rythmait ma production en la déchirant, sans autre commentaire que ce cri qui devait être un refrain. Il fallait à chaque fois inventer une formulation nouvelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b57bfd2a-924b-3e2a-8c4a-66a84973072d",
                                        "entry_id": "e7e7b4e6-c06c-3423-ba49-5d4481765cb7",
                                        "glosses": [
                                            "Mise au point de produits sous forme de mélange dont chaque élément a une fonction sans qu'ils ne réagissent chimiquement entre eux ; le contenu de ce mélange."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dcdb2b3-ede2-4f48-a56d-de5e056fbe00",
                                                "sense_id": "b57bfd2a-924b-3e2a-8c4a-66a84973072d",
                                                "text": "Certains constructeurs comme Amazone proposent, avec leurs épandeurs, un livret où figurent les résultats d’essais obtenus avec la plupart des engrais commercialisés. Deux engrais, de même formulation, ne sont jamais identiques."
                                            },
                                            {
                                                "example_id": "e268948d-0b12-40c2-9c2f-dc9c0016e10d",
                                                "sense_id": "b57bfd2a-924b-3e2a-8c4a-66a84973072d",
                                                "text": "L’association entre les pâtes optimisées et un squelette granulaire dont la demande en eau a été définie permet la formulation de bétons autoplaçants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccbed48c-3d79-439d-909a-0407af5b06cf",
