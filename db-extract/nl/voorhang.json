        "nl-extract.jsonl": [
            {
                "entry_id": "221ec4a2-90d0-3e5e-95df-1ccb99405ad1",
                "word": "voorhang",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6aadea20-a81c-4661-9a3d-8cf4b168d02e",
                        "entry_id": "221ec4a2-90d0-3e5e-95df-1ccb99405ad1",
                        "tags": [
                            "plural"
                        ],
                        "form": "voorhangen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a8b434e-ff8a-3039-a9d7-8b9b33700db9",
                        "entry_id": "221ec4a2-90d0-3e5e-95df-1ccb99405ad1",
                        "glosses": [
                            "gordijn dat dient om twee ruimtes van elkaar af te scheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc1aa96-c201-4239-a541-1829d0eee0d3",
                                "sense_id": "3a8b434e-ff8a-3039-a9d7-8b9b33700db9",
                                "text": "Bij binnenkomst wordt de bezoeker geconfronteerd met het extatische karakter van de hadj. Klanken van de azan, de zangerige oproep tot het gebed, en van luid biddende massa’s; manshoge close-ups van pelgrims verzonken in gebed; en luchtopnamen van de tawaf, de massale ommegang rond de Ka’ba, het met zwart brokaat beklede, kubusvormige heiligdom midden in de grote moskee van Mekka. In hetzelfde voorportaal hangt een fraaie sitara, een met gouddraad geborduurde voorhang van de Ka’ba."
                            },
                            {
                                "example_id": "c56238b1-a305-492e-9da7-3049fc6e1c39",
                                "sense_id": "3a8b434e-ff8a-3039-a9d7-8b9b33700db9",
                                "text": "De rots spleet, het voorhang schudde. Angela had van die ogen waarin je een truck kon repareren. Ze was baanwielrenster."
                            }
                        ]
                    },
                    {
                        "sense_id": "364688fc-f11a-3e35-b4ff-73cff95035e5",
                        "entry_id": "221ec4a2-90d0-3e5e-95df-1ccb99405ad1",
                        "glosses": [
                            "controleprocedure voor het parlement bij het delegeren van de wetgevende bevoegdheid zoals bij een Algemene Maatregel van Bestuur of een Ministeriële regeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a27aef04-9614-488c-b2f0-0f3c152ff90d",
                                "sense_id": "364688fc-f11a-3e35-b4ff-73cff95035e5",
                                "text": "„Ik heb er geen enkele behoefte aan om de suggestie te wekken dat ik de Kamer zou willen omzeilen”, aldus Schippers. Ofschoon de AMvB’s, in haar woorden, „geen voorhang behoeven”, zei ze die „met alle plezier” naar de Kamer te sturen. „Zodat wij erover kunnen debatteren en vervolgens tot een conclusie kunnen komen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee4b1184-73f3-4769-8bbb-f950f2f62dce",
                        "source_entry_id": "221ec4a2-90d0-3e5e-95df-1ccb99405ad1",
                        "source_sense_id": "3a8b434e-ff8a-3039-a9d7-8b9b33700db9",
                        "source_sense_description": "gordijn dat dient om twee ruimtes van elkaar af te scheiden",
                        "target_lang_word": "curtain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curtain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "718b18e9-9ae2-38f7-98d5-755d9161df1f",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "A piece of cloth covering a window, bed, etc. to offer privacy and keep out light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7abd6517-5143-47e6-91fb-ca66d4def01f",
                                                "sense_id": "718b18e9-9ae2-38f7-98d5-755d9161df1f",
                                                "text": "He drew the curtains at 11:00pm before falling asleep."
                                            },
                                            {
                                                "example_id": "7e2c6eee-8eba-4792-9e18-8a97e5b1d35c",
                                                "sense_id": "718b18e9-9ae2-38f7-98d5-755d9161df1f",
                                                "text": "Thus the red damask curtains which now shut out the fog-laden, drizzling atmosphere of the Marylebone Road, had cost a mere song, and yet they might have been warranted to last another thirty years. A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire."
                                            },
                                            {
                                                "example_id": "ff9a1077-cd41-4624-9320-06db8bb09bc1",
                                                "sense_id": "718b18e9-9ae2-38f7-98d5-755d9161df1f",
                                                "text": "It is realised that the old Pullman standard sleeper, with its convertible \"sections\", each containing upper and lower berths, and with no greater privacy at night than the curtains drawn along both sides of a middle aisle, has had its day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e5eeb6-4bea-35e0-9cae-6599b54cef51",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "A similar piece of cloth that separates the audience and the stage in a theater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fbac68-8ac3-4dee-8617-b57cf4c855b7",
                                                "sense_id": "74e5eeb6-4bea-35e0-9cae-6599b54cef51",
                                                "text": "“H'm !” he said, “so, so—it is a tragedy in a prologue and three acts. I am going down this afternoon to see the curtain fall for the third time on what[…]will prove a good burlesque ; but it all began dramatically enough. It was last Saturday[…]that two boys, playing in the little spinney just outside Wembley Park Station, came across three large parcels done up in American cloth.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88ce803e-6f5d-384b-8962-4d42f2ca76d5",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "The beginning of a show; the moment the curtain rises."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8046bf4c-9869-41e7-bd5d-ed3673154754",
                                                "sense_id": "88ce803e-6f5d-384b-8962-4d42f2ca76d5",
                                                "text": "He took so long to shave his head that we arrived 45 minutes after curtain and were denied late entry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e682fa1-5c90-3b25-9a65-288317eb8dc1",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "The flat area of wall which connects two bastions or towers; the main area of a fortified wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea590141-9e17-4019-ab42-9e6fc5a448b1",
                                                "sense_id": "9e682fa1-5c90-3b25-9a65-288317eb8dc1",
                                                "text": "Captain Rense, beleagring the Citie of Errona for us, […] caused a forcible mine to be wrought under a great curtine of the walles […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab52fb9-66a6-3158-b6f6-dd25404fd450",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "Death."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "in-plural",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca28afd5-d3ac-42c9-bb02-bb105d7e8c2c",
                                                "sense_id": "aab52fb9-66a6-3158-b6f6-dd25404fd450",
                                                "text": "For life is quite absurd / And death's the final word / You must always face the curtain with a bow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9eca760-90f2-3249-99f8-2d967022847a",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "That part of a wall of a building which is between two pavilions, towers, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b18fb593-4623-3f1c-8764-1e7ce2316b0f",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "A flag; an ensign."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a1bbd4d-0e63-4d0e-8a8a-dde9747563f6",
                                                "sense_id": "b18fb593-4623-3f1c-8764-1e7ce2316b0f",
                                                "text": "Their ragged curtains poorly are let loose"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0e831c-b9a9-3436-9cc0-95432723c6cb",
                                        "entry_id": "5942b371-b08a-3bdb-adad-d1fa5283cfac",
                                        "glosses": [
                                            "The uninterrupted stream of fluid that falls onto a moving substrate in the process of curtain coating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "curtain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2adcac5e-6af8-3001-b6ae-c7e17609ae74",
                                        "entry_id": "3b75e24b-84b7-3ff2-9390-0eb853216337",
                                        "glosses": [
                                            "To cover (a window) with a curtain; to hang curtains."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "354d1643-8895-445e-ae0c-8e2020fac86f",
                                                "sense_id": "2adcac5e-6af8-3001-b6ae-c7e17609ae74",
                                                "text": "In a large bedroom upstairs, the window of which was thickly curtained with a great woollen shawl lately discarded by the landlady, Mrs. Rolliver, were gathered on this evening nearly a dozen persons, all seeking vinous bliss; all old inhabitants of the nearer end of Marlott, and frequenters of this retreat."
                                            },
                                            {
                                                "example_id": "e3fd9cfb-44e6-4a53-ba9b-79ebedbbc4cb",
                                                "sense_id": "2adcac5e-6af8-3001-b6ae-c7e17609ae74",
                                                "text": "The window, softly curtained with dotted swiss, became the focus of my desperate hour-by-hour attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8eca859-9e59-31ee-8061-10a9c8902edb",
                                        "entry_id": "3b75e24b-84b7-3ff2-9390-0eb853216337",
                                        "glosses": [
                                            "To hide, cover or separate as if by a curtain."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62d6bbf-8b0e-4dba-8bb7-c974f402f8ad",
                                                "sense_id": "a8eca859-9e59-31ee-8061-10a9c8902edb",
                                                "text": "And, after conflict such as was supposed / The wandering prince and Dido once enjoy'd, / When with a happy storm they were surprised / And curtain'd with a counsel-keeping cave, / We may, each wreathed in the other's arms, / Our pastimes done, possess a golden slumber;"
                                            },
                                            {
                                                "example_id": "30631df0-c94e-4275-8433-48432b487859",
                                                "sense_id": "a8eca859-9e59-31ee-8061-10a9c8902edb",
                                                "text": "But poetry in a more restricted sense expresses those arrangements of language, and especially metrical language, which are created by that imperial faculty; whose throne is curtained within the invisible nature of man."
                                            },
                                            {
                                                "example_id": "cab462a3-7ec4-4f09-8b1b-84ee897b3f09",
                                                "sense_id": "a8eca859-9e59-31ee-8061-10a9c8902edb",
                                                "text": "He saw a rock that pierced the shifting waters / As they stilled, now curtained by the riding / Of the waves, and leaped to safety on it.",
                                                "translation": "Horace Gregory",
                                                "english": "Horace Gregory"
                                            },
                                            {
                                                "example_id": "979c13b0-f641-4715-8857-d2fd98dcd278",
                                                "sense_id": "a8eca859-9e59-31ee-8061-10a9c8902edb",
                                                "text": "But bleakness still curtained the gray horizon.",
                                                "translation": "Hillel Halkin",
                                                "english": "Hillel Halkin"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
