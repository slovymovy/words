                    {
                        "sense_id": "0840fe43-b491-3d53-92af-919391b816a4",
                        "entry_id": "4b2d8bec-47b5-3dea-bd85-95fc540be877",
                        "glosses": [
                            "Liebe zum Frieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf623635-699e-4223-aec5-82d277051104",
                                "sense_id": "0840fe43-b491-3d53-92af-919391b816a4",
                                "text": "„Wenn das Prinzip der Gleichheit nicht nur in einer einzigen Nation verwirklicht wird, sondern zugleich auch bei mehreren Nachbarvölkern, wie man es heute in Europa sehen kann, so werden die Einwohner dieser verschiedenen Länder trotz der Verschiedenheit der Sprache, Gebräuche und Gesetze wenigstens in dem einen Punkte übereinstimmen, nämlich in der Furcht vor Kriegen und in der Friedensliebe.“"
                            },
                            {
                                "example_id": "7c349304-f824-44fa-b426-2eaf0541acdc",
                                "sense_id": "0840fe43-b491-3d53-92af-919391b816a4",
                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
