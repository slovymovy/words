                    },
                    {
                        "translation_id": "0a06632f-73c0-428e-bb23-4214a7303613",
                        "source_entry_id": "50bfb121-95a4-3d45-a3a1-bcb1c34fa475",
                        "source_sense_id": "7f0c1493-9a6a-3af5-a5c6-0c3182ab79c4",
                        "source_sense_description": "erneuter Beginn einer Sache, die beendet oder unterbrochen wurde",
                        "target_lang_word": "recommencement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recommencement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c341cb2-0e05-31d7-b7e6-2c03a3b27282",
                                        "entry_id": "67115f7e-c97c-3f87-835b-ef050a65c494",
                                        "glosses": [
                                            "Action de recommencer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63bc6b25-8343-4e59-b7af-fb6b2670a1a4",
                                                "sense_id": "8c341cb2-0e05-31d7-b7e6-2c03a3b27282",
                                                "text": "On dit souvent que l’histoire est un perpétuel recommencement."
                                            },
                                            {
                                                "example_id": "64248644-175e-4f85-a70d-eea6469dfe40",
                                                "sense_id": "8c341cb2-0e05-31d7-b7e6-2c03a3b27282",
                                                "text": "La couture de ces pièces d’étoffe n’alla pas non plus sans tâtonnements, et recommencements."
                                            },
                                            {
                                                "example_id": "dcf3fe48-098f-43a6-a25a-cfea36f5d6a5",
                                                "sense_id": "8c341cb2-0e05-31d7-b7e6-2c03a3b27282",
                                                "text": "Ça m’est bien égal qu’il soit mal écrit et j’avais autre chose à faire, en l’écrivant, que de perdre mon temps à soigner mes phrases. D’ailleurs, bien finis pour moi, les chinoiseries de l’écriture et les recommencements, comme il y a encore deux ans, quinze fois de la même page."
                                            },
                                            {
                                                "example_id": "98cfee8d-3abe-437b-b1d3-73b06e48cdc8",
                                                "sense_id": "8c341cb2-0e05-31d7-b7e6-2c03a3b27282",
                                                "text": "Mais ma torpeur s’évanouissait, et je fis quelques mouvements qui dénotaient le recommencement de ma terreur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
