                "senses": [
                    {
                        "sense_id": "ecd09c0c-bec7-3d42-9537-3bd7601b08b6",
                        "entry_id": "fb75f235-745f-3322-8d0d-5c39f009765b",
                        "glosses": [
                            "een middel om de was te reinigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76128e61-ed45-4884-b84e-7667fa24eb41",
                                "sense_id": "ecd09c0c-bec7-3d42-9537-3bd7601b08b6",
                                "text": "Het belangrijkste bestanddeel van wasmiddel is zeep."
                            },
                            {
                                "example_id": "eda03f8b-af6d-4943-9409-10f2b5a0f3e4",
                                "sense_id": "ecd09c0c-bec7-3d42-9537-3bd7601b08b6",
                                "text": "Vermoedelijk waren de mooie vloerkleden ook gewassen met groene zeep omdat andere soorten zeep en wasmiddel op rantsoen waren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "940c0564-4e17-4485-afd5-a58916af47f0",
                        "source_entry_id": "fb75f235-745f-3322-8d0d-5c39f009765b",
                        "source_sense_id": "ecd09c0c-bec7-3d42-9537-3bd7601b08b6",
                        "source_sense_description": "een middel om de was te reinigen",
                        "target_lang_word": "Waschmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                        "entry_id": "314ee166-3024-36bb-93b9-be1c8aff7432",
                                        "glosses": [
                                            "Gemisch verschiedener Substanzen in flüssiger, gelartiger oder pulverförmiger Art bezeichnet, das zum Reinigen von Textilien verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12235cf7-3af0-4b47-bcd3-e59390cddab6",
                                                "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                                "text": "„Waschmittel enthalten waschaktive Substanzen, welche in der Lage sind, Verunreinigungen von Textilien zu lösen.“"
                                            },
                                            {
                                                "example_id": "f7e1c7e1-a70c-4663-8918-42ecd70eaa3c",
                                                "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                                "text": "Neuerdings gibt es auch Waschmittel, die nicht rein chemisch, sondern natürlicher und umweltverträglicher sein sollen."
                                            },
                                            {
                                                "example_id": "6690e830-a98e-4556-acab-43bb21b7d6ac",
                                                "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                                "text": "„Sie habe auch Waschmittel dabei.“"
                                            },
                                            {
                                                "example_id": "786a3e2a-c4b3-4944-921c-bead14d61dbc",
                                                "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                                "text": "„Etwa 630.000 Tonnen Waschmittel werden jährlich in Deutschland verbraucht. Umgerechnet verbraucht jeder Einwohner fast 8 Kilogramm Waschmittel im Jahr.“"
                                            },
                                            {
                                                "example_id": "e07055e0-c1dd-4a1e-9100-cad004d2c09b",
                                                "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                                "text": "„Es gibt keine per se umweltfreundlichen Waschmittel, da Waschmittel grundsätzlich Kläranlagen und Gewässer mit Chemikalien belasten.“"
                                            },
                                            {
                                                "example_id": "5b9f5420-2c1c-4bbb-b662-b930e8226901",
                                                "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                                "text": "„Lieber fest statt flüssig: Waschpulver sind umweltschonender als flüssige Waschmittel.“"
                                            },
                                            {
                                                "example_id": "6ae4fad5-e9bd-4754-9879-f5cd96068ec0",
                                                "sense_id": "82036142-4948-3f23-8c04-7d89701741d7",
                                                "text": "„Vorwäsche ist bei den heutigen Waschmitteln entbehrlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
