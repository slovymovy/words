                        "glosses": [
                            "rasa psów myśliwskich lub pokojowych o falistej sierści i długich wiszących uszach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ea03cc-39af-4d84-a9a5-280353712f2f",
                                "sense_id": "047c65d6-6828-3624-83c8-3c1394c5818b",
                                "text": "Żyła długo opowiadał mi o swoim spanielu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "017b04c1-5cd3-4dc9-86ad-e1fe5c55b18d",
                        "source_entry_id": "bfb92d55-9dc5-31aa-94a1-710b6c715d73",
                        "source_sense_id": "047c65d6-6828-3624-83c8-3c1394c5818b",
