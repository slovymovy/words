                "senses": [
                    {
                        "sense_id": "11f6c7db-0aa0-3b6a-995e-ec57650363b5",
                        "entry_id": "a52e29fe-ae4c-3d33-8e99-f05943df738f",
                        "glosses": [
                            "Familie, aus der eine Vielzahl an Investoren stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94fe4fe5-d4ca-47ed-876d-bd27e3782c79",
                                "sense_id": "11f6c7db-0aa0-3b6a-995e-ec57650363b5",
                                "text": "„Er entstammt einer Berliner Investorendynastie.“"
                            },
                            {
                                "example_id": "2cf52160-d776-457e-bde5-f45a27ec083a",
                                "sense_id": "11f6c7db-0aa0-3b6a-995e-ec57650363b5",
                                "text": "„Die Wolfsburger stocken ihren Anteil durch Kauf der Anteile der schwedischen Investorendynastie Wallenberg auf 69 Prozent der Stimmrechte auf.“"
                            },
                            {
                                "example_id": "6cf6c244-544d-4995-8331-22977bee2726",
                                "sense_id": "11f6c7db-0aa0-3b6a-995e-ec57650363b5",
                                "text": "„In unserer Position als Investorendynastie müssen wir manchmal auch mit Härte reagieren, was von dem Volk da draußen nicht verstanden wird.“"
                            },
                            {
                                "example_id": "fe32236e-38a2-403e-8b06-87e4c2dde2a7",
                                "sense_id": "11f6c7db-0aa0-3b6a-995e-ec57650363b5",
                                "text": "„Er entstammt nämlich einer Duisburger Investorendynastie, die im Bereich Immobilien so etwas ist wie die Albrechts im Bereich Einzelhandel: sehr diskret, sehr reich und nicht immer unumstritten.“"
                            },
                            {
                                "example_id": "2d6ad16e-a25b-461a-869d-3f7a81f1304a",
                                "sense_id": "11f6c7db-0aa0-3b6a-995e-ec57650363b5",
                                "text": "„Die schwedische Investorendynastie Wallenberg blockiert einem Zeitungsbericht zufolge die Gespräche über eine Lkw-Allianz zwischen MAN und Scania.“"
                            },
                            {
                                "example_id": "ef2b7d50-22fc-4962-9c7d-3d9a4a86f33b",
                                "sense_id": "11f6c7db-0aa0-3b6a-995e-ec57650363b5",
                                "text": "„Rosinger Group Konzernchef Gregor Rosinger stammt aus einer Börsianer- und Investorendynastie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
