                    "frequency": "Low",
                    "semantic_group_id": "cause_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans une négociation diplomatique difficile, le moral des délégués reste un <w>impondérable</w> déterminant."
                        },
                        {
                            "text": "La confiance du public est un de ces <w>impondérables</w> qui font basculer une élection."
                        }
                    ]
                }
            ]
        },
