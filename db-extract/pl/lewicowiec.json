                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1eb6662-2c18-42ee-bd91-4b776c11fbf7",
                                                "sense_id": "8cd6f8c6-fbda-31e4-9999-0b8de0de0f7e",
                                                "text": "Левые составляют большинство во французском парламенте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d66d6e2a-b30b-3703-8707-0d67ac46aebf",
                                        "entry_id": "f9d429e6-6ce9-3a64-a3e4-835d77b3aedb",
                                        "glosses": [
                                            "разг. неофициальный; сомнительный по статусу, происхождению или качеству (часто в кавычках)"
