                "senses": [
                    {
                        "sense_id": "c3f3958b-a179-3640-99e4-a66b9b866cf3",
                        "entry_id": "fe6d72dd-263f-3b77-bf4a-300927167ac5",
                        "glosses": [
                            "Faire perdre son caractère étagé à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20fad6da-ff4d-4ced-b2c5-c6fb848f1da5",
                                "sense_id": "c3f3958b-a179-3640-99e4-a66b9b866cf3",
                                "text": "Quand un bassin a été bien « dépollué » et sans attendre l’ultime action de dépollution, améliorer la naturalité des rivières, et, surtout l’écoulement des cours d’eau, qu’il est impératif de « désétager », est le « plus » qui permet d’atteindre enfin le « bon état »"
                            },
                            {
                                "example_id": "57288f1e-9dfe-4c1a-b9f4-292a6d217802",
                                "sense_id": "c3f3958b-a179-3640-99e4-a66b9b866cf3",
                                "text": "Utilisation transférée et « désétagée » des poings et des pieds."
                            },
                            {
                                "example_id": "d2098461-3087-4f47-8cc1-f4f094fc1a1a",
                                "sense_id": "c3f3958b-a179-3640-99e4-a66b9b866cf3",
                                "text": "Lorsque l'erreur PID P2273 dépasse cette valeur, un moteur est étagé / désétagé sans tenir compte des compteurs de retard."
                            }
                        ]
                    }
