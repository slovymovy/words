                "senses": [
                    {
                        "sense_id": "c4471b0e-eb32-3268-b576-2557aaeba66f",
                        "entry_id": "2b30af53-ec45-32c5-b254-5a17e36b43e8",
                        "glosses": [
                            "Jagd auf Kängurus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9efa94d-066e-4404-928f-ebe0fa266db4",
                                "sense_id": "c4471b0e-eb32-3268-b576-2557aaeba66f",
                                "text": "„Gab es so etwas wie Freizeit, gingen viele auf die Kängurujagd.“"
                            },
                            {
                                "example_id": "297e95fc-e343-4463-a997-c2c3c41351f2",
                                "sense_id": "c4471b0e-eb32-3268-b576-2557aaeba66f",
                                "text": "„In Australien ist die Kängurujagd ein beliebter \"Sport\" und jedes Jahr werden Hunderttausende von Tieren wegen ihres weichen wolligen Felles und wegen ihres Fleisches getötet.“"
                            },
                            {
                                "example_id": "fdae5ec5-8e73-4e5f-be99-290c137726c1",
                                "sense_id": "c4471b0e-eb32-3268-b576-2557aaeba66f",
                                "text": "„Vielmehr ist der Deerhound nahezu in aller Welt verbreitet und wird sogar noch mancherorts für die Kojoten-, Fuchs-, Schakal- oder auch Kängurujagd eingesetzt.“"
                            },
                            {
                                "example_id": "33925940-b328-4b0a-bded-2faa5dfaf00d",
                                "sense_id": "c4471b0e-eb32-3268-b576-2557aaeba66f",
                                "text": "„Ein anderes Hobby, welches ich leidenschaftlich pflege, ist die Kängurujagd in der heimischen Umgebung.“"
                            },
                            {
                                "example_id": "88945217-765c-48dd-9215-b17af9ecc616",
                                "sense_id": "c4471b0e-eb32-3268-b576-2557aaeba66f",
                                "text": "„Michael Archer, Direktor des australischen Museums in Sydney, befürwortet die Kängurujagd als \"Erlösung vor dem Hungertod\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
