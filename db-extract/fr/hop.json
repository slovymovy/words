                "senses": [
                    {
                        "sense_id": "1eb63dd0-a3dd-3d0f-93f2-135ff84f6ee1",
                        "entry_id": "74205cfc-b1aa-3efb-8368-69322a194b2d",
                        "glosses": [
                            "Association française créée en 2015 à la suite de l'instauration du délit d’obsolescence programmée dans le code de la consommation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1635b9-5e20-4ca8-bf2f-1f9bda4daca6",
                                "sense_id": "1eb63dd0-a3dd-3d0f-93f2-135ff84f6ee1",
                                "text": "Laëtitia Vasseur, déléguée générale et cofondatrice de HOP, répond à nos questions."
                            },
                            {
                                "example_id": "22aaef08-9bf3-4d59-a7b7-a060744fc91f",
                                "sense_id": "1eb63dd0-a3dd-3d0f-93f2-135ff84f6ee1",
                                "text": "HOP (Halte à l’obsolescence programmée) a pour objectif de sensibiliser en faveur de l’allongement de la durée de vie des produits."
                            },
                            {
                                "example_id": "05d8e2ec-4b8b-4fe3-8b7e-e442f5107040",
                                "sense_id": "1eb63dd0-a3dd-3d0f-93f2-135ff84f6ee1",
                                "text": "L’association HOP a été créée avant tout pour la protection du consommateur."
                            }
                        ]
                    }
