                        "glosses": [
                            "antike römische Provinz, die unter anderem [1] beinhaltet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b409137-5c18-4be2-adad-1bcc7fcfaee5",
                                "sense_id": "be4834fe-b372-3489-9c4d-2dcbb3cd58de",
                                "text": "„Die Geschichte von Dalmatien beginnt mit der Unabhängigkeitserklärung der Dalmatiner gegenüber dem illyrischen König Gentius.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
