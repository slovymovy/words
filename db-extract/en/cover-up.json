    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "451491a4-b230-31b0-a437-30631314f9da",
                "word": "cover-up",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "447ba836-8be4-4ebf-bd4a-36b72883ca25",
                        "entry_id": "451491a4-b230-31b0-a437-30631314f9da",
                        "tags": [
                            "plural"
                        ],
                        "form": "cover-ups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                        "entry_id": "451491a4-b230-31b0-a437-30631314f9da",
                        "glosses": [
                            "An attempt to conceal or disguise something, especially a wrongdoing or a mistake."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7da3985-b133-4ced-a619-9ea6e2dba544",
                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                "text": "Truthfulness means no lies and no cover-ups. Compassion means being kind and helpful to others. Forbearance means being able to tolerate and suffer, and not fight back."
                            },
                            {
                                "example_id": "79dbf3f9-e355-4619-aa49-cca421355ce5",
                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                "text": "[War metaphors] are used, either consciously or unconsciously, for specific effect and purpose. They are used, not so much as descriptions, but rather to convey additional moral, imaginative or judgmental information. The ubiquitous \"war between the sexes\" is, in fact, a cover-up of the fact that men, generally, have social power over women."
                            },
                            {
                                "example_id": "0499ff70-7dea-4e81-9adb-25d27dfb7eb3",
                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                "text": "Mona: Oh, of course, a cover-up! You know, the whole town would panic if they knew a misunderstood Frankensteinosaurus was on a bloodthirsty rampage! Your secret's safe, Officer. I don't want to cause an international panic any more than you do."
                            },
                            {
                                "example_id": "226a59a9-e432-48f4-baf5-dab0154eb438",
                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                "text": "These divine qualities migrated to Mary because of deficiencies in the theology of God, in Christology and in pneumatology. It makes no lasting sense to retain this as a permanent status quo, using Mary as a cover-up for defective notions of the divine."
                            },
                            {
                                "example_id": "ca6f7752-05e8-48e0-8bcd-4d5a7a16b23c",
                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                "text": "Many supporters believed Donald Trump would finally expose government cover-ups once he returned to power. But more than six months into his new term, those much-hyped conspiracy theories have either been debunked or quietly fallen apart."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3077a31-b341-3e67-8140-3e055f77e74e",
                        "entry_id": "451491a4-b230-31b0-a437-30631314f9da",
                        "glosses": [
                            "An item of clothing to be worn over a swimsuit while not in the water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b5444d5-9ba7-48a0-a579-9370a677a795",
                                "sense_id": "f3077a31-b341-3e67-8140-3e055f77e74e",
                                "text": "The women usually wore bikini tops with shorts, swimsuits underneath cover-ups or just swimsuits. Men came in various types of trunks, from traditional boxers, to Speedos, to G-string trunks that showcased their packages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98d83223-034c-4754-bac8-c6a4618ecf53",
                        "source_entry_id": "451491a4-b230-31b0-a437-30631314f9da",
