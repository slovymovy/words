                "senses": [
                    {
                        "sense_id": "c25a9814-d308-3215-b9c0-9ee1241877bc",
                        "entry_id": "88ba4c1d-9b00-3ae3-8a5f-31c4694b0ffa",
                        "glosses": [
                            "Faire perdre son caractère cosmopolite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf82869-32bf-4815-9fe4-38bb30b91ab6",
                                "sense_id": "c25a9814-d308-3215-b9c0-9ee1241877bc",
                                "text": "Ils tentèrent de lancer un mouvement pour un nouveau judaïsme dans l’espoir de le « décosmopolitiser »."
                            },
                            {
                                "example_id": "e6fb81e8-a619-48ea-addc-6603b864917e",
                                "sense_id": "c25a9814-d308-3215-b9c0-9ee1241877bc",
                                "text": "\"Décosmopolitiser\" le Top14."
                            },
                            {
                                "example_id": "f0ff5c6c-8393-4038-bfaa-ba436066e609",
                                "sense_id": "c25a9814-d308-3215-b9c0-9ee1241877bc",
                                "text": "Sujet : j’ai réussi à décosmopolitiser mon esprit"
                            },
                            {
                                "example_id": "7ce012bd-4a96-4584-be19-79c282e729e3",
                                "sense_id": "c25a9814-d308-3215-b9c0-9ee1241877bc",
                                "text": "Mais quand on est comme M. Horn, on ne doit pas commettre la contradiction de se décosmopolitiser en se francisant, et l’on retourne en Hongrie écrire ces pamphlets contre le pain qu’on a mangé."
                            }
                        ]
                    }
                ],
