                "senses": [
                    {
                        "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                        "entry_id": "dc2e66ee-74ea-32ba-89aa-7cb63a5d1c52",
                        "glosses": [
                            "Wirkung über einen kurzen Zeitraum hinaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34bff0de-65df-4e20-9b8b-fe51e85cb2eb",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "In der politischen Diskussion spielt Nachhaltigkeit zunehmend eine Rolle."
                            },
                            {
                                "example_id": "2d6988d1-462e-4d0b-b32b-f71ada346487",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "Die Nachhaltigkeit dieser Therapie konnte statistisch belegt werden."
                            },
                            {
                                "example_id": "75be526c-9786-42bb-8d03-beebc956d831",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "[Olympia 2022:] „Winterspiele mit 100 Prozent Kunstschnee – nicht erst in China steht Nachhaltigkeit ganz hinten an.“"
                            },
                            {
                                "example_id": "811dd60b-8e82-47d9-aa8e-d7ebd7c39bcb",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "„Regionale Produkte werden häufig mit Nachhaltigkeit in Verbindung gebracht. Kurze Transportwege können beispielsweise helfen, das Klima zu schützen.“"
                            },
                            {
                                "example_id": "46c9192a-3b33-46d9-bd68-569ec9a7753b",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "„Die Stadt Kaiserslautern hat im Internet eine Umfrage zur Nachhaltigkeit gestartet.“"
                            },
                            {
                                "example_id": "ff05abda-e16d-4a93-9d37-81c6af2ebf88",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "„Dass immer mehr Urlauber bei der Wahl ihres Reiseziels auf Nachhaltigkeit achten, hat man längst auch auf Mallorca erkannt.“"
                            },
                            {
                                "example_id": "7ce5fe02-007e-45bc-ad7a-fb1c2c7b6ec3",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "„Der Einsatz von Linux hilft somit, den Rechnermüllberg mindestens um den Faktor 2 zu reduzieren. Der Einsatz von Linux führt somit zu einer wirklichen und gelebten Nachhaltigkeit.“"
                            },
                            {
                                "example_id": "3f8d26d8-08ef-4292-acf5-0fbeb6cf31f1",
                                "sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                                "text": "„Smartphones können sich nicht mit Ruhm bekleckern: Schlechte Arbeitsbedingungen in chinesischen Fabriken, problematischer Rohstoffabbau – und bei der Nachhaltigkeit schneiden sie auch nicht gut ab: Selbst den Akku austauschen oder Reparaturen durchführen – geht nicht so einfach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "628dd4ba-7618-4bcd-b02d-8a20b1668c3d",
                        "source_entry_id": "dc2e66ee-74ea-32ba-89aa-7cb63a5d1c52",
                        "source_sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
                        "source_sense_description": "Wirkung über einen kurzen Zeitraum hinaus",
                        "target_lang_word": "sustainability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sustainability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4423f9de-6e51-39e5-8681-fba75853a920",
                                        "entry_id": "60d7e7d0-56db-3734-b87a-6a22f606910f",
                                        "glosses": [
                                            "The ability to sustain something.",
                                            "A means of configuring civilization and human activity so that society, its members and its economies are able to meet their needs and express their greatest potential in the present, while preserving biodiversity and natural ecosystems, planning and acting for the ability to maintain these necessary resources for future generations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6831f68c-bf16-44ca-9796-1fbfb5509bdb",
                                                "sense_id": "4423f9de-6e51-39e5-8681-fba75853a920",
                                                "text": "None of the processing happens out in the open ocean, said Gaurav Sant, an Equatic founder and professor of sustainability at UCLA, “this is important because it allows you to measure everything that you’re doing perfectly.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c7d8811-bc65-3658-837c-6bbb7ebdf334",
                                        "entry_id": "60d7e7d0-56db-3734-b87a-6a22f606910f",
                                        "glosses": [
                                            "The ability to sustain something.",
                                            "The ability to sustain a business in the long term, which is a state that is partly dependent on, but broader than, profitability today or in the short term; it involves aspects of a plausible path toward eventual profitability (as applies to a startup) and ecologic sustainability (for example, the long-term dependence of the timber/lumber industry on forest preservation and renewal, or of fisheries on viable fish stocks)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb069769-2d18-4c0d-aaba-3af291784a7d",
                                                "sense_id": "3c7d8811-bc65-3658-837c-6bbb7ebdf334",
                                                "text": "The making of buggy whips is the proverbial exemplar of a business without sustainability in the face of technological change."
                                            },
                                            {
                                                "example_id": "153f9770-f6f5-4976-8299-1f1a97c0da56",
                                                "sense_id": "3c7d8811-bc65-3658-837c-6bbb7ebdf334",
                                                "text": "In a war of words that has broken out between Khan and Secretary of State for Transport Grant Shapps, the Mayor was accused of sending revenue-raising proposals to Shapps some three weeks late, giving him little choice but to extend negotiations. Khan countered this by alleging that 'unfair' conditions, such as raising council tax, are being attached to any new funding deal that would \"punish Londoners\" for the effect the pandemic has had on passenger numbers. He added: \"These short-term deals are trapping TfL on life support rather than putting it on the path to long-term sustainability.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f476752d-1b3a-30aa-b72e-f3cbae98c836",
                                        "entry_id": "60d7e7d0-56db-3734-b87a-6a22f606910f",
                                        "glosses": [
                                            "The ability to sustain something.",
                                            "The ability to sustain a civic practice or process in the long term, such as democracy, entrepreneurialism, a war effort, or others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dc1ddb7-aa09-4dd2-af29-5d6be71bfaaa",
                                                "sense_id": "f476752d-1b3a-30aa-b72e-f3cbae98c836",
                                                "text": "universal primary and secondary education, without which the sustainability of innovation and entrepreneurialism seems questionable"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c51a9bd-48c3-4546-a655-f74faf56c463",
                        "source_entry_id": "dc2e66ee-74ea-32ba-89aa-7cb63a5d1c52",
                        "source_sense_id": "a310eb8f-693c-3c7e-b604-cb468994fb9c",
