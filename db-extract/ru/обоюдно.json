                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "4a72028e-5546-451b-a873-7ac181658d30",
                                "sense_id": "b042562e-8c2f-36be-b17a-800f0c1ee728",
                                "text": "Мы обоюдно заинтересованы в том, чтобы наращивать усилия антитеррористической коалиции и решать другие глобальные проблемы, отвечать на новые угрозы и вызовы на коллективной основе."
                            },
                            {
                                "example_id": "ef1aea0a-0ac3-4c16-b42e-79d52ca85bf7",
                                "sense_id": "b042562e-8c2f-36be-b17a-800f0c1ee728",
                                "text": "Её глаза голубые, твои — карие, её волосы белее снега, твои — черны, как ночь. Обоюдно выигрышный контраст, думаешь ты."
                            }
                        ]
                    }
