                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb2f801-30de-4146-b5d2-15000212bce5",
                                                "sense_id": "0b491609-1fe1-39ae-a86e-a1bc4309aa7e",
                                                "text": "Przed królem jechali rycerze na koniach odzianych w zdobne czapraki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "4f749b1e-e19a-37c1-8369-780c0c524eaa",
                                        "entry_id": "a414ab62-8544-3b22-96a5-6a0369345f3b",
                                        "glosses": [
                                            "derka lub okrycie zakładane koniowi lub psu, które zabezpieczają przed chłodem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d6e5183-7ba4-4709-8ff1-b98df4c1e739",
                                                "sense_id": "4f749b1e-e19a-37c1-8369-780c0c524eaa",
                                                "text": "Nasza klaczka dostanie nowy czaprak."
                                            },
                                            {
                                                "example_id": "265a7f6f-2756-44d6-9a8a-291adfa0aed1",
                                                "sense_id": "4f749b1e-e19a-37c1-8369-780c0c524eaa",
                                                "text": "Babciny jamnik okryty wełnianym czaprakiem siedział na kolanach."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "0fdbadaa-635a-37e4-a9d3-6a4af8de69a9",
