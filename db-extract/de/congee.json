                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91a26799-82e4-321d-aa49-80043e7c0d2d",
                                        "entry_id": "5d8cc82d-d5a7-3431-8897-9dce9579f81a",
                                        "glosses": [
                                            "Leave, formal permission for some action, (originally and particularly):",
                                            "Formal permission to leave; a passport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ee56091-565f-3887-bde8-b6aa773221c9",
                                        "entry_id": "5d8cc82d-d5a7-3431-8897-9dce9579f81a",
                                        "glosses": [
                                            "Formal dismissal; (figurative) any dismissal; (originally & particularly humorously ironic) abrupt dismissal without ceremony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e38f034-0638-45bd-86f9-d0c8a5267f6d",
                                                "sense_id": "6ee56091-565f-3887-bde8-b6aa773221c9",
                                                "text": "So courteous conge both did giue and take,\nWith right hands plighted, pledges of good will."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6babdd45-925f-3846-a2b4-286410d258b4",
                                        "entry_id": "5d8cc82d-d5a7-3431-8897-9dce9579f81a",
                                        "glosses": [
                                            "Formal leavetaking; (figurative) any farewell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ec40faf-f808-3e46-bf16-c1ea88ed9cd9",
                                        "entry_id": "5d8cc82d-d5a7-3431-8897-9dce9579f81a",
                                        "glosses": [
                                            "A fee paid to make another go away, (particularly) alms to a persistent beggar."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f8628e5-6efb-3322-a14e-b91086127ad2",
                                        "entry_id": "5d8cc82d-d5a7-3431-8897-9dce9579f81a",
                                        "glosses": [
                                            "A bow, curtsey, or other gesture (originally) made at departure but (later) including at greeting or in obeissance or respect."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6c60c39-5610-4afc-a54b-32495f3865b1",
                                                "sense_id": "1f8628e5-6efb-3322-a14e-b91086127ad2",
                                                "text": "As salutations, reverences, or conges, by which some doe often purchase the honour, (but wrongfully) to be humble, lowly, and courteous[…]."
                                            },
                                            {
                                                "example_id": "5b65cd96-d040-4e17-94d9-d3bf2cc48745",
                                                "sense_id": "1f8628e5-6efb-3322-a14e-b91086127ad2",
                                                "text": "So saying, he bowed with a thousand apish congês, and presented his paper to Peregrine […]."
                                            },
                                            {
                                                "example_id": "83c9167c-449e-4777-ae6d-538e54c74e48",
                                                "sense_id": "1f8628e5-6efb-3322-a14e-b91086127ad2",
                                                "text": "“My daughter Rebecca, so please your Grace,” answered Isaac, with a low congee, nothing embarrassed by the Prince’s salutation, in which, however, there was at least as much mockery as courtesy."
                                            },
                                            {
                                                "example_id": "231f2171-8c43-4903-a42d-52a7f1275a63",
                                                "sense_id": "1f8628e5-6efb-3322-a14e-b91086127ad2",
                                                "text": "His speech thus spake the Moor, and took his leave,\nhe and his meiny where the bátels lay:\nformal farewells to chief and crews he gave,\nexchanging congees with due courtesy."
                                            }
                                        ]
                                    }
                                ]
                            },
