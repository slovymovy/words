                ],
                "senses": [
                    {
                        "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                        "entry_id": "736f3581-809b-313c-9c97-436e37546154",
                        "glosses": [
                            "État, qualité, caractère de ce qui est réciproque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "825413cc-929c-4f83-99af-17f5baa5ed5f",
                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                "text": "E.-H. Weber a fait remarquer que le nerf vague se trouve en réciprocité d'action avec le grand sympathique. Ce dernier est fort peu développé chez les serpents, […]."
                            },
                            {
                                "example_id": "04f9e5a7-0dae-44e3-9e69-103b0e377f53",
                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                "text": "Le système de la réciprocité dans sa forme moderne est le fils ainé du protectionnisme ; s'il en adoucit légèrement les rigueurs, il est l'incarnation même de sa pensée."
                            },
                            {
                                "example_id": "d5f4f573-b5d1-424b-94b4-25990b6ff865",
                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                "text": "La destruction des systèmes de réciprocité africains par la colonisation et la généralisation de la domination du marché capitaliste conduisent à l’ethnocide, à l’« économicide » et au génocide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18dee07a-c5e6-4258-a30f-0c607f7cc91b",
                        "source_entry_id": "736f3581-809b-313c-9c97-436e37546154",
                        "source_sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                        "target_lang_word": "Reziprozität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reziprozität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ede71f5b-d3b1-3886-b2b1-f76688d38ae1",
                                        "entry_id": "171a152f-1ae9-3e39-abb0-ff872808bc21",
                                        "glosses": [
                                            "Gegenseitigkeit, Wechselseitigkeit, Wechselbeziehung"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e34408b-0641-406e-affa-56c1db61a260",
                                                "sense_id": "ede71f5b-d3b1-3886-b2b1-f76688d38ae1",
                                                "text": "„Die Sanktion für Dienste an anderen ist in Japan selbstverständlich Reziprozität […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86c5e5d2-bccf-3264-a4f8-6fd0aeb37a9d",
                                        "entry_id": "171a152f-1ae9-3e39-abb0-ff872808bc21",
                                        "glosses": [
                                            "gegenseitiger Austausch von Gütern oder Leistungen als Teil langfristiger Beziehungen"
                                        ],
                                        "tags": [
                                            "wirtschaftsethnologisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c762f0ac-793b-40d0-8b88-6eb6e0af8adc",
                                                "sense_id": "86c5e5d2-bccf-3264-a4f8-6fd0aeb37a9d",
                                                "text": "„In nicht-kapitalistischen Gesellschaften überschneiden sich die Konzepte von Formalismus und Substantivismus nicht, da diese nicht auf den Markt, sondern auf Redistribution und Reziprozität ausgerichtet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dce8cce-1c2e-4691-866d-956ac9829218",
                        "source_entry_id": "736f3581-809b-313c-9c97-436e37546154",
                        "source_sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                        "target_lang_word": "Gegenseitigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
