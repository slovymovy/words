                "senses": [
                    {
                        "sense_id": "55fc7932-509c-3f3d-b813-e28385a3e26f",
                        "entry_id": "11530274-98d3-31ef-8d5a-9f26e3bd069d",
                        "glosses": [
                            "Enforcir à nouveau."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "a0ebe4da-2d1e-4066-b0e1-31693674478e",
                                "sense_id": "55fc7932-509c-3f3d-b813-e28385a3e26f",
                                "text": "Des poteaux de pin et/ou d’épinette étaient placés à travers le toit avec plus de gazon pour réenforcir le tout et créer une couverture."
                            },
                            {
                                "example_id": "f45e7a36-a319-4551-adc7-d84545641e63",
                                "sense_id": "55fc7932-509c-3f3d-b813-e28385a3e26f",
                                "text": "Dès le premier jour du calendrier, j’avais entendu Claude Julien qui parlait de la nécessité pour l’équipe de «se réenforcir»."
                            }
                        ]
                    }
