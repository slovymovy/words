                        "entry_id": "41552727-db60-3488-b91b-c2d8be353691",
                        "glosses": [
                            "der Vorgang, bei dem ein Verstorbener von der Kirche offiziell als Seliger anerkannt wird"
                        ],
                        "tags": [
                            "Katholizismus",
                            "orthodoxe Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "ab5cf88d-b8b4-478c-b0de-a2bcce690611",
                                "sense_id": "d51d9647-9dae-3df0-8649-5d7e249a3441",
                                "text": "Der Heiligsprechung geht eine Seligsprechung voraus."
                            },
                            {
                                "example_id": "69ee6e94-cd9a-46fa-a511-bafbd3f0e57f",
                                "sense_id": "d51d9647-9dae-3df0-8649-5d7e249a3441",
                                "text": "„Doch die Aussagen der Augenzeugen müssen ihn schließlich wohl überzeugt haben, denn es war Lambertini selbst, der dann als Papst die Seligsprechung verkündete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
