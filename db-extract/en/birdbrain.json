                                        "entry_id": "52fc031d-8f10-3359-b36d-d99a9f52ef6c",
                                        "glosses": [
                                            "starker Mangel an geistigen Fähigkeiten"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e0fa30e-5562-424e-8558-b3a16e4af8d6",
                                                "sense_id": "7f7dd04b-7f18-347b-bcc2-a223d62aacc8",
                                                "text": "„Zwar wusste er nicht, was ihn hatte aufhorchen lassen, doch er war schlagartig nüchtern, denn in seinem Spatzenhirn war eine Warnlampe aufgeleuchtet.“"
                                            },
                                            {
                                                "example_id": "2f035e8c-7974-41f8-ac56-b9523f004040",
                                                "sense_id": "7f7dd04b-7f18-347b-bcc2-a223d62aacc8",
                                                "text": "„Er weiß von nichts. Außerdem wäre sein Spatzenhirn von so etwas überfordert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
