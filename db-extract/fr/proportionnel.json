                                                "sense_id": "8635ef1b-b49b-380e-b287-90963a3aa530",
                                                "text": "„Nirgendwo sonst leben proportional zur Einwohnerzahl so viele Millionäre wie in Singapur, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
