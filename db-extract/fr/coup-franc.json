                        "glosses": [
                            "Variante rare de coup franc : dans certains sports de ballon, pénalité accordée à l’équipe victime d’une faute, consistant à lui redonner le ballon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de06a8e8-c25d-43c4-b7ba-054b0d78b19b",
                                "sense_id": "baab3355-ab3e-3725-bb8c-a4eb61a50d77",
                                "text": "Deux minutes plus tard, un coup-franc à la limite de la surface de réparation, tiré par Vidot, échoue sur la transversale (13’)."
                            },
                            {
                                "example_id": "623c5003-2821-4fad-bc36-6d7713e3898f",
                                "sense_id": "baab3355-ab3e-3725-bb8c-a4eb61a50d77",
                                "text": "Landon Donovan a tiré le coup-franc : un centre devant le but qu’Edu a envoyé au fond des filets d’une reprise de volée."
                            },
                            {
                                "example_id": "556bed59-dee1-4515-ac3b-44e16fe3d769",
                                "sense_id": "baab3355-ab3e-3725-bb8c-a4eb61a50d77",
                                "text": "L’arbitre… jusque-là sans reproche, se laisse influencer et siffle un coup-franc indirect en faveur des Allemands à 25 m des buts de Curkovic, face à lui."
                            }
                        ]
                    }
