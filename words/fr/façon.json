                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier nous a servi un gâteau de sa <w>façon</w>."
                        },
                        {
                            "text": "Il aime réciter des poèmes de sa <w>façon</w> devant ses amis."
