                        "glosses": [
                            "verzameling auto's die een organisatie of bedrijf tot zijn beschikking heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b945ad6-59bf-49e6-8511-a64e1972dc1e",
                                "sense_id": "9629ab52-7d54-3b91-a56c-0e8e437f42a6",
                                "text": "Enorme huizen in meerdere wereldsteden, motorjachten, privévliegtuigen, een autopark en vooral veel bladgoud op meubels, trapleuningen, wc's en badkuipen lijken verplichte parafernalia van de Russische rijken."
                            }
                        ]
                    },
                    {
                        "sense_id": "06f44e13-c916-3d44-96fe-6c54fb571ffe",
                        "entry_id": "521872f8-1f59-30cf-97c0-b9e12988ee2e",
                        "glosses": [
                            "verzameling van alle auto's die in een land rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70a6a51-27af-48f4-af80-0f4b0d75dd1c",
                                "sense_id": "06f44e13-c916-3d44-96fe-6c54fb571ffe",
                                "text": "Maar volgens De Boer zullen scherpe grenzen in de bijtelling de markt toch zwaar verstoren en de werkgelegenheid verder onder druk zetten. \"Dit gaat de overheid ongetwijfeld weer veel geld kosten, terwijl het Nederlandse zakelijke autopark al het zuinigste van Europa is. De branche is toe aan een vrije, in plaats van een door de overheid gestuurde markt.\""
                            }
                        ]
                    }
