                                "target_senses": [
                                    {
                                        "sense_id": "34cb54b2-3c45-3619-abc4-cf2c50a7ab48",
                                        "entry_id": "2e61452c-6746-32fd-a695-e83ac2ec4422",
                                        "glosses": [
                                            "jemanden nach längerer oder kürzerer Abwesenheit wieder treffen; etwas wieder aufsuchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7d62a3e-1187-4a96-a2b7-df9326552fd4",
                                                "sense_id": "34cb54b2-3c45-3619-abc4-cf2c50a7ab48",
                                                "text": "Wann sehen wir uns wieder?"
                                            },
                                            {
                                                "example_id": "4fcd1254-1067-4a24-b4b5-ff5972f4e526",
                                                "sense_id": "34cb54b2-3c45-3619-abc4-cf2c50a7ab48",
                                                "text": "Verwandte aus Süd- und Nordkorea konnten sich nach Jahrzehnten erstmals bei Familientreffen wiedersehen."
                                            },
                                            {
                                                "example_id": "91787117-ba92-42e9-8b6a-5d38f11d9c17",
                                                "sense_id": "34cb54b2-3c45-3619-abc4-cf2c50a7ab48",
                                                "text": "Als er sie wiedersehen will, entdeckt er die triste Welt der Arbeiter, die in der Unterstadt ihr erbärmliches Dasein fristen."
                                            },
                                            {
                                                "example_id": "49866cdb-a406-43c1-a9ce-f58720243e59",
                                                "sense_id": "34cb54b2-3c45-3619-abc4-cf2c50a7ab48",
                                                "text": "Ein Gentest bestätigte, dass die beiden Frauen, die sich im vergangenen Jahr zum ersten Mal wiedersahen, tatsächlich Mutter und Kind sind."
                                            },
                                            {
                                                "example_id": "0f6a7367-63ab-40af-a63d-66f5f8da4514",
                                                "sense_id": "34cb54b2-3c45-3619-abc4-cf2c50a7ab48",
                                                "text": "Dann, so überliefert es 150 Jahre später Plutarch, setzte er sich hin und schrieb an einen Freund in Rom den lakonischsten Schlachtenbericht der Weltgeschichte: \"Veni, vidi, vici.\" Die Stadt Zela sah Cäsar danach nie wieder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
