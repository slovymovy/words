                                        "entry_id": "b0f1ec75-bf9a-3d8c-9b86-2b6904738a2a",
                                        "glosses": [
                                            "Imposible o muy difícil de perdonar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955135e9-0463-4475-918d-2e1ea7fb787b",
                                                "sense_id": "bba1e2e0-1848-3d06-ae76-0bff318c34bf",
                                                "text": "La suciedad es imperdonable, porque no hay miseria que pueda impedir a uno que lave su cuerpo."
                                            }
