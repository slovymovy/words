                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wilderness",
                                "target_lang_sense_clarification": "desolate, unpopulated wasteland"
                            },
                            {
                                "target_lang_word": "wasteland",
                                "target_lang_sense_clarification": "barren or uninhabited tract"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f20830d4-b590-3dc2-952e-315b088661c0",
                    "sense_definition": "trzecia osoba liczby pojedynczej czasu teraźniejszego czasownika <w>puszczać</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On zawsze <w>puszcza</w> muzykę bardzo głośno.",
                            "target_lang_translations": {
                                "en": "He always <w>plays</w> music very loudly."
                            }
                        },
                        {
                            "text": "Wiatr <w>puszcza</w> w ruch liście na drzewach.",
                            "target_lang_translations": {
