                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0a56e46d-87a0-403c-ad1e-4a72f669a484",
                                "sense_id": "3460ec08-2cc7-3699-9b97-cac5d484ceeb",
                                "text": "Everyone glared in disapproval at the man talking loudly on the phone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f180e6a-85c8-4d52-8109-d600e42ae564",
