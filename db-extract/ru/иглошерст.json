                        "source_sense_id": "916fef10-402a-328c-8675-0dc4fd639f92",
                        "target_lang_word": "North American porcupine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "North American porcupine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c0ff2d-addd-3a84-9b26-e8b3d94f0da2",
                                        "entry_id": "1e95106e-79ba-351c-992f-c52c7843c34a",
                                        "glosses": [
                                            "A species of New World porcupine, Erethizon dorsatum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1e671b-835e-4256-b303-2a374b269e1d",
                                                "sense_id": "a8c0ff2d-addd-3a84-9b26-e8b3d94f0da2",
                                                "text": "It is, however, different from the North American porcupine, which is a rodent but is a member of the family of Erethizontidae, which is not represented in South America."
                                            },
                                            {
                                                "example_id": "b87c07e4-ec93-4c45-9d5f-a1a498691853",
                                                "sense_id": "a8c0ff2d-addd-3a84-9b26-e8b3d94f0da2",
                                                "text": "The North American porcupine (Erethizon dorsatum) is the largest species in the family, usually weighing less than 7 kg (15.4 pounds) though males occasionally grow significantly larger."
                                            },
                                            {
                                                "example_id": "6dee5d0f-f734-4e17-9a00-9a613fe5ba05",
                                                "sense_id": "a8c0ff2d-addd-3a84-9b26-e8b3d94f0da2",
                                                "text": "North American porcupines, as well as a range of other Hystricomorph rodents, engage in urine showering as part of courtship and other behaviors."
                                            },
                                            {
                                                "example_id": "3e756b42-0d0f-4acb-9657-76e6c9777ba0",
                                                "sense_id": "a8c0ff2d-addd-3a84-9b26-e8b3d94f0da2",
                                                "text": "North American Porcupines are widely distributed across North America, except on islands and in Arctic or alpine tundra, dry desert are as without trees, and intensively farmed lands that lack woodlots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
