                "senses": [
                    {
                        "sense_id": "85f7948a-b6ee-30a4-9531-d9a46e873ba5",
                        "entry_id": "9ee067d4-16d2-3d1e-8525-4b5c375bf044",
                        "glosses": [
                            "Verfahren und Endprodukt der Wortbildung, wobei aus Wortgruppen durch Zusammenziehung komplexe Komposita entstehen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0093b5c0-b06f-46d6-81d1-f13d91e6c1a2",
                                "sense_id": "85f7948a-b6ee-30a4-9531-d9a46e873ba5",
                                "text": "Univerbierung liegt z.B. dann vor, wenn aus einer Aussage wie „es wurde eine wöchentliche Arbeitszeit von 40 Stunden vereinbart“ ein Kompositum „40-Stunden-Woche“ gebildet wird."
                            },
                            {
                                "example_id": "7a2922f3-46d2-49be-9062-b0c89b8855ea",
                                "sense_id": "85f7948a-b6ee-30a4-9531-d9a46e873ba5",
                                "text": "Univerbierung führt zur Informationsverdichtung und gilt als ein Merkmal von Pressesprache."
                            },
                            {
                                "example_id": "8e2040c5-4dea-4196-ad99-f95ab9ead0a4",
                                "sense_id": "85f7948a-b6ee-30a4-9531-d9a46e873ba5",
                                "text": "„Die Zunahme und Verstärkung der Univerbierung kann als Haupttendenz im Bereich der deutschen Wortbildung angesehen werden.“"
                            },
                            {
                                "example_id": "f34d1fb6-97c4-4053-a581-31970fca08f5",
                                "sense_id": "85f7948a-b6ee-30a4-9531-d9a46e873ba5",
                                "text": "„Sie passen besser zu einer eigenen Wortbildungsart: der Univerbierung, das heißt, der Zusammenziehung einer Wortgruppe zu einem Wort.“"
                            },
                            {
                                "example_id": "80b54dc4-9912-4c52-82ae-7b7e5e2e63ec",
                                "sense_id": "85f7948a-b6ee-30a4-9531-d9a46e873ba5",
                                "text": "„Die Integration englischer Entlehnungen erfolgt zum Teil auch durch Tendenzen zur Univerbierung (Layout, Lockdown).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
