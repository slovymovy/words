                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376f370c-5f71-4da2-a52b-225e755e230d",
                                "sense_id": "8058fc77-220b-3caf-a295-29e74b171aac",
                                "text": "„Es ist ein Wahlkampfmanöver mit schweren Konsequenzen ohne den notwendigen gesellschaftlichen Diskurs.“"
                            },
                            {
                                "example_id": "3cae884b-beae-40a0-8b34-a982ba08a768",
                                "sense_id": "8058fc77-220b-3caf-a295-29e74b171aac",
                                "text": "„Bis heute sind viele der Meinung, dass diese Eskalation ein innenpolitisches Wahlkampfmanöver von Erdogan war.“"
                            },
                            {
                                "example_id": "9094cf46-90b4-457d-ac6d-84a712893608",
                                "sense_id": "8058fc77-220b-3caf-a295-29e74b171aac",
                                "text": "„Der Umstand, dass mich zwei Senatoren aus verschiedenen politischen Lagern auf der Reise begleiteten, ließ jegliche Kritik, es handele sich um ein bloßes Wahlkampfmanöver, ins Leere laufen.“"
                            },
                            {
                                "example_id": "f4e63d1b-91b4-433f-809f-4f2260c83290",
                                "sense_id": "8058fc77-220b-3caf-a295-29e74b171aac",
                                "text": "„Meinte die Union es ernst und wäre der Vorstoß des Ministers mehr als nur ein Wahlkampfmanöver, man könnte wieder Hoffnung schöpfen für unser Land.“"
                            }
                        ],
