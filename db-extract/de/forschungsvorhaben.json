                "senses": [
                    {
                        "sense_id": "9d76f288-ac18-3fc4-97e3-173410efbdf5",
                        "entry_id": "1ca0d7e2-944f-36d9-b27c-5b2b14978cec",
                        "glosses": [
                            "Plan, Vorhaben, sich intensiv und gezielt mit einer bestimmten wissenschaftlichen Fragestellung zu beschäftigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd20a709-4c07-4baf-9608-046e3f0ee3ec",
                                "sense_id": "9d76f288-ac18-3fc4-97e3-173410efbdf5",
                                "text": "„Dabei werden auch die am Forschungsvorhaben beteiligten Lehrpersonen und ihre Schulklassen porträtiert.“"
                            },
                            {
                                "example_id": "5aa4feb5-4793-453a-87c7-68ae8a706442",
                                "sense_id": "9d76f288-ac18-3fc4-97e3-173410efbdf5",
                                "text": "„Die Prüfung des Forschungsvorhabens durch eine Ethikkommission wird in Forschungsartikeln häufig ausgewiesen und ist ein qualitatives Merkmal einer Studie.“"
                            },
                            {
                                "example_id": "18c35807-aab5-40b8-bc8a-134c1c999f20",
                                "sense_id": "9d76f288-ac18-3fc4-97e3-173410efbdf5",
                                "text": "„Viele dieser Forschungsvorhaben wurden an der University of Michigan durchgeführt.“"
                            },
                            {
                                "example_id": "d435931f-91df-482e-98de-4cb07ab976a1",
                                "sense_id": "9d76f288-ac18-3fc4-97e3-173410efbdf5",
                                "text": "„Der geisteswissenschaftliche, qualitative Zugang zu meinem Forschungsvorhaben bedingte eine induktive Herangehensweise.“"
                            },
                            {
                                "example_id": "dffd2fd9-5f48-4788-a59e-407cd8d1d353",
                                "sense_id": "9d76f288-ac18-3fc4-97e3-173410efbdf5",
                                "text": "„Das Forschungsvorhaben widmet sich im Kern der Frage, welche Auswirkungen inklusiver (Sport-)Unterricht auf die Professionalisierung von (Sport-)Lehrkräften hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
