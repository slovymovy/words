                                        "sense_id": "9d875051-aea7-394c-b0c6-0937bc9c48e7",
                                        "entry_id": "a0fff435-39c6-390d-9e56-8f08acdec2af",
                                        "glosses": [
                                            "Mitgefühl für die Notleidenden, Benachteiligten zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba2332f-a249-4055-91dc-3b82ec52cf4c",
                                                "sense_id": "9d875051-aea7-394c-b0c6-0937bc9c48e7",
                                                "text": "Der König war barmherzig und sprach den Todgeweihten frei."
                                            },
                                            {
                                                "example_id": "4ff58549-5a3b-49b1-9eaf-2aba551e47ee",
                                                "sense_id": "9d875051-aea7-394c-b0c6-0937bc9c48e7",
                                                "text": "„In der Bibel hat der barmherzige Samariter den Überfallenen nicht auf Dauer bei sich aufgenommen, sondern er hat ihn zur Herberge gebracht, dort für seine Versorgung gezahlt und ist dann weiter seinen Geschäften nachgegangen.“"
                                            },
                                            {
                                                "example_id": "99e5a32b-848f-4715-a05e-54bd2a61639f",
                                                "sense_id": "9d875051-aea7-394c-b0c6-0937bc9c48e7",
                                                "text": "Jesus Christus spricht: „Seid barmherzig, wie auch euer Vater barmherzig ist!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
