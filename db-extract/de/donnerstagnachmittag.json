                "senses": [
                    {
                        "sense_id": "09e4cbd2-642b-384e-b673-230032519ac8",
                        "entry_id": "eae7e5d7-d84b-3ecf-a614-44e36ac1e9bd",
                        "glosses": [
                            "der Nachmittag eines Donnerstages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f5624fe-aadf-450d-ae84-e6438e759d48",
                                "sense_id": "09e4cbd2-642b-384e-b673-230032519ac8",
                                "text": "Die Hitze des Donnerstagnachmittags diese Woche ist kaum zu übertreffen."
                            },
                            {
                                "example_id": "f616d79a-501b-4e2a-bda0-aa7c07d5295d",
                                "sense_id": "09e4cbd2-642b-384e-b673-230032519ac8",
                                "text": "Übernächste Woche komme ich am Donnerstagnachmittag zu dir."
                            },
                            {
                                "example_id": "8907ee2f-1e2d-4681-954e-becc0131311a",
                                "sense_id": "09e4cbd2-642b-384e-b673-230032519ac8",
                                "text": "„Die acht Teilnehmer kamen jeden Donnerstagnachmittag für drei Stunden zusammen, entweder in der Bibliothek im Vaughan Literature Building oder in Miss Martins Wohnzimmer in der South Front Street.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
