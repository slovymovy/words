                "senses": [
                    {
                        "sense_id": "7af1f733-eb20-37f8-87f4-5ded09088e17",
                        "entry_id": "79600180-3e26-3ee0-8536-629fd4cfb8e1",
                        "glosses": [
                            "weibliche Person, die aus dem Abendland stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e8878e-e6d8-4dfd-b731-835008bc5454",
                                "sense_id": "7af1f733-eb20-37f8-87f4-5ded09088e17",
                                "text": "„In The Captive ist die Frau keine Abendländerin, sondern eine Türkin, die Tochter eines Kadis, in die der gefangene Europäer sich verliebt […].“"
                            },
                            {
                                "example_id": "7723f04f-6765-4356-ac3d-bd028ea9852e",
                                "sense_id": "7af1f733-eb20-37f8-87f4-5ded09088e17",
                                "text": "„Dem Volke waren die Abendländerin Maria und ihr Günstling in gleichem Maße verhaßt.“"
                            },
                            {
                                "example_id": "3980c01d-458c-44e8-be21-e068dae5b8ca",
                                "sense_id": "7af1f733-eb20-37f8-87f4-5ded09088e17",
                                "text": "„Der Orient stellt sich der für diese Abendländerin als ‚die ungesittete Welt‘, während sich der Okzident, der geographisch in Thrazien, genauer am Bosporus endet, durch das ‚Zwielicht europäischer Kultur- und Zivilisationsbestrebungen‘ charakterisiert, was aus ihrer Sicht ‚das unglückselige Griechenland ruiniert hat.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
