                        "target_lang_word": "shutdown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shutdown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2987cfd-819e-3772-86e2-1b542e542d24",
                                        "entry_id": "79a24e4a-8d7e-36ea-b395-bc1c24438423",
                                        "glosses": [
                                            "The action of stopping operations; a closing, of a computer, business, event, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f6825f4-3c5a-4b1d-b17e-9d7f665dbeea",
                                                "sense_id": "a2987cfd-819e-3772-86e2-1b542e542d24",
                                                "text": "You need to enter your password at startup, but it's not required at shutdown."
                                            },
                                            {
                                                "example_id": "61c18ec1-c49c-499c-8e14-b20f4d13574d",
                                                "sense_id": "a2987cfd-819e-3772-86e2-1b542e542d24",
                                                "text": "There is a plastic molly-guard covering the escalator's shutdown button to prevent little kids from pushing it and stopping the escalator."
                                            },
                                            {
                                                "example_id": "3d26768d-2335-4020-9e34-30915ba07c87",
                                                "sense_id": "a2987cfd-819e-3772-86e2-1b542e542d24",
                                                "text": "In 1963, there was even more of a shutdown [at Christmas]. The Western and London Midland Regions ran no trains, with the rest of the network having the \"barest of skeleton services\". The Daily Herald called Beeching's cuts \"the most scrooge-like... in railway history\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d870db-3227-3c0b-9515-bb3e73141d0f",
                                        "entry_id": "79a24e4a-8d7e-36ea-b395-bc1c24438423",
                                        "glosses": [
                                            "A statement, insult, etc. that prevents the opponent from replying further."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9518e02c-af77-41e4-8a91-41680d8764cf",
                                                "sense_id": "13d870db-3227-3c0b-9515-bb3e73141d0f",
                                                "text": "When he insulted me, my reply was such a shutdown that he left the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cbc60be-26f2-394e-a65b-72739dfe6e29",
                                        "entry_id": "79a24e4a-8d7e-36ea-b395-bc1c24438423",
                                        "glosses": [
                                            "An autistic response to stress or sensory overload, in which the individual freezes up and becomes silent, motionless, and unresponsive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ce70aaa-6edc-4eb3-9dc6-ac46ad5cac17",
                                                "sense_id": "0cbc60be-26f2-394e-a65b-72739dfe6e29",
                                                "text": "I retreated into myself and allowed myself to be swallowed into a typically autistic shutdown."
                                            },
                                            {
                                                "example_id": "7581d736-1e9e-4a01-993c-19e96beb9f5b",
                                                "sense_id": "0cbc60be-26f2-394e-a65b-72739dfe6e29",
                                                "text": "I may even reach the point where I have an autistic shutdown, which means I'll be unable to communicate, interact or socialize."
                                            },
                                            {
                                                "example_id": "02e67cfb-7c5e-46bc-bc90-6547ec62c752",
                                                "sense_id": "0cbc60be-26f2-394e-a65b-72739dfe6e29",
                                                "text": "Their [autistic girls'] distress could come out in all sorts of ways and result in meltdown or shutdown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7567e4-3423-3d6e-be8d-2dbb2f6de8f4",
                                        "entry_id": "79a24e4a-8d7e-36ea-b395-bc1c24438423",
                                        "glosses": [
                                            "A defensive ploy that prevents the opposing players from attacking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c3a6a0b-4236-3ba9-bcc9-299c6ab330b7",
                                        "entry_id": "79a24e4a-8d7e-36ea-b395-bc1c24438423",
                                        "glosses": [
                                            "A big success; a hyped atmosphere."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "197e53b0-e874-4f26-97c5-41543fab2c46",
                                                "sense_id": "0c3a6a0b-4236-3ba9-bcc9-299c6ab330b7",
                                                "text": "Fashion week and it's shutdown / Went to the show, sitting in the front row / In a black tracksuit and it's shutdown"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad6e590c-fed0-4b47-9068-6369099e11d6",
                        "source_entry_id": "dbffc68e-45aa-3b30-81d5-d9d25bfeffbc",
