                ],
                "senses": [
                    {
                        "sense_id": "2ea2a9b8-a2d6-3e14-8eda-52b3e27f5288",
                        "entry_id": "09a34226-9028-32a9-ba42-20d4ecf7b8e3",
                        "glosses": [
                            "Familie, die Landwirtschaft betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a617185b-4359-4154-ae2e-686fcc2d2a7e",
                                "sense_id": "2ea2a9b8-a2d6-3e14-8eda-52b3e27f5288",
                                "text": "„In der Provinz zeigten sich viele Bauernfamilien glücklich, dass die Militärbehörden ihnen für einfache Arbeiten erstmals Kriegsgefangene in nennenswerter Zahl zuweisen konnten.“"
                            },
                            {
                                "example_id": "6dac162e-7f78-4911-b19d-ca0d24802143",
                                "sense_id": "2ea2a9b8-a2d6-3e14-8eda-52b3e27f5288",
                                "text": "„Natürlich waren Bauernfamilien, die bereit waren, ihre Heimat zu verlassen und in einem fremden Urwald neu anzufangen, eine Auslese der Tüchtigen und Unternehmungslustigen.“"
                            },
                            {
                                "example_id": "d8a90a97-f788-45a9-b492-4b40c3f1bbf4",
                                "sense_id": "2ea2a9b8-a2d6-3e14-8eda-52b3e27f5288",
                                "text": "„Die Bauernfamilie stellte immer unverschämtere Forderungen.“"
                            },
                            {
                                "example_id": "a18d18ee-3055-4ced-b2bf-d407280b7c75",
                                "sense_id": "2ea2a9b8-a2d6-3e14-8eda-52b3e27f5288",
                                "text": "„Dann nahm sie, wenige Wochen später, zwei Bauernfamilien auf, die aus der nordöstlich gelegenen Gegend um Tilsit vor den näher rückenden Russen geflohen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
