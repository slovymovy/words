                            {
                                "example_id": "5dd9f4a8-4ce6-4332-9e66-1778ff61a63f",
                                "sense_id": "5d6a2e9d-6c07-33cf-88f0-1a523f8d6789",
                                "text": "Wij zoeken naar idiomatische uitdrukkingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef44b4cb-9b4c-4f11-9c61-3b0858928814",
                        "source_entry_id": "a97710d0-ceed-33f2-b95d-0c76ff78efcc",
                        "source_sense_id": "5d6a2e9d-6c07-33cf-88f0-1a523f8d6789",
                        "source_sense_description": "het idioom betreffend",
                        "target_lang_word": "idiomatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiomatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d9bc20e-8300-391d-a5c9-c982ddced0a4",
                                        "entry_id": "8cdf63e6-2b1a-31fe-a286-4f5484185c86",
                                        "glosses": [
                                            "Eigenschaft von sprachlichen Ausdrücken, deren Bedeutung sich nicht aus der Bedeutung ihrer Bestandteile ableiten lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf758c97-cccf-4681-85d1-22d753246010",
                                                "sense_id": "2d9bc20e-8300-391d-a5c9-c982ddced0a4",
                                                "text": "\"Kind und Kegel\" ist ein idiomatischer Ausdruck, dessen Bedeutung sich nicht aus der Bedeutung der Wörter direkt herleiten lässt."
                                            },
                                            {
                                                "example_id": "608bd091-2df6-4726-af06-1e335ca8bc76",
                                                "sense_id": "2d9bc20e-8300-391d-a5c9-c982ddced0a4",
                                                "text": "„Die Auslandsgermanistik hat entscheidend zur Dynamik der Phraseologieforschung beigetragen, da sie durch ihr natürliches Engagement in der Fremdsprachendidaktik mit den Schwierigkeiten vertraut ist, die eine einigermaßen idiomatische Sprachbeherrschung in der Zielsprache bereitet.“"
                                            },
                                            {
                                                "example_id": "54a40de1-6934-40e1-89eb-18aab4cf248d",
                                                "sense_id": "2d9bc20e-8300-391d-a5c9-c982ddced0a4",
                                                "text": "„Im Allgemeinen gilt es als angemessen, eine idiomatische Wendung in der Ausgangssprache durch eine idiomatische Wendung in der Zielsprache wiederzugeben, also etwa Odettes Unverständnis für Wagners Musik durch die Wendung vom Esel mit der Harfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d9b693a-b6b5-32b3-a41c-4766fd088a82",
                                        "entry_id": "8cdf63e6-2b1a-31fe-a286-4f5484185c86",
                                        "glosses": [
                                            "einer Sprache oder Sprachform eigentümlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47b36413-15fa-4304-be0a-2c35e190b9f1",
                                                "sense_id": "7d9b693a-b6b5-32b3-a41c-4766fd088a82",
                                                "text": "„Was die Übersetzung betrifft, so habe ich mich immer möglichst genau dem japanischen Text angeschlossen, auch da, wo eine weniger genaue, aber idiomatischere Übersetzung nahe lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aac310d-19a2-46c7-a357-a979fe6fb8d3",
                        "source_entry_id": "a97710d0-ceed-33f2-b95d-0c76ff78efcc",
                        "source_sense_id": "5d6a2e9d-6c07-33cf-88f0-1a523f8d6789",
                        "source_sense_description": "het idioom betreffend",
                        "target_lang_word": "idiomatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7be63b8-0b17-358c-a6a3-a00a37048fc5",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Pertaining or conforming to idiom, the natural mode of expression of a language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016a989f-dd04-4547-81a6-cd7fa52d2f92",
                                                "sense_id": "f7be63b8-0b17-358c-a6a3-a00a37048fc5",
                                                "text": "The inclusion or omission of definite articles follows idiomatic norms in each language and depends on context and intent."
                                            },
                                            {
                                                "example_id": "e4011cd9-812c-4d5a-8bf6-22b4bd1d4d3b",
                                                "sense_id": "f7be63b8-0b17-358c-a6a3-a00a37048fc5",
                                                "text": "In English, the only idiomatic position for a pronoun as the object of a phrasal verb is before the particle, whereas a noun as object can fall either before or after the particle; thus only he picked them up but either he picked his tools up or he picked up his tools."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f599bea-7f90-3f58-9d67-a0c7177564fe",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Resembling or characteristic of an idiom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5741e30f-b1c7-489f-9b13-b949aae50516",
                                                "sense_id": "0f599bea-7f90-3f58-9d67-a0c7177564fe",
                                                "text": "An idiomatic phrase that warns us against Pollyannaism is \"don't count your chickens before they're hatched\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cfe5a75-c3a9-3493-966c-1a822391a45a",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Using many idioms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afac8abb-e187-3b77-b2bf-fcc2df14aa8f",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Relating to parts or pieces which are written both within the natural physical limitations of the instrument and human body and, less so or less often, the styles of playing used on specific instruments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "idiomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e58aafd-9adc-39de-9652-26e5f4fc8389",
                                        "entry_id": "19a47327-a2a7-39e6-97f6-418bb2e5c5f2",
                                        "glosses": [
                                            "Synonym of idiom."
                                        ],
