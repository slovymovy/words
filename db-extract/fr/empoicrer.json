                        "glosses": [
                            "Empoisser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0051c2bb-1f13-42d2-89be-f04a3bde46b9",
                                "sense_id": "625c8f3e-cfbf-3164-a987-11390150926d",
                                "text": "Victor continue à empoicrer de sa fiente le siège des cabinets."
                            },
                            {
                                "example_id": "d477995a-0634-4afb-afd3-43fa672b46e7",
                                "sense_id": "625c8f3e-cfbf-3164-a987-11390150926d",
                                "text": "La vaseline, très employée aujourd'hui, ne me parait pas mériter la faveur dont elle est l'objet. Elle empoicre trop la main ; elle empoicre naturellement aussi la peau du sujet, et il devient impossible de la laver convenablement."
                            }
                        ]
                    }
