    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9bf5c6e3-ebf9-3c2d-8502-1c8d3f3bda92",
                "word": "broadleaf",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ea5800e-366d-3e92-b4ac-ffbc3dcfa5ae",
                        "entry_id": "9bf5c6e3-ebf9-3c2d-8502-1c8d3f3bda92",
                        "glosses": [
                            "Pertaining to trees with relatively broad, flat leaves as opposed to needles, or woodlands made up of such trees."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e6732a0b-32e8-4a51-bd71-38c6d65e36e5",
                                "sense_id": "2ea5800e-366d-3e92-b4ac-ffbc3dcfa5ae",
                                "text": "Urban has spent close to a decade slogging around in the ponds of Connecticut’s broadleaf forests examining the intricacies of salamander populations."
                            }
                        ]
                    },
                    {
                        "sense_id": "f94628fb-82c1-3c0a-8460-adc1d23464cb",
                        "entry_id": "9bf5c6e3-ebf9-3c2d-8502-1c8d3f3bda92",
                        "glosses": [
                            "Used in the name of a plant or tree: having especially broad leaves."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8567d02a-5e25-4e6b-a25a-58149bf9b340",
                        "source_entry_id": "9bf5c6e3-ebf9-3c2d-8502-1c8d3f3bda92",
                        "source_sense_description": "pertaining to trees with leaves",
                        "target_lang_word": "feuillu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuillu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d011dca9-742e-34b5-8193-ce62cecdf86c",
                                        "entry_id": "233447f1-8ad6-3b2c-965d-7d2549c7f082",
                                        "glosses": [
                                            "Qui possède beaucoup de feuilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d1527f-3c6d-4715-9c3d-8e19f7249dea",
                                                "sense_id": "d011dca9-742e-34b5-8193-ce62cecdf86c",
                                                "text": "Un cerisier feuillu."
                                            },
                                            {
                                                "example_id": "2c47e089-ef1f-43e2-94a0-931c56c10e72",
                                                "sense_id": "d011dca9-742e-34b5-8193-ce62cecdf86c",
                                                "text": "Tige bien feuillue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea491aaf-baa4-3702-a3d7-dbe6db7df218",
                                        "entry_id": "233447f1-8ad6-3b2c-965d-7d2549c7f082",
                                        "glosses": [
                                            "Qualifie les arbres qui portent des feuilles, par opposition à ceux qui portent des aiguilles, les conifères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a67df9-1ae9-41a2-b356-34ee335ff27c",
                                                "sense_id": "ea491aaf-baa4-3702-a3d7-dbe6db7df218",
                                                "text": "A l'heure actuelle, l'étendue inculte boisable en épicéa étant fortement réduite, son extension est due à la conversion de peuplements feuillus en pessières et au boisement de terres agricoles."
                                            },
                                            {
                                                "example_id": "be6c3a7a-b50d-4707-baeb-56883e866db7",
                                                "sense_id": "ea491aaf-baa4-3702-a3d7-dbe6db7df218",
                                                "text": "Au XIVᵉ siècle, a la fin de l'époque Kamakura (1185-1333), le chef d'un clan local implanta une forteresse entourée de levées plantées de sudajii, Cayiaiiopyis sieaoldi, feuillus sempervirents caractéristiques de la forêt lauriphylle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05cbb60-3760-37e7-aa92-0a551bd4bdbf",
                                        "entry_id": "233447f1-8ad6-3b2c-965d-7d2549c7f082",
                                        "glosses": [
                                            "Qualifie un style touffu, difficile à comprendre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57c7f6a5-bea1-32fc-bd9d-e87c862ecf92",
                                        "entry_id": "233447f1-8ad6-3b2c-965d-7d2549c7f082",
                                        "glosses": [
                                            "Qualifiait un officier supérieur, général ou maréchal, dont les galons étaient de feuilles de chêne."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "119688f7-8a26-4e88-a973-1f3e6df2554c",
                                                "sense_id": "57c7f6a5-bea1-32fc-bd9d-e87c862ecf92",
                                                "text": "Alors vous direz votre obéissance, votre angoisse. Vous serez pathétique enfin ! amoureux, soldat dans l'âme, tout ce que vous voudrez, et pourvu que votre chef, galonné ou « feuillu », ait vraiment quelque bon sens, pan, pan! ça marchera."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feuillu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a1258fe-a8ca-3306-8d72-24791aa3264a",
                                        "entry_id": "b7d25c69-233c-3eae-8eb9-02c4d7126a16",
                                        "glosses": [
                                            "Arbre qui porte des feuilles, par contraste à ceux qui portent des aiguilles, les conifères ou résineux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c162e8d8-7dc8-424a-854a-404a5d826d7f",
                                                "sense_id": "8a1258fe-a8ca-3306-8d72-24791aa3264a",
                                                "text": "À l'état naturel, les résineux comme les feuillus ont une grande puissance de conquête et une grande longévité."
                                            },
                                            {
                                                "example_id": "3ad89cc0-1531-4827-b4f4-006d25c7c8e6",
                                                "sense_id": "8a1258fe-a8ca-3306-8d72-24791aa3264a",
                                                "text": "Des facteurs comme l'apport de résineux, plantés pour remplacer les feuillus d'origine ou introduits là où il n'y en avait pas comme en plaine, ajoutent à la lente transformation du paysage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf48636-6979-323a-af0c-1f07d406d5c0",
                                        "entry_id": "b7d25c69-233c-3eae-8eb9-02c4d7126a16",
                                        "glosses": [
                                            "Officier supérieur, général ou maréchal, dont les galons étaient de feuilles de chêne."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "note": "Ces grades n’existaient pas au féminin",
                                        "examples": [
                                            {
                                                "example_id": "50937b12-2705-4c55-8d46-e21560046ac8",
                                                "sense_id": "fbf48636-6979-323a-af0c-1f07d406d5c0",
                                                "text": "Un de mes amis, qui est soldat au 21e colonial à la caserne de Clignancourt, souhaite venir sur la rive gauche, et expressément au 23e colonial à la caserne de Lourcine. […]. Comme vous êtes dans les généraux jusqu'au cou, vous pourriez peut-être demander à un de ces feuillus comment l'on doit s'y prendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065a0963-7f7c-344a-9aa1-31aa082c3579",
                                        "entry_id": "b7d25c69-233c-3eae-8eb9-02c4d7126a16",
                                        "glosses": [
                                            "Fête, traditionnelle ou ancestrale, célébrée au début du printemps dans le canton de Genève."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67a98dd4-d619-3b8c-80a0-0c3a3076f961",
                                        "entry_id": "b7d25c69-233c-3eae-8eb9-02c4d7126a16",
                                        "glosses": [
                                            "Sexe des femmes."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60f11ab7-d186-414f-8b84-fe28f68ce297",
                                                "sense_id": "67a98dd4-d619-3b8c-80a0-0c3a3076f961",
                                                "text": "Dis-donc, tu n'as plus aucun poil sur le feuillu !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
