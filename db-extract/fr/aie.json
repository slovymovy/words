                        ],
                        "form": "que j’aie"
                    },
                    {
                        "form_id": "46cedb9a-bb1c-4df8-a3d6-ada73a297c9e",
                        "entry_id": "f3c22727-4d61-363d-ba5c-4c8807988bc2",
                        "tags": [],
                        "form": "as"
                    },
                    {
                        "form_id": "b8800f00-8770-46b2-a71a-0d9936f3302c",
                        "entry_id": "f3c22727-4d61-363d-ba5c-4c8807988bc2",
                        "tags": [],
                        "form": "aye"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe5dc25a-2765-3502-8c09-a151ccfc402c",
                        "entry_id": "f3c22727-4d61-363d-ba5c-4c8807988bc2",
                        "glosses": [
                            "Première personne du singulier du subjonctif présent du verbe avoir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "feefe835-4cc6-40c3-b57d-589e80eb5ec1",
                                "sense_id": "fe5dc25a-2765-3502-8c09-a151ccfc402c",
                                "text": "Mon jeune compatriote et ami, M. Quellien, poète breton d’une verve si originale, le seul homme de notre temps chez lequel j’aie trouvé la faculté de créer des mythes, […]"
                            },
                            {
                                "example_id": "38c3dc94-6505-4540-acac-9c320c306af6",
                                "sense_id": "fe5dc25a-2765-3502-8c09-a151ccfc402c",
                                "text": "Si je voyage en moto, alors il faut que j'aie un casque."
                            },
                            {
                                "example_id": "8aa901bc-9d42-4ce7-9873-d3041d04d49c",
                                "sense_id": "fe5dc25a-2765-3502-8c09-a151ccfc402c",
                                "text": "– Foi de moi, gronda Martin, même s’il faut traverser cette damnée baie à la nage, je vous donne ma parole : il ne se passera pas trois semaines que je n’aie rembarqué dans l’autre sens."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bbe6e8e-f3a2-3c2a-936f-1c9bfcad9405",
                        "entry_id": "f3c22727-4d61-363d-ba5c-4c8807988bc2",
                        "glosses": [
                            "Deuxième personne du singulier de l’impératif présent du verbe avoir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "43cefecc-d5ba-4113-9b18-97786d8e5fc3",
                                "sense_id": "0bbe6e8e-f3a2-3c2a-936f-1c9bfcad9405",
                                "text": "– C’est bon, mon enfant ; aie soin que ta poche ne se découse pas."
                            },
                            {
                                "example_id": "e72151c7-292d-4aa4-8013-dc1b1aab9f3d",
                                "sense_id": "0bbe6e8e-f3a2-3c2a-936f-1c9bfcad9405",
                                "text": "Aie peur de moi, je suis ton père ! Aie peur de Dieu ! Bref, aie peur !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
