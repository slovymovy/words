                "senses": [
                    {
                        "sense_id": "671ebedc-d18a-336d-ba1d-2a1ac0aa60e8",
                        "entry_id": "f49edbd6-b00d-38c1-a245-7a94cc5a7747",
                        "glosses": [
                            "eine plötzliche, geruchliche Veränderung, die mit den menschlichen Sinnen wahrgenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8ad92e-6644-4af0-94c0-e53a3562b368",
                                "sense_id": "671ebedc-d18a-336d-ba1d-2a1ac0aa60e8",
                                "text": "„Diese Geruchserscheinungen waren kaum wahrnehmbar.“"
                            },
                            {
                                "example_id": "556d9a87-97d7-485f-a8ae-0807d7ced6c3",
                                "sense_id": "671ebedc-d18a-336d-ba1d-2a1ac0aa60e8",
                                "text": "„Wenn in Räumen Ihrer Wohnung Geruchserscheinungen auftreten, (z.B. muffig, modrig o. nach\" Kartoffelkeller\"), oder regelmäßig körperliche Reaktionen auftreten (z.B. starkes Niesen), kann ein versteckter Schimmelbefall vorliegen.“"
                            },
                            {
                                "example_id": "aeb49e8a-2629-4884-8d5c-3bf646a0069d",
                                "sense_id": "671ebedc-d18a-336d-ba1d-2a1ac0aa60e8",
                                "text": "„Hier finden Sie Praxis-Beispiele über Schadstoff-Analysen, sogenannte \"Wohngifte\" oder auch \"nur\" Geruchserscheinungen am Arbeitsplatz.“"
                            },
                            {
                                "example_id": "4a309e15-4962-46c2-9de6-47eba461ef07",
                                "sense_id": "671ebedc-d18a-336d-ba1d-2a1ac0aa60e8",
                                "text": "„Unterbleibt diese ausreichende Belüftung des Kompostgutes kommt es zu unangenehmen Geruchserscheinungen.“"
                            },
                            {
                                "example_id": "30571a07-eeb4-4df8-a5fa-30e9b70e3165",
                                "sense_id": "671ebedc-d18a-336d-ba1d-2a1ac0aa60e8",
                                "text": "„Auffällig beim Sulfatverfahren sind typische Geruchserscheinungen, die durch organische Schwefelverbindungen entstehen können.“"
                            },
                            {
                                "example_id": "f41cb125-bd6f-4c5b-aa41-911a8ffdb061",
                                "sense_id": "671ebedc-d18a-336d-ba1d-2a1ac0aa60e8",
                                "text": "„Allerdings berichtete er zugleich von 150 Mitarbeiterbeschwerden über ‚Geruchserscheinungen‘ sowie 113 ‚Befindlichkeitsstörungen‘ von Beschäftigten, seit die Geräte wieder am Flughafen im Einsatz sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
