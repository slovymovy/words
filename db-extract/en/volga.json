                    {
                        "translation_id": "546e2886-c0e0-41ab-84ae-8b7cfc2bd698",
                        "source_entry_id": "85d55f7e-727d-360b-a75b-c91897cda1e1",
                        "source_sense_id": "bd022e37-58e3-3c03-b0f8-b655be867667",
                        "source_sense_description": "longest river in Europe, flowing to the Caspian Sea",
                        "target_lang_word": "Во́лга",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Во́лга",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1fbeb5-9324-37c8-8004-9e3545872e98",
                                        "entry_id": "48237e03-c322-39b8-8ff8-5345f48c5798",
                                        "glosses": [
                                            "река в России, впадает в Каспийское море, крупнейшая река в Европе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b04c75ec-bd0c-4ac0-85b6-c4dd8eee3984",
                                                "sense_id": "4e1fbeb5-9324-37c8-8004-9e3545872e98",
                                                "text": "Плавание вверх по Волге было очень медленно, и, в случае противного ветра, гребцы и рабочие выходили на берег и тянули суда лямкой: кроме судов, отправлявшихся с караваном, некоторые смелые хозяева пускались отдельно на своих стругах и носадах, но нередко платились достоянием и жизнью за свою смелость."
                                            },
                                            {
                                                "example_id": "1ad45ef2-c892-4f0b-bd9c-306cc07d2271",
                                                "sense_id": "4e1fbeb5-9324-37c8-8004-9e3545872e98",
                                                "text": "А величавая, вечно широкая Волга голубой пеленой омывала подошвы бугров, пугливо ласкаясь к ним и отражая в себе цвета их зеленых, желтых и багровых глин, белых песков и разновидных хрящей и слюд."
                                            },
                                            {
                                                "example_id": "142c3735-0c98-4fd1-b39b-4fb3e85c5346",
                                                "sense_id": "4e1fbeb5-9324-37c8-8004-9e3545872e98",
                                                "text": "Как он братьев да друзей своих из неволи вызволил, как с ними строгановские караваны топил, как потом на Дону казачил да по Волге гулял."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d2ba1d3-d224-31ff-a191-275349c34a8e",
                                        "entry_id": "48237e03-c322-39b8-8ff8-5345f48c5798",
                                        "glosses": [
                                            "название ряда населённых пунктов в России"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff948fd5-f8cb-3cfe-aa5d-49c6a401def2",
                                        "entry_id": "48237e03-c322-39b8-8ff8-5345f48c5798",
                                        "glosses": [
                                            "марка легкового автомобиля автозавода ГАЗ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9e9e369-5263-4aeb-83a8-8065b8b2bba1",
                                                "sense_id": "ff948fd5-f8cb-3cfe-aa5d-49c6a401def2",
                                                "text": "Несмотря на то что доставившая их милицейская «Волга» остановилась у самого порога, Борис Платонович ухитрился изрядно намокнуть."
                                            },
                                            {
                                                "example_id": "b8ba48d9-c274-45fe-a2ad-97c5101ae9dd",
                                                "sense_id": "ff948fd5-f8cb-3cfe-aa5d-49c6a401def2",
                                                "text": "До метро оставалось метров двести, когда рядом со мной затормозила чёрная «Волга» с тонированными стёклами и синим маячком на крыше. ❬…❭ Наша «Волга» взвизгнула покрышками и устремилась вперёд, нагоняя белый фургон."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55e438d3-cb9b-3ccf-9317-80189fe8bad8",
                                        "entry_id": "48237e03-c322-39b8-8ff8-5345f48c5798",
                                        "glosses": [
                                            "река в штате Айова, приток Миссисипи"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf8c0e00-1035-3d89-a747-637c7b5307dc",
                                        "entry_id": "48237e03-c322-39b8-8ff8-5345f48c5798",
                                        "glosses": [
                                            "фамилия"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
