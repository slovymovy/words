                    "frequency": "High",
                    "semantic_group_id": "egalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a préparé <w>autant</w> de gâteaux que nécessaire pour la fête de l'école."
                        },
                        {
                            "text": "Paul a réussi son examen et son frère espère bien en faire <w>autant</w> l'année prochaine."
                        }
                    ],
                    "antonyms": [
                        "moins",
                        "plus"
                    ],
                    "common_phrases": [
