                ],
                "senses": [
                    {
                        "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                        "entry_id": "57e47eff-480b-3600-a09b-99f5af221c77",
                        "glosses": [
                            "Eisenbahnzug, der Personen transportiert, ohne dass diese auf ihrer Fahrt umsteigen müssten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5d7e39-6bdf-4b75-a0f0-812013b4fcd4",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "Um die Bahn attraktiver zu machen müssten viele Direktzüge angeboten werden."
                            },
                            {
                                "example_id": "0ad97ac5-be41-42d0-81ea-bcef0f30b5b4",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„Der erste Direktzug aus Prag ist in Flensburg angekommen.“"
                            },
                            {
                                "example_id": "c940d10e-8e32-499d-9a66-6db82650b6dc",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„ab Sonntag, 12. Juni 2022, gibt es endlich wieder einen Direktzug von der Seegefelder Straße bis nach Westerland/Sylt.“"
                            },
                            {
                                "example_id": "ac650b9e-4f2e-4aec-9050-8d8c076adddf",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„Doch im neuen Fahrplan der Deutschen Bahn (DB), der von Mitte Dezember an gilt, ist der traditionsreiche Direktzug nach Westerland bislang nicht enthalten.“"
                            },
                            {
                                "example_id": "3fae61a3-4176-4eab-9b4d-2608e45857db",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "[Schlagzeile:] „Neuer Direktzug zwischen Berlin und Tirol“"
                            },
                            {
                                "example_id": "85fe9908-ae4e-40aa-8330-7e1f5169e9bd",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "[Schlagzeile:] „Bahn: Lokalpolitik fordert Direktzug Lüneburg-Berlin zurück“"
                            },
                            {
                                "example_id": "11d6ceb5-b03b-469d-ad07-301a04759174",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„Vom Bahnhof Windsor and Eton Riverside fahren Direktzüge zum Londoner Bahnhof Waterloo.“"
                            },
                            {
                                "example_id": "76a4ea67-ee47-485b-a226-b9eaf7b2baac",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„Die württembergischen Juden wurden ab November 1941 in mehreren Direktzügen zu je ca. 1000 Personen nach Riga, Izbica, Auschwitz und Theresienstadt deportiert, wo sie umgebracht wurden.“"
                            },
                            {
                                "example_id": "8a8e999b-1032-4bf2-a441-6d34aeefab89",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„Vom Hauptbahnhof Roma Termini fährt auch ein halbstündlicher, schnellerer Direktzug, der sogenannte Leonardo Express, der den Flughafen in 32 Minuten erreicht und nur über Erste-Klasse-Wagen verfügt.“"
                            },
                            {
                                "example_id": "85097098-68a5-4d45-8e39-753eaf1cb1cc",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„Chester ist ein wichtiger Eisenbahnknoten. Direktzüge nach London benötigen 2 Stunden (Virgin Trains), die häufigeren Verbindungen mit Umstieg in Crewe ca. 2:15 Stunden.“"
                            },
                            {
                                "example_id": "59507081-3567-4546-b90a-397b8ec3dc03",
                                "sense_id": "858cf1f4-5dbc-3bce-b446-eceb6d1a5cd5",
                                "text": "„Wer mit dem Zug von St. Gallen nach Basel fahren will, der soll das in Zukunft im Direktzug machen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
