                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91f732b-d8ed-49b5-9344-e55d34f1518f",
                                "sense_id": "26cb76ae-4152-3caa-93da-9bd7082b845a",
                                "text": "De tweeënveertig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
