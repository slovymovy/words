                "senses": [
                    {
                        "sense_id": "be8f5457-7702-323e-95fe-ed90f39a312e",
                        "entry_id": "23116ea0-4e28-342d-96de-2f4254fd5678",
                        "glosses": [
                            "A rhymer; a poetaster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6eb6a8-f175-4a55-9a9a-32669d43d150",
                                "sense_id": "be8f5457-7702-323e-95fe-ed90f39a312e",
                                "text": "[...] “Whether vanity is the cause of our becoming rhymesters or not,” answered Harley, “it is a pretty certain effect of it. [...]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad3e75a1-7dd1-42d1-a5d8-292a4eb29086",
