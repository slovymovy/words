                    {
                        "translation_id": "9fc4d087-f5c8-4c0f-aaf0-c7356035459f",
                        "source_entry_id": "2b487af2-bb9e-3d2b-97df-5d564c4281af",
                        "source_sense_description": "1036 — see also sextillion",
                        "target_lang_word": "ундециллион",
                        "target_lang_code": "ru",
