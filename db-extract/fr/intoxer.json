                "senses": [
                    {
                        "sense_id": "4e00baae-665c-36fe-b454-12c4f1e2630a",
                        "entry_id": "05da2271-b305-3cd0-867c-54ae3f609a41",
                        "glosses": [
                            "Variante de intoxiquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a733cd43-9c9b-49f7-bd6d-889da9e2341b",
                                "sense_id": "4e00baae-665c-36fe-b454-12c4f1e2630a",
                                "text": "Du Paty de Clam ne saisit pas que lui et les autres sont en train de se faire intoxer ou canuler."
                            },
                            {
                                "example_id": "316684f8-217b-434a-a186-214b928a291e",
                                "sense_id": "4e00baae-665c-36fe-b454-12c4f1e2630a",
                                "text": "Ça donne peut-être l'impression de violenter les drosophiles, mais ce serait dommage de se laisser intoxer par un site commercial inexact!"
                            },
                            {
                                "example_id": "ddd9d022-8950-43dd-8c64-78a3037c0201",
                                "sense_id": "4e00baae-665c-36fe-b454-12c4f1e2630a",
                                "text": "Une semaine riche en rebondissement mais personne pour en causer ou pour \"intoxer\" étrange"
                            },
                            {
                                "example_id": "a4435835-0f90-45ee-a946-dbb74b501a91",
                                "sense_id": "4e00baae-665c-36fe-b454-12c4f1e2630a",
                                "text": "BHL : un escroc de philosophe, un va-t'en-guerre au service d'Israël chargé d'intoxer le peuple français."
                            }
                        ]
                    }
