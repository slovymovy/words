                                    },
                                    {
                                        "sense_id": "b253e4a6-ee8a-3577-b794-9176508d9209",
                                        "entry_id": "fed95220-ba93-3077-9642-69851b092a87",
                                        "glosses": [
                                            "van een probleem dat het lang bestaat en maar niet opgelost wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac4d2b0-d337-4a57-ba70-9b5f7c22098e",
                                                "sense_id": "b253e4a6-ee8a-3577-b794-9176508d9209",
                                                "text": "Dat de EU en het IMF naar verwachting toch de geldzak opentrekken heeft te maken met de diep gekoesterde wens - en noodzaak - om de etterende Griekse wond in de eurozone van een stevig verband te voorzien. Vorig jaar werd het toezicht op de financiële markten aangescherpt, dit jaar de begrotingsdiscipline, dus is het nu tijd het Griekse drama te beëindigen."
                                            },
                                            {
                                                "example_id": "ba3d4dd9-3e7b-496c-9b84-8f1285fad265",
                                                "sense_id": "b253e4a6-ee8a-3577-b794-9176508d9209",
                                                "text": "Mogelijk zal er een beperkt akkoord worden gesloten om de ergste gevolgen van de fiscal cliff te verzachten, waarover in 2013 dan verder zal worden gesproken. De markt juicht dat niet toe. 'Ieder akkoord dat nu nog zal worden gesloten, zal niet meer zijn dan een kleine pleister op een etterende wond', aldus een analist."
                                            }
                                        ]
                                    }
                                ]
                            }
