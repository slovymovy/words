                        "examples": [
                            {
                                "example_id": "2da0d1ef-057f-4850-af85-27814974330a",
                                "sense_id": "06bd7829-a1fa-3705-8584-5c022c0400ae",
                                "text": "La version que j’insère ici est publiée avec le titre « Un monde enfin lisible et déambulable » dans le chapitre 8 de La experiencia de la lectura, Barcelone, Laertes, 1996, pages 261-296."
                            },
                            {
                                "example_id": "175a3e4a-c5be-44d1-be43-733d0e202fb7",
                                "sense_id": "06bd7829-a1fa-3705-8584-5c022c0400ae",
                                "text": "Sauf que TPL [ToyStory Playland] n’accueillait pas un E-ticket majeur familial, un premier restau de zone et la surface déambulable est plus longue et en couloir."
                            },
                            {
                                "example_id": "6d868f5a-1e62-4f0b-8539-bb27e5b7e59b",
                                "sense_id": "06bd7829-a1fa-3705-8584-5c022c0400ae",
                                "text": "Facile à dire, un, puis deux, puis trois quads pétaradants occupent d'autorité l'espace déambulable, avec la ferme intention d'éliminer tout élément gênant leur bruyante progression."
                            }
                        ]
                    }
