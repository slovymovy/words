{
    "word_family": [
        "quash",
        "quashable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ff14082-0741-307d-872e-53760b92f14c",
                    "sense_definition": "present participle and gerund of <w>quash</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is <w>quashing</w> any rumors about the upcoming election to maintain public order.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>пресекает</w> любые слухи о предстоящих выборах для поддержания общественного порядка."
                            }
                        },
                        {
                            "text": "By <w>quashing</w> the rebellion quickly, the military prevented a much larger conflict from starting.",
                            "target_lang_translations": {
                                "ru": "Быстро <w>подавив</w> восстание, военные предотвратили начало гораздо более масштабного конфликта."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppressing",
                        "crushing",
                        "nullifying"
                    ],
                    "antonyms": [
                        "encouraging",
                        "validating"
                    ],
                    "common_phrases": [
                        "quashing a rebellion",
                        "quashing rumors"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола quash (подавлять, аннулировать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавляющий",
                                "target_lang_sense_clarification": "о восстании или слухах"
                            },
                            {
                                "target_lang_word": "аннулирующий",
                                "target_lang_sense_clarification": "о судебном решении"
                            },
                            {
                                "target_lang_word": "пресекающий",
                                "target_lang_sense_clarification": "о попытках или действиях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51bdadee-cf62-38a8-8ad8-0dbaed6e9cab",
                    "sense_definition": "The act of suppressing, nullifying, or putting an end to something, often a legal proceeding or a rebellion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>quashing</w> of the legal verdict surprised everyone in the courtroom today.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>отмена</w> судебного приговора сегодня удивила всех присутствующих в зале суда."
                            }
                        },
                        {
                            "text": "The <w>quashing</w> of a jihadi enclave here only spurs the sprouting of another there.",
                            "target_lang_translations": {
                                "ru": "<w>Подавление</w> анклава джихадистов в одном месте лишь стимулирует его появление в другом."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppression",
                        "annulment",
                        "abrogation"
                    ],
                    "antonyms": [
                        "instigation",
                        "establishment"
                    ],
                    "common_phrases": [
                        "quashing of a conviction",
                        "quashing of a protest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт подавления, аннулирования или прекращения чего-либо, часто судебного разбирательства или восстания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавление",
                                "target_lang_sense_clarification": "восстания или протеста"
                            },
                            {
                                "target_lang_word": "аннулирование",
                                "target_lang_sense_clarification": "судебного приговора или решения"
                            },
                            {
                                "target_lang_word": "отмена",
                                "target_lang_sense_clarification": "официального постановления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}