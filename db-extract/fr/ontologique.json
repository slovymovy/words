                                        "entry_id": "01d01530-2255-3f55-a781-6e34c0a5b71f",
                                        "glosses": [
                                            "che riguarda l'ontologia, cioè la scienza dell'essere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37bf4ae2-bf3d-4fe1-9887-17ad8ad95ace",
