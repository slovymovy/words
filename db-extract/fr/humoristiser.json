                "senses": [
                    {
                        "sense_id": "3cf88b23-73eb-30ae-849c-1bc89becd8d4",
                        "entry_id": "0f26ef3d-9d6c-3d15-92c3-e9c74169517a",
                        "glosses": [
                            "Rendre humoristique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e85ecd-bb3b-4aa7-b78a-a09c4d1638ef",
                                "sense_id": "3cf88b23-73eb-30ae-849c-1bc89becd8d4",
                                "text": "Là ou Dieudo est fort c’est qu’il arrive à « humoristiser » le TABOU que ce soit la shoah, le cancer, etc… ^([sic : etc.])"
                            },
                            {
                                "example_id": "a0e89df7-da97-4afe-90ae-4bea13b80cb3",
                                "sense_id": "3cf88b23-73eb-30ae-849c-1bc89becd8d4",
                                "text": "Donc cela a pour but (totalement lucratif) de rendre notre chaîne encore plus active et de la diversifier grâce à notre imagination sans limite et de l’humoristiser avec notre sens de l’humour débordant."
                            },
                            {
                                "example_id": "b79acbba-a63a-4b29-b41d-6d57c96ceeb8",
                                "sense_id": "3cf88b23-73eb-30ae-849c-1bc89becd8d4",
                                "text": "j’avoue ma reine le roi a trouvé matière a ^([sic : à]) discuter… a ^([sic : à]) rigoler… à « humoristiser » notre cher forum"
                            }
                        ]
                    }
