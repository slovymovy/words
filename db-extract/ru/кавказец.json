                                                "example_id": "178fbbe0-0293-4961-9ddb-d7387c749841",
                                                "sense_id": "a18b241f-7727-3fc8-a210-c062f3ca163b",
                                                "text": "„Die Kaukasier wären nicht Kaukasier, wenn sie nicht eine stressfreie Abkürzung bei der Lösung dieses Problems gefunden hätten.“"
                                            },
                                            {
                                                "example_id": "54999790-e075-4c9e-9ed1-b9a4baf30a91",
                                                "sense_id": "a18b241f-7727-3fc8-a210-c062f3ca163b",
                                                "text": "„So früh es ist – die Leute sitzen doch schon vor ihren Türen und plaudern oder wandeln in den Straßen umher, die Kaukasier schlafen nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a23d0143-d910-3d09-b594-048c26ce8671",
                                        "entry_id": "e5efb789-4130-38ab-ae85-f8145a57020f",
                                        "glosses": [
                                            "rassenkundliche Bezeichnung für hellhäutige Menschen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed6f68e-30f3-4dec-8f74-2c660eb5768b",
                                                "sense_id": "a23d0143-d910-3d09-b594-048c26ce8671",
                                                "text": "„Alle wahrhaft gebildeten Völker, von denen die Geschichte spricht, waren Kaukasier, so die Perser, Assyrier, Inder, Aegypter, Juden, Griechen, Römer u.s.w.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
