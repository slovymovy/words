                            {
                                "target_lang_word": "terbiye",
                                "target_lang_sense_clarification": "ahlak ve edep"
                            },
                            {
                                "target_lang_word": "nezaket",
                                "target_lang_sense_clarification": "kibar davranışlar"
                            }
                        ]
