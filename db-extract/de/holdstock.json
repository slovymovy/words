                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a67a012-e890-48da-930e-e1e4ac0c7be9",
                                "sense_id": "84b2d5b2-a878-3554-8791-965439264cee",
                                "text": "Frau Holdstock ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f92d782b-c331-4576-8d3b-396252df803f",
                                "sense_id": "84b2d5b2-a878-3554-8791-965439264cee",
                                "text": "Herr Holdstock wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "291e45a0-cdbd-4893-9055-5c87b3b85189",
                                "sense_id": "84b2d5b2-a878-3554-8791-965439264cee",
                                "text": "Die Holdstocks fahren heute nach Genf."
                            },
                            {
                                "example_id": "61043869-691d-4cc8-a5e5-3cd96567a812",
                                "sense_id": "84b2d5b2-a878-3554-8791-965439264cee",
                                "text": "Der Holdstock trägt nie die Schals, die die Holdstock ihm strickt."
                            },
                            {
                                "example_id": "e2e3fded-e496-40b4-91e1-ce9bfc442041",
                                "sense_id": "84b2d5b2-a878-3554-8791-965439264cee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Holdstock kommt, geht der Herr Holdstock.“"
                            },
                            {
                                "example_id": "a48844d5-0a9a-432b-9525-549ba2d2318e",
                                "sense_id": "84b2d5b2-a878-3554-8791-965439264cee",
                                "text": "Holdstock kommt und geht."
                            },
                            {
                                "example_id": "d149bd8b-6cd0-4b35-bb11-f5dbb8d25372",
                                "sense_id": "84b2d5b2-a878-3554-8791-965439264cee",
                                "text": "Holdstocks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
