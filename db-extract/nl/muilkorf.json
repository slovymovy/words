                                    },
                                    {
                                        "sense_id": "78ab241a-000a-310c-8387-de2fc33d5980",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To veil, mask, muffle."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "646daa3f-70b3-395a-8980-d0977238b1b7",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To fondle with the closed mouth; to nuzzle."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03ee79e-d7e8-4b5a-a547-6cfb0bd1078d",
                                                "sense_id": "646daa3f-70b3-395a-8980-d0977238b1b7",
                                                "text": "Venus her self would sit Muzzling and Gazing them in the Eyes"
                                            },
                                            {
                                                "example_id": "168b8a55-6df9-49d9-a891-bcfd15a5297c",
                                                "sense_id": "646daa3f-70b3-395a-8980-d0977238b1b7",
                                                "text": "And now, while they are climbing the pole in another part of the field, and muzzling in a flour-tub in another, the old farmer […] announces to all whom it may concern that a half-sovereign in money will be forthcoming to the old gamester who breaks most heads; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "015b265e-fe38-348d-90fb-3b3d83c86daa",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To bring the muzzle or mouth near."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f64d5ee1-a63f-4670-a06a-797375a3ea56",
                                                "sense_id": "015b265e-fe38-348d-90fb-3b3d83c86daa",
                                                "text": "The Bear comes directly up to him, Muzzles and Smells to him."
                                            }
                                        ]
                                    }
                                ]
                            }
