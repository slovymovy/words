                    "sense_id": "53c3e19b-ca22-39a9-93e5-5ea10e30715f",
                    "sense_definition": "de handeling van het gaan naar een persoon of plaats om daar tijd door te brengen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "visite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga vanavond bij mijn oma op <w>bezoek</w> om haar te helpen.",
                            "target_lang_translations": {
                                "en": "I am going to <w>visit</w> my grandmother tonight to help her."
                            }
                        },
                        {
                            "text": "Zij gingen even een <w>bezoek</w> afleggen bij de nieuwe buren in de straat.",
                            "target_lang_translations": {
                                "en": "They went to pay a quick <w>visit</w> to the new neighbors in the street."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op bezoek",
                        "bezoek afleggen",
                        "bezoek aan"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of going to a person or place to spend time there"
                    },
                    "translations": {
                        "en": [
