                                    {
                                        "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                        "entry_id": "a7df7697-9afb-3150-90f6-c519425718dc",
                                        "glosses": [
                                            "A deficiency or need (of something desirable or necessary); an absence, want, dearth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b99ee4-fd45-4f0d-aadc-4fe2d2ebcebd",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "[…] let his lack of years be no impediment to let him lack a reverend estimation;"
                                            },
                                            {
                                                "example_id": "cb0b79c2-2308-4a43-a757-adbf961b4727",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "I went to a shrink, to analyze my dreams. He said it's lack of sex that's bringing me down."
                                            },
                                            {
                                                "example_id": "a9aec3fb-af32-40c1-8854-c3dace553090",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "If Moldova harboured even the slightest hopes of pulling off a comeback that would have bordered on miraculous given their lack of quality, they were snuffed out 13 minutes before the break when Oxlade-Chamberlain picked his way through midfield before releasing Defoe for a finish that should have been dealt with more convincingly by Namasco at his near post."
                                            },
                                            {
                                                "example_id": "4d879a7d-f1b2-439d-a7c5-0871f1353192",
                                                "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                                                "text": "More flak was aimed at the Treasury's apparent lack of marketing skills, when it was argued that its idea of how to sell tickets was along the lines of \"you can get two tickets for the price of two\", and it lacks the sales and promotional skills of the train operating companies which are needed to boost revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad7357e3-3577-3e1a-bd33-30ecdd6303cc",
                                        "entry_id": "a7df7697-9afb-3150-90f6-c519425718dc",
                                        "glosses": [
                                            "A defect or failing; moral or spiritual degeneracy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecacf5d-3d03-4dbb-b488-c807cf4e1602",
                                                "sense_id": "ad7357e3-3577-3e1a-bd33-30ecdd6303cc",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9aeb9b-0d7d-3527-9ded-191ebc6de41b",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be without, not to have, to need, to require."
                                        ],
                                        "tags": [
                                            "stative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c16ed48f-951e-4602-9ecf-80849c7dd839",
                                                "sense_id": "2a9aeb9b-0d7d-3527-9ded-191ebc6de41b",
                                                "text": "My life lacks excitement."
                                            },
                                            {
                                                "example_id": "59eecf70-d301-44a7-981a-bba6eb8fda67",
                                                "sense_id": "2a9aeb9b-0d7d-3527-9ded-191ebc6de41b",
                                                "text": "More flak was aimed at the Treasury's apparent lack of marketing skills, when it was argued that its idea of how to sell tickets was along the lines of \"you can get two tickets for the price of two\", and it lacks the sales and promotional skills of the train operating companies which are needed to boost revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b71ffc5-78fa-39e8-8f6a-d5be9826a6b8",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be short (of or for something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a293391-8687-4ac4-861d-7e439b1088e6",
                                                "sense_id": "9b71ffc5-78fa-39e8-8f6a-d5be9826a6b8",
                                                "text": "He'll never lack for company while he's got all that money."
                                            },
                                            {
                                                "example_id": "8a53cbd7-cb33-4721-b50f-a1f19e5e4102",
                                                "sense_id": "9b71ffc5-78fa-39e8-8f6a-d5be9826a6b8",
                                                "text": "Hamlet. What hour now?\nHoratio. I think it lacks of twelve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf760df-16fe-3d01-9718-e30f582fc519",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be in want."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "561de3d9-fb24-4622-8cce-4e8fcfc2bed4",
                                                "sense_id": "edf760df-16fe-3d01-9718-e30f582fc519",
                                                "text": "The young lions do lack, and suffer hunger […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7740c79-51fc-3d31-a112-59d58f85bb06",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To see the deficiency in (someone or something); to find fault with, to malign, reproach."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39c04724-b4ed-499d-ba21-66f17f203045",
                                                "sense_id": "e7740c79-51fc-3d31-a112-59d58f85bb06",
                                                "text": "That is Mede þe Mayde quod she · hath noyed me ful oft / And ylakked my lemman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e141bf08-5849-3f8c-9f52-1c53775dba24",
                                        "entry_id": "25e613a4-d8f2-3ac1-a851-51b9bf2d9ab9",
                                        "glosses": [
                                            "To be off one's guard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242cbab2-7a57-4b0d-b76c-ac37fea396ee",
                                                "sense_id": "e141bf08-5849-3f8c-9f52-1c53775dba24",
                                                "text": "His opps caught him lacking."
                                            }
