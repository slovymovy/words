                "senses": [
                    {
                        "sense_id": "4c1012cd-6e22-3e7b-8f8c-ae59c1c88d42",
                        "entry_id": "e81bf561-e93e-395a-b3b8-7fe804bd2087",
                        "glosses": [
                            "A person qualified to make or repair boilers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1236b6a9-47ff-4d1a-8094-26bc642286c7",
                                "sense_id": "4c1012cd-6e22-3e7b-8f8c-ae59c1c88d42",
                                "text": "The sole boilermaker visited the out-depots if necessary, but such occasions were exceptional, engines being worked up to Horsham on suitable duties and changed over as required."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a225758-f125-380f-8274-d9477102106a",
                        "entry_id": "e81bf561-e93e-395a-b3b8-7fe804bd2087",
                        "glosses": [
                            "A whiskey with a beer chaser."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "afda13a4-04e4-4d22-87fa-f134a60bb255",
                                "sense_id": "2a225758-f125-380f-8274-d9477102106a",
                                "text": "the beauteous Asian was […] knocking back boilermakers and their helpers at an astonishing pace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e9c0416-4329-4356-b4e4-c0a591402f22",
                        "source_entry_id": "e81bf561-e93e-395a-b3b8-7fe804bd2087",
                        "source_sense_description": "a person making or repairing boilers",
                        "target_lang_word": "chaudronnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaudronnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d35802-f01a-3f35-a12c-014e1061bf7a",
                                        "entry_id": "4adb9bad-b1ad-36fb-9803-5eb786309d64",
                                        "glosses": [
                                            "Celui qui fait, vend des chaudrons et autres ustensiles de cuisine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f48fbf2-1203-4560-b63e-473b7851d5bf",
                                                "sense_id": "d8d35802-f01a-3f35-a12c-014e1061bf7a",
                                                "text": "Si les corporations exclusivement féminines restent l’exception, les corporations mixtes qui admettent indistinctement les hommes et les femmes sont extrêmement nombreuses. Parmi celles-ci, il faut citer les drapiers, les tisserands, les grainiers (Rouen, Paris), les passementiers (Paris, Tours, Clermont), les cabaretiers (Tours, Orléans), les tonneliers (Nîmes), les tailleurs (Coutances, Angoulême, Dijon), les boulangers (Orléans, Paris), les merciers (Paris, Caen), les poissonniers (Paris, Dijon), les imprimeurs (Paris, Orléans, Caen), les limonadiers (Caen), les maçons (Apt), les corroyeurs (Annonay), les orfèvres (Lyon), les chaudronniers (Orléans), les charcutiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2bb2655-b6ed-31fc-b185-e80cb93ae7d5",
                                        "entry_id": "4adb9bad-b1ad-36fb-9803-5eb786309d64",
                                        "glosses": [
                                            "Ouvrier qualifié qui travaille le métal et plus particulièrement qui forge : la tôle, tubes, plats, et les pièces déjà usinées pour en faire des produits industriels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "134a1e91-054f-4da8-97fc-68d6d8a9e7d6",
                                                "sense_id": "c2bb2655-b6ed-31fc-b185-e80cb93ae7d5",
                                                "text": "Il y a un chaudronnier en train de taper sur du beau cuivre rouge, que le marteau marque comme une croupe de jument pommelée et qui fait « dzine, dzine, » sur le carreau ; chaque coup me fait froncer la peau et cligner des yeux."
                                            },
                                            {
                                                "example_id": "4aca7f6e-5d07-4ae7-ab1a-264c8193f121",
                                                "sense_id": "c2bb2655-b6ed-31fc-b185-e80cb93ae7d5",
                                                "text": "Mais, déduit lentement le Martinot, je suis ferblantier, et chaudronnier. Je sais passer la main sur la tôle pour en sentir le nerf et savoir où taper pour la débeugner. Eh ben, j’vas essayer de te rebouter."
                                            },
                                            {
                                                "example_id": "ea8e6309-446a-429e-8a28-6e4122415645",
                                                "sense_id": "c2bb2655-b6ed-31fc-b185-e80cb93ae7d5",
                                                "text": "Tracer, découper, percer, assembler le métal, telles sont les missions qui incombent au chaudronnier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chaudronnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7091a1f4-7cf4-3384-b448-aa228b4e10e7",
                                        "entry_id": "845b20d2-846f-31b3-b98f-dfceec14f21e",
                                        "glosses": [
                                            "Qui concerne la fabrication, la vente des chaudrons."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29dfd3eb-81b2-352e-ba4e-5828f552a5d3",
                                        "entry_id": "845b20d2-846f-31b3-b98f-dfceec14f21e",
                                        "glosses": [
                                            "Qui concerne l’industrie de la chaudronnerie."
                                        ],
                                        "tags": [
                                            "Chaudronnerie"
                                        ],
                                        "examples": [
