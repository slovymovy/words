                "senses": [
                    {
                        "sense_id": "a2c92ccf-b7fe-3038-ad6a-e685acd56331",
                        "entry_id": "6bdd2310-03a4-3a85-a462-67e4c914cf9b",
                        "glosses": [
                            "Antikörper, der zur Zytolyse führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc8f9bc-61eb-4911-9b66-a273877ae526",
                                "sense_id": "a2c92ccf-b7fe-3038-ad6a-e685acd56331",
                                "text": "„Bakterien wie Streptococcus pyogenes produzieren ständig Zytolysine für den Fall, dass sie auf Fresszellen treffen.“"
                            },
                            {
                                "example_id": "e1b4a982-9a5f-4149-aa92-7b0c9054badb",
                                "sense_id": "a2c92ccf-b7fe-3038-ad6a-e685acd56331",
                                "text": "„Nach Loeb sind es Zytolysine, welche bei kurzer Einwirkung die Entwicklung anregen, wahrscheinlich indem durch von ihnen bewirkte Veränderungen der Oberfläche stärkere Oxydationsprozesse im Ei ermöglicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
