                ],
                "senses": [
                    {
                        "sense_id": "00f23a40-3ac0-375c-b43b-0cc1269b6bfc",
                        "entry_id": "408d8688-8844-336a-bd7c-7324ac3b20c0",
                        "glosses": [
                            "тот, кто способствует примирению, устанавливает мир"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c687bc5-6a5c-4914-a758-551a45901fef",
                                "sense_id": "00f23a40-3ac0-375c-b43b-0cc1269b6bfc",
                                "text": "Счастливы миротворцы, потому что они будут названы сыновьями Бога."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a3bca59-8189-403a-8eef-39572f0b2dae",
                        "source_entry_id": "408d8688-8844-336a-bd7c-7324ac3b20c0",
                        "source_sense_id": "00f23a40-3ac0-375c-b43b-0cc1269b6bfc",
                        "target_lang_word": "peacemaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peacemaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                        "entry_id": "ea7547d6-f96f-3620-8087-7f42c660cdec",
                                        "glosses": [
                                            "A person who restores peace, especially by settling disputes; one who engages in peacemaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d728e5-41e6-4080-aad2-a52120edb83e",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "Bleſſed are the peacemakers: foꝛ they ſhall bee called the childꝛen of God."
                                            },
                                            {
                                                "example_id": "0401d8a3-685d-4910-a7f0-10b86731a53b",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "Mr. Carter has celebrated experience as a peacemaker: he mediated the 1978 peace talks between Israel and Egypt at Camp David."
                                            },
                                            {
                                                "example_id": "3fa77863-5b94-4007-ac0f-1d850656ef1a",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "The peacemakers – clergy, Gray’s family and brave residents – placed themselves in the rioters’ way."
                                            },
                                            {
                                                "example_id": "98146189-16ac-4ab4-884e-48c0303bcd21",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "We're not just the law, Joe. We're the peacemakers. Like the old Colts."
                                            },
                                            {
                                                "example_id": "cbef198a-8033-4e0f-bf7c-0fcd7d21aa7e",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "“That’s what I want to be: a peacemaker and a unifier,” he said. His time in office so far has not, at least not yet, been the era of peace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                        "entry_id": "ea7547d6-f96f-3620-8087-7f42c660cdec",
                                        "glosses": [
                                            "Catachresis for pacemaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6b5a8f-305f-422d-af36-80318cb6538b",
                                                "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                                "text": "Indeed, although the activity of the heart depends on the intrinsic rhythm of its peacemaker […]"
                                            },
                                            {
                                                "example_id": "a604b10c-e4c9-481b-b2fa-73ae9651e567",
                                                "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                                "text": "The “heart’s peacemaker” is the node from which the electrical signal for heart beat are […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6234c473-0423-4b3b-9580-a40e29c6a7d1",
                        "source_entry_id": "408d8688-8844-336a-bd7c-7324ac3b20c0",
                        "source_sense_id": "00f23a40-3ac0-375c-b43b-0cc1269b6bfc",
                        "target_lang_word": "peacekeeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peacekeeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b96680d3-0f2e-3d4b-b45c-2994d369f75d",
                                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                                        "glosses": [
                                            "One that preserves the peace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66af21ea-6408-48b6-8198-cba63e5b3b7e",
                                                "sense_id": "b96680d3-0f2e-3d4b-b45c-2994d369f75d",
                                                "text": "Roughly 1200 years ago, the turians were invited to join the Citadel Council to fulfill the role of galactic peacekeepers. The turians have the largest fleet in Citadel space, and they make up the single largest portion of the Council's military forces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                                        "glosses": [
                                            "A member of a military force charged with peacekeeping duties in a troublespot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e962c55-8728-4811-97d6-611910fd9aad",
                                                "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                                "text": "The grainy footage showed the peacekeepers first bound and beaten, then hooded and dead, hanging by the neck from a wooden ceiling beam. ."
                                            },
                                            {
                                                "example_id": "7353b710-d615-4155-be1f-2962ca36f5fc",
                                                "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                                "text": "Dozens of NATO peacekeepers were injured after they were attacked by ethnic Serbs in northern Kosovo, during protests over the installation of ethnically Albanian mayors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de1a298f-57e5-3a3c-865e-ac9ef42adc1a",
                                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                                        "glosses": [
                                            "An officer of the peace (police officer) in a force run by a Canadian aboriginal community."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
