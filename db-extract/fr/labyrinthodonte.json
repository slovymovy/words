                        "entry_id": "3a5e7fac-ecd4-3f5d-9f62-23c36db75311",
                        "tags": [],
                        "form": "labyrinthodon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7eac726-9b82-38ca-83d1-574515f36532",
                        "entry_id": "3a5e7fac-ecd4-3f5d-9f62-23c36db75311",
                        "glosses": [
                            "Membre d’un taxon d’amphibiens (batraciens) fossiles dont l’ivoire des dents formait des plis comme un labyrinthe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082c9c17-ec9e-4828-afc7-026b6636d27c",
                                "sense_id": "c7eac726-9b82-38ca-83d1-574515f36532",
                                "text": "Il ne craint pas l’iguane, ni le plésiosaure et l’archéoptérix lui plaît, pareillement le labyrinthodonte."
                            },
                            {
                                "example_id": "fe5f13a7-909e-462e-86eb-8870e5831f08",
                                "sense_id": "c7eac726-9b82-38ca-83d1-574515f36532",
                                "text": "Il y avait, à cette époque, des animaux intermédiaires entre les reptiles et les batraciens. C’étaient d’énormes crapauds appelés labyrinthodontes, recouverts de plaques osseuses, dont on a retrouvé les traces sur les rivages qu’ils ont parcourus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c09632a-8d13-479b-975b-7a9f5c5b88a9",
                        "source_entry_id": "3a5e7fac-ecd4-3f5d-9f62-23c36db75311",
                        "source_sense_id": "c7eac726-9b82-38ca-83d1-574515f36532",
                        "target_lang_word": "Labyrinthodontier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Labyrinthodontier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31ffdb46-fafe-37e0-9270-2f117bae2355",
                                        "entry_id": "376131a5-8eb6-3e42-92aa-8df8342ed7b9",
                                        "glosses": [
                                            "Vertreter einer Gruppe ausgestorbener, sehr ursprünglicher Amphibien von Salamandergröße bis zu Riesenformen"
                                        ],
                                        "tags": [
                                            "Paläontologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a087bfc-98c2-4c55-bbe8-02f6125427c5",
                                                "sense_id": "31ffdb46-fafe-37e0-9270-2f117bae2355",
                                                "text": "„Abgesehen von dem Fehlen der medianen Flossen und der Ausbildung kurzer, aber kräftiger Beine … stimmen die frühen Labyrinthodontier in vielen Baueigentümlichkeiten mit den Crossopterygiern weitgehend überein, von denen sie abstammen.“"
                                            },
                                            {
                                                "example_id": "a498184d-2ec3-4f03-b974-17743c3b7f0d",
                                                "sense_id": "31ffdb46-fafe-37e0-9270-2f117bae2355",
                                                "text": "Die Labyrinthodontier gelten heute als eine paraphyletische Gruppe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
