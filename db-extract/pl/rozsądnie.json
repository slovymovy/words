                                "example_id": "7b93cf39-b07f-4fca-953c-2c6a26326f32",
                                "sense_id": "1953479f-1a1d-30ff-afb7-a41aa581548a",
                                "text": "Jeszcze rozsądniej, ciekawiej od strony konstrukcyjnej, zabezpieczono zespół napędowy przed emisją nadmiaru podczerwieni"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8ef995b-a2f0-4acb-9ab8-d61c1ca2e3d2",
                        "source_entry_id": "bee9183a-e126-3982-8ac3-32c96614d3c7",
                        "source_sense_id": "1953479f-1a1d-30ff-afb7-a41aa581548a",
                        "target_lang_word": "advisedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advisedly",
