                "senses": [
                    {
                        "sense_id": "23f95165-44c4-304b-a220-25e0513c4a02",
                        "entry_id": "75d9f711-bd4f-3ba8-8f8e-c533143abb64",
                        "glosses": [
                            "Entschlüsselung der Informationen auf der Kette/Einfachhelix der RNA Identifizierung von RNA, die zu einem RNA-Virus gehört"
                        ],
                        "tags": [
                            "Molekularbiologie",
                            "molekulare Medizin",
                            "oder"
                        ],
                        "examples": [
                            {
                                "example_id": "0d8e4dce-5e2f-4f51-8965-385a4446f525",
                                "sense_id": "23f95165-44c4-304b-a220-25e0513c4a02",
                                "text": "„Die medizinisch relevanten Anwendungen der RNA- Analyse erstrecken sich zur Zeit auf Untersuchungen der Genphysiologie bzw. Pathophysiologie, auf die Diagnostik von RNA-Viren und auf die Expression pathogenetisch relevanter Gene etwas bei malignen Erkrankungen.“"
                            },
                            {
                                "example_id": "bb81d8fe-ca0d-4ca0-9087-a4d4714a74e5",
                                "sense_id": "23f95165-44c4-304b-a220-25e0513c4a02",
                                "text": "„Welcher Virustyp gewütet hat, kann eine RNA-Analyse ermitteln.“"
                            },
                            {
                                "example_id": "be289fdf-6290-4bfa-ae1e-43ba20659f4e",
                                "sense_id": "23f95165-44c4-304b-a220-25e0513c4a02",
                                "text": "„Die PCR kann auch zur RNA-Analyse genutzt werden.“"
                            },
                            {
                                "example_id": "a8e74c05-3bb4-413f-ba10-ff7632cc1ade",
                                "sense_id": "23f95165-44c4-304b-a220-25e0513c4a02",
                                "text": "„Aus dem geringen RNA-Gehalt der Thrombozyten resultieren im Bezug auf RNA-Analysen besondere Herausforderungen.“"
                            },
                            {
                                "example_id": "22479b6a-bd51-4f77-876c-948e6c9ef684",
                                "sense_id": "23f95165-44c4-304b-a220-25e0513c4a02",
                                "text": "„Für RNA-Analysen kann man das Verfahren durch Herstellung komplementärer DNA-Spezies mittels reverser Transkriptase (rtPCR) ebenfalls nutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
