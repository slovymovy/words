                                        "examples": [
                                            {
                                                "example_id": "621e7985-353d-48d8-9162-759d6fed1fdd",
                                                "sense_id": "fc1718fe-5db9-3c77-9515-28cdd05758ab",
                                                "text": "Le dictionnaire des sciences de la vie se donne pour objectif de décrire de façon intégrée les phénomènes de la nature grâce à ses 12 000 définitions appartenant aux 120 disciplines des sciences de la vie."
                                            },
                                            {
                                                "example_id": "0f819f11-66ac-4327-8cd3-3d8aa672f09d",
                                                "sense_id": "fc1718fe-5db9-3c77-9515-28cdd05758ab",
                                                "text": "Les sciences de la vie comprennent aussi, bien entendu , la médecine ; on parle d'ailleurs couramment de sciences de la vie et de la santé plutôt que de sciences de la vie."
                                            }
