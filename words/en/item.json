                            "trait_type": "dated",
                            "comment": "replaced by India in standard NATO alphabet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кодовое слово, обозначающее букву I в старой радиосвязи.",
                        "tr": "Eski telsiz haberleşmesinde I harfini temsil eden kod kelimesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Айтем",
                                "target_lang_sense_clarification": "фонетическое обозначение буквы I (устар.)"
