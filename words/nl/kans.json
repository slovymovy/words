                    "sense_id": "9b778125-1719-3549-bf04-16125090ca11",
                    "sense_definition": "De mogelijkheid dat iets gebeurt of de waarschijnlijkheid van een gebeurtenis.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mogelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kans</w> op regen is vandaag erg groot volgens het weerbericht.",
                            "target_lang_translations": {
                                "en": "The <w>chance</w> of rain is very high today according to the weather report.",
                                "ru": "Согласно прогнозу погоды, <w>вероятность</w> дождя сегодня очень велика.",
                                "fr": "Le <w>risque</w> de pluie est très élevé aujourd'hui selon les prévisions météo."
                            }
                        },
                        {
                            "text": "Er is een kleine <w>kans</w> dat we de trein nog halen als we nu rennen.",
                            "target_lang_translations": {
                                "en": "There is a small <w>chance</w> that we will still catch the train if we run now.",
                                "ru": "Есть небольшой <w>шанс</w>, что мы успеем на поезд, если побежим прямо сейчас.",
                                "fr": "Il y a une petite <w>chance</w> que nous attrapions encore le train si nous courons maintenant."
                            }
                        }
                    ],
                    "common_phrases": [
