                        "examples": [
                            {
                                "example_id": "c38a8d1b-7ddc-4822-a642-f8276bd93b0b",
                                "sense_id": "26cad5ab-1d4e-32c8-a9f1-b5bec359e072",
                                "text": "„Zuvor, um 9 Uhr, kämen die Redakteure mit ihrem Ressortleiter zusammen und besprächen die Themen des Tages.“"
                            },
                            {
                                "example_id": "5cedd82b-5145-40ff-8455-b213a9a97515",
                                "sense_id": "26cad5ab-1d4e-32c8-a9f1-b5bec359e072",
                                "text": "„Der Ressortleiter erhält ausreichende Kompetenzen, um die üblichen Entscheidungen in seinem Ressort allein treffen zu können, ohne dass ein zusätzlicher Vorstandsbeschluss erforderlich ist.“"
                            }
                        ],
