                {
                    "sense_id": "3318d194-5a98-3d7b-8e3c-a66c6754870a",
                    "sense_definition": "posępny, ponury, wyrażający smutek lub niezadowolenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nastrój",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od rana chodził <w>pochmurny</w> i nie odzywał się do nikogo.",
                            "target_lang_translations": {
                                "en": "He had been walking around looking <w>gloomy</w> since morning and did not speak to anyone.",
                                "ru": "С самого утра он ходил <w>хмурым</w> и ни с кем не разговаривал.",
                                "nl": "Hij liep al sinds de ochtend <w>somber</w> rond en sprak met niemand.",
                                "de": "Seit dem Morgen lief er <w>mürrisch</w> herum und sprach mit niemandem.",
                                "fr": "Depuis le matin, il marchait l'air <w>sombre</w> et n'adressait la parole à personne.",
                                "it": "Fin dal mattino andava in giro <w>imbronciato</w> e non parlava con nessuno.",
                                "cs": "Od rána chodil <w>pochmurný</w> a s nikým nemluvil.",
                                "tr": "Sabahtan beri <w>asık suratlı</w> geziyor ve kimseyle konuşmuyordu.",
                                "es": "Desde la mañana andaba <w>sombrío</w> y no le dirigía la palabra a nadie.",
                                "zh": "他从早上起就显得心事重重、神色<w>阴郁</w>，不跟任何人说话。"
                            }
                        },
                        {
                            "text": "Po otrzymaniu złych wiadomości jego twarz stała się bardzo <w>pochmurna</w>.",
                            "target_lang_translations": {
                                "en": "After receiving the bad news, his face became very <w>sullen</w>.",
                                "ru": "После получения плохих новостей его лицо стало очень <w>мрачным</w>.",
                                "nl": "Na het horen van het slechte nieuws werd zijn gezicht heel <w>bedrukt</w>.",
                                "de": "Nachdem er die schlechten Nachrichten erhalten hatte, wurde sein Gesicht sehr <w>finster</w>.",
                                "fr": "Après avoir reçu de mauvaises nouvelles, son visage est devenu très <w>renfrogné</w>.",
                                "it": "Dopo aver ricevuto la cattiva notizia, il suo volto si è fatto molto <w>cupo</w>.",
                                "cs": "Po obdržení špatných zpráv jeho tvář velmi <w>zchmurněla</w>.",
                                "tr": "Kötü haberleri aldıktan sonra yüzü son derece <w>asıldı</w>.",
                                "es": "Al recibir las malas noticias, su rostro se volvió muy <w>sombrío</w>.",
                                "zh": "收到坏消息后，他的脸色变得十分<w>阴沉</w>。"
                            }
                        }
