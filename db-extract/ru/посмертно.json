                "senses": [
                    {
                        "sense_id": "1873b2d3-b978-328a-82a2-2b5016f322f6",
                        "entry_id": "d6819041-2d40-3e43-9bed-1ae02123fa56",
                        "glosses": [
                            "после смерти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5036eec3-20e2-4bdc-b943-4c704596a0ce",
                                "sense_id": "1873b2d3-b978-328a-82a2-2b5016f322f6",
                                "text": "Сохранились краткие фрагменты замысла, они опубликованы посмертно."
                            },
                            {
                                "example_id": "023c99d2-7ef9-4a08-8af8-e252155642ac",
                                "sense_id": "1873b2d3-b978-328a-82a2-2b5016f322f6",
                                "text": "Все они посмертно реабилитированы, и честь их полностью восстановлена."
                            },
                            {
                                "example_id": "b060d70c-f3a4-4016-b313-ac1d3570da9e",
                                "sense_id": "1873b2d3-b978-328a-82a2-2b5016f322f6",
                                "text": "Ему посмертно присвоено звание Героя Советского Союза."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f348076-2396-49a3-a780-24a2e4f8a848",
                        "source_entry_id": "d6819041-2d40-3e43-9bed-1ae02123fa56",
                        "source_sense_id": "1873b2d3-b978-328a-82a2-2b5016f322f6",
                        "target_lang_word": "posthumously",
