                {
                    "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                    "sense_definition": "Wanting to do something very much; eagerly or earnestly desirous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>anxious</w> to please, so you can count on him.",
                            "target_lang_translations": {
                                "ru": "Он очень <w>старается</w> угодить, так что вы можете на него рассчитывать.",
                                "nl": "Hij <w>staat te popelen</w> om te behagen, dus je kunt op hem rekenen.",
                                "pl": "Bardzo <w>stara się</w> przypodobać, więc możesz na nim polegać.",
                                "de": "Er ist sehr <w>bestrebt</w>, es allen recht zu machen, daher kannst du dich auf ihn verlassen."
                            }
                        },
                        {
                            "text": "The team was <w>anxious</w> to start the project as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Команда <w>горела желанием</w> начать проект как можно скорее.",
                                "nl": "Het team <w>brandde van verlangen</w> om zo snel mogelijk met het project te beginnen.",
                                "pl": "Zespół <w>palił się</w> do rozpoczęcia projektu tak szybko, jak to możliwe.",
                                "de": "Das Team war <w>begierig</w> darauf, das Projekt so schnell wie möglich zu starten."
                            }
                        }
