                        "glosses": [
                            "Supreme, utmost bliss and happiness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "26dd0c01-4418-41d0-bbda-f3aaf3afa3a6",
                                "sense_id": "ed96f072-642c-3eed-9470-312d446a9d83",
                                "text": "Here is Gregson coming down the road with beatitude written upon every feature of his face."
                            }
                        ]
                    },
                    {
                        "sense_id": "867150e0-c08d-35de-806a-967f879ef6a2",
                        "entry_id": "6a84b062-9550-36c3-af5b-c9622d7b9f02",
                        "glosses": [
                            "Any of the Biblical blessings given by Jesus in Matthew 5:3–12. E.g.: \\\"Blessed are the meek for they shall inherit the earth\\\" (Matthew 5:5)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fb57c08-38fd-43ee-975d-acc84254f0b8",
                        "source_entry_id": "6a84b062-9550-36c3-af5b-c9622d7b9f02",
                        "source_sense_description": "supreme, utmost bliss and happiness",
                        "target_lang_word": "gelukzaligheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelukzaligheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c5eb7e71-3310-32c7-9af2-d875b665cad2",
                                        "entry_id": "2ec8b7a5-41de-3257-9303-5a0160329926",
                                        "glosses": [
                                            "het heel blij en tevreden zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cc4b2a-9daf-45f0-a6a2-d0d42156a2b1",
                                                "sense_id": "c5eb7e71-3310-32c7-9af2-d875b665cad2",
                                                "text": "Ze kon alleen nog op haar zij liggen en elke avond voor hij in slaap viel kroop Reid tegen haar aan en legde hij zijn hand koesterend op haar buik. Zijn gelukzaligheid was haast onverdraaglijk."
                                            },
                                            {
                                                "example_id": "f170a820-37d8-4ac8-9d5e-6420c1c6d78a",
                                                "sense_id": "c5eb7e71-3310-32c7-9af2-d875b665cad2",
                                                "text": "De gelukzaligheid die van het gezicht van het Schotse jongetje afstraalde, zou Samaras ook graag op het gelaat van de Griekse supporters willen toveren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0596afb7-bc92-320d-8a4d-d79e391a5fce",
                                        "entry_id": "2ec8b7a5-41de-3257-9303-5a0160329926",
                                        "glosses": [
                                            "iets waarvan je heel gelukkig wordt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "760ee290-56b2-414f-bab3-5ddf96b93a84",
                        "source_entry_id": "6a84b062-9550-36c3-af5b-c9622d7b9f02",
                        "source_sense_description": "supreme, utmost bliss and happiness",
                        "target_lang_word": "béatitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béatitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                                        "glosses": [
                                            "Félicité dont les élus jouissent au paradis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e77094-eb5b-43c2-ac37-2c19a8a459bd",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "Ceux-là ne navigueront plus sur les mers mauvaises parce qu’ils ont trouvé le port et que l’ancre a été jetée dans l’incomparable béatitude."
                                            },
                                            {
                                                "example_id": "7cf1e5dc-8d5b-4b8e-aee1-6efdf4d192ac",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "J’ai commencé dès ma douzième année à me faire une certaine idée que Donzac, l’année dernière et cette année, m’a rendue claire, c’est qu’à leur insu, les chrétiens qui nous ont élevés prennent en tout le contrepied de l’Évangile, et que de chaque béatitude du Sermon sur la Montagne, ils ont fait une malédiction : qu’ils ne sont pas doux, qu’ils ne sont pas seulement injustes mais qu’ils exècrent la justice."
                                            },
                                            {
                                                "example_id": "bd48a833-516d-47a9-9165-8d60edf67c90",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "La vraie béatitude consiste dans la vue de Dieu. — Les huit béatitudes, les huit sortes de félicités dont l’évangile fait l’énumération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                                        "glosses": [
                                            "Bonheur parfait, satisfaction tranquille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c79dab-4b80-47e0-b64c-cf23ba4055a1",
                                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                                "text": "Un grand chat noir, frileusement roulé en boule, rêvait dans la lueur rouge du feu, avec un tout petit ronron de béatitude."
                                            },
                                            {
                                                "example_id": "754abccf-eefc-4198-92ea-cb7a64bfc0fb",
                                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                                "text": "Je sens mes intestins qui ronronnent légèrement. La digestion sans heurts est le plus grand facteur d'activité. Le cerveau s'emplit avec le ventre et l'optimisme a sa source dans la béatitude des tripes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43228319-8d37-4865-9445-98a6f3cf2d4c",
                        "source_entry_id": "6a84b062-9550-36c3-af5b-c9622d7b9f02",
                        "source_sense_description": "supreme, utmost bliss and happiness",
                        "target_lang_word": "Glückseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glückseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                        "entry_id": "bfd3c04d-d15c-39d4-b259-68b51f84a1b0",
                                        "glosses": [
                                            "Gefühl ungetrübten Glücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1b09716-0212-4480-9f97-d932473c72a5",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Ich möchte darauf verzichten, die Glückseligkeit zu beschreiben, die unser Wiederzusammenfinden in uns auslöste.“"
                                            },
                                            {
                                                "example_id": "6aaa8412-358f-40d2-86c3-d8c1c7dbcba2",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Er fragte sich, warum man sich damals nicht dieser Glückseligkeit bewusst gewesen war.“"
                                            },
                                            {
                                                "example_id": "51a2c536-544d-4d88-82a7-2f72b7c1db1a",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Und diese Freiheit wurde zur Glückseligkeit, wenn sie aufging in jener Bindung, die alles Irdische übersteigt.“"
                                            },
                                            {
                                                "example_id": "24e3b885-2e9a-417f-b2db-29f238787f7d",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Nach dem Jahre 1807 lernte Nikolai Rostow diese Glückseligkeit in ihrem ganzen Umfange kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
