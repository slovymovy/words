                    {
                        "translation_id": "52a2ca16-7a34-4445-acc1-cd9eb509db63",
                        "source_entry_id": "d52897ee-1f2e-359f-9a15-bfe9bc4238ca",
                        "source_sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
