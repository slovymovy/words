        "fr-extract.jsonl": [
            {
                "entry_id": "7da4ea77-f6d7-35ad-b582-60536d607519",
                "word": "thunk",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05f975a1-f261-3876-9e35-5ccd363b9a4b",
                        "entry_id": "7da4ea77-f6d7-35ad-b582-60536d607519",
                        "glosses": [
                            "Onomatopée représentant le bruit sourd de l’impact d’un objet lourd s’arrêtant contre un autre, sans qu’il y ait de bris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e48e0d1a-499a-4c79-8f39-03b7fe34b47f",
                                "sense_id": "05f975a1-f261-3876-9e35-5ccd363b9a4b",
                                "text": "Thunk—Thunk. “Stop!” James yelled, sloshing to a rigid stance. He slowly put a finger to his lips and whispered, “Shhhhhhh.” Thunk-Thunk… Thunk-Thunk… “Do you hear that?” he said. “What is it?” Randy whimpered. Thunk-Thunk."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8c053d99-1e68-3ee7-bba7-a6a501a9c47b",
                "word": "thunk",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6a4cf6a7-4d20-42af-a040-49b52cac90e8",
                        "entry_id": "8c053d99-1e68-3ee7-bba7-a6a501a9c47b",
                        "tags": [
                            "plural"
                        ],
                        "form": "thunks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3c027d5-add0-34ba-8025-840c138e1f3d",
                        "entry_id": "8c053d99-1e68-3ee7-bba7-a6a501a9c47b",
                        "glosses": [
                            "En programmation fonctionnelle, une évaluation d’expression retardée jusqu’à ce que le besoin immédiat de son résultat survienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf4e014-1761-44fc-b14f-bc6d9e46394f",
                                "sense_id": "b3c027d5-add0-34ba-8025-840c138e1f3d",
                                "text": "When the evaluation of a thunk begins, the descriptor of the thunk is immediately overwritten with a black hole descriptor."
                            }
                        ]
                    },
                    {
                        "sense_id": "869ad8fa-92dd-3ef2-bce9-4345576768e8",
                        "entry_id": "8c053d99-1e68-3ee7-bba7-a6a501a9c47b",
                        "glosses": [
                            "Dans le langage de programmation Scheme, une fonction ou procédure sans arguments."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7bbd0c7f-0fa1-31cf-85e2-98d3fdb6dacc",
                        "entry_id": "8c053d99-1e68-3ee7-bba7-a6a501a9c47b",
                        "glosses": [
                            "Translation (mappage, mise en correspondance) de données d’un type à un autre, souvent pour des raisons de compatibilité, comme par exemple entre adresses 32-bits et 64-bits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a50b08-2f47-4f4d-8aed-403c0f177229",
                                "sense_id": "7bbd0c7f-0fa1-31cf-85e2-98d3fdb6dacc",
                                "text": "If the provider of these DLLs has not updated the code to a 32-bit environment, you will have to switch to a new 32-bit library or write thunks between your 32-bit code and the 16-bit DLL."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f82c078a-e8fb-3bbf-a4a0-df29ad5c3167",
                "word": "thunk",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "58362d94-3faf-36d4-af69-8eccd4199237",
                        "entry_id": "f82c078a-e8fb-3bbf-a4a0-df29ad5c3167",
                        "glosses": [
                            "Participe passé de to think."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6cf3478d-2f17-445b-a323-e6ceb73491a9",
                                "sense_id": "58362d94-3faf-36d4-af69-8eccd4199237",
                                "text": "I could not thunk at all. No sight! No sounds! All black— black— black; all silent as the grave."
                            },
                            {
                                "example_id": "9baf5092-e9ee-49be-98e2-2e82883da4a6",
                                "sense_id": "58362d94-3faf-36d4-af69-8eccd4199237",
                                "text": "Why hast thou thunk\nThat municipal ownership of public utilities,\nWith its great political and other facilities,\nIs bunk?\nWhy hast thou thunk\nThat municipal ownership of public utilities,\nWith its grasping and grafting capabilities,\n[…]"
                            },
                            {
                                "example_id": "aaed229c-2ef2-4e18-85de-8faf3d3d6f49",
                                "sense_id": "58362d94-3faf-36d4-af69-8eccd4199237",
                                "text": "FASHION: WHO’D HAVE THUNK THERE’S A FUR CALLED SLUNK?"
                            },
                            {
                                "example_id": "db482342-6ffe-4a9c-8886-2aa56e723f8c",
                                "sense_id": "58362d94-3faf-36d4-af69-8eccd4199237",
                                "text": "Who would have thunk those guys would have a problem with a little lie?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
