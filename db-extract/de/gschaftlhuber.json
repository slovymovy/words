                        ],
                        "examples": [
                            {
                                "example_id": "5455e5a0-2b5e-4840-bb3a-8ad60666b4e4",
                                "sense_id": "b98b7cc8-7f81-3138-ada1-7fdb464d3dc7",
                                "text": "Der Kollege hat gar nicht so viel Arbeit, wie es immer den Anschein hat, er ist einfach ein richtiger Gschaftlhuber."
                            },
                            {
                                "example_id": "bb89361a-9b11-4d70-8a7f-f6dec2643570",
                                "sense_id": "b98b7cc8-7f81-3138-ada1-7fdb464d3dc7",
                                "text": "„Beinahe hätten wir uns schon an den Gschaftlhuber im Cord-Sakko gewöhnt.“"
                            }
                        ],
