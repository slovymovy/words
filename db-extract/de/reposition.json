                        "glosses": [
                            "Zurückbringen von Knochen, Gelenken, Eingeweiden und Ähnliches in die ursprüngliche Stellung oder Lage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c77fa0-5641-432f-ae8f-ddf91cedaec1",
                                "sense_id": "44b2500e-ed74-3e62-a2c8-1d2208e500d9",
                                "text": "Repositionen sind dann erforderlich, wenn Knochen oder Organe sich nicht mehr in ihrer natürlichen Lage befinden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
