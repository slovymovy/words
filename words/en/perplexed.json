                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden change in attitude greatly <w>perplexed</w> all of his closest friends.",
                            "target_lang_translations": {
                                "de": "Sein plötzlicher Sinneswandel <w>verblüffte</w> all seine engsten Freunde zutiefst."
