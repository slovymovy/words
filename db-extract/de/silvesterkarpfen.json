                "senses": [
                    {
                        "sense_id": "fffe1297-ca87-3fb7-868b-be2c7bcf158e",
                        "entry_id": "ea506a94-16de-3af9-9ad3-c65576611e9b",
                        "glosses": [
                            "traditionelles Silvestergericht, das Reichtum und Glück im Neuen Jahr bescheren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b76a61c7-82dd-4c0c-82b3-fa45c85888da",
                                "sense_id": "fffe1297-ca87-3fb7-868b-be2c7bcf158e",
                                "text": "„Vom traditionellen Silvesterkarpfen wurde eine Schuppe ins Portemonnaie gelegt, damit die Finanzen immer stimmen.“"
                            },
                            {
                                "example_id": "5b5f861b-5cf9-497b-b839-02f0d8106f3b",
                                "sense_id": "fffe1297-ca87-3fb7-868b-be2c7bcf158e",
                                "text": "„Einen ähnlichen Hintergrund hat der Glaube, einen Karpfenstein des Silvesterkarpfen in die Geldbörse gelegt bewirke, damit dann auch ganzjährig Geld zur Verfügung zu haben.“"
                            },
                            {
                                "example_id": "1d09b86a-5f27-4c02-8044-75c889b6c73c",
                                "sense_id": "fffe1297-ca87-3fb7-868b-be2c7bcf158e",
                                "text": "„Selbst bei uns gibt es zum Teil noch besondere Eßgewohnheiten, zum Beispiel den Osterlammbraten, die Weihnachtsgans oder den Silvesterkarpfen, denen die Speisenfolgen angepaßt sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
