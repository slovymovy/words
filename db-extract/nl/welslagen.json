        "nl-extract.jsonl": [
            {
                "entry_id": "d6587eec-e474-317e-93b2-9d50ea443636",
                "word": "welslagen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ead2fecd-0ec2-3f0a-9ae8-822f3f356461",
                        "entry_id": "d6587eec-e474-317e-93b2-9d50ea443636",
                        "glosses": [
                            "met een goede afloop, met een goede uitslag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd0ae98-b5a6-4699-a5a9-ce093f485743",
                                "sense_id": "ead2fecd-0ec2-3f0a-9ae8-822f3f356461",
                                "text": "Binnen de gevechtsleer is het bedenken van een juiste strategie met bijbehorende tactiek allesbepalend voor het welslagen van een missie."
                            },
                            {
                                "example_id": "224d74a9-6a3a-4849-ae85-2e2814c3770b",
                                "sense_id": "ead2fecd-0ec2-3f0a-9ae8-822f3f356461",
                                "text": "Volgens wethouder Adriaan Visser (D66) klopt het dat het welslagen van Feyenoord City afhangt van de successen van de club. \"Je kunt ook drie keer degraderen, we moeten realistisch zijn. Als het slecht gaat met de club, gaan de bezoekersaantallen aan het gebied ook omlaag.\" Daarom is volgens hem ook een scenario voor tegenvallende resultaten gemaakt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78bce5d2-0cc3-4351-a9a7-2db4e1964269",
                        "source_entry_id": "d6587eec-e474-317e-93b2-9d50ea443636",
                        "source_sense_id": "ead2fecd-0ec2-3f0a-9ae8-822f3f356461",
                        "target_lang_word": "succes",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf04cf63-83db-489b-aed4-af9264625c9e",
                        "source_entry_id": "d6587eec-e474-317e-93b2-9d50ea443636",
                        "source_sense_id": "ead2fecd-0ec2-3f0a-9ae8-822f3f356461",
                        "target_lang_word": "achievement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achievement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "The act of achieving or performing; a successful performance; accomplishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10afc28b-de83-446a-ba88-ef491952d1c8",
                                                "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            },
                                            {
                                                "example_id": "616da912-7e63-4f67-8d57-692b2721e0f1",
                                                "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                                "text": "As to the type of seat preferred, the views were so varied that it was considered wisely that the ideal design was beyond achievement!"
                                            },
                                            {
                                                "example_id": "d10ae649-00be-4a52-844c-f2a5f390097f",
                                                "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7891bc7-be28-30e7-8a3a-46c2a4effa91",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "A great or heroic deed or feat; something accomplished by valor or boldness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38003b6d-3580-4206-8516-561c3845811f",
                                                "sense_id": "d7891bc7-be28-30e7-8a3a-46c2a4effa91",
                                                "text": "[…]the English genius was effecting in science a revolution which will, to the end of time, be reckoned among the highest achievements of the human intellect."
                                            },
                                            {
                                                "example_id": "0104ed78-acc4-4032-9b10-960f107a1f78",
                                                "sense_id": "d7891bc7-be28-30e7-8a3a-46c2a4effa91",
                                                "text": "[The exploits] of the ancient saints ; they do far surpass the most famous achievements of pagan heroes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d81fd037-491c-308d-9029-5bf298da729c",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "An escutcheon or ensign armorial; a full display or depiction of all the heraldic components to which the bearer of a coat of arms is entitled; (now especially) a funeral shield: the hatchment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f1e993-a034-4b2e-94ed-69626751f7d4",
                                                "sense_id": "d81fd037-491c-308d-9029-5bf298da729c",
                                                "text": "The narrow Gothic windows were filled, not with glass that admitted the light, but with glass painted with the achievements of the family […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c07f7f-3ee5-3158-8b6d-583c96ab5b11",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "An award for completing a particular task or meeting an objective in a video game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab2f359-db12-44c5-abfb-66e5aa321a0b",
                                                "sense_id": "e7c07f7f-3ee5-3158-8b6d-583c96ab5b11",
                                                "text": "Finishing the game does not give you a 100% score until you have unlocked all of the achievements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a435614-6056-3fac-967e-2142bd0cb9a8",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "The lexical aspect (aktionsart) of verbs or predicates that change in an instant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2ee612-27a2-4ce5-bfd6-148a4fe3dd4d",
                                                "sense_id": "6a435614-6056-3fac-967e-2142bd0cb9a8",
                                                "text": "[…]distinctions among states of affairs are reflected to a striking degree in distinctions among Aktionsart types. That is, situations are expressed by state verbs or predicates, events by achievement verbs or predicates, and actions by activity verbs or predicates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87942f4c-8d91-32b5-ba59-1df4ab07a172",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "The successful completion of a socially defined goal or task, highlighting individual or group accomplishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
