                                "target_senses": [
                                    {
                                        "sense_id": "c432cce1-b47d-3f3b-a063-e58707d7b6cc",
                                        "entry_id": "73575a39-d71d-3605-a016-9a0968f41df6",
                                        "glosses": [
                                            "Doctrina política de los anarquistas, que promueve la abolición del estado y la instauración de la anarquía."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "741b32c9-0fb1-335d-b122-7ff344deff3c",
                                        "entry_id": "73575a39-d71d-3605-a016-9a0968f41df6",
                                        "glosses": [
                                            "Movimiento político basado en dicha doctrina."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94d58aac-d69c-4631-9a81-8e1d0287db74",
                        "source_entry_id": "f999e00d-62dd-3216-8e9f-bec470c94089",
                        "source_sense_id": "96deccee-ee3b-3935-b481-19e4cb6f4a3d",
                        "target_lang_word": "Anarchismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anarchismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                        "entry_id": "c8d5ca7e-3aed-37bc-a3cc-c11d29d44989",
                                        "glosses": [
                                            "Anschauung, die jede Herrschaft über Menschen ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf1840d-5622-4e6d-b7ae-b5a0fbdf4412",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "\"Sie berührt, in einem kaum verhohlenen Anarchismus, den Muttergrund der Dinge, die Welt des ewigen Wahns; jene proteische Welt, in der sich jederzeit alles in alles verwandeln kann.\""
                                            },
                                            {
                                                "example_id": "1033aabd-a6d4-4b88-9e5d-89ef6674c9d8",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "Der Anarchismus geht vom Grundsatz aus, dass niemand das Recht habe, Menschen zu regieren."
                                            },
                                            {
                                                "example_id": "922eb11b-c4f1-43f1-b1ee-7569106b7466",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "Anarchismus steht in einer Konfrontation zum Konservativismus wegen seines Hanges zu Neuerungen; mit dem Liberalismus weil man die Ausbeutung nicht annehmen kann und mit dem Sozialismus, weil der Staat nicht anerkannt wird."
                                            },
                                            {
                                                "example_id": "0668d7e3-075d-4225-b44b-fc64965194db",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "„Anarchismus war nur eine logische Reaktion darauf.“"
                                            },
                                            {
                                                "example_id": "452ce104-e677-4c57-8a10-25c7327e26ac",
                                                "sense_id": "91f66367-6903-3ea2-af91-a3775874fe9a",
                                                "text": "„Während der Haft schrieb Mühsam einen Großteil seines literarischen und politischen Werkes, dessen Anarchismus noch heute mit Terrorismus gleichgesetzt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e87c895-20a8-424b-a2f7-2418450420ed",
                        "source_entry_id": "f999e00d-62dd-3216-8e9f-bec470c94089",
