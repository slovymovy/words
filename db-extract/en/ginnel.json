                "senses": [
                    {
                        "sense_id": "65848a28-8b8e-3b90-96a0-b859f1094b6e",
                        "entry_id": "360ac34c-c694-3454-aa7f-f60420eae91f",
                        "glosses": [
                            "A narrow passageway or alley often between terraced houses."
                        ],
                        "tags": [
                            "England",
                            "Yorkshire",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "93255fb7-0c9e-4cc4-8daa-69d0eac1480d",
                                "sense_id": "65848a28-8b8e-3b90-96a0-b859f1094b6e",
                                "text": "[…]maks things as pleasant as stondin in a ginnel ov a wyndy neet waitin o'th' sweetheart comin out."
                            },
                            {
                                "example_id": "a35e1d1a-b44b-4d02-a882-9da0d0c70e35",
                                "sense_id": "65848a28-8b8e-3b90-96a0-b859f1094b6e",
                                "text": "At the end of a short side-street a narrow ginnel with concrete bollards led into the surprisingly wide area in which the blocks of flats stood."
                            },
                            {
                                "example_id": "8cb05612-d7d3-4477-aa1a-9239b9bc98e6",
                                "sense_id": "65848a28-8b8e-3b90-96a0-b859f1094b6e",
                                "text": "Pssht, get over here, whoopie / Finish him like Sub-Zero / Out the window, into the garden / Over the fence and straight through the ginnel"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a48b0461-0282-434d-a924-95066852cf3b",
                        "source_entry_id": "360ac34c-c694-3454-aa7f-f60420eae91f",
                        "source_sense_id": "65848a28-8b8e-3b90-96a0-b859f1094b6e",
                        "source_sense_description": "narrow passageway",
                        "target_lang_word": "venelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "venelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ad3afa-3bf0-347f-a8aa-2efaeb836926",
                                        "entry_id": "a6f9fac0-bbf9-3a4b-bced-268b26f990df",
                                        "glosses": [
                                            "Ruelle étroite, entre des murs ou des haies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb7cc4a-f7d1-4b81-8985-bf2fff1b8179",
                                                "sense_id": "c8ad3afa-3bf0-347f-a8aa-2efaeb836926",
                                                "text": "Le chien avait enfilé une venelle, devant les pertuisanes du guet enrouillé par la pluie et morfondu par la bise."
                                            },
                                            {
                                                "example_id": "e966c252-9958-49b1-956f-5ec5afcaaff9",
                                                "sense_id": "c8ad3afa-3bf0-347f-a8aa-2efaeb836926",
                                                "text": "À la fin, après une suprême hésitation, il s'enfonça dans une venelle étroite, absolument privée de lumière."
                                            },
                                            {
                                                "example_id": "6e23e151-900e-45b5-99f8-516f8b5f2602",
                                                "sense_id": "c8ad3afa-3bf0-347f-a8aa-2efaeb836926",
                                                "text": "À Talmont même, …, c’est à travers les venelles qu’il faut flâner et chercher parmi les milliers de roses trémières roses… celles, très rares, qui sont rouges ou ivoire."
                                            },
                                            {
                                                "example_id": "dd323158-54fa-46b2-90f0-07477bcd61fd",
                                                "sense_id": "c8ad3afa-3bf0-347f-a8aa-2efaeb836926",
                                                "text": "Melchior attendit qu'ils disparaissent pour sortir de la Rover, repéra les lieux, la vieille ville, quelques venelles et passages à peine larges pour que deux hommes s'y croisent, des ruelles désertes, idéales pour un guet-apens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b717ffe-1ded-416e-9a0c-b5372657206d",
                        "source_entry_id": "360ac34c-c694-3454-aa7f-f60420eae91f",
                        "source_sense_id": "65848a28-8b8e-3b90-96a0-b859f1094b6e",
                        "source_sense_description": "narrow passageway",
                        "target_lang_word": "Gasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ac430d7-f4c9-3e17-9f71-3e8cbc2f3e2e",
                                        "entry_id": "a5d92289-09e6-3595-8460-6058a4fb778e",
                                        "glosses": [
                                            "enge Straße, schmaler Weg zwischen Zäunen oder Mauern"
                                        ],
                                        "tags": [
                                            "Verkehr",
                                            "Infrastruktur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36aabf6-f853-4ca7-8cc1-39ba62554edf",
                                                "sense_id": "2ac430d7-f4c9-3e17-9f71-3e8cbc2f3e2e",
                                                "text": "Einsam geh ich durch die Gassen."
                                            },
                                            {
                                                "example_id": "0bc1989f-471c-4eb9-b210-621b8ae891fc",
                                                "sense_id": "2ac430d7-f4c9-3e17-9f71-3e8cbc2f3e2e",
                                                "text": "„Unterwegs durch die Gassen Krakaus fiel mir auf, was ich noch alles hätte erwähnen können.“"
                                            },
                                            {
                                                "example_id": "7f22d2fb-2104-4dbb-b81e-931eee96304c",
                                                "sense_id": "2ac430d7-f4c9-3e17-9f71-3e8cbc2f3e2e",
                                                "text": "Marie Lechner, die nach kurzem Aufstieg und raschem Niedergang den Weg zurück in die freudlose Gasse gefunden hatte, lebte noch immer siech und elend bei ihrer Mutter, der Wäscherin, und ihrem Vater, dem ewig betrunkenen Invaliden."
                                            },
                                            {
                                                "example_id": "21db3662-6556-4e40-ac0f-c981d71189d3",
                                                "sense_id": "2ac430d7-f4c9-3e17-9f71-3e8cbc2f3e2e",
                                                "text": "„Durch diese hohle Gasse muss er kommen, Es führt kein andrer Weg nach Küssnacht.“"
                                            },
                                            {
                                                "example_id": "2a1c559a-229e-4ba9-9057-e68419a3aa10",
                                                "sense_id": "2ac430d7-f4c9-3e17-9f71-3e8cbc2f3e2e",
                                                "text": "„Die engen Gassen werden jetzt dunkel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8afd70ad-eec6-3384-a3f3-4f46e97df246",
                                        "entry_id": "a5d92289-09e6-3595-8460-6058a4fb778e",
                                        "glosses": [
                                            "(Quer-)Straße"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b4c57d-b24b-46c7-8032-c7a32c6c5a8a",
                                                "sense_id": "8afd70ad-eec6-3384-a3f3-4f46e97df246",
                                                "text": "„Die rund 400 Ausnahmeschilder, die bisher auf Ausfallrouten wie Triester Straße und Hadikgasse Tempo 60 beziehungsweise 70 erlaubt haben, sind weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "68a36291-0817-3015-a3a4-a930d2f8c26d",
