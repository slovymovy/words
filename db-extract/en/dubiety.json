                                "example_id": "25ef00b0-7bd1-451c-9ff1-9a3de259c978",
                                "sense_id": "575275d9-0993-361a-ae81-fc274e973625",
                                "text": "Sterling's dubieties as to continuing at Bordeaux were quickly decided."
                            }
                        ]
