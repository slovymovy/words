                ],
                "senses": [
                    {
                        "sense_id": "fd59e47f-b9db-3c08-b8ce-c7d6963fc1df",
                        "entry_id": "862fcdab-8350-3535-80c5-f1e195e855b7",
                        "glosses": [
                            "auf das Volk der Chanten bezogen, von ihm stammend, zu ihm gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58873520-254f-4f33-83ba-848ea6913917",
                                "sense_id": "fd59e47f-b9db-3c08-b8ce-c7d6963fc1df",
                                "text": "Ab 1940 wurde der chantischen Literatursprache ein Dialekt zugrunde gelegt, der am Mittellauf des Ob gesprochen wird."
                            },
                            {
                                "example_id": "58f2bd30-2867-4864-8dd1-90b0052a10e2",
                                "sense_id": "fd59e47f-b9db-3c08-b8ce-c7d6963fc1df",
                                "text": "Gegenwärtig stützt sich das Schrifttum auf fünf Dialekte der chantischen Sprache."
                            },
                            {
                                "example_id": "ca7e3b72-a8fc-4765-b286-07c5dd9dc864",
                                "sense_id": "fd59e47f-b9db-3c08-b8ce-c7d6963fc1df",
                                "text": "In kleineren Dörfern, in ethnischen Enklaven innerhalb größerer Siedlungen sowie auf den Wohnplätzen der in der Taiga lebenden Halbnomaden stellen die chantischen Dialekte bis heute ein wichtiges und teilweise das Hauptkommunikationsmittel dar."
                            },
                            {
                                "example_id": "9ae3c3a9-8f4f-435d-aadd-e3cb5fd8b276",
                                "sense_id": "fd59e47f-b9db-3c08-b8ce-c7d6963fc1df",
                                "text": "Wella schrieb in russischer, chantischer und waldnenzischer Sprache."
                            },
                            {
                                "example_id": "1966e5dd-98fc-4827-bcd6-bb2dcc216bc8",
                                "sense_id": "fd59e47f-b9db-3c08-b8ce-c7d6963fc1df",
                                "text": "Laiki vom chantischen Typ sind gedrungener, infolge der kürzeren Beine wirken sie aber lang gestreckter als der südliche Typ."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
