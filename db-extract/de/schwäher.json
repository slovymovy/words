                "senses": [
                    {
                        "sense_id": "52e8df16-8099-380d-9bf6-53f38cdc1eb9",
                        "entry_id": "48fd19f5-f264-33f6-84ea-80050a6e11a1",
                        "glosses": [
                            "Vater der Ehefrau, Schwiegervater"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "443b5b02-f6e1-47dc-a5f0-a3562a23146b",
                                "sense_id": "52e8df16-8099-380d-9bf6-53f38cdc1eb9",
                                "text": "„Und Jitro, der Priester Midjans, der Schwäher Mosches hörte alles, was Gott getan an Mosche und an Israel, seinem Volke, daß der Ewige Israel herausgeführt aus Mizrajim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4de52773-c936-3ffd-8f95-c78807fd95f1",
                        "entry_id": "48fd19f5-f264-33f6-84ea-80050a6e11a1",
                        "glosses": [
                            "Ehemann von einem Geschwister des Ehepartners"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1b0bc279-4c00-4160-8a37-c972eff1ccdd",
                                "sense_id": "4de52773-c936-3ffd-8f95-c78807fd95f1",
                                "text": "„Und Jitro, der Priester Midjans, der Schwäher Mosches hörte alles, was Gott getan an Mosche und an Israel, seinem Volke, daß der Ewige Israel herausgeführt aus Mizrajim.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
