                                "target_senses": [
                                    {
                                        "sense_id": "ba7b0b30-de4f-31bd-a1e2-4c2f6fa52a7f",
                                        "entry_id": "ce0569aa-73a9-32d2-b4f5-fa70b62edf5e",
                                        "glosses": [
                                            "rechter Zufluss zur Donau in Südostösterreich und Westungarn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e184b564-6542-48f8-a38e-c0e7d45072b4",
                                                "sense_id": "ba7b0b30-de4f-31bd-a1e2-4c2f6fa52a7f",
                                                "text": "„So räumten die Awaren kampflos ihre Stellungen auf der Höhe des Wiener Waldes, und die fränkischen Heere drangen ungehindert bis an die Raab vor.“"
                                            },
                                            {
                                                "example_id": "67ea3267-6b04-41f0-bfe5-93c919972c73",
                                                "sense_id": "ba7b0b30-de4f-31bd-a1e2-4c2f6fa52a7f",
                                                "text": "Wir überquerten die Raab."
                                            },
                                            {
                                                "example_id": "22462880-6866-4cee-b281-76e0be96a558",
                                                "sense_id": "ba7b0b30-de4f-31bd-a1e2-4c2f6fa52a7f",
                                                "text": "Die Kinder versuchten, in der Raab zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Raab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c9ade79-5510-3bbb-81e4-8e2db8c46ab9",
                                        "entry_id": "1292ed69-76c7-3a85-b96e-1309d6db92df",
                                        "glosses": [
                                            "Raab (Oberösterreich), Marktgemeinde in Oberösterreich, Österreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48ad20d-da10-4a05-9ab2-01e8436bc810",
                                                "sense_id": "5c9ade79-5510-3bbb-81e4-8e2db8c46ab9",
                                                "text": "Ich bin in Raab geboren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d79bd1aa-e108-36dc-802e-93b28d3f6f13",
                                        "entry_id": "1292ed69-76c7-3a85-b96e-1309d6db92df",
                                        "glosses": [
                                            "Raab (Gemeinde Passail), Ortschaft bei Hohenau an der Raab, Steiermark, A"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca54439e-978c-4b0f-94bd-2a6c560a9784",
                                                "sense_id": "d79bd1aa-e108-36dc-802e-93b28d3f6f13",
                                                "text": "Ich habe in Raab meinen Urlaub verbracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f402a942-3307-32d4-a094-e8fe71cb74f6",
                                        "entry_id": "1292ed69-76c7-3a85-b96e-1309d6db92df",
                                        "glosses": [
                                            "deutsche Bezeichnung der Stadt Győr an der Mündung des Flusses Raab (Rába) in Ungarn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db75edad-c163-4785-b79c-1b7ab5b092ff",
                                                "sense_id": "f402a942-3307-32d4-a094-e8fe71cb74f6",
                                                "text": "Nach Raab führen viele Wege."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Raab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                        "entry_id": "39a31a07-3752-356c-82dd-4a2c63592322",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d48eb5a-cf54-487d-b9ce-8fc238932f75",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Frau Raab ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "719efb41-ce51-4b15-aacd-cb553b512e6a",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Herr Raab wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "3b4c2e57-9a7e-48ac-90c6-1d8e96068f7d",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Die Raabs fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "ee266d8a-aa36-4d2b-a08d-bb15f0b318ad",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Der Raab trägt nie die Pullover, die die Raab ihm strickt."
                                            },
                                            {
                                                "example_id": "c1694966-0c4e-4cf6-918c-4e170ab12c3b",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Raab kommt, geht der Herr Raab.“"
                                            },
                                            {
                                                "example_id": "74837164-ee04-4a07-99c6-3f25061ec29b",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Raab kommt und geht."
                                            },
                                            {
                                                "example_id": "21a39192-188d-4ee6-b30d-dd1d48bfd5eb",
                                                "sense_id": "415f7cb8-9ac0-3276-9f53-349f4ec93a89",
                                                "text": "Raabs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
