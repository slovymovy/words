{
    "word_family": [
        "easterly",
        "eastern",
        "eastward",
        "eastertide"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d76dc09-1627-3513-b3bf-feeae6c6c7d8",
                    "sense_definition": "A Christian festival and holiday commemorating the resurrection of Jesus from the dead.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were excited to hunt for chocolate eggs on <w>Easter</w> morning.",
                            "target_lang_translations": {
                                "ru": "Дети с восторгом искали шоколадные яйца утром на <w>Пасху</w>."
                            }
                        },
                        {
                            "text": "Many families gather for a large traditional lunch to celebrate <w>Easter</w> together.",
                            "target_lang_translations": {
                                "ru": "Многие семьи собираются за большим традиционным обедом, чтобы вместе отпраздновать <w>Пасху</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Easter Day",
                        "Easter Sunday"
                    ],
                    "common_phrases": [
                        "Easter Sunday",
                        "Easter egg",
                        "Easter bunny",
                        "Easter weekend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Христианский праздник, посвященный воскресению Иисуса Христа из мертвых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пасха",
                                "target_lang_sense_clarification": "христианский праздник"
                            },
                            {
                                "target_lang_word": "Воскресение Христово",
                                "target_lang_sense_clarification": "торжественное название праздника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc043bea-d606-30a4-8b7b-c532ecb2d5c5",
                    "sense_definition": "The period of time or season associated with the Easter holiday.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school will be closed for two weeks during the <w>Easter</w> break.",
                            "target_lang_translations": {
                                "ru": "Школа будет закрыта на две недели во время <w>пасхальных</w> каникул."
                            }
                        },
                        {
                            "text": "We are planning a short trip to the mountains over <w>Easter</w> this year.",
                            "target_lang_translations": {
                                "ru": "В этом году на <w>Пасху</w> мы планируем небольшую поездку в горы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Easter break",
                        "Easter holidays",
                        "Easter season"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени или сезон, связанный с пасхальными праздниками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пасха",
                                "target_lang_sense_clarification": "период праздника"
                            },
                            {
                                "target_lang_word": "пасхальные каникулы",
                                "target_lang_sense_clarification": "время отдыха"
                            },
                            {
                                "target_lang_word": "Светлая седмица",
                                "target_lang_sense_clarification": "неделя после Пасхи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24ecc441-d915-3e77-b932-4ec1ab15c653",
                    "sense_definition": "A strong wind that blows from the east.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors struggled to keep the boat steady against the fierce <w>easter</w>.",
                            "target_lang_translations": {
                                "ru": "Моряки изо всех сил старались удержать лодку против свирепого <w>оста</w>."
                            }
                        },
                        {
                            "text": "A cold <w>easter</w> began to blow across the coast as the sun went down.",
                            "target_lang_translations": {
                                "ru": "Когда солнце зашло, над побережьем начал дуть холодный <w>восточный ветер</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный ветер, дующий с востока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ост",
                                "target_lang_sense_clarification": "морской термин для восточного ветра"
                            },
                            {
                                "target_lang_word": "восточный ветер",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5afc52ab-df74-3c6d-8fca-7fb1ab244a0c",
                    "sense_definition": "An archaic or dialectal term for the Jewish Passover.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some older translations of the Bible, the word <w>Easter</w> is used for Passover.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых переводах Библии слово <w>Пасха</w> используется для обозначения Песаха."
                            }
                        },
                        {
                            "text": "The text describes the ancient customs observed during the <w>Easter</w> of the Jews.",
                            "target_lang_translations": {
                                "ru": "В тексте описываются древние обычаи, соблюдавшиеся во время иудейской <w>Пасхи</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older religious texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичный или диалектный термин для иудейского праздника Песах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пасха",
                                "target_lang_sense_clarification": "в значении Песах"
                            },
                            {
                                "target_lang_word": "Песах",
                                "target_lang_sense_clarification": "иудейский праздник"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "59997e85-faf9-33ea-a692-76daada1fb1a",
                    "sense_definition": "The comparative form of <w>east</w>, meaning more toward the east.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village is located on the <w>easter</w> side of the mountain range.",
                            "target_lang_translations": {
                                "ru": "Деревня расположена на более <w>восточной</w> стороне горного хребта."
                            }
                        },
                        {
                            "text": "They moved to an <w>easter</w> province to be closer to the coast.",
                            "target_lang_translations": {
                                "ru": "Они переехали в более <w>восточную</w> провинцию, чтобы быть ближе к побережью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная форма слова «east», означающая «расположенный восточнее»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более восточный",
                                "target_lang_sense_clarification": "сравнительная степень"
                            },
                            {
                                "target_lang_word": "восточный",
                                "target_lang_sense_clarification": "направление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2157cf67-afa4-35d9-9540-5cef7278a589",
                    "sense_definition": "Located in or toward the east; eastern.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>easter</w> casement offered a beautiful view of the rising sun.",
                            "target_lang_translations": {
                                "ru": "<w>Восточное</w> окно открывало прекрасный вид на восходящее солнце."
                            }
                        },
                        {
                            "text": "The property was divided into two sections known as <w>Easter</w> and Wester Coull.",
                            "target_lang_translations": {
                                "ru": "Имение было разделено на две части, известные как <w>Восточный</w> и Западный Кулл."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily found in Scottish place names"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный на востоке или по направлению к востоку; восточный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восточный",
                                "target_lang_sense_clarification": "расположение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e2a2a4f-7713-31e8-bdf4-19b6723b7c0c",
                    "sense_definition": "To move or shift toward the east, often used in a nautical context regarding wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind <w>eastered</w> during the night, making the return journey much faster.",
                            "target_lang_translations": {
                                "ru": "Ночью ветер <w>повернул к востоку</w>, что сделало обратный путь намного быстрее."
                            }
                        },
                        {
                            "text": "As the storm passed, the breeze began <w>eastering</w> toward the open sea.",
                            "target_lang_translations": {
                                "ru": "Когда шторм прошел, бриз начал <w>смещаться на восток</w> в сторону открытого моря."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или смещаться к востоку (часто о ветре в морском контексте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворачивать к востоку",
                                "target_lang_sense_clarification": "о ветре"
                            },
                            {
                                "target_lang_word": "смещаться на восток",
                                "target_lang_sense_clarification": "направление движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a876f91e-4302-3bcf-bc5b-d8f8efe36274",
                    "sense_definition": "To celebrate the holiday of Easter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family usually <w>Easters</w> at their countryside cottage every spring.",
                            "target_lang_translations": {
                                "ru": "Семья обычно <w>проводит Пасху</w> в своем загородном коттедже каждую весну."
                            }
                        },
                        {
                            "text": "They decided to <w>Easter</w> in Rome to witness the traditional ceremonies.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>отпраздновать Пасху</w> в Риме, чтобы увидеть традиционные церемонии."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Праздновать Пасху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "праздновать Пасху",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "проводить Пасху",
                                "target_lang_sense_clarification": "о месте празднования"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c8339240-9ec6-34c1-ad92-494bee5618fe",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Easter</w> published a significant study on regional dialects.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Истер</w> опубликовал значимое исследование региональных диалектов."
                            }
                        },
                        {
                            "text": "The local library was named after the philanthropist Mary <w>Easter</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Мэри <w>Истер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Истер",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}