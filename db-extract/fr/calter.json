                            "pronominal"
                        ],
                        "form": "se calter"
                    },
                    {
                        "form_id": "2e02232b-7c4c-4c14-b72d-9a97bd6c6b4e",
                        "entry_id": "9c97b4b6-e634-3d2a-8b80-246484eeaf61",
                        "tags": [],
                        "form": "caleter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                        "entry_id": "9c97b4b6-e634-3d2a-8b80-246484eeaf61",
                        "glosses": [
                            "Partir rapidement, fuir."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6a8eae46-01ff-4fbe-ad1f-05f33b90d070",
                                "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                                "text": "Caltez, volaille !"
                            },
                            {
                                "example_id": "47da24a1-acb4-47e4-b01e-0a6bc3051c53",
                                "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                                "text": "Armandine, mettant son chapeau. — Vous voudriez que nous caltassions.\nLe Gérant. — Oh ! je ne me permettrais pas !\nArmandine. — Je finis de mettre mon chapeau et je cède la place !"
                            },
                            {
                                "example_id": "248bb57a-67ac-4bcb-b404-85a821243df5",
                                "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                                "text": "On m’voit dans le sérieux, moi, et celui qui m’connaît, calte."
                            },
                            {
                                "example_id": "c243ef36-1231-414c-b282-89b9b60b923f",
                                "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                                "text": "Ils ménageaient les femmes et les enfants : « Caltez, les gosses », avait crié Soudy aux gamins, lors du sac de la banque de Chantilly."
                            },
                            {
                                "example_id": "e6c366af-5086-46a8-890d-7e3c66fef1c1",
                                "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                                "text": "Puis il s’en balance encore un dans le gosier et calte."
                            },
                            {
                                "example_id": "1ba28791-939c-4908-94ee-7644d00f2976",
                                "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                                "text": "De toute façon il faut calter et vite, déclare-t-il, fataliste."
                            },
                            {
                                "example_id": "96b90fb7-650e-4979-8fb8-b5dad7785dfd",
                                "sense_id": "02cabc78-e7b7-3352-96d8-9ec7efd373e8",
                                "text": "– Si tu savais comme j’me fou d’ton opinion, Anjou ! Tu prends tes hommes et tu caltes !"
                            }
                        ]
                    },
                    {
                        "sense_id": "0d3334c6-5573-3677-a07d-ea56599b1564",
                        "entry_id": "9c97b4b6-e634-3d2a-8b80-246484eeaf61",
                        "glosses": [
                            "S’enfuir."
                        ],
                        "tags": [
                            "pronominal",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "75ee3837-1383-4d3f-a3ed-e853725e6bc6",
                                "sense_id": "0d3334c6-5573-3677-a07d-ea56599b1564",
                                "text": "Quant à l'auto, elle s'était caltée en vitesse, cela se comprend."
                            },
                            {
                                "example_id": "d62e8ff9-746d-4e7e-8327-b692efccb3b7",
                                "sense_id": "0d3334c6-5573-3677-a07d-ea56599b1564",
                                "text": "La Toulouche résuma la situation : — En somme, c’est un roussin ; derrière les volets, il doit nous zyeuter : si on se calte sur la droite, il nous pincera après le pont ; si on se trotte par la gauche, il nous fiche dans la flotte."
                            }
                        ]
                    }
                ],
