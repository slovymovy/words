                        "form": "велича́вшись"
                    },
                    {
                        "form_id": "79d7db66-f4ef-4246-b969-97370a56e8ff",
                        "entry_id": "20ea187f-afba-3e5b-9523-913d87b055b0",
                        "tags": [
