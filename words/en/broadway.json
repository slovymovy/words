{
    "word_family": [
        "broad",
        "way"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "673299e1-a56f-3daa-aa99-b1babbd176f1",
                    "sense_definition": "The famous wide road that runs diagonally through Manhattan in New York City",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "new-york-broadway",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a long walk down <w>Broadway</w> to see the bright lights of Times Square.",
                            "target_lang_translations": {
                                "ru": "Мы долго гуляли по <w>Бродвею</w>, чтобы увидеть яркие огни Таймс-сквер."
                            }
                        },
                        {
                            "text": "Many famous buildings are located along <w>Broadway</w> in Manhattan.",
                            "target_lang_translations": {
                                "ru": "Многие знаменитые здания расположены вдоль <w>Бродвея</w> на Манхэттене."
                            }
                        }
                    ],
                    "synonyms": [
                        "Great White Way"
                    ],
                    "common_phrases": [
                        "walk down Broadway",
                        "along Broadway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знаменитая широкая улица, проходящая по диагонали через Манхэттен в Нью-Йорке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бродвей",
                                "target_lang_sense_clarification": "название улицы в Нью-Йорке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c9512d5-6c39-3940-92ee-c9004f73b9c8",
                    "sense_definition": "The professional theater industry in New York City, or the district where these theaters are located",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "theater-broadway",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "She has always dreamed of performing in a <w>Broadway</w> musical.",
                            "target_lang_translations": {
                                "ru": "Она всегда мечтала выступить в <w>бродвейском</w> мюзикле."
                            }
                        },
                        {
                            "text": "The new play is a huge hit on <w>Broadway</w> this season.",
                            "target_lang_translations": {
                                "ru": "Новая пьеса — огромный хит на <w>Бродвее</w> в этом сезоне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Broadway musical",
                        "on Broadway",
                        "Broadway show",
                        "Broadway star"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональная театральная индустрия в Нью-Йорке или район, где расположены эти театры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бродвей",
                                "target_lang_sense_clarification": "театральный район или индустрия"
                            },
                            {
                                "target_lang_word": "бродвейский",
                                "target_lang_sense_clarification": "относящийся к театрам Бродвея"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a5f351-dcfb-3955-b858-391303503f11",
                    "sense_definition": "A common name for a wide street or main road in various towns and cities",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "generic-street",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The local shops are mostly situated on the <w>Broadway</w> near the station.",
                            "target_lang_translations": {
                                "ru": "Местные магазины в основном расположены на <w>Бродвее</w> рядом со станцией."
                            }
                        },
                        {
                            "text": "Turn left when you reach the <w>Broadway</w> in the center of town.",
                            "target_lang_translations": {
                                "ru": "Поверните налево, когда дойдете до <w>главной улицы</w> в центре города."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное название широкой улицы или главной дороги в различных городах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бродвей",
                                "target_lang_sense_clarification": "имя собственное для широких улиц"
                            },
                            {
                                "target_lang_word": "главная улица",
                                "target_lang_sense_clarification": "основная дорога города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "673f09b0-59ae-3bd8-8284-a472e8726c54",
                    "sense_definition": "The name of several specific towns or villages, such as those in Worcestershire or Somerset, England",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "settlements",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We spent a lovely weekend visiting the picturesque village of <w>Broadway</w> in the Cotswolds.",
                            "target_lang_translations": {
                                "ru": "Мы провели прекрасные выходные, посетив живописную деревню <w>Бродвей</w> в Котсуолдсе."
                            }
                        },
                        {
                            "text": "The historic houses in <w>Broadway</w> attract many tourists every year.",
                            "target_lang_translations": {
                                "ru": "Исторические дома в <w>Бродвее</w> ежегодно привлекают множество туристов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких конкретных городов или деревень, например, в Вустершире или Сомерсете, Англия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бродвей",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fbe3b87-5420-3a8a-b2a8-ab258e5b961b",
                    "sense_definition": "The provincial government of Manitoba, Canada, named after the street where the Legislative Building is located",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "government",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Local leaders criticized <w>Broadway</w> for not providing enough funding for road repairs.",
                            "target_lang_translations": {
                                "ru": "Местные лидеры раскритиковали <w>Бродвей</w> за недостаточное финансирование ремонта дорог."
                            }
                        },
                        {
                            "text": "The decision made by <w>Broadway</w> will affect all residents of Manitoba.",
                            "target_lang_translations": {
                                "ru": "Решение, принятое <w>Бродвеем</w>, затронет всех жителей Манитобы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Manitoba, Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Провинциальное правительство Манитобы, Канада, названное в честь улицы, на которой расположено здание Законодательного собрания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бродвей",
                                "target_lang_sense_clarification": "правительство Манитобы (метонимия)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6c5457a-76c7-3c2c-b827-4e803ad91ee4",
                    "sense_definition": "A rare family name",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Thomas <w>Broadway</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Томас <w>Бродвей</w>."
                            }
                        },
                        {
                            "text": "There are only a few families with the surname <w>Broadway</w> in this region.",
                            "target_lang_translations": {
                                "ru": "В этом регионе всего несколько семей с фамилией <w>Бродвей</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Редкая фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бродвей",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b04f3627-96b9-3ab7-bff7-bde6dbddc36e",
                    "sense_definition": "In poker, the highest possible straight, consisting of an ace, king, queen, jack, and ten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poker-terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to complete a <w>broadway</w> on the final card to win the pot.",
                            "target_lang_translations": {
                                "ru": "Ему удалось собрать <w>бродвей</w> на последней карте и забрать банк."
                            }
                        },
                        {
                            "text": "Holding an ace and a king gives you a chance to make a <w>broadway</w>.",
                            "target_lang_translations": {
                                "ru": "Наличие туза и короля дает шанс собрать <w>бродвей</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a broadway",
                        "broadway straight"
                    ],
                    "target_lang_definitions": {
                        "ru": "В покере — самый высокий стрит, состоящий из туза, короля, дамы, валета и десятки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродвей",
                                "target_lang_sense_clarification": "старший стрит в покере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7bfd7a4-f118-3072-b07a-0ef03810e76e",
                    "sense_definition": "A wide open path or a public walkway, such as an esplanade",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "walkway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace overlooked the <w>broadway</w> where the townspeople gathered.",
                            "target_lang_translations": {
                                "ru": "Дворец выходил окнами на <w>променад</w>, где собирались горожане."
                            }
                        },
                        {
                            "text": "They walked along the <w>broadway</w> of the main street to reach the harbor.",
                            "target_lang_translations": {
                                "ru": "Они шли по <w>широкой дороге</w> главной улицы, чтобы добраться до гавани."
                            }
                        }
                    ],
                    "synonyms": [
                        "Great White Way"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкая открытая дорожка или общественная прогулочная зона, например, эспланада"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "променад",
                                "target_lang_sense_clarification": "широкая прогулочная дорога"
                            },
                            {
                                "target_lang_word": "широкая дорога",
                                "target_lang_sense_clarification": "буквальное значение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f920a04d-6dd6-30c0-94f3-bf986dd773cb",
                    "sense_definition": "Describing something that is flashy, showy, or characteristic of the theatrical style of New York's theater district",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His new wardrobe is a bit too <w>Broadway</w> for a quiet office job.",
                            "target_lang_translations": {
                                "ru": "Его новый гардероб слишком <w>бродвейский</w> для спокойной работы в офисе."
                            }
                        },
                        {
                            "text": "The singer's performance was very <w>Broadway</w> with lots of dramatic gestures.",
                            "target_lang_translations": {
                                "ru": "Выступление певца было очень <w>театральным</w>, с множеством драматических жестов."
                            }
                        }
                    ],
                    "synonyms": [
                        "Great White Way"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe a style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание чего-то броского, эффектного или характерного для театрального стиля нью-йоркского театрального квартала"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродвейский",
                                "target_lang_sense_clarification": "в театральном стиле"
                            },
                            {
                                "target_lang_word": "театральный",
                                "target_lang_sense_clarification": "эффектный и броский"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "746338c9-9b37-3a11-a7f4-b785c64129f2",
                    "sense_definition": "Relating to the high-value cards (ten through ace) used to form a top straight in poker",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poker-terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was looking for <w>broadway</w> connectors to improve his hand.",
                            "target_lang_translations": {
                                "ru": "Он искал <w>бродвейные</w> коннекторы, чтобы улучшить свою комбинацию."
                            }
                        },
                        {
                            "text": "The flop contained two <w>broadway</w> cards, making the situation dangerous.",
                            "target_lang_translations": {
                                "ru": "На флопе выпали две <w>бродвейные</w> карты, что сделало ситуацию опасной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broadway connectors",
                        "broadway cards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к картам высокого достоинства (от десятки до туза), используемым для составления старшего стрита в покере"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродвейный",
                                "target_lang_sense_clarification": "о картах высокого достоинства в покере"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}