                    }
                ],
                "senses": [
                    {
                        "sense_id": "42b291f4-c0f1-3c50-9c54-45f572ad4161",
                        "entry_id": "b7fdb005-001d-3c42-904d-d6cba9572c82",
                        "glosses": [
                            "geräuchertes Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec18a8e4-c62b-41b6-baaf-5d1e81a5978a",
                                "sense_id": "42b291f4-c0f1-3c50-9c54-45f572ad4161",
                                "text": "„Einige sitzen mit am Tisch, der mit Rauchfleisch, Wurst, Eiern und Bier beschickt ist, so wie einst nur Großbauern bewirten konnten.“"
                            },
                            {
                                "example_id": "44c3d253-614b-4ec5-84d7-e3a15d9b6400",
                                "sense_id": "42b291f4-c0f1-3c50-9c54-45f572ad4161",
                                "text": "„Man kann auch französische Küche probieren, aber wir ordern die Altböhmische Platte mit Rauchfleisch, Ente und Wurst, dazu Knödel in drei verschiedenen Varianten.“"
                            },
                            {
                                "example_id": "55b7bd70-8d23-4aed-9dc8-624e1c096910",
                                "sense_id": "42b291f4-c0f1-3c50-9c54-45f572ad4161",
                                "text": "„Nun ließ sie durch Lenzfreude vier Teller mit Zukost holen nebst einem Teller mit fein geteiltem Rauchfleisch und den Tisch in ihrem Zimmer decken, um mit Simen Tjing zu speisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
