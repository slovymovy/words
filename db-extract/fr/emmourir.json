                    },
                    {
                        "sense_id": "5094656b-f7d7-3ffd-a2ef-96d9a88ed1ff",
                        "entry_id": "815f23fc-0fd7-39de-8f34-b891690571c7",
                        "glosses": [
                            "Mourir."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0d69aceb-aac8-4bcd-9890-4150cf887273",
                                "sense_id": "5094656b-f7d7-3ffd-a2ef-96d9a88ed1ff",
                                "text": "Je serais resté là à compter les décennies comme on compte les jours, comme on compte les moutons avant de s’emmourir."
                            },
                            {
                                "example_id": "83d04f54-a187-472d-b45c-656817b2cab9",
                                "sense_id": "5094656b-f7d7-3ffd-a2ef-96d9a88ed1ff",
                                "text": "Il a profité d’une clairière de tranquillité dans la forêt sombre de la maladie pour \"s’emmourir\" en paix."
                            }
                        ]
                    }
