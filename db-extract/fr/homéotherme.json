                "forms": [
                    {
                        "form_id": "a5b116fd-9748-4089-bd46-248098de763f",
                        "entry_id": "2f9ead46-ad96-3fc0-8b6d-bd5c9dc915de",
                        "tags": [
                            "plural"
                        ],
                        "form": "homéothermes"
