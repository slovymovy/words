                "senses": [
                    {
                        "sense_id": "c3b7f573-e36e-3e57-970d-d2bdcd9493f3",
                        "entry_id": "87e7ee92-db7c-3ec1-a1d9-86121de91b99",
                        "glosses": [
                            "wedding ceremony where the newly married couple are brought to the bedroom"
                        ],
                        "tags": [
                            "historical",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3add35f2-9003-466c-a7c9-1588ff3e2190",
                                "sense_id": "c3b7f573-e36e-3e57-970d-d2bdcd9493f3",
                                "text": "Nastąpiły pokładziny, pro­ wadzono młodych, panowie — Kazimierza, baby — Helenę, z wielkim śpiewem, z dwóch stron, do sypialni — przed której drzwiami spotkały się orszaki.",
                                "translation": "There was a beilager, young people were led, gentlemen - Kazimierz, women - Helena, with great singing, from both sides, to the bedroom - in front of whose door the retinues met.",
                                "english": "There was a beilager, young people were led, gentlemen - Kazimierz, women - Helena, with great singing, from both sides, to the bedroom - in front of whose door the retinues met."
                            }
                        ]
                    },
                    {
                        "sense_id": "315e441a-29d5-3c81-abc4-488d3b49508b",
                        "entry_id": "87e7ee92-db7c-3ec1-a1d9-86121de91b99",
                        "glosses": [
                            "consummation of a marriage"
                        ],
                        "tags": [
                            "Middle",
                            "Polish",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "90211481-044b-4184-9a53-ee656eab2be4",
                                "sense_id": "315e441a-29d5-3c81-abc4-488d3b49508b",
                                "text": "Bacżąc pánowie iż wdzyęcżnym gośćiem Gwilem v krolewny/ poięli go ná zámek/ y chćieli oddáć w małżeńſtwo s krolewną […]. Ale gdy vſłyſzeli iż Iágiełło iedzye/ niźli pokłádźiny były/ wyrzućili Gwilelmá z zamku.",
                                "translation": "The gentlemen, seeing that the grateful guest of Gwilem the royal/ took him to the castle/ and wanted to marry the princess […] . But when they heard that Jagiełło knew/ that the consummation happened/ they threw Gwilelmá out of the castle.",
                                "english": "The gentlemen, seeing that the grateful guest of Gwilem the royal/ took him to the castle/ and wanted to marry the princess […] . But when they heard that Jagiełło knew/ that the consummation happened/ they threw Gwilelmá out of the castle."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d316341-dab0-325e-94ba-33dbb60f0e71",
                        "entry_id": "87e7ee92-db7c-3ec1-a1d9-86121de91b99",
                        "glosses": [
                            "adultery (sexual relation before or outside of marriage)"
                        ],
                        "tags": [
                            "Middle",
                            "Polish",
                            "humorous",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "815628a4-ae67-4ed4-8dc6-1b0f0bfc35b0",
                                "sense_id": "9d316341-dab0-325e-94ba-33dbb60f0e71",
                                "text": "Bo pókiś żyw, choć umrzesz, zawżdy dawać musisz: Kup chrzest, kup spowiedź, i ślub także kupisz, Który samiż dawają i sami rozwodzą, Czasem przed panem młodym pokładzin dochodzą.",
                                "translation": "For as long as you live, even though you die, you must always give: Buy a baptism, buy a confession, and you will also buy a wedding, Which they themselves give and divorce themselves, Sometimes they demand adultery before the groom.",
                                "english": "For as long as you live, even though you die, you must always give: Buy a baptism, buy a confession, and you will also buy a wedding, Which they themselves give and divorce themselves, Sometimes they demand adultery before the groom."
                            }
                        ]
                    }
