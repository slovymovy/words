                    "sense_id": "c680b25c-70a8-31a5-87b0-1b8ef9cd7ea0",
                    "sense_definition": "In a random, chaotic, disorganized, or incomplete manner, without any obvious plan or order.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The books were piled <w>haphazardly</w> on the floor, making it impossible to find the one I needed.",
                            "target_lang_translations": {
                                "de": "Die Bücher waren <w>planlos</w> auf dem Boden aufgestapelt, sodass es unmöglich war, dasjenige zu finden, das ich brauchte."
                            }
                        },
                        {
                            "text": "Instead of following the instructions, he assembled the shelf <w>haphazardly</w> and it quickly collapsed.",
                            "target_lang_translations": {
                                "de": "Anstatt der Anleitung zu folgen, baute er das Regal <w>wahllos</w> zusammen, und es brach schnell in sich zusammen."
                            }
                        }
                    ],
                    "synonyms": [
                        "randomly",
                        "chaotically",
                        "disorganizedly",
                        "unsystematically",
                        "unmethodically"
                    ],
                    "antonyms": [
                        "methodically"
                    ],
                    "common_phrases": [
                        "piled haphazardly",
                        "arranged haphazardly",
                        "scattered haphazardly"
                    ],
                    "target_lang_definitions": {
