                "senses": [
                    {
                        "sense_id": "5500f223-ccf8-31ed-84c5-4a649639ff97",
                        "entry_id": "ead9edcd-b1aa-3844-97e7-216796b0504c",
                        "glosses": [
                            "провинция на востоке центральной части Китая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b1b252-91d1-4500-b8de-34c4d24d30cc",
                                "sense_id": "5500f223-ccf8-31ed-84c5-4a649639ff97",
                                "text": "Бассейн, недавно построенный в городе Цэинмыне китайской провинции Хубэй, имеет площадь семь тысяч квадратных метров."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fd44eb3-e473-43bc-a07c-304e27bfe327",
                        "source_entry_id": "ead9edcd-b1aa-3844-97e7-216796b0504c",
                        "source_sense_id": "5500f223-ccf8-31ed-84c5-4a649639ff97",
                        "target_lang_word": "Hubei",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hubei",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                        "entry_id": "d5e931db-7a54-3622-bba3-9ec4d920a164",
                                        "glosses": [
                                            "A province in central China. Capital: Wuhan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d74e63-4ad0-4ccc-b777-b1f18a7d9fd9",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "In 1965 the People’s Daily published sore figures for Yangxin xian in Hubei Province which showed how important the part-work schools were in raising school attendance figures (SCMP 3475, 1965)."
                                            },
                                            {
                                                "example_id": "8aed8b75-6875-41cc-95cb-09fc840a4a2e",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "The Communists were also very active in Hubei and Hunan; they were involved in strikes in the Wuhan arsenal and steelworks and the strike of the Anyuan coal miners, and in the formation of workers’ clubs and unions among miners, metal-workers, and textile workers. These workers’ organizations were grouped together in provincial union federations of Hunan (with Mao Tsetung as secretary) and of Hubei."
                                            },
                                            {
                                                "example_id": "1bc4de03-5a18-4b9d-9488-8434d84e4d86",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "The Three Gorges Dam in Hubei province is the largest in the country, but is also one of the most controversial hydroelectric plants in the world. An estimated 1.3 million people were forcibly relocated during its construction. Moreover, the reservoir has been polluted by industrial waste."
                                            },
                                            {
                                                "example_id": "f7cfd437-709d-4417-ae61-e0df86732151",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "Cases have been heavily concentrated in Wuhan and surrounding areas of Hubei province, which has been locked down for two weeks in an attempt to contain the virus."
                                            },
                                            {
                                                "example_id": "12c8fb76-1421-46e3-91cc-aa2f493f73db",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "Chinese authorities said Tuesday they will end a two-month lockdown of most of coronavirus-hit Hubei province at midnight, as domestic cases of what has become a global pandemic subside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
