                    }
                ],
                "translations": [
                    {
                        "translation_id": "97ee8a5b-7309-4590-b41c-6de2274785de",
                        "source_entry_id": "136f4dac-eb1f-3186-9abc-b321cc3522a4",
                        "source_sense_id": "4b95c7c9-92c7-3f85-8689-946bcbc76bf1",
                        "target_lang_word": "Ciceronian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ciceronian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccd2a518-74f5-3b9e-982b-03ed4cbde356",
                                        "entry_id": "cc472cdb-3a31-38b6-9067-b39b70e51396",
                                        "glosses": [
                                            "Of or relating to Marcus Tullius Cicero, or the ideas in his philosophical treatises."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76f21615-6bed-3d85-b273-456a43f3df52",
                                        "entry_id": "cc472cdb-3a31-38b6-9067-b39b70e51396",
                                        "glosses": [
                                            "Eloquent, resembling Cicero’s style."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f39782-8cac-41f1-8a10-8bfcfcbb76b1",
                                                "sense_id": "76f21615-6bed-3d85-b273-456a43f3df52",
                                                "text": "'But why should I attempt to depict and describe in detail, and feature by feature, the beauty of the peerless Dulcinea, the burden being one worthy of other shoulders than mine, an enterprise wherein the pencils of Parrhasius, Timantes, and Apelles, and the graver of Lysippus ought to be employed, to paint it in pictures and carve it in marble and bronze, and Ciceronian and Demosthenian eloquence to sound its praises?' / 'What does Demosthenian mean, Senor Don Quixote?' said the duchess; 'it is a word I never heard in all my life.' / 'Demosthenian eloquence,' said Don Quixote, 'means the eloquence of Demosthenes, as Ciceronian means that of Cicero, who were the two most eloquent orators in the world.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24bd95d3-885c-3629-8094-49c32600d092",
                                        "entry_id": "cc472cdb-3a31-38b6-9067-b39b70e51396",
                                        "glosses": [
                                            "With effusive use of antithesis and long sentences."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Ciceronian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "436d6bdb-2971-3e55-8f1e-926728a3857c",
                                        "entry_id": "e011bf7f-2873-3640-9535-b536ceb12469",
                                        "glosses": [
                                            "One who adopts or favours Cicero's literary style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fac60f2-d68f-45f8-b1af-5d2b6bbfb550",
                                                "sense_id": "436d6bdb-2971-3e55-8f1e-926728a3857c",
                                                "text": "One thing is observable in all the professed Ciceronians, namely, the using a multitude of words to express their meaning. This they learned from their master, since it cannot be denied that Cicero is rather verbose."
                                            },
                                            {
                                                "example_id": "afc9a30a-514a-45cb-b4e6-6486b79887cc",
                                                "sense_id": "436d6bdb-2971-3e55-8f1e-926728a3857c",
                                                "text": "The fact that he scoffed at their so-called purity of style, declaring that any reputable Latin was standard and that matter was more important than form, brought him into conflict with the sect of Ciceronians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4e62074-0fd8-4738-a258-9dd257897d0e",
                        "source_entry_id": "136f4dac-eb1f-3186-9abc-b321cc3522a4",
                        "source_sense_id": "4b95c7c9-92c7-3f85-8689-946bcbc76bf1",
                        "target_lang_word": "cicéronien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cicéronien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b7dc3b-a273-3315-aa66-3bea51aa7f66",
                                        "entry_id": "ee90ec85-86a4-37d1-93cf-2c51c0b1f6ff",
                                        "glosses": [
                                            "De Cicéron, ou du style de Cicéron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baed9564-abfc-467c-b9c3-b8866c3644f3",
                                                "sense_id": "b8b7dc3b-a273-3315-aa66-3bea51aa7f66",
                                                "text": "— Il ne manque pas d’un certain sans-gêne, se disait Bénin. Comme si cette grotesque réception ne suffisait pas… Il m’abrutit d’un discours cicéronien…"
                                            },
                                            {
                                                "example_id": "cf6bf46d-afd2-40f4-9a34-97c1662a1a40",
                                                "sense_id": "b8b7dc3b-a273-3315-aa66-3bea51aa7f66",
                                                "text": "Il [Samuel Johnson] augurait du sort des nations, procédait sans appel à la classification en bons et en méchants de tous les êtres humains qu’il lui était donné de connaître, réglait les affaires de la politique, de la littérature et de la théologie, déroulait par tous les chemins de la pensée humaine ses longues phrases à antithèses cicéroniennes."
                                            },
                                            {
                                                "example_id": "e085d0b9-f338-48da-872e-d3c1d9c63065",
                                                "sense_id": "b8b7dc3b-a273-3315-aa66-3bea51aa7f66",
                                                "text": "Lecture et écriture autorisent donc la maîtrise de la langue et l’exercice qui combine le mieux ces deux usus quotidiens, c’est la rétroversion, d’abord des textes cicéroniens puis plus tard des textes empruntés à Virgile et à Horace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6571d85c-7545-45bf-bffa-36cbf86ce184",
                        "source_entry_id": "136f4dac-eb1f-3186-9abc-b321cc3522a4",
                        "source_sense_id": "4b95c7c9-92c7-3f85-8689-946bcbc76bf1",
                        "target_lang_word": "ciceroniano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "081282e1-0bac-4022-a11a-b669f157f410",
                        "source_entry_id": "136f4dac-eb1f-3186-9abc-b321cc3522a4",
                        "source_sense_id": "4b95c7c9-92c7-3f85-8689-946bcbc76bf1",
                        "target_lang_word": "ciceronisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciceronisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bd6806a-bf87-3a2f-9e03-9ebf1dbff711",
                                        "entry_id": "759378fc-8a56-30a1-b622-d7679240d513",
                                        "glosses": [
                                            "in einem hochstehenden, fehlerfreien Stil ausgedrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a14362-e32c-405b-a534-c2bef2d8841e",
                                                "sense_id": "6bd6806a-bf87-3a2f-9e03-9ebf1dbff711",
                                                "text": "„Er vereinte eine ciceronische Fülle des Stils und eine wohltönende Vornehmheit des Satzbaus mit einer fast rituellen Verwendung von Wiederholungen und Andeutungen, die der Prosa eine bedrohliche, widerhallende Qualität verliehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
