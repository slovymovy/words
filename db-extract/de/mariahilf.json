                ],
                "senses": [
                    {
                        "sense_id": "3a8c6336-2791-30bd-a52b-e83642f0bb92",
                        "entry_id": "5b84af1a-046d-3b5e-b75e-3dbf33bd76b7",
                        "glosses": [
                            "sechster Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc587324-0c65-40ea-869d-3d3c7293fe67",
                                "sense_id": "3a8c6336-2791-30bd-a52b-e83642f0bb92",
                                "text": "In Mariahilf gab [es] nachweislich schon in der Jungsteinzeit menschliche Siedlungen: Bei Ausgrabungen im Bereich der U-Bahn-Station Gumpendorfer Straße wurden neolithische Siedlungsreste und Steinwerkzeuge gefunden."
                            },
                            {
                                "example_id": "ee719f54-545b-48da-8c20-ed964c6d7da0",
                                "sense_id": "3a8c6336-2791-30bd-a52b-e83642f0bb92",
                                "text": "Mariahilf hat ein dichtbesiedeltes Gewerbe- und Kleinindustrieviertel, besitzt drei Gymnasien, das Institut für Höhere Studien (Ford-Institut, 6, Stumpergasse 56), die erste Zentralberufsschule (Mollardschule) und mehrere Institute der Technischen Universität."
                            },
                            {
                                "example_id": "dcab452e-be2b-493c-9b0a-fce86598c467",
                                "sense_id": "3a8c6336-2791-30bd-a52b-e83642f0bb92",
                                "text": "Der Schriftsteller Robert Menasse lobte Mariahilf einst als am meisten lebenswerten Bezirk der Stadt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ec06efdb-69ea-3983-b484-bab4e55fb6ae",
                        "entry_id": "5b84af1a-046d-3b5e-b75e-3dbf33bd76b7",
                        "glosses": [
                            "ehemaliger Vorort, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dde6e4f-65d1-4180-a9cf-65c436643f4e",
                                "sense_id": "ec06efdb-69ea-3983-b484-bab4e55fb6ae",
                                "text": "Der Vorort Mariahilf entstand aus drei Rieden: „Im Schöff“, „Im Gern“ und „Grüner Scho“ (Grüner Anger)."
                            },
                            {
                                "example_id": "01eb9838-2816-484e-8950-1eaaf352dd82",
                                "sense_id": "ec06efdb-69ea-3983-b484-bab4e55fb6ae",
                                "text": "Die eigentliche Geschichte von Mariahilf beginnt jedoch erst nach der zweiten Türkenbelagerung um 1683 mit der dauerhaften Besiedelung und Verbindung der beiden doch einen Kilometer voneinander entfernten alten Vororte Laimgrube und Gumpendorf."
                            },
                            {
                                "example_id": "52cdde60-4bf4-4c73-9c99-31a8c3a887a3",
                                "sense_id": "ec06efdb-69ea-3983-b484-bab4e55fb6ae",
                                "text": "1850 wurde der Vorort Mariahilf gemeinsam mit Gumpendorf, Laimgrube, Windmühle und Magdalenengrund als 5. Bezirk in den Bezirk Mariahilf eingemeindet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
