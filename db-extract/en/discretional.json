                        "examples": [
                            {
                                "example_id": "4ed7537a-4917-4cfd-856c-a731065a1f28",
                                "sense_id": "af74ee23-4317-352c-8b25-ebf64a40c2a7",
                                "text": "That of their small force, some of the soldiers were superannuated, others invalid; therefore, since the course to be pursued was left discretional, their unanimous advice was, to remain where they were, and fortify themselves as strongly as possible."
                            },
                            {
                                "example_id": "bc9c9111-2925-4fbd-a296-8dac0c6404fa",
                                "sense_id": "af74ee23-4317-352c-8b25-ebf64a40c2a7",
                                "text": "The Admiral, very apprehensive of her falling into the hands of the enemy, sent me with discretional orders to Captain Hood, that, should he not be able to get her off the shoal, he might put his men into the Thames, and burn the Venerable, making the signal at the same time for the Thames to close with the Venerable as soon as possible."
                            }
                        ]
                    }
