                "senses": [
                    {
                        "sense_id": "92885a38-6511-30e3-9575-0cf365a415c8",
                        "entry_id": "4fa6ae84-bfe9-3c72-a8d6-fcc192cc1558",
                        "glosses": [
                            "рег. (украинск.) или редк. прост. то же, что убежать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f72a4d9-ae60-4166-bc28-7dc08e46f7de",
                                "sense_id": "92885a38-6511-30e3-9575-0cf365a415c8",
                                "text": "Господи!.. Убегти бы… Всее истрясло: при всех!!. страсть!"
                            },
                            {
                                "example_id": "fcae8d76-0316-419e-a1db-b9c980470d44",
                                "sense_id": "92885a38-6511-30e3-9575-0cf365a415c8",
                                "text": "Как лежишь до атаки-то, так всё думаешь, как бы убегти… А вышел — орать до того нужно, кишки сорвёшь…"
                            },
                            {
                                "example_id": "6298872c-35f7-437d-a716-d7a281e77b7c",
                                "sense_id": "92885a38-6511-30e3-9575-0cf365a415c8",
                                "text": "Коростель ― птица долгоногая, бегучая, сухопутная и летная, давно пора ей убегти в тёплую сторону."
                            }
                        ]
                    }
                ],
