                "senses": [
                    {
                        "sense_id": "151156b3-eb76-3fac-a2aa-20159db5becb",
                        "entry_id": "31e31cea-00a3-311f-aead-7992e8af5c07",
                        "glosses": [
                            "Festlegung, mit wem und wie ein Amt oder Position neu besetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "786e9eda-7fae-4a47-88ca-4ad001ac0f83",
                                "sense_id": "151156b3-eb76-3fac-a2aa-20159db5becb",
                                "text": "„Als Divisio Regnorum bezeichnet man die Nachfolgeregelung Karls des Großen, die dieser am 6. Februar 806 erließ.“"
                            },
                            {
                                "example_id": "49f6e678-04ce-4617-a29b-d3e2956cafec",
                                "sense_id": "151156b3-eb76-3fac-a2aa-20159db5becb",
                                "text": "„Dann verrät er ein pikantes Detail aus seinem Arbeitsvertrag: ‚Da steht, dass der Aufsichtsrat mich bittet, bei meiner Nachfolgeregelung mitzuhelfen. […]‘“"
                            },
                            {
                                "example_id": "3911f51a-33af-4c26-8502-475a87fdb2d8",
                                "sense_id": "151156b3-eb76-3fac-a2aa-20159db5becb",
                                "text": "„Hermann Göring, seinem designierten Nachfolger, entzog er alle Ämter und Rechte, als der Reichsmarschall von Berchtesgaden aus anfragte, ob es an der Zeit sei, die Nachfolgeregelung in Kraft zu setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
