                                        "glosses": [
                                            "osoba nebo stát, který podepsal příslušný významný dokument, smlouvu či petici"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95d1bb3-8b93-46bd-80b0-f53a30089f70",
                                                "sense_id": "19cb63b0-ab93-300e-9926-153ef1643c8c",
                                                "text": "Mezi signatáři Kjótského protokolu bychom marně hledali USA."
                                            },
                                            {
                                                "example_id": "e8c71a47-affa-4e9f-bc2a-4599dfdf0f98",
                                                "sense_id": "19cb63b0-ab93-300e-9926-153ef1643c8c",
                                                "text": "Na přelomu sedmdesátých a osmdesátých let se komunistický režim vehementně mstil na signatářích Charty 77 i jejich příbuzných."
                                            }
                                        ]
                                    }
                                ]
