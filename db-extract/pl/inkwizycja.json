                "senses": [
                    {
                        "sense_id": "b8c0d62f-8476-3b34-913e-161f6bc3e87a",
                        "entry_id": "18edb4ef-7a0d-39b7-bb46-66e697e9dc15",
                        "glosses": [
                            "system śledczo-sądowniczy Kościoła katolickiego, działający od XIII do XIX wieku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2f827f5-66a1-4e93-9e49-8561ff0ac2c6",
                                "sense_id": "b8c0d62f-8476-3b34-913e-161f6bc3e87a",
                                "text": "Na czele hiszpańskiej inkwizycji stał Wielki Inkwizytor."
                            },
                            {
                                "example_id": "a914edc3-b4a6-4ac0-811d-73b224319516",
                                "sense_id": "b8c0d62f-8476-3b34-913e-161f6bc3e87a",
                                "text": "Więzienie, skazanie na galery, utrata mienia - kary te stosowano nagminnie wobec wszystkich klientów inkwizycji, z wyjątkiem czarownic: te czekało zawsze autodafe, czyli spalenie żywcem."
                            },
                            {
                                "example_id": "0d872118-6d7f-4d6d-81db-f2a889351acf",
                                "sense_id": "b8c0d62f-8476-3b34-913e-161f6bc3e87a",
                                "text": "Krucjata albigeńska odegrała znaczącą rolę w tworzeniu i organizacji zarówno zakonu dominikanów, jak i średniowiecznej inkwizycji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7881fb6e-0ea2-41bb-be08-d6c7b49dfcad",
                        "source_entry_id": "18edb4ef-7a0d-39b7-bb46-66e697e9dc15",
                        "source_sense_id": "b8c0d62f-8476-3b34-913e-161f6bc3e87a",
                        "target_lang_word": "Inquisition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inquisition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02b6de3f-12f2-32ab-9587-83b64b21a480",
                                        "entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                                        "glosses": [
                                            "A tribunal of the Roman Catholic Church set up to investigate and suppress heresy."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9969d83d-b2fb-4c3e-8c9e-60967b5cc9f1",
                                                "sense_id": "02b6de3f-12f2-32ab-9587-83b64b21a480",
                                                "text": "We know from history that the Catholic Church has historically murdered, mutilated, castrated, maimed, imprisoned and flogged homosexuals. Catholic atrocities during the Inquisition are well documented and cannot be denied. The Church no longer does those things to homosexuals, but it violates their human rights in other ways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "554741d1-fc02-31a9-9a89-b9e6e616202d",
                                        "entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                                        "glosses": [
                                            "A harsh or rigorous interrogation that violates one’s rights."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "625aa7a8-3ffc-4dbf-900f-6531cc29a450",
