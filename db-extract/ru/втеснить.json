                "senses": [
                    {
                        "sense_id": "39fbe4db-94be-3f9d-b631-4ae29c3da22b",
                        "entry_id": "999f46f7-4de7-3cea-865d-77f32063c79d",
                        "glosses": [
                            "to squeeze"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "831d2de5-3a32-498e-818d-6dba0109eb4e",
                                "sense_id": "39fbe4db-94be-3f9d-b631-4ae29c3da22b",
                                "text": "К тому́ же ему́ ка́к-то бессозна́тельно хоте́лось втесни́ть ка́к-нибудь и себя́ в э́ту для него́ чу́ждую жизнь, кото́рую он досе́ле знал, и́ли, лу́чше сказа́ть, то́лько ве́рно предчу́вствовал инсти́нктом худо́жника.",
                                "translation": "Moreover, he had an unconscious longing to squeeze himself somehow into this life which was so strange to him, of which he had hitherto known—or rather correctly divined—only by the instinct of the artist.",
                                "english": "Moreover, he had an unconscious longing to squeeze himself somehow into this life which was so strange to him, of which he had hitherto known—or rather correctly divined—only by the instinct of the artist."
                            }
                        ]
                    }
