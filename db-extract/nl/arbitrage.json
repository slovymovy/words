                "translations": [
                    {
                        "translation_id": "f98157be-ab3b-4682-aca5-f517b8a546d6",
                        "source_entry_id": "ef818e0b-1b2d-3aa7-9bae-9e26cc006fc5",
                        "source_sense_description": "handelen van een scheidsrechter",
                        "target_lang_word": "Schlichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                        "entry_id": "3892bc61-040b-325c-8eb9-2f02b48c1a5e",
                                        "glosses": [
                                            "Versuch der Beilegung eines Streits zwischen zwei Parteien / Personen mit Hilfe einer dritten neutralen Person, also ohne Gerichte; es geht dabei um die Erzielung eines für beide Parteien hinnehmbaren Kompromisses; im Deutschen wird Schlichtung häufig bei tariflichen Auseinandersetzungen zwischen Arbeitgeberverbänden und Gewerkschaften gebraucht"
                                        ],
                                        "tags": [
                                            "die Verwendung des Plurals ist selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87b6de49-278a-4169-a02f-87e7ede63974",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "Vor einem Arbeitskampf können Gewerkschaften und Arbeitgeber eine Schlichtung vereinbaren."
                                            },
                                            {
                                                "example_id": "a4b805b8-2a1c-4ff6-abc9-8bc469f1350f",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„Mit der Protestaktion […] will die Gewerkschaft vor der auf Freitag (11.05.18) vertagten Schlichtung für die Bautarife ein Zeichen an die Arbeitgeber richten.“"
                                            },
                                            {
                                                "example_id": "06d160ca-ea05-44e4-95e7-3f2c21d0ae45",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "Eigentlich hält [der deutsche Innenminister Thomas] de Maizière [, CDU,] von einer Schlichtung überhaupt nichts."
                                            },
                                            {
                                                "example_id": "b30dc24e-825f-4796-a312-c7e0d922d18e",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„Während die SPD ein Schlichtungsverfahren fordert, lehnt der CDU-Verhandlungsführer auf Arbeitgeberseite, der niedersächsische Finanzminister Hartmut Möllring (CDU), eine Schlichtung ab.“"
                                            },
                                            {
                                                "example_id": "e0858a1e-2c92-402f-a21e-b560fec46b09",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„Der Klage vorausgegangen war eine Schlichtung unter der Leitung von zwei Oberlandesgerichts- und einem Landgerichtspräsidenten aus Niedersachsen.“"
                                            },
                                            {
                                                "example_id": "8710ab92-0ee7-4ed9-a948-d74e456e32f8",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "Zuletzt hatte bereits China in dem Streit um die Zölle [mit den USA] eine Schlichtung bei der WTO beantragt."
                                            },
                                            {
                                                "example_id": "48204922-8d99-4f4a-adde-81c83774892e",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„1517 gründeten seefahrende Hamburger Kaufleute die \"Versammlung Eines Ehrbaren Kaufmanns zu Hamburg\" […]. Zu ihren Aufgaben gehörte die Verteidigung des freien Handels gegen Feinde sowie die Schlichtung von Meinungsverschiedenheiten in den eigenen Reihen.“"
                                            },
                                            {
                                                "example_id": "78cceaf9-ca8d-4224-9c31-079a9307450a",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„[…] die Mittel der Aufsichtsbehörde [, der Bundesnetzagentur als Aufsichtsbehörde für die Postzustellung, sind] begrenzt: Sie kann Stellungnahmen der Unternehmenanfordern, die Beseitigung von Mängeln anmahnen und Schlichtungen anbieten - aber keine Bußgelder verhängen. 'Ein zahnloser Tiger', sagt ein Branchenkenner.“"
                                            },
                                            {
                                                "example_id": "fbdae2c6-2d2f-4887-83a2-045cb9812d95",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„Der Versuch, einen Streit zwischen zwei kirchlichen Strömungen […] mittels Schlichtung beizulegen, endete im Oktober in einem Tumult.“"
                                            },
                                            {
                                                "example_id": "577d4650-4600-4547-a44e-db9ce23bd84f",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„[Die] Gäste [waren] jedoch [mit der Änderung des Flugziels] nicht einverstanden. Sie fingen eine Schlägerei an. Zur Schlichtung musste die Polizei eingreifen.“"
                                            },
                                            {
                                                "example_id": "27e6a90e-1d3a-43b6-b336-6b18146b7bbd",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "„Jeder Passagier, der in Deutschland gelandet oder gestartet ist, hat das Recht, eine Schlichtung bei der Schlichtungsstelle für den öffentlichen Personenverkehr (SÖP) zu beantragen.“"
                                            },
                                            {
                                                "example_id": "0585aaac-1754-4e7c-9ca8-e7cb833b003a",
                                                "sense_id": "d64052a7-1f66-337e-b83f-9827aea43b35",
                                                "text": "[Die] Schülervertretung […] hat die Aufgabe, […] für die Schlichtung von Streitereien zwischen Schülern zu sorgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52a70301-b293-3ba8-bf1f-57311ca6c164",
                                        "entry_id": "3892bc61-040b-325c-8eb9-2f02b48c1a5e",
                                        "glosses": [
                                            "Glättung von Kettfäden beim Weben von Stoffen; Kämmen von Haaren"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14befed8-5609-4bb2-aa57-74927e5005fb",
                                                "sense_id": "52a70301-b293-3ba8-bf1f-57311ca6c164",
                                                "text": "Durch die Schlichtung wird die Gleichmäßigkeit eines Garnes verbessert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
