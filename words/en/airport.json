                {
                    "sense_id": "32a351ba-ead5-3b49-a72f-53df3e2188ef",
                    "sense_definition": "A place where aircraft land and take off, usually equipped with runways and buildings for passengers and cargo.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transportation_hubs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She met Sam and the others at the <w>airport</w> at 7:00 am.",
                            "target_lang_translations": {
                                "ru": "Она встретила Сэма и остальных в <w>аэропорту</w> в 7 утра."
                            }
                        },
                        {
                            "text": "The taxi driver dropped us off right in front of the <w>airport</w> terminal.",
                            "target_lang_translations": {
                                "ru": "Таксист высадил нас прямо перед терминалом <w>аэропорта</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "airfield",
                        "airstrip",
                        "aerodrome"
                    ],
                    "common_phrases": [
                        "international airport",
                        "airport terminal",
                        "airport security",
                        "busy airport"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где взлетают и садятся самолеты, обычно оборудованное взлетно-посадочными полосами и зданиями для пассажиров и грузов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аэропорт",
                                "target_lang_sense_clarification": "основной термин для гражданских авиаперевозок"
                            },
                            {
                                "target_lang_word": "аэродром",
                                "target_lang_sense_clarification": "техническая площадка для взлета и посадки"
                            },
                            {
                                "target_lang_word": "аэровокзал",
                                "target_lang_sense_clarification": "здание терминала для обслуживания пассажиров"
                            }
                        ]
                    }
                }
            ]
        },
