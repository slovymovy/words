                "senses": [
                    {
                        "sense_id": "92e35f7d-3322-32a0-a429-c9c03a64b1b4",
                        "entry_id": "9dbb3323-4e7b-38c6-a94e-ada9690c8fc3",
                        "glosses": [
                            "medizinische Einrichtung mit stationärer Abteilung, die speziell für Personen unter 18 Jahren gedacht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43fa3dc3-3b26-42ae-ba5d-b0c4a75dad01",
                                "sense_id": "92e35f7d-3322-32a0-a429-c9c03a64b1b4",
                                "text": "Die Kinderärztin überwies den kleinen Johannes in die Kinderklinik."
                            },
                            {
                                "example_id": "f56d3051-4f13-424c-b196-a1c46256762e",
                                "sense_id": "92e35f7d-3322-32a0-a429-c9c03a64b1b4",
                                "text": "„Die Organisation hilft national und international Kindern in Not und fördert Kinderkliniken, Schulen, Sport- und Bildungsprojekte, unterstützt aber auch Kinder in Kriegs- und Krisengebieten.“"
                            },
                            {
                                "example_id": "f8021c77-ce5d-4c21-b75b-08dc46d68161",
                                "sense_id": "92e35f7d-3322-32a0-a429-c9c03a64b1b4",
                                "text": "„Ein Tumor in solch einer Größe ist laut Irene Teichert von Lüttichau, Oberärztin an der Schwabinger Kinderklinik, eine Seltenheit und wäre vor fünf Jahren sicher nur schwer zu behandeln gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
