                                        "entry_id": "ded49054-31d3-3ee6-a049-889160179eca",
                                        "glosses": [
                                            "früher als vorgesehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0294111-9f96-45b7-b14f-b7b8065a7ff0",
                                                "sense_id": "3d9a34d5-f29d-3cfd-9d3a-156528ba6dc7",
                                                "text": "Seine vorzeitige Abreise war überraschend."
                                            },
                                            {
                                                "example_id": "b9349ece-4f2d-4782-a62b-aee8ac4cfba6",
                                                "sense_id": "3d9a34d5-f29d-3cfd-9d3a-156528ba6dc7",
                                                "text": "„Ihre Mutter, die sich als Linotypistin durchschlug, hatte das uneheliche Kind vorzeitig aus der Schule genommen, damit es zum Lebensunterhalt beitrage.“"
                                            },
                                            {
                                                "example_id": "d5f599cb-385f-4493-b7a1-5ae8ac53d082",
                                                "sense_id": "3d9a34d5-f29d-3cfd-9d3a-156528ba6dc7",
                                                "text": "„Die türkische Nationalmannschaft hat Lettland mit 4:0 besiegt und sich damit vorzeitig für die EM 2024 qualifiziert.“"
                                            },
                                            {
                                                "example_id": "6c0ff9c3-56a1-4c47-b1f4-4fdff0027bad",
                                                "sense_id": "3d9a34d5-f29d-3cfd-9d3a-156528ba6dc7",
                                                "text": "[Amerikanische Präsidentschaftswahl 2024:] „Rund 78 Millionen Wähler haben nach Angaben des \"Election Lab\" der Universität Florida bereits vorzeitig ihre Stimme abgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
