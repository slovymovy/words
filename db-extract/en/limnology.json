                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limnología",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e490187d-a661-37f6-b6fd-9831826b40bd",
                                        "entry_id": "6046fb65-a260-3092-973b-3b4bdd33249d",
                                        "glosses": [
                                            "Estudio de características biológicas, físicas y químicas de cuerposs hídricos continentales: lagos, lagunas, ríos, presas, charcas, marismas y estuarios, así como de las interacciones de organismos acuáticos y su hábitat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2768b044-6195-460f-a319-0e27fdfe153b",
                                                "sense_id": "e490187d-a661-37f6-b6fd-9831826b40bd",
                                                "text": "Limnología es una asignatura optativa que permite que el alumno tenga conocimiento sobre los procesos hidrológicos, para que comprenda el funcionamiento y efecto de los diferentes sistemas acuáticos. Además se busca la integración de los conocimientos teóricos con la práctica, de manera que el alumno complemente su formación y tenga las herramientas que le permitan analizar y evaluar diferentes tipos de sistemas limnéticos"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
