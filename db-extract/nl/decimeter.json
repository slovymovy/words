                                        "entry_id": "5f1caa16-bd5a-3eb5-b140-e128fd5de931",
                                        "glosses": [
                                            "An SI unit of length equal to 10⁻¹ metres. Symbol: dm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4682853a-fbcc-4797-bcd7-c7c1d898f7bb",
                                                "sense_id": "e867de22-b9c6-3cba-b5e7-fc964d7f0f91",
                                                "text": "If the aquarium is placed where it receives insufficient daylight, artificial lighting by means of ordinary incandescent lamps should be employed. For good plant growth 2 decalumens of luminous flux per square decimetre of water surface […]"
                                            },
                                            {
                                                "example_id": "eb580af1-c51c-445d-8f34-855ddf89d9e8",
                                                "sense_id": "e867de22-b9c6-3cba-b5e7-fc964d7f0f91",
                                                "text": "Holonyms: metre < kilometre < megametre < gigametre < terametre < petametre"
                                            },
                                            {
                                                "example_id": "aad4ead7-9ea2-4875-852b-0bdcd9a4612c",
                                                "sense_id": "e867de22-b9c6-3cba-b5e7-fc964d7f0f91",
                                                "text": "Meronyms: picometre < nanometre < micrometre < millimetre < centimetre"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87d3637f-a446-4526-8adb-5280531c6eaf",
                        "source_entry_id": "8b61ccd5-8b1b-3bc8-ba86-2923ded11257",
