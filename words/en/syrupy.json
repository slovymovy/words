{
    "word_family": [
        "syrup"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc24d40d-6bf8-3a84-af3c-82edd9040fcd",
                    "sense_definition": "Having the thick, sticky consistency or sweet taste of syrup.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>syrupy</w> liquid dripped slowly from the spoon into the bowl.",
                            "target_lang_translations": {
                                "nl": "De <w>stroperige</w> vloeistof druppelde langzaam van de lepel in de kom."
                            }
                        },
                        {
                            "text": "He enjoyed the <w>syrupy</w> texture of the fruit sauce on his dessert.",
                            "target_lang_translations": {
                                "nl": "Hij genoot van de <w>stroperige</w> textuur van de vruchtensaus op zijn dessert."
                            }
                        }
                    ],
                    "synonyms": [
                        "syruped"
                    ],
                    "common_phrases": [
                        "syrupy texture"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met de dikke, kleverige consistentie of de zoete smaak van stroop."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "stroperig",
                                "target_lang_sense_clarification": "verwijzend naar de dikke, vloeibare textuur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12eded83-e09f-3399-93d1-784e885fbc6b",
                    "sense_definition": "Covered or soaked in syrup.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ate their <w>syrupy</w> waffles with great delight.",
                            "target_lang_translations": {
                                "nl": "De kinderen aten hun <w>met stroop bedekte</w> wafels met veel plezier."
                            }
                        },
                        {
                            "text": "She served the pancakes with a <w>syrupy</w> fruit topping.",
                            "target_lang_translations": {
                                "nl": "Ze serveerde de pannenkoeken met een <w>stroperige</w> vruchtentopping."
                            }
                        }
                    ],
                    "common_phrases": [
                        "syrupy waffles",
                        "syrupy pancakes"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bedekt met of doordrenkt van stroop."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "met stroop",
                                "target_lang_sense_clarification": "letterlijk bedekt met stroop"
                            },
                            {
                                "target_lang_word": "stroperig",
                                "target_lang_sense_clarification": "figuurlijk gebruikt voor voedsel dat in stroop zwemt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "438c24d3-a33e-3024-8632-ceb19514e0ac",
                    "sense_definition": "Excessively sweet in taste.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drink was far too <w>syrupy</w> for my liking.",
                            "target_lang_translations": {
                                "nl": "Het drankje was veel te <w>suikerzoet</w> naar mijn smaak."
                            }
                        },
                        {
                            "text": "I prefer coffee that is not <w>syrupy</w> or overly sugared.",
                            "target_lang_translations": {
                                "nl": "Ik heb liever koffie die niet <w>stroperig</w> of overmatig gezoet is."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Overdreven zoet van smaak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "suikerzoet",
                                "target_lang_sense_clarification": "zeer zoet, vaak op een onaangename manier"
                            },
                            {
                                "target_lang_word": "stroperig",
                                "target_lang_sense_clarification": "overdreven zoet, vergelijkbaar met de smaak van pure stroop"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0600c38a-2350-3cb4-a48c-976e1ca222f2",
                    "sense_definition": "Excessively emotional or sentimental in a way that feels insincere.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was filled with <w>syrupy</w> dialogue that felt quite fake.",
                            "target_lang_translations": {
                                "nl": "De film zat vol met <w>melige</w> dialogen die nogal nep aanvoelden."
                            }
                        },
                        {
                            "text": "He wrote a <w>syrupy</w> poem that made everyone in the room uncomfortable.",
                            "target_lang_translations": {
                                "nl": "Hij schreef een <w>sentimenteel</w> gedicht waar iedereen in de kamer zich ongemakkelijk bij voelde."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Overdreven emotioneel of sentimenteel op een manier die onoprecht aanvoelt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "sentimenteel",
                                "target_lang_sense_clarification": "overdreven gevoelig of emotioneel"
                            },
                            {
                                "target_lang_word": "melig",
                                "target_lang_sense_clarification": "overdreven sentimenteel of klef"
                            },
                            {
                                "target_lang_word": "klef",
                                "target_lang_sense_clarification": "overdreven sentimenteel of romantisch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}