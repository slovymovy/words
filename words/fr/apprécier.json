    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b78a3f9-4997-3a09-aa26-e15ecfa69d21",
                    "sense_definition": "Aimer, porter de l'estime à une personne ou trouver une chose agréable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>apprécie</w> beaucoup ce nouveau restaurant italien situé près de chez moi."
                        },
                        {
                            "text": "Les élèves <w>apprécient</w> particulièrement leur professeur d'histoire pour sa grande patience."
                        }
                    ],
                    "synonyms": [
                        "aimer",
                        "respecter"
                    ],
                    "common_phrases": [
                        "apprécier la compagnie",
                        "apprécier le geste"
                    ]
                },
                {
                    "sense_id": "81eeeb8b-06d2-31ba-963d-b2b604136c9e",
                    "sense_definition": "Reconnaître et juger à sa juste valeur les qualités ou l'utilité de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut du temps pour <w>apprécier</w> à sa juste valeur le travail de cette équipe."
                        },
                        {
                            "text": "Nous <w>apprécions</w> votre aide précieuse pendant cette période difficile."
                        }
                    ],
                    "common_phrases": [
                        "apprécier à sa juste valeur"
                    ]
                },
                {
                    "sense_id": "744a086d-198e-34a3-a7c9-334886839606",
                    "sense_definition": "Porter un jugement sur une situation, en mesurer l'état ou l'importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin doit d'abord bien <w>apprécier</w> la situation avant de choisir un traitement."
                        },
                        {
                            "text": "Il est souvent difficile d'<w>apprécier</w> les risques financiers d'un tel investissement."
                        }
                    ],
                    "common_phrases": [
                        "apprécier la situation",
                        "apprécier les risques"
                    ]
                },
                {
                    "sense_id": "a902c694-1e9d-38ce-b8b4-78ef21b966e5",
                    "sense_definition": "Déterminer la valeur marchande, le prix ou la quantité d'un bien matériel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "évaluation_financière",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commissaire-priseur a <w>apprécié</w> cette peinture ancienne à plusieurs milliers d'euros."
                        },
                        {
                            "text": "Un spécialiste est venu à domicile pour <w>apprécier</w> la valeur exacte du mobilier."
                        }
                    ],
                    "common_phrases": [
                        "faire apprécier un bien"
                    ]
                }
            ]
        }
    ]
