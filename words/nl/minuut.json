                {
                    "sense_id": "0617f459-a0c7-3ed6-9929-5297008657de",
                    "sense_definition": "Eenheid van tijd, gelijk aan zestig seconden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een uur bestaat uit 60 <w>minuten</w> en een minuut bestaat uit 60 seconden.",
                            "target_lang_translations": {
                                "en": "An hour consists of 60 <w>minutes</w> and a minute consists of 60 seconds.",
                                "ru": "Час состоит из 60 <w>минут</w>, а минута состоит из 60 секунд.",
                                "pl": "Godzina składa się z 60 <w>minut</w>, a minuta składa się z 60 sekund.",
                                "de": "Eine Stunde besteht aus 60 <w>Minuten</w> und eine Minute besteht aus 60 Sekunden.",
                                "fr": "Une heure se compose de 60 <w>minutes</w> et une minute se compose de 60 secondes.",
                                "it": "Un'ora è composta da 60 <w>minuti</w> e un minuto è composto da 60 secondi.",
                                "cs": "Hodina se skládá ze 60 <w>minut</w> a minuta se skládá ze 60 sekund.",
                                "tr": "Bir saat 60 <w>dakikadan</w> oluşur ve bir dakika 60 saniyeden oluşur.",
                                "es": "Una hora consta de 60 <w>minutos</w> y un minuto consta de 60 segundos."
                            }
                        },
                        {
                            "text": "Het vliegtuig komt aan over twintig <w>minuten</w>.",
                            "target_lang_translations": {
                                "en": "The plane arrives in twenty <w>minutes</w>.",
                                "ru": "Самолет прибудет через двадцать <w>минут</w>.",
                                "pl": "Samolot przylatuje za dwadzieścia <w>minut</w>.",
                                "de": "Das Flugzeug kommt in zwanzig <w>Minuten</w> an.",
                                "fr": "L'avion arrive dans vingt <w>minutes</w>.",
                                "it": "L'aereo arriverà tra venti <w>minuti</w>.",
                                "cs": "Letadlo přiletí za dvacet <w>minut</w>.",
                                "tr": "Uçak yirmi <w>dakika</w> içinde varacak.",
                                "es": "El avión llega en veinte <w>minutos</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een minuutje",
                        "op de minuut",
                        "binnen een minuut"
                    ],
                    "target_lang_definitions": {
                        "en": "Unit of time, equal to sixty seconds.",
                        "ru": "Единица времени, равная шестидесяти секундам.",
                        "pl": "Jednostka czasu równa sześćdziesięciu sekundom.",
                        "de": "Zeiteinheit, die sechzig Sekunden entspricht.",
                        "fr": "Unité de temps, égale à soixante secondes.",
                        "it": "Unità di tempo, pari a sessanta secondi.",
                        "cs": "Jednotka času, která se rovná šedesáti sekundám.",
                        "tr": "Altmış saniyeye eşit olan zaman birimi.",
                        "es": "Unidad de tiempo equivalente a sesenta segundos."
                    },
