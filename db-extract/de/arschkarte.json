                "senses": [
                    {
                        "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                        "entry_id": "0730b95e-7525-3ffb-8d4b-6acf46ca9e08",
                        "glosses": [
                            "Pech, Missgeschick"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "efa26408-0323-4c84-8edc-bd4a65762f08",
                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                "text": "„Ich war es schon gewohnt, wenn Arschkarten verteilt wurden, eine davon zu erhalten.“"
                            },
                            {
                                "example_id": "55b1aede-dd47-495f-9315-574af12b5bcd",
                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                "text": "Wer so viel Unsinn macht, hat bei uns die Arschkarte gezogen."
                            },
                            {
                                "example_id": "cc61edc1-9536-4c04-9723-56fefaa17bf3",
                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                "text": "„Paul war auch bei diesem Treffen dabei, natürlich, und ich fühlte mich nicht nur[,] als hätte ich mir die Arschkarte selbst ausgesucht, sondern als wären alle Arschkarten der Welt auf einmal auf mich eingestürzt und hätten mich unter sich begraben.“"
                            },
                            {
                                "example_id": "6ee07b38-b853-4753-bcfe-f691cb07e08e",
                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                "text": "„Die Arschkarte stammt also auch als geflügeltes Wort aus dem Fußball und wird heute aufs gesamte Pech im Leben bezogen.“"
                            },
                            {
                                "example_id": "74a9837a-9d6b-41fb-bede-62adc8bfc78b",
                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                "text": "„Ich sollte nicht allzu sehr schwärmen, jetzt, unmittelbar nachdem er die Arschkarte gezogen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b259f5e4-0f23-441c-abc4-c26b39994fcc",
                        "source_entry_id": "0730b95e-7525-3ffb-8d4b-6acf46ca9e08",
                        "source_sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                        "source_sense_description": "Pech, Missgeschick",
                        "target_lang_word": "zonk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zonk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                        "entry_id": "cf171079-8aac-36c7-b627-c3c94fa87e01",
                                        "glosses": [
                                            "An unfavorable card or token, or undesirable or worthless item used as a prize in a contest or game show (such as Let's Make a Deal)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76d980b6-23bd-4682-91af-f4f5aef7433a",
                                                "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                                "text": "There will always be two doors that hold zonks, so regardless of whether you initially chose the grand prize or a zonk, Monty will always be able to show you a zonk not chosen."
                                            },
                                            {
                                                "example_id": "81c5ad9c-8cf4-40cb-b5e3-49efffd1d5fd",
                                                "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                                "text": "A live, mane-embellished, SAG-card-carrying lion, I should point out, who was likely being staged for a few minutes off to the side before he would be used as a freaking “Zonk!” on a freaking game show, for crying out loud."
                                            },
                                            {
                                                "example_id": "d520a188-eaf1-4e41-a8a3-1b09c91ef90b",
                                                "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                                "text": "A zonk was way overdue, yet the boys knew that the Seniors knew they would think this was a zonk and would trick the boys by making this another real prize."
                                            },
                                            {
                                                "example_id": "014fbc01-f723-42bf-b276-f744a0ea904b",
                                                "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                                "text": "I have three empty coffee cans, two with prizes and one with a slip of paper that says \"Zonk.\""
                                            },
                                            {
                                                "example_id": "31a57b57-55a3-4d7e-923d-694803b6c29a",
                                                "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                                "text": "Avoid the Zonk / On the TV show Let's Make a Deal, contestants often had to choose between three curtains."
                                            },
                                            {
                                                "example_id": "07059ccb-94c9-4412-9193-651917f193f6",
                                                "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                                "text": "Once a contestant picked a door, Monty would often open one of the other two doors to reveal a zonk, […]"
                                            },
                                            {
                                                "example_id": "df525433-71fb-4cd9-bd11-c3744d6278ff",
                                                "sense_id": "bcd6c70e-afda-3819-b88c-9625e0de4990",
                                                "text": "Behind two doors is a “zonk,” that is, something amusing but of little or no value, such as a goat, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8393654a-6205-3578-8088-bb3a8516f059",
                                        "entry_id": "cf171079-8aac-36c7-b627-c3c94fa87e01",
                                        "glosses": [
                                            "The feeling of a drug taking hold."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0eea060c-9f32-38af-b4d8-f4ad34fe7f48",
                                        "entry_id": "cf171079-8aac-36c7-b627-c3c94fa87e01",
                                        "glosses": [
                                            "A cigarette hand-rolled from tobacco and cannabis."
                                        ],
