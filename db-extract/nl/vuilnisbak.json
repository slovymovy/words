                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a91387-026f-43f3-96eb-3e419acf2980",
                                "sense_id": "be4362a8-eb7b-3f20-91e3-4048d5d8fbd5",
                                "text": "Gooi dat maar even in de vuilnisbak."
                            }
                        ]
