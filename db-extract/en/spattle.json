                        "sense_id": "bf3449f2-2c1a-3e4d-90ee-a58da3778578",
                        "entry_id": "15c61ed6-5995-30e1-878f-ad0656eba4a1",
                        "glosses": [
                            "To sprinkle or spatter; to mottle."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "be9c3fd7-829c-45ad-99bb-ad1a57644580",
                                "sense_id": "bf3449f2-2c1a-3e4d-90ee-a58da3778578",
                                "text": "The windows […] were all shatter'd: about a foot square of the foundation seemed as if ramm'd in with a force that spattled the dirt as high as the Cornish : […]"
                            },
                            {
                                "example_id": "1bb2e671-8a0f-417d-b9ff-42cab6602ca2",
                                "sense_id": "bf3449f2-2c1a-3e4d-90ee-a58da3778578",
                                "text": "... spattled with nicotine, and measled with pricks from his hypodermic syringe."
                            }
                        ]
                    }
