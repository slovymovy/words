                                "sense_id": "90018ec2-1627-3b22-b386-ff9f51e40b60",
                                "text": "Gestern hat Claudia wieder ein Gedicht über Karthago verfasst."
                            },
                            {
                                "example_id": "94b12d59-67f4-48e6-b864-b1ceface1bf5",
