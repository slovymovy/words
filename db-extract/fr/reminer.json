                ],
                "translations": [
                    {
                        "translation_id": "c1155c7a-f6ce-40a1-8a56-a764346fb000",
                        "source_entry_id": "4690062e-e8d8-31a0-8fb3-fba25e8a6f04",
                        "source_sense_id": "9b251c63-7bfa-30ad-b515-82036706b707",
                        "target_lang_word": "remine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a785be49-0912-3d89-ba07-369bd6c608f3",
                                        "entry_id": "66c94ac8-b561-315d-b129-88c46d3f722c",
                                        "glosses": [
                                            "To mine again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf6d110-2209-41e5-ae23-8d708e9b04d9",
                                                "sense_id": "a785be49-0912-3d89-ba07-369bd6c608f3",
                                                "text": "Therefore, in these latter days some of the coal beds already mined over and ready to be abandoned have been found to carry rider coal above or bottom coal below, which can be removed at a profit. And, therefore, for the past few years the total production from several beds has been from such remining of top and bottom coal."
                                            },
                                            {
                                                "example_id": "6c72315a-b6b7-4607-9dd1-46d81f2d8514",
                                                "sense_id": "a785be49-0912-3d89-ba07-369bd6c608f3",
                                                "text": "Most areas to be remined have little or no usable topsoil since these materials were destroyed or contaminated by the previous mining operation."
                                            },
                                            {
                                                "example_id": "13917d51-82f3-435b-b24f-1961a21294ab",
                                                "sense_id": "a785be49-0912-3d89-ba07-369bd6c608f3",
                                                "text": "As a means to reduce the inventory of AML sites, Congress and state legislatures are examining proposals to encourage industry to remine and reclaim previously mined areas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
