                        "glosses": [
                            "Celui qui démystifie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "230ebac4-72d0-40f5-923a-54399d3c40d2",
                                "sense_id": "63077ad6-1e61-3bc9-a2aa-45465847c6b5",
                                "text": "Il est un réaliste, un critique, un démystificateur sans merci."
                            },
                            {
                                "example_id": "4f82ecdf-6c40-4856-8cc0-4caef6851fd8",
                                "sense_id": "63077ad6-1e61-3bc9-a2aa-45465847c6b5",
                                "text": "L’Histoire retiendra Donald Trump non seulement pour ses polémiques, mais aussi pour son rôle inattendu de démystificateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e85e919e-2794-4888-ab71-71a010c322eb",
                        "source_entry_id": "e1ef05be-53f0-3305-b80b-ecd4336884f9",
