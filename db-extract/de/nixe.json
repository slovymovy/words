                ],
                "senses": [
                    {
                        "sense_id": "a35e760c-1ae9-39b1-9127-ae2466f91601",
                        "entry_id": "2a6250cc-7390-3868-8574-17b38e3d7a47",
                        "glosses": [
                            "mythologischer, weiblicher Wassergeist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "825d4883-cab1-480c-88c0-91749b9490ae",
                                "sense_id": "a35e760c-1ae9-39b1-9127-ae2466f91601",
                                "text": "\"Charakteristisches Merkmal der Nixen ist, dass sie den Menschen Gefahr, Schaden und Tod bringen. Häufig betören bzw. verführen sie Männer und ziehen sie etwa auf den Grund von Flüssen und Seen.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a494c5a-87a8-3418-9d37-e0ae855c6896",
                        "entry_id": "2a6250cc-7390-3868-8574-17b38e3d7a47",
                        "glosses": [
                            "hübsche, badende Frau"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "15b1df94-59f5-4725-beb8-3546e74617b6",
                                "sense_id": "7a494c5a-87a8-3418-9d37-e0ae855c6896",
                                "text": "Die spärlich bekleideten Nixen vom Travemünder Badestrand trafen sich abends feingemacht in der Bar des Kasinos."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "806f7014-6e29-4fe1-809c-52608dfc03d6",
                        "source_entry_id": "2a6250cc-7390-3868-8574-17b38e3d7a47",
                        "source_sense_id": "a35e760c-1ae9-39b1-9127-ae2466f91601",
                        "source_sense_description": "Mythologie: mythologischer, weiblicher Wassergeist",
                        "target_lang_word": "mermaid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mermaid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6ecda0-c90a-3aeb-a55c-a1e37751ec38",
                                        "entry_id": "24164ad1-2877-3d47-b65b-3024bde1ab2c",
                                        "glosses": [
                                            "A mythological creature with a woman's head and upper body, and a tail of a fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b8fc3f-51cb-4228-9cbf-77e5dcb60458",
                                                "sense_id": "3b6ecda0-c90a-3aeb-a55c-a1e37751ec38",
                                                "text": "Search the depth, & ſee that variety of Sea monſters & fiſhes, Mare-maids, Sea men, Horſes, &c. which it affords."
                                            },
                                            {
                                                "example_id": "f493ec1f-03ef-40e4-a32a-43ffacf33882",
                                                "sense_id": "3b6ecda0-c90a-3aeb-a55c-a1e37751ec38",
                                                "text": "People that are drowned, and whose bodies are not founds are believed to have been taken into the dwellings of the Mermaids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa660681-060a-31e7-adca-368aa24bea05",
                                        "entry_id": "24164ad1-2877-3d47-b65b-3024bde1ab2c",
                                        "glosses": [
                                            "Coloured a brilliant turquoise."
                                        ],
                                        "tags": [
                                            "as a modifier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813e6647-ca14-45d8-aa8e-436c0aaeffab",
                                                "sense_id": "fa660681-060a-31e7-adca-368aa24bea05",
                                                "text": "a mermaid smoothie"
                                            },
                                            {
                                                "example_id": "e6b4bafb-a05a-4c68-af56-1ba584681ac8",
                                                "sense_id": "fa660681-060a-31e7-adca-368aa24bea05",
                                                "text": "mermaid ice-cream"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e816720-312a-3eb3-a53c-45842e43cfc3",
                                        "entry_id": "24164ad1-2877-3d47-b65b-3024bde1ab2c",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37489f4b-76f0-46e7-9478-9f5bc3c0d302",
                                                "sense_id": "0e816720-312a-3eb3-a53c-45842e43cfc3",
                                                "text": "A Gentleman or an honeſt Cittizen, ſhall not Sit in your pennie-bench Theaters, vvith his Squirrell by his ſide cracking nuttes; nor ſneake into a Tauerne vvith his Mermaid; but he ſhall be Satyr'd and Epigram'd vpon, and his humour muſt run vpo'th Stage: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55f25dec-b365-4c78-919d-4be01f5035d2",
                        "source_entry_id": "2a6250cc-7390-3868-8574-17b38e3d7a47",
                        "source_sense_id": "a35e760c-1ae9-39b1-9127-ae2466f91601",
                        "source_sense_description": "Mythologie: mythologischer, weiblicher Wassergeist",
                        "target_lang_word": "nixe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nixe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f679fa8-472c-3630-9b58-9d0eb801d46f",
                                        "entry_id": "99de0179-fcea-3b32-8a1e-bfdf375816a3",
                                        "glosses": [
                                            "Nom allemand des ondines ; nymphe ou génie des eaux dans la mythologie germanique."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08561023-5e8e-4bf5-b400-e53fa70887b2",
                                                "sense_id": "2f679fa8-472c-3630-9b58-9d0eb801d46f",
                                                "text": "Si vous aimez les sortilèges, venez par un beau clair de lune d’une nuit de mai évoquer la nixe de Vaucluse, et peut-être à votre appel la verrez-vous sortir de cet abîme de cristal qui lui sert de palais."
                                            },
                                            {
                                                "example_id": "a4793c99-e485-46ae-9342-bd94e6f44318",
                                                "sense_id": "2f679fa8-472c-3630-9b58-9d0eb801d46f",
                                                "text": "Pour les Grecs, le monde et la vie étaient nés dans l’eau. C’était un dieu, Okéanos. Plus tard, on inventa les nixes, les elfes, les ondines, les nymphes."
                                            },
                                            {
                                                "example_id": "58281579-2350-465f-beb5-cc344469e3c8",
                                                "sense_id": "2f679fa8-472c-3630-9b58-9d0eb801d46f",
                                                "text": "Mais des arbres étonnants, à troncs et à branches vert pâle, me regardent, comme des nixes, entre les yeux…"
                                            },
                                            {
                                                "example_id": "36992112-c772-4510-b525-b7da3d8e04d6",
                                                "sense_id": "2f679fa8-472c-3630-9b58-9d0eb801d46f",
                                                "text": "Ne voulant surtout pas être dérangé dans ses rêves de conquêtes, il s’arrangea pour que Ténélande demeure isolée du reste du monde. Pour cela, il fit alliance avec les nixes et employa une puissante magie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "614488d5-b54a-47cc-bf4d-f38ff4856fb4",
                        "source_entry_id": "2a6250cc-7390-3868-8574-17b38e3d7a47",
                        "source_sense_id": "a35e760c-1ae9-39b1-9127-ae2466f91601",
                        "source_sense_description": "Mythologie: mythologischer, weiblicher Wassergeist",
                        "target_lang_word": "ondine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ondine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                        "entry_id": "a11609e0-c760-360e-8f3e-fdc4e69b8dff",
                                        "glosses": [
                                            "Génie féminin des eaux dans la mythologie germanique. (Le masculin ondin est beaucoup plus rare.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3e2dfc-3bbc-4c6e-9ab5-c1f70e43145a",
                                                "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                                "text": "Tour à tour ondine ou sylphide, cette fluide créature voltigeait dans les airs."
                                            },
                                            {
                                                "example_id": "9adabc54-1e46-4d3d-a4ff-aa7755306ef3",
                                                "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                                "text": "Ce n’étaient plus un petit bûcheron et une petite pêcheuse, — mais un Sylphe et une Ondine, lesquels, plus tard, furent unis légitimement."
                                            },
                                            {
                                                "example_id": "6f57ff7b-693a-43bb-8f53-0081bd184bf1",
                                                "sense_id": "966a86a8-a92f-309c-b7d2-45ef53154093",
                                                "text": "Triomphe des êtres fantastiques masculins ! Manifestement les sirènes et les ondines n’ont guère eu d’influence ! Cependant voici dans la région de Saint-Hubert et de Virton de quoi sauver l’honneur féminin : là, c’est Marie Crochet qui vous attirera dans l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a98e300-a9fa-3614-85f2-2122b3ab2844",
                                        "entry_id": "a11609e0-c760-360e-8f3e-fdc4e69b8dff",
                                        "glosses": [
                                            "Créature mythique représentée avec un torse humain et une queue de poisson ; sirène."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aac3b633-d51e-3142-a8b2-b25da8a553d1",
                                        "entry_id": "a11609e0-c760-360e-8f3e-fdc4e69b8dff",
                                        "glosses": [
                                            "Jolie baigneuse."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
