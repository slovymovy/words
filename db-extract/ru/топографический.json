                    {
                        "translation_id": "a5970095-1e0b-4608-ab5f-6bb785a65042",
                        "source_entry_id": "77e61dbc-71a7-3c85-8b6c-f45ebd452161",
                        "source_sense_id": "c394006a-1014-33df-b311-fe02f30d44f8",
                        "target_lang_word": "topographical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topographical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0a6099-85b1-3d8e-8028-33dade42fef1",
                                        "entry_id": "fb498def-b17f-3826-9c8d-3d6d28c6364e",
                                        "glosses": [
                                            "topographic"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ed4117-1a1e-4c54-98ae-144396e7828b",
                                                "sense_id": "aa0a6099-85b1-3d8e-8028-33dade42fef1",
                                                "text": "Edward asked a few topographical questions, and set forth without the old man, who seemed infinitely to prefer finishing his attendance on his carnations."
                                            },
                                            {
                                                "example_id": "384ce5f4-0937-469b-a9be-4e67a1946b6e",
                                                "sense_id": "aa0a6099-85b1-3d8e-8028-33dade42fef1",
                                                "text": "Firstly, Japan is in such a topographical condition and technical restriction as to make it impossible to adopt the use of machinery upon such an extensive scale as is emphasized by Marxist agriculturism."
                                            }
