                        "entry_id": "2544c6fb-6abc-33a3-b05d-29891543bea7",
                        "glosses": [
                            "Nom donné à un modèle de mobylette, de couleur bleu ciel."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "dcd53bad-e637-45be-87df-3c7af09086af",
                                "sense_id": "55b330d0-af56-3174-955f-6df9cc241b2e",
                                "text": "Plus de quarante-cinq ans après avoir été présentée dans sa première version, en 1956, la dernière bleue vient de sortir de la chaîne de son usine historique, à Rouvroy, près de Saint-Quentin."
                            }
                        ]
                    }
                ],
