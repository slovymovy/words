                        "sense_id": "f695fb01-755d-3c51-8499-206ec1c84077",
                        "entry_id": "6ea707fb-5ccd-37f5-a22e-964f4824f280",
                        "glosses": [
                            "Savant qui s’occupe de la langue et de l’histoire celtiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0b11d1-fddd-4b58-b7e6-3da331224cff",
                                "sense_id": "f695fb01-755d-3c51-8499-206ec1c84077",
                                "text": "M. Nigra s’est fait une place honorable parmi les celtisants les plus distingués de notre époque."
                            },
                            {
                                "example_id": "40f9d153-db43-4d6d-93d7-9e383712fa6f",
                                "sense_id": "f695fb01-755d-3c51-8499-206ec1c84077",
                                "text": "– Avec Eoin Mac Neill, vous êtes le premier celtisant du monde."
                            },
                            {
                                "example_id": "65ae4ca7-a58d-4388-b094-b925ff15de05",
                                "sense_id": "f695fb01-755d-3c51-8499-206ec1c84077",
                                "text": "– Deux aussi illustres celtisants ne sauraient s’ignorer."
                            }
                        ]
                    }
