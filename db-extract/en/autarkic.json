                "senses": [
                    {
                        "sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                        "entry_id": "b8656677-abf8-3e44-b1c2-d61c31487008",
                        "glosses": [
                            "Pertaining to an autarky; self-sufficient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9089cea-30fd-4538-bbc6-239945c5bd04",
                                "sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                                "text": "The countryside, in short, was becoming more archaic and more autarkic."
                            },
                            {
                                "example_id": "e878ad6d-cdda-4a10-b427-edb75b5a0315",
                                "sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                                "text": "Fascists had no particular economic doctrine aside from preparing for war. They wanted to build autarkic economies that could withstand blockade and did not rely on foreign trade except for bilateral deals with weaker countries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1e42f37-1176-4b11-b65d-ccb3be04e931",
                        "source_entry_id": "b8656677-abf8-3e44-b1c2-d61c31487008",
                        "source_sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                        "source_sense_description": "self-sufficient",
                        "target_lang_word": "soběstačný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3748b739-fa1e-4784-81b8-1847191071d7",
                        "source_entry_id": "b8656677-abf8-3e44-b1c2-d61c31487008",
                        "source_sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                        "source_sense_description": "self-sufficient",
                        "target_lang_word": "autark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f567aed-873e-307f-9e76-fd11f2983a23",
                                        "entry_id": "508431a0-055f-39e6-9498-a60260c71ba1",
                                        "glosses": [
                                            "insbesondere von der ausländischen Wirtschaft unabhängig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5fc33b-d75e-447c-a032-1a0a9aa13c4b",
                                                "sense_id": "5f567aed-873e-307f-9e76-fd11f2983a23",
                                                "text": "„Als Schutzmaßnahme [westlicher Sanktionen gegen Russland] propagiert die russische Führung das Ziel, autark zu werden. Sie möchte ein eigenes Zahlungssystem aufbauen, um dem Griff der US-Kreditkartenunternehmen zu entkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f4c2e1cf-42ec-3109-9462-3713514e92c1",
                                        "entry_id": "508431a0-055f-39e6-9498-a60260c71ba1",
                                        "glosses": [
                                            "von äußeren Einflüssen unabhängig"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9201a3d-4c72-4d3f-b11a-558f6a904d78",
                                                "sense_id": "f4c2e1cf-42ec-3109-9462-3713514e92c1",
                                                "text": "Wir streben eine autarke Stromversorgung an."
                                            },
                                            {
                                                "example_id": "fce8b3e7-2c3b-4930-96f1-44e3d35e545e",
                                                "sense_id": "f4c2e1cf-42ec-3109-9462-3713514e92c1",
                                                "text": "Die Systeme arbeiten vollständig autark, sind nicht mit dem öffentlichen Netz verbunden und gewährleisten so die Energieversorgung in ländlichen Regionen."
                                            },
                                            {
                                                "example_id": "a6a91d1e-e45a-44dd-affe-74f91017045f",
                                                "sense_id": "f4c2e1cf-42ec-3109-9462-3713514e92c1",
                                                "text": "„Ihr Traum war ein Land aus autarken Kommunen (gar nicht so anders als die der amerikanischen Hippies in den Sechzigerjahren).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
