                "senses": [
                    {
                        "sense_id": "0cdc5e1a-3853-3ac4-8547-b7362cf4bb53",
                        "entry_id": "c3e4bf6a-f17d-3177-b62a-57d630eca120",
                        "glosses": [
                            "Phase des Aufbaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ab862e-7904-4635-804b-1b54e5350f22",
                                "sense_id": "0cdc5e1a-3853-3ac4-8547-b7362cf4bb53",
                                "text": "„Wie Forschung und Lehre im internationalen Vergleich abschneiden, werde sich deshalb erst in den nächsten Jahren herausstellen. Uni.lu-Vize-Direktor Jean-Paul Lehners: \"Wir wollen den Europäischen Bürger\" © B. Schlüter BILD. Noch hat die junge Luxemburger Universität die Aufbauphase noch nicht hinter sich gelassen. Doch schon jetzt kümmert sie sich um Weichenstellungen für ihre Zukunft.“"
                            },
                            {
                                "example_id": "b3a535e5-bfe7-4d36-bf88-15392d44aee6",
                                "sense_id": "0cdc5e1a-3853-3ac4-8547-b7362cf4bb53",
                                "text": "„Der Hobby-Motorradfahrer war von 1993 bis 1996 Aufsichtsratsvorsitzender der DSD AG und begleitete damals die Aufbauphase des Unternehmens.“"
                            }
                        ],
