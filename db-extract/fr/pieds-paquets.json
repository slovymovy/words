                        "sense_id": "94f44a54-3a73-32d1-b11c-c3966d1b82df",
                        "entry_id": "4ffe7d45-3403-3be4-bf1d-b0e4aff9638b",
                        "glosses": [
                            "Plat composé de pieds de porc et d’estomac de mouton, découpés et roulés en forme de paquets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93bc15f3-11a0-4688-a189-bfb5ac966fd3",
                                "sense_id": "94f44a54-3a73-32d1-b11c-c3966d1b82df",
                                "text": "Ça me rappelle le vieux port marseillais, les marchandes de coquillages, les pieds-paquets et le vin de Cassis, doré comme du soleil."
                            },
                            {
                                "example_id": "6a8c5b71-3508-42af-abe4-5db48b9ee323",
                                "sense_id": "94f44a54-3a73-32d1-b11c-c3966d1b82df",
                                "text": "De là on va à la Pomme, où se fabriquent les pieds-paquets, dont la réputation survit à tous les orages."
                            },
                            {
                                "example_id": "d887faad-6577-4821-9b09-171a4bf1da82",
                                "sense_id": "94f44a54-3a73-32d1-b11c-c3966d1b82df",
                                "text": "Les pieds-paquets sont une des gloires de la cuisine marseillaise. Ils ont fait la renommée gastronomique du village de La Pomme, situé dans la proche banlieue de Marseille, où on avait coutume d'aller les manger."
                            }
                        ]
                    }
