                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b9d13b0-e81d-46ef-8e32-c34a11e7df97",
                        "source_entry_id": "2d0c6fbc-789d-345f-925f-5cea994ac056",
                        "source_sense_id": "e79b77f5-2769-3dc2-8965-2fca5d8d4573",
                        "target_lang_word": "duchowieństwo",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duchowieństwo",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "42ea9527-5655-3bc9-b497-fa70d64d51a4",
                                        "entry_id": "1c03f24f-5fda-3085-adce-3087a6903f5f",
                                        "glosses": [
                                            "ogół duchownych danego kościoła lub wspólnoty religijnej, stan duchowny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0aa188-9039-4feb-bda0-f3c8281b6485",
                                                "sense_id": "42ea9527-5655-3bc9-b497-fa70d64d51a4",
                                                "text": "Część szczególna dotycząca duchowieństwa została poświęcona zagadnieniom związanym z pełnieniem funkcji papieża, biskupa, proboszcza, wikariusza, zakonnika czy nauczyciela religii."
                                            },
                                            {
                                                "example_id": "a5747bf9-2215-44d3-b845-135db36bf835",
                                                "sense_id": "42ea9527-5655-3bc9-b497-fa70d64d51a4",
                                                "text": "Wykład był poświęcony roli duchowieństwa żydowskiego w czasie powstania styczniowego."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ae6653b-ce4e-461a-b159-d19fcae0ba39",
                        "source_entry_id": "2d0c6fbc-789d-345f-925f-5cea994ac056",
                        "source_sense_id": "e79b77f5-2769-3dc2-8965-2fca5d8d4573",
                        "target_lang_word": "clergé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clergé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                        "entry_id": "ca3f8748-246e-3161-853c-21f97f504a87",
                                        "glosses": [
                                            "Corps des ecclésiastiques, organisé selon une hiérarchie ecclésiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0774032-7512-476f-827a-26d7808cec9b",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "Pour lancer contre nous ces furieux prédicateurs, il faut que les chefs du clergé se soient sentis bien atteints."
                                            },
                                            {
                                                "example_id": "fec042ec-e81e-4da5-a6b5-6da3f22a90b3",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "Dans ce marais stagnant s’étend le filet ecclésiastique. Les vieilles dames, les pères devenus conservateurs avec l’âge, font des legs au clergé. Nulle excitation, nul renouvellement d’esprit : le culte avec ses pompes, l’habitude, le poids de la tradition, la litanie solennelle indéfiniment répétée, les ramènent à la vieille routine."
                                            },
                                            {
                                                "example_id": "b70f8463-0222-4833-85fd-5a8fd0ba642d",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "[…] elle provoque souvent la conversion au judaïsme de membres du Clergé, tel ce Wicelinius, aumônier du duc Conrad de Metz, et qui, une fois devenu juif (vers l'an 1000), écrivit un pamphlet contre le christianisme."
                                            },
                                            {
                                                "example_id": "61cf611e-2e5c-4d2a-81d8-7b3cfdf9972b",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "Je suis certaine qu’elle a vu clairement ce clergé stupide, incapable de véritable amour, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68263012-734b-3db1-a759-f9f32977fc71",
                                        "entry_id": "ca3f8748-246e-3161-853c-21f97f504a87",
                                        "glosses": [
                                            "Corps particulier des ecclésiastiques desservant d’une église, d’un chapitre cathédral ou d’une paroisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f4c9cc-2703-4c80-82f9-ed67118b0c0c",
                                                "sense_id": "68263012-734b-3db1-a759-f9f32977fc71",
                                                "text": "Vous pensez bien, dit-il, que la nomination d’un chanoine étranger au diocèse n’a pas été considérée d’un œil indifférent par le clergé de Chartres."
                                            },
                                            {
                                                "example_id": "fc1ee7af-0b84-4b11-a74e-d0883b9d084e",
                                                "sense_id": "68263012-734b-3db1-a759-f9f32977fc71",
                                                "text": "Le curé y assistait avec tout son clergé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
