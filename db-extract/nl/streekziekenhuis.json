                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fecbc632-05c9-4b55-a1ae-50581ef6a479",
                                "sense_id": "a0805869-4388-3ea4-afaf-648f7ed937ee",
                                "text": "Zoals veel dames die in het district aan liefdadigheid deden, hielp Lara sinds het begin van de oorlog zoveel ze kon in het hospitaal dat bij het streekziekenhuis van Joerjatin was opgezet."
                            },
                            {
                                "example_id": "a04fc9ed-aee2-450f-9499-c407235652bf",
                                "sense_id": "a0805869-4388-3ea4-afaf-648f7ed937ee",
                                "text": "Het Maasziekenhuis in Boxmeer is voorlopig uit de problemen. Een andere verdeling van de zorg moet ertoe leiden dat het streekziekenhuis voldoende patiënten houdt en daardoor kan blijven voortbestaan."
                            }
                        ]
