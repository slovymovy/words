                                        "sense_id": "a1205fe2-1294-3b1b-866c-112b356240f7",
                                        "entry_id": "adaf7c6c-7dbf-38d6-9f36-192da57ea31d",
                                        "glosses": [
                                            "A temporary wooden fortification with a projecting upper storey."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01b3ea51-52df-4f28-bc32-b4eaa0e30f6f",
                                                "sense_id": "a1205fe2-1294-3b1b-866c-112b356240f7",
                                                "text": "We had soon touched land in the same place as before and set to provision the blockhouse. All three made the first journey, heavily laden, and tossed our stores over the palisade."
                                            }
                                        ]
                                    }
                                ]
                            }
