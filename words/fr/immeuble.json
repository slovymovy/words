                    "semantic_group_id": "bâtiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'habite au troisième étage d'un bel <w>immeuble</w> ancien au centre de la ville."
                        },
                        {
                            "text": "Le facteur dépose tous les matins le courrier dans le hall de l'<w>immeuble</w>."
                        }
