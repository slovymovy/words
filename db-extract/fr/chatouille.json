        "fr-extract.jsonl": [
            {
                "entry_id": "aa08dbef-d3ef-38b5-947c-81a4487f7c70",
                "word": "chatouille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "49da4bc5-c1db-4100-8b65-0d3399ed4a7b",
                        "entry_id": "aa08dbef-d3ef-38b5-947c-81a4487f7c70",
                        "tags": [
                            "plural"
                        ],
                        "form": "chatouilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9bb28c4-39ae-36ad-9b27-c215b99b5b41",
                        "entry_id": "aa08dbef-d3ef-38b5-947c-81a4487f7c70",
                        "glosses": [
                            "Chatouillement, chatouillis."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "01417198-4c93-4370-a9d2-00e4350f8999",
                                "sense_id": "c9bb28c4-39ae-36ad-9b27-c215b99b5b41",
                                "text": "Heureusement qu’elle mettait son expérience du corps humain à sa disposition, et elle savait, dans les cas importants, comment on fait des chatouilles sous la mamelle gauche d’un amoureux ou d’une amoureuse."
                            },
                            {
                                "example_id": "bbe1165a-8bd4-4bcd-ac00-0b47288b393c",
                                "sense_id": "c9bb28c4-39ae-36ad-9b27-c215b99b5b41",
                                "text": "Et que se passe-t-il, au laboratoire, lorsqu’une chatouille au creux de la main est provoquée par les mouvements d’une plume tenue par une petite machine robot ?"
                            },
                            {
                                "example_id": "0de7117e-9b30-4139-ac57-2f7b30ed80f3",
                                "sense_id": "c9bb28c4-39ae-36ad-9b27-c215b99b5b41",
                                "text": "C’est pourquoi une chatouille un peu brusque le déconcerte. L’appréhension trop grande n’est donc pas favorable au rire."
                            },
                            {
                                "example_id": "f88160ea-e1d8-4f0c-b23c-1d0a74de8368",
                                "sense_id": "c9bb28c4-39ae-36ad-9b27-c215b99b5b41",
                                "text": "Tu la sens pas, la peur, assise sur ton cou et qui te fait des chatouilles le long du dos ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "860a91b3-14ef-4b57-b81e-662fbfa15de8",
                        "source_entry_id": "aa08dbef-d3ef-38b5-947c-81a4487f7c70",
