                            {
                                "example_id": "ab6bfb2c-0592-4536-b711-0ba23beac50e",
                                "sense_id": "af4b7e11-b8e2-3774-8431-7f58bb17a475",
                                "text": "„Courts Nahkampfkünste gewannen schnell die Oberhand, und er verpasste dem unter ihm Liegenden einen Kinnhaken und rammte dessen Hinterkopf gegen den Hartholzboden.“"
                            },
                            {
                                "example_id": "74e16b0a-5c51-4e01-afea-7c2aa49f9b0e",
                                "sense_id": "af4b7e11-b8e2-3774-8431-7f58bb17a475",
                                "text": "„Glänzende Hartholzböden bildeten den Kontrast zu weißen Wänden, an denen in großzügigen Abständen gerahmte Drucke von expressionistischen Werken hingen.“"
                            }
                        ],
