                        "glosses": [
                            "chinesische Provinz im Südwesten der Volksrepublik China"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0aef78-5b9b-435e-aedb-5ff70f3a09ac",
                                "sense_id": "9beaabbb-abd5-34fa-98ec-60ca7a142d50",
                                "text": "Guiyang ist die Hauptstadt von Guizhou."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6b14a6c-f540-49a4-9e6f-718dfe2fe98f",
                        "source_entry_id": "f3fa82aa-2c96-3655-bb5b-abdebcc65a45",
                        "source_sense_id": "9beaabbb-abd5-34fa-98ec-60ca7a142d50",
                        "source_sense_description": "chinesische Provinz im Südwesten der Volksrepublik China",
                        "target_lang_word": "Guizhou",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guizhou",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90e73013-0b4b-35e7-ba18-a23e2fb84751",
                                        "entry_id": "c36e9f83-d0b5-3aa6-bcbb-e5547db66499",
                                        "glosses": [
                                            "A province in southwestern China. Capital: Guiyang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71839523-ce2b-465d-9e2b-e4b6a18a014a",
                                                "sense_id": "90e73013-0b4b-35e7-ba18-a23e2fb84751",
                                                "text": "The siblings lived in a house in Guizhou Province, one of the poorest areas in China; their village, Cizhu, is under the administration of the city of Bijie."
                                            },
                                            {
                                                "example_id": "395c1a44-b239-4efc-a4f1-94a48f0f61c3",
                                                "sense_id": "90e73013-0b4b-35e7-ba18-a23e2fb84751",
                                                "text": "Over the weekend, engineers in China's mountainous southwestern Guizhou province linked the two ends of a bridge spanning a rocky gorge. The completion of the Beipanjiang bridge marks yet another infrastructure record in China — the world's \"highest\" bridge, sitting 1,854 feet above the river below."
                                            },
                                            {
                                                "example_id": "dd88912d-5e38-4124-ac1f-ed7d89a7a580",
                                                "sense_id": "90e73013-0b4b-35e7-ba18-a23e2fb84751",
                                                "text": "A mudslide in the south-western province of Guizhou has resulted in 15 deaths. Thirty people are still missing as the search continues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c6f0609-65ea-4c37-8313-9a4005464eb5",
                        "source_entry_id": "f3fa82aa-2c96-3655-bb5b-abdebcc65a45",
                        "source_sense_id": "9beaabbb-abd5-34fa-98ec-60ca7a142d50",
                        "source_sense_description": "chinesische Provinz im Südwesten der Volksrepublik China",
                        "target_lang_word": "Kweichow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kweichow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e38bcc9-8602-3362-8f31-6987956e0027",
                                        "entry_id": "d5936f7c-fa16-3826-b654-ab3e2bf29301",
                                        "glosses": [
                                            "Alternative form of Guizhou."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98038f59-da8d-454d-a49c-70b7d5627420",
                                                "sense_id": "7e38bcc9-8602-3362-8f31-6987956e0027",
                                                "text": "\"Famine conditions continue to be reported in Honan, Anhui, Shensi, Kansu, Szechuan, and Kweichow. Quite evidently the country faces one of the most severe famines of many years, and thousands have already died. A recent survey by the Szechuan Famine Relief Commission discovered that 30,000,000 people are now in the famine belt of that province, where bark and 'Goddess-of-Mercy' earth are being consumed by tens of thousands. There are said to be over 400,000 famine refugees in Shensi, over a million in Kansu, some 7,000,000 in Honan, and 3,000,000 in Kweichow. The famine in Kweichow is admitted by the official Central News to be the most serious in 100 years, affecting sixty districts of the province.\""
                                            },
                                            {
                                                "example_id": "0fbece32-3e20-4823-85c7-b91a772fc0fd",
                                                "sense_id": "7e38bcc9-8602-3362-8f31-6987956e0027",
                                                "text": "The first i-hsüeh (charity schools) were started in 1702, when the Board of Rites received imperial approval to establish them outside the Ch'ung-wen gate of the imperial city. Three years later similar institutions were authorized for Kweichow province for the benefit of the \"sons and younger brothers\" of the chieftains of tribal groups."
                                            },
                                            {
                                                "example_id": "bccdacc4-e568-417a-a5d9-907d2ca0fc1f",
                                                "sense_id": "7e38bcc9-8602-3362-8f31-6987956e0027",
                                                "text": "The Peking radio said today that Mao Tse-tung's forces had gained control of a fifth major city, Kweiyang, the capital of Kweichow Province."
                                            },
                                            {
                                                "example_id": "2ac21ad8-41e3-457c-afe2-c4ce0dd14c22",
                                                "sense_id": "7e38bcc9-8602-3362-8f31-6987956e0027",
                                                "text": "\"Radio Kweichow\" reported April 1 that high officials and cadres of Kweichow province had met to discuss \"the crimes of the gang of four and their black agents in the Kweichow province for the damage they had done to the railways and social order.\""
                                            },
                                            {
                                                "example_id": "d3a1b3a4-980e-4c30-a320-6852ba1b8fa1",
                                                "sense_id": "7e38bcc9-8602-3362-8f31-6987956e0027",
                                                "text": "Prof. Liu's family was from Kuei-yang in Kweichow, China, and he grew up in Shanghai."
                                            },
                                            {
                                                "example_id": "0c0fb5ca-313d-43fd-9688-7cce0a63081b",
                                                "sense_id": "7e38bcc9-8602-3362-8f31-6987956e0027",
                                                "text": "I ordered a bottle of Kweichow Moutai from 1927, a liquor made from sorghum that people say is the most expensive Chinese beverage ever made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
