                ],
                "senses": [
                    {
                        "sense_id": "49eaf762-bb5d-3531-bcd2-5bb3ed6713e4",
                        "entry_id": "aa58151a-8295-3684-bf39-bbae9bfd31f6",
                        "glosses": [
                            "quadratische Fußplatte von Säulen, Pfeilern und Statuen oder ganzen Gebäuden"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3e5dd19f-41da-478d-a9a1-422ca1ccc80a",
                                "sense_id": "49eaf762-bb5d-3531-bcd2-5bb3ed6713e4",
                                "text": "„Durch die Plinte erhalten Mauern ebenfalls eine Verstärkung in Absicht ihrer Stabilität, weil dadurch die Grundfläche breiter und der Abstand des Schwerpunktes von derselben geringer wird.“"
                            },
                            {
                                "example_id": "d4b44f11-3fba-43ff-a6d8-14d7dc4edb71",
                                "sense_id": "49eaf762-bb5d-3531-bcd2-5bb3ed6713e4",
                                "text": "„Das Schwerpunkt des auf der Plinte stehenden Mauertheiles liegt in der Mitte der Durchschnittsfigur efgl […].“"
                            },
                            {
                                "example_id": "7d84ede9-8ccf-47ef-8b00-384d819d6478",
                                "sense_id": "49eaf762-bb5d-3531-bcd2-5bb3ed6713e4",
                                "text": "„Dem Plane gemäß folgt jetzt die Berechnung der erforderlichen Materialien und der Mauerarbeit über ein zu erbauendes Amts-Haus von 90 Fuß lang, 44 Fuß tief, einer Etage von 11 Fuß hoch, mit einem Souterrain, welches exclusive des erstern Banquets 4 1/4 Fuß in und 5 Fuß über der Erde, incl. der Plinte, Höhe enthält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
