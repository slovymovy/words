                "senses": [
                    {
                        "sense_id": "fe3d2951-137d-3da4-9012-e560b349f7ea",
                        "entry_id": "683992b5-f70c-3f0b-8a25-04561c197c5e",
                        "glosses": [
                            "In a tangential manner or direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d592e9fc-46d3-41a3-a3d4-264459504dfc",
                                "sense_id": "fe3d2951-137d-3da4-9012-e560b349f7ea",
                                "text": "Rift sawn planks shrink about one half of those cut tangentially, due to the restraining action of medullary rays. Also, rift sawn timber gives a harder wearing surface than the other and hence these may be used in flooring and other locations subjected to abrasive actions."
                            },
                            {
                                "example_id": "9c6a2940-3b39-42f3-8db2-0c7934adf191",
                                "sense_id": "fe3d2951-137d-3da4-9012-e560b349f7ea",
                                "text": "And while cellphones are at least experientially related to the land line, and e-mail feels tangentially related to the fax, texting is simultaneously a throwback to the telegraph and a harbinger of a new age."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f89d9c5-db0a-4590-b455-a13c179ea865",
                        "source_entry_id": "683992b5-f70c-3f0b-8a25-04561c197c5e",
                        "source_sense_id": "fe3d2951-137d-3da4-9012-e560b349f7ea",
                        "source_sense_description": "in a tangential manner or direction",
                        "target_lang_word": "ко́свенно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ко́свенно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e3524f55-1a35-3a46-a0b2-8a0c4db992c2",
                                        "entry_id": "4b43c870-e274-3e98-aa83-92678bf75e87",
                                        "glosses": [
                                            "не прямо, не непосредственно; окольным путём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87914a73-b63e-4998-8928-a6adc8dce837",
                                                "sense_id": "e3524f55-1a35-3a46-a0b2-8a0c4db992c2",
                                                "text": "Это я его подуськал косвенно, можете себе представить."
                                            },
                                            {
                                                "example_id": "d591f6ba-da52-4ab6-840b-a436700d4eb8",
                                                "sense_id": "e3524f55-1a35-3a46-a0b2-8a0c4db992c2",
                                                "text": "Я же, под видом любезности в день рождения, изреку наконец свою волю, ― косвенно, не прямо, но будет всё как бы и прямо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2f0cf53-7324-3aa6-826c-e626e560a316",
                                        "entry_id": "4b43c870-e274-3e98-aa83-92678bf75e87",
                                        "glosses": [
                                            "устар. наискось, косо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1a73b3-e4f4-4b68-a4c1-3d6ed1172866",
                                                "sense_id": "d2f0cf53-7324-3aa6-826c-e626e560a316",
                                                "text": "Анатомия показывает, что на шее эти нечувствительные места свободны от косых и других волокон задних корешков, внизу же волокна корешков идут сильно косвенно вверх и вниз и потому свободных от них мест нет вовсе."
                                            },
                                            {
                                                "example_id": "da1e0cfc-81dc-4e52-a870-1460ff73c4b6",
                                                "sense_id": "d2f0cf53-7324-3aa6-826c-e626e560a316",
                                                "text": "Путешественники, остановившись среди полей, избирали ночлег, раскладывали огонь и ставили на него котел, в котором варили себе кулиш; пар отделялся и косвенно дымился на воздухе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
