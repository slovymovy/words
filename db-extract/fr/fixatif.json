                    {
                        "sense_id": "dcecaa91-3d3e-38c1-bfd7-52fc3a3ec14a",
                        "entry_id": "69cc98a9-0c7b-353d-8778-609ad0577d6e",
                        "glosses": [
                            "Produit en gel ou vaporisé qui fixe une coiffure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d890a17-bbf9-4e5e-9a53-9295278a70ac",
                                "sense_id": "dcecaa91-3d3e-38c1-bfd7-52fc3a3ec14a",
                                "text": "Alain travaille tout de suite à se refaire une beauté, autrement dit se colle la chevelure avec un fixatif rose, après quoi il paraît plutôt content de lui-même."
                            },
                            {
                                "example_id": "b0d4f4df-f597-40e6-a84d-63b0c36c8786",
                                "sense_id": "dcecaa91-3d3e-38c1-bfd7-52fc3a3ec14a",
                                "text": "Si je veux donner une certaine apparence à mes cheveux, je devrai peut-être utiliser du fixatif."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f06507b-52fb-3504-8943-79ddd7008aed",
                        "entry_id": "69cc98a9-0c7b-353d-8778-609ad0577d6e",
                        "glosses": [
                            "Substance qui fixe un dessin lorsque les pigments sont sous forme de poudre."
                        ],
                        "tags": [
                            "Dessin"
                        ],
                        "examples": [
                            {
                                "example_id": "b3f6355b-9a0e-4002-98bd-62b2867c058d",
                                "sense_id": "1f06507b-52fb-3504-8943-79ddd7008aed",
                                "text": "Le fixatif stabilise les pigments du fusain ou du pastel sur le support."
                            }
                        ]
                    }
