                        "glosses": [
                            "A French male choral society."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40817ff2-271b-4948-b0c6-7964420a119a",
                                "sense_id": "a0dee717-41e4-375e-88a5-877f07b28b4f",
                                "text": "It was but a short step, therefore, from the harmony of the orphéons to an ideal of harmony in the workshops and factories, and within the social body as a whole."
                            },
                            {
                                "example_id": "4d086854-fc40-4e21-a7f1-be8e9b5c9535",
                                "sense_id": "a0dee717-41e4-375e-88a5-877f07b28b4f",
                                "text": "Every orphéon had its emblems, uniforms (an expression of uniformity, as in schools), banners, medals, conviviality, and shared memories."
                            },
                            {
                                "example_id": "84f09b81-ff9c-467c-9213-087a5d3cf7aa",
                                "sense_id": "a0dee717-41e4-375e-88a5-877f07b28b4f",
                                "text": "For example, the orphéon of Algiers is recounted to have had, at one point, approximately 600 members."
                            }
                        ]
                    }
