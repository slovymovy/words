                                            {
                                                "example_id": "f99259f6-fcdd-4325-8c0a-00a69a7239e7",
                                                "sense_id": "f36145a9-5b36-3702-9f8d-7b02d3452c4a",
                                                "text": "This wall is made of bricks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8003fcee-00ff-388b-9c16-bf204e35034b",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "Such hardened mud, clay, etc. considered collectively, as a building material."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe5cb30-8a2e-47a5-b86d-61ed74f8461a",
                                                "sense_id": "8003fcee-00ff-388b-9c16-bf204e35034b",
                                                "text": "This house is made of brick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d94c91bd-cf31-3431-8ff5-447166a3bd6e",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "Something shaped like a brick."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eab05e3-a8dc-41dd-a109-801de66fdd0b",
                                                "sense_id": "d94c91bd-cf31-3431-8ff5-447166a3bd6e",
                                                "text": "a plastic explosive brick"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c19a1c03-2781-3504-8004-f218422ae247",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "The colour brick red."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cecb67b1-c3eb-40ac-9cbd-4722bd015f57",
                                                "sense_id": "c19a1c03-2781-3504-8004-f218422ae247",
                                                "text": "The handyman considered the question and I knew she had a brick of ground beans in her bag but was considering whether the beds and a hot drink was worth a brick of coffee."
                                            },
                                            {
                                                "example_id": "b67cea50-4881-4eb5-8de2-e954d2b11769",
                                                "sense_id": "c19a1c03-2781-3504-8004-f218422ae247",
                                                "text": "He disentangled himself from the safe door and delved inside. He brought out a brick of banknotes."
                                            },
                                            {
                                                "example_id": "4139403f-a16b-462a-9465-22e396ae1cfe",
                                                "sense_id": "c19a1c03-2781-3504-8004-f218422ae247",
                                                "text": "A few times, when I got tired of my whisky highs and tobacco fumes, I turned to my new little helper, the tiny brick of cannabis resin I got from Don."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4cd7b8-b096-3036-8889-2e57371c0201",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "A helpful and reliable person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17eb5d3e-314d-4542-a020-28b58e8fc20f",
                                                "sense_id": "0d4cd7b8-b096-3036-8889-2e57371c0201",
                                                "text": "Thanks for helping me wash the car. You’re a brick."
                                            },
                                            {
                                                "example_id": "e6a26b8e-98ae-4159-b02f-08373a227c5e",
                                                "sense_id": "0d4cd7b8-b096-3036-8889-2e57371c0201",
                                                "text": "“It's easy to see you're a brick!” replied Lady Augusta, and the laugh again became general."
                                            },
                                            {
                                                "example_id": "53fdcc98-f33a-4a9f-8f27-73e83553e93b",
                                                "sense_id": "0d4cd7b8-b096-3036-8889-2e57371c0201",
                                                "text": "Theobald's mind worked in this way: \"Now, I know Ernest has told this boy what a disagreeable person I am, and I will just show him that I am not disagreeable at all, but a good old fellow, a jolly old boy, in fact a regular old brick, and that it is Ernest who is in fault all through.\""
                                            },
                                            {
                                                "example_id": "fabef0a2-180b-4cf7-b747-0389b2f1e12c",
                                                "sense_id": "0d4cd7b8-b096-3036-8889-2e57371c0201",
                                                "text": "‘Somebody had to stay with you,’ said Bobbie.\n‘Tell you what, Bobbie,’ said Jim, ‘you’re a brick. Shake.’"
                                            },
                                            {
                                                "example_id": "16b0e0d3-d58f-4364-9d0f-a4df7125f6fe",
                                                "sense_id": "0d4cd7b8-b096-3036-8889-2e57371c0201",
                                                "text": "“Well, I’ll do what I can for you,” said the seaman, …“If you were only shorter, I'd lend you some clothes.”\n“You're a brick,” said the soldier gratefully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c6dd65-c4b4-3a88-9198-a1591501bfec",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "A shot which misses, particularly one which bounces directly out of the basket because of a too-flat trajectory, as if the ball were a heavier object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e86277-458a-4475-ab57-4aaae04801d2",
                                                "sense_id": "b2c6dd65-c4b4-3a88-9198-a1591501bfec",
                                                "text": "We can't win if we keep throwing up bricks from three-point land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4debc96e-3ca4-3941-b46c-203148c01aba",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "A power brick; an external power supply consisting of a small box with an integral male plug and an attached cord terminating in another plug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
