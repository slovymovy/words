        "fr-extract.jsonl": [
            {
                "entry_id": "9f4fa0c0-2353-3355-8870-7c68ae1be40b",
                "word": "trigramme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "170ab29c-f85c-4ac6-87a4-51e716a72902",
                        "entry_id": "9f4fa0c0-2353-3355-8870-7c68ae1be40b",
                        "tags": [
                            "plural"
                        ],
                        "form": "trigrammes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "463b40de-0c48-386b-b950-6f73205a8b67",
                        "entry_id": "9f4fa0c0-2353-3355-8870-7c68ae1be40b",
                        "glosses": [
                            "Groupe de trois graphèmes employé pour transcrire un phonème unique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6601759-a30d-4b68-9b86-47d245badc3e",
                                "sense_id": "463b40de-0c48-386b-b950-6f73205a8b67",
                                "text": "Dans pef, les deux premières lettres sont es, nous sommes amenés à penser que la dernière est un t, car le mot est forme le seul trigramme français commençant par es."
                            },
                            {
                                "example_id": "a728fd47-a84b-4ef3-bfc0-209bd6b75f38",
                                "sense_id": "463b40de-0c48-386b-b950-6f73205a8b67",
                                "text": "Pour l’allemand 26 lettres dont x est exclu, mais avec un signe supplémentaire ß ; le digramme CH a deux prononciations différentes ; le trigramme SCH correspond au ch français."
                            }
                        ]
                    },
                    {
                        "sense_id": "39906cf5-85f1-36ba-bbfe-2db9d6f9acb2",
                        "entry_id": "9f4fa0c0-2353-3355-8870-7c68ae1be40b",
                        "glosses": [
                            "Un des huit symboles de divination formé par la superposition de trois monogrammes, soit ☰ (ciel), ☱ (lac), ☲ (feu), ☳ (tonnerre), ☴ (vent), ☵ (eau), ☶ (montagne) ou ☷ (terre). Voir Yi Jing."
                        ],
                        "tags": [
                            "Culture chinoise"
                        ],
                        "examples": [
                            {
                                "example_id": "bc7b1157-267b-4a01-b9e5-c018441f69b6",
                                "sense_id": "39906cf5-85f1-36ba-bbfe-2db9d6f9acb2",
                                "text": "Ce livre a pour base deux signes symboliques fort simples, une ligne continue et une ligne brisée, qui, combinées trois à trois de diverses manières, forment soixante-quatre figures. Selon les traditions des Chinois, ces trigrammes furent inventés par leur premier législateur, Fo-Hi, trente siècles avant Jésus-Christ."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e7f19f2-14f0-351d-9c81-6f2506560b3d",
                        "entry_id": "9f4fa0c0-2353-3355-8870-7c68ae1be40b",
                        "glosses": [
                            "Toute séquence de trois caractères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fadcd0d-8dbc-438c-9abc-81f1ffa94116",
                                "sense_id": "4e7f19f2-14f0-351d-9c81-6f2506560b3d",
                                "text": "Par exemple: Georges Cuvier aurait pour trigramme GCU et pour adresse abrégée gcu@ipgp.fr alors que Antoine-Laurent de Jussieu aurait pour trigramme ALJ et alj@ipgp.fr comme adresse abrégée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8351dc02-f8e9-4e3b-ac79-a00798852b60",
                        "source_entry_id": "9f4fa0c0-2353-3355-8870-7c68ae1be40b",
                        "source_sense_id": "463b40de-0c48-386b-b950-6f73205a8b67",
                        "source_sense_description": "Linguistique",
                        "target_lang_word": "trigraph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trigraph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d06fbac-5898-3e17-9913-c525fb84e525",
                                        "entry_id": "749a746f-ba20-3914-b49b-9d31d1d64170",
                                        "glosses": [
                                            "A specific sequence of three letters, especially one used collectively to represent a single phoneme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c281fba0-170e-4d04-a9d5-f65fcb80f66b",
                                                "sense_id": "7d06fbac-5898-3e17-9913-c525fb84e525",
                                                "text": "Letter “i” is pronounced as /aɪ/ when followed by the trigraph “ght”, as in right /raɪt/."
                                            },
                                            {
                                                "example_id": "45fdaa07-bed6-4ecd-8d2d-f63bfbb69304",
                                                "sense_id": "7d06fbac-5898-3e17-9913-c525fb84e525",
                                                "text": "Then, practice reading fluency sentences together that contain words with trigraphs and other mastered words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1be2d94-275d-36d4-b2ce-b6b55740410e",
                                        "entry_id": "749a746f-ba20-3914-b49b-9d31d1d64170",
                                        "glosses": [
                                            "A three-character sequence used to enter a single conceptual character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb5e1c20-4690-4c81-acf7-3c222a388421",
                                                "sense_id": "e1be2d94-275d-36d4-b2ce-b6b55740410e",
                                                "text": "These new features are charizing, stringization, token concatenation, string concatenation, trigraph replacement, and predefined macros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
