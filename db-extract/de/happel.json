                ],
                "senses": [
                    {
                        "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                        "entry_id": "0c2fc953-c78d-3afc-8890-4ee176791fe5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a137fd-542a-463a-9604-8065dac6e3ce",
                                "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                                "text": "Frau Happel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "09346b3c-ffed-45d9-b15b-48d1df1130d7",
                                "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                                "text": "Herr Happel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "89088cb2-08fb-4f40-b34a-fb67bf9b2a84",
                                "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                                "text": "Die Happels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4c70d0cc-66e7-4704-9c2d-75cf00ea4404",
                                "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                                "text": "Der Happel trägt nie die Schals, die die Happel ihm strickt."
                            },
                            {
                                "example_id": "5e8dcdc8-2b90-4537-a424-5a6c0623c3cf",
                                "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Happel kommt, geht der Herr Happel.“"
                            },
                            {
                                "example_id": "ce906f7a-4f61-486d-b819-41a3271dbabb",
                                "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                                "text": "Happel kommt und geht."
                            },
                            {
                                "example_id": "2d71cd08-88f6-4455-be8b-8e64a9659ec0",
                                "sense_id": "c0ffc738-554a-3d37-92f7-d62545b449ca",
                                "text": "Happels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
