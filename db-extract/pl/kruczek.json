                "senses": [
                    {
                        "sense_id": "0f9894f4-71f5-3578-afce-df82ec7229c7",
                        "entry_id": "0c19b462-4cca-3d30-bc48-bc1c07759d6d",
                        "glosses": [
                            "wybieg, klauzula o nieoczywistych konsekwencjach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "263a90c2-b2cf-4e87-8e0a-b62a41841955",
                                "sense_id": "0f9894f4-71f5-3578-afce-df82ec7229c7",
                                "text": "W umowie był kruczek uniemożliwiający pracownikom dochodzenie swoich praw."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    },
                    {
                        "sense_id": "fa28fa35-533b-3e55-9cf4-82b59570ac4c",
