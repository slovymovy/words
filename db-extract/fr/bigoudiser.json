                "forms": [],
                "senses": [
                    {
                        "sense_id": "88c2cd41-ed5f-3b1d-bbf6-2e68ee27b2ca",
                        "entry_id": "af4fbe12-6541-339b-9416-293f94f40800",
                        "glosses": [
                            "Appliquer des bigoudis dans les cheveux de quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4818e31b-c8c0-4a73-82d9-5de1208b0ff0",
                                "sense_id": "88c2cd41-ed5f-3b1d-bbf6-2e68ee27b2ca",
                                "text": "Daniel, mon père de toujours et mon futur mari fonçaient tête baissée, droit devant eux, sans s’occuper de moi ni de la pluie ni de mon parapluie, que je tentais avec labeur de maintenir au-dessus de mon crâne afin de protéger mes cheveux, que j’avais eu tant de mal à « bigoudiser »."
                            },
                            {
                                "example_id": "de15ad75-8bdb-4f85-aadb-51fd1cc71a96",
                                "sense_id": "88c2cd41-ed5f-3b1d-bbf6-2e68ee27b2ca",
                                "text": "La tête bigoudisée de la mère Hougron se penchait vers le curieux chapeau du commissaire."
                            },
                            {
                                "example_id": "35d34160-15bc-4c8a-864e-aecc5099c8d6",
                                "sense_id": "88c2cd41-ed5f-3b1d-bbf6-2e68ee27b2ca",
                                "text": "Elle doit bigoudiser dans l’année, mais là, couchée bikiniante, c’est très potable, comme une histoire d’Eau."
                            },
                            {
                                "example_id": "4f79f653-3955-4f38-96c9-33f7c25ee4fb",
                                "sense_id": "88c2cd41-ed5f-3b1d-bbf6-2e68ee27b2ca",
                                "text": "Branle-bas de débat, tout s’agite, s’éclope, s’enfume, se bigoudise encore."
                            }
                        ]
                    }
                ],
