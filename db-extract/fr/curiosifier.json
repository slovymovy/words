                "senses": [
                    {
                        "sense_id": "fd1adaba-a010-3762-82eb-fea6b07ae1a5",
                        "entry_id": "f94dd35a-959d-37dd-afc2-80d52d7333b2",
                        "glosses": [
                            "Rendre curieux."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "453dbda6-6b1b-4143-9b75-bf42703c2bc6",
                                "sense_id": "fd1adaba-a010-3762-82eb-fea6b07ae1a5",
                                "text": "Curiosifier notre regard, c’est considérer un objet, une situation, un geste comme potentiellement étrange, et donc digne d’une attention particulière."
                            },
                            {
                                "example_id": "05be698b-f762-4be8-a416-b0cfe9ed4b19",
                                "sense_id": "fd1adaba-a010-3762-82eb-fea6b07ae1a5",
                                "text": "C'est toujours tout à fait passionnant de voir quels sont les recoins de cette immense citadelle qui vont curiosifier les lecteurs, …."
                            }
                        ]
                    }
