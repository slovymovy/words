                                    },
                                    {
                                        "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                        "entry_id": "55f03671-1ac4-3a4e-9c22-44bcd3a2bc22",
                                        "glosses": [
                                            "To become weaker or less strong."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41f92a1-c809-4cde-a132-924f5a1d239b",
                                                "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                                "text": "Over the years my enthusiasm for the job has weakened."
                                            },
                                            {
                                                "example_id": "bc60c0d1-67b8-4a6b-ae48-17889a3a1b69",
                                                "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                                "text": "My friends, we are confronted with a serious situation. But it is typical of the security problems of the world today. Powerful and aggressive forces are constantly probing, now here, now there, to see whether the free world is weakened. In the face of this, there are no easy choices available. It is misleading for anyone to imply that there are. However, the present situation, though serious, is by no means desperate or hopeless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
