                            {
                                "example_id": "d27590c0-cde1-4351-b417-a3469d7f1261",
                                "sense_id": "b9c5090f-f386-32ec-8b35-8c56d1ddd6d5",
                                "text": "„Aus der Firmenzentrale sollen Milliarden in die USA verschoben worden sein, von dort flossen sie wohl in schwarze Parteikassen.“"
                            },
                            {
                                "example_id": "aeadb1d4-9cbd-4591-9181-8443d464023f",
                                "sense_id": "b9c5090f-f386-32ec-8b35-8c56d1ddd6d5",
                                "text": "„Nach dem Diebstahl eines überdimensionierten Metall-Butterkekses von der Bahlsen-Firmenzentrale in Hannover ist am Dienstag ein kurioses Erpresserschreiben aufgetaucht - unterzeichnet mit \"Krümelmonster\".“"
                            }
                        ],
