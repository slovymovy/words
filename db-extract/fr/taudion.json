                        "examples": [
                            {
                                "example_id": "8059612f-58d9-4f83-891a-e3bf5837c390",
                                "sense_id": "73e24a44-9722-39dd-a9b4-9f7cbb77ff06",
                                "text": "Il l’appela et la fit monter dans sa chambre, un taudion formé de lattis et de plâtre, et se croisant les bras, il lui dit : — Eh bien ?"
                            },
                            {
                                "example_id": "ad2d6258-f75a-4392-a048-08f42284de48",
                                "sense_id": "73e24a44-9722-39dd-a9b4-9f7cbb77ff06",
                                "text": "C’est dans ce taudion, historique désormais, que furent signés les traités avec les États du Sud et la promotion du roi de Prusse à l’empire d’Allemagne ; plus tard, la capitulation de Paris et la fixation des préliminaires de paix."
                            },
                            {
                                "example_id": "9c87640d-e263-4f62-80b7-a1ba7f26c264",
                                "sense_id": "73e24a44-9722-39dd-a9b4-9f7cbb77ff06",
                                "text": "Et quel palais, son logis de la rue de Seine: une des ladres maisons contiguës à la rue des Marais; galetas, taudion, nid à vermine !"
                            }
                        ]
                    }
