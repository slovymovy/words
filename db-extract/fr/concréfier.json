                        "sense_id": "df8ebdb7-e297-3cb0-850e-92488a92d456",
                        "entry_id": "6cb248d5-1546-39f3-a011-529b8a383798",
                        "glosses": [
                            "Coaguler, solidifier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cee616ef-47c2-4c50-aa66-b34310eea82a",
                                "sense_id": "df8ebdb7-e297-3cb0-850e-92488a92d456",
                                "text": "Cette dernière ruisselait en coulées rapides, et venait se concréfier au pied du cône."
                            },
                            {
                                "example_id": "80c25698-ea5e-4f90-ace3-7f085d607743",
                                "sense_id": "df8ebdb7-e297-3cb0-850e-92488a92d456",
                                "text": "Le gutta percha, ou percharium, lorsqu’il découle de l’arbre qui le fournit, se présente sous la forme d’un suc laiteux qui ne larde pas à se concréfier par son exposition à l’air."
                            }
                        ]
                    }
