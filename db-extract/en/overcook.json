                        "entry_id": "c04c6ced-e176-36e9-9fd3-189f58cd57c0",
                        "glosses": [
                            "To do something to excess; to overdo."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6191e258-e0e8-43ef-b0ae-e6a8895c5cab",
                                "sense_id": "a46e0f29-0ef1-3c3c-af6e-9ae9be3d44e0",
                                "text": "The runner overcooked it on the first lap, and ended up finishing last."
