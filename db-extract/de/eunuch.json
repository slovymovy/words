                        ],
                        "form": "den Eunuchen"
                    },
                    {
                        "form_id": "d5863913-7879-4532-9ac7-3148ea350fe5",
                        "entry_id": "fc485e32-e783-3634-a092-796f3bfcf60e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Eunuchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fea8e2b7-8f23-3fb3-ade0-e50dfe159588",
                        "entry_id": "fc485e32-e783-3634-a092-796f3bfcf60e",
                        "glosses": [
                            "Mensch männlichen Geschlechts, der einer Kastration unterzogen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb94226-acac-41c2-86a2-e72b3a12d272",
                                "sense_id": "fea8e2b7-8f23-3fb3-ade0-e50dfe159588",
                                "text": "In der Antike standen Eunuchen im politischen und gesellschaftlichen Bereich im Rang von Ministern, in Byzanz waren sie hohe Offiziere."
                            },
                            {
                                "example_id": "fb271964-ce17-49e2-91b1-08953f74760f",
                                "sense_id": "fea8e2b7-8f23-3fb3-ade0-e50dfe159588",
                                "text": "„Ein hochgewachsener schwarzer Eunuch bedient die Wasserpfeife, an der sein Herr ohne Unterlass nuckelt.“"
                            },
                            {
                                "example_id": "424ea166-2863-4e54-99a7-fcd0965010f4",
                                "sense_id": "fea8e2b7-8f23-3fb3-ade0-e50dfe159588",
                                "text": "„Vielleicht 50000 Menschen teilen sich die Hälfte dieser Stadt, die andere ist dem König mit seinem Palast und den wohl etwa 1000 Frauen, Kindern, Eunuchen, Höflingen und Wächtern vorbehalten.“"
                            },
                            {
                                "example_id": "379a725e-4a23-4043-8328-35a3cf543b20",
                                "sense_id": "fea8e2b7-8f23-3fb3-ade0-e50dfe159588",
                                "text": "„Die Stimme des Eunuchen ist mehr die eines Vogels als die eines Menschen.“"
                            },
                            {
                                "example_id": "941e507e-118d-418d-8bd6-c45d6c97ac7b",
                                "sense_id": "fea8e2b7-8f23-3fb3-ade0-e50dfe159588",
                                "text": "„Als der Eunuch wieder aus der Dusche kommt, sehen die Haremsdamen sofort: Da ist auf einmal richtig Samba in der Pluderhose!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47fa7543-bb5e-4f7a-b1be-819fb3b7f91a",
                        "source_entry_id": "fc485e32-e783-3634-a092-796f3bfcf60e",
                        "source_sense_id": "fea8e2b7-8f23-3fb3-ade0-e50dfe159588",
                        "source_sense_description": "Mensch männlichen Geschlechts, der einer Kastration unterzogen wurde",
                        "target_lang_word": "eunuch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eunuch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e0c485d-dbf0-3f1c-97c4-8df9e4c0a431",
                                        "entry_id": "002fc2c3-7df8-3f5d-8940-094a337efc5d",
                                        "glosses": [
                                            "A castrated human male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3dc5af-6ad3-42fd-8901-cd20370a0aec",
                                                "sense_id": "8e0c485d-dbf0-3f1c-97c4-8df9e4c0a431",
                                                "text": "Semiramis was the first woman to invent eunuchs and women have had sympathy for them ever since; […] and women can tell them what they can't tell other men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf5a3699-123d-3da2-b0d4-59cea1ff9962",
                                        "entry_id": "002fc2c3-7df8-3f5d-8940-094a337efc5d",
                                        "glosses": [
                                            "Such a man employed as harem guard or in certain (mainly Eastern) monarchies (e.g. late Roman and Chinese Empires) as court or state officials."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d55723-feeb-4675-a771-79daabf88af0",
                                                "sense_id": "cf5a3699-123d-3da2-b0d4-59cea1ff9962",
                                                "text": "He ſhall be made a chaſte and luſtleſſe Eunuch,\nAnd in my Sarell tend my Concubines"
                                            },
                                            {
                                                "example_id": "c233381c-2365-4316-a90e-8c504a684fda",
                                                "sense_id": "cf5a3699-123d-3da2-b0d4-59cea1ff9962",
                                                "text": "[describing a bas-relief] An eunuch holds a fly-flapper or fan over the head of the king, who appears to be conversing or performing some ceremony with a figure standing in front of him; probably his vizir or minister."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "116a17af-e076-3233-849d-494f22c452cd",
                                        "entry_id": "002fc2c3-7df8-3f5d-8940-094a337efc5d",
                                        "glosses": [
                                            "A man who is not inclined to marry and procreate."
                                        ],
                                        "tags": [
                                            "in translations of ancient texts"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39f27b0d-7300-37fa-b33d-5349855169f3",
                                        "entry_id": "002fc2c3-7df8-3f5d-8940-094a337efc5d",
                                        "glosses": [
                                            "One that is ineffectual."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a64c5c-5486-4aea-9351-c077f9995140",
                                                "sense_id": "39f27b0d-7300-37fa-b33d-5349855169f3",
                                                "text": "Mr. Peterson really reaches for a low one when he says, \"They (gays) should never commit themselves to any broader ideological movement.\" I am, paradoxically, a Christian, a Maxist, a Gay, and a Human Being. To be gay one should not be a political eunuch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eunuch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7d09b6c-ac5b-3e73-a488-be82dc9788cd",
                                        "entry_id": "7144d8a1-4d53-3a68-ab58-208faf55d753",
