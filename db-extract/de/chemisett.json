                "senses": [
                    {
                        "sense_id": "9b7c10ed-7b3e-306a-91da-d26590de885d",
                        "entry_id": "9bec5a40-97be-3f3a-87d7-74389d109432",
                        "glosses": [
                            "gestärkte Hemdbrust eines Mannes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6468326-9cf8-49ef-a8cd-f584737e146a",
                                "sense_id": "9b7c10ed-7b3e-306a-91da-d26590de885d",
                                "text": "„Wir sagen ihm, daß wir weinen werden wie Hunde, die Musik hören, wenn er nicht mit uns zur Bescherung in die Weihnachtsstube hinuntergeht, und wir reden so lange auf ihn ein, bis er sein Chemisett umtut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3c4b4e85-fabc-3e2c-aaba-17776552dbc8",
                        "entry_id": "9bec5a40-97be-3f3a-87d7-74389d109432",
                        "glosses": [
                            "heller, vorderer Einsatz an einem Kleidungsstück für eine Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d256ce-8185-4ba8-8805-c2c25ae01e34",
                                "sense_id": "3c4b4e85-fabc-3e2c-aaba-17776552dbc8",
                                "text": "„Man stelle sich vor, wie diese elenden Nullen mit Blut auf ihren Chemisetten vom Konzert heimgehen!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
