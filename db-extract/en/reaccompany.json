                "senses": [
                    {
                        "sense_id": "bf3b543c-1f4e-3dce-bbdb-e2a13f6a5cf1",
                        "entry_id": "02872958-84ae-36b1-b43f-9ff89e337b12",
                        "glosses": [
                            "To accompany again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6cfe727-9ad5-4d0b-b498-c22e1b6c16d5",
                                "sense_id": "bf3b543c-1f4e-3dce-bbdb-e2a13f6a5cf1",
                                "text": "I insist, on the other hand, that monsieur's wishes must be complied with, and we must reaccompany him to the top, which we do."
                            },
                            {
                                "example_id": "ab457a5f-d47c-4a3f-a7f9-5c882e0c3e66",
                                "sense_id": "bf3b543c-1f4e-3dce-bbdb-e2a13f6a5cf1",
                                "text": "To the intense satisfaction of those of the Mayor's visitors who had gone without luncheon, the police escort was in attendance to reaccompany the beflagged motor-cars “up-town.”"
                            },
                            {
                                "example_id": "0e152d4c-3d9e-4213-8d25-5a8ec8974c80",
                                "sense_id": "bf3b543c-1f4e-3dce-bbdb-e2a13f6a5cf1",
                                "text": "And so, before we separated, in the ever more empty streets where we ended up by hearing only our own footsteps, we would reaccompany each other two or three times."
                            }
                        ]
                    }
                ],
