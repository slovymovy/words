{
    "word_family": [
        "clandestinely",
        "clandestinity",
        "clandestineness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "64e491e6-9db6-37cf-a4d3-f2dfa73b3951",
                    "sense_definition": "Done or kept in secret, sometimes to conceal an illicit or improper purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "secretive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intelligence agency carried out several <w>clandestine</w> operations in the region without the knowledge of the local government.",
                            "target_lang_translations": {
                                "de": "Der Geheimdienst führte in der Region mehrere <w>klandestine</w> Operationen ohne das Wissen der lokalen Regierung durch."
                            }
                        },
                        {
                            "text": "They had to arrange a <w>clandestine</w> meeting in a quiet cafe to discuss the sensitive documents.",
                            "target_lang_translations": {
                                "de": "Sie mussten ein <w>heimliches</w> Treffen in einem ruhigen Café vereinbaren, um die sensiblen Dokumente zu besprechen."
                            }
                        }
                    ],
                    "synonyms": [
                        "covert",
                        "furtive",
                        "secret",
                        "surreptitious",
                        "undercover",
                        "stealthy"
                    ],
                    "antonyms": [
                        "open",
                        "public",
                        "overt"
                    ],
                    "common_phrases": [
                        "clandestine meeting",
                        "clandestine operation",
                        "clandestine activity"
                    ],
                    "target_lang_definitions": {
                        "de": "Heimlich oder im Verborgenen getan oder gehalten, oft um einen illegalen oder ungebührlichen Zweck zu verbergen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "klandestin",
                                "target_lang_sense_clarification": "geheim, im Verborgenen (oft im politischen oder geheimdienstlichen Kontext)"
                            },
                            {
                                "target_lang_word": "geheim",
                                "target_lang_sense_clarification": "nicht für die Öffentlichkeit bestimmt"
                            },
                            {
                                "target_lang_word": "heimlich",
                                "target_lang_sense_clarification": "ohne das Wissen anderer durchgeführt"
                            },
                            {
                                "target_lang_word": "klammheimlich",
                                "target_lang_sense_clarification": "ganz heimlich und unbemerkt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f950bce-f1e1-3835-9fc8-f40fe5e4399a",
                    "sense_definition": "Not recognized as a regular member.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unrecognized",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clandestine</w> members of the organization were not allowed to vote on the new policy.",
                            "target_lang_translations": {
                                "de": "Die <w>inoffiziellen</w> Mitglieder der Organisation durften nicht über die neue Richtlinie abstimmen."
                            }
                        },
                        {
                            "text": "He maintained a <w>clandestine</w> status within the group, never officially registering.",
                            "target_lang_translations": {
                                "de": "Er behielt einen <w>inoffiziellen</w> Status innerhalb der Gruppe bei und registrierte sich nie offiziell."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrecognized",
                        "unofficial"
                    ],
                    "antonyms": [
                        "official",
                        "regular"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht als reguläres Mitglied anerkannt oder offiziell registriert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "inoffiziell",
                                "target_lang_sense_clarification": "nicht offiziell anerkannt"
                            },
                            {
                                "target_lang_word": "nicht registriert",
                                "target_lang_sense_clarification": "ohne formelle Anmeldung oder Mitgliedschaft"
                            }
                        ]
                    }
                }
            ]
        }
    ]
