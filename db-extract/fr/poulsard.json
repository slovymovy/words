                        "glosses": [
                            "Cépage donnant de petites grappes de petits raisins noirs donnant un jus rose pâle."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "1762a6e2-1772-4885-86da-2b3260a25bfb",
                                "sense_id": "d71c472c-38c2-352b-a290-27e95b214846",
                                "text": "Des coteaux d’Arbois, de Poligny et de Salins, descendait, chaque automne, avec les cuves pleines, le beau vin couleur peau d’oignon, jailli des grappes de poulsard."
                            },
                            {
                                "example_id": "71e3ed33-0f50-4167-883c-23185b0ffe3c",
                                "sense_id": "d71c472c-38c2-352b-a290-27e95b214846",
                                "text": "Si chardonnays, poulsards et savagnins se serrent ici la ceinture, sous l’effet d’une dessiccation particulièrement appropriée, ils célèbrent par contre avec gloire des moelleux tous aussi saisissants que complexes et profonds."
                            }
                        ]
                    }
