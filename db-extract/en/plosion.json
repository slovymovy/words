                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d1ef80b-e1a6-375d-bdd9-5c0c0b689cbb",
                        "entry_id": "1482881a-8872-3c28-a217-ac966253b7ec",
                        "glosses": [
                            "Pronunciation of a consonant that is characterised by completely blocking the flow of air through the mouth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70a37e0f-4fee-4658-8cbb-9db62e394095",
                                "sense_id": "4d1ef80b-e1a6-375d-bdd9-5c0c0b689cbb",
                                "text": "In Russian, nasal plosion is confined to cases where both the plosive and the nasal consonant have the same primary articulation. In English, however, nasal plosion occurs also in such groups as kn, tm (as in Hackney ['haekni], utmost [ˈʌtmoʊst])."
                            },
                            {
                                "example_id": "395fdbe6-c9d5-4d0f-bb78-127458a0d0ca",
                                "sense_id": "4d1ef80b-e1a6-375d-bdd9-5c0c0b689cbb",
                                "text": "Plosive consonants are sometimes not fully articulated ; under certain conditions they may be reduced to stops only, without plosions. This generally happens in English when a plosive is immediately followed by another plosive."
                            },
                            {
                                "example_id": "54370555-9ad1-4a1b-a3cf-b47a06c3a079",
                                "sense_id": "4d1ef80b-e1a6-375d-bdd9-5c0c0b689cbb",
                                "text": "To avoid too much air escape at the moment of plosion, the tongue-tip is placed lightly on the alveolar ridge, the less muscular pressure the better."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "287a9f5a-1a82-433e-b538-148c8cdf864f",
