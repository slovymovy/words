                "senses": [
                    {
                        "sense_id": "e888a779-96b7-3116-a1e7-4363f06ee350",
                        "entry_id": "ace3b93f-ed1e-3345-8977-a85183b123a4",
                        "glosses": [
                            "Enlever les arbres."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "182b60cd-c5e5-4c5d-adf3-cc3c9e77461a",
                                "sense_id": "e888a779-96b7-3116-a1e7-4363f06ee350",
                                "text": "Les Eaux et Forêts peuvent bien surveiller jalousement les futaies, c’est ailleurs que se fait le massacre, au bord des routes où les services d’EDF et des PTT désarbrent chacun leur côté, où les paysans sabrent à tort et à travers."
                            },
                            {
                                "example_id": "df46c2a3-5beb-43e8-a1a4-c227fad89580",
                                "sense_id": "e888a779-96b7-3116-a1e7-4363f06ee350",
                                "text": "Si par hasard on désarbrait la Chartreuse nous aurions deux Dévoluys au lieu d’un, c’est-à-dire une autre carcasse blanchâtre, un autre clapier, un autre chaos."
                            }
                        ]
                    }
