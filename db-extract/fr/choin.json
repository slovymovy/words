                "senses": [
                    {
                        "sense_id": "0dbda932-e035-3a83-8a6c-fa1172205382",
                        "entry_id": "82d043e0-57ed-3de8-98b7-f6f954726c90",
                        "glosses": [
                            "Plante botaniquement voisine des laîches et des souchets, à tige jonciforme, et qui végète dans les marais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7360935-b2c5-47ce-a8a1-e7dfd7ee66ed",
                                "sense_id": "0dbda932-e035-3a83-8a6c-fa1172205382",
                                "text": "Le sol s’affaisse en s’asséchant. Pour l’affermir, il faut d’abord brûler les choins, massettes, roseaux, et, pour cela, tenir le marais le plus à sec possible."
                            },
                            {
                                "example_id": "8e3046c0-278f-4661-86ee-21b90e22a76b",
                                "sense_id": "0dbda932-e035-3a83-8a6c-fa1172205382",
                                "text": "Le Choin, au contraire, garde toute l’année une teinte terne, gris-verdâtre, qui s’anime à peine au printemps, les feuilles et hampes desséchées persistent plusieurs années, dissimilant les nouvelles feuilles."
                            }
                        ]
                    }
