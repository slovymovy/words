                        "form": "den Trauergast"
                    },
                    {
                        "form_id": "bb02ebcf-7d5b-4d75-a553-264ffa818c54",
                        "entry_id": "edcea334-6028-3ddc-8744-2ee9075d6f47",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Trauergäste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                        "entry_id": "edcea334-6028-3ddc-8744-2ee9075d6f47",
                        "glosses": [
                            "Person, die an einer Beerdigung/Trauerfeier teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e80ccb66-34d9-4fca-9627-e28ac2f8ec88",
                                "sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                                "text": "„Aber auch in den Augen der übrigen Trauergäste hatte er kein Mitleid gefunden.“"
                            },
                            {
                                "example_id": "b766e1dd-3b39-4df4-b749-bc150176232a",
                                "sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                                "text": "Es kamen fast alle Trauergäste, die eingeladen worden waren."
                            },
                            {
                                "example_id": "353d118b-2741-45ac-b70a-02752f21cb95",
                                "sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                                "text": "„Helena, die unter den Trauergästen stand, zog sich zusammen.“"
                            },
                            {
                                "example_id": "6cf4f501-3206-4ac5-9046-9e242fe2e3ea",
                                "sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                                "text": "„Nach der Beisetzung und dem Trauergottesdienst gingen die Trauergäste zur Familie des Verstorbenen zum Essen.“"
                            },
                            {
                                "example_id": "b7ed1a61-ee13-4aec-ba7b-c9cfa9b1e60b",
                                "sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                                "text": "„Ich entdecke sie Stunden später, als das Wohnzimmer schon wieder voll mit Trauergästen ist.“"
                            },
                            {
                                "example_id": "aa15e8db-62d0-4491-8608-18acfcd80c24",
                                "sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                                "text": "„Der eine, der rechts hinter Le Chiffre stand, war groß und wirkte in seinem Smoking wie ein Trauergast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd5920a0-1c17-4136-b68a-fcc97aa9894e",
                        "source_entry_id": "edcea334-6028-3ddc-8744-2ee9075d6f47",
                        "source_sense_id": "058f562c-a7f2-30ce-b0be-e810c51950b8",
                        "source_sense_description": "Person, die an einer Beerdigung/Trauerfeier teilnimmt",
                        "target_lang_word": "mourner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mourner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6246fecd-b88b-37c0-8a45-31c0181df6d1",
                                        "entry_id": "e083baf8-b576-36eb-9c42-74cfb97a73f9",
                                        "glosses": [
                                            "Someone filled with or expressing grief or sadness, especially over a death; someone who mourns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6793f90b-ace2-4f98-934a-6396389d42ff",
                                                "sense_id": "6246fecd-b88b-37c0-8a45-31c0181df6d1",
                                                "text": "Disuniter of all affection—awful seal to life's nothingness—warning and witness of power and judgment—Death has always enow of terror and sorrow, even when there are many to comfort the mourner, when the path has been smoothed for the sufferer, and life offers all its best and brightest to soothe the survivor; […]"
                                            },
                                            {
                                                "example_id": "b6f63f57-8558-4626-99af-5a370a70b441",
                                                "sense_id": "6246fecd-b88b-37c0-8a45-31c0181df6d1",
                                                "text": "I stood close to heartsick mourners and worried that I would not sustain the enormousness of their spiritual weight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990232ad-e75b-3f7f-9d84-2e6d9b37e5fc",
                                        "entry_id": "e083baf8-b576-36eb-9c42-74cfb97a73f9",
                                        "glosses": [
                                            "Any of a number of suboscine birds in the related familes Tityridae and Tyrannidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
