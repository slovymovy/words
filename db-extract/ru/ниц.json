                                        "examples": [
                                            {
                                                "example_id": "ebf803e0-c108-44ec-b188-efb4f7aed239",
                                                "sense_id": "c8cc6128-8c84-39e6-84e1-fe7e98cf6ae2",
                                                "text": "That old philosopher grew cross, / Who could not tell what motion was; / Because he walked against his will, / He faced men down, that he stood still."
                                            },
                                            {
                                                "example_id": "e77cfdaf-3273-4f33-bf03-668f805a9d3f",
                                                "sense_id": "c8cc6128-8c84-39e6-84e1-fe7e98cf6ae2",
                                                "text": "An already febrile atmosphere within the ground before the start had been stoked still further when France's players formed an arrow formation to face down the haka, and then advanced slowly over halfway as the capacity crowd roared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe0fe47-dd72-3174-9ff9-4b1a6b4b5112",
                                        "entry_id": "4396393c-b6f5-3d85-8fe5-901669b613dd",
                                        "glosses": [
                                            "To persist in confronting impudently."
                                        ],
