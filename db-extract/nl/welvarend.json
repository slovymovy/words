                        "entry_id": "cf60efe9-3dbd-341e-8669-ab8c7468abf9",
                        "glosses": [
                            "over ruime financiële middelen beschikkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49c7b56-23e3-46b9-b10a-61e8158ec3d2",
                                "sense_id": "7ad82a0a-a450-3ac8-85da-1a30b325c016",
                                "text": "Amsterdam werd na de val van Antwerpen de welvarendste stad in de wijde omtrek."
                            },
                            {
                                "example_id": "a41cf166-81a6-47de-98e4-f1490bc7e18b",
                                "sense_id": "7ad82a0a-a450-3ac8-85da-1a30b325c016",
                                "text": "Ïn Zuid-Korea legt de overheid verantwoording af aan de burgers en heeft de bevolking volop economische kansen; het land is zeer welvarend\", aldus de Nederlandse uitgever bij het verschijnen van dat boek. \"Noord-Korea wordt dictatoriaal geregeerd en kent al tientallen jaren onderdrukking en hongersnood.\""
                            }
                        ]
                    }
