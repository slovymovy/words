                                "target_senses": [
                                    {
                                        "sense_id": "3c51e1d1-3912-33b9-9074-13e014a15e07",
                                        "entry_id": "e46d9a84-195f-36eb-bcc8-197c98946f11",
                                        "glosses": [
                                            "Ruisseau français affluent de l’Alagnon qui coule dans le département de la Haute-Loire."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Violette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b97e19-5ec7-3373-ad03-15116b0caec4",
                                        "entry_id": "38e792c1-aacc-3a42-b311-a67e62db327c",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce300fdd-f942-42bb-838e-827f3a83204a",
                                                "sense_id": "d8b97e19-5ec7-3373-ad03-15116b0caec4",
                                                "text": "Le pauvre Coco, gêné et rustaud, qui rougissait jusqu’à la pointe des cheveux chaque fois que ses yeux rencontraient ceux de Violette, par exemple quand elle arrivait à table pour les repas, se fit une toilette complète, ce soir-là, comme s’il s’était agi de « la grande demande »."
                                            },
                                            {
                                                "example_id": "3f3aea04-ffc5-4378-a72c-f5c5cd9434e9",
                                                "sense_id": "d8b97e19-5ec7-3373-ad03-15116b0caec4",
                                                "text": "La Rochefortaise Violette Dorange (« Devenir »), désormais basée en Bretagne, à Port-la-Forêt, a elle aussi un bel appétit."
                                            },
                                            {
                                                "example_id": "209b9b0b-b833-4793-8d47-7aba78b4d5b6",
                                                "sense_id": "d8b97e19-5ec7-3373-ad03-15116b0caec4",
                                                "text": "À l’ordre du jour : dépôt gerbe et bouquet et lecture de textes divers avant dépôt de gerbe en hommage à Violette Szabo à 11h30 au stade des Verrines."
                                            },
                                            {
                                                "example_id": "4fbf8c34-8a46-44d3-bfe1-be05bb9e91fc",
                                                "sense_id": "d8b97e19-5ec7-3373-ad03-15116b0caec4",
                                                "text": "Comme le résume Violette Kerleaux, « au fond, ça ne commence pas à la maison, mais partout »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2614a732-bc00-4ca6-b2f5-ba37c75d9921",
                        "source_entry_id": "4656f386-89be-3840-8640-81de457c42ae",
                        "source_sense_id": "436ced93-85cf-3707-8f8c-9e21f1254ff0",
