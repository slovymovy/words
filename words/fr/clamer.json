    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c4066ff-a325-3a40-8515-c501fb2b322f",
                    "sense_definition": "Manifester ou affirmer avec force et vigueur un sentiment, une opinion ou une revendication.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_forte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé n'a cessé de <w>clamer</w> son innocence devant les juges tout au long du procès."
                        },
                        {
                            "text": "Les manifestants se sont réunis pour <w>clamer</w> leur indignation face à cette décision injuste."
                        }
                    ],
                    "synonyms": [
                        "proclamer",
                        "revendiquer",
                        "affirmer"
                    ],
                    "antonyms": [
                        "taire",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "clamer son innocence",
                        "clamer son indignation",
                        "clamer haut et fort"
                    ]
                },
                {
                    "sense_id": "1c67b286-ab54-379a-a1bd-a0cb785d27ce",
                    "sense_definition": "Dire ou proférer des paroles à très haute voix, de manière à être entendu de loin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "parole_voix_haute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marchand ambulant <w>clamait</w> ses prix pour attirer les passants sur la grand-place."
                        },
                        {
                            "text": "Par la fenêtre ouverte, on entendait un homme qui <w>clamait</w> les dernières nouvelles du village."
                        }
                    ],
                    "synonyms": [
                        "crier",
                        "hurler"
                    ],
                    "antonyms": [
                        "chuchoter",
                        "murmurer"
                    ],
                    "common_phrases": [
                        "clamer à tue-tête"
                    ]
                },
                {
                    "sense_id": "2af26f64-8d2a-3b3e-8a03-145c19910abe",
                    "sense_definition": "Maintenir fermement une pièce mécanique à l'aide de clames pendant son usinage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier doit soigneusement <w>clamer</w> la pièce métallique sur la table avant de commencer l'usinage."
                        },
                        {
                            "text": "Le technicien vérifie que la plaque est bien <w>clamée</w> afin d'éviter tout mouvement dangereux."
                        }
                    ],
                    "synonyms": [
                        "serrer",
                        "fixer"
                    ],
                    "antonyms": [
                        "desserrer",
                        "libérer"
                    ]
                }
            ]
        }
    ]
