                ],
                "senses": [
                    {
                        "sense_id": "11268664-a775-3348-bed4-0462e7f626ba",
                        "entry_id": "d78fa365-5d7a-37eb-9c7a-301c0be5bd20",
                        "glosses": [
                            "Eigenschaft, nur eine Farbe zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7de55b7-21ed-4b14-9e92-b468d1d620b0",
                                "sense_id": "11268664-a775-3348-bed4-0462e7f626ba",
                                "text": "„Es ist eine sehr interessante Frage der Kunstgeschichte, welches die Ursache gewesen sein mag, daß allmählich die Einfarbigkeit in der Plastik aufkam.“"
                            },
                            {
                                "example_id": "be299f1f-2eee-4ea0-85e6-371a12126a0b",
                                "sense_id": "11268664-a775-3348-bed4-0462e7f626ba",
                                "text": "„Es war ein herrlicher Morgen mit strahlend blauem Himmel, und keine Wolke wagte es, die Einfarbigkeit zu stören.“"
                            },
                            {
                                "example_id": "e3bfe5c5-e760-4869-b38b-8333f656e822",
                                "sense_id": "11268664-a775-3348-bed4-0462e7f626ba",
                                "text": "„Meist wiegt umgekehrt Einfarbigkeit oder ein dunkles, nach unten abgetöntes Kleid vor.“"
                            },
                            {
                                "example_id": "73208504-ce97-45ba-858f-91a6746f3d6a",
                                "sense_id": "11268664-a775-3348-bed4-0462e7f626ba",
                                "text": "„Die Metallskulpturen unterstützen damit stets die Atmosphäre des Raumes, erwecken ihn quasi zum Leben und ergänzen durch ihre Einfarbigkeit und dreidimensionale Präsenz das durch die Bilder neu gewonnene Sehbewusstsein.“"
                            },
                            {
                                "example_id": "5eba577a-5d0a-465b-8a92-d7f18dd3ca42",
                                "sense_id": "11268664-a775-3348-bed4-0462e7f626ba",
                                "text": "„Durch ihre Einfarbigkeit stechen sie im Beet nicht großartig hervor, begrünen aber zuverlässig die Stellen, die sonst kahl bleiben würden.“"
                            },
                            {
                                "example_id": "22e9c422-7024-46c8-aab7-7f9c1dcb5a7f",
                                "sense_id": "11268664-a775-3348-bed4-0462e7f626ba",
                                "text": "„Auf der Einfarbigkeit des Laserlichts, der Tatsache also, daß es nur Energie einer Wellenlänge transportiert, beruhen schließlich viele Anwendungsmöglichkeiten in Chemie und Medizin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
