                ],
                "senses": [
                    {
                        "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                        "entry_id": "5426ea10-34e3-3433-a051-d7bd7cc08e08",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465a8be9-5d73-4c66-be77-fe33fbcf01c3",
                                "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                                "text": "Frau Ebert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "37df712f-acd7-4a7a-984d-7123e8616d4d",
                                "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                                "text": "Herr Ebert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d57539a1-16d3-48dc-89bc-29ba0be4d533",
                                "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                                "text": "Die Eberts kommen heute aus der Eifel."
                            },
                            {
                                "example_id": "ffebada2-75c4-46ef-84ab-86157e833c88",
                                "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                                "text": "Der Ebert trägt nie die Schals, die die Ebert ihm strickt."
                            },
                            {
                                "example_id": "7a8f02cd-2f90-41f5-8069-a06ef10eab30",
                                "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ebert kommt, geht der Herr Ebert.“"
                            },
                            {
                                "example_id": "ab293240-e21f-43a1-9b50-e2f3235d4824",
                                "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                                "text": "Ebert kommt und geht."
                            },
                            {
                                "example_id": "a4913158-d354-4387-b942-fd30cfd31a21",
                                "sense_id": "e1731d53-8bf1-3e97-a7d9-4a84338d6d9f",
                                "text": "Eberts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
