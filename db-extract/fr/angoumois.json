                    {
                        "sense_id": "13f1aa9e-6c3f-3a2b-b2e2-d7d602c4a7b4",
                        "entry_id": "74e86af6-0ce6-36de-9255-d61968239359",
                        "glosses": [
                            "De l’Angoumois, du pays d’Angoulême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c3b1727-4990-488d-b940-8ea285f4407b",
                                "sense_id": "13f1aa9e-6c3f-3a2b-b2e2-d7d602c4a7b4",
                                "text": "Le chœur et le transept, d’inspiration ligérienne, s’accolent à une nef angoumoise. La façade, remaniée plusieurs fois au cours des âges…"
                            },
                            {
                                "example_id": "45213818-1760-4847-923e-033b8f01fa1f",
                                "sense_id": "13f1aa9e-6c3f-3a2b-b2e2-d7d602c4a7b4",
                                "text": "On distingue dans la région les tripes à l’angoumoise (de bœuf avec aromates et vin blanc) des tripes à la saintongeaise, qui unissent le bœuf et le veau."
                            }
                        ]
                    },
                    {
                        "sense_id": "429517fe-3994-33ac-a611-9e0853d156a0",
                        "entry_id": "74e86af6-0ce6-36de-9255-d61968239359",
                        "glosses": [
                            "Qui concerne Angoulême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "359b1b76-2c24-4f67-b174-b48d95cfdbe3",
                                "sense_id": "429517fe-3994-33ac-a611-9e0853d156a0",
                                "text": "Les cultivateurs angoumois engraissent généralement des porcs et de la volaille."
                            }
                        ]
                    }
