                "senses": [
                    {
                        "sense_id": "e88d05a7-a8af-33f0-a8ed-a31d8867c2cf",
                        "entry_id": "35a20ae7-ad33-3172-93a0-d93d81338135",
                        "glosses": [
                            "stevig met de handen in zijn greep hebben en niet meer loslaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeefb2e1-930c-4b14-8036-5915f50787d1",
                                "sense_id": "e88d05a7-a8af-33f0-a8ed-a31d8867c2cf",
                                "text": "Sommigen zien dat de twee elkaar vasthebben. Een van hen maakt zelfs nog een foto van de twee vechtende jongens."
                            },
                            {
                                "example_id": "af41dc84-d59f-4552-bc8e-90b0f701bc50",
                                "sense_id": "e88d05a7-a8af-33f0-a8ed-a31d8867c2cf",
                                "text": "De grijper heeft drie vingers die uitvindingen op zichzelf zijn. Als ze naar iets grijpen, krommen ze zich automatisch. Daardoor zullen ze iets wat ze vasthebben niet snel laten glippen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d31a709-d99c-3463-a7a5-a248699c9992",
                        "entry_id": "35a20ae7-ad33-3172-93a0-d93d81338135",
                        "glosses": [
                            "stevig in bezit hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25884325-b1e5-4871-846b-fef9d98316a7",
                                "sense_id": "6d31a709-d99c-3463-a7a5-a248699c9992",
                                "text": "Nu we de halve finales halen en een ticket naar Peking vasthebben kunnen we ons concentreren op het tornooi winnen.'"
                            }
                        ]
                    }
                ],
