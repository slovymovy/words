                    {
                        "sense_id": "bfcc85da-dc71-3d1a-a4d4-23bb56783f1c",
                        "entry_id": "8e15b354-a130-3fb6-9e14-7d6bbde001c5",
                        "glosses": [
                            "Pore exhalant chez les éponges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d56d33d-0427-4ee2-842a-3969a9b47a67",
                                "sense_id": "bfcc85da-dc71-3d1a-a4d4-23bb56783f1c",
                                "text": "Le spongocoele est la grande cavité centrale des éponges. L’eau y pénètre via des centaines de petits pores, les ostioles, et en ressortent par une plus grande ouverture, l’oscule."
                            }
                        ]
                    },
