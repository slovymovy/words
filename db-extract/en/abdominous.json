                        "target_lang_word": "ventru",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ventru",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97179f9e-78e6-3c76-b857-2fa1ee51610a",
                                        "entry_id": "b291f090-0bbf-3565-bdb0-ca7dd1dd6a14",
                                        "glosses": [
                                            "Qui a un gros ventre, une grosse panse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d7a7a41-0990-4c02-bcb8-3e711ffa9616",
                                                "sense_id": "97179f9e-78e6-3c76-b857-2fa1ee51610a",
                                                "text": "Les citoyens doivent-ils vraiment payer un salaire de cadre ventru aux amis idéologiques de Valérie Plante pour qu’ils expliquent aux Montréalais que leur ville est raciste ?"
                                            },
                                            {
                                                "example_id": "9767ddb4-19a8-45fd-8e7a-87901b95ec91",
                                                "sense_id": "97179f9e-78e6-3c76-b857-2fa1ee51610a",
                                                "text": "Le cadavre est celui d’un homme d’une soixantaine d’années qui a du être ventru si on en juge par ce que son ventre a éparpillé autour de lui."
                                            },
                                            {
                                                "example_id": "c7a4804c-4eaf-4972-ab76-969d179894d2",
                                                "sense_id": "97179f9e-78e6-3c76-b857-2fa1ee51610a",
                                                "text": "Un petit homme ventru."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb6096fb-252b-3463-8565-8175163c986a",
                                        "entry_id": "b291f090-0bbf-3565-bdb0-ca7dd1dd6a14",
                                        "glosses": [
                                            "Qui semble enflé, qui présente une bosse."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94128e57-574d-4f75-a8cb-8c971d8645bd",
                                                "sense_id": "cb6096fb-252b-3463-8565-8175163c986a",
                                                "text": "Un large fossé rempli d’eau dormante ; huit tours énormes, massives, ventrues, serrées l’une contre l’autre ; des cours humides où l’herbe poussait […] C’était la Bastille."
                                            },
                                            {
                                                "example_id": "c7671fa7-f7d1-45ed-8641-d90abfbbe051",
                                                "sense_id": "cb6096fb-252b-3463-8565-8175163c986a",
                                                "text": "Au fur et à mesure des prélèvements, il fourrait les billets dans sa sacoche qui enflait jusqu’à être, en début d’après-midi, quatre fois plus ventrue que le matin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ventru",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae069e0-2b6c-32b7-889f-2a83787c703e",
                                        "entry_id": "06c23006-e3fc-387b-b248-f77060863969",
                                        "glosses": [
                                            "Personne qui a un gros ventre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294bd946-ac7f-4f01-a97e-6ee7f163dd75",
                                                "sense_id": "6ae069e0-2b6c-32b7-889f-2a83787c703e",
                                                "text": "Un gros ventru."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f53e035-59d4-35df-8491-512a9f311dc8",
                                        "entry_id": "06c23006-e3fc-387b-b248-f77060863969",
                                        "glosses": [
                                            "Homme riche, nanti."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90889bf-7b43-4412-9b79-51d75a9dee82",
                                                "sense_id": "2f53e035-59d4-35df-8491-512a9f311dc8",
                                                "text": "Avec ton harnais de guerre, ton fusil, ta baïonnette, par le sabre et par le revolver, tu imposeras aux malheureux, tes frères, l’autorité malfaisante des riches et des ventrus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
