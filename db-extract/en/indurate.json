                                                "sense_id": "c0b0db4a-5b5d-3d0b-8838-68a53ee99f5a",
                                                "text": "Die Sonne trocknet die Oberfläche aus und verhärtet sie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a8e6127-2c04-35c2-8de8-0277ad578671",
                                        "entry_id": "3d08895a-37d1-34e5-ba9f-b128422117b1",
                                        "glosses": [
                                            "so verändern, dass jemand im Geiste/Auftreten robuster/brutaler (härter) wird"
                                        ],
                                        "tags": [
                                            "transitiv, Hilfsverb haben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9810c96-4a3f-4876-95fc-6a0c63873fef",
                                                "sense_id": "0a8e6127-2c04-35c2-8de8-0277ad578671",
                                                "text": "Die gescheiterte Ehe hat ihr Herz verhärtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f440d493-c9e9-3366-9dd0-0c9ea756a7a4",
                                        "entry_id": "3d08895a-37d1-34e5-ba9f-b128422117b1",
                                        "glosses": [
                                            "sich so verändern, dass etwas oder jemand weniger anpassungsfähig/formbar/elastisch ist als zuvor"
                                        ],
                                        "tags": [
                                            "reflexiv, Hilfsverb haben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74a23b4c-f01c-47c0-bf1b-7a78cdce61c8",
                                                "sense_id": "f440d493-c9e9-3366-9dd0-0c9ea756a7a4",
                                                "text": "„Anacardium orientale: Juckende Bläschen, sie werden schnell pustulär, groß, flach, später fließen sie zusammen und sondern eine gelbliche, durchsichtige Flüssigkeit ab, die sich im Freien zu einem Schorf verhärtet.“"
                                            },
                                            {
                                                "example_id": "38feee14-31a0-4165-b02f-abfa0e776882",
                                                "sense_id": "f440d493-c9e9-3366-9dd0-0c9ea756a7a4",
                                                "text": "Die Positionen der gegnerischen Parteien hatten sich nach der Klausur verhärtet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ee6c63d9-304d-38da-a092-ec07183b59a8",
                                        "entry_id": "3d08895a-37d1-34e5-ba9f-b128422117b1",
                                        "glosses": [
                                            "(mit der Zeit) kompakter, härter werden"
                                        ],
                                        "tags": [
                                            "intransitiv, Hilfsverb sein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91b8a1e4-8664-42d8-9b63-b9b4ac3ea1f6",
                                                "sense_id": "ee6c63d9-304d-38da-a092-ec07183b59a8",
                                                "text": "Nach einer Weile ist die ehemals elastische Verbindung zwischen den Knochen verhärtet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
