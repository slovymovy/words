                "senses": [
                    {
                        "sense_id": "ba6fd45b-b37c-3993-bb6d-1f872f5e1cf6",
                        "entry_id": "9d3fcdad-a3af-3a38-927b-b1f083e6473a",
                        "glosses": [
                            "der Läufer, der in der Grundstellung auf der Brettseite der Dame steht"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "f0abbee8-2dee-435f-9dc2-fc5e5eb010d5",
                                "sense_id": "ba6fd45b-b37c-3993-bb6d-1f872f5e1cf6",
                                "text": "In der Ausgangsstellung des Schachspiels steht der weiße Damenläufer auf dem Feld c1, der schwarze Damenläufer auf dem Feld c8."
                            },
                            {
                                "example_id": "aba720da-27e5-43bf-8247-5c810d81ac74",
                                "sense_id": "ba6fd45b-b37c-3993-bb6d-1f872f5e1cf6",
                                "text": "„Statt den Damenläufer in die Brettmitte zu entwickeln, schickt er seinen Damenspringer auf eine längere Reise, deren Ziel nicht ganz klar ist.“"
                            },
                            {
                                "example_id": "1addbbc6-961f-4633-9226-a1ec041d1a56",
                                "sense_id": "ba6fd45b-b37c-3993-bb6d-1f872f5e1cf6",
                                "text": "„Der einzige Versuch des Damenläufers, sich hervorzuwagen, ist zurückgewiesen; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
