                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to explore the <w>surrounding</w> countryside on foot.",
                            "target_lang_translations": {
                                "ru": "Мы решили пешком исследовать <w>окрестную</w> сельскую местность.",
                                "nl": "We besloten het <w>omliggende</w> platteland te voet te verkennen.",
                                "pl": "Postanowiliśmy pieszo zwiedzić <w>okoliczną</w> wieś.",
                                "de": "Wir beschlossen, die <w>umliegende</w> Landschaft zu Fuß zu erkunden.",
                                "fr": "Nous avons décidé d'explorer la campagne <w>environnante</w> à pied.",
                                "it": "Abbiamo deciso di esplorare a piedi la campagna <w>circostante</w>.",
                                "cs": "Rozhodli jsme se prozkoumat <w>okolní</w> venkov pěšky.",
                                "tr": "<w>Çevreleyen</w> kırsal bölgeyi yürüyerek keşfetmeye karar verdik.",
                                "es": "Decidimos explorar a pie la campiña <w>circundante</w>.",
                                "zh": "我们决定步行探索<w>周围的</w>乡村。"
                            }
                        },
                        {
                            "text": "The <w>surrounding</w> buildings were damaged by the strong winds.",
                            "target_lang_translations": {
                                "ru": "<w>Окружающие</w> здания пострадали от сильного ветра.",
                                "nl": "De <w>omliggende</w> gebouwen raakten beschadigd door de harde wind.",
                                "pl": "<w>Otaczające</w> budynki zostały uszkodzone przez silne wiatry.",
                                "de": "Die <w>umliegenden</w> Gebäude wurden durch die starken Winde beschädigt.",
                                "fr": "Les bâtiments <w>environnants</w> ont été endommagés par les vents violents.",
                                "it": "Gli edifici <w>circostanti</w> sono stati danneggiati dai forti venti.",
                                "cs": "<w>Okolní</w> budovy byly poškozeny silným větrem.",
                                "tr": "<w>Etraftaki</w> binalar şiddetli rüzgarlardan zarar gördü.",
                                "es": "Los edificios <w>circundantes</w> fueron dañados por los fuertes vientos.",
                                "zh": "<w>周围的</w>建筑物在强风中受损了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "surrounding area",
                        "surrounding countryside",
                        "surrounding villages",
                        "surrounding environment"
