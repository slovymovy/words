                                    {
                                        "sense_id": "2b07fd56-6165-3f90-bd38-6ccc47922966",
                                        "entry_id": "80543170-70a7-378e-aff3-62de7cc18291",
                                        "glosses": [
                                            "Catering to tourists; touristic."
                                        ],
                                        "tags": [
