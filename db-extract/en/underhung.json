                        "entry_id": "55069f8d-afbb-32ee-90ac-532e1fc32505",
                        "glosses": [
                            "Having the lower jaw projecting."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "72fab485-99d8-4e87-a654-6b715b8d0ec0",
                                "sense_id": "ec672539-c0cd-3fd2-a72d-82a763831883",
                                "text": "[H]e was marked with small-pox, had large features, high cheek-bones, deeply set eyes, and a very long chin; and had got the trick which many underhung men have of compressing the upper lip."
                            },
                            {
                                "example_id": "ab4593cb-9c13-4c0a-a434-f5cbb710b0cd",
                                "sense_id": "ec672539-c0cd-3fd2-a72d-82a763831883",
                                "text": "His jaw was underhung, and when he laughed, two white buck-teeth protruded themselves and glistened savagely in the midst of the grin."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d9a80d1-8bc0-30e6-9169-4faa2f969f1f",
                        "entry_id": "55069f8d-afbb-32ee-90ac-532e1fc32505",
                        "glosses": [
                            "Of a sliding door: resting on a track at the bottom, instead of being suspended."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "acb30cdf-66bb-49f6-9937-72569fff4809",
                                "sense_id": "9d9a80d1-8bc0-30e6-9169-4faa2f969f1f",
                                "text": "Usually, [railroad] car doors slide on the top door-track, being then termed overhung doors; the underhung door being one supported and sliding on a rail below the door."
                            }
                        ]
                    }
