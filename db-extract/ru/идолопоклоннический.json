                ],
                "translations": [
                    {
                        "translation_id": "560289cb-6e19-4f28-973e-92ff79652781",
                        "source_entry_id": "3191e95a-78c9-33ff-81a3-b3772c225d46",
                        "source_sense_id": "e18c3eab-9c1b-36b7-9005-9fc4506ba2dd",
                        "target_lang_word": "idolatrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idolatrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d01ceff3-4c84-30d5-a441-179f7c5820f6",
                                        "entry_id": "71cda698-8a7c-3bfc-88b9-ece1d398e3d4",
                                        "glosses": [
                                            "Partaking in idolatry; worshipping idols or false gods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7379d0a-7112-49ab-af19-cecc625767de",
                                                "sense_id": "d01ceff3-4c84-30d5-a441-179f7c5820f6",
                                                "text": "the priests of an idolatrous religion"
                                            },
                                            {
                                                "example_id": "0ea42e65-9cd5-4594-b664-73ffd6b1dd73",
                                                "sense_id": "d01ceff3-4c84-30d5-a441-179f7c5820f6",
                                                "text": "Once Robert Smellie found her in a ruinous kirk on the Lang Muir, where of old the idolatrous rites of Rome were practiced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35eb3e02-3ac3-3039-b278-d3f59ae32ba7",
                                        "entry_id": "71cda698-8a7c-3bfc-88b9-ece1d398e3d4",
                                        "glosses": [
                                            "Engaging in excessive attachment or reverence; inordinately or profanely devoted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be56f4e-4b80-433c-a222-66cbe6a131c2",
                                                "sense_id": "35eb3e02-3ac3-3039-b278-d3f59ae32ba7",
                                                "text": "An idolatrous veneration for antiquity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfe78a7-a312-353c-81a8-539944e1b84c",
                                        "entry_id": "71cda698-8a7c-3bfc-88b9-ece1d398e3d4",
                                        "glosses": [
                                            "Used in or designed for idolatry; devoted to idols or idol-worship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d9fc15-6478-4292-bb1e-b2554b4352f4",
                                                "sense_id": "4dfe78a7-a312-353c-81a8-539944e1b84c",
                                                "text": "An idolatrous image or temple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2447e0a-062f-3f3c-b7be-e86a4c3e7c3c",
                                        "entry_id": "71cda698-8a7c-3bfc-88b9-ece1d398e3d4",
                                        "glosses": [
                                            "Of or pertaining to idolatry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "707dfde6-90ee-40bc-8a70-a38f0250856f",
                                                "sense_id": "d2447e0a-062f-3f3c-b7be-e86a4c3e7c3c",
                                                "text": "Next morning, I sent two of my companions to make enquiry about our prospects, but they returned in the afternoon to report that things were not at all promising, as a number of shopkeepers who traded in articles used for idolatrous worship had already engaged the Towncrier to go round and announce that anyone who rented, leased, or sold premises to the \"Jesus-Church\" would be seized and buried alive!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
