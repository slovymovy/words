                        "examples": [
                            {
                                "example_id": "60176b4e-d9b7-4753-afe8-e4de1ccc3ede",
                                "sense_id": "913ebc8e-6bad-3e9a-b3d3-c2281d00d507",
                                "text": "Mężczyzna rozejrzał się po placu i – zadowolony, że jego lud faktycznie ucieka całymi hordami, czy to w wyjściowych strojach, czy w nocnej bieliźnie, z walizami, małymi dziećmi i sentymentalnymi drobiazgami – zeskoczył z ławy, nie pozostawiając po sobie niczego prócz zapachu miętówek i przepoconych pach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
