{
    "word_family": [
        "reservation",
        "reserved",
        "reservist",
        "unreserved"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aabf12ee-96a7-37df-aa29-c0f26a2d1e06",
                    "sense_definition": "To book a seat, table, or room in advance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "booking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to <w>reserve</w> a table for two at seven o'clock tonight.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>забронировать</w> столик на двоих на семь часов вечера."
                            }
                        },
                        {
                            "text": "It is always a good idea to <w>reserve</w> a room before you travel.",
                            "target_lang_translations": {
                                "ru": "Всегда полезно <w>заказать</w> номер перед поездкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "book#Verb"
                    ],
                    "common_phrases": [
                        "reserve a table",
                        "reserve a room",
                        "reserve a seat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забронировать место, столик или номер заранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забронировать",
                                "target_lang_sense_clarification": "официально закрепить за собой"
                            },
                            {
                                "target_lang_word": "заказать",
                                "target_lang_sense_clarification": "сделать предварительный заказ"
                            },
                            {
                                "target_lang_word": "резервировать",
                                "target_lang_sense_clarification": "оставлять в своем распоряжении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d72e6cb3-31d9-3cd2-afb8-8e7d3e7ff5bc",
                    "sense_definition": "To keep something for a particular person or for a special purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "keeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This special cake is <w>reserved</w> for the guests arriving later this evening.",
                            "target_lang_translations": {
                                "ru": "Этот особенный торт <w>отложен</w> для гостей, которые приедут позже вечером."
                            }
                        },
                        {
                            "text": "Please <w>reserve</w> a parking space for the delivery truck near the entrance.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>зарезервируйте</w> место для парковки грузовика доставки у входа."
                            }
                        }
                    ],
                    "synonyms": [
                        "save#Verb",
                        "hold#Verb"
                    ],
                    "common_phrases": [
                        "reserve for guests",
                        "reserve a space"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранять что-либо для конкретного человека или специальной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарезервировать",
                                "target_lang_sense_clarification": "оставить для определенной цели"
                            },
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "приберечь для кого-то"
                            },
                            {
                                "target_lang_word": "сохранить",
                                "target_lang_sense_clarification": "оставить нетронутым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b981fc8f-a984-3302-87ec-938949874f12",
                    "sense_definition": "To retain a right or to delay a decision until more information is available.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "keeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The management <w>reserves</w> the right to refuse entry to anyone without a ticket.",
                            "target_lang_translations": {
                                "ru": "Администрация <w>оставляет за собой</w> право отказать во входе любому лицу без билета."
                            }
                        },
                        {
                            "text": "I will <w>reserve</w> judgment on the new policy until I see the results.",
                            "target_lang_translations": {
                                "ru": "Я <w>воздержусь</w> от суждений о новой политике, пока не увижу результаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "hold"
                    ],
                    "common_phrases": [
                        "reserve the right",
                        "reserve judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранять за собой право или откладывать решение до получения дополнительной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставлять за собой",
                                "target_lang_sense_clarification": "сохранять право или возможность"
                            },
                            {
                                "target_lang_word": "воздерживаться",
                                "target_lang_sense_clarification": "откладывать суждение или решение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c84b661-eaac-3984-a04b-002cb798089e",
                    "sense_definition": "To make an exception of something; to exclude from a general statement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract applies to all employees, though we <w>reserve</w> certain clauses for senior staff.",
                            "target_lang_translations": {
                                "ru": "Контракт распространяется на всех сотрудников, хотя мы <w>предусматриваем</w> отдельные пункты для руководящего состава."
                            }
                        },
                        {
                            "text": "He agreed to the terms but chose to <w>reserve</w> his final approval for later.",
                            "target_lang_translations": {
                                "ru": "Он согласился с условиями, но решил <w>отложить</w> окончательное одобрение на потом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать исключение для чего-либо; исключить из общего утверждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предусматривать отдельно",
                                "target_lang_sense_clarification": "выделять особые условия"
                            },
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "оставлять в силе только для определенных случаев"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b6cf02a-da5f-3f3e-8a8f-742691fe9c20",
                    "sense_definition": "An area of land kept for a special purpose, such as protecting animals or plants.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the afternoon walking through the local nature <w>reserve</w> to see the birds.",
                            "target_lang_translations": {
                                "ru": "Мы провели вторую половину дня, гуляя по местному природному <w>заповеднику</w>, чтобы посмотреть на птиц."
                            }
                        },
                        {
                            "text": "The government established a new wildlife <w>reserve</w> to protect endangered species.",
                            "target_lang_translations": {
                                "ru": "Правительство создало новый <w>заповедник</w> дикой природы для защиты исчезающих видов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nature reserve",
                        "wildlife reserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли, отведенный для специальных целей, например, для защиты животных или растений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заповедник",
                                "target_lang_sense_clarification": "охраняемая природная территория"
                            },
                            {
                                "target_lang_word": "заказник",
                                "target_lang_sense_clarification": "территория с временным ограничением природопользования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8adc14ee-60f0-3dfe-ad3b-b76a39c9f22f",
                    "sense_definition": "A player who is available to replace another player if they are injured or tired.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The star striker was injured, so a <w>reserve</w> had to play the second half.",
                            "target_lang_translations": {
                                "ru": "Звездный нападающий получил травму, поэтому во втором тайме пришлось играть <w>запасному</w>."
                            }
                        },
                        {
                            "text": "He started the game as a <w>reserve</w> but ended up scoring the winning goal.",
                            "target_lang_translations": {
                                "ru": "Он начал игру как <w>запасной игрок</w>, но в итоге забил победный гол."
                            }
                        }
                    ],
                    "synonyms": [
                        "substitute"
                    ],
                    "common_phrases": [
                        "reserve player",
                        "on the reserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрок, готовый заменить другого игрока в случае травмы или усталости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запасной",
                                "target_lang_sense_clarification": "игрок на скамейке запасных"
                            },
                            {
                                "target_lang_word": "запасной игрок",
                                "target_lang_sense_clarification": "спортсмен для замены"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49e23a91-51c3-3f48-91a5-5335089d93b8",
                    "sense_definition": "A supply of something that is available to be used in the future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country has a large oil <w>reserve</w> that could last for several decades.",
                            "target_lang_translations": {
                                "ru": "Страна обладает огромным <w>запасом</w> нефти, которого может хватить на несколько десятилетий."
                            }
                        },
                        {
                            "text": "She kept a small <w>reserve</w> of cash in her drawer for emergencies.",
                            "target_lang_translations": {
                                "ru": "Она держала в ящике небольшой <w>резерв</w> наличных на случай чрезвычайных ситуаций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oil reserve",
                        "cash reserve",
                        "gold reserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запас чего-либо, доступный для использования в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "накопленные ресурсы"
                            },
                            {
                                "target_lang_word": "резерв",
                                "target_lang_sense_clarification": "источник дополнительных средств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b851a45-dc63-34cf-9653-c2d0bf4d51cf",
                    "sense_definition": "A quality in someone's character that makes them shy or slow to show their feelings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his natural <w>reserve</w>, he was very friendly once you got to know him.",
                            "target_lang_translations": {
                                "ru": "Несмотря на природную <w>сдержанность</w>, он был очень дружелюбен, как только вы узнавали его поближе."
                            }
                        },
                        {
                            "text": "She spoke with great <w>reserve</w> about her personal life during the interview.",
                            "target_lang_translations": {
                                "ru": "Во время интервью она говорила о своей личной жизни с большой <w>замкнутостью</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-restraint",
                        "reticence",
                        "taciturnity"
                    ],
                    "common_phrases": [
                        "natural reserve",
                        "sense of reserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество характера, проявляющееся в застенчивости или нежелании показывать свои чувства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержанность",
                                "target_lang_sense_clarification": "умение контролировать эмоции"
                            },
                            {
                                "target_lang_word": "замкнутость",
                                "target_lang_sense_clarification": "склонность к уединению и молчаливости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec186c8d-169b-3920-8072-000ea662406d",
                    "sense_definition": "Military forces that are not part of the regular army but can be called to fight if needed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He serves in the army <w>reserve</w> and attends training sessions once a month.",
                            "target_lang_translations": {
                                "ru": "Он служит в армейском <w>запасе</w> и раз в месяц посещает тренировочные сборы."
                            }
                        },
                        {
                            "text": "The general decided to call up the <w>reserve</w> to strengthen the front line.",
                            "target_lang_translations": {
                                "ru": "Генерал решил призвать <w>резерв</w>, чтобы укрепить линию фронта."
                            }
                        }
                    ],
                    "synonyms": [
                        "Army Reserve",
                        "reservists"
                    ],
                    "common_phrases": [
                        "army reserve",
                        "military reserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военные силы, не входящие в регулярную армию, но готовые к призыву в случае необходимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "военнообязанные вне службы"
                            },
                            {
                                "target_lang_word": "резерв",
                                "target_lang_sense_clarification": "часть войск для особых случаев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a22786e2-146c-3b93-948a-f97a30ec9e1b",
                    "sense_definition": "An area of land set aside for the use of Indigenous or Aboriginal groups.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community lives on a large <w>reserve</w> in the northern part of the province.",
                            "target_lang_translations": {
                                "ru": "Община живет в большой <w>резервации</w> в северной части провинции."
                            }
                        },
                        {
                            "text": "Many traditions are still practiced by the people living on the <w>reserve</w>.",
                            "target_lang_translations": {
                                "ru": "Многие традиции до сих пор соблюдаются людьми, живущими в <w>резервации</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reservation",
                        "rez"
                    ],
                    "common_phrases": [
                        "indian reserve"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Canada and Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, отведенная для проживания коренных народов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резервация",
                                "target_lang_sense_clarification": "территория для коренного населения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6fe65a7-b997-350e-8be5-ea87d05f9b96",
                    "sense_definition": "The minimum price that a seller will accept for an item being sold at an auction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painting failed to sell because the bidding did not reach the <w>reserve</w>.",
                            "target_lang_translations": {
                                "ru": "Картину не удалось продать, так как ставки не достигли <w>резервной цены</w>."
                            }
                        },
                        {
                            "text": "The auctioneer announced that there was no <w>reserve</w> on the antique furniture.",
                            "target_lang_translations": {
                                "ru": "Аукционист объявил, что на антикварную мебель нет <w>минимальной цены</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reserve price",
                        "no reserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Минимальная цена, которую продавец готов принять за товар на аукционе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резервная цена",
                                "target_lang_sense_clarification": "минимальная цена на торгах"
                            },
                            {
                                "target_lang_word": "отправная цена",
                                "target_lang_sense_clarification": "нижний порог стоимости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18348cb8-faf1-31bb-85a3-a425e7db6128",
                    "sense_definition": "A feeling of doubt or a condition that limits your enthusiasm or agreement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can support your proposal, but only with one major <w>reserve</w> regarding the budget.",
                            "target_lang_translations": {
                                "ru": "Я могу поддержать ваше предложение, но только с одной существенной <w>оговоркой</w> относительно бюджета."
                            }
                        },
                        {
                            "text": "The committee accepted the report without <w>reserve</w> after the presentation.",
                            "target_lang_translations": {
                                "ru": "Комитет принял отчет без <w>оговорок</w> после презентации."
                            }
                        }
                    ],
                    "synonyms": [
                        "reservation"
                    ],
                    "common_phrases": [
                        "without reserve",
                        "with one reserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сомнения или условие, ограничивающее ваш энтузиазм или согласие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оговорка",
                                "target_lang_sense_clarification": "условие, ограничивающее согласие"
                            },
                            {
                                "target_lang_word": "сомнение",
                                "target_lang_sense_clarification": "неуверенность в правильности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d2d2faec-67dd-36bb-9617-0720a0ae639d",
                    "sense_definition": "A village and county seat in New Mexico, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small village of <w>Reserve</w> serves as the administrative center for Catron County.",
                            "target_lang_translations": {
                                "ru": "Небольшая деревня <w>Резерв</w> служит административным центром округа Катрон."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня и административный центр округа в штате Нью-Мексико, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Резерв",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}