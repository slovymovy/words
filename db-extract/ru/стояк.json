                        ],
                        "form": "стояка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9bfa0315-ce40-3feb-8d7c-1f159c3d287f",
                        "entry_id": "f879ee08-f09a-3cf3-9ed5-2667637898c8",
                        "glosses": [
                            "вертикальный брус, столб, служащий опорой для чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967231a4-480a-48de-a611-de61df86c56d",
                                "sense_id": "9bfa0315-ce40-3feb-8d7c-1f159c3d287f",
                                "text": "Сорвал с себя пояс, на бегу петлю сделал, захлестнул за стояк да старым обычаем и перекинулся за городской тын."
                            },
                            {
                                "example_id": "2115476c-2d48-4ef3-b2b8-7a8a4cd2a225",
                                "sense_id": "9bfa0315-ce40-3feb-8d7c-1f159c3d287f",
                                "text": "Спиной опершись об уцелевший стояк забора, он стоял во дворе, курил."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e72cfe7-f1c4-33c7-b773-fbaf837f0223",
                        "entry_id": "f879ee08-f09a-3cf3-9ed5-2667637898c8",
                        "glosses": [
                            "техн. ровная часть трубы, расположенная вертикально; вертикальный трубопровод для подачи воды, газа, водоотведения (канализации) внутри здания, проходящий через все этажи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b7765d-22ac-41e2-a3c3-c394abf9b5d5",
                                "sense_id": "5e72cfe7-f1c4-33c7-b773-fbaf837f0223",
                                "text": "— Вон стояк водопроводный голый у нас! Утепление-то сгорело, и как зима — вода замерзает!"
                            }
                        ]
                    },
                    {
                        "sense_id": "96310563-bca1-3683-83cf-61505e9f8391",
                        "entry_id": "f879ee08-f09a-3cf3-9ed5-2667637898c8",
                        "glosses": [
                            "жарг., груб. то же, что эрекция"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e65df5c-53a6-414e-947e-f926d41468a3",
                                "sense_id": "96310563-bca1-3683-83cf-61505e9f8391",
                                "text": "Я на работу не трахаться хожу! У меня научная тема. Достал он меня, ваш Изя. Что, у него всегда стояк?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "389f4bf4-a09e-4631-bc74-09deea0b09ef",
                        "source_entry_id": "f879ee08-f09a-3cf3-9ed5-2667637898c8",
                        "source_sense_description": "эрекция",
                        "target_lang_word": "Ständer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ständer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                        "entry_id": "69741292-520c-38e3-b3cd-6fb3965ec9a5",
                                        "glosses": [
                                            "freistehende Vorrichtung, um etwas daran aufrecht zu positionieren oder aufzuhängen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057b6688-1202-496b-b6da-77629bb10039",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "Ich habe mein Fahrrad am Ständer abgeschlossen."
                                            },
                                            {
                                                "example_id": "efa4c199-0141-4d36-8abc-29b7d81baa9c",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "„Und er hob, als er wieder allein war, den Koffer auf den Ständer und begann zu packen.“"
                                            },
                                            {
                                                "example_id": "c982e6b1-de1c-4c07-9632-0caadd5f409a",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "„Man hatte Ständer aufgestellt und so mit gelbem Absperrband verbunden, dass sie einen Korridor mit labyrinthartigen Kehrtwendungen bildeten.“"
                                            },
                                            {
                                                "example_id": "b2bd4efb-2ec5-4ba7-a70b-74953e4273da",
                                                "sense_id": "6f1d4263-7f1d-39f9-8047-6d3423cde41e",
                                                "text": "„Aus dem finsteren Flur sah Ari Bjarki am Schreibtisch sitzen, mehrere Kerzen erleuchteten den Raum, große weiße Kerzen in altmodischen Ständern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                        "entry_id": "69741292-520c-38e3-b3cd-6fb3965ec9a5",
                                        "glosses": [
                                            "erigiertes männliches Glied"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c18b2e0-4018-4ced-8036-b537623fe2e2",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "Seine Erregung sah man ihm an seinem Ständer an."
                                            },
                                            {
                                                "example_id": "f53108a2-96c1-4e10-afa9-a2b8a7049947",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Wie fast jeden Morgen war er mit einem ordentlichen Ständer erwacht, und er fragte sich, ob Elisabeth es gesehen hatte.“"
                                            },
                                            {
                                                "example_id": "49cbc94a-aa97-4b45-a5d3-57ef5b0b8e2d",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Einen Ständer hatte ich eh schon.“"
                                            },
                                            {
                                                "example_id": "a994fccb-68f1-4a5f-917f-3f93b9034e42",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Ich hatte die ganze Zeit einen Ständer.“"
                                            },
                                            {
                                                "example_id": "cac6b7dd-0cf0-4333-8808-34525d41a4b0",
                                                "sense_id": "9f016ee4-0f03-3d7a-97ba-7bd0c550adc2",
                                                "text": "„Ich hatte einen jener unermüdlichen, ausdauernden Ständer, die eine Frau verrückt machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
