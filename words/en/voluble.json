{
    "word_family": [
        "volubility",
        "volubly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d27d3ad-da7c-3946-823b-2fc92c96a7e8",
                    "sense_definition": "Speaking continuously, rapidly, and fluently; very talkative.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tour guide was exceptionally <w>voluble</w>, narrating local legends without pausing for breath.",
                            "target_lang_translations": {
                                "tr": "Tur rehberi son derece <w>konuşkandı</w>; soluksuz bir şekilde yerel efsaneleri anlatıyordu."
                            }
                        },
                        {
                            "text": "After a glass of wine, the quiet guest became surprisingly <w>voluble</w> and animated.",
                            "target_lang_translations": {
                                "tr": "Bir kadeh şarabın ardından, o sessiz konuğun şaşırtıcı bir şekilde <w>dili çözüldü</w> ve canlandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "garrulous",
                        "loquacious",
                        "talkative"
                    ],
                    "antonyms": [
                        "halting"
                    ],
                    "common_phrases": [
                        "voluble host",
                        "voluble speaker"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sürekli, hızlı ve akıcı konuşan; çok konuşkan, dili çözülmüş veya geveze."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "konuşkan",
                                "target_lang_sense_clarification": "sürekli ve kolayca konuşan kişi"
                            },
                            {
                                "target_lang_word": "geveze",
                                "target_lang_sense_clarification": "durmaksızın konuşan"
                            },
                            {
                                "target_lang_word": "dili çözülmüş",
                                "target_lang_sense_clarification": "hızlı ve bolca konuşmaya başlayan"
                            },
                            {
                                "target_lang_word": "çenebaz",
                                "target_lang_sense_clarification": "ağzı iyi laf yapan, konuşmayı seven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44cd58ea-53d3-3bac-bd8a-ba9c78417e96",
                    "sense_definition": "Of speech, words, or expression: uttered rapidly, easily, and at great length.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered a <w>voluble</w> stream of excuses to justify his unexpected lateness.",
                            "target_lang_translations": {
                                "tr": "Beklenmedik gecikmesini haklı çıkarmak için <w>sel gibi</w> mazeretler sıraladı."
                            }
                        },
                        {
                            "text": "Her complaints grew more <w>voluble</w> as the meeting dragged on into the evening.",
                            "target_lang_translations": {
                                "tr": "Toplantı akşama doğru uzadıkça şikâyetleri daha da <w>hararetli</w> bir hal aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "effusive",
                        "verbose"
                    ],
                    "common_phrases": [
                        "voluble stream",
                        "voluble excuses",
                        "voluble speech"
                    ],
                    "target_lang_definitions": {
                        "tr": "Söz, ifade veya konuşma için: hızla, kesintisiz ve uzun uzadıya söylenen, sel gibi akan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "akıcı",
                                "target_lang_sense_clarification": "hızlı ve kesintisiz akan söz veya anlatım"
                            },
                            {
                                "target_lang_word": "sel gibi",
                                "target_lang_sense_clarification": "ardı arkası kesilmeyen ifadeler için"
                            },
                            {
                                "target_lang_word": "hararetli",
                                "target_lang_sense_clarification": "hızlı ve coşkulu konuşma/ifade"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fb3ecf4-911c-37ab-a5d7-ea096813267a",
                    "sense_definition": "Moving smoothly and easily; turning or rolling with a fluid motion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hills rolled away into the distance like a sea-serpent in <w>voluble</w> motion.",
                            "target_lang_translations": {
                                "tr": "Tepeler, <w>akıcı</w> bir devinimle kıvrılan bir deniz yılanı gibi uzaklara doğru uzanıyordu."
                            }
                        },
                        {
                            "text": "Water rushed down the slope in a swift and <w>voluble</w> current.",
                            "target_lang_translations": {
                                "tr": "Su, yamaçtan aşağı hızlı ve <w>çağlayan</w> bir akıntıyla aktı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voluble motion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used rarely in modern English to describe rolling physical motion."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Akıcı ve kolayca dönen veya yuvarlanan; akışkan bir devinimle hareket eden (eskimiş)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "akıcı",
                                "target_lang_sense_clarification": "akışkan, pürüzsüz hareket eden"
                            },
                            {
                                "target_lang_word": "dönen",
                                "target_lang_sense_clarification": "yuvarlanarak veya kıvrılarak ilerleyen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3d03002-31d4-3ab6-84d7-156ee9c2e0e3",
                    "sense_definition": "Twisting, twining, or coiling around a support, as certain plant stems do.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist carefully documented the growth patterns of several <w>voluble</w> climbers.",
                            "target_lang_translations": {
                                "tr": "Botanikçi, birkaç <w>sarılıcı</w> tırmanıcı bitkinin büyüme modellerini titizlikle belgeledi."
                            }
                        },
                        {
                            "text": "Honeysuckle is a classic example of a <w>voluble</w> vine climbing around trees.",
                            "target_lang_translations": {
                                "tr": "Hanımeli, ağaçların çevresine tırmanan <w>sarılıcı</w> bir asmanın klasik bir örneğidir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voluble vine",
                        "voluble stems"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir desteğe sarılarak, bükülerek veya tırmanarak uzayan (bitki gövdeleri için)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sarılıcı",
                                "target_lang_sense_clarification": "desteğe dolanarak büyüyen bitki gövdesi"
                            },
                            {
                                "target_lang_word": "tırmanıcı",
                                "target_lang_sense_clarification": "bükülerek sarılan gövde"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}