{
    "word_family": [
        "barsten",
        "uitbarsting",
        "gebarst"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b63fb6cf-c1ce-3b30-8362-b8305e2d5f54",
                    "sense_definition": "plotseling en met veel geweld openbreken of tot een ontploffing komen, zoals bij een vulkaan of een hevige emotie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eruptie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Etna was <w>uitgebarsten</w> en de hete lava vloeide langzaam van de berg naar beneden.",
                            "target_lang_translations": {
                                "en": "Mount Etna had <w>erupted</w> and the hot lava flowed slowly down the mountain."
                            }
                        },
                        {
                            "text": "Toen de oorlog dreigde <w>uit te barsten</w>, vluchtten veel mensen naar het veilige buurland.",
                            "target_lang_translations": {
                                "en": "When the war threatened to <w>break out</w>, many people fled to the safe neighboring country."
                            }
                        }
                    ],
                    "synonyms": [
                        "erupteren",
                        "ontploffen"
                    ],
                    "common_phrases": [
                        "in tranen uitbarsten",
                        "de vulkaan barst uit",
                        "een oorlog barst uit"
                    ],
                    "target_lang_definitions": {
                        "en": "to break open or explode suddenly and with great force, such as a volcano or a violent emotion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "erupt",
                                "target_lang_sense_clarification": "volcanoes or sudden violence"
                            },
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "wars, conflicts, or diseases"
                            },
                            {
                                "target_lang_word": "burst",
                                "target_lang_sense_clarification": "sudden release of pressure or emotion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acb3201b-5665-3cb1-8bdd-165092c179d9",
                    "sense_definition": "plotseling en op een zeer heftige manier beginnen met een bepaalde uiting, meestal lachen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele uiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chantal beet hard op haar lip om niet in lachen <w>uit te barsten</w> tijdens de serieuze vergadering.",
                            "target_lang_translations": {
                                "en": "Chantal bit her lip hard to avoid <w>bursting into</w> laughter during the serious meeting."
                            }
                        },
                        {
                            "text": "Toen de cabaretier de grap vertelde, <w>barstte</w> het hele publiek tegelijkertijd <w>uit</w> in lachen.",
                            "target_lang_translations": {
                                "en": "When the comedian told the joke, the entire audience <w>burst into</w> laughter at the same time."
                            }
                        }
                    ],
                    "synonyms": [
                        "schateren"
                    ],
                    "common_phrases": [
                        "in lachen uitbarsten",
                        "in gejuich uitbarsten"
                    ],
                    "target_lang_definitions": {
                        "en": "to suddenly and very intensely begin a specific expression, usually laughter"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burst into",
                                "target_lang_sense_clarification": "laughter, tears, or cheers"
                            },
                            {
                                "target_lang_word": "break into",
                                "target_lang_sense_clarification": "sudden laughter or song"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}