                "senses": [
                    {
                        "sense_id": "edce642b-906b-3473-a281-53fafd63178b",
                        "entry_id": "3a2222a1-5e9f-32c4-b3a3-4849c3cc6b9b",
                        "glosses": [
                            "Geschwür, welches vorwiegend Blut entleert"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c13c974e-3478-3d30-8103-63f131001488",
                        "entry_id": "3a2222a1-5e9f-32c4-b3a3-4849c3cc6b9b",
                        "glosses": [
                            "Cocktail aus Eierlikör und Kirschlikör"
                        ],
                        "tags": [
                            "Getränk"
                        ],
                        "examples": [
                            {
                                "example_id": "5148fa61-2e61-4c2e-81c5-30381ab1c269",
                                "sense_id": "c13c974e-3478-3d30-8103-63f131001488",
                                "text": "„Ihre Spezialschnäpse waren „Blutgeschwür“ (Eierkognak und Kirschlikör), „Speicherratte“ und „Elefantendubs mit Setzei“.“"
                            },
                            {
                                "example_id": "b872c4b9-8a27-4b5a-b301-5681fa73ef9e",
                                "sense_id": "c13c974e-3478-3d30-8103-63f131001488",
                                "text": "„Ich kenne diesen Likör auch als Blutgeschwür!“"
                            },
                            {
                                "example_id": "830cb879-ba17-4bc6-a5cc-2a7d5cb80b75",
                                "sense_id": "c13c974e-3478-3d30-8103-63f131001488",
                                "text": "„Der Cocktail Blutgeschwür stammt ursprünglich aus Breslau. Für den Cocktail Blutgeschwür zunächst Eier Likör in ein Glas füllen. Kirsch Likör langsam über den Rücken eines Teelöffels auf den Eier Likör gießen. Der Likör sinkt im Eier Likör nach unten. Da der Cocktail Blutgeschwür nicht verrührt wird, zählt er zu den Pousse Cafes.“"
                            },
                            {
                                "example_id": "acdbe8d5-0875-4ee7-a30a-b9fb366bdce0",
                                "sense_id": "c13c974e-3478-3d30-8103-63f131001488",
                                "text": "„Blutgeschwür, Wolga-Bootsmann und Grüne Wiese: So mixte sich die DDR in den Rausch.“"
                            },
                            {
                                "example_id": "de685e1d-ad8c-472f-9d65-1459cd873906",
                                "sense_id": "c13c974e-3478-3d30-8103-63f131001488",
                                "text": "„Damit du dich nicht blamierst, wenn dich jemand beim nächsten Besuch in Thüringen & Co. auf ein „Blutgeschwür“ einlädt, haben wir hier die seltsamsten Cocktails Ostdeutschlands auf den Prüfstand gestellt. Wie du schnell feststellen wirst, gilt „Nomen est Omen“ glücklicherweise nicht immer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
