                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dążyć",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wielu godzinach męczącej jazdy wreszcie dotarliśmy do <w>celu</w>.",
                            "target_lang_translations": {
                                "ru": "После многих часов утомительной поездки мы наконец добрались до <w>пункта назначения</w>."
                            }
