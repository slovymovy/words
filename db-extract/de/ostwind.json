                ],
                "senses": [
                    {
                        "sense_id": "cf9dd058-20d8-3c22-a925-6a5446bd75ec",
                        "entry_id": "4353a266-3285-370a-9e1e-6614dba5196b",
                        "glosses": [
                            "aus östlicher Richtung kommende Luftbewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ff1b07-271c-4548-babd-b401e8780c58",
                                "sense_id": "cf9dd058-20d8-3c22-a925-6a5446bd75ec",
                                "text": "„Die obere Stratosphäre weist in unserem Sommer ein polares Hoch mit Ostwind über der Nordhalbkugel auf, in unserem Winter ein polares Tief und Westwind.“"
                            },
                            {
                                "example_id": "3d602372-f8be-4d28-b1ce-930795424f0b",
                                "sense_id": "cf9dd058-20d8-3c22-a925-6a5446bd75ec",
                                "text": "„Da in Südafrika nicht der Westwind vom Atlantik, sondern der Ostwind vom Indischen Ozean der Hauptregenbringer ist, nehmen die Niederschläge - und somit auch die Üppigkeit der Pflanzenwelt - generell von Osten nach Westen ab.“"
                            },
                            {
                                "example_id": "f92c9a3b-fc02-407f-88f8-c22a5d3784ce",
                                "sense_id": "cf9dd058-20d8-3c22-a925-6a5446bd75ec",
                                "text": "„Wir hatten frischen Westwind und kreuzten eine Zeit lang zwischen Europa und Afrika hin und her, als uns ein heftiger Ostwind traf, der uns mit rasender Geschwindigkeit in den Atlantik hinaustrieb.“"
                            },
                            {
                                "example_id": "d11db078-74de-4c9e-80ee-ba80ce5ff19f",
                                "sense_id": "cf9dd058-20d8-3c22-a925-6a5446bd75ec",
                                "text": "„Der scharfe Ostwind sollte nicht in die Stuben dringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
