                        "glosses": [
                            "A minor or insignificant philosopher; someone who claims philosophical expertise that they do not possess."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "339a4a57-1b6c-40ff-ac48-04ca9858eb36",
                                "sense_id": "64bbb8c5-9fb1-3acb-b44b-b00b045c33be",
                                "text": "But you know, or should know, that I am a senior philosophunculist on active duty."
                            },
                            {
                                "example_id": "aead4231-01c6-4a67-beae-9560d804f25c",
                                "sense_id": "64bbb8c5-9fb1-3acb-b44b-b00b045c33be",
                                "text": "The unsettled races of the north, constituting the Chartists, are Scotch philosophunculists and Irish savages, or the children of such."
                            },
                            {
                                "example_id": "a63bfb2d-3afe-43d8-96f8-823f8d8368d0",
                                "sense_id": "64bbb8c5-9fb1-3acb-b44b-b00b045c33be",
                                "text": "Cunningham's brilliant explication of ‘glassie Essence’ and related matters first appeared in ELH, 19 (1952), see esp. p. 266, but has been ignored by those whom Robert Burton would call the philosophunculists of the academy as well as by most students of Shakespeare."
                            },
                            {
                                "example_id": "459b1e63-a7ec-4f64-9ecc-16bd71d801f6",
                                "sense_id": "64bbb8c5-9fb1-3acb-b44b-b00b045c33be",
                                "text": "However, you should never be a philosophunculist (Go look it up) to succeed in your business ventures."
                            }
                        ]
                    }
