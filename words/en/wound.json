                                "target_lang_sense_clarification": "humillar o mortificar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤害",
                                "target_lang_sense_clarification": "情感上的打击"
                            },
                            {
                                "target_lang_word": "刺伤",
                                "target_lang_sense_clarification": "指言语等对自尊的伤害"
                            }
                        ]
                    }
                }
            ]
        }
    ]
