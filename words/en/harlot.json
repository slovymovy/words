                },
                {
                    "sense_id": "377a4ae0-362a-330c-b41d-8e45e997d15c",
                    "sense_definition": "A woman regarded as sexually promiscuous or indecent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "female_sexuality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict villagers unjustly branded the independent young woman a shameless <w>harlot</w> for refusing to marry.",
