                                        "sense_id": "e65c6282-4803-3363-bf8e-62d8a5ec5376",
                                        "entry_id": "08b3faca-de3b-39a9-9237-9590f1665c9b",
                                        "glosses": [
                                            "Oración en arameo, una de las principales en las ceremonias religiosas y funerales judías."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5346fc0-6ec7-4a9c-9d8b-7cd5b03b8334",
                                                "sense_id": "e65c6282-4803-3363-bf8e-62d8a5ec5376",
                                                "text": "Qué raro alabar el nombre de Dios en el dolor más grande. Murmuré el kadish."
                                            },
                                            {
                                                "example_id": "e60d2c3a-89d3-42ba-96fd-7338ecc72724",
                                                "sense_id": "e65c6282-4803-3363-bf8e-62d8a5ec5376",
                                                "text": "\"Tampoco hay, debajo de las lápidas, cadáveres individualizados, sino puñados de ceniza residual, de ceniza colectiva. Por lo visto, cada mañana, a las once, un cantor oficia aquí el kadish, la oración para los muertos. Gironella, José María (1978) El escándalo de Tierra Santa. Barcelona: Plaza & Janés, p. 358."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
