                "senses": [
                    {
                        "sense_id": "6ad787cc-36d7-31b0-95f8-9e689a0c45b9",
                        "entry_id": "65b779f6-4dee-313a-8fbe-378a473e0b3b",
                        "glosses": [
                            "schele hoofdpijn"
                        ],
                        "tags": [],
