                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9f1f5bc9-0ddf-46cd-ac99-474fd69c62d9",
                        "entry_id": "f30b30e6-201d-3b4b-be7f-68cefaadfdaf",
                        "tags": [
                            "plural"
                        ],
                        "form": "tarsectomies"
