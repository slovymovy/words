                                    {
                                        "sense_id": "8b575205-789b-3493-8b64-5c018467854b",
                                        "entry_id": "825c021a-0606-3b2f-b4a0-3e7671c5157f",
                                        "glosses": [
                                            "Grafik mit (nicht notwendigerweise gleich breiten) Säulen, deren Flächeninhalte Häufigkeiten oder Wahrscheinlichkeiten angeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a35941-840d-491d-bb1e-5ac8243e3494",
                                                "sense_id": "8b575205-789b-3493-8b64-5c018467854b",
                                                "text": "„Bei einem Histogramm werden Rechtecke über die Klassenintervalle [αₖ,;αₖ₊₁,] errichtet. Die Fläche eines Rechtecks stellt die rel. Häufigkeit der jeweiligen klassifizierten Merkmalsausprägung dar. Aufgrund verschieden großer Intervalle kann die Rechteckbreite variieren. Die Höhe muss dementsprechend angepasst werden.“"
                                            },
                                            {
                                                "example_id": "f2e93386-a545-490f-a8a9-0425c755fd0f",
                                                "sense_id": "8b575205-789b-3493-8b64-5c018467854b",
                                                "text": "„In einem Histogramm werden die Häufigkeiten im Prinzip durch den Flächeninhalt der einzelnen Säulen bestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
