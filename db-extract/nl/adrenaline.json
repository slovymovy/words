                    {
                        "translation_id": "2194b8a9-efb1-49cf-9955-24e3237c56af",
                        "source_entry_id": "f3ae5af0-d198-3c62-ad06-460c229947c0",
                        "source_sense_id": "05c96ffc-f0fc-3ed2-9a4b-95f458a02030",
                        "source_sense_description": "Adrenalin",
