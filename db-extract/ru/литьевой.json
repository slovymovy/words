                ],
                "senses": [
                    {
                        "sense_id": "12e6c1ae-577c-3fc8-a274-89187d7f8c99",
                        "entry_id": "f1b3267a-6f4e-3518-be89-6ae591dd56f6",
                        "glosses": [
                            "связанный с процессом изготовления каких-либо изделий литьём, предназначенный для литья (в отношении результата литья используется прилагательное литой)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92e09e4-ed72-4718-abf8-223ec2fd3681",
                                "sense_id": "12e6c1ae-577c-3fc8-a274-89187d7f8c99",
                                "text": "Экструзионный и литьевой акрил отличаются своими эксплуатационными характеристиками и физико-химическими свойствами."
                            },
                            {
                                "example_id": "d20f4c31-e227-4b9c-b933-094b544f02e9",
                                "sense_id": "12e6c1ae-577c-3fc8-a274-89187d7f8c99",
                                "text": "Литьевое крепление подошвы в настоящее время считается самым надёжным и прогрессивным, обеспечивающим отличные эксплуатационные характеристики. Его особенность – в креплении подошвы методом литья, то есть материал впрыскивается в специальную пресс-форму, где и выполняется его крепление к заготовке верха с одновременным формованием и отделкой."
                            }
                        ]
                    }
