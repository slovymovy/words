                "senses": [
                    {
                        "sense_id": "901938d0-82f5-3d46-8b89-87245c0c7d03",
                        "entry_id": "e5e0070d-7420-3bba-ad96-8f87ebdaf1ee",
                        "glosses": [
                            "положить, разложить, покрывая поверхность чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f707c6e4-2069-3b9f-9705-dcf6ff062cb5",
                        "entry_id": "e5e0070d-7420-3bba-ad96-8f87ebdaf1ee",
                        "glosses": [
                            "положить, разложить постельные принадлежности, приготовляя (постель) для сна"
                        ],
                        "tags": [
                            "также без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "c7dd7798-44fb-4da8-8f67-449be5e80cbf",
                                "sense_id": "f707c6e4-2069-3b9f-9705-dcf6ff062cb5",
                                "text": "Давай мы ему, Феклинька, постель постелем, пока он у городничего."
                            },
                            {
                                "example_id": "28ba235e-07b4-4c11-bf72-7d79f2957f00",
                                "sense_id": "f707c6e4-2069-3b9f-9705-dcf6ff062cb5",
                                "text": "Я теперь гулять пойду; а ужо нам Глаша постелет постели в саду, маменька позволила."
                            }
                        ]
                    }
                ],
