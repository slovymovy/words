                        "examples": [
                            {
                                "example_id": "59c15893-8991-4d3f-82cc-3822dbd1f3b3",
                                "sense_id": "60e76d77-ecad-31bb-ac85-391c4be3cddd",
                                "text": "„Die hässlichen Schuhe und die Vampirromane waren nur die Spitze eines neu aufkommenden Trends.“"
                            },
                            {
                                "example_id": "b9e4e322-87cc-4137-b161-2c8841996f0c",
                                "sense_id": "60e76d77-ecad-31bb-ac85-391c4be3cddd",
                                "text": "„1897 veröffentlichte Bram Stoker (1847-1912) Dracula, es dauerte jedoch einige Zeit, bis das Buch als prototypischer Vampirroman Berühmtheit erlangte.“"
                            }
                        ],
