                                    {
                                        "sense_id": "84ec534e-f9ec-37d4-87b6-6d406370b27a",
                                        "entry_id": "4d9528de-9616-39b5-9d22-700797ad04b2",
                                        "glosses": [
                                            "iemand die een opschudding of rel veroorzaakt of een conflict erger maakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50d7c3a9-391d-4542-a6c3-fd981c6594e3",
                                                "sense_id": "84ec534e-f9ec-37d4-87b6-6d406370b27a",
                                                "text": "Zonder dat er een naam aan te pas kwam liet de expert zijn analyse los op deze onschuldige stromingsgegevens met als resultaat dat de abt de aanstokers van de ruzie kon ontmaskeren."
                                            },
                                            {
                                                "example_id": "74aba2aa-1ae5-4830-acad-2e4fba1ccfbd",
                                                "sense_id": "84ec534e-f9ec-37d4-87b6-6d406370b27a",
                                                "text": "De mobiele brigade was de aanstoker van het geweld. Ze dachten dat de mensen wel bang zouden worden, zoals bij incidenten elders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
