                    },
                    {
                        "sense_id": "b3834b2f-2da5-30b0-90fc-29554f0bef97",
                        "entry_id": "4b197d24-8e00-3116-9845-202e535317ea",
                        "glosses": [
                            "Redonner un attrait enchanteur à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb13e7a-1cbf-42f4-8e8c-bd1449fdcb12",
                                "sense_id": "b3834b2f-2da5-30b0-90fc-29554f0bef97",
                                "text": "Grâce à leurs propriétés anti-inflammatoires et antioxydantes, ils viennent réenchanter le microbiote."
                            },
                            {
                                "example_id": "51ed6227-59f8-44de-a0e9-68d7bb27ed06",
                                "sense_id": "b3834b2f-2da5-30b0-90fc-29554f0bef97",
                                "text": "«Je veux offrir à la jeunesse de France une vie meilleure que la nôtre: c’est le rêve français que je veux réenchanter», a-t-il lancé en fin de soirée devant des partisans enthousiastes au siège du parti rue de Solférino à Paris."
                            }
                        ]
                    }
