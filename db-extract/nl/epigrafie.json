                        "translation_id": "3e715b57-7def-4512-ad74-82b5008e22d9",
                        "source_entry_id": "dd4bb2f1-6b51-39e2-a8aa-68a170ec11fa",
                        "source_sense_id": "1fdd4978-46df-31d0-8051-25ed221ff226",
