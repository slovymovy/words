                ],
                "senses": [
                    {
                        "sense_id": "d9c655ea-4966-391f-b832-2ffa632bce61",
                        "entry_id": "cf9da125-5978-38f8-a99f-b572c6a6a476",
                        "glosses": [
                            "bei Begegnungen verpflichtet, Vorfahrt zu gewähren"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "43095d9a-ab7f-4e2a-bccf-8d841716df9a",
                                "sense_id": "d9c655ea-4966-391f-b832-2ffa632bce61",
                                "text": "„Die Beklagten wendeten ein, dem Erstbeklagten wäre ein Anhalten vor dem Bahnschranken nicht mehr möglich gewesen, das Alleinverschulden treffe den benachrangten Kläger.“"
                            },
                            {
                                "example_id": "970e88ba-df5e-49b0-9996-d06ee6b313e5",
                                "sense_id": "d9c655ea-4966-391f-b832-2ffa632bce61",
                                "text": "„Auch darf sich ein Radfahrer nur mit zehn km/h einer Radfahrerüberfahrt nähern, während die Annäherungsgeschwindigkeit des benachrangten Autoverkehrs nicht geregelt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
