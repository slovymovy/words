                                    {
                                        "sense_id": "2f415d62-a095-3d17-ae87-63a495f4d57e",
                                        "entry_id": "7c90bed6-7198-317b-972e-61892b4faf3c",
                                        "glosses": [
                                            "über Einfluss verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58781188-2f97-4c2e-9a5b-56bfac619e73",
                                                "sense_id": "2f415d62-a095-3d17-ae87-63a495f4d57e",
                                                "text": "„Erstmals spricht jetzt ein über Jahre einflussreicher Politiker aus dem Regierungslager aus, was viele in der Koalition denken: dass die europäische Währungsunion nicht zu retten ist.“"
                                            },
                                            {
                                                "example_id": "27ff28bb-e475-43ed-8586-9c51a806c84f",
                                                "sense_id": "2f415d62-a095-3d17-ae87-63a495f4d57e",
                                                "text": "„In einer einflussreichen Vorlesung von 1962 hat der Philosoph Joachim Ritter das mit Petrarca einsetzende Motiv des Blicks vom Berge als Ausdruck neuzeitlicher Subjektivität gedeutet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68eea4a9-d934-4234-8c3c-b105210bf0ef",
                        "source_entry_id": "00da730b-4dca-3da2-8eb0-f88b3c332e57",
                        "source_sense_id": "c37e1330-062e-3a52-9c4b-ba6f5ca9e4b7",
                        "target_lang_word": "influential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "influential",
