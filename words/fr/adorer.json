                                "ru": "Дети <w>обожают</w> проводить каникулы у моря.",
                                "nl": "Kinderen <w>vinden het heerlijk</w> om hun vakantie aan zee door te brengen.",
                                "de": "Die Kinder <w>lieben</w> es, ihre Ferien am Meer zu verbringen.",
                                "pl": "Dzieci <w>uwielbiają</w> spędzać wakacje nad morzem.",
                                "it": "I bambini <w>adorano</w> trascorrere le vacanze al mare.",
                                "cs": "Děti <w>zbožňují</w> trávit prázdniny u moře.",
                                "tr": "Çocuklar tatillerini deniz kenarında geçirmeye <w>bayılırlar</w>.",
                                "es": "A los niños les <w>encanta</w> pasar las vacaciones a orillas del mar.",
                                "zh": "孩子们<w>喜欢</w>在海边度过假期。"
                            }
