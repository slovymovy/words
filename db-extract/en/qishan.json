                        "examples": [
                            {
                                "example_id": "0b48c2b5-8a76-4208-aee5-3e1d529d5dce",
                                "sense_id": "8a80fc9c-d4f5-3fea-b383-a786f03e1b86",
                                "text": "For two decades Mr. Lu, 76, cultivated his banana trees in the Qishan district, rising at 5 a.m. and working until sunset."
                            },
                            {
                                "example_id": "2d224ea8-045a-4f75-9b7a-ebdf009e15de",
                                "sense_id": "8a80fc9c-d4f5-3fea-b383-a786f03e1b86",
                                "text": "For Qishan, Meinong and Foguangshan you’re best off catching a bus outside Kaohsiung Zuoying HSR Station/Zuoying KMRT Station. From there Freeway Bus #10 is the quickest and cheapest service to Qishan (departs every 20mins on w/days 🕘 06.30-23.00 Mon-Fri, less frequent at w/ends; takes 40mins; NTD50)."
                            },
                            {
                                "example_id": "2df8ec95-afbb-4a2a-95da-0dba94c1c752",
                                "sense_id": "8a80fc9c-d4f5-3fea-b383-a786f03e1b86",
                                "text": "The Mainland Affairs Council (MAC) stated that Minister Hsiao–yueh Chang today (June 9, 2017) participated in a “Mobile Service Train activity” held by the National Immigration Agency in Qishan District, Kaohsiung City."
                            }
                        ]
                    }
