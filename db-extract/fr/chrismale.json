                        "glosses": [
                            "Petit coffret d’origine anglaise, porté autour du cou, qui servait à transporter des hosties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "603bb8b3-bbc3-4f0a-bf9d-e5f10b95666c",
                                "sense_id": "c8025958-332b-3a55-b175-96f5449bd670",
                                "text": "Kismeel est l’équivalent de chrismale en anglo-saxon de Northumbrie. Des règles monastiques et des vies de saints irlandais et gallois mentionnent le chrismale, petit coffret qui servait à porter sur soi les espèces consacrées."
                            },
                            {
                                "example_id": "d3213e30-c78f-43ad-b83a-e6260fa090bd",
                                "sense_id": "c8025958-332b-3a55-b175-96f5449bd670",
                                "text": "Le chrismale de Mortain est un petit coffret de hêtre recouvert de cuivre ouvragé et décoré sur l’une des faces d’un Christ Pantocrator encadré par les archanges Michel et Gabriel."
                            }
                        ]
                    }
