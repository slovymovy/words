                ],
                "senses": [
                    {
                        "sense_id": "0ced2834-f069-303a-84e8-10dc81aca04c",
                        "entry_id": "9640d070-dc8c-3f5b-a81c-fa1b36fdbf14",
                        "glosses": [
                            "zębate zwieńczenie murów obronnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbdd0885-24b5-48da-9e29-cef325fcf749",
                                "sense_id": "0ced2834-f069-303a-84e8-10dc81aca04c",
                                "text": "Łucznik schował się za jedną z kamiennych blanek i cierpliwie wyczekiwał."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5e03ce97-2e0f-3ea4-a1c2-2687d9e9d7f5",
                        "entry_id": "9640d070-dc8c-3f5b-a81c-fa1b36fdbf14",
                        "glosses": [
                            "gruba belka"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16de82c4-af52-4b99-87f5-ea0a979b4019",
                        "source_entry_id": "9640d070-dc8c-3f5b-a81c-fa1b36fdbf14",
                        "source_sense_id": "0ced2834-f069-303a-84e8-10dc81aca04c",
                        "target_lang_word": "Zinne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                        "entry_id": "322af360-4c92-3dc2-bc91-e865ca6da57c",
                                        "glosses": [
                                            "Schutzvorrichtung auf Burgen, Mauern oder Ähnlichem, die eine Gegenwehr ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c731b558-3a69-416b-9cf1-2205e53d7c73",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "Die Bogenschützen fanden Schutz hinter der Zinne und konnten gleichzeitig ein Ziel erfassen."
                                            },
                                            {
                                                "example_id": "73510419-221d-4f24-9ab9-371477cd3b52",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Wohl mehr als 300000 Menschen leben hinter den Zinnen der Stadt, auf einer Fläche, die jene des antiken Rom übertrifft.“"
                                            },
                                            {
                                                "example_id": "3873a6be-9812-4471-9e09-2533bc770aa1",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Erst unter den Zinnen der osmanischen Stadtmauer endete der verwinkelte Konvent.“"
                                            },
                                            {
                                                "example_id": "38548392-a9a9-466e-9aa9-3eec8b7fb884",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Auf den Mauerkronen sah ich die Zinnen, die zum größten Teil unversehrt waren; sie stammten immerhin aus dem zweiten Punischen Krieg.“"
                                            },
                                            {
                                                "example_id": "7b8fe214-6c83-413b-b46b-c1e8c95b4b16",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Kein Mensch kümmerte sich um die Sonne über dem Meer, um die Zinnen der Kirche Saint-Victor, um die Netze, die auf der ganzen Länge des Hafendamms zum Trocknen lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d4242e4-f11d-3670-b2ba-097834431172",
                                        "entry_id": "322af360-4c92-3dc2-bc91-e865ca6da57c",
                                        "glosses": [
                                            "der oberste Punkt eines Berges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481d821f-ebac-449e-8632-6939cd064269",
                                                "sense_id": "8d4242e4-f11d-3670-b2ba-097834431172",
                                                "text": "Bevor Alois die Zinne des Bergs erreichen konnte, rutschte er wieder in das Tal zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0090ad65-244c-3f09-9944-557dc90aa7f3",
                                        "entry_id": "322af360-4c92-3dc2-bc91-e865ca6da57c",
                                        "glosses": [
                                            "Dachterrasse"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae0af4c2-82af-4989-b5ec-1973c66e5c30",
                                                "sense_id": "0090ad65-244c-3f09-9944-557dc90aa7f3",
                                                "text": "Mit bald neunzig, als die Schweizer Seen zufroren, hat sie auf der Zinne Wäsche gehängt, die sie zum Plätten tiefgefroren vorzog, holte sich dabei eine Erkältung, ging zu Bett und starb."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
