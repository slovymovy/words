                    {
                        "sense_id": "30569c18-1d51-3c5f-b962-d7d55083ecfc",
                        "entry_id": "09cd7422-239d-3417-b7e6-c02090098476",
                        "glosses": [
                            "Qualifiait les écuyers qui avaient la surveillance des chevaux et de tous les équipages de l’écurie dans la maison du roi et des princes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016a3352-4e5e-43b4-a5d5-7f13a4fafc6e",
                                "sense_id": "30569c18-1d51-3c5f-b962-d7d55083ecfc",
                                "text": "Les jours étaient proches des charges recouvrées à la Cour, et des sinécures bien rentées, des chambellans, des maîtres de cérémonies, des veneurs, des écuyers cavalcadours."
                            },
                            {
                                "example_id": "a7ee0e6a-16ea-4e0b-bbee-f6ea0ba62dfd",
                                "sense_id": "30569c18-1d51-3c5f-b962-d7d55083ecfc",
                                "text": "Mais il avait dû s’en tenir à ce rôle d’écuyer cavalcadour et d’agent d’affaires par occasion ; la Tompkins lui ayant déclaré qu’elle ne pouvait le souffrir qu’à cheval, qu’autrement il était \"stioupide\", et puis qu’elle aimait à être toute seule, toujours, « avec ses diables bleus »."
                            }
                        ]
                    },
