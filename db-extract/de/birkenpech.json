                    {
                        "translation_id": "d89e9791-ff1a-46a7-913e-ce8559d09941",
                        "source_entry_id": "edc600a7-8f96-3989-bf4e-6d148548a23d",
                        "source_sense_id": "da27debe-cd5a-34a0-b1be-32c861d0d8c4",
                        "source_sense_description": "teerartiges Destillat, das aus der Birkenrinde gewonnen wird",
                        "target_lang_word": "goudron de bouleau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goudron de bouleau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26e05711-1291-38c8-81b2-2b78c3b5d290",
                                        "entry_id": "d9f5aa66-1518-3a6e-bf65-abcef74b6540",
                                        "glosses": [
                                            "Substance noirâtre pâteuse et collante, obtenue par une carbonisation contrôlée d’écorce de bouleau, et utilisée, dès la préhistoire néandertalienne, comme colle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3440e3bb-f4ee-49c7-9b17-8b7096dc909e",
                                                "sense_id": "26e05711-1291-38c8-81b2-2b78c3b5d290",
                                                "text": "Le goudron de bouleau a été récemment introduit dans les usages thérapeutiques à New-York."
                                            },
                                            {
                                                "example_id": "191f89c7-134f-47c0-9b01-a2824726324a",
                                                "sense_id": "26e05711-1291-38c8-81b2-2b78c3b5d290",
                                                "text": "La lame de silex est soit simplement insérée, soit collée dans une rainure. La colle est un mélange de goudron de bouleau, d’huile de lin et d’une cire à Chalain (Jura)."
                                            },
                                            {
                                                "example_id": "9ae00776-34c4-4211-b92d-1d049034dc53",
                                                "sense_id": "26e05711-1291-38c8-81b2-2b78c3b5d290",
                                                "text": "Selon l’équipe, s’il est probable que la production souterraine de goudron de bouleau par Néandertal soit le résultat de longues expérimentations, le fait qu’elle précède d’environ 100 000 ans le plus ancien exemple connu pour Homo sapiens remet en question notre perception de l’intelligence humaine moderne ainsi que son caractère unique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
