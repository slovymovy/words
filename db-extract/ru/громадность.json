                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b72cf4c-159e-47bc-aa9e-f6f7fa7ce692",
                                "sense_id": "c7a6be5e-72c6-3651-b979-ee020476f0f2",
                                "text": "Город был громаден и многолюден, и было в этом многолюдии и громадности что-то упорное, непобедимое и равнодушно-жестокое.",
                                "translation": "The city was immense and populous, and there was in its populousness and immensity something stubborn, unconquerable, and callously cruel.",
                                "english": "The city was immense and populous, and there was in its populousness and immensity something stubborn, unconquerable, and callously cruel."
                            }
                        ]
                    }
