                "senses": [
                    {
                        "sense_id": "4a352538-272f-317a-92b2-7dd9d3ba8813",
                        "entry_id": "e0db3df7-5a9e-3868-a2cd-f018d9639882",
                        "glosses": [
                            "durchschnittliche Anzahl der Einwohner pro Fläche für ein bestimmtes Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611cb89b-be05-418a-b029-7ee63440e653",
                                "sense_id": "4a352538-272f-317a-92b2-7dd9d3ba8813",
                                "text": "Die Bevölkerungsdichte in Deutschland beträgt derzeit circa 230 Einwohner pro Quadratkilometer."
                            },
                            {
                                "example_id": "d2ef8a4b-2864-4cac-8d03-607f8709681d",
                                "sense_id": "4a352538-272f-317a-92b2-7dd9d3ba8813",
                                "text": "Beim Vergleich der Bevölkerungsdichten von der Region Stuttgart und der Uckermark sollte ein Unterschied auffallen."
                            },
                            {
                                "example_id": "950b2ac9-a7db-4e78-919d-bd126075e0da",
                                "sense_id": "4a352538-272f-317a-92b2-7dd9d3ba8813",
                                "text": "„Die Ukraine produziert nicht nur viel Getreide, sie verbraucht auch nur wenig davon selbst: Wegen seiner riesigen Anbauflächen bei gleichzeitig geringer Bevölkerungsdichte kann das Land einen sehr großen Teil seiner Ernten verkaufen – nicht nur nach Europa, sondern auch in die armen Regionen der Erde.“"
                            },
                            {
                                "example_id": "fd4672b1-99c4-4425-b1eb-66870ddfd468",
                                "sense_id": "4a352538-272f-317a-92b2-7dd9d3ba8813",
                                "text": "„Verständlich wird dies jedoch, wenn man sich vor Augen führt, dass nicht nur der zivilisatorische Entwicklungsstand, sondern auch die Bevölkerungsdichte der Indigenen weit unterschätzt worden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
