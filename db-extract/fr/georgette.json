                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0e8d18-1f63-3041-8620-250247868748",
                                        "entry_id": "698f28f9-7183-3d36-9ea5-9d8f9c31d00d",
                                        "glosses": [
                                            "„zartes, durchsichtiges Gewebe aus Kreppgarn“"
                                        ],
                                        "tags": [
                                            "Textilwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe15a02e-9562-48fd-993f-21faf088d3f6",
                                                "sense_id": "6e0e8d18-1f63-3041-8620-250247868748",
                                                "text": "„Bald begann er, größere Waren zu verkaufen: Schals, Tücher, Kunstseide oder Georgette als Meterware - dieses Wort sprach er mit einem solchen Entzücken aus, dass man Gänsehaut bekam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a709bba6-af68-4f82-8e96-2f32ad9e5686",
                        "source_entry_id": "c4d975b1-21c9-3156-a602-1266d86e2fbd",
                        "source_sense_description": "tissu",
                        "target_lang_word": "georgette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "georgette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f8ff270-150a-33fd-a1b3-9b6f66d84a27",
                                        "entry_id": "9252ac32-a59c-332f-b3b9-58ada0bb3ac9",
                                        "glosses": [
                                            "A thin lightweight silk or cotton fabric with a matte finish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9192cedd-f948-43e4-bae7-8f2171959608",
                                                "sense_id": "2f8ff270-150a-33fd-a1b3-9b6f66d84a27",
                                                "text": "She looked away from the stage at an enormously stout lady promenading in a black and salmon georgette dress."
                                            },
                                            {
                                                "example_id": "60ca786a-b9d9-4d72-a860-165ee476d9a0",
                                                "sense_id": "2f8ff270-150a-33fd-a1b3-9b6f66d84a27",
                                                "text": "Martha began sarcastically to explain why it was that even if she had been twelve she could not have worn this pink frilled georgette to the Van Rensbergs' house, since nice little English girls were not for export."
                                            },
                                            {
                                                "example_id": "dfb5d6a3-423d-41a4-a107-5a0e08728694",
                                                "sense_id": "2f8ff270-150a-33fd-a1b3-9b6f66d84a27",
                                                "text": "Silk chiffon and silk georgette. Two thin, thin materials that cannot be confused with each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f2a246d-4aec-4477-b75b-8722be2202c3",
