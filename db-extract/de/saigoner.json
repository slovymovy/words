                "senses": [
                    {
                        "sense_id": "bc1d6f26-6211-386f-b24b-d740988c7904",
                        "entry_id": "7788599c-e539-3ff8-ac71-bdbdee04a9f1",
                        "glosses": [
                            "sich auf Saigon beziehend, aus Saigon kommend, zu Saigon gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73acb159-ee56-4daf-a365-12a28b3b4b45",
                                "sense_id": "bc1d6f26-6211-386f-b24b-d740988c7904",
                                "text": "„Ich warf einen letzten Blick auf das Givral Café, wo ich bei meinen Rendezvous mit anständigen Saigoner Mädchen und ihren mumifizierten Anstandsdamen französisches Vanilleeis genossen hatte.“"
                            },
                            {
                                "example_id": "29539a86-6004-43c7-8956-57ddadbb1295",
                                "sense_id": "bc1d6f26-6211-386f-b24b-d740988c7904",
                                "text": "„Ein Mitarbeiter brachte ein Kabel aus der Saigoner Station, das die neueste Katastrophe in Vietnam zusammenfasste.“"
                            },
                            {
                                "example_id": "bd47cdb8-877f-4123-8cca-a282bcb3a435",
                                "sense_id": "bc1d6f26-6211-386f-b24b-d740988c7904",
                                "text": "„Vor zehn Jahren hatte der Boss einer Saigoner Straßenbande fünf ehemalige Offiziere der vietnamesischen Volksarmee als überqualifizierte Leibwächter engagiert, die alle einer Infanterieeinheit namens ›Die Tiger‹ angehört hatten, einer Elite-Spezialtruppe für Aufklärungsmissionen im Dschungel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
