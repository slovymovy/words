                {
                    "sense_id": "40171404-39e5-3fbe-8be9-a80f9ccb8c80",
                    "sense_definition": "Способный к самостоятельному передвижению",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Современный <w>мобильный</w> робот может самостоятельно обходить препятствия в помещении.",
                            "target_lang_translations": {
                                "en": "A modern <w>mobile</w> robot can independently navigate around obstacles in a room."
                            }
                        },
                        {
                            "text": "Военные провели испытания, где использовался <w>мобильный</w> ракетный комплекс.",
                            "target_lang_translations": {
                                "en": "The military conducted tests where a <w>mobile</w> missile system was used."
                            }
                        }
                    ],
                    "synonyms": [
                        "подви́жный",
                        "самодвижущийся"
                    ],
                    "antonyms": [
                        "стационарный"
                    ],
                    "common_phrases": [
                        "мобильный робот"
                    ],
                    "target_lang_definitions": {
                        "en": "Capable of moving independently or being moved."
                    },
                    "translations": {
