                ],
                "senses": [
                    {
                        "sense_id": "767f4371-985c-3283-86d6-b06c2052bf5b",
                        "entry_id": "a5175236-8de1-3747-9b58-182dd5aa1cdf",
                        "glosses": [
                            "Effectuer des réglages, changements et réparations mécaniques sur un véhicule motorisé, en particulier en compétition lors d'un arrêt au stand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4c30b6-adf4-4a48-95f7-0323e0111e55",
                                "sense_id": "767f4371-985c-3283-86d6-b06c2052bf5b",
                                "text": "Voici des motards ou des amateurs de 4×4 qui, chez eux, sont condamnés à mécaniquer le dimanche."
                            },
                            {
                                "example_id": "ef4ce7ba-1a0e-43d9-87e9-8d7babb7cc09",
                                "sense_id": "767f4371-985c-3283-86d6-b06c2052bf5b",
                                "text": "« Tu n'as que ta bite et ton couteau » était une phrase fétiche de son frangin quand il « mécaniquait » ses Mobylettes et ensuite ses karts dans le garage."
                            },
                            {
                                "example_id": "0eb8d9f7-5c2f-4915-ad97-02f8ae093d46",
                                "sense_id": "767f4371-985c-3283-86d6-b06c2052bf5b",
                                "text": "A cette époque, on pouvait librement circuler dans le paddock et dans les stands, […]. Les pilotes du continental circus étaient souvent des privés et les usines n'avaient pas encore la grosse tête, ils mécaniquaient dans la terre devant leur tente !"
                            }
                        ]
                    }
