                "senses": [
                    {
                        "sense_id": "f7a6ecf2-0532-347c-af25-873bdaa6556b",
                        "entry_id": "e9ee4187-5833-3a36-8cea-3ce8d7cbe69c",
                        "glosses": [
                            "предсказать что-либо (обычно неприятное)"
                        ],
