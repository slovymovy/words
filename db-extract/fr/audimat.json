                "translations": [
                    {
                        "translation_id": "0793dcff-a274-4d0d-8861-cf24092b89a8",
                        "source_entry_id": "05fbb9fb-ea3d-30a0-9b27-da8a0aed1ddf",
                        "source_sense_id": "b495494c-dbfe-3a3d-b5a9-6887932482ef",
                        "source_sense_description": "Rundfunk, übertragen: Einschaltquote, Publikum",
                        "target_lang_word": "Einschaltquote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschaltquote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "614c9a42-2abf-3b71-9592-5b9198b8fee0",
                                        "entry_id": "b605de62-ae72-3132-9f0e-c829587a9d59",
                                        "glosses": [
                                            "Anteil der Fernsehzuschauer oder Radiohörer, die eine bestimmte Sendung verfolgen"
                                        ],
                                        "tags": [
                                            "Fernsehen",
                                            "Radio"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e73feb5-4162-4513-9db6-9d4c99413948",
                                                "sense_id": "614c9a42-2abf-3b71-9592-5b9198b8fee0",
                                                "text": "Die neue Sendung hatte eine sehr schlechte Einschaltquote und wird vermutlich abgesetzt."
                                            },
                                            {
                                                "example_id": "0d4b3f21-6816-4912-b28c-767460db738f",
                                                "sense_id": "614c9a42-2abf-3b71-9592-5b9198b8fee0",
                                                "text": "„Dass der Zweiteiler, der die Flucht einer fiktiven ostpreußischen Gräfin in den Mittelpunkt stellte, dem Sender die höchsten Einschaltquoten seit vielen Jahren bescherte, dürfte auch daran gelegen haben, dass laut Lexikon des Internationalen Films ein »deutsches Tabuthema« aufgegriffen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb9cf762-9047-459c-9619-e8959734263c",
                        "source_entry_id": "05fbb9fb-ea3d-30a0-9b27-da8a0aed1ddf",
                        "source_sense_id": "b495494c-dbfe-3a3d-b5a9-6887932482ef",
                        "source_sense_description": "Rundfunk, übertragen: Einschaltquote, Publikum",
                        "target_lang_word": "Publikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Publikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3aa8e2c-ad65-35e2-9d42-9ef0669d4c37",
                                        "entry_id": "cac2ae26-a394-3da0-8762-2c51d02ef610",
                                        "glosses": [
                                            "Bezeichnung für die Öffentlichkeit sowie für die Gesamtheit der Zuschauer, Zuhörer, Besucher und anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129063b2-f3fe-4854-8663-b45796d99817",
                                                "sense_id": "e3aa8e2c-ad65-35e2-9d42-9ef0669d4c37",
                                                "text": "„Das Publikum wollte Musik.“"
                                            },
                                            {
                                                "example_id": "6eaec54c-8d68-4ca6-828a-05191b094b92",
                                                "sense_id": "e3aa8e2c-ad65-35e2-9d42-9ef0669d4c37",
                                                "text": "Das Publikum war begeistert vom Theaterstück."
                                            },
                                            {
                                                "example_id": "aae77385-3c07-4635-89f3-9bb407d62fde",
                                                "sense_id": "e3aa8e2c-ad65-35e2-9d42-9ef0669d4c37",
                                                "text": "Der Beifall des Publikums hallte durch das ganze Stadion."
                                            },
                                            {
                                                "example_id": "d9a9f1ba-452f-4174-918d-434da4ac183c",
                                                "sense_id": "e3aa8e2c-ad65-35e2-9d42-9ef0669d4c37",
                                                "text": "„Sie konnte wie die Apokryphen trotz der dem großen Publikum fremden Gelehrtensprache zu Seumes Lebzeiten aus politischen Gründen nicht erschienen.“"
                                            },
                                            {
                                                "example_id": "6a50f94c-d3be-4466-ba6e-b4d9ecea436e",
                                                "sense_id": "e3aa8e2c-ad65-35e2-9d42-9ef0669d4c37",
                                                "text": "„Wir haben auch diesen Vortheil, daß, wenn indessen auch eine Gegencritik erscheint, die Rezension der Metaphysik einstweilen dem Publicum eine Unterhaltung macht.“"
                                            },
                                            {
                                                "example_id": "5b72d0bb-73b6-4bf9-a75e-4bddc9c28bbb",
                                                "sense_id": "e3aa8e2c-ad65-35e2-9d42-9ef0669d4c37",
                                                "text": "„Der Interviewpartner soll, so die Absicht, diese Lassowörter reflexartig aufgreifen, wiederholen und auf diese Weise dazu beitragen, dass sich das entsprechende Bild beim Publikum verfestigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
