                                        "entry_id": "b0fe0e4f-9492-349d-8297-da524deca385",
                                        "glosses": [
                                            "masywny ssak z rzędu parzystokopytnych z charakterystycznie uformowaną przez włosy brodą pod pyskiem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "383d54c7-c1b8-44ec-b7a1-fd852efa9566",
                                                "sense_id": "4bda5744-ac41-3aa6-9b37-3c18057b8e3f",
                                                "text": "Pokarmem żubra są zioła, trawy, liście krzewów, pąki i kora drzew; chętnie zjadają też żołędzie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
