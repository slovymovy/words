                                                "example_id": "54e577c1-1988-4b7e-81ce-283404af3787",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Juste préférence."
                                            },
                                            {
                                                "example_id": "67eb7a06-4f40-480d-a46b-16694445cb75",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Demander, avoir, obtenir la préférence."
                                            },
                                            {
                                                "example_id": "00f23dae-ce94-4600-baed-5d01572758e2",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Disputer la préférence."
                                            },
                                            {
                                                "example_id": "6c6a4b80-de34-4a16-8cb7-691b7c93c2ab",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Donner, accorder la préférence."
                                            },
                                            {
                                                "example_id": "df97b7e7-3cb7-494b-96cc-deca451da461",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Cicéron mérite la préférence sur tous les orateurs latins."
                                            },
                                            {
                                                "example_id": "4a74ce0c-710b-4c89-8e85-0b65806ed38c",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Si vous ne trouvez pas de votre maison plus que je vous en offre, je vous demande la préférence."
                                            },
                                            {
                                                "example_id": "240a2adb-c4b3-4d7f-ab01-b936d35842cd",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Si je ne trouve pas cette marchandise à meilleur marché que chez vous, je vous donnerai la préférence, vous aurez ma préférence."
                                            },
                                            {
                                                "example_id": "e9d7d187-c3ca-4467-baae-8393e4ce1011",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "Vous avez certaines préférences que je ne puis approuver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4987ee-62d0-364d-a292-c5438fb62be6",
