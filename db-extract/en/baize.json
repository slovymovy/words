                                                "sense_id": "44d1a2d2-d813-3fa7-973c-a218b973e99b",
                                                "text": "Doe je het laken op je bed?"
                                            },
                                            {
                                                "example_id": "50c22498-b84e-471e-b619-b6b1b3cdadb5",
                                                "sense_id": "44d1a2d2-d813-3fa7-973c-a218b973e99b",
                                                "text": "In de keuken hing een laken over het schilderij, want niemand mocht het van hem zien voordat het af was."
                                            },
                                            {
                                                "example_id": "f2ac60e0-7236-4243-aeb9-372f0c1add6d",
                                                "sense_id": "44d1a2d2-d813-3fa7-973c-a218b973e99b",
                                                "text": "Het witte laken ligt verfrommeld naast hem."
                                            },
                                            {
                                                "example_id": "2c6f2390-9e40-40bc-b453-3803104d62b3",
                                                "sense_id": "44d1a2d2-d813-3fa7-973c-a218b973e99b",
                                                "text": "Maar één ding wilde Pietje beslist niet: slapen in een groot bed met witte lakens."
                                            }
                                        ]
                                    }
                                ]
