                "senses": [
                    {
                        "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                        "entry_id": "92d7ec82-97f1-376e-8954-faf08efc946e",
                        "glosses": [
                            "Eigenschaft (eines Stoffes, vor allem bei Kristallen), in alle Richtungen gleiche (physikalische und chemische) Eigenschaften zu besitzen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "0dd8ad54-9ad8-465a-afa8-711ff0801705",
                                "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                                "text": "„Die Isotropie von Protoplasma und Gelatine ist indessen keine unveränderliche Eigenschaft.“"
                            },
                            {
                                "example_id": "bb0f6cc7-5d7a-4943-bb3c-f0ad249f8758",
                                "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                                "text": "„Dagegen ist die Isotropie eine reine Materialeigenschaft; sie bedeutet, dass im Material keine Richtung ausgezeichnet ist.“"
                            },
                            {
                                "example_id": "7520d5b3-9ea1-426d-a6e3-60778d1db7f6",
                                "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                                "text": "„Wenden wir uns nun der Frage nach der Homogenität und Isotropie der Materieverteilung zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
