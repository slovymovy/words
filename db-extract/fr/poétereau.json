                ],
                "senses": [
                    {
                        "sense_id": "0f3dadb2-ba44-334c-92a0-5faff0b59918",
                        "entry_id": "ca184fcc-3c7d-3092-8e59-4e8734b86663",
                        "glosses": [
                            "Poète médiocre, mauvais poète."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e3ce2c33-0103-4671-a2b6-c2009f62ac90",
                                "sense_id": "0f3dadb2-ba44-334c-92a0-5faff0b59918",
                                "text": "Ce n’est qu’un poétereau."
                            },
                            {
                                "example_id": "97a60495-b028-41b8-8b02-6fb49006f679",
                                "sense_id": "0f3dadb2-ba44-334c-92a0-5faff0b59918",
                                "text": "On disait autrefois un rimeur, pour parler d’un méchant poétereau, et cependant, comme l’un de vos confrères l’a justement remarqué, le vers « est suspendu tout entier à la rime comme à un clou d’or », et le mot qui le termine a la puissance magique d’évoquer en nous le sentiment ou la vision que voulait nous communiquer le poète."
                            },
                            {
                                "example_id": "afca4d3d-1303-4316-8eb5-d8458176a3c8",
                                "sense_id": "0f3dadb2-ba44-334c-92a0-5faff0b59918",
                                "text": "Les hôtes du baron de Reinach ne se perdent pas à chicaner comme des avocats, à faire parade d’imbéciles complications sentimentales, à la façon des jolies filles et des poétereaux qui pour rien, pour le plaisir de se faire connaître et sans démêler leurs interlocuteurs, disent et redisent : « Moi, je pense ceci… »"
                            }
                        ]
                    }
                ],
