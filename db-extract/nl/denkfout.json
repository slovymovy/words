                "translations": [
                    {
                        "translation_id": "2b3ea75b-266e-4979-b5a5-65d0402016c1",
                        "source_entry_id": "5c4d01b1-c268-3d66-b96d-80c40061f9b5",
                        "source_sense_id": "52eb08aa-3184-36d2-8d83-0303f16b026d",
                        "source_sense_description": "fout in het denkproces, onjuiste gedachtegang of redenering",
                        "target_lang_word": "Denkfehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denkfehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca20813-39bf-3ee2-83fc-4e300a86860c",
                                        "entry_id": "9b1a4af1-52d1-3bf1-ba18-32e116a97ad6",
                                        "glosses": [
                                            "zuerst (erdachte) Annahme oder Lösung eines Sachverhalts, die sich im Nachhinein als Fehler herausstellt; falsche Annahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6148a8bf-0e92-4114-9dd3-c3d35d6fd82a",
                                                "sense_id": "3ca20813-39bf-3ee2-83fc-4e300a86860c",
                                                "text": "Bei manchen unnötigen Änderungen traten zuvor Denkfehler auf."
                                            },
                                            {
                                                "example_id": "f79e145c-f53c-4357-b4e7-cc8a2bc80f74",
                                                "sense_id": "3ca20813-39bf-3ee2-83fc-4e300a86860c",
                                                "text": "Mein Denkfehler war es, dir zu trauen."
                                            },
                                            {
                                                "example_id": "dd2222ce-5c76-4f4b-bf7f-1e8de18e3327",
                                                "sense_id": "3ca20813-39bf-3ee2-83fc-4e300a86860c",
                                                "text": "„Bernstein führte konzentriert die Denkfehler der Kriegspartei vor.“"
                                            },
                                            {
                                                "example_id": "a299668d-171a-4540-9b8f-dd2f204daa5e",
                                                "sense_id": "3ca20813-39bf-3ee2-83fc-4e300a86860c",
                                                "text": "„Allerdings hat die Aufdeckung oder Vermeidung solcher Denkfehler letztlich mehr mit gesundem Menschenverstand zu tun als mit zünftiger Logik.“"
                                            },
                                            {
                                                "example_id": "25a27a6d-2678-4b2e-83be-0fccd66d42fa",
                                                "sense_id": "3ca20813-39bf-3ee2-83fc-4e300a86860c",
                                                "text": "„Die mögliche Konsequenz sind falsche Schlüsse mit unter Umständen fatalen Folgen, wenn zum Beispiel medizinische Entscheidungen oder Gerichtsurteile auf diesem Denkfehler beruhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
