                "senses": [
                    {
                        "sense_id": "40d4713f-c021-3dd6-905a-841be1bf73f0",
                        "entry_id": "933d0573-5590-3dd1-b0dc-f6c04e66fb0c",
                        "glosses": [
                            "Handlung, etwas neu/anders zu regeln, und Ergebnis dieser Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0f01345-cdf2-42fe-8cd4-1276b35242c4",
                                "sense_id": "40d4713f-c021-3dd6-905a-841be1bf73f0",
                                "text": "„Sie sollte die Einführung der Neuregelung begleiten.“"
                            },
                            {
                                "example_id": "746b2ff5-4731-4a8d-9981-22085bc1ea06",
                                "sense_id": "40d4713f-c021-3dd6-905a-841be1bf73f0",
                                "text": "„Der erneute Drehstopp ist nicht die einzige Widrigkeit für die Sexfilmer: Neben der Kostenlos-Kultur im Internet bedroht auch noch eine Neuregelung im Bezirk Los Angeles ihr Geschäftsmodell. Dort sind Pornodarsteller nun gesetzlich verpflichtet, sich beim Dreh mit Kondomen zu schützen.“"
                            },
                            {
                                "example_id": "4eded405-ecc7-49a0-aa0f-6a5237a1f8db",
                                "sense_id": "40d4713f-c021-3dd6-905a-841be1bf73f0",
                                "text": "„Bei der Neuregelung der deutschen Rechtschreibung wurden auch für die Fremdwortschreibung einige Änderungen festgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
