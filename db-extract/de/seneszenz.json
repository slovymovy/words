                "senses": [
                    {
                        "sense_id": "c535d6db-ba31-30f5-81de-fc4e8e056dc3",
                        "entry_id": "33b5a3bc-fc43-352a-9659-e530e7345a4d",
                        "glosses": [
                            "Altern, das biologische Älterwerden eines Organismus/einer Zelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8241b336-001c-4d70-8b74-81d073cbc4dc",
                                "sense_id": "c535d6db-ba31-30f5-81de-fc4e8e056dc3",
                                "text": "„Dolly verstarb nach früh einsetzender Seneszenz weit vor Erreichung der mittleren Lebenserwartung von Schafen.“"
                            },
                            {
                                "example_id": "a7d35789-078b-4a92-807b-8a69ec1fd50b",
                                "sense_id": "c535d6db-ba31-30f5-81de-fc4e8e056dc3",
                                "text": "„Die Seneszenz ist ein auf molekularer Ebene wenig verstandener Vorgang des natürlichen Alterungsprozesses von Zellen.“"
                            },
                            {
                                "example_id": "d3bf01bd-6670-4be7-83be-b4a98fab0b1e",
                                "sense_id": "c535d6db-ba31-30f5-81de-fc4e8e056dc3",
                                "text": "„Zelluläre Seneszenz wird oft mit ‚Altersapoptose‘ gleichgesetzt. Streng genommen ist Seneszenz aber keine Form des Zelltodes, sondern ein irreversibler Zellzyklusstopp. Zellen in Seneszenz sind weiterhin metabolisch aktiv.“"
                            },
                            {
                                "example_id": "2f5ca51e-0824-493e-aea4-b09187a03a8b",
                                "sense_id": "c535d6db-ba31-30f5-81de-fc4e8e056dc3",
                                "text": "„Die Beziehung zwischen biologischem Altern des Organismus und zellulärer Seneszenz beruht darauf, dass die Körperzellen ein begrenztes Potenzial zur Zellteilung besitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
