        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b2ce15a1-768a-3344-8526-1acc5d0b5017",
                "word": "Windows",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19bbf103-da97-3ac6-83d0-1dd72f869f1e",
                        "entry_id": "b2ce15a1-768a-3344-8526-1acc5d0b5017",
                        "glosses": [
                            "Microsoft Windows, an operating system with a WIMP graphical user interface that dominates the personal computer market."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5114c4c6-b97c-3b1a-b1bd-8fdef63ffa5d",
                        "entry_id": "b2ce15a1-768a-3344-8526-1acc5d0b5017",
                        "glosses": [
                            "Ellipsis of Windows key."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "281633c9-3e8f-4d0c-af5c-5cc76cf7e61a",
                        "source_entry_id": "b2ce15a1-768a-3344-8526-1acc5d0b5017",
                        "source_sense_description": "Microsoft Windows",
                        "target_lang_word": "Windows",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windows",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c39f215-b274-339a-8269-361853289aa7",
                                        "entry_id": "69a2daeb-04c7-3ae9-8476-078887f82490",
                                        "glosses": [
                                            "Système d’exploitation propriétaire, développé et commercialisé par la Microsoft Corporation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "369124e6-4c59-4b10-9fe1-b4ffb36b7a18",
                                                "sense_id": "2c39f215-b274-339a-8269-361853289aa7",
                                                "text": "En effet, on a vu précédemment que le classement arborescent atteint vite ses limites : l’explorateur de document de Google Docs, basé sur des mots-clefs, est plus efficace que l’explorateur Windows basé sur une arborescence stricte."
                                            },
                                            {
                                                "example_id": "e461740f-4e63-4799-a18d-b7da5f0d3aff",
                                                "sense_id": "2c39f215-b274-339a-8269-361853289aa7",
                                                "text": "Certains pourraient le contester. Mais je suis convaincu que la reconnaissance du matériel sous Linux est bien meilleure que sous Windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce245d9f-9095-3fd7-bd47-5bc9e3865838",
                                        "entry_id": "69a2daeb-04c7-3ae9-8476-078887f82490",
                                        "glosses": [
                                            "Touche de clavier qui, sous Windows, permet d’ouvrir le menu démarrer de cette série de système d’exploitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99bd994e-b04d-45c4-8a65-013e4d3c468f",
                                                "sense_id": "ce245d9f-9095-3fd7-bd47-5bc9e3865838",
                                                "text": "Lorsque vous appuyez sur la touche Logo, la vue d'ensemble des Activités s'affiche. Cette touche se trouve généralement dans la partie inférieure gauche du clavier, à côté de la touche Alt et est souvent identifiable par son logo Windows. Elle est parfois nommée touche Windows ou touche système. Si vous avez un clavier Apple, celui-ci comportera une touche de commande ⌘ à la place de la touche Windows, alors que les Chromebooks auront une loupe à cet endroit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8513a694-a339-43cc-8754-e5bd7bf9ea07",
                        "source_entry_id": "b2ce15a1-768a-3344-8526-1acc5d0b5017",
