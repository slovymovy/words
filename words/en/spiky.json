{
    "word_family": [
        "spike",
        "spikiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2586762b-229b-3d32-82e2-8346fe022589",
                    "sense_definition": "Having one or more sharp, pointed projections.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sharp_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dinosaur had a <w>spiky</w> tail that it used for protection against predators.",
                            "target_lang_translations": {
                                "ru": "У динозавра был <w>колючий</w> хвост, который он использовал для защиты от хищников."
                            }
                        },
                        {
                            "text": "Be careful when touching that <w>spiky</w> cactus in the garden.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда трогаешь тот <w>колючий</w> кактус в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "prickly",
                        "thorny"
                    ],
                    "common_phrases": [
                        "spiky plant",
                        "spiky tail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий один или несколько острых, колючих выступов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "общий термин для чего-то с шипами или иглами"
                            },
                            {
                                "target_lang_word": "шипастый",
                                "target_lang_sense_clarification": "имеющий шипы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75258873-fae7-3695-9695-4e886eef0816",
                    "sense_definition": "Resembling spikes; erect and having sharp points.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sharp_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He styled his hair into a <w>spiky</w> look using a strong gel.",
                            "target_lang_translations": {
                                "ru": "Он уложил волосы в <w>торчащую</w> прическу с помощью сильного геля."
                            }
                        },
                        {
                            "text": "The <w>spiky</w> thorns on the rose bush made it difficult to prune.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>колючих</w> шипов на розовом кусте его было трудно подрезать."
                            }
                        }
                    ],
                    "synonyms": [
                        "prickly",
                        "thorny"
                    ],
                    "common_phrases": [
                        "spiky hair",
                        "spiky thorns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий шипы; торчащий вверх и имеющий острые концы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торчащий",
                                "target_lang_sense_clarification": "о прическе или форме"
                            },
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "о предметах с острыми концами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2a02160-93b9-38d9-ab8a-bcd4ff14ce5e",
                    "sense_definition": "Not smooth; rough or sharp in texture or sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sharp_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a <w>spiky</w> guitar riff that sounded very aggressive.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла <w>резкий</w> гитарный рифф, который звучал очень агрессивно."
                            }
                        },
                        {
                            "text": "The surface of the rock felt <w>spiky</w> and uneven under my hand.",
                            "target_lang_translations": {
                                "ru": "Поверхность камня казалась <w>колючей</w> и неровной под моей рукой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiky sound",
                        "spiky texture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Негладкий; шероховатый или резкий по текстуре или звуку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о звуке или характере"
                            },
                            {
                                "target_lang_word": "шероховатый",
                                "target_lang_sense_clarification": "о текстуре поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe29786-05ff-36ef-b2fa-22e3ebe05689",
                    "sense_definition": "Difficult to deal with; abrasive, hostile, or unfriendly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>spiky</w> personality that often puts people on edge.",
                            "target_lang_translations": {
                                "ru": "У нее <w>колючий</w> характер, из-за чего люди часто чувствуют себя неловко."
                            }
                        },
                        {
                            "text": "His <w>spiky</w> response to the question showed he was in a bad mood.",
                            "target_lang_translations": {
                                "ru": "Его <w>резкий</w> ответ на вопрос показал, что он в плохом настроении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiky personality",
                        "spiky response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложный в общении; резкий, враждебный или недружелюбный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "о характере или поведении"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о манере общения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8100476-bcd7-30cc-a0b0-3a6ef3ffe1ee",
                    "sense_definition": "Relating to a formal, traditional style of church liturgy that emphasizes Catholic practices.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local church is known for its <w>spiky</w> Anglo-Catholic traditions.",
                            "target_lang_translations": {
                                "ru": "Местная церковь известна своими <w>высокоцерковными</w> англо-католическими традициями."
                            }
                        },
                        {
                            "text": "Many <w>spiky</w> curates preferred to follow the old liturgical rules.",
                            "target_lang_translations": {
                                "ru": "Многие <w>высокоцерковные</w> священники предпочитали следовать старым литургическим правилам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiky curate",
                        "spiky church"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in British English contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к формальному, традиционному стилю церковной литургии, подчеркивающему католические практики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокоцерковный",
                                "target_lang_sense_clarification": "в контексте англиканства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "501bfbc1-7e47-3b7d-87a1-2cb8e61033d8",
                    "sense_definition": "Of a plant, producing spikes or inflorescences.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The field was filled with <w>spiky</w> wheat ready for the harvest.",
                            "target_lang_translations": {
                                "ru": "Поле было заполнено <w>колосистой</w> пшеницей, готовой к сбору урожая."
                            }
                        },
                        {
                            "text": "Farmers identified the <w>spiky</w> plant by the shape of its flowers.",
                            "target_lang_translations": {
                                "ru": "Фермеры определили <w>колосистое</w> растение по форме его цветов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiky plant",
                        "spiky wheat"
                    ],
                    "target_lang_definitions": {
                        "ru": "О растении: образующее колосья или соцветия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колосистый",
                                "target_lang_sense_clarification": "имеющий колосья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b068420-27d6-3cbc-a908-a18bd5edc958",
                    "sense_definition": "Resembling the spike or ear of a plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The herb has a small <w>spiky</w> head that contains the seeds.",
                            "target_lang_translations": {
                                "ru": "У этой травы есть маленькая <w>колосовидная</w> головка, в которой содержатся семена."
                            }
                        },
                        {
                            "text": "Each <w>spiky</w> ear of the plant looked like a tiny torch.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>колосовидный</w> початок растения выглядел как крошечный факел."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiky head",
                        "spiky ear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий колос растения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колосовидный",
                                "target_lang_sense_clarification": "похожий на колос"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}