{
    "word_family": [
        "sting",
        "stinger"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73505416-78a9-3ccb-bb3b-32bbb778c9a1",
                    "sense_definition": "Having the ability to cause a sharp, painful sensation or injury, often by injecting venom.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when walking through the woods because of the <w>stinging</w> nettles.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, гуляя по лесу из-за <w>жгучей</w> крапивы."
                            }
                        },
                        {
                            "text": "The <w>stinging</w> insects were swarming around the hive.",
                            "target_lang_translations": {
                                "ru": "<w>Жалящие</w> насекомые роились вокруг улья."
                            }
                        }
                    ],
                    "synonyms": [
                        "painful",
                        "prickly"
                    ],
                    "common_phrases": [
                        "stinging nettle",
                        "stinging insect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью вызывать острую, болезненную реакцию или повреждение, часто путем впрыскивания яда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жгучий",
                                "target_lang_sense_clarification": "о растениях или веществах, вызывающих жжение"
                            },
                            {
                                "target_lang_word": "жалящий",
                                "target_lang_sense_clarification": "о насекомых или животных, способных ужалить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8257eda4-d529-35e3-8c00-a45b6d9794e5",
                    "sense_definition": "Causing emotional pain or distress through harsh, critical, or biting remarks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic wrote a <w>stinging</w> review that ruined the director's reputation.",
                            "target_lang_translations": {
                                "ru": "Критик написал <w>язвительную</w> рецензию, которая разрушила репутацию режиссера."
                            }
                        },
                        {
                            "text": "She felt hurt by his <w>stinging</w> comments about her work.",
                            "target_lang_translations": {
                                "ru": "Ей было больно от его <w>резких</w> замечаний по поводу её работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "biting",
                        "harsh",
                        "scathing"
                    ],
                    "antonyms": [
                        "gentle",
                        "kind"
                    ],
                    "common_phrases": [
                        "stinging remark",
                        "stinging critique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий эмоциональную боль или страдание через резкие, критические или язвительные замечания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "язвительный",
                                "target_lang_sense_clarification": "о словах или критике, причиняющих душевную боль"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о критике, которая звучит грубо и обидно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eff380ac-cbcb-3b74-b325-3969aa6708aa",
                    "sense_definition": "The act or experience of being stung.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>stinging</w> from the jellyfish made swimming impossible.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>укусы</w> медуз сделали купание невозможным."
                            }
                        },
                        {
                            "text": "The <w>stinging</w> of the nettles left red marks on his legs.",
                            "target_lang_translations": {
                                "ru": "От <w>ожогов</w> крапивой на ногах у него остались красные следы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или ощущение укуса или ожога."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укусы",
                                "target_lang_sense_clarification": "физическое воздействие насекомых или медуз"
                            },
                            {
                                "target_lang_word": "муки",
                                "target_lang_sense_clarification": "метафорическое описание сильных душевных страданий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c94423be-267e-3763-b2f8-f645ad00d417",
                    "sense_definition": "Present participle and gerund of <w>sting</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind was <w>stinging</w> my face as I walked home.",
                            "target_lang_translations": {
                                "ru": "Холодный ветер <w>обжигал</w> мне лицо, пока я шел домой."
                            }
                        },
                        {
                            "text": "She was <w>stinging</w> from the insult he threw at her.",
                            "target_lang_translations": {
                                "ru": "Она <w>мучилась</w> от оскорбления, которое он ей нанес."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «жалить» или «причинять боль»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжигающий",
                                "target_lang_sense_clarification": "о воздействии холода или ветра на кожу"
                            },
                            {
                                "target_lang_word": "мучающийся",
                                "target_lang_sense_clarification": "о человеке, испытывающем острую душевную боль"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}