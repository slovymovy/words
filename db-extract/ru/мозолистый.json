                                                "example_id": "fc0cf78f-91ba-43e3-aceb-c39287bb5a27",
                                                "sense_id": "1dd55819-4e16-311e-851a-46d87d80ac91",
                                                "text": "After a while I sat down in a chair and smoked a couple of cigarettes. I was feeling pretty horny. I have to admit it."
                                            },
