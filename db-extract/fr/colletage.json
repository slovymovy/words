                "senses": [
                    {
                        "sense_id": "d8351ddb-b62a-36e2-a665-7e406b84dbdd",
                        "entry_id": "0b094d7c-4592-36b3-b5bc-ae8681eaad36",
                        "glosses": [
                            "Action de se colleter ; empoignade de gens qui se collettent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0649021-b11c-4a18-bddc-a1e9ff4965a7",
                                "sense_id": "d8351ddb-b62a-36e2-a665-7e406b84dbdd",
                                "text": "Et le concierge, un gros homme, barrait de son ventre le corridor. Au risque d’un colletage possible, Yves le jeta de côté d'un coup d’épaules."
                            },
                            {
                                "example_id": "81a6f98e-4879-4674-9b1d-a2130d024a6e",
                                "sense_id": "d8351ddb-b62a-36e2-a665-7e406b84dbdd",
                                "text": "Une bousculade, une querelle … un colletage … et lui enlever son portefeuille."
                            },
                            {
                                "example_id": "3c9598da-8665-46a6-95fd-34c51c0b4080",
                                "sense_id": "d8351ddb-b62a-36e2-a665-7e406b84dbdd",
                                "text": "Saugues, très pâle, un léger tremblement aux lèvres, n’osait faire un mouvement, à cause du valet proche dont la rigidité de pierre semblait croître à mesure qu’il entendait, sentant que cet homme, que d’Yeuse aussi, allaient lui saisir le bras, l’humilier dans un colletage abject."
                            }
                        ]
                    }
