                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8d340283-e0ba-48b2-80cd-a3bbe430396d",
                        "entry_id": "11ff90db-eb9b-305b-9be0-53e0f70e2a94",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more obligate"
                    },
                    {
                        "form_id": "cffd0d90-78d2-47ab-b19d-95b9acced0ed",
                        "entry_id": "11ff90db-eb9b-305b-9be0-53e0f70e2a94",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most obligate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad17334f-f168-3e6d-8677-bc31bc6530bc",
                        "entry_id": "11ff90db-eb9b-305b-9be0-53e0f70e2a94",
                        "glosses": [
                            "Requiring a (specified) way of life, habitat, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e1dfb0-1d03-4561-89aa-0cbd1fb347f4",
                                "sense_id": "ad17334f-f168-3e6d-8677-bc31bc6530bc",
                                "text": "[A]nalysis of the chemical composition of their bones reveals that they were obligate carnivores."
                            }
                        ]
                    },
                    {
                        "sense_id": "c46d02d6-6bca-30df-bf24-848246ff61f2",
                        "entry_id": "11ff90db-eb9b-305b-9be0-53e0f70e2a94",
                        "glosses": [
                            "Indispensable; essential; necessary; obligatory; mandatory; unavoidably invoked."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a679f066-e2af-40ac-8b99-0a1f6240cf4e",
                                "sense_id": "c46d02d6-6bca-30df-bf24-848246ff61f2",
                                "text": "In addition to being the obligate food source for monarch caterpillars, milkweeds also provide abundant nectar for the adult butterflies."
                            },
                            {
                                "example_id": "12afb272-cfbd-437e-bab7-293d7e574dc9",
                                "sense_id": "c46d02d6-6bca-30df-bf24-848246ff61f2",
                                "text": "In some languages such signaling is optional, whereas in others it is obligate."
                            },
                            {
                                "example_id": "9ef3819f-8da3-4855-9e7c-0cf19ae5dbb3",
                                "sense_id": "c46d02d6-6bca-30df-bf24-848246ff61f2",
                                "text": "Aquatic sites constitute obligate habitat for some species, and are critical breeding habitat for species with complex life cycles involving aquatic egg or larval development."
                            },
                            {
                                "example_id": "0775dd77-fae7-4440-81ef-bfa1b63e34ff",
                                "sense_id": "c46d02d6-6bca-30df-bf24-848246ff61f2",
                                "text": "Unlike for phagotrophic flagellates, bacteria serve as a facultative rather than an obligate food source for crustacean zooplankton."
                            },
                            {
                                "example_id": "e0ce4a73-86e7-46ae-93bc-c3c89d909fc6",
                                "sense_id": "c46d02d6-6bca-30df-bf24-848246ff61f2",
                                "text": "Light is the obligate energy source for the phototrophic microbes constructing these benthic mats"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7286833c-3209-4692-84ba-858107f021e9",
                        "source_entry_id": "11ff90db-eb9b-305b-9be0-53e0f70e2a94",
                        "source_sense_description": "Able to exist or survive only in a particular environment or by assuming a particular role",
                        "target_lang_word": "облига́тный",
                        "target_lang_code": "ru",
