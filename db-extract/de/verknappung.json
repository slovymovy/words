                ],
                "senses": [
                    {
                        "sense_id": "c44f3320-aa0a-3e0b-8883-34f37a414a09",
                        "entry_id": "74472e30-3f95-39ce-afb9-d80c47d9f9fd",
                        "glosses": [
                            "Vorgang, in dem etwas in seinem Bestand abnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2244ba53-8818-4393-ae88-5f5c9c1a60b4",
                                "sense_id": "c44f3320-aa0a-3e0b-8883-34f37a414a09",
                                "text": "Die Verknappung von Ressourcen ist ein globales Problem."
                            },
                            {
                                "example_id": "65290a25-f880-4cf8-a2ab-32ab87b56d47",
                                "sense_id": "c44f3320-aa0a-3e0b-8883-34f37a414a09",
                                "text": "„Im US-Bundesstaat Georgia verbrennen Farmer große Mengen Baumwolle, um durch künstliche Verknappung die Verkaufspreise wieder in die Höhe zu bringen.“"
                            },
                            {
                                "example_id": "c7c52e97-bae5-42e3-9e3a-f4a8763654a4",
                                "sense_id": "c44f3320-aa0a-3e0b-8883-34f37a414a09",
                                "text": "„So folgte jeder Festlegung von Höchstpreisen eine weitere Verknappung des regulären Angebots.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa8acfb6-984b-48aa-a680-5b5d38df5bb3",
                        "source_entry_id": "74472e30-3f95-39ce-afb9-d80c47d9f9fd",
                        "source_sense_id": "c44f3320-aa0a-3e0b-8883-34f37a414a09",
                        "source_sense_description": "Vorgang, in dem etwas in seinem Bestand abnimmt",
                        "target_lang_word": "scarcity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scarcity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "988c8b0d-71eb-30b1-9ab4-5006bdb76195",
                                        "entry_id": "900ff5df-9147-34b1-b27f-59cdd317069e",
                                        "glosses": [
                                            "The condition of something being scarce or deficient."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3982c30e-ddb3-49cc-a866-6c375b992c35",
                                                "sense_id": "988c8b0d-71eb-30b1-9ab4-5006bdb76195",
                                                "text": "Praise […] owes its value only to its scarcity."
                                            },
                                            {
                                                "example_id": "d9f25d97-5756-4df5-8213-7724dff56ed0",
                                                "sense_id": "988c8b0d-71eb-30b1-9ab4-5006bdb76195",
                                                "text": "To understand the events of the next fifty years, then, one must understand environmental scarcity, cultural and racial clash, geographic destiny, and the transformation of war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab8938d-493d-337f-9e70-80d44f557411",
                                        "entry_id": "900ff5df-9147-34b1-b27f-59cdd317069e",
                                        "glosses": [
                                            "An inadequate amount of something; a shortage."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95f7d80c-c3be-465a-a869-cec0b0b50576",
                                                "sense_id": "fab8938d-493d-337f-9e70-80d44f557411",
                                                "text": "a scarcity of grain"
                                            },
                                            {
                                                "example_id": "8ebad11f-bd79-402b-9cf5-a0a8cbbac891",
                                                "sense_id": "fab8938d-493d-337f-9e70-80d44f557411",
                                                "text": "The crucial and intersecting challenges of scarcities, both emerging and intensifying, will consume China’s custodians over the next decade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8ca9ac0-0b45-45ed-8de4-b10c3ea54ca4",
                        "source_entry_id": "74472e30-3f95-39ce-afb9-d80c47d9f9fd",
                        "source_sense_id": "c44f3320-aa0a-3e0b-8883-34f37a414a09",
                        "source_sense_description": "Vorgang, in dem etwas in seinem Bestand abnimmt",
                        "target_lang_word": "shortage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shortage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c23ca3bd-26fb-3a65-b875-59c4d299e116",
                                        "entry_id": "662695be-ae99-3f1e-87dd-6ec38f1b6973",
                                        "glosses": [
                                            "A lack or deficiency; an insufficient amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5c74edc-c1fa-49f9-94f8-6ded2cce377b",
                                                "sense_id": "c23ca3bd-26fb-3a65-b875-59c4d299e116",
                                                "text": "The admirable smoothness of the riding also reflected the greatest credit on those who, despite the difficulties caused by the shortage of men and materials, have succeeded in maintaining the track in such first-class order."
                                            },
                                            {
                                                "example_id": "ca775de8-c91c-43d4-85e4-a5053d1bb563",
                                                "sense_id": "c23ca3bd-26fb-3a65-b875-59c4d299e116",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania.[…]It was used to make kerosene, the main fuel for artificial lighting after overfishing led to a shortage of whale blubber."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45074e8d-2024-4b91-9212-8f826c11131b",
                        "source_entry_id": "74472e30-3f95-39ce-afb9-d80c47d9f9fd",
                        "source_sense_id": "c44f3320-aa0a-3e0b-8883-34f37a414a09",
                        "source_sense_description": "Vorgang, in dem etwas in seinem Bestand abnimmt",
                        "target_lang_word": "pénurie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pénurie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "603e2138-8e53-371a-af7a-63ab01e85f20",
                                        "entry_id": "7d7753ec-2525-3458-9125-cba433123112",
                                        "glosses": [
                                            "Extrême disette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e1fd959-9357-43df-a8e2-9b5667ed7b12",
                                                "sense_id": "603e2138-8e53-371a-af7a-63ab01e85f20",
                                                "text": "Les sociétés de pénurie possèdent vraisemblablement une conscience de groupe plus développée que les sociétés d’abondance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8008d3cf-bfc1-3232-9eba-2416fdd4c456",
                                        "entry_id": "7d7753ec-2525-3458-9125-cba433123112",
                                        "glosses": [
                                            "Disette d’argent, pauvreté, misère."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb12c87c-61d1-49a2-884a-c658577d2ed0",
                                                "sense_id": "8008d3cf-bfc1-3232-9eba-2416fdd4c456",
                                                "text": "Cet homme est dans une grande pénurie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                        "entry_id": "7d7753ec-2525-3458-9125-cba433123112",
                                        "glosses": [
                                            "Manque ; absence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8c10a6a-3bf5-420a-9967-543b3777ba8c",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "Lorsque l'œil était fait à cette pénurie de lumière, il distinguait, placées tout autour, ces pudibondes cloisons en usage dans les restaurants anglais."
                                            },
                                            {
                                                "example_id": "b049056a-5e73-48f7-b58d-f859bbc4b5da",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "En se mettant en grève dans tout le pays, les pompistes ont rapidement provoqué une pénurie de carburant assez sérieuse."
                                            },
                                            {
                                                "example_id": "30f8b944-45dd-4366-9fb5-8e619e3e4e38",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "Par ailleurs, le pays souffre d'une grave pénurie de ciment, qui engendre en parallèle une hausse des prix du secteur du bâtiment."
                                            },
                                            {
                                                "example_id": "b5c39ecf-b54a-41ff-acf6-e8e28fabe4d0",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "L’État se contente d’organiser la pénurie, soupire Cyrille Godfroid, secrétaire général de ce syndicat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31a46894-4cf5-4e49-8685-5853325324ac",
                        "source_entry_id": "74472e30-3f95-39ce-afb9-d80c47d9f9fd",
