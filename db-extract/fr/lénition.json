            {
                "entry_id": "6825af16-54cb-31d0-8c11-64b7209b4a5e",
                "word": "lénition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a5101118-51b7-4e38-8271-8380b298ece4",
                        "entry_id": "6825af16-54cb-31d0-8c11-64b7209b4a5e",
                        "tags": [
                            "plural"
