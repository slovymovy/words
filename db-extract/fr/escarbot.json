                "senses": [
                    {
                        "sense_id": "fcd4a159-8699-3f2c-a7ea-f83f1474d70a",
                        "entry_id": "9af814ac-193d-3a0b-8c6c-355d09d55ff4",
                        "glosses": [
                            "Relatif aux escarbots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b5b1a0a-076e-4dee-830f-3943c14d17c0",
                                "sense_id": "fcd4a159-8699-3f2c-a7ea-f83f1474d70a",
                                "text": "Le monarque des dieux s’avisa, pour bien faire,\nDe transporter le temps où l’aigle fait l’amour\nEn une autre saison, quand la race escarbote\nEst en quartier d’hiver, et, comme la marmotte,\nSe cache et ne voit point le jour."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a9a3ee4d-0574-3402-81f8-ef9fba4818bc",
                "word": "escarbot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6a27c6e-5d0b-4cb1-93ff-73a35c572504",
                        "entry_id": "a9a3ee4d-0574-3402-81f8-ef9fba4818bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "escarbots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3549734-0261-3ac8-b68e-61230506dc50",
                        "entry_id": "a9a3ee4d-0574-3402-81f8-ef9fba4818bc",
                        "glosses": [
                            "Insecte coléoptère, qui vit dans les fumiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67020e28-9f61-4c52-bb28-a52609001c74",
                                "sense_id": "b3549734-0261-3ac8-b68e-61230506dc50",
                                "text": "L’oiseau de Jupiter, sans répondre un seul mot,\nChoque de l’aile l’escarbot,\nL’étourdit, l’oblige à se taire."
                            },
                            {
                                "example_id": "77e206c6-373c-4723-a485-ebf12773ebed",
                                "sense_id": "b3549734-0261-3ac8-b68e-61230506dc50",
                                "text": "Non! — ricanait le nain railleur, — tu serais la pâture de l'escarbot qui chasse, le soir, aux moucherons aveuglés par le soleil couchant!"
                            },
                            {
                                "example_id": "4094e5d5-c926-4f13-b152-b7ebaa9c608f",
                                "sense_id": "b3549734-0261-3ac8-b68e-61230506dc50",
                                "text": "… les uns, pas plus grands que des escarbots et des grillons, avec leurs vrilles et leurs tarières ; les autres, hauts comme des tours, avec leurs haches, leurs scies et leurs truelles …"
                            }
                        ]
                    },
                    {
                        "sense_id": "7687884d-375c-3db8-ab14-c354080ab0ce",
                        "entry_id": "a9a3ee4d-0574-3402-81f8-ef9fba4818bc",
                        "glosses": [
                            "Synonyme de tribule (espèce de plante)."
