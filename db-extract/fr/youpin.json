                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e8a949-695c-4e58-8629-f404e1156e10",
                                                "sense_id": "8553ed71-11a6-36a1-ae24-3099166f1b9e",
                                                "text": "\"Now you quit kidding me! What's the nice little name?\" \"Oh, it ain't so darn nice. I guess it's kind of kike. But my folks ain't kikes. My papa's papa was a nobleman in Poland, and there was a gentleman in here one day, he was kind of a count or something--\""
                                            },
                                            {
                                                "example_id": "e8413355-ae02-47f8-b372-69f50c272ea4",
                                                "sense_id": "8553ed71-11a6-36a1-ae24-3099166f1b9e",
                                                "text": "In one tweet, Weisman was referred to as a \"kike.\" Another threatened to have him put \"in the oven.\""
                                            },
                                            {
                                                "example_id": "e1e7aac2-f316-499b-a5a1-04a268592d71",
                                                "sense_id": "8553ed71-11a6-36a1-ae24-3099166f1b9e",
                                                "text": "Potok in case you don’t know, is a devious kike who works for the Southern Poverty Law Center which is a notorious anti-White hate group."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3757d582-b841-3e50-b8d8-c696893b919a",
                                        "entry_id": "df5f6f64-39ae-3125-b548-cdf90cbd6d24",
                                        "glosses": [
                                            "A miser; a contemptible, stingy person, particularly a well-endowed one."
                                        ],
                                        "tags": [
                                            "US",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a765a6d-05fe-4e0b-b082-9f8006a3f143",
                                                "sense_id": "3757d582-b841-3e50-b8d8-c696893b919a",
                                                "text": "That greedy kike would not give me any money when I was starving and needed food."
                                            }
                                        ]
                                    }
