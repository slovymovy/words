                "senses": [
                    {
                        "sense_id": "a9f59ce6-f258-3514-8f83-50d37ad6f3e8",
                        "entry_id": "52db6391-800e-38e7-bd58-e250f508dd63",
                        "glosses": [
                            "Bildung einer Verkleinerungsform"
