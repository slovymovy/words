                                "example_id": "e0ffbfe4-f00d-4401-ac3f-39d31ee919a4",
                                "sense_id": "a116b782-4245-3a75-9317-75230770011b",
                                "text": "Hij doet onderzoek naar veranderingen in zeestromingen in de Atlantische Oceaan."
                            }
