                "senses": [
                    {
                        "sense_id": "0c1340a2-d530-310c-8e05-35377e9d91fb",
                        "entry_id": "e6a4d41c-75cf-32e8-9cfb-96f3f72cfe33",
                        "glosses": [
                            "opstandig, balorig, geneigd tot verzet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "341dc0bc-eb41-4500-bed3-f688ba3522d5",
                                "sense_id": "0c1340a2-d530-310c-8e05-35377e9d91fb",
                                "text": "Omdat ik nog nooit op een naaktstrand of naturistencamping was geweest, merkte ik voor het eerst hoe natuurlijk het voelt om zonder kleren door de natuur te lopen. In deze onbewoonde omgeving was het ook niet raar of rebels."
                            },
                            {
                                "example_id": "58a7b4b8-edad-445d-bc4c-86ef8ad31078",
                                "sense_id": "0c1340a2-d530-310c-8e05-35377e9d91fb",
                                "text": "Ze was als rebelse tiener al op haar 16e van huis gegaan en had, met veel geëxperimenteer, geleerd op haar eigen benen te staan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8598d26e-7001-4105-a022-b807e1a51989",
                        "source_entry_id": "e6a4d41c-75cf-32e8-9cfb-96f3f72cfe33",
