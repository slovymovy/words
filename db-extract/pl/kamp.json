                ],
                "translations": [
                    {
                        "translation_id": "b5af8f4d-76f4-4926-b3a0-feca6bace062",
                        "source_entry_id": "ed8505fa-3479-3012-9221-35b565751f6f",
                        "source_sense_id": "c84b6094-7905-366b-a30e-9520c777f068",
                        "target_lang_word": "camp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d457a3cb-b899-3f6f-b98f-5f6e3538dc16",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "An outdoor place acting as temporary accommodation in tents or other simple structures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d288a1-e8d1-4277-a2b5-694c6c75d0ff",
                                                "sense_id": "d457a3cb-b899-3f6f-b98f-5f6e3538dc16",
                                                "text": "Near-synonyms: campsite, campground, encampment"
                                            },
                                            {
                                                "example_id": "a4bbe1d5-1d87-4598-8261-737618190b98",
                                                "sense_id": "d457a3cb-b899-3f6f-b98f-5f6e3538dc16",
                                                "text": "There's a big camp in the woods northwest of here. It's popular with hikers and bushcrafters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59245d45-0698-3795-9c09-f1cba86a9483",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "An organised event, often taking place in tents or temporary accommodation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05c734bf-089b-437f-adec-145c773b10db",
                                                "sense_id": "59245d45-0698-3795-9c09-f1cba86a9483",
                                                "text": "I met my best friend last summer at camp. She lives in Albany and plays the clarinet."
                                            },
                                            {
                                                "example_id": "21d25e64-bfdd-4cc1-9d04-ff1334d1a86b",
                                                "sense_id": "59245d45-0698-3795-9c09-f1cba86a9483",
                                                "text": "He used to go to summer camp every alternate year."
                                            },
                                            {
                                                "example_id": "bbf1928b-2fd6-4859-b835-837857d3af74",
                                                "sense_id": "59245d45-0698-3795-9c09-f1cba86a9483",
                                                "text": "I met my girlfriend last summer at camp. You wouldn't know her — she lives in Canada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09940be8-37cc-3711-a995-598fc98a3ddd",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "A base of a military group, not necessarily temporary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a93956ce-1abd-4687-b8da-1febe5da9110",
                                                "sense_id": "09940be8-37cc-3711-a995-598fc98a3ddd",
                                                "text": "Near-synonym: encampment"
                                            },
                                            {
                                                "example_id": "be6fe9c9-8749-467e-ad7c-ea0dd2acc17d",
                                                "sense_id": "09940be8-37cc-3711-a995-598fc98a3ddd",
                                                "text": "Signs of enemy recon were found near their camp last week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4afdd77-e5c1-3c15-8290-77c5d676ef9e",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "A place of politically motivated confinement in outdoorsy conditions, usually also leading to slave labor and death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a533a155-7602-409b-bfa3-a233b07c9ee2",
                                                "sense_id": "b4afdd77-e5c1-3c15-8290-77c5d676ef9e",
                                                "text": "Near-synonyms: concentration camp, labor camp, reeducation camp, gulag, stalag, prison camp"
                                            },
                                            {
                                                "example_id": "bd6f78c9-b266-4bfd-ae05-04b3668ec84f",
                                                "sense_id": "b4afdd77-e5c1-3c15-8290-77c5d676ef9e",
                                                "text": "Some say they'll round us all up into camps, but if they come for us, we'll take some out with us, on our way out."
                                            },
                                            {
                                                "example_id": "0783f76f-7577-44c5-938d-9fc40ca63728",
                                                "sense_id": "b4afdd77-e5c1-3c15-8290-77c5d676ef9e",
                                                "text": "Mr. Ahn Myong-Chol was a prison guard at Camp 22 in Hoeryong and a driver at the camps. He was there between 1990 and 1994. He is the one who reported that prisoners had been used for human experimentation inside the camps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b564c16-a350-3a9b-a0ab-12cacf650655",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "A single hut or shelter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f74cb73-8250-4f16-a70f-abbedb872b13",
                                                "sense_id": "7b564c16-a350-3a9b-a0ab-12cacf650655",
                                                "text": "a hunter’s camp"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bca58d0-c268-390f-bca5-c04db3936688",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "The company or body of persons encamped."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc1cba5-bdb3-4059-b825-7261859fc191",
                                                "sense_id": "3bca58d0-c268-390f-bca5-c04db3936688",
                                                "text": "The camp broke up with the confusion of a flight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27404510-4fa9-3408-b15e-f702dfc8d8f1",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "A group of people with the same strong ideals or political leanings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bc149e3-4be8-4edf-955b-8d33a0052203",
                                                "sense_id": "27404510-4fa9-3408-b15e-f702dfc8d8f1",
                                                "text": "Near-synonyms: faction, ingroup"
                                            },
                                            {
                                                "example_id": "aaa88337-03dc-4e63-98df-38146f4e898d",
                                                "sense_id": "27404510-4fa9-3408-b15e-f702dfc8d8f1",
                                                "text": "She's in the camp that speaks as if all vaccines were poisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a36cc770-c428-321e-80b4-fbc58c1192c9",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "An army."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ef2d20-36cf-404a-91af-b20acd971067",
                                                "sense_id": "a36cc770-c428-321e-80b4-fbc58c1192c9",
                                                "text": "My Campe is like to Iulius Cæſars Hoſte,\nThat neuer fought but had the victorie:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f92775b1-0b94-3fc6-a79f-3e15dddd26de",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "Clipping of campus"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f7f2b10-29a7-35d5-af5f-a0d4986647e7",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "Any prison or prison camp."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d3717c4-ef68-4037-969c-0e1a9b1f4279",
                                                "sense_id": "0f7f2b10-29a7-35d5-af5f-a0d4986647e7",
                                                "text": "Lantana is a sweet camp. It's an old hospital that has been converted to a drug treatment center for prisoners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4713e7e0-83d9-3001-b2be-8edb7cfa5ed6",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "Misconstruction of clamp (“mound of earth in which potatoes and other vegetables are stored”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "misconstruction",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31ca33e1-0461-35ed-8cb0-54251655f953",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "Anywhere that a colonist stayed when away from their permanent residence; such places collectively."
                                        ],
                                        "tags": [
                                            "British",
                                            "India",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc04f07-8cd4-4a15-a070-865b3639dfaf",
                                                "sense_id": "31ca33e1-0461-35ed-8cb0-54251655f953",
                                                "text": "Then the Rains came, when no one could go into camp, and the Narkarra Road was washed away by the Kasun River, and in the cup-like pastures of Kashima the cattle waded knee-deep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23274d7a-ee71-3659-b78f-3c057971022c",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "Conflict; battle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4df683e-d8a2-372f-a184-5d146380f93a",
                                        "entry_id": "6cf082d7-5a81-3902-a7ac-5ac06fe64f9d",
                                        "glosses": [
                                            "An online game, in some cases roleplay, in which people compete against each other, usually in a structure similar to that of a competition show."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "camp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ecf12f9-d16f-3640-99a9-bc1bd428ad60",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "To live in a tent or similar temporary accommodation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "061b970d-470c-4892-8fb6-bea823df1e04",
                                                "sense_id": "9ecf12f9-d16f-3640-99a9-bc1bd428ad60",
                                                "text": "We're planning to camp in the field until Sunday."
                                            },
                                            {
                                                "example_id": "893339a7-6e6a-4dec-ba08-43160daae0a3",
                                                "sense_id": "9ecf12f9-d16f-3640-99a9-bc1bd428ad60",
                                                "text": "A few hours before sundown we camped at a small playa lake sunk beneath the level of the grass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4189245a-3c0e-3988-8094-b36121a8a768",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "To set up a camp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d92ecdb-bb20-3fa8-81e0-8369c4de5fda",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "To afford rest or lodging for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ecff09e-428e-4852-b751-596c5d89142f",
                                                "sense_id": "5d92ecdb-bb20-3fa8-81e0-8369c4de5fda",
                                                "text": "Had our great palace the capacity / To camp this host, we all would sup together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f39491e-29a6-3ae4-9cd6-87b99874bc01",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "To stay in an advantageous location."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c4de4a-1c4f-4296-b85d-2e498dedf20d",
                                                "sense_id": "9f39491e-29a6-3ae4-9cd6-87b99874bc01",
                                                "text": "Some players like to camp next to a power-up's spawning point."
                                            },
                                            {
                                                "example_id": "38e2deba-b8d6-45de-8234-c98d315359e9",
                                                "sense_id": "9f39491e-29a6-3ae4-9cd6-87b99874bc01",
                                                "text": "Yet, even without the three second rule, where your big man could camp underneath and take those delightful “garbage” shots, there was little or no pivot offense, no cutting off the bucket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60ace96b-7291-3a7e-a110-73521f70a2f3",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "To stay beside (something) to gain an advantage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcaac583-5eb4-4e9f-aea1-f7cac82d14c0",
                                                "sense_id": "60ace96b-7291-3a7e-a110-73521f70a2f3",
                                                "text": "The easiest way to win on this map is to camp the double damage."
                                            },
                                            {
                                                "example_id": "fdcd4549-8ca2-4763-aed4-48d7ee76842a",
                                                "sense_id": "60ace96b-7291-3a7e-a110-73521f70a2f3",
                                                "text": "Go and camp the flag for the win."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37bad540-5d6f-37c7-84d4-1de221af8c9e",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "Ellipsis of corpse camp."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f78a143-c420-3d0b-b40e-251969f54c7a",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "To fight; contend in battle or in any kind of contest; to strive with others in doing anything; compete."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da67bf13-1d4f-42c2-922d-a64629be972a",
                                                "sense_id": "3f78a143-c420-3d0b-b40e-251969f54c7a",
                                                "text": "1562, Leigh, The Accedens of Armory ː\nAristotle affirmeth that Rauens will gather together on sides, and campe and fight for victorie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aabfc1f-32a1-3c47-b312-98fa110d67fb",
                                        "entry_id": "1d0d5f34-bc4e-3b7a-bcff-84c75cba6c27",
                                        "glosses": [
                                            "To wrangle; argue."
                                        ],
