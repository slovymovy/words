                ],
                "senses": [
                    {
                        "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                        "entry_id": "5fc69029-2c49-32c3-82c9-04653ace3694",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d02b96eb-98f9-4fe5-a776-84851d49b8b0",
                                "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                                "text": "Frau Becht ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4c14134a-ca6c-4c05-9e31-4a487489ba33",
                                "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                                "text": "Herr Becht wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f503cafe-176a-4488-be09-24c5fc8390ed",
                                "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                                "text": "Die Bechts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "b5f0f282-3388-41f5-a7f9-ef5a2622acb7",
                                "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                                "text": "Der Becht trägt nie die Pullover, die die Becht ihm strickt."
                            },
                            {
                                "example_id": "4d1bd0eb-a8af-43b1-8f40-9c1694f650b8",
                                "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Becht kommt, geht der Herr Becht.“"
                            },
                            {
                                "example_id": "6b4a3b6d-a5c9-4200-b52d-e2b5373af8b8",
                                "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                                "text": "Becht kommt und geht."
                            },
                            {
                                "example_id": "017bddbe-a718-400a-bc5c-c7bae0f00468",
                                "sense_id": "1e34e498-d658-3a4c-a74e-6b68ee331502",
                                "text": "Bechts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
