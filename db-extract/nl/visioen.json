                "translations": [
                    {
                        "translation_id": "a274ba61-2edf-46fc-9e01-4b59c6a7db16",
                        "source_entry_id": "236af691-488d-3248-8579-8ba56679ce9e",
                        "source_sense_id": "ffc154b0-fa79-3b6a-8e5b-5290f3626e19",
                        "source_sense_description": "een droombeeld",
                        "target_lang_word": "Vision",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vision",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bad8da05-096a-30e0-9df7-54e88cfe9e4b",
                                        "entry_id": "3a031b18-3e37-369c-8ced-ca32edd32ad7",
                                        "glosses": [
                                            "übernatürliche Erscheinung, Offenbarung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "686cc543-b3bf-4f28-a503-56b16886c064",
                                                "sense_id": "bad8da05-096a-30e0-9df7-54e88cfe9e4b",
                                                "text": "Lourdes und Fatima haben als Wallfahrtsorte ihren Ursprung in Visionen."
                                            },
                                            {
                                                "example_id": "fff4aa22-d6ac-41d1-b0af-110ec2637ea4",
                                                "sense_id": "bad8da05-096a-30e0-9df7-54e88cfe9e4b",
                                                "text": "„Schon als Kind habe sie plötzliche Eingebungen und Visionen gehabt, das Schicksal von Menschen intuitiv erkennen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f875d63-1a8a-3b1c-880e-53fc76949e7d",
                                        "entry_id": "3a031b18-3e37-369c-8ced-ca32edd32ad7",
                                        "glosses": [
                                            "Traumbild, Trugbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1784d259-bfd2-4b08-9e22-15b446b17012",
                                                "sense_id": "7f875d63-1a8a-3b1c-880e-53fc76949e7d",
                                                "text": "Wer Visionen hat, sollte zum Arzt gehen. (Sinngemäß nach Helmut Schmidt)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9b630038-158c-3f54-a83e-41f41fe29a3c",
                                        "entry_id": "3a031b18-3e37-369c-8ced-ca32edd32ad7",
                                        "glosses": [
                                            "Wunschbild, Zukunftsentwurf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc22d640-1eac-4199-b2ea-3bc207f0ec92",
                                                "sense_id": "9b630038-158c-3f54-a83e-41f41fe29a3c",
                                                "text": "„Diese Gratwanderung im Grenzgebiet zwischen Phantasterei und wissenschaftlich fundierten Visionen hat seit jeher fasziniert…“"
                                            },
                                            {
                                                "example_id": "990b6d3b-24f9-4662-be42-7b8de763ef5e",
                                                "sense_id": "9b630038-158c-3f54-a83e-41f41fe29a3c",
                                                "text": "„Die glückselige Vision beseelte all seine Mühen, ließ ihn Studium, Reisen und Qualen heldenhaft bewältigen.“"
                                            },
                                            {
                                                "example_id": "e90e7a74-e7e6-4167-8d2b-b11ef91b7c6b",
                                                "sense_id": "9b630038-158c-3f54-a83e-41f41fe29a3c",
                                                "text": "„List war einer der wenigen deutschen Denker der Geschichte, die beides zugleich hatten: eine Vision und einen gesunden Menschenverstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20d9c25c-a399-43fc-949e-c17eb14d78c0",
                        "source_entry_id": "236af691-488d-3248-8579-8ba56679ce9e",
                        "source_sense_id": "ffc154b0-fa79-3b6a-8e5b-5290f3626e19",
                        "source_sense_description": "een droombeeld",
                        "target_lang_word": "Erscheinung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erscheinung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00ef70a1-c689-3800-9667-8d410ea683bd",
                                        "entry_id": "f527713f-629d-359c-a2f8-2037ce8d0707",
                                        "glosses": [
                                            "ein Umstand, der mit den menschlichen Sinnen wahrgenommen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3a5057-ddb2-437a-b191-0ebec246fbe6",
                                                "sense_id": "00ef70a1-c689-3800-9667-8d410ea683bd",
                                                "text": "Polarlichter sind wunderschöne Erscheinungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf343109-de6e-3053-a3fa-fff244f807a6",
                                        "entry_id": "f527713f-629d-359c-a2f8-2037ce8d0707",
                                        "glosses": [
                                            "eine plötzliche Veränderung; Manifestation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f1d007-a8b3-4604-9692-3f19c820614b",
                                                "sense_id": "bf343109-de6e-3053-a3fa-fff244f807a6",
                                                "text": "In Notzeiten ist eine in breiten Bevölkerungsschichten auftretende Fremdenfeindlichkeit keine seltene Erscheinung."
                                            },
                                            {
                                                "example_id": "0f622dd0-10fb-4e10-8f72-fe2c111850ce",
                                                "sense_id": "bf343109-de6e-3053-a3fa-fff244f807a6",
                                                "text": "„Die Gesamtheit der Ursachen einer Erscheinung ist dem menschlichen Verstand nicht zugänglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8d8b8e5e-ccd8-383a-b2a3-8af1c2dbaed0",
                                        "entry_id": "f527713f-629d-359c-a2f8-2037ce8d0707",
                                        "glosses": [
                                            "Auftritt/Wirkung einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afbef787-1b76-4067-8923-a5f43a15076f",
                                                "sense_id": "8d8b8e5e-ccd8-383a-b2a3-8af1c2dbaed0",
                                                "text": "Sie war noch in hohem Alter eine eindrucksvolle Erscheinung."
                                            },
                                            {
                                                "example_id": "69ad63f7-7e58-44ee-b546-828f29b80ada",
                                                "sense_id": "8d8b8e5e-ccd8-383a-b2a3-8af1c2dbaed0",
                                                "text": "„Bei solchen großen Erscheinungen von Facharroganz zu sprechen, wäre höchst unangebracht; aber im allgemeinen kommt mit der Würde der Dünkel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "302112a9-3acd-358f-9477-97e29e8ee436",
                                        "entry_id": "f527713f-629d-359c-a2f8-2037ce8d0707",
                                        "glosses": [
                                            "scheinbares Auftreten von etwas Unwirklichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2f956a-8c51-4dbb-bf01-c85d8e1afe08",
                                                "sense_id": "302112a9-3acd-358f-9477-97e29e8ee436",
                                                "text": "Es war mir, als hätte ich eine Erscheinung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8a954fd-c9dd-4dd5-a974-86518b76eca8",
                        "source_entry_id": "236af691-488d-3248-8579-8ba56679ce9e",
                        "source_sense_id": "ffc154b0-fa79-3b6a-8e5b-5290f3626e19",
