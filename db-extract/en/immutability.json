                                            {
                                                "example_id": "fed5eaf4-b0fa-41f5-824e-1279a7bdfa4b",
                                                "sense_id": "269da972-63a3-3122-a06a-fa69b42eaf39",
                                                "text": "Hij was de enige die niet gehoorzaamde aan de wet der onveranderlijkheid in dit betoverde, slapende kasteel."
                                            },
                                            {
                                                "example_id": "ead904e1-ffa3-4189-8f95-31f3f964f589",
                                                "sense_id": "269da972-63a3-3122-a06a-fa69b42eaf39",
                                                "text": "V&D sinds begin bekend om onveranderlijkheid: In de vorige eeuw groeide de warenhuisketen snel. Tot begin deze eeuw. Pogingen om het tij te keren komen te laat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2624aa15-6131-3770-84c1-daaa27932698",
                                        "entry_id": "6578a96f-d66a-3aae-8410-56c530cb2c2d",
