                "senses": [
                    {
                        "sense_id": "6b65a6db-4a53-3fbe-91b4-0972fbe372fa",
                        "entry_id": "f85992fe-e362-38c4-b02c-fdbe6d4a815b",
                        "glosses": [
                            "Espèce de plante vivace marine, à rhizome, aux feuilles rubanées, croissant en Méditerranée et sur la côte occidentale de l’Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54557fe3-8a16-4d91-b4ee-4c3a776b5593",
                                "sense_id": "6b65a6db-4a53-3fbe-91b4-0972fbe372fa",
                                "text": "La cymodocée n'est pas une algue mais une plante à fleurs marine submergée."
                            },
                            {
                                "example_id": "9350fd70-9ff6-420c-a50e-cc60a941a3ae",
                                "sense_id": "6b65a6db-4a53-3fbe-91b4-0972fbe372fa",
                                "text": "La cymodocée se rencontre sur les fonds sableux éclairés comportant une certaine proportion de matières organiques."
                            },
                            {
                                "example_id": "b27578b2-15d8-4b37-83f7-2266bc59a3df",
                                "sense_id": "6b65a6db-4a53-3fbe-91b4-0972fbe372fa",
                                "text": "Aux côtés de la posidonie, on peut citer les cystoserres littorales qui sont des algues brunes, la zostère naine qui est une plante à fleurs que l’on trouve dans les fonds alluvionnaires des baies à l’abri, la cymodocée, plante à fleurs que l’on trouve dans le sable."
                            }
                        ]
                    }
