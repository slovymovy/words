                                                "sense_id": "a9243edb-77cc-341a-a6c7-6efd61e124af",
                                                "text": "Nimm ein wenig Schmand, damit die Suppe besser schmeckt."
                                            },
                                            {
                                                "example_id": "33a016a5-20c9-4281-bb7b-8f40b73d3804",
                                                "sense_id": "a9243edb-77cc-341a-a6c7-6efd61e124af",
                                                "text": "„Denn ohne Schmand läuft im Eichsfeld rein gar nichts.“"
                                            }
                                        ],
