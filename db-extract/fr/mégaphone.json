                                    {
                                        "sense_id": "505e1697-dba0-33f8-ade6-f5f48c753c57",
                                        "entry_id": "d36708b8-f68e-3f6a-8d0e-8112c71bba95",
                                        "glosses": [
                                            "A megaphone which electronically amplifies a person’s natural voice."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d57c30-32d5-40e8-ab56-d14f8b8cb5d2",
                                                "sense_id": "505e1697-dba0-33f8-ade6-f5f48c753c57",
                                                "text": "Iʼll press the trigger, and with a loud squeal of ear-piercing feedback, the bullhorn buzzes to staticky life."
                                            },
                                            {
                                                "example_id": "f4aa4a69-e8d5-4f0a-af50-4fd7e2785008",
                                                "sense_id": "505e1697-dba0-33f8-ade6-f5f48c753c57",
                                                "text": "[Mark Zuckerberg] didn’t found Facebook to manipulate elections; Jack Dorsey and the other Twitter founders didn’t intend to give Donald Trump a digital bullhorn."
                                            },
                                            {
                                                "example_id": "5794f674-5a1c-436c-b1e5-89e04f6594aa",
                                                "sense_id": "505e1697-dba0-33f8-ade6-f5f48c753c57",
                                                "text": "CNews, the news network created by the billionaire Vincent Bolloré, topped the ratings in May by giving a new bullhorn for right-wing views on crime, immigration, climate and Covid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
