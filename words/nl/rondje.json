    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df0db4c2-7e67-3cb8-bb32-a86c2ed586d6",
                    "sense_definition": "Een traktatie van drankjes voor alle aanwezigen in een gezelschap, meestal in een café of bar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drankjes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wie geeft het volgende <w>rondje</w> aan de bar?",
                            "target_lang_translations": {
                                "en": "Who is buying the next <w>round</w> at the bar?"
                            }
                        },
                        {
                            "text": "Hij besloot een <w>rondje</w> te geven om zijn verjaardag te vieren.",
                            "target_lang_translations": {
                                "en": "He decided to buy a <w>round</w> to celebrate his birthday."
                            }
                        }
                    ],
                    "synonyms": [
                        "traktatie"
                    ],
                    "common_phrases": [
                        "een rondje geven"
                    ],
                    "target_lang_definitions": {
                        "en": "A treat of drinks for everyone present in a group, usually in a pub or bar."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "round",
                                "target_lang_sense_clarification": "of drinks"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5519d57-71c8-31ad-a60d-107945bfaadb",
                    "sense_definition": "Een enkele rondgang of omloop over een circuit, baan of een korte wandeling.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we vanavond een <w>rondje</w> lopen door het park?",
                            "target_lang_translations": {
                                "en": "Shall we go for a short <w>walk</w> through the park tonight?"
                            }
                        },
                        {
                            "text": "De schaatser reed een snel <w>rondje</w> op de ijsbaan.",
                            "target_lang_translations": {
                                "en": "The speed skater skated a fast <w>lap</w> on the ice rink."
                            }
                        }
                    ],
                    "synonyms": [
                        "ronde",
                        "ommegang"
                    ],
                    "common_phrases": [
                        "een rondje lopen",
                        "een rondje fietsen"
                    ],
                    "target_lang_definitions": {
                        "en": "A single lap or circuit on a track, course, or a short walk."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lap",
                                "target_lang_sense_clarification": "on a track or circuit"
                            },
                            {
                                "target_lang_word": "round",
                                "target_lang_sense_clarification": "a short walk or ride"
                            },
                            {
                                "target_lang_word": "circuit",
                                "target_lang_sense_clarification": "a completed route"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07550f6f-e653-3bf7-8b9d-0a83c5fadb54",
                    "sense_definition": "Verkleinwoord van <w>ronde</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diminutief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een kort <w>rondje</w> langs de winkels ging zij weer naar huis.",
                            "target_lang_translations": {
                                "en": "After a quick <w>round</w> of the shops, she went back home."
                            }
                        },
                        {
                            "text": "De bewaker deed zijn gebruikelijke <w>rondje</w> door het gebouw.",
                            "target_lang_translations": {
                                "en": "The security guard did his usual <w>rounds</w> through the building."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutive"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of 'ronde' (round/turn/patrol)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "round",
                                "target_lang_sense_clarification": "a short tour or patrol"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "a brief stroll or visit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07b2dd58-1f78-3c3a-ac8b-ee45b0148056",
                    "sense_definition": "Het cirkelvormige symbool (de letter O) gebruikt in het spelletje boter-kaas-en-eieren.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zet jij een kruisje of kies je voor het <w>rondje</w>?",
                            "target_lang_translations": {
                                "en": "Do you place a cross or do you choose the <w>nought</w>?"
                            }
                        },
                        {
                            "text": "Met drie op een rij van het <w>rondje</w> heeft zij het spel gewonnen.",
                            "target_lang_translations": {
                                "en": "With three <w>noughts</w> in a row, she won the game."
                            }
                        }
                    ],
                    "antonyms": [
                        "kruis"
                    ],
                    "target_lang_definitions": {
                        "en": "The circular symbol (the letter O) used in the game of tic-tac-toe."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nought",
                                "target_lang_sense_clarification": "in tic-tac-toe"
                            },
                            {
                                "target_lang_word": "O",
                                "target_lang_sense_clarification": "the letter/symbol in tic-tac-toe"
                            },
                            {
                                "target_lang_word": "circle",
                                "target_lang_sense_clarification": "the shape in the game"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}