                                    {
                                        "sense_id": "1856e9b4-d6e5-3735-aff4-ecf1ba697927",
                                        "entry_id": "a080602e-cceb-3f23-b3af-a6b64bc89497",
                                        "glosses": [
                                            "Autre nom du Kirghizistan."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4379c754-4382-4824-8b19-300b103fbfa9",
                                                "sense_id": "1856e9b4-d6e5-3735-aff4-ecf1ba697927",
                                                "text": "Les incidents au Kazakhstan, en Ouzbékistan, au Tadjikistan, au Turkménistan ou au Kirghizstan se sont produits à l'échelle locale, dans les installations nucléaires des pays en question."
                                            },
                                            {
                                                "example_id": "abeda77d-1552-42dc-a7ad-937d0b7b5730",
                                                "sense_id": "1856e9b4-d6e5-3735-aff4-ecf1ba697927",
                                                "text": "L'application TikTok ne fonctionne plus depuis ce jeudi au Kirghizstan, à la demande des services de sécurité de ce pays d'Asie centrale, qui l'ont justifiée par la nécessité de «protéger la santé des enfants»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ce8eb15-37d3-4766-88b8-49dcb8baef63",
                        "source_entry_id": "6f3f0740-3bb9-37a9-b6fb-1b203447bd06",
                        "source_sense_id": "84d8dc2b-bfb5-3cff-a100-cfefe51b4704",
                        "target_lang_word": "Kirghizie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirghizie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f757d9-46e1-3f62-9fc8-d1b2bce0f4df",
                                        "entry_id": "d4ec4f7e-692a-3982-987f-d923bfe19611",
                                        "glosses": [
                                            "Ancien nom du Kirghizistan, en particulier à l’époque de la République socialiste soviétique kirghize."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d13314-a46f-481f-ad75-fe10d4366747",
                                                "sense_id": "e3f757d9-46e1-3f62-9fc8-d1b2bce0f4df",
                                                "text": "Tout le monde en Kirghizie, craignait ce gouvernement autoritaire et cruel."
                                            },
                                            {
                                                "example_id": "2c13c4ea-ba7b-4d47-bfb9-2f20ad213880",
                                                "sense_id": "e3f757d9-46e1-3f62-9fc8-d1b2bce0f4df",
                                                "text": "Quant à la Kirghizie, petite et pauvre, elle a établi d’excellents rapports avec la Russie et diversifie, en concertation avec elle, ses relations avec les États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
