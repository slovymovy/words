                "senses": [
                    {
                        "sense_id": "547f9ba4-dd49-3d4a-805b-a2363d952afe",
                        "entry_id": "b3e23954-1c62-39c7-96d8-df15dd468e8a",
                        "glosses": [
                            "van de slaap: dat je makkelijk wakker kunt worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e2541b-d750-494c-9430-98cd1d1c3f48",
                                "sense_id": "547f9ba4-dd49-3d4a-805b-a2363d952afe",
                                "text": "Ik heb een lichte, onvaste slaap. Ik word van het minste geluid al wakker."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cb6ebf9-c0e2-3eef-98b7-0d518b9cb62f",
                        "entry_id": "b3e23954-1c62-39c7-96d8-df15dd468e8a",
                        "glosses": [
                            "van bewegingen van het lichaam dat ze niet helemaal beheerst worden: een onvaste hand, een onvaste tred, onvast op de benen staan, een onvaste (zang)stem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc9da410-2de5-47ba-b982-c99a02c2778e",
                                "sense_id": "0cb6ebf9-c0e2-3eef-98b7-0d518b9cb62f",
                                "text": "Op camerabeelden is een strompelende Cole te zien. Door de alcoholinname is de jongen zeer onvast ter been. Op een gegeven moment wordt de Brit benaderd door een aantal mannen, die hem meerdere malen vastpakken. Uiteindelijk wordt zijn mobiele telefoon gestolen."
                            }
                        ]
                    },
                    {
                        "sense_id": "98c67763-40fc-3df6-80be-362962c0fe67",
                        "entry_id": "b3e23954-1c62-39c7-96d8-df15dd468e8a",
                        "glosses": [
                            "van een bouwwerk dat het niet stevig is"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4f0475c9-5a68-37e1-9d3c-4154b1419d44",
                        "entry_id": "b3e23954-1c62-39c7-96d8-df15dd468e8a",
                        "glosses": [
                            "van het weer dat het niet zeker is dat het droog blijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3e46fb-d964-45d1-8e01-b5609854e0b3",
                                "sense_id": "4f0475c9-5a68-37e1-9d3c-4154b1419d44",
                                "text": "Onvast weer hoort nu eenmaal bij Nederland."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b9ecd7a-8ef4-3765-a8b0-bd8483ad6d8a",
                        "entry_id": "b3e23954-1c62-39c7-96d8-df15dd468e8a",
                        "glosses": [
                            "gevoel van onzekerheid gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1182961-b51b-4184-8c9d-387e751ab0b1",
                                "sense_id": "8b9ecd7a-8ef4-3765-a8b0-bd8483ad6d8a",
                                "text": "Ooit geloofde Jongstra dat zijn identiteit ‘een feit’ was, noteert hij in het begin, maar feit en fictie blijken schijngestalten. De wereld is een onvaste plaats geworden. Van de weeromstuit zoeken we vertwijfeld ankerpunt, meerpaal, stoothout. We stellen onze hoop in de illusoire standvastigheid van de grens, de norm, de eigenheid, de taal. Maar, zegt Jongstra: ‘Identiteit is twee dingen. Dat je weet waar je bij hoort, en ook inziet wat je anders maakt.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0f0d80f-7c77-4f66-9505-967367f5d2a5",
                        "source_entry_id": "b3e23954-1c62-39c7-96d8-df15dd468e8a",
