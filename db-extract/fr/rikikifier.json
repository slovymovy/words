                ],
                "senses": [
                    {
                        "sense_id": "00dc62ad-f505-3de7-ab93-434f3c0e94f6",
                        "entry_id": "130f1c1d-d781-31e5-b1bf-42e05f5e962a",
                        "glosses": [
                            "Rendre riquiqui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fbceeea-4231-4312-8cff-f5f421414632",
                                "sense_id": "00dc62ad-f505-3de7-ab93-434f3c0e94f6",
                                "text": "Et je pense qu'un chihuahua est déjà assez petit sans vouloir le rikikifier davantage, au détriment de sa santé !!!"
                            },
                            {
                                "example_id": "0da44214-b35e-4a9a-87b6-8260cfece24d",
                                "sense_id": "00dc62ad-f505-3de7-ab93-434f3c0e94f6",
                                "text": "Passer d'un format A4 resplendissant à un format mook « dans l'air du temps » (homothétie : dans notre cas, rikikifier tout le jeu plus la gamme), si la mise en pages est adaptée, peut amplifier les délais prévus."
                            },
                            {
                                "example_id": "a7fed92d-86eb-4410-b989-393d7f24969b",
                                "sense_id": "00dc62ad-f505-3de7-ab93-434f3c0e94f6",
                                "text": "Encore une fois, boostée par tous les très bons échos sur ce livre, je suis partie bille en tête et mon enthousiasme s'est rikikifié en cours de lecture."
                            }
                        ]
                    }
                ],
