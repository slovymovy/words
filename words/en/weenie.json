                },
                {
                    "sense_id": "b601ca7d-3321-34e2-a5d9-296092a96dc8",
                    "sense_definition": "Someone who is weak, timid, or unimportant; a wimp.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>weenie</w> and just jump into the pool already.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>слабаком</w>, просто прыгни уже в бассейн."
                            }
                        },
                        {
                            "text": "He felt like a total <w>weenie</w> when he refused to ride the roller coaster.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя полным <w>нытиком</w>, когда отказался кататься на американских горках."
                            }
                        }
                    ],
                    "synonyms": [
                        "wuss",
                        "softy",
                        "milksop"
                    ],
                    "common_phrases": [
                        "such a weenie",
                        "total weenie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a mild, informal insult."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, трусливый или никчемный человек; слабак, размазня."
