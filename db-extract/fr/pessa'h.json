                    {
                        "translation_id": "ceeb0d52-0c50-4554-aa9d-674752e849de",
                        "source_entry_id": "b865430d-37a5-32ef-a3b5-12ef47309821",
                        "source_sense_id": "3cfea2b8-2a4c-3dda-b007-0a3088f1f1c6",
                        "target_lang_word": "Passover",
                        "target_lang_code": "en",
