                                "example_id": "0457d6c7-6cd5-4cf3-ab11-96a1fb93567e",
                                "sense_id": "e66f5a3d-0fac-30c2-9f28-49502d774617",
                                "text": "Le temps d’ajustabilité du carrelage pour ce type de mortier est de 20 minutes, ensuite la prise sera définitive."
                            },
