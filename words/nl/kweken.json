            "senses": [
                {
                    "sense_id": "76b8660f-661e-34e8-80e0-83bfca267e53",
                    "sense_definition": "het verzorgen en laten groeien van planten of gewassen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze kas <w>kweken</w> ze het hele jaar door verse tomaten.",
                            "target_lang_translations": {
                                "en": "In this greenhouse, they <w>grow</w> fresh tomatoes all year round.",
                                "ru": "В этой теплице круглый год <w>выращивают</w> свежие помидоры."
                            }
                        },
                        {
                            "text": "Mijn opa houdt ervan om zijn eigen groenten te <w>kweken</w> in de achtertuin.",
                            "target_lang_translations": {
                                "en": "My grandfather loves to <w>grow</w> his own vegetables in the backyard.",
                                "ru": "Мой дедушка любит <w>выращивать</w> собственные овощи на заднем дворе."
                            }
                        }
                    ],
                    "synonyms": [
                        "telen",
                        "verbouwen"
                    ],
                    "common_phrases": [
                        "groenten kweken",
                        "planten kweken"
                    ],
                    "target_lang_definitions": {
                        "en": "the care and cultivation of plants or crops",
                        "ru": "уход за растениями или сельскохозяйственными культурами и их выращивание"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "general cultivation of plants"
                            },
                            {
                                "target_lang_word": "cultivate",
                                "target_lang_sense_clarification": "formal term for growing crops"
                            },
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "to nurture plants from seeds"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выращивать",
                                "target_lang_sense_clarification": "общее значение для растений"
                            },
                            {
                                "target_lang_word": "культивировать",
                                "target_lang_sense_clarification": "более формальный термин"
                            },
                            {
                                "target_lang_word": "разводить",
                                "target_lang_sense_clarification": "о растениях или сортах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a165500-ade2-3584-8dac-88840c5a9ae0",
                    "sense_definition": "het houden en laten voortplanten van dieren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>kweekte</w> gekleurde kanaries en won daar veel prijzen mee.",
                            "target_lang_translations": {
                                "en": "He <w>bred</w> colored canaries and won many prizes with them.",
                                "ru": "Он <w>разводил</w> цветных канареек и выиграл с ними много призов."
                            }
                        },
                        {
                            "text": "Het is een uitdaging om zeldzame vissen in een aquarium te <w>kweken</w>.",
                            "target_lang_translations": {
                                "en": "It is a challenge to <w>breed</w> rare fish in an aquarium.",
                                "ru": "Разведение редких рыб в аквариуме — это непростая задача (букв. <w>разводить</w>)."
                            }
