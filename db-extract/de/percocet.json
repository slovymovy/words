                        "glosses": [
                            "Arzneistoff, bestehend aus Paracetamol und Oxycodon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758ac887-23ef-4a84-8e6a-bfb2170998df",
                                "sense_id": "a65f87e3-7fa5-3ada-b7f0-747d03b88bda",
                                "text": "„Jeder Student der University of Oregon konnte ein Fentanyl-Pflaster oder eine Percocet von der Erdumlaufbahn aus erkennen.“"
                            },
                            {
                                "example_id": "c5d148f4-23c9-4cc8-9351-2cead657ce4d",
                                "sense_id": "a65f87e3-7fa5-3ada-b7f0-747d03b88bda",
                                "text": "„Marks hatte es bislang geschafft, ohne das deutlich höher dosierte Percocet, das er ständig mit sich herumtrug, auszukommen.“"
                            },
                            {
                                "example_id": "65c5e4c5-55fb-4cce-915b-c8fc0ef60f8e",
                                "sense_id": "a65f87e3-7fa5-3ada-b7f0-747d03b88bda",
                                "text": "„Immer wenn ich in der Schule meine Brotdose aufmachte, war da außer einem Käsebrot und Möhrenstückchen und einem kleinen Karton Apfelsaft auch eine 500-Milligramm-Dosis Percocet.“"
                            }
                        ],
