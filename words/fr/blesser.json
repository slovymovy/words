                    ]
                },
                {
                    "sense_id": "b54c845f-1200-33c8-8885-8528396ef79a",
                    "sense_definition": "Porter atteinte ou préjudice à des intérêts ou à des droits moraux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prejudice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle clause contractuelle pourrait <w>blesser</w> les intérêts des salariés."
                        },
                        {
                            "text": "Une telle accusation infondée vise clairement à <w>blesser</w> l'honneur de sa famille."
