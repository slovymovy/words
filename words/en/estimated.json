{
    "word_family": [
        "estimate",
        "estimation",
        "estimator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0e543d8-87b1-317d-aa18-f12f5f905ed1",
                    "sense_definition": "Calculated approximately; determined by rough calculation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project will take an <w>estimated</w> three months to complete.",
                            "target_lang_translations": {
                                "ru": "На завершение проекта потребуется <w>приблизительно</w> три месяца."
                            }
                        },
                        {
                            "text": "There are an <w>estimated</w> fifty million people living in this region.",
                            "target_lang_translations": {
                                "ru": "В этом регионе проживает <w>оценочно</w> пятьдесят миллионов человек."
                            }
                        }
                    ],
                    "synonyms": [
                        "estd."
                    ],
                    "common_phrases": [
                        "estimated time",
                        "estimated cost",
                        "estimated value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизительно рассчитанный; определенный путем примерного подсчета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приблизительный",
                                "target_lang_sense_clarification": "общий термин для чего-то, что не является точным"
                            },
                            {
                                "target_lang_word": "оценочный",
                                "target_lang_sense_clarification": "относящийся к результатам оценки или расчетов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af8ccbfc-d258-34f3-91a6-67b1ae5cb690",
                    "sense_definition": "Past tense and past participle of <w>estimate</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experts <w>estimated</w> the total damage to be over one million dollars.",
                            "target_lang_translations": {
                                "ru": "Эксперты <w>оценили</w> общий ущерб более чем в один миллион долларов."
                            }
                        },
                        {
                            "text": "We <w>estimated</w> the travel time based on previous trips.",
                            "target_lang_translations": {
                                "ru": "Мы <w>оценили</w> время в пути, основываясь на предыдущих поездках."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «оценивать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценили",
                                "target_lang_sense_clarification": "прошедшее время, множественное число"
                            },
                            {
                                "target_lang_word": "оцененный",
                                "target_lang_sense_clarification": "причастие, описывающее объект, который подвергся оценке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}