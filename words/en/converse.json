                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b1503a8-fb54-3042-87d8-45b7e9d31c76",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
