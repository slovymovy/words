                                "target_word": "Torhüter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93abe13c-28d9-3e85-8e2a-2d97e4050fc4",
                                        "entry_id": "6dd65066-a8ae-3b89-82d5-4dd08ee0fd15",
                                        "glosses": [
                                            "defensivster Spieler einer Sportmannschaft, der gegnerische Tore verhindern soll und hierfür oft auch mit Sonderberechtigungen ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683bb6ff-44c5-4bbd-9cdc-16b17b2ca38d",
                                                "sense_id": "93abe13c-28d9-3e85-8e2a-2d97e4050fc4",
                                                "text": "Der deutsche Torhüter konnte im Elfmeterschießen zwei Schüsse parieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2ab580b-28a3-374e-b23e-2116fd96ae1c",
                                        "entry_id": "6dd65066-a8ae-3b89-82d5-4dd08ee0fd15",
                                        "glosses": [
                                            "Person, die ein Tor (eines Anwesens, einer Stadt, ...) beaufsichtigt/bewacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d94440cd-2103-433e-a57d-da8436fc02c0",
                                                "sense_id": "a2ab580b-28a3-374e-b23e-2116fd96ae1c",
                                                "text": "„Er selbst begab sich in seiner schwarzen Bediententracht sofort zu dem Torhüter und verneigte sich vor ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b84c1408-3d56-498f-bf37-80d6baec1f64",
                        "source_entry_id": "422490d0-e988-3186-8c6b-15d74a309ca9",
                        "source_sense_id": "435924b9-e57f-3601-87c5-c45449392ae0",
                        "target_lang_word": "Torwart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Torwart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fda28e1-16b4-329f-ac9a-5890abfd1e93",
                                        "entry_id": "032a587b-4f90-3ba6-8cd4-33341facd39a",
                                        "glosses": [
                                            "defensivster Spieler einer Sportmannschaft, der gegnerische Tore verhindern soll und hierfür oft auch mit Sonderberechtigungen ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8dea49-41c4-4b89-8c60-9013fa516a8d",
                                                "sense_id": "4fda28e1-16b4-329f-ac9a-5890abfd1e93",
                                                "text": "Der Torwart konnte den Ball nicht festhalten."
                                            },
                                            {
                                                "example_id": "51c254a1-ee21-41ad-ab6d-03e52096c215",
                                                "sense_id": "4fda28e1-16b4-329f-ac9a-5890abfd1e93",
                                                "text": "„An dem herausstürzenden Torwart trieb er den Ball immer weiter nach links vorbei und schob ihn dann ins leere Tor hinein, ganz lässig.“"
                                            },
                                            {
                                                "example_id": "01659996-cd95-4e12-bd40-42ee39ffc2b1",
                                                "sense_id": "4fda28e1-16b4-329f-ac9a-5890abfd1e93",
                                                "text": "„Als wir dann eine Pause machten, sagte er, dass er Torwart in einer Jugendmannschaft sei und jeden Tag trainiere, und als ich ihn fragte, mit wem er denn jeden Tag trainiere, sagte er, dass er meist allein trainiere und dass er ein Buch habe, in dem genau drin stehe, wie man als Torwart allein trainiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "533da097-dd3a-42cb-adf3-f1f3c3fccdb7",
