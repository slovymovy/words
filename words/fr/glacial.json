                {
                    "sense_id": "fd344dca-e223-32be-a154-e7c8c8fa9423",
                    "sense_definition": "D'une froideur distante ou intimidante, qui déconcerte et manque de chaleur humaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa remarque maladroite, un silence <w>glacial</w> s'est installé dans la pièce.",
                            "target_lang_translations": {
                                "en": "After his clumsy remark, an <w>icy</w> silence settled over the room.",
                                "ru": "После его неловкого замечания в комнате воцарилось <w>ледяное</w> молчание.",
                                "nl": "Na zijn onhandige opmerking viel er een <w>ijzige</w> stilte in de kamer.",
                                "de": "Nach seiner ungeschickten Bemerkung herrschte im Raum ein <w>eisiges</w> Schweigen.",
                                "pl": "Po jego niezręcznej uwadze w pokoju zapanowała <w>lodowata</w> cisza.",
                                "it": "Dopo la sua osservazione maldestra, nella stanza è calato un silenzio <w>gelido</w>.",
                                "cs": "Po jeho nešikovné poznámce se v místnosti rozhostilo <w>ledové</w> ticho.",
                                "tr": "Beceriksiz sözünün ardından odada <w>buz gibi</w> bir sessizlik çöktü.",
                                "es": "Tras su torpe comentario, un silencio <w>glacial</w> se instaló en la habitación.",
                                "zh": "他说了一句笨拙的话之后，屋里便陷入了一片<w>冰冷</w>的沉默。"
                            }
                        },
                        {
                            "text": "Le directeur a réservé un accueil <w>glacial</w> aux délégués du personnel.",
                            "target_lang_translations": {
                                "en": "The director gave the staff representatives a <w>frosty</w> reception.",
                                "ru": "Директор оказал представителям персонала <w>холодный</w> приём.",
                                "nl": "De directeur bereidde de personeelsafgevaardigden een <w>kille</w> ontvangst.",
                                "de": "Der Direktor bereitete den Personalvertretern einen <w>frostigen</w> Empfang.",
                                "pl": "Dyrektor zgotował przedstawicielom pracowników <w>lodowate</w> przyjęcie.",
                                "it": "Il direttore ha riservato un'accoglienza <w>gelida</w> ai delegati del personale.",
                                "cs": "Ředitel připravil zástupcům zaměstnanců <w>chladné</w> přijetí.",
                                "tr": "Müdür, personel temsilcilerine <w>soğuk</w> bir karşılama yaptı.",
                                "es": "El director reservó un recibimiento <w>frío</w> a los delegados del personal.",
                                "zh": "经理对员工代表的接待十分<w>冷淡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glaçant"
                    ],
                    "antonyms": [
                        "chaleureux",
                        "cordial"
                    ],
                    "common_phrases": [
                        "accueil glacial",
                        "silence glacial",
                        "regard glacial"
                    ],
                    "target_lang_definitions": {
                        "en": "Distantly cold or intimidating, lacking warmth and unsettling others.",
                        "ru": "Подчёркнуто холодный, сдержанный и отчуждённый, вызывающий неловкость у окружающих.",
                        "nl": "Afstandelijk en koel, zonder warmte, waardoor anderen zich ongemakkelijk voelen.",
                        "de": "Distanziert und abweisend, ohne Wärme, sodass sich andere unbehaglich fühlen.",
                        "pl": "Dystansowo chłodny lub onieśmielający, pozbawiony serdeczności i budzący skrępowanie.",
                        "it": "Di una freddezza distante o intimidatoria, che disorienta e manca di calore umano.",
                        "cs": "Odtažitě chladný, bez lidského tepla, takže ostatní znejistí nebo se cítí nepříjemně.",
                        "tr": "Mesafeli ve soğuk, sıcaklıktan yoksun, karşısındakini rahatsız eden bir tutum.",
                        "es": "Distante y poco cordial, que desconcierta y carece de calidez humana.",
                        "zh": "态度疏远冷淡，缺乏温情，令人感到拘束或不安。"
                    },
