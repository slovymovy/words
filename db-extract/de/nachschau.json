                ],
                "senses": [
                    {
                        "sense_id": "d18a675f-4b10-37fc-aa87-d657ef9a597e",
                        "entry_id": "fe1c9f60-23b8-3ba0-87e5-9adc05e0fd42",
                        "glosses": [
                            "im Hergang eines Vorganges nachprüfende Handlung zur Sachlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c963b631-636a-47ea-a9be-9f28f652d875",
                                "sense_id": "d18a675f-4b10-37fc-aa87-d657ef9a597e",
                                "text": "„Die Nachschau ist ein Kontrollinstrument der Finanzverwaltung von teilweise größerer Eingriffsintensität als die Betriebsprüfung, weil der prozeduale Grundrechtsschutz schon im Ansatz geringer ausgestaltet ist.“"
                            },
                            {
                                "example_id": "317380fa-c822-442c-94a6-6054328cc8b2",
                                "sense_id": "d18a675f-4b10-37fc-aa87-d657ef9a597e",
                                "text": "Bei der sofortigen polizeilichen Nachschau wurden die Einbrechen im Keller des Hause gefasst."
                            },
                            {
                                "example_id": "e23c0366-1a60-460f-a0c4-d30e412e4db6",
                                "sense_id": "d18a675f-4b10-37fc-aa87-d657ef9a597e",
                                "text": "„Nachschau ist jederzeit zulässig, wenn der Verdacht besteht, dass Verstöße gegen Zoll- und Verbrauchsteuergesetze, v.a. dass sich in den betreffenden Räumen Schmuggelwaren oder nicht ordnungsgemäß versteuerte verbrauchsteuerpflichtige Waren befinden, aufgedeckt werden können; bei Gefahr im Verzug darf eine Durchsuchung von Wohn- und Geschäftsräumen ohne richterliche Anordnung erfolgen (§ 210 II AO). Übergang zur Außenprüfung ist möglich (§ 210 IV AO).“"
                            },
                            {
                                "example_id": "1ff8be79-8700-45f2-afbd-7807afff6a90",
                                "sense_id": "d18a675f-4b10-37fc-aa87-d657ef9a597e",
                                "text": "„Der Erlaubnisinhaber sollte einen schriftlichen Vermerk über die Nachschau anfertigen mit Datum, Namen der Behördenmitarbeiter, Zeitdauer der Nachschau, Namen anwesender Zeugen sowie dem Ergebnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ff994e3-e1da-3c3d-802e-a5dfc8d16102",
                        "entry_id": "fe1c9f60-23b8-3ba0-87e5-9adc05e0fd42",
                        "glosses": [
                            "spätere Betrachtung eines erledigten Vorganges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed563ec5-4b26-4599-816b-eace883ab9dd",
                                "sense_id": "7ff994e3-e1da-3c3d-802e-a5dfc8d16102",
                                "text": "„Nachschau ist jederzeit zulässig, wenn der Verdacht besteht, dass Verstöße gegen Zoll- und Verbrauchsteuergesetze, v.a. dass sich in den betreffenden Räumen Schmuggelwaren oder nicht ordnungsgemäß versteuerte verbrauchsteuerpflichtige Waren befinden, aufgedeckt werden können; bei Gefahr im Verzug darf eine Durchsuchung von Wohn- und Geschäftsräumen ohne richterliche Anordnung erfolgen (§ 210 II AO). Übergang zur Außenprüfung ist möglich (§ 210 IV AO).“"
                            },
                            {
                                "example_id": "7af8090e-7916-4cac-b555-6228e6d7460e",
                                "sense_id": "7ff994e3-e1da-3c3d-802e-a5dfc8d16102",
                                "text": "„Die Nachschau ist ein Kontrollinstrument der Finanzverwaltung von teilweise größerer Eingriffsintensität als die Betriebsprüfung, weil der prozeduale Grundrechtsschutz schon im Ansatz geringer ausgestaltet ist.“"
                            },
                            {
                                "example_id": "4c8b418d-fd88-4626-8003-a9d8012a70b4",
                                "sense_id": "7ff994e3-e1da-3c3d-802e-a5dfc8d16102",
                                "text": "„Der Erlaubnisinhaber sollte einen schriftlichen Vermerk über die Nachschau anfertigen mit Datum, Namen der Behördenmitarbeiter, Zeitdauer der Nachschau, Namen anwesender Zeugen sowie dem Ergebnis.“"
                            },
                            {
                                "example_id": "fbc166c1-a131-4992-a121-1950f5ea91a8",
                                "sense_id": "7ff994e3-e1da-3c3d-802e-a5dfc8d16102",
                                "text": "Die Revision der Akten ergab, dass die geforderte interne Nachschau rechtens war und der Einspruch termingerecht eingegangen ist."
                            }
                        ],
