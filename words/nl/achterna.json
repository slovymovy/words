                    "semantic_group_id": "nastreven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is bewonderenswaardig dat zij eindelijk haar grote droom <w>achterna</w> gaat.",
                            "target_lang_translations": {
                                "en": "It is admirable that she is finally going <w>after</w> her big dream.",
                                "ru": "Заслуживает восхищения то, что она наконец-то идет <w>вслед за</w> своей большой мечтой."
                            }
                        },
                        {
                            "text": "Hij besloot zijn hart <w>achterna</w> te gaan en verhuisde naar het buitenland.",
                            "target_lang_translations": {
                                "en": "He decided to <w>follow</w> his heart and moved abroad.",
                                "ru": "Он решил последовать <w>вслед за</w> своим сердцем и переехал за границу."
                            }
                        }
                    ],
                    "synonyms": [
