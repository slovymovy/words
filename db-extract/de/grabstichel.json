                "senses": [
                    {
                        "sense_id": "796cabaa-b7d8-30cd-b4d3-8ba607fdd7c4",
                        "entry_id": "3c29fd73-9b59-39e0-81db-4f6955383dc6",
                        "glosses": [
                            "ein kleiner Meißel zur Bearbeitung von Metall, der nicht mit dem Hammer, sondern nur mit der Hand geführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2433196-cd8c-42ed-83f2-2cceac666cc9",
                                "sense_id": "796cabaa-b7d8-30cd-b4d3-8ba607fdd7c4",
                                "text": "Mit dem Grabstichel wird unter dem Druck der Hand, das Metall als Span ausgehoben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83def567-b8e1-326b-8495-14ddbbdd10c9",
                        "entry_id": "3c29fd73-9b59-39e0-81db-4f6955383dc6",
                        "glosses": [
                            "ein Sternbild des Südhimmels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff78425-e7b3-4799-acb7-5387060a92d7",
                                "sense_id": "83def567-b8e1-326b-8495-14ddbbdd10c9",
                                "text": "Grabstichel ist ein sehr unauffälliges Sternbild in einem sternenarmen Gebiet des südlichen Himmels."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a57d02f-24ea-4c92-966b-59c2f64bcba9",
                        "source_entry_id": "3c29fd73-9b59-39e0-81db-4f6955383dc6",
                        "source_sense_id": "796cabaa-b7d8-30cd-b4d3-8ba607fdd7c4",
                        "target_lang_word": "burin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b44fef84-df25-31b5-b5a0-02a066110e31",
                                        "entry_id": "238f9d5f-d5b2-3793-a46c-ec8c5819f625",
                                        "glosses": [
                                            "A chisel with a sharp point, used for engraving; a graver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74835253-f6dc-4535-a1e0-a9359f5dabb8",
                                                "sense_id": "b44fef84-df25-31b5-b5a0-02a066110e31",
                                                "text": "I kept staring at the same wallpaper on the same wall; I stared at it so often that every line of its zigzag pattern has etched itself on the innermost folds of my brain as if with an engraver’s burin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db305d3a-854f-3d81-a193-96e8cca2403e",
                                        "entry_id": "238f9d5f-d5b2-3793-a46c-ec8c5819f625",
                                        "glosses": [
                                            "A prehistoric flint tool"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c5cd704-ebea-4721-a4cc-c78c0e4a5d2a",
                        "source_entry_id": "3c29fd73-9b59-39e0-81db-4f6955383dc6",
                        "source_sense_id": "796cabaa-b7d8-30cd-b4d3-8ba607fdd7c4",
                        "target_lang_word": "burin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dedae32-9526-3468-9ae4-e9c1fd52c569",
                                        "entry_id": "35aede10-5b0d-3f51-8314-c3ec880b8304",
                                        "glosses": [
                                            "Outil en forme de ciseau d’acier que l’on pousse à la main et qui sert à graver, à couper les métaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c58965fc-a80b-4f0d-8712-2c8decb079d5",
                                                "sense_id": "0dedae32-9526-3468-9ae4-e9c1fd52c569",
                                                "text": "L'ancienne taille en fil, qui champlevait péniblement ses blancs dans le poirier, a cédé la place au travail plus net qui creuse dans le bout de buis des lignes où le burin n'a plus à craindre les éclats des fibres lamelleuses."
                                            },
                                            {
                                                "example_id": "a99bcfd3-73f4-4358-baf2-24288e1145f2",
                                                "sense_id": "0dedae32-9526-3468-9ae4-e9c1fd52c569",
                                                "text": "Ah ! si j’osais attaquer le bois directement avec le burin, sans me refroidir à le dessiner d’abord ! Je n’indique d’ailleurs au crayon que l’ébauche, le burin peut ensuite avoir des trouvailles, des énergies et des finesses inattendues."
                                            },
                                            {
                                                "example_id": "ea2de555-7d7c-4f02-a56e-e108b813b42c",
                                                "sense_id": "0dedae32-9526-3468-9ae4-e9c1fd52c569",
                                                "text": "Ce n’est pas sans mélancolie que j’ai revu récemment les outils d’un de mes grands-pères : des burins par dizaines, des perloirs, des traçoirs, des grattoirs, des rifloirs, des outils à « chairrer », c’est-à-dire à donner le grain de la chair et toutes sortes de marteaux à tête ronde, finement emmanchés."
                                            },
                                            {
                                                "example_id": "bcac105c-d071-44e3-8daf-cbee6122d943",
                                                "sense_id": "0dedae32-9526-3468-9ae4-e9c1fd52c569",
                                                "text": "Il y a bien longtemps que les petits marteaux ne sonnent plus clair sur les burins des orfèvres et des ciseleurs dans le Marais et le Faubourg."
                                            },
                                            {
                                                "example_id": "59051298-81ed-43cd-9aed-5e926ffcb6f5",
                                                "sense_id": "0dedae32-9526-3468-9ae4-e9c1fd52c569",
                                                "text": "Ce gisement de plein air avait été initialement considéré comme aurignacien (Bodechon, 1982 ; Bel, 1991) sur la base d’une industrie lithique associant burins carénés et produits lamellaires, en particulier des lamelles torses à retouche abrupte directe fortement latéralisée (Le Brun-Ricalens et Brou, 2003)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0b8590-9bc3-35c2-92a7-e5d7bd495a3d",
                                        "entry_id": "35aede10-5b0d-3f51-8314-c3ec880b8304",
                                        "glosses": [
                                            "Outil de maçon ou de mécanicien, à lame plate, que l'on frappe avec un maillet ou un marteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ac6600-a8a9-4f6e-a308-26354e5f755b",
                                                "sense_id": "ba0b8590-9bc3-35c2-92a7-e5d7bd495a3d",
                                                "text": "On attaquerait la roche à la masse afin d'épargner les burins, car il n'y avait pas de forge pour les recharger. Cette façon de procéder ménagerait également la dynamite, car il fallait aussi craindre le pouillant qui asphyxie."
                                            },
                                            {
                                                "example_id": "831a1fe2-8af5-4da5-853f-615fbf9cc890",
                                                "sense_id": "ba0b8590-9bc3-35c2-92a7-e5d7bd495a3d",
                                                "text": "Un burin, c’est un ciseau grossier."
                                            },
                                            {
                                                "example_id": "b8223a3a-e3d9-4881-a980-dff6e180ff1a",
                                                "sense_id": "ba0b8590-9bc3-35c2-92a7-e5d7bd495a3d",
                                                "text": "L’outillage du mineur (burin, coin, pointerolle, pic, masse) devait être entretenu quotidiennement pour conserver son efficacité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71010032-c2e1-312f-81c1-d3759f4633b5",
                                        "entry_id": "35aede10-5b0d-3f51-8314-c3ec880b8304",
                                        "glosses": [
                                            "Gravure effectuée en utilisant la technique du burin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ef8f6c-72f2-429a-9fa8-511f2861d5fb",
                                                "sense_id": "71010032-c2e1-312f-81c1-d3759f4633b5",
                                                "text": "Livre du XIXᵉ siècle illustré de burins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c164bac8-67c2-32db-98bd-971d066177e8",
                                        "entry_id": "35aede10-5b0d-3f51-8314-c3ec880b8304",
                                        "glosses": [
                                            "Instrument à extrémité biseautée tranchante, pour entailler l’os."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29189ce4-f20b-355d-ae4c-f8402218f8a2",
                                        "entry_id": "35aede10-5b0d-3f51-8314-c3ec880b8304",
                                        "glosses": [
                                            "Meuble représentant l’outil de sculpteur du même nom dans les armoiries. À rapprocher de ciseau à bois et ciseau de sculpteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5763f7-7d74-4be7-adee-bcddf7df6239",
                                                "sense_id": "29189ce4-f20b-355d-ae4c-f8402218f8a2",
                                                "text": "D’argent à la fasce ondée d’azur accompagnée en chef d’un R de gueules à la jambe barrée d’un S et en pointe d’un maillet et d’un burin du même passés en sautoir, qui est de la commune de Riviera du Tessin en Suisse → voir illustration « armoiries avec un burin »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
