                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c6ff7d1-25fb-33ee-a714-5d7fb8176218",
                        "entry_id": "f61e5319-3970-3cd7-ae19-ad94c62e6f0b",
                        "glosses": [
                            "farbloser, ölig-flüssiger Reinstoff, der in der Arzneimittel-, Farb- und Kunststoffproduktion von Bedeutung ist"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "c50bd3b5-448d-4445-8aba-24e4b26c4611",
                                "sense_id": "5c6ff7d1-25fb-33ee-a714-5d7fb8176218",
                                "text": "„‚Der Deutsche kommt von seinen Universitäten, wie er einst aus seinen Wäldern getreten ist.‘ Radiographie und Präzisionsmaschinen und chemische Fabriken und Anilin und Diesel-Motoren — aber für den Franzosen haftet dem Deutschen etwas von einer ‚brute‘ an — einem unbehauenen Stamm.“"
                            },
                            {
                                "example_id": "67718603-7a90-4c58-9ec4-3907cc52422b",
                                "sense_id": "5c6ff7d1-25fb-33ee-a714-5d7fb8176218",
                                "text": "„Ich wußte sehr wenig über die Eigenschaften des Anilins; aber es war zu spät, darüber nachzudenken.“"
                            },
                            {
                                "example_id": "0044a9e8-35cc-4605-a61a-741496f1e8fb",
                                "sense_id": "5c6ff7d1-25fb-33ee-a714-5d7fb8176218",
                                "text": "„Anilin steht auch im Verdacht, dass es Krebs auslösen oder genetische Defekte verursachen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48ef8833-bf1d-4de7-9a3a-a0dde7a9ba8d",
                        "source_entry_id": "f61e5319-3970-3cd7-ae19-ad94c62e6f0b",
