            "senses": [
                {
                    "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                    "sense_definition": "Eine Bemühung, einen Kampf oder ein Vorhaben vorzeitig beenden; den Widerstand einstellen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "abbrechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trotz aller Schwierigkeiten wollte die Sportlerin das Rennen nicht <w>aufgeben</w>."
                        },
                        {
                            "text": "Er verlor den Mut und <w>gab</w> kurz vor dem Ziel <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "kapitulieren",
                        "aufhören",
                        "aufstecken"
                    ],
                    "antonyms": [
                        "weitermachen",
                        "fortsetzen"
                    ],
                    "common_phrases": [
                        "niemals aufgeben",
                        "den Kampf aufgeben",
                        "vorzeitig aufgeben"
                    ]
                },
                {
                    "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                    "sense_definition": "Jemandem etwas zur Erledigung oder Lösung auftragen; zur Pflicht machen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "auftragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Lehrer <w>gibt</w> den Schülern über das Wochenende viele Hausaufgaben <w>auf</w>."
                        },
                        {
                            "text": "Dieses seltsame Verhalten der Maschine <w>gab</w> den Experten große Rätsel <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "beauftragen"
                    ],
                    "antonyms": [
                        "aufhaben"
                    ],
                    "common_phrases": [
                        "Hausaufgaben aufgeben",
                        "Rätsel aufgeben"
                    ]
                },
                {
                    "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                    "sense_definition": "Etwas zur Beförderung, Veröffentlichung oder Bearbeitung einreichen oder übergeben.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "einreichen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor ihrer Abreise wollte sie noch schnell ein Paket bei der Post <w>aufgeben</w>."
                        },
                        {
                            "text": "Das Unternehmen will nächste Woche eine Anzeige in der Zeitung <w>aufgeben</w>."
                        }
                    ],
                    "synonyms": [
                        "einliefern",
                        "abgeben"
                    ],
                    "antonyms": [
                        "annehmen",
                        "entgegennehmen"
                    ],
                    "common_phrases": [
                        "eine Anzeige aufgeben",
                        "ein Paket aufgeben",
                        "eine Bestellung aufgeben"
                    ]
                },
                {
                    "sense_id": "a8f7c929-cbdb-3bcd-a79e-4e759dcb929a",
                    "sense_definition": "Die Hoffnung auf Rettung oder Genesung von jemandem verlieren und die Person als verloren betrachten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ärzte hatten den schwer verletzten Patienten bereits fast <w>aufgegeben</w>."
                        },
                        {
                            "text": "Obwohl die Lage aussichtslos schien, wollte die Familie ihre Tochter noch nicht <w>aufgeben</w>."
                        }
                    ],
                    "synonyms": [
                        "abschreiben"
                    ],
                    "common_phrases": [
                        "einen Patienten aufgeben",
                        "die Hoffnung aufgeben"
                    ]
                },
                {
                    "sense_id": "11ad95fd-69a8-3b37-87d8-98c41312cebd",
                    "sense_definition": "Einen Ort, eine Stellung oder ein Eigentum räumen und verlassen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verlassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen des drohenden Hochwassers mussten die Bewohner das Dorf vollständig <w>aufgeben</w>."
                        },
                        {
                            "text": "Die Soldaten waren gezwungen, ihre vorderste Stellung nach schweren Angriffen <w>aufzugeben</w>."
                        }
                    ],
                    "common_phrases": [
                        "eine Stellung aufgeben",
                        "einen Standort aufgeben"
                    ]
