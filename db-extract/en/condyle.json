                                "target_senses": [
                                    {
                                        "sense_id": "44669e73-a886-38d2-8453-458a5a58db1d",
                                        "entry_id": "0e3cab4b-ba25-3fed-865a-4378293e3e5a",
                                        "glosses": [
                                            "bewegliche Verbindung von Knochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b105dd2e-097b-46bd-94e6-0a8b4788c23f",
                                                "sense_id": "44669e73-a886-38d2-8453-458a5a58db1d",
                                                "text": "„Das größte Gelenk des Menschen kann kurzfristig sogar bis zu eineinhalb Tonnen Gewicht tragen. Ohne unsere Kniegelenke könnten wir weder gehen, noch uns hinsetzen und schon gar nicht umherhüpfen. Damit wir all diese Bewegungen ausführen können, besteht das Kniegelenk aus einem ausgeklügelten System von Knochen, Bändern, Muskeln und Knorpel. Das Kniegelenk wird deshalb auch - zu recht - als das komplizierteste Gelenk im ganzen Körper bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5700941-bb42-38b2-ba5c-939ee9c16ad8",
                                        "entry_id": "0e3cab4b-ba25-3fed-865a-4378293e3e5a",
                                        "glosses": [
                                            "bewegliche Verbindung von zwei mechanischen Bauteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc548aac-db11-4b78-bb63-4e1537254697",
                                                "sense_id": "c5700941-bb42-38b2-ba5c-939ee9c16ad8",
                                                "text": "Er kontrollierte die Unversehrtheit der Gelenke der Antriebswellen."
                                            },
                                            {
                                                "example_id": "721fbb5a-0843-4c19-8e7d-490b431c24fb",
                                                "sense_id": "c5700941-bb42-38b2-ba5c-939ee9c16ad8",
                                                "text": "„Die Männer fingerten zwischen den Gelenken der Puppe herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
