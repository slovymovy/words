                    },
                    {
                        "translation_id": "b19859f9-e65b-43c0-99d0-e639cc91f812",
                        "source_entry_id": "fccacf7f-89f3-35e5-bcdb-69f9fd20d1d2",
                        "source_sense_id": "dddeba08-45d5-387c-a420-285813cbc38f",
                        "source_sense_description": "to refill with fuel",
                        "target_lang_word": "faire le plein",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faire le plein",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                        "entry_id": "476578ca-5f59-348d-940f-33524686d85f",
                                        "glosses": [
                                            "Remplir un réservoir (le plus souvent le carburant d’un véhicule)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25077100-93bc-4af7-b524-75b96d98c0f4",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "En début de mois, les gens font toujours le plein sans réfléchir. Là, beaucoup serrent les dents, ne dépassent pas des montants ronds, 30, 40 ou 50, comme pour tenir leur budget, comme si c’était déjà la fin du mois."
                                            },
                                            {
                                                "example_id": "d6487e3d-aa9a-4673-9c3b-d5a7b9810c77",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "Rynner voudrait bien voir revenir le second camion-citerne qui est parti, voilà déjà déjà un bon moment, pour faire le plein au riachuelo voisin."
                                            },
                                            {
                                                "example_id": "3bfdaf95-5af8-4911-8ecf-57b37365435c",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "Quand des Alsaciens ou des Mosellans se précipitaient dans le Bade-Wurtemberg, la Sarre ou la Rhénanie-Palatinat pour faire le plein, chercher du tabac ou acheter des produits d’hygiène…"
                                            },
                                            {
                                                "example_id": "bacab979-8bc1-4ab6-9808-f8b8ad738f73",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "Si la foudre tombe sur une voiture électrique, est-ce que ça fait le plein?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56296d82-207b-3991-8ec3-6029146a8b29",
                                        "entry_id": "476578ca-5f59-348d-940f-33524686d85f",
                                        "glosses": [
                                            "Acheter de la nourriture ou une autre denrée, en grande quantité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63868f30-c47d-4165-9550-0e3d11a44f2b",
                                                "sense_id": "56296d82-207b-3991-8ec3-6029146a8b29",
                                                "text": "Il a fait le plein de bière et de cigarettes pour la soirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5630c5d7-becd-385d-b6e5-0e1058ff8d70",
                                        "entry_id": "476578ca-5f59-348d-940f-33524686d85f",
                                        "glosses": [
                                            "Remplir une salle de spectacle, ce qui prouve son succès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d5f265-3e71-4700-8823-055a59a8e046",
                                                "sense_id": "5630c5d7-becd-385d-b6e5-0e1058ff8d70",
                                                "text": "A la première Toussaint, les chers défunts font toujours le plein. Ensuite, le temps fait son boulot."
                                            },
                                            {
                                                "example_id": "ca0d4747-7e52-4179-94b3-fbec293afc2e",
                                                "sense_id": "5630c5d7-becd-385d-b6e5-0e1058ff8d70",
                                                "text": "En ce deuxième dimanche d’août, la rue principale d’Auvers-sur-Oise (Val-d’Oise) est inhabituellement calme. Sous le ciel menaçant, les terrasses des restaurants peinent à faire le plein. Les touristes, qui se pressent d’ordinaire par milliers pour découvrir le village où vécut Vincent Van Gogh, ne sont pas encore revenus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b0e4018-0320-412b-9a3a-ec375043aed3",
                        "source_entry_id": "fccacf7f-89f3-35e5-bcdb-69f9fd20d1d2",
                        "source_sense_id": "dddeba08-45d5-387c-a420-285813cbc38f",
                        "source_sense_description": "to refill with fuel",
                        "target_lang_word": "ravitailler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravitailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "Pourvoir de vivres et de munitions une place, une flotte, une armée, une troupe qui en était démunie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d62ac8f-256f-4257-802e-ec552492edc8",
                                                "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                                "text": "Sacramoro Visconti, qu’il avait laissé à Milan avec cent hommes d’armes, fit arborer sur les murs les étendards de France, et permit de ravitailler le château, toujours occupé par les Français."
                                            },
                                            {
                                                "example_id": "93e55766-80f2-4a83-a0ef-17d0c870a157",
                                                "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                                "text": "Par là il entendait la plaine alluviale d’Attigny aussi bien que le grenier à blé situé entre Vouziers et le pied des Monts de Champagne, du côté de Grivy-Loisy qui ravitaillait en grains le marché de Charleville."
                                            },
                                            {
                                                "example_id": "b5c92fca-34af-443d-a52f-876329a98440",
                                                "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                                "text": "Au fond de la pièce, le barman mélomane refait le plein de son distributeur de cacahuètes et essuie une dernière fois le comptoir, après avoir ravitaillé le présentoir d'œufs durs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f4d087-bc17-3c4e-a4ea-921fbaae595b",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "D'autre part, Wynmalen a dû s'arrêter à Launois-sur-Vence pour être ravitaillé, puis dut atterrir de nouveau à Montigny sur route, à dix kilomètres de Metz. Il ne repartira que ce matin. — (Le Circuit européen - La première étape : Paris-Liège, dans L'Aurore : littéraire, artistique, sociale, 15ᵉ année, n° 4966 du lundi 19 juin 1911, p. 2)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ebcd975-ab14-38a2-b9c7-dc608aa309ad",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "Faire des emplettes pour pourvoir à ses besoins."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e57969cc-3033-4cbd-848a-f6eaf96c3988",
                                                "sense_id": "2ebcd975-ab14-38a2-b9c7-dc608aa309ad",
                                                "text": "Il a fait des achats pour ravitailler sa maison de campagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "Se pourvoir de vivres, faire ses emplettes."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a840f430-9c88-45dc-9e21-35d0b3a8962d",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "À Ténériffe, le brick aborda pour se ravitailler et réparer son gouvernail."
                                            },
                                            {
                                                "example_id": "2b11708b-a3ca-4e1d-be1b-6e7ca96c3ee9",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "Les îles Galapagos, autrefois inhabitées, n’étaient alors visitées que par quelques baleiniers qui venaient s’y ravitailler en eau."
                                            },
                                            {
                                                "example_id": "e0090617-c222-4533-af37-c48161c56b92",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "On peut se ravitailler facilement à la ville voisine."
                                            },
                                            {
                                                "example_id": "d09b4ece-6c98-4261-83a5-2c7c540ea5d5",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "Se ravitailler en arguments, en idées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
