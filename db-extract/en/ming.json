                        "glosses": [
                            "To mix, blend, mingle."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0d75013e-67ba-426a-b428-98fe896367c7",
                                "sense_id": "9c481074-2778-31ae-ae94-dd74d126f2f2",
                                "text": "I founde here and there litle peces of marquesites and stones, menged with copper, but I could by no sense or wit perceyue, that the bathes had any notable qualitie thereof."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc5cdaf6-35c1-32e2-a93f-3593cec93a33",
                        "entry_id": "daf2d5fe-1df5-3e8b-8222-1726d68e4b8d",
                        "glosses": [
