                ],
                "senses": [
                    {
                        "sense_id": "aad1e736-74ec-3801-93f9-183b8e45d9c6",
                        "entry_id": "cc7ef64f-d558-319f-a4ff-e6fa319633b8",
                        "glosses": [
                            "sehr lang andauernder Schlaf; anhaltend unveränderter, verborgener Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6484cd0-f615-46f6-a356-c35c0362ac25",
                                "sense_id": "aad1e736-74ec-3801-93f9-183b8e45d9c6",
                                "text": "„Die Damen suchen alte Musterkarten, Raritäten, die auf Dachböden, in aufgelassenen Produktionsstätten oder sonst wo im Dornröschenschlaf liegen, oft auch Kontakte zu Produzenten.“"
                            },
                            {
                                "example_id": "dba8eb52-d5aa-434f-a468-4af4e893e010",
                                "sense_id": "aad1e736-74ec-3801-93f9-183b8e45d9c6",
                                "text": "„Danach verfiel die Bibliothek in einen Jahrzehnte dauernden Dornröschenschlaf, was vor allem daran lag, daß der Hof 1753 ins nahe Braunschweig gezogen und die Hälfte der Bevölkerung abgewandert war.“"
                            },
                            {
                                "example_id": "8b84780f-8efd-413f-81f2-516b543108bc",
                                "sense_id": "aad1e736-74ec-3801-93f9-183b8e45d9c6",
                                "text": "„Wir wissen also, dass die heilige Sprache, die der Gott Thot den ägyptischen Weisen geschenkt hat, mehr als viertausend Jahre benützt wurde, bevor sie in einen tiefen Dornröschenschlaf fiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
