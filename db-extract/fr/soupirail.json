                    {
                        "translation_id": "f26d0506-5492-42bd-a2e5-a20de1248b1d",
                        "source_entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                        "target_lang_word": "keldergat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keldergat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "258f2abc-d7d0-37d6-bf9f-73c7498cb470",
                                        "entry_id": "b22d0f25-b9ea-3258-bc1b-1f7f5cb42b13",
                                        "glosses": [
                                            "een gat in een muur of vloer dat toegang geeft tot de kelder(trap)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3f24ddd-8c78-499c-afa2-e4478d88da35",
                                                "sense_id": "258f2abc-d7d0-37d6-bf9f-73c7498cb470",
                                                "text": "Een 54-jarige koordirigent uit Vriezenveen is maandagavond zwaargewond geraakt nadat hij achterwaarts in een keldergat was gevallen."
                                            },
                                            {
                                                "example_id": "f889ec45-ca1d-4d50-8f1e-c551605fd589",
                                                "sense_id": "258f2abc-d7d0-37d6-bf9f-73c7498cb470",
                                                "text": "Hoeveel mensen zouden er al voorover in het keldergat zijn getuimeld omdat de milieuvriendelijke spaarlamp boven de keldertrap niet op tijd aansprong? Op het knopje gedrukt, gelijk al de eerste stap gezet, en te laat gemerkt dat het donker bleef. Hoeveel mensen zouden al hebben vastgesteld dat hun milieuvriendelijke spaarlamp niet, zoals beloofd, zeven keer zeven maanden meegaat, maar vaak niet meer dan zeven weken?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ac9c090-cfb3-45e0-bb24-3f38cbf4777c",
                        "source_entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                        "target_lang_word": "kelderraam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kelderraam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c5fd6ff2-6748-384d-9622-4590bba36666",
                                        "entry_id": "ecce5c53-6bbf-3797-9b5f-e992533a6ce8",
                                        "glosses": [
                                            "raam van een kelder dat zicht geeft op de buitenlucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44e173d-6c51-4b39-851b-d04395e9f3e0",
                                                "sense_id": "c5fd6ff2-6748-384d-9622-4590bba36666",
                                                "text": "Hij klom door een kelderraam naar buiten, liet zijn jas schuieren en vroeg waar hij was."
                                            },
                                            {
                                                "example_id": "a83870fe-1465-4c78-b9da-38a430ced0c1",
                                                "sense_id": "c5fd6ff2-6748-384d-9622-4590bba36666",
                                                "text": "Van de Roer had al twijfels toen Zijlstra over de ontmoeting met Poetin sprak op een partijcongres in 2016. \"De eerste keer dat ik dit verhaal hoorde, dacht ik al, who the hell is Halbe Zijlstra, dat hij daarbij was? Was hij door een kelderraam naar binnen gekropen? Hij hangt nu een beetje de havik uit tegenover Rusland, alsof hij Poetin al jaren door heeft. Van die stoere grootspraak heb ik in de nasleep van het MH17-drama niets gemerkt: daar heeft Zijlstra zich als een volgzame duif van het slappe Nederland gedragen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
