                {
                    "sense_id": "70cd0249-137d-376d-9941-8833dc0a0f70",
                    "sense_definition": "De fysieke plaats waarvandaan men naar iets kijkt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanaf dit hoge <w>standpunt</w> heb je een prachtig uitzicht over de stad.",
                            "target_lang_translations": {
                                "en": "From this high <w>vantage point</w> you have a beautiful view over the city.",
                                "ru": "С этой высокой <w>точки обзора</w> открывается прекрасный вид на город.",
                                "zh": "从这个高处的<w>观察点</w>，你可以俯瞰城市的美景。"
                            }
                        },
                        {
                            "text": "De fotograaf koos een laag <w>standpunt</w> om het gebouw groter te laten lijken.",
                            "target_lang_translations": {
                                "en": "The photographer chose a low <w>viewpoint</w> to make the building seem larger.",
                                "ru": "Фотограф выбрал низкую <w>точку съемки</w>, чтобы здание казалось больше.",
                                "zh": "摄影师选择了一个较低的<w>视角</w>，使建筑物看起来更宏伟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gezichtspunt"
                    ],
                    "common_phrases": [
                        "vanuit een ander standpunt"
                    ],
                    "target_lang_definitions": {
                        "en": "The physical place from which one looks at something.",
                        "ru": "Физическое место, откуда открывается вид на что-либо.",
                        "zh": "观察事物的物理位置或角度。"
                    },
