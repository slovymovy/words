                    {
                        "translation_id": "efe4370d-baf8-4767-921e-f096eabd0028",
                        "source_entry_id": "3d38b35f-4fe2-341c-b2bc-b110318aadd5",
                        "source_sense_description": "facility that melts metals",
                        "target_lang_word": "fonderie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fonderie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59750ea8-57d2-304f-af47-f53b15996feb",
                                        "entry_id": "dc4251f3-0c0f-39b9-915a-cf8963d0d3f7",
                                        "glosses": [
                                            "Art et technique consistant à fondre un métal et à le couler dans un moule pour fabriquer des pièces ou des objets."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607c5bde-d932-4a5a-9373-132ae3053ac3",
                                                "sense_id": "59750ea8-57d2-304f-af47-f53b15996feb",
                                                "text": "Afin d’améliorer encore les caractéristiques (de fluage notamment), plusieurs procédés de fonderie sont possibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf4aa09-8058-31cd-a7fd-1ed6948b7408",
                                        "entry_id": "dc4251f3-0c0f-39b9-915a-cf8963d0d3f7",
                                        "glosses": [
                                            "Atelier ou établissement industriel où l’on fabrique des pièces par coulée de métal en fusion."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b939e1a-a013-4017-b688-cfd4e8f5c4e7",
                                                "sense_id": "5cf4aa09-8058-31cd-a7fd-1ed6948b7408",
                                                "text": "Une fonderie de canons. - Une fonderie de caractères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a245354b-d501-34c1-bbb1-ffd5dff55ab6",
                                        "entry_id": "dc4251f3-0c0f-39b9-915a-cf8963d0d3f7",
                                        "glosses": [
                                            "Établissement où l’on fond et où l’on purifie le métal tiré d’une mine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9e943dd-0619-4ab0-80e2-b61e6894943a",
                                                "sense_id": "a245354b-d501-34c1-bbb1-ffd5dff55ab6",
                                                "text": "Quand il pousse la porte du Café du Pont, à Vrigne-aux-Bois, la tante est derrière le comptoir. Le café est à elle. C'est elle qui a fait dire qu'il n'avait qu'à venir. Que dans les fonderies, il y avait du travail tant qu'on en voulait. Suffisait d'être courageux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05340754-a8fb-34e0-b6a2-63b853d66655",
                                        "entry_id": "dc4251f3-0c0f-39b9-915a-cf8963d0d3f7",
                                        "glosses": [
                                            "Lieu où l’on fond la cire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e01b67db-e97b-4c8c-849b-f911f8e7df35",
                        "source_entry_id": "3d38b35f-4fe2-341c-b2bc-b110318aadd5",
                        "source_sense_description": "facility that melts metals",
                        "target_lang_word": "Gießerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gießerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                        "entry_id": "66f481fe-8697-31e0-9b70-d258063ea34a",
                                        "glosses": [
                                            "eine (Teil-)Fabrik, in der Rohlinge aus zuvor geschmolzenen Materialien (Metall, Glas) für die Fertigung produziert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1a63db-c217-4759-a49d-38cac0d73907",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "Da die Firma ihre Gießerei ausgliederte, kann sie nicht mehr so schnell auf Probleme reagieren."
                                            },
                                            {
                                                "example_id": "4cc3debc-f555-46db-b618-7f312e5b1dc4",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "„Der Insolvenzverwalter möchte die Stilllegung der Gießerei verhindern.“"
                                            },
                                            {
                                                "example_id": "01c8e111-bbd8-4cfe-9fd4-fa5a53e1dea5",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "„Es beginnt aber im eigentlichen Sinne 1829, als Friedrich Nies eine Buchdruckerei gründete, der er 1830 eine Gießerei anfügte.“"
                                            },
                                            {
                                                "example_id": "6b378a26-717b-412a-ada0-1684e649c23d",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "Im 19. Jahrhundert gab es in unserer Stadt mehrere Gießereien."
                                            },
                                            {
                                                "example_id": "d9be7aea-aacd-4649-85bd-5b84e9056376",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "„Drucker kauften ihre Typensätze bei einer Handvoll Gießereien in ganz Europa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
