                                "target_senses": [
                                    {
                                        "sense_id": "5d601bb9-fbed-3b8a-af20-3b55e2e406b9",
                                        "entry_id": "891ccf19-478b-37a0-bf53-7b6159025e5f",
                                        "glosses": [
                                            "veraltet (19. Jahrhundert) für Extremismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f224bed7-6707-4404-a97c-4751d6752e7f",
                                                "sense_id": "5d601bb9-fbed-3b8a-af20-3b55e2e406b9",
                                                "text": "Die deutsche Vormärzliberalen sprachen […] oft von den „Ultras“ beider Seiten. Deren Gemeinsamkeit wurde mit der superlativischen Wendung „Ultraismus“ auf den Begriff gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74889d47-2ffa-3cc3-a73d-8d0f05528c25",
                                        "entry_id": "891ccf19-478b-37a0-bf53-7b6159025e5f",
                                        "glosses": [
                                            "spanische Kunstrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8583a2c2-b2a6-42ce-b8d6-431fa3e84676",
                                                "sense_id": "74889d47-2ffa-3cc3-a73d-8d0f05528c25",
                                                "text": "Das beweist er an den Gewaltphantasien und -manifesten des Futurismus, des Dadaismus, des Surrealismus und erstmals auch an denen des spanischen Ultraismus und des englischen Vortizismus. - (Die Welt, zitiert nach Wortschatz-Lexikon)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55fbaffb-cb4d-4037-be04-9e712314941a",
                        "source_entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                        "source_sense_description": "Spanish poetic movement",
                        "target_lang_word": "ultraismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cf5d050b-949e-4562-8faa-bca1e621f914",
                        "source_entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                        "source_sense_description": "Spanish poetic movement",
                        "target_lang_word": "ultraísmo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraísmo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1267e0-8ebe-3fec-a641-44cc8b5d74b1",
                                        "entry_id": "f3d10cbb-258f-3d6f-8e4f-713608f55a28",
                                        "glosses": [
                                            "Movimiento literario de vanguardia, activo en las segunda y tercera décadas del siglo XX, caracterizado por el abandono del sentimentalismo, el preciosismo modernista y de la rima, y el énfasis en una imaginería sugestiva y moderna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4da1c75-042e-4c4e-9326-dce4d8d1ccd3",
                                                "sense_id": "0d1267e0-8ebe-3fec-a641-44cc8b5d74b1",
                                                "text": "El ‘ultraísmo’ es uno de los nombres más certeros que se han forjado para denominar la nueva sensibilidad. Son sentimientos específicamente estéticos."
                                            },
                                            {
                                                "example_id": "54b82219-de43-4922-9474-5890bc22173f",
                                                "sense_id": "0d1267e0-8ebe-3fec-a641-44cc8b5d74b1",
                                                "text": "Cuando andaba con Verhaeren, 1913-15, se ponía la poesía del arrugado belga bigotudo, como una esfera de cristal, en la punta de los dedos enguantados de blanco y jugaba con ella al sol del mediodía madrileño por el campo de tenis. Me parecía un señorito vizcaíno malabar, verde de norte, ocre de sur; como un olmo, un pino, que perdía su tiempo, sin quitarse el sombrero duro, los botines tiesos ni la bufanda repetida, luchando entre el gris simbolismo francés y el rojo ultraísmo español (ya en la atmósfera)."
                                            },
                                            {
                                                "example_id": "c5a4e791-d9e8-4148-ae90-ca7d2f61a00b",
                                                "sense_id": "0d1267e0-8ebe-3fec-a641-44cc8b5d74b1",
                                                "text": "te vuelvo a repetir, no peyorativamente ni mucho menos, que Borges es el único, en idioma español, que mamó el expresionismo, que convivió con el nacimiento del dadaísmo ‘en su mera mata’ y naturalmente fue de los fundadores del ultraísmo aquí y en Buenos Aires, aunque luego se divierta en borrar pistas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
