                        "sense_id": "53f5752d-d48b-36c1-9f5f-0250ad80c803",
                        "entry_id": "212cfd0f-df8b-3889-b577-f02684bca349",
                        "glosses": [
                            "Qui spolie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a20728ee-992d-47bb-8216-15c44425b880",
                                "sense_id": "53f5752d-d48b-36c1-9f5f-0250ad80c803",
                                "text": "Un acte spoliateur. Une mesure spoliatrice."
                            },
                            {
                                "example_id": "5842cab7-6b2c-4eb8-9afe-b624ffb102f8",
                                "sense_id": "53f5752d-d48b-36c1-9f5f-0250ad80c803",
                                "text": "L’ingestion de métacercaires par un bovin déclenche la libération de douves immatures ou adolescarias qui migrent dans l’organisme de l’animal à travers le péritoine puis le foie (histophagie), avant d’atteindre les canaux biliaires et de devenir adultes (pouvoir irritatif et spoliateur : hématophagie)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "31380507-a7a2-32fa-ace8-64d94c496f90",
