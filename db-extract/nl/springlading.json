                "senses": [
                    {
                        "sense_id": "b85cfbdc-80db-3ad0-a81a-194181b19126",
                        "entry_id": "559624c6-dc8b-3a89-a674-6f5c496f3b0c",
                        "glosses": [
                            "de springstof die in een explosief zit, of het explosief zelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6891e49-7642-4e42-9c65-14d679eae2b4",
                                "sense_id": "b85cfbdc-80db-3ad0-a81a-194181b19126",
                                "text": "Mijn gedachten dwalen af naar vragen als: Hoe kiezen walvissen namen voor elkaar? Voelt vliegen net als zwemmen? Lijden zij ook aan onbeantwoorde liefdes? En schreeuwen ze wanneer een harpoen met springlading bij hen binnendringt en afgaat? Natuurlijk doen ze dat."
                            },
                            {
                                "example_id": "e3c35b7f-9c0b-429e-82d5-f8669bd41d13",
                                "sense_id": "b85cfbdc-80db-3ad0-a81a-194181b19126",
                                "text": "Honderd jaar geleden ontstaken Britse soldaten 500 ton springlading onder de Duitse frontlinie in Heuvelland. ‘Kraterfront’ bracht zaterdag een ode aan de littekens."
                            },
                            {
                                "example_id": "59c1419a-2782-4b70-9f95-eaefd99689fe",
                                "sense_id": "b85cfbdc-80db-3ad0-a81a-194181b19126",
                                "text": "De bom, die op een bouwwerf werd gevonden, is volgens de Duitse explosievenopruimingsdienst momenteel niet gevaarlijk. Het onschadelijk maken van de springlading zal naar verwachting vier uur in beslag nemen."
                            }
                        ]
                    }
