                        ],
                        "form": "испуска́я"
                    },
                    {
                        "form_id": "0cbc4c1b-ad88-4163-b9c1-1f753a5f0443",
                        "entry_id": "e2c48325-6809-3e66-8d21-a80b7e783984",
                        "tags": [
                            "adverbial",
                            "participle",
