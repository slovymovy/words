                "senses": [
                    {
                        "sense_id": "f20c1538-a76c-30e0-9067-a2f4f90cb77c",
                        "entry_id": "f1b0f484-4a3c-3a4c-9235-5213eb5f2747",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2284bef8-c832-3762-8660-e3a9e99fa3f2",
                        "entry_id": "f1b0f484-4a3c-3a4c-9235-5213eb5f2747",
                        "glosses": [
                            "продажная женщина, проститутка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4913225d-d22c-44cf-a199-befcb53abe97",
                                "sense_id": "2284bef8-c832-3762-8660-e3a9e99fa3f2",
                                "text": "От этого-то большинство и предпочитает знаться с Кларами. Там неудача доказывает только, что у тебя недостало денег, а здесь — твоё достоинство на весах."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41bfa7e7-18d6-434c-8084-22ffa091cdea",
                        "source_entry_id": "f1b0f484-4a3c-3a4c-9235-5213eb5f2747",
                        "target_lang_word": "Clara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Clara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cbbc244-b7b5-3259-bf0f-02749c58e51e",
                                        "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c13b491-6522-4e7a-ab51-7c1990a83737",
                                                "sense_id": "7cbbc244-b7b5-3259-bf0f-02749c58e51e",
                                                "text": "But the fashion spreads deeper and wider; the village is infected and the village green; Amelias and Claras sweep your rooms and cook your dinners, gentle Sophias milk your cows, and if you ask a pretty smiling girl at a cottage door to tell you her name, the rosy lips lisp out Caroline."
                                            },
                                            {
                                                "example_id": "cb44efc4-1553-4529-8925-92d8926746e8",
                                                "sense_id": "7cbbc244-b7b5-3259-bf0f-02749c58e51e",
                                                "text": "My mother called me Clara. And everybody else called me Clara until I was fourteen years old. Then I got sick of it. Clara! Sounds like breaking glass. Did you ever stop to think of that, Frank? Say it fast and hit the C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3557af6a-b947-3a58-82f4-9f37c54f653e",
                                        "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                                        "glosses": [
                                            "A town in Pyrénées-Orientales department, France; named Clara-Villerach since 2017."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18d7df48-5662-3469-b733-eb9c1671b6a3",
                                        "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                                        "glosses": [
                                            "A town in County Offaly, Ireland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2107966e-a075-3eba-b073-691f07d1842f",
                                        "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                                        "glosses": [
                                            "An area of Taylor County, Florida, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a0f7c5a-fe48-3f70-b001-64e85abfcf1d",
                                        "entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                                        "glosses": [
                                            "An unincorporated community in Wayne County, Mississippi, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "372eee07-bda3-4f51-9684-6912a40b706b",
                        "source_entry_id": "f1b0f484-4a3c-3a4c-9235-5213eb5f2747",
                        "target_lang_word": "Clara",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Clara",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78d12e8c-ef6f-34c3-a7ea-7d5ab163d291",
                                        "entry_id": "6d175aa1-2ac1-3eb7-8626-d91e15cb1ba1",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9e8eb8-f8ac-448c-b854-89fe4fa5c03e",
                                                "sense_id": "78d12e8c-ef6f-34c3-a7ea-7d5ab163d291",
                                                "text": "„Sie sollen sehen, daß mir in Clara und in dir noch große Freude geblieben ist und daß ich weder so schwach noch so alt bin, mich von einem Unglück niederwerfen zu lassen.“"
                                            },
                                            {
                                                "example_id": "b0914194-3b12-4fda-9a37-0d616d850f47",
                                                "sense_id": "78d12e8c-ef6f-34c3-a7ea-7d5ab163d291",
                                                "text": "„Ich habe es aber etwas schlauer angestellt als Hans und Clara.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
