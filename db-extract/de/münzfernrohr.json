                "senses": [
                    {
                        "sense_id": "3b1de312-6ff5-36ae-a3f4-6ad4d038b119",
                        "entry_id": "ae5a13ee-9174-3db7-9933-f9eb62aa6af1",
                        "glosses": [
                            "in einem öffentlichen Bereich aufgestelltes Fernrohr, welches nach Bezahlung (Einwurf von Münzen) für einen kurzen Zeitraum benutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f61c7e-0e76-4566-9a34-136dbd1e8451",
                                "sense_id": "3b1de312-6ff5-36ae-a3f4-6ad4d038b119",
                                "text": "„Als Münzfernrohr könnte es seine Kosten schnell wieder einspielen, glaubt Bockholt. \"Wir brauchen 40 Besucher am Tag, die einen Euro bezahlen, um rentabel zu sein.\"“"
                            },
                            {
                                "example_id": "0914c44d-b9d0-4e61-8c4c-7925d7a092a2",
                                "sense_id": "3b1de312-6ff5-36ae-a3f4-6ad4d038b119",
                                "text": "„Pünktlich zu Beginn des Sommerhalbjahres stehen ab sofort zwei Münzfernrohre zur Verfügung, die es ermöglichen, den Blick noch weiter in die Ferne schweifen zu lassen.“"
                            },
                            {
                                "example_id": "a52540fa-a328-4ea2-8b3b-9ee85b32f945",
                                "sense_id": "3b1de312-6ff5-36ae-a3f4-6ad4d038b119",
                                "text": "„Ganz draußen weitet sich der Damm zu einer schattigen Piazza im See mit Café, mit Münzfernrohren, mit Münzautos und -raketen für die Kleinen und mit Rundbänken um die stattlichen Ahornbäume und Platanen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
