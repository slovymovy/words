{
    "word_family": [
        "cadeauter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f21c005-1146-37a4-9e1d-4012ff27322f",
                    "sense_definition": "Chose que l'on offre à quelqu'un sans rien attendre en retour, généralement pour faire plaisir ou célébrer un événement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "offrande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour son anniversaire, elle a reçu un magnifique <w>cadeau</w> de la part de ses parents."
                        },
                        {
                            "text": "Nous cherchons un beau <w>cadeau</w> à offrir à nos amis pour leur pendaison de crémaillère."
                        }
                    ],
                    "synonyms": [
                        "don",
                        "offrande",
                        "présent"
                    ],
                    "common_phrases": [
                        "faire un cadeau",
                        "cadeau d'anniversaire",
                        "cadeau de Noël",
                        "paquet cadeau"
                    ]
                },
                {
                    "sense_id": "deb95ba1-c756-3904-a4b5-384924f3ce80",
                    "sense_definition": "Par ironie, personne ou situation particulièrement désagréable, pénible ou embarrassante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devoir gérer ce client mécontent dès le lundi matin n'est vraiment pas un <w>cadeau</w>."
                        },
                        {
                            "text": "Ce nouveau logiciel plein d'erreurs est un <w>cadeau</w> empoisonné pour toute l'équipe technique."
                        }
                    ],
                    "common_phrases": [
                        "pas un cadeau",
                        "tu parles d'un cadeau",
                        "cadeau empoisonné"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé par antiphrase ou de manière ironique."
                        }
                    ]
                },
                {
                    "sense_id": "22b30959-55f2-3dc4-8814-85c023ddb55a",
                    "sense_definition": "Fête ou divertissement galant que l'on offrait principalement à des femmes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rejouissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marquis organisa un somptueux <w>cadeau</w> fait de musique et de danses champêtres pour plaire à la comtesse."
                        },
                        {
                            "text": "La dame accepta avec ravissement ce <w>cadeau</w> somptueux préparé à la campagne en son honneur."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Usage historique du dix-septième siècle."
                        }
                    ]
                },
                {
                    "sense_id": "4a447a12-21b6-31b1-bf17-d3f36e07e535",
                    "sense_definition": "Mandrin en fer sur lequel les armuriers façonnent ou liment certains orifices.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armurier a placé la pièce de fer sur le <w>cadeau</w> pour rectifier l'embouchoir du fusil."
                        },
                        {
                            "text": "Cet ancien <w>cadeau</w> en métal permettait d'ajuster soigneusement la grenadière de l'arme."
                        }
                    ]
                }
            ]
        }
    ]
}