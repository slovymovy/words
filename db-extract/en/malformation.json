                    {
                        "translation_id": "7c1c693e-dfb9-4cae-8633-550751205e32",
                        "source_entry_id": "a652a9b9-78fa-3524-a08f-cc8cc9cb6448",
                        "source_sense_description": "abnormal formation",
                        "target_lang_word": "malformación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malformación",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c1dd2757-2f9c-3d67-8e28-76affb25b033",
                                        "entry_id": "26d8b3f1-834c-3f8d-a172-2cf3f850114e",
                                        "glosses": [
                                            "Diferencia morfológica orgánica o corporal, notoria, respecto del promedio habitual. La etiología (causas) puede ser genética o ambiental:infecciosa, química, física o, mayoritariamente, por causas ignotas."
                                        ],
                                        "tags": [
                                            "traumatología"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a79ddf0f-033f-42c3-b022-40d5e8b99db2",
                                                "sense_id": "c1dd2757-2f9c-3d67-8e28-76affb25b033",
                                                "text": "Malformación''' arteriovenosa cerebral. Es una conexión anormal entre las arterias y las venas en el cerebro que por lo general se forma antes de nacer. Causas. Se desconoce la causa de la malformación arteriovenosa cerebral (MAV). La afección ocurre cuando las arterias en el cerebro se conectan directamente con las venas cercanas, sin tener los vasos normales (capilares) entre ellas"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
