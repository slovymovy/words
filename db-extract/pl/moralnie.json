                    {
                        "translation_id": "8e24afc1-32fc-4787-a86c-2f1d3a2e878c",
                        "source_entry_id": "c40fd989-5b0f-378e-a7e2-896b73fdb17f",
                        "source_sense_id": "34ca83f4-9011-385a-a821-c5d4d1af3f2a",
                        "target_lang_word": "morally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7ce50b9-aec5-39fe-84c5-ecada97d206a",
                                        "entry_id": "56b69f66-3d37-3ba6-ad1f-429a649f0127",
                                        "glosses": [
                                            "In terms of morals or ethics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be184f32-19a6-4515-8d08-c5fc25098c06",
                                                "sense_id": "e7ce50b9-aec5-39fe-84c5-ecada97d206a",
                                                "text": "Morally, it is a difficult issue to deal with."
                                            },
                                            {
                                                "example_id": "7a1408e8-4715-4d2b-9e5c-ced5e410dafa",
                                                "sense_id": "e7ce50b9-aec5-39fe-84c5-ecada97d206a",
                                                "text": "There is no pressure to leave, Mondelez chief executive Dirk Van de Put admitted last week, claiming that investors did not “morally care” whether companies such as the Chicago-based chocolate maker did business in Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de2de787-0692-3a2a-91da-907192d4a89c",
                                        "entry_id": "56b69f66-3d37-3ba6-ad1f-429a649f0127",
                                        "glosses": [
                                            "In keeping of requirements of morality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751943f3-3868-4768-b422-9db1c60fd6cd",
                                                "sense_id": "de2de787-0692-3a2a-91da-907192d4a89c",
                                                "text": "to behave morally"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa7a2247-f834-3a0f-bbba-0a6ff6935a34",
                                        "entry_id": "56b69f66-3d37-3ba6-ad1f-429a649f0127",
                                        "glosses": [
                                            "To all intents and purposes; practically."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ea4c7f4-8d6d-3818-a4da-c0c503b8c621",
                                        "entry_id": "56b69f66-3d37-3ba6-ad1f-429a649f0127",
                                        "glosses": [
                                            "Used to clarify that a statement is made in analogy, and every detail may not be strictly true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579ab5f4-23d8-4411-b72e-90bd91fe8e78",
                                                "sense_id": "5ea4c7f4-8d6d-3818-a4da-c0c503b8c621",
                                                "text": "In the short exact sequence 0#92;xrightarrow#123;q#125;A#92;xrightarrow#123;r#125;B#92;xrightarrow#123;s#125;C#92;xrightarrow#123;t#125;0, B is morally A#92;timesC, even if in reality the sequence may fail to split."
                                            },
                                            {
                                                "example_id": "bf9f3ce2-393b-4df2-a54a-3a00df0c56eb",
                                                "sense_id": "5ea4c7f4-8d6d-3818-a4da-c0c503b8c621",
                                                "text": "The data governing the deformations of X then consist of what we call a structure, which is a collection of slabs and walls: these are codimension-one polyhedral subsets of B, contained locally in affine hyperplanes, along with some attached data of a ring automorphism which is used in our gluing construction. This structure has an important tropical interpretation: morally, a structure can be viewed as a union of tropical trees in #92;check#123;B#125; with leaves on #92;Delta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42e1416c-4c82-49eb-bfaa-cb123b2c529f",
                        "source_entry_id": "c40fd989-5b0f-378e-a7e2-896b73fdb17f",
                        "source_sense_id": "34ca83f4-9011-385a-a821-c5d4d1af3f2a",
                        "target_lang_word": "moralisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moralisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f963db5-25d0-393a-b6cd-bbddf78db574",
                                        "entry_id": "d15e0038-b845-3bf0-8e34-9a47da50c9d0",
                                        "glosses": [
                                            "auf die Moral bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f73c40-2575-47b9-a421-cd6fb32556fa",
                                                "sense_id": "3f963db5-25d0-393a-b6cd-bbddf78db574",
                                                "text": "Das Theater wird von manchen als moralische Anstalt betrachtet."
                                            },
                                            {
                                                "example_id": "cc95fded-6cfc-4d89-b256-4608bae70656",
                                                "sense_id": "3f963db5-25d0-393a-b6cd-bbddf78db574",
                                                "text": "Das ist keine moralische, sondern lediglich eine finanzielle Frage."
                                            },
                                            {
                                                "example_id": "701a43c5-9648-4f2f-b1ec-9dd545ef1d07",
                                                "sense_id": "3f963db5-25d0-393a-b6cd-bbddf78db574",
                                                "text": "„Das moralische Skandalon ihres amoralischen Lebensstils ist längst konsensfähig geworden, vorausgesetzt, man verfügt über das nötige Kleingeld.“"
                                            },
                                            {
                                                "example_id": "b8925830-ce58-4c11-931c-91f196117441",
                                                "sense_id": "3f963db5-25d0-393a-b6cd-bbddf78db574",
                                                "text": "„Es herrschen Oberflächenreize statt Sinnsuche, und dem hohen Ton der moralischen 60er und friedensbewegten 70er begegnet Lottmann mit unbeschwerten Unkorrektheiten und Provokationen.“"
                                            },
                                            {
                                                "example_id": "85bd5ffb-e60c-4317-8aa1-b8a7da1d09fb",
                                                "sense_id": "3f963db5-25d0-393a-b6cd-bbddf78db574",
                                                "text": "„Mit diesem moralischen Gottesbeweis hätten wir den einzig möglichen Gottesbeweis vor uns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47cc5240-a0a9-3939-86dd-b7476c331bb7",
                                        "entry_id": "d15e0038-b845-3bf0-8e34-9a47da50c9d0",
                                        "glosses": [
                                            "den Maßstäben der Moral genügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2e9c7c-ed9e-43a7-9de2-2abe604703e3",
                                                "sense_id": "47cc5240-a0a9-3939-86dd-b7476c331bb7",
                                                "text": "Sein Verhalten war nicht immer sehr moralisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3deb801-a742-3229-bc76-6742f97f6856",
                                        "entry_id": "d15e0038-b845-3bf0-8e34-9a47da50c9d0",
                                        "glosses": [
                                            "von Leistungswillen geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "391d6ef7-43cf-4907-b328-f2e8dac37b49",
                                                "sense_id": "e3deb801-a742-3229-bc76-6742f97f6856",
                                                "text": "Nach dieser Niederlage muss man den Spieler moralisch wieder aufbauen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
