                            {
                                "example_id": "de02e7c8-afde-40b4-9bfa-8d84863369ff",
                                "sense_id": "bfb93876-00e0-37ff-a14f-24bc38967fc7",
                                "text": "Heb je nog wat zwoerd gekocht?",
                                "translation": "Did you buy some pork rind?",
                                "english": "Did you buy some pork rind?"
                            },
                            {
                                "example_id": "2afac432-77d3-4e84-8af2-cc9c96207ba5",
                                "sense_id": "bfb93876-00e0-37ff-a14f-24bc38967fc7",
                                "text": "Wanneer de ham bijna gaar is, probeert men of men er tot aan het zwoerd toe een' stroohalm in kan steken, hetgeen een zeker teeken is dat ze gaar is.",
                                "translation": "When the ham is almost done, try to see whether you can insert a blade of straw down to the rind, which is a sure sign that the ham has finished cooking.",
                                "english": "When the ham is almost done, try to see whether you can insert a blade of straw down to the rind, which is a sure sign that the ham has finished cooking."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4319ebb-cb4d-3743-a31b-b31679a35ca4",
                        "entry_id": "f6a01336-49a7-32d3-af1a-cbd9508a5eaf",
