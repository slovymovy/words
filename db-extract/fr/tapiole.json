                "senses": [
                    {
                        "sense_id": "0826a0c2-24c5-3a44-a935-3f287fad0cd7",
                        "entry_id": "413ae159-e302-3369-a617-a298ac873aa7",
                        "glosses": [
                            "Homosexuel le plus souvent efféminé."
                        ],
                        "tags": [
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9cb85c24-3061-48ae-a1c2-ba0c39de9ed5",
                                "sense_id": "0826a0c2-24c5-3a44-a935-3f287fad0cd7",
                                "text": "Comme Artaud, quand on croit qu’il grimace, comme une vieille tapiole à la tasse !"
                            },
                            {
                                "example_id": "1bfa65f4-3a8c-487b-9e5c-c8384e8f9595",
                                "sense_id": "0826a0c2-24c5-3a44-a935-3f287fad0cd7",
                                "text": "C’est vrai quoi, on ne compte plus les reprises de « moon river », j’en ai récupéré une bonne quarantaine sur le net : country, jazz, classique, il y a même une reprise ska sans parler de cette tapiole de Morrissey qui fait traîner la chanson plus de 9 minutes."
                            },
                            {
                                "example_id": "25235149-976a-4f7b-82bd-c3b08a9b46dc",
                                "sense_id": "0826a0c2-24c5-3a44-a935-3f287fad0cd7",
                                "text": "A côté de moi, Superman est qu’une tapiole. Quand je veux, je vole d’un coup jusqu’aux Pôles et retour. Je suis fort comme du roquefort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1588ced5-d19b-4482-9201-7ae5c2d314a6",
                        "source_entry_id": "413ae159-e302-3369-a617-a298ac873aa7",
                        "source_sense_id": "0826a0c2-24c5-3a44-a935-3f287fad0cd7",
