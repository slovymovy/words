                "senses": [
                    {
                        "sense_id": "bcc53ee8-0d92-3046-83a0-aac7269b0c3f",
                        "entry_id": "52f8011e-6f58-3404-8f7f-daf4ac60a042",
                        "glosses": [
                            "ботан. род красных водорослей семейства Анфельтиевые из класса Флоридеевые водоросли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dafc5443-c639-4e00-970d-fc796421f40e",
                                "sense_id": "bcc53ee8-0d92-3046-83a0-aac7269b0c3f",
                                "text": "Получают это вещество из анфельции и других морских водорослей, которых отнюдь не так уж много в морях."
                            },
                            {
                                "example_id": "282676e0-c5c6-45bf-ac1e-a3f66bfd9186",
                                "sense_id": "bcc53ee8-0d92-3046-83a0-aac7269b0c3f",
                                "text": "Главное богатство озера Вуссе — лагуны на берегу залива Анива — красная водоросль анфельция. Из неё производят агар, ценнейший продукт, применяемый во многих отраслях лёгкой и пищевой промышленности."
                            }
                        ]
                    }
