                ],
                "senses": [
                    {
                        "sense_id": "ea57e6fb-53f3-32e9-b4ca-06b0536bec84",
                        "entry_id": "41634aec-f01c-3145-9c9b-83c04cd48103",
                        "glosses": [
                            "Gruppe von Personen, mit denen man sich aufgrund innerer Einstellung, und nicht aufgrund Geburt oder Heirat, eng verbunden fühlt"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "6c1f95bc-ba62-4aba-9a6d-b106f5212f65",
                                "sense_id": "ea57e6fb-53f3-32e9-b4ca-06b0536bec84",
                                "text": "„Sie lebten in fröhlichen Wahlverwandtschaften, sich gegenseitig abstützend, etwas länger als drei Jahre.“"
                            },
                            {
                                "example_id": "48b566d4-fdd0-4dde-a1e5-01460633393e",
                                "sense_id": "ea57e6fb-53f3-32e9-b4ca-06b0536bec84",
                                "text": "„Berger verspürt eine Art Wahlverwandtschaft.“"
                            },
                            {
                                "example_id": "baf79860-926e-4d85-8e29-5b16a4f8dc09",
                                "sense_id": "ea57e6fb-53f3-32e9-b4ca-06b0536bec84",
                                "text": "„Oder sagen wir einfach und weniger brutal, daß meine Folgerungen richtiger waren als Volkmars Berechnungen und daß in der Tat zwischen Sophie und mir eine Art Wahlverwandtschaft bestanden hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
