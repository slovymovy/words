                    {
                        "sense_id": "a3b427fa-94fb-36a2-8d8f-c6fd4bf11399",
                        "entry_id": "069dfe04-6913-3134-a1ff-167090da2aa7",
                        "glosses": [
                            "To urinate."
                        ],
                        "tags": [
