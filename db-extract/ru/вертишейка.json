                    {
                        "translation_id": "03534ff6-6da8-4fe5-9f6b-8b187a8b7c03",
                        "source_entry_id": "6364fecf-e81b-388f-a706-679d0e5f6aea",
                        "source_sense_id": "adc1f7fc-3316-3e34-a1c7-210fe6553dd4",
                        "target_lang_word": "Wendehals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wendehals",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "972f9d88-cefb-37b0-a4d5-3ee7e38af484",
                                        "entry_id": "19d62058-8fac-3537-abfe-de213dff6d0a",
                                        "glosses": [
                                            "Vogel , der seinen Kopf ständig hin und her dreht"
                                        ],
                                        "tags": [
                                            "Jynx torquilla"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14e46738-3d79-429e-b40d-815e344107a4",
                                                "sense_id": "972f9d88-cefb-37b0-a4d5-3ee7e38af484",
                                                "text": "Der Wendehals brütet gerne in Streuobstwiesen."
                                            },
                                            {
                                                "example_id": "43538c8a-0402-4c32-9611-921f061d4f7b",
                                                "sense_id": "972f9d88-cefb-37b0-a4d5-3ee7e38af484",
                                                "text": "literarisch auf den Menschen übertragen: \"Interessant aber nicht schön. - Diese Gegend verbirgt ihren Sinn, aber sie hat einen, den man errathen möchte: wohin ich sehe, lese ich Worte und Winke zu Worten, aber ich weiss nicht, wo der Satz beginnt, der das Räthsel aller dieser Winke löst, und ich werde zum Wendehals darüber, zu untersuchen, ob von hier oder dort aus zu lesen ist.\""
                                            },
                                            {
                                                "example_id": "b4e2f306-d667-4b2a-aa0f-1b426fd9d481",
                                                "sense_id": "972f9d88-cefb-37b0-a4d5-3ee7e38af484",
                                                "text": "„Nur der Wendehals singt so, wie der Wendehals singt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c39ae56-7f38-3b56-9fee-e20720756ecc",
                                        "entry_id": "19d62058-8fac-3537-abfe-de213dff6d0a",
                                        "glosses": [
                                            "Vertreter der Vogelgattung Jynx"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bbaaf28-44d4-429e-b9ad-4c563e8f5963",
                                                "sense_id": "4c39ae56-7f38-3b56-9fee-e20720756ecc",
                                                "text": "Wendehälse kommen weltweit in zwei Arten vor."
                                            },
                                            {
                                                "example_id": "1eba6749-caf4-40c8-94f4-757a430f94f8",
                                                "sense_id": "4c39ae56-7f38-3b56-9fee-e20720756ecc",
                                                "text": "„Die Stare lärmten, die Schwalben zwitscherten, der Wendehals saß vor seinem Loch im Birnbaum und lachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bda10e3c-3ab1-3a96-9198-b3583ff0007b",
                                        "entry_id": "19d62058-8fac-3537-abfe-de213dff6d0a",
                                        "glosses": [
                                            "politischer Opportunist, der seine Überzeugungen schnell ändert, wenn ihm dies zum Vorteil gereicht (vor allem nach der Wende von 1989 in der DDR)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60e25db3-dd88-4841-ae0c-499194595354",
                                                "sense_id": "bda10e3c-3ab1-3a96-9198-b3583ff0007b",
                                                "text": "Viele SED-Kader entpuppten sich nach der Wende als Wendehälse."
                                            },
                                            {
                                                "example_id": "852112dd-4359-401b-9097-e871bbcf811c",
                                                "sense_id": "bda10e3c-3ab1-3a96-9198-b3583ff0007b",
                                                "text": "„Und da kommt nun dieser Wendehals Wallace daher und trägt dick mit einer ganzen Latte von anderen Kräften auf, die wie aus heiterem Himmel über den Homo sapiens gekommen zu sein scheinen, und drängt damit Darwin samt seiner Theorie und kompletten Entourage auf die falsche Seite des Rubikons.“"
                                            },
                                            {
                                                "example_id": "4881409b-d373-46e2-9e82-ce9ab34295be",
                                                "sense_id": "bda10e3c-3ab1-3a96-9198-b3583ff0007b",
                                                "text": "„Die neue Bedeutung des politischen Wendehalses stellt sprachlich gesehen eine Metapher dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
