                    {
                        "translation_id": "809ce85a-5450-4b53-8631-38f4f69ba30d",
                        "source_entry_id": "6b253b85-7f8f-3698-8b3d-21634f972fe8",
                        "source_sense_id": "b477ceb9-efbe-3969-a181-7aa076bbf37d",
                        "target_lang_word": "harm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Physical injury; hurt; damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e87d2d36-9634-4ca0-88f0-962d53317db8",
                                                "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                                "text": "You can do a lot of harm to someone if you kick them in the teeth."
                                            },
                                            {
                                                "example_id": "94f28af4-5332-4b8a-9640-595be76f35cb",
                                                "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                                "text": "No harm came to my possessions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Emotional or figurative hurt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7279cb7-6f49-43aa-93bf-3140196c8297",
                                                "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                                "text": "Although not physically injured in the car accident, she received some psychological harm."
                                            },
                                            {
                                                "example_id": "5922821c-9c6c-411f-ab62-66f8d907848b",
                                                "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them. Soft heartedness caused more harm than good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f72db51-9adc-388b-a487-dcfe42eb7aeb",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Detriment; misfortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b6a2d6-95db-4971-9d30-1c52892bbf7f",
                                                "sense_id": "8f72db51-9adc-388b-a487-dcfe42eb7aeb",
                                                "text": "I wish him no harm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82f5774-c4e6-368d-a9a8-69a7d12da4c1",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "That which causes injury, damage, or loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f0401c-956e-4e3c-a741-e2c55552964c",
                                                "sense_id": "b82f5774-c4e6-368d-a9a8-69a7d12da4c1",
                                                "text": "We, ignorant of ourselves, / Beg often our own harms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05de3270-c097-33e9-972c-27360469aafc",
                                        "entry_id": "7a954a5c-e442-302d-b4be-b1f7d7e65c5e",
                                        "glosses": [
                                            "To damage, hurt, or injure something, usually an inanimate object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75d11b4-c576-4454-a85f-9c6de440fe3a",
                                                "sense_id": "05de3270-c097-33e9-972c-27360469aafc",
                                                "text": "Will justice and conscience of society not be harmed if people avoid the truth?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e978bbe-758c-427b-ad9d-4778ea4a5120",
                        "source_entry_id": "6b253b85-7f8f-3698-8b3d-21634f972fe8",
                        "source_sense_id": "b477ceb9-efbe-3969-a181-7aa076bbf37d",
                        "target_lang_word": "injury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Damage to the body of a living thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d881574b-745c-4761-ba88-a369f841f0d6",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "The passenger sustained a severe injury in the car accident."
                                            },
                                            {
                                                "example_id": "bad00ff5-d366-4560-8eb9-5b01cf170aa6",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "He got a shoulder injury in the nets three days before the match."
                                            },
                                            {
                                                "example_id": "f26e7d62-2470-4b86-9ed9-1b8c71c2966b",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "Whether you need to recover from a stressful day, a strenuous workout or even an injury or surgery, restorative yoga may be just the thing for you."
                                            },
                                            {
                                                "example_id": "de62401f-9efc-4700-af95-907c6e74017b",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "Soft tissue injuries are the bane of any physically active person. They are the most common injuries in sport, can be difficult to heal and often reoccur, according to Sports Medicine Australia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e25a621-09c5-370b-9835-34a3c7cf17c6",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Other forms of damage sustained by a living thing, e.g. psychologically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd78b5b2-f952-37dd-88fa-22ef22ef0b17",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "The violation of a person's reputation, rights, property, or interests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a9ed25-bb33-4923-8cfe-ee07bab601c7",
                                                "sense_id": "fd78b5b2-f952-37dd-88fa-22ef22ef0b17",
                                                "text": "Slander is an injury to the character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43fd8eb1-68cc-3430-8d21-b3b24adfe98a",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Injustice."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "injury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9599ebd9-4a04-3c84-b780-4abb8bb03b26",
                                        "entry_id": "c99678e0-b79d-3e01-a149-4852f88e54c1",
                                        "glosses": [
                                            "To wrong, to injure."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87796690-5750-4d8f-9056-715bd69a3b3c",
                                                "sense_id": "9599ebd9-4a04-3c84-b780-4abb8bb03b26",
                                                "text": "The best of us doth not so much feare to wrong him, as he doth to injurie his neighbour, his kinsman, or his master."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98026b3f-f76f-4e8a-a93a-29f188042894",
                        "source_entry_id": "6b253b85-7f8f-3698-8b3d-21634f972fe8",
                        "source_sense_id": "b477ceb9-efbe-3969-a181-7aa076bbf37d",
                        "target_lang_word": "wound",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a03bf2f1-6268-34dc-87a9-f868f0cf81fe",
                                        "entry_id": "9cc7332b-2a8d-3518-b96a-bc0d1d12e99a",
                                        "glosses": [
                                            "An injury, such as a cut, stab, or tear, to a (usually external) part of the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9187aa-3ebe-4bdd-932a-be08e49778bf",
                                                "sense_id": "a03bf2f1-6268-34dc-87a9-f868f0cf81fe",
                                                "text": "The visitors were without Wayne Rooney after he suffered a head wound in training, which also keeps him out of England's World Cup qualifiers against Moldova and Ukraine."
                                            },
                                            {
                                                "example_id": "56089d04-eb1b-4aeb-898f-2249a652124b",
                                                "sense_id": "a03bf2f1-6268-34dc-87a9-f868f0cf81fe",
                                                "text": "Showers of blood / Rained from the wounds of slaughtered Englishmen."
                                            },
                                            {
                                                "example_id": "0f84c96f-99c9-42de-af40-80151e808637",
                                                "sense_id": "a03bf2f1-6268-34dc-87a9-f868f0cf81fe",
                                                "text": "I went below, and did what I could for my wound; it pained me a good deal, and still bled freely; but it was neither deep nor dangerous, nor did it greatly gall me when I used my arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8b15a7b-cec7-3a65-bc94-86f0b9e7d4ec",
                                        "entry_id": "9cc7332b-2a8d-3518-b96a-bc0d1d12e99a",
                                        "glosses": [
                                            "A hurt to a person's feelings, reputation, prospects, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b35182ca-c6fc-4e75-89dc-b2adef0c8ddf",
                                                "sense_id": "c8b15a7b-cec7-3a65-bc94-86f0b9e7d4ec",
                                                "text": "It took a long time to get over the wound of that insult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5d28650-fa6c-3443-bc93-f6fd4911b168",
                                        "entry_id": "9cc7332b-2a8d-3518-b96a-bc0d1d12e99a",
                                        "glosses": [
                                            "An injury to a person by which the skin is divided or its continuity broken."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eae432b0-a726-327e-9143-146412c6be69",
                                        "entry_id": "d415d42c-4df6-3d23-88e7-9e900b13f000",
                                        "glosses": [
                                            "To hurt or injure (someone) by cutting, piercing, or tearing the skin."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1097885d-d4ae-4bff-b860-9c462e4387fd",
                                                "sense_id": "eae432b0-a726-327e-9143-146412c6be69",
                                                "text": "The police officer wounded the suspect during the fight that ensued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51b3e5cb-84a6-3bdf-b9a5-eedafb3939c1",
                                        "entry_id": "d415d42c-4df6-3d23-88e7-9e900b13f000",
                                        "glosses": [
                                            "To hurt (a person's feelings)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04817777-aff1-4907-bea2-039344b8cc72",
                                                "sense_id": "51b3e5cb-84a6-3bdf-b9a5-eedafb3939c1",
                                                "text": "The actor's pride was wounded when the leading role went to his rival."
                                            },
                                            {
                                                "example_id": "0cb0004d-16af-4796-b523-68ac093dc014",
                                                "sense_id": "51b3e5cb-84a6-3bdf-b9a5-eedafb3939c1",
                                                "text": "I find neglect or rejection from my own community much harder to take and more wounding than the same thing or worse from the outside world."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3c66bf-69c0-35e7-947e-9b9c5e99a2ba",
