    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "711b8849-7499-3f95-ae1d-728cbaca91da",
                    "sense_definition": "The basic unit of a living organism, consisting of a quantity of protoplasm surrounded by a cell membrane.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In multicellular organisms, groups of <w>cells</w> form tissues and tissues come together to form organs.",
                            "target_lang_translations": {
                                "ru": "В многоклеточных организмах группы <w>клеток</w> образуют ткани, а ткани соединяются, образуя органы.",
                                "zh": "在多细胞生物中，一组<w>细胞</w>形成组织，组织再结合形成器官。"
                            }
                        },
                        {
                            "text": "The scientist looked through the microscope to see the <w>cell</w> membrane clearly.",
                            "target_lang_translations": {
                                "ru": "Ученый посмотрел в микроскоп, чтобы четко увидеть <w>клеточную</w> мембрану.",
                                "zh": "科学家通过显微镜清晰地观察到了<w>细胞</w>膜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cyte"
                    ],
                    "common_phrases": [
                        "cell membrane",
                        "blood cell",
                        "stem cell",
                        "nerve cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная единица живого организма, состоящая из протоплазмы, окруженной клеточной мембраной.",
                        "zh": "生物体的基本结构和功能单位，由细胞膜包围的细胞质组成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клетка",
                                "target_lang_sense_clarification": "биологическая единица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "细胞",
                                "target_lang_sense_clarification": "生物学基本单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "900aea24-39d2-35ad-acb3-f7d7866fc8d7",
                    "sense_definition": "A small room in a prison or jail where one or more inmates are kept.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The combatants spent the night in separate <w>cells</w> after the fight.",
                            "target_lang_translations": {
                                "ru": "Участники драки провели ночь в разных <w>камерах</w>.",
                                "zh": "打架后，参与者被分别关在不同的<w>牢房</w>里过夜。"
                            }
                        },
                        {
                            "text": "The guard locked the <w>cell</w> door at exactly ten o'clock every night.",
                            "target_lang_translations": {
                                "ru": "Охранник запирал дверь <w>камеры</w> ровно в десять часов каждый вечер.",
                                "zh": "守卫每天晚上十点准时锁上<w>牢房</w>门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prison cell"
                    ],
                    "common_phrases": [
                        "jail cell",
                        "cell door",
                        "solitary cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое помещение в тюрьме или следственном изоляторе, где содержатся один или несколько заключенных.",
                        "zh": "监狱或看守所内关押犯人的小房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "камера",
                                "target_lang_sense_clarification": "тюремная"
                            },
                            {
                                "target_lang_word": "клетка",
                                "target_lang_sense_clarification": "разговорное о тюремной камере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牢房",
                                "target_lang_sense_clarification": "监狱中的房间"
                            },
                            {
                                "target_lang_word": "监房",
                                "target_lang_sense_clarification": "监狱中的房间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c6397c4-6256-3c4a-a974-6b1e39fe0e7c",
                    "sense_definition": "A cellular phone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I forgot my <w>cell</w> at home, so I could not call you earlier.",
                            "target_lang_translations": {
                                "ru": "Я забыл свой <w>мобильник</w> дома, поэтому не смог позвонить тебе раньше.",
                                "zh": "我把<w>手机</w>忘在家里了，所以没能早点给你打电话。"
                            }
                        },
                        {
                            "text": "Please turn off your <w>cell</w> phone before the movie starts.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выключите свой <w>сотовый</w> телефон перед началом фильма.",
                                "zh": "电影开始前请关闭您的<w>手机</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cell phone",
                        "cell number"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сотовый телефон.",
                        "zh": "移动电话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мобильник",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "сотовый",
                                "target_lang_sense_clarification": "сокращение от сотовый телефон"
                            },
                            {
                                "target_lang_word": "мобильный телефон",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手机",
                                "target_lang_sense_clarification": "移动电话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01b79bdd-8e32-3912-a125-5e3bd21b7341",
                    "sense_definition": "The unit in a spreadsheet or statistical array where a row and a column intersect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to enter the formula into the correct <w>cell</w> of the spreadsheet.",
                            "target_lang_translations": {
                                "ru": "Вам нужно ввести формулу в соответствующую <w>ячейку</w> таблицы.",
                                "zh": "你需要将公式输入到电子表格中正确的<w>单元格</w>里。"
                            }
                        },
                        {
                            "text": "Each <w>cell</w> in this table contains a different piece of data.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>ячейка</w> в этой таблице содержит отдельный фрагмент данных.",
                                "zh": "这张表里的每个<w>单元格</w>都包含不同的数据。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spreadsheet cell",
                        "active cell",
                        "empty cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент электронной таблицы или статистического массива на пересечении строки и столбца.",
                        "zh": "电子表格或统计数组中行与列的交叉点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "в таблице"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单元格",
                                "target_lang_sense_clarification": "表格中的格子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b40695cc-cc63-384c-9f2c-3267c067c190",
                    "sense_definition": "A device which stores electrical power; the basic unit of a battery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This MP3 player runs on two AAA <w>cells</w>.",
                            "target_lang_translations": {
                                "ru": "Этот MP3-плеер работает от двух <w>батареек</w> типа AAA.",
                                "zh": "这个MP3播放器靠两节AAA<w>电池</w>运行。"
                            }
                        },
                        {
                            "text": "A solar <w>cell</w> converts sunlight directly into electricity.",
                            "target_lang_translations": {
                                "ru": "Солнечный <w>элемент</w> преобразует солнечный свет непосредственно в электричество.",
                                "zh": "太阳能<w>电池</w>能将阳光直接转化为电能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fuel cell",
                        "solar cell",
                        "dry cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, накапливающее электрическую энергию; базовый элемент батареи.",
                        "zh": "储存电能的装置；电池的基本组成部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "питания"
                            },
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "электрохимическая"
                            },
                            {
                                "target_lang_word": "батарейка",
                                "target_lang_sense_clarification": "в бытовом смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电池",
                                "target_lang_sense_clarification": "储能装置"
                            },
                            {
                                "target_lang_word": "电芯",
                                "target_lang_sense_clarification": "电池内部单元"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1725bb7-716a-3fde-b469-2b07ef7d9b32",
                    "sense_definition": "A small group of people forming part of a larger organization, often an outlawed or secret one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Those three fellows are the local <w>cell</w> of that organization.",
                            "target_lang_translations": {
                                "ru": "Эти трое парней — местная <w>ячейка</w> той организации.",
                                "zh": "那三个人是该组织当地的<w>小组</w>成员。"
                            }
                        },
                        {
                            "text": "The intelligence agency discovered a sleeper <w>cell</w> operating in the city.",
                            "target_lang_translations": {
                                "ru": "Разведка обнаружила спящую <w>ячейку</w>, действующую в городе.",
                                "zh": "情报机构发现了一个在城内活动的潜伏<w>小组</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sleeper cell",
                        "terrorist cell",
                        "local cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая группа людей, входящая в состав более крупной организации, часто незаконной или секретной.",
                        "zh": "大型组织内部的小型团体，常指非法或秘密组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "организационная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小组",
                                "target_lang_sense_clarification": "组织内部的小团体"
                            },
                            {
                                "target_lang_word": "分支",
                                "target_lang_sense_clarification": "组织的分支机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb1c4525-3074-33e9-ba30-4ebfe67cccdd",
                    "sense_definition": "A small room in a monastery or nunnery accommodating one person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A nun's bedroom is properly called a <w>cell</w> and is small, bare, and plain.",
                            "target_lang_translations": {
                                "ru": "Комната монахини правильно называется <w>кельей</w>, она маленькая, пустая и простая.",
                                "zh": "修女的卧室通常被称为<w>僧房</w>，它狭小、空旷且简朴。"
                            }
                        },
                        {
                            "text": "The monk spent most of his day praying in his quiet <w>cell</w>.",
                            "target_lang_translations": {
                                "ru": "Монах проводил большую часть дня в молитвах в своей тихой <w>келье</w>.",
                                "zh": "僧侣一天中的大部分时间都在他安静的<w>僧房</w>里祈祷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "monastic cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая комната в монастыре, предназначенная для проживания одного человека.",
                        "zh": "修道院中供一人居住的小房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "келья",
                                "target_lang_sense_clarification": "монашеская"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "僧房",
                                "target_lang_sense_clarification": "僧侣的房间"
                            },
                            {
                                "target_lang_word": "修道室",
                                "target_lang_sense_clarification": "修道院中的房间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94725bd7-2f9b-3ab7-bdda-0ca3fa565ce4",
                    "sense_definition": "Each of the small hexagonal compartments in a honeycomb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bees were busy filling each <w>cell</w> of the honeycomb with honey.",
                            "target_lang_translations": {
                                "ru": "Пчелы были заняты заполнением медом каждой <w>ячейки</w> сот.",
                                "zh": "蜜蜂正忙着往蜂巢的每个<w>蜂房</w>里填满蜂蜜。"
                            }
                        },
                        {
                            "text": "The structure of the hive is made of many tiny <w>cells</w>.",
                            "target_lang_translations": {
                                "ru": "Структура улья состоит из множества крошечных <w>ячеек</w>.",
                                "zh": "蜂巢的结构由许多微小的<w>蜂房</w>组成。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "honeycomb cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждое из небольших шестиугольных отделений в пчелиных сотах.",
                        "zh": "蜂巢中六角形的小隔间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "в сотах"
                            },
                            {
                                "target_lang_word": "сота",
                                "target_lang_sense_clarification": "отдельный элемент сот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜂房",
                                "target_lang_sense_clarification": "蜂巢的格子"
                            },
                            {
                                "target_lang_word": "巢室",
                                "target_lang_sense_clarification": "蜂巢的格子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15f08cad-638e-38a7-8323-98a0954db42d",
                    "sense_definition": "A region of radio reception that is a part of a larger radio network.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I get good reception in my home because it is near a <w>cell</w> tower.",
                            "target_lang_translations": {
                                "ru": "У меня дома хороший прием, потому что он находится рядом с вышкой <w>сотовой</w> связи.",
                                "zh": "我家信号很好，因为附近有一座移动通信<w>基站</w>。"
                            }
                        },
                        {
                            "text": "The mobile network is divided into many different <w>cells</w> to cover the city.",
                            "target_lang_translations": {
                                "ru": "Мобильная сеть разделена на множество различных <w>сот</w> для охвата города.",
                                "zh": "移动网络被划分为许多不同的<w>小区</w>以覆盖全城。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cell tower",
                        "cell site"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зона радиоприема, являющаяся частью более крупной радиосети.",
                        "zh": "无线电网络覆盖区域中的一个小区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сота",
                                "target_lang_sense_clarification": "в мобильной связи"
                            },
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "сети"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小区",
                                "target_lang_sense_clarification": "移动通信覆盖区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21a510c4-f289-3941-b3e3-e8927b6ab205",
                    "sense_definition": "A small thunderstorm, caused by convection, that forms ahead of a storm front.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a powerful storm <w>cell</w> headed our way according to the radar.",
                            "target_lang_translations": {
                                "ru": "Согласно радару, в нашу сторону движется мощный штормовой <w>очаг</w>.",
                                "zh": "根据雷达显示，一个强大的风暴<w>单体</w>正向我们袭来。"
                            }
                        },
                        {
                            "text": "The weather report warned of a convective <w>cell</w> developing in the west.",
                            "target_lang_translations": {
                                "ru": "В прогнозе погоды предупредили о развитии конвективной <w>ячейки</w> на западе.",
                                "zh": "天气预报警告说西部正在形成一个对流<w>单体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "storm cell",
                        "convective cell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой грозовой очаг, вызванный конвекцией, который формируется перед штормовым фронтом.",
                        "zh": "由对流引起，在风暴锋面之前形成的局部雷暴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "метеорологическая"
                            },
                            {
                                "target_lang_word": "очаг",
                                "target_lang_sense_clarification": "штормовой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对流单体",
                                "target_lang_sense_clarification": "气象学概念"
                            },
                            {
                                "target_lang_word": "风暴单体",
                                "target_lang_sense_clarification": "气象学概念"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bedbdc5d-e5fc-3251-884c-644991f9b792",
                    "sense_definition": "To place or enclose in a cell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was <w>celled</w> underground where no light could reach him.",
                            "target_lang_translations": {
                                "ru": "Заключенного <w>заперли в камере</w> под землей, куда не проникал свет.",
                                "zh": "囚犯被<w>监禁</w>在地下，那里没有任何光线。"
                            }
                        },
                        {
                            "text": "He spent years being <w>celled</w> away from the rest of society.",
                            "target_lang_translations": {
                                "ru": "Он провел годы, будучи <w>изолированным в камере</w> от остального общества.",
                                "zh": "他被<w>监禁</w>起来，与世隔绝多年。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
