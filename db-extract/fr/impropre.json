                                "sense_id": "980efe32-e1b3-3c6d-92f7-5d244f188937",
                                "text": "Il a fait de cet outil, un usage impropre."
                            }
                        ]
                    },
                    {
                        "sense_id": "52b9ba77-51ed-3125-8c9c-36dbcfe615d7",
                        "entry_id": "3e9d91d7-8bfd-3113-8925-2986257c65cb",
                        "glosses": [
