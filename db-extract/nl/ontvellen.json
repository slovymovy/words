        "nl-extract.jsonl": [
            {
                "entry_id": "30a203c9-e66e-3acc-8451-cd27327cd8d5",
                "word": "ontvellen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ffbbb9d3-5d15-38e4-a54e-ea9a9770e602",
                        "entry_id": "30a203c9-e66e-3acc-8451-cd27327cd8d5",
                        "glosses": [
                            "ergens de huid vanaf halen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e141e311-395d-4fdf-856a-ac08069863f7",
                                "sense_id": "ffbbb9d3-5d15-38e4-a54e-ea9a9770e602",
                                "text": "Haal de zoete aardappelen uit de oven, je kunt ze nu makkelijk ontvellen. Pureer ze met een vork en breng op smaak met peper, zout en koriander."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac0244d5-557f-32b4-b508-9c3d845cc39b",
                        "entry_id": "30a203c9-e66e-3acc-8451-cd27327cd8d5",
                        "glosses": [
                            "je verwonden zodat er een oppervlakkige wond met een wat groter oppervlak ontstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bee9482-36d4-430d-a5bc-ad92c83a60c9",
                                "sense_id": "ac0244d5-557f-32b4-b508-9c3d845cc39b",
                                "text": "Amerikaans onderzoek (van Douglas Richie) toonde aan dat niet alleen de vezel maar ook de aard van het weefsel van belang is. Gunstige eigenschappen heeft het lussenweefsel dat badstof heet. Moderne sport- en wandelsokken hebben vaak lokale verdikkingen van badstof of wat daar op lijkt. Het vermindert ook de kans op schuren en en ontvellen."
                            }
                        ]
                    }
                ],
