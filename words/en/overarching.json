{
    "word_family": [
        "arch",
        "overarch"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0c889b8-3388-3183-8a3f-64a45522fc8a",
                    "sense_definition": "Dominating, comprehensive, or embracing all parts of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee established an <w>overarching</w> goal for the entire organization to follow.",
                            "target_lang_translations": {
                                "ru": "Комитет установил <w>главную</w> цель, которой должна следовать вся организация."
                            }
                        },
                        {
                            "text": "Her book addresses several issues under one <w>overarching</w> theme of social justice.",
                            "target_lang_translations": {
                                "ru": "В её книге рассматриваются различные вопросы в рамках одной <w>всеобъемлющей</w> темы социальной справедливости."
                            }
                        }
                    ],
                    "synonyms": [
                        "all-embracing",
                        "all-encompassing"
                    ],
                    "common_phrases": [
                        "overarching theme",
                        "overarching goal",
                        "overarching framework"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охватывающий все аспекты чего-либо; главный, господствующий или всеобъемлющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всеобъемлющий",
                                "target_lang_sense_clarification": "охватывающий всё целиком"
                            },
                            {
                                "target_lang_word": "всеохватывающий",
                                "target_lang_sense_clarification": "включающий все элементы или аспекты"
                            },
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "основной, определяющий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddd3e3ef-667b-375d-8e18-d31f4967f893",
                    "sense_definition": "Forming an arch overhead; physically curving above.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked slowly along the quiet path shaded by <w>overarching</w> trees.",
                            "target_lang_translations": {
                                "ru": "Они медленно шли по тихой тропинке в тени <w>смыкавшихся сводом</w> деревьев."
                            }
                        },
                        {
                            "text": "The <w>overarching</w> sky was painted with streaks of vibrant pink at dawn.",
                            "target_lang_translations": {
                                "ru": "<w>Раскинувшийся сводом</w> небосвод на рассвете окрасился яркими розовыми полосами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overarching branches",
                        "overarching trees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образующий арку над головой; нависающий или смыкающийся сводом сверху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависающий сводом",
                                "target_lang_sense_clarification": "склоняющийся сверху аркой"
                            },
                            {
                                "target_lang_word": "смыкающийся",
                                "target_lang_sense_clarification": "образующий арку или свод над чем-либо"
                            },
                            {
                                "target_lang_word": "сводчатый",
                                "target_lang_sense_clarification": "имеющий форму свода"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "497e3368-2e2f-337d-bc37-d62b7e53e18e",
                    "sense_definition": "present participle and gerund of <w>overarch</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tall oak boughs were <w>overarching</w> the stone gateway to the garden.",
                            "target_lang_translations": {
                                "ru": "Высокие дубовые ветви <w>нависали аркой над</w> каменными воротами в сад."
                            }
                        },
                        {
                            "text": "We paused to admire the ancient vines completely <w>overarching</w> the courtyard.",
                            "target_lang_translations": {
                                "ru": "Мы остановились, чтобы полюбоваться древними лозами, полностью <w>образующими свод над</w> внутренним двором."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по значению глагола overarch: нависать сводом, образовывать арку над чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависать аркой",
                                "target_lang_sense_clarification": "образовывать свод над чем-либо"
                            },
                            {
                                "target_lang_word": "образовывать свод",
                                "target_lang_sense_clarification": "смыкаться над чем-либо в виде свода"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1727c020-f7d7-3dc0-856f-ae2d3fbd2446",
                    "sense_definition": "A physical structure or curve that forms an arch over something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stone <w>overarching</w> supported the ceiling of the ancient crypt perfectly.",
                            "target_lang_translations": {
                                "ru": "Каменный <w>свод</w> идеально поддерживал потолок древнего склепа."
                            }
                        },
                        {
                            "text": "Architects inspected every <w>overarching</w> in the historic cathedral for structural cracks.",
                            "target_lang_translations": {
                                "ru": "Архитекторы осмотрели каждую <w>арку</w> в историческом соборе на наличие структурных трещин."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая конструкция или изгиб, образующий свод или арку над чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "арочное перекрытие"
                            },
                            {
                                "target_lang_word": "арка",
                                "target_lang_sense_clarification": "криволинейное перекрытие проема"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}