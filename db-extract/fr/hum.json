                                        "examples": [
                                            {
                                                "example_id": "e3bbc7a6-51d5-45c9-bb5e-9096985e6d0e",
                                                "sense_id": "f6d9d07d-3a06-34a4-a24b-956e4b45cbb9",
                                                "text": "\"You there! Where are you going?\" \"Hmm? Oh, I just need to get a drink.\""
