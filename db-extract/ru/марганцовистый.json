                "senses": [
                    {
                        "sense_id": "0c449434-a1f2-3079-8bfd-5a18f987a252",
                        "entry_id": "f22add28-2bf2-36d1-82f4-67dc5bc72976",
                        "glosses": [
                            "минер. содержащий в себе примеси марганца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f75fa88-bbf5-47a3-b15d-86ffe6a9390a",
                                "sense_id": "0c449434-a1f2-3079-8bfd-5a18f987a252",
                                "text": "Марганец широко применяется в металлургии, главным образом в качестве легирующего компонента соответствующих видов стали (марганцовистые стали и др.), а также чугуна."
                            },
                            {
                                "example_id": "1eb9f576-2e17-463c-9613-c50c090c46a6",
                                "sense_id": "0c449434-a1f2-3079-8bfd-5a18f987a252",
                                "text": "Наиболее марганцовистый кальцит обнаруживает под ультрафиолетом слабую люминесценцию в красных тонах."
                            }
                        ]
                    }
                ],
