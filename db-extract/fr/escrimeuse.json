                                "target_senses": [
                                    {
                                        "sense_id": "b5bd5751-9272-3bd1-969a-fb0456f5a2b6",
                                        "entry_id": "011a9c0f-decb-3564-8149-d1095bfc0ead",
                                        "glosses": [
                                            "Sportlerin, die das Fechten ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b35825-b694-4a6d-9492-c25f8206f064",
                                                "sense_id": "b5bd5751-9272-3bd1-969a-fb0456f5a2b6",
                                                "text": "Die Fechterinnen erreichten einen Platz am Siegespodest."
                                            },
                                            {
                                                "example_id": "ce373c61-b8b8-45c1-931e-d47810dd9ea3",
                                                "sense_id": "b5bd5751-9272-3bd1-969a-fb0456f5a2b6",
                                                "text": "„Bei der WM dürfen Fechterinnen und Fechter aus Russland und Belarus in den Einzelwettbewerben als neutrale Athleten starten.“"
                                            }
