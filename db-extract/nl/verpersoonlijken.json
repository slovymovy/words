        "nl-extract.jsonl": [
            {
                "entry_id": "7c7793ac-a6e6-303e-8ca0-54f771126878",
                "word": "verpersoonlijken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c67a7c49-fe54-3768-9cfd-cbba65e96d7d",
                        "entry_id": "7c7793ac-a6e6-303e-8ca0-54f771126878",
                        "glosses": [
                            "als een persoon voorstellen van iets dat niet tastbaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d42fbeeb-1ce2-400d-9f38-bc27437e6041",
                                "sense_id": "c67a7c49-fe54-3768-9cfd-cbba65e96d7d",
                                "text": "Murray werd door chef de mission Mark England en enkele bestuursleden gekozen uit een select groepje atleten 'die de olympische waarden verpersoonlijken en die van Team GB hooghouden'."
                            },
                            {
                                "example_id": "d4571436-9979-4684-ba91-f8dfc5c9c6ac",
                                "sense_id": "c67a7c49-fe54-3768-9cfd-cbba65e96d7d",
                                "text": "Poincheval heeft een voorliefde voor buitengewone kunstprojecten. Hij leefde in 2014 een dag in een uitgeholde beer. Daarbij at hij insecten, om zo de maag van de beer te verpersoonlijken."
                            },
                            {
                                "example_id": "384ec109-80da-487b-9bb9-52de21e03db4",
                                "sense_id": "c67a7c49-fe54-3768-9cfd-cbba65e96d7d",
                                "text": "'Ze geven Ketnet een gezicht, op televisie, op de website en op allerlei evenementen. Ze verpersoonlijken de waarden waar Ketnet voor staat en begeleiden de kinderen doorheen onze programma’s."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f662b58-2b9f-39f6-86d6-fee16beb82d0",
                        "entry_id": "7c7793ac-a6e6-303e-8ca0-54f771126878",
                        "glosses": [
                            "speciaal aanpassen op één bepaald persoon of één bepaalde doelgroep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b578b8-93dc-489e-9524-202575c70d8f",
                                "sense_id": "4f662b58-2b9f-39f6-86d6-fee16beb82d0",
                                "text": "\"We gaan kijken hoe we de brief meer kunnen verpersoonlijken.\" Dat dat na de signalen niet meteen al is gebeurd, heeft een financiële reden: Van Belkom: \"We hebben 500.000 van deze flyers laten drukken. Elke partij voorzien van persoonlijke gegevens uit de buurt waar die wordt verspreid, brengt heel veel extra kosten met zich mee.\" Als de 500.000 folders op zijn, zal een aangepaste versie worden gedrukt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bd3a2e1-c3ba-4a68-b751-8ecd78275ed9",
                        "source_entry_id": "7c7793ac-a6e6-303e-8ca0-54f771126878",
                        "source_sense_id": "c67a7c49-fe54-3768-9cfd-cbba65e96d7d",
                        "source_sense_description": "als een persoon voorstellen van iets dat niet tastbaar is",
                        "target_lang_word": "personify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84ce51f-3d90-39be-8d14-345e4a7d40a3",
                                        "entry_id": "42d07333-6cc1-31f2-be97-2a2d5974cbfc",
                                        "glosses": [
                                            "To be an example of; to have all the attributes of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e72a0a0-57b4-4c2d-aa7d-81d96bb9642e",
                                                "sense_id": "a84ce51f-3d90-39be-8d14-345e4a7d40a3",
                                                "text": "Mozart could be said to personify musical genius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c41afc65-4568-312d-bd89-2dc0eab72d43",
                                        "entry_id": "42d07333-6cc1-31f2-be97-2a2d5974cbfc",
                                        "glosses": [
                                            "To create a representation of (an abstract quality) in the form of a character or persona."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21950c16-2126-4182-b935-85dc0334045b",
                                                "sense_id": "c41afc65-4568-312d-bd89-2dc0eab72d43",
                                                "text": "The writer personified death in the form of the Grim Reaper."
                                            },
                                            {
                                                "example_id": "6b6ffcb7-5e0c-447a-a07d-dfd6238eea85",
                                                "sense_id": "c41afc65-4568-312d-bd89-2dc0eab72d43",
                                                "text": "If ever any of the girls had taken a fancy to personify their good genius, they would certainly have given to his image all they remembered of \"Uncle Frank.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffaec63b-92c0-4550-860e-dc1e2f79d003",
                        "source_entry_id": "7c7793ac-a6e6-303e-8ca0-54f771126878",
                        "source_sense_id": "c67a7c49-fe54-3768-9cfd-cbba65e96d7d",
