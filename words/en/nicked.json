{
    "word_family": [
        "nick"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc1f3170-3d93-3cb3-a512-35940e767276",
                    "sense_definition": "Having small cuts or notches on the edge or surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "damaged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nicked</w> blade was no longer sharp enough to cut the paper cleanly.",
                            "target_lang_translations": {
                                "nl": "Het <w>ingekerfde</w> mes was niet scherp genoeg meer om het papier netjes door te snijden."
                            }
                        },
                        {
                            "text": "He noticed the <w>nicked</w> edge of the table after moving the heavy furniture.",
                            "target_lang_translations": {
                                "nl": "Hij merkte de <w>beschadigde</w> rand van de tafel op nadat hij het zware meubel had verplaatst."
                            }
                        }
                    ],
                    "synonyms": [
                        "notched",
                        "notchy",
                        "jagged"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van kleine inkepingen of beschadigingen aan de rand of het oppervlak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ingekerfd",
                                "target_lang_sense_clarification": "met kleine sneden of inkepingen"
                            },
                            {
                                "target_lang_word": "beschadigd",
                                "target_lang_sense_clarification": "met een kleine beschadiging aan de rand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12acb5cc-1569-306f-ad96-41ef8bcf08c0",
                    "sense_definition": "Taken illegally without permission.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stolen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found the <w>nicked</w> bicycle hidden behind the old garage.",
                            "target_lang_translations": {
                                "nl": "De politie vond de <w>gejatte</w> fiets verborgen achter de oude garage."
                            }
                        },
                        {
                            "text": "He felt guilty about the <w>nicked</w> watch he had bought from a stranger.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich schuldig over het <w>gestolen</w> horloge dat hij van een vreemde had gekocht."
                            }
                        }
                    ],
                    "synonyms": [
                        "stolen",
                        "lifted"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Op illegale wijze meegenomen zonder toestemming."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gejat",
                                "target_lang_sense_clarification": "informeel voor gestolen"
                            },
                            {
                                "target_lang_word": "gestolen",
                                "target_lang_sense_clarification": "algemene term voor diefstal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdd2532a-e154-38a5-97eb-aa1b8f2d634c",
                    "sense_definition": "Taken into custody by law enforcement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arrested",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief realized he was <w>nicked</w> as soon as the sirens started blaring.",
                            "target_lang_translations": {
                                "nl": "De dief besefte dat hij <w>opgepakt</w> was zodra de sirenes begonnen te loeien."
                            }
                        },
                        {
                            "text": "You are <w>nicked</w> for speeding, the officer told the driver firmly.",
                            "target_lang_translations": {
                                "nl": "Je bent <w>aangehouden</w> voor te hard rijden, zei de agent streng tegen de bestuurder."
                            }
                        }
                    ],
                    "synonyms": [
                        "apprehended",
                        "busted",
                        "collared"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Door de politie aangehouden of gearresteerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opgepakt",
                                "target_lang_sense_clarification": "door de politie gearresteerd"
                            },
                            {
                                "target_lang_word": "aangehouden",
                                "target_lang_sense_clarification": "formeel voor gearresteerd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb2d1f8c-8913-350c-93c4-450ea0a00a4d",
                    "sense_definition": "Past tense and past participle of <w>nick</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>nicked</w> his finger while he was chopping vegetables for dinner.",
                            "target_lang_translations": {
                                "nl": "Hij <w>kerfde</w> in zijn vinger terwijl hij groenten aan het snijden was voor het avondeten."
                            }
                        },
                        {
                            "text": "She <w>nicked</w> the paint on the wall when she moved the chair.",
                            "target_lang_translations": {
                                "nl": "Ze <w>beschadigde</w> de verf op de muur toen ze de stoel verplaatste."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb nick."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'nick' (een kleine snede maken)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ingekerfd",
                                "target_lang_sense_clarification": "een kleine snede gemaakt"
                            },
                            {
                                "target_lang_word": "beschadigd",
                                "target_lang_sense_clarification": "een kleine kras of deuk veroorzaakt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}