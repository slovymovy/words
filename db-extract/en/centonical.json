                        "glosses": [
                            "Of or pertaining to a cento (work quoting from other authors)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "698a73d6-2fe8-4d38-8cdb-0fbbc68da2da",
                                "sense_id": "8cf56c4f-0ee5-377e-a534-eda30ad843ca",
                                "text": "In technical terms, the Zadonščina could be defined as a centonical palinode, i.e. as a composition built up primarily on literal or paraphrased quotations and intended to counterbalance or refute the quoted work."
                            },
                            {
                                "example_id": "d31a60bc-90f4-446a-8c97-5689a0598c8e",
                                "sense_id": "8cf56c4f-0ee5-377e-a534-eda30ad843ca",
                                "text": "The end of the poem offers a good example of his centonical procedure."
                            },
                            {
                                "example_id": "0865cc1e-82d7-4c0d-8147-004ba2a9c918",
                                "sense_id": "8cf56c4f-0ee5-377e-a534-eda30ad843ca",
                                "text": "Ballads in the black tradition are also often centonical—they borrow thematic elements from a variety of sources to build something new."
                            }
                        ]
                    }
