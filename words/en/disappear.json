{
    "word_family": [
        "appearance",
        "disappearance",
        "reappear",
        "apparent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c688a981-c783-3632-a8b5-bc9ee33ae704",
                    "sense_definition": "To stop being visible; to pass out of sight.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cease_to_be_perceived",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun <w>disappeared</w> behind a large dark cloud.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>скрылось</w> за большой темной тучей.",
                                "tr": "Güneş büyük ve karanlık bir bulutun arkasında <w>gözden kayboldu</w>.",
                                "zh": "太阳<w>消失</w>在一大片乌云后面。"
                            }
                        },
                        {
                            "text": "We watched the ship as it slowly <w>disappeared</w> over the horizon.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за кораблем, пока он медленно не <w>скрылся</w> за горизонтом.",
                                "tr": "Gemi ufukta yavaşça <w>gözden kaybolurken</w> onu izledik.",
                                "zh": "我们看着那艘船，它慢慢地在海平线上<w>隐没</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vanish"
                    ],
                    "antonyms": [
                        "appear"
                    ],
                    "common_phrases": [
                        "disappear from view",
                        "disappear into thin air",
                        "suddenly disappear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать быть видимым; скрыться из виду.",
                        "tr": "Görünmez hale gelmek; gözden kaybolmak.",
                        "zh": "不再可见；从视野中消失。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "становиться невидимым"
                            },
                            {
                                "target_lang_word": "скрываться",
                                "target_lang_sense_clarification": "уходить из поля зрения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gözden kaybolmak",
                                "target_lang_sense_clarification": "görünmez olmak, görüş alanından çıkmak"
                            },
                            {
                                "target_lang_word": "kaybolmak",
                                "target_lang_sense_clarification": "görünmez hale gelmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消失",
                                "target_lang_sense_clarification": "不再可见，从视野中隐去"
                            },
                            {
                                "target_lang_word": "隐没",
                                "target_lang_sense_clarification": "逐渐看不见，隐藏在某物之后"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61911690-34f0-3b3c-86a6-84183c5cf5c6",
                    "sense_definition": "To become lost or impossible to find, often referring to a person.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cease_to_be_perceived",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child <w>disappeared</w> while playing in the crowded park.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>пропал</w>, когда играл в переполненном парке.",
                                "tr": "Çocuk kalabalık parkta oynarken <w>kayboldu</w>.",
                                "zh": "那个孩子在拥挤的公园里玩耍时<w>失踪</w>了。"
                            }
                        },
                        {
                            "text": "Police are investigating why the man <w>disappeared</w> without telling anyone.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует, почему мужчина <w>исчез</w>, никому ничего не сказав.",
                                "tr": "Polis, adamın kimseye bir şey söylemeden neden <w>ortadan kaybolduğunu</w> araştırıyor.",
                                "zh": "警方正在调查那名男子为何没告诉任何人就<w>消失</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vanish",
                        "go missing"
                    ],
                    "antonyms": [
                        "appear"
                    ],
                    "common_phrases": [
                        "disappear without a trace",
                        "mysteriously disappear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потеряться или стать невозможным для нахождения (часто о человеке).",
                        "tr": "Genellikle bir insan için, kaybolmak veya bulunamaz hale gelmek.",
                        "zh": "丢失或无法找到，常指人失踪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропадать",
                                "target_lang_sense_clarification": "теряться, исчезать без вести"
                            },
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "пропадать неизвестно куда"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kaybolmak",
                                "target_lang_sense_clarification": "izini kaybettirmek, bulunamamak"
                            },
                            {
                                "target_lang_word": "ortadan kaybolmak",
                                "target_lang_sense_clarification": "birdenbire yok olmak, sırra kadem basmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失踪",
                                "target_lang_sense_clarification": "下落不明，找不到人"
                            },
                            {
                                "target_lang_word": "走失",
                                "target_lang_sense_clarification": "因迷路或疏忽而失去踪迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbcf7905-c3e3-3216-a87e-57a7ee3cfd12",
                    "sense_definition": "To cease to exist or happen; to come to an end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cease_to_be_perceived",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient civilizations <w>disappeared</w> thousands of years ago.",
                            "target_lang_translations": {
                                "ru": "Многие древние цивилизации <w>исчезли</w> тысячи лет назад.",
                                "tr": "Birçok antik uygarlık binlerce yıl önce <w>yok oldu</w>.",
                                "zh": "许多古代文明在几千年前就<w>消失</w>了。"
                            }
                        },
                        {
                            "text": "If you take this medicine, your headache should <w>disappear</w> quickly.",
                            "target_lang_translations": {
                                "ru": "Если вы примете это лекарство, ваша головная боль должна быстро <w>пройти</w>.",
                                "tr": "Bu ilacı alırsanız baş ağrınız hızla <w>geçmelidir</w>.",
                                "zh": "如果你吃了这药，你的头痛应该很快就会<w>消除</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "perish",
                        "vanish"
                    ],
                    "antonyms": [
                        "appear"
                    ],
                    "common_phrases": [
                        "completely disappear",
                        "gradually disappear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать существовать или происходить; прекратиться.",
                        "tr": "Varlığı sona ermek veya durmak; yok olmak.",
                        "zh": "停止存在或发生；结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "прекращать существование"
                            },
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "прекращаться (о боли, симптомах)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yok olmak",
                                "target_lang_sense_clarification": "varlığı sona ermek"
                            },
                            {
                                "target_lang_word": "geçmek",
                                "target_lang_sense_clarification": "ağrı veya belirtiler için bitmek, sona ermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消失",
                                "target_lang_sense_clarification": "不再存在"
                            },
                            {
                                "target_lang_word": "消除",
                                "target_lang_sense_clarification": "指症状或感觉不再存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                    "sense_definition": "To cause someone to vanish, usually by abducting or killing them for political reasons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator's regime <w>disappeared</w> many political opponents during the war.",
                            "target_lang_translations": {
                                "ru": "Режим диктатора <w>устранил</w> многих политических оппонентов во время войны.",
                                "tr": "Diktatörün rejimi savaş sırasında birçok siyasi muhalifi <w>ortadan kaldırdı</w>.",
                                "zh": "战争期间，独裁政权<w>秘密绑架</w>了许多政治反对派。"
                            }
                        },
                        {
                            "text": "He feared that the secret police would come to <w>disappear</w> him.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что тайная полиция придет, чтобы <w>убрать</w> его.",
                                "tr": "Gizli polisin gelip kendisini <w>ortadan kaldıracağından</w> korkuyordu.",
                                "zh": "他担心秘密警察会来将他<w>除掉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "forcibly disappear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то исчезнуть, обычно путем похищения или убийства по политическим причинам.",
                        "tr": "Siyasi nedenlerle birini kaçırarak veya öldürerek ortadan kaldırmak.",
                        "zh": "使某人消失，通常指因政治原因绑架或杀害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убирать",
                                "target_lang_sense_clarification": "устранять, убивать (эвфемизм)"
                            },
                            {
                                "target_lang_word": "устранять",
                                "target_lang_sense_clarification": "ликвидировать (противников)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ortadan kaldırmak",
                                "target_lang_sense_clarification": "zorla kaybettirmek, yok etmek"
                            },
                            {
                                "target_lang_word": "kaybetmek",
                                "target_lang_sense_clarification": "zorla veya gizlice yok etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秘密绑架",
                                "target_lang_sense_clarification": "指强迫某人失踪"
                            },
                            {
                                "target_lang_word": "除掉",
                                "target_lang_sense_clarification": "指通过暴力手段消除异己"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}