                                                "sense_id": "56d6328d-ea9e-38fa-8fc3-47ace083f8b8",
                                                "text": "Hij heeft altijd veel gezwommen."
                                            },
                                            {
                                                "example_id": "45eae763-402a-4e6c-800f-8699c34f08c8",
                                                "sense_id": "56d6328d-ea9e-38fa-8fc3-47ace083f8b8",
                                                "text": "De hele dag werd er gekaart, vuur gemaakt, gezwommen en geschilderd."
                                            },
                                            {
                                                "example_id": "ea20aa5b-d0b0-4f47-a61f-291e36bec119",
                                                "sense_id": "56d6328d-ea9e-38fa-8fc3-47ace083f8b8",
                                                "text": "Zo ook in het afgelegen dorpje Shelter Cove, waar ik een dag rust nam en met vrienden in het meer zwom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed68e6d-f440-301c-a298-84e3cf775fd1",
                                        "entry_id": "4f2cedd5-7342-3e35-9e49-5161b22e300f",
                                        "glosses": [
                                            "zwemmend ergens heen gaan"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89882115-9ea7-4af2-ae29-d45ee2d7f4fb",
                                                "sense_id": "1ed68e6d-f440-301c-a298-84e3cf775fd1",
                                                "text": "Hij is naar de andere kant gezwommen."
                                            },
                                            {
                                                "example_id": "8416a9b8-3d8e-4982-a106-690624fe5653",
                                                "sense_id": "1ed68e6d-f440-301c-a298-84e3cf775fd1",
                                                "text": "Toen ik ook daar geen succes had, zocht ik weer een andere plek op maar de vissen bleven vrolijk om mijn haak heen zwemmen."
                                            }
                                        ]
