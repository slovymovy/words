                                "target_senses": [
                                    {
                                        "sense_id": "2bbdf00d-7e62-32b6-82dc-0c42fb8c199b",
                                        "entry_id": "b25846e9-4a46-3619-8781-af19143ffb1e",
                                        "glosses": [
                                            "In terms of structure."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52cf3153-32b8-414d-90d8-61d7c3d23153",
                                                "sense_id": "2bbdf00d-7e62-32b6-82dc-0c42fb8c199b",
                                                "text": "After the hurricane, the building was structurally sound but aesthetically displeasing."
                                            },
                                            {
                                                "example_id": "ccd9d77d-b552-48c7-8e2e-3b2d0ed95a78",
                                                "sense_id": "2bbdf00d-7e62-32b6-82dc-0c42fb8c199b",
                                                "text": "Being structurally deficient does not necessarily mean that the bridge is unsafe, but it does mean it’s in need of repair."
                                            },
                                            {
                                                "example_id": "6a382521-5177-4399-80fb-dcb379586b10",
                                                "sense_id": "2bbdf00d-7e62-32b6-82dc-0c42fb8c199b",
                                                "text": "Harringay: The station booking office has been permanently closed, after it was declared structurally unsafe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6540e89d-b22e-409f-9565-4385049b6a06",
