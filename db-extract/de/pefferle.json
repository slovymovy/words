                "senses": [
                    {
                        "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                        "entry_id": "7f704e5a-65e2-30fa-a67c-81b36804ce2d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9222f410-7931-4dfa-ba92-d7f3f3730443",
                                "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                                "text": "Frau Pefferle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "09b58ce8-7712-42bb-97ff-b069243e2ee0",
                                "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                                "text": "Herr Pefferle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ac05ce9f-de00-4f49-8c10-52c975831413",
                                "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                                "text": "Die Pefferles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ab78981f-c6bb-4fd2-a83f-a19edbeb77ec",
                                "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                                "text": "Der Pefferle trägt nie die Pullover, die die Pefferle ihm strickt."
                            },
                            {
                                "example_id": "0e81e66f-acbb-40e7-ba92-7e066d83bcdc",
                                "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pefferle kommt, geht der Herr Pefferle.“"
                            },
                            {
                                "example_id": "0aa75712-639c-45f1-b629-300723decb15",
                                "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                                "text": "Pefferle kommt und geht."
                            },
                            {
                                "example_id": "8926b461-f491-46aa-a0f6-6de517573a4f",
                                "sense_id": "58fd73ea-a229-35ab-a472-35b3c595dd3b",
                                "text": "Pefferles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
