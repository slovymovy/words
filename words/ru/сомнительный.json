                },
                {
                    "sense_id": "e8aa7ff4-017c-3fd3-8e0a-469f4a91c683",
                    "sense_definition": "Вызывающий сомнение в наличии определенного качества или состояния.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Качество этих товаров весьма <w>сомнительно</w>.",
                            "target_lang_translations": {
                                "de": "Die Qualität dieser Waren ist äußerst <w>fraglich</w>."
                            }
                        },
                        {
                            "text": "Его <w>сомнительное</w> удовольствие от работы было заметно всем.",
                            "target_lang_translations": {
                                "de": "Sein <w>zweifelhaftes</w> Vergnügen an der Arbeit war für alle offensichtlich."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сомнительное удовольствие"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи для иронии"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, bei dem das Vorhandensein einer bestimmten Qualität oder eines Zustands in Frage gestellt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fraglich",
                                "target_lang_sense_clarification": "wenn der Wert oder die Qualität einer Sache unklar ist"
                            },
                            {
                                "target_lang_word": "zweifelhaft",
                                "target_lang_sense_clarification": "oft ironisch verwendet, um den Wert einer Sache zu mindern"
                            }
                        ]
                    }
                }
            ]
