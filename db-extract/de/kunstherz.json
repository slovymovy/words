                "senses": [
                    {
                        "sense_id": "39c95f35-0cf1-33a6-8131-125fef788968",
                        "entry_id": "d91e5607-4fd2-3d8f-9ce3-9cdd881f5729",
                        "glosses": [
                            "vorübergehend oder dauerhaft implantiertes Gerät, das die Funktionen eines kranken oder beeinträchtigten Herzens übernehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac8407e-aa76-4c1a-8092-4fbd9c7d879b",
                                "sense_id": "39c95f35-0cf1-33a6-8131-125fef788968",
                                "text": "„Wenn zum Beispiel ein Herzpatient in einem sehr schlechten Zustand ist, wird bei uns sehr schnell ein Kunstherz eingebaut.“"
                            },
                            {
                                "example_id": "a40aaf1b-b19f-467f-9c1b-b484e5f4bd8d",
                                "sense_id": "39c95f35-0cf1-33a6-8131-125fef788968",
                                "text": "„Inzwischen werden die deutlich kleineren Kunstherzen für ältere Patienten wie Aleksic - trotz der Gefahren - immer häufiger zur Dauerlösung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
