                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "to contain as a component or part"
                            },
                            {
                                "target_lang_word": "contain",
                                "target_lang_sense_clarification": "to hold inside"
                            },
                            {
                                "target_lang_word": "include",
                                "target_lang_sense_clarification": "to comprise as part of a whole"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tener",
                                "target_lang_sense_clarification": "incluir o contener elementos"
                            },
                            {
                                "target_lang_word": "contener",
                                "target_lang_sense_clarification": "llevar dentro o incluir"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "comporter",
                                "target_lang_sense_clarification": "contenir dans sa composition"
                            },
                            {
                                "target_lang_word": "contenir",
                                "target_lang_sense_clarification": "renfermer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a193308-3667-321e-9180-67e373a1c2e4",
                    "sense_definition": "Использоваться в устойчивых сочетаниях со значением осуществления какого-либо действия или намерения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_phrases",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не <w>имел</w> намерения вас обидеть своим замечанием.",
                            "target_lang_translations": {
                                "en": "I did not <w>have</w> the intention to offend you with my remark.",
                                "es": "No <w>tenía</w> la intención de ofenderle con mi comentario.",
                                "fr": "Je n'<w>avais</w> pas l'intention de vous offenser avec ma remarque."
                            }
                        },
                        {
                            "text": "Он всегда <w>имеет</w> в виду интересы своей семьи.",
                            "target_lang_translations": {
                                "en": "He always <w>has</w> his family's interests in mind.",
                                "es": "Él siempre <w>tiene</w> en cuenta los intereses de su familia.",
                                "fr": "Il <w>garde</w> toujours à l'esprit les intérêts de sa famille."
                            }
                        }
                    ],
                    "common_phrases": [
                        "иметь намерение",
                        "иметь в виду"
                    ],
                    "target_lang_definitions": {
                        "en": "To be used in set expressions signifying the execution of an action or intention.",
                        "es": "Usarse en expresiones fijas con el significado de realizar una acción o intención.",
                        "fr": "S'employer dans des expressions figées exprimant la réalisation d'une action ou d'une intention."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "used in set phrases like 'have in mind' or 'have intention'"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tener",
                                "target_lang_sense_clarification": "utilizado en frases hechas como tener intención o tener en cuenta"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "utilisé dans des locutions (avoir l'intention, avoir en vue)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "226b6127-b616-3e79-85a3-669968133fb1",
                    "sense_definition": "Быть несогласным с чем-либо, испытывать неприязнь или возражение.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вы что-то <w>имеете</w> против этого предложения?",
                            "target_lang_translations": {
                                "en": "Do you <w>have</w> anything against this proposal?",
                                "es": "¿<w>Tiene</w> algo en contra de esta propuesta?",
                                "fr": "Vous <w>avez</w> quelque chose contre cette proposition ?"
                            }
                        },
                        {
                            "text": "Я ничего не <w>имею</w> против нашей встречи завтра.",
                            "target_lang_translations": {
                                "en": "I <w>have</w> nothing against us meeting tomorrow.",
                                "es": "No <w>tengo</w> nada en contra de nuestra reunión de mañana.",
                                "fr": "Je n'<w>ai</w> rien contre notre rencontre demain."
                            }
                        }
                    ],
                    "common_phrases": [
                        "иметь против",
                        "ничего не иметь против"
                    ],
                    "target_lang_definitions": {
                        "en": "To disagree with something, or to feel an objection/dislike towards it.",
                        "es": "Estar en desacuerdo con algo, sentir rechazo u objeción.",
                        "fr": "Être en désaccord avec quelque chose, éprouver de l'hostilité ou une objection."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "used in phrases like 'have something against'"
                            },
                            {
                                "target_lang_word": "mind",
                                "target_lang_sense_clarification": "to object to something"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tener algo en contra",
                                "target_lang_sense_clarification": "oponerse o no estar de acuerdo con algo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir contre",
                                "target_lang_sense_clarification": "s'opposer à quelque chose"
                            },
                            {
                                "target_lang_word": "objecter",
                                "target_lang_sense_clarification": "émettre une objection"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e04891d-71b4-3ce3-9593-8ea7dc6a5b16",
                    "sense_definition": "Проявлять какое-либо качество или смелость для совершения поступка.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <w>иметь</w> мужество признать свои ошибки.",
                            "target_lang_translations": {
