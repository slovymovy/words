                    {
                        "sense_id": "fd6b4431-d60a-318e-aa9d-d457f00fb5bd",
                        "entry_id": "cafdd2ad-0ac1-3183-809c-65d4525b7723",
                        "glosses": [
                            "hoofdstad van de provincie Groningen\\nGroningen (stad); reisgids: Groningen (stad)"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "21cc7e67-dfb5-4635-8608-2465c6b3d6a8",
                                "sense_id": "fd6b4431-d60a-318e-aa9d-d457f00fb5bd",
                                "text": "Hoewel het bij mijn oudste dochter soms lastig was om een afspraak in haar drukke tieneragenda in te plannen, reden we samen naar Groningen om in mijn oude studentenhuis te logeren en zijn we bezig met een tour om in elke provincie een biefstuk te eten."
                            },
                            {
                                "example_id": "465c6a73-05ff-40d0-a538-f1d0baf2563a",
                                "sense_id": "fd6b4431-d60a-318e-aa9d-d457f00fb5bd",
                                "text": "Het vernieuwde Hoofdstation van Groningen moet op 13 juli weer volledig opengaan."
                            }
                        ]
                    },
