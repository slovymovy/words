                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2c469c-fb33-46ee-804e-7f795d9713c1",
                                "sense_id": "9e769eab-b88d-3692-9895-ab68d57fde19",
                                "text": "Zgadza się, wszystko się zgadza – potwierdził mechanicznie Florczak, zaraz jednak spojrzał z niedowierzaniem na milicjanta. – Że niby jak?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05d0bb6e-5fac-4594-afe4-5ab5ab0a7a75",
                        "source_entry_id": "eb753a4e-a58e-3997-b539-31fa15f1c425",
