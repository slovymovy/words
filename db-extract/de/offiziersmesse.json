                "senses": [
                    {
                        "sense_id": "36bf0bb7-e67e-3a88-9696-021c35fa1d68",
                        "entry_id": "65155722-0ed2-346c-a223-379547ef3d1b",
                        "glosses": [
                            "Wohn- und Speiseraum der Offiziere auf einem Schiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f13c43-63d8-4443-9ab1-f20c194987eb",
                                "sense_id": "36bf0bb7-e67e-3a88-9696-021c35fa1d68",
                                "text": "„Die Forscher konnten mehr als 90 Prozent des Unterdecks untersuchen. Aufnahmen aus dem Schiff zeigen unter anderem Betten und Tische, Regale mit Porzellan und Glasflaschen in der Offiziersmesse und Messgeräte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c93fee62-1d33-3892-8f47-7b6c42b86e28",
                        "entry_id": "65155722-0ed2-346c-a223-379547ef3d1b",
                        "glosses": [
                            "Gruppe von Offizieren, die sich an einem Tisch zusammengefunden hat, zum Beispiel zum Essen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fd14dd-3a1e-4f2d-af40-fa7ba8b4287b",
                                "sense_id": "c93fee62-1d33-3892-8f47-7b6c42b86e28",
                                "text": "Wir freuen uns, wenn Sie heute Abend der Offiziersmesse die Ehre Ihrer Anwesenheit erweisen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
