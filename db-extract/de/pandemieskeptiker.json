                "senses": [
                    {
                        "sense_id": "85eb34da-283d-37c4-9c31-23b4ffef70b2",
                        "entry_id": "f79cfc89-2403-3b0a-a059-833bc4cc8963",
                        "glosses": [
                            "Person, die die Existenz oder Bedeutung einer Pandemie (meist Coronapandemie) anzweifelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8416216-07aa-4793-93a9-59fa6a1ff11a",
                                "sense_id": "85eb34da-283d-37c4-9c31-23b4ffef70b2",
                                "text": "„Eine bundesweite Erhebung über Pandemieskeptiker in der Ärzteschaft gibt es nicht.“"
                            },
                            {
                                "example_id": "e2d21835-c4b5-465b-aeba-f20061305c4b",
                                "sense_id": "85eb34da-283d-37c4-9c31-23b4ffef70b2",
                                "text": "„Deutschland steht das nächste Demowochenende der Pandemieskeptiker bevor.“"
                            },
                            {
                                "example_id": "72551461-8115-471c-b633-023970c0d824",
                                "sense_id": "85eb34da-283d-37c4-9c31-23b4ffef70b2",
                                "text": "„ Diese Woche demonstrierten die Pandemieskeptiker gleich zwei Mal auf dem Bundesplatz.“"
                            },
                            {
                                "example_id": "e9b5a10a-35e7-47f9-8bb1-1291a8509de5",
                                "sense_id": "85eb34da-283d-37c4-9c31-23b4ffef70b2",
                                "text": "„Ich kenne beide Autoren persönlich und habe nach kurzem Zögern unterschrieben. Mir ist nicht verborgen geblieben, dass sie zuletzt den Pandemieskeptikern das Wort redeten, die ich rechts ansiedele, falls diese Sortierung noch was taugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
