                    {
                        "translation_id": "f81684c2-8c55-4421-aa4b-015e0f3e8e59",
                        "source_entry_id": "65587103-f083-3a98-a248-0c341c3416cf",
                        "source_sense_description": "пробел между колонками текста",
                        "target_lang_word": "gutter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gutter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d2f15e9-2a39-37e9-b9be-10dd956eead6",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A prepared channel in a surface, especially at the side of a road adjacent to a curb, intended for the drainage of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d799c3-3524-4dd0-bf40-6f33e04aee85",
                                                "sense_id": "8d2f15e9-2a39-37e9-b9be-10dd956eead6",
                                                "text": "They a not so clean as they might be, since the water [is] carried off by only one gutter, in the centre of t[he] street"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abbd3c5a-bcb4-3b26-ab3e-0169259db7c8",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A ditch along the side of a road."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2acc442-4569-456d-82d7-b6af0ab8c8c7",
                                                "sense_id": "abbd3c5a-bcb4-3b26-ab3e-0169259db7c8",
                                                "text": "In nearly all of the towns the gutters are filled with vegetation, or have been neglected for so long a time that the roadway becomes its own drainage bed."
                                            },
                                            {
                                                "example_id": "a2b400a6-7386-4fc1-926c-db8d2b0f5df2",
                                                "sense_id": "abbd3c5a-bcb4-3b26-ab3e-0169259db7c8",
                                                "text": "‘Children crawled over each other like little grey worms in the gutters,’ he said. ‘The only red things about them were their buttocks and they were raw. Their faces looked as if snails had slimed on them and their mothers were like great sick beasts whose byres had never been cleared.[…]’"
                                            },
                                            {
                                                "example_id": "9fead141-d1c2-44e3-aae4-92fe849aceaf",
                                                "sense_id": "abbd3c5a-bcb4-3b26-ab3e-0169259db7c8",
                                                "text": "As Mike parked the vehicle, its right wheels sank into an unpaved gutter gradually worn irregular and deep by the rush of rainwater flowing down the street."
                                            },
                                            {
                                                "example_id": "0f2eaeff-0aa5-47de-8c3d-f118de3e3af1",
                                                "sense_id": "abbd3c5a-bcb4-3b26-ab3e-0169259db7c8",
                                                "text": "Gutters separated the sidewalk from the road on both sides and flowed with muddy water."
                                            },
                                            {
                                                "example_id": "d3d99bab-e5a2-4fec-9ea8-a44d4df2c23c",
                                                "sense_id": "abbd3c5a-bcb4-3b26-ab3e-0169259db7c8",
                                                "text": "Meltwater gathered in the icy ruts of the unpaved road, the pressure wearing thin channels in the packed snow. Along the gutter the rivulets of spring runoff cut a course to the storm sewer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1405c53-06e2-3ff8-b113-3a61abfd41e9",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A duct or channel beneath the eaves of a building to carry rain water; eavestrough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4722c778-a335-494b-9515-569644e04989",
                                                "sense_id": "b1405c53-06e2-3ff8-b113-3a61abfd41e9",
                                                "text": "The gutters must be cleared of leaves a few times a year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb3584ac-166d-3cb7-b2b6-768dfd43b25f",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A groove down the sides of a bowling lane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df65a0c-8c24-41aa-95f8-09c01e59e8b6",
                                                "sense_id": "cb3584ac-166d-3cb7-b2b6-768dfd43b25f",
                                                "text": "You can decide to use the bumpers to avoid the ball going down the gutter every time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0bb63aa-15e8-37a8-9d81-6ec7cc56da1e",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A large groove (commonly behind animals) in a barn used for the collection and removal of animal excrement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4a8ce8d-895f-32ef-8f97-0434920ea794",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "Any narrow channel or groove, such as one formed by erosion in the vent of a gun from repeated firing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "921cc005-3011-3f83-a288-45aa704a10ac",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A space between printed columns of text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f157622-a08f-335d-9502-00ea11c8a364",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "One of a number of pieces of wood or metal, grooved in the centre, used to separate the pages of type in a form."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19d52738-f4de-3780-8a92-cd58243b9a4f",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "An unprinted space between rows of stamps."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71b65976-b407-3236-87f5-bf7cb577e166",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A drainage channel."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeed7510-b328-32bf-84d7-2644260f9f79",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "The notional locus of things, acts, or events that are distasteful, ill-bred, or morally questionable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a20993e-d1f0-4271-8a0f-d8bbbeadd819",
                                                "sense_id": "eeed7510-b328-32bf-84d7-2644260f9f79",
                                                "text": "Nosei (Löwensohn): This is Tom and Cynthia Kruger. / Jean-Michel Basquiat (Jeffrey Wright): I heard. / Nosei: This is Jean-Michel Basquiat. / Tom Kruger (Chuck Pfeiffer): Hi. / Nosei: You've seen the SAMO graffiti everywhere – that's his. This is the true voice of the gutter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0781e988-bf26-304b-9228-a713fcae905d",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A low, vulgar state."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668f5563-e7d6-4ffe-9c7e-858887a8933c",
                                                "sense_id": "0781e988-bf26-304b-9228-a713fcae905d",
                                                "text": "Get your mind out of the gutter."
                                            },
                                            {
                                                "example_id": "74df348a-2806-46c0-a97a-fe7b13efb1f3",
                                                "sense_id": "0781e988-bf26-304b-9228-a713fcae905d",
                                                "text": "What kind of gutter language is that? I ought to wash your mouth out with soap."
                                            },
                                            {
                                                "example_id": "203c5514-f442-42c8-b8a3-aa1000234389",
                                                "sense_id": "0781e988-bf26-304b-9228-a713fcae905d",
                                                "text": "Lord Darlington. No, we are all in the gutter, but some of us are looking at the stars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "385ff98c-8b77-34cb-85c0-9f1d281eedc7",
                                        "entry_id": "f2169b24-a209-30f5-a8a4-1cbc383f3c95",
                                        "glosses": [
                                            "A space between comic strip panels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gutter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e15ce6c6-1da9-31ce-a93c-bb072accc5eb",
                                        "entry_id": "ee503147-e254-30c9-8915-9236289faaeb",
                                        "glosses": [
                                            "To flow or stream; to form gutters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5614c85-0b29-3b03-aed0-5375601f4b17",
                                        "entry_id": "ee503147-e254-30c9-8915-9236289faaeb",
                                        "glosses": [
                                            "To melt away by having the molten wax run down along the side of the candle."
                                        ],
                                        "tags": [
                                            "of a candle"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2aec1d8f-24dc-321a-8608-9bb6e052667d",
                                        "entry_id": "ee503147-e254-30c9-8915-9236289faaeb",
                                        "glosses": [
                                            "To flicker as if about to be extinguished."
                                        ],
                                        "tags": [
                                            "of a small flame",
                                            "of eyes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880c639e-58ef-427b-b707-3fc9e94311c5",
                                                "sense_id": "2aec1d8f-24dc-321a-8608-9bb6e052667d",
                                                "text": "The light in his eyes guttered like a candle in a mighty wind and finally went out. She had no time to grieve[…]"
                                            },
                                            {
                                                "example_id": "9ea49950-6eb8-4ac5-8dbb-da5b3fb5622f",
                                                "sense_id": "2aec1d8f-24dc-321a-8608-9bb6e052667d",
                                                "text": "Alex's eyes gutter, and his face goes cold. He stands there mutely through my apology, stiff and frozen. I want to touch him, but I'm scared he'll flinch away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c5430b-cbec-304a-ac4c-15251720ba23",
                                        "entry_id": "ee503147-e254-30c9-8915-9236289faaeb",
                                        "glosses": [
                                            "To send (a bowling ball) into the gutter, not hitting any pins."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c61d9a17-a378-3f17-ac73-793637cdfe36",
                                        "entry_id": "ee503147-e254-30c9-8915-9236289faaeb",
                                        "glosses": [
                                            "To supply with a gutter or gutters."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d095ef19-4952-44a3-9652-aa21fdcb3e16",
                                                "sense_id": "c61d9a17-a378-3f17-ac73-793637cdfe36",
                                                "text": "A narrow flooring, guttered, walled, and tiled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c89b76-2559-300d-a6ec-41aef473e1db",
                                        "entry_id": "ee503147-e254-30c9-8915-9236289faaeb",
                                        "glosses": [
                                            "To cut or form into small longitudinal hollows; to channel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c306e71e-a3bf-4362-a04f-617762c51906",
                                                "sense_id": "e0c89b76-2559-300d-a6ec-41aef473e1db",
                                                "text": "The gutter'd-Rockes, and Congregated Sands,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598f7f07-251e-3e04-8c05-153f73bea0c9",
                                        "entry_id": "ee503147-e254-30c9-8915-9236289faaeb",
                                        "glosses": [
                                            "To make worse; to show emphasis that something has gotten worse."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06e1154-256a-4d2e-bed3-985fa70808c9",
                                                "sense_id": "598f7f07-251e-3e04-8c05-153f73bea0c9",
                                                "text": "The students' performance guttered after the school event."
                                            },
                                            {
                                                "example_id": "0cfb1960-bec5-445a-99d9-6ef093427ef3",
                                                "sense_id": "598f7f07-251e-3e04-8c05-153f73bea0c9",
                                                "text": "The patient's state would soon gutter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
