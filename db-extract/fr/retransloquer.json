                "senses": [
                    {
                        "sense_id": "788c8db4-a159-3a46-a8c1-048d2faf6359",
                        "entry_id": "06b761e8-c4e5-3b63-854f-195b18ed7e06",
                        "glosses": [
                            "Transloquer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ac2976-42f8-4ab3-8ba4-0b4bd0f21175",
                                "sense_id": "788c8db4-a159-3a46-a8c1-048d2faf6359",
                                "text": "Les protéines du RE mal repliées ou mal assemblées sont détectées et retransloquées dans le cytosol pour leur dégradation par des protéasomes."
                            },
                            {
                                "example_id": "4447254c-e04d-4004-8e00-50bb55e422d8",
                                "sense_id": "788c8db4-a159-3a46-a8c1-048d2faf6359",
                                "text": "Les rapports molaires S:N des produits retransloqués des cimes de ces forêts feuillues nordiques étaient plus faibles que ceux du feuillage à la mi-juillet, ou que de la litière, et n'ont pas montré de tendance géographique reliée aux dépositions, suggérant que S et N sont retransloqués dans des proportions relativement constantes."
                            }
                        ]
                    }
