                                "target_senses": [
                                    {
                                        "sense_id": "37f454e1-b9c2-3532-a649-2f3f6f6f8b37",
                                        "entry_id": "8dce59ed-5c92-32a9-aeb2-a5cc4d95aa44",
                                        "glosses": [
                                            "Qui mange du poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23545188-77f9-441f-8ae6-781b44506013",
                                                "sense_id": "37f454e1-b9c2-3532-a649-2f3f6f6f8b37",
                                                "text": "Le chasseur Sabine parvint à abattre une couple de ces gigantesques orfraies, […], — magnifiques échantillons de ces oiseaux voyageurs, exclusivement ichtyophages, que l’hiver chasse jusqu’aux rivages du golfe du Mexique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ichtyophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fda98100-f47d-34dc-9b09-27541cb0a960",
                                        "entry_id": "be923f83-9262-3ec0-b8cb-c94b3b79b03e",
                                        "glosses": [
                                            "Personne qui mange du poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1627533-e4c0-4763-9e38-c72aba169f10",
                                                "sense_id": "fda98100-f47d-34dc-9b09-27541cb0a960",
                                                "text": "Tout le monde sait que le Norvégien est un ichtyophage décidé : plus de 40 kg par an et par habitant, en 1965/66."
                                            },
                                            {
                                                "example_id": "f4f08287-d4ea-4fba-96ac-675fb0b14fd4",
                                                "sense_id": "fda98100-f47d-34dc-9b09-27541cb0a960",
                                                "text": "Nous dûmes paraître des ichtyophages et des carnivores de première force…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f00a05a6-4689-435b-8aff-199287beac18",
                        "source_entry_id": "054c416d-faad-397e-9b59-de7e2eb506b2",
                        "source_sense_id": "72e8cad3-22ae-38e0-bf73-b30edea518f8",
                        "source_sense_description": "eating fish",
                        "target_lang_word": "piscivore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piscivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11d92590-fc94-3b2f-b150-73ee25e3a839",
                                        "entry_id": "e2b4f8c4-ba02-3b4e-a8b6-4b9ef0ac2e69",
                                        "glosses": [
                                            "Qui se nourrit principalement de poissons."
                                        ],
                                        "tags": [
                                            "Écologie aquatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4379939e-fa7a-4f99-8661-5fe0e4e99b0c",
                                                "sense_id": "11d92590-fc94-3b2f-b150-73ee25e3a839",
                                                "text": "De manière similaire, aux États-Unis, une équipe de bénévoles encadrée par le biologiste Marco Restani suit depuis 2012 des nids de balbuzards pêcheurs – une espèce de rapace piscivore – le long de la rivière Yellowstone, dans le Montana."
                                            },
                                            {
                                                "example_id": "620792cd-3be1-4cc2-a4e8-cee6b3c60296",
                                                "sense_id": "11d92590-fc94-3b2f-b150-73ee25e3a839",
                                                "text": "Lancées dans leur partie de pêche, des chauves-souris piscivores frôlent la surface."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piscivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9af4a89-406c-3999-8b59-344a971da477",
                                        "entry_id": "44bceba7-65a5-335d-8bb0-730a6a88ca9e",
                                        "glosses": [
                                            "Animal dont le régime alimentaire est constitué principalement de poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d6baaa-f252-421c-80d1-c3e4d0f8589a",
                                                "sense_id": "f9af4a89-406c-3999-8b59-344a971da477",
                                                "text": "L’ours est un piscivore."
                                            },
                                            {
                                                "example_id": "a5d3967a-0bcf-4f57-833e-4463b5cb2c8a",
                                                "sense_id": "f9af4a89-406c-3999-8b59-344a971da477",
                                                "text": "Le piscivore est un animal qui se nourrit ordinairement de poissons, le suffixe –vore signifiant « qui mange »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
