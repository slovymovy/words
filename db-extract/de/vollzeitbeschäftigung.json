                "senses": [
                    {
                        "sense_id": "b887fee0-f9cb-31ec-a59b-8d429b701fb5",
                        "entry_id": "f67443d3-fcd7-3582-a90f-1ce038ec6ddd",
                        "glosses": [
                            "Beschäftigung (Arbeit), bei der man mehr als 40 Stunden pro Woche arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d262b6c-9b88-47c5-a4ec-6336775c6052",
                                "sense_id": "b887fee0-f9cb-31ec-a59b-8d429b701fb5",
                                "text": "„»Früher haben Frauen den Haushalt in Vollzeitbeschäftigung geführt, aber das hat sich geändert«, sagt Menzel, »heute muss das oft nebenherlaufen.“"
                            },
                            {
                                "example_id": "12010c4b-9699-49d7-9ec6-0d67a30adb0a",
                                "sense_id": "b887fee0-f9cb-31ec-a59b-8d429b701fb5",
                                "text": "„Es war eine Vollzeitbeschäftigung, wenn man zu klugen Vorhersagen für mögliche Gewinner kommen wollte, und Geld konnte man damit nicht machen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
