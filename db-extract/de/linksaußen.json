                "senses": [
                    {
                        "sense_id": "572baa27-00c2-320e-b250-d1bec18a6139",
                        "entry_id": "19e47387-69a6-374c-b84e-72b40f33dc43",
                        "glosses": [
                            "Stürmer, der auf dem Spielfeld auf der äußersten linken Seite spielt"
                        ],
                        "tags": [
                            "bei Ballspielen"
                        ],
                        "examples": [
                            {
                                "example_id": "e4f702db-e446-4682-90d3-c151f4ec5bb2",
                                "sense_id": "572baa27-00c2-320e-b250-d1bec18a6139",
                                "text": "„Beim Saisonauftaktspiel in Hannover-Burgdorf war er mit der Angriffsleistung allgemein nicht zufrieden, das betraf auch die Linksaußen.“"
                            },
                            {
                                "example_id": "cf489e21-f5b2-4c7f-9a68-c50b23f92575",
                                "sense_id": "572baa27-00c2-320e-b250-d1bec18a6139",
                                "text": "„Der junge Linksaußen ist nur per Zweitspielrecht für die Wallauer aktiv.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08bc9c5c-90b7-373a-8c95-80c48d9aea79",
                        "entry_id": "19e47387-69a6-374c-b84e-72b40f33dc43",
                        "glosses": [
                            "Vertreter des linken Flügels innerhalb einer politischen Partei"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "41d3c33e-ecaf-424e-ba0e-9b1c246ffd2b",
                                "sense_id": "08bc9c5c-90b7-373a-8c95-80c48d9aea79",
                                "text": "„Denn die Traditionalisten um den Linksaußen Dieter Dehm wollen nicht nur zwei Gegenanträge vorlegen, die eine deutlichere Opposition und einen schärferen Kurs gegen die gegenwärtige Sozialpolitik fordern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
