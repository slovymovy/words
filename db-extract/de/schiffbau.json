                "senses": [
                    {
                        "sense_id": "b0d8f7ee-9fc8-37dd-81e5-b9f8ad5881e7",
                        "entry_id": "d3aff78f-c306-3655-b036-56f35adfb8ab",
                        "glosses": [
                            "das Bauen von Schiffen"
