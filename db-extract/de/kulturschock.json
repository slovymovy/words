                        ],
                        "form": "die Kulturschocks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dd33379-48e1-37a6-85af-45d09f41e6a9",
                        "entry_id": "1baa5621-0a1d-3960-a34c-1fb05e4ebcaf",
                        "glosses": [
                            "große Überraschung/Widerstand, ausgelöst durch die Konfrontation mit von den eigenen abweichenden kulturellen Eigenheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "076a8718-2de1-464c-98f9-3c1c193511a2",
                                "sense_id": "9dd33379-48e1-37a6-85af-45d09f41e6a9",
                                "text": "„Ja, ich bin ja nicht so wahnsinnig, meiner Traumfrau den Kulturschock zuzumuten, den schon unzählige Polinnen in Deutschland erleben mussten.“"
                            },
                            {
                                "example_id": "9403f6a3-e02c-461c-87ef-25f0c671d166",
                                "sense_id": "9dd33379-48e1-37a6-85af-45d09f41e6a9",
                                "text": "„In den individuellen Reaktionen der Emigranten zeichnen sich, als Ergebnis der Konfrontation eines traditionellen europäischen Bildungsverständnisses mit den Gegebenheiten des demokratischen Massenkultur-Betriebs, die Konturen eines »Kulturschocks« ab.“"
                            },
                            {
                                "example_id": "1b54aa41-ac4d-421b-a996-37decbdc58ef",
                                "sense_id": "9dd33379-48e1-37a6-85af-45d09f41e6a9",
                                "text": "„Von Kulturschock konnte bei mir keine Rede sein, da ich mit der europäischen Kultur, in ihrer französischen Spielart, vertraut war, …“"
                            },
                            {
                                "example_id": "bc22d3f1-9133-4e61-b6a8-77193ca83be6",
                                "sense_id": "9dd33379-48e1-37a6-85af-45d09f41e6a9",
                                "text": "„Beinahe alles schmeckt dort so herausragend, dass ein mit Fastfood aufgewachsener Ausländer einen Kulturschock bekommt, wenn er mit der kaukasischen Küche in Berührung kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05328fbe-4135-45cd-8d63-a918831057a3",
                        "source_entry_id": "1baa5621-0a1d-3960-a34c-1fb05e4ebcaf",
                        "source_sense_id": "9dd33379-48e1-37a6-85af-45d09f41e6a9",
                        "target_lang_word": "culture shock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culture shock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8447fb0b-bf01-3291-a0a0-b6881c371d7a",
                                        "entry_id": "da7e1506-07f6-3729-a369-147b9a854c80",
                                        "glosses": [
                                            "A state of anxious confusion experienced by someone exposed to an alien or unfamiliar environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c9c138e-5426-4dc0-beac-8f16778fb37c",
                                                "sense_id": "8447fb0b-bf01-3291-a0a0-b6881c371d7a",
                                                "text": "Having grown up in rural Arkansas, I experienced tremendous culture shock on moving to Harlem."
                                            },
                                            {
                                                "example_id": "ecf64e25-4c14-4083-b86d-8ccb889c1ff1",
                                                "sense_id": "8447fb0b-bf01-3291-a0a0-b6881c371d7a",
                                                "text": "I went through another, reverse culture shock when I got back to Israel and the efort ^([sic]) required to change from cherished and catered-to visitor to an ordinary working woman kept me away from my typewriter jor ^([sic]) months."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee9a7d98-69d8-4d15-a074-e606314402ae",
                        "source_entry_id": "1baa5621-0a1d-3960-a34c-1fb05e4ebcaf",
