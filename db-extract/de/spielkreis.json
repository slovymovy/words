                ],
                "senses": [
                    {
                        "sense_id": "d3543d8e-cc78-32fa-9938-7d6b0753a81f",
                        "entry_id": "913ff70d-9ca5-31bb-a666-6e2da26fc314",
                        "glosses": [
                            "Runde von Menschen, die sich zum gemeinsamen Spielen treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9479b0df-06da-4332-a5cb-a028870fb2a7",
                                "sense_id": "d3543d8e-cc78-32fa-9938-7d6b0753a81f",
                                "text": "„In jeder größeren Stadt gibt es öffentliche Spielkreise und finden Spielveranstaltungen statt.“"
                            },
                            {
                                "example_id": "3d63b7e3-c879-4d6d-9677-a17bf26a1ae9",
                                "sense_id": "d3543d8e-cc78-32fa-9938-7d6b0753a81f",
                                "text": "„Während aber gegen Gemeinsamkeiten im Spielkreis kaum Einwände erhoben werden, stoßen Integrationsbemühungen in der Regelschule auf Skepsis bei vielen Sonderpädagogen und Schulverwaltungen – die leistungsorientierte Normalschule könne auf die Bedürfnisse Behinderter nicht eingehen.“"
                            },
                            {
                                "example_id": "10a12c7b-d0fa-4ea3-9c51-542aae30904a",
                                "sense_id": "d3543d8e-cc78-32fa-9938-7d6b0753a81f",
                                "text": "„Es geht schließlich auch darum, gegen die Konkurrenz aus dem Spielkreis selbst in die Endrunde zu kommen.“"
                            },
                            {
                                "example_id": "65ca6c67-ec0a-446d-856e-c97cd810f580",
                                "sense_id": "d3543d8e-cc78-32fa-9938-7d6b0753a81f",
                                "text": "„Nach Enttäuschungen über den städtischen Kindergarten haben Koops zusammen mit einigen anderen Eltern für zehn Kinder einen privaten Spielkreis gegründet, den eine erfahrene Waldorf-Erzieherin leitet.“"
                            },
                            {
                                "example_id": "02a11ff7-9df6-474a-bc3c-7e6fe87b5f6e",
                                "sense_id": "d3543d8e-cc78-32fa-9938-7d6b0753a81f",
                                "text": "„Seine Verantwortung besteht darin, sagt Michael, daß er nicht mehr zu jeder Demo läuft, sich dafür aber für konkrete Veränderungen einsetzt, zum Beispiel für den Spielkreis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
