                        "glosses": [
                            "Reptile appartenant à un sous-ordre comprenant une quinzaine de familles de reptiles squamates tétrapodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce3a2dc-d86a-4975-b755-2fd2533fde04",
                                "sense_id": "662ddd4a-3660-3833-8d22-1fc0bab58871",
                                "text": "Les iguanes, les caméléons, les geckos, les lézards sont des lacertiliens."
                            },
                            {
                                "example_id": "ded6254f-1a0c-415d-8e72-bd2f1090b8a8",
                                "sense_id": "662ddd4a-3660-3833-8d22-1fc0bab58871",
                                "text": "Son corps d’émeraude est celui d’un lacertilien et sa longue queue s’enroule sur elle-même."
                            }
                        ]
                    }
