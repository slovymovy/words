                    {
                        "sense_id": "151f55c0-9b82-3c4a-90c6-efe23ab184a9",
                        "entry_id": "81152241-441c-3c2a-a343-9ee1bb71a5e9",
                        "glosses": [
                            "Gremium, das über die Mitteilung einer unerwünschten Situation oder ein Fehlverhalten berät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c70b96ac-c877-40dd-a9e9-576ccb367323",
                                "sense_id": "151f55c0-9b82-3c4a-90c6-efe23ab184a9",
                                "text": "„Der Beschwerdeausschuss des Presserats hatte sich am Dienstag mit der Kolumne in der ‚taz‘ vom 15. Juni beschäftigt.“"
                            },
                            {
                                "example_id": "7911b460-bc1c-4fc3-8afa-e5c4740935a3",
                                "sense_id": "151f55c0-9b82-3c4a-90c6-efe23ab184a9",
                                "text": "„Der Beschwerdeausschuss des Presserats erkannte darin mehrere schwere Verstöße gegen die journalistische Sorgfaltspflicht nach Ziffer 2 des Pressekodex.“"
                            },
                            {
                                "example_id": "3224bd77-8428-4648-a36a-ff28a4fb965d",
                                "sense_id": "151f55c0-9b82-3c4a-90c6-efe23ab184a9",
                                "text": "„Kein Wunder also, dass die Mitglieder des Beschwerdeausschusses ‚mit überwiegender Mehrheit zu dem Schluss kamen, dass der Text nicht gegen die Menschenwürde von Polizistinnen und Polizisten nach Ziffer 1 des Pressekodex verstößt, da sich die Kritik auf eine ganze Berufsgruppe und nicht auf Einzelpersonen bezieht‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
