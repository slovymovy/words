                                        "sense_id": "d211101d-d83e-37af-8dd8-fce223c75305",
                                        "entry_id": "dfd01807-2715-354b-b4b8-c3b2126cf121",
                                        "glosses": [
                                            "Schale oder Fläche mit Löchern zum Trennen gemischter verschiedenartiger Bestandteile; auch im übertragenen Sinne verwendet (Sieb des Eratosthenes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9940bd33-0828-40ad-952f-c5052eb63db4",
                                                "sense_id": "d211101d-d83e-37af-8dd8-fce223c75305",
                                                "text": "Mit dem Sieb werden die festen von den flüssigen Bestandteilen getrennt."
                                            }
