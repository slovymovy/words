                        "sense_id": "8a505c22-6d4e-3452-bbc0-e900e73752ba",
                        "entry_id": "fa4aaf81-5aca-300a-beee-59f7be2bf7fd",
                        "glosses": [
                            "um das Verbindende hervorzuheben, besonders auch das zweier ehemaliger Gegner"
                        ],
                        "tags": [
                            "symbolhaft"
                        ],
                        "examples": [
                            {
                                "example_id": "789ff1e7-d775-4c6d-8ebb-69a3f788f6e4",
                                "sense_id": "8a505c22-6d4e-3452-bbc0-e900e73752ba",
                                "text": "So reich' mir deine Bruderhand, mein Freund, dass wir besiegeln unsern Bund."
                            },
                            {
                                "example_id": "1bbe5566-96d6-4198-8298-7cea07b94379",
                                "sense_id": "8a505c22-6d4e-3452-bbc0-e900e73752ba",
                                "text": "„Trotz alledem und alledem, | es kommt dazu trotz alledem, | dass rings der Mensch die Bruderhand | dem Menschen reicht trotz alledem!“ (Letzte Zeilen aus dem Gedicht Trotz alledem von Wikipedia-Artikel „Ferdinand Freiligrath“)"
                            },
                            {
                                "example_id": "3ae9e8ab-4c1f-4fff-beef-8ad3de6bcb80",
                                "sense_id": "8a505c22-6d4e-3452-bbc0-e900e73752ba",
                                "text": "„Reicht die Bruderhand als schönste aller Gaben | Übern Graben, Leute, übern Graben!“ (Letzte Zeilen aus dem Gedicht Der Graben von Wikipedia-Artikel „Kurt Tucholsky“)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
