        "de-extract.jsonl": [
            {
                "entry_id": "09f31492-7390-3d50-84ca-47a202896ccb",
                "word": "perdu",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "f4c5b6ee-b49f-4736-80e5-77ca97a534b4",
                        "entry_id": "09f31492-7390-3d50-84ca-47a202896ccb",
                        "tags": [
                            "positive"
                        ],
                        "form": "perdu"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d4c72e9-0206-3fde-8c16-300fbaf39cd9",
                        "entry_id": "09f31492-7390-3d50-84ca-47a202896ccb",
                        "glosses": [
                            "veraltend: verloren, nicht mehr da"
                        ],
                        "tags": [
                            "umgangssprachlich,"
                        ],
                        "examples": [
                            {
                                "example_id": "a9122869-cc72-44e3-8d48-368673a92e5d",
                                "sense_id": "6d4c72e9-0206-3fde-8c16-300fbaf39cd9",
                                "text": "„Manche mögen davor Angst haben, weil sie befürchten, ohne »richtige« Männer und Frauen wäre auch Sex sinnlos und alle Freude am Leben perdu.“"
                            },
                            {
                                "example_id": "1db3bcfb-4cf9-433a-b477-7e023510e29c",
                                "sense_id": "6d4c72e9-0206-3fde-8c16-300fbaf39cd9",
                                "text": "Bei „Max und Moritz“ heißt es: „Jeder denkt, die sind perdü! Aber nein! – noch leben sie!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49120615-1f32-4ace-bc42-72a7d87c0123",
                        "source_entry_id": "09f31492-7390-3d50-84ca-47a202896ccb",
                        "source_sense_id": "6d4c72e9-0206-3fde-8c16-300fbaf39cd9",
                        "target_lang_word": "gone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gone",
