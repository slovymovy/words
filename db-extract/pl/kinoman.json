                "senses": [
                    {
                        "sense_id": "0f095494-e3ee-3d30-a92a-ba2c7d83f028",
                        "entry_id": "067c86fe-bc7a-3819-89c4-7ef767de5ae8",
                        "glosses": [
                            "miłośnik kina, filmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6804d4f2-5dd3-44d6-9023-1f0120da428f",
                                "sense_id": "0f095494-e3ee-3d30-a92a-ba2c7d83f028",
                                "text": "Przed premierą filmu, przed kasami kłębił się tłum kinomanów."
                            },
                            {
                                "example_id": "0701f98d-13a4-4428-9f52-50924d27fdb1",
                                "sense_id": "0f095494-e3ee-3d30-a92a-ba2c7d83f028",
                                "text": "Będąc żarliwym kinomanem, Bartosz nie opuści żadnego maratonu filmowego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb229e7c-910e-45b5-b162-6f930fc13fb4",
