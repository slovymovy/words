                        "glosses": [
                            "door de mensen aangelegd meer waarin men kan zwemmen; vijver waarin men ook kan zwemmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f08b26ac-30b0-46b4-ae39-876789485d5a",
                                "sense_id": "b5477ef3-850f-3365-9d1f-a8021d6066ce",
                                "text": "Berichten dat er wellicht daarom een lijn met boeien ontbrak, waardoor er geen onderscheid werd aangegeven tussen het ondiepe en diepere gedeelte van de zwemvijver, kent de beheerder niet. „Daar weet ik niets van.”"
                            },
                            {
                                "example_id": "bd9d5a9b-15c4-415e-9a29-782b29b78e5d",
                                "sense_id": "b5477ef3-850f-3365-9d1f-a8021d6066ce",
                                "text": "De brandweerpost Vroomshoop beleefde een drukke woensdagavond met meerdere buitenbrandjes in Westerhaar, maar verzorgde tegelijk wat waterpret: de brandweerlieden liet jeugd de brand bij de zwemvijver nablussen."
                            }
                        ]
                    }
