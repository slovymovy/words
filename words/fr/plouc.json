                {
                    "sense_id": "3f256614-b6fe-3b5c-885a-68e243c81f9b",
                    "sense_definition": "Personne jugée rustre, naïve ou manquant d'élégance et de manières citadines ; péquenaud.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'est jamais allé en ville et se comporte comme un vrai <w>plouc</w> dès qu'il prend le métro."
                        },
                        {
                            "text": "Ces citadins prétentieux traitent souvent tous les provinciaux de <w>ploucs</w> sans les connaître."
                        }
                    ],
                    "synonyms": [
                        "péquenaud"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "4c9a2c07-4eae-3575-9c09-53c74627009d",
                    "sense_definition": "Habitant de la campagne ou paysan, perçu de façon péjorative ou stéréotypée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le village semblait complètement isolé et habité uniquement par quelques <w>ploucs</w>."
                        },
                        {
                            "text": "Ce livre raconte avec humour la vie quotidienne d'un jeune <w>plouc</w> au milieu des champs."
                        }
                    ],
                    "synonyms": [
                        "paysan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "37d1e969-812b-34e3-909b-3ad033dd58ff",
                    "sense_definition": "Simple soldat sans grade dans le vocabulaire militaire familier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant son service militaire, il n'était qu'un simple <w>plouc</w> obéissant aux ordres."
                        },
                        {
                            "text": "Le sergent passait ses journées à crier sur les nouveaux <w>ploucs</w> arrivés à la caserne."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "militaire"
                        }
