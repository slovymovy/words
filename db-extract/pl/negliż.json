                    {
                        "translation_id": "f2e07398-a124-48c1-b3a1-26701588a0f1",
                        "source_entry_id": "5a9c14dd-2c13-32ab-b31a-fe62be879880",
                        "source_sense_id": "46feff58-5c43-31a9-81d0-520c1f4f2d8a",
                        "target_lang_word": "négligée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "négligée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a669935-13b9-39ba-b7d5-d9d781dd8956",
                                        "entry_id": "57aacf3f-973e-37ea-942e-380fc2da9977",
                                        "glosses": [
                                            "Féminin singulier de négligé."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fddc61b0-a99d-41a9-a1aa-d4709a8abc91",
                                                "sense_id": "0a669935-13b9-39ba-b7d5-d9d781dd8956",
                                                "text": "Fait assez inhabituel, il avait gardé sur sa chemise le harnachement de son holster, ceinturage de cuir toujours un peu impressionnant, qui contrastait avec sa tenue négligée, la chemise fripée, le pantalon de toile fatigué, les pieds nus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "négligée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c747ece6-04bd-3427-b48d-24abae7be2aa",
                                        "entry_id": "f9a9de2a-d0cd-3662-b6fd-5f43dd11e975",
                                        "glosses": [
                                            "Participe passé au féminin de négliger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e156473-349c-4b77-b2be-c82171f375f4",
                        "source_entry_id": "5a9c14dd-2c13-32ab-b31a-fe62be879880",
                        "source_sense_id": "46feff58-5c43-31a9-81d0-520c1f4f2d8a",
                        "target_lang_word": "неглиже",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неглиже",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "72910feb-97ee-3bb3-9172-fbc541dd0d5e",
                                        "entry_id": "23d836cc-6ac0-381a-8018-3fd2aa199613",
                                        "glosses": [
                                            "лёгкая домашняя (преимущественно утренняя) одежда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110857bc-2ca2-473a-8cf7-0839cc646ec0",
                                                "sense_id": "72910feb-97ee-3bb3-9172-fbc541dd0d5e",
                                                "text": "Она сидела в своей комнате и разливала чай; против неё сидел у стола Игнатий Кузьмич в совершеннейшем утреннем неглиже, которое только можно себе представить."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d33af0-5976-3efc-bdd0-4c3f8b63416a",
                                        "entry_id": "23d836cc-6ac0-381a-8018-3fd2aa199613",
                                        "glosses": [
                                            "одетый в такую одежду"
                                        ],
                                        "tags": [
                                            "в знач. нескл. прил."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e8dac06-f092-4391-ac0f-6def0a3e9133",
                                                "sense_id": "21d33af0-5976-3efc-bdd0-4c3f8b63416a",
                                                "text": "Фемида просто, какова есть, в неглиже и халате принимала гостей."
                                            },
                                            {
                                                "example_id": "290507a1-f81a-473b-8390-633234b1dd7e",
                                                "sense_id": "21d33af0-5976-3efc-bdd0-4c3f8b63416a",
                                                "text": "Наконец, для полноты картины, Петрушка, следуя любимому своему обыкновению ходить всегда в неглиже, по-домашнему, был и теперь босиком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "882fb132-385f-3d95-b205-b42c69f3c470",
                                        "entry_id": "23d836cc-6ac0-381a-8018-3fd2aa199613",
                                        "glosses": [
                                            "небрежно одевшись, в неприбранном, небрежном виде"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "486d844b-b6aa-42c6-9f8b-3d2151847f75",
                                                "sense_id": "882fb132-385f-3d95-b205-b42c69f3c470",
                                                "text": "Лишь только опустили занавес, со всех сторон высыпали на сцену актеры и актрисы в неглиже, танцовщики и танцовщицы, и проч. и проч."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
