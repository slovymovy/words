                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for <w>green</w> bacon rather than the smoked variety.",
                            "target_lang_translations": {
                                "ru": "В рецепте требуется <w>некопчёный</w> бекон, а не копчёный."
                            }
                        },
                        {
                            "text": "He preferred the taste of <w>green</w> ham for this specific dish.",
                            "target_lang_translations": {
                                "ru": "Для этого блюда он предпочёл вкус <w>сырого</w> окорока."
                            }
                        }
                    ],
                    "synonyms": [
                        "raw",
                        "unprocessed",
                        "unsmoked"
                    ],
                    "antonyms": [
                        "processed",
                        "smoked",
                        "spiced"
                    ],
                    "common_phrases": [
                        "green bacon",
                        "green ham"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необработанный, сырой, некопчёный (о беконе или мясе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сырой",
                                "target_lang_sense_clarification": "необработанный"
