                        "sense_id": "2b68911c-08f6-3bcd-9f70-1f02ed178586",
                        "entry_id": "987401a5-1725-37d8-bcff-3893af27339a",
                        "glosses": [
                            "действие по значению гл. жарить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa38c372-c565-4be5-9f72-31a67ff5c75a",
                                "sense_id": "2b68911c-08f6-3bcd-9f70-1f02ed178586",
                                "text": "Для жарения во фритюре удобно пользоваться глубокой посудой, обжариваемый продукт должен быть полностью погружён в кипящий жир (фритюр)."
                            }
