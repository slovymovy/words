                "senses": [
                    {
                        "sense_id": "f9986aa6-93ed-36ff-ae91-156d27a1c936",
                        "entry_id": "49953bad-7718-3e7f-9550-430e2263f570",
                        "glosses": [
                            "innere Befriedigung, Erfüllung im eigenen Leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0d90760-d9ae-4a77-8948-f76a527b67f0",
                                "sense_id": "f9986aa6-93ed-36ff-ae91-156d27a1c936",
                                "text": "„So findet Mario, der nur seinen Eltern zuliebe Rechtswissenschaften studierte, sein Lebensglück im Sammeln von Antiquitäten und wandelt die Wohnung der verstorbenen Eltern in eine Pension um.“"
                            },
                            {
                                "example_id": "74fc3316-a881-4862-8298-0f09f9450194",
                                "sense_id": "f9986aa6-93ed-36ff-ae91-156d27a1c936",
                                "text": "„Es ist tatsächlich die reine Politik, der er seine künftigen Jahre und das Lebensglück seiner Ausgeschauten (das ihn keine Sekunde kümmert) aufzuopfern gedenkt.“"
                            },
                            {
                                "example_id": "82194e99-2425-4289-9545-6e91ef596a98",
                                "sense_id": "f9986aa6-93ed-36ff-ae91-156d27a1c936",
                                "text": "„Ohne Lebensglück wiegen all unsere Erfolge nicht viel, ist aller Reichtum sinnlos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
