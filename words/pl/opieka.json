                    "sense_id": "c85dd1c4-e05a-3974-8769-8ce80681d79d",
                    "sense_definition": "dbanie o kogoś lub o coś, troszczenie się o czyjeś dobro i bezpieczeństwo",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opieka_ogolna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Małe dzieci bardzo potrzebują stałej <w>opieki</w> ze strony rodziców.",
                            "target_lang_translations": {
                                "ru": "Маленькие дети очень нуждаются в постоянной <w>заботе</w> со стороны родителей."
                            }
                        },
                        {
                            "text": "Starsza pani wymaga codziennej pomocy i medycznej <w>opieki</w>.",
                            "target_lang_translations": {
                                "ru": "Пожилая женщина требует ежедневной помощи и медицинского <w>ухода</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dbanie",
                        "dbałość",
                        "ochrona",
                        "piecza"
                    ],
                    "common_phrases": [
                        "opieka medyczna",
                        "opieka zdrowotna",
                        "otoczyć opieką"
                    ],
                    "target_lang_definitions": {
                        "ru": "забота о ком-либо или чём-либо, внимание к чьему-либо благополучию и безопасности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забота",
                                "target_lang_sense_clarification": "внимание, уход и попечение"
                            },
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "бытовая или медицинская помощь, присмотр"
                            },
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "покровительство, забота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2d7eded-be7b-3688-ac93-a7fd12b6ccc9",
                    "sense_definition": "formalny lub prawny nadzór nad osobą małoletnią lub ubezwłasnowolnioną",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opieka_prawna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po rozwodzie sąd przyznał ojcu pełną <w>opiekę</w> nad dziećmi.",
                            "target_lang_translations": {
                                "ru": "После развода суд передал отцу полную <w>опеку</w> над детьми."
                            }
                        },
                        {
                            "text": "Dziadkowie wystąpili do sądu rodzinnego o prawną <w>opiekę</w> nad osieroconym wnukiem.",
                            "target_lang_translations": {
                                "ru": "Бабушка и дедушка обратились в суд по семейным делам за оформлением законного <w>попечительства</w> над осиротевшим внуком."
                            }
                        }
                    ],
                    "synonyms": [
                        "kuratela",
                        "piecza"
                    ],
                    "common_phrases": [
                        "opieka rodzicielska",
                        "opieka prawna",
                        "opieka naprzemienna"
                    ],
                    "target_lang_definitions": {
