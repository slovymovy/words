{
    "word_family": [
        "kronkel",
        "kronkeling",
        "kronkelweg",
        "kronkelpad",
        "kronkelvormig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0525a269-a4fa-38d9-96e1-82859aa0c9c3",
                    "sense_definition": "In veel bochten ergens heen lopen of bewegen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het smalle bergpad <w>kronkelt</w> langzaam naar boven.",
                            "target_lang_translations": {
                                "en": "The narrow mountain path <w>winds</w> slowly upwards."
                            }
                        },
                        {
                            "text": "De rivier <w>kronkelt</w> door het groene landschap.",
                            "target_lang_translations": {
                                "en": "The river <w>meanders</w> through the green landscape."
                            }
                        }
                    ],
                    "synonyms": [
                        "slingeren"
                    ],
                    "common_phrases": [
                        "kronkelend pad",
                        "kronkelende rivier"
                    ],
                    "target_lang_definitions": {
                        "en": "To move or run in many curves or bends."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to wind",
                                "target_lang_sense_clarification": "of a road or river"
                            },
                            {
                                "target_lang_word": "to meander",
                                "target_lang_sense_clarification": "of a river or path"
                            },
                            {
                                "target_lang_word": "to twist",
                                "target_lang_sense_clarification": "of a path or route"
                            },
                            {
                                "target_lang_word": "to snake",
                                "target_lang_sense_clarification": "moving in a long, curving line"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41bd06d1-887d-353e-9c5b-9f3c85391151",
                    "sense_definition": "Heen en weer bewegen door het lichaam in bochten te wringen, vaak bij pijn of ongemak.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De worm <w>kronkelde</w> over de natte tegels na de regen.",
                            "target_lang_translations": {
                                "en": "The worm <w>wriggled</w> across the wet tiles after the rain."
                            }
                        },
                        {
                            "text": "Hij <w>kronkelde</w> van de pijn op de grond.",
                            "target_lang_translations": {
                                "en": "He was <w>writhing</w> in pain on the ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "slieren"
                    ],
                    "common_phrases": [
                        "kronkelen van pijn"
                    ],
                    "target_lang_definitions": {
                        "en": "To move back and forth by twisting the body, often due to pain or discomfort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to writhe",
                                "target_lang_sense_clarification": "in pain or agony"
                            },
                            {
                                "target_lang_word": "to wriggle",
                                "target_lang_sense_clarification": "like a worm or small animal"
                            },
                            {
                                "target_lang_word": "to squirm",
                                "target_lang_sense_clarification": "due to discomfort or nervousness"
                            },
                            {
                                "target_lang_word": "to wiggle",
                                "target_lang_sense_clarification": "small, quick movements"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}