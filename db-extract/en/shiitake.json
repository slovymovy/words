                "senses": [
                    {
                        "sense_id": "571b3902-7a94-398d-bd68-74ce98e08fa3",
                        "entry_id": "dae4b6eb-7d9d-33da-bd41-be9afa4f6eb3",
                        "glosses": [
                            "A wide, brown variety of edible mushroom, Lentinula edodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1bd1189-d869-49b4-8163-991680df4f82",
                                "sense_id": "571b3902-7a94-398d-bd68-74ce98e08fa3",
                                "text": "Some fun meatless recipes include jackfruit sandwiches in place of pulled pork; black bean meatless balls or eggplant and shiitake “meatballs.”"
                            },
                            {
                                "example_id": "126c1a22-72b3-42a6-acbe-727fb3ef7105",
                                "sense_id": "571b3902-7a94-398d-bd68-74ce98e08fa3",
                                "text": "Tea bag-style dashi kits are a better quick choice. They pack katsuobushi, kombu and often other ingredients, like dried baby sardines (niboshi) and shiitake mushrooms, into a steepable bag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6220bc7-6960-4731-ac95-7266217fa9c4",
                        "source_entry_id": "dae4b6eb-7d9d-33da-bd41-be9afa4f6eb3",
                        "source_sense_id": "571b3902-7a94-398d-bd68-74ce98e08fa3",
