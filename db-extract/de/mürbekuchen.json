                "senses": [
                    {
                        "sense_id": "e13ec1e8-25ea-3cb8-b516-ed22583453ca",
                        "entry_id": "f230b977-4883-3943-a977-669a16608476",
                        "glosses": [
                            "Kuchen aus einem viel Zucker, Mehl und Fett und wenig Wasser enthaltenden, festen Teig; aus Mürbeteig hergestellter Kuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11f84f7-d9d9-4d98-aa56-b8230ccccc00",
                                "sense_id": "e13ec1e8-25ea-3cb8-b516-ed22583453ca",
                                "text": "„Mürbekuchen und Puddings folgten, von ungezählten Leckereien begleitet, dann Käse und Biskuits.“"
                            },
                            {
                                "example_id": "3c852816-3b5c-4955-a4f3-d64b90245d6c",
                                "sense_id": "e13ec1e8-25ea-3cb8-b516-ed22583453ca",
                                "text": "„Wir knabbern wohlschmeckende Mürbekuchen, und den niedrigen Teetisch zwischen uns schmückt eine mit großer Liebe und Kunst gestickte Decke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
