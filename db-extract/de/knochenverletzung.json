                "senses": [
                    {
                        "sense_id": "07e041c4-0a60-3b00-ab05-e3374f2a5a07",
                        "entry_id": "d3e0b6da-981a-3909-b2f3-9a6dadffa7b3",
                        "glosses": [
                            "Verletzung eines Knochens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d85c0a-4a37-4357-9da1-accf5352b3c8",
                                "sense_id": "07e041c4-0a60-3b00-ab05-e3374f2a5a07",
                                "text": "„Knochenverletzungen, insbesondere Frakturen finden sich deutlich häufiger im ersten Lebensjahrzehnt und in höherem Lebensalter.“"
                            },
                            {
                                "example_id": "fe4fcf7e-68fc-41e7-9458-28aab9cfae00",
                                "sense_id": "07e041c4-0a60-3b00-ab05-e3374f2a5a07",
                                "text": "„Im Stirnbein befindet sich eine ausgeheilte Knochenverletzung, die auf den Sturz auf einen scharfkantigen Stein zurückgeführt wird.“"
                            },
                            {
                                "example_id": "e85439e5-66e8-4485-b706-eb2dd9911704",
                                "sense_id": "07e041c4-0a60-3b00-ab05-e3374f2a5a07",
                                "text": "„Die Regeneration von Knochenverletzungen geht teils von Knochenzellen selbst aus, die sich zu Osteoblasten zu entdifferenzieren vermögen, überwiegend aber von Bindegewebszellen der zell- und gefäßreichen inneren Periostschichten, die zusammen mit einsprossenden Blutkapillaren in das Wundgebiet einwandern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
