    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d252f49-bfff-3519-80fa-2a03787a47d7",
                    "sense_definition": "Крупный раздел книги или литературного произведения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chapter_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я прочитал первую <w>главу</w> этой интересной книги за один вечер.",
                            "target_lang_translations": {
                                "en": "I read the first <w>chapter</w> of this interesting book in one evening.",
                                "zh": "我用一个晚上读完了这本有趣书籍的第一<w>章</w>。"
                            }
                        },
                        {
                            "text": "В учебнике по истории всего десять <w>глав</w>.",
                            "target_lang_translations": {
                                "en": "There are only ten <w>chapters</w> in the history textbook.",
                                "zh": "这本历史教科书总共只有十<w>章</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "раздел",
                        "часть"
                    ],
                    "common_phrases": [
                        "первая глава",
                        "новая глава",
                        "читать главу",
                        "конец главы"
                    ],
                    "target_lang_definitions": {
                        "en": "A main division of a book or other written work.",
                        "zh": "书籍或文学作品的主要部分。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chapter",
                                "target_lang_sense_clarification": "section of a book"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "章",
                                "target_lang_sense_clarification": "书籍的章节"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bca12d96-d0de-36ee-89f6-be8d3a87ef3e",
                    "sense_definition": "Руководитель, главное лицо, имеющее наибольший авторитет или власть в организации, государстве или семье.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Президент является <w>главой</w> государства и представляет страну на международных встречах.",
                            "target_lang_translations": {
                                "en": "The president is the <w>head</w> of state and represents the country at international meetings.",
                                "zh": "总统是国家<w>首脑</w>，在国际会议上代表国家。"
                            }
                        },
                        {
                            "text": "Мой дедушка всегда был бесспорным <w>главой</w> нашей большой семьи.",
                            "target_lang_translations": {
                                "en": "My grandfather was always the undisputed <w>head</w> of our large family.",
                                "zh": "我的祖父一直是我们大家庭中无可争议的<w>家长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "руководитель",
                        "начальник",
                        "шеф",
                        "босс"
                    ],
                    "antonyms": [
                        "подчинённый"
                    ],
                    "common_phrases": [
                        "глава государства",
                        "глава семьи",
                        "глава администрации",
                        "глава правительства"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is in charge of a group, organization, or country.",
                        "zh": "负责管理组织、国家或家庭的人，拥有最高权威。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "leader or person in charge"
                            },
                            {
                                "target_lang_word": "leader",
                                "target_lang_sense_clarification": "person who leads or commands"
                            },
                            {
                                "target_lang_word": "chief",
                                "target_lang_sense_clarification": "head of a group or organization"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首脑",
                                "target_lang_sense_clarification": "国家或组织的领导人"
                            },
                            {
                                "target_lang_word": "负责人",
                                "target_lang_sense_clarification": "负责某项工作或组织的人"
                            },
                            {
                                "target_lang_word": "家长",
                                "target_lang_sense_clarification": "家庭的领导者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99669236-9481-3483-8026-d87c1dc04284",
                    "sense_definition": "Важный этап или период в жизни или истории, следующий за значительными изменениями.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chapter_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Переезд в другой город стал новой <w>главой</w> в моей жизни.",
                            "target_lang_translations": {
                                "en": "Moving to another city became a new <w>chapter</w> in my life.",
                                "zh": "搬到另一个城市成为了我人生中新的<w>篇章</w>。"
                            }
                        },
                        {
                            "text": "Это событие открыло очередную <w>главу</w> в истории нашей страны.",
                            "target_lang_translations": {
                                "en": "This event opened another <w>chapter</w> in the history of our country.",
                                "zh": "这一事件开启了我国历史上的又一个新<w>篇章</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "новая глава жизни",
                        "открыть новую главу"
                    ],
                    "target_lang_definitions": {
                        "en": "A distinct period or stage in history or a person's life.",
                        "zh": "历史或个人生活中一个独特的时期或阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chapter",
                                "target_lang_sense_clarification": "figurative period or phase"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "篇章",
                                "target_lang_sense_clarification": "比喻人生或历史的阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66923fff-34fe-3606-96be-2456879df9fd",
                    "sense_definition": "Купол церковного здания, обычно в форме шлема или луковицы.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На ярком солнце блестели золотые <w>главы</w> старинного собора.",
                            "target_lang_translations": {
                                "en": "The golden <w>domes</w> of the ancient cathedral shone in the bright sun.",
                                "zh": "古老教堂的金色<w>圆顶</w>在灿烂的阳光下闪闪发光。"
                            }
                        },
                        {
                            "text": "Реставраторы восстановили разрушенные <w>главы</w> монастырской церкви.",
                            "target_lang_translations": {
                                "en": "Restorers rebuilt the destroyed <w>cupolas</w> of the monastery church.",
                                "zh": "修复人员重建了修道院教堂受损的<w>圆顶</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "купол"
                    ],
                    "common_phrases": [
                        "золотые главы",
                        "главы собора",
                        "главы церкви"
                    ],
                    "target_lang_definitions": {
                        "en": "A rounded vault forming the roof of a building or structure, typically with a circular base.",
                        "zh": "教堂建筑的圆形屋顶，通常呈头盔或洋葱状。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dome",
                                "target_lang_sense_clarification": "architectural structure"
                            },
                            {
                                "target_lang_word": "cupola",
                                "target_lang_sense_clarification": "small dome-like structure"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆顶",
                                "target_lang_sense_clarification": "建筑结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "404930fa-0143-3054-ad8c-49aa08948720",
                    "sense_definition": "Голова человека или животного.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рыцарь в знак глубокого уважения склонил свою <w>главу</w> перед королём.",
                            "target_lang_translations": {
                                "en": "The knight bowed his <w>head</w> before the king as a sign of deep respect.",
                                "zh": "骑士为了表示深深的敬意，在国王面前低下了<w>头</w>。"
                            }
                        },
                        {
                            "text": "Усталый путник преклонил <w>главу</w> на мягкую траву и уснул.",
                            "target_lang_translations": {
                                "en": "The weary traveler laid his <w>head</w> on the soft grass and fell asleep.",
                                "zh": "疲惫的旅人将<w>头</w>枕在柔软的草地上睡着了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "голова"
                    ],
                    "common_phrases": [
                        "склонить главу",
                        "преклонить главу"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "поэтическое или устаревшее употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The head of a human or animal (archaic or poetic usage).",
                        "zh": "人或动物的头部（古语或诗歌用法）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "archaic or poetic usage"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头",
                                "target_lang_sense_clarification": "身体部位的古称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
