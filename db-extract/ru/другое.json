                                        "sense_id": "de3dafb0-7e4c-3fad-8199-c7a75c40c125",
                                        "entry_id": "cfda5f8c-33d6-3eeb-b7c2-6f67a0d33752",
                                        "glosses": [
                                            "Second."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35f7b8a2-f03f-49ea-b79d-ce25e6830134",
                                                "sense_id": "de3dafb0-7e4c-3fad-8199-c7a75c40c125",
                                                "text": "I get paid every other week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c695f1-bdf9-338f-afec-9af67e24ee72",
                                        "entry_id": "cfda5f8c-33d6-3eeb-b7c2-6f67a0d33752",
                                        "glosses": [
                                            "Alien."
                                        ],
                                        "tags": [
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a2cb573-5ef0-42b1-b947-194461b95464",
                                                "sense_id": "76c695f1-bdf9-338f-afec-9af67e24ee72",
                                                "text": "In Matthew's account, the law remains intact, as does virtually everything except that critical belief in Jesus as the Messiah (obviously no small thing), and this is not enough to make Matthew completely other from its Jewish origins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b5e6ccf-3e8b-3421-bf01-c35f37dc457a",
                                        "entry_id": "cfda5f8c-33d6-3eeb-b7c2-6f67a0d33752",
                                        "glosses": [
                                            "Different."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4efb77d-0993-47ae-a5c0-9cc33c18ddd5",
                                                "sense_id": "0b5e6ccf-3e8b-3421-bf01-c35f37dc457a",
                                                "text": "it is inherent, rather, in the revolutionary attempt of the West to externalize the idea of a source of meaning wholly other than what is embodied in human conventions and hierarchies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f9766cf-d703-3932-8c88-601672651e4c",
                                        "entry_id": "cfda5f8c-33d6-3eeb-b7c2-6f67a0d33752",
                                        "glosses": [
                                            "Left, as opposed to right."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4646e86-cfc1-415a-9140-fb34e105143b",
                                                "sense_id": "5f9766cf-d703-3932-8c88-601672651e4c",
                                                "text": "A diſtaffe in her other hand ſhe had, / Vpon the which ſhe litle ſpinnes, but ſpils, / And faynes to weaue falſe tales and leaſings bad, / To throw amongſt the good, which others had diſprad."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "other",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7abd1259-e847-3cbc-9026-bb8e04b9131e",
                                        "entry_id": "79c5715c-cd84-377a-ac22-2d1edadd8f18",
                                        "glosses": [
                                            "An other, another (person, etc), more often rendered as another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a77b907-c455-482f-93ce-6209121be787",
                                                "sense_id": "7abd1259-e847-3cbc-9026-bb8e04b9131e",
                                                "text": "I'm afraid little Robbie does not always play well with others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d77e7a-00d1-3cb7-95be-fc861bb6402b",
                                        "entry_id": "79c5715c-cd84-377a-ac22-2d1edadd8f18",
                                        "glosses": [
                                            "The other one; the second of two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea2bc118-eeb9-481f-afe7-2ab66c70bfc8",
                                                "sense_id": "87d77e7a-00d1-3cb7-95be-fc861bb6402b",
                                                "text": "One boat is not better than the other."
                                            },
                                            {
                                                "example_id": "f8a0fb02-9fbc-44ba-a9fe-ea465ebb040f",
                                                "sense_id": "87d77e7a-00d1-3cb7-95be-fc861bb6402b",
                                                "text": "Why not tell one or other of your parents?"
                                            },
                                            {
                                                "example_id": "efbca77f-4bf2-4aca-ab34-b143c31cff41",
                                                "sense_id": "87d77e7a-00d1-3cb7-95be-fc861bb6402b",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            },
                                            {
                                                "example_id": "d3b44318-f201-4ac9-b08d-44b69f458e30",
                                                "sense_id": "87d77e7a-00d1-3cb7-95be-fc861bb6402b",
                                                "text": "He had one hand on the bounce bottle—and he'd never let go of that since he got back to the table—but he had a handkerchief in the other and was swabbing his deadlights with it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "other",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a30af7df-7883-3118-b0fe-4bbe5e881b53",
                                        "entry_id": "a3bca4e5-a223-36db-a3f9-e8b7aa88b5cc",
                                        "glosses": [
                                            "Not the one or ones previously referred to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8c02f0-9e34-410e-93b0-9230f5f4bb92",
                                                "sense_id": "a30af7df-7883-3118-b0fe-4bbe5e881b53",
                                                "text": "Earning less than $2,000 a month I have no other source of income except for gifts from relatives."
                                            },
                                            {
                                                "example_id": "4e28a791-6a9e-4a21-8ac7-e81de7f341b4",
                                                "sense_id": "a30af7df-7883-3118-b0fe-4bbe5e881b53",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track. The three returned wondering and charmed with Mrs. Cooke; they were sure she had had no hand in the furnishing of that atrocious house."
                                            },
                                            {
                                                "example_id": "628875fb-840c-496a-b406-9fa674843399",
                                                "sense_id": "a30af7df-7883-3118-b0fe-4bbe5e881b53",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes like\n Here's rattling good luck and roaring good cheer, / With lashings of food and great hogsheads of beer. […]”"
                                            },
                                            {
                                                "example_id": "0342a45a-d89d-462f-9230-37f1960bcfe8",
                                                "sense_id": "a30af7df-7883-3118-b0fe-4bbe5e881b53",
                                                "text": "“By the way,” Jessamy went on, “what’s your other name? You never told me.” “Stubbs,” said Billy, “William Stubbs!”."
                                            },
                                            {
                                                "example_id": "8519cc5f-e703-40b0-972c-ce00393a147a",
                                                "sense_id": "a30af7df-7883-3118-b0fe-4bbe5e881b53",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "other",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e1fa4b-03eb-3069-b405-950d7f8fd75a",
                                        "entry_id": "916e7b62-dfe2-3608-9afc-697e15f29b3e",
                                        "glosses": [
                                            "Otherwise."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23612a6d-fce7-4b18-b1a8-f30c7906a727",
                                                "sense_id": "c8e1fa4b-03eb-3069-b405-950d7f8fd75a",
                                                "text": "I durst, my lord, to wager she is honest, Lay down my soul at state; if you think other, Remove your thought;"
                                            },
                                            {
                                                "example_id": "44ff28b2-2126-496a-89e9-31aada32fb8f",
                                                "sense_id": "c8e1fa4b-03eb-3069-b405-950d7f8fd75a",
                                                "text": "Weigh also, the pretty escape of the disguised attempt of the party that seemed to be in so great peril, who can believe other, then that it was a made matter, to continue a belief, whom they think they have inchaunted at their wills."
                                            },
                                            {
                                                "example_id": "52ac3754-ce4f-473c-82b2-1e32635614dd",
                                                "sense_id": "c8e1fa4b-03eb-3069-b405-950d7f8fd75a",
                                                "text": "That he knew from Monsieur Meerman, I had been the occasion of giving him any Credit in England of an honest sincere Man, and he would never lose mine upon that occasion by giving the King Cause to believe other of him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "other",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5a7651-7317-39c7-8b25-36f6e036b16b",
                                        "entry_id": "b35ed28e-5555-332d-9d83-61ca7a6ee2d3",
                                        "glosses": [
                                            "To regard, label, or treat as an \\\"other\\\", as not part of the same group; to view as different and alien."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d00593-6c1a-4b81-ac43-c677e6ce0347",
                                                "sense_id": "0c5a7651-7317-39c7-8b25-36f6e036b16b",
                                                "text": "\"Rican\" is code for its homonym, \"redskin,\" through which they othered this non-Mexican ethnic group."
                                            },
                                            {
                                                "example_id": "5951a40b-cb57-41ff-a5e4-8b796b2f1801",
                                                "sense_id": "0c5a7651-7317-39c7-8b25-36f6e036b16b",
                                                "text": "That is, whilst Lesfest organisers are othering women who are not born female (thus producing a kind of lesbian-normativity), the Australian WOMAN Network is othering women who have not had surgical sex reassignment (thus producing a kind of \"trans-normativity\")."
                                            },
                                            {
                                                "example_id": "3a624515-b2a9-477a-87ce-3546af5a73b0",
                                                "sense_id": "0c5a7651-7317-39c7-8b25-36f6e036b16b",
                                                "text": "[…] and Black males have not taken her seriously politically (gender); and the color of her skin has marginalized her (race and \"othered\" her when compared with White women, who have also worked to silence her political views."
                                            },
                                            {
                                                "example_id": "be52afe2-613c-42f1-ab59-4d7192262a3e",
                                                "sense_id": "0c5a7651-7317-39c7-8b25-36f6e036b16b",
                                                "text": "Others with admitted addictions are Othered and sadly, forever stigmatized."
                                            },
                                            {
                                                "example_id": "3cebe1e6-0d58-40f0-8dfc-626299afa84c",
                                                "sense_id": "0c5a7651-7317-39c7-8b25-36f6e036b16b",
                                                "text": "“You’re coming here and you’re expecting that everybody’s Black, so I’m going to be OK,” Ms. Davis said. “But then you get here and then you’re being ‘othered’” — viewed as different and separate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cd05496-3840-3be2-aac1-000f2a2f81e7",
                                        "entry_id": "b35ed28e-5555-332d-9d83-61ca7a6ee2d3",
                                        "glosses": [
                                            "To treat as different or separate; segregate; ostracise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e9db707-6436-4b61-a7bc-87c792b8510d",
                                                "sense_id": "5cd05496-3840-3be2-aac1-000f2a2f81e7",
                                                "text": "In this scenario, the young lady who had spoken had been othered by her peers and her response to my question had been dismissed as invalid despite the fact that she was alright."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
