            {
                "entry_id": "48326ff3-019c-3837-a7e7-864b9da84e64",
                "word": "bandana",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "091c702d-44bc-4211-acfc-4f61dfa38925",
                        "entry_id": "48326ff3-019c-3837-a7e7-864b9da84e64",
                        "tags": [
                            "plural"
                        ],
                        "form": "bandanas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
                        "entry_id": "48326ff3-019c-3837-a7e7-864b9da84e64",
                        "glosses": [
                            "Pièce de tissu triangulaire ou quadrangulaire nouée sur la tête ou autour du cou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb4f234c-89b7-40a1-a0c9-0b43150c5497",
                                "sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
                                "text": "Jadis dans l’ouest des États-Unis, le bandana cachait le bas du visage pour le protéger de la poussière."
                            },
                            {
                                "example_id": "b8c34669-c874-4862-ae4a-1eb03d882af5",
                                "sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
                                "text": "Coiffé d’un bandana qui lui valait le surnom de Pirate, la peau brûlée par le soleil, Georges passait l’essentiel de sa journée au volant de son hors-bord, interpellait les uns, taquinait les autres, exigeait qu’autour de lui les femmes évoluent seins nus."
                            },
                            {
                                "example_id": "3c6bbe32-ef43-44da-ba2c-228a91d83735",
                                "sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
                                "text": "Il noua avec application un bandana noir à pois blancs autour de sa glotte, inclina son décalitre, descendit avec précaution, sur la pointe de ses bottes, l'escalier pentu de la résidence d'anciens."
                            },
                            {
                                "example_id": "12d248cb-18b3-4430-b49f-a9ed149781fd",
                                "sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
                                "text": "Je me suis mariée en jean élimé, coiffée d’un bandana. Quelle importance, ce qu’on porte ? Ce qui compte, c’est qui on épouse."
                            },
                            {
                                "example_id": "329deb07-cc60-4c81-92cf-e85452e7b6ca",
                                "sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
                                "text": "son look a étonné, y compris ses collègues : un bandana aux motifs bleus sur le front lui donnant, selon les commentateurs, des airs de hippie, de biker ou d’Indien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5da719bd-0b02-40a2-8462-7ac1cae56ff3",
                        "source_entry_id": "48326ff3-019c-3837-a7e7-864b9da84e64",
                        "source_sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
                        "source_sense_description": "Pièce de tissu pour la tête ou le cou",
                        "target_lang_word": "Bandana",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bandana",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89207a3a-c830-3475-9446-d9eabb6d39d8",
                                        "entry_id": "259876a1-242e-36dc-90fd-d359402b8bc1",
                                        "glosses": [
                                            "farbiges Tuch, das bei den Cowboys um den Hals getragen wurde, heute zumeist aber als Kopftuch verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e9705e-8d03-4d3e-ac23-c983bb9c8aa0",
                                                "sense_id": "89207a3a-c830-3475-9446-d9eabb6d39d8",
                                                "text": "Sie trug ein Bandana."
                                            },
                                            {
                                                "example_id": "f916ab48-db34-48fc-9b81-a2e5612f1043",
                                                "sense_id": "89207a3a-c830-3475-9446-d9eabb6d39d8",
                                                "text": "„Sie entdeckte das Bandana in den Tarnfarben, das ihr Vater so oft getragen hatte, und steckte es ein.“"
                                            },
                                            {
                                                "example_id": "f06622cd-0c5b-452a-8a0b-cd8bc36b833d",
                                                "sense_id": "89207a3a-c830-3475-9446-d9eabb6d39d8",
                                                "text": "„Mein Hals war wundgekratzt, selbst durch das Bandana hindurch, das ich mir vor Mund und Nase gebunden hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baf616b8-82da-47d2-8631-4f6d57f662af",
                        "source_entry_id": "48326ff3-019c-3837-a7e7-864b9da84e64",
                        "source_sense_id": "796b18fe-baed-393a-bc22-db4d967bb1a6",
