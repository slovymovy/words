                                        "glosses": [
                                            "A person who follows the philosophy of rationalism"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4005faa-8f0f-4061-997e-c28f3d110796",
                                                "sense_id": "47907cef-bb3e-3c3f-b625-91aae97fe6bd",
                                                "text": "“He says,” replied Lord Peter, “that he believes Hannah to be a sincerely religious woman. He has sat beside her in chapel and shared her hymn-book.” “But that may be the merest hypocrisy,” said Miss Murchison, rather warmly, for she was militantly rationalist. “I don’t trust these unctuous people.”"
                                            }
