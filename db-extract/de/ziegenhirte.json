                                        "sense_id": "1f542f6c-1bf9-3e87-a6ba-6d3e3481363d",
                                        "entry_id": "78d5ccde-c9cb-32e4-a8a0-5b0b44dfdb40",
                                        "glosses": [
                                            "Pâtre qui mène des chèvres."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ff8bb6-b70d-4fad-a0fb-8345059baa8e",
                                                "sense_id": "1f542f6c-1bf9-3e87-a6ba-6d3e3481363d",
                                                "text": "La Révolution, l’Empire, qu’est-ce que cela pour des chevriers et des pêcheurs qui ne savent pas lire ?"
                                            },
                                            {
                                                "example_id": "6d75d5d1-f8e0-4522-8574-81ee56f98350",
                                                "sense_id": "1f542f6c-1bf9-3e87-a6ba-6d3e3481363d",
                                                "text": "Pendant plus de vingt ans, j'ai parcouru cette vallée, et celles qui lui ressemblent, j'ai interrogé des chevriers muets, j'ai frappé à la porte de ruines inhabitées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chevrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3c511c-616e-3725-ae9a-c833392fbb4f",
                                        "entry_id": "5c01e471-8a27-326a-b352-6b5e85260e40",
                                        "glosses": [
                                            "Scieur de long qui manie l’extrémité supérieure de la scie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chevrier",
