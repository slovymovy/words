                "translations": [
                    {
                        "translation_id": "93840f78-f2bf-4812-a27b-cc818082f41e",
                        "source_entry_id": "821ffa21-de34-3c67-bec0-23dd0e6f752f",
                        "source_sense_id": "3aa2ebd4-705e-3261-aad7-c8820d92eecd",
                        "target_lang_word": "nirvana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nirvana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "642aecc1-4a51-3ee9-b9d8-7ad28e4a7afb",
                                        "entry_id": "a85a36e4-4a01-30d9-bfbd-c890647c1242",
                                        "glosses": [
                                            "Complete cessation of dukkha; a blissful state attained through realization of sunyata; enlightened experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7faf401e-25a9-3d4f-b1bf-1a4b097680ce",
                                        "entry_id": "a85a36e4-4a01-30d9-bfbd-c890647c1242",
                                        "glosses": [
                                            "State of paradise; heightened or great pleasure or peace."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca9abfd7-49c2-4483-811c-31665662aa44",
                                                "sense_id": "7faf401e-25a9-3d4f-b1bf-1a4b097680ce",
                                                "text": "Welcome to this celebration of legal abortion. I wish January 22 meant more than that. The truth is that we are not winging our way to a state of nirvana for reproductive rights."
                                            },
                                            {
                                                "example_id": "f962d209-6b8b-463d-9e51-e0dc31de3a3b",
                                                "sense_id": "7faf401e-25a9-3d4f-b1bf-1a4b097680ce",
                                                "text": "Though we don’t all reach nirvana when we swim, swimming may well be that last refuge from connectivity — and, for some, the only way to find the solitary self."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26ec0ceb-b853-4531-85eb-93e545163dba",
                        "source_entry_id": "821ffa21-de34-3c67-bec0-23dd0e6f752f",
                        "source_sense_id": "3aa2ebd4-705e-3261-aad7-c8820d92eecd",
                        "target_lang_word": "нирвана",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нирвана",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ad90331a-4145-3e9d-8bf4-a0d100f8dd41",
                                        "entry_id": "3476f488-3ce9-3567-ba92-72115bb66d99",
                                        "glosses": [
                                            "религ. основное понятие буддисткой религиозной философии — конечная цель человеческого существования, осуществление которой равнозначно окончательному уничтожению страдания, исчерпанности притоков аффектированного сознания, прекращению перерождения и переходов от одной сферы существования к другой (сансара) и действия механизмов «закона кармы»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a7774d-be31-4cb1-af7c-bc38bd9e8fbc",
                                                "sense_id": "ad90331a-4145-3e9d-8bf4-a0d100f8dd41",
                                                "text": "Буддист понимал и понимает своё отношение к бесконечному так, что он, переходя из одной формы жизни в другую, неизбежно страдает, страдания же происходят от страстей и желаний, и потому он должен стремиться к уничтожению всех страстей и желаний и переходу в нирвану."
                                            },
                                            {
                                                "example_id": "2bb82d2a-8e09-4142-9442-324a24b28864",
                                                "sense_id": "ad90331a-4145-3e9d-8bf4-a0d100f8dd41",
                                                "text": "Если нирвана есть нечто большее, чем затухание, а истина — нечто большее, нежели просто преходящая тень, тогда индивидуальность не есть абсолютное небытие, но смесь бытия и небытия, и авидья — не столько неправда, сколько отсутствие знания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c85dc9-dc3d-3f10-817d-f2c2d608654d",
                                        "entry_id": "3476f488-3ce9-3567-ba92-72115bb66d99",
                                        "glosses": [
                                            "перен., разг. высшее наслаждение, удовольствие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325f323d-dc72-41e4-85c4-247706a2822b",
                                                "sense_id": "56c85dc9-dc3d-3f10-817d-f2c2d608654d",
                                                "text": "Дай мне испить блаженство нирваны из кубка твоих уст, о ты, моя лучшая тифлисская чурчхела!"
                                            },
                                            {
                                                "example_id": "4ef529b7-0a3f-4f60-a231-ee2f3a2483f5",
                                                "sense_id": "56c85dc9-dc3d-3f10-817d-f2c2d608654d",
                                                "text": "Одна лишь нирвана у синего моря, под музыку… сиртаки?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
