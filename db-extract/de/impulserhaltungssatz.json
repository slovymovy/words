                "senses": [
                    {
                        "sense_id": "300ab1fc-f4dd-361d-b0a0-a88919a1480c",
                        "entry_id": "9fc62959-108a-3ad2-ad40-e258336e2c7a",
                        "glosses": [
                            "Erhaltungssatz, der besagt, dass der Gesamtimpuls in einem abgeschlossenen System (System ohne Wechselwirkungen mit seiner Umgebung) konstant ist"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "e4f72f00-a485-4549-b462-9103e6c0ec57",
                                "sense_id": "300ab1fc-f4dd-361d-b0a0-a88919a1480c",
                                "text": "„In einem Inertialsystem gilt für alle Stöße der Impulserhaltungssatz – die Summe aller Impulse bleibt konstant.“"
                            },
                            {
                                "example_id": "0844c517-2c17-4a02-ae83-3970825a7474",
                                "sense_id": "300ab1fc-f4dd-361d-b0a0-a88919a1480c",
                                "text": "„Er erkannte, dass Energieerhaltungssatz und Impulserhaltungssatz beim radioaktiven Betazerfall nur dann erfüllt sind, wenn bei der Umwandlung eines Neutrons in ein Proton und ein Elektron zusätzlich ein drittes, bis dahin unbekanntes Teilchen entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
