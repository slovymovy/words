                {
                    "sense_id": "aff1cc70-2f87-3710-ba71-4cbeecf967b0",
                    "sense_definition": "Formule de déférence employée pour atténuer une parole susceptible de choquer ou de déplaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sauf</w> votre respect, je ne partage pas du tout cette analyse de la situation.",
                            "target_lang_translations": {
                                "en": "<w>With all due respect</w>, I don't share this analysis of the situation at all.",
                                "ru": "<w>При всём уважении</w>, я совсем не разделяю этот анализ ситуации.",
                                "nl": "<w>Met alle respect</w>, ik deel deze analyse van de situatie helemaal niet.",
                                "de": "<w>Bei allem Respekt</w>, ich teile diese Analyse der Lage überhaupt nicht.",
                                "pl": "<w>Z całym szacunkiem</w>, zupełnie nie podzielam tej analizy sytuacji.",
                                "it": "<w>Con tutto il rispetto</w>, non condivido affatto questa analisi della situazione.",
                                "cs": "<w>S veškerou úctou</w>, ale tuto analýzu situace vůbec nesdílím.",
                                "tr": "<w>Müsaadenizle</w> söyleyeyim, durumla ilgili bu analize hiç katılmıyorum.",
                                "es": "<w>Con todo respeto</w>, no comparto en absoluto este análisis de la situación.",
                                "zh": "<w>恕我直言</w>，我完全不赞同这种对局势的分析。"
                            }
                        },
                        {
                            "text": "<w>Sauf</w> le respect que je vous dois, monsieur le directeur, votre plan ne tient pas.",
                            "target_lang_translations": {
                                "en": "<w>With all due respect</w>, Director, your plan doesn't hold up.",
                                "ru": "<w>При всём уважении</w>, директор, ваш план не выдерживает критики.",
                                "nl": "<w>Met alle respect</w>, meneer de directeur, uw plan houdt geen stand.",
                                "de": "<w>Mit Verlaub</w>, Herr Direktor, Ihr Plan hält einer Prüfung nicht stand.",
                                "pl": "<w>Z całym szacunkiem</w>, panie dyrektorze, pański plan nie wytrzymuje krytyki.",
                                "it": "<w>Con il dovuto rispetto</w>, direttore, il suo piano non regge.",
                                "cs": "<w>S dovolením</w>, pane řediteli, váš plán neobstojí.",
                                "tr": "<w>Affınıza sığınarak</w>, Müdür Bey, planınız tutmuyor.",
                                "es": "<w>Con el debido respeto</w>, señor director, su plan no se sostiene.",
                                "zh": "<w>请允许我直言</w>，主任，您的这个方案站不住脚。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sauf votre respect",
                        "sauf le respect"
                    ],
                    "target_lang_definitions": {
                        "en": "A polite phrase used before saying something that may offend or displease the listener.",
                        "ru": "Вежливая формула, которой смягчают возражение или замечание, способное задеть собеседника.",
                        "nl": "Beleefde uitdrukking die vooraf gaat aan opmerkingen die de luisteraar kunnen kwetsen of irriteren.",
                        "de": "Höfliche Wendung, mit der man eine Kritik oder einen Widerspruch einleitet, der das Gegenüber verletzen könnte.",
                        "pl": "Formuła grzeczności używana przed wypowiedzią, która może urazić rozmówcę.",
                        "it": "Formula di cortesia che precede un'affermazione potenzialmente offensiva o sgradita per l'interlocutore.",
                        "cs": "Zdvořilá formule, kterou se uvozuje výhrada nebo kritika, jež by mohla posluchače urazit.",
                        "tr": "Karşı tarafı kırabilecek bir itiraz ya da eleştiriden önce kullanılan kibar bir giriş formülüdür.",
                        "es": "Fórmula de cortesía que se usa antes de decir algo que puede molestar o chocar al interlocutor.",
                        "zh": "用于在说出可能令对方不快的话之前，表示礼貌和歉意的套语。"
                    },
