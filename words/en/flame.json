{
    "word_family": [
        "flammable",
        "inflammable",
        "inflammation",
        "inflammatory",
        "flamethrower"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cee8e264-04ec-37ca-9b5b-efa29eaf3db6",
                    "sense_definition": "The visible part of fire; a stream of burning vapour or gas, emitting light and heat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fire_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candle <w>flame</w> flickered gently in the draft from the window.",
                            "target_lang_translations": {
                                "ru": "<w>Пламя</w> свечи мягко мерцало на сквозняке из окна.",
                                "zh": "窗户吹进来的风让蜡烛的<w>火焰</w>轻轻摇曳。"
                            }
                        },
                        {
                            "text": "The car burst into <w>flames</w> shortly after the accident occurred.",
                            "target_lang_translations": {
                                "ru": "Машина была охвачена <w>пламенем</w> вскоре после аварии.",
                                "zh": "事故发生后不久，汽车就<w>起火</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "burst into flames",
                        "in flames",
                        "go down in flames",
                        "candle flame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Видимая часть огня; поток горящего пара или газа, излучающий свет и тепло.",
                        "zh": "火的可见部分；发光发热的燃烧气体或蒸气流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пламя",
                                "target_lang_sense_clarification": "основное значение; видимая часть огня"
                            },
                            {
                                "target_lang_word": "огонь",
                                "target_lang_sense_clarification": "синоним; процесс горения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "火焰",
                                "target_lang_sense_clarification": "主要含义；火的可见部分"
                            },
                            {
                                "target_lang_word": "火苗",
                                "target_lang_sense_clarification": "指细小的火焰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "697ab9aa-8012-3bf1-88a3-aa22c1257065",
                    "sense_definition": "A romantic partner or lover in a usually short-lived but passionate affair.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lover_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was surprised to run into an old <w>flame</w> at the grocery store.",
                            "target_lang_translations": {
                                "ru": "Он удивился, встретив свою старую <w>любовь</w> в продуктовом магазине.",
                                "zh": "他在杂货店意外遇到了自己的<w>旧情人</w>。"
                            }
                        },
                        {
                            "text": "She is not just a casual <w>flame</w>, but someone I truly care about.",
                            "target_lang_translations": {
                                "ru": "Она не просто случайное <w>увлечение</w>, а та, кто мне действительно дорог.",
                                "zh": "她不仅仅是我的一段露水<w>情缘</w>，而是我真正关心的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lover",
                        "sweetheart",
                        "crush",
                        "love interest",
                        "paramour",
                        "beloved"
                    ],
                    "common_phrases": [
                        "old flame"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'old flame'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Романтический партнер или возлюбленный, обычно в контексте прошлых отношений.",
                        "zh": "浪漫伴侣或情人，通常指短暂而热烈的恋情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любовь",
                                "target_lang_sense_clarification": "о человеке; часто в выражении «старая любовь»"
                            },
                            {
                                "target_lang_word": "увлечение",
                                "target_lang_sense_clarification": "предмет страсти или кратковременный роман"
                            },
                            {
                                "target_lang_word": "пассия",
                                "target_lang_sense_clarification": "разговорное; предмет любви"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旧情人",
                                "target_lang_sense_clarification": "常用于“old flame”一词，指过去的恋人"
                            },
                            {
                                "target_lang_word": "恋人",
                                "target_lang_sense_clarification": "指代浪漫关系中的对象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cb6b5d1-0893-304a-88f3-a0cf80f09397",
                    "sense_definition": "An aggressively insulting criticism or remark.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The discussion forum was shut down after a nasty <w>flame</w> war erupted.",
                            "target_lang_translations": {
                                "ru": "Дискуссионный форум закрыли после того, как разгорелся неприятный <w>флейм</w>.",
                                "zh": "在一场恶毒的<w>网络谩骂</w>爆发后，讨论区被关闭了。"
                            }
                        },
                        {
                            "text": "He ignored the <w>flame</w> and continued to express his opinion calmly.",
                            "target_lang_translations": {
                                "ru": "Он проигнорировал <w>нападки</w> и продолжил спокойно высказывать свое мнение.",
                                "zh": "他无视了那些<w>人身攻击</w>，继续冷静地表达自己的观点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flame war"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Агрессивная критика или оскорбительное замечание в интернете.",
                        "zh": "互联网上具有攻击性的批评或侮辱性言论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флейм",
                                "target_lang_sense_clarification": "интернет-сленг; спор ради спора"
                            },
                            {
                                "target_lang_word": "перепалка",
                                "target_lang_sense_clarification": "словесная ссора"
                            },
                            {
                                "target_lang_word": "нападки",
                                "target_lang_sense_clarification": "агрессивная критика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "网络谩骂",
                                "target_lang_sense_clarification": "指互联网上的攻击性言论"
                            },
                            {
                                "target_lang_word": "人身攻击",
                                "target_lang_sense_clarification": "指针对个人的恶意批评"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ac9274a-2f6d-3711-aa91-2b6beecbc82e",
                    "sense_definition": "To produce flames; to burn with a flame or blaze.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry wood <w>flamed</w> up instantly when the match touched it.",
                            "target_lang_translations": {
                                "ru": "Сухое дерево мгновенно <w>вспыхнуло</w>, когда спичка коснулась его.",
                                "zh": "火柴一碰到干木头，它就立刻<w>燃烧</w>了起来。"
                            }
                        },
                        {
                            "text": "Her cheeks <w>flamed</w> with embarrassment when she realized her mistake.",
                            "target_lang_translations": {
                                "ru": "Ее щеки <w>запылали</w> от смущения, когда она поняла свою ошибку.",
                                "zh": "当意识到自己的错误时，她的脸因尴尬而<w>泛红</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flame up",
                        "flame out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гореть ярким пламенем; вспыхивать (также о покраснении лица от эмоций).",
                        "zh": "产生火焰；燃烧或闪烁（也指因情绪激动而脸红）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пылать",
                                "target_lang_sense_clarification": "гореть ярко или быть красным от жара/стыда"
                            },
                            {
                                "target_lang_word": "вспыхнуть",
                                "target_lang_sense_clarification": "внезапно загореться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "燃烧",
                                "target_lang_sense_clarification": "指产生火焰的过程"
                            },
                            {
                                "target_lang_word": "泛红",
                                "target_lang_sense_clarification": "指因羞愧或激动而脸红"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "792b362a-5622-3d17-a15a-dbd447cede7d",
                    "sense_definition": "To post a destructively critical or abusive message (to somebody).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I got <w>flamed</w> for asking a simple question on the message board.",
                            "target_lang_translations": {
                                "ru": "Меня <w>зафлеймили</w> за простой вопрос на форуме.",
                                "zh": "因为在留言板上问了一个简单的问题，我遭到了<w>谩骂</w>。"
                            }
                        },
                        {
                            "text": "Users who <w>flame</w> others will be banned from the chat room immediately.",
                            "target_lang_translations": {
                                "ru": "Пользователи, которые <w>оскорбляют</w> других, будут немедленно забанены в чате.",
                                "zh": "在聊天室<w>谩骂</w>他人的用户将被立即封禁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публиковать оскорбительные сообщения или агрессивно критиковать кого-то в интернете.",
                        "zh": "在互联网上发布具有破坏性的批评或辱骂信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "наносить обиду словами"
                            },
                            {
                                "target_lang_word": "флеймить",
                                "target_lang_sense_clarification": "интернет-сленг; разжигать ссору"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谩骂",
                                "target_lang_sense_clarification": "指用恶毒语言攻击他人"
                            },
                            {
                                "target_lang_word": "网络攻击",
                                "target_lang_sense_clarification": "指在网上进行言语攻击"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af7c327f-42a1-36a1-847c-66e402bfa9c2",
                    "sense_definition": "Of a brilliant reddish orange-gold colour, like that of a flame.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a stunning <w>flame</w> dress that caught everyone's attention.",
                            "target_lang_translations": {
                                "ru": "На ней было потрясающее <w>огненное</w> платье, которое привлекло всеобщее внимание.",
                                "zh": "她穿了一件惊艳的<w>火红色</w>裙子，吸引了所有人的目光。"
                            }
                        },
                        {
                            "text": "The artist used <w>flame</w> hues to paint the dramatic sunset.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>огненные</w> оттенки, чтобы нарисовать драматичный закат.",
                                "zh": "艺术家用<w>火焰色</w>调描绘了那壮观的日落。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркого красновато-оранжевого цвета, напоминающего пламя.",
                        "zh": "像火焰一样明亮的红橙金色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огненный",
                                "target_lang_sense_clarification": "цвета огня"
                            },
                            {
                                "target_lang_word": "пламенный",
                                "target_lang_sense_clarification": "поэтическое; относящийся к пламени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "火红的",
                                "target_lang_sense_clarification": "形容像火一样的颜色"
                            },
                            {
                                "target_lang_word": "火焰色",
                                "target_lang_sense_clarification": "指代特定的红橙色调"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}