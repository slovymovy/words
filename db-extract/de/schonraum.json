                ],
                "senses": [
                    {
                        "sense_id": "3da71862-fd25-36b0-8420-85a78e132efb",
                        "entry_id": "c2f5800f-3f7c-3631-9517-188ee99372a5",
                        "glosses": [
                            "Lebensbereich, der während einer Ausbildungsphase vor ernsten Gefahren des realen Lebens schützt und Fehler zulässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc0f5f6-f528-420a-9c79-0bfac48348d6",
                                "sense_id": "3da71862-fd25-36b0-8420-85a78e132efb",
                                "text": "„Der Großteil aller Lernprozesse vollzieht sich in Schonräumen und Spielbereichen.“"
                            },
                            {
                                "example_id": "ba00720e-3278-4e4e-98a3-f0798b8a005b",
                                "sense_id": "3da71862-fd25-36b0-8420-85a78e132efb",
                                "text": "„Was im Schonraum der Schule also gelingt, verliert seine Kraft, wenn es hinaus ins Leben geht.“"
                            },
                            {
                                "example_id": "4e363140-0f11-4e46-ae3d-133ebc124187",
                                "sense_id": "3da71862-fd25-36b0-8420-85a78e132efb",
                                "text": "„Dass man sich mit Fug und Recht darüber streiten kann, ob eine formalisierte Leistungsbewertung und Leistungsselektion besser frühzeitig im pädagogischen Schonraum der Schule oder anschließend bei Betrieben oder Hochschulen angesiedelt sind, wird gar nicht mehr diskutierbar.“"
                            },
                            {
                                "example_id": "29bdc5e0-9145-469b-a1a3-45e670067c24",
                                "sense_id": "3da71862-fd25-36b0-8420-85a78e132efb",
                                "text": "„Und hätten sie uns nicht ‚Fördern und Fordern’ gepredigt, könnten wir ihnen verzeihen, sich in die politischen Schonräume der wärmend linken Verheißungen zurückzuziehen.“"
                            },
                            {
                                "example_id": "7d5e3566-4fd9-438a-acc7-8ac6380cfd59",
                                "sense_id": "3da71862-fd25-36b0-8420-85a78e132efb",
                                "text": "„Noch lange werden selbst Eltern dem gemeinsamen Lernen skeptisch gegenüberstehen und für ihre Kinder einen Schonraum suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
