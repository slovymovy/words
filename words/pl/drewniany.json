{
    "word_family": [
        "drewno",
        "drewniak",
        "drewnieć"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d10f5c2-6943-3bae-b7c7-67040f0eca9c",
                    "sense_definition": "Wykonany z drewna, zrobiony z materiału pozyskiwanego z drzew.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na środku salonu stoi duży, <w>drewniany</w> stół dębowy.",
                            "target_lang_translations": {
                                "ru": "Посреди гостиной стоит большой <w>деревянный</w> дубовый стол.",
                                "de": "In der Mitte des Wohnzimmers steht ein großer, <w>hölzerner</w> Eichentisch."
                            }
                        },
                        {
                            "text": "Dziecko bawiło się małym, <w>drewnianym</w> klockiem na dywanie.",
                            "target_lang_translations": {
                                "ru": "Ребёнок играл маленьким <w>деревянным</w> кубиком на ковре.",
                                "de": "Das Kind spielte auf dem Teppich mit einem kleinen, <w>hölzernen</w> Bauklotz."
                            }
                        }
                    ],
                    "antonyms": [
                        "niedrewniany"
                    ],
                    "common_phrases": [
                        "drewniany dom",
                        "drewniany stół",
                        "drewniana podłoga",
                        "drewniana łyżka"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из дерева, изготовленный из материала, добываемого из деревьев.",
                        "de": "Aus Holz bestehend, aus dem Material gefertigt, das aus Bäumen gewonnen wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревянный",
                                "target_lang_sense_clarification": "сделанный из дерева"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hölzern",
                                "target_lang_sense_clarification": "aus Holz gefertigt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03da93a4-0a68-3dce-9b0d-d6a131aeaf89",
                    "sense_definition": "O częściach ciała lub ruchach: sztywny, nienaturalny i niezgrabny.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze strachu poczułem, że mam zupełnie <w>drewniane</w> nogi.",
                            "target_lang_translations": {
                                "ru": "От страха я почувствовал, что у меня совершенно <w>деревянные</w> ноги.",
                                "de": "Vor Angst fühlte ich, dass ich völlig <w>hölzerne</w> Beine hatte."
                            }
                        },
                        {
                            "text": "Jego <w>drewniane</w> ruchy na parkiecie rozbawiły wszystkich gości.",
                            "target_lang_translations": {
                                "ru": "Его <w>деревянные</w> движения на паркете рассмешили всех гостей.",
                                "de": "Seine <w>hölzernen</w> Bewegungen auf der Tanzfläche amüsierten alle Gäste."
                            }
                        }
                    ],
                    "antonyms": [
                        "zręczny",
                        "zgrabny"
                    ],
                    "common_phrases": [
                        "drewniane nogi",
                        "drewniane ruchy",
                        "mieć drewniane ręce"
                    ],
                    "target_lang_definitions": {
                        "ru": "О частях тела или движениях: жесткий, неестественный и неуклюжий.",
                        "de": "Bezogen auf Körperteile oder Bewegungen: steif, unnatürlich und ungelenk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревянный",
                                "target_lang_sense_clarification": "скованный, лишенный подвижности"
                            },
                            {
                                "target_lang_word": "неповоротливый",
                                "target_lang_sense_clarification": "неуклюжий"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hölzern",
                                "target_lang_sense_clarification": "steif, ungelenk"
                            },
                            {
                                "target_lang_word": "steif",
                                "target_lang_sense_clarification": "unbeweglich, verkrampft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a96c0904-e03d-3f35-accf-b09f89d58d01",
                    "sense_definition": "O głosie: pozbawiony emocji, głuchy, bezdźwięczny lub nieprzyjemny.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lektor czytał tekst nudnym, <w>drewnianym</w> głosem bez wyrazu.",
                            "target_lang_translations": {
                                "ru": "Диктор читал текст скучным, <w>деревянным</w> голосом без выражения.",
                                "de": "Der Sprecher las den Text mit einer langweiligen, <w>hölzernen</w> Stimme ohne Ausdruck."
                            }
                        },
                        {
                            "text": "Jej <w>drewniany</w> ton sugerował, że jest bardzo zmęczona rozmową.",
                            "target_lang_translations": {
                                "ru": "Её <w>деревянный</w> тон говорил о том, что она очень устала от разговора.",
                                "de": "Ihr <w>hölzerner</w> Tonfall deutete darauf hin, dass sie sehr müde vom Gespräch war."
                            }
                        }
                    ],
                    "synonyms": [
                        "szorstki",
                        "głuchy"
                    ],
                    "antonyms": [
                        "dźwięczny",
                        "ciepły"
                    ],
                    "common_phrases": [
                        "drewniany głos",
                        "drewniany ton"
                    ],
                    "target_lang_definitions": {
                        "ru": "О голосе: лишенный эмоций, глухой, беззвучный или неприятный.",
                        "de": "Bezogen auf die Stimme: emotionslos, dumpf, klanglos oder unangenehm."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревянный",
                                "target_lang_sense_clarification": "лишенный выразительности"
                            },
                            {
                                "target_lang_word": "бесцветный",
                                "target_lang_sense_clarification": "монотонный, безэмоциональный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "monoton",
                                "target_lang_sense_clarification": "ohne Ausdruck, gleichförmig"
                            },
                            {
                                "target_lang_word": "ausdruckslos",
                                "target_lang_sense_clarification": "ohne Emotionen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d787a04-14b1-3b05-a60a-fb9c86367237",
                    "sense_definition": "O wyrazie twarzy, zachowaniu lub grze aktorskiej: sztuczny, bezbarwny i pozbawiony życia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aktor otrzymał słabe recenzje za swoją <w>drewnianą</w> grę w filmie.",
                            "target_lang_translations": {
                                "ru": "Актёр получил плохие отзывы за свою <w>деревянную</w> игру в фильме.",
                                "de": "Der Schauspieler erhielt schlechte Kritiken für sein <w>hölzernes</w> Spiel im Film."
                            }
                        },
                        {
                            "text": "Przyjął tę wiadomość z obojętną, wręcz <w>drewnianą</w> twarzą.",
                            "target_lang_translations": {
                                "ru": "Он принял эту новость с равнодушным, прямо-таки <w>деревянным</w> лицом.",
                                "de": "Er nahm diese Nachricht mit einem gleichgültigen, geradezu <w>hölzernen</w> Gesichtsausdruck entgegen."
                            }
                        }
                    ],
                    "antonyms": [
                        "czuły"
                    ],
                    "common_phrases": [
                        "drewniana twarz",
                        "drewniana gra aktorska"
                    ],
                    "target_lang_definitions": {
                        "ru": "О выражении лица, поведении или актерской игре: искусственный, бесцветный и безжизненный.",
                        "de": "Bezogen auf Gesichtsausdruck, Verhalten oder Schauspielerei: künstlich, farblos und leblos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревянный",
                                "target_lang_sense_clarification": "бесстрастный, неподвижный"
                            },
                            {
                                "target_lang_word": "неподвижный",
                                "target_lang_sense_clarification": "застывший (о лице)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hölzern",
                                "target_lang_sense_clarification": "steif, unnatürlich"
                            },
                            {
                                "target_lang_word": "steif",
                                "target_lang_sense_clarification": "unnatürlich, gehemmt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}