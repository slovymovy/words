                        "form": "sie sind wutschnaubend"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4e2476c-3eb5-3f24-b6a4-89950fc40fa9",
                        "entry_id": "37bb44d4-0fad-349e-937d-795e54d27ed6",
                        "glosses": [
                            "äußerst wütend, mit sehr viel Wut, Zorn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f5e480-00af-4cb8-9c58-09199584c8c0",
                                "sense_id": "e4e2476c-3eb5-3f24-b6a4-89950fc40fa9",
                                "text": "„Alle bogen sich vor Lachen, nur der Ingenieur konnte nichts Heiteres an der Sache finden und verließ wutschnaubend den Betrieb.“"
                            },
                            {
                                "example_id": "66cae7e1-0c14-4e99-a9cc-7275d8533938",
                                "sense_id": "e4e2476c-3eb5-3f24-b6a4-89950fc40fa9",
                                "text": "„Und ich würde verstehen, wenn du mir jetzt eine Ohrfeige gibst und mich wutschnaubend verlässt.“"
                            },
                            {
                                "example_id": "1db2679d-cdb3-4ec2-84b9-b56ce3af4dea",
                                "sense_id": "e4e2476c-3eb5-3f24-b6a4-89950fc40fa9",
                                "text": "„Er ließ den Wagen mit offenen Türen und laufendem Motor stehen und stampfte wutschnaubend zurück zur Villa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
