                    {
                        "sense_id": "28a093a6-85f6-346a-886c-097adbdfe56a",
                        "entry_id": "6a773231-b47e-3cb3-9fa8-fb3773bf1b30",
                        "glosses": [
                            "Having (a given type of) springs; equipped with (a given type of) springs."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a5843001-563c-4493-ae3d-64d903aac6b4",
                                "sense_id": "28a093a6-85f6-346a-886c-097adbdfe56a",
                                "text": "They were probably the work of individual craftsmen working to meet the chieftains' needs. Their place in the chronology of the big cemeteries is indicated by the less richly-decorated double-springed bronze brooches which are found here."
                            },
                            {
                                "example_id": "81a9d82c-59f7-42b2-a25b-f7c3e8f2be1c",
                                "sense_id": "28a093a6-85f6-346a-886c-097adbdfe56a",
                                "text": "Snibbing down the springed catch to secure a slatted wooden barrier, mindful of pained fingers past, she strategically pulled her hand back, thinking of it as a smart mouse stealing cheese from a trap."
                            },
                            {
                                "example_id": "52908be5-16ea-4f4f-9e9a-611451343fa7",
                                "sense_id": "28a093a6-85f6-346a-886c-097adbdfe56a",
                                "text": "Michael Reid sat, leaning against the footboard at the end of the weak-springed bed, watched a cockroach walk boldly across the headboard at the other end, and tried to figure out what day it was."
                            }
                        ]
                    }
