                },
                {
                    "sense_id": "eaf74f5a-5ade-34f5-8f5d-ede1ce4d070e",
                    "sense_definition": "A period of lowest brightness or energy intensity of a star.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The solar <w>minimum</w> is characterized by a reduced number of sunspots.",
                            "target_lang_translations": {
                                "ru": "Солнечный <w>ми́нимум</w> характеризуется уменьшенным количеством пятен на Солнце.",
                                "pl": "<w>Minimum</w> słoneczne charakteryzuje się zmniejszoną liczbą plam na Słońcu.",
                                "zh": "太阳<w>极小期</w>的特征是太阳黑子数量减少。"
                            }
                        },
                        {
                            "text": "Scientists are studying how the solar <w>minimum</w> affects the climate on Earth.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают, как солнечный <w>ми́нимум</w> влияет на климат Земли.",
                                "pl": "Naukowcy badają, jak <w>minimum</w> słoneczne wpływa na klimat na Ziemi.",
                                "zh": "科学家们正在研究太阳<w>极小期</w>如何影响地球气候。"
                            }
                        }
                    ],
                    "antonyms": [
                        "maximum"
                    ],
                    "common_phrases": [
                        "solar minimum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период наименьшей яркости или энергетической интенсивности звезды.",
                        "pl": "Okres najniższej jasności lub intensywności energii gwiazdy.",
                        "zh": "恒星亮度或能量强度最低的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ми́нимум",
                                "target_lang_sense_clarification": "астрономический термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "minimum",
                                "target_lang_sense_clarification": "termin astronomiczny"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极小期",
                                "target_lang_sense_clarification": "天文术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f825be8f-1ac9-3b5f-9312-613c1fd52046",
                    "sense_definition": "Used to describe the smallest amount, degree, or size allowed or possible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>minimum</w> age for obtaining a driver's license varies by country.",
                            "target_lang_translations": {
                                "ru": "<w>Минима́льный</w> возраст для получения водительских прав варьируется в зависимости от страны.",
                                "pl": "<w>Minimalny</w> wiek do uzyskania prawa jazdy różni się w zależności od kraju.",
                                "zh": "考取驾照的<w>最低</w>年龄因国家而异。"
                            }
                        },
                        {
                            "text": "There is a <w>minimum</w> charge for using a credit card at this store.",
                            "target_lang_translations": {
                                "ru": "В этом магазине существует <w>минима́льная</w> плата за использование кредитной карты.",
                                "pl": "W tym sklepie obowiązuje <w>minimalna</w> opłata za korzystanie z karty płatniczej.",
                                "zh": "在这家店使用信用卡有<w>最低</w>消费额。"
                            }
                        }
                    ],
                    "synonyms": [
                        "minimal",
                        "lowest",
                        "least"
                    ],
                    "antonyms": [
                        "maximum"
                    ],
                    "common_phrases": [
                        "minimum wage",
                        "minimum age",
                        "minimum charge",
                        "minimum standard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает наименьшее допустимое или возможное количество, степень или размер.",
                        "pl": "Używane do opisania najmniejszej dopuszczalnej lub możliwej ilości, stopnia lub rozmiaru.",
                        "zh": "用于描述允许或可能达到的最小数量、程度或尺寸。"
                    },
                    "translations": {
                        "ru": [
                            {
