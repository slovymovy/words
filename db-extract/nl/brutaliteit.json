                    {
                        "sense_id": "4384b5ce-53b0-3d7c-b67c-3de1c043b0d3",
                        "entry_id": "94715413-b501-3c88-9e67-4d7758f76ec8",
                        "glosses": [
                            "zich onbelemmerd door overwegingen van respect of ontzag gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0050f3b9-5916-4e29-b8fc-9e1c3f3d4c69",
                                "sense_id": "4384b5ce-53b0-3d7c-b67c-3de1c043b0d3",
                                "text": "Die brutaliteit zet ik je betaald!"
                            },
                            {
                                "example_id": "eae31360-f208-4302-bfe8-e2e4f7671dc3",
                                "sense_id": "4384b5ce-53b0-3d7c-b67c-3de1c043b0d3",
                                "text": "Poetin heeft een indrukwekkende lijst van internationale brutaliteiten op zijn naam staan: de inval in Georgië in 2008, de inname van de Krim en de operaties in het oosten van Oekraïne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eca87a1-1fa1-4ed5-8eb6-c967d38ad857",
                        "source_entry_id": "94715413-b501-3c88-9e67-4d7758f76ec8",
                        "source_sense_id": "4384b5ce-53b0-3d7c-b67c-3de1c043b0d3",
                        "target_lang_word": "Frechheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frechheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "603139c8-be40-3439-a9a8-f1265e01a11c",
                                        "entry_id": "57f07cd0-688f-3fc6-913c-fb90208004cd",
                                        "glosses": [
                                            "freche Art; das Frechsein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d28eb1e7-86ff-4e71-a32d-b1c46d6094b5",
                                                "sense_id": "603139c8-be40-3439-a9a8-f1265e01a11c",
                                                "text": "„Sie mochte wohl glauben, ihr Verhalten müsse mir als Geistesstärke, Charakterfestigkeit und hohes Vertrauen erscheinen, während ich es nur als maßlose Frechheit empfand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4a73a55-b252-31f7-b575-f0b7c6d7348b",
                                        "entry_id": "57f07cd0-688f-3fc6-913c-fb90208004cd",
                                        "glosses": [
                                            "eine respektlose, dreiste, freche Aussage oder Handlung; etwas Freches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a962ed09-bd80-4c51-b6ec-e0d62ccff5bf",
                                                "sense_id": "c4a73a55-b252-31f7-b575-f0b7c6d7348b",
                                                "text": "Es ist eine Frechheit, dass Sie sich hier alle Liegestühle mit Handtüchern reservieren!"
                                            },
                                            {
                                                "example_id": "e2b6e524-d090-4f14-8a97-f43277adcc14",
                                                "sense_id": "c4a73a55-b252-31f7-b575-f0b7c6d7348b",
                                                "text": "„Als Pécuchet den Vorschlag machte, einen Klub zu gründen, hatte Foureu die Frechheit zu antworten, so was würde es niemals geben in Chavignolles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "431ed54a-ddcf-4630-9f2a-0d2e7d05c0a0",
                        "source_entry_id": "94715413-b501-3c88-9e67-4d7758f76ec8",
                        "source_sense_id": "4384b5ce-53b0-3d7c-b67c-3de1c043b0d3",
