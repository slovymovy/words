                "senses": [
                    {
                        "sense_id": "b88f6134-a721-3088-820c-92e49da27ba1",
                        "entry_id": "23498da8-f179-39aa-9dd4-bcef91f2bc7d",
                        "glosses": [
                            "eine Frage einleitendes Pronomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1038f53-cfbf-4b44-8b33-d8e39d09495a",
                                "sense_id": "b88f6134-a721-3088-820c-92e49da27ba1",
                                "text": "Fragepronomen leiten Ergänzungsfragen oder indirekte Fragen ein."
                            },
                            {
                                "example_id": "8f4b8704-4875-4060-a098-3dc2070374b4",
                                "sense_id": "b88f6134-a721-3088-820c-92e49da27ba1",
                                "text": "Fragepronomen in einer Ergänzungsfrage: \"Wer kommt heute zu Besuch?\""
                            },
                            {
                                "example_id": "56bfaac4-d5e3-4684-a042-d6e929b1188e",
                                "sense_id": "b88f6134-a721-3088-820c-92e49da27ba1",
                                "text": "Fragepronomen in einer indirekten Frage: \"Er fragte mich, wer heute zu Besuch kommt.\""
                            },
                            {
                                "example_id": "afb1adbf-52fc-49d6-8146-2099dabcfd7c",
                                "sense_id": "b88f6134-a721-3088-820c-92e49da27ba1",
                                "text": "„Ins Deutsche übersetzt würde dasselbe Fragepronomen aus einem zweisilbigen Wort bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
