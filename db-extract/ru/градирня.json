                ],
                "senses": [
                    {
                        "sense_id": "1893ed5c-e01c-3b59-bcf6-c8b3d99a7ecf",
                        "entry_id": "ffe900fa-9b4c-327f-87e7-c33e7f697229",
                        "glosses": [
                            "техн. приспособление для градирования — выпаривания воды из соляного раствора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70a29472-86c4-42dd-ad14-cbe09dae7af2",
                                "sense_id": "1893ed5c-e01c-3b59-bcf6-c8b3d99a7ecf",
                                "text": "Всё та же озерна́я гладь, // Всё так же каплет соль с градирен."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9981dd7-73b0-3573-b62f-f4481c2454f1",
                        "entry_id": "ffe900fa-9b4c-327f-87e7-c33e7f697229",
                        "glosses": [
                            "техн. сооружение в виде башни — охладитель горячей воды на промышленных предприятиях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c08f5793-3f14-47ce-a77e-4e522e199a1d",
                                "sense_id": "d9981dd7-73b0-3573-b62f-f4481c2454f1",
                                "text": "Был праздничный день, и хотя в исполинских градирнях ТЭЦ шумела вода, над ними не было тех густых облаков пара, которыми окутаны в обычные дни их железобетонные кратеры."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b6211f9-0f78-4896-95ac-bd82c2fdda9a",
                        "source_entry_id": "ffe900fa-9b4c-327f-87e7-c33e7f697229",
                        "target_lang_word": "cooler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cooler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e1385de-ed40-3715-a689-3eeb259ad6b1",
                                        "entry_id": "5989fba1-3331-37c6-83d5-621e8f2e58ac",
                                        "glosses": [
                                            "Anything which cools."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a1153d-abca-4f25-b010-18901613e828",
                                                "sense_id": "6e1385de-ed40-3715-a689-3eeb259ad6b1",
                                                "text": "If acid Things were used only as Coolers, they would not be so proper in this Case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17493a96-4e4c-3abd-b944-2982b230e267",
                                        "entry_id": "5989fba1-3331-37c6-83d5-621e8f2e58ac",
                                        "glosses": [
                                            "An insulated bin or box used with ice or freezer packs to keep food or beverages cold while picnicking or camping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe8bdf6-da5f-41cb-9648-fc2489c926f2",
                                                "sense_id": "17493a96-4e4c-3abd-b944-2982b230e267",
                                                "text": "While Brown distracted the usually hyperfocused Mangini, safety Kerry Rhodes and linebackers Eric Barton and Jonathan Vilma grabbed a cooler of Gatorade and surreptitiously assumed their positions according to plan."
                                            },
                                            {
                                                "example_id": "727d606d-80d6-4221-9357-d3530036bfb6",
                                                "sense_id": "17493a96-4e4c-3abd-b944-2982b230e267",
                                                "text": "Two women were found unresponsive in a car along with the likely culprit – four coolers of dry ice – Friday morning in Pierce County, Washington, CNN affiliate KOMO reports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f34b3d1-2575-3f50-9ca1-fba2f69be80e",
                                        "entry_id": "5989fba1-3331-37c6-83d5-621e8f2e58ac",
                                        "glosses": [
                                            "A device for refrigerating dead bodies in a morgue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a449a5-d965-4760-8f1a-cc2fc500c9df",
                                                "sense_id": "2f34b3d1-2575-3f50-9ca1-fba2f69be80e",
                                                "text": "He recalls that experience in a smooth, speedy story, “The Monster Mash,” but these days he’s not sure he liked it too much — the disembowelings, the coolers of brains, the stench of decomposing corpses (“the smell of job security,” as one pathologist puts it) terrify him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf54b774-fe54-3104-99c5-634507f7913e",
                                        "entry_id": "5989fba1-3331-37c6-83d5-621e8f2e58ac",
                                        "glosses": [
                                            "A type of drink made with alcohol, especially wine, mixed with fruit juice."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "South-Africa",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495a28b0-4636-449c-b4e0-6d7d0cb5d045",
                                                "sense_id": "bf54b774-fe54-3104-99c5-634507f7913e",
                                                "text": "They served wine coolers in the afternoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f5d8dc5-9baf-3efc-9829-2b83e57f40d9",
                                        "entry_id": "5989fba1-3331-37c6-83d5-621e8f2e58ac",
                                        "glosses": [
                                            "samalamig drink (sweet chilled beverage, such as chilled fruit juice or other flavors like chocolate, coffee, sweet corn, etc., usually mixed with either shredded jelly and/or sago pearls or tapioca pearls)"
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7604f945-61b6-3481-8da5-e0c43d0d53e8",
                                        "entry_id": "5989fba1-3331-37c6-83d5-621e8f2e58ac",
                                        "glosses": [
                                            "Ellipsis of air cooler, evaporative cooler, desert cooler, or swamp cooler."
                                        ],
                                        "tags": [
                                            "India",
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
