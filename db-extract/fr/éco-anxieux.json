                        "examples": [
                            {
                                "example_id": "136e8129-c468-48ce-81d6-00b4c54160c8",
                                "sense_id": "929b2a11-49f9-3594-b246-ac72aecc1529",
                                "text": "Éco-anxieux, nous restons chez nous et assistons à l’altération ou à la disparition d’un environnement familier, souvent de façon définitive et sans possibilité de retour à un état originel."
                            },
                            {
                                "example_id": "7661e696-d2f8-4901-a4bf-5b4f04691a32",
                                "sense_id": "929b2a11-49f9-3594-b246-ac72aecc1529",
                                "text": "Je ne suis pas éco-anxieux, je suis inquiet, mais aussi bourré d’optimisme."
                            },
                            {
                                "example_id": "973b7e2c-c50a-43a5-9b18-ced704d04ee7",
                                "sense_id": "929b2a11-49f9-3594-b246-ac72aecc1529",
                                "text": "Il se dit lui-même éco-anxieux, inquiet de voir que le thérmomètre peut parfois dépasser les 40 °C dans son jardin du Cotentin, comme à l’été 2022."
                            }
                        ]
                    }
