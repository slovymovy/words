                    {
                        "sense_id": "a50c804d-bdcf-3980-8174-ac4b7eb6b5fd",
                        "entry_id": "c1aad270-be03-3dda-9a0a-322fb812314b",
                        "glosses": [
                            "Bezeichnung für Vertreter der russischen Geheimdienste und des Militärs, die in den Regierungen unter Boris Jelzin und vor allem Wladimir Putin zu bedeutenden politischen und wirtschaftlichen Positionen kamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba7541b-4830-46bb-86d8-cd924b4cbb29",
                                "sense_id": "a50c804d-bdcf-3980-8174-ac4b7eb6b5fd",
                                "text": "„›Du redest verrücktes Zeug, Dummerchen. Wir Russen verlassen Russland und ziehen hierher, wenn wir's uns leisten können, weil der Kreml uns sonst unsere Vermögen abknöpft. Nur hier sind sie in Sicherheit vor der Gier der Silowiki, die in der Rodina das Sagen haben.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
