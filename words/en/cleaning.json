                    "sense_definition": "Present participle and gerund of <w>clean</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>cleaning</w> her room to make it tidy.",
