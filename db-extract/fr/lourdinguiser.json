                        "sense_id": "338830c1-e7ad-3d44-b0ad-760543e0c308",
                        "entry_id": "3377fd36-347c-3392-acf5-90409700885e",
                        "glosses": [
                            "Donner un caractère lourdingue à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84cb3d0a-34a5-4edc-ba28-55ef5f2243ae",
                                "sense_id": "338830c1-e7ad-3d44-b0ad-760543e0c308",
                                "text": "Les ficelles sont grosses: rabattage lourdingue, accueil lourdingue, nourriture lourdingue et addition frauduleusement lourdinguisée..."
                            },
                            {
                                "example_id": "075b9f20-7d0e-488a-9e29-3cc40b43e406",
                                "sense_id": "338830c1-e7ad-3d44-b0ad-760543e0c308",
                                "text": "Pas facile de comprendre nos vieux, c'est si tentant d'essayer plutôt de les renier ! Suffit ! de lourdinguiser ce vendredi verdissant"
                            },
                            {
                                "example_id": "712982e3-cb13-41f3-99b5-4d30d77a45f9",
                                "sense_id": "338830c1-e7ad-3d44-b0ad-760543e0c308",
                                "text": "arrête avec ça, ça me lourdinguise en ce moment"
                            }
                        ]
                    }
