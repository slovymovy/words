                "senses": [
                    {
                        "sense_id": "fb88166e-4ddb-3581-a8ac-4e76a5c15944",
                        "entry_id": "40fd3e47-9696-3c85-9556-89b460536dcf",
                        "glosses": [
                            "een stad gelegen in Zuid-Afghanistan en de hoofdstad van de gelijknamige provincie"
                        ],
