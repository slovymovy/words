                    {
                        "sense_id": "9c5483e0-8a1d-3d65-9965-94e6d4dbf056",
                        "entry_id": "e187a1bd-aa49-3803-96ec-0b8ff0174301",
                        "glosses": [
                            "To make something routine, automatic or monotonous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f162bf0c-b547-4c6f-b3ce-f3c7a2d4d0ba",
                                "sense_id": "9c5483e0-8a1d-3d65-9965-94e6d4dbf056",
                                "text": "The engineering department of the Sinkiang Posts and Telecommunications Control Bureau fully utilized both native and foreign methods to carry out innovation and technical revolution. About 80 percent of its line work are now mechanized. A remote control switch for the radio transmitter was test-produced by the Kashgar and A-k'o-su bureaus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae868e0a-1e2c-44db-874f-37c069c44d3f",
                        "source_entry_id": "e187a1bd-aa49-3803-96ec-0b8ff0174301",
                        "source_sense_description": "to equip with machinery",
                        "target_lang_word": "mécaniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mécaniser",
