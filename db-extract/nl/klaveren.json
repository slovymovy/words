                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3929df9a-465c-36c0-9e09-f41e2cd0539f",
                                        "entry_id": "f61d8fd2-04b0-3c65-a3fd-9653af4d7b3e",
                                        "glosses": [
                                            "Symbol",
                                            "für Jesus Christus, für das Christentum, für die christlichen Kirchen, für den Klerus, für die Kreuzigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64abba9e-00b0-4af2-a615-43d5ab5db406",
                                                "sense_id": "3929df9a-465c-36c0-9e09-f41e2cd0539f",
                                                "text": "Jesus starb am Kreuz."
                                            },
                                            {
                                                "example_id": "0d50d698-cef6-4572-aa7f-0af539ade497",
                                                "sense_id": "3929df9a-465c-36c0-9e09-f41e2cd0539f",
                                                "text": "Das Kreuz ist das Zeichen des Christentums."
                                            },
                                            {
                                                "example_id": "bedf9d9a-69f2-48b2-903b-a3b3d0491792",
                                                "sense_id": "3929df9a-465c-36c0-9e09-f41e2cd0539f",
                                                "text": "„Andere hat er gerettet, sich selbst kann er nicht retten. Er ist doch der König von Israel! Er soll jetzt vom Kreuz herabsteigen, dann werden wir an ihn glauben.“"
                                            },
                                            {
                                                "example_id": "1cd3d54c-ffda-4726-93be-f230ded4fc2f",
                                                "sense_id": "3929df9a-465c-36c0-9e09-f41e2cd0539f",
                                                "text": "„Grabsteine und Kreuze waren umgekippt und lagen kreuz und quer übereinander.“"
                                            },
                                            {
                                                "example_id": "c4f7a199-2713-4b9f-8032-0db5ff042bbd",
                                                "sense_id": "3929df9a-465c-36c0-9e09-f41e2cd0539f",
                                                "text": "„Der Pastor hielt das Kreuz vor seinen wohlgewölbten Bauch, als mache er sich gleich auf zur Prozession.“"
                                            },
                                            {
                                                "example_id": "d14b7e8c-243e-46a2-aeef-d6a143956ab1",
                                                "sense_id": "3929df9a-465c-36c0-9e09-f41e2cd0539f",
                                                "text": "„Dort hält ein geharnischter steinerner Engel die Lanze, mit der Christus am Kreuz die Seitenwunde beigebracht wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ccb84766-dbd9-35b4-a77d-581d2b69f060",
                                        "entry_id": "f61d8fd2-04b0-3c65-a3fd-9653af4d7b3e",
                                        "glosses": [
                                            "Symbol",
                                            "für verschiedene Hilfsorganisationen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "c360c2b6-1777-3672-8678-b2f2d98442cc",
