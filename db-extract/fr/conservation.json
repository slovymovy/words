        "fr-extract.jsonl": [
            {
                "entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                "word": "conservation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a8170b32-654b-4d27-bbf5-1adfed8ff2a8",
                        "entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                        "tags": [
                            "plural"
                        ],
                        "form": "conservations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                        "entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                        "glosses": [
                            "Action de conserver ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ada1b780-d1fc-4ee9-bec5-2a53ddd2fcc3",
                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                "text": "Tout homme est chargé de sa conservation sous peine de souffrance, et il souffre seul quand il manque à ce devoir envers lui même, ce qui l’oblige à le remplir préalablement à tout autre."
                            },
                            {
                                "example_id": "212e81d6-0dc1-4524-a154-aa92ab1d6c22",
                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                "text": "Une conservation prolongée exigera la congélation, qui s'opère à des températures allant jusqu'à - 12 °. C'est une opération qui ne pourra se faire qu'au frigo même."
                            },
                            {
                                "example_id": "7581712c-84d4-4481-8476-9243441b0551",
                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                "text": "Vous me répondez : « Je ne fais de mal à personne. » Attention : la haine n’est pas le contraire de l’amour ; c’est l’égoïsme qui s’oppose à l’amour, ou plus exactement, monsieur, un sentiment dont vous entendrez désormais beaucoup parler en bien et en mal : l’esprit de conservation."
                            },
                            {
                                "example_id": "7e18efa3-75ae-4c98-817e-7fb6e8b76a70",
                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                "text": "…deux ouvriers recouvrent les poissons d'une pelletée de sel avant de les précipiter dans une fosse de conservation."
                            },
                            {
                                "example_id": "ba7ea3e4-cb4e-474c-a33b-150fecb98fc7",
                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                "text": "On parle généralement de conservation lorsqu’il s’agit de maintenir des races dont les effectifs sont en déclin et sont susceptibles de continuer à décroître jusqu’à extinction si aucune mesure de sauvegarde n’est prise."
                            }
                        ]
                    },
                    {
                        "sense_id": "93135ffc-3936-3008-9d22-db10dda34d8d",
                        "entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                        "glosses": [
                            "Qualité de ce qui est bien entier, bien conservé, en bon état."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0cf0b91c-b253-4215-9399-3b8e0e6f47b3",
                                "sense_id": "93135ffc-3936-3008-9d22-db10dda34d8d",
                                "text": "Ce tombeau est un monument fort intéressant, bien que la figure du personnage, traitée en bas-relief, soit médiocre ; le simulacre du sarcophage qui la porte donne une série de figurines d’une conservation parfaite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c179c68-47e2-4428-9015-6322b8256323",
                        "source_entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                        "target_lang_word": "conservation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b841e06b-000f-3722-8e9a-121a81dc6469",
                                        "entry_id": "52da0ae8-3a37-34c0-99f9-35492e95eea3",
                                        "glosses": [
                                            "The act of preserving, guarding, or protecting; the keeping (of a thing) in a safe or entire state; preservation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dfb02b9-c855-3835-be26-adc7bd9f9965",
                                        "entry_id": "52da0ae8-3a37-34c0-99f9-35492e95eea3",
                                        "glosses": [
                                            "Wise use of natural resources."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b62d16c-e52b-4eec-b585-d4a7ea2941b0",
                                                "sense_id": "2dfb02b9-c855-3835-be26-adc7bd9f9965",
                                                "text": "“My father had ideas about conservation long before the United States took it up.[…]You preserve water in times of flood and freshet to be used for power or for irrigation throughout the year. …”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c830d89-09ce-3fb0-b508-9eb42f99fb41",
                                        "entry_id": "52da0ae8-3a37-34c0-99f9-35492e95eea3",
                                        "glosses": [
                                            "The discipline concerned with protection of biodiversity, the environment, and natural resources"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbe462d3-6fcb-38d5-a973-e595473a4b66",
                                        "entry_id": "52da0ae8-3a37-34c0-99f9-35492e95eea3",
                                        "glosses": [
                                            "Genes and associated characteristics of biological organisms that are unchanged by evolution, for example similar or identical nucleic acid sequences or proteins in different species descended from a common ancestor"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d0b2bf5-8bc0-39ad-9d75-de7d4c00cbdf",
                                        "entry_id": "52da0ae8-3a37-34c0-99f9-35492e95eea3",
                                        "glosses": [
                                            "The protection and care of cultural heritage, including artwork and architecture, as well as historical and archaeological artifacts"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49d107c3-8bea-3611-8818-328f2f2bc9fb",
                                        "entry_id": "52da0ae8-3a37-34c0-99f9-35492e95eea3",
                                        "glosses": [
