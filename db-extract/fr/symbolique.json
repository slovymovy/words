                        "form_id": "58db77e6-b751-4144-becc-ab4c55e24a0c",
                        "entry_id": "c0edf4d9-b23a-376b-a82d-059ff7441629",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "symboliques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5757f4d7-fffb-39f3-bcce-fcc0f54d941d",
                        "entry_id": "c0edf4d9-b23a-376b-a82d-059ff7441629",
                        "glosses": [
                            "Qui se rapporte à un symbole, qui sert de symbole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8aeea2-3cfe-4890-b109-67e798ed098f",
                                "sense_id": "5757f4d7-fffb-39f3-bcce-fcc0f54d941d",
                                "text": "Le 14 juillet 1888, le « 52 » ouvre enfin ses portes. Le choix de la date d’ouverture de la maison close est éminemment symbolique et commercial."
                            },
                            {
                                "example_id": "8bd1f6c9-4c1a-401c-8810-cd466c4c94a3",
                                "sense_id": "5757f4d7-fffb-39f3-bcce-fcc0f54d941d",
                                "text": "Les blasons sont couverts de dessins symboliques."
                            }
                        ]
                    },
                    {
                        "sense_id": "056e3ac3-77ce-31a1-91dc-68be1dd50fc7",
                        "entry_id": "c0edf4d9-b23a-376b-a82d-059ff7441629",
                        "glosses": [
                            "Qui utilise des symboles, qui est constitué de symboles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898a5454-abe6-46e3-a489-20674aeaa088",
                                "sense_id": "056e3ac3-77ce-31a1-91dc-68be1dd50fc7",
                                "text": "Écriture symbolique, sorte d’écriture hiéroglyphique."
                            }
                        ]
                    },
                    {
                        "sense_id": "f78fb4f9-9855-3896-afac-c26fdd0bb9ed",
                        "entry_id": "c0edf4d9-b23a-376b-a82d-059ff7441629",
                        "glosses": [
                            "Qui n’a de valeur que par son expression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af964cf2-f433-45a7-b3f9-ca9cee6eb0e5",
                                "sense_id": "f78fb4f9-9855-3896-afac-c26fdd0bb9ed",
                                "text": "Les nonnes fertiles lui offrent, aux périodes lunaires, une goutte symbolique de leur dégoulinure."
                            },
                            {
                                "example_id": "a8ee37ac-47d6-479a-8e55-6f8e1c055aed",
                                "sense_id": "f78fb4f9-9855-3896-afac-c26fdd0bb9ed",
                                "text": "Ils ne voient que la valeur symbolique que l’on accorde à ces couleurs n’a rien à voir avec les couleurs elles-mêmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c0334fe-dcaf-4c2c-86da-4d149114a29f",
                        "source_entry_id": "c0edf4d9-b23a-376b-a82d-059ff7441629",
