                    "sense_id": "5637a365-0501-3294-8235-df3d639ac3e2",
                    "sense_definition": "Previously mentioned or referred to earlier in a text or speech.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aforementioned</w> report provides a detailed analysis of the current economic situation.",
                            "target_lang_translations": {
