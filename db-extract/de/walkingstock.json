                "senses": [
                    {
                        "sense_id": "d17b3fa0-02e7-3e96-b903-96a412f62fbc",
                        "entry_id": "63873957-5cc5-3722-9b29-40c2b9f4325a",
                        "glosses": [
                            "Sportgerät, das beim Nordic Walking das schnelle Gehen unterstützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b044a876-9bca-45cb-ae04-a0f7021879d2",
                                "sense_id": "d17b3fa0-02e7-3e96-b903-96a412f62fbc",
                                "text": "„Der Priester drückt sich gegenüber in den Eingang eines Modegeschäfts, lässt die Walkingstöcke dort liegen und schleicht zurück.“"
                            },
                            {
                                "example_id": "1f2647cd-1615-4de8-aef0-12ff9dd4230c",
                                "sense_id": "d17b3fa0-02e7-3e96-b903-96a412f62fbc",
                                "text": "„Den Untersuchungsbefund leitet der Sachverständige mit der Beschreibung ein, dass die Beschwerdeführerin in Stiefeletten zur Untersuchung kommt und zwei Walkingstöcke verwendet, den Oberkörper beim Gehen weit nach vorne neigt und das Gangbild eher kleinschrittig ausführt, dieses aber insgesamt symmetrisch und sicher ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
