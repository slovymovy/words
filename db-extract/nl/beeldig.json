                    {
                        "sense_id": "9bd41233-0c99-3326-af9a-ffdaeaf1c13b",
                        "entry_id": "e9a6a1c5-9b57-3713-92a9-06c8ef70465a",
                        "glosses": [
                            "mooi alsof het een plaatje is"
                        ],
