                "senses": [
                    {
                        "sense_id": "becfd617-85f7-33f7-b364-89b49b15ed48",
                        "entry_id": "13a2f22d-cf69-32ea-a00a-d40fad23609f",
                        "glosses": [
                            "To steal."
                        ],
                        "tags": [
                            "Ireland",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b66ac341-8bec-456c-bea9-c85824ece514",
                                "sense_id": "becfd617-85f7-33f7-b364-89b49b15ed48",
                                "text": "—But why did they run away, tell us?\n —I know why, Cecil Thunder said. Because they had fecked cash out of the rector's room.\n —Who fecked it?\n —Kickham's brother. And they all went shares in it. But that was stealing. How could they have done that?"
                            },
                            {
                                "example_id": "bf636aa2-93c6-42ac-99bf-8c4fd16bf999",
                                "sense_id": "becfd617-85f7-33f7-b364-89b49b15ed48",
                                "text": "And isn't it pure gangsters run the car parks, the price of them, and security cameras my arse, begging your pardon, sure it's watching videos they'd be, while some scut of a ten-year-old's fecking your tape machine and maybe going back to break off the aerial if they don't approve of your taste in music."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
