                                            {
                                                "example_id": "b708850f-94fc-4eed-b3d9-0f9236b9cb3d",
                                                "sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                                                "text": "Unlike the orderly or batman, a humble low-ranking servant, an aide-de-camp is often a general, who before the institution of the chief of staff could hold a similar position to his chief."
                                            },
                                            {
                                                "example_id": "b17eb92d-2488-4504-854c-827967c3d9a3",
                                                "sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                                                "text": "The police uncovered the plot after recovering information from the phone of Bolsonaro’s former personal secretary, Lt Col Mauro Cid, who served as Bolsonaro’s aide-de-camp during his 2019–2023 presidency."
                                            }
