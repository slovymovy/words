                        "sense_id": "716871f1-120c-3dc6-a367-b5d02e3a0978",
                        "entry_id": "aa662bd3-ccae-3f4b-a37e-6cea59aa1913",
                        "glosses": [
                            "Van een binnenschip: de plaats waarvandaan het schip wordt bestuurd. Cockpit (vliegtuig), Cabine (trein),"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd8d36bc-c2a0-437a-8be5-1cfa96e9ab05",
                                "sense_id": "716871f1-120c-3dc6-a367-b5d02e3a0978",
                                "text": "In de zeevaart wordt de stuurhut het stuurhuis genoemd, dat gewoonlijk op de brug zit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42772cbd-4633-468b-a36f-2823355b72db",
                        "source_entry_id": "aa662bd3-ccae-3f4b-a37e-6cea59aa1913",
                        "source_sense_id": "716871f1-120c-3dc6-a367-b5d02e3a0978",
                        "target_lang_word": "Ruderhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0aeab7bc-b5f8-418e-908e-2a0645c2916c",
                        "source_entry_id": "aa662bd3-ccae-3f4b-a37e-6cea59aa1913",
                        "source_sense_id": "716871f1-120c-3dc6-a367-b5d02e3a0978",
                        "target_lang_word": "wheelhouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wheelhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41a63c3d-0f3a-3155-a173-ddc1cbf1188f",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A building or other structure containing a (large) wheel, such as the water wheel of a mill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdad1b96-3ef7-40b5-8d10-bd03dd8a7439",
                                                "sense_id": "41a63c3d-0f3a-3155-a173-ddc1cbf1188f",
                                                "text": "A machine with two pair of moulds only, will make from fifty to seventy thousand bricks per week. But if the regular market be large, it can, by using a steam machine of 10 horse power, work sixteen moulds, (four on each side of the wheel house,) and make two hundred thousand bricks per week."
                                            },
                                            {
                                                "example_id": "c8903018-86ea-4430-84c2-0c9f58f4296b",
                                                "sense_id": "41a63c3d-0f3a-3155-a173-ddc1cbf1188f",
                                                "text": "The mill was driven by an overshot wheel twenty-seven and a half feet in diameter, placed in a separate wheel-house, built of stone, between the mill and a bank thirty feet high, upon which the water was brought by a canal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cab5f23-a15e-3d93-8403-ef878a51c2db",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A building or other structure containing a (large) wheel, such as the water wheel of a mill.",
                                            "The partially enclosed structure above and around a wheel of an automobile, typically partly formed by a portion of a fender panel that has been extended outward beyond the plane of the rest of the panel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4e1712-bcab-4ddb-b0c3-5489a1d3e429",
                                                "sense_id": "0cab5f23-a15e-3d93-8403-ef878a51c2db",
                                                "text": "This invention relates to an improved device for hanging the body of carriages having a so-called \"cut-under\" or wheel-house, such as a common rockaway, extension-top phaeton, coupé-rockaway, &c., [...]"
                                            },
                                            {
                                                "example_id": "255f7200-1176-4b5a-ab24-8992e89abd9c",
                                                "sense_id": "0cab5f23-a15e-3d93-8403-ef878a51c2db",
                                                "text": "To install a new outer wheelhouse in a convertible, measure (at 1-in. intervals) the distance from the reinforcement that runs along the top of the old wheelhouse to the flange where the inner and outer wheelhouses are joined. Then transfer these measurements onto the new wheelhouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f1ac83-f5e5-3b20-a3be-f96bff507047",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A building or other structure containing a (large) wheel, such as the water wheel of a mill.",
                                            "An enclosed compartment on the deck of a vessel such as a fishing boat, originally housing its helm or steering wheel, from which it may be navigated; on a larger vessel it is the bridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f55a7a-021a-4919-a51f-696f73922c7c",
                                                "sense_id": "e7f1ac83-f5e5-3b20-a3be-f96bff507047",
                                                "text": "Captain Waterman was on the wheel-house at the time of the explosion, attending to the landing of passengers from the small boat. He noticed a movement over the boilers, and immediately jumped or was thrown upon the forward deck. He was somewhat bruised, but not seriously injured."
                                            },
                                            {
                                                "example_id": "a6512b19-c1cd-45de-8b6d-ec7e883420c0",
                                                "sense_id": "e7f1ac83-f5e5-3b20-a3be-f96bff507047",
                                                "text": "The wheel-house is a small room or closet, with windows in front, built on the deck, in the forward part of the boat, where the helmsman stands to steer. The windows in the front of the wheel-house are for him to look out, and see where he is going. [...] There is a large wheel in this place, which is the reason why they call it the wheel-house. The wheel has handles to it, all around, for the man to take hold of, to turn the wheel one way or the other."
                                            },
                                            {
                                                "example_id": "be9b632f-92f2-4925-85d2-6a666cb5bfd7",
                                                "sense_id": "e7f1ac83-f5e5-3b20-a3be-f96bff507047",
                                                "text": "Affiant further states that thereupon Judge-Advocate Portocarrero, closely followed by Minister Madriz, rushed into the wheelhouse of the steamship Yulu. They were both white with anger, and Portocarrero had in his right hand, with his finger on the spring, a clasp knife with a blade about 8 inches long."
                                            },
                                            {
                                                "example_id": "4f39abb8-60db-4063-87fb-6018f7731154",
                                                "sense_id": "e7f1ac83-f5e5-3b20-a3be-f96bff507047",
                                                "text": "I last saw William Saunders, the mate of the said vessel, alive on the morning of August the 6th, 1897, on the left side of the forecastle head of that vessel. It was between nine and ten o'clock of that morning. He was shot at that time and place by John Andersen, the cook of the vessel and the prisoner here. I saw him shoot him. I was at the wheel of the vessel, in the wheelhouse, just aft of the aftercabin."
                                            },
                                            {
                                                "example_id": "fb2c78c0-1973-43a0-86de-53e5e8f87de7",
                                                "sense_id": "e7f1ac83-f5e5-3b20-a3be-f96bff507047",
                                                "text": "Early the next morning Leander walked down the fish-smelling path to the wharf where the Topaze lay. A dozen passengers were waiting to buy their tickets and go aboard. Then he noticed a sign had been hung on his wheelhouse. [...] no trespassing, it said. this yacht for sale. for further information see honora wapshot 27 boat street."
                                            },
                                            {
                                                "example_id": "4f48ddb5-e6b2-4167-aa29-97856a141a68",
                                                "sense_id": "e7f1ac83-f5e5-3b20-a3be-f96bff507047",
                                                "text": "He looked aft just before going back into the wheelhouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cbb0960-6d6d-3a29-a3df-bd23e895dc51",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A building or other structure containing a (large) wheel, such as the water wheel of a mill.",
                                            "The enclosed structure around the paddlewheel of a steamboat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e6a7b3-9fd8-450c-8f4d-35f6d82cd3d8",
                                                "sense_id": "0cbb0960-6d6d-3a29-a3df-bd23e895dc51",
                                                "text": "PLATE XXVII.—Details of the Paddle Wheel of the Steamboat \"North America.\" Fig. 1, shows the outside framing of the paddle-box, or as it is frequently termed, the wheel-house; also an elevation of the paddle-wheel, shewing the arrangement of the buckets, arms, centre-plate, &c."
                                            },
                                            {
                                                "example_id": "2bf172e9-296e-48fe-b48c-4c2dddd2c487",
                                                "sense_id": "0cbb0960-6d6d-3a29-a3df-bd23e895dc51",
                                                "text": "These little rooms have each a half glass door, which opens on a gallery running all round the boat, with only the interruption of the wheel-houses, outside of which is a door of Venetian blinds, which being thrown open, you can sit in your room and see every object on one side of the river."
                                            },
                                            {
                                                "example_id": "250c6cb6-1a42-4bc5-8706-c3386caf8e37",
                                                "sense_id": "0cbb0960-6d6d-3a29-a3df-bd23e895dc51",
                                                "text": "The Eureka broke an arm in her larboard wheel[-]house with a tremendous crash, tearing the whole structure away. She crawled back to the city to refit.—Journal Com. April 10."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a285524-e455-3673-9866-6a91304b286a",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A prehistoric structure from the Iron Age found in Scotland, characteristically including an outer wall within which a circle of stone piers (resembling the spokes of a wheel) form the basis for lintel arches supporting corbelled roofing with a hearth at the hub."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15e0ad0-3aae-4941-a350-0459ca5c5c93",
                                                "sense_id": "2a285524-e455-3673-9866-6a91304b286a",
                                                "text": "Most Celtic houses in Britain were simply constructed. They were generally round as in the remains of the house at Little Woodbury in Wiltshire, the wheelhouse at Jarlshof in Shetland, or the house on an unenclosed platform at Greenknowe in Berwickshire. [...] The roof of the Greenknowe house was conical. It had rafters fanning outwards from a high top, like the spokes of an umbrella. You can see why it is called a wheelhouse. The rafters were held at their lower ends on a horizontal ring of timber that rested on vertical posts with Y-shaped tops."
                                            },
                                            {
                                                "example_id": "59ef8a57-9b0a-486f-842d-3f3877c32df1",
                                                "sense_id": "2a285524-e455-3673-9866-6a91304b286a",
                                                "text": "Ancestors of the historical Picts can be credited with the structural form of the wheelhouse with its western and northern affinities, and with the souterrain, and distribution and function of which is becoming clearer, but which may now be thought to have persisted in evolved form until the middle part of the first millennium AD [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e055d2-57c2-3644-a749-e3887d2e37c5",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A pitch location which is favourable to the hitter."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ec673c-166d-4540-a475-c16428c51136",
                                                "sense_id": "c4e055d2-57c2-3644-a749-e3887d2e37c5",
                                                "text": "The pitch was right in his wheelhouse, and he hit a grand slam."
                                            },
                                            {
                                                "example_id": "de2a37a5-a466-4e4c-a863-044441e14961",
                                                "sense_id": "c4e055d2-57c2-3644-a749-e3887d2e37c5",
                                                "text": "The ball was up in my wheelhouse, and I got round on it, got the meat of that Ritchie Ashburn bottle bat solidly on the ball. I'll never in my life hit a ball any better."
                                            },
                                            {
                                                "example_id": "f4c648fc-a651-4880-b3e2-4c4071d8dd35",
                                                "sense_id": "c4e055d2-57c2-3644-a749-e3887d2e37c5",
                                                "text": "The next pitch was close to my wheelhouse so I just let 'er rip. I got ahold of it and shot it to left field on the line."
                                            },
                                            {
                                                "example_id": "726c48b7-ca50-42ea-9fab-078129e6bf5b",
                                                "sense_id": "c4e055d2-57c2-3644-a749-e3887d2e37c5",
                                                "text": "Here is the ball, in my wheelhouse. I slide my hips out of the way, put myself in place to hit the coldie of a lifetime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A person's area of authority or expertise."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5924354-9557-4179-b813-26852d8bdd8f",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "Horse viruses are in Pat’s wheelhouse."
                                            },
                                            {
                                                "example_id": "86741384-5860-4747-877d-7efbf5dd3b9a",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "Turning out terrific subordinates was not in her wheelhouse. [...] But she did so, mostly by force of will and with a number of false starts and midcourse corrections, and went on to become an icon in her industry."
                                            },
                                            {
                                                "example_id": "b2405496-36fb-4980-a507-597427e62759",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "I watched as Vic digested the information. His career was built on analyzing intel and making tactical decisions, and this was right in his wheelhouse."
                                            },
                                            {
                                                "example_id": "256df183-f426-4108-8b6c-c11271956eb2",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "If an app is entertaining, and especially if it contains age-appropriate humor, that increases its appeal. You just need to keep the learning in a Digitod's [i.e., a digital toddler's] wheelhouse (for you non-baseball fans, that's his prime area of ability)."
                                            },
                                            {
                                                "example_id": "97c95ca2-3066-49dd-bfc4-1d19ae069a90",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "Similarly, it has been beyond the scope of health care providers or other Intermediaries to address well-being. These concerns and measures are simply not in their wheelhouses and not high on their priority lists."
                                            },
                                            {
                                                "example_id": "9e5bbd1c-b849-483c-93bf-3405368f3e1c",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "What the film rarely does is challenge or interrogate the fan culture to which it plays uncritical tribute. Wade and his friends, including a trigger-happy cyborgian alpha nerd whose offline identity the film handles more tastefully than the book did, are possessive gatekeepers, viciously protective of their pop-culture wheelhouse."
                                            },
                                            {
                                                "example_id": "53002b96-8e34-4abd-992f-6cda7508178b",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "“Here,” she said, “if we’re thinking about E.P.A. regulating greenhouse gases, well, there’s a match between the regulation and the agency’s wheelhouse, right?”"
                                            },
                                            {
                                                "example_id": "31e5fcdc-02be-4ab3-822f-e43c59a68af2",
                                                "sense_id": "29bf49e9-c4f5-3098-9b6b-15af503ff266",
                                                "text": "Mike Schroepfer, Meta’s former chief technology officer, who has known the couple for almost two decades, said they focused on science partly because it was “much more in their wheelhouse.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8f5a8c4-4fc6-37dc-a613-c609a72c0142",
                                        "entry_id": "dedcadcc-9f84-33d8-8726-6cbc6d370a49",
                                        "glosses": [
                                            "A set of skills necessitated by a situation."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4ea4201-dccc-4c3a-aaa1-6a7f0f8253de",
                                                "sense_id": "e8f5a8c4-4fc6-37dc-a613-c609a72c0142",
                                                "text": "Ever since I started taking antipsychotics, managing my mental health has been a whole different wheelhouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
