    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2dbd82be-3ec8-3cfa-a8c2-769ff6d48277",
                    "sense_definition": "Effacer ou retirer des données d'un support informatique ou de la mémoire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>supprimer</w> un message si tu ne veux pas le conserver."
                        },
                        {
                            "text": "Elle a <w>supprimé</w> tous les anciens fichiers de son ordinateur portable."
                        }
                    ],
                    "synonyms": [
                        "effacer"
                    ],
                    "antonyms": [
                        "ajouter",
                        "conserver",
                        "enregistrer",
                        "sauvegarder"
                    ],
                    "common_phrases": [
                        "supprimer un fichier",
                        "supprimer un message",
                        "supprimer un compte"
                    ]
                },
                {
                    "sense_id": "a056d9d9-e7a0-32cb-a776-5b9c4adbf091",
                    "sense_definition": "Faire cesser d'exister, abolir ou annuler légalement ou administrativement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abolition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction envisage de <w>supprimer</w> plusieurs emplois au cours de l'année."
                        },
                        {
                            "text": "Le gouvernement a décidé de <w>supprimer</w> cette taxe dès le mois prochain."
                        }
                    ],
                    "antonyms": [
                        "conserver"
                    ],
                    "common_phrases": [
                        "supprimer un poste",
                        "supprimer une taxe",
                        "supprimer un emploi"
                    ]
                },
                {
                    "sense_id": "7d69b799-c16b-3713-b17a-9fd7a5d29e3f",
                    "sense_definition": "Retrancher ou ôter un élément d'un ensemble pour l'alléger ou le modifier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a vivement conseillé de <w>supprimer</w> le sucre de son alimentation."
                        },
                        {
                            "text": "Vous devez <w>supprimer</w> ce paragraphe pour raccourcir votre texte de présentation."
                        }
                    ],
                    "antonyms": [
                        "ajouter"
                    ],
                    "common_phrases": [
                        "supprimer le sucre",
                        "supprimer un paragraphe"
                    ]
                },
                {
                    "sense_id": "3e2f936e-560a-35a9-af88-55498bc6da4f",
                    "sense_definition": "Faire disparaître une personne en la tuant ; assassiner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "meurtre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le malfaiteur cherchait un moyen efficace de <w>supprimer</w> le témoin gênant."
                        },
                        {
                            "text": "Dans ce polar captivant, un inconnu <w>supprime</w> méthodiquement tous ses rivaux."
                        }
                    ],
                    "common_phrases": [
                        "supprimer un témoin",
                        "supprimer un rival"
                    ]
                },
                {
                    "sense_id": "9227254f-7434-3ebd-b1ea-3066fa949166",
                    "sense_definition": "Interdire la diffusion ou faire disparaître un passage jugé inopportun ; censurer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "censure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité de rédaction a <w>supprimé</w> les passages les plus polémiques de l'article."
                        },
                        {
                            "text": "Le journal a dû <w>supprimer</w> cette chronique avant son impression définitive."
                        }
                    ],
                    "common_phrases": [
                        "supprimer un passage"
                    ]
                }
            ]
        }
    ]
