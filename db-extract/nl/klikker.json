                "senses": [
                    {
                        "sense_id": "d789e01e-df3f-3167-bb2d-6c20110608b0",
                        "entry_id": "31155de0-4b0d-3808-aa17-6f741e4ef5e1",
                        "glosses": [
                            "iemand die tegen het bevoegd gezag vertelt dat iemand anders iets verkeerds heeft gedaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a46c2e-854d-4af8-96f7-6f79707e9b28",
                                "sense_id": "d789e01e-df3f-3167-bb2d-6c20110608b0",
                                "text": "Ondernemers die over elkaar klikken doen dat vrijwel altijd uit eigen belang, blijkt uit onderzoek naar kliklijnen door de Universiteit van Utrecht. Geen reden om de melding niet serieus te nemen, menen de onderzoekers."
                            }
                        ]
                    },
                    {
                        "sense_id": "057f4913-0239-3646-a4d7-1e506379f151",
                        "entry_id": "31155de0-4b0d-3808-aa17-6f741e4ef5e1",
                        "glosses": [
                            "iemand die internetlinks aanklikt met zijn muis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4122668f-1833-4d6c-bc5e-f0eb83ac2bfe",
                                "sense_id": "057f4913-0239-3646-a4d7-1e506379f151",
                                "text": "Jo Neus is een klikker. Klikkenklikkenklikken doet hij een paar uur per dag, met zijn computermuis, op advertentiepagina's. Zo verdient Jo wel 20 cent per uur."
                            }
                        ]
                    },
                    {
                        "sense_id": "6da644c0-1b5d-3af4-a1b2-2d3f7091b52b",
                        "entry_id": "31155de0-4b0d-3808-aa17-6f741e4ef5e1",
                        "glosses": [
                            "apparaat dat een klikkend geluid maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be6eb5b0-e6d5-4ac8-8ce2-4e2bc81cbb33",
                                "sense_id": "6da644c0-1b5d-3af4-a1b2-2d3f7091b52b",
                                "text": "Meyers uit Germantown, Maryland heeft de kip piano leren spelen door middel van een klikker. Elke keer als de kip een noot speelde, klikte Meyers met de klikker en beloonde Jokgu vervolgens met een beetje voer. Daarna leerde ze de kip pikken op rood oplichtende toetsen van het keyboard. De video van America, The Beautiful kwam afgelopen dinsdag online en is al 230.000 keer bekeken."
                            },
                            {
                                "example_id": "b05ba8ed-ebe9-4baf-93ca-82ea7a60565b",
                                "sense_id": "6da644c0-1b5d-3af4-a1b2-2d3f7091b52b",
                                "text": "Noteboom legt uit wat er gebeurde. “Robin heeft een schot gelost op een moment dat het niet moest. Er stonden tientallen fotografen en hij dacht dat zijn klikker afging, terwijl dat niet zo was en hij dus te vroeg schoot.”"
                            }
                        ]
                    }
