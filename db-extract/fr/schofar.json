                                    {
                                        "sense_id": "6e63a26e-93a3-3508-9550-b2571832a809",
                                        "entry_id": "426306b2-576d-3610-97fa-0755437aec28",
                                        "glosses": [
                                            "A ram’s-horn trumpet, used for Jewish ritual purposes."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369513f6-ac50-490a-87f0-1d402c96be2a",
                                                "sense_id": "6e63a26e-93a3-3508-9550-b2571832a809",
                                                "text": "Thaddeus the fluteplayer had, it seems, found a ram’s horn or shofar, and he was blowing this not in the normal manner of an angry summons but so as to produce a melody of four notes, like a camp call to dinner or parade."
                                            },
                                            {
                                                "example_id": "59096957-bdfa-40d2-adc2-0e8643ca3d63",
                                                "sense_id": "6e63a26e-93a3-3508-9550-b2571832a809",
                                                "text": "“This is one of those times in the history of our country and the world, where we are being presented with a wake up call — the blast of the shofar — to challenge ourselves, to ask, ‘What are we doing? What can we do?’ And know that we can do so much,” said Harris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
