                        "entry_id": "a98f9443-1386-3c07-972b-dbb8056eea58",
                        "glosses": [
                            "Fleuve qui traverse la région des Scottish Borders."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "d0e1a436-ea91-491e-ac68-b884c7c50490",
                                "sense_id": "6219dbbc-c031-31b7-8e35-e9cddeec7626",
                                "text": "Les principales villes traversées par la Tweed sont Peebles, Galashiels, Melrose, Kelso, Coldstream, Berwick-upon-Tweed où elle se jette dans la mer du Nord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d325be30-8ac0-4a6d-8df5-11a9009771bb",
                        "source_entry_id": "a98f9443-1386-3c07-972b-dbb8056eea58",
