{
    "word_family": [
        "honer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "345b000f-bb19-3cd7-aef9-6dd055e18e45",
                    "sense_definition": "To sharpen a blade using a fine-grit stone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sharpening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef used a stone to <w>hone</w> his kitchen knife before starting the dinner service.",
                            "target_lang_translations": {
                                "zh": "厨师在开始晚餐服务前，用磨刀石<w>磨</w>了磨他的菜刀。"
                            }
                        },
                        {
                            "text": "It is important to <w>hone</w> the blade regularly to keep it in perfect condition.",
                            "target_lang_translations": {
                                "zh": "定期<w>磨</w>刀以保持其完美状态非常重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hone a blade"
                    ],
                    "target_lang_definitions": {
                        "zh": "用磨刀石磨利刀刃。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "磨",
                                "target_lang_sense_clarification": "指通过摩擦使物体变锋利。"
                            },
                            {
                                "target_lang_word": "磨快",
                                "target_lang_sense_clarification": "强调使刀刃变得锋利的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7812d0b-ff2b-3562-8ea6-5f8745a71338",
                    "sense_definition": "To improve or refine a skill or ability through practice.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent years in the studio to <w>hone</w> her craft as a professional painter.",
                            "target_lang_translations": {
                                "zh": "她在工作室里花了多年时间来<w>磨练</w>她作为专业画家的技艺。"
                            }
                        },
                        {
                            "text": "The athlete continues to <w>hone</w> her skills to prepare for the upcoming championship.",
                            "target_lang_translations": {
                                "zh": "运动员继续<w>磨练</w>她的技能，为即将到来的锦标赛做准备。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hone a skill"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过练习来改进或精炼某项技能或能力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "磨练",
                                "target_lang_sense_clarification": "指在实践中锻炼和提高技能。"
                            },
                            {
                                "target_lang_word": "精进",
                                "target_lang_sense_clarification": "指使技艺更加精深。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be91f22-78e9-3f0c-a481-2b4b5b1afb14",
                    "sense_definition": "To make something more intense, effective, or focused.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician worked to <w>hone</w> his message before the televised debate.",
                            "target_lang_translations": {
                                "zh": "这位政治家在电视辩论前努力<w>强化</w>他的演讲信息。"
                            }
                        },
                        {
                            "text": "The team needs to <w>hone</w> their strategy to win against such a strong opponent.",
                            "target_lang_translations": {
                                "zh": "团队需要<w>优化</w>他们的策略，才能战胜如此强大的对手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hone a strategy"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某事物变得更加强烈、有效或专注。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强化",
                                "target_lang_sense_clarification": "指增强某事物的力度或效果。"
                            },
                            {
                                "target_lang_word": "聚焦",
                                "target_lang_sense_clarification": "指使目标或重点更加明确。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c37c1f1-7273-32b0-8fed-46eeafcf0872",
                    "sense_definition": "To use a specialized machine tool to create a precise internal cylindrical surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sharpening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic had to <w>hone</w> the engine cylinder to ensure the piston fit perfectly.",
                            "target_lang_translations": {
                                "zh": "机械师必须对发动机气缸进行<w>珩磨</w>，以确保活塞完美贴合。"
                            }
                        },
                        {
                            "text": "Precision engineers <w>hone</w> the metal bores to meet strict industrial tolerances.",
                            "target_lang_translations": {
                                "zh": "精密工程师对金属孔进行<w>珩磨</w>，以达到严格的工业公差要求。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使用专用机床加工出精确的内圆柱表面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "珩磨",
                                "target_lang_sense_clarification": "机械加工术语，指对孔进行精密磨削。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0b0992-a907-38d6-94dc-f7ea7c3e6002",
                    "sense_definition": "To feel a deep longing or to express sorrow through lamentation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man sat by the window, <w>honing</w> for the days of his youth.",
                            "target_lang_translations": {
                                "zh": "老人坐在窗边，<w>哀叹</w>着他逝去的青春岁月。"
                            }
                        },
                        {
                            "text": "She spent the evening <w>honing</w> over the loss of her dear friend.",
                            "target_lang_translations": {
                                "zh": "她整个晚上都在为失去挚友而<w>哀叹</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "感到深深的渴望或通过哀叹表达悲伤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "哀叹",
                                "target_lang_sense_clarification": "指悲伤地叹息。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d5636e-a22a-3d63-8407-51bea4d301b2",
                    "sense_definition": "To complain or grumble in a persistent manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He continued <w>honing</w> about the unfair treatment he received at work.",
                            "target_lang_translations": {
                                "zh": "他一直在<w>抱怨</w>他在工作中受到的不公平待遇。"
                            }
                        },
                        {
                            "text": "Stop <w>honing</w> and try to find a solution to the problem instead.",
                            "target_lang_translations": {
                                "zh": "别再<w>抱怨</w>了，试着找个解决问题的办法吧。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "持续地抱怨或发牢骚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "指对不满的事物进行持续的言语表达。"
                            }
                        ]
                    }
                }
            ]
        },
        {
