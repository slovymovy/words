                ],
                "senses": [
                    {
                        "sense_id": "68319d85-7e37-33a2-a2be-40899c4d3eaa",
                        "entry_id": "d3fe0515-e464-3401-84a5-8ce324ce5208",
                        "glosses": [
                            "Redonner un caractère territorial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6baefbc3-41c8-4d4e-b76f-fbb9248bde9c",
                                "sense_id": "68319d85-7e37-33a2-a2be-40899c4d3eaa",
                                "text": "Autre exemple du caractère productif que peuvent avoir les gens qui se déterritorialisent hors des codes contraignants et se reterritorialisent sur un territoire différent, MAIS qui ne renie pas le premier."
                            },
                            {
                                "example_id": "0c0a36b5-2d86-459d-ae10-dcecc3a78bb8",
                                "sense_id": "68319d85-7e37-33a2-a2be-40899c4d3eaa",
                                "text": "Toute théorie nomade, en effet, déplace aussi le champ sémantique, elle déterritorialise et reterritorialise."
                            },
                            {
                                "example_id": "8be02ba4-9850-40f4-99bb-040907feca87",
                                "sense_id": "68319d85-7e37-33a2-a2be-40899c4d3eaa",
                                "text": "Mais, tandis que le père essayait de se reterritorialiser en s'efforçant d'acquérir une position sociale confortable par son travail, le fils essayait de se reterritorialiser par ses écrits."
                            }
                        ]
                    }
