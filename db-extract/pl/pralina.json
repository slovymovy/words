                                                "sense_id": "3551f468-3a96-37cc-a01a-15ed9e7bd668",
                                                "text": "Eine Schachtel mit Pralinen ist immer ein willkommenes Gastgeschenk."
                                            },
                                            {
                                                "example_id": "cea624f9-5ffc-4cc1-ad36-e22cb997970b",
                                                "sense_id": "3551f468-3a96-37cc-a01a-15ed9e7bd668",
                                                "text": "Es gibt auch Pralinen für Diabetiker zu kaufen."
                                            },
                                            {
                                                "example_id": "254cf78c-13b5-447a-a1e3-d885cb38395c",
                                                "sense_id": "3551f468-3a96-37cc-a01a-15ed9e7bd668",
                                                "text": "Jede Praline trägt ein Stück Kultur der Chocolaterie in sich."
                                            },
                                            {
                                                "example_id": "d97a9b22-45e6-40e2-9eab-22529bf4b1d8",
                                                "sense_id": "3551f468-3a96-37cc-a01a-15ed9e7bd668",
                                                "text": "„Ich warte auf eine Kontaktanzeige, in der eine Frau einen maulfaulen Stubenhocker sucht, der weder tanzt noch wandert, aber gerne die Sopranos guckt und dabei Pralinen futtert.“"
                                            },
                                            {
                                                "example_id": "9fe35f0c-cdad-4380-8367-755188e18988",
                                                "sense_id": "3551f468-3a96-37cc-a01a-15ed9e7bd668",
                                                "text": "„Frau Joos stand hinter der Theke und ordnete mit einer silbernen Zange Pralinen in Kristallschalen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
