                "senses": [
                    {
                        "sense_id": "40a8f83b-ee88-3dd0-8991-c67be8ea463b",
                        "entry_id": "03053abf-b307-35bf-b833-57cba7994655",
                        "glosses": [
                            "eine mehrjährige unverholzte Pflanze, deren oberirdische Sprossteile am Ende der Vegetationsperiode absterben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b608d0e-9421-4b7e-a6d4-06cf89c076ee",
                                "sense_id": "40a8f83b-ee88-3dd0-8991-c67be8ea463b",
                                "text": "Hast du schon die Stauden geschnitten?"
                            },
                            {
                                "example_id": "34dbc356-4733-42aa-9a45-11c03653362a",
                                "sense_id": "40a8f83b-ee88-3dd0-8991-c67be8ea463b",
                                "text": "In botanischen Bestimmungsbüchern wird eine Staude häufig mit dem Symbol ♃ gekennzeichnet."
                            },
                            {
                                "example_id": "c7cbcc13-58c6-4187-bc0b-b081fcf453a4",
                                "sense_id": "40a8f83b-ee88-3dd0-8991-c67be8ea463b",
                                "text": "„Stauden gedeihen nicht an jedem Platz gleich gut.“"
                            },
                            {
                                "example_id": "67342ede-15dd-4204-973d-d93ee7af8636",
                                "sense_id": "40a8f83b-ee88-3dd0-8991-c67be8ea463b",
                                "text": "„Ringsherum wucherte ein Dickicht von Stauden und Bambus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
