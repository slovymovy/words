                ],
                "senses": [
                    {
                        "sense_id": "367a8915-402e-367d-9324-96aa9cf934e8",
                        "entry_id": "3852b764-b2b0-31f9-9347-38f293f7b367",
                        "glosses": [
                            "Gebet, das zu später Tageszeit, am Abend, gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d8240a0-5a2d-4e4f-a5c0-39aab34e6c70",
                                "sense_id": "367a8915-402e-367d-9324-96aa9cf934e8",
                                "text": "Gloger: […] Aber auf jeden Fall spielte und spielt der Glaube bei uns eine wichtige Rolle. Der Gottesdienstbesuch am Sonntag, Tisch- und Abendgebet und meistens eine Wallfahrt im Sommer gehören zum Familienleben einfach dazu."
                            },
                            {
                                "example_id": "b6bce22d-9ce3-4105-b5b5-b83b034402d2",
                                "sense_id": "367a8915-402e-367d-9324-96aa9cf934e8",
                                "text": "„Zum Zeitpunkt der Explosion hätten sich viele Gläubige zum Abendgebet in der Moschee befunden, sagte der Provinzgouverneur dem staatlichen Fernsehen.“"
                            },
                            {
                                "example_id": "69a56a68-0afb-40b2-af58-56b10b252d78",
                                "sense_id": "367a8915-402e-367d-9324-96aa9cf934e8",
                                "text": "„Sie strickte Strümpfe und Pullover für ihn, und in ihrem Abendgebet dankte sie Gott dafür, dass er ihren Bruder heil wieder heimgeschickt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38175438-2fd8-4676-a813-b9c2524960fd",
                        "source_entry_id": "3852b764-b2b0-31f9-9347-38f293f7b367",
                        "source_sense_id": "367a8915-402e-367d-9324-96aa9cf934e8",
