                    },
                    {
                        "translation_id": "0af82b0e-f008-4c92-8fc6-1c96f1e20730",
                        "source_entry_id": "5521b525-63a4-33d4-a0ab-4eafc73edcbb",
                        "source_sense_id": "61705eb3-0dac-35c8-8580-9e6a6eca515e",
                        "source_sense_description": "taps toelopende buis, gebruikt voor het vullen van vaten",
                        "target_lang_word": "entonnoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entonnoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "330ebc02-539c-38fe-be5e-bce91183c054",
                                        "entry_id": "df417772-cba4-3aff-aad2-fa9644ec4f02",
                                        "glosses": [
                                            "Instrument formé d’un cône renversé, dont la pointe est prolongée par un tube à l’aide duquel on verse un liquide dans un récipient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "432bb4dd-cdc7-47f2-b870-9fbf2019c20c",
                                                "sense_id": "330ebc02-539c-38fe-be5e-bce91183c054",
                                                "text": "Sur les murs, plusieurs dessins représentaient des petits malades en compagnie du docteur Lebillon, souvent équipé d’un stéthoscope qui ressemblait à un anaconda ou d’un otoscope en forme d’entonnoir géant."
                                            },
                                            {
                                                "example_id": "5f1e522b-d425-4828-bafd-2c54fd96fd32",
                                                "sense_id": "330ebc02-539c-38fe-be5e-bce91183c054",
                                                "text": "Entonnoir Büchner : équipement de laboratoire utilisé pour la filtration sous vide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                        "entry_id": "df417772-cba4-3aff-aad2-fa9644ec4f02",
                                        "glosses": [
                                            "Tout ce qui en rappelle la forme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a90c69d-cc56-4328-a73e-e0d0c9027295",
                                                "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                                "text": "Lac, vallée en entonnoir."
                                            },
                                            {
                                                "example_id": "914ec049-0e1b-408b-91f7-50fd90e4679d",
                                                "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                                "text": "Le cirque de Malaga est d’une grandeur vraiment antique et peut contenir douze ou quinze mille spectateurs dans son vaste entonnoir, dont l’arène forme le fond, et dont l’acrotère s’élève à la hauteur d’une maison de cinq étages."
                                            },
                                            {
                                                "example_id": "1b18052d-c7e0-44e0-84e8-5d8a8695cb92",
                                                "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                                "text": "Entonnoir de mine, d’obus, de volcan."
                                            },
                                            {
                                                "example_id": "131b8398-b039-44a7-9994-4eabfd6bfcd9",
                                                "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                                "text": "Mais c’est justement ce précédent qui m’inspirait une certaine assurance, car je partageais un peu la superstition des vieux guerriers, selon lesquels c’est dans l’entonnoir tout fraîchement ouvert qu’on est le plus en sûreté."
                                            },
                                            {
                                                "example_id": "6756a894-4a86-454a-9578-6fa1a01eff1b",
                                                "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                                "text": "Toutes les recherches sur la résurgence de la Fontaine de Vaucluse n’ont pas vraiment percé le secret de cet entonnoir de 300 mètres."
                                            },
                                            {
                                                "example_id": "98bd8549-5341-40f3-88c3-a6bcaaecf480",
                                                "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                                "text": "Mettre les mains en entonnoir autour de la bouche."
                                            },
                                            {
                                                "example_id": "b85061de-212c-46df-935a-230917ceb2d7",
                                                "sense_id": "3f888d5e-60ce-3118-af79-8534d2282a65",
                                                "text": "Entonnoir nuageux : appendice nuageux conique en rotation sous un nuage convectif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eec6a18a-547e-3e8c-9929-0bc80e93712b",
                                        "entry_id": "df417772-cba4-3aff-aad2-fa9644ec4f02",
                                        "glosses": [
                                            "Sorte de fossette entre la base du pilier antérieur de la voûte du cerveau et la partie antérieure du point de réunion des nerfs optiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1550bf1b-b91d-3834-a273-561959aafdf8",
                                        "entry_id": "df417772-cba4-3aff-aad2-fa9644ec4f02",
                                        "glosses": [
                                            "En entonnoir : En allant du plus large au plus fin, par analogie avec la forme de l’objet."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12595487-25cb-44a3-8d36-22c848114e28",
                                                "sense_id": "1550bf1b-b91d-3834-a273-561959aafdf8",
                                                "text": "J’ai adopté une technique de lecture en entonnoir, du plus généraliste, pour poser le contexte autour du handicap, et orienter ensuite mes pistes de réflexion vers des sujets plus précis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
