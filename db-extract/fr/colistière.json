                "senses": [
                    {
                        "sense_id": "a3bacd59-a533-3d57-a3ff-b234fa63c29b",
                        "entry_id": "4bdd4168-abb3-3a01-9228-c354376e0e86",
                        "glosses": [
                            "Candidate inscrite sur la même liste électorale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e735b563-867a-47f9-9fcd-ed7195333445",
                                "sense_id": "a3bacd59-a533-3d57-a3ff-b234fa63c29b",
                                "text": "Il l’a annoncé sur Twitter. « J’ai l’immense honneur d’annoncer que j’ai choisi Kamala Harris, combattante dévouée à la défense courageuse des classes populaires et l’une des plus grands serviteurs de l’État, comme ma colistière », a-t-il écrit."
                            },
                            {
                                "example_id": "5596643b-8577-4d63-abb9-4e30e1978d73",
                                "sense_id": "a3bacd59-a533-3d57-a3ff-b234fa63c29b",
                                "text": "S'il le voulait, il pourrait prendre la place de sa colistière, Chantal Rossi, dans le district Ovide-Clermont de l'arrondissement de Montréal-Nord."
                            },
                            {
                                "example_id": "abfe38ad-de95-4237-ace4-6b78441fbde0",
                                "sense_id": "a3bacd59-a533-3d57-a3ff-b234fa63c29b",
                                "text": "Troisième homme de la présidentielle américaine qui doit se dérouler le 5 novembre, Robert Kennedy Jr a annoncé ce mardi que l’avocate et philanthrope Nicole Shanahan serait sa colistière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0f3205d-3a4f-4756-9d74-c1712df53f8c",
