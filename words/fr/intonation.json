            "senses": [
                {
                    "sense_id": "7d979677-3ebb-330e-a57f-370ee93d1026",
                    "sense_definition": "Manière d'articuler et d'infléchir la voix en parlant ou en lisant, exprimant un sentiment ou une attitude.",
