                        "entry_id": "7bc12733-7957-35fb-a0f3-0ed346657109",
                        "glosses": [
                            "Bactérie du genre Salmonella."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4d42e9-0dca-425d-84d4-e18d2bee99d0",
                                "sense_id": "31cae672-8309-3f82-974a-24bbc5ed2697",
                                "text": "Même s'ils semblent propres, ces animaux, comme les poules ou les canards, peuvent transporter la salmonelle, une bactérie pouvant provoquer diarrhées, fièvre et vomissements, ont prévenu les CDC."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adb17d6c-857a-41b8-b662-6ab6bdb251a2",
                        "source_entry_id": "7bc12733-7957-35fb-a0f3-0ed346657109",
                        "source_sense_id": "31cae672-8309-3f82-974a-24bbc5ed2697",
