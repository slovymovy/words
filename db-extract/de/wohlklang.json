                                "target_senses": [
                                    {
                                        "sense_id": "33d9e283-3154-3d03-9370-220adf539722",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Concours et accord de divers sons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb581a00-2dbe-4145-a471-205def9c20a6",
                                                "sense_id": "33d9e283-3154-3d03-9370-220adf539722",
                                                "text": "Harmonie céleste."
                                            },
                                            {
                                                "example_id": "f3c3e14f-cf5a-4bbd-8385-0b908a5d29f4",
                                                "sense_id": "33d9e283-3154-3d03-9370-220adf539722",
                                                "text": "L’harmonie des instruments."
                                            },
                                            {
                                                "example_id": "36d4ac57-8048-4fb2-83b2-a2792f53fe90",
                                                "sense_id": "33d9e283-3154-3d03-9370-220adf539722",
                                                "text": "Les platoniciens prétendaient que les cieux, dans leur mouvement, faisaient entendre une harmonie parfaite."
                                            },
                                            {
                                                "example_id": "16db15de-9283-4342-86b1-9c604ed7e13d",
                                                "sense_id": "33d9e283-3154-3d03-9370-220adf539722",
                                                "text": "Le pouvoir de l’harmonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d511e912-ac81-36ba-b7dd-2b226cfba514",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Succession d’accords, par opposition à la mélodie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929d20b1-a569-4d3f-9e2b-4ee94e223639",
                                                "sense_id": "d511e912-ac81-36ba-b7dd-2b226cfba514",
                                                "text": "L’harmonie musicale."
                                            },
                                            {
                                                "example_id": "c22be6b6-fe06-4ccc-9ab7-bc0eb99ca2f9",
                                                "sense_id": "d511e912-ac81-36ba-b7dd-2b226cfba514",
                                                "text": "Il y a plus d’harmonie que de chant dans ce chœur."
                                            },
                                            {
                                                "example_id": "c07bbdbd-7588-474c-80cd-51bdffbada1d",
                                                "sense_id": "d511e912-ac81-36ba-b7dd-2b226cfba514",
                                                "text": "Connaître les lois, les règles, les principes de l’harmonie."
                                            },
                                            {
                                                "example_id": "2b3cd7e6-4350-4658-b7b2-0e672e722e63",
                                                "sense_id": "d511e912-ac81-36ba-b7dd-2b226cfba514",
                                                "text": "Leçons, cours, traité d’harmonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35ef1cde-ed60-327e-82f8-2a9d0182d03f",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Ensemble d’instruments à vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6087ca-ba32-49ec-a436-5e4e4f3f8056",
                                                "sense_id": "35ef1cde-ed60-327e-82f8-2a9d0182d03f",
                                                "text": "Je rappelle qu’il était maître de violon, de violoncelle, de flûte, qu’il dirigeait l’harmonie de la ville et qu’il était titulaire de l’orgue de la collégiale Saint-Vincent."
                                            },
                                            {
                                                "example_id": "4546cd3b-c9a1-448e-b6c8-b74797a39923",
                                                "sense_id": "35ef1cde-ed60-327e-82f8-2a9d0182d03f",
                                                "text": "Le 7 juin 1983, à la Bernardière, l’orchestre des élèves de l’école donne son premier concert public. Un an après, l’école de musique, l’harmonie municipale et 300 élèves du primaire participent à la 3ᵉ édition de la fête de la musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e1960c-40e4-341a-b3db-6c425c537d7b",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Compagnie de musiciens concertants."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c65dd7a8-e5a4-346e-8ee8-830c2eebf1b0",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Son net, doux ou agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fbcf550-39cc-4168-ae54-efe558614fc4",
                                                "sense_id": "c65dd7a8-e5a4-346e-8ee8-830c2eebf1b0",
                                                "text": "L’harmonie de sa voix."
                                            },
                                            {
                                                "example_id": "f4de84bf-f913-4c69-be68-cb3e2316ec7b",
                                                "sense_id": "c65dd7a8-e5a4-346e-8ee8-830c2eebf1b0",
                                                "text": "L’harmonie de son instrument."
                                            },
                                            {
                                                "example_id": "c81f0c0d-21a4-45d1-b6df-e520843c991f",
                                                "sense_id": "c65dd7a8-e5a4-346e-8ee8-830c2eebf1b0",
                                                "text": "L’harmonie d’une flûte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f15ad4-89ab-358b-a566-80f7f888648d",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Concours de sons, de mots qui flattent l’oreille ; nombre, cadence."
                                        ],
                                        "tags": [
                                            "Stylistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98cecc6f-2c84-4348-b80e-f2a643dbafcc",
                                                "sense_id": "02f15ad4-89ab-358b-a566-80f7f888648d",
                                                "text": "L’harmonie du style, du discours."
                                            },
                                            {
                                                "example_id": "392be004-0dc3-49f8-bb77-d9e5ef98fed4",
                                                "sense_id": "02f15ad4-89ab-358b-a566-80f7f888648d",
                                                "text": "Ces vers n’ont point d’harmonie."
                                            },
                                            {
                                                "example_id": "7338d5e0-b7ec-4d91-883a-4acf7606248a",
                                                "sense_id": "02f15ad4-89ab-358b-a566-80f7f888648d",
                                                "text": "Comme vous le verrez dans la grammaire, l’accent tonique est invariablement sur l’avant-dernière syllabe du mot, en Espéranto. Observez donc bien d’élever toujours la voix sur cette syllabe, et non point sur la finale. … Inspirez-vous bien de cette observation dans tous les cas analogues. Nous avons cru devoir l’insérer ici, à cause de la tendance qu’ont nos compatriotes à négliger toujours l’accent tonique, dans les langues étrangères. A la vérité, le faire en Espéranto ne vous exposerait pas à devenir incompréhensible, comme dans beaucoup d’idiomes ; mais, à coup sûr, vous dépouilleriez la langue d’une grande partie de son harmonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f03dc74-3ea2-36bd-a3c6-2dcf67b12213",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Accord parfait et une entière correspondance de plusieurs parties qui forment un tout, ou qui concourent à une même fin."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd1f741-fb4c-4659-b698-db8697bfabb7",
                                                "sense_id": "4f03dc74-3ea2-36bd-a3c6-2dcf67b12213",
                                                "text": "Les nuages, diaprés et à demi transparents, affectent la forme d'immenses draperies suspendues à la voûte du ciel, où toutes les couleurs du prisme se fondent dans une divine harmonie."
                                            },
                                            {
                                                "example_id": "13613052-c108-4267-8a3c-b3c100f18423",
                                                "sense_id": "4f03dc74-3ea2-36bd-a3c6-2dcf67b12213",
                                                "text": "Sale et productif comme le commerce, ce passage, toujours plein d’allants et de venants, de charrettes, de haquets, est d’un aspect repoussant, et la population qui y grouille est en harmonie avec les choses et les lieux."
                                            },
                                            {
                                                "example_id": "7993ffda-3577-4c06-a025-ba0baf8d5f01",
                                                "sense_id": "4f03dc74-3ea2-36bd-a3c6-2dcf67b12213",
                                                "text": "L’harmonie du corps humain."
                                            },
                                            {
                                                "example_id": "db00ab15-79c9-4a37-913c-2e0ac09e254b",
                                                "sense_id": "4f03dc74-3ea2-36bd-a3c6-2dcf67b12213",
                                                "text": "Il règne une belle, une savante harmonie entre toutes les parties de cette composition."
                                            },
                                            {
                                                "example_id": "c0c0564e-266d-4c94-8886-fd1ce04943a1",
                                                "sense_id": "4f03dc74-3ea2-36bd-a3c6-2dcf67b12213",
                                                "text": "Ces lois n’étaient plus en harmonie avec les mœurs nouvelles."
                                            },
                                            {
                                                "example_id": "0a4194e8-1eb4-4016-8425-5af59dffabd4",
                                                "sense_id": "4f03dc74-3ea2-36bd-a3c6-2dcf67b12213",
                                                "text": "Mettre une chose en harmonie avec une autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e414c7ad-e2e4-3f48-9a19-5d131b14ce98",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Concorde, en parlant des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b62f9a-e9f6-460e-a1c4-2c9d8d105488",
                                                "sense_id": "e414c7ad-e2e4-3f48-9a19-5d131b14ce98",
                                                "text": "Ils vivent dans une parfaite harmonie."
                                            },
                                            {
                                                "example_id": "27ef07e5-864f-44ed-9ec7-f6aae0480d85",
                                                "sense_id": "e414c7ad-e2e4-3f48-9a19-5d131b14ce98",
                                                "text": "Cet événement a dû troubler l’harmonie qui régnait entre eux."
                                            },
                                            {
                                                "example_id": "ff8ad7ac-d423-428e-a92d-0eedfee55637",
                                                "sense_id": "e414c7ad-e2e4-3f48-9a19-5d131b14ce98",
                                                "text": "L’harmonie d’une famille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "502a81bc-f0ab-37b3-ace7-7e9e2e5c3d17",
                                        "entry_id": "065f201c-93bc-3168-a962-8b686e2d1fc7",
                                        "glosses": [
                                            "Articulation dans laquelle les os sont liés ensemble par des dentelures presque imperceptibles. Cette articulation se remarque surtout à un des os de la face."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
