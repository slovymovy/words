                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e38e1638-bd76-4841-adb9-e4ae3cdb59eb",
                                "sense_id": "e59ac2c3-9e2c-39a1-a214-6c875d10c491",
                                "text": "Его место за бортом станции займёт американец Дональд Петтит, который присоединится к командиру экипажа Кеннету Бауэрсоксу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b92dbaa-bf15-4263-99c6-989a1c2c63b2",
                        "source_entry_id": "e41b9f2a-8857-3efc-a511-6ca988e452ca",
                        "source_sense_id": "e59ac2c3-9e2c-39a1-a214-6c875d10c491",
                        "target_lang_word": "Donald",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Donald",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b183fe28-8971-323e-b2eb-5509530425a0",
                                        "entry_id": "5b368df3-5ea8-3a4a-9cf1-06cfee0d6da1",
                                        "glosses": [
                                            "A male given name from Scottish Gaelic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26201d82-0987-4ff8-ba78-01912dde28af",
                                                "sense_id": "b183fe28-8971-323e-b2eb-5509530425a0",
                                                "text": "\"Country?\" replied Cuddie; \"ou, the country's weel eneugh, and it werena that dour deevil, Calver'se, ( they ca' him Dundee now) that's stirring about yet in the Highlands, they say, with a' the Donalds, and Duncans, and Dugalds, that ever wore bottomless breeks, driving about wi' him, to set things asteer again, - - -"
                                            },
                                            {
                                                "example_id": "345fee5b-e5e1-4e15-91c9-b3cf77e2a783",
                                                "sense_id": "b183fe28-8971-323e-b2eb-5509530425a0",
                                                "text": "My friends call me Terry. My husband always used my full name, Teresa. He said it made him feel like he was married to a foreign woman. And I never called him Don or Donny or Donny Joe. I called him Donald from the first time we met."
                                            },
                                            {
                                                "example_id": "78cccd06-b665-4f84-8e12-5aa9a294d68b",
                                                "sense_id": "b183fe28-8971-323e-b2eb-5509530425a0",
                                                "text": "Donald Duk never liked his name. He hates his name. He is not a duck. He is not a cartoon character. - - - \"Only the Chinese are stupid enough to give a kid a stupid name like Donald Duk,\" Donald Duk says to himself."
                                            },
                                            {
                                                "example_id": "ee990b90-138f-4919-a2af-489b33309d8e",
                                                "sense_id": "b183fe28-8971-323e-b2eb-5509530425a0",
                                                "text": "The death of anti-feminist activist Phyllis Schlafly on Monday brought commiserations from the GOP ticket. Donald Trump tweeted that she was “truly great.” Mike Pence called her “the First Lady of the Conservative Movement.” Pence wasn’t exaggerating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87010c6e-58a9-37ff-a0c7-b9aa251870bd",
                                        "entry_id": "5b368df3-5ea8-3a4a-9cf1-06cfee0d6da1",
