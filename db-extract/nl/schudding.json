                "translations": [
                    {
                        "translation_id": "b617cc8e-0b1a-447e-a798-4e18a8aec57a",
                        "source_entry_id": "b8b2b4d7-c16d-3736-b093-a9bb1eebe2ae",
                        "source_sense_id": "dd8bfa6d-8541-3385-b1e3-d23f7d7e69e9",
                        "source_sense_description": "handeling waarbij iets met kracht snel heen en weer of op en neer wordt bewogen",
                        "target_lang_word": "shake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92fc390a-5d3a-3d8d-8642-065750b51571",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To cause (something) to move rapidly in opposite directions alternatingly."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "063e4470-d213-4c26-a6c6-f8ffa6ce2a47",
                                                "sense_id": "92fc390a-5d3a-3d8d-8642-065750b51571",
                                                "text": "The earthquake shook the building."
                                            },
                                            {
                                                "example_id": "22d85867-0cfd-4662-a097-7c60a6e6eaa3",
                                                "sense_id": "92fc390a-5d3a-3d8d-8642-065750b51571",
                                                "text": "He shook the can of soda for thirty seconds before delivering it to me, so that, when I popped it open, soda went everywhere."
                                            },
                                            {
                                                "example_id": "a90c4574-195e-4018-96a1-3ba81428ed75",
                                                "sense_id": "92fc390a-5d3a-3d8d-8642-065750b51571",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and now seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76db8d0e-868b-3412-9d39-bd36c593fbfa",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To move (one's head) from side to side, especially to indicate refusal, reluctance, or disapproval."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6ffceed-805d-4ad2-a045-72e44e29491c",
                                                "sense_id": "76db8d0e-868b-3412-9d39-bd36c593fbfa",
                                                "text": "Shaking his head, he kept repeating “No, no, no”."
                                            },
                                            {
                                                "example_id": "9ba276ac-69d2-4c3c-9614-653d2421f285",
                                                "sense_id": "76db8d0e-868b-3412-9d39-bd36c593fbfa",
                                                "text": "I became alſo a reproch vnto them: when they looked vpon me, they ſhaked their heads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcdcf252-cbb5-305e-be65-24b57649c619",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To move or remove by agitating; to throw off by a jolting or vibrating motion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b70ab61c-0b48-48e2-92f7-7e77ed052d16",
                                                "sense_id": "fcdcf252-cbb5-305e-be65-24b57649c619",
                                                "text": "to shake fruit down from a tree"
                                            },
                                            {
                                                "example_id": "b3f82002-c848-4577-a9e4-5b0d964db754",
                                                "sense_id": "fcdcf252-cbb5-305e-be65-24b57649c619",
                                                "text": "[…]Shake off the golden ſlumber of repoſe;[…]"
                                            },
                                            {
                                                "example_id": "bf01e7a0-8e61-4c2b-9ed1-fbc733ae3667",
                                                "sense_id": "fcdcf252-cbb5-305e-be65-24b57649c619",
                                                "text": "But indeed this Shame was a bold Villain; I could ſcarce ſhake him out of my company; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32abe64-fe3d-3046-9861-1677c24ca304",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To disturb emotionally; to shock."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16da1b79-a53a-4dd7-90a5-f2b52fb5d73b",
                                                "sense_id": "e32abe64-fe3d-3046-9861-1677c24ca304",
                                                "text": "Her father’s death shook her terribly."
                                            },
                                            {
                                                "example_id": "d28c6793-2717-40cb-a67f-5dd05dc5c3c4",
                                                "sense_id": "e32abe64-fe3d-3046-9861-1677c24ca304",
                                                "text": "He was shaken by what had happened."
                                            },
                                            {
                                                "example_id": "dbb0e5d5-7ce1-44a8-81e9-d77c23725def",
                                                "sense_id": "e32abe64-fe3d-3046-9861-1677c24ca304",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b4d995e-214c-3476-be8b-9a0067ba4c04",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To lose, evade, or get rid of (something)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80cc8db7-436b-40e4-998d-8602c7b07d54",
                                                "sense_id": "8b4d995e-214c-3476-be8b-9a0067ba4c04",
                                                "text": "I can’t shake the feeling that I forgot something."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da94998-dadb-313c-aab4-4e2f19292dc5",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To move from side to side."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d5bf64b-50e7-41e9-95dd-3e6b5371704c",
                                                "sense_id": "3da94998-dadb-313c-aab4-4e2f19292dc5",
                                                "text": "She shook with grief."
                                            },
                                            {
                                                "example_id": "61546944-8b4a-4899-b0e3-cf7802aed5b2",
                                                "sense_id": "3da94998-dadb-313c-aab4-4e2f19292dc5",
                                                "text": "The slightest effort made the patient cough. He would stand leaning on a stick and holding a hand to his side, and when the paroxysm had passed it left him shaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d812cc-8a76-3001-a799-29dbc967e48c",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To shake hands."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e59b1d-ae73-40e4-9f5e-a996c1fb3ecf",
                                                "sense_id": "83d812cc-8a76-3001-a799-29dbc967e48c",
                                                "text": "OK, let’s shake on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "004bc6e9-db03-3844-a96a-aad2f28f6808",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To dance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6daef632-7cdf-4901-8e7b-5c297fd33eca",
                                                "sense_id": "004bc6e9-db03-3844-a96a-aad2f28f6808",
                                                "text": "She was shaking it on the dance floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81316faf-44c7-3a7c-a6d6-a7cefd524306",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To give a tremulous tone to; to trill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a73637d9-05e0-47b1-9a0c-1e77afff7278",
                                                "sense_id": "81316faf-44c7-3a7c-a6d6-a7cefd524306",
                                                "text": "to shake a note in music"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0de23ee-ac97-3573-b218-c0607b4b427e",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To threaten to overthrow."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0a066e0-e89b-41c5-b708-2e90cbf65036",
                                                "sense_id": "a0de23ee-ac97-3573-b218-c0607b4b427e",
                                                "text": "The experience shook my religious belief."
                                            },
                                            {
                                                "example_id": "e517c786-ae24-47b3-9b6b-228a4f3d8064",
                                                "sense_id": "a0de23ee-ac97-3573-b218-c0607b4b427e",
                                                "text": "The story of Ms. He and her mother began in the early 1960s, shortly before the Cultural Revolution shook China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9462733-da47-35fc-8845-2260df0a1806",
                                        "entry_id": "61364259-d91b-3850-acba-f9113310326a",
                                        "glosses": [
                                            "To be agitated; to lose firmness."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c793ced9-1875-3afc-a08b-9aad92c5c49a",
                                        "entry_id": "ca7436c1-020c-3e0c-8a01-218cbb305aa3",
                                        "glosses": [
                                            "The act of shaking or being shaken; tremulous or back-and-forth motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c983082-513a-4728-8698-847eb8710460",
                                                "sense_id": "c793ced9-1875-3afc-a08b-9aad92c5c49a",
                                                "text": "The cat gave the mouse a shake."
                                            },
                                            {
                                                "example_id": "6b3b77ce-efce-40e1-beb5-e66c69fba468",
                                                "sense_id": "c793ced9-1875-3afc-a08b-9aad92c5c49a",
                                                "text": "She replied in the negative, with a shake of her head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb4d614-8d06-3cfa-b366-fcd3375e4dfe",
                                        "entry_id": "ca7436c1-020c-3e0c-8a01-218cbb305aa3",
                                        "glosses": [
                                            "A twitch, a spasm, a tremor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37079097-6011-43d2-88b7-9b21215ff05a",
                                                "sense_id": "0fb4d614-8d06-3cfa-b366-fcd3375e4dfe",
                                                "text": "And when the princely Perſean Diadem,\nShall ouerweigh his wearie witleſſe head,\nAnd fall like mellowed fruit, with ſhakes of death,\nIn faire Perſea noble Tamburlain\nShall be my Regent, and remaine as King:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7914a10b-9d10-3d1a-ba32-bf4a03357450",
                                        "entry_id": "ca7436c1-020c-3e0c-8a01-218cbb305aa3",
                                        "glosses": [
                                            "A dance popular in the 1960s in which the head, limbs, and body are shaken."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045a2446-4f2c-4f82-bed3-2e96d18890fc",
                                                "sense_id": "7914a10b-9d10-3d1a-ba32-bf4a03357450",
                                                "text": "The snake did the frug, the monkey did the shake. The crowd, mostly young couples, tourists and kids, loved it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc4113b-58a3-3d44-995a-3c3819f1f875",
                                        "entry_id": "ca7436c1-020c-3e0c-8a01-218cbb305aa3",
                                        "glosses": [
                                            "A milkshake."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5644c8e8-598a-30a8-924a-b0dd864c7357",
                                        "entry_id": "ca7436c1-020c-3e0c-8a01-218cbb305aa3",
