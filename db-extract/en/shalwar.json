                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saroual",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c73a81b7-887a-3a4c-90ad-72a6beb7d38b",
                                        "entry_id": "3f87ee45-ca60-3138-ab74-da8fb70e9171",
                                        "glosses": [
                                            "Variante de sarouel."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab2c3349-4f45-436c-bfd9-ba17add5ca1a",
                                                "sense_id": "c73a81b7-887a-3a4c-90ad-72a6beb7d38b",
                                                "text": "Je pris l'habitude, à l'imitation des goumiers et des bellahs, d'aller pisser accroupi, à flanc de dune, pour parer au risque de m'humidifier le saroual par vent tourbillonnant et parce qu'en terre d'Islam, ce besoin est à satisfaire discrètement."
                                            },
                                            {
                                                "example_id": "c5a9d56a-ca9b-48a5-8a24-01d9071abad2",
                                                "sense_id": "c73a81b7-887a-3a4c-90ad-72a6beb7d38b",
                                                "text": "J’avais un saroual sous cette robe longue et boutonnée jusqu’au cou, c’est un pantolon gris ou blanc, très bouffant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
