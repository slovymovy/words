                        "glosses": [
                            "massenhafte geäußerte Sympathie gegenüber einer Person oder Institution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d745272-81e9-4068-b0f1-2b0e9e8c53c1",
                                "sense_id": "7b4069c5-c52b-316a-b8c0-39a0ed909399",
                                "text": "„Eine landesweite Solidarisierung und eine Sympathiewelle erfasste die Armee im April 2012, nachdem am Siachen-Gletscher in 4000 Meter Höhe eine Lawine den Gayari-Armeestützpunkt mit 139 dort stationierten Soldaten unter sich begraben hatte.“"
                            },
                            {
                                "example_id": "b45e1fa6-d022-4f6f-8b70-707b9ae87490",
                                "sense_id": "7b4069c5-c52b-316a-b8c0-39a0ed909399",
                                "text": "„Sie versuchte nun aus der Sympathiewelle, die ihr nach dem israelischen Abzug entgegenschlug, politisch Kapital zu schlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
