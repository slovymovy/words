{
    "word_family": [
        "abstract",
        "abstractly",
        "abstractness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50f673f9-00e2-30ad-89d4-1ea08514f00f",
                    "sense_definition": "A state of being lost in thought or not paying attention to one's surroundings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was lost in a deep <w>abstraction</w> and did not hear the phone ring.",
                            "target_lang_translations": {
                                "zh": "他当时陷入了深深的<w>出神</w>状态，没听见电话响。"
                            }
                        },
                        {
                            "text": "She woke from her <w>abstraction</w> when the teacher called her name.",
                            "target_lang_translations": {
                                "zh": "老师叫她名字时，她才从<w>出神</w>中回过神来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lost in abstraction"
                    ],
                    "target_lang_definitions": {
                        "zh": "指心不在焉、沉思或对周围环境缺乏注意的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "出神",
                                "target_lang_sense_clarification": "指精神不集中，心不在焉的状态。"
                            },
                            {
                                "target_lang_word": "心不在焉",
                                "target_lang_sense_clarification": "形容心思不在这里，指思想不集中。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f4028e7-ebed-3152-b923-752a5b92b528",
                    "sense_definition": "A general idea or concept that is not based on a specific physical object.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Justice is a difficult <w>abstraction</w> for young children to fully understand.",
                            "target_lang_translations": {
                                "zh": "对年幼的孩子来说，正义是一个难以完全理解的<w>抽象概念</w>。"
                            }
                        },
                        {
                            "text": "They prefer to discuss concrete facts rather than vague <w>abstractions</w>.",
                            "target_lang_translations": {
                                "zh": "他们更喜欢讨论具体事实，而不是模糊的<w>抽象概念</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指非基于具体实物的抽象概念或思想。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抽象概念",
                                "target_lang_sense_clarification": "指脱离具体事物的概括性概念。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce7aeb7a-a406-3d84-8ade-d6b51c630673",
                    "sense_definition": "The process of identifying common features among different things to create a general rule or category.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>abstraction</w> of data helps scientists find patterns in complex information.",
                            "target_lang_translations": {
                                "zh": "对数据进行<w>抽象</w>有助于科学家在复杂信息中发现规律。"
                            }
                        },
                        {
                            "text": "Through the <w>abstraction</w> of shared traits, we can classify many different animals.",
                            "target_lang_translations": {
                                "zh": "通过对共有特征的<w>抽象</w>，我们可以对许多不同的动物进行分类。"
                            }
                        }
                    ],
                    "synonyms": [
                        "generalization",
                        "universalization"
                    ],
                    "antonyms": [
                        "specialization",
                        "concretization"
                    ],
                    "target_lang_definitions": {
                        "zh": "指从不同事物中提取共同特征以形成一般规则或类别的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抽象",
                                "target_lang_sense_clarification": "指从具体事物中概括出共同属性的思维过程。"
                            },
                            {
                                "target_lang_word": "概括",
                                "target_lang_sense_clarification": "指将事物归纳总结为一般性结论。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdacfa3d-c668-3d53-9b7b-7c373c51918f",
                    "sense_definition": "A method in computer science that hides complex details to make a system easier to use.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Programming languages provide an <w>abstraction</w> that allows developers to write code without knowing machine hardware.",
                            "target_lang_translations": {
                                "zh": "编程语言提供了一种<w>抽象</w>，使开发人员无需了解机器硬件即可编写代码。"
                            }
                        },
                        {
                            "text": "Good software design relies on a clear <w>abstraction</w> between the user interface and the database.",
                            "target_lang_translations": {
                                "zh": "优秀的软件设计依赖于用户界面与数据库之间清晰的<w>抽象</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "level of abstraction"
                    ],
                    "target_lang_definitions": {
                        "zh": "计算机科学中，通过隐藏复杂细节来简化系统使用的方法。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抽象",
                                "target_lang_sense_clarification": "计算机科学术语，指屏蔽底层实现细节的机制。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}