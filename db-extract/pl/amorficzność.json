                        "source_sense_id": "1db6b5e4-f79a-358e-90d8-01305d63e1c7",
                        "source_sense_description": "Physik, Chemie: Unvermögen, sich in Kristallen anzuordnen; Amorphie",
                        "target_lang_word": "Amorphie",
