                "senses": [
                    {
                        "sense_id": "08ebb1a7-905f-31df-80d9-72c44c7efb3f",
                        "entry_id": "aee5a0f8-ea00-3fbb-9cf7-6dad390652fe",
                        "glosses": [
                            "Rechnernetz auf Grundlage des Internet-Protokolls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474f6214-7a0a-4149-99b2-babd5699a930",
                                "sense_id": "08ebb1a7-905f-31df-80d9-72c44c7efb3f",
                                "text": "Das Internet ist ein IP-Netz."
                            },
                            {
                                "example_id": "7e55e78d-c0df-480a-b71d-455bff196bff",
                                "sense_id": "08ebb1a7-905f-31df-80d9-72c44c7efb3f",
                                "text": "„Der Server stellt diese als gemeinsame Ressource dem IP-Netz bereit.“"
                            },
                            {
                                "example_id": "bf9f0a75-1e50-4797-845e-cbec7b7d0ee6",
                                "sense_id": "08ebb1a7-905f-31df-80d9-72c44c7efb3f",
                                "text": "„Zunächst befindet er sich im funkbasierten IP-Netz 1 und hat dort die individuelle IP-Adresse 88888888.“"
                            },
                            {
                                "example_id": "a712c88f-f196-4ae7-9246-34462adcea34",
                                "sense_id": "08ebb1a7-905f-31df-80d9-72c44c7efb3f",
                                "text": "„Möchte ein PC aus dem IP-Netz A mit dem Rechner aus dem IP-Netz B kommunizieren, so benötigt er dafür mindestens einen Router.“"
                            },
                            {
                                "example_id": "d5f3bb0a-2e45-4fb6-ace3-c47188f3a451",
                                "sense_id": "08ebb1a7-905f-31df-80d9-72c44c7efb3f",
                                "text": "„Dies hängt wiederum entscheidend davon ab, ob das Internet oder ein sonstiges IP-Netz als öffentliches Telefonnetz angesehen werden kann.“"
                            },
                            {
                                "example_id": "755e55a9-8d1c-4c49-9367-f3321e3392ca",
                                "sense_id": "08ebb1a7-905f-31df-80d9-72c44c7efb3f",
                                "text": "„Sie entstehen und wirken in der Regel erst beim Transport der Sprachpakete über das IP-Netz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
