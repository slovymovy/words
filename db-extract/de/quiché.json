                "senses": [
                    {
                        "sense_id": "5af8fb78-3ec7-36a5-962c-17be3a003691",
                        "entry_id": "928730c8-d7f1-3fd6-affe-448ea6697058",
                        "glosses": [
                            "eine in Guatemala gesprochene Sprache; die meistgesprochene Maya-Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a2b10d-7017-4d2d-bff6-34df1bc6e1b5",
                                "sense_id": "5af8fb78-3ec7-36a5-962c-17be3a003691",
                                "text": "„Vor der Conquista wurde Quiché mit der Maya-Schrift geschrieben.“"
                            },
                            {
                                "example_id": "7953a294-9c33-4396-b52a-df7e42ad6624",
                                "sense_id": "5af8fb78-3ec7-36a5-962c-17be3a003691",
                                "text": "„So kennen die Maya-Sprachen Tzotzil und Quiché ebenfalls keine Tempusangabe im uns geläufigen Sinn. Im Verbalkomplex des Quiché wird lediglich in Form eines Praefix ein Aspekt 'completiv/incompletiv' zum Ausdruck gebracht, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
