                                    {
                                        "sense_id": "8d70b460-6a2c-39f5-904d-53d248ff0f29",
                                        "entry_id": "c5927b76-eda5-31b5-82f6-dff688937b28",
                                        "glosses": [
                                            "A large, round-bottomed cooking pan used in East Asian cooking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab667cb8-f49b-4fbf-9f10-2967478b0962",
                                                "sense_id": "8d70b460-6a2c-39f5-904d-53d248ff0f29",
                                                "text": "The 'wok' is an efficient, all-purpose metal cooking vessel used by every housewife in China. It has two handles and is shaped like a shallow cone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a31d0cb1-76d4-3ed8-9708-cb1dc2adcf60",
