                    },
                    {
                        "form_id": "a2ad5994-f70c-4994-ad91-8f341955cbdf",
                        "entry_id": "35f74909-50e2-3b3c-b99a-1d527a6bef4b",
                        "tags": [
                            "singular",
                            "prepositional"
                        ],
                        "form": "за́нятости"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ff675d8-e4e6-3097-a900-d37ccc050f02",
                        "entry_id": "35f74909-50e2-3b3c-b99a-1d527a6bef4b",
                        "glosses": [
                            "свойство или состояние по значению прилагательного занятый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bce4ebc-6721-42b7-81d4-5be6895d0df7",
                                "sense_id": "5ff675d8-e4e6-3097-a900-d37ccc050f02",
                                "text": "На мою занятость письмом Гез даже не обратил внимания."
                            },
                            {
                                "example_id": "85d2bbc1-b88e-4d69-b561-faf6c56976f6",
                                "sense_id": "5ff675d8-e4e6-3097-a900-d37ccc050f02",
                                "text": "Необходимо отличать общественно полезную занятость от занятости как таковой."
                            },
                            {
                                "example_id": "241cc147-ed53-43bb-86d4-3249c352e4d1",
                                "sense_id": "5ff675d8-e4e6-3097-a900-d37ccc050f02",
                                "text": "Ему хотелось создать впечатление торопливости, занятости, и он выполнил это блестяще."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc227bee-a2b3-3358-9cc1-a7836b6f9006",
                        "entry_id": "35f74909-50e2-3b3c-b99a-1d527a6bef4b",
                        "glosses": [
                            "наличие работы, занятий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06230d21-dded-4ee5-becd-f7720401f936",
                                "sense_id": "bc227bee-a2b3-3358-9cc1-a7836b6f9006",
                                "text": "В литературе, посвященной проблемам занятости, часто предлагается более дробная классификация видов занятости. Например: полная, продуктивная, рациональная, эффективная, самозанятость, частичная, вторичная, временная, сезонная."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d4d40d1-9844-462c-a97e-b9a218c87187",
                        "source_entry_id": "35f74909-50e2-3b3c-b99a-1d527a6bef4b",
                        "source_sense_description": "свойство или состояние по значению прилагательного занятый",
                        "target_lang_word": "occupation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occupation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16841cbb-b8c4-337d-8b0e-45784826fd74",
                                        "entry_id": "a20568dc-d96e-3a0e-a7ed-5d4460011d93",
                                        "glosses": [
                                            "Action d’occuper militairement un pays, une région."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b745b100-7541-42f0-9aeb-b0dd61d5a0e9",
                                                "sense_id": "16841cbb-b8c4-337d-8b0e-45784826fd74",
                                                "text": "[…] si vous ne vous conformez pas aux usages dictés par la raison et par les besoins de l’occupation, je me verrai dans l’obligation, très désagréable pour moi, de demander à mes chefs que vous soyez relevé du poste."
                                            },
                                            {
                                                "example_id": "0643e7b0-c147-4583-a132-29abbd6f85ff",
                                                "sense_id": "16841cbb-b8c4-337d-8b0e-45784826fd74",
                                                "text": "Ce fut la guerre civile dans toute son horreur, laquelle ne devait prendre fin que par l’occupation étrangère."
                                            },
                                            {
                                                "example_id": "87f7ad5b-b169-4425-9806-53b161a49251",
                                                "sense_id": "16841cbb-b8c4-337d-8b0e-45784826fd74",
                                                "text": "Le premier projet qui miroita devant moi concernait la Baltique. L’occupation de cette mer par la flotte britannique offrait des avantages qui pouvaient être décisifs."
                                            },
                                            {
                                                "example_id": "6deb2268-6969-47d8-ae8f-3b5a597193c2",
                                                "sense_id": "16841cbb-b8c4-337d-8b0e-45784826fd74",
                                                "text": "Il souhaite […] un allègement des frais d’occupation. Ceux-ci s’élèvent à 20 millions de marks par jour, soit 400 millions de francs 1940, soit environ 800 millions de francs lourds 1998."
                                            },
                                            {
                                                "example_id": "216791c6-2960-4f0c-b049-b8c37405d4a8",
                                                "sense_id": "16841cbb-b8c4-337d-8b0e-45784826fd74",
                                                "text": "D'autres seront déportés pour fait de résistance : Benoît Jean, Bombardier Gabriel, Vouaux Jean. Souvent, dans un état de délabrement physique à leur retour, ils retrouveront leur village meurtri, par l’occupation et les luttes qui y eurent lieu."
                                            },
                                            {
                                                "example_id": "fdfd64d3-2594-450c-bc47-39f996fd4c56",
                                                "sense_id": "16841cbb-b8c4-337d-8b0e-45784826fd74",
                                                "text": "Je me demandai soudain si avec la défaite et l’occupation l’insuline n’allait pas manquer en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c5c3cce-bca4-3974-b4e1-8d32fb164477",
                                        "entry_id": "a20568dc-d96e-3a0e-a7ed-5d4460011d93",
                                        "glosses": [
                                            "Action de s’établir, de se saisir de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5873dcb4-3fcd-4008-b1f6-a772c5d00e23",
                                                "sense_id": "6c5c3cce-bca4-3974-b4e1-8d32fb164477",
                                                "text": "L’occupation a précédé la propriété."
                                            },
                                            {
                                                "example_id": "f5903dcf-24bb-4432-9aad-c56ec80fb316",
                                                "sense_id": "6c5c3cce-bca4-3974-b4e1-8d32fb164477",
                                                "text": "Des centres urbains jusqu’aux confins des périphéries, nous appelons à des reprises de terres, par l’installation paysanne, le rachat en commun ou l’occupation. Nous nous retrouverons dès ce printemps pour des actions d’occupations de terres contre l’artificialisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e12246a-64fe-3863-bade-efd7c1339d3c",
                                        "entry_id": "a20568dc-d96e-3a0e-a7ed-5d4460011d93",
                                        "glosses": [
                                            "Le fait d’habiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293457c8-f0f9-4e94-a839-7859f7e85421",
                                                "sense_id": "8e12246a-64fe-3863-bade-efd7c1339d3c",
                                                "text": "Il a été forcé de payer les loyers des lieux, à proportion du temps et de l’occupation qu’il a faite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f731545-3e7a-3ca0-ae6e-822fc542ab4a",
                                        "entry_id": "a20568dc-d96e-3a0e-a7ed-5d4460011d93",
                                        "glosses": [
                                            "Ce à quoi on est occupé, soit momentanément, soit d’une manière fixe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f28b5a-4d8f-4fdf-a312-116ea5686dc0",
                                                "sense_id": "6f731545-3e7a-3ca0-ae6e-822fc542ab4a",
                                                "text": "Ce rappel à la réalité quotidienne et aux occupations usuelles change momentanément le cours de mes pensées."
                                            },
                                            {
                                                "example_id": "96051a74-c983-479e-8439-cc33037e057d",
                                                "sense_id": "6f731545-3e7a-3ca0-ae6e-822fc542ab4a",
                                                "text": "Il y eu certes des juifs qui s’adonnèrent au commerce, et qui poursuivirent des négoces importants. Mais pendant de longs siècles le commerce n’est pas l’occupation principale des juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "668de66e-d505-3ea9-9ea2-64112d996f8c",
                                        "entry_id": "a20568dc-d96e-3a0e-a7ed-5d4460011d93",
                                        "glosses": [
                                            "Travail ; profession."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8804d12-d532-4e2b-aeb0-4807e7ed9a01",
                                                "sense_id": "668de66e-d505-3ea9-9ea2-64112d996f8c",
                                                "text": "Sir Walter-Scott avait honte de son métier. Il a passé une partie de son existence à donner le change sur la nature de ses occupations."
                                            },
                                            {
                                                "example_id": "a050b9c3-8401-4dcf-b36d-d6d40b787b31",
                                                "sense_id": "668de66e-d505-3ea9-9ea2-64112d996f8c",
                                                "text": "Les noms mêmes des petits métiers qui sont à la base de l'édifice du recyclage révèlent le côté dérisoire de ces occupations : plus spécialisés encore que le chiffonnier, il y a le ramasseur de crottes de chien, le ramasseur de bouts de cigare, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6075f19e-8015-3d5e-a829-1b338d2c22e9",
                                        "entry_id": "a20568dc-d96e-3a0e-a7ed-5d4460011d93",
                                        "glosses": [
                                            "Activité ne mettant pas en œuvre des capacités d’acquisition ou d’apprentissage de l’élève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eefdb78-60c9-4ce7-83b2-7ac42fea10f7",
                                                "sense_id": "6075f19e-8015-3d5e-a829-1b338d2c22e9",
                                                "text": "Ils ont vu la formation comme une activité d’occupation ou de passe-temps"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a0a9c8b-a9cd-4e3c-8f70-9dafdc043efe",
                        "source_entry_id": "35f74909-50e2-3b3c-b99a-1d527a6bef4b",
                        "source_sense_description": "наличие работы",
                        "target_lang_word": "emploi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emploi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68c72e5a-acd4-3a26-9d0b-ea93dd90d991",
                                        "entry_id": "3a6348bf-82c9-37d7-a2f2-6014227c2489",
                                        "glosses": [
                                            "Usage qu’on fait de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88929a2-a8e9-42e6-b743-72a4c8d0747f",
                                                "sense_id": "68c72e5a-acd4-3a26-9d0b-ea93dd90d991",
                                                "text": "Quoiqu’il en soit, il est certain que l’emploi du fer se perd dans la nuit des temps historiques."
                                            },
                                            {
                                                "example_id": "1c4bc814-a195-4e2e-8bf4-d1661e811720",
                                                "sense_id": "68c72e5a-acd4-3a26-9d0b-ea93dd90d991",
                                                "text": "C'est une sorte de psychisme, tout comme l'agora-phobie ou la crampe des écrivains, devenue après l'emploi de la machine à écrire, la crampe des dactylographes."
                                            },
                                            {
                                                "example_id": "9a7dff44-55aa-4e6b-8e79-02042f807f61",
                                                "sense_id": "68c72e5a-acd4-3a26-9d0b-ea93dd90d991",
                                                "text": "On sait que l’emploi du fer fut inconnu de toute l’Amérique avant l’arrivée de Colomb. […]. Parfois cependant le fer météorique est employé accidentellement."
                                            },
                                            {
                                                "example_id": "926b84b1-439e-4669-80ee-84d4dd73a9f4",
                                                "sense_id": "68c72e5a-acd4-3a26-9d0b-ea93dd90d991",
                                                "text": "On note une prédominance à l’emploi des réseaux alternatifs et à l'usage généralisé du triphasé 200 V/400 Hz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cd717a3-ce50-3509-8db0-93bd312e282e",
                                        "entry_id": "3a6348bf-82c9-37d7-a2f2-6014227c2489",
                                        "glosses": [
                                            "Collocation de certaines sommes d’argent ou de capitaux."
                                        ],
                                        "tags": [
                                            "Jurisprudence et finance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9157df99-9d61-4dc7-8ed0-989ce78f913e",
                                                "sense_id": "1cd717a3-ce50-3509-8db0-93bd312e282e",
                                                "text": "Régler l’emploi des sommes qui proviennent d’une vente."
                                            },
                                            {
                                                "example_id": "414bf0ee-95ac-471d-9e62-32f2a36b48c8",
                                                "sense_id": "1cd717a3-ce50-3509-8db0-93bd312e282e",
                                                "text": "Quittance d’emploi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aada46a-15b1-3d9c-8e49-0788d1b87131",
                                        "entry_id": "3a6348bf-82c9-37d7-a2f2-6014227c2489",
                                        "glosses": [
                                            "Placement obligatoire des sommes revenant à des usufruitiers, à des mineurs, dans une succession. → voir remploi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e937d4d5-db04-3cff-a22c-b034073c9b19",
                                        "entry_id": "3a6348bf-82c9-37d7-a2f2-6014227c2489",
                                        "glosses": [
                                            "Action d’employer une somme et d’en faire mention dans un compte, soit en dépense, soit en recette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb43208-e829-4fef-a1e7-93e3c50c1d7d",
                                                "sense_id": "e937d4d5-db04-3cff-a22c-b034073c9b19",
                                                "text": "Les immobilisations corporelles représentent des emplois durables de fonds en actifs physiques dont l'entreprise est propriétaire (capacité industrielle ou commerciale disponible)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c325f9d-8f9b-3033-8727-c14b97ad6146",
                                        "entry_id": "3a6348bf-82c9-37d7-a2f2-6014227c2489",
                                        "glosses": [
                                            "Manière dont on emploie, dont on peut employer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb5d83f-0c43-447e-9559-77ea4b70fc3a",
                                                "sense_id": "1c325f9d-8f9b-3033-8727-c14b97ad6146",
                                                "text": "Plus le cheval est irritable, nerveux ou craintif plus il faut être modéré dans l’emploi de la chambrière."
                                            },
                                            {
                                                "example_id": "6665a326-81cd-478b-967f-843f3e8c5dfd",
                                                "sense_id": "1c325f9d-8f9b-3033-8727-c14b97ad6146",
                                                "text": "Ainsi « boîte de nuit » nous a été signalé à plusieurs reprises comme un « togolisme ». Par contre, de véritables écarts ont été omis car ils apparaissaient à tous les locuteurs comme la forme française « correcte », en raison de leur grande fréquence d’emploi."
                                            },
                                            {
                                                "example_id": "e47c3987-de52-427a-bea7-e4a509101775",
                                                "sense_id": "1c325f9d-8f9b-3033-8727-c14b97ad6146",
                                                "text": "La boussole est en Islande d'un emploi assez difficile, à cause de la variation magnétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d30cbb7-e00d-333c-bad9-bd14037aefa6",
                                        "entry_id": "3a6348bf-82c9-37d7-a2f2-6014227c2489",
                                        "glosses": [
                                            "Occupation, fonction d’une personne employée dans l'administration, l'agriculture, le commerce ou l’industrie."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f368adfe-097d-4a5a-ad62-cc9259db1e26",
                                                "sense_id": "2d30cbb7-e00d-333c-bad9-bd14037aefa6",
                                                "text": "Elle a tenu les emplois les plus divers, pour finir dans les vestiaires d'une boîte de nuit."
                                            },
                                            {
                                                "example_id": "c83864d8-b8d1-496c-a55d-e28e79727500",
                                                "sense_id": "2d30cbb7-e00d-333c-bad9-bd14037aefa6",
                                                "text": "Ça tombe bien : El Padrino marche à voile et à vapeur, et ce sont, semble-t-il, des copains de son milieu qui lui dégotent en 1983 un emploi de top-model masculin à Mexico, capitale fédérale."
                                            },
                                            {
                                                "example_id": "178b4ea4-8b51-409e-b064-4a94535749fa",
                                                "sense_id": "2d30cbb7-e00d-333c-bad9-bd14037aefa6",
                                                "text": "Depuis le milieu des années 90, la croissance des effectifs a été alimentée, dans une large mesure, par des emplois faiblement rémunérés."
                                            },
                                            {
                                                "example_id": "934619c0-055a-4567-9ed1-395b7eefe133",
                                                "sense_id": "2d30cbb7-e00d-333c-bad9-bd14037aefa6",
                                                "text": "D'après l'Insee, le chômage devrait continuer à progresser et atteindre 11% d'ici l'été, avec 75000 destructions supplémentaires d’emplois marchands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884cff0b-090f-3b23-a370-febf524ac531",
                                        "entry_id": "3a6348bf-82c9-37d7-a2f2-6014227c2489",
                                        "glosses": [
                                            "Catégorie de rôles pour lesquels un acteur peut être employé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e6d738-6f46-4ef2-b65f-5cef868ff0ac",
                                                "sense_id": "884cff0b-090f-3b23-a370-febf524ac531",
                                                "text": "Les principaux acteurs étaient M. de Voltaire qui s'était chargé des rôles de vieillards, madame Denis qui jouait les amantes passionnées , un imprimeur de Genève , appelé Craner, qu'on habillait en Gengis-kan ou en Orosmane, et Chabanon qui avait l’emploi des jeunes premiers."
                                            },
                                            {
                                                "example_id": "1f697331-4275-45bd-966f-a8138cad0b97",
                                                "sense_id": "884cff0b-090f-3b23-a370-febf524ac531",
                                                "text": "Quelques jours après elle était dégoûtée de sa confidente de la veille et racoquinée avec le traître, lesquels d’ailleurs, pour la prochaine représentation, échangeraient leurs emplois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
