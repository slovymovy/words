{
    "word_family": [
        "bucketful",
        "bucketload"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "553a2aa1-dae2-3ca9-b785-895522337e64",
                    "sense_definition": "A container made of rigid material, often with a handle, used to carry liquids or small items.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a plastic <w>bucket</w> to carry the water from the well.",
                            "target_lang_translations": {
                                "ru": "Мне нужно пластиковое <w>ведро</w>, чтобы принести воды из колодца.",
                                "zh": "我需要一个塑料<w>水桶</w>从井里提水。"
                            }
                        },
                        {
                            "text": "The child filled his <w>bucket</w> with sand to build a castle on the beach.",
                            "target_lang_translations": {
                                "ru": "Ребёнок наполнил своё <w>ведёрко</w> песком, чтобы построить замок на пляже.",
                                "zh": "孩子用沙子装满了他的<w>小桶</w>，在沙滩上盖城堡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pail"
                    ],
                    "common_phrases": [
                        "plastic bucket",
                        "mop and bucket",
                        "metal bucket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд из жесткого материала, обычно с ручкой, используемый для переноски жидкостей или мелких предметов.",
                        "zh": "一种通常带有提手的硬质容器，用于搬运液体或小件物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведро",
                                "target_lang_sense_clarification": "сосуд"
                            },
                            {
                                "target_lang_word": "ведёрко",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水桶",
                                "target_lang_sense_clarification": "盛水或杂物的容器"
                            },
                            {
                                "target_lang_word": "桶",
                                "target_lang_sense_clarification": "通用容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f3b3119-9282-3046-97c5-8baeede78bc6",
                    "sense_definition": "The amount held in a bucket.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thirsty horse drank a whole <w>bucket</w> of water.",
                            "target_lang_translations": {
                                "ru": "Измученная жаждой лошадь выпила целое <w>ведро</w> воды.",
                                "zh": "那匹口渴的马喝了整整<w>一桶</w>水。"
                            }
                        },
                        {
                            "text": "We picked a <w>bucket</w> of apples from the tree in the garden.",
                            "target_lang_translations": {
                                "ru": "Мы собрали <w>ведро</w> яблок с дерева в саду.",
                                "zh": "我们从花园的树上摘了<w>一桶</w>苹果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bucket of water",
                        "bucket of ice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество чего-либо, вмещающееся в ведро.",
                        "zh": "一桶所能容纳的量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведро",
                                "target_lang_sense_clarification": "мера объёма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一桶",
                                "target_lang_sense_clarification": "容量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c536facc-2d5b-3ffe-a6e3-2495223a0337",
                    "sense_definition": "A large amount of liquid, such as rain or sweat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idiom_liquid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It rained <w>buckets</w> yesterday, flooding the entire street.",
                            "target_lang_translations": {
                                "ru": "Вчера лило как из <w>ведра</w>, затопив всю улицу.",
                                "zh": "昨天大雨<w>倾盆</w>，整条街都被淹了。"
                            }
                        },
                        {
                            "text": "I was so nervous about the interview that I sweated <w>buckets</w>.",
                            "target_lang_translations": {
                                "ru": "Я так нервничал из-за собеседования, что с меня <w>градом</w> лил пот.",
                                "zh": "我对面试感到非常紧张，以至于<w>大汗淋漓</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rain buckets",
                        "sweat buckets",
                        "cry buckets"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize intensity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество жидкости (обычно в идиомах о дожде или поте).",
                        "zh": "指代大量的液体（常用于描述雨水或汗水）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведро",
                                "target_lang_sense_clarification": "в идиоме 'лить как из ведра'"
                            },
                            {
                                "target_lang_word": "ручей",
                                "target_lang_sense_clarification": "в идиоме 'лить ручьем'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾盆",
                                "target_lang_sense_clarification": "形容雨大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52794a7d-5d19-3310-85f1-071d45070303",
                    "sense_definition": "The basket or a successful field goal in basketball.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_basketball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forward drove to the <w>bucket</w> and scored an easy layup.",
                            "target_lang_translations": {
                                "ru": "Нападающий прорвался к <w>кольцу</w> и забил легкий лей-ап.",
                                "zh": "前锋冲向<w>篮筐</w>，轻松上篮得分。"
                            }
                        },
                        {
                            "text": "We need to get a <w>bucket</w> on this possession to stay in the game.",
                            "target_lang_translations": {
                                "ru": "Нам нужно забить в <w>корзину</w> в этом владении, чтобы остаться в игре.",
                                "zh": "我们这次进攻必须<w>进球</w>才能留在比赛中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a bucket",
                        "drive to the bucket"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корзина или успешный бросок в баскетболе.",
                        "zh": "篮球运动中的篮筐或得分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кольцо",
                                "target_lang_sense_clarification": "баскетбольное"
                            },
                            {
                                "target_lang_word": "корзина",
                                "target_lang_sense_clarification": "баскетбольная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "篮筐",
                                "target_lang_sense_clarification": "篮球设施"
                            },
                            {
                                "target_lang_word": "进球",
                                "target_lang_sense_clarification": "得分动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cce1262b-9451-3fbc-9975-5a5345cc7d11",
                    "sense_definition": "A part of a piece of machinery, such as an excavator, used for scooping or lifting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "machinery_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excavator used its large metal <w>bucket</w> to dig the foundation.",
                            "target_lang_translations": {
                                "ru": "Экскаватор использовал свой большой металлический <w>ковш</w>, чтобы вырыть фундамент.",
                                "zh": "挖掘机用它巨大的金属<w>铲斗</w>挖掘地基。"
                            }
                        },
                        {
                            "text": "Be careful near the <w>bucket</w> of the tractor when it is moving.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны рядом с <w>ковшом</w> трактора, когда он движется.",
                                "zh": "拖拉机移动时，靠近它的<w>铲斗</w>要小心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scoop"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть механизма (например, экскаватора) в форме чаши для черпания или подъема грунта.",
                        "zh": "机械设备（如挖掘机）上用于铲取或提升物料的部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковш",
                                "target_lang_sense_clarification": "деталь машины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铲斗",
                                "target_lang_sense_clarification": "工程机械部件"
                            },
                            {
                                "target_lang_word": "挖斗",
                                "target_lang_sense_clarification": "挖掘机部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ba7d325-b7fe-39ff-8015-ebf2371910d7",
                    "sense_definition": "An old vehicle that is not in good working order.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drives a rusty old <w>bucket</w> that breaks down every week.",
                            "target_lang_translations": {
                                "ru": "Он ездит на ржавом старом <w>ведре</w>, которое ломается каждую неделю.",
                                "zh": "他开着一辆每周都要坏的生锈<w>破车</w>。"
                            }
                        },
                        {
                            "text": "I can't believe you bought that <w>bucket</w> for five hundred dollars.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что ты купил это <w>корыто</w> за пятьсот долларов.",
                                "zh": "真不敢相信你花了五百美元买了那辆<w>破车</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jalopy",
                        "clunker",
                        "rustbucket",
                        "wreck"
                    ],
                    "common_phrases": [
                        "rust bucket"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory or humorous"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старый автомобиль в плохом состоянии.",
                        "zh": "状况不佳的旧车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведро",
                                "target_lang_sense_clarification": "сленг: старая машина"
                            },
                            {
                                "target_lang_word": "корыто",
                                "target_lang_sense_clarification": "сленг: старая машина"
                            },
                            {
                                "target_lang_word": "развалюха",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破车",
                                "target_lang_sense_clarification": "贬义"
                            },
                            {
                                "target_lang_word": "老爷车",
                                "target_lang_sense_clarification": "老旧车辆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1ace35-09f9-3704-a781-85e51253c7d4",
                    "sense_definition": "A storage space in a hash table for every item sharing a particular key.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If too many items end up in the same <w>bucket</w>, the lookup time increases.",
                            "target_lang_translations": {
                                "ru": "Если слишком много элементов окажется в одной <w>корзине</w>, время поиска увеличится.",
                                "zh": "如果太多的项目最终进入同一个<w>桶</w>，查找时间就会增加。"
                            }
                        },
                        {
                            "text": "The algorithm distributes data evenly across every <w>bucket</w> in the array.",
                            "target_lang_translations": {
                                "ru": "Алгоритм равномерно распределяет данные по каждой <w>ячейке</w> в массиве.",
                                "zh": "该算法将数据均匀地分布在数组中的每个<w>桶</w>里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ячейка памяти в хеш-таблице для хранения элементов с одинаковым ключом.",
                        "zh": "哈希表中用于存储具有相同键值的元素的存储单元。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корзина",
                                "target_lang_sense_clarification": "информатика"
                            },
                            {
                                "target_lang_word": "сегмент",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桶",
                                "target_lang_sense_clarification": "计算机科学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29f29e31-0448-35ae-b685-060decc08919",
                    "sense_definition": "To rain very heavily.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "weather_rain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It’s really <w>bucketing</w> down out there, so take an umbrella.",
                            "target_lang_translations": {
                                "ru": "Там реально льёт как из <w>ведра</w>, так что возьми зонт.",
                                "zh": "外面正在<w>倾盆大雨</w>，带把伞吧。"
                            }
                        },
                        {
                            "text": "We stayed inside all day because it was <w>bucketing</w> without stopping.",
                            "target_lang_translations": {
                                "ru": "Мы просидели дома весь день, потому что лило как из <w>ведра</w> не переставая.",
                                "zh": "我们整天待在室内，因为外面一直在下着<w>倾盆大雨</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pour"
                    ],
                    "common_phrases": [
                        "bucket down"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually with 'down'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лить очень сильно (о дожде).",
                        "zh": "形容雨下得非常大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лить как из ведра",
                                "target_lang_sense_clarification": "о дожде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾盆大雨",
                                "target_lang_sense_clarification": "形容雨势猛烈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17112806-2437-3df0-ba5f-671e3848887b",
                    "sense_definition": "To draw, lift, or carry liquids or items using a bucket.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action_carry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers had to <w>bucket</w> water from the river during the drought.",
                            "target_lang_translations": {
                                "ru": "Жителям деревни пришлось <w>черпать</w> воду из реки во время засухи.",
                                "zh": "干旱期间，村民们不得不从河里<w>提</w>水。"
                            }
                        },
                        {
                            "text": "We spent the morning <w>bucketing</w> sand out of the trench.",
                            "target_lang_translations": {
                                "ru": "Мы провели утро, <w>вычерпывая</w> песок из траншеи.",
                                "zh": "我们花了一上午的时间把沟里的沙子<w>舀</w>出来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Черпать, поднимать или носить жидкости или предметы с помощью ведра.",
                        "zh": "用桶来舀取、提升或搬运液体或物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черпать",
                                "target_lang_sense_clarification": "набирать ведром"
                            },
                            {
                                "target_lang_word": "носить вёдрами",
                                "target_lang_sense_clarification": "переносить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舀",
                                "target_lang_sense_clarification": "用容器取物"
                            },
                            {
                                "target_lang_word": "提",
                                "target_lang_sense_clarification": "搬运"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5465385-54f3-3077-8c06-af25071a7ae2",
                    "sense_definition": "To categorize data by splitting it into groups of related items.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "data_categorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These candidates are then <w>bucketed</w> into groups based on their experience.",
                            "target_lang_translations": {
                                "ru": "Затем эти кандидаты <w>группируются</w> на основе их опыта.",
                                "zh": "然后根据经验将这些候选人<w>归类</w>。"
                            }
                        },
                        {
                            "text": "The software automatically <w>buckets</w> expenses into different tax categories.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение автоматически <w>распределяет</w> расходы по разным налоговым категориям.",
                                "zh": "该软件会自动将费用<w>归类</w>到不同的税务类别中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "categorize",
                        "group",
                        "classify"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business or technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Категоризировать данные, разделяя их на группы связанных элементов.",
                        "zh": "通过将数据划分为相关组别来进行分类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группировать",
                                "target_lang_sense_clarification": "распределять по группам"
                            },
                            {
                                "target_lang_word": "классифицировать",
                                "target_lang_sense_clarification": "распределять по классам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归类",
                                "target_lang_sense_clarification": "分配到组"
                            },
                            {
                                "target_lang_word": "分组",
                                "target_lang_sense_clarification": "分类处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e42996-d1f8-35f4-a0cd-593ceb3f5f51",
                    "sense_definition": "To travel very quickly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat was <w>bucketing</w> along through the rough waves.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка <w>неслась</w> по бурным волнам.",
                                "zh": "小船在汹涌的波涛中<w>飞驰</w>。"
                            }
                        },
                        {
                            "text": "We were <w>bucketing</w> down the highway trying to catch the flight.",
                            "target_lang_translations": {
                                "ru": "Мы <w>мчались</w> по шоссе, пытаясь успеть на рейс.",
                                "zh": "我们为了赶上航班，在高速公路上<w>疾驰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speed",
                        "hurtle",
                        "rocket"
                    ],
                    "common_phrases": [
                        "bucket along"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
