                    "sense_id": "67768789-55bb-3c16-b564-680d0f17d19d",
                    "sense_definition": "von einer hellen violetten Farbe; die Farbe von Fliederblüten habend",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "farbe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meine Schwester trägt heute ein schönes <w>lila</w> Kleid.",
                            "target_lang_translations": {
                                "en": "My sister is wearing a beautiful <w>purple</w> dress today.",
                                "ru": "Сегодня на моей сестре красивое <w>лиловое</w> платье.",
                                "nl": "Mijn zus draagt vandaag een mooie <w>lila</w> jurk.",
                                "pl": "Moja siostra ma dziś na sobie piękną <w>liliową</w> sukienkę.",
                                "fr": "Aujourd'hui, ma sœur porte une belle robe <w>lilas</w>.",
                                "it": "Oggi mia sorella indossa un bel vestito <w>lilla</w>.",
                                "cs": "Moje sestra má dnes na sobě krásné <w>fialové</w> šaty.",
                                "tr": "Kız kardeşim bugün güzel, <w>lila</w> bir elbise giyiyor.",
                                "es": "Mi hermana lleva hoy un bonito vestido <w>lila</w>.",
                                "zh": "我妹妹今天穿了一件漂亮的<w>浅紫色</w>连衣裙。"
                            }
                        },
                        {
                            "text": "Im Frühling blühen viele kleine <w>lila</w> Blumen im Garten.",
                            "target_lang_translations": {
                                "en": "In spring, many small <w>purple</w> flowers bloom in the garden.",
                                "ru": "Весной в саду цветёт много маленьких <w>лиловых</w> цветов.",
                                "nl": "In het voorjaar bloeien veel kleine <w>paarse</w> bloemen in de tuin.",
                                "pl": "Wiosną w ogrodzie kwitnie wiele małych, <w>liliowych</w> kwiatów.",
                                "fr": "Au printemps, beaucoup de petites fleurs <w>mauves</w> fleurissent dans le jardin.",
                                "it": "In primavera fioriscono molti piccoli fiori <w>lilla</w> in giardino.",
                                "cs": "Na jaře na zahradě kvete mnoho malých <w>fialových</w> květin.",
                                "tr": "İlkbaharda bahçede birçok küçük <w>mor</w> çiçek açar.",
                                "es": "En primavera florecen muchas pequeñas flores <w>lilas</w> en el jardín.",
                                "zh": "春天，花园里盛开着许多小小的<w>淡紫色</w>花朵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "violett",
                        "hellviolett",
                        "fliederfarben",
                        "lilafarben"
                    ],
                    "common_phrases": [
