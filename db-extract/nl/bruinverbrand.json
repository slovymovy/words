                "senses": [
                    {
                        "sense_id": "bbb6dba5-cea5-3858-90af-f1c5b2b7ce62",
                        "entry_id": "9d080004-f6de-33b6-bd88-e0b88349f232",
                        "glosses": [
                            "van de huid: door de uv-straling van de zon bruin geworden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4283d78-6cc2-4cba-8a18-875a3ca7a91d",
                                "sense_id": "bbb6dba5-cea5-3858-90af-f1c5b2b7ce62",
                                "text": "En dan komen de vakantiegangers thuis. Bruinverbrand en uitgerust, vragend hoe mijn vakantie was, die ik niet heb ­gehad. De drukte keert terug, de lome zomer komt tot een resoluut einde."
                            },
                            {
                                "example_id": "254854a5-c6e1-429a-81e2-2a621007c2c6",
                                "sense_id": "bbb6dba5-cea5-3858-90af-f1c5b2b7ce62",
                                "text": "De film van Van Noort en Sigmond opende met een scène die me voor altijd bij zal blijven: het beeld van zomaar een hal van zomaar een huis in Nederland. Een oudere heer met een bruinverbrand gezicht rommelt wat in zijn paraplubak. Dan tilt hij het ding op, zet zijn leesbril op en bestudeert de bronzen bak nauwkeurig."
                            }
                        ]
                    }
