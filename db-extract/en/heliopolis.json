                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heliopolis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6e48479-6b87-3fd3-ba63-63f038575f3a",
                                        "entry_id": "ee31cbc9-3463-34f3-afc2-fda513489efa",
                                        "glosses": [
                                            "Stadt im alten Ägypten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1ed8f2-3078-49d0-a71b-0a21a6b65ce8",
                                                "sense_id": "f6e48479-6b87-3fd3-ba63-63f038575f3a",
                                                "text": "„Er ist den Steinen im früheren Ägypten nachgebildet, geweiht dem Sonnengotte Aton und aufgerichtet in Heliopolis.“"
                                            },
                                            {
                                                "example_id": "32e19b18-fdb9-4f4a-a0f0-55436d6ec829",
                                                "sense_id": "f6e48479-6b87-3fd3-ba63-63f038575f3a",
                                                "text": "„Überall standen Säulen, Obelisken und die lotrechten, frei trangenden Pfeiler von Bauwerken, neben denen die Tempel von Theben oder Heliopolis sich wie winzige Hütten ausgenommen hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fb0094c-e584-3b2f-af84-4c7eae4c5973",
                                        "entry_id": "ee31cbc9-3463-34f3-afc2-fda513489efa",
                                        "glosses": [
                                            "Stadtteil von Kairo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8f99e0-6e98-4d12-bdea-3b3735141704",
                                                "sense_id": "9fb0094c-e584-3b2f-af84-4c7eae4c5973",
                                                "text": "„Fuad gab Jamal die Adresse einer gesicherten Wohnung der CIA in der Kairoer Vorstadt Heliopolis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
