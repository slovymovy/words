{
    "word_family": [
        "wel",
        "opwellen",
        "uitwellen",
        "welwater"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9530722d-69c3-3c5d-bb90-d916d7c7fb72",
                    "sense_definition": "Iets in water leggen om het vocht te laten opnemen en zachter te maken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de gedroogde pruimen eerst een nachtje <w>wellen</w> in water.",
                            "target_lang_translations": {
                                "en": "You first need to <w>soak</w> the dried prunes in water overnight."
                            }
                        },
                        {
                            "text": "Nu die rozijnen goed <w>geweld</w> zijn, kunnen ze door het beslag.",
                            "target_lang_translations": {
                                "en": "Now that those raisins are well <w>soaked</w>, they can be mixed into the batter."
                            }
                        }
                    ],
                    "synonyms": [
                        "weken",
                        "weekmaken"
                    ],
                    "antonyms": [
                        "drogen"
                    ],
                    "common_phrases": [
                        "rozijnen wellen",
                        "in water wellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To place something in water to allow it to absorb moisture and soften."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soak",
                                "target_lang_sense_clarification": "to immerse in liquid to soften or saturate"
                            },
                            {
                                "target_lang_word": "plump up",
                                "target_lang_sense_clarification": "to make dried fruit swell by soaking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9600777e-3af3-3d16-a9a5-875b2b464797",
                    "sense_definition": "Een vloeistof tot net onder het kookpunt verwarmen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verhitten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laat de melk zachtjes <w>wellen</w> zonder dat het echt gaat koken.",
                            "target_lang_translations": {
                                "en": "Let the milk <w>simmer</w> gently without actually letting it boil."
                            }
                        },
                        {
                            "text": "De kok liet de bouillon urenlang zachtjes <w>wellen</w> op het vuur.",
                            "target_lang_translations": {
                                "en": "The chef let the broth <w>simmer</w> gently on the stove for hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "simmeren",
                        "stoven"
                    ],
                    "antonyms": [
                        "koken"
                    ],
                    "common_phrases": [
                        "zachtjes wellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To heat a liquid to just below the boiling point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "simmer",
                                "target_lang_sense_clarification": "to cook gently just below boiling"
                            },
                            {
                                "target_lang_word": "steep",
                                "target_lang_sense_clarification": "to keep in warm liquid to extract flavor"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0bd744be-3f0c-3835-803b-cde9bdd67b21",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>wel</w>; natuurlijke bronnen waar water uit de grond omhoogkomt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bronnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit bosrijke gebied bevinden zich verschillende natuurlijke <w>wellen</w>.",
                            "target_lang_translations": {
                                "en": "There are several natural <w>springs</w> in this wooded area."
                            }
                        },
                        {
                            "text": "Het heldere water stroomde onophoudelijk uit de ondergrondse <w>wellen</w>.",
                            "target_lang_translations": {
                                "en": "The clear water flowed continuously from the underground <w>springs</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bronnen",
                        "waterbronnen"
                    ],
                    "common_phrases": [
                        "natuurlijke wellen"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'wel'; natural springs where water rises from the ground."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "springs",
                                "target_lang_sense_clarification": "natural sources of water rising from the ground"
                            },
                            {
                                "target_lang_word": "water sources",
                                "target_lang_sense_clarification": "places where water originates"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}