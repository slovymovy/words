                "senses": [
                    {
                        "sense_id": "1b26c848-fd0b-37a9-8c4d-736d50263ec9",
                        "entry_id": "dabdf740-1283-3af9-8aab-604a18fe1a94",
                        "glosses": [
                            "A combat engineer; an engineer or a soldier engaged in attacking, destroying, and circumventing or building fortifications, bridges, and roads; a military engineer active in a combat zone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0527f19d-02f1-4e9b-b030-6447115e5812",
                                "sense_id": "1b26c848-fd0b-37a9-8c4d-736d50263ec9",
                                "text": "his knowledge of Arabic and freedom from the theories of the ordinary sapper-school enabled him to teach the art of demolition to unlettered Beduin in a quick and ready way."
                            },
                            {
                                "example_id": "883134b9-1114-4832-8a5a-ce5e197be041",
                                "sense_id": "1b26c848-fd0b-37a9-8c4d-736d50263ec9",
                                "text": "A vast minefield trapped Ukrainian troops for weeks as infantry sappers slowly cleared an assault route on foot."
                            }
                        ]
                    },
                    {
                        "sense_id": "7df39efd-d4d5-32f1-9e1b-976944886395",
                        "entry_id": "dabdf740-1283-3af9-8aab-604a18fe1a94",
                        "glosses": [
                            "An officer or private of the Royal Engineers."
                        ],
                        "tags": [
                            "British",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "764f16f1-8d03-48fb-bb9d-0cfcc589444e",
                                "sense_id": "7df39efd-d4d5-32f1-9e1b-976944886395",
                                "text": "By a remarkable piece of railway reconstruction work on the part of the Allied Forces—mainly South African railway construction troops—mines laid along the track by the retreating enemy were removed by sappers, and the German damage made good, within 7 days."
                            },
                            {
                                "example_id": "8f8235af-de34-4357-a2a5-17ab3a2032e2",
                                "sense_id": "7df39efd-d4d5-32f1-9e1b-976944886395",
                                "text": "Billinge, from St Austell, was one of the first soldiers to land on 'Gold' beach on June 6 1944. He was a sapper attached to the 44 Royal Engineer Commandos and was one of only four to survive from his unit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d87d525b-1132-439d-a235-fe3a6c5bcdd3",
                        "source_entry_id": "dabdf740-1283-3af9-8aab-604a18fe1a94",
