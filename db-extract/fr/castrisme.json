                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09c14b9f-aebf-3abb-82b8-3559eff4476a",
                                        "entry_id": "637dc0b9-ccf6-35c4-a996-921c9a1b5e37",
                                        "glosses": [
                                            "Synonym of Castrism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313ce127-dfd8-406f-ba62-7a4dfeac8d63",
                                                "sense_id": "09c14b9f-aebf-3abb-82b8-3559eff4476a",
                                                "text": "A summary dialectic would thus make of Fidelism an a posteriori synthesis of two currents, national and international, nationalist and Communist. But such an interpretation risks giving Fidelism the consistency of a distinct ideology, which it does not have and does not want."
                                            },
                                            {
                                                "example_id": "f36ac1ba-5e49-4d71-af11-81147261a874",
                                                "sense_id": "09c14b9f-aebf-3abb-82b8-3559eff4476a",
                                                "text": "He is undoubtedly conscious of Fidelism and its threat to constituted governments and Cuba can push him too hard. Better than most Latin American leaders today, he can meet Fidelism with its own weapons which he understands well."
                                            },
                                            {
                                                "example_id": "700ff382-37bd-4e64-a22c-ac2edfad7e37",
                                                "sense_id": "09c14b9f-aebf-3abb-82b8-3559eff4476a",
                                                "text": "Originally the New Left was indistinguishable from Fidelism, but in view of this uneven development the vanguard is no longer coextensive with the entire movement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
