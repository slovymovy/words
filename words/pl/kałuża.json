{
    "word_family": [
        "kałużysko",
        "kałużasty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88588afe-04b8-364a-b429-30a731ed0b92",
                    "sense_definition": "niewielkie, płytkie zagłębienie w ziemi lub nawierzchni wypełnione wodą z opadów albo błotem",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "woda_zbiornik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci z radością skakały w głębokie <w>kałuże</w> po letnim deszczu.",
                            "target_lang_translations": {
                                "ru": "Дети с радостью прыгали в глубокие <w>лужи</w> после летнего дождя."
                            }
                        },
                        {
                            "text": "Musiałem ominąć dużą <w>kałużę</w>, żeby nie przemoczyć nowych butów.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось обойти большую <w>лужу</w>, чтобы не промочить новые ботинки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skakać po kałużach",
                        "ominąć kałużę",
                        "wdepnąć w kałużę"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое неглубокое углубление в земле или дорожном покрытии, заполненное дождевой водой или грязью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лужа",
                                "target_lang_sense_clarification": "на земле или дороге после дождя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fee78702-c95f-3bea-8af1-54387d6f4274",
                    "sense_definition": "rozlana na jakiejś powierzchni ciecz tworząca plamę",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "plama_ciecz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na korytarzu rozlał się sok i powstała lepka <w>kałuża</w>.",
                            "target_lang_translations": {
                                "ru": "В коридоре разлился сок, и образовалась липкая <w>лужа</w>."
                            }
                        },
                        {
                            "text": "Policjanci zabezpieczyli miejsce wypadku, w którym widoczna była <w>kałuża</w> krwi.",
                            "target_lang_translations": {
                                "ru": "Полицейские оцепили место происшествия, где была видна <w>лужа</w> крови."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kałuża krwi"
                    ],
                    "target_lang_definitions": {
                        "ru": "пролитая на какую-либо поверхность жидкость, образующая пятно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лужа",
                                "target_lang_sense_clarification": "разлитая жидкость на полу или поверхности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d6c07fd3-a5a7-36b6-a058-abc2c91350bc",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Kałuża</w> przyszedł dzisiaj punktualnie na zebranie zarządu.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Калужа</w> пришёл сегодня вовремя на заседание правления."
                            }
                        },
                        {
                            "text": "Wczoraj rozmawiałem z profesorem <w>Kałużą</w> o wynikach moich badań.",
                            "target_lang_translations": {
                                "ru": "Вчера я говорил с профессором <w>Калужей</w> о результатах моих исследований."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Калужа",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "475004f5-bbd4-3fff-9868-7bc1c4bd3f85",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Kałuża</w> odebrała telefon i przekazała nam ważne wiadomości.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Калужа</w> ответила на звонок и передала нам важные новости."
                            }
                        },
                        {
                            "text": "Spotkałem wczoraj doktor <w>Kałużę</w> w przychodni lekarskiej.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил доктора <w>Калужу</w> в поликлинике."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Калужа",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
