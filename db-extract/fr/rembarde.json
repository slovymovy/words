                        "tags": [
                            "plural"
                        ],
                        "form": "rembardes"
                    },
                    {
                        "form_id": "31f40826-6ba4-4944-80d5-242fd3fc809e",
                        "entry_id": "93511e36-0345-3fc5-8a6e-715111488039",
                        "tags": [],
                        "form": "rambarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d81d274-c7e5-3fcb-a058-79a881c4ca92",
                        "entry_id": "93511e36-0345-3fc5-8a6e-715111488039",
                        "glosses": [
                            "Variante orthographique de rambarde. Barre horizontale, située à environ un mètre du sol, et destinée à prévenir une chute."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "022054af-8997-46a1-9859-c49aa7e5366e",
                                "sense_id": "2d81d274-c7e5-3fcb-a058-79a881c4ca92",
                                "text": "Je me cramponnai de toutes mes forces à la rembarde et j’allai au fond avec le Petroparlovsk."
                            },
                            {
                                "example_id": "adbe7a28-88b6-4696-9ea0-9dfd9a4995f7",
                                "sense_id": "2d81d274-c7e5-3fcb-a058-79a881c4ca92",
                                "text": "Le commandant Plelan, accoudé à la rembarde, contemplait la fuite obscure de l’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "1559afc6-f702-3b02-a04a-4f6de152d4d3",
                        "entry_id": "93511e36-0345-3fc5-8a6e-715111488039",
                        "glosses": [
                            "Profilé positionné au bord de certaines routes et destiné à empêcher les sorties de route."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bd3c8a-87cc-4102-b21f-8c6e3d1d0367",
                                "sense_id": "1559afc6-f702-3b02-a04a-4f6de152d4d3",
                                "text": "… il a déjà ‘inauguré’ le viaduc de Millau en s’élançant de la rembarde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf67b920-2706-42e1-a078-8ab1c065fb10",
                        "source_entry_id": "93511e36-0345-3fc5-8a6e-715111488039",
                        "target_lang_word": "Geländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                        "entry_id": "2e32cab6-04e2-386b-80b4-47ce3c53865e",
                                        "glosses": [
                                            "Konstruktion zum Festhalten entlang von Wegen oder Treppen sowie um Flächen, um Sicherheit gegen einen Absturz zu bieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6185abb-db1a-4610-9646-70e9762a4e06",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "Halte Dich gut am Geländer fest, wenn Du die steile Treppe hinunter gehst!"
                                            },
                                            {
                                                "example_id": "4efd1a83-06a4-4898-91fa-6bf8d9cdaa27",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "Es ist verboten, über das Geländer zu klettern!"
                                            },
                                            {
                                                "example_id": "49b55b7d-5ce1-4c88-8859-c45c276a7a68",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Jetzt muß sie im ersten Stockwerk innehalten, ihre Hand wird im Dunkel des Flurs nach den Bogen des gewellten Geländers tasten, ihr Fuß die schiefe, ausgetretene Treppe suchen, die zum zweiten Stockwerk führt.“"
                                            },
                                            {
                                                "example_id": "7217f40e-5828-4c2f-9bb6-4415b1026925",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Der rote Jude trat wieder in das Haus, entdeckte den andern am Geländer zuerst nicht.“"
                                            },
                                            {
                                                "example_id": "6b507f3d-9fa7-48a2-b5ca-dcf79461e449",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Mißmutig tritt Eos an das Geländer ihres Balkons und bemerkt plötzlich tief unter sich einen Mann, der in der ersten Etage eines der kleineren Häuser in der Nachbarschaft ein Fenster aufgestoßen hat und hinaussieht.“"
                                            },
                                            {
                                                "example_id": "6ed4f14e-93af-42ea-be82-49707bf30dff",
                                                "sense_id": "706da84d-23d7-3d89-80af-fdd05fbc7a10",
                                                "text": "„Er ging zurück ins Wohnzimmer, wankte zum Treppenhaus hinaus, hielt sich am Geländer fest und wühlte in seinen Taschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "351f4d43-8613-486e-ba6a-eb3549f9db19",
                        "source_entry_id": "93511e36-0345-3fc5-8a6e-715111488039",
                        "target_lang_word": "parapet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parapet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8117b4a-56d5-3cb1-900d-b1611176bd59",
                                        "entry_id": "110fe0f7-5c9d-310d-9602-d3d10c86ce36",
                                        "glosses": [
                                            "A low protective wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67aca827-2a1e-4b9c-8c21-2887b14d17b6",
                                                "sense_id": "e8117b4a-56d5-3cb1-900d-b1611176bd59",
                                                "text": "Engineers will be closely checking the bridge for damage beyond the obvious smashed parapets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05760b65-8b74-31c0-a2ed-649b8c6e7aaa",
                                        "entry_id": "110fe0f7-5c9d-310d-9602-d3d10c86ce36",
                                        "glosses": [
                                            "Part of a perimeter that extends above the roof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a85f03-a59a-4c87-872d-7879bceed744",
                                                "sense_id": "05760b65-8b74-31c0-a2ed-649b8c6e7aaa",
                                                "text": "Maccario, it was evident, did not care to take the risk of blundering upon a picket, and a man led them by twisting paths until at last the hacienda rose blackly before them. Appleby could see it dimly, a blur of shadowy buildings with the ridge of roof parapet alone cutting hard and sharp against the clearing sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb355f10-917a-3fe5-ba0d-b6a6f0aac73c",
                                        "entry_id": "110fe0f7-5c9d-310d-9602-d3d10c86ce36",
                                        "glosses": [
                                            "A fortification consisting of a wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660b0088-16dc-4259-be32-1e57c211d6d0",
                                                "sense_id": "eb355f10-917a-3fe5-ba0d-b6a6f0aac73c",
                                                "text": "Obviously if you have only a few days in which to train a soldier, you must teach him the things he will most need; how to take cover, how to advance across open ground, how to mount guards and build a parapet – above all, how to use his weapons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
