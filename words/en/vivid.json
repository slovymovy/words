                },
                {
                    "sense_id": "72ac0073-2657-381c-a27e-b8e832d07181",
                    "sense_definition": "Full of life, energy, and vigor; strikingly alive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liveliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>vivid</w> personality that lights up every room he enters.",
                            "target_lang_translations": {
                                "ru": "У него <w>я́ркая</w> индивидуальность, которая озаряет любую комнату, в которую он входит.",
                                "pl": "Ma tak <w>barwną</w> osobowość, że rozświetla każde pomieszczenie, do którego wchodzi."
                            }
                        },
                        {
                            "text": "The characters in the novel felt so <w>vivid</w> that they seemed real.",
                            "target_lang_translations": {
                                "ru": "Персонажи романа казались настолько <w>живы́ми</w>, что выглядели реальными.",
                                "pl": "Postacie w powieści wydawały się tak <w>żywe</w>, że sprawiały wrażenie prawdziwych."
                            }
