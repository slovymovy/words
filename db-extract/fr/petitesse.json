                    {
                        "translation_id": "fe3091a5-4ac0-45f8-a2e8-8b36732a710b",
                        "source_entry_id": "8193d494-2685-3c99-b7e2-f7e43567ff2c",
                        "source_sense_description": "Petite dimension, petite étendue, petit volume",
                        "target_lang_word": "piccolezza",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piccolezza",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca3c544-fe3f-3f61-8a05-880204e02d7f",
                                        "entry_id": "1deec852-4735-3bc0-ab06-0dac3aa94328",
                                        "glosses": [
                                            "alla resa dei conti, ormai evidente la colpevolezza di qualcuno, è spesso l'insistenza nell'accanirsi appunto con ostinata ed ingiusta cattiveria contro chi nulla ha fatto di sleale e scorretto"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7f9b3a1-c863-4e56-905e-50ea95a4fd25",
                                                "sense_id": "0ca3c544-fe3f-3f61-8a05-880204e02d7f",
                                                "text": "\"Tu, nella tua piccolezza, cerchi continuamente zizzania!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d47dfa7-6725-37f5-8e82-6f1ff15b96b5",
                                        "entry_id": "1deec852-4735-3bc0-ab06-0dac3aa94328",
                                        "glosses": [
                                            "approfittare di un momento di difficoltà di qualcuno, talvolta persino in malattia, insistendo vigliaccamente con accuse o con un espresso rancore crudele e sleale"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eba2abf-8334-45e8-a49a-267c635f3d8c",
                                                "sense_id": "9d47dfa7-6725-37f5-8e82-6f1ff15b96b5",
                                                "text": "nella sua piccolezza"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1e7354f-470c-49a8-85c8-c47172b7da74",
                        "source_entry_id": "8193d494-2685-3c99-b7e2-f7e43567ff2c",
                        "source_sense_description": "Modicité, surtout en parlant de dons, de présents.",
                        "target_lang_word": "Kleinigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                        "entry_id": "e96fe193-aa41-3a2e-a0a9-213a4b2c5b3e",
                                        "glosses": [
                                            "winzige oder unbedeutende Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b92c024-3437-4925-bd0b-223cbbc2f20e",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "Um die Kleinigkeiten kümmern wir uns später."
                                            },
                                            {
                                                "example_id": "332e788c-7909-4836-b0d0-3284dc471cd3",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "„Und dieser feige Verräter spuckte sofort alles aus, was er wußte, ohne die geringste Kleinigkeit auszulassen.“"
                                            },
                                            {
                                                "example_id": "6e4c2861-905a-4d37-b8a4-ee6bea2e481f",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "„Kleinigkeiten machten manchmal den größten Unterschied.“"
                                            },
                                            {
                                                "example_id": "22a398f2-bf61-4a07-a7dc-c108f4ca2cd9",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "„Aber an diesen Kleinigkeiten soll man sich nicht stoßen, wenn es gilt, einen neuen Markenartikel auszuprobieren, der einem so unwiderstehlich angeboten wird.“"
                                            },
                                            {
                                                "example_id": "11b91152-b0f2-4ee0-b2fb-e3c7b853278b",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
