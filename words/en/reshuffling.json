{
    "word_family": [
        "reshuffle",
        "shuffle",
        "shuffler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "217be4ff-d298-3975-ac61-3d0d2bb7adcd",
                    "sense_definition": "The act of changing the order, arrangement, or personnel of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reorganization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime minister announced a major cabinet <w>reshuffling</w> to improve government efficiency.",
                            "target_lang_translations": {
                                "de": "Der Premierminister kündigte eine umfassende <w>Kabinettumbildung</w> an, um die Effizienz der Regierung zu verbessern."
                            }
                        },
                        {
                            "text": "After the <w>reshuffling</w> of the project teams, productivity increased significantly.",
                            "target_lang_translations": {
                                "de": "Nach der <w>Umstrukturierung</w> der Projektteams stieg die Produktivität deutlich an."
                            }
                        }
                    ],
                    "synonyms": [
                        "reorganization",
                        "rearrangement",
                        "shake-up"
                    ],
                    "common_phrases": [
                        "cabinet reshuffling",
                        "personnel reshuffling"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Vorgang, bei dem die Reihenfolge, Anordnung oder das Personal von etwas geändert wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Umstrukturierung",
                                "target_lang_sense_clarification": "allgemeine organisatorische Neugestaltung"
                            },
                            {
                                "target_lang_word": "Umbesetzung",
                                "target_lang_sense_clarification": "speziell bei Personal oder Ämtern"
                            },
                            {
                                "target_lang_word": "Neuordnung",
                                "target_lang_sense_clarification": "allgemeine Änderung der Anordnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6339e3b7-855e-3cb0-8e38-592ecba7a3a3",
                    "sense_definition": "The present participle and gerund of <w>reshuffle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reorganization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are currently <w>reshuffling</w> the deck of cards to ensure a fair game.",
                            "target_lang_translations": {
                                "de": "Sie sind gerade dabei, die Karten <w>neu zu mischen</w>, um ein faires Spiel zu gewährleisten."
                            }
                        },
                        {
                            "text": "The company is <w>reshuffling</w> its management structure to better compete in the market.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen <w>strukturiert</w> seine Führungsstruktur <w>um</w>, um auf dem Markt besser bestehen zu können."
                            }
                        }
                    ],
                    "synonyms": [
                        "reorganizing",
                        "rearranging"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Partizip Präsens und Gerundium von 'reshuffle' (umstrukturieren, neu mischen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "umstrukturieren",
                                "target_lang_sense_clarification": "organisatorisch neu aufstellen"
                            },
                            {
                                "target_lang_word": "neu mischen",
                                "target_lang_sense_clarification": "bei Karten oder physischen Objekten"
                            },
                            {
                                "target_lang_word": "umbesetzen",
                                "target_lang_sense_clarification": "Personal oder Positionen neu verteilen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
