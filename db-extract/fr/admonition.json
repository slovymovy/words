                "forms": [
                    {
                        "form_id": "6a1a4885-29ba-4ff8-8ae5-0b50a0a73494",
                        "entry_id": "4e4a4cfb-771c-318b-a677-d8dcd95f2dd2",
                        "tags": [
                            "plural"
                        ],
                        "form": "admonitions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2ac7f1f-ef54-3854-a3de-b78c94a7bfba",
                        "entry_id": "4e4a4cfb-771c-318b-a677-d8dcd95f2dd2",
                        "glosses": [
                            "Action d’admonester, avertissement."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "e99c26c3-16e8-4ba3-9bbb-1a9b77ef56b9",
                                "sense_id": "b2ac7f1f-ef54-3854-a3de-b78c94a7bfba",
                                "text": "Après plusieurs admonitions."
                            },
                            {
                                "example_id": "4bdd9fb7-c0f2-4ed3-a1f9-873511107302",
                                "sense_id": "b2ac7f1f-ef54-3854-a3de-b78c94a7bfba",
                                "text": "De temps à autre, la petite main s’allonge, cueille maladroitement, ou plutôt arrache, une tige ou une touffe. L’oncle un peu solennel proteste : « Songe à la plante mutilée, à ses racines laborieuses, à la sève qui découle de sa blessure… » […] Se souviendra-t-elle de l’admonition au bal, quand elle portera dans les cheveux ou au corsage ce que Victor Hugo appelle un bouquet d’agonies ?"
                            },
                            {
                                "example_id": "3607add9-ff38-4503-9780-114e25545400",
                                "sense_id": "b2ac7f1f-ef54-3854-a3de-b78c94a7bfba",
                                "text": "Selon l’admonition, le frère ne fait pas sien le bon travail qu’il accomplit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a34356e-80bc-42ba-bbf4-cdff92bb7334",
                        "source_entry_id": "4e4a4cfb-771c-318b-a677-d8dcd95f2dd2",
                        "source_sense_id": "b2ac7f1f-ef54-3854-a3de-b78c94a7bfba",
                        "target_lang_word": "admonition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admonition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5692087d-75a4-3cbd-89f1-e4324782c156",
                                        "entry_id": "05fc563c-adba-3023-bd24-3bb32bf4833d",
                                        "glosses": [
                                            "A rebuke by an authority that one has erred and should not persist in their actions; a reprimand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6335142-589f-47d5-859b-9b97ccff05ea",
                                                "sense_id": "5692087d-75a4-3cbd-89f1-e4324782c156",
                                                "text": "But modesty cannot be implanted by admonition only—the elders must set the example."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
