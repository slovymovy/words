                "senses": [
                    {
                        "sense_id": "16264c3b-c276-3fd0-9e83-d81dabad88f5",
                        "entry_id": "b89c54ce-4851-3396-878a-356f04d31cdd",
                        "glosses": [
                            "Wort auffälliger Länge und/oder ungewöhnlicher Wortbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff20c8a-c815-4e5f-bcaa-56e689798384",
                                "sense_id": "16264c3b-c276-3fd0-9e83-d81dabad88f5",
                                "text": "„Die rot-grüne Bundesregierung wollte das Wort 2004 mit dem »Gesetz zur finanziellen Unterstützung der Innovationsoffensive durch Abschaffung der Eigenheimzulage« entsorgen, scheiterte mit diesem Wortungetüm aber im Bundesrat, der Vermittlungsausschuss vermittelte.“"
                            },
                            {
                                "example_id": "51aad562-8cc9-43e8-8cd8-b279d4129c8d",
                                "sense_id": "16264c3b-c276-3fd0-9e83-d81dabad88f5",
                                "text": "„Sie stellt aber auch Anforderungen an die Bürger als Sprachrezipienten, an ihr sprachliches Wissen und Können, etwa bei der Aufnahme von Wortungetümen wie »Wachstumsbeschleunigungsgesetz«.“"
                            },
                            {
                                "example_id": "e7eb6add-913e-49c1-8078-e2608263376e",
                                "sense_id": "16264c3b-c276-3fd0-9e83-d81dabad88f5",
                                "text": "„Das Deutsche ist bekannt für seine Wortungetüme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
