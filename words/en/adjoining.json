{
    "word_family": [
        "adjoin",
        "adjoinment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68ae66bd-1002-343d-8302-8372deeca4e2",
                    "sense_definition": "Being in contact at some point or line; next to or touching something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stayed in two <w>adjoining</w> rooms at the hotel.",
                            "target_lang_translations": {
                                "pl": "Zatrzymaliśmy się w dwóch <w>sąsiednich</w> pokojach w hotelu."
                            }
                        },
                        {
                            "text": "The garden is located on the <w>adjoining</w> property.",
                            "target_lang_translations": {
                                "pl": "Ogród znajduje się na <w>przyległej</w> posesji."
                            }
                        }
                    ],
                    "synonyms": [
                        "contiguous",
                        "bordering",
                        "adjacent"
                    ],
                    "antonyms": [
                        "separated"
                    ],
                    "common_phrases": [
                        "adjoining room",
                        "adjoining property"
                    ],
                    "target_lang_definitions": {
                        "pl": "Będący w kontakcie w jakimś punkcie lub linii; znajdujący się obok lub stykający się z czymś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sąsiedni",
                                "target_lang_sense_clarification": "odnoszący się do czegoś, co znajduje się tuż obok lub w bezpośrednim sąsiedztwie"
                            },
                            {
                                "target_lang_word": "przyległy",
                                "target_lang_sense_clarification": "odnoszący się do czegoś, co bezpośrednio graniczy lub styka się z danym obiektem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46143b4a-031b-3c77-b553-14ba33ecc38b",
                    "sense_definition": "Present participle and gerund of <w>adjoin</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two buildings are <w>adjoining</w> each other.",
                            "target_lang_translations": {
                                "pl": "Te dwa budynki <w>przylegają</w> do siebie."
                            }
                        },
                        {
                            "text": "He is <w>adjoining</w> the new garage to the main house.",
                            "target_lang_translations": {
                                "pl": "On <w>dobudowuje</w> nowy garaż do głównego domu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb adjoin."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów przymiotnikowy czynny lub forma gerundium czasownika 'adjoin' (przylegać, graniczyć)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przylegający",
                                "target_lang_sense_clarification": "forma imiesłowowa opisująca czynność lub stan przylegania do czegoś"
                            },
                            {
                                "target_lang_word": "graniczący",
                                "target_lang_sense_clarification": "forma imiesłowowa opisująca czynność lub stan posiadania wspólnej granicy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}