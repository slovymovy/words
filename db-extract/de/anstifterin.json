                        "entry_id": "e20042ab-ee6f-3100-b280-ea0fc651ae93",
                        "glosses": [
                            "weibliche Person, die jemand dazu veranlasst, etwas Falsches/Unrechtmäßiges zu tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5528fc4-301d-443e-80ee-234bd6b3e1c3",
                                "sense_id": "a7486f29-252d-3980-9ba0-42b1bf5a1946",
                                "text": "Ida hat nicht mitgemacht, sie war nicht dabei, aber sie war ja eigentlich die Anstifterin, weil sie als erste auf die Idee gekommen ist."
                            },
                            {
                                "example_id": "19071417-fdc6-4019-9abe-b45da09663d6",
                                "sense_id": "a7486f29-252d-3980-9ba0-42b1bf5a1946",
                                "text": "„Ich sah in ihnen Anstifterinnen meiner schrecklichen Begehrlichkeit, die mich zum Mörder eines leibhaftigen Engels hatte werden lassen.“"
                            }
                        ],
