                    {
                        "sense_id": "b8df85ca-22c8-3aa2-8ebe-1ba30ba39b3c",
                        "entry_id": "29ef8b44-0504-329d-b646-b1eaf451ebe0",
                        "glosses": [
                            "alle organen die dienen voor de voortbeweging van een organisme zoals bijvoorbeeld botten, spieren en gewrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ae806bd-074c-44db-86ee-287cb37aa19d",
                                "sense_id": "b8df85ca-22c8-3aa2-8ebe-1ba30ba39b3c",
                                "text": "Het gaat om patiënten met het ongeneeslijke Morquio A-syndroom, een zeer zeldzame erfelijke ziekte. Patiënten lijden aan voortschrijdende abnormale vorming en groei van het skelet. De patiënten blijven vaak heel klein en krijgen steeds meer problemen met hun bewegingsapparaat."
                            },
                            {
                                "example_id": "c7b64315-49ec-46c8-9acb-36a0862352c6",
                                "sense_id": "b8df85ca-22c8-3aa2-8ebe-1ba30ba39b3c",
                                "text": "\"We hopen over vier jaar bot of kraakbeen te gaan printen\", zegt Wouter Dhert, hoogleraar translationeel onderzoek van het steun- en bewegingsapparaat bij het universitair medisch centrum Utrecht. \"Er is veel kennis nodig en dat krijg je alleen maar als je meer specialisten hebt. Die moeten het 3D-bioprinten naar een hoger niveau tillen.\""
                            }
                        ]
                    }
