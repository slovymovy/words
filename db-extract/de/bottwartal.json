                ],
                "senses": [
                    {
                        "sense_id": "f85b9671-2e68-3dc7-bd2f-4eeaba2e0b2b",
                        "entry_id": "1d97b99b-6aeb-39d3-9ef2-16757ddf6efc",
                        "glosses": [
                            "das Tal, in dem die Bottwar fließt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "5cf29fa7-3f20-462e-b0c9-5677a43fb496",
                                "sense_id": "f85b9671-2e68-3dc7-bd2f-4eeaba2e0b2b",
                                "text": "„Unser heutiger Ausflug führt uns in das Bottwartal der 60er Jahre, zum \"Feurigen Elias\".“"
                            },
                            {
                                "example_id": "6b2bdea7-cf08-4141-b551-7a1dd5b7b8de",
                                "sense_id": "f85b9671-2e68-3dc7-bd2f-4eeaba2e0b2b",
                                "text": "„Im „Regionalen Fenster“ des Landratsamtes Ludwigsburg wird derzeit für Wanderungen im Bottwartal geworben.“"
                            },
                            {
                                "example_id": "9b45e4f8-b18a-46e8-a306-b6ba611d0815",
                                "sense_id": "f85b9671-2e68-3dc7-bd2f-4eeaba2e0b2b",
                                "text": "„Wer am Dienstagmorgen rund um die Burg Hohenbeilstein im Bottwartal unterwegs gewesen ist, konnte in eine mystische Landschaft eintauchen.“"
                            },
                            {
                                "example_id": "749a4847-4bed-46be-9cbf-04a4365b064c",
                                "sense_id": "f85b9671-2e68-3dc7-bd2f-4eeaba2e0b2b",
                                "text": "„Unter dem Eindruck dieser Katastrophen haben sich die Kommunen Steinheim, Großbottwar, Oberstenfeld und Beilstein zu einem Zweckverband zusammengeschlossen, um der Hochwassergefahr im Bottwartal mit wirksamen Maßnahmen zu begegnen.“"
                            },
                            {
                                "example_id": "50d06217-8a5c-4e87-80fd-4c64438925a4",
                                "sense_id": "f85b9671-2e68-3dc7-bd2f-4eeaba2e0b2b",
                                "text": "„Nun springt ein junger Wasserbüffel im Bottwartal über die Weiden - putzmunter und tiefschwarz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
