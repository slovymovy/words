                    {
                        "sense_id": "99182926-29c4-3049-bc06-332106c5a2f8",
                        "entry_id": "e239e6bf-735f-39a4-a7e0-a2409d9ea5ff",
                        "glosses": [
                            "een lamp die dient als een merkteken om veilig te kunnen navigeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0532e95b-a504-4148-bd50-08b0db6e4713",
                                "sense_id": "99182926-29c4-3049-bc06-332106c5a2f8",
                                "text": "Het cruiseschip met de naam Pacific Princess was op weg naar Dover. Gisteravond zag het dertig kilometer voor de kust van Norwich het lichtbaken van het reddingsvlot. Het was een lastige opgave om de drenkelingen op te pikken, omdat er golven stonden van meer dan anderhalve meter."
                            }
                        ]
                    },
                    {
                        "sense_id": "23087d23-b32e-33b8-a07b-d2adac73a9e0",
                        "entry_id": "e239e6bf-735f-39a4-a7e0-a2409d9ea5ff",
                        "glosses": [
                            "iets of iemand die het goede, hoopvolle voorbeeld is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf0578d-aee0-421f-8025-da2d24fa247d",
                                "sense_id": "23087d23-b32e-33b8-a07b-d2adac73a9e0",
                                "text": "Southgate was daarover heel duidelijk: \"Dat tolereren wij niet. Het is niet waar we voor staan. Ik denk dat wij een lichtbaken zijn geweest in het samenbrengen van mensen. Het nationale elftal is er voor iedereen.\""
                            }
                        ]
                    }
