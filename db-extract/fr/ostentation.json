                                    }
                                ]
                            },
                            {
                                "target_word": "flaunting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47ba7477-dc1c-3dc5-8931-087f547e3c25",
                                        "entry_id": "37c05521-1411-3f81-8c0d-84df506a654a",
                                        "glosses": [
                                            "That flaunts; showy or gaudy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7240610-80c0-4742-b84f-68cd53780802",
                                                "sense_id": "47ba7477-dc1c-3dc5-8931-087f547e3c25",
                                                "text": "He was much over-dressed, in a gaudy vest of many colors, a blue neckerchief, bedropped gayly with yellow spots, and arranged with a flaunting tie, quite in keeping with the general air of the man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flaunting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46236196-983c-3231-a1d9-723f298deb1f",
                                        "entry_id": "c1ed9729-3aaa-307f-b60c-3f6219a057ab",
                                        "glosses": [
                                            "The act by which something is flaunted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9daa2331-f4f7-4ff0-a6ee-3ebff4a8a914",
                                                "sense_id": "46236196-983c-3231-a1d9-723f298deb1f",
                                                "text": "Their bearing, which was simply the bearing of commonplace individuals going about their business in the assurance of perfect safety, was offensive to me like the outrageous flauntings of folly in the face of a danger it is unable to comprehend […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
