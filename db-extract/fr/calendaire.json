                "forms": [
                    {
                        "form_id": "baeecb24-1018-415a-aa0b-1994ee615af5",
                        "entry_id": "b6657046-8201-3562-a82a-f45fa637411d",
                        "tags": [
                            "plural",
                            "masculine",
