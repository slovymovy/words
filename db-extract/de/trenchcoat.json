                ],
                "senses": [
                    {
                        "sense_id": "f4812672-302c-38fe-84ac-f63488f1409b",
                        "entry_id": "cc453c9c-6c7c-3841-be97-a9c640be35f1",
                        "glosses": [
                            "Regenmantel mit Gürtel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ee0c23-a82f-4bde-b8c5-27aa0aacbdd6",
                                "sense_id": "f4812672-302c-38fe-84ac-f63488f1409b",
                                "text": "„Der Student mit den Schmissen verlangt kurz und knapp einen blauen Trenchcoat.“"
                            },
                            {
                                "example_id": "b3767c77-4ec5-473d-bc03-03cd51286f1b",
                                "sense_id": "f4812672-302c-38fe-84ac-f63488f1409b",
                                "text": "„Es mag auch sein, dass der Trenchcoat ein Klassiker ist, der, wenn man ihn tragen kann, ein überall einsetzbares Kleidungsstück ist.“"
                            },
                            {
                                "example_id": "32157a4d-6833-49fc-bcbc-f17cb7707241",
                                "sense_id": "f4812672-302c-38fe-84ac-f63488f1409b",
                                "text": "„In einer Ecke sitzt ein stilles Mädchen, sie trägt einen Trenchcoat, sie hat glänzendes blondes Haar, und ihr Gesicht ist wie das eines Vogels, eines dieser harten kleinen Gesichter, deren Knochen sich unter der Haut abzeichnen.“"
                            },
                            {
                                "example_id": "dd433d26-4735-4c7d-8090-2e9d2c2de2e8",
                                "sense_id": "f4812672-302c-38fe-84ac-f63488f1409b",
                                "text": "„Beim Eingang standen, verlegen grüßend, zwei Männer in nicht ganz sauberen Trenchcoats.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
