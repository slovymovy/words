                "senses": [
                    {
                        "sense_id": "07300677-f421-39c8-8095-55072442cf7c",
                        "entry_id": "4cc0443f-f784-3c61-90fa-66c00ff01f70",
                        "glosses": [
                            "grupa osób wykorzystująca swoje stanowiska dla własnych korzyści i uprawiania stronniczej polityki"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2236bb6a-8ad1-4f2f-a4c9-8ad6e89bda70",
                                "sense_id": "07300677-f421-39c8-8095-55072442cf7c",
                                "text": "Prezydent chce przeprosin za „dworską kamarylę”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7fcaf31b-7e3a-3eed-b11e-91ed36ccbe84",
                        "entry_id": "4cc0443f-f784-3c61-90fa-66c00ff01f70",
                        "glosses": [
                            "grupa dworzan faworyzowanych przez panującego, wywierająca wpływ na bieg spraw publicznych"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "40e7bf7e-512e-4fcc-be36-98fed9670bd7",
                                "sense_id": "7fcaf31b-7e3a-3eed-b11e-91ed36ccbe84",
                                "text": "Mikołaj II nie miał żadnych kwalifikacji do sprawowania władzy w wielkim państwie, a otaczająca go kamaryla dworska jeszcze bardziej pogarszała stan rzeczy"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e23e6468-ca9d-4856-b4b4-d1b4df10ae90",
                        "source_entry_id": "4cc0443f-f784-3c61-90fa-66c00ff01f70",
