                    {
                        "sense_id": "d32fa8d5-54d8-3884-ba5f-a0106b31f247",
                        "entry_id": "9ec438ce-b28c-30bc-97e7-f23f51054286",
                        "glosses": [
                            "Grande masse de roche molle ou mal consolidée, érodée par le vent dans une région désertique, qui se trouve parallèle aux vents dominants, et qui a souvent une forme inhabituelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29c4d768-188d-4eaa-9195-8b2f514b640f",
                                "sense_id": "d32fa8d5-54d8-3884-ba5f-a0106b31f247",
                                "text": "À la suite du dessèchement total des lacs, une très forte déflation a balayé jusqu’à 4,5 m de sédiments en produisant d’énormes quantités de poussière, ne laissant parfois que quelques yardangs."
                            },
                            {
                                "example_id": "bb2dbce0-4e07-4527-a747-8600d84cd1b8",
                                "sense_id": "d32fa8d5-54d8-3884-ba5f-a0106b31f247",
                                "text": "Selon Farouk El-Baz, il y aurait également possibilité d’un yardang, une formation rocheuse inhabituelle trouvée dans les déserts et résultant de la poussière et du sable soufflés par le vent."
                            }
                        ]
                    }
