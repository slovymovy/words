                ],
                "senses": [
                    {
                        "sense_id": "28fdc782-4368-3df9-8be2-f8943ed59d0f",
                        "entry_id": "e187d868-e01b-3eb1-9574-5f8c1399e6c8",
                        "glosses": [
                            "Menge des Pigments Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007696a4-14e9-4de1-bb4d-94e2e4c3a2da",
                                "sense_id": "28fdc782-4368-3df9-8be2-f8943ed59d0f",
                                "text": "„Eine oft beobachtete verstärkte Hautpigmentierung an belichteten Hautarealen wird nicht durch Eisenablagerungen, sondern durch einen erhöhten Melaningehalt hervorgerufen.“"
                            },
                            {
                                "example_id": "10b4ab40-8781-4bd8-b6ce-54269e378d95",
                                "sense_id": "28fdc782-4368-3df9-8be2-f8943ed59d0f",
                                "text": "„Ein dunkler Harn wird bei Blutgehalt, bei Melaningehalt und beim Ikterus entleert.“"
                            },
                            {
                                "example_id": "e9503cae-daa9-4e09-9641-9012f8ea53ac",
                                "sense_id": "28fdc782-4368-3df9-8be2-f8943ed59d0f",
                                "text": "„Die Haarfarbe wird vom Melaningehalt in den verhornten Zellen bestimmt.“"
                            },
                            {
                                "example_id": "11f2bd1e-c60a-49aa-9be7-5b613e1f5cea",
                                "sense_id": "28fdc782-4368-3df9-8be2-f8943ed59d0f",
                                "text": "„Durch den verminderten Melaningehalt der Haut besteht eine starke Lichtempfindlichkeit (Fotosensibilität) mit erhöhter Gefahr von wiederholtem schwerem Sonnenbrand und daraus folgend auch von Hauttumoren.“"
                            },
                            {
                                "example_id": "04ce1b13-6dc7-4689-a6f8-292ea95934de",
                                "sense_id": "28fdc782-4368-3df9-8be2-f8943ed59d0f",
                                "text": "„Als mögliche Mechanismen werden der Melaningehalt, die Eisenkonzentration sowie die Anwesenheit von Enzymen diskutiert, die ihrerseits Sauerstoffradikale beseitigen helfen.“"
                            },
                            {
                                "example_id": "4333ac81-9174-4e9a-b9ba-8bdb7e2aa073",
                                "sense_id": "28fdc782-4368-3df9-8be2-f8943ed59d0f",
                                "text": "„In den Zellen der sogenannten ‚Substantia nigra‘, den zwei kleinen, durch einen hohen Eisen- und Melaningehalt dunkel gefärbten Arealen, die sich im Mittelhirn befinden, läuft genau das ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
