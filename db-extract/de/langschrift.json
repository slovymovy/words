                "senses": [
                    {
                        "sense_id": "9c44e418-12f0-382a-af0f-9a678bd35324",
                        "entry_id": "80655266-d020-3e6e-8981-ea22e407d512",
                        "glosses": [
                            "normale Schreibschrift, im Gegensatz zur Kurzschrift"
                        ],
                        "tags": [
                            "Stenografie"
                        ],
                        "examples": [
                            {
                                "example_id": "920dc112-b91c-4b83-bb65-7c7bf45b844a",
                                "sense_id": "9c44e418-12f0-382a-af0f-9a678bd35324",
                                "text": "„Übertragen Sie die stenografischen Beispiele Ihres Lehrbuches in Langschrift. Anschließend nehmen Sie sich diese Langschrift und übertragen die Beispiele wieder zurück in Kurzschrift.“"
                            },
                            {
                                "example_id": "cdb436ed-4bcb-49e6-a1e3-1bcd567298d7",
                                "sense_id": "9c44e418-12f0-382a-af0f-9a678bd35324",
                                "text": "„Es sollen Langschriften von Stenogrammen hergestellt werden.“"
                            },
                            {
                                "example_id": "f043688f-e32c-4490-9c8d-a32d03064027",
                                "sense_id": "9c44e418-12f0-382a-af0f-9a678bd35324",
                                "text": "„Auch konnte ich mit meinen wenigen noch vorhandenen Kenntnissen der Stenographie einzelne Wörter entziffern und war frohen Mutes, den gesamten Text mit etwas Anstrengung in Langschrift übertragen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
