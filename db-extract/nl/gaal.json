                        "entry_id": "de4fe3db-a2c9-3842-b4ce-5e3768c8e1a1",
                        "glosses": [
                            "spleet die ontstaat in een gobelin daar waar verschillende kleurvlakken tegen elkaar liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b56dc2-7079-4297-bd19-5f7f18dd7cb4",
                                "sense_id": "300088fc-3a2a-3cf1-9d75-873e4fbe87fa",
                                "text": "Afhankelijk van het ontwerp kan de gaal dichtgenaaid worden of open blijven."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cb26e0c-ecbd-312f-865d-e7fbb9b06eeb",
                        "entry_id": "de4fe3db-a2c9-3842-b4ce-5e3768c8e1a1",
                        "glosses": [
                            "langgerekte dunne streep in weefsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "110512c1-8104-436a-9ea0-b229d8f21707",
                                "sense_id": "9cb26e0c-ecbd-312f-865d-e7fbb9b06eeb",
                                "text": "(…) ze bloosde als het kritisch spiedend oog van haar schoonmoeder een gaal zag in het tafellaken, (…)"
                            },
                            {
                                "example_id": "54367899-c96c-455e-b439-6fa8a298a403",
                                "sense_id": "9cb26e0c-ecbd-312f-865d-e7fbb9b06eeb",
                                "text": "Wij leên geen vuil noch schurft noch smet,\nmaar hebben 't al in roer gezet\nom Israel te maken\nzo gaaf en zuiver als een glas\ndat daar niets onreins onder was,\nnoch streep noch gaal in 't laken."
                            }
                        ]
                    }
