                        "sense_id": "e4718dac-84ba-3506-b349-a061fd168f8c",
                        "entry_id": "270f3eef-57ba-336b-b494-f1ca2cac76b3",
                        "glosses": [
                            "Person, die auf einer Toilette sitzend uriniert"
