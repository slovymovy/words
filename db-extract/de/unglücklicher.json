                "senses": [
                    {
                        "sense_id": "18760a8f-c99b-31a0-8736-a013b314187a",
                        "entry_id": "8a4f112c-0298-3df0-b1ad-e900c774a3d4",
                        "glosses": [
                            "unglückliche, sich in einer misslichen Lage befindende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d6c5b2-39f8-4afb-936c-9436ae9117b0",
                                "sense_id": "18760a8f-c99b-31a0-8736-a013b314187a",
                                "text": "„Und die Unglücklichen, die draußen unterwegs sind, bewegen sich ganz langsam, um Energie zu sparen; ihre Hemden und Blusen sind schweißnass.“"
                            },
                            {
                                "example_id": "7864ca8f-6948-490e-adf4-d01ea4e7f908",
                                "sense_id": "18760a8f-c99b-31a0-8736-a013b314187a",
                                "text": "„Angelockt werden diese Unglücklichen zum Teil von wissenschaftlicher Neugier, von unheiliger Machtgier oder von einer künstlerischen Sensitivität, die beinahe augenblicklich zu Instabilität führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
