                            "neuter"
                        ],
                        "form": "es ist zwider"
                    },
                    {
                        "form_id": "61bb1c95-fc17-490b-b7b9-5ffe795a7567",
                        "entry_id": "1ab3c0fb-6e6c-39a4-a68c-a146f2d9eb24",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind zwider"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5a89dd3-d2fb-3ae3-8a0b-dfd759ed5eb3",
                        "entry_id": "1ab3c0fb-6e6c-39a4-a68c-a146f2d9eb24",
                        "glosses": [
                            "Dialektform der standarddeutschen Form zuwider, kann aber im Gegensatz zu dieser auch attributiv verwendet werden"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "e2cd34d2-56e6-4155-9744-7bfb4b15c6d9",
                                "sense_id": "e5a89dd3-d2fb-3ae3-8a0b-dfd759ed5eb3",
                                "text": "„Alle Menschen san ma zwider, i mechts in die Goschn haun“"
                            },
                            {
                                "example_id": "bb91353b-b5d5-4cad-bc86-540d805e6653",
                                "sense_id": "e5a89dd3-d2fb-3ae3-8a0b-dfd759ed5eb3",
                                "text": "„Die Arbeit bleibt immer die gleiche. Deswegen versuchen wir, ein Umfeld zu schaffen, in dem die Leute nicht zwider sind und ihre Familie angranteln, wenn sie nach Hause kommen.“"
                            },
                            {
                                "example_id": "16ad9097-a0f6-4d3b-b621-822b20936979",
                                "sense_id": "e5a89dd3-d2fb-3ae3-8a0b-dfd759ed5eb3",
                                "text": "„Früher hat das Erwachsensein noch Würde gehabt: Da waren Erwachsene „grantig, zwider, unguat“, sagt Thomas Maurer in „Out of the dark“.“"
                            },
                            {
