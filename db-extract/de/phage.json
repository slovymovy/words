                            }
                        ]
                    },
                    {
                        "translation_id": "8e6ba02f-4eec-4a8e-bfa2-13e798f4bd8c",
                        "source_entry_id": "d1db09f4-2cd5-3352-8c60-7f78868d484c",
                        "source_sense_id": "6c723416-d066-3849-9ce8-9df92af7818e",
                        "source_sense_description": "Biologie: Virus, das auf Bakterien und Archaeen als Wirtszelle spezialisiert ist; Bakteriophage",
                        "target_lang_word": "phage",
                        "target_lang_code": "fr",
