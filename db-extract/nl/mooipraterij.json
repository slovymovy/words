                "senses": [
                    {
                        "sense_id": "10653ba6-aa91-3c8d-8a6f-42eb753d9df1",
                        "entry_id": "40893567-2308-3d2b-b122-2b1596d37b79",
                        "glosses": [
                            "het zaken mooier voorstellen dan ze eigenlijk zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48e94c0-86c8-4b2d-b185-b86efb310ba4",
                                "sense_id": "10653ba6-aa91-3c8d-8a6f-42eb753d9df1",
                                "text": "Ondanks veel mooipraterij slagen de bestuurders er maar niet in deze veenweidegebieden voor de toekomst te behouden."
                            },
                            {
                                "example_id": "269b19ba-a5b0-455e-a5a3-1a6f9f4278f1",
                                "sense_id": "10653ba6-aa91-3c8d-8a6f-42eb753d9df1",
                                "text": "Voor de oppositie was het niet genoeg. Volgens Fleur Agema (PVV) waren de antwoorden van Van Rijn „te glad” en bezigde hij „mooipraterij”. Ze verweet hem te praten over besluiten die „we met elkaar” hebben genomen. Hij probeert daarmee de Kamer medeverantwoordelijk te maken, zei Agema. Ook Linda Voortman (GroenLinks) sprak daarover haar ergernis uit."
                            },
                            {
                                "example_id": "20186d74-b9f6-46ae-8d07-aeec7d465911",
                                "sense_id": "10653ba6-aa91-3c8d-8a6f-42eb753d9df1",
                                "text": "Oud-model Imme Visser (26) is minder te spreken over het convenant. Het is mooipraterij, zegt ze. \"Ik vind dit soort initiatieven altijd een beetje onzin. Er staat niet concreet in wat er gaat gebeuren.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d5bd1e4-7d30-4542-aa46-56ef5df594b7",
                        "source_entry_id": "40893567-2308-3d2b-b122-2b1596d37b79",
                        "source_sense_id": "10653ba6-aa91-3c8d-8a6f-42eb753d9df1",
                        "source_sense_description": "verhaaltje dat lelijke dingen mooier doet lijken",
                        "target_lang_word": "flattery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flattery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04c62ca2-d196-3249-a5ae-3c3447923f27",
                                        "entry_id": "c93c72a2-d0c5-30f3-be86-06d0653e1695",
                                        "glosses": [
                                            "Excessive praise or approval, which is often insincere and sometimes contrived to win favour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a8d1bc1-5cc1-41da-b2ec-d297228e1676",
                                                "sense_id": "04c62ca2-d196-3249-a5ae-3c3447923f27",
                                                "text": "Don't you know that some of his contributions here are pure flattery?"
                                            },
                                            {
                                                "example_id": "84e28d5a-21b2-41f9-8bff-62436510b88b",
                                                "sense_id": "04c62ca2-d196-3249-a5ae-3c3447923f27",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d3e345-0dfa-343c-b973-8fbc2e092440",
                                        "entry_id": "c93c72a2-d0c5-30f3-be86-06d0653e1695",
                                        "glosses": [
                                            "An instance of excessive praise."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17822322-58a9-49da-8d1a-5e2a10403806",
                                                "sense_id": "c5d3e345-0dfa-343c-b973-8fbc2e092440",
                                                "text": "But I pitty the flatteries, and ſelfe-applauſes of a careleſſe and impenitent heart: This jollity hath in it much danger, and vvithout ſome change, death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
