                "senses": [
                    {
                        "sense_id": "077605ef-e32a-3a72-9888-51ae2ced1e50",
                        "entry_id": "17847d03-f96a-38bc-8e0d-b9f7f0003980",
                        "glosses": [
                            "erforderliche Menge an Futter, damit ein Tier am Leben erhalten werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc34344-edf2-43f7-9453-29ce975afeb7",
                                "sense_id": "077605ef-e32a-3a72-9888-51ae2ced1e50",
                                "text": "„Um nun den Schaden an den Forstpflanzen weitestgehend zu vermeiden, versuchen wir, mit strukturreichem Erhaltungsfutter das Wild abzulenken und den Hunger zu stillen.“"
                            },
                            {
                                "example_id": "ab2c8f9f-8cb9-46d6-8183-b8415e3520b3",
                                "sense_id": "077605ef-e32a-3a72-9888-51ae2ced1e50",
                                "text": "„Wenn man weiß, dass ein Reh durchschnittlich zirka 600 g Erhaltungsfutter pro Tag benötigt, um über den Winter zu kommen, zudem bei geschlossener Schneedecke und Minus-Temperaturen keine artgerechte Futtervorlage erhält, so werden die not- wendigen Nähr- und Rohfaserstoffe eben von den aus der Schneedecke ragenden Pflanzen verbissen, gegebenenfalls geschält (Rotwild).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
