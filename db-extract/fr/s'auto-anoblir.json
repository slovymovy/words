                "senses": [
                    {
                        "sense_id": "6d5e4e18-5753-35a7-84cb-1950115e6b73",
                        "entry_id": "29c0137b-6e3c-3df8-8dab-9a6c6d40ff8f",
                        "glosses": [
                            "S’anoblir soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ee4530-8b03-46ad-9eae-6f08198370da",
                                "sense_id": "6d5e4e18-5753-35a7-84cb-1950115e6b73",
                                "text": "Comment ne pas songer à l'imprimerie de Balzac qui s'est auto-anobli en tant qu'imprimeur?"
                            },
                            {
                                "example_id": "79ee217c-d8ca-40eb-b910-a6153126d1a0",
                                "sense_id": "6d5e4e18-5753-35a7-84cb-1950115e6b73",
                                "text": "Mais rien ne me paraît donner une telle impression de tranchant, de ricanement sans retour et de désaveu définitif de son propre monde, que la prose insolemment valorisée en poésies d'Isidore Ducasse, lui-même auto-anobli, avec quelle ironie, en comte de Lautréamont."
                            }
                        ]
                    }
                ],
