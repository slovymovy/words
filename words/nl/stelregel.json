            "senses": [
                {
                    "sense_id": "8e8ae308-9344-3e32-b97d-41d4e2ff1b10",
                    "sense_definition": "Een vaste gedragsregel of richtsnoer die men als leidraad aanhoudt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn belangrijkste <w>stelregel</w> was om altijd eerlijk te blijven tegenover zijn klanten.",
                            "target_lang_translations": {
                                "de": "Seine wichtigste <w>Maxime</w> war es, gegenüber seinen Kunden immer ehrlich zu bleiben."
                            }
                        },
                        {
                            "text": "In dit bedrijf hanteren we een duidelijke <w>stelregel</w> voor communicatie met de pers.",
                            "target_lang_translations": {
                                "de": "In diesem Unternehmen wenden wir einen klaren <w>Grundsatz</w> für die Kommunikation mit der Presse an."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginsel",
                        "principe"
                    ],
                    "common_phrases": [
                        "een vaste stelregel",
                        "als stelregel gelden"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine feste Verhaltensregel oder Richtschnur, an der man sich orientiert."
                    },
                    "translations": {
                        "de": [
                            {
