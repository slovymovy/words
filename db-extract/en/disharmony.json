                    {
                        "translation_id": "8eb72b93-9934-4bf8-9e1b-1c43c9f4f21d",
                        "source_entry_id": "2cb1569b-8bc8-33f0-b960-0be2f1b63c87",
                        "source_sense_id": "f420dad6-a1fc-3811-a60b-f78e0c1e1d51",
                        "source_sense_description": "the absence of harmony",
                        "target_lang_word": "désaccord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désaccord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9475ed-6789-3dc1-9285-744d13ee54dd",
                                        "entry_id": "7bb6e11f-6b8c-357d-abd3-9596156d2c53",
                                        "glosses": [
                                            "Le fait de n’être pas d’accord, en parlant des personnes et des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2beacf-9624-4785-8dfb-020cb89be530",
                                                "sense_id": "5b9475ed-6789-3dc1-9285-744d13ee54dd",
                                                "text": "Ainsi, comme il arrive très-souvent, l’homme est en désaccord complet avec les produits de sa pensée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b0ed4c-0c5e-362a-b403-aa58293f65d4",
                                        "entry_id": "7bb6e11f-6b8c-357d-abd3-9596156d2c53",
                                        "glosses": [
                                            "Manque d'accord dans le son rendu par des instruments de musique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3aeea913-ef72-4a63-8825-78908be633b7",
                        "source_entry_id": "2cb1569b-8bc8-33f0-b960-0be2f1b63c87",
                        "source_sense_id": "f420dad6-a1fc-3811-a60b-f78e0c1e1d51",
                        "source_sense_description": "the absence of harmony",
                        "target_lang_word": "Disharmonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Disharmonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8837d94-9302-3331-98dd-32e8bc234647",
                                        "entry_id": "edcf4585-3a23-388f-ba3c-457a32d34b3f",
                                        "glosses": [
                                            "Zustand, in dem etwas nicht harmonisch ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "409b0006-6d0d-43cd-be89-488876743dd4",
                                                "sense_id": "e8837d94-9302-3331-98dd-32e8bc234647",
                                                "text": "„Er findet bei über der Hälfte der untersuchten Projekte mehr oder weniger ausgeprägte Disharmonien - und konnte zudem deren negative Auswirkungen auf den Projekterfolg nachweisen.“"
                                            },
                                            {
                                                "example_id": "22cedbd6-fa4e-4795-bf39-c0184efa49d3",
                                                "sense_id": "e8837d94-9302-3331-98dd-32e8bc234647",
                                                "text": "„Und sie hinterließ eine unangenehme Form von Disharmonie im Raum, die ihm sofort bewusst wurde und daher ein unangenehmes Gefühl in ihm hervorrief.“"
                                            },
                                            {
                                                "example_id": "405a6277-ab97-4656-ab18-b4400116d688",
                                                "sense_id": "e8837d94-9302-3331-98dd-32e8bc234647",
                                                "text": "„Ich saß da neben Marie und rauchte vor Aufregung, durch die Disharmonien im Hintergrund vollkommen aus dem Gleichgewicht gebracht, eine Zigarette nach der anderen, während Sommerwild mit Marie plauderte, immer dieses ›verzeihende und großzügige Lächeln‹ auf dem Gesicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5307b781-55a4-3773-97e3-4bfae304fae7",
                                        "entry_id": "edcf4585-3a23-388f-ba3c-457a32d34b3f",
                                        "glosses": [
                                            "Zusammenklang von Tönen, die nicht miteinander harmonieren"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f95ab70-f4c6-4400-9723-92414c5003ca",
                                                "sense_id": "5307b781-55a4-3773-97e3-4bfae304fae7",
                                                "text": "„In der klassischen Musik gibt es eine Richtung, die als Zwölf-Ton-Musik bezeichnet wird. In dieser Richtung sind die üblichen Kompositionsregeln, die eben bestimmte Harmonien vorschreiben, geändert und Disharmonien sind durchaus erlaubt und sogar gewünscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
