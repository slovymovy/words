                    },
                    {
                        "translation_id": "cde2ddfa-6d95-49f3-a505-0eb2ed974637",
                        "source_entry_id": "8dc2edd4-653b-32b8-9258-4306571dcc5f",
                        "source_sense_id": "f1001077-a773-3857-9a7a-19ab6d16c155",
                        "source_sense_description": "anyone that has control over another human being",
                        "target_lang_word": "esclavagiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esclavagiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3111444-286f-3716-b6bc-317aef3498f2",
                                        "entry_id": "210172d2-f8e9-31dd-a97b-673b7e2e1b7f",
                                        "glosses": [
                                            "Qui veut maintenir l’esclavage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a430dc39-df25-4ad4-9ffc-1caa2d3ccf40",
                                                "sense_id": "e3111444-286f-3716-b6bc-317aef3498f2",
                                                "text": "Lors d'un discours devant une foule galvanisée, il avait brûlé des livres de charia pour protester contre l'interprétation esclavagiste de la religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe0991a-a6eb-3ed7-b493-f868f89b6945",
                                        "entry_id": "210172d2-f8e9-31dd-a97b-673b7e2e1b7f",
                                        "glosses": [
                                            "Qui fait la traite des esclaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02a7a5d6-4fef-44c4-91f5-9868541ff8f0",
                                                "sense_id": "dbe0991a-a6eb-3ed7-b493-f868f89b6945",
                                                "text": "Au milieu du XIXe siècle, à part les États-Unis, il ne reste que trois nations esclavagistes dans le monde occidental : les Pays-Bas aux Indes néerlandaises, l’Espagne qui maintient sa souveraineté à Cuba et à Porto-Rico, et le Brésil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82f7dc93-f567-303e-a6d2-2716dcb0b510",
                                        "entry_id": "210172d2-f8e9-31dd-a97b-673b7e2e1b7f",
                                        "glosses": [
                                            "Qui traite les travailleurs comme des esclaves."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e3cc5bc-b060-4f29-92a9-794055562847",
                                                "sense_id": "82f7dc93-f567-303e-a6d2-2716dcb0b510",
                                                "text": "Le cas de la société tibétaine d’avant 1950 illustre de façon tragique les lacunes d’une idéologie dogmatique bouddhiste gérée par de faillibles humains. Elle a conduit à une société féodale esclavagiste basée sur l’oppression de presque toute la population par les hiérarchies religieuse et aristocratique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esclavagiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62e8621a-61a3-3aa3-85f6-9b8c27fb6427",
                                        "entry_id": "58466bc5-30d3-3b92-9131-df6a8c39cec6",
                                        "glosses": [
                                            "Partisan de l’esclavagisme, qui veut maintenir l’esclavage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a11745-a3aa-4006-ab9d-227c41a3ad57",
                                                "sense_id": "62e8621a-61a3-3aa3-85f6-9b8c27fb6427",
                                                "text": "Mais ce planteur de Guadeloupe était un fervent esclavagiste et a une plaque au Panthéon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b4acf4-82b7-32f9-817a-16202564d096",
                                        "entry_id": "58466bc5-30d3-3b92-9131-df6a8c39cec6",
                                        "glosses": [
                                            "Personne qui fait la traite des esclaves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
