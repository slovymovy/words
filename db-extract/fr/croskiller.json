                        "glosses": [
                            "Passer au croskill (brise-mottes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfca074f-d0c2-4c62-a192-97d2d2920fe0",
                                "sense_id": "2b05b708-4211-32de-b84a-2af20952ff44",
                                "text": "Aussi est-il souvent utile de croskiller les terres labourées très tardivement ou d’y faire passer un troupeau de bêtes à laine."
                            },
                            {
                                "example_id": "3c3e8a62-e849-499c-9ea5-722e527395a0",
                                "sense_id": "2b05b708-4211-32de-b84a-2af20952ff44",
                                "text": "M. Heuzé a été d’avis qu’on peut encore semer des blés de Bordeaux, et qu’il faut croskiller le plus tôt possible les blés qui ont résisté à la gelée."
                            }
                        ]
                    }
