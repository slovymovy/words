                                        "sense_id": "b6b71e6e-7e62-3ece-8032-696af3d0c787",
                                        "entry_id": "b1bf254f-57da-3f88-927f-03422e4b210a",
                                        "glosses": [
                                            "onvoltooid deelwoord van bestaan"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba54dee4-eeca-43f3-82c7-07a1068b317b",
                                                "sense_id": "b6b71e6e-7e62-3ece-8032-696af3d0c787",
                                                "text": "Het is een pas enkele maanden bestaand bedrijf."
                                            },
                                            {
                                                "example_id": "7ba17e34-2d9a-42fb-aed4-1949e5450d16",
                                                "sense_id": "b6b71e6e-7e62-3ece-8032-696af3d0c787",
                                                "text": "Abstracte werken, veelal bestaand uit horizontale en verticale lijnen, zijn kenmerkend voor zijn werk."
                                            },
                                            {
                                                "example_id": "e55504ee-b570-4be1-9445-45b51e52dbad",
                                                "sense_id": "b6b71e6e-7e62-3ece-8032-696af3d0c787",
                                                "text": "Ik bestelde een lunch bestaande uit vier dikke pannenkoeken, rijkelijk belegd met boter en ahornsiroop."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bestaand",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b20d74c7-1247-366b-ae77-d7b38a58e039",
                                        "entry_id": "59f139e0-6707-3cb5-9123-343df771abd4",
                                        "glosses": [
                                            "deel uitmakend van de werkelijkheid, feitelijk functionerend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fcd0ed9-743a-49ec-a05d-49f315af7798",
                                                "sense_id": "b20d74c7-1247-366b-ae77-d7b38a58e039",
                                                "text": "Het is een bestaand winkelcentrum dat herontwikkeld wordt."
                                            },
                                            {
                                                "example_id": "e1b53e81-99e5-4571-a02b-1c97eba3b236",
                                                "sense_id": "b20d74c7-1247-366b-ae77-d7b38a58e039",
                                                "text": "Zowel bestaande als startende ondernemers worden uitgenodigd."
                                            },
                                            {
                                                "example_id": "6da5ecf5-7712-4d62-a490-9a3982c3813f",
                                                "sense_id": "b20d74c7-1247-366b-ae77-d7b38a58e039",
                                                "text": "Daarom gaat de gemeente bestaande maatregelen verstevigen. Zo gaat ze inwoners en horecaondernemers beter informeren over hoe ze afval het beste kunnen opruimen en komen er meer afvalbakken. Ook geeft de gemeente woningcorporaties en bewoners advies over kieren en gaten in huizen, en hoe deze gedicht kunnen worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
