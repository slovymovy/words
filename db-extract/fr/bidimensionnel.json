                        "entry_id": "be11e4a6-b487-3bb6-8614-e493ae503e10",
                        "glosses": [
                            "Relatif aux deux dimensions du plan géométrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953ac1d8-3bc0-4333-9462-79c65d5a6768",
                                "sense_id": "0f763a42-aeb4-30eb-9c9c-91a9ca2a33ef",
                                "text": "Un modèle bidimensionnel."
                            }
                        ]
                    },
                    {
                        "sense_id": "23bafb9b-9ac5-323c-9bad-45dee65c700b",
                        "entry_id": "be11e4a6-b487-3bb6-8614-e493ae503e10",
                        "glosses": [
                            "Qui a deux possibilités."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9513c74b-6db8-4796-97c1-2d3b0068e15f",
                                "sense_id": "23bafb9b-9ac5-323c-9bad-45dee65c700b",
                                "text": "Car que deviendraient alors l’héroïque mentalité d'assiégés et son effet domestique stabilisateur, ainsi que l'obligation pour tous les citoyens de protéger la patrie et de maintenir en vie l'idéologie bidimensionnelle : qui n'est pas avec moi est contre moi ?"
                            }
                        ]
                    }
                ],
