                "senses": [
                    {
                        "sense_id": "1218fa43-d415-330c-8ace-22bb2812aa13",
                        "entry_id": "a8efb33a-fbb6-34a6-ba0d-778fc92593f9",
                        "glosses": [
                            "Geistliche, die sich um Lebens- und Glaubensfragen ihrer Gemeindemitglieder kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40fd03d-cf54-4fed-b863-d9d809196bc0",
                                "sense_id": "1218fa43-d415-330c-8ace-22bb2812aa13",
                                "text": "Die Seelsorgerin besucht Frau Müller auf der Palliativstation des Allgemeinkrankenhauses."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "caede248-2ce3-3338-8f0a-59844c3966d5",
                        "entry_id": "a8efb33a-fbb6-34a6-ba0d-778fc92593f9",
                        "glosses": [
                            "weibliche Person, die Beistand für das seelische Wohlbefinden unabhängig von religiösen Bezügen leistet"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fb42120f-bda0-4c83-a83c-afd4806bcd5a",
                                "sense_id": "caede248-2ce3-3338-8f0a-59844c3966d5",
                                "text": "„Die Humanistikerin und humanistische Seelsorgerin Anke Lauke wagte methodisch den Versuch, einen zentralen Aspekt humanistischer Seelsorge und Lebensbegleitung leibhaftig erfahrbar zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
