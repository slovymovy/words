                                                "sense_id": "47efe375-c66f-35be-ac16-215c0481fcc2",
                                                "text": "Rozhodnutí třineckých radních bylo jednohlasné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
