                "senses": [
                    {
                        "sense_id": "db60095d-339c-39ec-9ab9-739d223cfd5e",
                        "entry_id": "f176049f-e450-3ff1-b607-689691d69a41",
                        "glosses": [
                            "Réduction d’un solide en poudre ou d’une poudre en une poudre plus fine encore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "973e2168-87f1-4226-a344-9bcb65c22402",
                                "sense_id": "db60095d-339c-39ec-9ab9-739d223cfd5e",
                                "text": "Le broyage des fourrages grossiers a fait l’objet d’une analyse critique de Oreenhalgh et Wainman en 1972."
                            },
                            {
                                "example_id": "3eba9c41-613a-4eca-a5d7-596f04a035a4",
                                "sense_id": "db60095d-339c-39ec-9ab9-739d223cfd5e",
                                "text": "La plupart des oiseaux ne peuvent pas mastiquer leur nourriture et le gésier renferme des gastrolithes (des petits cailloux ingérés, les pierres du gésier, du gravier) responsables du broyage de ce qui est ingéré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82ffc411-98ff-442b-9d01-505e01be9d9a",
                        "source_entry_id": "f176049f-e450-3ff1-b607-689691d69a41",
                        "source_sense_id": "db60095d-339c-39ec-9ab9-739d223cfd5e",
                        "target_lang_word": "grinding",
                        "target_lang_code": "en",
