                        "form": "das Meme"
                    },
                    {
                        "form_id": "8b1c9d04-5270-4d19-bd56-39e643705af8",
                        "entry_id": "d04575ea-084c-3315-a66a-c6da5f9f7524",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Memes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79c6a7f4-ac1b-3fa2-98f1-09f7e0624a1e",
                        "entry_id": "d04575ea-084c-3315-a66a-c6da5f9f7524",
                        "glosses": [
                            "Botschaft (Text, Bild, Video), die (mit Variationen) via Internet in Umlauf kommt und schnell allseits bekannt wird"
                        ],
                        "tags": [
                            "Medien",
                            "Netzkultur"
                        ],
                        "examples": [
                            {
                                "example_id": "3587e701-390e-4b6e-88a1-995e8ca31820",
                                "sense_id": "79c6a7f4-ac1b-3fa2-98f1-09f7e0624a1e",
                                "text": "„Die Bildplattform Imgur hat ihre Mitglieder nun dazu aufgerufen, das Meme des Jahrzehnts zu wählen.“"
                            },
                            {
                                "example_id": "e0061922-c83f-4d81-bc78-65b195381a1a",
                                "sense_id": "79c6a7f4-ac1b-3fa2-98f1-09f7e0624a1e",
                                "text": "„Filme und TV-Serien, Rock, Rap und Dancepop, die kreative Zitierkultur des Internets (Mashups, Meme und Co.) werden nicht für eine edle Elite, sondern für eine demokratische Massengesellschaft geschaffen.“"
                            },
                            {
                                "example_id": "1be66e3b-5d77-4038-a82e-c79778d5e930",
                                "sense_id": "79c6a7f4-ac1b-3fa2-98f1-09f7e0624a1e",
                                "text": "„Die Kinderbuchfigur Conni ist eine beliebte Vorlage für Memes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22014d40-0bb8-4c4c-adfd-8d599539987d",
                        "source_entry_id": "d04575ea-084c-3315-a66a-c6da5f9f7524",
                        "source_sense_id": "79c6a7f4-ac1b-3fa2-98f1-09f7e0624a1e",
                        "source_sense_description": "Botschaft, die via Internet in Umlauf kommt und schnell allseits bekannt wird",
                        "target_lang_word": "meme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a02939df-99f7-33af-b323-1529a919ef46",
                                        "entry_id": "b49a11b5-c6e0-3ab7-b563-e15142111db7",
                                        "glosses": [
                                            "Any unit of (originally cultural) information, such as a practice or idea, that is transmitted verbally or by repeated action from one mind to another in a comparable way to the transmission of genes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c1d10c-0ab9-4fe9-9066-ca351806cd9b",
                                                "sense_id": "a02939df-99f7-33af-b323-1529a919ef46",
                                                "text": "Examples of memes are tunes, ideas, catch-phrases, clothes fashions, ways of making pots or of building arches."
                                            },
                                            {
                                                "example_id": "5324be30-3dc7-453f-99c7-3235817cfd98",
                                                "sense_id": "a02939df-99f7-33af-b323-1529a919ef46",
                                                "text": "For most of the population, the media system is, I think, a different one. It's not just the case that it tries to entertain them. It tries to entertain them through memes, which will intensify attitudes that support the interests of elites."
                                            },
                                            {
                                                "example_id": "0e3f567a-f144-4fbf-8bd1-872486a48e00",
                                                "sense_id": "a02939df-99f7-33af-b323-1529a919ef46",
                                                "text": "Related memes tend to form mutually supporting meme-complexes such as religions, political ideologies, scientific theories, and New Age dogmas."
                                            },
                                            {
                                                "example_id": "21fe70c8-5c1b-4b8e-9bfc-88243f1f2675",
                                                "sense_id": "a02939df-99f7-33af-b323-1529a919ef46",
                                                "text": "The original Hobson and Jobson stock comic characters have died out as a meme, as has the application of their names to the Muharram in India."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                        "entry_id": "b49a11b5-c6e0-3ab7-b563-e15142111db7",
                                        "glosses": [
                                            "Media, usually humorous, which is copied and circulated online with slight adaptations, such as basic pictures, video templates, etc."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7897f2b9-4e64-4720-b6cc-37bbb45a4550",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "He posted a meme that went viral within a few hours on social media."
                                            },
                                            {
                                                "example_id": "df45c502-14e0-4f26-a3aa-b65ab9b4089c",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "He stuck memes on the wall to campaign for the position of President."
                                            },
                                            {
                                                "example_id": "b968b009-e0e9-462f-8a7c-70a8030762f8",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "Not everyone saw the comparison to Nazis as a \"meme\" - most people on the Net, as elsewhere, had never heard of \"memes\" or \"memetics.\" But now that we're living in an increasingly information-aware culture, it's time for that to change."
                                            },
                                            {
                                                "example_id": "4b754ef0-f223-4fd1-be92-4a66a15a9af7",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "I do...but my journal is a mess. It's mostly filled with memes and my bitching about a house I am building."
                                            },
                                            {
                                                "example_id": "b5614a61-8e57-437b-bd13-143ebc8073f2",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "The idea was to append Keyboard Cat to the end of a blooper video to \"play\" that person offstage after a mistake or gaffe, like getting the hook in the days of vaudeville. The meme became popular, Ashton Kutcher tweeted about it to more than 1 million followers, and more than 4,000 such videos have now been made."
                                            },
                                            {
                                                "example_id": "36c4f01c-5875-4d9c-bbcd-32d327fa0c60",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "Harlem Shake meme: the new Gangnam Style? [headline]"
                                            },
                                            {
                                                "example_id": "f869bd0b-95c7-47b6-bbce-f11f56f11e32",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "Social networks produce inside jokes at a relentless pace. The best, worst, stupidest and funniest of those jokes become memes, and either you get them or you don’t."
                                            },
                                            {
                                                "example_id": "06df659a-1f0e-4550-b976-7a220e7bc409",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "Haha, memes are funny! Until they totally become racist. Pepe the Frog lived a very normal meme life right up until online trolls turned him into a green thing of hate in 2016. It got so bad his creator symbolically killed him off in 2017."
                                            },
                                            {
                                                "example_id": "7ecf901c-94b7-42e9-9278-43de3b345071",
                                                "sense_id": "d018870a-ac6e-33de-8334-a1c724da6052",
                                                "text": "He said that NFT sales had helped establish memes as a sophisticated art form and “serious pieces of culture.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed2598f2-83e9-3be8-a1e1-f09e11e88805",
                                        "entry_id": "b49a11b5-c6e0-3ab7-b563-e15142111db7",
                                        "glosses": [
                                            "A specific instance of a meme, such as an image macro or a video, often with humorous superimposed text."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7713b257-271f-4a77-9c12-a7d76c9acdd2",
                                                "sense_id": "ed2598f2-83e9-3be8-a1e1-f09e11e88805",
                                                "text": "This meme generator lets you make your own memes by adding a caption to existing images, or by uploading your own image."
                                            },
                                            {
                                                "example_id": "61a937b9-be04-4fcd-a4ce-a03a4e28348d",
                                                "sense_id": "ed2598f2-83e9-3be8-a1e1-f09e11e88805",
                                                "text": "I'm always posting memes on the groupchat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68d8f174-167d-31da-b1b1-61ef298f2cb5",
                                        "entry_id": "b49a11b5-c6e0-3ab7-b563-e15142111db7",
                                        "glosses": [
                                            "Something which is deceptive; a trick, a ruse."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34e9c94-93aa-440b-861c-101cb15b2e29",
                                                "sense_id": "68d8f174-167d-31da-b1b1-61ef298f2cb5",
                                                "text": "It's a meme degree, you know. Good luck getting a job from that."
                                            },
                                            {
                                                "example_id": "9132b051-6fe6-4c2c-a1f9-0a4483fefd21",
                                                "sense_id": "68d8f174-167d-31da-b1b1-61ef298f2cb5",
                                                "text": "I can't believe I fell for the bulking meme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf820f2-6acf-335f-9c57-57a6df364227",
                                        "entry_id": "b49a11b5-c6e0-3ab7-b563-e15142111db7",
                                        "glosses": [
                                            "Something not to be taken seriously; a joke."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cae0c94-df7a-4503-9ff7-fb7184edfd5d",
                                                "sense_id": "adf820f2-6acf-335f-9c57-57a6df364227",
                                                "text": "It's a meme degree, you know. Good luck getting a job from that."
                                            },
                                            {
                                                "example_id": "313e00fc-2691-47c8-a24c-90336dffcd97",
                                                "sense_id": "adf820f2-6acf-335f-9c57-57a6df364227",
                                                "text": "Jogging is a meme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16558c35-6de7-31bb-8095-6fc596aa45e7",
                                        "entry_id": "b49a11b5-c6e0-3ab7-b563-e15142111db7",
                                        "glosses": [
                                            "A work produced and shared in response to a prompt or suggestion within an online group."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb036eb-70ac-4e19-9553-de520b77261c",
                                                "sense_id": "16558c35-6de7-31bb-8095-6fc596aa45e7",
                                                "text": "kink meme"
                                            },
                                            {
                                                "example_id": "96f312df-686c-4129-ad6a-44ec714f7123",
                                                "sense_id": "16558c35-6de7-31bb-8095-6fc596aa45e7",
                                                "text": "anon meme"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9e85fe1-04f5-3f84-bcd0-089123327d19",
                                        "entry_id": "c2a3382a-4069-3035-b7e1-91b5d8584c7c",
                                        "glosses": [
                                            "To create and use humorous memes."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2392f3-ff2a-4f6a-8c0c-ad3cf99b749d",
                                                "sense_id": "d9e85fe1-04f5-3f84-bcd0-089123327d19",
                                                "text": "One axiom commonly seen on /pol/ is \"The Left Can't Meme\"; in other words, left-wing meme jokes aren't funny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e1e954d-d665-3255-8f35-5084fd5c2099",
                                        "entry_id": "c2a3382a-4069-3035-b7e1-91b5d8584c7c",
                                        "glosses": [
                                            "To turn into a meme; to use a meme, especially to achieve a goal in real life."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c5a9e6-f039-4a5d-b504-223e7f16d22e",
                                                "sense_id": "2e1e954d-d665-3255-8f35-5084fd5c2099",
                                                "text": "Scott Greer, a deputy editor of the Daily Caller, tweeted, “Cernovich memed #SickHillary into reality. Never doubt the power of memes.”"
                                            },
                                            {
                                                "example_id": "e804316c-2b87-44bc-b065-2083e9847cbe",
                                                "sense_id": "2e1e954d-d665-3255-8f35-5084fd5c2099",
                                                "text": "David Moyes succeeding Slaven Bilić as West Ham United manager is being memed into existence by the internet, Football Burp understands."
                                            },
                                            {
                                                "example_id": "509cd363-bccd-4937-ac34-a077ae6f02b7",
                                                "sense_id": "2e1e954d-d665-3255-8f35-5084fd5c2099",
                                                "text": "“Succession’s language is so specific, unique and captivating that nearly every line is worthy of being ‘memed’, even if it’s just somebody saying ‘fuck off’ or ‘bad tweet!’” she says."
                                            },
                                            {
                                                "example_id": "860e174c-552a-486d-907e-577582ae7483",
                                                "sense_id": "2e1e954d-d665-3255-8f35-5084fd5c2099",
                                                "text": "In my experience the films that typically get memed are either really terrible (Madame Web), so huge that they’re everywhere (Barbie), or have a cast stacked with familiar faces so the memes cast a wide net for potential sharing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b55c749-14ff-3005-9d2d-4893c5d6d91b",
                                        "entry_id": "c2a3382a-4069-3035-b7e1-91b5d8584c7c",
                                        "glosses": [
                                            "To joke around."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3699b0a-2c4d-46c1-b3f5-8dee7cbda437",
                                                "sense_id": "3b55c749-14ff-3005-9d2d-4893c5d6d91b",
                                                "text": "actually, it wasn't my mental functioning. i'm just meming."
                                            },
                                            {
                                                "example_id": "c87c32f7-434c-4d02-b0ac-2aecb6258407",
                                                "sense_id": "3b55c749-14ff-3005-9d2d-4893c5d6d91b",
                                                "text": "“[P]ewdiepie is, once again, doing exactly what neo-nazis want,” Kotaku reporter Nathan Grayson commented on Twitter in response to the incident. “[W]hether he’s just meming or he ascribes to these values, it doesn’t matter. [W]hat matters is that he normalizes these ideas as jokes on THE platform where kids increasingly get their first exposure to the world at large.”"
                                            },
                                            {
                                                "example_id": "e8bdf08e-f82b-44b6-b5a4-242112a737f5",
                                                "sense_id": "3b55c749-14ff-3005-9d2d-4893c5d6d91b",
                                                "text": "Some of his fellow fascists thought he was just “meming and pranking”; others dismissed it as “some autistic phase.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb79bdc-79ce-3bd8-a9c7-e77e1da8bef2",
                                        "entry_id": "285d34e3-5713-3881-81fb-cce8cdc173c0",
                                        "glosses": [
                                            "granny; nana"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2870c57-74a8-4747-b572-2eaca79d0385",
                                                "sense_id": "5eb79bdc-79ce-3bd8-a9c7-e77e1da8bef2",
                                                "text": "When my parents got a divorce my dad washed his hands of my mom and me. He just pretended neither she nor I existed. If it weren't for my Meme, I would have lost all contact with the Atwood family after the divorce."
                                            },
                                            {
                                                "example_id": "157e88b6-dd6b-4641-a35b-0a3dc12ee7f1",
                                                "sense_id": "5eb79bdc-79ce-3bd8-a9c7-e77e1da8bef2",
                                                "text": "Then there was my Meme, my father's mother. She was one of the most wonderful, loving, craziest, funniest people I ever had in my life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
