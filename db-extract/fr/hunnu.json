                        "entry_id": "b6016003-433d-3093-b5d9-929b015ea889",
                        "glosses": [
                            "Relatif aux Hunnus, aussi appelé Xiongnus, peuples nomades vivant en Mongolie, en Transbaïkalie et en Chine du Nord du IIIᵉ au IIᵉ av. J.-C.."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4de3fb0d-f6cb-44d1-ac42-29498d9880af",
                                "sense_id": "90327dfb-5a87-3e8c-ad39-44c8176ce7b7",
                                "text": "Le type et le style de mobilier archéologique, ainsi que des datations au carbone 14, permettent d’attribuer le site de Boroo Gol à la civilisation xiongnue (ou hunnue)."
                            }
                        ]
                    }
