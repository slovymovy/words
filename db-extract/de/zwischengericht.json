                            "Speise, die zwischen zwei Gängen/Hauptgängen serviert/eingenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0596c8ab-3281-429b-a828-2eb40afd3222",
                                "sense_id": "b19ff7b8-0a65-364f-9664-61bbcb2418ae",
                                "text": "Als Zwischengericht wurde eine marinierte Jakobsmuschel serviert."
                            },
                            {
                                "example_id": "74d3c088-1d75-4ba8-b5bc-c75c80f37979",
                                "sense_id": "b19ff7b8-0a65-364f-9664-61bbcb2418ae",
                                "text": "„Als ich das Zwischengericht reintrug, war das Gelächter vorbei, das große Mädchen unterhielt sich mit dem Vater, und der kleine Dickwanst war der einzige, der mich anguckte.“"
                            }
                        ],
