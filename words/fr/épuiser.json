    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cffc0b09-cca8-3e58-a0ca-4781b931c4d1",
                    "sense_definition": "Fatiguer excessivement quelqu'un, consumer toutes ses forces physiques ou morales.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fatiguer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce long voyage en montagne a fini par <w>épuiser</w> les randonneurs les plus expérimentés."
                        },
                        {
                            "text": "Elle travaille sans relâche et risque d'<w>épuiser</w> ses forces avant la fin de la semaine."
                        }
                    ],
                    "common_phrases": [
                        "épuiser ses forces",
                        "s'épuiser à la tâche"
                    ]
                },
                {
                    "sense_id": "77cf3412-c867-3404-8a25-27b759ac430a",
                    "sense_definition": "Consommer ou dépenser entièrement une réserve, un stock ou des ressources de manière à ne rien laisser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ressources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La forte demande pendant les soldes a rapidement fait <w>épuiser</w> les stocks du magasin."
                        },
                        {
                            "text": "L'entreprise a continué d'<w>épuiser</w> ses réserves financières pour payer ses employés."
                        }
                    ],
                    "common_phrases": [
                        "épuiser les stocks",
                        "épuiser ses ressources"
                    ]
                },
                {
                    "sense_id": "e8ede3e2-34ba-3ef4-a23b-66367328eda8",
                    "sense_definition": "Traiter un sujet sous tous ses aspects, examiner complètement une question sans rien omettre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "examiner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons longuement débattu mais il est impossible d'<w>épuiser</w> un sujet aussi vaste en une heure."
                        },
                        {
                            "text": "Le conférencier a cherché à <w>épuiser</w> la question avant de donner la parole au public."
                        }
                    ],
                    "common_phrases": [
                        "épuiser le sujet",
                        "épuiser la question"
                    ]
                },
                {
                    "sense_id": "83755679-e24a-3832-8ce9-801720adeeb9",
                    "sense_definition": "Vider entièrement un réservoir, un puits ou une source d'eau en puisant, mettre à sec.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont utilisé une pompe spéciale pour <w>épuiser</w> l'eau accumulée dans la cave."
                        },
                        {
                            "text": "Une utilisation excessive a fini par <w>épuiser</w> la source qui alimentait tout le village."
                        }
                    ],
                    "synonyms": [
                        "tarir"
                    ],
                    "common_phrases": [
                        "épuiser un puits",
                        "épuiser une source"
                    ]
                }
            ]
        }
    ]
