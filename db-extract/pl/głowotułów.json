                "senses": [
                    {
                        "sense_id": "c412caa3-08db-3ce0-a010-fddd56afcd43",
                        "entry_id": "4de686aa-697f-35f0-a5fe-cb750739fb10",
                        "glosses": [
                            "tułów zlany z głową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76546d73-c447-4959-a151-063bfed868ec",
                                "sense_id": "c412caa3-08db-3ce0-a010-fddd56afcd43",
                                "text": "Granica pomiędzy głowotułowiem a odwłokiem jest niewyraźna, co nadaje ciału owalny kształt"
                            },
                            {
                                "example_id": "c218d2f4-e908-4765-98c3-6c2b1f29def2",
                                "sense_id": "c412caa3-08db-3ce0-a010-fddd56afcd43",
                                "text": "Ma ośmioro oczu, czworo większych oczu umieszczonych jest z przodu, na szerokim głowotułowiu, a czworo mniejszych po bokach głowotułowia z tyłu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "728689a9-1f5f-4838-80b0-d1e6b0fbef6e",
                        "source_entry_id": "4de686aa-697f-35f0-a5fe-cb750739fb10",
                        "source_sense_id": "c412caa3-08db-3ce0-a010-fddd56afcd43",
                        "target_lang_word": "cephalothorax",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cephalothorax",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d429b7b-5510-3ad9-9dfa-83820441d1ed",
                                        "entry_id": "5d0bfe7c-a593-387e-a424-2e0e6006088a",
                                        "glosses": [
                                            "The fused head and thorax of spiders and crustaceans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2338853b-7f73-4d88-9cc2-9ed29667fad5",
                                                "sense_id": "0d429b7b-5510-3ad9-9dfa-83820441d1ed",
                                                "text": "\"Come in!\" says the gray spider to the house-fly; \"I have entertained a great many flies. I have plenty of room, fine meals and a gay life. [...] Philosophers have written volumes about my antennae and cephalothorax.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "411c8b65-a16d-4ded-8a93-1e6edddfa953",
                        "source_entry_id": "4de686aa-697f-35f0-a5fe-cb750739fb10",
                        "source_sense_id": "c412caa3-08db-3ce0-a010-fddd56afcd43",
                        "target_lang_word": "prosoma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
