                                                "sense_id": "47d81ebd-fdf3-324a-abe0-7d9e13e0d20a",
                                                "text": "Dieser Junge ist ein begnadeter Mittelfeldspieler."
                                            },
                                            {
                                                "example_id": "15b485cd-4ede-4115-83c3-432d3bb0c2da",
                                                "sense_id": "47d81ebd-fdf3-324a-abe0-7d9e13e0d20a",
                                                "text": "„Der zentrale Mittelfeldspieler Georgi Sarmov wechselt ablösefrei vom bulgarischen Erstligisten FK Etar Veliko Tarnovo zum CFC.“"
                                            }
                                        ],
