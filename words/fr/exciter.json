    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                    "sense_definition": "Provoquer, éveiller un sentiment, une émotion ou une vive réaction chez quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "provoquer_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette énigme non résolue ne cesse d'<w>exciter</w> la curiosité des enquêteurs."
                        },
                        {
                            "text": "Le succès soudain de son collègue a fini par <w>exciter</w> la jalousie au sein de l'équipe."
                        }
                    ],
                    "common_phrases": [
                        "exciter la curiosité",
                        "exciter la jalousie",
                        "exciter l'admiration"
                    ]
                },
                {
                    "sense_id": "d8e2bbd6-6fc9-3da4-b902-8c232e506b6b",
                    "sense_definition": "Éveiller le désir ou l'attirance sexuelle chez une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "desir_sexuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce parfum subtil et envoûtant suffit à <w>exciter</w> les sens de son partenaire."
                        },
                        {
                            "text": "La scène romantique du film a visiblement réussi à l'<w>exciter</w>."
                        }
                    ],
                    "common_phrases": [
                        "exciter les sens"
                    ]
                },
                {
                    "sense_id": "9deb36df-3dec-3545-afa4-03e46c5368df",
                    "sense_definition": "Pousser, inciter quelqu'un à agir ou à adopter un comportement particulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inciter_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribun passionné cherchait à <w>exciter</w> la foule à la révolte contre le pouvoir."
                        },
                        {
                            "text": "Ses parents l'<w>excitent</w> toujours au travail pour obtenir les meilleurs résultats scolaires."
                        }
                    ],
                    "common_phrases": [
                        "exciter à la révolte",
                        "exciter au travail"
                    ]
                },
                {
                    "sense_id": "dd7eaf55-b8db-3467-ae96-74a45910962f",
                    "sense_definition": "Stimuler l'énergie, l'activité physique ou le fonctionnement d'un organisme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stimuler_physiologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Boire trop de café en fin de journée peut facilement <w>exciter</w> le système nerveux."
                        },
                        {
                            "text": "L'entraîneur crie sur le bord du terrain pour <w>exciter</w> l'ardeur de ses joueurs."
                        }
                    ],
                    "synonyms": [
                        "stimuler"
                    ],
                    "common_phrases": [
                        "exciter les esprits"
                    ]
                }
            ]
        }
    ]
}