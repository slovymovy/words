                                                "text": ".. Я на брегу парнасских вод //Любил марать поэмы, оды .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976f18eb-49cd-3571-99b7-5cbd974dca2f",
                                        "entry_id": "da47c79d-3b37-3900-aa2a-d61f72f8605b",
