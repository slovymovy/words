{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "ee72383c-465b-3ed1-bfeb-57c4a3ce023f",
                    "sense_definition": "zaimek pytajny używany do pytania o konkretny element lub numer w grupie",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pytanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pod <w>którym</w> numerem mieszkasz?",
                            "target_lang_translations": {
                                "en": "At <w>which</w> number do you live?"
                            }
                        },
                        {
                            "text": "<w>Które</w> miejsce zajął nasz zawodnik?",
                            "target_lang_translations": {
                                "en": "<w>Which</w> place did our athlete take?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "który numer",
                        "które miejsce"
                    ],
                    "target_lang_definitions": {
                        "en": "An interrogative pronoun used to ask about a specific element or number within a group."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "Used to ask for a choice from a specific set of options."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbd8d4b2-6930-3065-b386-8e4d6ffd4d3e",
                    "sense_definition": "zaimek pytajny służący do wyboru jednego elementu z większej grupy",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pytanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Który</w> jest wasz samochód? Ten czerwony?",
                            "target_lang_translations": {
                                "en": "<w>Which</w> is your car? The red one?"
                            }
                        },
                        {
                            "text": "<w>Która</w> z tych książek należy do ciebie?",
                            "target_lang_translations": {
                                "en": "<w>Which</w> of these books belongs to you?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An interrogative pronoun used to select one item from a larger group."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "Used to identify one or more specific items from a set."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0654d7a-10c0-3bd0-802f-0f9e9ed7aa8f",
                    "sense_definition": "zaimek względny łączący zdanie podrzędne z nadrzędnym, odnoszący się do rzeczownika",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj spotkałem kolegę, <w>którego</w> nie widziałem od dawna.",
                            "target_lang_translations": {
                                "en": "Yesterday I met a friend <w>whom</w> I hadn't seen for a long time."
                            }
                        },
                        {
                            "text": "To jest Zygmunt, o <w>którym</w> tyle wam opowiadałam.",
                            "target_lang_translations": {
                                "en": "This is Zygmunt, about <w>whom</w> I told you so much."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A relative pronoun connecting a subordinate clause to a main clause, referring back to a noun."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "who",
                                "target_lang_sense_clarification": "Used when the antecedent is a person."
                            },
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "Used when the antecedent is an object or idea."
                            },
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "Used in restrictive relative clauses for people or things."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9395c8e-922a-303e-b511-c4986607d334",
                    "sense_definition": "zaimek nieokreślony oznaczający nieznaną osobę lub rzecz",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nieokreśloność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weźmie <w>który</w> ode mnie te ciężkie zakupy, czy nie?",
                            "target_lang_translations": {
                                "en": "Will <w>someone</w> take these heavy groceries from me or not?"
                            }
                        },
                        {
                            "text": "Może <w>który</w> z nich w końcu przyjdzie na spotkanie.",
                            "target_lang_translations": {
                                "en": "Maybe <w>some</w> of them will finally come to the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "któryś",
                        "ktoś"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "użycie w znaczeniu nieokreślonym jest potoczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An indefinite pronoun meaning an unknown person or thing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "someone",
                                "target_lang_sense_clarification": "Referring to an unspecified person."
                            },
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "Used to refer to an unspecified member of a group."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}