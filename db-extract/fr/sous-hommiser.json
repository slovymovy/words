                ],
                "senses": [
                    {
                        "sense_id": "2796e5dc-cf6c-3eb0-965f-e3a69b63d17a",
                        "entry_id": "04109144-9149-397b-8e55-6669f5fae0e0",
                        "glosses": [
                            "Considérer comme sous-homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff31737-9642-48ff-94db-14505eb0973c",
                                "sense_id": "2796e5dc-cf6c-3eb0-965f-e3a69b63d17a",
                                "text": "Les individus qui trouvent naturel de « sous-hommiser » leurs semblables sont nauséabonds."
                            },
                            {
                                "example_id": "e7c57529-bc33-45e9-ad65-e0493e12d608",
                                "sense_id": "2796e5dc-cf6c-3eb0-965f-e3a69b63d17a",
                                "text": "Nous qualifions de nazoïdes tout usage discriminatoire, et tenu pour “naturel” par la doxa, qui vise à choséifier, autrement dit à sous-hommiser, des catégories de personnes au seul motif que leurs performances ne sont pas conformes aux standards sociaux en vigueur."
                            },
                            {
                                "example_id": "f84d833e-0d37-43d9-b368-b48c9da83c80",
                                "sense_id": "2796e5dc-cf6c-3eb0-965f-e3a69b63d17a",
                                "text": "Dans ce pays, pourvu qu’on aie assez de tunes pour s’acheter l’impunité, on peut, sans coup férir, acculer les petites gens au suicide, racketter les invalides, choséifier ou sous-hommiser les faibles, les traiter comme des serpillières ou des sextoys."
                            }
                        ]
                    }
                ],
