                "senses": [
                    {
                        "sense_id": "909b37c1-6f1c-3cf2-ba89-3146188f1d68",
                        "entry_id": "d7424c71-f728-38af-9637-1c870e69921a",
                        "glosses": [
                            "État de ce qui est enchâssé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "392a5fd9-1b6b-44d0-aab2-648932e34832",
                                "sense_id": "909b37c1-6f1c-3cf2-ba89-3146188f1d68",
                                "text": "Cette tête est belle pourtant, beaux enchâssements d’yeux, belle forme, belle bouche."
                            }
                        ]
                    },
                    {
                        "sense_id": "388339fb-442a-3686-955f-12986b27826b",
                        "entry_id": "d7424c71-f728-38af-9637-1c870e69921a",
                        "glosses": [
                            "Représentation d'une donnée par un vecteur de nombres réels."
                        ],
                        "tags": [
                            "Intelligence artificielle"
                        ],
                        "examples": [
                            {
                                "example_id": "45969215-c178-4d7b-80b5-14c56743d390",
                                "sense_id": "388339fb-442a-3686-955f-12986b27826b",
                                "text": "L'enchâssement (embedding) consiste à représenter une image, une vidéo ou un texte par un vecteur."
                            },
                            {
                                "example_id": "a01b38d9-50d2-4a50-ad01-4997975e0df0",
                                "sense_id": "388339fb-442a-3686-955f-12986b27826b",
                                "text": "[…] l’enchâssement donne, pour chaque mot, l’ensemble des mots employés dans les mêmes contextes. Il ne décrit pas à proprement parler le sens des mots, mais il rapproche les mots de sens similaires. Ainsi, « chat » et « chien » devraient avoir des enchâssements proches, parce que souvent interchangeables alors que « chèvre » et « cigare » devraient avoir des enchâssements plus éloignés."
                            }
                        ]
                    }
                ],
