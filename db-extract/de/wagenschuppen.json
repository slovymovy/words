                        "examples": [
                            {
                                "example_id": "cf4651fc-df27-498f-9f8f-2e641dacf7fe",
                                "sense_id": "de608485-7a0c-34d6-933e-dda772eb68e3",
                                "text": "„Pierre wurde mit dreizehn anderen in die Gegend der Krim-Brücke transportiert und im Wagenschuppen eines Kaufmannshauses untergebracht.“"
                            },
                            {
                                "example_id": "bbe8104e-d63e-4575-827a-86494cefcb0b",
                                "sense_id": "de608485-7a0c-34d6-933e-dda772eb68e3",
                                "text": "„Alle Gebäude, vom Wagenschuppen angefangen bis zur Schnapsbrennerei, seien ausbesserungsbedürftig.“"
                            }
                        ],
