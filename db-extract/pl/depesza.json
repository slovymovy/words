                                        "sense_id": "f74520c1-da3a-3d78-8abe-ab79a44e65be",
                                        "entry_id": "3daa7e0b-e8b7-3246-a79e-a35a28d40b86",
                                        "glosses": [
                                            "besonders schnell übermittelter Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19200678-e6b8-4c1d-83e5-2e2ad174d1e1",
                                                "sense_id": "f74520c1-da3a-3d78-8abe-ab79a44e65be",
                                                "text": "„Ein ehemaliger Nordhäuser Schauspieler - durch eine Depesche benachrichtigt - empfing meine Kollegen in München am Bahnhof und hatte schon Zimmer für sie belegt.“"
                                            },
                                            {
                                                "example_id": "3c80f0a8-d61c-4cbf-85e2-cbf41f80c3ce",
                                                "sense_id": "f74520c1-da3a-3d78-8abe-ab79a44e65be",
                                                "text": "„Als er sein Zelt erreichte, blickte er flüchtig auf die wenigen Depeschen, die sich in seiner Abwesenheit angesammelt hatten.“"
                                            },
                                            {
                                                "example_id": "ca39b5d2-4d56-4c42-8fdb-830a3bf8801f",
                                                "sense_id": "f74520c1-da3a-3d78-8abe-ab79a44e65be",
                                                "text": "„Der Wärter bringt mir eine Depesche, ein Reichstagsabgeordneter telegraphiert, daß die Amnestie beschlossen sei.“"
                                            },
                                            {
                                                "example_id": "6d398f46-5192-4511-8222-f2e591958cf3",
                                                "sense_id": "f74520c1-da3a-3d78-8abe-ab79a44e65be",
                                                "text": "„Am denkwürdigen 13. Juli 1870 überbrachte der französische Kaiser Napoleon III. dem preußischen König die berühmte Depesche durch den französischen Botschafter Vincent Graf von Benedetti auf der Promenade in Bad Ems, wo dieser zur Kur weilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49fd6799-a8dc-4d6f-bdf5-e7a60bdbb2c2",
                        "source_entry_id": "e1905fef-4703-3412-b04d-9baa96bbe801",
                        "source_sense_id": "32e212e3-fd98-345e-a0d8-f85f24d5b515",
                        "target_lang_word": "депеша",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "депеша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b053c1ac-e823-3f87-8fc0-fc827014e28e",
                                        "entry_id": "21e9d2d4-c64d-3b09-bf19-8c1ec1338d43",
                                        "glosses": [
                                            "устар. телеграмма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1af3e62-7098-4ff2-a32f-10ae89c7d56c",
                                                "sense_id": "b053c1ac-e823-3f87-8fc0-fc827014e28e",
                                                "text": "— Наш телеграф не достигает теперь ни одной радиостанции, и наших депеш никто не слышит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "178592f9-23aa-3f7a-8520-f38a206415f5",
                                        "entry_id": "21e9d2d4-c64d-3b09-bf19-8c1ec1338d43",
                                        "glosses": [
                                            "спешное уведомление, донесение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0090a697-f60d-428a-abb3-3f6e00715e60",
                                                "sense_id": "178592f9-23aa-3f7a-8520-f38a206415f5",
                                                "text": "Особливо полученные третьего дни депеши от 23 ноября тем приятнее были, что все из них ясно увидели, какую поверхность взяли вы над рассуждениями турецкого посла."
                                            },
                                            {
                                                "example_id": "97137952-915c-4cb0-8299-0526bbb4ebcc",
                                                "sense_id": "178592f9-23aa-3f7a-8520-f38a206415f5",
                                                "text": "Произошла ошибка, и депешу передали исковерканной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
