                ],
                "senses": [
                    {
                        "sense_id": "07231820-2531-3da3-8024-85617e69bad6",
                        "entry_id": "499ac653-a738-324b-92b3-57b817e8f0ff",
                        "glosses": [
                            "woda naturalnych zbiorników o dużym stężeniu soli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5adee022-9a32-4c85-a69b-d23b0364ea36",
                                "sense_id": "07231820-2531-3da3-8024-85617e69bad6",
                                "text": "Groźne dla środowiska mogą być wypływy solanek ze złóż cechsztyńskich, położonych stosunkowo płytko pod dnem"
                            },
                            {
                                "example_id": "76e2c0dd-2648-4c98-9399-648097ec77a8",
                                "sense_id": "07231820-2531-3da3-8024-85617e69bad6",
                                "text": "W salinie produkują sól poprzez odparowanie wody z solanki morskiej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1f5b9a9c-310a-3fb3-a7e5-ea338354b872",
                        "entry_id": "499ac653-a738-324b-92b3-57b817e8f0ff",
                        "glosses": [
                            "naturalny roztwór soli, z którego pozyskuje się sól kuchenną"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "282c5ba6-f199-3122-adb8-e79600f330c0",
                        "entry_id": "499ac653-a738-324b-92b3-57b817e8f0ff",
                        "glosses": [
