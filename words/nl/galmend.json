                    "sense_id": "19d6a40d-4cd5-3f7e-bb88-19842f085afc",
                    "sense_definition": "met een luid en nagalmend geluid dat weerkaatst in de ruimte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
