                "senses": [
                    {
                        "sense_id": "06a97c02-a899-326e-9d3e-cc134d2704ba",
                        "entry_id": "8b1ba64d-49c0-3428-a46a-fddf51364c3b",
                        "glosses": [
                            "Wahrnehmung und Verarbeitung von Reizen durch die Sinnesorgane; Sehen, Hören, Riechen, Tasten und Schmecken"
                        ],
                        "tags": [
                            "Sinnesphysiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "23b4c37b-3b7d-4dd8-a015-329d75859daa",
                                "sense_id": "06a97c02-a899-326e-9d3e-cc134d2704ba",
                                "text": "Ein Tinnitus stellt eine Störung des Hörens dar und ist somit eine Störung der Sinneswahrnehmung."
                            },
                            {
                                "example_id": "673d846e-3db6-4b53-b607-b1a96aae801b",
                                "sense_id": "06a97c02-a899-326e-9d3e-cc134d2704ba",
                                "text": "Justitia trägt eine Augenbinde und sieht nichts; jedoch fühlt sie die Waage in der Hand und nutzt diese Sinneswahrnehmung unbeeinflusst für ihre Entscheidung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
