                        "sense_id": "fde2553c-0725-34df-afb5-1a723f041c9e",
                        "entry_id": "ef355a47-c607-3a13-afee-b659e94023af",
                        "glosses": [
                            "gegen die Taliban gerichtetes militärisches Zweckbündnis afghanischer Milizen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1b59de74-3b1f-4e6d-b14c-8cff920a9cc6",
                                "sense_id": "fde2553c-0725-34df-afb5-1a723f041c9e",
                                "text": "„Knapp entschuldigte er sich, sein Firmenflugzeug warte auf ihn, um ihn nach Mazar-i-Sharif, die Hauptstadt der Nordallianz, zu bringen.“"
                            },
                            {
                                "example_id": "4dc80337-c6b9-402f-a1b9-53d8ed5d26da",
                                "sense_id": "fde2553c-0725-34df-afb5-1a723f041c9e",
                                "text": "„Unbewaffnete Taliban-Gefangene hatten die Wachen der Nordallianz überrannt und die Kontrolle über das Gefängnis übernommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
