{
    "word_family": [
        "тот",
        "потом",
        "потому",
        "оттого",
        "зато"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dd89591a-e3bb-303b-b26f-d89ac8d9a7fa",
                    "sense_definition": "После этого, спустя некоторое время; обозначает следование одного действия или события за другим.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сначала мы пообедали, а <затем> пошли гулять в парк.",
                            "target_lang_translations": {
                                "en": "First we had lunch, and <w>then</w> we went for a walk in the park.",
                                "zh": "我们先吃了午饭，<w>然后</w>去公园散步了。"
                            }
                        },
                        {
                            "text": "Он внимательно прочитал письмо и <затем> убрал его в стол.",
                            "target_lang_translations": {
                                "en": "He read the letter carefully and <w>then</w> put it away in the desk.",
                                "zh": "他仔细读了信，<w>接着</w>把它收进了桌子里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "потом",
                        "позже",
                        "далее",
                        "после этого",
                        "вслед за тем"
                    ],
                    "antonyms": [
                        "прежде",
                        "ранее"
                    ],
                    "common_phrases": [
                        "а затем",
                        "и затем"
                    ],
                    "target_lang_definitions": {
                        "en": "After this, after some time; indicates the sequence of one action or event following another.",
                        "zh": "在此之后，过了一段时间；表示一个动作或事件紧接着另一个发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "used to indicate what happens next in a sequence"
                            },
                            {
                                "target_lang_word": "after that",
                                "target_lang_sense_clarification": "following a previous event"
                            },
                            {
                                "target_lang_word": "next",
                                "target_lang_sense_clarification": "immediately following in time or order"
                            },
                            {
                                "target_lang_word": "afterwards",
                                "target_lang_sense_clarification": "at a later time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "然后",
                                "target_lang_sense_clarification": "表示时间上的先后顺序"
                            },
                            {
                                "target_lang_word": "接着",
                                "target_lang_sense_clarification": "表示紧随其后的动作"
                            },
                            {
                                "target_lang_word": "之后",
                                "target_lang_sense_clarification": "表示在某事发生以后"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83cf5786-44c3-3a02-93d9-7cdc9e5c1069",
                    "sense_definition": "С этой целью, для этого; указывает на причину или намерение (часто используется в связке с союзом «чтобы»).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я пришёл к тебе <затем>, чтобы лично поздравить с праздником.",
                            "target_lang_translations": {
                                "en": "I came to you <w>in order</w> to personally congratulate you on the holiday.",
                                "zh": "我来找你，就是<w>为了</w>当面祝贺你节日快乐。"
                            }
                        },
                        {
                            "text": "Мы собрались здесь <затем>, чтобы решить эту важную проблему.",
                            "target_lang_translations": {
                                "en": "We gathered here <w>in order</w> to solve this important problem.",
                                "zh": "我们聚在这里，<w>为此</w>就是为了解决这个重要问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "затем чтобы"
                    ],
                    "target_lang_definitions": {
                        "en": "With this purpose, for this; indicates a reason or intention (often used in conjunction with 'in order to').",
                        "zh": "为了这个目的；指明原因或意图（常与“为了”连用）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in order (to)",
                                "target_lang_sense_clarification": "used to express purpose or intention"
                            },
                            {
                                "target_lang_word": "for that purpose",
                                "target_lang_sense_clarification": "with that specific goal in mind"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "为了",
                                "target_lang_sense_clarification": "表示目的"
                            },
                            {
                                "target_lang_word": "为此",
                                "target_lang_sense_clarification": "为了这个目的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}