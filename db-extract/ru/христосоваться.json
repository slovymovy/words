                "senses": [
                    {
                        "sense_id": "3fdc04ef-7c1c-35d9-9371-98360b2bc04c",
                        "entry_id": "9984a635-09e6-3dc2-a403-502eaf6589a0",
                        "glosses": [
                            "to exchange a triple kiss as an Easter salutation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5c0665-30a7-4da9-aef6-6a1aa20fbb3e",
                                "sense_id": "3fdc04ef-7c1c-35d9-9371-98360b2bc04c",
                                "text": "Разговля́лись до́лго и ра́достно. Вы входи́ли по́зже всех, христо́совались с ма́мой, бра́тьями, со мно́й.",
                                "translation": "They took time joyfully breaking their fast. You all came in later, exchanged three Easter kisses with mum, my brothers and me.",
                                "english": "They took time joyfully breaking their fast. You all came in later, exchanged three Easter kisses with mum, my brothers and me."
                            }
                        ]
                    }
                ],
