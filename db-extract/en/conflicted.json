                        "entry_id": "f63480f3-d19f-3a02-9383-772760e59ef8",
                        "glosses": [
                            "In a state of personal or emotional conflict."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7e1ea65e-785c-458f-9f9b-364e97a67bf4",
                                "sense_id": "33cb6db5-cf91-3d44-beb0-5b191651279f",
                                "text": "I felt conflicted about whether he liked me or not."
                            },
                            {
                                "example_id": "c44a5458-3df0-4c20-888b-8c313cb721f6",
                                "sense_id": "33cb6db5-cf91-3d44-beb0-5b191651279f",
                                "text": "She has always been conflicted about her relationship with my family."
                            },
                            {
                                "example_id": "b325e169-86fc-46b1-8b15-079e72412fec",
                                "sense_id": "33cb6db5-cf91-3d44-beb0-5b191651279f",
                                "text": "He sees a pretty woman in a pod and decides to make her his, subsuming her lifetime of hopes and dreams (not to mention her bodily autonomy) to his own desire for companionship, and lies to her in order to fulfill that desire. But he’s a nice guy, and he felt conflicted about it before he did it, so it’s… understandable? Or at least forgivable? Apparently?)"
                            }
                        ]
                    },
