                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a779ffc6-1211-4f06-99ea-4fd53931f726",
                                                "sense_id": "6851d015-998a-3e93-8685-cc6fdabaac01",
                                                "text": "A country cannot disinformation its way out of fallen soldiers."
                                            }
