                                    },
                                    {
                                        "sense_id": "666decc4-868d-3904-9147-989212df278e",
                                        "entry_id": "f8d7b9a9-512b-312b-82e5-a8666c652369",
                                        "glosses": [
                                            "One who makes a pitch or proposal."
                                        ],
                                        "tags": [],
