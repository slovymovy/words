                ],
                "senses": [
                    {
                        "sense_id": "75a4b320-da9d-3f53-a7a9-bc54fcc13c70",
                        "entry_id": "d1bfa9e9-7e21-316e-ba18-c50c42c5e258",
                        "glosses": [
                            "Mensch, der sich allein, ohne Partner oder Gegenspieler, mit einem Spiel beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41031617-8d6e-424d-8443-2847ae54c3c7",
                                "sense_id": "75a4b320-da9d-3f53-a7a9-bc54fcc13c70",
                                "text": "„Im Gegensatz zu den stark gruppenbetonten Bewegungsspielen ist das bauende Spielen auch für stille, selbstgenügsame Einzelspieler interessant.“"
                            },
                            {
                                "example_id": "c9ac9ca8-6e78-4f12-8c90-91b8b924ce1b",
                                "sense_id": "75a4b320-da9d-3f53-a7a9-bc54fcc13c70",
                                "text": "„Er hat es geschafft, ein Außenseiterteam zu Erfolgen zu führen, die weit über das hinausgehen, was die Einzelspieler, addiert man lediglich ihre Fähigkeiten, eigentlich hätten erreichen können.“"
                            },
                            {
                                "example_id": "db4a12e9-9e57-48ef-832b-0cfad9cd9cde",
                                "sense_id": "75a4b320-da9d-3f53-a7a9-bc54fcc13c70",
                                "text": "„Das Kollektiv gilt mehr als der Einzelspieler, dieser Fußball fordert den Renner.“"
                            },
                            {
                                "example_id": "1fb07e10-de17-4f69-bc69-ac16a0d5bdec",
                                "sense_id": "75a4b320-da9d-3f53-a7a9-bc54fcc13c70",
                                "text": "„Fußball besteht aber nicht nur aus den Einzelspielern, sondern auch aus der Konstellation von mehreren Spielern - und die muss passen.“"
                            },
                            {
                                "example_id": "fea42de9-436d-49b2-9f03-bc43147e7ef4",
                                "sense_id": "75a4b320-da9d-3f53-a7a9-bc54fcc13c70",
                                "text": "„Gegen Teams wie Nordirland kann die deutsche Elf praktisch nicht verlieren, der Qualitätsvorsprung der Einzelspieler ist zu groß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ee07f988-e23d-3d73-ad67-4286d2ec1180",
                        "entry_id": "d1bfa9e9-7e21-316e-ba18-c50c42c5e258",
                        "glosses": [
                            "Spieler, der sich ohne Spielpartner einem Gegner im Wettspiel stellt, beispielsweise im Badminton, Tennis oder Tischtennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "304fa1ee-b97e-492f-be44-abb29260a639",
                                "sense_id": "ee07f988-e23d-3d73-ad67-4286d2ec1180",
                                "text": "„Matkowski bestritt 2011 das Doppel-Endspiel der US Open, Kubot war auch ein guter Einzelspieler, der vor dem Sprung in die Top 40 stand.“"
                            },
                            {
                                "example_id": "fad4e921-9cd6-41a2-baed-10d828789bd6",
                                "sense_id": "ee07f988-e23d-3d73-ad67-4286d2ec1180",
                                "text": "„Struff kennt beide jungen Kontrahenten von einem Challenger-Turnier in Stettin, wo in dieser Woche sowohl Brown als auch Polens stärkster Einzelspieler Jerzy Janowicz aufschlagen.“"
                            },
                            {
                                "example_id": "e9e873d2-fa1a-4422-b142-a2d3b39b9df4",
                                "sense_id": "ee07f988-e23d-3d73-ad67-4286d2ec1180",
                                "text": "„Sollte der diesmal erkrankte Alexander Zverev sich weiter so gut entwickeln, könnte der überaus talentierte 18-Jährige der zweite starke Einzelspieler sein.“"
                            },
                            {
                                "example_id": "7992b1e1-501a-45f3-be65-ca4502361cab",
                                "sense_id": "ee07f988-e23d-3d73-ad67-4286d2ec1180",
                                "text": "„Als zweiter Einzelspieler dürfte Routinier Benjamin Becker zum Einsatz kommen, der in Acapulco das deutsche Erstrunden-Duell gegen Tobias Kamke gewann und sich mit starken Leistungen im vergangenen Jahr bis auf Platz 41 vorgearbeitet hat.“"
                            },
                            {
                                "example_id": "eb0e76cc-14c6-4400-ac8d-f965f5498927",
                                "sense_id": "ee07f988-e23d-3d73-ad67-4286d2ec1180",
                                "text": "„Beim Playoffspiel im Davis Cup um den Aufstieg in die Weltgruppe werden die Gastgeber ohne ihren routiniertesten Einzelspieler gegen die Deutschen antreten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
