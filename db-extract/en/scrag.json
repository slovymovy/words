                "senses": [
                    {
                        "sense_id": "e22cef21-0e18-3362-b721-ba9f84015961",
                        "entry_id": "77645a78-a5cb-3e42-8fb3-dffe7f1f9638",
                        "glosses": [
                            "To hang on a gallows, or to choke, garotte, or strangle."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a78c4102-694a-4411-b06e-02293d9bf17f",
                                "sense_id": "e22cef21-0e18-3362-b721-ba9f84015961",
                                "text": "An enthusiastic mob will scrag me to a certainty the day war breaks out."
                            }
                        ]
                    },
                    {
                        "sense_id": "68f83893-7618-33c5-a77c-a8349486c5d8",
                        "entry_id": "77645a78-a5cb-3e42-8fb3-dffe7f1f9638",
                        "glosses": [
                            "To harass; to manhandle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39abb5bf-44a3-4a0e-9a93-91cba83b18de",
                                "sense_id": "68f83893-7618-33c5-a77c-a8349486c5d8",
                                "text": "'...I urged him ... to ... try the Ickenham System ... a little thing I knocked together in my bachelor days ... it has a good many points in common with all-in wrestling and osteopathy. I generally recommend it to diffident wooers and it always works like magic...'\nJohnny stared.\n'You mean you told McMurdo to … scrag her?'"
                            }
                        ]
                    },
                    {
                        "sense_id": "febdeec2-08f3-384b-a13e-a1e3b0bc7aba",
                        "entry_id": "77645a78-a5cb-3e42-8fb3-dffe7f1f9638",
                        "glosses": [
                            "To destroy or kill."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d58f31-13ae-4fa0-ba42-88d8732f1d11",
                                "sense_id": "febdeec2-08f3-384b-a13e-a1e3b0bc7aba",
                                "text": "[...] I went out lookin' for a line of retreat for my men. A man found me. I abolished him—privatim—scragged him."
                            },
                            {
                                "example_id": "9b286a34-3995-494e-af54-264ddd939cb7",
                                "sense_id": "febdeec2-08f3-384b-a13e-a1e3b0bc7aba",
                                "text": "But they'll scrag you for it, you know, if you do. They scrag anyone who speaks to me."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "074e3cd4-71a6-4959-981d-47c3915fbbc0",
                        "source_entry_id": "77645a78-a5cb-3e42-8fb3-dffe7f1f9638",
                        "source_sense_description": "to choke",
                        "target_lang_word": "задыха́ться",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "задыха́ться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "63e183a1-a2e8-3f2e-b0fa-ec653cbcb1bd",
                                        "entry_id": "68f73836-297e-30c3-98a2-df8aa89c0d9e",
                                        "glosses": [
                                            "испытывать стеснение, затруднение в дыхании от недостатка воздуха; терять возможность свободно дышать (от эмоций, физических усилий и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65aaa09-851e-40c5-9377-fb6c5864200a",
                                                "sense_id": "63e183a1-a2e8-3f2e-b0fa-ec653cbcb1bd",
                                                "text": "Был он слаб, жёлт, руки трепещут, сам задыхается, но смотрит умилённо и радостно."
                                            },
                                            {
                                                "example_id": "b9a06969-d962-4b37-a602-9ec5ce0fe3b1",
                                                "sense_id": "63e183a1-a2e8-3f2e-b0fa-ec653cbcb1bd",
                                                "text": "Он задыхался от волнения, и глаза его блестели."
                                            },
                                            {
                                                "example_id": "c6f5c9ce-6c4b-46eb-937e-e2db66737b09",
                                                "sense_id": "63e183a1-a2e8-3f2e-b0fa-ec653cbcb1bd",
                                                "text": "Я по льду ехал через замёрзшую реку, задыхаясь от горя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7519acb2-1b7c-3214-9afd-b6914e0fa9f0",
                                        "entry_id": "68f73836-297e-30c3-98a2-df8aa89c0d9e",
                                        "glosses": [
                                            "умирать от невозможности дышать, от недостатка воздуха, от затруднённого дыханния, от удушья и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48016fbe-8486-4973-ae48-3dd0a082d906",
                                                "sense_id": "7519acb2-1b7c-3214-9afd-b6914e0fa9f0",
                                                "text": "Тяжкая духота навалилась на меня, давила, вязала тело и мозг… я задыхался по-настоящему."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45984aad-434a-3575-a3fe-2b81a7ebd37a",
                                        "entry_id": "68f73836-297e-30c3-98a2-df8aa89c0d9e",
                                        "glosses": [
                                            "перен. испытывать затруднения в каких либо действиях или в существовании из-за непреодолимых препятствий, нехватки чего-либо необходимого и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a0d7eb-2f9e-4676-bda4-22110ae147bd",
                                                "sense_id": "45984aad-434a-3575-a3fe-2b81a7ebd37a",
                                                "text": "В 1995 году Грачёв пожаловался президенту, что реформа армии задыхается без денег."
                                            }
                                        ]
                                    }
                                ]
                            }
