                ],
                "senses": [
                    {
                        "sense_id": "51f7050b-a73a-379e-8481-c7ca1e17fa2c",
                        "entry_id": "0ad2f635-3121-3bd4-bd06-783dc49bd030",
                        "glosses": [
                            "Water that dishes and cooking utensils have been washed in."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5ea6a12e-a41c-43a6-8bdc-85f9f8de3fab",
                                "sense_id": "51f7050b-a73a-379e-8481-c7ca1e17fa2c",
                                "text": "The dishwater drained away slowly."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fb871cd-0814-3180-81a5-f764e3ee9560",
                        "entry_id": "0ad2f635-3121-3bd4-bd06-783dc49bd030",
                        "glosses": [
                            "Anything dull and lacking interest or flavour."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "37b9ca19-cf98-46e1-8de5-cb45554a0c35",
                                "sense_id": "1fb871cd-0814-3180-81a5-f764e3ee9560",
                                "text": "This season's offerings are nothing but dishwater."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85825bc2-20cf-4889-a7bf-f94ece2e4bf6",
                        "source_entry_id": "0ad2f635-3121-3bd4-bd06-783dc49bd030",
                        "source_sense_description": "washing water",
                        "target_lang_word": "afwaswater",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afwaswater",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5528465f-87aa-3149-a812-ebd175314e1d",
                                        "entry_id": "efb9eb63-6dec-35e5-9dc0-e30151ec83ae",
                                        "glosses": [
                                            "het sop waarin met het eetgerei schoonmaakt of -gemaakt heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3797e14f-966f-4612-bcd7-7f3cd69ca7e3",
                                                "sense_id": "5528465f-87aa-3149-a812-ebd175314e1d",
                                                "text": "Je moet het afwaswater nog in de gootsteen gooien."
                                            },
                                            {
                                                "example_id": "fab4e188-befa-4d15-bff5-d020e41b9f93",
                                                "sense_id": "5528465f-87aa-3149-a812-ebd175314e1d",
                                                "text": "Iedereen had duidelijke taken, ik moest altijd afwassen. Het afwaswater werd tijdens het eten op het vuur verwarmd waarmee ik na de maaltijd de aangekoekte pannen schoon schrobde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdcf3487-0438-4bd2-a3c5-847d77641c4a",
                        "source_entry_id": "0ad2f635-3121-3bd4-bd06-783dc49bd030",
                        "source_sense_description": "washing water",
                        "target_lang_word": "rinçure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rinçure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74a60688-e4bd-3e3f-a186-dbb65963f9e2",
                                        "entry_id": "bdd12881-b0ef-380b-b787-ac7875d95f44",
                                        "glosses": [
                                            "Eau avec laquelle on a rincé un verre, une bouteille, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b96165-5995-4003-a8be-9104a266d4b0",
                                                "sense_id": "74a60688-e4bd-3e3f-a186-dbb65963f9e2",
                                                "text": "On rince bien la surface de cet amydon avec ce seau d'eau ; on a un tonneau vide tout prêt à recevoir les rinçures : on les y met ; elles y déposent ; et ce dépôt des rinçures s’appelle amydon commun."
                                            },
                                            {
                                                "example_id": "f8654ff4-aac3-4f54-937c-26ec33a2a7ed",
                                                "sense_id": "74a60688-e4bd-3e3f-a186-dbb65963f9e2",
                                                "text": "Mais une querelle éclatait entre les deux frères : Jeanlin s’était hâté de sauter dans le baquet, sous le prétexte que Zacharie mangeait encore ; et celui-ci le bousculait, réclamait son tour, criait que s’il était assez gentil pour permettre à Catherine de se tremper d’abord, il ne voulait pas avoir la rinçure des galopins, d’autant plus que, lorsque celui-ci avait passé dans l’eau, on pouvait en remplir les encriers de l’école."
                                            },
                                            {
                                                "example_id": "24018a17-6b45-4861-88de-7dab25c7a8e3",
                                                "sense_id": "74a60688-e4bd-3e3f-a186-dbb65963f9e2",
                                                "text": "Thomas a dit qu’il prenait un café. Je fais remarquer à Thomas qu'ici il n’y a pas de café, mais seulement de la rinçure de balai de chiottes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cedfea64-96e7-345f-af3b-846b9213e09d",
                                        "entry_id": "bdd12881-b0ef-380b-b787-ac7875d95f44",
                                        "glosses": [
                                            "Boisson trop diluée."
                                        ],
                                        "tags": [
                                            "hyperbole",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29a56d00-3fdb-45db-a373-b3924998c9bf",
                                                "sense_id": "cedfea64-96e7-345f-af3b-846b9213e09d",
                                                "text": "- Ce café, mon pauvre oncle, est infect ! Vous avez passé de l’eau sur votre lavasse de ce matin. Si la tante aime les rinçures, ne vous privez pas de lui en servir."
                                            },
                                            {
                                                "example_id": "8fd6bd68-123a-4841-9003-c775ecacf3cc",
                                                "sense_id": "cedfea64-96e7-345f-af3b-846b9213e09d",
                                                "text": "J’enfile mon costume de prolétaire malgré lui, avale un breuvage aux arrière-goûts de rinçure, passe un bon quart d’heure à faire le guet derrière ma fenêtre au cas où un terroriste s’aviserait de me faire péter ma tirelire-à-préjugés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8281fc03-6c12-4f01-bd31-1e4dd1df6926",
                        "source_entry_id": "0ad2f635-3121-3bd4-bd06-783dc49bd030",
