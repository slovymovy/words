                ],
                "translations": [
                    {
                        "translation_id": "d12b7858-a041-494f-9e98-3d56454fd1eb",
                        "source_entry_id": "db58246d-a293-3530-9edf-d932b171c96f",
                        "source_sense_id": "bc4f9443-41c0-38c6-9022-841e1fb8a893",
                        "target_lang_word": "lightfast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lightfast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                        "entry_id": "b2d2cf0c-25fe-3bf6-9c90-77700290a6e6",
                                        "glosses": [
                                            "Resistant to fading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083493fa-9fd6-462c-953c-2c4e9eb0f1c9",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "Verdigris is lightfast in oil paint, as numerous examples of fifteenth-century paintings show."
                                            },
                                            {
                                                "example_id": "7a35b2bb-724a-444c-98f8-5760c0a1986f",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "Some ink-and-paper combinations are more lightfast than others, and the resulting prints are more fade-resistant."
                                            },
                                            {
                                                "example_id": "72cf5a65-c5fc-43b1-bb8f-f2a57203a230",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "Tara, a gallotannin, is often quoted as being the most lightfast vegetable tannin and makes very pale coloured leather."
                                            },
                                            {
                                                "example_id": "2cc84bda-8de2-421e-9e4c-235469377002",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "The blue, or cyan, is the most lightfast ink used in the printing process, so it lasts the longest. That blue, incidentally, is the phthalocyanine blue pigment.\nYou can easily test to determine whether any material is lightfast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
