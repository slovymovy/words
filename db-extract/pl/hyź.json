        "pl-extract.jsonl": [
            {
                "entry_id": "782bc3e7-6953-399e-a799-4ae486f7280c",
                "word": "hyź",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b405761-c9e0-3e37-be2d-b9c737ca09c9",
                        "entry_id": "782bc3e7-6953-399e-a799-4ae486f7280c",
                        "glosses": [
                            "utracony rozum"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "37394c3e-bcc4-4d31-8265-b44193510514",
                                "sense_id": "0b405761-c9e0-3e37-be2d-b9c737ca09c9",
                                "text": "Tak Wandę pożądam, że dostanę hyzia, jeśli ona mnie odrzuci."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b773b7c-451b-4751-b335-5767217d4561",
                        "source_entry_id": "782bc3e7-6953-399e-a799-4ae486f7280c",
                        "source_sense_id": "0b405761-c9e0-3e37-be2d-b9c737ca09c9",
                        "target_lang_word": "crackpot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crackpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97caff77-af63-31d2-a223-d745c21fc59b",
                                        "entry_id": "8550573c-3243-317e-811b-3e03f1d434ea",
                                        "glosses": [
                                            "An eccentric, crazy or foolish person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ac21cc-f094-490c-9151-7aa586faa82a",
                                                "sense_id": "97caff77-af63-31d2-a223-d745c21fc59b",
                                                "text": "Time will tell whether he is a crackpot or a genius for promoting that sort of idea."
                                            },
                                            {
                                                "example_id": "d40f97e2-a534-47ab-8dba-f9341c94f77c",
                                                "sense_id": "97caff77-af63-31d2-a223-d745c21fc59b",
                                                "text": "The Police Commissioner sat studying Frank the Flower for several minutes. Then he called the policeman who had arrested Frank. “You will have to lock this man up,” he said. “But treat him gently. He is a harmless crackpot.”"
                                            },
                                            {
                                                "example_id": "a4dd6fe8-ce37-4fc9-9604-2861c8d66401",
                                                "sense_id": "97caff77-af63-31d2-a223-d745c21fc59b",
                                                "text": "No one plots like Gaston / Takes cheap shots like Gaston / Plans to persecute harmless crackpots like Gaston"
                                            },
                                            {
                                                "example_id": "48016a57-df79-454e-8d0a-2c2ce5087ea0",
                                                "sense_id": "97caff77-af63-31d2-a223-d745c21fc59b",
                                                "text": "In the early 1990s, Ms. Feilding realized that the only way to overcome the taboo of these drugs — and her reputation as a crackpot — was to start a scientific foundation to fund research projects that governments and universities would never consider."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c60268-986d-31b8-960d-b871b553bd36",
                                        "entry_id": "8550573c-3243-317e-811b-3e03f1d434ea",
                                        "glosses": [
                                            "Someone addicted to crack cocaine (i.e. a drug addict)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crackpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9382e3c8-0c99-354e-bb99-b048c6f6d40a",
                                        "entry_id": "e940644c-2427-3c34-a750-d8622bebc712",
                                        "glosses": [
                                            "Eccentric or impractical."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d5dfc9a-bff5-4146-81d8-6e51fe932687",
                                                "sense_id": "9382e3c8-0c99-354e-bb99-b048c6f6d40a",
                                                "text": "a crackpot idea"
                                            },
                                            {
                                                "example_id": "8d18bf20-c73d-4cbd-a570-6fe98195757d",
                                                "sense_id": "9382e3c8-0c99-354e-bb99-b048c6f6d40a",
                                                "text": "While all this was happening Mr. Dies on February 1, 1943, in a long speech on the floor of the House attacked thirty-nine named Government employees as 'irresponsible, unrepresentative, crackpot, radical bureaucrats' and affiliates of 'communist front organizations.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
