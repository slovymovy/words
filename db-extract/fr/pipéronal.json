                        "examples": [
                            {
                                "example_id": "2aaea1b9-c728-4ed6-a8dc-05643af701f9",
                                "sense_id": "a5868836-438f-34d4-a014-74783c942e1e",
                                "text": "J'ai d'abord fait réagir le réactif à la vanilline et au pipéronal sur une série d'huiles, et j'ai observé les colorations directement après mélange et également au bout d'un certain temps."
                            },
                            {
                                "example_id": "53d64281-8ab3-4b44-a93a-841e8d2b5c63",
                                "sense_id": "a5868836-438f-34d4-a014-74783c942e1e",
                                "text": "Le pipéronal est obtenu à partir du safran et possède l'odeur de l’héliotrope. Le chauffage du pipéronal en milieu acide dilué le transforme en une molécule de formule C₇H₆0₃."
                            }
