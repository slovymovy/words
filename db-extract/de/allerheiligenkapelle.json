                "senses": [
                    {
                        "sense_id": "7cb9619a-8ed9-30f1-99bb-21af5e8c28f2",
                        "entry_id": "4819b466-4504-3d4c-8695-91861618e693",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das nicht für regelmäßige Gottesdienste einer Gemeinde bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60e81e5-ab19-458f-b5b1-a059ea0bee30",
                                "sense_id": "7cb9619a-8ed9-30f1-99bb-21af5e8c28f2",
                                "text": "Die Kath. Kirche kennt ca. 6800 eingetragene Heilige und \"All diesen Heiligen\" kann man in einer Allerheiligenkapelle gedenken, und dies nicht nur an Allerheiligen."
                            },
                            {
                                "example_id": "5a4f99f3-ac87-419d-9105-576d0aa2be73",
                                "sense_id": "7cb9619a-8ed9-30f1-99bb-21af5e8c28f2",
                                "text": "„Da der frühere, direkt an die Allerheiligenkapelle angrenzende Friedhof nicht sehr groß war, wurden die Gebeine älterer Bestattungen in den dreischiffigen Keller gebracht, der so zum Bainhaus der Stadt wurde.“"
                            },
                            {
                                "example_id": "4b426929-1d5a-4e30-a518-1ccf68a097c8",
                                "sense_id": "7cb9619a-8ed9-30f1-99bb-21af5e8c28f2",
                                "text": "„Der bedeutende romanische Zentralbau der Allerheiligenkapelle steht im östlichen Kreuzganghof am Domkapitelhaus am Domgarten 1.“"
                            },
                            {
                                "example_id": "7f87d772-59f9-49ab-867c-1ae536bd1a98",
                                "sense_id": "7cb9619a-8ed9-30f1-99bb-21af5e8c28f2",
                                "text": "„Die im ersten Jahrzehnt des 16. Jahrhunderts erbaute Allerheiligenkapelle des Landauerschen Zwölfbrüderhauses zeigt ebenso wie die Kapelle der Familie Holzschuher auf dem Johannisfriedhof (1513) hängende Gewölbeschlußsteine, ein typisches Merkmal der Stilentwicklung in der Spätgotik.“"
                            },
                            {
                                "example_id": "98cc1760-8b48-48fb-8e47-fa439e24114f",
                                "sense_id": "7cb9619a-8ed9-30f1-99bb-21af5e8c28f2",
                                "text": "„Mit dem Bau der Wettsteinbrücke 1878/79 nahte das Ende des nunmehr als Allerheiligenkapelle bekannten Gotteshauses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23bc76a6-d3c8-3b4e-9620-0e2f3341c63f",
                        "entry_id": "4819b466-4504-3d4c-8695-91861618e693",
                        "glosses": [
                            "abgeteilter Raum in einem größeren Gotteshaus oder sonstigen Gebäude, der für Gottesdienste und dergleichen von einer Gemeinde, genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904e5a90-c48e-44c1-96b1-b1eeb66c459d",
                                "sense_id": "23bc76a6-d3c8-3b4e-9620-0e2f3341c63f",
                                "text": "Die Kath. Kirche kennt ca. 6800 eingetragene Heilige und \"All diesen Heiligen\" kann man in einer Allerheiligenkapelle gedenken, und dies nicht nur an Allerheiligen."
                            },
                            {
                                "example_id": "3415d768-1ed9-4b35-9605-6db207e29a80",
                                "sense_id": "23bc76a6-d3c8-3b4e-9620-0e2f3341c63f",
                                "text": "„Der bedeutende romanische Zentralbau der Allerheiligenkapelle steht im östlichen Kreuzganghof am Domkapitelhaus am Domgarten 1.“"
                            },
                            {
                                "example_id": "6f065ca5-b211-4949-acc4-ee635dd9539c",
