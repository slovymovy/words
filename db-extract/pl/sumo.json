                        "cross_references": [
                            {
                                "target_word": "сумо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ca319ff6-a937-37f0-b12c-a40211294f29",
                                        "entry_id": "e0c05c62-8b9c-3ed8-8293-fd14ee842643",
                                        "glosses": [
                                            "спорт. традиционный японский вид спорта, в котором два спортсмена пытаются вытолкнуть друг друга за пределы круга или заставить коснуться земли любой частью тела, кроме стоп"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d27500c-f475-45cc-8120-3019cdab0f45",
                                                "sense_id": "ca319ff6-a937-37f0-b12c-a40211294f29",
                                                "text": "Сумо - древнейшее из всех видов японских единоборств - в последние годы активно развивается как любительский вид спорта."
                                            },
                                            {
                                                "example_id": "cb3aceaa-8f0a-4cb9-a9d1-38e92b7267ee",
                                                "sense_id": "ca319ff6-a937-37f0-b12c-a40211294f29",
                                                "text": "Во время учёбы в университете он осваивал джиу-джитсу под руководством трёх мастеров этого единоборства. А также, параллельно, посещал занятия по сумо и изучал всю доступную ему литературу по различным видам борьбы."
                                            },
                                            {
                                                "example_id": "8ec73f83-8319-46e5-b8c4-d81e9fc0bc4b",
                                                "sense_id": "ca319ff6-a937-37f0-b12c-a40211294f29",
                                                "text": "Мужчина протягивает руку с пультом и включает телевизор. Слышен голос английского, спортивного комментатора. [Женщина:] ❬…❭ Это как называется? [Мужчина:] Сумо. [Женщина:] А какие правила? [Мужчина:] Надо выпихнуть соперника за пределы круга."
                                            },
                                            {
                                                "example_id": "0749640f-8faf-4c4f-848b-a0b8c0883160",
                                                "sense_id": "ca319ff6-a937-37f0-b12c-a40211294f29",
                                                "text": "Перед взором юноши предстала небывалая картина. Нет, он и раньше видел воинские поединки на мечах, копьях или каком-либо другом оружии, а также рукопашной. Но, борьбу под названием сумо, ему довелось видеть впервые. ❬…❭ На помосте, находились двое борцов, здоровущих, тучных, пытающихся вытолкнуть друг друга за начертанный на песке круг. ❬…❭ По правилам сумо, если боец коснётся песка любой частью тела, кроме стоп, считается проигравшим."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
