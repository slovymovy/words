                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3bc40e6-1701-3b55-80f5-b6fb4885420e",
                        "entry_id": "1436f62e-b237-31da-9c1e-07e85221993e",
                        "glosses": [
                            "A type of large dirigible rigid airship of the early 20th century, built by the German Luftschiffbau Zeppelin and designed to carry passengers or bombs."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9092b85d-8f7d-3ec8-97f6-7676af9fb09b",
                        "entry_id": "1436f62e-b237-31da-9c1e-07e85221993e",
                        "glosses": [
                            "A rigid airship dirigible, not restricted to Germany nor the early 20th century."
                        ],
                        "tags": [
                            "broadly",
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a9ca93e4-a683-3f55-b150-178e31b94c3f",
                        "entry_id": "1436f62e-b237-31da-9c1e-07e85221993e",
                        "glosses": [
                            "The penis."
                        ],
                        "tags": [
                            "rare",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "165aabb4-572a-4718-bab0-f7927e0888e6",
                                "sense_id": "a9ca93e4-a683-3f55-b150-178e31b94c3f",
                                "text": "2022, Seaward Dracula, D. Stroker, sVck\nShe shoved him back on the bed, but fear had turned his zeppelin into a deflated balloon, and try as she might, she couldn't blow any air into it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40472d49-54b7-4db8-96fd-030631a1ce42",
                        "source_entry_id": "1436f62e-b237-31da-9c1e-07e85221993e",
                        "source_sense_description": "a type of large German dirigible airship of the early 20th century",
                        "target_lang_word": "zeppelin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeppelin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4cece6-9720-3c4c-9c5d-5f232325265e",
                                        "entry_id": "83b6c39e-3697-33b6-a62e-b816b8af9a87",
                                        "glosses": [
                                            "Aérostat de type dirigeable rigide fabriqué par Zeppelin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd308b1-c6fd-4f3c-a61c-7a59dfca617c",
                                                "sense_id": "cb4cece6-9720-3c4c-9c5d-5f232325265e",
                                                "text": "Les zeppelins ont lancé sans discontinuer des bombes destructives sur Londres et sur toute l’Angleterre; chaque jour les U-boote criminels, envoyaient sans merci tous les navires au fond de la mer."
                                            },
                                            {
                                                "example_id": "c306f718-6770-4d20-8f36-13d1169a638f",
                                                "sense_id": "cb4cece6-9720-3c4c-9c5d-5f232325265e",
                                                "text": "Le bruit de la ligne Dauphine-Nation, pareil à une plainte de zeppelin, accompagne le voyageur jusqu’à ces quartiers cernés de cheminées d’usines, lacs de zinc où la rue d’Aubervilliers se jette comme une rivière de vernis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd6c65a2-ce05-39dc-b1e0-edc73b612089",
                                        "entry_id": "83b6c39e-3697-33b6-a62e-b816b8af9a87",
                                        "glosses": [
                                            "N'importe quel ballon dirigeable rigide ou souple (blimp)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab3b31c0-d7c2-4d6c-88f6-d88b780c4419",
                        "source_entry_id": "1436f62e-b237-31da-9c1e-07e85221993e",
                        "source_sense_description": "a type of large German dirigible airship of the early 20th century",
                        "target_lang_word": "Zeppelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                        "entry_id": "523fd728-a170-3f3a-babd-178b788c9637",
                                        "glosses": [
                                            "bekanntester Luftschifftyp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c374d2-39f7-4c80-8b4c-330e8d3b6d34",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "Im Ersten Weltkrieg wurden Zeppeline zur Bombardierung der englischen Zivilbevölkerung eingesetzt."
                                            },
                                            {
                                                "example_id": "08f03a26-b036-41be-9680-fc08123471f7",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Nobile war mit dem Luftschiff ‚Italia‘ erneut zum Nordpol aufgebrochen, diesmal ohne Amundsen. Auf dem Rückweg stürzte der Zeppelin ab.“"
                                            },
                                            {
                                                "example_id": "6bf95538-1d40-46c6-b6c4-1895251909a6",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Bei Cuxhaven war ein Zeppelin durch Blitzschlag vernichtet.“"
                                            },
                                            {
                                                "example_id": "fa6bef46-0d10-4a46-8bb7-7304b0f0e902",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Aber der Zeppelin fliegt nicht los, Eckener will ihn nicht unnütz gefährden.“"
                                            },
                                            {
                                                "example_id": "4c70c79b-bc3e-4434-bb19-cc3ca1bb1d40",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Auch der Zeppelin erschien in Mainz, wenn auch mit etwas Verspätung, auf dem ersten Flug, der ihn vom Bodensee bis fast zur Nordsee hätte führen sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                        "entry_id": "144d7ead-45be-36af-a453-9c771fe27d8e",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25c2b41-582d-4a9f-9047-cfdb88707188",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Frau Zeppelin ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "e48b10fb-2fee-41af-88c1-7da4ecf8e5ae",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Herr Zeppelin wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "dbbc3bf2-f612-4eee-8b3f-9ff926b69799",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Die Zeppelins fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "a2b1ac64-88f1-4f77-b013-4e43944c5431",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Der Zeppelin trägt nie die Schals, die die Zeppelin ihm strickt."
                                            },
                                            {
                                                "example_id": "f836ea5d-773d-4e36-ba9b-3d8ae10cbaf8",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zeppelin kommt, geht der Herr Zeppelin.“"
                                            },
                                            {
                                                "example_id": "988e924e-f851-4e39-ad75-74d82050ce9b",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelin kommt und geht."
                                            },
                                            {
                                                "example_id": "b841a79e-ee05-47b4-94f6-6b4a3c61d5ac",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelins kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cad73a9b-d4ee-44ae-ad84-32113341aa2d",
                        "source_entry_id": "1436f62e-b237-31da-9c1e-07e85221993e",
                        "source_sense_description": "a type of large German dirigible airship of the early 20th century",
                        "target_lang_word": "цеппели́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цеппели́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "369cabc3-00bf-3b55-b4e2-4497db3b4d0f",
                                        "entry_id": "e7909866-8959-3366-a864-1150ea7f5379",
                                        "glosses": [
                                            "устар., авиац. сигарообразный дирижабль жёсткого типа с металлическим каркасом, обтянутым тканью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630120c9-27ef-4d96-913f-4afd30805d26",
                                                "sense_id": "369cabc3-00bf-3b55-b4e2-4497db3b4d0f",
                                                "text": "Французский авиатор Гарро погиб, протаранив германский цеппелин."
                                            },
                                            {
                                                "example_id": "4b8833d0-74d3-4c22-ad1d-557b975391e2",
                                                "sense_id": "369cabc3-00bf-3b55-b4e2-4497db3b4d0f",
                                                "text": "Над городом плавал бело-розовый цеппелин, точно небольшое, заострённое с двух концов облако."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7fed20e-b964-3dc2-b238-3e9622f1e53d",
                                        "entry_id": "e7909866-8959-3366-a864-1150ea7f5379",
                                        "glosses": [
                                            "рег. (Прибалтика) кулин. картофельная зраза, фаршированная мясом"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77a7fd32-c22d-4ea4-afe9-339710edd9e9",
                                                "sense_id": "a7fed20e-b964-3dc2-b238-3e9622f1e53d",
                                                "text": ".. ковырял вилкой чуть тёплый цеппелин и думал с предстоящем разговоре со Смилдзиней."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c06e964-7e5e-41ed-a1cc-043f29de45e1",
                        "source_entry_id": "1436f62e-b237-31da-9c1e-07e85221993e",
                        "source_sense_description": "a type of large German dirigible airship of the early 20th century",
                        "target_lang_word": "дирижа́бль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дирижа́бль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6a059878-f91a-375a-bf3e-57b065ce50a5",
                                        "entry_id": "d82ed109-9c4e-3183-95e8-0ec45934e69d",
                                        "glosses": [
                                            "управляемый аэростат с одним или несколькими двигателями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67905e06-6475-4fac-9982-1752052252ff",
                                                "sense_id": "6a059878-f91a-375a-bf3e-57b065ce50a5",
                                                "text": "Вторые сутки огромный дирижабль висел над поляной, пришвартованный носом к причальной мачте."
                                            },
                                            {
                                                "example_id": "f94cb5e3-ba11-4e28-b00d-0b114723c83e",
                                                "sense_id": "6a059878-f91a-375a-bf3e-57b065ce50a5",
                                                "text": "Благодаря именно этим качествам — лёгкости и твёрдости — дюралюминий широко применяется для строительства самолётов и дирижаблей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd53e0b6-4887-335e-b16c-b8f888bb58db",
                                        "entry_id": "d82ed109-9c4e-3183-95e8-0ec45934e69d",
                                        "glosses": [
                                            "жарг. летательный аппарат сомнительного качества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b36ee43a-1b64-4c0b-9218-677dab3c80d8",
                                                "sense_id": "fd53e0b6-4887-335e-b16c-b8f888bb58db",
                                                "text": "Кто бы мог подумать, но, несмотря на некорректность сравнения этих дирижаблей, срач на форумах не утихает."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
