                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7554ce01-bfdb-3e01-957e-ddc3b9c1ee95",
                                        "entry_id": "f74e2d26-eb66-3dc7-a6be-c5c1d01124bd",
                                        "glosses": [
                                            "Progression from dissonance to consonance; a chord to which such progression is made."
                                        ],
