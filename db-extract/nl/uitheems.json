                    {
                        "sense_id": "79b16b1b-dd18-3c30-9109-b5124bb5d631",
                        "entry_id": "d0a9eef9-c1b3-3d2a-9865-ad48e42ee4de",
                        "glosses": [
                            "van oorsprong ergens niet voorkomend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0441a00-bbef-4633-9a92-624cb56c4ab4",
                                "sense_id": "79b16b1b-dd18-3c30-9109-b5124bb5d631",
                                "text": "Dat is een uitheems kruid in ons land."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47ed8654-d161-4f31-af0d-bc3eee99d518",
                        "source_entry_id": "d0a9eef9-c1b3-3d2a-9865-ad48e42ee4de",
                        "source_sense_id": "79b16b1b-dd18-3c30-9109-b5124bb5d631",
                        "source_sense_description": "van oorsprong ergens niet voorkomend",
                        "target_lang_word": "exotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3839179-7c6a-3960-a0c7-e99154dd17fd",
                                        "entry_id": "4ae0572b-7fa2-37ec-b13a-c955bedf2a75",
                                        "glosses": [
                                            "aus fernen Gebieten stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6109bbef-dbbc-428f-aea7-aa4d9b4dac5b",
                                                "sense_id": "b3839179-7c6a-3960-a0c7-e99154dd17fd",
                                                "text": "Manche Terrarientiere stammen aus exotischen Ländern."
                                            },
                                            {
                                                "example_id": "1015febd-e174-4a25-b829-5be8795e5cf4",
                                                "sense_id": "b3839179-7c6a-3960-a0c7-e99154dd17fd",
                                                "text": "„Gleichzeitig war aber doch ein Bestreben unverkennbar, gerade diese Rampe zu was Besonderem zu machen, und zwar mit Hilfe mehrerer Kübel mit exotischen Blattpflanzen, darunter zwei Aloes, von denen die eine noch gut im Stande, die andre dagegen krank war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14b931bd-091d-331e-8f32-a99698449a00",
                                        "entry_id": "4ae0572b-7fa2-37ec-b13a-c955bedf2a75",
                                        "glosses": [
                                            "fremdartig wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c9b99b-1962-48ef-baf7-c705f746cf79",
                                                "sense_id": "14b931bd-091d-331e-8f32-a99698449a00",
                                                "text": "An Karneval sieht man manche exotische Verkleidung."
                                            },
                                            {
                                                "example_id": "1b48f2f8-6f52-4833-8f0d-bf92ca46bd30",
                                                "sense_id": "14b931bd-091d-331e-8f32-a99698449a00",
                                                "text": "„Briefmarkensammeln ist fast ein exotisches Hobby geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a53bce0-408b-4f24-9cf3-15615420db42",
                        "source_entry_id": "d0a9eef9-c1b3-3d2a-9865-ad48e42ee4de",
                        "source_sense_id": "79b16b1b-dd18-3c30-9109-b5124bb5d631",
                        "source_sense_description": "van oorsprong ergens niet voorkomend",
                        "target_lang_word": "exotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Foreign, especially in an exciting way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb871f5-6eba-4c2d-a112-8027650e2022",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "an exotic appearance"
                                            },
                                            {
                                                "example_id": "9cb3cf7f-2606-4ff5-9c56-f399ed242965",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "Nothing was so splendid and exotic as the ambassador."
                                            },
                                            {
                                                "example_id": "9a146834-bb53-48b6-9476-7c8b79828606",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "“Two or three months more went by ; the public were eagerly awaiting the arrival of this semi-exotic claimant to an English peerage, and sensations, surpassing those of the Tichbourne case, were looked forward to with palpitating interest.[…]”"
                                            },
                                            {
                                                "example_id": "eaed9e8a-0888-4676-b1e5-a0032d6341e4",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b7424d-a726-30b8-853d-416c615c6c44",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Foreign, especially in an exciting way.",
                                            "Non-native to the ecosystem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e868bbb2-c503-3b7a-8019-a2ba1cbe4866",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Foreign, especially in an exciting way.",
                                            "extraterrestial, alien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8189d9a-4c8f-43e5-89c2-6825af4282be",
                                                "sense_id": "e868bbb2-c503-3b7a-8019-a2ba1cbe4866",
                                                "text": "exotic materials"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578b5f5c-f7d9-3379-95c3-b85ed395b662",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Being or relating to an option with features that make it more complex than commonly traded options."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "debdebb5-2b99-33da-a917-6264a017d03b",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Being or relating to various wagers, such as the trifecta, that involve betting on the finishing positions of multiple competitors across one or more races."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "exotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9205ac-945d-30c7-bf59-1d840c112cdc",
                                        "entry_id": "3cbfe53b-9bf3-3a63-8467-c018b9da933c",
                                        "glosses": [
                                            "An organism that is exotic to an environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7898ddc9-f422-4803-8c17-3e020aab13ff",
                                                "sense_id": "bf9205ac-945d-30c7-bf59-1d840c112cdc",
                                                "text": "There were a few exotics among them — some South American boys, sons of Argentine beef barons, one or two Russians, and even a Siamese prince, or someone who was described as a prince."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4f827b-3566-365a-8632-79042a4ab74c",
                                        "entry_id": "3cbfe53b-9bf3-3a63-8467-c018b9da933c",
                                        "glosses": [
                                            "An exotic dancer; a stripteaser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b0c572e-4347-3e98-8031-0ec575d287ca",
                                        "entry_id": "3cbfe53b-9bf3-3a63-8467-c018b9da933c",
                                        "glosses": [
                                            "Any exotic particle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1de10e1-f066-49c7-9ea3-0fa390ccadbe",
                                                "sense_id": "2b0c572e-4347-3e98-8031-0ec575d287ca",
                                                "text": "Glueballs, theoretical particles composed only of gluons, are exotics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29962929-c75c-4e8e-804a-63cfa3b72216",
                        "source_entry_id": "d0a9eef9-c1b3-3d2a-9865-ad48e42ee4de",
                        "source_sense_id": "79b16b1b-dd18-3c30-9109-b5124bb5d631",
                        "source_sense_description": "van oorsprong ergens niet voorkomend",
                        "target_lang_word": "exotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0505f590-d89d-3cf4-a9fa-2150299305f4",
                                        "entry_id": "c0eda6d6-872a-3275-942f-8a9bdb1aa4df",
                                        "glosses": [
                                            "Qualifie ce qui, dans une perspective endémique fixée, est susceptible d’inspirer un sentiment d’étrangeté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5071ec90-a8e3-43e0-b331-f1ec8839c5f2",
                                                "sense_id": "0505f590-d89d-3cf4-a9fa-2150299305f4",
                                                "text": "Flétrissez aussi le charlatanisme de ces pseudo-virtuoses qui ont obtenu des succès apocryphes à New-York ou en Californie, et qui, […], viennent défigurer sur nos grandes scènes lyriques des partitions dont elles ridiculisent la majesté par les exagérations de leur style exotique."
                                            },
                                            {
                                                "example_id": "1cf8e04f-730f-41ae-b578-fba4b73052b8",
                                                "sense_id": "0505f590-d89d-3cf4-a9fa-2150299305f4",
                                                "text": "Elle escompterait les lettres de change tirées sur nos places par les exportateurs de produits exotiques sans que ceux ci passassent sous les fourches caudines des banquiers londoniens."
                                            },
                                            {
                                                "example_id": "7ae72110-aa8f-458c-a12d-135fc3df5855",
                                                "sense_id": "0505f590-d89d-3cf4-a9fa-2150299305f4",
                                                "text": "[…], il apercevait des mâts, des charrettes, des gerles et des barils pleins de poissons, des échoppes de bouquinistes et des boutiques d'oiseleurs remplies d'oiseaux exotiques multicolores et piaillants."
                                            },
                                            {
                                                "example_id": "661e7c4a-b5b1-4c76-9a23-d3f822b8f375",
                                                "sense_id": "0505f590-d89d-3cf4-a9fa-2150299305f4",
                                                "text": "Le château de Michel Pacha est entouré d’un jardin planté d’essences exotiques et de palmiers, avec escaliers à double volée, exèdres à degrés, kiosque-belvédère en forme de tempietto, volières, serres, nymphées, fontaines et édicules de rocaille à la marseillaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d13108-a0ad-3eda-a5c6-0a0caaac56b0",
                                        "entry_id": "c0eda6d6-872a-3275-942f-8a9bdb1aa4df",
                                        "glosses": [
                                            "Qualifie des plantes et des animaux extérieurs à un écosystème."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30964e26-432a-33a8-9baf-c4c410e9d630",
                                        "entry_id": "c0eda6d6-872a-3275-942f-8a9bdb1aa4df",
                                        "glosses": [
                                            "Qualifie ce qui provient de lieux jugés lointains ou tout au moins dont la fréquentation n’est pas considéré coutumière, notamment des lieux tropicaux pour les personnes résidents hors de tels lieux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "exotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d9fe00-3a0c-3bfd-8024-26bf4b772c4b",
                                        "entry_id": "700041c9-6fe0-340d-ab97-3316a89f32ee",
