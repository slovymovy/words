                "senses": [
                    {
                        "sense_id": "18aa77d7-1064-3f22-9c75-81a76c02c83a",
                        "entry_id": "2677ed13-2d5f-36fa-830d-008387685f27",
                        "glosses": [
                            "Geldbetrag, der monatlich für die Nutzung einer Dienstleistung oder die Benutzung einer Sache zu entrichten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89da35f1-e7be-4fcc-978e-d471f5d93aab",
                                "sense_id": "18aa77d7-1064-3f22-9c75-81a76c02c83a",
                                "text": "„Da die Monatsgebühr von 40 Euro nicht mehr abgebucht werden konnte, sandte der Betreiber 5 Mahnungen über je 11 Euro an die alte Adresse.“"
                            },
                            {
                                "example_id": "1807cb4e-303d-49b7-8745-3eff961a3432",
                                "sense_id": "18aa77d7-1064-3f22-9c75-81a76c02c83a",
                                "text": "„Für ihn ist etwa unklar, wieviel von der Monatsgebühr tatsächlich bei den Youtubern landen wird und ob das Modell sich als vorteilhaft für kleinere Channels erweisen kann.“"
                            },
                            {
                                "example_id": "2ad438a1-63ac-47cc-85da-fd402c296b2d",
                                "sense_id": "18aa77d7-1064-3f22-9c75-81a76c02c83a",
                                "text": "„Verbraucher sollten jedoch bei allen Handyverträgen mit Telefon prüfen, was nach Ablauf der zwei Jahr mit der Monatsgebühr passiert.“"
                            },
                            {
                                "example_id": "cedaad3c-bbe9-4348-a0c1-7b60cd85fe71",
                                "sense_id": "18aa77d7-1064-3f22-9c75-81a76c02c83a",
                                "text": "„Filme und Serien können auf Netflix gegen eine Monatsgebühr jederzeit angesehen werden, die Bindung an das Programm eines Fernsehsenders entfällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
