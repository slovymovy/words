                "senses": [
                    {
                        "sense_id": "7ed6a1d3-b072-3d62-80d9-98a886e62be4",
                        "entry_id": "f7d06f5b-7eb5-3622-bcd6-59648fb7e0e0",
                        "glosses": [
                            "krankhafte Ansammlung von Flüssigkeit (= Ödem) in der Lunge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63fea1a-e87d-463b-bc71-594acb5aa5aa",
                                "sense_id": "7ed6a1d3-b072-3d62-80d9-98a886e62be4",
                                "text": "In der schwersten Verlaufsform kann das Asthma cardiale in ein akutes Lungenödem übergehen."
                            },
                            {
                                "example_id": "69019516-c271-4a36-8299-6d3b237cb312",
                                "sense_id": "7ed6a1d3-b072-3d62-80d9-98a886e62be4",
                                "text": "Ein akutes Lungenödem bei Linksherzinsuffizienz ist ein medizinischer Notfall, der unbehandelt zum Atemstillstand und damit in Minuten zum Tod des Patienten führen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
