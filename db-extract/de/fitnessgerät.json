                ],
                "senses": [
                    {
                        "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                        "entry_id": "4a373e15-8c00-35b6-bcff-80a9b20b66a8",
                        "glosses": [
                            "Apparat/Vorrichtung, mit dem man seine Muskeln trainieren oder seine Ausdauerleistung verbessern kann oder das man zum Abnehmen durch Verbrennen von Körperfett benutzen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f807c362-e3ab-4198-abc7-8ee98c81517d",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "„Ich brauche ein Fitnessgerät, ich bin so schlapp.“"
                            },
                            {
                                "example_id": "44797d43-321e-455c-b39f-13b4a2162498",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "[…] mit dem Langläufer Pal Golberg lieferte sich der Kronprinz [Haakon von Norwegen] später noch einen Wettkampf auf einem Fitnessgerät."
                            },
                            {
                                "example_id": "3a3012d2-db99-415e-bcd4-379aa3fee8cb",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "Das Ziel ist für alle gleich: Mitarbeiter in Bewegung bringen. […] Dazu empfiehlt sie [Prof. C. Graf] das kleinste Fitnessgerät der Welt, den Schrittzähler."
                            },
                            {
                                "example_id": "6dce1dd0-7d8d-437d-9e62-24b12b810141",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "An fast jeder Straßenecke in Peking sieht man knallgelbe Fitnessgeräte für Laufübungen, Klimmzüge, Sit-ups und vieles mehr. Transparente fordern zum Üben auf."
                            },
                            {
                                "example_id": "7babc0da-a8da-41d5-88c6-61043c2774f3",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "Das Angebot [in einem Fitnessstudio] umfasst in der Regel Training an Fitnessgeräten wie auch betreute Kurse mit festen Start- und Endzeiten."
                            },
                            {
                                "example_id": "950d54fb-bee5-4727-8a3b-3b8dce447c0b",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "In einer Lagerhalle der Notunterkunft hat er aus Holzplatten einen abgegrenzten Raum gebaut, in dem Geflüchtete Tischtennis spielen, auf Boxsäcke eindreschen und an Fitnessgeräten „pumpen“ können."
                            },
                            {
                                "example_id": "d28e67a9-b451-459a-a48b-81babd05f922",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "Rasenplätze, eine überdachte Laufbahn, modernste Fitnessgeräte und eine Reha-Abteilung für die Arbeit mit verletzten Profis – alles steht dem Team von Trainer Ralf Rangnick [vom Fußballverein 1899 Hoffenheim] zur Verfügung."
                            },
                            {
                                "example_id": "2f197ede-704a-4960-a2ce-1c1a0c8a0a88",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "Auch Männer altern und verlieren dabei nicht nur Haare oder Zähne, sondern auch die Jugend und mit ihr die Schönheit, die bis heute untrennbar mit glatter, straffer Haut, mit Frische und Elan verbunden ist – und auf keinem Fitnessgerät der Welt zurückerobert werden kann."
                            },
                            {
                                "example_id": "6ed9e0c7-bded-489b-982d-3411e1cd0105",
                                "sense_id": "1d3ada5a-48aa-3ace-93c2-e69ea3c8b3d7",
                                "text": "Er gibt Sprach- und Computerkurse und macht Sport mit den Jugendlichen. Darüber bringt er die beiden Völker zusammen: Um zu den Fitnessgeräten zu kommen, müssen die Albaner in den serbischen Teil. Um im Internet surfen zu können, ist es andersrum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
