{
    "word_family": [
        "muscular",
        "musculature",
        "muscularity",
        "muscularly",
        "musculo-skeletal",
        "intermuscular",
        "intramuscular"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7138e778-4b9f-3e50-a02e-f16c1a59e751",
                    "sense_definition": "An organ or piece of body tissue composed of contractile fibers that produces movement in an animal body.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sharp pain in his leg <w>muscle</w> after running the marathon.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал острую боль в ножной <w>мышце</w> после марафона."
                            }
                        },
                        {
                            "text": "Regular exercise helps to build strong <w>muscles</w> and improve overall health.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения помогают нарастить крепкие <w>мускулы</w> и улучшить общее состояние здоровья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pull a muscle",
                        "sore muscles",
                        "muscle tension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Орган или часть тканей тела, состоящая из сокращающихся волокон и обеспечивающая движение у животных и человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мышца",
                                "target_lang_sense_clarification": "анатомический орган"
                            },
                            {
                                "target_lang_word": "мускул",
                                "target_lang_sense_clarification": "анатомический орган"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "515b8755-0313-39b6-a0d5-f4103e65ce75",
                    "sense_definition": "A well-developed physique where the body parts are enlarged and defined from physical exercise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bodybuilder showed off his impressive <w>muscle</w> during the competition.",
                            "target_lang_translations": {
                                "ru": "Бодибилдер демонстрировал свою впечатляющую <w>мускулатуру</w> во время соревнований."
                            }
                        },
                        {
                            "text": "It takes years of dedicated training to develop that much <w>muscle</w>.",
                            "target_lang_translations": {
                                "ru": "Требуются годы упорных тренировок, чтобы развить такие <w>мышцы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pack on muscle",
                        "lean muscle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо развитое телосложение с выраженным рельефом мышц, полученным в результате физических упражнений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мускулатура",
                                "target_lang_sense_clarification": "совокупность мышц тела"
                            },
                            {
                                "target_lang_word": "мышцы",
                                "target_lang_sense_clarification": "рельеф тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07cc9b91-93e1-3cde-8b8f-b9333421e5b2",
                    "sense_definition": "Physical power, strength, or the ability to exert influence and force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government used its political <w>muscle</w> to push the new law through parliament.",
                            "target_lang_translations": {
                                "ru": "Правительство использовало свой политический <w>вес</w>, чтобы провести новый закон через парламент."
                            }
                        },
                        {
                            "text": "The company needs more financial <w>muscle</w> to compete in the global market.",
                            "target_lang_translations": {
                                "ru": "Компании нужно больше финансовых <w>ресурсов</w>, чтобы конкурировать на мировом рынке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political muscle",
                        "financial muscle",
                        "industrial muscle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая мощь, сила или способность оказывать влияние и давление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "могущество или влияние"
                            },
                            {
                                "target_lang_word": "влияние",
                                "target_lang_sense_clarification": "способность воздействовать"
                            },
                            {
                                "target_lang_word": "мускулы",
                                "target_lang_sense_clarification": "переносное значение силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f495d03d-45d0-39c1-a5cc-2db49b3598b3",
                    "sense_definition": "People, especially hired strongmen or bodyguards, who use physical strength to protect or intimidate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang leader brought some <w>muscle</w> with him to the meeting to ensure safety.",
                            "target_lang_translations": {
                                "ru": "Главарь банды привел с собой на встречу <w>силовую поддержку</w> для обеспечения безопасности."
                            }
                        },
                        {
                            "text": "They hired extra <w>muscle</w> to stand at the door and keep uninvited guests out.",
                            "target_lang_translations": {
                                "ru": "Они наняли дополнительных <w>вышибал</w>, чтобы те стояли у двери и не пускали незваных гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hired muscle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to refer to hired security or enforcers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, специально нанятые охранники или вышибалы, использующие физическую силу для защиты или запугивания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "силовая поддержка",
                                "target_lang_sense_clarification": "нанятые люди для охраны"
                            },
                            {
                                "target_lang_word": "вышибалы",
                                "target_lang_sense_clarification": "крепкие люди для охраны"
                            },
                            {
                                "target_lang_word": "охрана",
                                "target_lang_sense_clarification": "физическая защита"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a6b3c93-b177-36d7-9746-f92089adb773",
                    "sense_definition": "To move or make progress by using physical strength or force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forceful_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>muscled</w> his way through the crowded subway station to reach the exit.",
                            "target_lang_translations": {
                                "ru": "Он <w>проложил себе путь силой</w> через переполненную станцию метро, чтобы добраться до выхода."
                            }
                        },
                        {
                            "text": "The player <w>muscled</w> past the defenders to score a brilliant goal.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>прорвался</w> сквозь защитников и забил блестящий гол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle through",
                        "muscle one's way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или прокладывать путь, используя физическую силу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладывать путь силой",
                                "target_lang_sense_clarification": "физически проталкиваться"
                            },
                            {
                                "target_lang_word": "проталкиваться",
                                "target_lang_sense_clarification": "пробиваться сквозь толпу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed827daa-bcd4-3f66-af8b-405c28dae633",
                    "sense_definition": "To force one's way into a situation or place where one is not necessarily welcome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forceful_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The larger corporation tried to <w>muscle</w> in on the small company's territory.",
                            "target_lang_translations": {
                                "ru": "Крупная корпорация попыталась <w>вклиниться</w> на территорию маленькой компании."
                            }
                        },
                        {
                            "text": "Don't try to <w>muscle</w> into a conversation that doesn't involve you.",
                            "target_lang_translations": {
                                "ru": "Не пытайся <w>влезать</w> в разговор, который тебя не касается."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle in"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'in' to describe intrusive behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вторгаться или навязываться в ситуацию или место, где человека не ждут."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вклиниваться",
                                "target_lang_sense_clarification": "бесцеремонно вмешиваться"
                            },
                            {
                                "target_lang_word": "вторгаться",
                                "target_lang_sense_clarification": "навязывать свое присутствие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}