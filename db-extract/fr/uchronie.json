                                "target_senses": [
                                    {
                                        "sense_id": "e5316cd2-467d-322f-85d3-3e7d89de76ea",
                                        "entry_id": "63f6b7cd-8495-36bd-90ba-61e34da92995",
                                        "glosses": [
                                            "Counterfactual history, a form of scientific speculation used by historians."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6550825-d007-4274-b35d-412c976f5e32",
                                                "sense_id": "e5316cd2-467d-322f-85d3-3e7d89de76ea",
                                                "text": "One of the many criticisms that can be directed at alternative historians is their failure to think historically. For alternative history, the past is not a ‘foreign country’, but rather a country that closely resembles the Russian Empire of recent times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f8d21fa-fc2c-309f-a309-8ff02330599e",
                                        "entry_id": "63f6b7cd-8495-36bd-90ba-61e34da92995",
                                        "glosses": [
                                            "A genre of fiction based around or involving ahistorical events (often occurring after a fixed point of divergence from real history)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
