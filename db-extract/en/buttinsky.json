                    {
                        "form_id": "87e56ee5-b479-409e-9d0d-780679790744",
                        "entry_id": "3988c26b-a4a9-3a1a-be76-83108b7d2861",
                        "tags": [
                            "plural"
                        ],
                        "form": "buttinskies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c94b4fb-7734-345a-922f-e3ac9c05b4ec",
                        "entry_id": "3988c26b-a4a9-3a1a-be76-83108b7d2861",
                        "glosses": [
                            "One who is prone to butt in, interrupt, or get involved where they are not welcome; a busybody."
                        ],
                        "tags": [
                            "derogatory",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "735a96dc-6a8f-4ad3-a437-b2d7cd43ef78",
                                "sense_id": "2c94b4fb-7734-345a-922f-e3ac9c05b4ec",
                                "text": "I wish I had never met that nosy buttinsky!"
                            },
                            {
                                "example_id": "6e831535-da75-41c1-ab71-c2d1e4e4e312",
                                "sense_id": "2c94b4fb-7734-345a-922f-e3ac9c05b4ec",
                                "text": "Well, all right then! If you think I'm a buttinsky, then I'll just butt in!"
                            },
                            {
                                "example_id": "84b6c8bf-0c29-40be-974c-2dcfc1c7b68a",
                                "sense_id": "2c94b4fb-7734-345a-922f-e3ac9c05b4ec",
                                "text": "\"Shut up, Garrett. I never,\" said Mr. Tallboy, extricating himself from Garrett's grasp and giving him a playful punch in the wind, \"in my life, met with such a bunch of buttinskis as you are in this department. Nothing is sacred to you, not even a man's business correspondence.\""
                            },
                            {
                                "example_id": "c90d1792-7d93-4fe9-94ba-e3eee45ba7ed",
                                "sense_id": "2c94b4fb-7734-345a-922f-e3ac9c05b4ec",
                                "text": "It is never pleasant for a man of sensibility to find himself regarded as a buttinski and a trailing arbutus, and it was thus, I could see at a g., that Wilbert Cream was pencilling me in."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ebfbe88-da2e-305d-9fd9-cb1ba3a241e4",
                        "entry_id": "3988c26b-a4a9-3a1a-be76-83108b7d2861",
                        "glosses": [
                            "A robust portable one-piece telephone instrument with clips, used by technicians and lines staff for testing telephone circuits or making a temporary connection to a telephone line."
                        ],
