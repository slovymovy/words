                "senses": [
                    {
                        "sense_id": "64f5ab71-5ca3-3d96-9dbe-695ed8b8c64c",
                        "entry_id": "9060607c-e162-31f6-b848-7a426494bef0",
                        "glosses": [
                            "Puppenbühne zur Verkehrserziehung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b88a46fb-70a8-4337-9040-009a6a71f1c1",
                                "sense_id": "64f5ab71-5ca3-3d96-9dbe-695ed8b8c64c",
                                "text": "„Als wesentliche Kriterien für gutes Verkehrstheater können daher gelten: es soll die Kinder emotional bewegen, es soll mehr als Unterhaltung bieten, es soll Lernmöglichkeiten schaffen, es soll die Kinder aktiv in das Geschehen einbeziehen, es soll Ängste aufgreifen und bewältigen helfen, es soll Aggressionen abbauen, es soll zu verkehrsgerechtem Verhalten leiten, es soll Verhaltensalternativen diskutieren und ausprobieren.“"
                            },
                            {
                                "example_id": "0d521e16-fc62-41d5-ac0d-96cdb4c365de",
                                "sense_id": "64f5ab71-5ca3-3d96-9dbe-695ed8b8c64c",
                                "text": "„Das ARBÖ ‚Puppomobil’ ist ein Verkehrstheater, welches sich an Kinder im Vor- und Volksschulalter wendet und so die Volksschulen bei der Verkehrserziehung unterstützt. […] Die Kinder werden aktiv in das Verkehrstheater einbezogen.“"
                            },
                            {
                                "example_id": "51478376-937e-4aa0-8803-6d3a2ae4d52d",
                                "sense_id": "64f5ab71-5ca3-3d96-9dbe-695ed8b8c64c",
                                "text": "„Die kleine Lena aus Geretsried kommt mit leuchtenden Augen aus der Vorstellung des Verkehrstheaters der Polizei München in der Mehrzweckhalle in Farchet.“"
                            },
                            {
                                "example_id": "7b74b95c-519b-42ae-bd45-7f75374ea241",
                                "sense_id": "64f5ab71-5ca3-3d96-9dbe-695ed8b8c64c",
                                "text": "„Die Erstklässler unserer Grundschule haben am Fr. 10. Dez. 2010 in Gengenbach das Verkehrstheater ‚Das kleine Zebra’ besucht.“"
                            },
                            {
                                "example_id": "9b1ec065-cc69-4629-9240-f312403cde23",
                                "sense_id": "64f5ab71-5ca3-3d96-9dbe-695ed8b8c64c",
                                "text": "„Schauspieler Andreas Benkwitz hat vor 17 Jahren mit dem Verkehrstheater begonnen, das Grundschulkindern in den ersten beiden Schuljahren das richtige Verhalten im Straßenverkehr zeigen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6146889e-cd18-3e92-88c0-5846cc4b83b2",
                        "entry_id": "9060607c-e162-31f6-b848-7a426494bef0",
                        "glosses": [
                            "Betriebigkeit im Verkehrsalltag, Verkehrsspektakel"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "9139d2df-3a63-46b5-87b5-a4f202b1193b",
                                "sense_id": "6146889e-cd18-3e92-88c0-5846cc4b83b2",
                                "text": "„Das Fenster meines Büros sichert mir täglich einen Logenplatz im Hamburger Verkehrstheater.“"
                            },
                            {
                                "example_id": "2bca74e3-7250-483e-b449-737de62d0c23",
                                "sense_id": "6146889e-cd18-3e92-88c0-5846cc4b83b2",
                                "text": "„Die größte Freude scheinen dabei quietschende Reifen und ein röhrender Motor auszulösen. Das Ehepaar Palm hat genau hier ein Modegeschäft und erlebt dabei täglich das Verkehrstheater.“"
                            },
                            {
                                "example_id": "e2ce4ca3-5403-4a34-b453-ce21ba3c4dee",
                                "sense_id": "6146889e-cd18-3e92-88c0-5846cc4b83b2",
                                "text": "„Den U-Bahnhof Alexanderplatz gestaltet er gewissermaßen als grandioses Verkehrstheater.“"
                            },
                            {
                                "example_id": "ecde660c-cc06-41bc-8d31-ae4b76a479af",
                                "sense_id": "6146889e-cd18-3e92-88c0-5846cc4b83b2",
                                "text": "„Die von dem Kulturgeografen Yu-Fu-Tuan ausgearbeitete Kategorie der Topophilie soll in dieser Hinsicht erweitert werden: Topophilie bezeichnet nicht nur […] den Ort selbst, als Verkehrstheater und Hüter der Erinnerung, sondern vor allem einen gelebten Ort, der Teil unserer existentiellen Sphäre und unserer Spiritualität wird.“"
                            },
                            {
                                "example_id": "799b22ef-81e3-43cd-ab3b-fc909d7e09f5",
                                "sense_id": "6146889e-cd18-3e92-88c0-5846cc4b83b2",
                                "text": "„Während der letzten zehn Kilometer hörte das Verkehrstheater Gott sei Dank auf, und ich konnte meinen Marsch wesentlich bequemer fortsetzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
