                    {
                        "sense_id": "8c42f473-ddc9-30ce-897b-f4dfb77acc5a",
                        "entry_id": "aad63eda-b935-3302-baa6-672a20cb7ba9",
                        "glosses": [
                            "Acorus calamus een vaste moerasplant uit de familie Acoraceae, waarvan de wortelstok als smaakmaker dient. De plant heeft een stevige, lange wortelstok met zachte wortels. De wortelstok kruipt dicht langs het grondoppervlak. Deze produceert tot één meter lange, zwaardvormige, rechtopstaande bladeren en een alleenstaande, rechtopstaande bloemstengel. De vorm van de bloemstengel lijkt op die van het blad. Aan de bloemstengel groeit de bloeikolf, die uit de zijkant van de stengel lijkt te komen. De bloeikolf bestaat uit dicht opeen staande, kleine, geelgroene bloemen. De vruchten zijn rode bessen met meerdere zaden. De plant vermeerdert zich niet alleen via geslachtelijke voortplanting maar kan zich ook via vegetatieve voortplanting vermeerderen door onderaardse uitlopers die uit de wortelstok ontspringen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dcf96f1-0404-4f0f-b8b7-070e0f0e490e",
                        "source_entry_id": "aad63eda-b935-3302-baa6-672a20cb7ba9",
                        "source_sense_id": "8c42f473-ddc9-30ce-897b-f4dfb77acc5a",
                        "target_lang_word": "Kalmus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                        "entry_id": "ded09ce8-95fb-3579-8b64-60d9d1a67d72",
                                        "glosses": [
                                            "schilfartige Sumpfpflanze, aus deren aromatisch riechendem Wurzelstock (Rhizom) ein Öl gewonnen wird (Acorus calamus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af34d29-39f0-431d-a949-0660b9b7b394",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Ein Drittel des Teiches ist von Schilf, Kalmus, Schwertlilie, Rohr und Pumpkeule erfüllt, die ein undurchdringliches Dickicht bilden.“"
                                            },
                                            {
                                                "example_id": "59003463-88e7-4167-b109-940200da7ff8",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Um den See herum breitet sich Ödland mit versteckten, halb zugewachsenen Tümpeln aus, Bäume und Sträucher, die niemand zurechtstutzt, Schilf, Kalmus, gelbe Schwertlilien, dichtes Brombeergestrüpp, seltene Pflanzen; im Quellwasser sprießt die Brunnenkresse.“"
                                            },
                                            {
                                                "example_id": "c755060e-b7f4-4457-93f6-cf8616e74f2d",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Draußen aber fuhr Wolf einen großen Wagen mit Binsen und Kalmus heran, den er am Ufer des nahen Teiches geschnitten, um den Fußboden zu bestreuen.“"
                                            },
                                            {
                                                "example_id": "e9e300c0-c2e0-4b99-b704-1de824a4f17a",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Über den Wipfeln des westliche Haines winket uns freundlich der rötliche Schein./Unter den Zweigen des östlichen Haines säuselt der Kalmus im rötlichen Schein…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
