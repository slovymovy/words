                                        "entry_id": "28a1f59b-d067-31c6-9165-c7b9af8ef270",
                                        "glosses": [
                                            "Attitudes or beliefs that privilege cisgender people or perspectives over transgender ones."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283c0837-6d51-410f-82af-ee6ff4b2c10d",
                                                "sense_id": "60ede91e-d44d-3057-85f7-f7947b2e905d",
                                                "text": "Confronting cisgenderism means asking our colleagues aloud why intersex babies' genitals are still being surgically altered at birth far below the age of informed consent, while women like Charlotte are routinely denied these surgeries."
                                            },
                                            {
                                                "example_id": "4f8cf6c9-fe57-4d4c-b32e-d9ac0798fafe",
                                                "sense_id": "60ede91e-d44d-3057-85f7-f7947b2e905d",
                                                "text": "Such assumptions can motivate expressions of cisgenderism such as retroactive misgendering (in which a person's past is described using language that disregards or contrasts with their current designation of their gender) […]"
                                            },
                                            {
                                                "example_id": "20a28325-3109-469c-871b-d2ba70bea1bf",
                                                "sense_id": "60ede91e-d44d-3057-85f7-f7947b2e905d",
                                                "text": "While cisgenderism may manifest as individual instances of prejudice and discrimination, it is rooted in systemic practices and ideology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
