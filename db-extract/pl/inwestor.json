                ],
                "senses": [
                    {
                        "sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                        "entry_id": "b7293669-cfb6-3803-bb9d-b9b93dd0dc36",
                        "glosses": [
                            "osoba lub firma/spółka dokonująca inwestycji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0181e4f-e9c3-47de-ac02-5f850fd05948",
                                "sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                                "text": "Od kilku lat Dania należy do największych inwestorów zagranicznych w Polsce"
                            },
                            {
                                "example_id": "3c311b4b-44be-4fb4-8f56-e2df0aad0a67",
                                "sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                                "text": "Dlaczego wielu inwestorów traci na giełdzie?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37351874-98ef-4b60-b793-628e6d6fd3d7",
                        "source_entry_id": "b7293669-cfb6-3803-bb9d-b9b93dd0dc36",
                        "source_sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                        "target_lang_word": "investor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                        "entry_id": "30b3f798-5f3c-30f1-8b99-8f5f07783ecf",
                                        "glosses": [
                                            "A person who invests money in order to make a profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f98171-9da7-4430-9775-7ea0b7d6a443",
                                                "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                                "text": "[…] (it was the town's humour to be always gassing of phantom investors who were likely to come any moment and pay a thousand prices for everything) — “[…] Them rich fellers, they don't make no bad breaks with their money. […]”"
                                            },
                                            {
                                                "example_id": "002cc0b8-22e2-4e5b-ad33-4c14c1130acf",
                                                "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            },
                                            {
                                                "example_id": "2312f782-7b12-4ee0-9355-629d2e613dd4",
                                                "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                                "text": "So investors buy stablecoins not to make a profit but instead as a place to store money within the cryptocurrency infrastructure and to use when buying and selling other crypto assets. […] For example, the Commodity Futures Trading Commission asserted that for nearly four years Tether did not fully back its stablecoin with US dollars, meaning it did not have enough US dollars on hand to pay back every investor who potentially might cash out their Tether stablecoins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad71d47f-9ce1-44a9-83e1-225278af7fe0",
                        "source_entry_id": "b7293669-cfb6-3803-bb9d-b9b93dd0dc36",
                        "source_sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                        "target_lang_word": "investisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07ea1a59-7448-38af-8030-fbc0c0728b7a",
                                        "entry_id": "23d1cc19-bd51-3b40-99da-349ebab5c631",
                                        "glosses": [
                                            "Qui investit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c6795e-66ca-4a0b-8e70-1fe178d4b34d",
                                                "sense_id": "07ea1a59-7448-38af-8030-fbc0c0728b7a",
                                                "text": "La perte des processus décisionnels, notamment de la stratégie d’entreprise, peut en effet freiner l’engouement de la société investisseuse."
                                            },
                                            {
                                                "example_id": "96b90743-d5e0-455e-b32c-29955ce0ce04",
                                                "sense_id": "07ea1a59-7448-38af-8030-fbc0c0728b7a",
                                                "text": "« Il existe une perception largement répandue selon laquelle les sociétés investisseuses nuisent au logement abordable, mais le gouvernement fédéral n’investit pas de manière significative dans les locations, donc quelqu’un doit intervenir et résoudre le problème », a affirmé Mme Heaps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "investisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e421ff83-5a45-3e45-9cd6-d529da49fe88",
                                        "entry_id": "c1d395e2-70af-301c-b53b-6a97de1a13a6",
                                        "glosses": [
                                            "Personne physique ou morale (société, organisme, collectivité, etc.) qui investit des capitaux dans un secteur économique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0428e4c4-d2f9-4a6e-b237-20b92630d3cf",
                                                "sense_id": "e421ff83-5a45-3e45-9cd6-d529da49fe88",
                                                "text": "Dans tous les cas, ne perdez pas de vue l’essentiel : le plus important est de choisir un investisseur aligné sur vos valeurs, disponible pour votre entreprise et qui comprend votre projet stratégique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c5d2ee8-d6b4-4a1c-ab66-7fdacc77655e",
                        "source_entry_id": "b7293669-cfb6-3803-bb9d-b9b93dd0dc36",
                        "source_sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                        "target_lang_word": "inversor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5e07d57c-2588-4370-b76a-b1d111d78c6c",
                        "source_entry_id": "b7293669-cfb6-3803-bb9d-b9b93dd0dc36",
                        "source_sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                        "target_lang_word": "inversionista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3b495050-f7a2-4aa8-b82c-9652be4cf04b",
                        "source_entry_id": "b7293669-cfb6-3803-bb9d-b9b93dd0dc36",
                        "source_sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
                        "target_lang_word": "Investor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Investor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d014bbe0-98d6-333f-b83e-61e3a5038ea0",
                                        "entry_id": "49f29875-d5b5-3c4b-9cde-3d3fc4454b18",
                                        "glosses": [
                                            "jemand, der investiert, der Geld (am Kapitalmarkt) anlegt, um Gewinn zu erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dff83e3-c565-486a-9cc1-9e526ed25139",
                                                "sense_id": "d014bbe0-98d6-333f-b83e-61e3a5038ea0",
                                                "text": "Mehr als ein halbes Dutzend Investoren interessiert sich für einen Einstieg beim krisengeschüttelten Autobauer Opel."
                                            },
                                            {
                                                "example_id": "bd048499-6dd7-45bc-9a89-f330db69d627",
                                                "sense_id": "d014bbe0-98d6-333f-b83e-61e3a5038ea0",
                                                "text": "„Und dann ist da noch die südsudanesische Arbeitsmoral, sehr abschreckend für Investoren.“"
                                            },
                                            {
                                                "example_id": "4d1b6895-ceb8-4b4c-9b40-2ed40e358eb8",
                                                "sense_id": "d014bbe0-98d6-333f-b83e-61e3a5038ea0",
                                                "text": "„Bislang erzielten Investoren mit kurzfristigen Anlagen so hohe Renditen, dass sie keinen Anreiz hatten, in längerfristige Infrastrukturprojekte einzusteigen.“"
                                            },
                                            {
                                                "example_id": "ac77607a-3b70-4aa8-90e9-4d676cd890fe",
                                                "sense_id": "d014bbe0-98d6-333f-b83e-61e3a5038ea0",
                                                "text": "„Nirgendwo sind Investoren aus dem In- und Ausland so aktiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d84add-da24-4695-acf5-bf20f65065fd",
                        "source_entry_id": "b7293669-cfb6-3803-bb9d-b9b93dd0dc36",
                        "source_sense_id": "8dfdb798-39f4-35b6-9fbd-82111eb7ebbd",
