{
    "word_family": [
        "clear",
        "clearing",
        "clearly",
        "clearness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59b6043e-ed7e-3e0f-8777-2ab99a741d5e",
                    "sense_definition": "A sale of merchandise at reduced prices to make room for new stock.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought these shoes at a huge discount during the end-of-season <w>clearance</w>.",
                            "target_lang_translations": {
                                "ru": "Я купил эти туфли с огромной скидкой во время сезонной <w>распродажи</w>."
                            }
                        },
                        {
                            "text": "The store is having a <w>clearance</w> sale to get rid of last year's models.",
                            "target_lang_translations": {
                                "ru": "Магазин проводит <w>распродажу</w>, чтобы избавиться от моделей прошлого года."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clearance sale",
                        "stock clearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продажа товаров по сниженным ценам для освобождения места для новых поступлений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распродажа",
                                "target_lang_sense_clarification": "сбыт товара по сниженным ценам"
                            },
                            {
                                "target_lang_word": "ликвидация",
                                "target_lang_sense_clarification": "полная распродажа остатков товара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8255d9d1-b6ac-3c81-8c63-aaa5fcce9506",
                    "sense_definition": "Official permission for a vehicle to proceed or for a person to travel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot waited for <w>clearance</w> from the tower before starting the takeoff.",
                            "target_lang_translations": {
                                "ru": "Пилот ждал <w>разрешения</w> от диспетчерской вышки перед началом взлета."
                            }
                        },
                        {
                            "text": "The plane got <w>clearance</w> from air traffic control and we were finally off.",
                            "target_lang_translations": {
                                "ru": "Самолет получил <w>разрешение</w> от авиадиспетчеров, и мы наконец взлетели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get clearance",
                        "air traffic clearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение транспортному средству на движение или человеку на поездку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "официальное позволение на движение"
                            },
                            {
                                "target_lang_word": "допуск",
                                "target_lang_sense_clarification": "право на проезд или проход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e239b153-0800-3ee9-a982-5cf5f9a24d74",
                    "sense_definition": "The physical space or gap between two objects, such as a vehicle and a bridge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The truck was too tall and did not have enough <w>clearance</w> to pass under the bridge.",
                            "target_lang_translations": {
                                "ru": "Грузовик был слишком высоким, и ему не хватило <w>просвета</w>, чтобы проехать под мостом."
                            }
                        },
                        {
                            "text": "The new bridge will have sufficient height to allow <w>clearance</w> for the passage of canal traffic.",
                            "target_lang_translations": {
                                "ru": "Новый мост будет иметь достаточную высоту, чтобы обеспечить свободный <w>проход</w> судов по каналу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ground clearance",
                        "low clearance",
                        "sufficient clearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое пространство или зазор между двумя объектами, например, между транспортным средством и мостом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просвет",
                                "target_lang_sense_clarification": "свободное пространство между объектами"
                            },
                            {
                                "target_lang_word": "зазор",
                                "target_lang_sense_clarification": "щель или расстояние между деталями"
                            },
                            {
                                "target_lang_word": "клиренс",
                                "target_lang_sense_clarification": "дорожный просвет автомобиля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff8718df-dd8c-3236-ae8b-454baa665dc6",
                    "sense_definition": "Official authorization to have access to classified or secret information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need a high-level security <w>clearance</w> to enter this part of the government building.",
                            "target_lang_translations": {
                                "ru": "Вам нужен высокий уровень <w>допуска</w> к секретной информации, чтобы войти в эту часть правительственного здания."
                            }
                        },
                        {
                            "text": "He established his legend as an insider with top security <w>clearance</w> who knew the truth.",
                            "target_lang_translations": {
                                "ru": "Он создал себе репутацию осведомленного человека с высшим <w>допуском</w>, который знал правду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "security clearance",
                        "top-secret clearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение на доступ к секретной или конфиденциальной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допуск",
                                "target_lang_sense_clarification": "право доступа к секретным сведениям"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "официальная авторизация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a92657a-d3da-3f97-b68c-0c376d5b0dff",
                    "sense_definition": "The act of removing things from a place or the empty space that is created.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clearance</w> of the forest was necessary to build the new highway through the valley.",
                            "target_lang_translations": {
                                "ru": "<w>Расчистка</w> леса была необходима для строительства нового шоссе через долину."
                            }
                        },
                        {
                            "text": "After the <w>clearance</w> of the old furniture, the room looked much larger and brighter.",
                            "target_lang_translations": {
                                "ru": "После <w>удаления</w> старой мебели комната стала выглядеть намного больше и светлее."
                            }
                        }
                    ],
                    "synonyms": [
                        "clearing"
                    ],
                    "common_phrases": [
                        "slum clearance",
                        "land clearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по удалению предметов из какого-либо места или созданное в результате этого пустое пространство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчистка",
                                "target_lang_sense_clarification": "освобождение территории от чего-либо"
                            },
                            {
                                "target_lang_word": "очистка",
                                "target_lang_sense_clarification": "удаление ненужных элементов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "722de17f-bf94-35e8-bf87-a8d5c9bc3352",
                    "sense_definition": "In sports, the act of kicking or hitting a ball away from the goal area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defender made a desperate <w>clearance</w> just before the striker could reach the ball.",
                            "target_lang_translations": {
                                "ru": "Защитник совершил отчаянный <w>вынос</w> мяча прямо перед тем, как нападающий смог до него добраться."
                            }
                        },
                        {
                            "text": "The team conceded a goal following a poor attempted <w>clearance</w> by the goalkeeper.",
                            "target_lang_translations": {
                                "ru": "Команда пропустила гол после неудачной попытки вратаря <w>выбить</w> мяч."
                            }
                        }
                    ],
                    "common_phrases": [
                        "defensive clearance",
                        "poor clearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "В спорте: удар по мячу с целью выбить его подальше от своих ворот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынос",
                                "target_lang_sense_clarification": "удар мяча от ворот в футболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9638deec-3ba4-3496-aafa-61f7af51d15c",
                    "sense_definition": "The process by which banks or financial institutions settle transactions and exchange payments.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank requires three business days for the <w>clearance</w> of international checks.",
                            "target_lang_translations": {
                                "ru": "Банку требуется три рабочих дня для <w>клиринга</w> международных чеков."
                            }
                        },
                        {
                            "text": "The central bank manages the <w>clearance</w> of payments between all major commercial banks.",
                            "target_lang_translations": {
                                "ru": "Центральный банк управляет <w>расчетами</w> по платежам между всеми крупными коммерческими банками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "check clearance",
                        "clearance house"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical financial term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, посредством которого банки или финансовые учреждения проводят расчеты по транзакциям и обмениваются платежами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиринг",
                                "target_lang_sense_clarification": "система безналичных расчетов"
                            },
                            {
                                "target_lang_word": "очистка",
                                "target_lang_sense_clarification": "завершение финансовых операций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d68aa856-0e72-3666-afdc-5946e3704499",
                    "sense_definition": "The rate at which a substance is removed from the blood by the kidneys.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors monitored the patient's renal <w>clearance</w> to check how well the kidneys were functioning.",
                            "target_lang_translations": {
                                "ru": "Врачи следили за почечным <w>клиренсом</w> пациента, чтобы проверить, насколько хорошо функционируют почки."
                            }
                        },
                        {
                            "text": "The drug's <w>clearance</w> rate was slower in older patients, requiring a lower dosage.",
                            "target_lang_translations": {
                                "ru": "Скорость <w>выведения</w> препарата была ниже у пожилых пациентов, что требовало меньшей дозировки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "renal clearance",
                        "creatinine clearance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорость, с которой вещество выводится из крови почками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиренс",
                                "target_lang_sense_clarification": "показатель очищения биологических жидкостей"
                            },
                            {
                                "target_lang_word": "очищение",
                                "target_lang_sense_clarification": "процесс выведения веществ из организма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}