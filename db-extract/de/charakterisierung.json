                "senses": [
                    {
                        "sense_id": "32970b62-8ee3-3ac9-80a3-7c6c592d624f",
                        "entry_id": "cef7d643-8b3f-31d4-ad71-457547184af1",
                        "glosses": [
                            "Hervorhebung besonders typischer Eigenschaften; das Charakterisieren oder auch das Charakterisiertwerden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a40c9fcc-7993-43f2-b47b-bda49ef45f15",
                                "sense_id": "32970b62-8ee3-3ac9-80a3-7c6c592d624f",
                                "text": "Die Charakterisierung eines Objektes gibt Aufschluss über seine Eigenschaften."
                            },
                            {
                                "example_id": "293f40fb-e1ef-4271-adc4-f919a26a3c45",
                                "sense_id": "32970b62-8ee3-3ac9-80a3-7c6c592d624f",
                                "text": "„Die Charakterisierung Carmens in dem stilistisch nicht sehr subtilen Werk wird auf Standardelemente konzentriert.“"
                            },
                            {
                                "example_id": "a8bdf7ce-96f9-4812-ac4f-f60056ae7fc4",
                                "sense_id": "32970b62-8ee3-3ac9-80a3-7c6c592d624f",
                                "text": "„Diese positive Charakterisierung von Häftling 594 teilten seine Mithäftlinge nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ef845d6-58f1-4960-8b1b-8836a66156e3",
                        "source_entry_id": "cef7d643-8b3f-31d4-ad71-457547184af1",
                        "source_sense_id": "32970b62-8ee3-3ac9-80a3-7c6c592d624f",
                        "source_sense_description": "Hervorhebung besonders typischer Eigenschaften",
                        "target_lang_word": "characterization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "characterization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                        "entry_id": "4bc93003-e203-3651-9244-9438f873b2f6",
                                        "glosses": [
                                            "The act or process of characterizing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fdc66b-14ae-4a11-ab05-ceb95e4a2523",
                                                "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                                "text": "Near-synonyms: portrayal, representation; definition"
                                            },
                                            {
                                                "example_id": "1c1100c5-0fb8-413b-ae9e-0d79a3f897c4",
                                                "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                                "text": "It was while he was performing the duties of the store that he acquired the soubriquet \"Honest Abe\"--a characterization that he never dishonored, and an abbreviation that he never outgrew."
                                            },
                                            {
                                                "example_id": "d8784393-64f0-4b17-b450-59861fb77852",
                                                "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                                "text": "The art of characterization exhibited by the author fascinates us; we gaze and examine as if we were face to face with real personages, whose passions are laid bare, whose life is traced, whose countenance is portrayed with miraculousness, distinctness and verisimilitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
