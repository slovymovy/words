                "senses": [
                    {
                        "sense_id": "2dcd921e-a7f8-3750-9277-9ead0811c774",
                        "entry_id": "f1b51a3c-303a-3387-82b8-d22cbd6750c1",
                        "glosses": [
                            "Redéfinir le contour de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e130b2-8570-41d3-81f7-8133ea041a7c",
                                "sense_id": "2dcd921e-a7f8-3750-9277-9ead0811c774",
                                "text": "L'invention concerne un procédé pour recontourer une ailette de compresseur ou de turbine (1) pour une turbine à gaz, l'arête d'entrée (2) de l'ailette de compresseur ou de turbine (1) étant fondue de façon appropriée au moins dans une plage partielle par un jet d'énergie (8), de sorte que le matériau soit solidifié en un nouveau contour (5) principalement sans l'addition de matériau supplémentaire."
                            },
                            {
                                "example_id": "5a8ba37e-e897-4b69-b5fa-df11823107a8",
                                "sense_id": "2dcd921e-a7f8-3750-9277-9ead0811c774",
                                "text": "Recontourer les tissus pour créer un environnement favorable à la réalisation d'une prothèse."
                            },
                            {
                                "example_id": "b59cc60d-e99f-448c-b455-a04da01a0aa9",
                                "sense_id": "2dcd921e-a7f8-3750-9277-9ead0811c774",
                                "text": "L'objectif n'est pas de recontourer les objets mis en évidence mais bien de localiser les zones où un éventuel recontourage sera possible (étude quantitative)."
                            }
                        ]
                    }
                ],
