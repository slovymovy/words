                    },
                    {
                        "form_id": "d2519761-6a69-43ed-8ff6-91a70bf8a741",
                        "entry_id": "563d93e3-5561-3c0d-94c1-07121d70aa53",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "egoportrait"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14b696b5-b16a-3878-a54d-306860a5bad0",
                        "entry_id": "563d93e3-5561-3c0d-94c1-07121d70aa53",
                        "glosses": [
                            "Autoportrait fait à l’aide d’un appareil photo ou d’un photophone, en général pour le publier sur un réseau social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52011d7a-083d-46a7-a2f1-f21090800418",
                                "sense_id": "14b696b5-b16a-3878-a54d-306860a5bad0",
                                "text": "L’égoportrait est une autre façon de dire que l’on existe dans des univers où cette urgence d’exister est devenue une maladie, au sens figuré s’entend."
                            },
                            {
                                "example_id": "28090477-3e4b-47e7-aa93-fac42a1753ed",
                                "sense_id": "14b696b5-b16a-3878-a54d-306860a5bad0",
                                "text": "Il est interdit de prendre un égoportrait (selfie) ou une photo de son bulletin de vote derrière l’isoloir, mais ce n’est pas un acte carrément illégal, selon le Directeur général des élections du Québec (DGEQ)."
                            },
                            {
                                "example_id": "943a6caa-c736-4e09-a3d2-4433d96e15b3",
                                "sense_id": "14b696b5-b16a-3878-a54d-306860a5bad0",
                                "text": "La police indienne a jugé qu'il était inapproprié pour un homme et une femme de prendre des égoportraits ensemble s'ils ne sont pas mariés. Pourquoi? En raison de leur proximité dans la photo."
                            },
                            {
                                "example_id": "7e901427-cc25-4361-bad0-422ae0afecc8",
                                "sense_id": "14b696b5-b16a-3878-a54d-306860a5bad0",
                                "text": "Chaque jour, environ 20,000 personnes se pressent dans la Salle des États, la plus grande salle du musée, juste pour prendre un égoportrait avec la femme énigmatique peinte par Léonard de Vinci, cachée derrière une vitre de protection."
                            }
                        ]
                    }
