                "senses": [
                    {
                        "sense_id": "e830da90-2f25-34d1-84da-779dd57e6785",
                        "entry_id": "78d5347c-6db1-3467-82b7-71a5065490eb",
                        "glosses": [
                            "зоол. крупная рыба семейства калкановых отряда камбалообразных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a36b925f-3fbd-4ec0-899d-2f56c4bfb532",
                                "sense_id": "e830da90-2f25-34d1-84da-779dd57e6785",
                                "text": "Калкан — ценная промысловая рыба с вкусным мясом, его промышляют ставными сетями и ярусами."
                            }
                        ]
                    },
                    {
                        "sense_id": "b79f54bb-8f15-33d6-8c89-9be22904cf55",
                        "entry_id": "78d5347c-6db1-3467-82b7-71a5065490eb",
                        "glosses": [
                            "диал., разг. жировой нарост на затылке у животного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce72f623-405b-4171-bb34-e930f1127bd1",
                                "sense_id": "b79f54bb-8f15-33d6-8c89-9be22904cf55",
                                "text": "― У атамана-то волчий ожерелок, ишь голову не повернет. ― Калкан нажрал, боров, дьявол!"
                            }
                        ]
                    }
                ],
