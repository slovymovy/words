                    {
                        "sense_id": "99e159f3-383f-33ac-970b-df7cc1b88fa1",
                        "entry_id": "772d6d5f-3b42-3c2a-849f-a13cb3521d4b",
                        "glosses": [
                            "de vaak pijnlijke gevolgen van een blootstelling van de huid aan een te grote dosis ultraviolet licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c41374-e1ed-4ed6-aefe-a87012b11022",
                                "sense_id": "99e159f3-383f-33ac-970b-df7cc1b88fa1",
                                "text": "Als je je niet insmeert heb je dadelijk last van zonnebrand."
                            }
                        ]
                    },
                    {
                        "sense_id": "7444b95e-73ad-36a6-b186-973a33456886",
                        "entry_id": "772d6d5f-3b42-3c2a-849f-a13cb3521d4b",
