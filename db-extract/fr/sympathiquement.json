                "forms": [],
                "senses": [
                    {
                        "sense_id": "361e465e-bfc6-3d71-aeb8-18222ccaff50",
                        "entry_id": "bd260c27-ea50-3ce7-9529-3dc4126dbd6e",
                        "glosses": [
                            "D'une manière sympathique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce79c6b-606b-4c5a-8bfd-54dd33cbf45c",
                                "sense_id": "361e465e-bfc6-3d71-aeb8-18222ccaff50",
                                "text": "Là, sans qu’il s'en doutât, je me suis sentie éprise de lui sympathiquement à la première vue."
                            },
                            {
                                "example_id": "86843741-10c0-4306-9170-6fa2de00d818",
                                "sense_id": "361e465e-bfc6-3d71-aeb8-18222ccaff50",
                                "text": "Il ne chercha point à cacher son émotion, il prit la main que lui tendait le chasseur Marbre et la serra sympathiquement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6572d742-c7d4-4549-8ded-5e1a7cd082fa",
                        "source_entry_id": "bd260c27-ea50-3ce7-9529-3dc4126dbd6e",
                        "source_sense_id": "361e465e-bfc6-3d71-aeb8-18222ccaff50",
                        "target_lang_word": "sympathetically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sympathetically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c87aa08-7ab9-325b-8eb3-de030526061e",
                                        "entry_id": "9a882468-0197-307a-8806-c234b2f8a510",
                                        "glosses": [
                                            "Owing to or showing evidence of sympathy, or affinity; happening through or demonstrating correspondences, whether occult or physiological."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a66a04-73a1-456d-a630-9657d0ca05ed",
                                                "sense_id": "0c87aa08-7ab9-325b-8eb3-de030526061e",
                                                "text": "I feel sure that here before me were assembled those, in whose unhealing hearts the sight of those bleak tablets sympathetically caused the old wounds to bleed afresh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c279e7b-a646-3599-84a1-77a2900a2b64",
                                        "entry_id": "9a882468-0197-307a-8806-c234b2f8a510",
                                        "glosses": [
                                            "In a manner which demonstrates a sharing in the feelings of others; compassionately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ac3c69-0e6e-4bdc-b87d-e4b3c7b71bf5",
                                                "sense_id": "7c279e7b-a646-3599-84a1-77a2900a2b64",
                                                "text": "Still she didn't stir, so he patted her shoulder and added sympathetically, 'Come now, don't take it so much to heart.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
