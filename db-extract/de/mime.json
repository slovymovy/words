                ],
                "senses": [
                    {
                        "sense_id": "87dbe4c2-3fca-33a2-b5fa-6cb2ac719dff",
                        "entry_id": "dc5e859e-d2e9-3afd-bec7-4e325c68e711",
                        "glosses": [
                            "Schauspieler, Bühnenkünstler"
                        ],
                        "tags": [
                            "humorous",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "9cf285d5-aa81-4d87-8afe-f5476f2de0d5",
                                "sense_id": "87dbe4c2-3fca-33a2-b5fa-6cb2ac719dff",
                                "text": "Der große alte Mime zieht immer noch die Zuschauer in seinen Bann."
                            },
                            {
                                "example_id": "93d9f4b1-5c66-46c5-b8ad-4785fe8d83f9",
                                "sense_id": "87dbe4c2-3fca-33a2-b5fa-6cb2ac719dff",
                                "text": "„Denn bei meinen Recherchen fand ich heraus, dass Johann Wolfgang von Goethe, von 1791 bis 1817 Hoftheaterdirektor in Weimar, 1803 »Regeln für Schauspieler« verfasst hat, die von seinen Miminnen und Mimen streng befolgt werden mussten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e420719f-0877-4ccf-8d23-f3d85ad0547b",
                        "source_entry_id": "dc5e859e-d2e9-3afd-bec7-4e325c68e711",
                        "source_sense_id": "87dbe4c2-3fca-33a2-b5fa-6cb2ac719dff",
                        "source_sense_description": "veraltet, scherzhaft: Schauspieler, Bühnenkünstler",
                        "target_lang_word": "mime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42dac01f-08b9-3c6c-8543-9784a7f1ba8c",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A form of acting without words; pantomime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b82aff-5117-4454-8b29-581e7f075ef2",
                                                "sense_id": "42dac01f-08b9-3c6c-8543-9784a7f1ba8c",
                                                "text": "[Silence] demands returning to the self, to innocence and a a portrayal of situations as if all the particulars were completely unknown to the viewer. There are no props but the muscular versatility of the human form. Mime is the one thing that truly proves we can be all things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa8bb5e-4c35-38de-8784-e0a5325539d6",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A pantomime actor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3d1f9da-6e53-36f8-978d-a9947963b03c",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A classical theatrical entertainment in the form of farce."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c07f2ee-3916-4522-980e-b1b39a0f00ad",
                                                "sense_id": "a3d1f9da-6e53-36f8-978d-a9947963b03c",
                                                "text": "The mimes were packed with lascivious gestures and movements, and usually presented erotic scenes, on occasion farcically treated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67cbb7b8-2bc1-3d5a-952c-c94d0dc06dba",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A performer of such a farce."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4454a042-0d6b-3dfd-99a2-bd75c5bdcb41",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A person who mimics others in a comical manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa24a89d-b7ce-37cf-9699-c8fa680da7f3",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "Any of various papilionid butterflies of the genus Chilasa or Papilio, that mimic other species in appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d181e168-1727-3038-bc40-f888ba9b9ce7",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
