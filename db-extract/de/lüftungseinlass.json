                "senses": [
                    {
                        "sense_id": "b248e6a0-b51e-358f-97b0-e91788d01004",
                        "entry_id": "8e12815a-f7b1-3e51-b490-05b323dbd48c",
                        "glosses": [
                            "Öffnung, durch die Luft eintreten, abströmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8f381e-8dd4-4d70-93ba-8f525461d467",
                                "sense_id": "b248e6a0-b51e-358f-97b0-e91788d01004",
                                "text": "„Aus Angst vor Giftgas, das schwerer war als Luft, wurden bei den Bunkern die Lüftungseinlässe sehr hoch angebracht.“"
                            },
                            {
                                "example_id": "44d6b34d-e2d7-44a2-b6fd-69f66d224cfc",
                                "sense_id": "b248e6a0-b51e-358f-97b0-e91788d01004",
                                "text": "„Dazwischen kann auch ein Lüftungseinlass mit Aussenluft vorgesehen werden, oder auch ein Wärmetauscher, welcher der Abluft die Wärme entzieht, bevor sie in den Aussenbereich entlassen wird.“"
                            },
                            {
                                "example_id": "0ecd5df6-275e-4322-86de-81ae3d7e6b16",
                                "sense_id": "b248e6a0-b51e-358f-97b0-e91788d01004",
                                "text": "„Das heißt, je geringer die Temperaturspreizung, also der Temperaturunterschied zwischen Lüftungseinlass und Lüftungsauslass des IT-Equipments, desto mehr Luft muss herangeführt werden.“"
                            },
                            {
                                "example_id": "926f0d42-2fa4-4648-91ef-9f9e810f851c",
                                "sense_id": "b248e6a0-b51e-358f-97b0-e91788d01004",
                                "text": "„In bevorzugter Ausgestaltung der Erfindung ist vorgesehen, dass der von außen zugängliche und von einem Fahrzeugteil überdeckte Raum des Kraftfahrzeugs ein Radkasten, ein Lüftungseinlass oder dergleichen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
