        "fr-extract.jsonl": [
            {
                "entry_id": "75b53010-164e-30ea-a606-23a9bc817c70",
                "word": "indéfiniment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "848c5ffa-73c9-32f9-b57d-e5401f20c218",
                        "entry_id": "75b53010-164e-30ea-a606-23a9bc817c70",
                        "glosses": [
                            "D’une manière indéfinie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6ac8589-bcd0-4f19-828c-cb2e9e8c1ac8",
                                "sense_id": "848c5ffa-73c9-32f9-b57d-e5401f20c218",
                                "text": "La pauvreté de leur vie, […], le frappa : le service machinal, un petit nombre de mouvements et de gestes toujours les mêmes à répéter indéfiniment, par crainte d'abord, puis par habitude."
                            },
                            {
                                "example_id": "92a9d451-ad63-4206-a6df-4cde2ed49767",
                                "sense_id": "848c5ffa-73c9-32f9-b57d-e5401f20c218",
                                "text": "Certains « on dit » circulent, s'amplifient, se font écho à eux-mêmes indéfiniment, sans avoir cependant de substance réelle."
                            },
                            {
                                "example_id": "0ec5ced2-b2d1-4516-80fa-86bde85dbdec",
                                "sense_id": "848c5ffa-73c9-32f9-b57d-e5401f20c218",
                                "text": "M'étant proposé l’objet des géomètres, que je concevais comme un corps continu ou un espace indéfiniment étendu en longueur, largeur et hauteur ou profondeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ebee6f5-b32b-3991-b739-6a20f549194d",
                        "entry_id": "75b53010-164e-30ea-a606-23a9bc817c70",
                        "glosses": [
                            "Dans un sens indéfini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46bc0449-47fe-41ee-bb2b-d4d7c14d07d1",
                                "sense_id": "7ebee6f5-b32b-3991-b739-6a20f549194d",
                                "text": "On dit, par exemple, qu’un homme a été traité avec honneur : comme il ne s’agit pas de spécifier l’honneur particulier qu’on lui a rendu, on n'y met point d’article ; honneur est pris indéfiniment."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9390474-1220-3122-ad40-49a503ddd3c2",
                        "entry_id": "75b53010-164e-30ea-a606-23a9bc817c70",
                        "glosses": [
                            "Perpétuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd12ed0-4983-44f8-a15a-bd7d4d362d5e",
                                "sense_id": "f9390474-1220-3122-ad40-49a503ddd3c2",
                                "text": "On ne doit pas être surpris si, dans ces temps éloignés de nous, certains sièges se prolongeaient indéfiniment."
                            },
                            {
                                "example_id": "4183b7f0-e9a7-451f-9e80-87a581f44f81",
                                "sense_id": "f9390474-1220-3122-ad40-49a503ddd3c2",
                                "text": "On peut indéfiniment parler de révoltes sans provoquer jamais aucun mouvement révolutionnaire, tant qu'il n'y a pas de mythes acceptés par les masses ; […]."
                            },
                            {
                                "example_id": "34cb6c88-bcb2-49f9-b773-02f8e06bd4fe",
                                "sense_id": "f9390474-1220-3122-ad40-49a503ddd3c2",
                                "text": "La cuisson peut être intermittente ou continue : dans le premier cas on défourne la chaux produite après chaque opération ; dans le second on continue indéfiniment la calcination en retirant la chaux à mesure qu'elle est cuite […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b3b57b7-8870-43fa-ba2d-ba5ceb66b0ec",
                        "source_entry_id": "75b53010-164e-30ea-a606-23a9bc817c70",
                        "target_lang_word": "indefinitely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indefinitely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89cb2bb8-3b50-398a-90f0-7c8447387e1e",
                                        "entry_id": "30d237f3-2246-3172-a464-a703443e1b3d",
                                        "glosses": [
                                            "In a manner that is not definite."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df100d36-0b3b-4d96-bce0-00babfce92e6",
                                                "sense_id": "89cb2bb8-3b50-398a-90f0-7c8447387e1e",
                                                "text": "an indefinitely determined fossil"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55226941-50d6-377d-b180-09671ab27f73",
                                        "entry_id": "30d237f3-2246-3172-a464-a703443e1b3d",
                                        "glosses": [
                                            "For a long time, with no defined end."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef390a11-974e-4d53-a5e2-11fb91b1ef89",
                                                "sense_id": "55226941-50d6-377d-b180-09671ab27f73",
                                                "text": "It was a dark, horsehairy place with a sort of abandon-hope atmosphere that seemed suitable for people that had no money, and who were going indefinitely into pawn."
                                            },
                                            {
                                                "example_id": "1f77c4a5-70ae-4b4a-8e94-06514f8c1d9f",
                                                "sense_id": "55226941-50d6-377d-b180-09671ab27f73",
                                                "text": "One argument is that \"the virus has changed everything\" and that people will work from home and travel much less, easing capacity pressures.\nBut there is a counter argument whereby we may all discover that, longer-term, many jobs cannot after all be effectively carried out from home indefinitely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d896d24a-6da4-3549-8a12-6a4e14169d04",
                                        "entry_id": "30d237f3-2246-3172-a464-a703443e1b3d",
                                        "glosses": [
                                            "Forever."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
