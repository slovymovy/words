                "senses": [
                    {
                        "sense_id": "e509b6fe-0a3f-3e43-a7c9-1caf1761c64a",
                        "entry_id": "7cfb7361-106f-38de-97f8-e95c47018342",
                        "glosses": [
                            "Science et technique de la gestion, de l’exploitation, de la conservation et de la restauration des forêts et des ressources forestières."
                        ],
                        "tags": [
                            "Sciences forestières"
                        ],
                        "examples": [
                            {
                                "example_id": "b10fccf9-7252-49ab-9adf-bf07c121107d",
                                "sense_id": "e509b6fe-0a3f-3e43-a7c9-1caf1761c64a",
                                "text": "Ainsi, elle ouvre le débat sur le partage de l’effort des objectifs entre les États membres ; l’utilisation des terres et la foresterie ; et sur le système d’échange des quotas d’émission carbone (ETS)."
                            }
                        ]
                    },
                    {
                        "sense_id": "04d1737e-8c81-3f79-bc40-c9b9d453aaff",
                        "entry_id": "7cfb7361-106f-38de-97f8-e95c47018342",
                        "glosses": [
                            "Ensemble des métiers liés à la gestion et à l’exploitation des forêts."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "8d7e8ec9-878b-47b8-ac2c-0161b5c5c885",
                                "sense_id": "04d1737e-8c81-3f79-bc40-c9b9d453aaff",
                                "text": "Les semis d’arbres, une gracieuseté du programme de foresterie du Collège Boréal, grandiront en santé sur les propriétés des résidents et embelliront leurs quartiers."
                            }
                        ]
                    }
