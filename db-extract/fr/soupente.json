        "fr-extract.jsonl": [
            {
                "entry_id": "905a4e7d-f9ad-35d3-b6b5-265d739aa934",
                "word": "soupente",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e4bdfdc9-aaf0-49b4-b258-61e7a468607f",
                        "entry_id": "905a4e7d-f9ad-35d3-b6b5-265d739aa934",
                        "tags": [
                            "plural"
                        ],
                        "form": "soupentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0118c4ff-3228-3bdb-8490-a67cd25d7730",
                        "entry_id": "905a4e7d-f9ad-35d3-b6b5-265d739aa934",
                        "glosses": [
                            "Réduit en planches ou en maçonnerie, pratiqué dans la hauteur d’une cuisine, d’une écurie, d’une chambre, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f76045a-2136-4511-9f46-367b2166634a",
                                "sense_id": "0118c4ff-3228-3bdb-8490-a67cd25d7730",
                                "text": "Ou encore, rêvant dans ta soupente, n'as-tu pu résister au désir de te précipiter au cabaret."
                            },
                            {
                                "example_id": "cb71a1cc-df7a-4ab2-be22-1c6c390ade82",
                                "sense_id": "0118c4ff-3228-3bdb-8490-a67cd25d7730",
                                "text": "et les bandits, qu’agaçaient en vain les grasses Maritornes de la noire hôtellerie, grimpèrent aux soupentes, en bâillant d'ennui, de fatigue et de sommeil."
                            },
                            {
                                "example_id": "3be69631-e3eb-45d7-b10d-96f6a941853b",
                                "sense_id": "0118c4ff-3228-3bdb-8490-a67cd25d7730",
                                "text": "Je monte dans ma soupente. Je couche dans une soupente à laquelle on arrive par une petite échelle ; on y étouffe en été, on y gèle en hiver ; mais j’y suis libre, tout seul, et je l’aime, ce cabinet suspendu, où je peux m’isoler, dont les murs de bois ont entendu tous les murmures de mes colères et de mes douleurs."
                            },
                            {
                                "example_id": "b5490dbc-be88-4659-9b5c-e69b42d9b72e",
                                "sense_id": "0118c4ff-3228-3bdb-8490-a67cd25d7730",
                                "text": "Une mère me montre, attenant à sa chambre unique, une soupente obscure où, dit-elle, elle n'ose pas faire dormir son petit garçon tant les rats qui la hantent sont nombreux et forts."
                            },
                            {
                                "example_id": "317b467c-b36b-4d6e-960f-44e954d98313",
                                "sense_id": "0118c4ff-3228-3bdb-8490-a67cd25d7730",
                                "text": "Beata était plus affectueuse. Quand j’arrivais avec mon père, elle m’offrait une friandise ou me caressait les cheveux. Mais on m’envoyait aussitôt vers la salle de jeux du deuxième étage, qui formait soupente."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3369836-36d1-3c5d-bf30-2eb3087fff01",
                        "entry_id": "905a4e7d-f9ad-35d3-b6b5-265d739aa934",
                        "glosses": [
                            "Large courroie servant à soutenir le corps d’une voiture."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0e946335-b678-43fc-b527-1481cd715257",
                                "sense_id": "e3369836-36d1-3c5d-bf30-2eb3087fff01",
                                "text": "Relever les soupentes d’une voiture."
                            }
                        ]
                    },
                    {
                        "sense_id": "5707910b-aa81-38d4-8336-3f3d99c30e9c",
                        "entry_id": "905a4e7d-f9ad-35d3-b6b5-265d739aa934",
                        "glosses": [
                            "Longue et large bande de cuir croisée, dont on se sert pour maintenir, pour suspendre un cheval dans l’appareil qu’on nomme travail."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8f204a8e-4983-3609-88b0-f2daef75c065",
                        "entry_id": "905a4e7d-f9ad-35d3-b6b5-265d739aa934",
                        "glosses": [
                            "Pièce de métal qui retient le faux manteau d'une cheminée."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1da903d3-35a1-4334-9487-6c9f10d4a423",
                        "source_entry_id": "905a4e7d-f9ad-35d3-b6b5-265d739aa934",
                        "source_sense_description": "réduit en planche dans la hauteur d'une pièce",
                        "target_lang_word": "sobrado",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sobrado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "af45fa71-9e2b-30c6-ad75-f0fc1777be41",
                                        "entry_id": "ac9b179e-b6d6-3bb3-ac08-936364413bc3",
                                        "glosses": [
                                            "Que sobra o es más abundante de lo necesario."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2fac82-5175-48a8-a79b-ed6ddb41d436",
                                                "sense_id": "af45fa71-9e2b-30c6-ad75-f0fc1777be41",
                                                "text": "el nuestro valeroso Maestre temía contra ellos algúnd arraygado rencor o malquerençia por tantos e tantos enojos en que por muchas vezes avían puesto al Rey su señor con sus sobradas demandas."
                                            },
                                            {
                                                "example_id": "a6247c45-0f1d-430c-b096-9be840a274cf",
                                                "sense_id": "af45fa71-9e2b-30c6-ad75-f0fc1777be41",
                                                "text": "¿No eran ya, dime, sobradas\ntantas marañas y ardides,\ny las traiciones y males\nque hasta aquí, cruel, me hiciste?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9b58717-3b59-3321-aab1-41728c876d4b",
                                        "entry_id": "ac9b179e-b6d6-3bb3-ac08-936364413bc3",
                                        "glosses": [
                                            "Dicho de una persona, que posee gran cantidad de bienes o dinero."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "121779f6-a664-47eb-9fb2-737d91b90f51",
                                                "sense_id": "f9b58717-3b59-3321-aab1-41728c876d4b",
                                                "text": "El caballero, que ya tenía lo importante a su deseo, pareciéndole lo demás impertinente, aunque en su tanto muy bueno, y no hallándose tan sobrado que lo pudiera pagar, con discreción le dijo: ‘Yo os pedí un caballo solo, y tal como por bueno os lo pagaré, si me lo queréis vender; los jaeces, quedaos con ellos o dadlos a otros, que no los he menester."
                                            },
                                            {
                                                "example_id": "a30415ce-088c-45f0-8514-746c45120bc2",
                                                "sense_id": "f9b58717-3b59-3321-aab1-41728c876d4b",
                                                "text": "cuando el Obispo salió de Palencia para Córdoba, tenía atrasadas dos buenas partidas que no se habían podido cobrar: una, del Arcedianato, y otra, del Obispado, por el tiempo que tardaron en llegar las bulas y el consagrarse, que serían hasta cuarenta mil ducados, de los cuales (porque nunca se había visto tan rico y sobrado) entró gastando sin temor ni recelo de que podría faltarle."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4abc3038-a1e9-3127-8473-c4a98c0c4ceb",
                                        "entry_id": "ac9b179e-b6d6-3bb3-ac08-936364413bc3",
                                        "glosses": [
                                            "Que ofende las reglas morales comúnmente aceptadas, en especial en materia de sexualidad; licencioso."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b828897-b60a-43c5-925f-0be41ba027ca",
                                                "sense_id": "4abc3038-a1e9-3127-8473-c4a98c0c4ceb",
                                                "text": "de sobrar, sobrado, adj. Lo mismo que atrevido, audaz y licencioso."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d45b6827-928a-3464-9af4-808750d3f600",
                                        "entry_id": "ac9b179e-b6d6-3bb3-ac08-936364413bc3",
                                        "glosses": [
                                            "Que se tiene a sí mismo en muy alta estima."
                                        ],
                                        "tags": [
                                            "Chile",
                                            "Colombia",
                                            "Ecuador",
                                            "Peru",
                                            "colloquial",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a33dda-fe31-41fe-afdc-2482b1bdb651",
                                                "sense_id": "d45b6827-928a-3464-9af4-808750d3f600",
                                                "text": "Sus locuras le dieron mala fama y Chingolo, hermano, tienes que cambiar, Choto, Pichulita, te estás volviendo antipático, Mañuco, las chicas ya no querían juntarse con él, te creían un bandido, un sobrado y un pesado."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8b59bca4-70f1-3acc-a69f-77b8aba64a9d",
                                        "entry_id": "ac9b179e-b6d6-3bb3-ac08-936364413bc3",
                                        "glosses": [
                                            "Dicho de una persona, que presume de sus condiciones, reales o imaginarias, en especial de la de valiente."
                                        ],
                                        "tags": [
                                            "Ecuador",
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "11b3aa0a-a7a9-38ce-a467-00403f493cde",
                                        "entry_id": "ac9b179e-b6d6-3bb3-ac08-936364413bc3",
                                        "glosses": [
                                            "Que sobrepasa en calidad las expectativas habituales."
                                        ],
                                        "tags": [
                                            "Colombia",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b01be3-6494-4476-8608-2623b8f54ceb",
                                                "sense_id": "11b3aa0a-a7a9-38ce-a467-00403f493cde",
                                                "text": "Ese computador está sobrado para lo que necesito."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "sobrado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e479437e-c039-36fb-b348-7f97c3ff3682",
                                        "entry_id": "3cbfb16e-d825-3660-bb79-e88263782a88",
                                        "glosses": [
                                            "Cada piso de una vivienda por encima del nivel del suelo."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9c4c32-6f53-4b65-b728-1e53954f21da",
                                                "sense_id": "e479437e-c039-36fb-b348-7f97c3ff3682",
                                                "text": "E encima de aquella cámara avía un sobrado, fecho como cámara, y en derecho de la cama de la reina avía una como puerta de tablas."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "e3e5e330-6631-3110-8e0e-30b0af09b946",
                                        "entry_id": "3cbfb16e-d825-3660-bb79-e88263782a88",
                                        "glosses": [
                                            "En particular, el último e inmediato al tejado, que generalmente tiene el techo inclinado; se utiliza como habitación o para guardar cosas que no se usan habitualmente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34c83163-78c9-4cc3-b2e6-ab2133b62ea7",
                                                "sense_id": "e3e5e330-6631-3110-8e0e-30b0af09b946",
                                                "text": "Y tomando una escalera de mano, la apoyó contra un boquete que se notaba en el techo, y que daba entrada a un sobrado o desván, en el que se guardaban las semillas y trastos viejos."
                                            },
                                            {
                                                "example_id": "4ae6d0b0-7a2f-477d-86b3-f5d97a05ef7f",
                                                "sense_id": "e3e5e330-6631-3110-8e0e-30b0af09b946",
                                                "text": "Cayéndole la camisa por los hombros, y deshecha la trenza, descuelga el candil y sube a dormir en el sobrado."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "9dd20606-3406-3f0b-b3a2-e4c4556642bb",
                                        "entry_id": "3cbfb16e-d825-3660-bb79-e88263782a88",
                                        "glosses": [
                                            "Restos que quedan de alimento al acabar los comensales una comida."
                                        ],
                                        "tags": [
                                            "Andalusia",
                                            "Chile",
                                            "Colombia",
                                            "Ecuador",
                                            "Peru"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            },
                            {
                                "target_word": "sobrado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7aaf9f33-14b0-36d6-95d7-07e7b44b433e",
                                        "entry_id": "578457b5-c068-3dbd-b052-9e1fc76adfaf",
