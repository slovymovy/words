            {
                "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                "word": "YouTube",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0448ec77-d451-4f55-bf81-62532a8702b2",
                        "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                        "tags": [
                            "plural"
                        ],
                        "form": "YouTubes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "815d41b7-0512-3af1-ae87-7b195c248d3c",
                        "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                        "glosses": [
                            "Any website that allows users to upload content, particularly YouTube itself."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "714b4295-e222-4983-aa30-04ff95156cf5",
                                "sense_id": "815d41b7-0512-3af1-ae87-7b195c248d3c",
                                "text": "None of this is to suggest that academic libraries should turn their websites into a YouTube or Facebook in which our user communities would create all the content,[…]"
                            },
                            {
                                "example_id": "8bfd886e-bd79-434a-b6f8-ddcae0276449",
                                "sense_id": "815d41b7-0512-3af1-ae87-7b195c248d3c",
                                "text": "There is all kinds of stuff that people post there- some of it is entertaining, some is actually useful as a template for studying or for business...it is sort of like a YouTube for documents."
                            }
                        ]
                    },
                    {
                        "sense_id": "350b506b-9568-36d4-8ed0-53c7ea7f2018",
                        "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                        "glosses": [
                            "A small video that can be viewed online, particularly one hosted on YouTube."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "15634f42-6159-44dc-b8b2-9fe3f1f6249d",
                                "sense_id": "350b506b-9568-36d4-8ed0-53c7ea7f2018",
                                "text": "Then it's a YouTube of some kid trying to play \"Radar Love\" on a cheap guitar using only his feet,[…]"
                            },
                            {
                                "example_id": "45de7424-dfe6-4f46-919f-c4a2ab93a72a",
                                "sense_id": "350b506b-9568-36d4-8ed0-53c7ea7f2018",
                                "text": "Not too long ago, there was a YouTube of you two brawling. How did the musical collaboration happen?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d4904b5-3fc6-3451-96b3-196d7b73a456",
                        "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                        "glosses": [
                            "A YouTube channel."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "f334bf38-74ce-41cb-bb0c-493823513412",
                                "sense_id": "7d4904b5-3fc6-3451-96b3-196d7b73a456",
                                "text": "National Theatre at Home also unveiled titles for the remainder of its season, which continues to release streams every Thursday at 2 PM ET on its YouTube, with productions remaining on demand through noon ET the following Thursday."
                            }
                        ]
                    }
                ],
