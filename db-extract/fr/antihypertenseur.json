                        "sense_id": "8c969956-a8fe-3ec7-b21f-7f8f9820ac9d",
                        "entry_id": "350fc7a8-9cdd-3fe9-bb4c-09e93fb60caa",
                        "glosses": [
                            "Médicament destiné à lutter contre l’hypertension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86115576-a69b-4c61-90f9-877c532926c9",
                                "sense_id": "8c969956-a8fe-3ec7-b21f-7f8f9820ac9d",
                                "text": "Les antihypertenseurs sont utilisés pour rétablir une tension artérielle (TA) normale."
                            },
                            {
                                "example_id": "3b6e0a39-6017-47a2-813c-1b63b28b0e17",
                                "sense_id": "8c969956-a8fe-3ec7-b21f-7f8f9820ac9d",
                                "text": "L’objectif dans cet exemple est de caractériser la relation entre la dose et l’effet d’un antihypertenseur par le biais de la relation dose-concentration-réponse."
                            },
                            {
                                "example_id": "56c78ceb-a170-49fd-b039-7ef09c4afc31",
                                "sense_id": "8c969956-a8fe-3ec7-b21f-7f8f9820ac9d",
                                "text": "Je fondis plus vite encore que l’antihypertenseur dans la soupe acide de mon estomac."
                            }
                        ]
