                        ],
                        "form": "den Rücksitz"
                    },
                    {
                        "form_id": "f432695f-ea43-4154-b8ea-c2aeac9d9f2e",
                        "entry_id": "c8465b13-dc16-36c7-93a3-70edc6228750",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rücksitze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc75e45b-355c-34d1-89c4-5b289fb07165",
                        "entry_id": "c8465b13-dc16-36c7-93a3-70edc6228750",
                        "glosses": [
                            "hinterer Sitzplatz in einem Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4164fef5-ba93-4ed2-8e63-29ebccbc21b8",
                                "sense_id": "dc75e45b-355c-34d1-89c4-5b289fb07165",
                                "text": "Auf dem Rücksitz wurde Orangensaft verschüttet."
                            },
                            {
                                "example_id": "4954cf4e-6f69-4596-9f9d-205c710edac9",
                                "sense_id": "dc75e45b-355c-34d1-89c4-5b289fb07165",
                                "text": "„Das hatte Dele zwar nicht gesagt, aber auf dem Rücksitz des Motorradtaxis heimwärts hatte sie angefangen zu träumen und sich die Reichtümer vorgestellt, die sie verdienen würde.“"
                            },
                            {
                                "example_id": "2cd45ca8-65b7-4e16-8f53-51e75ad4063c",
                                "sense_id": "dc75e45b-355c-34d1-89c4-5b289fb07165",
                                "text": "„Auf dem Rücksitz hat er zwei seiner Minister.“"
                            },
                            {
                                "example_id": "699e112d-6960-4936-91a7-4e6a180cc7d2",
                                "sense_id": "dc75e45b-355c-34d1-89c4-5b289fb07165",
                                "text": "„Sie nahmen ihre Waschwanne und ihr Krabbennetz, schütteten den größten Teil vom Wasser weg und trugen dann die Shrimps zum Ford, wo sie die Wanne auf den Rücksitz stellten.“"
                            },
                            {
                                "example_id": "c975535b-e6e4-4ae1-9ec7-bde6ad5a4db6",
                                "sense_id": "dc75e45b-355c-34d1-89c4-5b289fb07165",
                                "text": "„Calo verstaute den Picknickkorb auf dem Rücksitz.“"
                            },
                            {
                                "example_id": "108ee794-a6b6-4eeb-b65c-ff23bf2dc4fe",
                                "sense_id": "dc75e45b-355c-34d1-89c4-5b289fb07165",
                                "text": "„Zudem gab es auch auf dem Land Autos, deren Scheiben beschlagen waren — wenn man Glück hatte, konnte man einen Blick auf ein nacktes Bein oder eine Brust erhaschen, wenn das Pärchen vom Vordersitz auf den Rücksitz kletterte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
