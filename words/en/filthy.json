                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъярённый",
                                "target_lang_sense_clarification": "в состоянии ярости"
                            },
                            {
                                "target_lang_word": "злобный",
                                "target_lang_sense_clarification": "выражающий злость (о взгляде)"
                            }
