                        "glosses": [
                            "Chanter d’une voix rauque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec74cc58-9eb8-492d-9dbd-73d45abebc95",
                                "sense_id": "8c50f3f7-4247-337b-a3f4-735c1975765e",
                                "text": "La remarque de ce type est formidable, rauquifie Pacino."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f386a38-75ad-38a0-8440-f81c8b896ef5",
                        "entry_id": "213170aa-8e52-36e8-accc-8ce01c56e0b6",
                        "glosses": [
                            "Donner un caractère rauque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c763217d-96e6-4847-9270-21bf379725d5",
                                "sense_id": "8f386a38-75ad-38a0-8440-f81c8b896ef5",
                                "text": "Bien sûr qu'il réalise de grandes prouesses vocales, quand il s'envole dans les aigus, quand il rauquifie sa voix mais il n'y a jamais d'emphase."
                            },
                            {
                                "example_id": "afab0724-146c-495e-9aa3-4a01269cd156",
                                "sense_id": "8f386a38-75ad-38a0-8440-f81c8b896ef5",
                                "text": "Toujours les dix mêmes chansons depuis 50 ans, qu'il \"rauquifie\" avec son manque de voix."
                            },
                            {
                                "example_id": "f161e0b0-be1c-4686-9c9f-13541ae0e6d9",
                                "sense_id": "8f386a38-75ad-38a0-8440-f81c8b896ef5",
                                "text": "après quelques paquets de cigarettes pour rauquifier/rockifier tout ça !"
                            }
                        ]
