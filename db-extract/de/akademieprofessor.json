                ],
                "senses": [
                    {
                        "sense_id": "cf522fb3-2532-36d5-9638-b858a95a72aa",
                        "entry_id": "d1efcb22-d8e6-3307-99ed-e4b95c8d1bb6",
                        "glosses": [
                            "Professor an einer Akademie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5e83c5-a551-4737-9082-93756963b6d0",
                                "sense_id": "cf522fb3-2532-36d5-9638-b858a95a72aa",
                                "text": "„Der Münchner Akademieprofessor habe mit seinen Bildern den nicht \"ungefährlichen Versuch der Annäherung\" an die Architektur des Nationalsozialismus unternommen und seine verführerische Ästhetik beleuchtet.“"
                            },
                            {
                                "example_id": "655e66f5-6a91-4b82-8407-8e692b1b18cb",
                                "sense_id": "cf522fb3-2532-36d5-9638-b858a95a72aa",
                                "text": "„So das \"Büdericher Ehrenmal\" 1958 mit den in einer Art Keilschrift eingeschnitzten Namen von Kriegsgefallenen, die von Getlinger in präziser Plastizität wiedergegeben werden, sowie jene Werke, die von Beuys für die erfolgreiche Bewerbung als Düsseldorfer Akademieprofessor 1961 vorgelegt wurden.“"
                            },
                            {
                                "example_id": "df26fa5b-5827-4293-9f7e-350d7515d7cd",
                                "sense_id": "cf522fb3-2532-36d5-9638-b858a95a72aa",
                                "text": "„Mit dieser plakativen Kunst wurde der Düsseldorfer Akademieprofessor bekannt.“"
                            },
                            {
                                "example_id": "4c76e286-d8a2-49e2-8b27-52770a2b1b18",
                                "sense_id": "cf522fb3-2532-36d5-9638-b858a95a72aa",
                                "text": "„Ebenfalls interessant und aktuell ist der Blick nach Ravensburg, wo über den Sommer der Karlsruher Akademieprofessor und Künstler Stephan Balkenhol mit neuen, teils extra für die Ausstellung gefertigten Arbeiten zu sehen ist.“"
                            },
                            {
                                "example_id": "4eae1dd7-b40b-4511-b332-3de83ac24184",
                                "sense_id": "cf522fb3-2532-36d5-9638-b858a95a72aa",
                                "text": "„Wir müssen also, wie es Akademieprofessor W.I. Wernadskij tat, zwischen dem menschlichen Individuum als Mitglied der und den niederen Lebewesen der unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
