                                        "entry_id": "f0877b6d-bf80-3869-9618-7748862c2750",
                                        "glosses": [
                                            "Invite susceptible d’entraîner une réaction par tentation insistante."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad569ba4-d8d1-4548-8ba5-2060f79b4abf",
                                                "sense_id": "a258262d-8e6d-3aef-ac59-7cd13e006404",
                                                "text": "Je fus face à une nouvelle sollicitation pressante, instante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4526a7-0503-3e4b-a915-5da3efd16a32",
                                        "entry_id": "f0877b6d-bf80-3869-9618-7748862c2750",
                                        "glosses": [
                                            "Demande instante, ou démarche pressante venant de l’extérieur."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456f1234-1730-475c-9ca4-2bb7fafc3c7e",
                                                "sense_id": "8f4526a7-0503-3e4b-a915-5da3efd16a32",
                                                "text": "C’est à la sollicitation d’un de ses amis qu’il a fait telle chose."
                                            },
                                            {
                                                "example_id": "3905fb04-8040-4c79-a3e6-a9badcf34b90",
                                                "sense_id": "8f4526a7-0503-3e4b-a915-5da3efd16a32",
                                                "text": "Il s’est rendu à mes sollicitations."
                                            },
                                            {
                                                "example_id": "f65506a9-9db6-459f-8de9-eb52c140bebe",
                                                "sense_id": "8f4526a7-0503-3e4b-a915-5da3efd16a32",
                                                "text": "Céder, résister aux sollicitations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d396ffb-763a-3328-8f13-f52ad830864c",
                                        "entry_id": "f0877b6d-bf80-3869-9618-7748862c2750",
                                        "glosses": [
                                            "Ensemble des forces extérieurs s’exerçant sur un objet ou sur une structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e49103c-c59f-4a60-a202-1d0e284e984c",
                                                "sense_id": "2d396ffb-763a-3328-8f13-f52ad830864c",
                                                "text": "Le banc d'essai est défini en fonction des résultats des expertises tribologiques. Le cahier des charges de ce banc ne tient compte que des sollicitations réellement influentes sur le contact."
                                            }
                                        ]
                                    }
