                "senses": [
                    {
                        "sense_id": "331f9c2e-ffe4-3bf1-8978-33b889c87bc2",
                        "entry_id": "47fde6c5-cc2a-355d-8d77-89f8da19f956",
                        "glosses": [
                            "Stätte, die von vielen Touristen besucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a417764c-ff11-43a5-b895-5ffd37a9f3f7",
                                "sense_id": "331f9c2e-ffe4-3bf1-8978-33b889c87bc2",
                                "text": "„Eine Touristenattraktion ist die ‚Shambles‘, eine noch mit Kopfstein gepflasterte Einkaufsstraße mit vielen windschiefen Läden und Boutiquen.“"
                            },
                            {
                                "example_id": "c59d42c9-9728-44c9-8ce6-4f604d17683f",
                                "sense_id": "331f9c2e-ffe4-3bf1-8978-33b889c87bc2",
                                "text": "„Heute ist die Mauer weg, der Brocken eine gesamtdeutsche Touristenattraktion.“"
                            },
                            {
                                "example_id": "6a8943ac-f263-4588-825c-96643f7f66d3",
                                "sense_id": "331f9c2e-ffe4-3bf1-8978-33b889c87bc2",
                                "text": "„Er ist sogar eine Touristenattraktion, betreibt ein Fremdenverkehrsgewerbe.“"
                            },
                            {
                                "example_id": "b960d34f-435c-4b1c-8f3a-57fb9f79b2c5",
                                "sense_id": "331f9c2e-ffe4-3bf1-8978-33b889c87bc2",
                                "text": "„Der Leuchtturm verlor viel von seinem Charme, wenn er zur Touristenattraktion wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
