                        "glosses": [
                            "alles wat te maken heeft met het verrichten van (betaald) werk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "765dca57-561c-4bca-a4a1-1284e158f015",
                                "sense_id": "7560b5c3-f4fc-34f1-bb02-f53c38879eae",
                                "text": "De haalbaarheid van 'het' is de leugen waarop de moderne leef- en arbeidswereld is gebaseerd."
                            },
                            {
                                "example_id": "80034431-162a-4cf5-b691-b6b4b4afafce",
                                "sense_id": "7560b5c3-f4fc-34f1-bb02-f53c38879eae",
                                "text": "Thyssen: \"We moeten ons verbonden voelen met elkaar in Europa. We leven in een steeds grotere wereld. Dus moet je een stapje over de eigen landsgrens zetten. Werken in een andere taal, in een ander land, in een ander cultuur, dat is iets wat mensen verrijkt en hun extra troeven geeft om later de stap te zetten in de echte arbeidswereld.\""
                            }
                        ]
