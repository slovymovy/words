                ],
                "senses": [
                    {
                        "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                        "entry_id": "d468cce4-c573-3e20-b96b-67887bb5b0c5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f63a83c-4a6b-49a1-8c46-3269a94ac5c3",
                                "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                                "text": "Frau Rechel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "57d0e4c9-ce84-47a9-8b4f-f4a19c591af7",
                                "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                                "text": "Herr Rechel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "482a764e-04c4-4c8a-ad59-2e4631e874c6",
                                "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                                "text": "Die Rechels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a62100e2-2f1c-4a54-8e2d-9f2305870109",
                                "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                                "text": "Der Rechel trägt nie die Schals, die die Rechel ihm strickt."
                            },
                            {
                                "example_id": "ee9b570c-0646-4b25-8c20-0dad2bb04365",
                                "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rechel kommt, geht der Herr Rechel.“"
                            },
                            {
                                "example_id": "e4fd7301-ef81-41ef-bd8b-9d1551cb2297",
                                "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                                "text": "Rechel kommt und geht."
                            },
                            {
                                "example_id": "b85a4b67-0f73-4c44-9a16-d293dd87f2f6",
                                "sense_id": "5d2baeec-1f21-3796-99ce-acdc4f20bd4a",
                                "text": "Rechels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
