                                    },
                                    {
                                        "sense_id": "1b74cb62-71f7-3dbd-b60e-5cd8ad036548",
                                        "entry_id": "2fde728c-8e76-3f52-8b25-78ba178fe1cf",
                                        "glosses": [
                                            "A small child."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258f5b22-443c-4968-b7d5-7424d48b3932",
                                                "sense_id": "1b74cb62-71f7-3dbd-b60e-5cd8ad036548",
                                                "text": "Shouldn't you tadpoles be in bed?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa55ad7-6d89-3f20-bf12-00258006ae04",
                                        "entry_id": "2fde728c-8e76-3f52-8b25-78ba178fe1cf",
                                        "glosses": [
                                            "An insignificant person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0bbb0a2-17bb-4545-a52c-af42e610e9be",
                                                "sense_id": "daa55ad7-6d89-3f20-bf12-00258006ae04",
                                                "text": "Woman's voice: You impudent imp! You tadpole! You shrimp!"
                                            },
                                            {
                                                "example_id": "3074749e-3dd6-4fb3-94f7-aa2cac5e3131",
                                                "sense_id": "daa55ad7-6d89-3f20-bf12-00258006ae04",
                                                "text": "“[H]ere's this Tooralooral tadpole of a Mayor shovin' his nose into the business and arrestin' our Puddin' without rhyme or reason.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7545649-5baa-482f-97cb-5ffda97c9c73",
                        "source_entry_id": "04c42fbf-aebc-327c-a71e-182bbdca3668",
                        "source_sense_id": "8d1f5ab9-f566-3970-b0b2-2557036cc6ea",
                        "source_sense_description": "kikker- of paddenlarve",
                        "target_lang_word": "têtard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "têtard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95231882-742b-3151-8fb0-4ea959a6dd26",
                                        "entry_id": "63be8f7c-4718-3cd4-b853-6fa04a206356",
                                        "glosses": [
                                            "Larve de batracien vivant dans l’eau et respirant par des branchies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bcc5e0-247e-40b1-b383-e4b557146bba",
                                                "sense_id": "95231882-742b-3151-8fb0-4ea959a6dd26",
                                                "text": "[…] ; cette larve à corps ovalaire est munie d’une longue queue qui lui donne quelque ressemblance avec un têtard."
                                            },
                                            {
                                                "example_id": "ce5f729e-e677-4bee-90de-9c274adc990b",
                                                "sense_id": "95231882-742b-3151-8fb0-4ea959a6dd26",
                                                "text": "Il y a des perce-oreilles dans les chantiers des Ursulines, il y a des mille-pieds au Panthéon, il y a des têtards dans les fossés du Champ de Mars."
                                            },
                                            {
                                                "example_id": "a9457f5d-044d-4952-81b2-e2dc47e4033e",
                                                "sense_id": "95231882-742b-3151-8fb0-4ea959a6dd26",
                                                "text": "L’aération de l’eau peut être maintenue au moyen de bulleurs. Il est conseillé de placer les bulleurs à des endroits où ils n’entraînent pas de stress excessif chez les têtards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e928f6d9-6520-3c70-bab9-832444f1d6c9",
                                        "entry_id": "63be8f7c-4718-3cd4-b853-6fa04a206356",
                                        "glosses": [
                                            "Se dit de certains petits poissons à grosse tête, comme le chabot."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "448ef3fe-f071-3c66-bc8f-b7874b3e44ef",
                                        "entry_id": "63be8f7c-4718-3cd4-b853-6fa04a206356",
                                        "glosses": [
                                            "Façon de tailler un arbre, de façon qu’il forme une touffe épaisse au sommet du tronc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c3ae0e-01f8-403e-855a-6687427d52ac",
                                                "sense_id": "448ef3fe-f071-3c66-bc8f-b7874b3e44ef",
                                                "text": "Ce saule a été taillé en têtard."
                                            },
                                            {
                                                "example_id": "8b17c37f-1533-410f-82d2-d9c951b62193",
                                                "sense_id": "448ef3fe-f071-3c66-bc8f-b7874b3e44ef",
                                                "text": "Werst n’était plus qu’à trois portées de fusil, au delà d’une épaisse saulaie, formée de francs arbres et non de ces têtards rabougris, qui touffent à quelques pieds au-dessus de leurs racines."
                                            },
                                            {
                                                "example_id": "16983f1b-681f-400b-b41a-4ddb2407bbdd",
                                                "sense_id": "448ef3fe-f071-3c66-bc8f-b7874b3e44ef",
                                                "text": "Le gros chêne têtard qui se trouvait à côté de la pompe, tout au fond du jardin, n’avait pas été élagué depuis cinq ou six ans."
                                            },
                                            {
                                                "example_id": "1ef523e2-da37-47f1-99f8-45d1a2e73e1a",
                                                "sense_id": "448ef3fe-f071-3c66-bc8f-b7874b3e44ef",
                                                "text": "C’est l’occasion de se familiariser avec la végétation qui caractérise le Marais, comme des chênes têtards, ses saules pleureurs, ainsi que l’angélique, plante qui a donné quelques spécialités locales."
                                            },
                                            {
                                                "example_id": "bacee46e-9116-4890-9e19-d0c139437929",
                                                "sense_id": "448ef3fe-f071-3c66-bc8f-b7874b3e44ef",
                                                "text": "Il était plus immobile que le têtard d'aune voisin dont, parallèles à ses jambes, descendaient vers l'Ommée deux racines rougeâtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e29607-4689-3871-acb4-be636152766b",
                                        "entry_id": "63be8f7c-4718-3cd4-b853-6fa04a206356",
                                        "glosses": [
                                            "Arbre dont on coupe régulièrement (3 à 10 ans) les branches pour fournir du bois, et que l'on laisse repousser. Au bout de plusieurs tailles l'arbre prend cet aspect caractéristique d'où il tire son nom."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
