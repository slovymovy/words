                    {
                        "sense_id": "ef9f7fb1-8df9-3bb4-9cd4-b8b9c1ada78c",
                        "entry_id": "70a0d1c0-28dc-3d13-8c1d-64031158aa83",
                        "glosses": [
                            "Film über den Geheimagenten James Bond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af9d03c1-b9b1-4c19-94a9-8ce94c34281a",
                                "sense_id": "ef9f7fb1-8df9-3bb4-9cd4-b8b9c1ada78c",
                                "text": "„Sie sollte nicht nur hübsch sein, sondern auch sexy, denn alle Welt – Dschihadisten mit eingeschlossen – wusste aus den James-Bond-Filmen, dass ein richtiger Geheimagent grundsätzlich nur mit einer Superbraut herummachte.“"
                            },
                            {
                                "example_id": "53ec9ff0-91d6-477d-95d4-2683ae0b0ce5",
                                "sense_id": "ef9f7fb1-8df9-3bb4-9cd4-b8b9c1ada78c",
                                "text": "„Der Gedanke mutet wie eine Szene aus einem James-Bond-Film an.“"
                            },
                            {
                                "example_id": "d530b475-2b10-4f94-8d69-f06747119235",
                                "sense_id": "ef9f7fb1-8df9-3bb4-9cd4-b8b9c1ada78c",
                                "text": "„Trotz der unzähligen James-Bond-Filme, in denen der Agent gefühlte Kilometer durch die Gegend rannte und das Feuer der automatischen Waffen nur Funken um ihn herum schlug, wusste Kurtz, dass der Stahl ihn kaum vor Schussverletzungen schützen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
