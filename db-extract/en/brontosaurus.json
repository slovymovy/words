        "de-extract.jsonl": [
            {
                "entry_id": "0583243d-8d92-3716-b1e2-18fb0136164f",
                "word": "Brontosaurus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "90216c03-ce83-3fc4-80b0-a96560a5c892",
                        "entry_id": "0583243d-8d92-3716-b1e2-18fb0136164f",
                        "glosses": [
                            "Biologie, Nomenklatur: die Art, englisch genus ^(→ en), Brontosaurus, ein großer vierbeiniger, pflanzenfressender Dinosaurier aus dem Jura."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20286327-f0cb-4ef5-b370-d9d350bee6ff",
                                "sense_id": "90216c03-ce83-3fc4-80b0-a96560a5c892",
                                "text": "„Marsh considered Apatosaurus and Brontosaurus as distinct but closely related genera within the larger family of sauropod dinoraurs. Brontosaurus soon became everyone's typical sauropod—indeed the canonical herbivorous dinosaur of popular consciousness.“ (kursiv im Original)",
                                "translation": "Marsh betrachtete Apatosaurus und Brontosaurus als unterschiedliche, jedoch nahe verwandte Arten innerhalb der größeren Familie der Sauropoden. Brontosaurus wurde bald jedermanns typischer Sauropode — tatsächlich der anerkannte pflanzenfressende Dinosaurier im allgemeinen Bewusstsein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95199ac2-28d0-49ce-a0d0-949e02ba5858",
                        "source_entry_id": "0583243d-8d92-3716-b1e2-18fb0136164f",
                        "source_sense_id": "90216c03-ce83-3fc4-80b0-a96560a5c892",
                        "source_sense_description": "ein großer vierbeiniger, pflanzenfressender Dinosaurier aus dem Jura",
                        "target_lang_word": "Brontosaurus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brontosaurus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee679e6a-61b5-3515-b9df-63499aa6f755",
                                        "entry_id": "3c755f3e-e2ad-3cdd-a761-4b06d8454d2c",
                                        "glosses": [
                                            "Vertreter einer Gattung großer, pflanzenfressender, vierbeiniger Dinosaurier. Vom Entdecker Othniel Charles Marsh zwei Jahre nach seiner Beschreibung von Apatosaurus als eigene Art veröffentlicht und später mit diesem synonymisiert. Seit 2014 wieder als eigenständige Art anerkannt."
                                        ],
                                        "tags": [
                                            "Paläontologie",
                                            "Nomenklatur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1928f9bd-abee-452d-97cb-a27e40172db3",
                                                "sense_id": "ee679e6a-61b5-3515-b9df-63499aa6f755",
                                                "text": "Ein Brontosaurus war riesig!"
                                            },
                                            {
                                                "example_id": "584a5af3-e43b-4772-a6a6-161b3e8b1cd8",
                                                "sense_id": "ee679e6a-61b5-3515-b9df-63499aa6f755",
                                                "text": "Der Brontosaurus in dem Film gestern hat mich beeindruckt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
