                        "examples": [
                            {
                                "example_id": "fd65c28b-2f90-405f-8954-1ab95f5a14fb",
                                "sense_id": "55549ffa-9d2c-35d8-87d2-94b4360a0640",
                                "text": "Heute stellen viele Unternehmen nicht nur Raumpflegerinnen, sondern auch Raumpfleger ein. Häufig haben sie die Aufgabe, Fenster zu putzen."
                            },
                            {
                                "example_id": "ede34822-cf1b-4531-acfb-62d221e43924",
                                "sense_id": "55549ffa-9d2c-35d8-87d2-94b4360a0640",
                                "text": "Wir mussten feststellen, dass selbst für Möbelpacker oder einfache Putzarbeiten perfektes Deutsch, eine Ausbildung zum Raumpfleger etc, und eine Arbeitserlaubnis erfordert wurden."
                            }
                        ],
