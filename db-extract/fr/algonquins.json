                "word": "Algonquins",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bee595ad-5348-3e50-8500-d136181fdc08",
                        "entry_id": "11c1dc8b-5388-3768-8ab1-799a3dc60a47",
                        "glosses": [
                            "Peuple amérindien de l’est du Canada, de la grande famille des Algonquiens."
                        ],
                        "tags": [
                            "collectively",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "99953079-bfc1-41c0-bbc8-6a6e1af61317",
                                "sense_id": "bee595ad-5348-3e50-8500-d136181fdc08",
                                "text": "Ce petit peuple menace la paix de la colonie, car il a déclaré la guerre aux Algonquins et il songe à s'allier aux Hollandais pour faire la traite des fourrures... — (Jacques Lacoursière, Histoire populaire du Québec, vol. 1, « Des origines à 1791 », 2013, p. 189.)"
                            },
                            {
                                "example_id": "b9190475-731a-47d6-8ccf-c27e8a1e132b",
                                "sense_id": "bee595ad-5348-3e50-8500-d136181fdc08",
                                "text": "Les Algonquins étaient une nation, qui vivait le long de l'Outaouais et appartenait à la famille algonkienne, dite aussi famille algique."
                            }
                        ]
                    }
