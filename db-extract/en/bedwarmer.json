                        "glosses": [
                            "A concubine or mistress."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "43d510da-8e21-4b95-9d53-f2b008c562e9",
                                "sense_id": "8faa2b60-6dd5-3500-a34f-37c8b9eca373",
                                "text": "\"You speak of lowly! You, once a slave whore whose only purpose wad bed hopping! You, a Cultellrin whore! You may be a queen, but that ends now! This moment! From now on you are nothing more than my bedwarmer! You'd better pray to your god that I never tire of you, for if I do, I'll split your gut all the way up to your neck!\""
                            },
                            {
                                "example_id": "b0668177-e261-42ec-9c92-ed4d9fdfcc93",
                                "sense_id": "8faa2b60-6dd5-3500-a34f-37c8b9eca373",
                                "text": "unknown year, His Bedwarmer's Wife, Red Auza\n\"Nah, I'ts fine, Ley. Because from now on I won't bring any woman here. You will be my bedwarmer.\""
                            },
                            {
                                "example_id": "30cdf28c-b4f6-44c7-af06-bf500ba57c92",
                                "sense_id": "8faa2b60-6dd5-3500-a34f-37c8b9eca373",
                                "text": "You're more than my bed-warmer. If you decide to stay with me, I'll keep you safe and give you room to grow into the incredible woman I know you can be, […]"
                            },
                            {
                                "example_id": "a38441ac-f993-4e37-8e20-0d7ef5279a2a",
                                "sense_id": "8faa2b60-6dd5-3500-a34f-37c8b9eca373",
                                "text": "\"But my appetite for other delights has just awoken, so if you will excuse me Brothers, I shall take a bottle of brandy and my bed-warmer for tonight, and I shall you all In^([sic]) the morning.\" and turning to Theresa he grabbsed her arm roughly and dragged her to her feet, […]"
                            }
                        ]
