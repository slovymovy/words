                "senses": [
                    {
                        "sense_id": "7877272c-8001-3ea2-acea-ea50901af7b0",
                        "entry_id": "6313ea4d-1d05-3671-90b8-acaa322132bd",
                        "glosses": [
                            "Free from pain; without pain or trouble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "374003ea-1653-4118-93d3-41dcffe2d756",
                                "sense_id": "7877272c-8001-3ea2-acea-ea50901af7b0",
                                "text": "There are now washless dishes, painless razors, painless shoes, painless corsets, prepared soups, painless photographs (it used to give you a stiff neck for three days to have your picture taken)[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a146c874-1e94-3d6a-b1ec-ac6708e135fb",
                        "entry_id": "6313ea4d-1d05-3671-90b8-acaa322132bd",
                        "glosses": [
                            "Not difficult; easy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ddde226-eb01-44f0-9dae-fe1fd07c1ec9",
                                "sense_id": "a146c874-1e94-3d6a-b1ec-ac6708e135fb",
                                "text": "At first it seemed like a very painless way to get my work done and I told Milly to let me sleepwrite as much as I liked. We discovered, however, that although my subconscious might lead me to the typewriter, it couldn't make me think."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf1cfe43-c8c8-47d9-822d-c236ce687d11",
