                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc29fb76-e0d9-4362-9c21-7b2e26218b60",
                                                "sense_id": "01d66d85-dbde-327e-aa85-c98285a752f0",
                                                "text": "Паломники пересекли Мраморное море, Дарданеллы и через Артакию, острова Лесбос, Хиос, Кос приплыли в Александрию, а оттуда, совершив плавание по Нилу отправились в Иоппию (Яффу) и Иерусалим."
                                            }
