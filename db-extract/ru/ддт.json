                "senses": [
                    {
                        "sense_id": "f4c52662-8cf6-35db-95e3-161b31dc34cf",
                        "entry_id": "fdb286ee-60fc-32b2-9d15-bf128b9a4890",
                        "glosses": [
                            "хим. сокр. от дихлордифенилтрихлорэтан; один из самых экологически опасных инсектицидов"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "faa83f69-21ee-4ea8-a783-f71620cd75ed",
                                "sense_id": "f4c52662-8cf6-35db-95e3-161b31dc34cf",
                                "text": "Машины производят обработку молодых посадок, опыление плантации препаратом ДДТ, уничтожающим розанную златку ― основного врага розовых плантаций, и т. д."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c021ba9-dfb3-3c31-9812-28894b1a0a81",
                        "entry_id": "fdb286ee-60fc-32b2-9d15-bf128b9a4890",
                        "glosses": [
                            "сокр. от дом детского творчества"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "10c3fc02-74b6-45c3-a41b-8407788cfafd",
                                "sense_id": "9c021ba9-dfb3-3c31-9812-28894b1a0a81",
                                "text": "Соперниками автозаводцев были ребята из ДДТ «Остров», ДЮЦ «Надежда» и гости из Снежинска."
                            }
                        ]
                    },
