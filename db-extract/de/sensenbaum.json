                                "example_id": "8402d97c-5d22-44ab-bfb9-2ac5834e4bd9",
                                "sense_id": "472ebcc1-f21d-381c-9657-57411f989f8e",
                                "text": "„Der Sensenbaum kann gerade oder S-förmig geschwungen sein.“"
                            }
                        ],
