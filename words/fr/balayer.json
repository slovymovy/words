    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1261909a-15fa-3c14-bbfd-854e200c9293",
                    "sense_definition": "Nettoyer un sol ou un espace à l'aide d'un balai en rassemblant la saleté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nettoyer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, mon frère prend le balai pour <w>balayer</w> la cuisine et le couloir."
                        },
                        {
                            "text": "Il faut <w>balayer</w> la poussière avant de laver le sol avec de l'eau."
                        }
                    ],
                    "synonyms": [
                        "nettoyer",
                        "épousseter"
                    ],
                    "antonyms": [
                        "salir",
                        "encombrer"
                    ],
                    "common_phrases": [
                        "balayer la poussière",
                        "balayer le sol",
                        "balayer devant sa porte"
                    ]
                },
                {
                    "sense_id": "c9a2715f-5460-3251-a556-b021caa87839",
                    "sense_definition": "Rejeter catégoriquement ou dissiper rapidement des doutes, des arguments ou des craintes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rejeter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a préféré <w>balayer</w> les objections soulevées par les journalistes lors du débat."
                        },
                        {
                            "text": "Ses explications claires ont suffi à <w>balayer</w> tous les doutes qui persistaient encore."
                        }
                    ],
                    "synonyms": [
                        "écarter",
                        "rejeter",
                        "dissiper"
                    ],
                    "antonyms": [
                        "accueillir",
                        "retenir"
                    ],
                    "common_phrases": [
                        "balayer d'un revers de main",
                        "balayer les doutes",
                        "balayer les objections"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens figuré"
                        }
                    ]
                },
                {
                    "sense_id": "ace926f9-596e-3863-a765-a7c43c9af521",
                    "sense_definition": "Vaincre ou battre facilement et nettement un adversaire lors d'une compétition ou d'une élection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vaincre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe locale a réussi à <w>balayer</w> ses adversaires dès la première mi-temps du match."
                        },
                        {
                            "text": "Le candidat a totalement <w>balayé</w> l'opposition lors du second tour des élections régionales."
                        }
                    ],
                    "synonyms": [
                        "écraser",
                        "battre",
                        "étriller"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "balayer un adversaire",
                        "balayer l'opposition"
                    ]
                },
                {
                    "sense_id": "ee38086d-4b63-3e3f-8d3b-030c93416a35",
                    "sense_definition": "Toucher et traîner sur le sol lors d'un déplacement, en parlant d'un long vêtement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "froler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La traîne de sa magnifique robe blanche <w>balayait</w> le sol de l'allée centrale."
                        },
                        {
                            "text": "Elle marchait lentement pour éviter que son long manteau ne <w>balaie</w> les pavés mouillés."
                        }
                    ],
                    "synonyms": [
                        "frôler",
                        "traîner"
                    ],
                    "common_phrases": [
                        "balayer le sol",
                        "balayer la terre"
                    ]
                },
                {
                    "sense_id": "8df18cbf-bd2e-36f9-8b63-46e0f020d7ce",
                    "sense_definition": "Couvrir une zone d'un mouvement régulier, qu'il s'agisse de tirs nourris ou d'un faisceau lumineux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "couvrir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le puissant projecteur du phare continuait de <w>balayer</w> la côte dans l'obscurité totale."
                        },
                        {
                            "text": "Les pièces d'artillerie installées sur la crête étaient prêtes à <w>balayer</w> la route."
                        }
                    ],
                    "synonyms": [
                        "mitrailler",
                        "arroser"
                    ],
                    "common_phrases": [
                        "balayer la zone",
                        "balayer la route"
                    ]
                }
            ]
        }
    ]
}