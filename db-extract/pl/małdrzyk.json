                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3bfe6f08-7540-3495-94a4-823553e68b25",
                        "entry_id": "48fabb6f-03a3-3cae-ac35-7db7181b5fbb",
                        "glosses": [
                            "rodzaj deseru, mały serek ze słodkiego mleka zwarzonego podpuszczką; zob. też małdrzyk, mądrzyk w Encyklopedii staropolskiej"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b8e8d7ac-6824-491b-ae73-7f043292ab27",
                                "sense_id": "3bfe6f08-7540-3495-94a4-823553e68b25",
                                "text": "Miał w teatrum kredens gustownie ozdobny, z cukrawi, limonadami, było dla amatorów wino i różne łakocie, szczególniej smaczne były małdrzyki z konfektami, w których sam król Imć i inni panowie wielce sobie gustowali"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "9b7c901c-ba13-35a9-9522-05e634b9400c",
                        "entry_id": "48fabb6f-03a3-3cae-ac35-7db7181b5fbb",
                        "glosses": [
                            "placuszek z białego sera utartego z jajami i smażonego na oleju, najczęściej podawany na słodko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "068b4e2f-f66d-43d5-8e32-629b2eb7157b",
                                "sense_id": "9b7c901c-ba13-35a9-9522-05e634b9400c",
                                "text": "Małdrzyki smaż z obu stron, podawaj posypane cukrem"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "f6b3dd9e-2520-3366-89c8-f457e82bf1f4",
                        "entry_id": "48fabb6f-03a3-3cae-ac35-7db7181b5fbb",
                        "glosses": [
                            "zob. ręce w małdrzyk"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "8f64703c-b603-4d09-a02e-50011948c289",
                                "sense_id": "f6b3dd9e-2520-3366-89c8-f457e82bf1f4",
                                "text": "Na moją prośbę usiadła na krześle naprzeciw, składając dłonie w małdrzyk niczym panienka z pensji"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
