                    {
                        "translation_id": "4573e1d6-688f-4605-abc7-0e7c51c82d98",
                        "source_entry_id": "2d47d432-6362-3619-a90c-baba0852a7ec",
                        "source_sense_description": "To produce a substance by chemical synthesis",
                        "target_lang_word": "synthétiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synthétiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                        "entry_id": "27bd98e7-d2fe-3d9e-af68-73fb83d97062",
                                        "glosses": [
                                            "Faire la synthèse de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7281f43-021d-4a69-97ba-174879aac187",
                                                "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                                "text": "Les lichens produisent les acides lichéniques, substances dues aux filaments du champignon, mais qui ne sont synthétisées qu’en présence de l’algue."
                                            },
                                            {
                                                "example_id": "c5c2b6cb-73ec-4971-a4f6-d9e15c638f9c",
                                                "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                                "text": "La plupart des enzymes protéolytiques sont habituellement synthétisées sous forme de précurseurs inactifs plus longs appelés zymogènes."
                                            },
                                            {
                                                "example_id": "5c20521a-abb2-43db-bdd1-f59f7e8bbad1",
                                                "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                                "text": "Un nanotube de carbone, c’est aussi une usine. Des chercheurs finlandais (université Aalto) ont synthétisé des nanorubans de graphène - autre variété de carbone - à l’intérieur de nanotubes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920a1eab-0d78-314e-b11d-7140bf7ee9df",
                                        "entry_id": "27bd98e7-d2fe-3d9e-af68-73fb83d97062",
                                        "glosses": [
                                            "Résumer, faire la synthèse de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3225ab81-f659-478d-9fcd-090ca38132f0",
                                                "sense_id": "920a1eab-0d78-314e-b11d-7140bf7ee9df",
                                                "text": "Dans ce dernier cours, plusieurs équipes s'étaient partagé la tâche de synthétiser des informations concernant diverses périodes de l'histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94c4007b-b1d1-447b-b05f-1081b4c67b26",
                        "source_entry_id": "2d47d432-6362-3619-a90c-baba0852a7ec",
                        "source_sense_description": "To produce a substance by chemical synthesis",
                        "target_lang_word": "synthetisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synthetisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a63f145-2d5e-3b78-90a6-bef6ef6f83d1",
                                        "entry_id": "be48ab02-66b3-3a0b-97de-8d879cd389b1",
                                        "glosses": [
                                            "aus einfachen Bestandteilen eine komplexe Verbindung aufbauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a20b26-e4a0-4919-8e96-ac0810bc6fc0",
                                                "sense_id": "2a63f145-2d5e-3b78-90a6-bef6ef6f83d1",
                                                "text": "Vitamin D ist das einzige Vitamin, das der menschliche Körper selbst synthetisieren kann."
                                            },
                                            {
                                                "example_id": "cd8601d8-cecc-4c17-9bcb-48b314855c2a",
                                                "sense_id": "2a63f145-2d5e-3b78-90a6-bef6ef6f83d1",
                                                "text": "„1832 synthetisierte Justus von Liebig aus Äthanol und Chlor das Chloralhydrat, das aber erst wesentlich später als Schlafmittel erkannt und von O. Liebreich 1869 in der Berliner Charité als Beruhigungsmittel bei erregten Psychosekranken eingesetzt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
