                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze trui is gemaakt van hoogwaardige, <w>gekamde</w> katoen.",
