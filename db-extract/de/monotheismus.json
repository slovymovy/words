                "senses": [
                    {
                        "sense_id": "9bfa560a-2dcf-37a3-83c5-f8a67753fcfc",
                        "entry_id": "29ea64c7-a599-3166-89b1-80ebaea677b0",
                        "glosses": [
                            "Monothéisme, croyance à un seul dieu."
                        ],
                        "tags": [],
                        "note": "Le pluriel est rare, et peut dénoter plusieurs formes de monothéisme ou plusieurs religions monothéistes (voir 2ᵉ exemple",
                        "examples": [
                            {
                                "example_id": "218e90f6-4271-40ab-aec9-eec559a198dd",
                                "sense_id": "9bfa560a-2dcf-37a3-83c5-f8a67753fcfc",
                                "text": "Während das Christentum dem Monotheismus zugewandt ist, glaubt man im Hinduismus an viele Götter.",
                                "translation": "Alors que le christianisme choisit la voie du monothéisme, on croit à maints dieux dans l'hindouisme."
                            },
                            {
                                "example_id": "d4104713-5e57-42f4-9a16-ffa3d0958e7c",
                                "sense_id": "9bfa560a-2dcf-37a3-83c5-f8a67753fcfc",
                                "text": "Gottes Eifer: Vom Kampf der drei Monotheismen",
                                "translation": "La folie de Dieu: du combat des trois monothéismes"
                            }
                        ]
                    }
                ],
