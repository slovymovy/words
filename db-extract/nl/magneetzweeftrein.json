                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a5f5388-0ec0-4c56-8763-46e6f72f281f",
                                "sense_id": "4838d2c6-9106-320d-b0d9-10c0f411cf0c",
                                "text": "De ramp met de magneetzweeftrein, afgelopen vrijdag in Noord-Duitsland, heeft de grensstad Nordhorn hard getroffen. Maar liefst tien van de in totaal 23 dodelijke slachtoffers waren werkzaam op het regiokantoor van energiereus RWE in Nordhorn."
                            },
                            {
                                "example_id": "38af82e2-f074-4a38-a2d0-a06c7750c7b3",
                                "sense_id": "4838d2c6-9106-320d-b0d9-10c0f411cf0c",
                                "text": "In Japan heeft een magneetzweeftrein een nieuw snelheidsrecord gevestigd. De trein haalde tijdens een testrit een snelheid van 603 km/uur."
                            }
                        ]
                    }
