                    {
                        "translation_id": "418de9f9-8dab-4eb8-b702-36797cd05d57",
                        "source_entry_id": "8a7f578a-006f-33e9-a795-26b803aae05b",
                        "source_sense_id": "1fe93e54-b8fb-372a-af13-a62cb0abf1ae",
