                {
                    "sense_id": "689f08eb-da39-33b3-a86e-4e71d1e84c7e",
                    "sense_definition": "A variety of a language or a level of usage, as determined by degree of formality and choice of vocabulary.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Academic writing usually requires a very formal <w>register</w>.",
                            "target_lang_translations": {
                                "ru": "Академическое письмо обычно требует очень формального <w>стиля</w>.",
                                "zh": "学术写作通常需要非常正式的<w>语体</w>。"
                            }
