                ],
                "senses": [
                    {
                        "sense_id": "756239aa-abe2-3e15-8819-57c589b05c8a",
                        "entry_id": "79622ec5-48a8-3af3-813b-c0ac871ac759",
                        "glosses": [
                            "verplichting om (tijdelijk) ergens te werken, met name bij de strijdkrachten van een land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31beb603-0e93-40d5-8d23-7369060ad2d2",
                                "sense_id": "756239aa-abe2-3e15-8819-57c589b05c8a",
                                "text": "De dienstplicht is in Nederland niet afgeschaft maar opgeschort."
                            },
                            {
                                "example_id": "1b5f1937-b97b-4125-a4cc-97e19765bcb4",
                                "sense_id": "756239aa-abe2-3e15-8819-57c589b05c8a",
                                "text": "Deze 23-jarige Israëli had net zijn driejarige militaire dienstplicht afgerond."
                            },
                            {
                                "example_id": "a70208b8-9f96-4202-912e-d4193a9537e4",
                                "sense_id": "756239aa-abe2-3e15-8819-57c589b05c8a",
                                "text": "Hij werd later gekozen tot rockkoning van heel Scandinavië op een gala in het Jordal Amfi in Oslo en kreeg als prijs de gelegenheid om Elvis op te zoeken, die zijn dienstplicht vervulde in West-Duitsland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3253611-27c4-44fc-9b39-63e1dd0da5a2",
                        "source_entry_id": "79622ec5-48a8-3af3-813b-c0ac871ac759",
                        "source_sense_id": "756239aa-abe2-3e15-8819-57c589b05c8a",
                        "source_sense_description": "verplichting om ergens te werken",
                        "target_lang_word": "Wehrpflicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wehrpflicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                        "entry_id": "02146ce4-e924-351b-8b2e-0017a28fbff5",
                                        "glosses": [
                                            "die Pflicht eines Staatsbürgers, einen zeitlich begrenzten Dienst in den Streitkräften des Landes zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fabe32-3309-4911-bb23-771590c1e15d",
                                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                                "text": "1813 führte Preußen die allgemeine Wehrpflicht ein."
                                            },
                                            {
                                                "example_id": "f3bc4ef6-f0ee-4ffc-8c70-5e5c819614b6",
                                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                                "text": "„Die Einführung der Wehrpflicht war nur ein Teil eines umfassenden Reformpakets.“"
                                            },
                                            {
                                                "example_id": "13a57821-5466-4fa3-8a2a-a2674ac48d0a",
                                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                                "text": "„Also forderten Hindenburg und Ludendorff eine Ausdehnung der Wehrpflicht auf alle Männer von 16 Jahren bis zum Rentenalter, sie sollten notfalls zwangsweise in der Rüstungsproduktion eingesetzt werden.“"
                                            },
                                            {
                                                "example_id": "e7a7dda9-d4a9-471f-ab33-a995994127ff",
                                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                                "text": "„Die »Reichswehr«, von der Benn spricht, heißt seit der Wiedereinführung der allgmeinen Wehrpflicht durch Hitler am 16. März 1935 »Wehrmacht« und soll mindestens auf Vorkriegsniveau aufgestockt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b536545-0653-475a-af5c-e27a699eb65c",
                        "source_entry_id": "79622ec5-48a8-3af3-813b-c0ac871ac759",
                        "source_sense_id": "756239aa-abe2-3e15-8819-57c589b05c8a",
