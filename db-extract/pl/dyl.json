                                "target_senses": [
                                    {
                                        "sense_id": "8b317a38-1056-332e-a6ea-e3d597d311cc",
                                        "entry_id": "b9013e1a-c4f5-3d25-9bd0-a26b6c0395cb",
                                        "glosses": [
                                            "ein langes, schmales, 12 bis 35 Millimeter starkes hölzernes Brett, welches als Fußbodenbelag und als Verschalung dient"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6287d1da-314d-4180-8394-d582df15b47b",
                                                "sense_id": "8b317a38-1056-332e-a6ea-e3d597d311cc",
                                                "text": "Die Dielen werden poliert."
                                            },
                                            {
                                                "example_id": "2457a4c6-b7e8-4fa6-9bfa-abf0f4017606",
                                                "sense_id": "8b317a38-1056-332e-a6ea-e3d597d311cc",
                                                "text": "Die weißgescheuerten Dielen knarrten, als sie sich der Tür näherte."
                                            },
                                            {
                                                "example_id": "1ba993bb-4e36-4005-a846-fff07e062eef",
                                                "sense_id": "8b317a38-1056-332e-a6ea-e3d597d311cc",
                                                "text": "„Das Schlafzimmer war leer. Leo ging in die Knie und legte den Kopf auf die Dielen. Ihr Koffer war nicht mehr da..“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bcb4e781-511b-3734-ab33-5f190e5a5ae5",
                                        "entry_id": "b9013e1a-c4f5-3d25-9bd0-a26b6c0395cb",
                                        "glosses": [
                                            "ein Hausflur, ein Vorraum, der sich hinter dem Eingang eines Hauses oder einer Wohnung befindet und von dem aus die einzelnen Wohnungen oder aber die einzelnen Zimmer zugänglich sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5459548c-2ea6-49ef-a3c2-28f63b9c7e26",
                                                "sense_id": "bcb4e781-511b-3734-ab33-5f190e5a5ae5",
                                                "text": "Der Mann wartet in der Diele auf seine Frau."
                                            },
                                            {
                                                "example_id": "6305adb0-95d8-40b1-8741-7c74f9253e37",
                                                "sense_id": "bcb4e781-511b-3734-ab33-5f190e5a5ae5",
                                                "text": "„Die Wohnung war sehr hell und schön, zunächst gab es eine große Diele und daneben drei größere Zimmer.“"
                                            },
                                            {
                                                "example_id": "21daeb1f-1d50-4558-bd2f-3a35ffdb0e59",
                                                "sense_id": "bcb4e781-511b-3734-ab33-5f190e5a5ae5",
                                                "text": "„Aber der Kinobesitzer, Herr Mandelstamm, war so freundlich und brachte für Mira einen der breiten Klubsessel aus der Diele herein und stellte ihn neben den Notausgang.“"
                                            },
                                            {
                                                "example_id": "4afa005b-062e-478d-a337-8f49fc861978",
                                                "sense_id": "bcb4e781-511b-3734-ab33-5f190e5a5ae5",
                                                "text": "„Es war meine Wirtin, und ich ging rasch zur Tür, öffnete sie nur halb und schlüpfte zu ihr in die Diele hinaus.“"
                                            },
                                            {
                                                "example_id": "c30c524d-0c9b-4782-8962-a25ff0580014",
                                                "sense_id": "bcb4e781-511b-3734-ab33-5f190e5a5ae5",
                                                "text": "„Er machte Platz und führte Ari zum Esszimmertisch, nicht weit von der Diele entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c153cbc1-f8f1-31df-8381-833b064112b9",
                                        "entry_id": "b9013e1a-c4f5-3d25-9bd0-a26b6c0395cb",
                                        "glosses": [
                                            "im norddeutschen Bauernhaus und norddeutschen Bürgerhaus der wichtigste und meist größte, zu ebener Erde gelegene Raum, welcher als Küche, Wohnraum, gegebenenfalls auch als Werkstatt und Verkaufsraum dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5ec716-eecb-4531-b281-c9b928b0c25b",
                                                "sense_id": "c153cbc1-f8f1-31df-8381-833b064112b9",
                                                "text": "Die große Diele eignet sich für viele Veranstaltungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e371a3b2-7e4a-3847-91b3-67f299955e84",
                                        "entry_id": "b9013e1a-c4f5-3d25-9bd0-a26b6c0395cb",
                                        "glosses": [
                                            "eine Eisdiele, eine Speisediele, eine Tanzdiele"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2988a474-5644-46ba-91cd-f5e4fe855171",
                                                "sense_id": "e371a3b2-7e4a-3847-91b3-67f299955e84",
                                                "text": "Sehen wir uns nachher noch in der Diele?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
