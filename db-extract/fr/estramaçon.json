        "fr-extract.jsonl": [
            {
                "entry_id": "218d109c-c035-3f75-b7d2-a165acbd392f",
                "word": "estramaçon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8ebf6f1c-55a3-4e60-8dc1-c8a940363862",
                        "entry_id": "218d109c-c035-3f75-b7d2-a165acbd392f",
                        "tags": [
                            "plural"
                        ],
                        "form": "estramaçons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96512ada-eefe-37ab-b7d6-2931241d382f",
                        "entry_id": "218d109c-c035-3f75-b7d2-a165acbd392f",
                        "glosses": [
                            "Tranchant d’une épée."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "61f0c1a4-6194-37f2-b4c6-51db3c5a1ead",
                        "entry_id": "218d109c-c035-3f75-b7d2-a165acbd392f",
                        "glosses": [
                            "Coup d’estramaçon, coup de taille."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "840e75cf-bfee-3006-bacb-fb432c8d9905",
                        "entry_id": "218d109c-c035-3f75-b7d2-a165acbd392f",
                        "glosses": [
                            "Forte épée de guerre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c811fe28-300c-458f-a05d-b9fec153193d",
                                "sense_id": "840e75cf-bfee-3006-bacb-fb432c8d9905",
                                "text": "La claymore écossaise est une sorte d’estramaçon."
                            },
                            {
                                "example_id": "f9560cd9-21e2-4769-b87c-3a77ed49025d",
                                "sense_id": "840e75cf-bfee-3006-bacb-fb432c8d9905",
                                "text": "Donc, sous son mantelet emportait sa richesse,\nSa lyre qui vibrait pour l'hospitalité ;\nEt son estramaçon sans cesse\nDemi-tiré pour sa maîtresse,\nBrandissant pour sa liberté !"
                            },
                            {
                                "example_id": "5144d1d2-594a-4f81-89ee-b4417d610f0f",
                                "sense_id": "840e75cf-bfee-3006-bacb-fb432c8d9905",
                                "text": "Seulement ils avaient l’air plus gai que de coutume, et on leur voyait à tous reluire quelque arme entre les jambes, une serpe, une cognée, un gros estramaçon, ou le croc d’une vieille hacquebute."
                            },
                            {
                                "example_id": "323ea200-371c-4f1b-ac15-03a18e72f29c",
                                "sense_id": "840e75cf-bfee-3006-bacb-fb432c8d9905",
                                "text": "Le soir, il n’y avait plus derrière une barricade improvisée qu’une trentaine de combattants, à la tête desquels un homme levait à chaque instant son estramaçon rouge qu’il tenait à deux mains, et qui à chaque fois retombait sur un crâne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79703292-7f22-43f8-874c-9b7c948c503f",
                        "source_entry_id": "218d109c-c035-3f75-b7d2-a165acbd392f",
                        "target_lang_word": "estramaçon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estramaçon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5aff7a5-ee0b-33df-a37e-529a37f8ad8e",
                                        "entry_id": "f33a5bfc-ca43-3016-a424-f1647348b7e5",
                                        "glosses": [
                                            "A straight, heavy sword with two edges, used in the 16th and 17th centuries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e272d0b-4ecb-456b-81cf-b6353a8a8fda",
                                                "sense_id": "c5aff7a5-ee0b-33df-a37e-529a37f8ad8e",
                                                "text": "Then to the pair, who speechless stood, he stretch'd\nA table-spread, bade each to hold an end,\nAnd with clear voice: \"As we, the Church's arm,\nWith this estramacon do smite in twain\nThe texture of this fabric\" (here he flash'd\nThe blade between the two, cleaving the cloth), […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf1b6b7-237b-3779-8703-40a626fcf798",
                                        "entry_id": "f33a5bfc-ca43-3016-a424-f1647348b7e5",
                                        "glosses": [
                                            "A downward cutting blow with the edge of a sword or fencing weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a47cbe6-fbad-4974-b035-547434460c77",
                                                "sense_id": "fbf1b6b7-237b-3779-8703-40a626fcf798",
                                                "text": "I tripped a hasty morrice[…]upon the dining table, now offering my sword [to the Duke of Buckingham], now recovering it, I made a blow at his nose—a sort of estramaçon—the dexterity of which consists in coming mighty near to the object you seem to aim at, yet not attaining it."
                                            },
                                            {
                                                "example_id": "cda117fa-8df7-4ca1-9c1a-3fe01f2f845b",
                                                "sense_id": "fbf1b6b7-237b-3779-8703-40a626fcf798",
                                                "text": "Dost think I could ride a horse and learn the tricks of Carricade and sly passata, Stramazon and bold stoccata, Maudritta to embrocata."
                                            },
                                            {
                                                "example_id": "550b5579-06f3-4df4-8971-5128bedd2d49",
                                                "sense_id": "fbf1b6b7-237b-3779-8703-40a626fcf798",
                                                "text": "In general we know that early armor of this type was often tried out by the chopping cut (estramaçon) of a sword, and that a similar test was used throughout Europe down to the seventeenth century."
                                            },
                                            {
                                                "example_id": "c7655d0e-55d6-4462-9bde-23a84abc66c4",
                                                "sense_id": "fbf1b6b7-237b-3779-8703-40a626fcf798",
                                                "text": "Colombino used his left arm as a buckler, and before the ruffian could disentangle his blade from the Captain's cloak, a swift estramacon came to sever the sinews of his sword-arm."
                                            },
                                            {
                                                "example_id": "d7971f17-f949-41c3-a81e-984cd5be266c",
                                                "sense_id": "fbf1b6b7-237b-3779-8703-40a626fcf798",
                                                "text": "In speaking of head-pieces he states, on the same page, that the heavier kinds were proved with musket-shot, but the light varieties were only tested with \"estramaçon\" or sword-cut; and he adds that for armour to be good it must be beaten and worked cold and not hot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c8d50c3-bd78-4e91-90d6-27963498b78f",
                        "source_entry_id": "218d109c-c035-3f75-b7d2-a165acbd392f",
                        "target_lang_word": "broadsword",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broadsword",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66ee0f2a-697b-3e6b-9039-51c80cb4c2f9",
                                        "entry_id": "368330e1-7f86-3502-b090-de6daddae6fe",
                                        "glosses": [
                                            "A type of early modern sword that has a broad double-edged blade for cutting (as opposed to the more slender thrust-oriented rapier) and typically a basket hilt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36260ae6-670e-4b84-ae6f-b190251a52fc",
                                                "sense_id": "66ee0f2a-697b-3e6b-9039-51c80cb4c2f9",
                                                "text": "The principal distinction between the broadsword and the rapier is, that the latter is formed only for thrusting, while the former is adapted for cutting also. Indeed, those who use the broadsword are, in my opinion, too apt to neglect the use of the point, and to give their attention almost exclusively to the cuts."
                                            },
                                            {
                                                "example_id": "395332da-be45-4c97-8d80-67962d71598a",
                                                "sense_id": "66ee0f2a-697b-3e6b-9039-51c80cb4c2f9",
                                                "text": "One version of the broadsword, the Highland broadsword, was adopted as the national sword of Scotland. Another, the schiavona, was Italy's version of the weapon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f79071b-f330-3995-b407-789eec2a275a",
                                        "entry_id": "368330e1-7f86-3502-b090-de6daddae6fe",
                                        "glosses": [
                                            "A person armed with such a sword."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48d4732e-6ef9-3208-8758-0fbc340cc5c6",
                                        "entry_id": "368330e1-7f86-3502-b090-de6daddae6fe",
                                        "glosses": [
                                            "Synonym of longsword."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e2225b8-1cf0-4ca0-9438-84823950b6f9",
                                                "sense_id": "48d4732e-6ef9-3208-8758-0fbc340cc5c6",
                                                "text": "The Brythunian's arm drew back; the ancient broadsword with its strange, clawed quillons arcked spinning through the air."
                                            },
                                            {
                                                "example_id": "8c953ad0-89e1-4c79-89f4-c5d9d7f7352f",
                                                "sense_id": "48d4732e-6ef9-3208-8758-0fbc340cc5c6",
                                                "text": "Henry carried a heavy broadsword with a cruciform hilt, and a decorated dagger on his hip known as a misericord because its blade could release souls. The English knights and men-at-arms carried broadswords, maces for smashing skulls and the murderous pole-axe, combining a spear with an axehead about five feet long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9067b02-a762-3feb-bb78-53d06858945d",
                                        "entry_id": "368330e1-7f86-3502-b090-de6daddae6fe",
                                        "glosses": [
                                            "A flat, rectangular bread made from corn (maize) and beans by the Cherokee, traditionally by boiling rather than baking it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43221112-511f-438e-9679-8cbb41429930",
                                                "sense_id": "c9067b02-a762-3feb-bb78-53d06858945d",
                                                "text": "Cherokee \"broadswords'\" and \"dog-heads,\" or Iroquois wedding breads (paired like dumbbells) might be eaten and described by visitors, but apparently were not adapted by colonial farmers other than a few intermarried pioneers."
                                            },
                                            {
                                                "example_id": "cd8d9394-9110-4e1c-863e-acd497be71c0",
                                                "sense_id": "c9067b02-a762-3feb-bb78-53d06858945d",
                                                "text": "These breads were noted by early English explorers of the East Coast and continue to be made as Cherokee broadswords, Navajo kneel-down bread, and other dishes. Tamale pie is one of a group of American foods invented outside the ethnic[…]"
                                            },
                                            {
                                                "example_id": "e72727f1-215d-42e8-af9b-3c3c31f0b4a9",
                                                "sense_id": "c9067b02-a762-3feb-bb78-53d06858945d",
                                                "text": "Then took two broadsword corn dumplings from the basket Mother left out on the porch last night. Ate them as I walked our line of rail fence after letting out the cows from the barn. The dumplings were delicious, and I wished I had[…]"
                                            },
                                            {
                                                "example_id": "2b6ce9fb-1538-495f-9c5f-64fd8e1c0cdd",
                                                "sense_id": "c9067b02-a762-3feb-bb78-53d06858945d",
                                                "text": "Well, after awhile we just sat right down there on the ground by that fire beside the creek, and we ate some of those broadswords, hot and fresh, and I tell you, that was the best bean bread I ever ate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "broadsword",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a7c657-c8e8-35fb-aa54-6f86bc1cf075",
                                        "entry_id": "1eb24a6e-2bac-322e-8727-c314e56591a6",
                                        "glosses": [
                                            "To attack or kill with a broadsword."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a177fb-068f-4454-af6a-ece5b9e1895e",
                                                "sense_id": "c6a7c657-c8e8-35fb-aa54-6f86bc1cf075",
                                                "text": "She’d met her first black knight—a pock-faced man in his sixties, wearing an ugly brown hat—and escaped from him without being broadsworded to death."
                                            },
                                            {
                                                "example_id": "04125b8d-62db-4deb-92b3-0d259deb9add",
                                                "sense_id": "c6a7c657-c8e8-35fb-aa54-6f86bc1cf075",
                                                "text": "He broadsworded one of his dogs in exuberance and it lay there whimpering till it expired."
                                            },
                                            {
                                                "example_id": "3c9aab3c-69d4-4795-8acc-b13715d17f44",
                                                "sense_id": "c6a7c657-c8e8-35fb-aa54-6f86bc1cf075",
                                                "text": "He took his steel-edged ruler, screamed and then broadsworded the snake into two equal lengths."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
