                        "cross_references": [
                            {
                                "target_word": "audio commentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e44309-b096-3b2d-b2f9-b4cdb8931ab2",
                                        "entry_id": "b0ffaa97-c6fd-3902-a091-09bb28ab0635",
                                        "glosses": [
                                            "An audio track on a video recording, timed to the footage of a film, that typically consists of one or more people commenting about the film being shown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703bc3e3-4efb-4177-9b20-e2a641710c1a",
                                                "sense_id": "77e44309-b096-3b2d-b2f9-b4cdb8931ab2",
                                                "text": "According to the audio commentary on “Treehouse of Horror III”, some of the creative folks at The Simpsons were concerned that the “Treehouse of Horror” franchise had outworn its welcome and was rapidly running out of classic horror or science-fiction fodder to spoof."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
