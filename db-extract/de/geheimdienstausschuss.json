                "senses": [
                    {
                        "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                        "entry_id": "2b535032-ce9c-3d65-814d-4396e6d0957e",
                        "glosses": [
                            "Gruppe von Personen (meist Politikern), die den/die Geheimdienst/-e ihres Staates kontrollieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1745be5-2f60-4052-9eb2-c30b579d5fef",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Mittlerweile interessiert sich auch der Geheimdienstausschuss des Repräsentantenhauses für die CIA-Pläne.“"
                            },
                            {
                                "example_id": "18057472-e20c-4103-901d-37feb3dfc398",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Der Geheimdienstausschuss und der Ausschuss für Finanzdienstleistungen im Repräsentantenhaus haben Dokumente unter Strafandrohung angefordert.“"
                            },
                            {
                                "example_id": "94540913-a291-4dba-81d6-ec543c7a9ca6",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Der Geheimdienstausschuss des US-Senats hat die Veröffentlichung seines Berichts über brutale Verhörmethoden des Geheimdienstes CIA in der Regierungszeit von Präsident George W. Bush beschlossen.“"
                            },
                            {
                                "example_id": "417cf57f-5fe7-4513-9621-f0316dfb8d91",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Der Geheimdienstausschuss des britischen Parlaments ist sich sicher, dass Russland beim schottischen Unabhängigkeitsreferendum 2014 mitgemischt hat - mit großer Wahrscheinlichkeit auch beim Brexit-Referendum 2016.“"
                            },
                            {
                                "example_id": "88d25804-944e-4cec-9481-0c50402cd22b",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Was war am 5. Mrz. 1986? – Der Geheimdienstausschuss und ein Unterausschuss des Repräsentantenhauses für auswärtige Angelegenheiten lehnen die von US-Präsident Ronald Reagan beantragte Militärhilfe für die antisandinistischen Contras in Nicaragua ab.“"
                            },
                            {
                                "example_id": "8078a878-5df0-4fde-b176-2293a47574be",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Der Vorsitzende des Geheimdienstausschusses des Repräsentantenhauses, Adam Schiff, warf Trump vor, seine Befugnis zur Begnadigung missbraucht zu haben.“"
                            },
                            {
                                "example_id": "f12583f6-423b-4d49-bb3a-e4791f4b4ae0",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Im Oktober hatte er vor dem Geheimdienstausschuss des Kongresses ausgesagt, dass die Trump-Regierung Militärhilfen für die Ukraine nur auszahlen wollte, wenn der ukrainische Präsident öffentlich Korruptionsermittlungen gegen den Sohn von Trump-Rivale Joe Biden verkündet.“"
                            },
                            {
                                "example_id": "b2047944-c922-4a4a-9ae3-c16a161b40f5",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Die britische Abgeordnete Laila Moran zitiert den alarmierenden Bericht des Geheimdienstausschusses im Unterhaus von 2020, wonach »viele Russen mit engen Beziehungen zu Putin in die britische Wirtschaft und das soziale Leben gut integriert sind«.“"
                            },
                            {
                                "example_id": "7cbf2443-99c8-4634-b18e-0bad5f04a033",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Der US-Geheimdienst CIA gibt zu, Computer des Geheimdienstausschusses des Senats ausgespäht zu haben.“"
                            },
                            {
                                "example_id": "76415afb-71d5-4947-aabf-09726c80c0f8",
                                "sense_id": "434bd8a6-2214-38ee-b4be-ff4057635e2a",
                                "text": "„Zwei weitere Stunden wird sich Robert Mueller dann im Geheimdienstausschuss den Fragen der Abgeordneten stellen müssen“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
