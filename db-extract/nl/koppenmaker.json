                            {
                                "example_id": "b4fa4f2e-1e80-499d-9ded-7d134a5a75ba",
                                "sense_id": "5d81a93b-369f-3e94-928a-d152720771b5",
                                "text": "\"Ajax recht rug na zwak begin.\" Als Erik ten Hag koppenmaker bij de krant zou zijn, zou dat boven het verhaal over de in 2-2 geëindigde topper Ajax-PSV staan. Mede dankzij kersverse aankoop Sébastien Haller, die de assist verzorgde op de gelijkmaker."
                            },
                            {
                                "example_id": "58d4f79f-72af-4a8a-a916-bcd3c030deed",
                                "sense_id": "5d81a93b-369f-3e94-928a-d152720771b5",
                                "text": "De koppenmaker zocht zijn oplossing, heel sportief, in een groot dubbelportret van beide mannen. Daaronder de tekst 'Un choix historique' (een historische keuze), iets dat met een beetje goede wil opgaat voor alle verkiezingen."
                            }
                        ]
                    }
