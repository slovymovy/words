                        "glosses": [
                            "een wetenschappelijke samenkomst waarop verschillende wetenschappers een lezing houden over een bepaald onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66974bf1-028e-40bb-9f88-c42e1d0e7c08",
                                "sense_id": "98067b2e-2098-3f4e-9d6e-480034b671ef",
                                "text": "Op symposia krijgt men de kans over de nieuwste ontwikkelingen in een vakgebied te horen en te spreken."
                            }
                        ]
