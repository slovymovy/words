                        "sense_id": "5d588364-0647-3d1c-b563-8c141dddc71b",
                        "entry_id": "c27edb37-71d8-3a9b-b842-4c0036635905",
                        "glosses": [
                            "Any of the microdrile oligochaetes of the family Enchytraeidae, which resemble small earthworms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22f68e43-1e04-41b5-91fe-a0fe25d32361",
                                "sense_id": "5d588364-0647-3d1c-b563-8c141dddc71b",
                                "text": "The effect of fertilizers on the diversity of enchytraeids has not been studied but occurrence of high abundance of enchytraeids after organic manure application has been noted."
                            },
                            {
                                "example_id": "935c5775-f3d0-46f5-a64e-e1d4c5d72665",
                                "sense_id": "5d588364-0647-3d1c-b563-8c141dddc71b",
                                "text": "Enchytraeids probably consume and further process larger fecal pellets and castings of soil macrofauna, such as collembolans and earthworms (Zachariae, 1984; Rusek, 1985)."
                            },
                            {
                                "example_id": "e6f160b6-2ed0-4a49-b5d9-d651bafb631e",
                                "sense_id": "5d588364-0647-3d1c-b563-8c141dddc71b",
                                "text": "The exclusion of enchytraeids from many treatises and aquatic oligochaetes keys cannot be justified as approximately one third of the total enchytraeid species (Martin et al. 2008) inhabit aquatic habitats."
                            }
                        ]
                    }
                ],
