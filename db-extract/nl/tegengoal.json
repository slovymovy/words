                        "examples": [
                            {
                                "example_id": "88a805b0-04c6-44ea-ac37-6c134e1a0d43",
                                "sense_id": "a7815ce3-2391-3069-85f2-9171fa67035a",
                                "text": "Na die tegengoal was PSV wakker geschud. De ploeg kwam onder leiding van regisseur Gastón Pereiro beter in de wedstrijd. Nadat de doorgebroken Steven Bergwijn eerst nog neer werd gehaald en scheidsrechter Mulder geen rood gaf, was het daarna wél raak."
                            },
                            {
                                "example_id": "65fbfd86-df4f-46ee-93fd-0c368f36fada",
                                "sense_id": "a7815ce3-2391-3069-85f2-9171fa67035a",
                                "text": "Toch valt het niet veel later stil in de Arena als Tomasz Kedziora scoort na een door Klaas-Jan Huntelaar weggeven corner scoort. Het was vooraf misschien wel de belangrijkste doelstelling: thuis geen tegengoals krijgen. Maar toch even niet scherp en pats: raak."
                            }
                        ]
                    }
