                                                "example_id": "500c062b-acc5-4305-be9c-dea11901f11e",
                                                "sense_id": "9a68dc3b-8cca-3ccd-ac35-b73df09f175f",
                                                "text": "Wir sollten besser noch eine Zwischenwand einziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b72ba1fb-3272-34bb-b452-736fd3d1a435",
