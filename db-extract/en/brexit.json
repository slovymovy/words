                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db05b61a-37fe-4dc9-9fd8-d2a3cae0dae5",
                                "sense_id": "6317d27d-04ab-37de-8b56-d15c625a0a03",
                                "text": "If you were lawfully resident in an EU country before 1 January 2021, your rights are protected by the Withdrawal Agreement. You continue to have broadly the same rights to live, work, study and access benefits and services as you had before Brexit.",
                                "translation": "Als u legaal in een EU-lidstaat verbleef voor 1 januari 2021, zijn uw rechten beschermd door het Uittredingsakkoord. U behoudt over het algemeen dezelfde rechten om te verblijven, werken, studeren en voorzieningen te gebruiken als u voor Brexit had."
                            }
                        ]
                    }
