                "senses": [
                    {
                        "sense_id": "6acd63f1-1bd6-31a6-9165-a547f441bcec",
                        "entry_id": "c7ab02cd-97a9-3913-9dbd-fb08bb1bea37",
                        "glosses": [
                            "Comportement, caractéristique ou objet qui calme ou inhibe l’amour, le désir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77391c88-9d2d-406a-9753-16fd95f3b12c",
                                "sense_id": "6acd63f1-1bd6-31a6-9165-a547f441bcec",
                                "text": "L’idée est qu’il faut avoir plus qu’une simple distance entre les tables pour installer la confiance : il faut recréer une architecture intérieure avec des barrières physiques les plus élégantes et légères possibles, pour éviter le tue-l’amour ou de perdre l’âme des lieux."
                            },
                            {
                                "example_id": "42032878-fe72-4a64-8aaf-58324d1efefa",
                                "sense_id": "6acd63f1-1bd6-31a6-9165-a547f441bcec",
                                "text": "Si les excréments sont « un tue-l’amour absolu », selon Jean-Claude Kaufmann, c’est parce que notre façon d’aller au petit coin est révélatrice de nos rapports à l’intimité."
                            }
                        ]
                    }
