    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                "word": "kryptonite",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7ff7d6a1-48d0-4e1e-800a-8827915c7049",
                        "entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "tags": [
                            "plural"
                        ],
                        "form": "kryptonites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a87f50c1-eed0-3689-9688-872570cd3a5d",
                        "entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "glosses": [
                            "The one weakness of something or someone that is otherwise invulnerable."
                        ],
                        "tags": [
                            "figuratively",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2cc1b5cd-8283-43d3-99a9-6662f59742e2",
                                "sense_id": "a87f50c1-eed0-3689-9688-872570cd3a5d",
                                "text": "The terrific seven-grain bread here is the kryptonite of restaurant reviewers: two mini-loaves and you are incapacitated."
                            },
                            {
                                "example_id": "22e65bec-24f0-4865-b9a0-b8820c217986",
                                "sense_id": "a87f50c1-eed0-3689-9688-872570cd3a5d",
                                "text": "So while recording or sampling a Charlie Manson track […] makes for shock rock kudos aplenty, a devotion to Hubbard is kryptonite for credibility."
                            },
                            {
                                "example_id": "166a4c38-6699-496a-be98-fd1b52bb7b95",
                                "sense_id": "a87f50c1-eed0-3689-9688-872570cd3a5d",
                                "text": "We all have our own kryptonite or kryptonites, so don't tempt yourself by listening to so-called friends who are just demonic tools being used to bring you under."
                            },
                            {
                                "example_id": "f26a5ad6-e6b6-4fd7-acf2-be91f31490f2",
                                "sense_id": "a87f50c1-eed0-3689-9688-872570cd3a5d",
                                "text": "But of course porn is kryptonite to many investors."
                            }
                        ]
                    },
                    {
                        "sense_id": "4376ef70-2706-3c20-96f3-869745597880",
                        "entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "glosses": [
                            "Crack cocaine."
                        ],
                        "tags": [
                            "slang",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77155cb9-cf42-4fd8-a614-d2d5a256baa6",
                        "source_entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "source_sense_description": "weakness",
                        "target_lang_word": "kryptoniet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
