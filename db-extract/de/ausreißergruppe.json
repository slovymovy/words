                "senses": [
                    {
                        "sense_id": "650356c4-e8f8-3e54-9c1a-cbaa568a15f6",
                        "entry_id": "d0b8df1f-8bc1-3fb8-94a5-9bb469e2af4a",
                        "glosses": [
                            "Gruppe von Fahrern, die während eines Rennens einen mehr oder minder großen Vorsprung vor dem Hauptfeld herausfahren kann"
                        ],
                        "tags": [
                            "Radsport"
                        ],
                        "examples": [
                            {
                                "example_id": "45e7a9d2-f8d5-4da3-b97d-8028592941cb",
                                "sense_id": "650356c4-e8f8-3e54-9c1a-cbaa568a15f6",
                                "text": "Die gestrige Etappe wurde die Beute einer Ausreißergruppe."
                            },
                            {
                                "example_id": "bfcbdb02-7fc9-4114-81c9-63c50315f034",
                                "sense_id": "650356c4-e8f8-3e54-9c1a-cbaa568a15f6",
                                "text": "„Zunächst versuchten vier Fahrer davonzuziehen, daraus entwickelte sich eine 24-köpfige Ausreißergruppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
