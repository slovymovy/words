                "senses": [
                    {
                        "sense_id": "aa160586-f5f2-385f-a5a2-ead3cb624ab5",
                        "entry_id": "633dca5d-9bb5-30a9-b656-80e901ab01fd",
                        "glosses": [
                            "D’une manière théâtrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573d01ef-13a5-488f-98ce-ad52e6bcfea5",
                                "sense_id": "aa160586-f5f2-385f-a5a2-ead3cb624ab5",
                                "text": "Il se flatte beaucoup trop : cet ouvrage [Pulchérie] ne fut point heureux à la représentation et ne le sera jamais à la lecture, puisqu’il n’est ni intéressant, ni conduit théâtralement, ni bien écrit, il s’en faut beaucoup."
                            },
                            {
                                "example_id": "a361ea93-f739-47a7-aca5-3c527f226dab",
                                "sense_id": "aa160586-f5f2-385f-a5a2-ead3cb624ab5",
                                "text": "C’est ici que toute la rage antiphilosophique s’est déployée ; elle a dit : Sénèque veut mourir théâtralement […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a975a1a-e297-4227-9d11-38e6ce61b276",
                        "source_entry_id": "633dca5d-9bb5-30a9-b656-80e901ab01fd",
                        "source_sense_id": "aa160586-f5f2-385f-a5a2-ead3cb624ab5",
                        "target_lang_word": "theatrically",
