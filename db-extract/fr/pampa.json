        "fr-extract.jsonl": [
            {
                "entry_id": "009d377b-63e1-3916-890b-658028e3e1c7",
                "word": "pampa",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7e04c3b-0027-4638-b058-3dc0b0768c2c",
                        "entry_id": "009d377b-63e1-3916-890b-658028e3e1c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "pampas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec088054-d9db-3e87-b8cc-e3a328392605",
                        "entry_id": "009d377b-63e1-3916-890b-658028e3e1c7",
                        "glosses": [
                            "Vaste plaine d’Amérique du Sud, dont le climat et la végétation sont ceux de la steppe (prairie, savane, brousse tempérée)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b354664e-5ad6-4b56-adf5-7f8c01ac2a93",
                                "sense_id": "ec088054-d9db-3e87-b8cc-e3a328392605",
                                "text": "Lui, un homme d’action autrefois, était devenu une étonnante machine à rêve comme ceux qui ont longtemps habité la mer ou les pampas : toujours l’horizon ou le mur de leur chambre a quelque confuse nouvelle à leur annoncer."
                            },
                            {
                                "example_id": "186aaa21-4ac1-41b8-b9dd-4838307483bb",
                                "sense_id": "ec088054-d9db-3e87-b8cc-e3a328392605",
                                "text": "Dans une prairie, toutes les plantes sont herbacées et on n'y voit en général pas un arbuste ou un arbre isolé. Je parle naturellement des paysages naturels comme la Prairie ou la Pampa."
                            },
                            {
                                "example_id": "47d12ded-61e7-4d55-a638-45de67f43a68",
                                "sense_id": "ec088054-d9db-3e87-b8cc-e3a328392605",
                                "text": "À l'inverse nous savons, pour reprendre le mot de Supervielle à propos de la pampa argentine, que « trop d'espace nous étouffe, beaucoup plus que s'il n'y en avait pas assez. »"
                            },
                            {
                                "example_id": "7d3e9d5d-c18a-4f58-8cb1-9eae4ce2db7f",
                                "sense_id": "ec088054-d9db-3e87-b8cc-e3a328392605",
                                "text": "J'ignorerai toujours ces délices de la pampa, dit Gregovorius. Mais il me semble qu'on avait parlé d'autre chose à boire."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5ed128b-48e1-39c2-b7f3-48c400eb4b1f",
                        "entry_id": "009d377b-63e1-3916-890b-658028e3e1c7",
                        "glosses": [
                            "Coin de campagne reculé, vaste plaine, cambrousse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c26e36-e515-4ce7-8179-c0872cfce160",
                                "sense_id": "d5ed128b-48e1-39c2-b7f3-48c400eb4b1f",
                                "text": "J'ai passé un mois au fond de la pampa, complètement coupé du reste du monde."
                            },
                            {
                                "example_id": "f77d9016-e5d7-4ab1-86a3-a572b933ff9b",
                                "sense_id": "d5ed128b-48e1-39c2-b7f3-48c400eb4b1f",
                                "text": "C'était une partie de chasse ou de pêche en Camargue, vers l'étang du Vacarès, parmi les boeufs et les chevaux sauvages librement lâchés dans ce coin de pampas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f524347-14b5-4cd9-a697-3b66591a1d05",
                        "source_entry_id": "009d377b-63e1-3916-890b-658028e3e1c7",
                        "source_sense_description": "Vaste plaine d’Amérique du Sud.",
                        "target_lang_word": "Pampa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pampa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "897da9a0-6eb1-3b5a-97ef-3b57fe44e909",
                                        "entry_id": "e57ab213-4dde-3cd0-bdac-199dcfe80779",
                                        "glosses": [
                                            "südamerikanische Steppe; Grassteppe Argentiniens"
                                        ],
                                        "tags": [
                                            "meist im Plural verwendet",
                                            "spezialisierend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b59a7bd4-3ef4-4d46-af07-4fe43b4f0f6e",
                                                "sense_id": "897da9a0-6eb1-3b5a-97ef-3b57fe44e909",
                                                "text": "Argentinien besteht überwiegend aus der Pampa."
                                            },
                                            {
                                                "example_id": "377c80df-780f-4c0c-9e1e-232572ec2ba0",
                                                "sense_id": "897da9a0-6eb1-3b5a-97ef-3b57fe44e909",
                                                "text": "„Die durch die Pampas reisende Gesellschaft hatte ihre Zelte in weitem Halbkreise aufgeschlagen. In der Mitte desselben brannten die von Pferdemist genährten Feuer, über denen Fleischstücke schmorten.“"
                                            },
                                            {
                                                "example_id": "f636b70b-657f-4886-b11b-89e0e414ca08",
                                                "sense_id": "897da9a0-6eb1-3b5a-97ef-3b57fe44e909",
                                                "text": "„Das Gras der Pampas wurde höher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c63db80-5641-3456-af24-d0dc3ad8b554",
                                        "entry_id": "e57ab213-4dde-3cd0-bdac-199dcfe80779",
                                        "glosses": [
                                            "dünn besiedelte, einsame, abgelegene Gegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5728ac9f-e41e-47e9-ad09-7bda7c999b25",
                                                "sense_id": "7c63db80-5641-3456-af24-d0dc3ad8b554",
                                                "text": "In was für eine Pampa schleppst du mich denn?"
                                            },
                                            {
                                                "example_id": "86c796cb-a178-46e6-8e98-4655d4101a52",
                                                "sense_id": "7c63db80-5641-3456-af24-d0dc3ad8b554",
                                                "text": "Rambazamba in der Pampa!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "768d53fa-bfed-4893-b4b5-dfc38be55806",
                        "source_entry_id": "009d377b-63e1-3916-890b-658028e3e1c7",
