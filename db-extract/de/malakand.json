                        "examples": [
                            {
                                "example_id": "bd4997d8-2383-40af-a5af-00643549b999",
                                "sense_id": "200b131a-f045-30e4-bba1-5bd5df2ec09d",
                                "text": "„Vom grünen und dicht bewaldeten Land Swat waren sie zur Hochebene von Malakand mit ihren künstlich bewässerten Obstgärten und Feldern hinabgestiegen.“"
                            },
                            {
                                "example_id": "5fea33e6-6acf-44d0-b0bc-e3867672e92a",
                                "sense_id": "200b131a-f045-30e4-bba1-5bd5df2ec09d",
                                "text": "„The Hit Parade hatte nicht nur hohe Funktionäre aus den drei größten politischen Parteien Pakistans bestochen, sie bezahlte auch die Führer von vier Stämmen in den Grenzgebieten, zwei in Nord-Waziristan, einen in Orakzai und einen in Malakand.“"
                            }
                        ],
