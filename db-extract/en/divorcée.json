                "senses": [
                    {
                        "sense_id": "4cf1f54b-f76b-3d1a-81bf-c1c358ca2037",
                        "entry_id": "77598e3f-38c4-30d0-93d3-00fa2ab5a9d0",
                        "glosses": [
                            "Divorced (of a woman)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ed11a6f3-0e3a-46d7-a127-c8795b523328",
                                "sense_id": "4cf1f54b-f76b-3d1a-81bf-c1c358ca2037",
                                "text": "[She went] ballistic on him and told him that a woman who was divorcee, with three kids to raise, only wanted him for support."
                            },
                            {
                                "example_id": "38c20a41-4fbc-4932-9d19-8e14256fdab4",
                                "sense_id": "4cf1f54b-f76b-3d1a-81bf-c1c358ca2037",
                                "text": "We -- we -- since she was divorcée, I persuaded our minister unfortunately to -- to give them together, just the same."
                            },
                            {
                                "example_id": "e817ee35-d371-4fd4-8c0c-3e67cb4298d0",
                                "sense_id": "4cf1f54b-f76b-3d1a-81bf-c1c358ca2037",
                                "text": "[She] was divorcee and had a kid (daughter). I accepted the kid and I kept her as my own child."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
