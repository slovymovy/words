                "senses": [
                    {
                        "sense_id": "becc7d37-000b-37ac-9615-021fab1bd915",
                        "entry_id": "8c5ec62c-2317-3d6b-a7dd-2c58e347e028",
                        "glosses": [
                            "Robe longue et ample aux manches longues et de couleur sombre, couvrant la tête, sauf le visage, jusqu’aux pieds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890b7bd8-aa58-4595-8242-a8fe5d7d72ce",
                                "sense_id": "becc7d37-000b-37ac-9615-021fab1bd915",
                                "text": "Quand elle se regarde dans le rétroviseur intérieur après avoir noué l’étoffe de coton autour de sa tête, elle se dit que son turban coloré ne lui permet en rien de se fondre dans la masse des femmes en hidjab et souvent en jilbab austère qu’elle aperçoit sur les trottoirs."
                            },
                            {
                                "example_id": "5f5111af-2bd2-49bb-a0ed-5aea0f4c10c1",
                                "sense_id": "becc7d37-000b-37ac-9615-021fab1bd915",
                                "text": "Je porte le jilbab, parce que la religion est très importante pour moi », explique-t-elle, en glissant d’un sourire: « si je fais ça, c’est pour avoir le paradis."
                            },
                            {
                                "example_id": "47028e27-1100-487e-b4c0-89ea8a77ea00",
                                "sense_id": "becc7d37-000b-37ac-9615-021fab1bd915",
                                "text": "Les deux se moquent en chœur de celles qu’ils appellent les Batman, ces filles portant le jilbab, qui va jusqu’aux pieds et ne laisse apparent que le visage."
                            }
                        ]
                    }
                ],
