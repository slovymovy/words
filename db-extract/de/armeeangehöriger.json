                "senses": [
                    {
                        "sense_id": "5d0c93ea-4bc5-3814-95a5-81f8d1e5892b",
                        "entry_id": "c34c7581-11f9-3e21-a5a7-6843c0d28d2c",
                        "glosses": [
                            "Person, die der Armee angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd51c01-09fd-461e-bc1d-313c0bed1818",
                                "sense_id": "5d0c93ea-4bc5-3814-95a5-81f8d1e5892b",
                                "text": "„Das Hotel war hell erleuchtet und voller Lärm; es wimmelte von Offizieren, Frauen von Armeeangehörigen, weiblichen Armeeangehörigen; zwischen Bar und Empfangshalle war eine laute Party in vollem Gang, und im Speisesaal spielte eine Band.“"
                            },
                            {
                                "example_id": "462016a6-e279-43d7-8e4e-4f157120d283",
                                "sense_id": "5d0c93ea-4bc5-3814-95a5-81f8d1e5892b",
                                "text": "„Nicht nur bei Hindu-Soldaten, sondern auch bei muslimischen Armeeangehörigen kam es deshalb zu Protesten, da sie argwöhnten, dass es sich um Schweinefett handelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
