                "senses": [
                    {
                        "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                        "entry_id": "0546e012-e0df-36ac-aa25-1f4ad93e6eda",
                        "glosses": [
                            "italienisches (ligurisches) Fladenbrot, das aus einem Hefeteig hergestellt wird und mit diversen Zutaten wie Kräutern, Zwiebeln, Oliven und weiteren belegt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75ff74b-4312-4fe1-95b1-10f2ab608547",
                                "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                                "text": "Beim Grillfest steuerte Onkel August seine legendären Focaccias bei."
                            },
                            {
                                "example_id": "4ffd2e40-d7e9-4774-b662-0526553f7f55",
                                "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                                "text": "Beim Grillfest im vergangenen Monat steuerte Tante Meta ihre legendären Focacce bei."
                            },
                            {
                                "example_id": "007a2a64-951d-40ea-808e-9e0e4acc1070",
                                "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                                "text": "Und wie jedes Mal stritten Onkel August und Tante Meta darum, ob es nun Focaccias oder Focacce heißt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6d0b3b9-9c9e-4e11-80fa-f326b052e269",
                        "source_entry_id": "0546e012-e0df-36ac-aa25-1f4ad93e6eda",
                        "source_sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                        "source_sense_description": "Gastronomie: italienisches (ligurisches) Fladenbrot aus Hefeteig, das mit diversen Zutaten belegt werden kann",
                        "target_lang_word": "focaccia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "focaccia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb75602-8844-3bad-bd43-0148d48937ab",
                                        "entry_id": "8c1f3195-68a9-3a01-96b9-2b54c669a0e5",
                                        "glosses": [
                                            "A flatbread similar in style, composition, and texture to modern pizza doughs and topped with herbs, cheese and other products. Focaccia typically consists of high-gluten flour, oil, water, sugar, salt and yeast."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dc986b3-5f08-4a3e-b211-b42c279780dd",
                                                "sense_id": "0cb75602-8844-3bad-bd43-0148d48937ab",
                                                "text": "The same dough can be used for bread, rolls, breadsticks, bruschetta, focaccia, calzone, or pizza. The only practical difference between pizza and focaccia is the thickness of the crust: Traditional pizza crust is thin, and something an inch or two thick […] is more like focaccia."
                                            },
                                            {
                                                "example_id": "d181099e-5471-4cb6-a09e-81f34f755905",
                                                "sense_id": "0cb75602-8844-3bad-bd43-0148d48937ab",
                                                "text": "Sweetgreen told CNN the company was “proud to share that we are currently in the process of rolling out new PFAS-free focaccia bags that will be available in all Sweetgreen locations by the end of Q2.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58033641-3966-3b4e-8970-be41a2aa7a0f",
                                        "entry_id": "8c1f3195-68a9-3a01-96b9-2b54c669a0e5",
                                        "glosses": [
                                            "A sandwich made with this type of bread."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a495bba8-8556-4ccf-a5be-56874394b989",
                        "source_entry_id": "0546e012-e0df-36ac-aa25-1f4ad93e6eda",
                        "source_sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                        "source_sense_description": "Gastronomie: italienisches (ligurisches) Fladenbrot aus Hefeteig, das mit diversen Zutaten belegt werden kann",
                        "target_lang_word": "focaccia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "focaccia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0c5764-47ec-3560-99b3-30bc21db0856",
                                        "entry_id": "6bc1b6ef-6fea-353f-bec6-0ce0a055b56d",
                                        "glosses": [
                                            "Pain de forme plate cuit au four et originaire d’Italie, qui peut être agrémenté d’autres ingrédients."
                                        ],
                                        "tags": [
                                            "Italianisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01febb7d-5f7a-40a0-b3fa-b957bd568568",
                                                "sense_id": "bf0c5764-47ec-3560-99b3-30bc21db0856",
                                                "text": "Sous les trombes d’eau, elles explorent les venelles, visitent le palazzo Bianco, le palazzo Rosso, dégustent des foccaccias à peine sorties du four."
                                            },
                                            {
                                                "example_id": "a2effba1-235c-41e0-8cf3-48d5c8d0bc2b",
                                                "sense_id": "bf0c5764-47ec-3560-99b3-30bc21db0856",
                                                "text": "Ils longent la berge nord, ils mangent la focaccia et des morceaux de fromage, ils suivent de larges sentes entre les arbres où le ruissellement des pluies sépare les aiguilles de pin couleur rouille en vaguelettes."
                                            },
                                            {
                                                "example_id": "39a120ec-0cbe-47c9-9e4a-184e28059b0b",
                                                "sense_id": "bf0c5764-47ec-3560-99b3-30bc21db0856",
                                                "text": "Parce qu’il faut des bulles pour célébrer à Noël, ce Crémant du Jura sera parfait pour l’apéro et pour accompagner des canapés, comme des bouchées de prosciutto et melon ou même une simple focaccia aux fines herbes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
