                ],
                "senses": [
                    {
                        "sense_id": "37ba7781-092c-32cb-a0ed-3fcd8abdd405",
                        "entry_id": "627082d0-e9ce-38a9-abaf-eeeabfa96aa2",
                        "glosses": [
                            "уменьш.-ласк. к водка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6918b0-3b69-46fd-b05a-d934c21e7a49",
                                "sense_id": "37ba7781-092c-32cb-a0ed-3fcd8abdd405",
                                "text": "Ну-с, когда вы входите в дом, то стол уже должен быть накрыт, а когда сядете, сейчас салфетку за галстук и не спеша тянетесь к графинчику с водочкой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd4dec55-1e26-42eb-9efc-2f3093b3b8b9",
                        "source_entry_id": "627082d0-e9ce-38a9-abaf-eeeabfa96aa2",
                        "source_sense_id": "37ba7781-092c-32cb-a0ed-3fcd8abdd405",
                        "target_lang_word": "vodka",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vodka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85f0f12a-027b-3cdd-bf17-deb02ac81fdb",
                                        "entry_id": "f1a8903f-359c-318f-934d-55418a65a8f1",
                                        "glosses": [
                                            "A clear distilled alcoholic liquor made from grain mash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249048ef-2864-43cb-9903-83ae69200424",
                                                "sense_id": "85f0f12a-027b-3cdd-bf17-deb02ac81fdb",
                                                "text": "Eurydice pointed to the cupboard, and sat down on the low divan with folded hands, and looked at the floor. She was quite white. Elsa made her drink a glass of vodka."
                                            },
                                            {
                                                "example_id": "e17d4747-f6dd-4d86-b747-03328112c255",
                                                "sense_id": "85f0f12a-027b-3cdd-bf17-deb02ac81fdb",
                                                "text": "At Vessel, in Seattle, the bar manager, Jamie Boudreau, starts his cherry bitters by combining separate bourbon- and rye-based infusions with a touch of honey-flavored vodka and the Italian digestif amaro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eea3ca2e-aac3-3cc1-a218-7bd0b61d2be2",
                                        "entry_id": "f1a8903f-359c-318f-934d-55418a65a8f1",
                                        "glosses": [
                                            "A serving of the above beverage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba490350-d7eb-4891-8cd4-e29c91c88540",
                                                "sense_id": "eea3ca2e-aac3-3cc1-a218-7bd0b61d2be2",
                                                "text": "You should mutter sullenly into your glass, cursing the serving woman (Witch! Hag! Poison!) or the vodka (Poison! Bitch!), as the one pours you another glass of the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eec3421-7d9c-3b1d-9977-b67938762344",
                                        "entry_id": "f1a8903f-359c-318f-934d-55418a65a8f1",
                                        "glosses": [
                                            "Neutral spirits distilled (or treated after distillation) so as to have no distinctive character, aroma, taste, or color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
