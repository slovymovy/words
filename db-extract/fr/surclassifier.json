                "senses": [
                    {
                        "sense_id": "643e07f1-58fc-3f18-a747-1d5e01e7e5a2",
                        "entry_id": "fb948cd2-00d4-3a9f-8382-2dfce15f925d",
                        "glosses": [
                            "Attribuer un niveau de classification supérieur à ce qui serait normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6053fc18-f8fd-4ae3-9ab5-1bb4ad351e2d",
                                "sense_id": "643e07f1-58fc-3f18-a747-1d5e01e7e5a2",
                                "text": "Ces autorités sont donc tentées en permanence de maintenir des informations secrètes et de les surclassifier."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b1758a4-c397-3c5e-9088-b95d240cc278",
                        "entry_id": "fb948cd2-00d4-3a9f-8382-2dfce15f925d",
                        "glosses": [
                            "Classifier de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595f721c-6971-4223-b116-e52199aada89",
                                "sense_id": "8b1758a4-c397-3c5e-9088-b95d240cc278",
                                "text": "J'ai du mal à comprendre cette nécessité de surclassifier les classifications du métol, comme si il y en avais pas assez."
                            },
                            {
                                "example_id": "8d6556ed-4f7c-4ec9-9de0-9d4f6feb2e7c",
                                "sense_id": "8b1758a4-c397-3c5e-9088-b95d240cc278",
                                "text": "Certains ont essayé de la renommer « musique de concert » pour simplifier, d'autres essaient de la surclassifier selon les périodes musicales."
                            }
                        ]
                    }
