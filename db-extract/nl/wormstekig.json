                                        "glosses": [
                                            "Of or like a worm or worms; shaped like a worm or worms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1feb485c-6d8d-4a5f-9a1f-3468a072c88f",
                                                "sense_id": "1c69be76-c91a-3c25-984a-0d6e2af8a2c7",
                                                "text": "The Siamese boy brought in plates containing wormy shreds of over-fried egg, seasoned with blackened bits of onion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45573452-6da0-3bf8-9f3d-b683be0e4d5d",
                                        "entry_id": "081100b1-fb92-3f8d-aa39-902f6915bcd6",
                                        "glosses": [
                                            "Infested with worms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfeae68a-dffc-4de7-92c4-d5d067c95ed6",
                                                "sense_id": "45573452-6da0-3bf8-9f3d-b683be0e4d5d",
                                                "text": "I am your witness. If their Ladyships so much as mention the word FIRE or STEERPIKE, you shall take them with you under wormy ground."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
