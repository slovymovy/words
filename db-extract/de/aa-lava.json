                                            {
                                                "example_id": "1b0f0e9b-a1d8-4816-8092-010d5582bdd5",
                                                "sense_id": "9bb23eb5-eb74-3499-bb1e-56dfbdb8febc",
                                                "text": "La surface des coulées de lave peut se présenter sous trois formes différentes, le pahoehoe, le aa, le plan uni."
                                            },
                                            {
                                                "example_id": "ada53dfc-5e54-444b-81b1-106044397215",
                                                "sense_id": "9bb23eb5-eb74-3499-bb1e-56dfbdb8febc",
                                                "text": "[La coulée] se compose de deux branches, l’une de pahoehoe (lave unie) et l’autre d’aa (lave rugueuse)."
                                            }
                                        ]
                                    }
                                ]
                            },
