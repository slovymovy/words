                                "sense_id": "5fb3f5b5-85aa-3f49-b3e7-c1b2bb2483d8",
                                "text": "\"In Budapest, Minsk und Peking ist das Hackbrett in seiner jeweiligen landestypischen Erscheinungsform in den akademischen Lehrbetrieb aufgenommem worden, ebenso in Bayern und Österreich.\" (Wikipedia, Artikel Hackbrett)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6106ea4-4fc0-3659-9165-524313199d7d",
                        "entry_id": "fa58cc53-d0d4-3551-b950-a2c6c43d97ae",
                        "glosses": [
                            "dickes Brett, auf dem man Fleisch, Gemüse oder Fisch bearbeitet und zubereitet"
                        ],
                        "tags": [
                            "Haushalt",
                            "Küchensprache"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8b1bd9-c8cd-4838-bab1-7f1fcfc375d2",
                                "sense_id": "e6106ea4-4fc0-3659-9165-524313199d7d",
                                "text": "Zwiebeln schneidet man üblicherweise auf dem Hackbrett."
                            }
                        ],
