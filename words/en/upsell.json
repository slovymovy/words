{
    "word_family": [
        "upselling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f2ffb98-f8df-3947-98cb-8778c607c328",
                    "sense_definition": "To persuade a customer to buy more expensive items, upgrades, or add-ons than originally planned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercial_transaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cashier tried to <w>upsell</w> me by offering a larger drink for fifty cents.",
                            "target_lang_translations": {
                                "cs": "Pokladní se mi pokusil <w>nabídnout dražší variantu</w> tím, že mi nabídl větší nápoj za padesát centů."
                            }
                        },
                        {
                            "text": "Hotel staff are trained to <w>upsell</w> guests to premium suites during check-in.",
                            "target_lang_translations": {
                                "cs": "Personál hotelu je vyškolen k tomu, aby hostům při přihlášení <w>nabízel dražší</w> prémiová apartmá."
                            }
                        }
                    ],
                    "antonyms": [
                        "downsell"
                    ],
                    "common_phrases": [
                        "upsell a customer",
                        "attempt to upsell"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přesvědčit zákazníka ke koupi dražšího zboží, vylepšení nebo doplňkových služeb, než měl původně v plánu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nabídnout dražší variantu",
                                "target_lang_sense_clarification": "dražší produkt či službu"
                            },
                            {
                                "target_lang_word": "upgradovat prodej",
                                "target_lang_sense_clarification": "v obchodním kontextu"
                            },
                            {
                                "target_lang_word": "prodat dražší produkt",
                                "target_lang_sense_clarification": "zákazníkovi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31f1515d-4e06-39b1-8d96-5c9723d07c59",
                    "sense_definition": "An instance or sales technique of persuading a customer to purchase a more expensive product or additional service.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "commercial_transaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Offering extended warranties at the checkout counter is an effective <w>upsell</w>.",
                            "target_lang_translations": {
                                "cs": "Nabízení prodloužené záruky u pokladny je efektivní <w>upselling</w>."
                            }
                        },
                        {
                            "text": "The salesperson made a successful <w>upsell</w> by convincing the client to buy the deluxe model.",
                            "target_lang_translations": {
                                "cs": "Prodejce provedl úspěšný <w>doprodej dražšího zboží</w>, když přesvědčil klienta ke koupi luxusního modelu."
                            }
                        }
                    ],
                    "antonyms": [
                        "downsell"
                    ],
                    "common_phrases": [
                        "successful upsell",
                        "effective upsell"
                    ],
                    "target_lang_definitions": {
                        "cs": "Prodejní technika nebo případ přesvědčení zákazníka ke koupi dražšího produktu či dodatečné služby (upselling)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "upselling",
                                "target_lang_sense_clarification": "obchodní technika, běžně přejatý výraz"
                            },
                            {
                                "target_lang_word": "doprodej dražšího zboží",
                                "target_lang_sense_clarification": "prodejní technika"
                            },
                            {
                                "target_lang_word": "navýšení prodeje",
                                "target_lang_sense_clarification": "nabídkou dražší varianty"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}