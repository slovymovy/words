            {
                "entry_id": "5b371d36-3e4e-3a22-8ecc-bd9a13bdf62a",
                "word": "sarrette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8bb84568-e8df-47ea-9f33-e2de87a2d796",
                        "entry_id": "5b371d36-3e4e-3a22-8ecc-bd9a13bdf62a",
                        "tags": [
                            "plural"
                        ],
                        "form": "sarrettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab32dd8b-b6ee-3359-a3fc-57289b8031d2",
                        "entry_id": "5b371d36-3e4e-3a22-8ecc-bd9a13bdf62a",
                        "glosses": [
                            "Plante vivace à fleurs composées, qui pousse dans les lieux humides et ombragés, et dont une espèce (Sarrette des teinturiers) était utilisée pour produire une teinture jaune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f90543d-650b-43a7-9fd6-e3778c3bc67e",
                                "sense_id": "ab32dd8b-b6ee-3359-a3fc-57289b8031d2",
                                "text": "Dans l’émission du 4 juillet 2015 de Télématin, Dominique Cardon a évoqué la sarrette des teinturiers, plante massivement utilisée par les Salviati de Florence dans leur atelier de teinture, pour obtenir du jaune."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbd8b499-9664-459e-8470-f71eacc26e78",
                        "source_entry_id": "5b371d36-3e4e-3a22-8ecc-bd9a13bdf62a",
                        "source_sense_id": "ab32dd8b-b6ee-3359-a3fc-57289b8031d2",
                        "target_lang_word": "Scharte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8693362c-351f-3c85-bbb6-3bcc82a45a09",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "Einschnitt, Kerbe, Kratzer in einem Gegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a00cc3c-54b2-4b2d-94c3-dec17b8e8017",
                                                "sense_id": "8693362c-351f-3c85-bbb6-3bcc82a45a09",
                                                "text": "Das Schwert hat eine Scharte. Die Klinge ist schartig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d8b5240-c67f-343c-994e-52ac83cfcc95",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "offen gelassene Stelle in einer Verteidigungsanlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5870d4a-b16f-48ed-8785-0926060bc126",
                                                "sense_id": "3d8b5240-c67f-343c-994e-52ac83cfcc95",
                                                "text": "Die Scharten sind schmal und hoch und wurden in einem Abstand von cirka 5 Metern angelegt."
                                            },
                                            {
                                                "example_id": "3fe5fe7e-a17b-44d9-82ae-4b2cc027dd22",
                                                "sense_id": "3d8b5240-c67f-343c-994e-52ac83cfcc95",
                                                "text": "„Sie guckten durch eine Scharte in der Mauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b2540eb0-9c9b-3f43-b2a2-ab1fbb8e596b",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "kurz für: Hasenscharte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f42a53c-4bce-4137-b662-005678a60952",
                                                "sense_id": "b2540eb0-9c9b-3f43-b2a2-ab1fbb8e596b",
                                                "text": "So eine Scharte kann man doch heute operieren lassen, die Lippen-Kiefer-Gaumenspalte ist gar nicht so selten, wie man denkt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5110a97d-71f0-3378-bf42-4d171eb09ce5",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "(enge, schwer) passierbare Stelle im Gebirge, um von einem Tal in das nächste zu gelangen"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666484f9-0f18-4f18-a338-5152a7712d7a",
                                                "sense_id": "5110a97d-71f0-3378-bf42-4d171eb09ce5",
                                                "text": "Die Scharte ist nicht nur Verkehrsverbindung zwischen den beiden Tälern, sondern auch Wasserscheide."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4a2b0348-8d8f-3de4-b34d-c021f9ed905c",
                                        "entry_id": "863da968-90d1-3b00-8063-989e3a45eeb1",
                                        "glosses": [
                                            "erlittener Nachteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb1da6d6-1b82-48fc-9441-824ccac1bec7",
                                                "sense_id": "4a2b0348-8d8f-3de4-b34d-c021f9ed905c",
                                                "text": "„Um diese Scharte auszuwetzen, fing ich an, mir Landkarten auszudenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
