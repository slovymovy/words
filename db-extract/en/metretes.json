                "senses": [
                    {
                        "sense_id": "85389343-c4a5-3c36-98dc-ca39e9732d5d",
                        "entry_id": "a44b9fc1-644c-3b13-8c7b-de08b63bb24a",
                        "glosses": [
                            "Synonym of metrete."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9e8e5c-c2e4-4d4d-8b62-037ad31be423",
                                "sense_id": "85389343-c4a5-3c36-98dc-ca39e9732d5d",
                                "text": "Applying this to I 33 we note that the 4 επι hold 3 ½ metretai, or less than 1 metretes each."
                            },
                            {
                                "example_id": "666144b0-fad3-4028-a7e3-e6da4fa3c3d6",
                                "sense_id": "85389343-c4a5-3c36-98dc-ca39e9732d5d",
                                "text": "Aelius N.N., who is probably the lessor, has agreed to sell the olive and grain produce of property belonging to him at a price of four metretai of olive oil, three artabas of black olives, and a third of the grain produced."
                            },
                            {
                                "example_id": "d88d09a7-7f2f-4c74-838f-c266b97c9a50",
                                "sense_id": "85389343-c4a5-3c36-98dc-ca39e9732d5d",
                                "text": "[…] a jar, of two metretai; a bronze jug, of four choes, and spouted cup; a tray for cups, and a second one; […]"
                            },
                            {
                                "example_id": "820eda56-5db7-473b-be2d-8b0769f75f2b",
                                "sense_id": "85389343-c4a5-3c36-98dc-ca39e9732d5d",
                                "text": "Let pass for Kallo( ) son of Haryothes, camel driver of Machatas of the men of Antaios son of Apion, 4 Laodicean jars of wine and 4 hemikadia of oil and 2 lykia and 1 Rhodian jar of sweet wine (?) and two ephesia, total 2, and 1 … of vinegar and 1 (jar) of beets and two metretai of …, total 2."
                            },
                            {
                                "example_id": "8ccf8dd2-bff4-4bfa-9dcd-ccc0cdd5ab78",
                                "sense_id": "85389343-c4a5-3c36-98dc-ca39e9732d5d",
                                "text": "Theoretically each vase held a metretes (the largest standard liquid measure) […]"
                            }
                        ]
                    }
                ],
