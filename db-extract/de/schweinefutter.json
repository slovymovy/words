                        "source_sense_id": "99c3d569-af60-3100-8d96-8197b5aa7d04",
                        "source_sense_description": "Tiernahrung speziell für Schweine",
                        "target_lang_word": "swill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72a68f6d-88b2-30fd-9497-677b46102171",
                                        "entry_id": "a30d5ffd-26d7-3144-98d8-6fc89fc3ee7d",
                                        "glosses": [
                                            "A mixture of solid and liquid food scraps fed to pigs etc; especially kitchen waste for this purpose."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c02eb1ec-49ab-3d35-a7f2-bdcfad6fdf88",
                                        "entry_id": "a30d5ffd-26d7-3144-98d8-6fc89fc3ee7d",
                                        "glosses": [
                                            "Any disgusting or distasteful liquid."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e467d3f-0277-48d7-8147-6229fb40d0c9",
                                                "sense_id": "c02eb1ec-49ab-3d35-a7f2-bdcfad6fdf88",
                                                "text": "I cannot believe anyone could drink this swill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6040cc13-5c77-3c5f-9946-ff5c32c57c87",
                                        "entry_id": "a30d5ffd-26d7-3144-98d8-6fc89fc3ee7d",
                                        "glosses": [
                                            "Anything disgusting or worthless."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5175a25-28e7-402f-9640-02a0d9366d15",
                                                "sense_id": "6040cc13-5c77-3c5f-9946-ff5c32c57c87",
                                                "text": "This new TV show is a worthless load of swill."
                                            },
                                            {
                                                "example_id": "78d434d4-dede-43e5-9c9a-5057bfec1a35",
                                                "sense_id": "6040cc13-5c77-3c5f-9946-ff5c32c57c87",
                                                "text": "They have helped foster a corrosive, mean-spirited, angry and divisive atmosphere that May and her lieutenants are too weak to challenge. Into this swill comes Leave financier-in-chief, Arron Banks, who last week announced he was setting up a “Patriotic Alliance” to attempt to unseat 100 Remain-supporting MPs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e39448-fe44-3d02-9c6b-45df8cf04bd9",
                                        "entry_id": "a30d5ffd-26d7-3144-98d8-6fc89fc3ee7d",
                                        "glosses": [
                                            "A large quantity of liquid drunk at one swallow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5da19b-03eb-4fd3-9b02-dd1bbdc285f2",
                                                "sense_id": "64e39448-fe44-3d02-9c6b-45df8cf04bd9",
                                                "text": "He took a swill of his drink and tried to think of words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cedb99a-29fa-3592-bd14-4f42bbf898f6",
                                        "entry_id": "a30d5ffd-26d7-3144-98d8-6fc89fc3ee7d",
                                        "glosses": [
                                            "Inexpensive beer or alcohol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2230e61-d534-3ae7-a60c-df967affa5e5",
                                        "entry_id": "a30d5ffd-26d7-3144-98d8-6fc89fc3ee7d",
                                        "glosses": [
                                            "A badly-thrown pass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a32874bd-bce6-34cd-b677-e99c898ea3be",
                                        "entry_id": "8cbda3f3-e63b-3937-b49f-b63811639ba7",
                                        "glosses": [
                                            "To drink (or, rarely, eat) greedily or to excess."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2614b5c1-5a71-406d-b1cc-8da379f8212c",
                                                "sense_id": "a32874bd-bce6-34cd-b677-e99c898ea3be",
                                                "text": "[…] well-dressed people, of both sexes, […] devouring sliced beef, and swilling port, and punch, and cider […]"
                                            },
                                            {
                                                "example_id": "2d5650c1-f153-4370-9809-54ceaa29f74a",
                                                "sense_id": "a32874bd-bce6-34cd-b677-e99c898ea3be",
                                                "text": "“It is time lost,” muttered Cedric apart and impatiently, “to speak to him of aught else but that which concerns his appetite! […] he hath no pleasure save to fill, to swill, and to call for more. […]”"
                                            },
                                            {
                                                "example_id": "4fe19c8c-ab95-46ce-beb0-590ccfa5d085",
                                                "sense_id": "a32874bd-bce6-34cd-b677-e99c898ea3be",
                                                "text": "If you can give me no more than twenty-five shillings, I'm sure I'm not going to buy you pork-pie to stuff, after you've swilled a bellyful of beer."
                                            },
                                            {
                                                "example_id": "5b0eea2b-9622-4e45-8101-79c715f02d1f",
                                                "sense_id": "a32874bd-bce6-34cd-b677-e99c898ea3be",
                                                "text": "1944, Rutherford George Montgomery (as Al Avery), A Yankee Flier in Italy, New York: Grosset & Dunlap, Chapter 1, p. 9,\nO’Malley answered calmly as he shoved half of the pie into his mouth.\n“Stop! Stop—swilling that pie!” the colonel roared."
                                            },
                                            {
                                                "example_id": "1b59287d-9743-4062-a35b-4e1aaaea0bed",
                                                "sense_id": "a32874bd-bce6-34cd-b677-e99c898ea3be",
                                                "text": "The awful judge at the trial, booze-swilling hack James Haggerty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7bf25cb-619a-361c-ab21-37bd77850fe4",
                                        "entry_id": "8cbda3f3-e63b-3937-b49f-b63811639ba7",
                                        "glosses": [
                                            "To wash (something) by flooding with water."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c44429-ac2e-46fb-806a-42a9af2f6e56",
                                                "sense_id": "e7bf25cb-619a-361c-ab21-37bd77850fe4",
                                                "text": "As fearfully as doth a galled rock / O’erhang and jutty his confounded base, / Swill’d with the wild and wasteful ocean."
                                            },
                                            {
                                                "example_id": "3eb287e9-aeda-436a-aead-cc2f8c30f6cb",
                                                "sense_id": "e7bf25cb-619a-361c-ab21-37bd77850fe4",
                                                "text": "Already, at three o’clock, Kezia, the good-hearted, bad-tempered housemaid, who regarded all people that came to the sale as her personal enemies, the dirt on whose feet was of a peculiarly vile quality, had begun to scrub and swill with an energy much assisted by a continual low muttering […]"
                                            },
                                            {
                                                "example_id": "8ce9f6f9-7f92-44de-89e2-1c73da1a1ce5",
                                                "sense_id": "e7bf25cb-619a-361c-ab21-37bd77850fe4",
                                                "text": "When my turn came for the bath, I asked if I might swill out the tub, which was streaked with dirt, before using it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84521057-c446-3ac9-b1e4-f31a19504c38",
                                        "entry_id": "8cbda3f3-e63b-3937-b49f-b63811639ba7",
                                        "glosses": [
                                            "To move (a liquid or liquid-filled vessel) in a circular motion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2b2e98-e783-418c-85fe-4530bd947b14",
                                                "sense_id": "84521057-c446-3ac9-b1e4-f31a19504c38",
                                                "text": "Jimmie looked lovingly at the flask, smelt it, and then, placing it next his ear, swilled it round to hear the splash of liquor."
                                            },
                                            {
                                                "example_id": "13e11ff3-fb20-46b7-bd20-1716fa4808db",
                                                "sense_id": "84521057-c446-3ac9-b1e4-f31a19504c38",
                                                "text": "He swilled round the whisky in his glass […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "134d2a2c-95b8-3d58-9952-81184b787781",
                                        "entry_id": "8cbda3f3-e63b-3937-b49f-b63811639ba7",
                                        "glosses": [
                                            "To move around or over a surface."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f639766d-395a-443b-8b8f-d96a7e9410eb",
                                                "sense_id": "134d2a2c-95b8-3d58-9952-81184b787781",
                                                "text": "[…] before them, between the high banks of the Vaal, they saw only a world of brown water, streaked with white froth, hurling down upon them. It rose above the foot-board and swilled to the level of the seat."
                                            },
                                            {
                                                "example_id": "abdc2d91-b5e6-477a-9a9a-dd031e7a7df9",
                                                "sense_id": "134d2a2c-95b8-3d58-9952-81184b787781",
                                                "text": "A flood of fads swilled over all Europe."
                                            },
                                            {
                                                "example_id": "9281f8d5-3e56-4a21-9785-20ecde1fe347",
                                                "sense_id": "134d2a2c-95b8-3d58-9952-81184b787781",
                                                "text": "2000, Hanif Kureishi, “Goodbye, Mother” in Granta 69, Spring 2000, p. 119,\nThe smell, the internal workings of every human being, the shit, blood, mucus swilling in a bag of flesh, made him mad. He felt he was wearing the glasses the stage hypnotist had given people, but instead of seeing them naked, he saw their inner physiology, their turbulence, their death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf303b6-f1e1-3162-8ec2-38527e4d5162",
                                        "entry_id": "8cbda3f3-e63b-3937-b49f-b63811639ba7",
                                        "glosses": [
                                            "To inebriate; to fill with drink."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14aedd50-4c4b-4886-9689-04c6fe50e926",
                                                "sense_id": "3cf303b6-f1e1-3162-8ec2-38527e4d5162",
                                                "text": "[…] I should be loath\nTo meet the rudenesse, and swill’d insolence\nOf such late Wassailers;",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "ee8fc7be-a673-4851-9cf9-1d6478b9fa55",
                                                "sense_id": "3cf303b6-f1e1-3162-8ec2-38527e4d5162",
                                                "text": "Have I not kept open house for three days and nights, and swilled yourself and comrades with liquor for a week, and haven’t you all been drunk at my expense for several days?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "224dd1a2-b743-34ec-ba40-2b9566f7dff3",
                                        "entry_id": "8cbda3f3-e63b-3937-b49f-b63811639ba7",
                                        "glosses": [
                                            "To feed swill to (pigs)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f58e098c-82e6-4c64-8e8a-038bf7d2334a",
                                                "sense_id": "224dd1a2-b743-34ec-ba40-2b9566f7dff3",
                                                "text": "“Carlia, have you swilled the pigs?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
