{
    "word_family": [
        "reel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d832f99f-50ad-37b8-81d7-9dc44dd3df6b",
                    "sense_definition": "present participle and gerund of <w>reel</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer was <w>reeling</w> from the heavy blow to his head.",
                            "target_lang_translations": {
                                "nl": "De bokser <w>wankelde</w> door de zware klap op zijn hoofd."
                            }
                        },
                        {
                            "text": "She was <w>reeling</w> in shock after hearing the unexpected news.",
                            "target_lang_translations": {
                                "nl": "Haar hoofd <w>tolde</w> van schok na het horen van het onverwachte nieuws."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reeling from shock",
                        "reeling in pain"
                    ],
                    "target_lang_definitions": {
                        "nl": "onvast ter been zijn, wankelen of duizelig/aangedaan zijn door een klap of schok"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wankelen",
                                "target_lang_sense_clarification": "fysiek of figuurlijk wankel zijn"
                            },
                            {
                                "target_lang_word": "duizelen",
                                "target_lang_sense_clarification": "het hoofd tolt van schok of verwarring"
                            },
                            {
                                "target_lang_word": "tolleren",
                                "target_lang_sense_clarification": "ronddraaien van duizeligheid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "064c7b48-a24f-313e-a37d-2da2fb6e6de6",
                    "sense_definition": "The act or state of moving unsteadily or swaying as if about to fall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reeling</w> of the ship made everyone on board feel quite sick.",
                            "target_lang_translations": {
                                "nl": "Het <w>slingeren</w> van het schip maakte iedereen aan boord behoorlijk misselijk."
                            }
                        },
                        {
                            "text": "The drunk man's <w>reeling</w> made the other passengers step aside.",
                            "target_lang_translations": {
                                "nl": "Het <w>gewankel</w> van de dronken man zorgde ervoor dat de andere passagiers opzij stapten."
                            }
                        }
                    ],
                    "synonyms": [
                        "swaying",
                        "staggering",
                        "lurching"
                    ],
                    "target_lang_definitions": {
                        "nl": "het wankelen of schommelen alsof men gaat vallen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het wankelen",
                                "target_lang_sense_clarification": "onvaste beweging"
                            },
                            {
                                "target_lang_word": "het slingeren",
                                "target_lang_sense_clarification": "heen en weer bewegen"
                            },
                            {
                                "target_lang_word": "het deinzen",
                                "target_lang_sense_clarification": "onvast bewegen of heen en weer gaan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}