                        "cross_references": [
                            {
                                "target_word": "Bauxit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd0a8558-a1a3-3604-87e7-2f18365daa13",
                                        "entry_id": "995c84f5-b5b0-3f3c-8e4e-b8bccac26e8f",
                                        "glosses": [
                                            "festes, kolloidales Aluminiumhydroxid mit etwas Eisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3a1142-ee66-47fb-8402-9ee3e5919d9f",
                                                "sense_id": "dd0a8558-a1a3-3604-87e7-2f18365daa13",
                                                "text": "„Das einzige wirtschaftlich wichtige Ausgangsmaterial für die Aluminiumproduktion ist Bauxit.“"
                                            },
                                            {
                                                "example_id": "e7dc194d-8b3d-411d-a5cc-802a6843b7c8",
                                                "sense_id": "dd0a8558-a1a3-3604-87e7-2f18365daa13",
                                                "text": "„Im Rahmen der Explorationsgeologie kann der Untersuchung des Regoliths eine große Bedeutung u.a. bei der Aufspürung von Lagerstätten von Kaolin (und anderen technisch verwertbaren Tonen), Bauxit, Nickel, Edelmetallen, Edel- und Halbedelsteinen zukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c444fffa-5ab3-433f-894a-246f24f8158f",
                        "source_entry_id": "204cbe3a-16fb-3d4c-b5af-f1fa46bc122d",
                        "source_sense_id": "8776cb18-d620-3070-8b72-b3b8a72023a0",
                        "target_lang_word": "bauxiet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bauxiet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7153a3-5adf-368e-b227-1c5461a2a17d",
                                        "entry_id": "a3e67895-2cbb-3f9f-9480-5a3f4b31194c",
                                        "glosses": [
                                            "een mineraal dat een belangrijk erts van aluminium vormt. Bauxiet bestaat voor een groot deel uit aluminiumoxide; daarnaast bevat het, afhankelijk van de oorsprong, ook verbindingen van titanium, ijzer en silicium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc75a23-2c5d-4d91-a214-bd12192744d0",
                                                "sense_id": "8f7153a3-5adf-368e-b227-1c5461a2a17d",
                                                "text": "Alcoa splitst zich later dit jaar op in twee beursgenoteerde bedrijven. Een gaat zich toeleggen op de productie van hoogwaardige materialen voor de vliegtuigindustrie en de automotive-industrie en de ander op het delven van bauxiet en het produceren van aluminium."
                                            },
                                            {
                                                "example_id": "baba4599-8da2-49e8-9efa-e108e9ee67c8",
                                                "sense_id": "8f7153a3-5adf-368e-b227-1c5461a2a17d",
                                                "text": "Eerst het milieu. Aluin is een aluminiumverbinding, meestal via elektrolyse uit bauxiet gemaakt. Is deo met dat ene stofje ‘beter’ voor bodem, lucht en water dan een spuitbus met een cocktail van chemicaliën? De briefschrijver geeft het antwoord niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
