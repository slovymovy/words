                                "example_id": "79ba9c90-f32d-4ba7-936f-c528f21db578",
                                "sense_id": "6b429199-a77d-34ec-9f6a-9df99265d63c",
                                "text": "Na przyjęciu u Adama podano jajka z kawiorem."
                            },
                            {
                                "example_id": "3e4ab009-27b6-4f81-93db-9293b0919706",
                                "sense_id": "6b429199-a77d-34ec-9f6a-9df99265d63c",
                                "text": "Mają duże znaczenie gospodarcze ze względu na smaczne i delikatne mięso oraz czarny kawior wyrabiany z ich ikry"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
