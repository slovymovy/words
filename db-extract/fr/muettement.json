                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d6d9892-c55c-3d96-97a7-df283ee95e8c",
                        "entry_id": "f62a6b2a-bd43-3b85-a63d-7684b7093f25",
                        "glosses": [
                            "D’une façon muette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa72f4a-6989-453d-8f70-dabd5ef10c6e",
                                "sense_id": "2d6d9892-c55c-3d96-97a7-df283ee95e8c",
                                "text": "Dans le grésillement du projecteur, se voir pour la première fois marcher, remuer les lèvres, rire muettement sur l’écran déplié dans le living, décontenançait."
                            },
                            {
                                "example_id": "e02709fc-00bf-4f34-adf9-2da98372aec1",
                                "sense_id": "2d6d9892-c55c-3d96-97a7-df283ee95e8c",
                                "text": "Le roi parut étonné, et, à ce qui lui échappa muettement, piqué du secret de l’entrée d’Harcourt au conseil découvert."
                            },
                            {
                                "example_id": "8d144272-2256-47bc-8419-6a18566beace",
                                "sense_id": "2d6d9892-c55c-3d96-97a7-df283ee95e8c",
                                "text": "— Vas-y, lui suggéra-t-elle muettement. Fais-le ! Fais-le sans hésiter."
                            }
                        ]
                    }
