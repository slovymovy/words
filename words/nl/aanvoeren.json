                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een donkere nacht toen de schepen per ongeluk tegen de kade <w>aanvoeren</w>.",
                            "target_lang_translations": {
                                "en": "It was a dark night when the ships accidentally <w>collided</w> with the quay."
                            }
                        },
                        {
                            "text": "De getuigen verklaarden dat zij met hoge snelheid tegen de brug <w>aanvoeren</w>.",
                            "target_lang_translations": {
                                "en": "The witnesses stated that they <w>struck</w> the bridge at high speed."
                            }
                        }
                    ],
                    "traits": [
