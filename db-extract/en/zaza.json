            {
                "entry_id": "4b1315d0-ea8e-3b69-abff-704111a5cdc4",
                "word": "zaza",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2daaf3de-9b56-33d9-a34a-aa7da304f842",
                        "entry_id": "4b1315d0-ea8e-3b69-abff-704111a5cdc4",
                        "glosses": [
                            "Exotic marijuana."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "79b3ad11-fabc-4a20-bd28-df78588bb9c9",
                                "sense_id": "2daaf3de-9b56-33d9-a34a-aa7da304f842",
                                "text": "Having grabbed the torch from the first wave of Brooklyn drill's innovators, Fivio Foreign is all about the genre's future. The gravelly-voiced rapper took over the second half of 2020 with his viral hit \"Big Drip,\" whose video has a whole Hennessy-brandishing squad smoking zaza in front of a Shake Shack, of all places — bringing big roll-up-a-Backwoods-on-the-last-car-of-the-subway energy to a part of Brooklyn where the average overpaying tenant probably rides a unicycle to work."
                            },
                            {
                                "example_id": "6fd48b70-f02d-4e7f-a366-bcc65cc99104",
                                "sense_id": "2daaf3de-9b56-33d9-a34a-aa7da304f842",
                                "text": "Top shelf zaza disrupted my circadian rhythm. I have seen the Magna Carta, I've seen the Eye of Horus. I was flippin' bricks for Mansa Musa before y'all even became a type-1 civilization."
                            }
                        ]
                    }
                ],
