                    "sense_definition": "die Umwandlung oder Transformation einer Sache in einen anderen Zustand oder eine andere Form",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "Umwandlung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Staudamm erfolgt die <w>Umsetzung</w> von potenzieller Energie in elektrische Energie."
                        },
                        {
                            "text": "Die chemische <w>Umsetzung</w> der Stoffe verläuft unter hoher Temperatur besonders schnell."
                        }
                    ],
                    "synonyms": [
