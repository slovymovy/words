                "senses": [
                    {
                        "sense_id": "43659fec-a08b-394d-8230-8ec6b2f8f7c0",
                        "entry_id": "eefeb796-7dde-3d39-9a40-f3a2d96b4403",
                        "glosses": [
                            "Mann, der eine Drehorgel (einen Leierkasten) spielt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "543c740e-d7e9-408d-ad6a-b35c35d885e3",
                                "sense_id": "43659fec-a08b-394d-8230-8ec6b2f8f7c0",
                                "text": "„Drüben hinterm Dorfe / Steht ein Leiermann, / Und mit starren Fingern / Dreht er, was er kann.“"
                            },
                            {
                                "example_id": "4dbbd11c-e22e-4557-86c5-5bad02025803",
                                "sense_id": "43659fec-a08b-394d-8230-8ec6b2f8f7c0",
                                "text": "„Ein Leiermann, in dessen Mantel, sich wärmend, ein kleiner verhungerter Affe in betreßtem Jäckchen stak, trug seinen Musikkasten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
