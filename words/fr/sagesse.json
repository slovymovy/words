                    "sense_id": "201e2348-99be-3fb8-9c5c-49b1da6638ac",
                    "sense_definition": "Connaissance profonde, discernement et modération guidant la conduite de la vie et le jugement moral.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vertu_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieil homme est respecté par tous les villageois pour sa grande <w>sagesse</w>."
                        },
                        {
                            "text": "Les proverbes anciens transmettent la <w>sagesse</w> populaire de génération en génération."
                        }
                    ],
                    "synonyms": [
                        "discernement",
                        "raison"
                    ],
                    "antonyms": [
                        "folie"
                    ]
                },
                {
                    "sense_id": "811ea2ed-4fd7-3ff5-b2d1-264065819017",
                    "sense_definition": "Disposition à être calme, docile et mesuré, particulièrement chez les enfants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les maîtres ont félicité les élèves pour leur <w>sagesse</w> tout au long de la sortie."
                        },
                        {
                            "text": "Cet enfant surprend souvent sa famille par son calme et sa remarquable <w>sagesse</w>."
                        }
                    ],
                    "synonyms": [
                        "docilité",
                        "retenue"
                    ],
                    "common_phrases": [
