                    {
                        "translation_id": "123fc627-f866-4b1d-b770-007b8b148093",
                        "source_entry_id": "a4e2622f-d552-3b45-997a-13c9291f43c1",
                        "source_sense_id": "2f32765a-4f60-3671-b9f8-84d84abb2aa8",
                        "source_sense_description": "act of walking while not conscious or aware of it, during sleep",
                        "target_lang_word": "somnambulisme",
