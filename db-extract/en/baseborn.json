                        "glosses": [
                            "Of lowly birth."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "595af1fd-d2ee-43a6-9315-6c8884c94cf7",
                                "sense_id": "ed47cc4d-7947-3a71-b5ba-40c2a829c32a",
                                "text": "And while the baſe borne Tartars take it vp,\nYou fighting more for honor than for gold:\nShall maſſacre those greedie minded ſlaues."
                            },
                            {
                                "example_id": "0c6842e4-b9c8-4724-aff1-00fd9a48f46c",
                                "sense_id": "ed47cc4d-7947-3a71-b5ba-40c2a829c32a",
                                "text": "Non-Arabs, of whatever racial origin, were of course baseborn, but so too were many Arabs who, for one reason or another, were not full and free members of a tribe."
                            }
                        ]
