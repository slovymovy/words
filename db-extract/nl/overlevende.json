                                        "sense_id": "42855f27-6866-3581-9d2f-2a27dffc3bfc",
                                        "entry_id": "d2649aaa-7ee3-392e-973e-ac83a73142b0",
                                        "glosses": [
                                            "Participe présent de survivre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4995e5a-8d31-4ec6-b213-4af4510795d8",
                        "source_entry_id": "6e9588f9-d955-3bac-925a-a17428e76c61",
                        "source_sense_id": "b1524c28-841f-3fbc-8f4c-c57514ca7573",
                        "source_sense_description": "iemand die een levensbedreigende situatie overleefd heeft",
                        "target_lang_word": "survivante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "survivante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b46ec09-a2a9-3461-9661-4e7abd992a52",
                                        "entry_id": "6821cd71-9790-3949-8723-43103e0608ff",
                                        "glosses": [
                                            "Celle qui a survécu à un événement traumatique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11387c17-c179-3df3-88ef-a0db841c898d",
                                        "entry_id": "6821cd71-9790-3949-8723-43103e0608ff",
                                        "glosses": [
                                            "Celle qui a survécu à un événement traumatique.",
                                            "Celle qui a survécu à un accident, à une catastrophe, à une maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01bbcda7-af86-4f45-9850-a4c5b6d2d6d5",
                                                "sense_id": "11387c17-c179-3df3-88ef-a0db841c898d",
                                                "text": "Le 13 mars 2023, des survivantes du cancer posent pour une photo devant une œuvre de sensibilisation au cancer colorectal sur le National Mall, dans la ville de Washington. L’œuvre est une représentation visuelle des plus de 27 400 personnes de moins de 50 ans qui devraient, selon les estimations, recevoir un diagnostic de cancer colorectal en 2030."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91999648-086c-3bb4-a3d9-bd370f676d24",
                                        "entry_id": "6821cd71-9790-3949-8723-43103e0608ff",
                                        "glosses": [
                                            "Celle qui a survécu à un événement traumatique.",
                                            "Celle qui a survécu à une guerre, à un crime de masse, à un attentat, à un génocide."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f773164e-ddd7-4819-8186-60dea49e4769",
                                                "sense_id": "91999648-086c-3bb4-a3d9-bd370f676d24",
                                                "text": "Immaculée Songa, survivante du génocide de 1994 contre les Tutsis au Rwanda, témoigne de sa douleur dans un entretien accordé à ONU Info à l’occasion de l’exposition « Histoires de survie et de souvenir - Un appel à l’action pour la prévention du génocide », actuellement présentée au siège de l’ONU à New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8409ea58-dcf1-3169-b7c3-9714de9cc45e",
                                        "entry_id": "6821cd71-9790-3949-8723-43103e0608ff",
                                        "glosses": [
                                            "Celle qui a survécu à un événement traumatique.",
                                            "Celle qui a survécu à un viol, à des violences sexuelles, à la prostitution."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2761adf-fd3c-4c38-8ed0-e5e8c43b2eb8",
                                                "sense_id": "8409ea58-dcf1-3169-b7c3-9714de9cc45e",
                                                "text": "Nous sommes là aujourd’hui pour porter la voix de nos sœur survivantes de la prostitution. Mais aussi celles des femmes qui se battent en ce moment même pour survivre, et surtout, pour celles qui n’ont PAS survécu. Nous sommes là pour les filles et les femmes qui subissent indirectement les conséquences de l’existence de ce système : celle d’être partout, tout le temps, prostituables aux yeux des hommes."
                                            },
                                            {
                                                "example_id": "ccdfbdf7-c020-4331-ae50-2505dd78c76d",
                                                "sense_id": "8409ea58-dcf1-3169-b7c3-9714de9cc45e",
                                                "text": "Dans la fiction, l’athlète a fondé Olympia, un centre sportif inclusif où la performance devient l’expression d’un combat plus qu’un record à battre. Survivantes de viols, sportives transgenres et handicapées sont les compagnes de route du personnage que représente Pérec dans cette parabole inspirée par le mouvement #metoo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c8dad16-c462-394b-9516-baba43f12278",
                                        "entry_id": "6821cd71-9790-3949-8723-43103e0608ff",
                                        "glosses": [
                                            "Celle qui a survécu à un événement traumatique.",
                                            "Celle qui a survécu à un viol, à des violences sexuelles, à la prostitution.",
                                            "Survivante de la prostitution qui milite pour son abolition."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "282babd2-d376-4653-aaa8-0bedc28b81f6",
                                                "sense_id": "9c8dad16-c462-394b-9516-baba43f12278",
                                                "text": "Laurence était la première survivante. Une belle personne, une femme engagée, très courageuse. On était là toutes les deux pour créer le mouvement des survivantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca8d7cc-4921-3692-9b18-76be209dae4a",
                                        "entry_id": "6821cd71-9790-3949-8723-43103e0608ff",
                                        "glosses": [
                                            "Celle qui a survécu à une autre personne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "survivante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6487a142-3b15-3313-aa50-da30f785b35c",
                                        "entry_id": "13f14515-44b1-3f62-bbfd-0c9b4ac6c4a9",
                                        "glosses": [
                                            "Féminin singulier de survivant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b55db1cd-07bd-4476-818e-f57489739d46",
                                                "sense_id": "6487a142-3b15-3313-aa50-da30f785b35c",
                                                "text": "Ainsi, nous pouvons discerner trois sphères d’activité dans la littérature de notre époque: dans l’ordre historique, le premier, c’est la tradition d’une littérature orale, survivante; le deuxième, c’est la littérature écrite ou typographisée; enfin, le troisième, c’est la littérature orale nouvelle, mécanisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
