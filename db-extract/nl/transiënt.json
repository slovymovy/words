                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d8b7aa-5876-4c8b-ae81-d5c5c76dc52d",
                                                "sense_id": "95e26f64-8783-304c-a6c9-1377247eaf37",
                                                "text": "Taking advantage of the surprise, which assured him at least transient attention, he continued, addressing himself particularly to Evelyn."
