                        "sense_id": "c4792473-c517-3c62-946a-d023e54f1e41",
                        "entry_id": "725b4f28-1af0-3935-b897-f1f96f3b0b2f",
                        "glosses": [
                            "Frapper avec un scion."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "703a6549-eed4-45b0-9585-366297ead2c7",
                                "sense_id": "c4792473-c517-3c62-946a-d023e54f1e41",
                                "text": "Il faut scionner ce petit drôle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3adda51-bfb5-3820-a770-2665fbc13dd7",
                        "entry_id": "725b4f28-1af0-3935-b897-f1f96f3b0b2f",
                        "glosses": [
                            "Poignarder, assassiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f650dd-9975-4810-8540-04baf537e682",
                                "sense_id": "d3adda51-bfb5-3820-a770-2665fbc13dd7",
                                "text": "Ah ! tandis qu’il s’agit de visiter, qu’elle vienne donc bientôt, sinon tout de suite, la grande attendue, un dimanche ou un jeudi, ou tel jour de la semaine qu’il lui plaira, me parer enfin des fleurs qu’il faut – point surtout de rhétorique ! – et pareil, moi, dès lors, à la victime antique, à mon tour me scionner !"
                            }
                        ]
                    }
