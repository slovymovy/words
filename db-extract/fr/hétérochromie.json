        "fr-extract.jsonl": [
            {
                "entry_id": "da81e41a-ac5e-32a3-9649-2b2152deb61c",
                "word": "hétérochromie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77c6e301-41b7-4848-9c5b-08cf2c65b974",
                        "entry_id": "da81e41a-ac5e-32a3-9649-2b2152deb61c",
                        "tags": [
                            "plural"
                        ],
                        "form": "hétérochromies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7c0c3ea-1cee-380c-b301-3b197aa4a495",
                        "entry_id": "da81e41a-ac5e-32a3-9649-2b2152deb61c",
                        "glosses": [
                            "Différence de couleurs."
                        ],
                        "tags": [
                            "generically",
                            "literally"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1f9154f3-8180-322c-b7a6-74c9d8720094",
                        "entry_id": "da81e41a-ac5e-32a3-9649-2b2152deb61c",
                        "glosses": [
                            "Différences de colorations d’éléments anatomiques homologues (ex: peau, poils, cheveux, iris), chez un même individu, qui peuvent être congénitales ou pathologiques."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0a3a8150-0447-32f1-9e5b-4fdcfbd6842e",
                        "entry_id": "da81e41a-ac5e-32a3-9649-2b2152deb61c",
                        "glosses": [
                            "Différences de colorations d’éléments anatomiques homologues (ex: peau, poils, cheveux, iris), chez un même individu, qui peuvent être congénitales ou pathologiques.",
                            "Chez certains vertébrés, coloration différente des deux iris."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5369da19-baf3-4321-9a56-4b87f666e3cb",
                                "sense_id": "0a3a8150-0447-32f1-9e5b-4fdcfbd6842e",
                                "text": "Ses yeux ne marquaient plus aucune agressivité ; leur hétérochromie ne le dérangeait plus."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b13d81b-8c66-3117-8a15-7825b2aeead2",
                        "entry_id": "da81e41a-ac5e-32a3-9649-2b2152deb61c",
                        "glosses": [
                            "Différences de colorations d’éléments anatomiques homologues (ex: peau, poils, cheveux, iris), chez un même individu, qui peuvent être congénitales ou pathologiques.",
                            "Chez certains vertébrés, coexistence de deux ou plusieurs colorations sur le même iris."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a9846342-61f7-4bfe-873b-d67951c9b9e6",
                                "sense_id": "7b13d81b-8c66-3117-8a15-7825b2aeead2",
                                "text": "Les hétérochromies indiquent une éventuelle altération fonctionnelle d’organes, ou de systèmes entiers. L’hétérochromie en cocarde, par exemple, indique une atonie soit générale (asthénie, somnolence), soit digestive (flatulences, ballonnements)."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b3cbfe6-244b-3df5-8a2a-d42d36281e29",
                        "entry_id": "da81e41a-ac5e-32a3-9649-2b2152deb61c",
                        "glosses": [
                            "Différence de couleur d’un animal avec son environnement."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f7070869-34da-4145-87da-13574391b622",
                                "sense_id": "4b3cbfe6-244b-3df5-8a2a-d42d36281e29",
                                "text": "En négligeant les cas d’hétérochromie, un grand nombre de faits montre que les animaux homochromes ne sont pas de ce fait à l’abri des prédateurs. Judd, dans une série d’expériences, a constaté que les oiseaux discernent instantanément les Insectes dont l’homochromie nous paraît la plus parfaite."
                            }
                        ]
                    }
                ],
