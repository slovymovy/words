                "senses": [
                    {
                        "sense_id": "26c9986f-ea4e-35c1-9b04-0d6c6003fdcd",
                        "entry_id": "01320542-8b13-35e0-8ab0-55ff1e913313",
                        "glosses": [
                            "zła, nieprzyjemna pogoda"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6c725e-7ef9-44a4-a576-63ace34a2cb7",
                                "sense_id": "26c9986f-ea4e-35c1-9b04-0d6c6003fdcd",
                                "text": "W taką niepogodę lepiej zostać w domu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b9782a3e-47cd-311a-aff1-990f4bc05f8f",
                        "entry_id": "01320542-8b13-35e0-8ab0-55ff1e913313",
                        "glosses": [
                            "nieodpowiednia, zła sytuacja"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fc61bd6-ef89-4efb-be6d-19f76ccbbed7",
                        "source_entry_id": "01320542-8b13-35e0-8ab0-55ff1e913313",
                        "source_sense_id": "26c9986f-ea4e-35c1-9b04-0d6c6003fdcd",
                        "target_lang_word": "intempérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intempérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                                        "entry_id": "90ee0de8-51db-3d2f-afd5-4a637bba326c",
                                        "glosses": [
                                            "Mauvais temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d71ba3-905c-4ceb-846b-b5faa8637b55",
                                                "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                                                "text": "Si les grains ont souffert de l’intempérie des saisons, il faudra recourir au criblage qui produit ordinairement un pour cent de déchet, lequel sera vendu au profit de la République."
                                            },
                                            {
                                                "example_id": "1f1d9a0a-14db-48e6-9e57-c05481476221",
                                                "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                                                "text": "Cette couverture, tordue par les intempéries du climat parisien, s’avançait de trois pieds sur la rue."
                                            },
                                            {
                                                "example_id": "0e5ea1d0-dda1-47fe-a859-97566656869e",
                                                "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                                                "text": "Les intempéries meurtrières des Alpes-Maritimes avaient été classées orange, mais pas rouge. C’est quoi l’alerte rouge ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0f7c560-c9fe-36db-9d4d-c51ccff6056c",
                                        "entry_id": "90ee0de8-51db-3d2f-afd5-4a637bba326c",
                                        "glosses": [
                                            "Mauvaise constitution des humeurs du corps."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebf0b6e9-b7d4-4502-ab14-b7c6bbcaccb6",
                                                "sense_id": "a0f7c560-c9fe-36db-9d4d-c51ccff6056c",
                                                "text": "Ce qui marque une intempérie dans le parenchyme splénique, c’est-à-dire la rate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96eac819-0c8d-47ec-9e01-81916b52f317",
                        "source_entry_id": "01320542-8b13-35e0-8ab0-55ff1e913313",
                        "source_sense_id": "26c9986f-ea4e-35c1-9b04-0d6c6003fdcd",
                        "target_lang_word": "Unwetter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unwetter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                        "entry_id": "11744f40-fdc0-311a-a508-d64d04d14b8e",
                                        "glosses": [
                                            "extremes, Schaden verursachendes Wetter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47de293-2a10-4762-9a0a-cecf106eda87",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "Das Unwetter setzte unseren Keller unter Wasser."
                                            },
                                            {
                                                "example_id": "1b24fe28-519d-4376-a9a8-d5fc1867b232",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Dort wurden gerade zwei Boote heraufgehievt, die vor zwei Wochen bei einem Unwetter gesunken waren.“"
                                            },
                                            {
                                                "example_id": "7cc4ffec-4066-42d0-ae10-39f3ca681de6",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Das erwartete Unwetter brach drei Stunden nach Sonnenaufgang über uns herein.“"
                                            },
                                            {
                                                "example_id": "15673d89-5811-40a6-a516-5009b5a9687f",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Bald brach ein furchtbares Unwetter los.“"
                                            },
                                            {
                                                "example_id": "0d60eac0-a073-45f8-8bf4-6da33c3293e1",
                                                "sense_id": "4e077e61-f32b-33eb-921d-6780d92712fe",
                                                "text": "„Ein schweres Unwetter führt am 8. Juli 1926 zum Hochwasser im Steintorbereich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7053037f-a5cd-4e75-b552-c936e2517d72",
                        "source_entry_id": "01320542-8b13-35e0-8ab0-55ff1e913313",
                        "source_sense_id": "26c9986f-ea4e-35c1-9b04-0d6c6003fdcd",
                        "target_lang_word": "Schlechtwetter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlechtwetter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c34ad59b-caa9-3113-bcc1-b333699cd1fe",
                                        "entry_id": "ecc84fc6-f3c8-3d5b-9f85-66fd20cd2e10",
                                        "glosses": [
                                            "Bezeichnung für augenblicklich schlechtes, ungünstiges Wetter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b0cd6c6-868c-4858-a520-948b8ff2bb7e",
                                                "sense_id": "c34ad59b-caa9-3113-bcc1-b333699cd1fe",
                                                "text": "Das Schlechtwetter im Herbst legt sich aufs Gemüt und man liegt dann lieber vorm wärmenden Kamin."
                                            },
                                            {
                                                "example_id": "4e4b572c-81c6-4792-8c3c-bd28990806d6",
                                                "sense_id": "c34ad59b-caa9-3113-bcc1-b333699cd1fe",
                                                "text": "„Obwohl alles nach Schlechtwetter aussieht, geht kein Wind, das Wasser liegt still und wie gelähmt unter dem vielen Grau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "825e468e-fa54-49e5-b4be-8eed30533b1b",
                        "source_entry_id": "01320542-8b13-35e0-8ab0-55ff1e913313",
