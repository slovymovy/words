                                        "glosses": [
                                            "ten, kdo zápasí, účastní se nějakého zápasu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcc33d71-d364-4831-ab9a-d05fc813ea16",
                                                "sense_id": "407fc970-11b2-32b7-beb7-04411cfd6bb2",
                                                "text": "Tak dorážel bystrý náš zápasník na nepřítele vlastní jeho zbraní, — vždy s touže křepkostí a hotovostí odvetnou, brzy vážně, brzy s nepřekonatelným humorem, ale vždy s tou pravdou na jazyku, kterou v srdci měl."
                                            },
                                            {
                                                "example_id": "3fa505d4-e7d3-4b86-8b99-1b66ffe8ceaa",
                                                "sense_id": "407fc970-11b2-32b7-beb7-04411cfd6bb2",
                                                "text": "Právě duchové stojící na výšinách touží nejvroucněji po osvobození lidstva, sympatisujíce se zápasníky za spravedlnost sociální."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61318cc0-9454-3a89-8088-b9b304363c31",
                                        "entry_id": "a2d82319-3ce4-34be-be47-0021cde4786e",
                                        "glosses": [
                                            "sportovec, věnující se zápasu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9b9818-3bac-45e7-ad0d-0f05dbba490e",
                                                "sense_id": "61318cc0-9454-3a89-8088-b9b304363c31",
                                                "text": "Jediný český zápasník na olympijských hrách v Pekingu Marek Švec bronz nevybojoval."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
