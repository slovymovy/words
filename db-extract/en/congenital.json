                                        "sense_id": "e49fc614-7113-383c-9336-6f24d5ed8339",
                                        "entry_id": "f061bd89-3cea-3593-b401-b23679500c05",
                                        "glosses": [
                                            "bereits bei der Geburt bestehend"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e96e7574-30f7-4a87-b65c-74c6ce60f48d",
                                                "sense_id": "e49fc614-7113-383c-9336-6f24d5ed8339",
                                                "text": "In England werden die kongenitalen Röteln seit 1990 durch die entsprechende \"British Paediatric Surveillance Unit\" erfasst."
                                            },
                                            {
                                                "example_id": "93627285-6ce1-460b-8e2b-943d335a5fc7",
                                                "sense_id": "e49fc614-7113-383c-9336-6f24d5ed8339",
                                                "text": "Das kongenitale Schielsyndrom […] ist eine angeborene Erkrankung der Augenbewegung, die aus einem umfangreichen Symptomkomplex besteht."
                                            },
                                            {
                                                "example_id": "45600095-e6d4-48a4-9b52-bc73546b9f9d",
                                                "sense_id": "e49fc614-7113-383c-9336-6f24d5ed8339",
                                                "text": "Bei den kongenitalen dyserythropoetischen Anämien handelt es sich um eine Gruppe genetisch und klinisch unterschiedlicher Erkrankungen, die jedoch ähnliche Störungen und Probleme bei den Betroffenen hervorrufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
