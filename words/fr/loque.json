                        "tomber en loques"
                    ]
                },
                {
                    "sense_id": "2462a2de-100e-3bed-8db5-b16f4f5c534c",
                    "sense_definition": "Personne affaiblie qui n'a plus de force physique, de volonté ou d'énergie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "etat_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Épuisé par des semaines de travail acharné, il se sentait réduit à l'état de véritable <w>loque</w>."
                        },
                        {
                            "text": "La fièvre l'avait terrassé au point de faire de lui une <w>loque</w> incapable de sortir du lit."
                        }
                    ],
                    "synonyms": [
                        "épave"
                    ],
                    "common_phrases": [
