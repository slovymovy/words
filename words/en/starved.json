{
    "word_family": [
        "starve",
        "starvation",
        "starver"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "51079792-f43f-3397-aba5-2f9a273b7289",
                    "sense_definition": "Feeling extremely hungry.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>starved</w> because I have not eaten anything since early this morning.",
                            "target_lang_translations": {
                                "nl": "Ik ben <w>uitgehongerd</w> omdat ik sinds vanmorgen vroeg niets meer heb gegeten."
                            }
                        },
                        {
                            "text": "After the long hike, the group was <w>starved</w> and ready for a large meal.",
                            "target_lang_translations": {
                                "nl": "Na de lange wandeling was de groep <w>uitgehongerd</w> en klaar voor een grote maaltijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "famished",
                        "ravenous"
                    ],
                    "antonyms": [
                        "full",
                        "satiated"
                    ],
                    "common_phrases": [
                        "absolutely starved"
                    ],
                    "target_lang_definitions": {
                        "nl": "Extreem hongerig zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitgehongerd",
                                "target_lang_sense_clarification": "erg hongerig zijn"
                            },
                            {
                                "target_lang_word": "doodhongerig",
                                "target_lang_sense_clarification": "informele term voor zeer sterke honger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7af6308-3bd6-388a-a715-bd91c561f657",
                    "sense_definition": "Suffering from severe malnutrition or emaciation due to lack of food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>starved</w> animals were rescued from the abandoned farm and taken to a shelter.",
                            "target_lang_translations": {
                                "nl": "De <w>uitgehongerde</w> dieren werden gered van de verlaten boerderij en naar een opvangcentrum gebracht."
                            }
                        },
                        {
                            "text": "Years of drought left the population <w>starved</w> and in desperate need of humanitarian aid.",
                            "target_lang_translations": {
                                "nl": "Jaren van droogte lieten de bevolking <w>uitgehongerd</w> achter en in wanhopige behoefte aan humanitaire hulp."
                            }
                        }
                    ],
                    "synonyms": [
                        "emaciated",
                        "malnourished"
                    ],
                    "target_lang_definitions": {
                        "nl": "Lijdend aan ernstige ondervoeding of uitgemergeld door gebrek aan voedsel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitgehongerd",
                                "target_lang_sense_clarification": "lang geen of te weinig eten hebben gekregen"
                            },
                            {
                                "target_lang_word": "uitgemergeld",
                                "target_lang_sense_clarification": "fysiek zeer zwak en dun door gebrek aan voedsel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38b9e6ee-9c65-3fa3-b0a0-c6e38a2a012f",
                    "sense_definition": "Deprived of something essential or vital.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plants were <w>starved</w> of sunlight and eventually withered away in the dark corner.",
                            "target_lang_translations": {
                                "nl": "De planten <w>ontbeerden</w> zonlicht en verwelkten uiteindelijk in de donkere hoek."
                            }
                        },
                        {
                            "text": "The project was <w>starved</w> of funding and could not be completed on time.",
                            "target_lang_translations": {
                                "nl": "Het project <w>kwam financiering tekort</w> en kon niet op tijd worden voltooid."
                            }
                        }
                    ],
                    "synonyms": [
                        "deprived",
                        "denied"
                    ],
                    "common_phrases": [
                        "starved of attention"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beroofd van iets essentieels of levensbelangrijks."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tekortkomen aan",
                                "target_lang_sense_clarification": "een gebrek hebben aan iets noodzakelijks"
                            },
                            {
                                "target_lang_word": "ontberen",
                                "target_lang_sense_clarification": "iets essentieels missen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43659d7e-601c-3b2b-b499-6c159f6a8699",
                    "sense_definition": "Simple past and past participle of <w>starve</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray cat had <w>starved</w> for weeks before someone finally found it.",
                            "target_lang_translations": {
                                "nl": "De zwerfkat had wekenlang <w>honger geleden</w> voordat iemand het eindelijk vond."
                            }
                        },
                        {
                            "text": "Many people <w>starved</w> during the harsh winter when food supplies ran out.",
                            "target_lang_translations": {
                                "nl": "Veel mensen <w>hongerden</w> tijdens de strenge winter toen de voedselvoorraad opraakte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb starve."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van uithongeren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitgehongerd",
                                "target_lang_sense_clarification": "voltooid deelwoord van uithongeren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}