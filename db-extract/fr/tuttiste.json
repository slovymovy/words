                        "glosses": [
                            "Instrumentiste d'un orchestre qui ne joue sa partition qu'avec l'ensemble des musiciens d'un pupitre ou de l'orchestre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80515e9a-56bd-4951-8447-ae20008a07ca",
                                "sense_id": "dcf1647f-cd4d-398f-a208-1e24c29f0b46",
                                "text": "Je ne suis qu’un tuttiste. C’est-à-dire que ma place est au troisième pupitre. Au premier pupitre, il y a notre soliste et le second soliste ; au deuxième pupitre, le chef d’attaque et son second ; et ensuite viennent les tuttistes."
                            },
                            {
                                "example_id": "75142df1-07f0-4695-bd43-8307f36113fb",
                                "sense_id": "dcf1647f-cd4d-398f-a208-1e24c29f0b46",
                                "text": "Le tuttiste joue à l'unisson, lors des tutti."
                            }
                        ]
                    }
