                        ],
                        "form": "aérostats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                        "entry_id": "19389801-70e8-33ff-998d-0bc4aefb229f",
                        "glosses": [
                            "Aéronef qui se maintient en altitude grâce à de l’air chaud ou d’autres gaz plus légers que l’air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd9e590b-c6a1-4716-ab33-8eaf85b846aa",
                                "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                                "text": "L’aérostat demeurait presque immobile, à l’abri des vents de l’est."
                            },
                            {
                                "example_id": "1b4d4cbc-dbf0-4747-a626-0df9af56b15c",
                                "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                                "text": "À la manière des aérostats soulagés d’une partie de leur poids par un contact quelconque, le ballon avait bondi avec une sorte d’impertinence, […]."
                            },
                            {
                                "example_id": "526882cf-e425-4d05-ae54-626061f1675a",
                                "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                                "text": "L’aire sémantique de aéronef avec cette signification y est délimitée par rapport à aérostat désignant un ballon non dirigeable et aéronat réservé au ballon dirigeable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5015ce2a-ad88-4a2e-9b12-53afe08c064d",
                        "source_entry_id": "19389801-70e8-33ff-998d-0bc4aefb229f",
                        "source_sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                        "target_lang_word": "Luftschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2a08b17-9381-3d2e-9041-c8e07285d45d",
                                        "entry_id": "dd327a3e-ed7a-34d4-a1c9-192db88445bf",
                                        "glosses": [
                                            "lenkbares Luftfahrzeug, das aus einem länglichen, dickbauchigen, mit einem Leichtgas gefüllten Körper besteht, an dessen Unterseite eine oder mehrere Gondeln zur Aufnahme von Fracht oder Passagieren angebracht sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb0e41f6-4b9c-4ee8-b179-fde4c6e87422",
                                                "sense_id": "b2a08b17-9381-3d2e-9041-c8e07285d45d",
                                                "text": "„Über ihnen flog ein Luftschiff.“"
                                            },
                                            {
                                                "example_id": "e64e556b-fd92-4087-960d-dc0baa9fb9d1",
                                                "sense_id": "b2a08b17-9381-3d2e-9041-c8e07285d45d",
                                                "text": "„Die Berichterstatter zeigten sich vor allem beeindruckt von der schieren Phänomenologie des Luftschiffs. Sie, die doch seit Jahr und Tag immer wieder das Kolossale des Luftschiffs beschrieben hatten, mussten nun als Augenzeugen konzedieren: ‚es war doch ein unerwartet imponierender Anblick, den man nicht so bald vergessen wird‘. Und unabhängig voneinander hielten sie es der Erwähnung wert, dass die Propeller des Luftschiffs infolge der schnellen Umdrehung gar nicht sichtbar seien.“"
                                            },
                                            {
                                                "example_id": "e5cc2fdf-e1e7-4810-9e16-eaec4def2894",
                                                "sense_id": "b2a08b17-9381-3d2e-9041-c8e07285d45d",
                                                "text": "„Nobile war mit dem Luftschiff ‚Italia‘ erneut zum Nordpol aufgebrochen, diesmal ohne Amundsen. Auf dem Rückweg stürzte der Zeppelin ab.“"
                                            },
                                            {
                                                "example_id": "4c380823-621b-4bcb-8d28-50ab5b4a930d",
                                                "sense_id": "b2a08b17-9381-3d2e-9041-c8e07285d45d",
                                                "text": "„Im Näherkommen erkannte ich ein langes Luftschiff, das über einem großen Kurgan schwebte.“"
                                            },
                                            {
                                                "example_id": "43b8e6d2-62a5-499c-86f1-4d49045ffd34",
                                                "sense_id": "b2a08b17-9381-3d2e-9041-c8e07285d45d",
                                                "text": "„Die letzte offizielle Zeppelinpost in Deutschland wurde im Oktober 1939 mit dem Luftschiff »LZ 130« befördert.“"
                                            },
                                            {
                                                "example_id": "6a2e701d-10bf-41fa-a7ad-fca060e854c1",
                                                "sense_id": "b2a08b17-9381-3d2e-9041-c8e07285d45d",
                                                "text": "„Aus dem vorerst hauptsächlich der Feindbeobachtung dienenden Einsatz von Luftschiffen und Flugzeugen wurde eine Waffe, mit der ein „Luftkrieg“ eingeläutet wurde, der im Zweiten Weltkrieg verheerende Ausmaße annahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1753060-2a4d-3da6-8b27-c4d565481023",
                                        "entry_id": "dd327a3e-ed7a-34d4-a1c9-192db88445bf",
                                        "glosses": [
                                            "Luftfahrzeug, das durch den aerodynamischen Auftrieb feststehender beziehungsweise umlaufender Flügel in der Luft getragen wird"
                                        ],
                                        "tags": [
                                            "regional,",
                                            "besonders Brasilien (Rio Grande do Sul)",
                                            "Südafrika (KwaZulu-Natal)"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85be9181-db7a-4cb9-9acd-0f5a25a0821b",
                        "source_entry_id": "19389801-70e8-33ff-998d-0bc4aefb229f",
                        "source_sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                        "target_lang_word": "Zeppelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                        "entry_id": "523fd728-a170-3f3a-babd-178b788c9637",
                                        "glosses": [
                                            "bekanntester Luftschifftyp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c374d2-39f7-4c80-8b4c-330e8d3b6d34",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "Im Ersten Weltkrieg wurden Zeppeline zur Bombardierung der englischen Zivilbevölkerung eingesetzt."
                                            },
                                            {
                                                "example_id": "08f03a26-b036-41be-9680-fc08123471f7",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Nobile war mit dem Luftschiff ‚Italia‘ erneut zum Nordpol aufgebrochen, diesmal ohne Amundsen. Auf dem Rückweg stürzte der Zeppelin ab.“"
                                            },
                                            {
                                                "example_id": "6bf95538-1d40-46c6-b6c4-1895251909a6",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Bei Cuxhaven war ein Zeppelin durch Blitzschlag vernichtet.“"
                                            },
                                            {
                                                "example_id": "fa6bef46-0d10-4a46-8bb7-7304b0f0e902",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Aber der Zeppelin fliegt nicht los, Eckener will ihn nicht unnütz gefährden.“"
                                            },
                                            {
                                                "example_id": "4c70c79b-bc3e-4434-bb19-cc3ca1bb1d40",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Auch der Zeppelin erschien in Mainz, wenn auch mit etwas Verspätung, auf dem ersten Flug, der ihn vom Bodensee bis fast zur Nordsee hätte führen sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                        "entry_id": "144d7ead-45be-36af-a453-9c771fe27d8e",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25c2b41-582d-4a9f-9047-cfdb88707188",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Frau Zeppelin ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "e48b10fb-2fee-41af-88c1-7da4ecf8e5ae",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Herr Zeppelin wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "dbbc3bf2-f612-4eee-8b3f-9ff926b69799",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Die Zeppelins fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "a2b1ac64-88f1-4f77-b013-4e43944c5431",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Der Zeppelin trägt nie die Schals, die die Zeppelin ihm strickt."
                                            },
                                            {
                                                "example_id": "f836ea5d-773d-4e36-ba9b-3d8ae10cbaf8",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zeppelin kommt, geht der Herr Zeppelin.“"
                                            },
                                            {
                                                "example_id": "988e924e-f851-4e39-ad75-74d82050ce9b",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelin kommt und geht."
                                            },
                                            {
                                                "example_id": "b841a79e-ee05-47b4-94f6-6b4a3c61d5ac",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelins kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
