                        ],
                        "examples": [
                            {
                                "example_id": "e257e7f5-8ca0-45f7-80a0-707cf4ad6280",
                                "sense_id": "df7332b4-684f-358b-85f7-cb65f1130422",
                                "text": "Op het Ketelmeer is iemand zwaargewond geraakt bij een explosie aan boord van een boot. Omroep Flevoland meldt dat er een gasfles is ontploft. Het slachtoffer is met een helikopter naar het brandwondencentrum gebracht. Een tweede opvarende bleef ongedeerd."
                            },
                            {
                                "example_id": "bfa62e1f-191d-4ae1-bd56-3de75a062412",
                                "sense_id": "df7332b4-684f-358b-85f7-cb65f1130422",
                                "text": "In een aantal ziekenhuizen, zoals het Antoni van Leeuwenhoek en het Brandwondencentrum, wordt de zorg niet afgeschaald."
                            }
                        ]
                    }
