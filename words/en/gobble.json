{
    "word_family": [
        "gobbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c09ab191-f789-3bd3-92bb-3a626b29e03f",
                    "sense_definition": "To eat food hastily, greedily, or in large chunks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eating_quickly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry children would <w>gobble</w> down their lunch in a matter of minutes before running back to play.",
                            "target_lang_translations": {
                                "cs": "Hladové děti svůj oběd během pár minut <w>zhltly</w>, než běžely zpátky si hrát."
                            }
                        },
                        {
                            "text": "He was so late for the meeting that he had to <w>gobble</w> food quickly at his desk.",
                            "target_lang_translations": {
                                "cs": "Na schůzku šel tak pozdě, že musel jídlo <w>hltat</w> rychle u svého stolu."
                            }
                        }
                    ],
                    "synonyms": [
                        "hork",
                        "scarf",
                        "scoff"
                    ],
                    "common_phrases": [
                        "gobble food quickly",
                        "gobble down dinner"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jíst jídlo rychle, hltavě nebo ve velkých soustech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hltat",
                                "target_lang_sense_clarification": "jíst velmi rychle a hltavě"
                            },
                            {
                                "target_lang_word": "cpát se",
                                "target_lang_sense_clarification": "neformální výraz pro rychlou a nadměrnou konzumaci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7b88231-1f04-3f68-976f-bac89536a379",
                    "sense_definition": "To make the characteristic rapid, gurgling sound of a male turkey.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "turkey_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the turkeys <w>gobble</w> loudly from the farm across the field.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme, jak krocani na farmě přes pole hlasitě <w>hudrují</w>."
                            }
                        },
                        {
                            "text": "The male turkey began to <w>gobble</w> in response to the sudden noise.",
                            "target_lang_translations": {
                                "cs": "Krocan začal v reakci na náhlý hluk <w>hudrovat</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "turkeys gobble loudly"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat charakteristický rychlý, bublavý zvuk krocana."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hudrovat",
                                "target_lang_sense_clarification": "vydávat zvuk typický pro krocana"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fa3c48a-346e-3f99-a8b8-9b88b13adc58",
                    "sense_definition": "The characteristic rapid, gurgling sound made by a turkey.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "turkey_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud <w>gobble</w> of a turkey startled the hikers in the woods.",
                            "target_lang_translations": {
                                "cs": "Náhlé hlasité <w>hudrování</w> krocana vyděsilo turisty v lese."
                            }
                        },
                        {
                            "text": "We heard a distinctive turkey <w>gobble</w> coming from behind the barn.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme za stodolou typické krocaní <w>hudrování</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "turkey gobble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Charakteristický rychlý, bublavý zvuk, který vydává krocan."
