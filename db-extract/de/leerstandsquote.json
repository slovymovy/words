                "senses": [
                    {
                        "sense_id": "211dc39c-1b4c-3da7-8508-db2c74f0f023",
                        "entry_id": "a93344b9-71d0-3e5d-97fb-741c9494699b",
                        "glosses": [
                            "Prozentsatz der nichtvermieteten bzw. nichtverpachteten Objekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb49949-283f-458f-bafe-159a5159f617",
                                "sense_id": "211dc39c-1b4c-3da7-8508-db2c74f0f023",
                                "text": "„Allerdings gibt es beim Leerstand regional betrachtet große Unterschiede: So sind die Leerstandsquoten im Osten deutlich höher als im Westen.“"
                            },
                            {
                                "example_id": "f26f98b0-10de-4cdc-8e87-a1ed76a702c2",
                                "sense_id": "211dc39c-1b4c-3da7-8508-db2c74f0f023",
                                "text": "„Der Leerstand in Frankfurt ist seit Ende Dezember um zwei Prozent auf 1,4 Millionen Quadratmeter gesunken, das entspricht einer Leerstandsquote von 12,2 Prozent.“"
                            },
                            {
                                "example_id": "0a4a30bf-8570-47d3-b07c-6a126c112b19",
                                "sense_id": "211dc39c-1b4c-3da7-8508-db2c74f0f023",
                                "text": "„Wenig leerstehende Geschäfte gibt es in den größeren Städten - und dort naturgemäß vor allem in den Toplagen wie in der Wiener City (2,3 Prozent Leerstandsquote), in Innsbruck (2,9 Prozent) und in Linz (1,7 Prozent).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
