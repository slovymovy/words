                ],
                "senses": [
                    {
                        "sense_id": "ce887e23-7c86-3de5-9add-f985d6fc9799",
                        "entry_id": "e864ac1a-cd10-390f-bdaa-9b1c2bd49675",
                        "glosses": [
                            "ein Millionstel Gramm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776ff597-9b83-44ed-abbd-c73f8ce192ac",
                                "sense_id": "ce887e23-7c86-3de5-9add-f985d6fc9799",
                                "text": "„Der tägliche Folsäurebedarf liegt bei 300 Mikrogramm, bei Schwangeren bei 600 Mikrogramm.“"
                            },
                            {
                                "example_id": "f8e814a4-699b-4637-bd7d-f0259d4ba1a6",
                                "sense_id": "ce887e23-7c86-3de5-9add-f985d6fc9799",
                                "text": "„Nach den EU-Vorschriften dürfen seit 2005 die Grenzwerte von 50 Mikrogramm Feinstaub pro Kubikmeter maximal an 35 Tagen im Jahr überschritten werden.“"
                            },
                            {
                                "example_id": "9dd1fa7c-fb82-4290-abe3-7201400077f4",
                                "sense_id": "ce887e23-7c86-3de5-9add-f985d6fc9799",
                                "text": "„Eine gute Nachricht gibt es für alle Städte, die nur noch knapp über dem Schadstoffgrenzwert von 40 Mikrogramm Stickoxide pro Kubikmeter Luft liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "515b567a-1dbc-4b18-8151-fdfda74d8885",
                        "source_entry_id": "e864ac1a-cd10-390f-bdaa-9b1c2bd49675",
                        "source_sense_id": "ce887e23-7c86-3de5-9add-f985d6fc9799",
                        "source_sense_description": "ein Millionstel Gramm",
                        "target_lang_word": "microgram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microgram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                        "entry_id": "687c510a-783a-31f5-93a2-e57699255429",
                                        "glosses": [
                                            "An SI unit of mass equal to 10⁻⁶ grams. Symbol: μg A unit of mass equal to one millionth of a gram, or 0.000 001 grams."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d060793b-7b0b-4fe0-bc06-5912354efbc3",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "Holonyms: milligram < gram < kilogram < megagram < gigagram"
                                            },
                                            {
                                                "example_id": "b68f151c-6b73-4416-b920-2675a5a35349",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "Meronyms: picogram < nanogram"
                                            },
                                            {
                                                "example_id": "734a2744-dee8-460f-ac2b-f08b1d40f9ea",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "All seven cities saw an increase in air pollution during January-May. Readings assessed showed an average concentration of hazardous airborne particles - known as PM2.5 - up by as much as 14.8% in Taiyuan, the provincial capital, and by 16.3% in Shuozhou.[…]\nAccording to the latest data, average rates of PM2.5 in 337 cities nationwide stood at 44 micrograms per cubic meter in the first five months of the year, unchanged from 2018, with 118 cities reaching the national standard of 35 micrograms or below."
                                            },
                                            {
                                                "example_id": "b0905ac1-3737-46cf-8e26-a946738e808a",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "In the United States, there was a daily mortality increase of 0.79 percent for each 10 micrograms per cubic meter increase in PM 10 and a 1.58 percent increase for each 10 microgram increase in PM 2.5."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a8d202d-26ed-4796-a4f7-f566d33e9433",
                        "source_entry_id": "e864ac1a-cd10-390f-bdaa-9b1c2bd49675",
                        "source_sense_id": "ce887e23-7c86-3de5-9add-f985d6fc9799",
                        "source_sense_description": "ein Millionstel Gramm",
                        "target_lang_word": "microgramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microgramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b00d4d4a-17f9-31f3-aa38-14051f798f01",
                                        "entry_id": "20479fef-9a39-33b8-820d-a0b25060b2ca",
                                        "glosses": [
                                            "Unité de mesure de masse du Système international (SI), valant 10⁻⁶ gramme ou 10⁻⁹ kilogramme, et dont le symbole est μg."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c04f193-e312-46f4-aa19-8c4c8499791b",
                                                "sense_id": "b00d4d4a-17f9-31f3-aa38-14051f798f01",
                                                "text": "On entend par là des concentrations dans l’environnement de l’ordre du microgramme ou du nanogramme, par litre ou par kilogramme."
                                            },
                                            {
                                                "example_id": "a03178bf-cd6a-43e1-a376-a88afcdc8982",
                                                "sense_id": "b00d4d4a-17f9-31f3-aa38-14051f798f01",
                                                "text": "Tout ici, tout ce qui se mange et qui se boit, est drogué : il y a 35 000 microgrammes de LSD dans les bonbonnes de cidre, de la mescaline dans la salade de carotte, du peyote dans le poulet, du LSD encore dans le pain."
                                            },
                                            {
                                                "example_id": "f266a3c5-a2a8-42ad-995f-68c062ec5bbf",
                                                "sense_id": "b00d4d4a-17f9-31f3-aa38-14051f798f01",
                                                "text": "Quelques millimètres pesant quelques microgrammes de l’essence même de la vie. Obtenus après avoir lysé les globules blancs et séparé par centrifugation le précieux ADN du reste du matériel cellulaire."
                                            },
                                            {
                                                "example_id": "1b8e9142-7975-41b8-ac5f-05967ffc4ccd",
                                                "sense_id": "b00d4d4a-17f9-31f3-aa38-14051f798f01",
                                                "text": "Le taux d’ammoniac a baissé toute la nuit pour ensuite dépasser, vers midi, les cinq microgrammes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26834bb4-72a6-4c27-887c-6ce44498753e",
                        "source_entry_id": "e864ac1a-cd10-390f-bdaa-9b1c2bd49675",
