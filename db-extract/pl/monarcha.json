                                            },
                                            {
                                                "example_id": "30150ece-df64-49c1-abc6-d2532f6d39b8",
                                                "sense_id": "c58bc174-3401-3fcf-9bae-ba00bae157e7",
                                                "text": "„Doch der Monarch antwortet nicht einmal auf das Schreiben des Regenten.“"
                                            },
                                            {
                                                "example_id": "d14c6c34-074d-4192-b837-24c7dba0d9bc",
                                                "sense_id": "c58bc174-3401-3fcf-9bae-ba00bae157e7",
                                                "text": "„Kaum ein anderer Monarch blickt auf eine derart lange Geschichte seines Herrscherhauses zurück.“"
                                            },
                                            {
                                                "example_id": "822d4334-9748-471b-95ea-660241b0e53d",
                                                "sense_id": "c58bc174-3401-3fcf-9bae-ba00bae157e7",
                                                "text": "„Die lokalen Monarchen wurden schnell auf den erfolgreichen Tuchhändler aufmerksam und stellten ihn als geistigen Ratgeber in ihre Dienste.“"
                                            },
                                            {
                                                "example_id": "03342b0d-a4e6-401e-8271-7e8a9ce34adf",
                                                "sense_id": "c58bc174-3401-3fcf-9bae-ba00bae157e7",
                                                "text": "„Das erste Mal sprach der nach altem Herkommen ohnmächtige Monarch ein Machtwort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a85cd79-4823-3703-9259-14950d00a6ee",
                                        "entry_id": "3810abc0-abab-3e99-8563-a8ed5eae0df2",
