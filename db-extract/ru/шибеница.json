                "senses": [
                    {
                        "sense_id": "2fe78786-80c3-3292-aca6-cf6bd36ac23d",
                        "entry_id": "25891e5b-7d6b-37da-8c7e-0b75fd524512",
                        "glosses": [
                            "диал. то же, что виселица"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8407602b-91e1-4d04-9095-db1735012149",
                                "sense_id": "2fe78786-80c3-3292-aca6-cf6bd36ac23d",
                                "text": "Увидал я её на ярмарке в Калачике, полюбил до смерти, хоть на шибеницу полезай…"
                            },
                            {
                                "example_id": "ae999177-e9ff-48eb-bce9-a1d1a92211a2",
                                "sense_id": "2fe78786-80c3-3292-aca6-cf6bd36ac23d",
                                "text": "Будь готов на Москву оборотить! Там тебя примут на горячие калачи палачи… кнутом обдерут, ребра повынут, на огне припекут, после чести на шибеницу вздёрнут…"
                            }
                        ]
                    }
