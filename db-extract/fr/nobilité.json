                        ],
                        "examples": [
                            {
                                "example_id": "97e3b25e-ce45-4752-8545-ebce8ea42aa0",
                                "sense_id": "b35ec37e-250a-33a1-9ce0-2a3b995c380d",
                                "text": "Les seigneurs de fiefs assuraient que les propriétés classaient les citoyens en Provence; que, seuls propriétaires des terres franches ou nobles, ils représentaient la noblesse, puisque, selon eux, il y avait en Provence une nobilité de biens plutôt qu’une noblesse de personnes."
                            }
                        ]
