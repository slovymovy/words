                    {
                        "sense_id": "141cd291-b388-34eb-9241-c5197e6e151f",
                        "entry_id": "cd5ff3ca-4d69-3fe8-aa02-34cad7b3f9b2",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными затворник, затворничество; замкнутый, уединённый"
                        ],
                        "tags": [],
