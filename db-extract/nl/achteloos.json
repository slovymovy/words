                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                        "entry_id": "2bbc6485-5dfc-38b8-96fd-595979351e83",
                        "glosses": [
                            "zonder de vereiste belangstelling, zorg, achting, nadenkendheid of aandacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4cb35dd-087c-4281-943d-1be8351efd89",
                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                "text": "Die achteloze jongen keek niet eens op toen hij het afval op straat gooide."
                            },
                            {
                                "example_id": "a81b1bdd-ac89-4946-84b6-30f5a7951f4c",
                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                "text": "De achteloze manier waarop hij zijn verlies nam was zeer bewonderenswaardig."
                            },
                            {
                                "example_id": "a40560d6-ac38-477d-83b6-56da2e646c51",
                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                "text": "Door een eigenaardige alchemie - misschien omdat ik me in zijn huis bevond - leek Gerry me te ontheffen van de onbewuste kleurenhiërarchie waarvan hij af en toe achteloos blijk had gegeven. Misschien was hij mijn huid wel aan het witwassen. Misschien vond hij het wel opwindend dat zijn koloniale verleden bij hem op de stoep stond. Of misschien mocht hij me gewoon. Wat het ook was, ik voelde me welkom."
                            },
                            {
                                "example_id": "180303bb-a802-4934-a901-73a056b40cdf",
                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                "text": "Vijf luidruchtige seconden later trok hij zijn shirt uit en achteloos wierp hij het kledingstuk in de schoot van zijn vriendin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1238809a-7654-4f4d-a59f-de48636a5c0c",
                        "source_entry_id": "2bbc6485-5dfc-38b8-96fd-595979351e83",
                        "source_sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                        "source_sense_description": "zonder de vereiste belangstelling of zorg",
                        "target_lang_word": "careless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "careless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c64680f-c854-3035-9a7a-30195d187813",
                                        "entry_id": "c68a0d26-fe4b-36a4-bc71-584830ca406e",
                                        "glosses": [
                                            "Not concerned or worried (about)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5adb710d-4112-43f4-9040-c7515f26523b",
                                                "sense_id": "3c64680f-c854-3035-9a7a-30195d187813",
                                                "text": "\"He was here,\" observed Drina composedly, \"and father was angry with him.\"\n\"What?\" exclaimed Eileen. \"When?\"\n\"This morning, before father went downtown.\"\nBoth Selwyn and Lansing cut in coolly, dismissing the matter with a careless word or two; and coffee was served—cambric tea in Drina's case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                        "entry_id": "c68a0d26-fe4b-36a4-bc71-584830ca406e",
                                        "glosses": [
                                            "Not giving sufficient attention or thought, especially concerning the avoidance of harm or mistakes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359d619f-3f7a-439b-9f2e-9e6595862b94",
                                                "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                                "text": "Jessica was so careless that she put her shorts on backwards."
                                            },
                                            {
                                                "example_id": "a9ac66ce-7af3-484d-98f5-a2da7f9a9bbe",
                                                "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                                "text": "These ballads, none of which are later than the fifteenth century, are written in a strain of the most artless simplicity, not the slightest attempt at ornament is to be discerned in them; the same ideas and expressions continually recur, and the rimes are the most careless imaginable, often a mere assonnance in vowels or consonants, sometimes not possessing even that slight similarity of sound."
                                            },
                                            {
                                                "example_id": "680f3f13-d867-4a71-b4c3-d0b75c4c1279",
                                                "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                                "text": "I don't find the pose of careless youth charming and engaging any more than you find the pose of careworn age fascinating and eccentric, I should imagine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978b55f6-7088-3da1-97f9-01e5ff793963",
                                        "entry_id": "c68a0d26-fe4b-36a4-bc71-584830ca406e",
                                        "glosses": [
                                            "Free from care; unworried, without anxiety."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be4aeb97-e952-4bc4-bb36-e8d7aecd824c",
                                                "sense_id": "978b55f6-7088-3da1-97f9-01e5ff793963",
                                                "text": "Jessica was careless about putting her shorts on properly."
                                            },
                                            {
                                                "example_id": "a6ec422a-e374-4381-8a50-c85bafb4cd95",
                                                "sense_id": "978b55f6-7088-3da1-97f9-01e5ff793963",
                                                "text": "Good-humored, easy, and careless, he presided over his whale-boat as if the most deadly encounter were but a dinner, and his crew all invited guests."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6db25b78-1b9f-4301-8453-a91aa6778943",
                        "source_entry_id": "2bbc6485-5dfc-38b8-96fd-595979351e83",
                        "source_sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                        "source_sense_description": "zonder de vereiste belangstelling of zorg",
                        "target_lang_word": "distrait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distrait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5e65a9a-86da-31e2-b899-d5997d66caf0",
                                        "entry_id": "fe775371-7b08-3ace-a6cf-47ae7bbe6090",
                                        "glosses": [
                                            "Qui n’a pas d’attention à ce qu’il dit ou à ce qu’il fait, qui n’est pas à l'écoute de ce qu’on lui dit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9049001d-4767-4b30-922b-94b92da01097",
                                                "sense_id": "c5e65a9a-86da-31e2-b899-d5997d66caf0",
                                                "text": "Il discernait qu’il avait affaire à un personnage exceptionnellement distrait, mais il n’était pas responsable d’une pareille balourdise chez cet hurluberlu qui visait à l’élégance."
                                            },
                                            {
                                                "example_id": "04d76b00-ba92-4373-9815-1c3c558005e6",
                                                "sense_id": "c5e65a9a-86da-31e2-b899-d5997d66caf0",
                                                "text": "Une autre fois encore, tard, en revenant du cinéma, distrait, je butai devant le Planzpalace dans le pare-choc d'une voiture où s'était entassée toute une famille de Ripalous."
                                            },
                                            {
                                                "example_id": "d78a8ca4-6a35-4512-970d-f6a94e24144e",
                                                "sense_id": "c5e65a9a-86da-31e2-b899-d5997d66caf0",
                                                "text": "Dans la vidéo de l'accident, on le voit distrait, regarder et pianoter sur son téléphone juste avant de perdre le contrôle de sa McLaren. Sous une pluie battante, sa voiture personnalisée a alors dérapé sur la chaussée mouillée avant de percuter la barrière de sécurité en bordure de route, arrachant le capot et détruisant toute la moitié avant de la voiture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd25288-c48b-338f-867d-083ed96f523f",
                                        "entry_id": "fe775371-7b08-3ace-a6cf-47ae7bbe6090",
                                        "glosses": [
                                            "Qui dénote que l’on est distrait."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5ff5ec-5af8-4062-b7ea-3389aeb35360",
                                                "sense_id": "bdd25288-c48b-338f-867d-083ed96f523f",
                                                "text": "Air distrait."
                                            },
                                            {
                                                "example_id": "c36930f1-b024-4228-9dc1-2cf1c625a287",
                                                "sense_id": "bdd25288-c48b-338f-867d-083ed96f523f",
                                                "text": "Des yeux, des regards distraits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "distrait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67a4b51f-ae97-3e79-8150-356d672ae467",
                                        "entry_id": "7f1d84df-2459-345f-b585-6938021efc98",
                                        "glosses": [
                                            "Personne de nature distraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2429392-a162-4186-8ce8-7224be43b883",
                                                "sense_id": "67a4b51f-ae97-3e79-8150-356d672ae467",
                                                "text": "La Bruyère a peint le distrait dans ses Caractères."
                                            },
                                            {
                                                "example_id": "30b08b29-c5dd-4d46-884c-46b35efa829f",
                                                "sense_id": "67a4b51f-ae97-3e79-8150-356d672ae467",
                                                "text": "La comédie du Distrait, de Regnard."
                                            },
                                            {
                                                "example_id": "83240b9d-871e-467c-a8a3-9a9f18e6ba2b",
                                                "sense_id": "67a4b51f-ae97-3e79-8150-356d672ae467",
                                                "text": "Cette réserve cachait un compliment : au XXᵉ siècle, le poète n'est pas ce distrait, ce tête en l’air cher aux clichés, mais un homme qui sait concilier vie de travail et vie de poésie."
                                            }
                                        ]
                                    }
                                ]
                            },
