                        "examples": [
                            {
                                "example_id": "bf238c76-83c6-47a7-9c24-0d24a14f7022",
                                "sense_id": "42537f0c-b8fb-36d7-a59b-9cc7dfa14d08",
                                "text": "De reanimatie van prins Friso direct na zijn skiongeluk op 17 februari is niet belemmerd door een lege accu in de apparatuur. Dat hebben reddingswerkers die bij de reddingsactie betrokken waren benadrukt in Oostenrijkse media."
                            },
                            {
                                "example_id": "ea0a46a5-8b54-482a-9409-2ea8184948da",
                                "sense_id": "42537f0c-b8fb-36d7-a59b-9cc7dfa14d08",
                                "text": "Schumacher raakte op zondag 29 december ernstig gewond bij een skiongeluk in de Franse Alpen. Doordat hij bij een val met zijn hoofd op een rotsblok terecht kwam, liep hij zwaar hersenletsel op. Maandag liet de medische staf van het ziekenhuis weten dat de toestand van Schumachter weliswaar iets is verbeterd, maar dat zijn toestand nog altijd kritiek is."
                            }
                        ]
