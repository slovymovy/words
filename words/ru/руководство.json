{
    "word_family": [
        "руководить",
        "руководитель",
        "руководящий"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "921ab934-2e6f-3144-a3ea-741222f164f3",
                    "sense_definition": "Совокупность руководителей учреждения, организации или страны; начальство.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новое <руководство> компании решило изменить стратегию развития.",
                            "target_lang_translations": {
                                "en": "The company's new <management> decided to change the development strategy.",
                                "zh": "公司新的<w>管理层</w>决定改变发展战略。"
                            }
                        },
                        {
                            "text": "На совещании присутствовало всё высшее <руководство> завода.",
                            "target_lang_translations": {
                                "en": "All the factory's top <management> was present at the meeting.",
                                "zh": "工厂所有的最高<w>领导</w>都出席了会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "начальство"
                    ],
                    "common_phrases": [
                        "руководство страны",
                        "руководство компании",
                        "высшее руководство",
                        "сменить руководство"
                    ],
                    "target_lang_definitions": {
                        "en": "The group of people who manage an organization, company, or country.",
                        "zh": "指管理机构、组织或国家的领导层或管理人员。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "management",
                                "target_lang_sense_clarification": "people in charge of a business"
                            },
                            {
                                "target_lang_word": "leadership",
                                "target_lang_sense_clarification": "group of leaders"
                            },
                            {
                                "target_lang_word": "administration",
                                "target_lang_sense_clarification": "government or institutional officials"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理层",
                                "target_lang_sense_clarification": "负责企业或组织的人员"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "领导集体或负责人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28251ee0-2582-35aa-a7e2-6c11655cb5fd",
                    "sense_definition": "Книга, документ или пособие, содержащее инструкции, правила или учебный материал по какому-либо предмету.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед использованием прибора внимательно прочитайте <руководство> пользователя.",
                            "target_lang_translations": {
                                "en": "Read the user <manual> carefully before using the device.",
                                "zh": "使用设备前请仔细阅读用户<w>手册</w>。"
                            }
                        },
                        {
                            "text": "Студентам рекомендовали купить новое <руководство> по физике.",
                            "target_lang_translations": {
                                "en": "Students were recommended to buy the new physics <guide>.",
                                "zh": "学生们被推荐购买一本新的物理<w>指南</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пособие",
                        "наставление"
                    ],
                    "common_phrases": [
                        "руководство пользователя",
                        "руководство по эксплуатации",
                        "краткое руководство"
                    ],
                    "target_lang_definitions": {
                        "en": "A book or document containing instructions, rules, or educational material.",
                        "zh": "包含说明、规则或教学材料的书籍、文档或手册。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manual",
                                "target_lang_sense_clarification": "instructions for use"
                            },
                            {
                                "target_lang_word": "guide",
                                "target_lang_sense_clarification": "book of information or instruction"
                            },
                            {
                                "target_lang_word": "handbook",
                                "target_lang_sense_clarification": "concise reference book"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手册",
                                "target_lang_sense_clarification": "使用说明或参考书"
                            },
                            {
                                "target_lang_word": "指南",
                                "target_lang_sense_clarification": "提供信息或指导的书籍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2750719-af7a-3134-836c-f6ca0af2c230",
                    "sense_definition": "Процесс управления кем-либо или чем-либо; деятельность руководителя.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Проект был успешно завершён под <руководством> опытного инженера.",
                            "target_lang_translations": {
                                "en": "The project was successfully completed under the <guidance> of an experienced engineer.",
                                "zh": "该项目在一位经验丰富的工程师的<w>指导</w>下圆满完成。"
                            }
                        },
                        {
                            "text": "Он взял на себя общее <руководство> строительством моста.",
                            "target_lang_translations": {
                                "en": "He took on the general <supervision> of the bridge construction.",
                                "zh": "他承担了桥梁建设的全面<w>监督</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "управление",
                        "начальствование"
                    ],
                    "common_phrases": [
                        "под руководством",
                        "осуществлять руководство",
                        "общее руководство"
                    ],
                    "target_lang_definitions": {
                        "en": "The activity of managing, supervising, or guiding someone or something.",
                        "zh": "管理、监督或引导某人或某事的活动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guidance",
                                "target_lang_sense_clarification": "advice or supervision"
                            },
                            {
                                "target_lang_word": "leadership",
                                "target_lang_sense_clarification": "act of leading"
                            },
                            {
                                "target_lang_word": "supervision",
                                "target_lang_sense_clarification": "act of watching over work"
                            },
                            {
                                "target_lang_word": "direction",
                                "target_lang_sense_clarification": "act of directing operations"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指导",
                                "target_lang_sense_clarification": "建议或监督"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "引导或管理的行为"
                            },
                            {
                                "target_lang_word": "监督",
                                "target_lang_sense_clarification": "对工作进行查看和管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9536a614-cc40-394d-adcc-bcda41cdce00",
                    "sense_definition": "Принципы и правила, служащие основой для какой-либо деятельности.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы восприняли его слова как прямое <руководство> к действию.",
                            "target_lang_translations": {
                                "en": "We took his words as a direct <guide> to action.",
                                "zh": "我们把他的话当作直接的行动<w>指南</w>。"
                            }
                        },
                        {
                            "text": "Этот документ служит нам <руководством> при принятии важных решений.",
                            "target_lang_translations": {
                                "en": "This document serves as a <guide> for us when making important decisions.",
                                "zh": "这份文件是我们做重要决策时的<w>准则</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "установка"
                    ],
                    "common_phrases": [
                        "руководство к действию",
                        "принять как руководство"
                    ],
                    "target_lang_definitions": {
                        "en": "Principles or rules that serve as a basis for action or decision-making.",
                        "zh": "作为行动或决策基础的原则或规则。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guide",
                                "target_lang_sense_clarification": "model for conduct"
                            },
                            {
                                "target_lang_word": "guideline",
                                "target_lang_sense_clarification": "rule or principle"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指南",
                                "target_lang_sense_clarification": "行为准则或参考"
                            },
                            {
                                "target_lang_word": "准则",
                                "target_lang_sense_clarification": "行动的原则或规则"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}