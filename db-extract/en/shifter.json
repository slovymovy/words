                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca90011-afd6-4280-81ed-13373f6f038d",
                                "sense_id": "871472a7-f843-39e0-940f-0e1a91981a71",
                                "text": "'Twas ſuch a ſhifter, that if truth were known, / Death was half glad when he had got him down;"
