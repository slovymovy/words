                                    {
                                        "sense_id": "6fc0e644-cd39-350e-864b-34639ea20a7c",
                                        "entry_id": "32690027-1e33-359e-bff1-d4e7523ad247",
                                        "glosses": [
                                            "A traditional Brazilian alcoholic drink prepared with cachaça, lime juice, sugar, and ice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6351ef5-f249-40b6-9f33-e1468e69ab76",
                                                "sense_id": "6fc0e644-cd39-350e-864b-34639ea20a7c",
                                                "text": "They thought of, I don’t know, monkeys and caipirinhas and samba.”"
                                            },
                                            {
                                                "example_id": "9f71f35e-0b12-4784-b6fb-2cdd37418443",
                                                "sense_id": "6fc0e644-cd39-350e-864b-34639ea20a7c",
                                                "text": "Oh, no! Oh, no! Aunt Hoda got into the caipirinha supply. Everybody, watch yourself, she gets grabby."
                                            },
                                            {
                                                "example_id": "e46acd5b-eda5-4d16-9a4f-4dea0bb6e583",
                                                "sense_id": "6fc0e644-cd39-350e-864b-34639ea20a7c",
                                                "text": "The caipirinha isn’t too far removed from its warm-weather drinking buddies, the margarita and daiquiri."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
