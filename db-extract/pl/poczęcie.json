                    }
                ],
                "translations": [
                    {
                        "translation_id": "322e29bc-f64c-4cb3-b01e-852fdd01f6f1",
                        "source_entry_id": "9469ca4a-153f-3909-9b55-1eb06cd48252",
                        "source_sense_id": "439f5705-3b58-3e1b-8d09-a42b2091668a",
                        "target_lang_word": "conception",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conception",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52312b29-05fc-371b-b34e-0928eb47fb5f",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The act of conceiving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19848c42-e055-3d4a-ab34-9c71af636d39",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The state of being conceived; the beginning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a2af9bb-6155-3e3f-b575-67110d4d6407",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The fertilization of an ovum by a sperm to form a zygote."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "340744d0-2d8b-4308-b7fe-540a95ebbc0e",
                                                "sense_id": "3a2af9bb-6155-3e3f-b575-67110d4d6407",
                                                "text": "Some powers diuine, or els infernall, mixt\nTheir angry ſeedes at his conception:\nFor he was neuer ſprong of humaine race,\nSince with the ſpirit of his fearefull pride,\nHe dares so doubtleſly reſolue of rule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d21c89a3-9355-3d6b-8ec2-496950f5cb6f",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The start of pregnancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82556de4-8ed9-3483-8aee-d3869d6c7b70",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The formation of a conceptus or an implanted embryo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "034de16e-015d-3724-8eb2-b262553e95eb",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "The power or faculty of apprehending of forming an idea in the mind; the power of recalling a past sensation or perception; the ability to form mental abstractions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a8df411-1558-40b2-a922-e96537fe8ae1",
                                                "sense_id": "034de16e-015d-3724-8eb2-b262553e95eb",
                                                "text": "What the school books say about the united efforts of the two great Rossums is all a fairy tale. They used to have dreadful rows. The old atheist hadn't the slightest conception of industrial matters, and the end of it was that young Rossum shut him up in some laboratory or other and let him fritter the time away with his monstrosities, while he himself started on the business from an engineer's point of view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69469130-763e-3f6d-8350-7055ee8d9234",
                                        "entry_id": "5a527621-f5fb-398f-a11a-05aa1c64b5dd",
                                        "glosses": [
                                            "An image, idea, or notion formed in the mind; a concept, plan or design."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "802cc9ae-1742-45af-94b4-99ddafb85d17",
                                                "sense_id": "69469130-763e-3f6d-8350-7055ee8d9234",
                                                "text": "Elegant brick and stone buildings, with iron and glass canopies and decorative wooden scalloping and fencing—all evidencing care on the part of the architect to produce a pleasing, well-planned building—were submerged beneath a profusion of ill-conceived additions and camouflaged by vulgar paint schemes; and the original conception was lost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
