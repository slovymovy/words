                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marketplace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7109d8a0-db8a-3fad-9e7b-16b715382d73",
                                        "entry_id": "1cd8c8c8-0a47-3052-bc27-5c30b4a0e5eb",
                                        "glosses": [
                                            "An open area in a town housing a public market."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e976bb17-c4bc-3a0f-8aad-25863b379ba4",
                                        "entry_id": "1cd8c8c8-0a47-3052-bc27-5c30b4a0e5eb",
                                        "glosses": [
                                            "The space, actual or metaphorical, in which a market operates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82264aea-1f1c-42a1-b12c-efd5c5ed5246",
                                                "sense_id": "e976bb17-c4bc-3a0f-8aad-25863b379ba4",
                                                "text": "Some high-street retailers were slow to enter the new digital marketplace of the Internet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c154b3cb-daca-35ad-8cfa-cccf88f0c39a",
                                        "entry_id": "1cd8c8c8-0a47-3052-bc27-5c30b4a0e5eb",
                                        "glosses": [
                                            "The world of commerce and trade."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1ecf2ab-6873-495a-810d-755cbcd5d126",
                                                "sense_id": "c154b3cb-daca-35ad-8cfa-cccf88f0c39a",
                                                "text": "Endorsing the liberal anti-interventionist credo that the marketplace should act as the \"site of verification,\" the advocates of white lead opposed government intervention for the sake of open economic competition, which they claimed revealed its true value and thus should be the sole determinant: \"When the railways were built, the stage coaches disppeared; they died a timely death. If zinc white is truly superior to white lead, it will kill us in the marketplace, but the government should not intervene.\" These were the words of Expert-Bezançon, in his February 1903 deposition to the parliamentary committee examining the bill for banning lead-based pigments in paint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f44da564-1b2d-35d7-bf46-0d404c731bdd",
                                        "entry_id": "1cd8c8c8-0a47-3052-bc27-5c30b4a0e5eb",
                                        "glosses": [
                                            "A place or sphere for the exchange of anything, such as ideas or fashions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8b2e854-29d8-44b7-badc-5a225709cfc8",
                                                "sense_id": "f44da564-1b2d-35d7-bf46-0d404c731bdd",
                                                "text": "marketplace of ideas"
                                            },
                                            {
                                                "example_id": "370b89a0-566e-4bee-8895-bb4b64f17757",
                                                "sense_id": "f44da564-1b2d-35d7-bf46-0d404c731bdd",
                                                "text": "While political theory frequently appears condemned to nostalgic reflection, cultural studies often dulls its critical edge in the never-ending stampede to document the newest styles and counterstyles of the cultural marketplace."
                                            },
                                            {
                                                "example_id": "7ad6ef92-4a0c-432b-a33f-e2fdf666fbc7",
                                                "sense_id": "f44da564-1b2d-35d7-bf46-0d404c731bdd",
                                                "text": "So I have seen this controversy from both sides, and I truly believe that the most important factor is the preservation of the Internet's potential for becoming the new neutral marketplace of ideas that is so needed for the revitalization of American democracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
