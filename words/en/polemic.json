{
    "word_family": [
        "polemical",
        "polemically",
        "polemicist",
        "polemics",
        "polemize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71699d07-e3ff-309b-b58a-9a658d0711bb",
                    "sense_definition": "A strong verbal or written attack on someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attack_or_dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author published a fierce <w>polemic</w> against the government's economic policies.",
                            "target_lang_translations": {
                                "zh": "作者发表了一篇严厉<w>抨击</w>政府经济政策的文章。"
                            }
                        },
                        {
                            "text": "Her latest book is less of an objective study and more of a political <w>polemic</w>.",
                            "target_lang_translations": {
                                "zh": "她的最新著作与其说是一项客观研究，不如说是一篇政治<w>檄文</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "screed",
                        "tirade",
                        "philippic",
                        "harangue",
                        "rant"
                    ],
                    "common_phrases": [
                        "political polemic",
                        "fierce polemic"
                    ],
                    "target_lang_definitions": {
                        "zh": "（对某人或某事的）激烈抨击，激烈的批评文章或言论"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抨击文章",
                                "target_lang_sense_clarification": "激烈的批评性文章"
                            },
                            {
                                "target_lang_word": "檄文",
                                "target_lang_sense_clarification": "讨伐或声讨性质的文章"
                            },
                            {
                                "target_lang_word": "激烈抨击",
                                "target_lang_sense_clarification": "强烈的言语或文字批评"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d56bad9-96ac-35e0-b56b-2792054505f9",
                    "sense_definition": "An aggressive argument or dispute over contentious opinions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attack_or_dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher preferred peaceful dialogue over bitter academic <w>polemic</w>.",
                            "target_lang_translations": {
                                "zh": "这位哲学家更倾向于平和的对话，而非激烈的学术<w>论战</w>。"
                            }
                        },
                        {
                            "text": "They were drawn into a long <w>polemic</w> concerning theological doctrine.",
                            "target_lang_translations": {
                                "zh": "他们被卷入了一场关于神学教义的长期<w>辩论</w>中。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（争论性观点引发的）激烈争辩，论战"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "论战",
                                "target_lang_sense_clarification": "观点上的激烈争论与辩驳"
                            },
                            {
                                "target_lang_word": "辩论",
                                "target_lang_sense_clarification": "争论，辩驳"
                            },
                            {
                                "target_lang_word": "争辩",
                                "target_lang_sense_clarification": "针锋相对的争执"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48ba5160-9c95-3bf6-b743-f7bba5104093",
                    "sense_definition": "A person who writes in support of one opinion in opposition to another; a disputant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was renowned as a brilliant <w>polemic</w> who could dismantle any opponent's thesis.",
                            "target_lang_translations": {
                                "zh": "他作为一名出色的<w>论辩家</w>而闻名，能够驳倒任何对手的论点。"
                            }
                        },
                        {
                            "text": "The young writer earned a reputation as a fierce <w>polemic</w> in the local press.",
                            "target_lang_translations": {
                                "zh": "这位年轻作家在当地媒体中赢得了言辞激烈的<w>论战者</w>的名声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "controversialist",
                        "disputant",
                        "polemicist"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English in favor of polemicist"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "擅长论辩者；好辩之人；论战者（现多用 polemicist）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "论辩者",
                                "target_lang_sense_clarification": "擅长参与激烈争论的人"
                            },
                            {
                                "target_lang_word": "论战家",
                                "target_lang_sense_clarification": "擅长撰写论战文章的人"
                            },
                            {
                                "target_lang_word": "好争辩的人",
                                "target_lang_sense_clarification": "喜好与人辩驳者"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "feab00b9-d0f8-30bc-9cbc-3465042d8f75",
                    "sense_definition": "Characterized by argument, dispute, or aggressive controversy; polemical.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attack_or_dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article adopted a sharply <w>polemic</w> tone that alienated many moderate readers.",
                            "target_lang_translations": {
                                "zh": "这篇文章采取了极具<w>论战性</w>的基调，使许多温和派读者产生反感。"
                            }
                        },
                        {
                            "text": "Critics dismissed the essay as a purely <w>polemic</w> exercise with little factual basis.",
                            "target_lang_translations": {
                                "zh": "批评家们认为该文纯属缺乏事实依据的<w>争辩性</w>操练，对此不屑一顾。"
                            }
                        }
                    ],
                    "synonyms": [
                        "polemical"
                    ],
                    "common_phrases": [
                        "polemic tone"
                    ],
                    "target_lang_definitions": {
                        "zh": "争论的，辩论的；好辩的；引起激辩的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "论战性的",
                                "target_lang_sense_clarification": "具有攻击性辩论特征的"
                            },
                            {
                                "target_lang_word": "好争辩的",
                                "target_lang_sense_clarification": "具有争论性质或倾向的"
                            },
                            {
                                "target_lang_word": "引起争议的",
                                "target_lang_sense_clarification": "导致激烈争执的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}