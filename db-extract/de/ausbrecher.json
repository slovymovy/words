                        "source_sense_id": "a42ce39f-b2e5-3544-92ec-195bd81a4dbb",
                        "source_sense_description": "Person, die sich (unerlaubt) aus einem Gefängnis befreit",
                        "target_lang_word": "évadé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évadé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d36e3af-5f5d-338d-abba-79003aa2687d",
                                        "entry_id": "790e281d-2b05-3dd9-b644-e82c59b6eef5",
                                        "glosses": [
                                            "Celui qui s’est évadé de prison ou du bagne."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cdf75dc-21d9-45ef-aa9f-c1b9f8efe26d",
                                                "sense_id": "8d36e3af-5f5d-338d-abba-79003aa2687d",
                                                "text": "Il s'agit d'un évadé de la Guyane. Je le piste depuis cinq mois et je l'ai manqué une première fois à Nogent dans une guinguette du bord de l'eau, où on l'employait comme garçon."
                                            },
                                            {
                                                "example_id": "e9668f98-fdcf-491d-8018-a6f861f15a9b",
                                                "sense_id": "8d36e3af-5f5d-338d-abba-79003aa2687d",
                                                "text": "Le visage de l’évadé marqua un grand étonnement."
                                            },
                                            {
                                                "example_id": "cdf7ec89-8169-4c83-b6c2-5f17d7161c63",
                                                "sense_id": "8d36e3af-5f5d-338d-abba-79003aa2687d",
                                                "text": "Joanna Kulig, révélée dans Cold War et toujours épatante, se montre un excellent atout pour l’évadé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "évadé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30cb4198-3204-3d70-8c74-eacd022bf077",
                                        "entry_id": "e807a282-0768-37b9-af49-801288148651",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe évader."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0731e13b-421e-4a75-b8aa-ea14c243cc6b",
                                                "sense_id": "30cb4198-3204-3d70-8c74-eacd022bf077",
                                                "text": "Il avait pris le maquis un an plus tôt : arrêté par les gendarmes d’Alès, en avril 1943, pour ses activités politiques, il s’était évadé et avait trouvé refuge chez les francs-tireurs et partisans (FTP)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
