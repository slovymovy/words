                "senses": [
                    {
                        "sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                        "entry_id": "8a690442-6056-3124-beba-b8940ea35906",
                        "glosses": [
                            "To make something into a commodity, sometimes at the expense of its intrinsic value."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "191517ab-6a7e-497a-82b4-af6e3871b87d",
                                "sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                                "text": "[…"
                            },
                            {
                                "example_id": "7350c45a-4663-4194-bbd3-d4de9003a005",
                                "sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                                "text": "As capitalism, especially in its current neoliberal and globalized form, seeks to commodify the world, to transform everything existing—earth, water, air, living creatures, the human body, human relationships, love, religion—into commodities, so advertising aims to sell those commodities by forcing living individuals to serve the commercial necessities of capital."
                            },
                            {
                                "example_id": "7a38a84f-54c2-49a2-b6d8-6020d3e59dca",
                                "sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                                "text": "With over 160 lavish full-color images, 20 mouth-watering recipes, and 40 essays on food, love, and life, La Figa is a genuine treat for the senses and an invitation to approach something that's been overly functionalized and commodified with a little bit more playfulness, poignancy, and poetry."
                            },
                            {
                                "example_id": "8e3be311-74de-4abf-8023-4e652fd0b33b",
                                "sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                                "text": "Our attention spans have been chopped up and commodified, sold off piecemeal to platforms and algorithms. We’re too busy, too lazy, too preoccupied to lose ourselves in books."
                            },
                            {
                                "example_id": "76abe232-26fd-49b6-9bc5-4e6a3dd63670",
                                "sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                                "text": "The T-shirt is white, with a simple message, “Freedom,” rendered in plain black letters across the chest. It’s also now widely available for sale, indicative of an internet culture that instantaneously commodifies any significant event."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f218b80-b57c-40a6-a9e1-7ce49fc75a1e",
                        "source_entry_id": "8a690442-6056-3124-beba-b8940ea35906",
                        "source_sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                        "source_sense_description": "to make something a commodity",
                        "target_lang_word": "kommerzialisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kommerzialisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9e5265f-7f64-3737-9112-e78c47c699b9",
                                        "entry_id": "a14a3063-5212-3856-8344-93e17a56b257",
                                        "glosses": [
                                            "etwas dem Kommerz, den rein geschäftlichen Interessen unterordnen; ein finanziell einträgliches Geschäft aus etwas machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35073cbf-11a6-4ad6-ab03-7836a682ed00",
                                                "sense_id": "b9e5265f-7f64-3737-9112-e78c47c699b9",
                                                "text": "Der Fußball wurde schon recht früh kommerzialisiert und ist heute ein Milliarden-Business."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07ab5d62-110c-381d-9fd6-1cd5fed9df6a",
                                        "entry_id": "a14a3063-5212-3856-8344-93e17a56b257",
                                        "glosses": [
                                            "Schulden der öffentlichen Hand zu Papieren machen, die privat gehandelt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1402459f-8132-4a89-a1a6-c4a0af8b481c",
                                                "sense_id": "07ab5d62-110c-381d-9fd6-1cd5fed9df6a",
                                                "text": "Werden öffentliche Schulden kommerzialisiert, werden sie damit an die freien Märkte gebunden."
                                            },
                                            {
                                                "example_id": "dc9b87dd-488c-4ac2-9230-53ffce54a12b",
                                                "sense_id": "07ab5d62-110c-381d-9fd6-1cd5fed9df6a",
                                                "text": "Der sogenannte Young-Plan, ein Reparationsplan, der die Zahlungsverpflichtungen des Deutschen Reichs auf Grundlage des Versailler Vertrags regelte, sollte die Reparationen kommerzialisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0d74f94-908d-40ac-9ffa-a1a732002da0",
                        "source_entry_id": "8a690442-6056-3124-beba-b8940ea35906",
                        "source_sense_id": "43beb457-8102-3c69-a2db-32dae09c825a",
                        "source_sense_description": "to make something a commodity",
                        "target_lang_word": "kommodifizieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kommodifizieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8fd2d5-8625-3b7f-aaca-546f4c851f9e",
                                        "entry_id": "0d59ea0e-1d67-30c7-85ed-6f5702d0451b",
                                        "glosses": [
                                            "verwertbar/zu Geld machen, zur Ware (offen für Tausch, Verkauf und Erwerb) machen; der Öffentlichkeit zum Ausnutzen bereitstellen; das sachliche Objektsein vor der Individualität betonen; unter Marktgesichtspunkten vereinheitlichen; Vielfältigkeit in markttaugliche Eindimensionalität eindampfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0d6e79b-bdc0-47ef-bed8-bb1a0de14298",
                                                "sense_id": "0f8fd2d5-8625-3b7f-aaca-546f4c851f9e",
                                                "text": "„Die aktive Rolle der indigenen Akteure wird hierin erneut deutlich, insofern sie die Macht hatten, die Kommodifizierung bestimmter Gegenstände zu verhindern, aber auch diese unter ihren Bedingungen zu kommodifizieren.“"
                                            },
                                            {
                                                "example_id": "fd64f547-8c9c-474e-93ee-6cd1a8906c7a",
                                                "sense_id": "0f8fd2d5-8625-3b7f-aaca-546f4c851f9e",
                                                "text": "„Auch ist sie nicht bereit, ihren Körper durch Schönheitshandeln zu kommodifizieren.“"
                                            },
                                            {
                                                "example_id": "3ce7e128-ddb3-4741-8a14-2d0527bb9b6e",
                                                "sense_id": "0f8fd2d5-8625-3b7f-aaca-546f4c851f9e",
                                                "text": "„Hier gilt es zu unterscheiden, ob die Möglichkeit, die Daten exklusiv zu verwenden, zu kommodifizieren und zu monetarisieren von Anfang an Ziel des marktbeherrschenden Unternehmens auf dem Datenmarkt war.“"
                                            },
                                            {
                                                "example_id": "5a3c043b-1e29-4c76-b382-ff8d2bee4be8",
                                                "sense_id": "0f8fd2d5-8625-3b7f-aaca-546f4c851f9e",
                                                "text": "„Zusammenfassend kann festgehalten werden, daß die Nordischen Wohlfahrtsstaaten den weiblichen Lebenszusammenhang kommodifiziert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
