                        "translation_id": "2f88d6f2-a676-4f44-a0a7-d226fb541b85",
                        "source_entry_id": "b948a6de-340e-3266-be1a-c61d68629b6e",
                        "source_sense_id": "6d611573-66b1-3ca0-8179-c1adb52c3391",
                        "target_lang_word": "enlèvement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enlèvement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41542486-be88-315c-8f51-695cd021fb6f",
                                        "entry_id": "5f8336d3-5c47-33f2-a0ed-aa213edb8e6b",
                                        "glosses": [
                                            "Action d’enlever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0eaae30-d231-483c-b178-eba29d7cba52",
                                                "sense_id": "41542486-be88-315c-8f51-695cd021fb6f",
                                                "text": "Prenez donc garde, s’écria l'officier qui saisit Julie par la taille et la souleva […]. Sans ce brusque enlèvement, sa curieuse parente allait être froissée par la croupe du cheval blanc …."
                                            },
                                            {
                                                "example_id": "3a3b1860-71cc-4fd4-98d1-6d695b1cde25",
                                                "sense_id": "41542486-be88-315c-8f51-695cd021fb6f",
                                                "text": "Après avoir mis en demeure le groupement de faire réaliser les opérations d’enlèvement de la grue accidentée, le pouvoir adjudicateur attribue à une société tierce le marché de démantèlement et de mise en stock de la grue accidenté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3051a5f-aa31-3a2c-83ba-09f160909cdb",
                                        "entry_id": "5f8336d3-5c47-33f2-a0ed-aa213edb8e6b",
                                        "glosses": [
                                            "Rapt."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a09216a5-793c-413f-a8eb-64ee90f827f3",
                                                "sense_id": "c3051a5f-aa31-3a2c-83ba-09f160909cdb",
                                                "text": "L’enlèvement de Proserpine. - L’enlèvement des Sabines. - L’enlèvement d’une femme, d’une mineure."
                                            },
                                            {
                                                "example_id": "799d93de-9465-41d0-86d4-36ee0a53d4c4",
                                                "sense_id": "c3051a5f-aa31-3a2c-83ba-09f160909cdb",
                                                "text": "L’alerte enlèvement existe en Suisse depuis le 1ᵉʳ janvier 2010. Cette mesure concerne uniquement les mineurs et dans un cadre bien précis. Pourtant, cette alerte n’a jamais été déclenchée en huit ans. Il est, à présent, question de l’élargir aux adultes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2485a7-14d5-3b61-ad64-691a4f25e240",
                                        "entry_id": "5f8336d3-5c47-33f2-a0ed-aa213edb8e6b",
                                        "glosses": [
                                            "Marque sur un objet taillé indiquant que de la matière a été ôtée en une seule fois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4ffa5cd-cd0a-39b6-a62d-e20b52ad3696",
                                        "entry_id": "5f8336d3-5c47-33f2-a0ed-aa213edb8e6b",
                                        "glosses": [
                                            "Retrait d’une marchandise de son lieu de stockage."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21db8b36-cbb9-47f3-83c2-c339006e0d31",
                                                "sense_id": "c4ffa5cd-cd0a-39b6-a62d-e20b52ad3696",
                                                "text": "Pour faciliter l’envoi des petits colis de bouteilles, la Champagne a développé un réseau dense de points relais pour l’enlèvement de ces colis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cceb56c-23b1-4469-8cce-e05fb1f6efbb",
                        "source_entry_id": "b948a6de-340e-3266-be1a-c61d68629b6e",
                        "source_sense_id": "6d611573-66b1-3ca0-8179-c1adb52c3391",
                        "target_lang_word": "rapt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f084ec6-43b4-375b-a3e1-321288390195",
                                        "entry_id": "c438fa71-6c13-38bd-8f36-8cf2bbf99787",
                                        "glosses": [
                                            "Enlèvement, par violence ou par séduction, d’une personne, et spécialement d’une jeune fille, d’une femme mariée, d’une religieuse, ou encore d’un enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eef8632-15f8-49dd-8280-6aefba10267b",
                                                "sense_id": "7f084ec6-43b4-375b-a3e1-321288390195",
                                                "text": "On vous l’a enlevée ! reprit le commissaire, et savez-vous quel est l’homme qui a commis ce rapt ?"
                                            },
                                            {
                                                "example_id": "bdfeb102-87d6-49a1-98b6-c8abca6b1f44",
                                                "sense_id": "7f084ec6-43b4-375b-a3e1-321288390195",
                                                "text": "Le législateur canonique intervient aussi pour réprimer le rapt ; le Concile de Chalcédoine de 451 (canon 27) dépose les clercs coupables de complicité de rapt et excommunie les laïques dans ces cas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
