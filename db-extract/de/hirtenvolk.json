                "senses": [
                    {
                        "sense_id": "6d9454d2-d87b-3ba1-82aa-0e2514e79f35",
                        "entry_id": "7c55690e-c2fc-3bb6-8f5d-dba490216388",
                        "glosses": [
                            "Volk, das hauptsächlich von der Tierzucht lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e838706-d72f-499d-a771-b09f38155def",
                                "sense_id": "6d9454d2-d87b-3ba1-82aa-0e2514e79f35",
                                "text": "„Da die Gegend von einem streng islamischen Herrscher kontrolliert wird, der zum Hirtenvolk der Fulbe gehört, muss Barth fürchten, als Ungläubiger getötet zu werden.“"
                            },
                            {
                                "example_id": "893cbc00-543b-40a5-acda-747b67d681cf",
                                "sense_id": "6d9454d2-d87b-3ba1-82aa-0e2514e79f35",
                                "text": "„Es sind nicht mehr viele, die beharrlich ihren Lebensstil und ihre Kultur als Hirtenvolk verteidigen.“"
                            },
                            {
                                "example_id": "05962fee-a5b9-414f-a272-2bfdc90a6fc5",
                                "sense_id": "6d9454d2-d87b-3ba1-82aa-0e2514e79f35",
                                "text": "„Die Himba sind ein halbnomadisches Hirtenvolk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
