                                    },
                                    {
                                        "sense_id": "3968984a-341f-3c6a-889e-4da0b14d9de4",
                                        "entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
                                        "glosses": [
                                            "Enfermement et isolement criminels et d’une personne contre sa volonté, généralement précédés d’un enlèvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e72f757b-971d-482a-a130-1e0478114179",
                                                "sense_id": "3968984a-341f-3c6a-889e-4da0b14d9de4",
                                                "text": "Séquestration de personnes."
                                            },
                                            {
                                                "example_id": "8b056ab6-6ec4-4699-9f59-20a952195c7c",
                                                "sense_id": "3968984a-341f-3c6a-889e-4da0b14d9de4",
                                                "text": "La députée et son ami taxi ont ensuite été accompagnés au commissariat de Vincennes : elle a porté plainte pour séquestration, et lui pour coups et blessures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9ea1ca-8446-3351-b78a-9b26e84f4ed1",
                                        "entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
                                        "glosses": [
                                            "Enfermement et isolement drastiques mais volontaires d’une personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6954c56-5178-400d-9d53-5637432edc9f",
                        "source_entry_id": "0bc9ba08-eadf-3ff7-855d-f7f4bd1ef218",
                        "source_sense_description": "state of being entrapped",
                        "target_lang_word": "захва́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "захва́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "538d2d60-0e8e-3c2a-8b12-dbb560cbf794",
                                        "entry_id": "8830f1d5-37e8-31bd-b71c-5a59ac502831",
                                        "glosses": [
                                            "действие по значению гл. захватывать, захватить; овладение чем-либо с помощью силы, агрессии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8941595-3749-4849-9831-5a12702ddbc1",
                                                "sense_id": "538d2d60-0e8e-3c2a-8b12-dbb560cbf794",
                                                "text": "Используя свои специфические средства, мы установили, что в кругах, близких к Президенту, сложился заговор, ставящий целью захват власти."
                                            },
                                            {
                                                "example_id": "89b5eb47-94a9-463e-8a62-13af69487256",
                                                "sense_id": "538d2d60-0e8e-3c2a-8b12-dbb560cbf794",
                                                "text": "Н. Воронов описывал захват нашими частями 31 июля вражеского опорного пункта на Ленинградском фронте, назвав среди отличившихся воинов танкиста Кулаева."
                                            },
                                            {
                                                "example_id": "294c1c2a-0d02-4303-b4ae-4a0662e01054",
                                                "sense_id": "538d2d60-0e8e-3c2a-8b12-dbb560cbf794",
                                                "text": "Интересные и неожиданные явления были обнаружены в последнее время советскими физиками в Дубне, изучавшими замедление и захват в веществе отрицательных пи- и мю-мезонов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f889d38-56a6-360f-9854-1854bf50c015",
                                        "entry_id": "8830f1d5-37e8-31bd-b71c-5a59ac502831",
                                        "glosses": [
                                            "спорт. в борцовских единоборствах — приём, дающий борцу контроль над частью тела противника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97bd397a-9196-4774-b82e-0149222c90b2",
                                                "sense_id": "8f889d38-56a6-360f-9854-1854bf50c015",
                                                "text": "Фома ударил его в пах, что было сил, и резко присел, выбрасывая вверх руки, чтобы сбить захват."
                                            },
                                            {
                                                "example_id": "707c110d-f107-43b8-8286-57652ce0611f",
                                                "sense_id": "8f889d38-56a6-360f-9854-1854bf50c015",
                                                "text": "Вероника бросилась на своего возлюбленного с недвусмысленным желанием ― расцарапать ему физиономию, но негодяй ловко поймал её в захват, заломив девчонке руки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcfacc0e-3f64-39fa-9a37-ee6c84b3a21a",
                                        "entry_id": "8830f1d5-37e8-31bd-b71c-5a59ac502831",
                                        "glosses": [
                                            "техн. приспособление для подъёма, удержания и перемещения грузов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915b926f-15fc-4985-9a90-3ef3a1288d29",
                                                "sense_id": "fcfacc0e-3f64-39fa-9a37-ee6c84b3a21a",
                                                "text": "Когда требуется сменить долото, в трубы на канате опускают захват и с его помощью извлекают ротор турбины вместе с долотом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d9df910-8528-487b-86ce-a381723d0891",
                        "source_entry_id": "0bc9ba08-eadf-3ff7-855d-f7f4bd1ef218",
                        "source_sense_description": "action by law enforcement personnel to lead an otherwise innocent person to commit a crime",
                        "target_lang_word": "provocation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provocation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6154511-37b3-3ab1-a4c3-bd414f70b762",
                                        "entry_id": "22d97de0-574f-3b82-88ad-f2c2573a9bcb",
                                        "glosses": [
                                            "Action de provoquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd87731-e224-4ee2-acf4-4705cf59b5db",
                                                "sense_id": "f6154511-37b3-3ab1-a4c3-bd414f70b762",
                                                "text": "« Les bénéfices records, fièrement affichés par les entreprises, ont été vécus comme un véritable provocation », atteste Joël Sohier, maître de conférences à l’université de Reims et auteur de l’ouvrage Le Syndicalisme en France (éd. Vuibert, 2010)."
                                            },
                                            {
                                                "example_id": "2332fa16-ef43-4bbc-b9e6-7433145f69d5",
                                                "sense_id": "f6154511-37b3-3ab1-a4c3-bd414f70b762",
                                                "text": "Et pourtant le bon sens s’oppose à ce qu’une impératrice s’accommode comme une danseuse, qui semblerait une manière de provocation aux bonnes mœurs."
                                            },
                                            {
                                                "example_id": "ce31cd83-4cb0-470f-b497-2f6f3b182b72",
                                                "sense_id": "f6154511-37b3-3ab1-a4c3-bd414f70b762",
                                                "text": "Je peux comprendre que certains collègues pètent une durite. Dans la rue, certains de nos “clients” sont des spécialistes de la provocation."
                                            },
                                            {
                                                "example_id": "8e430f4a-c2ef-430c-bdfa-f713ac309bd7",
                                                "sense_id": "f6154511-37b3-3ab1-a4c3-bd414f70b762",
                                                "text": "« L’emploi de masse n’est pas une option politiquement viable […] en clair : ce dont ce pays a besoin, pour mater cette bande d’écervelés, c’est d’une bonne dépression », écrit au début des années 1970 un chroniqueur économique qui s’autorise d’autant plus la provocation qu’il signe ses textes d’un nom d’emprunt – un pseudonyme révélateur : « Adam Smith.»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e54c2087-6803-4727-bfbc-c781371d7d28",
                        "source_entry_id": "0bc9ba08-eadf-3ff7-855d-f7f4bd1ef218",
                        "source_sense_description": "action by law enforcement personnel to lead an otherwise innocent person to commit a crime",
                        "target_lang_word": "провока́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "провока́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efac4138-5ed9-37d8-ac53-fc008fd72eb3",
                                        "entry_id": "46dffada-3882-39c3-a71e-4c2084f07b53",
                                        "glosses": [
                                            "действие, направленное против отдельных лиц, групп, государств и т. п. с целью вызвать ответное действие, влекущее за собою тяжёлые или гибельные для них последствия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3cdad17-dc65-4b9f-ad68-3b0e8d825460",
                                                "sense_id": "efac4138-5ed9-37d8-ac53-fc008fd72eb3",
                                                "text": "Совершенно ясно, кому была выгодна эта провокация: спровоцировав редактора на публикацию заведомой клеветы, органы для большей убедительности избили его сына."
                                            },
                                            {
                                                "example_id": "bf5861b1-f1e2-4470-88b1-377a820e4870",
                                                "sense_id": "efac4138-5ed9-37d8-ac53-fc008fd72eb3",
                                                "text": "Тогда у диссидентов было правило, что, если на них нападают, они, подозревая, что это провокация с целью их самих обвинить в хулиганстве, демонстративно поднимают руки и не оказывают сопротивления."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "328bc499-c86e-3bed-b369-a42ed7030d96",
                                        "entry_id": "46dffada-3882-39c3-a71e-4c2084f07b53",
                                        "glosses": [
                                            "мед., микробиол. искусственное возбуждение, усиление каких-либо признаков, явлений болезни с целью выработки иммунитета организма"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b38093fb-fb64-3be0-98a8-c21987361234",
                                        "entry_id": "46dffada-3882-39c3-a71e-4c2084f07b53",
                                        "glosses": [
                                            "с.-х. искусственный вызов всходов семян сорных растений с целью последующего уничтожения их"
                                        ],
                                        "tags": [],
