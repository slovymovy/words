            "senses": [
                {
                    "sense_id": "bf0ce790-612b-343c-aab0-f1c48b370c16",
                    "sense_definition": "Couper quelque chose en morceaux, en parlant particulièrement d'aliments ou de matériaux divers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "couper_morceaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef cuisinier prend le temps de <w>découper</w> la viande avant de la servir."
                        },
                        {
                            "text": "Il commence à <w>découper</w> en morceaux les légumes pour préparer la soupe."
                        }
                    ],
                    "synonyms": [
                        "débiter",
                        "dépecer",
                        "partager"
                    ],
                    "common_phrases": [
                        "découper en morceaux",
                        "découper la viande"
                    ]
                },
                {
                    "sense_id": "f48a3681-8918-3678-9c91-502e3272492e",
                    "sense_definition": "Détacher une forme ou une figure en suivant ses contours sur une feuille, un tissu ou un carton.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "couper_forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants adorent <w>découper</w> du papier pour fabriquer de jolies décorations colorées."
                        },
                        {
                            "text": "Elle utilise de petits ciseaux pour <w>découper</w> avec soin les motifs du tissu."
                        }
                    ],
                    "common_phrases": [
                        "découper aux ciseaux",
                        "découper du papier"
                    ]
                },
                {
                    "sense_id": "3acc57f1-184b-3621-9d6f-50f536415ad6",
                    "sense_definition": "Diviser ou fractionner un espace, un territoire ou une structure en plusieurs zones distinctes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diviser_territoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a décidé de <w>découper</w> le territoire en plusieurs quartiers administratifs."
                        },
                        {
                            "text": "Le directeur préfère <w>découper</w> en secteurs les différentes activités de son entreprise."
                        }
                    ],
                    "synonyms": [
                        "diviser",
                        "fractionner",
                        "morceler",
                        "partager"
                    ],
                    "common_phrases": [
                        "découper le territoire",
                        "découper en secteurs"
                    ]
                },
                {
                    "sense_id": "0a1d3c24-4221-3060-bddd-963b5cfb7834",
                    "sense_definition": "Se détacher avec netteté en faisant apparaître ses contours sur un fond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "se_detacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au coucher du soleil, les collines viennent se <w>découper</w> dans le ciel rougeoyant."
                        },
                        {
                            "text": "Les silhouettes des grands arbres se <w>découpaient</w> nettement dans la brume du matin."
                        }
                    ],
                    "common_phrases": [
                        "se découper dans le ciel"
                    ]
                }
            ]
        }
    ]
