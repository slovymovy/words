                },
                {
                    "sense_id": "af092296-eacb-35bf-a830-d886bc4f8056",
                    "sense_definition": "Feeling unwell, uncomfortable, or slightly ill.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am feeling <w>dodgy</w> today, so I think I might be coming down with the flu.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя <w>неважно</w> сегодня, кажется, я заболеваю гриппом."
                            }
                        },
                        {
                            "text": "Eating that old seafood made my stomach feel a bit <w>dodgy</w> for the rest of the evening.",
                            "target_lang_translations": {
                                "ru": "Из-за тех несвежих морепродуктов мой желудок чувствовал себя <w>не лучшим образом</w> весь оставшийся вечер."
                            }
                        }
                    ],
                    "antonyms": [
                        "healthy",
                        "well"
                    ],
                    "common_phrases": [
                        "feel dodgy",
                        "dodgy stomach"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English to describe feeling sick."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий недомогание, дискомфорт или легкую тошноту."
                    },
