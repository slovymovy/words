                    {
                        "sense_id": "2ff9009f-171f-38a4-b5c5-a13ca85c7d4d",
                        "entry_id": "a3e1921d-521c-306d-9e1f-5223c16ddacf",
                        "glosses": [
                            "Fachsprache der Küche/des Kochens"
