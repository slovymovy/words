                    },
                    {
                        "translation_id": "ab6c2f21-4239-44dd-9d6e-7e8e483db630",
                        "source_entry_id": "f8ab2aa9-1171-3d7a-9ef2-9b1d2ebc517d",
                        "source_sense_id": "c67baad4-ea69-339f-8d98-5d10b9680f89",
                        "target_lang_word": "Treppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                        "entry_id": "05bc78f8-5329-3b16-ba29-4cdab59bf87c",
                                        "glosses": [
                                            "Aufstieg und Abstieg aus Stufen in einem Gebäude oder im Freien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a7b6c0-46d5-42fd-ad50-090ce55af053",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "Wer kommt denn da die Treppe herauf?"
                                            },
                                            {
                                                "example_id": "f5cd10c6-ced9-4b42-a64d-189783dd072f",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "Diese Treppe führt in den Keller."
                                            },
                                            {
                                                "example_id": "28fb7302-68d1-423e-8bc6-c3c0d73ff238",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "Die Treppe ist frisch gewischt, passen sie bitte auf, dass sie nicht ausrutschen."
                                            },
                                            {
                                                "example_id": "25c9c256-3092-4dea-89aa-a967c46db4af",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "„Jetzt muß sie im ersten Stockwerk innehalten, ihre Hand wird im Dunkel des Flurs nach den Bogen des gewellten Geländers tasten, ihr Fuß die schiefe, ausgetretene Treppe suchen, die zum zweiten Stockwerk führt.“"
                                            },
                                            {
                                                "example_id": "207079e1-0291-4959-b88d-2220fcc60e7d",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "„Ich nickte und verließ die Wohnung, und als ich draußen im Treppenhaus auf der gedrehten Treppe war, atmete ich durch, so erleichtert war ich, mich nicht mehr nach Berliner Art unterhalten zu müssen.“"
                                            },
                                            {
                                                "example_id": "792faac1-b70e-4fb3-b82e-4dab4e2a95db",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "„Müller kommt die Treppe zum Deck hoch, sieht uns und winkt.“"
                                            },
                                            {
                                                "example_id": "6dc2bf8a-ab0e-47f8-838d-c73301c481d6",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "[Fußball-EM in Wembley:] „In sozialen Medien waren Videos von chaotischen Szenen zu sehen, etwa wie Menschen eine Treppe im Umfeld der Arena hochrannten und von Sicherheitspersonal verfolgt wurden.“"
                                            },
                                            {
                                                "example_id": "6ddeeaf3-207d-4080-98ff-cdd05f8e48bd",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "[Coronapandemie 2021:] „Wir laufen sonst mehr, steigen mehr Treppen, sprinten kurz zum Bus, wuchteten die Einkäufe nach Hause etc. Alles normale Bewegungen, die bei vielen im Lockdown wegfallen.“"
                                            },
                                            {
                                                "example_id": "eda5e61a-d0a0-496b-a6a4-422fd5a6f094",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "„Er repariert eigenhändig die Treppe auf dem Friedhof, bessert die Grabsteine mit ihren unleserlich gewordenen Inschriften aus.“"
                                            },
                                            {
                                                "example_id": "3b8ee7ec-5366-4db4-87cc-4124fe4f8a7a",
                                                "sense_id": "c0fcabf5-d136-3bd5-a917-636836c94804",
                                                "text": "Nach meiner COVID-19-Erkrankung war ich nicht mehr in der Lage, zwei Treppen hochzusteigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a6a5727-f9b4-44b7-9481-3c65706165a4",
                        "source_entry_id": "f8ab2aa9-1171-3d7a-9ef2-9b1d2ebc517d",
                        "source_sense_id": "c67baad4-ea69-339f-8d98-5d10b9680f89",
                        "target_lang_word": "лестница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лестница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f2cdc0c0-83fe-3707-a39a-bee4615d50e7",
                                        "entry_id": "607e79d4-9604-3716-9ef8-289830229ad5",
                                        "glosses": [
                                            "сооружение для пешего подъёма или спуска в виде ряда ступеней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f6acbb-6eef-4936-a6c0-be47e22f4beb",
                                                "sense_id": "f2cdc0c0-83fe-3707-a39a-bee4615d50e7",
                                                "text": "Пройдя по лестнице с низкими ступенями и чуть не споткнувшись о них, я оглянулся."
                                            },
                                            {
                                                "example_id": "2a27f5f7-7513-4658-a849-3c85975245df",
                                                "sense_id": "f2cdc0c0-83fe-3707-a39a-bee4615d50e7",
                                                "text": "Сновидение исчезло, но я не мог уже спать, чувствовал нужду в свежем воздухе, приблизился к окну, увидел подле него маленькую дверь, отворил её и по крутой лестнице сошёл в сад."
                                            },
                                            {
                                                "example_id": "cadbed07-9393-4477-be9a-f0cb6d9ea8e7",
                                                "sense_id": "f2cdc0c0-83fe-3707-a39a-bee4615d50e7",
                                                "text": "Вниз шла земляная лестница, кое-где укреплённая шестами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b9d156b-6239-354e-87e9-863611c326c7",
                                        "entry_id": "607e79d4-9604-3716-9ef8-289830229ad5",
                                        "glosses": [
                                            "конструкция для пешего подъёма или спуска в виде ряда ступеней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e91b3f6-20d3-4d4a-9c17-44a30743d047",
                                                "sense_id": "5b9d156b-6239-354e-87e9-863611c326c7",
                                                "text": "Что-то своё, родное было в этих перилах, в этой лестнице, заскрипевшей под его шагами, в детских каракулях на стене, в рыбе, которую вчера жарили."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9b68c32-42c5-3891-8079-409938c68c74",
                                        "entry_id": "607e79d4-9604-3716-9ef8-289830229ad5",
                                        "glosses": [
                                            "конструкция для подъёма или спуска в виде ряда перекладин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6b788f7-5d61-40bf-83be-e8aa5f64e8b1",
                                                "sense_id": "d9b68c32-42c5-3891-8079-409938c68c74",
                                                "text": "Прыгай через палисады, бросай фашины, спускайся в ров, ставь лестницы!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea749174-f138-332c-874f-9c6eb52a7661",
                                        "entry_id": "607e79d4-9604-3716-9ef8-289830229ad5",
                                        "glosses": [
                                            "перен. последовательное, постепенное продвижение кого-л., чего-л. по восходящей линии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48c0100f-ae4d-4009-9474-efac7cefab3c",
                                                "sense_id": "ea749174-f138-332c-874f-9c6eb52a7661",
                                                "text": "Я многого добилась в свои 25 лет, и мне не нужен искусственный рост по служебной лестнице или какие-то блага, которых я не заслужила."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
