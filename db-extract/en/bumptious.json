                                                "sense_id": "302211fd-e595-3825-9067-8c193b94b0c4",
                                                "text": "»Das Musical war prätentiös.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ac7e30f-ff7f-3301-b685-199a5d183e1a",
                                        "entry_id": "49e249b4-341c-39f6-9162-a866461151c3",
                                        "glosses": [
                                            "durch besondere Darstellungsmöglichkeiten (Sprache, Aussehen usw.) versuchend kultiviert zu wirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0441be5-cbc1-4af9-8a60-bf4cfff8a4c0",
                                                "sense_id": "6ac7e30f-ff7f-3301-b685-199a5d183e1a",
                                                "text": "Der Schweinezüchter ist ein Emporkömmling, der durch sein prätentiöses Auftreten versucht, seinen sozialen Aufstieg zu inszenieren und eine große Rolle zu spielen, was der Erzähler mit Ironie kommentiert."
                                            },
                                            {
                                                "example_id": "15e04b42-cb1b-492d-972b-5aaa0fe07167",
                                                "sense_id": "6ac7e30f-ff7f-3301-b685-199a5d183e1a",
                                                "text": "»Das tangiert mich nur peripher« anstatt »Das berührt mich kaum« oder »Das ist mir im Grunde egal« zu sagen, ist prätentiös."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
