                    },
                    {
                        "translation_id": "a2f7496e-261d-4d40-b0f5-88e2fac854f7",
                        "source_entry_id": "155216e8-4de8-3a91-ae74-a7919f603f3d",
                        "source_sense_id": "3c3029fe-35af-38f0-8d68-1c73ffc239e2",
                        "target_lang_word": "Abend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f853f6f5-3b80-3474-9346-0a9fbe090c2d",
                                        "entry_id": "166067f8-ae5e-32b5-ac0d-8bc6161eceac",
                                        "glosses": [
                                            "die Tageszeit nach dem Nachmittag, die beginnt, wenn die Sonne den Horizont erreicht, und bei völliger Dunkelheit endet; dem Abend geht der Tag voran und auf den Abend folgt die Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ddfd36-e545-454f-800a-076c19849f91",
                                                "sense_id": "f853f6f5-3b80-3474-9346-0a9fbe090c2d",
                                                "text": "„Eines Abends, als sie so vertraulich beisammensaßen, klopfte jemand an die Türe, als wollte er eingelassen sein.“"
                                            },
                                            {
                                                "example_id": "8e586d3e-1cd5-4f87-a56b-0c180355451d",
                                                "sense_id": "f853f6f5-3b80-3474-9346-0a9fbe090c2d",
                                                "text": "Gegen Abend werden wir uns sehen."
                                            },
                                            {
                                                "example_id": "fb62467d-5a07-4430-a75a-b975eb13fecb",
                                                "sense_id": "f853f6f5-3b80-3474-9346-0a9fbe090c2d",
                                                "text": "Wenn es gestern Abend nicht geklappt hat, dann wird es vielleicht heute Abend oder spätestens morgen Abend etwas."
                                            },
                                            {
                                                "example_id": "d0b6e8ac-e8c3-4ba0-914d-d4c6f05ab2b9",
                                                "sense_id": "f853f6f5-3b80-3474-9346-0a9fbe090c2d",
                                                "text": "Es ist zu früh, „guten Abend“ zu sagen."
                                            },
                                            {
                                                "example_id": "6e601470-21fd-4097-8345-64ae1d28cd8e",
                                                "sense_id": "f853f6f5-3b80-3474-9346-0a9fbe090c2d",
                                                "text": "Wir haben einen wunderbaren Abend in der Oper verbracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bf97008-f7d4-3a93-b2ec-73d0f4abc971",
                                        "entry_id": "166067f8-ae5e-32b5-ac0d-8bc6161eceac",
                                        "glosses": [
                                            "die Himmelsrichtung Westen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea7fe187-6504-4c98-936b-c6843bab71bf",
                                                "sense_id": "9bf97008-f7d4-3a93-b2ec-73d0f4abc971",
                                                "text": "„Dies sind die Namen der Stämme: von Mitternacht, an dem Wege nach Hethlon, gen Hamath und Hazar-Enon und von Damaskus gegen Hamath, das soll Dan für seinen Teil haben von Morgen bis gen Abend.“"
                                            },
                                            {
                                                "example_id": "dd87f9d2-ed0a-4dd7-93f8-1dbca6f991e9",
                                                "sense_id": "9bf97008-f7d4-3a93-b2ec-73d0f4abc971",
                                                "text": "„Der Hof steht am östlichen Ausläufer einer schmalen Geländerippe, die sich in der Ausdehnung einer halben Wegstunde von Abend nach Morgen erstreckt in leichtem Bogen, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ce9755a3-6b79-30d1-b2ef-b4e35f7d098d",
                                        "entry_id": "166067f8-ae5e-32b5-ac0d-8bc6161eceac",
                                        "glosses": [
                                            "verschliffene Begrüßungsfloskel „guten Abend“"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f14ca4a-4670-4212-973f-6a38f75072bb",
