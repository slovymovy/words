        "nl-extract.jsonl": [
            {
                "entry_id": "7f923b62-b1c4-3005-85ef-31d9f798eb00",
                "word": "morgenrood",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c117e12b-f53d-32e5-b088-c591f8395b5b",
                        "entry_id": "7f923b62-b1c4-3005-85ef-31d9f798eb00",
                        "glosses": [
                            "rode lucht bij zonsopgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e1e06ea-92d7-43b0-952d-2c44236ae65a",
                                "sense_id": "c117e12b-f53d-32e5-b088-c591f8395b5b",
                                "text": "Morgenrood, water in de sloot, luidt een oude weerspreuk. Dat zou betekenen dat we in de regio op korte termijn te maken krijgen met neerslag. Een blik op de weerkaart lijkt de zegswijze te bevestigen. Of er ook sprake zal zijn van winterse neerslag, moet nog blijken. Weerman Johan Effing, van weerstationlosser.nl, verwacht 'wat kwakkelweer'."
                            }
                        ]
                    },
                    {
                        "sense_id": "e067336e-e161-3534-b4f1-0e21de72af77",
                        "entry_id": "7f923b62-b1c4-3005-85ef-31d9f798eb00",
                        "glosses": [
                            "goede toekomst"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d5c8f8c6-da0d-4c46-84b8-5bcae09dafbb",
                                "sense_id": "e067336e-e161-3534-b4f1-0e21de72af77",
                                "text": "Zo werd de Magnum de Che Guevara in een guerrilla die volwassenen zou emanciperen door hen te infantiliseren. Kinderlijkheid als de ultieme vorm van maatschappijkritiek en subversie! Eens ze zich kommerloos op een ijsje op een stokje konden trakteren, zonder voor een zonderling of weer zo’n vieze kinderlokker te worden versleten, lag het lichtend pad naar de vrijheid en het nieuwe morgenrood helemaal open."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ff6715c-26d2-3f31-a52d-caa50f2751dd",
                        "entry_id": "7f923b62-b1c4-3005-85ef-31d9f798eb00",
                        "glosses": [
                            "bepaald soort vlinder, Lycaena virgaureae uit de familie Lycaenidae, de kleine pages, vuurvlinders en blauwtjes"
                        ],
                        "tags": [
                            "vlinders"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2814007-1b3b-4c23-98c8-62526fe1cff6",
                        "source_entry_id": "7f923b62-b1c4-3005-85ef-31d9f798eb00",
                        "source_sense_id": "c117e12b-f53d-32e5-b088-c591f8395b5b",
                        "source_sense_description": "de rode lucht bij zonsopgang",
                        "target_lang_word": "Morgenröte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgenröte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                        "entry_id": "2d0f48bc-0072-3493-aba3-e04837bca223",
                                        "glosses": [
                                            "Färbung des Himmels in Rottönen am Morgen kurz vor Sonnenaufgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01c01b2-82e4-402f-b410-2aa3eb33c551",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "Der Professor erfreute sich an der fantastischen Morgenröte."
                                            },
                                            {
                                                "example_id": "2ca2daf7-6a56-4006-9b89-b62112bf802d",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "„Bis zur Morgenröte hatte Reizl auf ihn eingeredet.“"
                                            },
                                            {
                                                "example_id": "768f02a4-6dfd-4417-a430-82a5ef810c41",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "„Beim ersten Strahl der Morgenröte kreischten der mächtige Schlüssel und der Riegel, und Signora Orio öffnete die Tür, um sich ihren nötigen Seelenfrieden für den Tag zu holen.“"
                                            },
                                            {
                                                "example_id": "937787cb-4444-46c5-a9f3-59dbf7c3b352",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "„Die Morgenröte hatte kaum durch den Wald zu schimmern angefangen, als die dunkeln Gestalten der Squaws und ihrer Töchter dem Landungsplatze zueilten, wo einige Stunden zuvor ihre Männer und Väter sich eingeschifft hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b977a0b-b193-4e9a-8e52-8eef8819d7ec",
                        "source_entry_id": "7f923b62-b1c4-3005-85ef-31d9f798eb00",
                        "source_sense_id": "c117e12b-f53d-32e5-b088-c591f8395b5b",
                        "source_sense_description": "de rode lucht bij zonsopgang",
                        "target_lang_word": "Morgenrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgenrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                        "entry_id": "80d7e59f-a322-3df7-bc8c-de427b89d07d",
                                        "glosses": [
                                            "rötliche Färbung des Himmels bei Sonnenaufgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa02358-3a7b-41ca-b647-139c4a048d4e",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "Einer alten Bauernregel zufolge kündigt ein kräftiges Morgenrot schlechtes Wetter an."
                                            },
                                            {
                                                "example_id": "4fdfbcd0-32d6-4070-8400-076398b00922",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "Trittst im Morgenrot daher, Seh’ ich dich im Strahlenmeer, Dich, du Hocherhabener, Herrlicher!"
                                            },
                                            {
                                                "example_id": "101685a6-6f9c-449a-aab7-f2959fb9d1b6",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "„Das musste das Morgenrot sein, das viel zu frühe Morgenrot, das der Schnee reflektierte.“"
                                            },
                                            {
                                                "example_id": "45e59ae9-87cb-4f54-a5f1-68d6bc2486df",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "„Wir waren – ein schöner Beweis meiner Ortskenntnis – bis zum Morgenrot vor der Nase der roten Vorposten in den Sümpfen herumgewatet.“"
                                            },
                                            {
                                                "example_id": "bfbc6449-d9e7-46d1-8b2f-0c8752131db1",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "„Das Morgenrot stand hoch hinter den Häusern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb26f16c-5e67-4288-8cbc-2b7377ef9d35",
