                                        "entry_id": "f243f51c-641e-3918-84ae-9bc692c4f840",
                                        "glosses": [
                                            "eine Person in einer hohen Position, die anderen Mitarbeitern Anweisungen gibt: Vorgesetzter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7011f3fe-3702-48ec-adda-7ce09d89550a",
                                                "sense_id": "f95c617d-8864-306d-9de6-7b9b9dde3bcc",
                                                "text": "Wir müssen den Boss fragen – das können wir nicht allein entscheiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fc38af9-5f8c-3b91-bc0e-b556021ac467",
                                        "entry_id": "f243f51c-641e-3918-84ae-9bc692c4f840",
                                        "glosses": [
                                            "eine Person mit viel Macht"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2476177-7f1f-4c29-8113-9f5e7e1a99f9",
                                                "sense_id": "4fc38af9-5f8c-3b91-bc0e-b556021ac467",
                                                "text": "Du bist der Boss!, also du entscheidest!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "784f3e60-8db9-3ec1-aa77-46df070a61ae",
                                        "entry_id": "f243f51c-641e-3918-84ae-9bc692c4f840",
                                        "glosses": [
                                            "starker Spielgegner"
                                        ],
                                        "tags": [
                                            "Gaming"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "994efa2e-be9c-44af-8258-8a5ccb6dc296",
                                                "sense_id": "784f3e60-8db9-3ec1-aa77-46df070a61ae",
                                                "text": "„Dabei ist der Endgegner nicht immer der stärkste Boss oder auch Gegner im Spiel. Gerade im Rollenspiel sind Bosse oft auch der Abschluss einer besonders fordernden Sidequest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
