                "senses": [
                    {
                        "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                        "entry_id": "c8f6e53d-0a89-345d-a63e-d245881a1e28",
                        "glosses": [
                            "landwirtschaftliche Fläche zum Weiden von Nutztieren (beispielsweise Rindern, Schafen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5989bf-8002-46a3-a6c5-6d3eb8bd77c6",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Auf einer Weidefläche von 70 Hektar werden etwa 100 Rinder gehalten.“"
                            },
                            {
                                "example_id": "92ee82a4-b508-48e4-a3b3-cec4a4721873",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Pro Schaf muss eine Weidefläche von 1.000 Quadratmetern eingeplant werden, […].“"
                            },
                            {
                                "example_id": "1a80d6f0-7039-4c3c-a23d-79986d9fc95c",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Ein Schäfer wie Erich Neulinger braucht mindestens 130 Hektar Weidefläche, um seine Tiere satt zu kriegen.“"
                            },
                            {
                                "example_id": "07cd8825-3f66-4c4a-9cdb-c1d4a87d2791",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Umweltverschmutzung, die Erschließung neuer Acker- und Weideflächen, die Anlage von Verkehrswegen und die Versiegelung von Flächen stellen dramatische Eingriffe in den Naturhaushalt dar.“"
                            },
                            {
                                "example_id": "231cd2f1-9f9f-4dfe-b642-44813c4810fd",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Da DDT auf Weideflächen gelangt war, war die Milch der Kühe von diesen Weiden nicht mehr verkäuflich.“"
                            },
                            {
                                "example_id": "1c1af201-8e7b-4dc8-a903-4dda1ffeb386",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Der Sonderbericht des Weltklimarats (IPCC) zur Landnutzung und Ernährungssicherheit empfiehlt, Weideflächen und Ackerland weltweit zu reduzieren.“"
                            },
                            {
                                "example_id": "4a13a2ac-bb90-45c0-81b8-69a5995aa274",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Eine Hauptaufgabe der Forstverwaltung ist die Aufforstung aufgelassener Weideflächen.“"
                            },
                            {
                                "example_id": "2a2c283d-182e-43b6-82a6-416f94709bb9",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Weideflächen sollten zumindest alle zwei bis drei Tage abgeäppelt werden.“"
                            },
                            {
                                "example_id": "523657a8-efe3-4c23-ab18-61d892ff4419",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "[Über die brasilianische Feuchtsavanne Cerrado:] „In den letzten 40 Jahren wurde laut WWF etwa die Hälfte der natürlichen Vegetation in Acker- und Weideflächen umgewandelt.“"
                            },
                            {
                                "example_id": "973c0293-6700-4944-9ff8-7c889d139bf9",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Zu den Haupttreibern der Abholzung gehören die Nachfrage nach landwirtschaftlichen Weideflächen, Holz sowie fossilen Brennstoffen.“"
                            },
                            {
                                "example_id": "c095f534-a8bc-48ae-8552-df2b3f362c95",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "[Über den Ngorongoro-Krater:] „Wo einmal Lava brodelte, da dehnt sich jetzt unten eine riesige, von steilen Kraterwänden umgebene grüne Weidefläche.“"
                            },
                            {
                                "example_id": "a9cc88d8-502c-4d94-866a-754e84bdf6ed",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Degradierte Weideflächen kommen wieder in Einsatz. »Es handelt sich dabei um Weideland, das bereits seit 20 oder 30 Jahren genutzt wurde und nun nicht mehr brauchbar ist. Jetzt wird dort Soja angebaut«, sagt Endrigo Dalcin, Direktor des Soja-Anbauverbands Aprosoja.“"
                            },
                            {
                                "example_id": "50ee4db5-0c4b-4dbe-8dde-d74fd4da9b31",
                                "sense_id": "97e20657-9bae-3913-a39e-1281235eb072",
                                "text": "„Stellt Bäume auf den Acker! […] Agroforste zeichnen sich dadurch aus, dass Bäume und Hecken in verschiedenen Anordnungen neben den Nutzpflanzen wachsen. Auch Weideflächen für Rinder, Schweine oder Hühner können dazugehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
