                                "target_senses": [
                                    {
                                        "sense_id": "6e055835-50a3-3ca8-91bb-98726fbd7053",
                                        "entry_id": "978ab1e3-d20f-39af-a0d8-fd50be03ddd1",
                                        "glosses": [
                                            "разг. самодельная папироса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e48b29-86c1-468f-8bfa-d47ca8cd9b13",
                                                "sense_id": "6e055835-50a3-3ca8-91bb-98726fbd7053",
                                                "text": "Он вытащил из кармана мундштук и принялся прилаживать к нему толстую самокрутку."
                                            },
                                            {
                                                "example_id": "0a89c796-2fcd-4139-a83a-faa069472fab",
                                                "sense_id": "6e055835-50a3-3ca8-91bb-98726fbd7053",
                                                "text": "Он курил большие самокрутки из невероятно крепкого табака и сочно сплёвывал за борт."
                                            },
                                            {
                                                "example_id": "e051513d-955b-43be-bfed-ac8c68c20b7b",
                                                "sense_id": "6e055835-50a3-3ca8-91bb-98726fbd7053",
                                                "text": "Я научился сворачивать самокрутки, не отрывая рук от рулевого колеса. Ездил и покуривал."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "самокру́тка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e300e63f-09f4-3a10-bb29-b1b6f4ec93f5",
                                        "entry_id": "3fa6dcca-8d39-3eb8-86e3-0dd0ad744915",
                                        "glosses": [
                                            "неодуш., истор. брак, совершённый тайком, против воли родителей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d6dbd6-01e2-4782-86ff-e9229f336ae3",
                                                "sense_id": "e300e63f-09f4-3a10-bb29-b1b6f4ec93f5",
                                                "text": "Свадьба предполагалась самокрутка, чтобы меньше расходов, как делали в Балчуговском заводе."
                                            },
                                            {
                                                "example_id": "ba5a5d52-8b04-48a4-8049-731b7d95f527",
                                                "sense_id": "e300e63f-09f4-3a10-bb29-b1b6f4ec93f5",
                                                "text": "― Велеть нам с Петром Степанычем самокрутку ладить скорей, вот что надобно делать, ― подхватил Семен Петрович. ― Мы бы с ним зараз. Шапки с головы ухватить не успеешь, как будешь повенчан…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22952cbf-c5ef-3e3a-9905-7cf0b813b038",
