                    },
                    {
                        "form_id": "84cd69e4-0a13-4980-b27c-fc52db2f28a1",
                        "entry_id": "92e1b3e5-d262-39c1-af74-8fbd38513708",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "rémunératrices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad171e34-1f2a-369c-abb3-f6cb1caadaee",
                        "entry_id": "92e1b3e5-d262-39c1-af74-8fbd38513708",
                        "glosses": [
                            "Qui récompense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7379714c-6511-411c-be7b-98c709da7d0d",
                                "sense_id": "ad171e34-1f2a-369c-abb3-f6cb1caadaee",
                                "text": "Eh bien ! que puis-je faire pour toi ? dit le Christ. Je suis le Dieu rémunérateur, demande, et ce que tu me demanderas te sera accordé."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a427add-311b-3ba3-be1c-e1452ed446ff",
                        "entry_id": "92e1b3e5-d262-39c1-af74-8fbd38513708",
                        "glosses": [
                            "Qui procure un bénéfice suffisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c757a513-edf2-4e48-ad64-cbd1afee5c3c",
                                "sense_id": "0a427add-311b-3ba3-be1c-e1452ed446ff",
                                "text": "L’élève du cheval de trait et du mulet est aujourd’hui une industrie très-prospère et surtout très-rémunératrice."
                            },
                            {
                                "example_id": "4ad28012-5c71-41e3-88ba-d0f2e213860f",
                                "sense_id": "0a427add-311b-3ba3-be1c-e1452ed446ff",
                                "text": "Quelle hérésie ! Jacques Bonhomme, trahir la cause du sol, abandonner la culture du blé parce que peu rémunératrice."
                            },
                            {
                                "example_id": "0b24dc28-eb0a-4a20-aa7c-3bcd6c235ebd",
                                "sense_id": "0a427add-311b-3ba3-be1c-e1452ed446ff",
                                "text": "Ils sont bien ravitaillés, les paysans ne rechignent plus, leur vendent à des prix rémunérateurs pour eux, mais sans difficultés tout ce dont ils ont besoin. Dans quelques cas, on a été obligé d’en passer par les prix du marché noir."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "507da5da-0543-4c4f-b60f-8097ac07e750",
                        "source_entry_id": "92e1b3e5-d262-39c1-af74-8fbd38513708",
