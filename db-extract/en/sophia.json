                                            {
                                                "example_id": "caac0891-22db-44fe-bfcd-635bd4fc295a",
                                                "sense_id": "70f750ac-6adb-37ae-8f61-b224b5a3e9ac",
                                                "text": "Za oknem fuchsie a jedna píseň krotká, svátek má Žofie a ta má v těle šotka, hele"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ad36d87-f911-4ff3-88c2-83c2521a46d6",
                        "source_entry_id": "c8e20c84-edd4-3de5-b4e5-2dd942b67983",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Sophie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sophie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8954e67d-bc2c-3b63-90a7-ea2275d632c5",
                                        "entry_id": "522c7744-e353-3054-b398-e33296e1cdb9",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dbf2cb0-28e7-420c-b57f-8a77e4f7dc32",
                                                "sense_id": "8954e67d-bc2c-3b63-90a7-ea2275d632c5",
                                                "text": "En ce début d’automne 1793, on célèbre, à Genève, une fête simple et idyllique en l’honneur de Jean-Jacques Rousseau. Une blonde jeune fille représente Sophie et pose une couronne de roses sur le buste du grand homme."
                                            },
                                            {
                                                "example_id": "d6cf137b-c06d-4111-a389-8870b884d30d",
                                                "sense_id": "8954e67d-bc2c-3b63-90a7-ea2275d632c5",
                                                "text": "Mais mon oncle me représenta que Sophie était un prénom des plus répandus, et souvent porté par de jeunes personnes rien moins que sages : demi-mondaines, maîtresses d’empire, vésuviennes…"
                                            },
                                            {
                                                "example_id": "c65117c1-7008-4436-8c5b-ed3ecb4604c5",
                                                "sense_id": "8954e67d-bc2c-3b63-90a7-ea2275d632c5",
                                                "text": "Avec Sophie Belloir, mezzo-soprano ; Maël Fauvy, guitariste et compositeur, et Chani Stroobant, violoniste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sophie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05476d92-3683-3765-9c25-ca2fd82d0df9",
                                        "entry_id": "804e0574-2c3c-39f4-84f8-9442c98e2117",
                                        "glosses": [
                                            "Ancien nom de Sofia, capitale de la Bulgarie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e0e0eca-95c3-4dd5-a1e0-2e44ab80ca8b",
                                                "sense_id": "05476d92-3683-3765-9c25-ca2fd82d0df9",
                                                "text": "On franchit une marche de Nissa [Niš] à Mustapha-Pacha-Palanka [Bela Palanka], puis une autre de Palanka à Scharkoë [Pirot] et une troisième de Scharkoë à Sophie, en traversant le long plateau de Tzaribrod [Dimitrovgrad]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
