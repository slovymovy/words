                    {
                        "translation_id": "9aa88737-d7bb-4286-bc46-14263a4ccf73",
                        "source_entry_id": "fc992f9f-79c5-3160-b36e-38b398022249",
                        "source_sense_id": "a0458b82-4d1f-3222-bc48-b6df8880089f",
                        "target_lang_word": "braconner",
                        "target_lang_code": "fr",
