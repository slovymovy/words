                        "examples": [
                            {
                                "example_id": "5d802741-27bb-4e4b-b0d3-32cc9ae1e6af",
                                "sense_id": "cf3d4f60-4953-3eae-af38-4532ff3d964f",
                                "text": "— Et vous comptez tenir le barbeuc dehors tout à l'heure, aussi ? Retourner les steaks hachés à ma place ?"
                            },
                            {
                                "example_id": "372cc79d-a42b-4ae5-9a64-5c15b7df42d0",
                                "sense_id": "cf3d4f60-4953-3eae-af38-4532ff3d964f",
                                "text": "— Rien à foutre, on fait un barbeuc !\nIl avait décidé de fêter dignement le retour de ses deux sœurs préférées à la maison."
                            },
                            {
                                "example_id": "242818b7-8324-4aa3-b1dc-16a02c4cfc45",
                                "sense_id": "cf3d4f60-4953-3eae-af38-4532ff3d964f",
                                "text": "En revoyant Tonio, Hervé se rappelle les apéros, les « barbeucs » chez les uns et les autres... Tout le quartier s'était mobilisé quand la petite avait disparu."
                            }
                        ]
                    }
