                    }
                ],
                "senses": [
                    {
                        "sense_id": "0eb003bd-7dcc-3b5c-a3d8-56c044adab40",
                        "entry_id": "34db1123-9359-310f-b85f-991a1dfc26bb",
                        "glosses": [
                            "durch die Polizei sichergestellter Schutz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832a5b20-f93c-4f03-87d9-8996b250408d",
                                "sense_id": "0eb003bd-7dcc-3b5c-a3d8-56c044adab40",
                                "text": "„Das Fest der schlagenden Verbindungen sei mittlerweile ein Höhepunkt im Kalender beider Gruppen, schreibt das Blatt, den einen diene es zum Knüpfen von Netzwerken unter Polizeischutz, den anderen als Grund, zuzuschlagen.“"
                            },
                            {
                                "example_id": "b7fa4bb8-bf96-4a45-858d-21c735240737",
                                "sense_id": "0eb003bd-7dcc-3b5c-a3d8-56c044adab40",
                                "text": "„Einmal kletterten sie auf die Bühne, sodass ich unter Polizeischutz über einen Hinterausgang fliehen musste.“"
                            },
                            {
                                "example_id": "46fb46b1-cbf2-422a-a180-fc0bb3f5947e",
                                "sense_id": "0eb003bd-7dcc-3b5c-a3d8-56c044adab40",
                                "text": "„Alles, was die französische Regierung daraufhin unternommen hatte, war, Polizeischutz für italienische Amtsstellen und Geschäfte in Paris bereitzustellen.“"
                            },
                            {
                                "example_id": "1deda1cf-422c-4210-8ab5-53f1a2a1314a",
                                "sense_id": "0eb003bd-7dcc-3b5c-a3d8-56c044adab40",
                                "text": "„Sie wäre in einem anderen Land unter Polizeischutz und mit viel Geld.“"
                            },
                            {
                                "example_id": "3d44ec89-d327-4dba-b08f-0f95a48c4aeb",
                                "sense_id": "0eb003bd-7dcc-3b5c-a3d8-56c044adab40",
                                "text": "„Wie vergiftet das innenpolitische Klima war, zeigte sich besonders drastisch in einem Angriff auf den Premierminister am 14. September 1960, als Whitehead nur mit knapper Not und unter Polizeischutz einer wütenden Menge entkommen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
