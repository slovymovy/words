                "senses": [
                    {
                        "sense_id": "0d2a2764-68d7-329c-b645-d2ba6bd38d86",
                        "entry_id": "15a3d059-f693-3959-a402-e30af7656881",
                        "glosses": [
                            "Potage national russe, ukrainien et slave en général."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06dee323-1090-41e1-a7a5-6e120bb3799c",
                                "sense_id": "0d2a2764-68d7-329c-b645-d2ba6bd38d86",
                                "text": "Comment résister aux délices du bortsch, la soupe nationale, sorte de pot-au-feu, additionné de chou rouge et de crème fraîche, dont les marbrures glacées de rose et de blanc rappellent la page de garde d'un vieux bouquin."
                            },
                            {
                                "example_id": "6a67ef62-7e2c-43c2-b161-67a020ac22a7",
                                "sense_id": "0d2a2764-68d7-329c-b645-d2ba6bd38d86",
                                "text": "Tu connais une femme lubrique à Moscou\nQui mange tes syllabes et les met dans ton bortsch."
                            },
                            {
                                "example_id": "8f667ddc-d65c-46bd-aabf-e9456a0c1283",
                                "sense_id": "0d2a2764-68d7-329c-b645-d2ba6bd38d86",
                                "text": "La nourriture servie pour le dîner était un bortsch immonde et j’eus l’idée de faire miroiter à la serveuse un billet de dix dollars."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3156d177-0693-411e-bca0-f47dbfcbec8a",
                        "source_entry_id": "15a3d059-f693-3959-a402-e30af7656881",
                        "source_sense_id": "0d2a2764-68d7-329c-b645-d2ba6bd38d86",
                        "target_lang_word": "Borschtsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Borschtsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1128df83-0423-314b-a688-f5e25cea7451",
                                        "entry_id": "6c6b3bb5-f86c-3351-b694-ff7faf3b834b",
                                        "glosses": [
                                            "reichhaltige Gemüsesuppe aus Roter Bete mit Fleisch, die in Mittel- und Osteuropa sehr verbreitet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1a194a-b742-452d-8732-a3642b3f68fe",
                                                "sense_id": "1128df83-0423-314b-a688-f5e25cea7451",
                                                "text": "Die Zusammensetzung von Borschtsch ist regional unterschiedlich, fast immer gehören jedoch Fleisch, Rote Bete und Weißkohl dazu."
                                            },
                                            {
                                                "example_id": "05a16e41-603c-40eb-984d-dbdddf014f77",
                                                "sense_id": "1128df83-0423-314b-a688-f5e25cea7451",
                                                "text": "„Er brachte mir Brot, Speck und in Wodkaflaschen abgefüllten Borschtsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
