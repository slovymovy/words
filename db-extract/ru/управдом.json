                                    {
                                        "sense_id": "6373694e-b40c-3158-95f2-5df50803e023",
                                        "entry_id": "563cc854-a190-3a47-823c-3398cba3a578",
                                        "glosses": [
                                            "Person, die für die Instandhaltung eines Gebäudes zuständig ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "872d9d45-2ef9-4c37-b035-b83a00f52021",
                                                "sense_id": "6373694e-b40c-3158-95f2-5df50803e023",
                                                "text": "Eine Stelle als Hausmeister ist oft ein begehrter Arbeitsplatz."
                                            },
                                            {
                                                "example_id": "535f035c-d1fd-4278-86d5-5b001c079b5e",
                                                "sense_id": "6373694e-b40c-3158-95f2-5df50803e023",
                                                "text": "„Der Hausmeister war hinzugekommen.“"
                                            },
                                            {
                                                "example_id": "f2aebaa8-a036-4156-8edf-25db855835f4",
                                                "sense_id": "6373694e-b40c-3158-95f2-5df50803e023",
                                                "text": "„Später sagte man mir, er habe im Lehrerzimmer auf mich gewartet, bis der Hausmeister das Schulgebäude abschließen wollte.“"
                                            },
                                            {
                                                "example_id": "574a8fb9-ddc4-49e3-a1b9-2247ba175954",
                                                "sense_id": "6373694e-b40c-3158-95f2-5df50803e023",
                                                "text": "„Der Hausmeister kam und er sah nichts als die Schatten unserer fleißigen Körper, die putzten und wischten.“"
                                            },
                                            {
                                                "example_id": "fcbe8445-e673-4daa-a87a-d517f894bf5b",
                                                "sense_id": "6373694e-b40c-3158-95f2-5df50803e023",
                                                "text": "„Im Jahre 1937 starb unser Hausmeister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
