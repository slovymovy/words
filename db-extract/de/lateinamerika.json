                "senses": [
                    {
                        "sense_id": "dd5805ba-c3fc-3656-8d70-4d696034303d",
                        "entry_id": "d15a1796-cfb7-3870-a0ee-3cdcd9ca7546",
                        "glosses": [
                            "Gesamtheit der amerikanischen Länder südlich der USA, zu der meist die Gebiete Südamerika, Mittelamerika, Mexiko und Karibik gezählt werden"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "51349f27-0ed3-47ff-ab83-b99f6f7a3bd9",
                                "sense_id": "dd5805ba-c3fc-3656-8d70-4d696034303d",
                                "text": "In der heute üblichen Definition des Begriffs werden zu Lateinamerika nur die Länder gezählt, in denen das Spanische oder das Portugiesische vorherrscht."
                            },
                            {
                                "example_id": "e11f5251-fabe-40fe-968c-cfefafa27fdc",
                                "sense_id": "dd5805ba-c3fc-3656-8d70-4d696034303d",
                                "text": "„Die Einwanderungswelle aus Lateinamerika ist gewaltig, Spanisch wird immer wichtiger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d915d1f-394a-4d25-944b-0c3e64399d15",
                        "source_entry_id": "d15a1796-cfb7-3870-a0ee-3cdcd9ca7546",
