                                        "examples": [
                                            {
                                                "example_id": "0169be41-5f7d-485e-b2c0-fd783ff4ad19",
                                                "sense_id": "b0ca1cda-e480-392d-bc7e-94cf9703fd81",
                                                "text": "Es ist eine fröhliche Gesellschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19ac2c2b-4add-3c57-a0ca-e4ab0ca0f556",
                                        "entry_id": "60704948-316b-30bb-bb7c-5952943f61a3",
                                        "glosses": [
                                            "lustig, ausgelassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00d8030-3f93-44ed-82e3-f8190d0feac7",
                                                "sense_id": "19ac2c2b-4add-3c57-a0ca-e4ab0ca0f556",
                                                "text": "Dies ist ein fröhliches Lied."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5c9a62e-d03a-4ad6-87bb-d59de3cb5188",
                        "source_entry_id": "7a600934-0ada-3541-9503-7b3c325c2d87",
                        "source_sense_id": "de5d529e-becc-3fc2-b2f8-4bad52ef8676",
                        "target_lang_word": "mit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                        "entry_id": "f89d2e81-79c2-3045-868a-98f2ab11c3f0",
                                        "glosses": [
                                            "etwas oder jemandem angeschlossen oder damit als gewisse Einheit verbunden; zusammen"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b50069-98a3-4276-94f4-c3f510790258",
                                                "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                                "text": "Ich gehe mit Freunden spazieren."
                                            },
                                            {
                                                "example_id": "b58c10e0-4eff-4e51-9cff-d2509a7aaf7c",
                                                "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                                "text": "Hier hätten wir dann einen Fernseher mit Fernbedienung."
                                            },
                                            {
                                                "example_id": "626be311-f90f-4a34-b6dc-cc5d0a7afcf6",
                                                "sense_id": "db2f05c7-f540-3a10-bf72-7037ba0b9be9",
                                                "text": "Mit wem hast du da telefoniert?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                        "entry_id": "f89d2e81-79c2-3045-868a-98f2ab11c3f0",
                                        "glosses": [
                                            "unter Ausnutzung, durch die Hilfe von etwas"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46b4d1e3-7620-4d9f-8b65-a82314f33321",
                                                "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                                "text": "Ich fahre mit dem Auto."
                                            },
                                            {
                                                "example_id": "6e7b3812-f013-465f-8500-368232021202",
                                                "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                                "text": "Wir sind da mit der Seilbahn hochgefahren."
                                            },
                                            {
                                                "example_id": "c2ffb95a-b222-4f0c-a9f6-f5cf8240ea0e",
                                                "sense_id": "05c53c18-32d8-3bec-add2-0e353532295c",
                                                "text": "Mit Seehofer besucht erstmals ein bayerischer Ministerpräsident das Nachbarland Tschechien. (Hörfunk-Nachricht zu einer Zeit, in der Horst Seehofer der Ministerpräsident von Bayern ist, nur mit diesem Wissen von Bedeutung 1 unterscheidbar)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d9ddbd5a-e401-3152-8bf6-a331d75a72b7",
                                        "entry_id": "f89d2e81-79c2-3045-868a-98f2ab11c3f0",
                                        "glosses": [
                                            "beim Kämpfen mit einem Gegner (im Wettkampf mit); gegen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c9662-5027-445b-be73-c535532589d3",
                                                "sense_id": "d9ddbd5a-e401-3152-8bf6-a331d75a72b7",
                                                "text": "Im Kampf mit der gegnerischen Mannschaft konnte unser Team ein ehrenwertes Unentschieden erreichen."
                                            },
                                            {
                                                "example_id": "bb9822b3-c236-4963-a5f3-48138d056d87",
                                                "sense_id": "d9ddbd5a-e401-3152-8bf6-a331d75a72b7",
                                                "text": "Ich habe mich noch nicht entschieden, ich ringe noch mit mir, ob ich wirklich einen ganzen Tag frei nehmen soll."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "mit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e906643-cde6-3e37-9fe2-fa4aeb3055bf",
                                        "entry_id": "bab1bd5f-7bed-31c5-b0ff-542c68ae3989",
                                        "glosses": [
                                            "wie andere, zusammen mit anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d7915e-ec26-44ef-ad2c-5535cfb1f538",
                                                "sense_id": "7e906643-cde6-3e37-9fe2-fa4aeb3055bf",
                                                "text": "Dieses Hemd gehört nicht mit in die Buntwäsche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7b9dc69-9dcb-31e1-b15b-d31b63e67cc9",
                                        "entry_id": "bab1bd5f-7bed-31c5-b0ff-542c68ae3989",
                                        "glosses": [
                                            "neben anderen, als eines/einige von mehreren"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a6ae27-c245-45e9-9911-9d8dbbc9e754",
                                                "sense_id": "b7b9dc69-9dcb-31e1-b15b-d31b63e67cc9",
                                                "text": "Das ist mit das interessanteste Verzeichnis und auch eines der wichtigsten."
                                            },
                                            {
                                                "example_id": "fed13667-d8d2-468b-9825-a3ccd80f8b50",
                                                "sense_id": "b7b9dc69-9dcb-31e1-b15b-d31b63e67cc9",
                                                "text": "„Mit die schönsten Gerichtsgebäude in Deutschland sind das Landgericht in Bremen von 1895 und das auf einer Insel gelegene Amtsgericht in Lindau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00afd956-d950-4a7b-8e5a-17658abd4994",
                        "source_entry_id": "7a600934-0ada-3541-9503-7b3c325c2d87",
                        "source_sense_id": "de5d529e-becc-3fc2-b2f8-4bad52ef8676",
                        "target_lang_word": "Freude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freude",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c80e91f6-7bdc-3fe0-b239-bb0b4b87f271",
                                        "entry_id": "fe3087c9-7ae7-30e3-94c9-7012b0f98a37",
                                        "glosses": [
                                            "positives Gefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2100061-0b13-4cb0-b46c-818a679d6949",
                                                "sense_id": "c80e91f6-7bdc-3fe0-b239-bb0b4b87f271",
                                                "text": "Die Freude war groß, als der Onkel endlich da war."
                                            },
                                            {
                                                "example_id": "557a3d61-9ba1-4d53-8d1a-b0a19d278a9b",
                                                "sense_id": "c80e91f6-7bdc-3fe0-b239-bb0b4b87f271",
                                                "text": "Es ist mir eine große Freude, Sie begrüßen zu dürfen."
                                            },
                                            {
                                                "example_id": "33c8eda4-bf35-4018-b8e6-e6921a00895b",
                                                "sense_id": "c80e91f6-7bdc-3fe0-b239-bb0b4b87f271",
                                                "text": "Er genoss die Freuden des Junggesellenlebens."
                                            },
                                            {
                                                "example_id": "f49d1971-8267-46c8-88b9-5697a1bb9b1a",
                                                "sense_id": "c80e91f6-7bdc-3fe0-b239-bb0b4b87f271",
                                                "text": "„Kaum hatte sie seine Stimme gehört, als ihr Gesicht plötzlich erglühte, und zwar offenbar in Kummer und Freude zugleich.“"
                                            },
                                            {
                                                "example_id": "56ac36df-3e2d-4c79-b831-f5fb91bad501",
                                                "sense_id": "c80e91f6-7bdc-3fe0-b239-bb0b4b87f271",
                                                "text": "„Schach empfing am selben Tage noch ein Antwortbillett, das ihm unumwunden die herzliche Freude seiner alten Freundin ausdrückte.“"
                                            },
                                            {
                                                "example_id": "77cfe319-9931-4224-a264-243f4ec1dbe6",
                                                "sense_id": "c80e91f6-7bdc-3fe0-b239-bb0b4b87f271",
                                                "text": "„Ein Gefühl von Wehmut und Freude, von bangem Schmerze und froher Sehnsucht trieb ihn vorwärts zum Lande seiner Kindheit, seiner Mannbarkeit, dem er den Rücken zu wenden gezwungen worden war, das ihn verstoßen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
