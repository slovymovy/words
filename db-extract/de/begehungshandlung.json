                "senses": [
                    {
                        "sense_id": "a7ee12a0-a4cf-39d1-ab67-7266a85dcf8b",
                        "entry_id": "8aa13036-e998-3429-b506-545f2958ae6d",
                        "glosses": [
                            "rechtlicher Handlungstyp, bei dem eine bestimmte Handlung begangen werden soll oder muss (und nicht eine bestimmte Handlung unterlassen werden soll oder muss)"
                        ],
                        "tags": [
                            "Rechtsphilosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "43d1245d-bb91-458c-ae5f-e846f55d87ce",
                                "sense_id": "a7ee12a0-a4cf-39d1-ab67-7266a85dcf8b",
                                "text": "„[…] um der Pflicht, meine Schulden zurückzuzahlen, zu genügen, muß ich eine Handlung vom Typ einer Begehungshandlung unternehmen, d.h. ich muß etwas tun und eben nicht etwas unterlassen.“"
                            },
                            {
                                "example_id": "bbf0b06c-0cae-43b5-bd85-1174bf8c666d",
                                "sense_id": "a7ee12a0-a4cf-39d1-ab67-7266a85dcf8b",
                                "text": "„Die Verpflichtung zum Schadenersatze setzt eine Begehungshandlung voraus, doch kann die Handlung auch eine solche sein, welche bloß mittelbar Schaden bringt […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
