            "senses": [
                {
                    "sense_id": "d41dfe31-e598-343c-a13a-42ed3b6d3648",
                    "sense_definition": "Relating to the continent of Africa or its people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geographical_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>African</w> continent is home to a vast diversity of cultures and languages.",
                            "target_lang_translations": {
                                "ru": "<w>Африканский</w> континент является домом для огромного разнообразия культур и языков."
                            }
                        },
                        {
                            "text": "Many <w>African</w> nations have seen rapid economic growth in recent decades.",
                            "target_lang_translations": {
                                "ru": "Многие <w>африканские</w> страны продемонстрировали быстрый экономический рост в последние десятилетия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "African continent",
                        "African countries",
                        "African culture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к континенту Африка или его народам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "африканский",
                                "target_lang_sense_clarification": "относящийся к Африке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5981e0b-ee7d-3c4c-8669-544fdf76459b",
                    "sense_definition": "Relating to people with dark skin or of Black ancestry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ethnicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study compared different <w>African</w> skin types to understand their unique needs.",
                            "target_lang_translations": {
                                "ru": "В исследовании сравнивались различные <w>африканские</w> типы кожи, чтобы понять их уникальные потребности."
                            }
                        },
                        {
                            "text": "He spoke about the historical significance of <w>African</w> heritage in the Americas.",
                            "target_lang_translations": {
                                "ru": "Он говорил об историческом значении <w>африканского</w> наследия в Америке."
                            }
                        }
                    ],
                    "synonyms": [
                        "Afro-",
                        "Nubian"
                    ],
                    "common_phrases": [
                        "African heritage",
                        "African descent"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "sometimes used in older texts to describe race"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к людям с темным цветом кожи или африканским происхождением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "африканский",
                                "target_lang_sense_clarification": "о происхождении или наследии"
                            },
                            {
                                "target_lang_word": "афро-",
                                "target_lang_sense_clarification": "приставка, указывающая на связь с Африкой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe7c8d3f-429d-34c4-886d-304025782384",
                    "sense_definition": "A person who was born in Africa or who has ancestors from Africa.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Africans</w> living abroad maintain strong ties to their home countries.",
                            "target_lang_translations": {
                                "ru": "Многие <w>африканцы</w>, живущие за границей, поддерживают тесные связи со своими родными странами."
                            }
                        },
                        {
                            "text": "The conference brought together <w>Africans</w> from across the globe to discuss innovation.",
                            "target_lang_translations": {
                                "ru": "Конференция собрала <w>африканцев</w> со всего мира для обсуждения инноваций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "native Africans",
                        "diaspora Africans"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, родившийся в Африке или имеющий африканских предков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "африканец",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "африканка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ]
                    }
