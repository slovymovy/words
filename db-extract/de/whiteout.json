                ],
                "senses": [
                    {
                        "sense_id": "7a8e4a31-9e57-3fd4-83ca-69ef1e8fbd1f",
                        "entry_id": "973a5e06-4f08-3554-a58f-082e23f651d0",
                        "glosses": [
                            "meteorologische Erscheinung, bei der durch hohe Helligkeit Boden und Himmel zu verschmelzen scheinen und der Horizont nicht mehr zu erkennen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4626da-0a18-4458-b37b-bb1c5acd17f3",
                                "sense_id": "7a8e4a31-9e57-3fd4-83ca-69ef1e8fbd1f",
                                "text": "„Beim polaren Whiteout wird Sonnenlicht so diffus von der Schnee- und Wolkendecke reflektiert, dass sich im Auge des geblendeten Betrachters bestimmte Kontraste auflösen.“"
                            },
                            {
                                "example_id": "f645282a-e905-4938-8195-6df94de2cc8f",
                                "sense_id": "7a8e4a31-9e57-3fd4-83ca-69ef1e8fbd1f",
                                "text": "„Ein sogenanntes ‚Whiteout‘ soll sich durch die aufwirbelnden Schneewolken entwickelt haben, die Sicht sei dadurch erheblich eingeschränkt gewesen.“"
                            },
                            {
                                "example_id": "f38f000e-6d6b-423a-9067-1b6514f94455",
                                "sense_id": "7a8e4a31-9e57-3fd4-83ca-69ef1e8fbd1f",
                                "text": "„Denn der ständige Wind, heftige Schneestürme, schlechte Sicht und Whiteout – durch extreme Helligkeit gehen Konturen in Eis und Schnee verloren – machen jeden Flug zum Wagnis.“"
                            },
                            {
                                "example_id": "1b4a08c0-9b9b-4673-a124-8a291a378d2b",
                                "sense_id": "7a8e4a31-9e57-3fd4-83ca-69ef1e8fbd1f",
                                "text": "„‚Whiteout‘ wird es genannt, wenn in arktischen Eiswüsten nicht mehr erkannt werden kann, wo der Boden endet und der Himmel beginnt – und sich ein unendlich leerer Raum aufzutun scheint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db3746d1-55e4-47de-81c8-fa0d82d63630",
                        "source_entry_id": "973a5e06-4f08-3554-a58f-082e23f651d0",
                        "source_sense_id": "7a8e4a31-9e57-3fd4-83ca-69ef1e8fbd1f",
                        "target_lang_word": "whiteout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whiteout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5db61fb-fd9d-3a15-b7a5-6a93c7cc8607",
                                        "entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                                        "glosses": [
                                            "A heavy snowstorm; a blizzard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb18fa39-fea4-31ec-b763-2c5aff977ba2",
                                        "entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                                        "glosses": [
                                            "Any weather condition in which visibility and contrast are severely reduced by snow or sand causing the horizon and physical features of the terrain to disappear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59d8fc1-1bac-4499-bc65-df4cb5785691",
                                                "sense_id": "cb18fa39-fea4-31ec-b763-2c5aff977ba2",
                                                "text": "A whiteout can best be described as a paradoxical combination of being partially blind, but also being able to see illusions of things. It is like floundering in a sea of cotton; everything looks blurred and white."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe38155-5253-35be-9cc5-f412dcb7fc03",
                                        "entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                                        "glosses": [
                                            "Correction fluid (from the brand name Wite-Out)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "068329f3-566d-3094-a238-bf3dcf01488d",
                                        "entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                                        "glosses": [
                                            "A sporting event where all in attendance are urged to wear white apparel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98579e45-b8b8-3485-83d3-c06da8972df0",
                                        "entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                                        "glosses": [
                                            "The simulated erasure of a file, etc. on a read-only volume."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82e568c3-2fd5-3676-9705-0d463263f6ca",
                                        "entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                                        "glosses": [
                                            "The suppression of a story by the media, analogously to deleting information with correction fluid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d867695-0a9c-4f8f-9eb3-d66cf6f9cb68",
                                                "sense_id": "82e568c3-2fd5-3676-9705-0d463263f6ca",
                                                "text": "Despite the media whiteout, we believe our weapon flashing had communicated the important political message that the nuclear mentality and the masculine mentality are intimately connected."
                                            },
                                            {
                                                "example_id": "0e268ea6-d1c7-4ac4-a4dd-ef6831297890",
                                                "sense_id": "82e568c3-2fd5-3676-9705-0d463263f6ca",
                                                "text": "The slightest reference to national security is accepted as excuse enough for a news whiteout."
                                            },
                                            {
                                                "example_id": "514f8cb1-63be-458c-a063-9c0fce11fa3c",
                                                "sense_id": "82e568c3-2fd5-3676-9705-0d463263f6ca",
                                                "text": "What, for example, have the protagonists of the First Amendment to say about the media whiteout in the United States on the work of such a distinguished radical as Noam Chomsky?"
                                            },
                                            {
                                                "example_id": "de0011c0-4032-48ed-bb91-62e078ecd087",
                                                "sense_id": "82e568c3-2fd5-3676-9705-0d463263f6ca",
                                                "text": "\"Who Put the Black Face on Poverty,\" the show asked. Well, the mainstream media \"whiteout\" of the story provides a clue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0e3c663-9e18-366e-9ff5-7302169718c6",
                                        "entry_id": "b16da757-d194-36bb-9bc8-d7632e14fe9c",
                                        "glosses": [
                                            "The silencing of voices and perspectives other than those of white people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df5cb542-72a3-4edb-a248-2f148c1cf47c",
                                                "sense_id": "e0e3c663-9e18-366e-9ff5-7302169718c6",
                                                "text": "While it represented a symbolic break from the “whiteout” on the US presidency, it was also, obviously, the most racialized campaign in American history."
                                            },
                                            {
                                                "example_id": "9ee7e48a-f0b9-4eb0-8eeb-ff951da3f412",
                                                "sense_id": "e0e3c663-9e18-366e-9ff5-7302169718c6",
                                                "text": "Closer to home, I thought about how that same “whiteout” existed in U.S. scholarship on television production and viewership and their cultural flows."
                                            },
                                            {
                                                "example_id": "e9103955-0d42-4b15-bca1-302425a41483",
                                                "sense_id": "e0e3c663-9e18-366e-9ff5-7302169718c6",
                                                "text": "We must return to a time where whiteout will no longer exist in our thinking process, and remember, black is not just a color but a totally different way of being."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
