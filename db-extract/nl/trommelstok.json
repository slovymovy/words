                        "sense_id": "b9b87c42-ca1f-3fbe-9f87-050013a98249",
                        "entry_id": "94911cac-98f4-30b3-afe2-8960cc86e390",
                        "glosses": [
                            "een stok met een bolvormig uiteinde waarmee men op een trommel kan trommelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a5fe378-3505-447b-83bd-2fdac3c614ad",
                                "sense_id": "b9b87c42-ca1f-3fbe-9f87-050013a98249",
                                "text": "Wie de Lattjo-trommelstokjes voor kinderen heeft gekocht bij de IKEA kan die beter terugbrengen naar het woonwarenhuis. Bovenop de stokjes zit een rubberen bal en die kan loskomen of losgedraaid worden. Heel jonge kinderen kunnen erin stikken."
                            },
                            {
                                "example_id": "1adb5b09-b2f1-4828-813a-5f9761c58acb",
                                "sense_id": "b9b87c42-ca1f-3fbe-9f87-050013a98249",
                                "text": "Onder het motto ‘trommelen op rommel’ geeft het duo De Vuilnismannen een bijzondere muziekles op het podium in het Parkgebouw. Na wat korte demonstraties mogen leerlingen zelf met trommelstokken ter hand nemen."
                            }
                        ]
                    }
