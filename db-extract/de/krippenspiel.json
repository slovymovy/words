                "senses": [
                    {
                        "sense_id": "ca287b60-85f9-3d50-a4df-44105f15a2ed",
                        "entry_id": "d6ba9f28-0d82-3b12-a2aa-01bd1019f8cc",
                        "glosses": [
                            "nativity play, Christmas pageant"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f74ec771-9326-44a6-9476-81bd1d2d50cf",
                                "sense_id": "ca287b60-85f9-3d50-a4df-44105f15a2ed",
                                "text": "Wenn alljährlich am 25. Dezember um 6 Uhr morgens das Krippenspiel aufgeführt wird und dazu die 125 »Kruzianer« des traditionsreichen Knabenchors singen, ist die Kirche stets bis auf den letzten ihrer 3000 Plätze gefüllt.",
                                "translation": "When the nativity play is performed every year on December 25th at 6 am and the 125 \"Crucians\" of the traditional boys' choir sing along with it, the church is always filled to the last of its 3,000 seats.",
                                "english": "When the nativity play is performed every year on December 25th at 6 am and the 125 \"Crucians\" of the traditional boys' choir sing along with it, the church is always filled to the last of its 3,000 seats."
                            },
                            {
                                "example_id": "2e472f40-6671-4226-9657-495fb1b9aa9b",
                                "sense_id": "ca287b60-85f9-3d50-a4df-44105f15a2ed",
                                "text": "Das Krippenspiel, wird am Freitag, 24. Dezember, um 14 und um 15.30 Uhr in der Pfarrkirche St. Peter und Paul in Eltville aufgeführt.",
                                "translation": "The nativity play will be performed at the parish church of St. Peter and Paul in Eltville on Friday 24 December at 2 and at 3.30 PM.",
                                "english": "The nativity play will be performed at the parish church of St. Peter and Paul in Eltville on Friday 24 December at 2 and at 3.30 PM."
                            }
                        ]
                    }
