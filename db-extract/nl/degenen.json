                "senses": [
                    {
                        "sense_id": "47797bfd-c303-3565-8cab-dba7432c4440",
                        "entry_id": "5db8c9e3-9494-3efc-ba04-60746584235a",
                        "glosses": [
                            "als antecedent van een beperkende bijzin; de personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850a4031-8d74-4775-afc0-36e5ea19e29a",
                                "sense_id": "47797bfd-c303-3565-8cab-dba7432c4440",
                                "text": "Degenen die dat gemaakt hebben moeten goed georganiseerd geweest zijn."
                            },
                            {
                                "example_id": "0921d17d-39ff-484d-81da-f7a47bd72669",
                                "sense_id": "47797bfd-c303-3565-8cab-dba7432c4440",
                                "text": "Het kon niet lang meer duren voordat een paar gasten het welletjes vonden en opstapten. Ze zag dat haar ouders al een beetje onrustig op de tweezits zaten te schuifelen. Waarschijnlijk waren zij degenen die het spoedig voor gezien hielden."
                            },
                            {
                                "example_id": "8f7cdbb1-222b-4315-b861-663158122a58",
                                "sense_id": "47797bfd-c303-3565-8cab-dba7432c4440",
                                "text": "Aan zijn biograaf had hij er eerder nog wat bij verteld. Een van degenen die destijds bij hem binnenliepen was \"een charmante twintiger\", de minnaar van een vrouw die zijn souterrain huurde. Op een dag ontdekte Terlouw dat de man 400 gulden uit zijn bureaula had gepikt. Omdat de man huilend bekende, deed Terlouw geen aangifte."
                            }
                        ]
                    }
                ],
