{
    "word_family": [
        "nécessaire",
        "nécessiter",
        "nécessité"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cdf74981-136f-32ce-bc4d-588e32d7958e",
                    "sense_definition": "D'une manière inévitable ou logique ; forcément.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un prix plus élevé n'est pas <w>nécessairement</w> le signe d'une meilleure qualité."
                        },
                        {
                            "text": "Si nous partons trop tard, nous allons <w>nécessairement</w> manquer notre correspondance."
                        }
                    ],
                    "synonyms": [
                        "forcément",
                        "inéluctablement",
                        "immanquablement",
                        "fatalement"
                    ],
                    "antonyms": [
                        "éventuellement"
                    ],
                    "common_phrases": [
                        "pas nécessairement"
                    ]
                },
                {
                    "sense_id": "cb3b1e71-8bd4-34a3-84c9-ced19cf42f86",
                    "sense_definition": "D'une façon essentielle ou indispensable ; par un besoin absolu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour obtenir ce poste exigeant, il faut <w>nécessairement</w> maîtriser plusieurs langues étrangères."
                        },
                        {
                            "text": "Le corps humain a <w>nécessairement</w> besoin d'eau pour rester en bonne santé."
                        }
                    ],
                    "synonyms": [
                        "absolument",
                        "indispensablement"
                    ],
                    "antonyms": [
                        "facultativement"
                    ]
                },
                {
                    "sense_id": "a1324ae7-7d37-37c8-b474-750554c89600",
                    "sense_definition": "Sous l'effet d'une contrainte ou du déterminisme, par opposition au libre arbitre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains philosophes affirment que l'homme agit <w>nécessairement</w> sous l'influence de causes extérieures."
                        },
                        {
                            "text": "Dans cette doctrine, la volonté obéit <w>nécessairement</w> aux lois strictes de la nature."
                        }
                    ],
                    "synonyms": [
                        "fatalement"
                    ],
                    "antonyms": [
                        "librement"
                    ]
                }
            ]
        }
    ]
}