                "senses": [
                    {
                        "sense_id": "8da65d3f-6f49-3a5d-a500-78a665a35add",
                        "entry_id": "eb2cbf55-a7c9-3cb4-9a4d-775536068e39",
                        "glosses": [
                            "Stadt in Deutschland, Hauptstadt von Hessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d2e49a-becc-41cb-b225-809637f1ff67",
                                "sense_id": "8da65d3f-6f49-3a5d-a500-78a665a35add",
                                "text": "Wiesbaden liegt am rechten Rheinufer."
                            },
                            {
                                "example_id": "1a7fd4a7-38ba-4894-bf4b-66bc14cb68ff",
                                "sense_id": "8da65d3f-6f49-3a5d-a500-78a665a35add",
                                "text": "„Als traditionelle Orte der Namenforschung im deutschsprachigen Raum sind Lüneburg, Heidelberg, Mainz und Wiesbaden sowie mit Statistiken auch Zentren in Österreich und der Schweiz zu nennen.“"
                            },
                            {
                                "example_id": "5582ef43-a87a-4f14-a4da-60a703555dd0",
                                "sense_id": "8da65d3f-6f49-3a5d-a500-78a665a35add",
                                "text": "„Jetzt war Wiesbaden eine Stadt der armen Rentner, die in Trümmern hausten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
