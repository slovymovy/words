                                                "example_id": "c339152a-8915-4cb3-9cf3-e8fabe60f781",
                                                "sense_id": "3e3b46bd-fb46-378b-a06e-d226a5053eeb",
                                                "text": "The opacity of a clean glass window is near zero."
