                "senses": [
                    {
                        "sense_id": "1eee309f-87af-3856-bf95-b36237491334",
                        "entry_id": "7df9d8df-f61b-3ef2-b772-ba9f8dbf7cbd",
                        "glosses": [
                            "międzynarodowy, nieformalny antyfaszystowski ruch społeczny luźnych, niepowiązanych grup młodzieżowych, stanowiący siłowe ramię organizacji lewicowych i prospołecznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39a5d01-c60c-4bb8-8010-b38ed108906f",
                                "sense_id": "1eee309f-87af-3856-bf95-b36237491334",
                                "text": "Występ odwołano po protestach Antify, zarzucającej muzykom zespołów rasizm i antysemityzm"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58aca986-f28d-4db1-8c99-4c9434995294",
                        "source_entry_id": "7df9d8df-f61b-3ef2-b772-ba9f8dbf7cbd",
                        "source_sense_id": "1eee309f-87af-3856-bf95-b36237491334",
                        "target_lang_word": "Antifa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antifa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbc2216-cdfb-377e-b096-57d129655086",
                                        "entry_id": "9dbb8f74-1eed-37af-a657-ead0686251a0",
                                        "glosses": [
                                            "A decentralized, radical political movement that opposes fascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454818c3-6355-4b40-bf67-22f15d7a2db6",
                                                "sense_id": "6bbc2216-cdfb-377e-b096-57d129655086",
                                                "text": "Similarly, Antifa organized local defense units that fought off Nazi assaults and factory and land-estate committees that blocked further wage cuts and other infringements."
                                            },
                                            {
                                                "example_id": "e0788109-c75e-47d8-8a4a-db6c950343cb",
                                                "sense_id": "6bbc2216-cdfb-377e-b096-57d129655086",
                                                "text": "The active Communist participation in the leadership of the Antifa committees made them vulnerable to \"red scare\" propaganda, especially from the much more conservative city government."
                                            },
                                            {
                                                "example_id": "c7d04b0c-5a3d-4d7d-b3ea-28e656bf0197",
                                                "sense_id": "6bbc2216-cdfb-377e-b096-57d129655086",
                                                "text": "After an anti-fascist punched a right-wing journalist in Portland, militant anti-fascists and Antifa have been branded as 'violent gangs,' even 'terrorists.' Those definitions are completely wrong."
                                            },
                                            {
                                                "example_id": "57c54688-951b-421c-bbab-48e5b1d9c520",
                                                "sense_id": "6bbc2216-cdfb-377e-b096-57d129655086",
                                                "text": "And the FBI is not the only federal law enforcement agency that tracks groups associated with the larger Antifa movement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1ae8784-17b4-3c41-9074-62f3b3603d40",
                                        "entry_id": "9dbb8f74-1eed-37af-a657-ead0686251a0",
                                        "glosses": [
                                            "Black bloc groups that fight fascist or far-right groups in public, usually anarchist, socialist, or communist groups."
                                        ],
                                        "tags": [
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Antifa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                                        "entry_id": "cdd2b0ee-c9ac-38db-b356-06a18bef9d6c",
                                        "glosses": [
                                            "A local instance of this movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fac8135-5fda-4f3c-a340-2e3067b7ffa5",
                                                "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                                                "text": "The stakes were high and the issues far-reaching; it is hardly astonishing that in cities like Bremen and Leipzig Antifas jumped the gun, exercised administrative powers without waiting for military government and continued them."
                                            },
                                            {
                                                "example_id": "4242c65e-0d8a-463b-9b5f-8d7fa414c5cc",
                                                "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                                                "text": "Both the pattern and participation and the internal structure of the Antifas recalled the French underground."
                                            },
                                            {
                                                "example_id": "822437c4-daa6-4171-9fc4-3257dadfe0fa",
                                                "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                                                "text": "After the war, Antifas varied in size and composition across the former Reich, now divided into four zones of occupation, and developed in interaction with the local occupying power. […] Although surviving records indicate that many Antifas were dominated by the KPD, the political mood in the early months was far from the “Third Period” adventurism of the late Weimar period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b25fe4b3-6e9a-340c-87c4-51742152cefd",
                                        "entry_id": "cdd2b0ee-c9ac-38db-b356-06a18bef9d6c",
                                        "glosses": [
                                            "A member of an anti-fascist group."
                                        ],
                                        "tags": [
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "246db0e7-acd7-4c66-8b8c-6d1577302d06",
                        "source_entry_id": "7df9d8df-f61b-3ef2-b772-ba9f8dbf7cbd",
                        "source_sense_id": "1eee309f-87af-3856-bf95-b36237491334",
