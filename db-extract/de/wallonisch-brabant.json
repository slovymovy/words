                    {
                        "sense_id": "7486f130-cc99-35e1-b0c7-9324ed125f50",
                        "entry_id": "f9c919f3-c1ef-3fed-b461-6e40b515c376",
                        "glosses": [
                            "belgische Provinz in der Region Wallonien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51778ec-437a-41dd-8657-d282ceb329bb",
                                "sense_id": "7486f130-cc99-35e1-b0c7-9324ed125f50",
                                "text": "„Weil man des ewigen Hickhacks überdrüssig war, wurde die zweisprachige Provinz schließlich in zwei einsprachige Provinzen – Flämisch-Brabant und Wallonisch-Brabant – geteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
