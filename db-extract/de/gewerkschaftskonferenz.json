                ],
                "senses": [
                    {
                        "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                        "entry_id": "50a5df4c-8779-348f-860c-6da9a5d2bdb0",
                        "glosses": [
                            "Konferenz, auf der sich Gewerkschaftsmitglieder treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106f8a67-9d68-4449-8690-8ec24f875ed6",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Eigentlich wollten Kuypers und seine Leute noch rechtzeitig zur interzonalen Gewerkschaftskonferenz in Berlin sein.“"
                            },
                            {
                                "example_id": "a2749f21-19ac-4909-a5df-fa462b4d7fb5",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Wie viele andere kinderreiche Familien falle jetzt auch die seine den wirtschaftlichen Reformen in Polen zum Opfer, klagte Walesa auf einer Gewerkschaftskonferenz, mit Seitenhieb auf die Politik der Regierung.“"
                            },
                            {
                                "example_id": "4a3bc3a6-1454-4fcd-8212-2555078cdb53",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Während die Regierung sich bemüht, so viele internationale Wirtschaftsforen wie möglich nach China zu holen, sind Gewerkschaftskonferenzen nicht willkommen.“"
                            },
                            {
                                "example_id": "4cf13e69-78ce-480e-a2a4-660e516c29dc",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Bei der Gewerkschaftskonferenz diesen Samstag in Klagenfurt geht eine Ära zu Ende.“"
                            },
                            {
                                "example_id": "13ed4ead-9ccf-4469-ba6d-0caf9c15263b",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Zu den Plakaten der Linken, die für die Gewerkschaftskonferenz werben, meint der Werbefachmann: ‚Das mutet ja zutiefst politisch und ernsthaft an‘.“"
                            },
                            {
                                "example_id": "2644855b-801e-427a-a35b-463391e07022",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Ich war mal auf einer Gewerkschaftskonferenz mit 150 Betriebsräten und da stellte sich heraus, dass nur 10 % bis 15 % der Geschäftsführer das Thema Industrie 4.0 mit all seinen Veränderungen angesprochen haben.“"
                            },
                            {
                                "example_id": "1ef2f339-285b-491d-bb85-58725dd3f88a",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Bei der Gewerkschaftskonferenz warnte Gross die grün-schwarze Landesregierung erneut vor Einschnitten bei der Bildungszeit.“"
                            },
                            {
                                "example_id": "8840c038-fd7d-4f27-beec-109ddb1a1d6e",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Besonders, weil am Montag nicht angesprochen wurde, dass der Armeechef den Armeedelegierten die Teilnahme an einer Gewerkschaftskonferenz untersagt habe, obwohl der zuständige Minister Bausch grünes Licht gegeben hätte.“"
                            },
                            {
                                "example_id": "15d9e2ec-d305-4ae0-8e29-043b02852103",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Auch eine Allgemeine Gewerkschaftskonferenz legte damals den Grundstein für die spätere starke deutsche Arbeiter- und Gewerkschaftsbewegung.“"
                            },
                            {
                                "example_id": "2b8a0e21-6d25-4b77-99f5-8e9c399e4c26",
                                "sense_id": "4f8a2369-2259-32c0-b11a-320efbc49a88",
                                "text": "„Der britische Premierminister Harold Wilson setzt sich am Eröffnungstag der Gewerkschaftskonferenz in Blackpool für die Annahme eines sechsmonatigen Lohnstopps ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
