                        "glosses": [
                            "A place where a gambler can bet on various sports competitions; the company that runs it; the website that is its online presence. (Most such companies offer online betting, subject to geofencing by state.)"
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
