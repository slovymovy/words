                        "sense_id": "fc68b174-9ad1-37ea-b1df-5f571adc71d9",
                        "entry_id": "182de407-d54e-36f0-b988-0523ed0efb8b",
                        "glosses": [
                            "faeces"
                        ],
                        "tags": [
