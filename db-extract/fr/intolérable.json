                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0af5f2-c5e1-4d0a-a546-70d731a9d72f",
                                                "sense_id": "5ab5fd47-014c-3add-a585-88f4d4ae5706",
                                                "text": "It is an intolerable sound that sets spoons tinkling in saucers and windowpanes vibrating."
                                            },
                                            {
                                                "example_id": "52b5b854-e1ae-42db-8aa5-7e6857427609",
                                                "sense_id": "5ab5fd47-014c-3add-a585-88f4d4ae5706",
                                                "text": "“I call on all citizens of Berlin and across Germany to wear the yarmulke (as the skullcap is known in Yiddish) next Saturday if there are new, intolerable attacks targeting Israel and Jews on the occasion of Al-Quds Day in Berlin,” said Felix Klein in a statement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aba12c8-33e6-30e5-a00d-6ccf434de0c2",
                                        "entry_id": "44d2fadc-6106-35fe-9f40-2e1057976762",
                                        "glosses": [
                                            "Extremely worn and degraded, to the point of being unsafe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81da171-4e4d-4032-87f1-599cccbda2d8",
                                                "sense_id": "9aba12c8-33e6-30e5-a00d-6ccf434de0c2",
                                                "text": "o take apart an ageing nuclear facility, you have to put a lot of other things together first. New technologies, for instance, and new buildings to replace the intolerable ones, and new reserves of money."
                                            }
                                        ]
                                    }
                                ]
                            }
