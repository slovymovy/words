                    {
                        "translation_id": "60c793dd-2cea-437f-938d-8e16e5c083d3",
                        "source_entry_id": "ed80ed17-f8f8-39a9-9a1e-def82b9e23a3",
                        "source_sense_id": "24b17db3-2e36-3fc1-ba02-c97f5eb71f8a",
                        "source_sense_description": "act of shaking orweakening or the resulting state; overthrow, ruination",
                        "target_lang_word": "паде́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "паде́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e1539b72-d9a4-3be6-8f22-04ced198c3e0",
                                        "entry_id": "8c39e163-976a-3e87-a2c7-5abc5464494c",
                                        "glosses": [
                                            "действие по значению гл. падать, пасть; движение вниз под действием силы тяжести"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4349788b-ddb3-4d3a-acd6-07f01383241c",
                                                "sense_id": "e1539b72-d9a4-3be6-8f22-04ced198c3e0",
                                                "text": "Тотчас же я услышал падение на пол чего-то тяжёлого: то упала без чувств моя жена."
                                            },
                                            {
                                                "example_id": "24d5f9a8-eec4-49cf-b162-a79ab38f3ced",
                                                "sense_id": "e1539b72-d9a4-3be6-8f22-04ced198c3e0",
                                                "text": "Но тут ветки, за которые цепляется его левая рука, обрываются, и он, потеряв равновесие, — бултых в воду! Словно испуганные, бегут от берега волнистые круги и на месте падения вскакивают пузыри."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c2e137-eab2-3939-9798-6812ed808cdb",
                                        "entry_id": "8c39e163-976a-3e87-a2c7-5abc5464494c",
                                        "glosses": [
                                            "перен. уменьшение, снижение величины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d47743-5362-4b2e-b567-8f1879ca78a2",
                                                "sense_id": "f7c2e137-eab2-3939-9798-6812ed808cdb",
                                                "text": "При падении масс Солнца, при уменьшении его поперечника должна выделяться невообразимо громадная энергия."
                                            },
                                            {
                                                "example_id": "8b2c873c-c027-4e15-9dc8-b503ff4925e5",
                                                "sense_id": "f7c2e137-eab2-3939-9798-6812ed808cdb",
                                                "text": "Падение напряжения в сети."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590ce09c-4bd1-34f5-b5c9-53a51be586f5",
                                        "entry_id": "8c39e163-976a-3e87-a2c7-5abc5464494c",
                                        "glosses": [
                                            "перен. упадок нравственных или духовных сил, нравственное или бытовое разложение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213d8095-1174-4aae-a2cf-3b8b4d627b5a",
                                                "sense_id": "590ce09c-4bd1-34f5-b5c9-53a51be586f5",
                                                "text": "Библейское предание говорит, что отсутствие труда — праздность была условием блаженства первого человека до его падения."
                                            },
                                            {
                                                "example_id": "f583aa04-3262-4763-aeed-9a34ed74e9bd",
                                                "sense_id": "590ce09c-4bd1-34f5-b5c9-53a51be586f5",
                                                "text": "Это было лишь падение воли моей и ума и было вызвано лишь отчаянием моего положения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e063f54b-3811-39c1-88df-90fab75eb0a0",
                                        "entry_id": "8c39e163-976a-3e87-a2c7-5abc5464494c",
                                        "glosses": [
                                            "поражение кого-либо, сдача, покорение врагу"
                                        ],
                                        "tags": [
                                            "(об осажденном городе, крепости)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a400cac4-cca8-4450-94f6-579ce9cdf32e",
                                                "sense_id": "e063f54b-3811-39c1-88df-90fab75eb0a0",
                                                "text": "Падение вражеской крепости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b84fa6e-8ead-3d29-9bbe-63ca9c442f45",
                                        "entry_id": "8c39e163-976a-3e87-a2c7-5abc5464494c",
                                        "glosses": [
                                            "свержение, смещение"
                                        ],
                                        "tags": [
                                            "(о власти)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f50fe11b-7b3e-4f4c-a8b6-cdda6c09eef7",
                                                "sense_id": "5b84fa6e-8ead-3d29-9bbe-63ca9c442f45",
                                                "text": "Я с самого начала, вы знаете, был за них всей душою, ибо в одном бесповоротном падении наполеоновской системы вижу спасение цивилизации, возможность свободного развития свободных учреждений в Европе."
                                            },
                                            {
                                                "example_id": "50709583-51a5-4b46-9e4f-80c0307e1a28",
                                                "sense_id": "5b84fa6e-8ead-3d29-9bbe-63ca9c442f45",
                                                "text": "Падение царского режима в феврале 1917 г."
                                            },
                                            {
                                                "example_id": "77d162a2-ee9c-47fb-a833-060c29c2046e",
                                                "sense_id": "5b84fa6e-8ead-3d29-9bbe-63ca9c442f45",
                                                "text": "Падение правительства."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49eedcd-1388-3414-a7b7-504ad218bd55",
                                        "entry_id": "8c39e163-976a-3e87-a2c7-5abc5464494c",
                                        "glosses": [
                                            "геол. наклонное положение по отношению к горизонтальной поверхности (земли, рек, горных пород); перепад высот"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
