                                                "example_id": "0db4560f-2dc9-43f4-8c56-a1c888bc0738",
                                                "sense_id": "76b3b1a4-68f5-33d4-80dc-8c4615925059",
                                                "text": "That is just the way God tells me this book is His Word. I read it, and it warms me and gives me light."
                                            }
                                        ]
                                    },
