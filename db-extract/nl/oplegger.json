                "senses": [
                    {
                        "sense_id": "2b7ce407-a311-3b64-9631-530bce7bc331",
                        "entry_id": "caf2cdd8-bff4-3948-8bb5-b4ada1ddd07f",
                        "glosses": [
                            "een aanhangwagen, die geen eigen vooras heeft en waarvan dus een belangrijk deel van het gewicht op het trekkend voertuig (de trekker) rust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d2368d-4b68-4f94-89bc-f039172e548d",
                                "sense_id": "2b7ce407-a311-3b64-9631-530bce7bc331",
                                "text": "Nadat de trekker-opleggercombinatie de bestemming had bereikt kon de trekker direkt een nieuwe vracht ophalen terwijl de oplegger nog gelost moest worden."
                            },
                            {
                                "example_id": "59b5d5b5-8a0b-48db-a00f-063c81aac5d4",
                                "sense_id": "2b7ce407-a311-3b64-9631-530bce7bc331",
                                "text": "Elke trekker kan met elke oplegger rijden."
                            },
                            {
                                "example_id": "4526937b-a343-4f74-bc1a-9df23ae8b2d9",
                                "sense_id": "2b7ce407-a311-3b64-9631-530bce7bc331",
                                "text": "De negen trucks werden dertig trucks en vijftig opleggers. Er kwamen huiftrailers bij, diepladers, semi-diepladers en sinds een tijd ook windmolenvervoer. Nu verzorgt Bolk (uit Almelo)transporten in Frankrijk, Schotland, Italië, Duitsland, met driehonderd man en 150 ‘trekkende’ en 450 ‘getrokken eenheden’."
                            }
                        ]
                    }
