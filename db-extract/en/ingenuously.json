                "senses": [
                    {
                        "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                        "entry_id": "eee24856-de71-376b-932c-3f79bcef5cbe",
                        "glosses": [
                            "In an ingenuous manner; frankly, straightforwardly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c17e8b8-00e7-4739-87aa-ead5975cf2d2",
                                "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                                "text": "Let us ingenuously confesse that only God and Faith hath told it us: for it is no lesson of Nature, nor comming from our reason."
                            },
                            {
                                "example_id": "37c113f5-9ae9-403f-bcec-5acf5dab10e2",
                                "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                                "text": "Yet this in Duty and Modesty I may ingenuously confess, My Royal Husband is oto far seduced, his Ear is too open, his Will too violent, and his Heart too free, to those bewitching Syrens, that make his Errors their Profit and Glory."
                            },
                            {
                                "example_id": "8bc535e2-56de-40e9-bac4-7aefb13e3d2f",
                                "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                                "text": "I must ingenuously acknowledge the chief Motive of my leaving her was the Present of a New-Year's-Gift she made me; but whether French or Neopolitan, I leave to the Determination of the Sons of Galen."
                            }
                        ]
                    }
                ],
