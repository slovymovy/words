                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_dagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>daag</w> hem voor de rechter wegens wanbetaling.",
                            "target_lang_translations": {
                                "en": "I <w>summon</w> him to court for non-payment.",
                                "ru": "Я <w>вызываю</w> его в суд за неуплату.",
                                "pl": "<w>Wzywam</w> go do sądu z powodu niepłacenia należności.",
                                "de": "Ich <w>lade</w> ihn wegen Nichtzahlung vor Gericht <w>vor</w>.",
                                "fr": "Je l'<w>assigne</w> en justice pour non-paiement.",
                                "it": "Lo <w>cito</w> in giudizio per mancato pagamento.",
                                "cs": "<w>Předvolávám</w> ho k soudu kvůli neplacení.",
                                "tr": "Ödeme yapmadığı için onu mahkemeye <w>çağırıyorum</w>.",
                                "es": "Lo <w>cito</w> ante el tribunal por impago.",
                                "zh": "我因他欠款不还而将他<w>传唤</w>至法庭。"
                            }
                        },
                        {
                            "text": "Ik <w>daag</w> je uit om het beter te doen.",
                            "target_lang_translations": {
                                "en": "I <w>challenge</w> you to do better.",
                                "ru": "Я <w>вызываю</w> тебя сделать это лучше.",
                                "pl": "<w>Wyzywam</w> cię, żebyś zrobił to lepiej.",
                                "de": "Ich <w>fordere</w> dich <w>heraus</w>, es besser zu machen.",
                                "fr": "Je te <w>défie</w> de faire mieux.",
                                "it": "Ti <w>sfido</w> a fare di meglio.",
                                "cs": "<w>Vyzývám</w> tě, abys to udělal lépe.",
                                "tr": "Daha iyisini yapman için sana <w>meydan okuyorum</w>.",
                                "es": "Te <w>desafío</w> a que lo hagas mejor.",
                                "zh": "我<w>挑战</w>你做得更好。"
                            }
