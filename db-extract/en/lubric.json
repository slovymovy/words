                    {
                        "sense_id": "19213eef-1f2c-30ab-b8b7-4c00791e3c50",
                        "entry_id": "8d8baaa8-71a4-3c4a-82bf-487ee6b32fcb",
                        "glosses": [
                            "Lascivious; wanton; lewd."
