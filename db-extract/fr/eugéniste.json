        "fr-extract.jsonl": [
            {
                "entry_id": "aa7f05d8-5546-37da-939d-fc0b2849834d",
                "word": "eugéniste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0eb86efd-ba8f-4ec4-8fae-bf954af95e16",
                        "entry_id": "aa7f05d8-5546-37da-939d-fc0b2849834d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "eugénistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                        "entry_id": "aa7f05d8-5546-37da-939d-fc0b2849834d",
                        "glosses": [
                            "Relatif à l’eugénisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99bdd25-fda8-4331-a50d-2af66a4399e2",
                                "sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                                "text": "De fait, l'approche franchement eugéniste de Carrel ne trouvera pas sa place dans les congrès néohippocratiques."
                            },
                            {
                                "example_id": "cdbe3c2c-c074-40e9-b639-c31b673399ef",
                                "sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                                "text": "Fasciné par la politique eugéniste allemande, il se sait associé à tous les parias de l'univers nazi (handicapés, gitans, criminels, opposants politiques et juifs) :[…]."
                            },
                            {
                                "example_id": "0a41fe46-bd59-4738-a1e4-386502692222",
                                "sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                                "text": "Et qu’ont-ils alors vraiment en tête quand ils clament qu’il faut continuer d’y « aller à fond » ? Double pensée ? Pulsion suicidaire ? Cynisme plus ou moins eugéniste (survivra qui pourra) ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a6fd740-9792-4a8f-94c6-7b786edc3381",
                        "source_entry_id": "aa7f05d8-5546-37da-939d-fc0b2849834d",
                        "source_sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                        "target_lang_word": "eugenist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eugenist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38c15264-4dd7-3e8e-aa90-237c6fddc047",
                                        "entry_id": "df3c3490-4a1d-3cf3-a6ba-df0664e36988",
                                        "glosses": [
                                            "An advocate or supporter of eugenics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2eb134f-9eff-4069-9a25-2ce92d01c0b3",
                                                "sense_id": "38c15264-4dd7-3e8e-aa90-237c6fddc047",
                                                "text": "And we have enough of this kind of tyranny already ... the world does not want the eugenist to set it straight...."
                                            },
                                            {
                                                "example_id": "ed4dbb9e-a17d-42c2-927f-4cfc355c0385",
                                                "sense_id": "38c15264-4dd7-3e8e-aa90-237c6fddc047",
                                                "text": "A man who would throw a bomb at the Russian Czar or at a murderous pogrom-inciting Russian Governor would be considered an assassin, and if caught would be hanged; and in making up the pedigree of such a family, a narrow-minded eugenist would be apt to say that there was criminality in that family."
                                            },
                                            {
                                                "example_id": "2ab15acd-9bca-4a9e-9f09-e0df3eb054cb",
                                                "sense_id": "38c15264-4dd7-3e8e-aa90-237c6fddc047",
                                                "text": "When it reported in 1908, it took a strongly hereditarian view of mental deficiency, which was not surprising given that many of its members were paid-up eugenists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4779f0a-6f62-4fa4-9d18-065bc737a0bf",
                        "source_entry_id": "aa7f05d8-5546-37da-939d-fc0b2849834d",
                        "source_sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                        "target_lang_word": "eugenetisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eugenetisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7e274c81-5866-3b4e-98c6-01ed76009e68",
