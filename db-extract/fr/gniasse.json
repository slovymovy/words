                    {
                        "sense_id": "63ded24c-3eae-3df9-9f33-00c26865e37f",
                        "entry_id": "d916bd17-478e-3acf-b6a8-1797cab1103d",
                        "glosses": [
                            "Individu, personne."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ca685d97-0f88-44f6-b21e-a774978bde91",
                                "sense_id": "63ded24c-3eae-3df9-9f33-00c26865e37f",
                                "text": "Ah ! dites ! c’est marrant ! il y a le vieux d’à côté, le gros bonhomme, qui en pince pour mon gniasse [= pour moi] !"
                            },
                            {
                                "example_id": "41104eb9-beb1-4520-b946-ef00477c1d44",
                                "sense_id": "63ded24c-3eae-3df9-9f33-00c26865e37f",
                                "text": "Des gniasses pareils, c’est des pauvres types qu’un jour ou l’autre, tu retrouves, en douce, prêts à te faire tomber."
                            },
                            {
                                "example_id": "1f09e2b8-880b-40ef-9bb8-fd8b956f2d55",
                                "sense_id": "63ded24c-3eae-3df9-9f33-00c26865e37f",
                                "text": "Certaines apparaissent aux trois personnes : mézigue, tézigue, cézigue, cézig, sézig, ou sézigue, mon (ton, son) gniasse (gnasse)."
                            }
                        ]
                    }
