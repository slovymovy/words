                "senses": [
                    {
                        "sense_id": "7c47b264-6e90-3e01-8bd4-158f6b96aff6",
                        "entry_id": "63ff880a-26c7-3fda-9b20-2d5de05299ea",
                        "glosses": [
                            "Cellule précurseuse d’un myélocyte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543e16cd-8735-4c13-957f-11af2a1e4b92",
                                "sense_id": "7c47b264-6e90-3e01-8bd4-158f6b96aff6",
                                "text": "Le granulocyte neutrophile provient de la maturation d'un myéloblaste, lors d'une maturation qui dure 3 jours."
                            },
                            {
                                "example_id": "5c98fe0d-dd02-4437-a5da-3c9cf5b57f2d",
                                "sense_id": "7c47b264-6e90-3e01-8bd4-158f6b96aff6",
                                "text": "Les myéloblastes proviennent des hémocytoblastes eux même provenant d’une cellule souche hématopoïétique."
                            },
                            {
                                "example_id": "35f50f6b-3ccd-4cb3-91a2-b2a2b838783b",
                                "sense_id": "7c47b264-6e90-3e01-8bd4-158f6b96aff6",
                                "text": "Les cellules orientées vers la lignée granulocytaire sont dans l’ordre de maturation : le myéloblaste, le promyélocyte, le métamyélocyte, le granulocyte non segmenté et le granulocyte ou polynucléaire mature."
                            }
                        ]
                    }
                ],
