                            {
                                "example_id": "c10d846c-a0c6-4175-b67b-30e4d083c9e5",
                                "sense_id": "ccaa020b-3e9a-3883-b144-056b0ec70710",
                                "text": "The storm broke on June 27, when the space agency disclosed that its multi-billion-dollar Hubble Space telescope, launched amid much hoopla in April, can't see straight thanks to a misground mirror."
                            },
                            {
                                "example_id": "d2e647a3-cf09-48cd-83da-5b29d11fb412",
                                "sense_id": "ccaa020b-3e9a-3883-b144-056b0ec70710",
                                "text": "According to Riordan the matter was subsequently resolved by returning the misground or unground products back to the grinders."
                            },
                            {
                                "example_id": "73bc3b98-7ced-478d-b114-9c0bd27a38fc",
                                "sense_id": "ccaa020b-3e9a-3883-b144-056b0ec70710",
                                "text": "It is like claiming that the misground Hubble mirror with its correcting lenses is the “best possible design” because it gives clear pictures."
                            }
                        ]
                    }
