                        "glosses": [
                            "Of or relating to Achaea or the Achaeans."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d8472e07-7e36-3c1d-b233-b6e17d5676dc",
                        "entry_id": "ec3cfc80-4f40-3107-ad7f-8d29a89f25fc",
                        "glosses": [
                            "In Homeric usage, of or relating to Greece, especially of the Mycenaean era."
                        ],
                        "tags": [
                            "broadly",
