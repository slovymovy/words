                    {
                        "sense_id": "c48fd9b8-4351-320a-ae0d-129c2907eab4",
                        "entry_id": "a5841cd9-9b43-3d3d-b374-3bf569b45578",
                        "glosses": [
                            "характеристика минерала, описывающая вид поверхности, образующийся при расколе минерала"
                        ],
                        "tags": [],
