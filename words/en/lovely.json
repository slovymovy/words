                            },
                            {
                                "target_lang_word": "чудесный",
                                "target_lang_sense_clarification": "вызывающий восхищение"
                            },
                            {
                                "target_lang_word": "прекрасный",
                                "target_lang_sense_clarification": "очень красивый, превосходный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美丽",
                                "target_lang_sense_clarification": "形容外表好看"
                            },
                            {
                                "target_lang_word": "美好",
                                "target_lang_sense_clarification": "形容事物令人愉悦"
                            }
                        ]
