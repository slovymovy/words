                "senses": [
                    {
                        "sense_id": "849f1c0a-9804-3202-9e45-1c8e24b54306",
                        "entry_id": "695b2bcd-77d4-3bdc-b17f-65be9585df1e",
                        "glosses": [
                            "Ramphastos Linnaeus, barwny ptak południowoamerykański o dużym dziobie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93432f89-4971-49f1-8cf1-d9fc04d1ae43",
                                "sense_id": "849f1c0a-9804-3202-9e45-1c8e24b54306",
                                "text": "Nad głowami małych podróżników przelatywały ciągle z jednego brzegu parowu na drugi tukany o purpurowych głowach, niebieskich piersiach i żółtych skrzydłach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4524184f-b2c6-4233-bf8a-0e8383274a9e",
                        "source_entry_id": "695b2bcd-77d4-3bdc-b17f-65be9585df1e",
                        "source_sense_id": "849f1c0a-9804-3202-9e45-1c8e24b54306",
                        "target_lang_word": "toucan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toucan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56326dd8-92d0-3fd5-b4a2-1200b4bf50ce",
                                        "entry_id": "2d72b1df-2574-3636-af7d-376cab276d26",
                                        "glosses": [
                                            "Any of various neotropical frugivorous birds from the family Ramphastidae, with a large colorful beak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc851724-8cce-462c-bcc2-5d4fd4c39cc3",
                                                "sense_id": "56326dd8-92d0-3fd5-b4a2-1200b4bf50ce",
                                                "text": "The ear, small and shapely, the arch of the foot, the curve in mouth and nostril, even the indurated hand dyed to the orange-tawny of the toucan's bill, a hand telling alike of the halyards and tar-bucket;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1589d302-db2c-486f-b8bc-c4fb3337fe86",
                        "source_entry_id": "695b2bcd-77d4-3bdc-b17f-65be9585df1e",
                        "source_sense_id": "849f1c0a-9804-3202-9e45-1c8e24b54306",
                        "target_lang_word": "tukan",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tukan",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c2745e31-2f99-36fe-8bfb-79c552a0c571",
                                        "entry_id": "5cd03f37-6ed4-3e48-a627-b92d6ae99005",
                                        "glosses": [
                                            "rod ptáků s dlouhým, mohutným a barevným zobákem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c774854-0fcb-4c8b-b884-174741ce4a38",
                                                "sense_id": "c2745e31-2f99-36fe-8bfb-79c552a0c571",
                                                "text": "Drží-li se peří takové proti světlu, vypadá jinak nežli ve světle odraženém. Příčina leží v jemné tkani mikroskopicky malých buněk, jejichž stěny jsou nesmírně jemně ryhovány (arara, trupial, tukan a j.)."
                                            },
                                            {
                                                "example_id": "2f4760b1-274d-4929-9b83-b84b1fafa55f",
                                                "sense_id": "c2745e31-2f99-36fe-8bfb-79c552a0c571",
                                                "text": "Ještě den před narozeninami Karin jsem běhal po Mnichově a žebral o osvícení. Až jsem se ocitl v jednom vetešnictví nedaleko Marienplatzu. Nemáte něco neobyčejného, co bych mohl darovat ženě z Dolního Bavorska k narozeninám? zeptal jsem se majitele. Beze slov přede mne postavil tukana z porcelánu. Toho ptáka se žlutým zobákem, který je větší než sám pták. Mám čtyři, řekl. Zvedl významně obočí a nechal vypochodovat tři další porcelánové tukany. Každý tukan házel jinou pózu, ale jinak byli stejně velcí a zbarvení. Koupil jsem všechny. Mohl jsem Karin přepadnout se čtyřmi tukany..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb987d58-8cc1-4426-8f3e-db6ad98f6ee6",
                        "source_entry_id": "695b2bcd-77d4-3bdc-b17f-65be9585df1e",
                        "source_sense_id": "849f1c0a-9804-3202-9e45-1c8e24b54306",
                        "target_lang_word": "toucan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toucan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6814c530-12d8-3b28-b479-84e9334687a1",
                                        "entry_id": "37ee6e86-5eec-31fe-9aa6-b8b275eabb59",
                                        "glosses": [
                                            "Nom donné à deux genres et 12 espèces d'oiseaux arboricoles grimpeurs de la taille d'une corneille, de la famille des ramphastidés (ordre des piciformes), caractérisés par leur bec très gros et très long, souvent orné de patrons complexes de couleurs vives, à diète en majeure partie frugivore, et qui habitent les forêts primaires tropicales de l'écozone néotropicale continentale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9cc7fd3-5d3d-4c84-b323-30c9d624c413",
                                                "sense_id": "6814c530-12d8-3b28-b479-84e9334687a1",
                                                "text": "Il y a des toucans dont le bec est plus long que le corps entier."
                                            },
                                            {
                                                "example_id": "3c2d8f5d-75f8-44c8-90d7-9a228b977f6a",
                                                "sense_id": "6814c530-12d8-3b28-b479-84e9334687a1",
                                                "text": "Plus au sud, en haute Amazonie, les Jivaros Achuar réservent une place de choix à un autre oiseau encore, le toucan."
                                            },
                                            {
                                                "example_id": "e21aed02-5cd9-4855-8817-316247423221",
                                                "sense_id": "6814c530-12d8-3b28-b479-84e9334687a1",
                                                "text": "La découverte du fossile d'une créature ressemblant à un « toucan avec des dents de lapin » ayant vécu il y a 68 millions d'années illustre la diversité des espèces d'oiseaux contemporains des dinosaures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67b9a6cc-7829-4761-9144-28aeb51396a4",
                        "source_entry_id": "695b2bcd-77d4-3bdc-b17f-65be9585df1e",
                        "source_sense_id": "849f1c0a-9804-3202-9e45-1c8e24b54306",
