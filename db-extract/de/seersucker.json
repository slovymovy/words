                                        "sense_id": "997668e5-1c67-3098-96bf-38025afcf052",
                                        "entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                                        "glosses": [
                                            "A thin, all-cotton fabric, commonly striped, used to make clothing for summer wear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd675f4d-1342-4466-ab4f-fdcb7eca288c",
                                                "sense_id": "997668e5-1c67-3098-96bf-38025afcf052",
                                                "text": "I saw merely a lank, commonplace, and simple-looking farmer, going about his chores in faded blue overalls, a seersucker shirt, and a straw hat of the kind that is called a \"cow's breakfast.\""
                                            }
                                        ]
                                    },
                                    {
