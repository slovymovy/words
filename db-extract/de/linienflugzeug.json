                "senses": [
                    {
                        "sense_id": "baa6ad39-570b-3c7d-ac9c-77865c5fcc2d",
                        "entry_id": "0a327b98-a028-3be5-88a3-46b7c4286c32",
                        "glosses": [
                            "Flugzeug, das im Linienverkehr eingesetzt wird"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "0c78a153-fd6b-4d72-bc73-c755ad39376c",
                                "sense_id": "baa6ad39-570b-3c7d-ac9c-77865c5fcc2d",
                                "text": "„Das Linienflugzeug mit 298 Menschen an Bord war vergangenen Donnerstag in einem von prorussischen Separatisten kontrollierten Gebiet der Unruheregion Donezk abgestürzt.“"
                            },
                            {
                                "example_id": "4541f5ef-16cd-46bd-8b5b-089c1f9b627b",
                                "sense_id": "baa6ad39-570b-3c7d-ac9c-77865c5fcc2d",
                                "text": "„Ohne die entsprechenden Dokumente können sie kein Linienflugzeug und keine offizielle Fähre benutzen.“"
                            },
                            {
                                "example_id": "f4107883-535c-4213-ab0f-8874cea47af6",
                                "sense_id": "baa6ad39-570b-3c7d-ac9c-77865c5fcc2d",
                                "text": "„1978 kaperte ein DDR-Bürger ein polnisches Linienflugzeug und erzwang eine Landung in West-Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
