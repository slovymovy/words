                                                "example_id": "244d3727-dc9a-427e-b651-a26c10b5b5bb",
                                                "sense_id": "e6969dd4-de78-3b2a-89aa-445a39bfade1",
                                                "text": "The sidewalk needed a sweeping every morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e07bdbc-6d41-3cd7-ae9d-00b0f9ed199c",
                                        "entry_id": "2f202a1e-b161-342e-a54f-7f87a18c0303",
                                        "glosses": [
                                            "The activity of sweeping."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab0fe97-a109-4d1b-9b82-5ee29a2c3cb3",
                                                "sense_id": "9e07bdbc-6d41-3cd7-ae9d-00b0f9ed199c",
                                                "text": "Sweeping took all morning."
                                            },
                                            {
                                                "example_id": "dcf53ecc-1be9-4cc6-8553-cad0649e10fe",
                                                "sense_id": "9e07bdbc-6d41-3cd7-ae9d-00b0f9ed199c",
                                                "text": "The sidewalk needed sweeping every morning."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sweeping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9020ad1f-1152-33a2-840b-221afe222121",
                                        "entry_id": "9dd06443-1cb9-3054-9971-8d16e4c5586d",
                                        "glosses": [
                                            "Wide, broad, affecting or touching upon many things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94be8780-4f0b-456e-82e9-a2f69d06eab2",
                                                "sense_id": "9020ad1f-1152-33a2-840b-221afe222121",
                                                "text": "The government will bring in sweeping changes to the income tax system."
                                            },
                                            {
                                                "example_id": "1b1472f2-0f06-4283-87c3-3d44fb319e93",
                                                "sense_id": "9020ad1f-1152-33a2-840b-221afe222121",
                                                "text": "He loves making sweeping statements without the slightest evidence."
                                            },
                                            {
                                                "example_id": "5cfeecd5-3ec4-4283-8628-41e031a3e0be",
                                                "sense_id": "9020ad1f-1152-33a2-840b-221afe222121",
                                                "text": "We steamed easily across the first part of the Tay Bridge, and then after passing over the long spans in mid-stream we coasted smoothly down the 1 in 114 gradient, and around the sweeping curve through Esplanade Station."
                                            },
                                            {
                                                "example_id": "14d8d4ea-f12c-404b-bc3b-dc91aa012d0e",
                                                "sense_id": "9020ad1f-1152-33a2-840b-221afe222121",
                                                "text": "By the time politicians in several cities backed down on Tuesday and announced that they would cut or consider reducing fares, the demonstrations had already morphed into a more sweeping social protest, with marchers waving banners carrying slogans like “The people have awakened.”"
                                            },
                                            {
                                                "example_id": "0542acfc-0cc8-47bf-947a-a147de41882c",
                                                "sense_id": "9020ad1f-1152-33a2-840b-221afe222121",
                                                "text": "The thing is, we've even had formal confirmation from Government itself that the crucial research required to make such sweeping claims hasn't been done!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e44853-5dd1-355d-a521-1e6bacc1d2fd",
                                        "entry_id": "9dd06443-1cb9-3054-9971-8d16e4c5586d",
                                        "glosses": [
                                            "Completely overwhelming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f7053f4-bba9-4a6b-9cee-aa4310000e30",
                                                "sense_id": "73e44853-5dd1-355d-a521-1e6bacc1d2fd",
                                                "text": "He claimed a sweeping victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c237fc-1f2d-3ff2-84f6-7519ffa74f02",
                                        "entry_id": "9dd06443-1cb9-3054-9971-8d16e4c5586d",
                                        "glosses": [
                                            "Moving in a continuous motion, rather than by intermittent jumps. (For example, the second hand on a clock face may move either in the sweeping manner or in the ticking manner.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
