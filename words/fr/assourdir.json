            "senses": [
                {
                    "sense_id": "8452e7d2-e309-3e2f-8b5d-fbafe434e72d",
                    "sense_definition": "Rendre temporairement sourd ou étourdi par un bruit trop violent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vacarme des moteurs d'avion <w>assourdit</w> les ouvriers qui travaillent sur la piste."
                        },
                        {
                            "text": "Le tir d'artillerie était si puissant qu'il a fini par <w>assourdir</w> toute la garnison."
                        }
                    ],
                    "synonyms": [
                        "rendre sourd"
                    ],
                    "common_phrases": [
                        "à vous assourdir"
                    ]
                },
                {
                    "sense_id": "47dc72e4-1bb1-316e-b7a8-f022d4db8e2e",
                    "sense_definition": "Rendre un son moins intense, en atténuer la résonance ou la portée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet épais rideau permet d'<w>assourdir</w> les bruits provenant de la rue passante."
                        },
                        {
                            "text": "Ils marchaient avec précaution sur le tapis pour <w>assourdir</w> leurs pas."
                        }
                    ],
                    "common_phrases": [
                        "assourdir le bruit",
                        "assourdir les pas"
                    ]
                },
                {
                    "sense_id": "63324cb0-0831-3937-a99c-c83740248803",
                    "sense_definition": "Diminuer l'éclat, le contraste ou la vivacité des teintes en peinture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a choisi d'<w>assourdir</w> les couleurs pour évoquer la brume automnale."
                        },
                        {
                            "text": "Le temps a fini par <w>assourdir</w> les tons vifs de cette fresque murale."
                        }
                    ],
                    "common_phrases": [
                        "teinte assourdie"
