                ],
                "senses": [
                    {
                        "sense_id": "7d974be1-87ff-3ada-b3d6-24f3c1fe6550",
                        "entry_id": "d319eb60-be42-3291-99bd-45deca24339e",
                        "glosses": [
                            "Qui aime à contrarier, en parlant d'une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c58c83b-f0a5-4c26-9d7b-c43a7c60ffca",
                                "sense_id": "7d974be1-87ff-3ada-b3d6-24f3c1fe6550",
                                "text": "Vous êtes bien contrariant, bien contrariante. - Esprit contrariant. - Humeur contrariante."
                            },
                            {
                                "example_id": "43977e89-60b2-4560-930e-5dbb551640c8",
                                "sense_id": "7d974be1-87ff-3ada-b3d6-24f3c1fe6550",
                                "text": "Tante Aline n’était ni curieuse, ni contrariante, elle ne posait pas de questions : « Pourquoi as-tu les yeux rouges ? Pourquoi ne manges-tu pas ? »"
                            }
                        ]
                    },
                    {
                        "sense_id": "e50eb3ac-7450-3d2a-b7d9-048d39c3eab6",
                        "entry_id": "d319eb60-be42-3291-99bd-45deca24339e",
                        "glosses": [
                            "Qui est de nature à contrarier, en parlant d'une chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e75e574-0a33-4898-a006-03794351cf75",
                                "sense_id": "e50eb3ac-7450-3d2a-b7d9-048d39c3eab6",
                                "text": "Cela est bien contrariant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ff950e0-1c2d-4073-aa80-e7d4741bf80b",
                        "source_entry_id": "d319eb60-be42-3291-99bd-45deca24339e",
                        "target_lang_word": "contrary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "525fa2af-0153-3893-a3d5-64baf4202da3",
                                        "entry_id": "8e5d5a90-6369-3f55-ab63-cca29ccb8b3d",
                                        "glosses": [
                                            "Opposite; in an opposite direction; in opposition; adverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e51371-c3e2-4882-b49c-b66fa34e0c7f",
                                                "sense_id": "525fa2af-0153-3893-a3d5-64baf4202da3",
                                                "text": "contrary winds"
                                            },
                                            {
                                                "example_id": "8a16a530-a66c-4c35-a2ab-72aa9411cdca",
                                                "sense_id": "525fa2af-0153-3893-a3d5-64baf4202da3",
                                                "text": "And if ye walk contrary unto me, and will not hearken unto me[…]"
                                            },
                                            {
                                                "example_id": "998ba91e-617e-420a-96da-ac709ed10031",
                                                "sense_id": "525fa2af-0153-3893-a3d5-64baf4202da3",
                                                "text": "We have lost our labour; they are gone a contrary way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cce07c8-41e3-3562-b131-0bda49aa3fb5",
                                        "entry_id": "8e5d5a90-6369-3f55-ab63-cca29ccb8b3d",
                                        "glosses": [
                                            "Opposed; contradictory; inconsistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9fa3b3-8524-402e-8afc-f7e6c0c19e33",
                                                "sense_id": "1cce07c8-41e3-3562-b131-0bda49aa3fb5",
                                                "text": "Galileo [Galilei]'s zeal for his opinions soon led him again to bring the question under the notice of the Pope, and the result was a declaration of the Inquisition that the doctrine of the earth's motion appeared to be contrary to the sacred scripture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99c5b2e-5220-338e-9ed6-69da1a4ea16d",
                                        "entry_id": "8e5d5a90-6369-3f55-ab63-cca29ccb8b3d",
                                        "glosses": [
                                            "Given to opposition; perverse; wayward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "001c03de-5d40-48c3-b00b-ebcede8c2d5a",
                                                "sense_id": "b99c5b2e-5220-338e-9ed6-69da1a4ea16d",
                                                "text": "a contrary disposition; a contrary child"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contrary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00179265-4e04-349a-be86-7c97b5c36fbe",
                                        "entry_id": "f38ae9e5-6943-367d-8d9f-a1a746ce28ad",
                                        "glosses": [
                                            "Contrarily"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4266ebd-dbda-432f-8b56-fe7fe4402405",
                                                "sense_id": "00179265-4e04-349a-be86-7c97b5c36fbe",
                                                "text": "I never act contrary to my principles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contrary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02a4ade8-c23c-3c21-927e-13df3fa393d5",
                                        "entry_id": "808f7c18-e895-3b1c-a475-e8cf33a71625",
                                        "glosses": [
                                            "The opposite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3c89e56-2e73-45f7-81a3-c9a9d1ba6ce8",
                                                "sense_id": "02a4ade8-c23c-3c21-927e-13df3fa393d5",
                                                "text": "No contraries hold more antipathy\nThan I and such a knave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e36548-977f-3143-9b7b-fa9aafc17c2f",
                                        "entry_id": "808f7c18-e895-3b1c-a475-e8cf33a71625",
                                        "glosses": [
                                            "One of a pair of propositions that cannot both be simultaneously true, though they may both be false."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c2d5f9-c136-4c96-ae05-c49b8c2c978c",
                                                "sense_id": "d9e36548-977f-3143-9b7b-fa9aafc17c2f",
                                                "text": "If two universals differ in quality, they are contraries; as, every vine is a tree; no vine is a tree. These can never be both true together; but they may be both false."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9bf8921-ed82-38a6-ab20-ad8076d113f5",
                                        "entry_id": "808f7c18-e895-3b1c-a475-e8cf33a71625",
                                        "glosses": [
                                            "A type of loaded die."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "contrary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d548b12-7396-3517-b489-b8116dfce41f",
                                        "entry_id": "d6c5bb2c-37fc-38c2-8344-6c05f09e1aa2",
                                        "glosses": [
                                            "To oppose; to frustrate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638c9d86-6151-4318-9809-819e1f43d4e2",
                                                "sense_id": "5d548b12-7396-3517-b489-b8116dfce41f",
                                                "text": "You that be of the court, & eſpecially ye ſworn chaplains beware of a leſſon that a great man taught me at my firſt coming to the court he told me for a good will, he thoughte it wel. He ſayd vnto me. You muſt beware how ſo euer ye do that ye cõtrary not the king, let him haue his ſaiyngs, folow him, go with him. Mary out vpon this counſel, ſhal I ſay, as he ſayes?"
                                            },
                                            {
                                                "example_id": "40a3df44-a5c0-41b9-8cc4-1736fd811a70",
                                                "sense_id": "5d548b12-7396-3517-b489-b8116dfce41f",
                                                "text": "The Athenians having left the enemie in their owne land, for to pass into Sicilie, had very ill successe, and were much contraried by fortune[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9f922c-239a-3ce6-b744-b85ea9ca99ab",
                                        "entry_id": "d6c5bb2c-37fc-38c2-8344-6c05f09e1aa2",
                                        "glosses": [
                                            "To impugn."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a442438-646c-354b-a59b-d181c6119d38",
                                        "entry_id": "d6c5bb2c-37fc-38c2-8344-6c05f09e1aa2",
                                        "glosses": [
                                            "To contradict (someone or something)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df0f09dc-01bd-44e6-8fe2-78fef63d25c8",
                                                "sense_id": "2a442438-646c-354b-a59b-d181c6119d38",
                                                "text": "thus wilfully sir Palomydes dyd bataille with yow\n& as for hym sir I was not gretely aferd but I dred fore laūcelot that knew yow not\nMadame said Palomydes ye maye saye what so ye wyll\nI maye not contrary yow but by my knyghthode I knewe not sir Tristram"
                                            },
                                            {
                                                "example_id": "3611e3a0-6318-43d6-aef5-c69e691e28e9",
                                                "sense_id": "2a442438-646c-354b-a59b-d181c6119d38",
                                                "text": "I finde them everie one in his turne to have reason, although they contrary one another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3cae260-a893-310d-9597-494a83e63eb9",
                                        "entry_id": "d6c5bb2c-37fc-38c2-8344-6c05f09e1aa2",
                                        "glosses": [
                                            "To do the opposite of (someone or something)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "369b0ba7-6272-3002-a756-cc01a7af68e4",
                                        "entry_id": "d6c5bb2c-37fc-38c2-8344-6c05f09e1aa2",
                                        "glosses": [
                                            "To act inconsistently or perversely; to act in opposition to."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "176cafb8-aceb-310c-964a-952d8c2cbe63",
                                        "entry_id": "d6c5bb2c-37fc-38c2-8344-6c05f09e1aa2",
                                        "glosses": [
                                            "To argue; to debate; to uphold an opposite opinion."
