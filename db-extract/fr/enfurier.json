                ],
                "senses": [
                    {
                        "sense_id": "85d2e57a-74d4-3c9f-9bb5-7df71de93ecc",
                        "entry_id": "60108526-c348-3635-a20c-0ffc9cbb2856",
                        "glosses": [
                            "Mettre en furie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990a0dcc-e630-4e5f-81b4-756ae02e163e",
                                "sense_id": "85d2e57a-74d4-3c9f-9bb5-7df71de93ecc",
                                "text": "Il n’était pas difficile d’imaginer qu’un tel effort, pour égaliser, dans l’injustice, les deux partis tous deux sous la pesée de l’inéluctable nécessité, ne satisferait aucun des deux, mais achèverait de les « enfurier », en retournant leur furie contre l’auteur."
                            },
                            {
                                "example_id": "71a902c7-a4c5-4e1b-8a8a-5820b82be114",
                                "sense_id": "85d2e57a-74d4-3c9f-9bb5-7df71de93ecc",
                                "text": "Qu’il en soit à s’enfurier pour un coq ? en plein complot, en butte aux fripouillards, un cadavre sur les reins, consommer son peu de force pour un petit coq de rien !"
                            }
                        ]
                    }
                ],
