                        "examples": [
                            {
                                "example_id": "595e1ef6-00b2-4c32-863c-fa8ef1ada9e1",
                                "sense_id": "bd1a8d84-a820-36ef-87cd-14f489cf7536",
                                "text": "Ontelbare keren moest Pan in het verleden naar de Chinese toko om nieuwe houten stelen te halen. \"Het probleem is dan ook nog dat die stelen te dik zijn. Met een mesje moet je er wat afkerven om de steel in de pan te krijgen en die vervolgens vast zetten met een zelftappertje.\""
                            }
                        ]
