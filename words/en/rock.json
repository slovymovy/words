    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9f56b84-00a7-3f45-8ea3-684a81f5cbab",
                    "sense_definition": "The naturally occurring aggregate of solid mineral matter that constitutes a significant part of the earth's crust.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The face of the cliff is solid <w>rock</w>.",
                            "target_lang_translations": {
                                "ru": "Склон утеса — это сплошная <w>порода</w>."
                            }
                        },
                        {
                            "text": "The park features strange and beautiful <w>rock</w> formations carved by the river over millions of years.",
                            "target_lang_translations": {
                                "ru": "В парке представлены странные и красивые <w>скальные</w> образования, выточенные рекой за миллионы лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "stone"
                    ],
                    "common_phrases": [
                        "solid rock",
                        "rock formation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природная совокупность твердых минеральных веществ, составляющая значительную часть земной коры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порода",
                                "target_lang_sense_clarification": "геологический термин"
                            },
                            {
                                "target_lang_word": "камень",
                                "target_lang_sense_clarification": "как материал или масса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef963385-43ba-3037-b301-f1d28204b7be",
                    "sense_definition": "A boulder or large stone; or a smaller stone or pebble.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some fool has thrown a <w>rock</w> through my window.",
                            "target_lang_translations": {
                                "ru": "Какой-то дурак бросил <w>камень</w> в мое окно."
                            }
                        },
                        {
                            "text": "The children spent the afternoon throwing <w>rocks</w> into the lake.",
                            "target_lang_translations": {
                                "ru": "Дети провели весь день, бросая <w>камни</w> в озеро."
                            }
                        }
                    ],
                    "synonyms": [
                        "stone",
                        "boulder",
                        "pebble"
                    ],
                    "common_phrases": [
                        "throw a rock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Валун или большой камень; либо камень меньшего размера или галька."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "камень",
                                "target_lang_sense_clarification": "отдельный кусок породы"
                            },
                            {
                                "target_lang_word": "валун",
                                "target_lang_sense_clarification": "крупный обломок породы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5be6d5d9-2b71-37c8-9ba2-d7d9b4ea42b7",
                    "sense_definition": "A style of music characterized by basic drum-beat, generally 4/4 riffs, based on electric guitar, bass, and drums.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love listening to classic <w>rock</w> while I am driving my car.",
                            "target_lang_translations": {
                                "ru": "Я обожаю слушать классический <w>рок</w>, когда нахожусь за рулем."
                            }
                        },
                        {
                            "text": "The band played a mix of <w>rock</w> and roll and blues music.",
                            "target_lang_translations": {
                                "ru": "Группа играла смесь <w>рок</w>-н-ролла и блюза."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock music",
                        "rock and roll"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный стиль, характеризующийся базовым барабанным ритмом, обычно в размере 4/4, основанный на электрогитаре, басу и барабанах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рок",
                                "target_lang_sense_clarification": "музыкальный жанр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c2ee40-a752-3425-a68f-280d578474c9",
                    "sense_definition": "Something that is strong, stable, and dependable; a person who provides security or support to another.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mother has always been my <w>rock</w> during difficult times.",
                            "target_lang_translations": {
                                "ru": "Моя мать всегда была моей <w>опорой</w> в трудные времена."
                            }
                        },
                        {
                            "text": "She is my <w>rock</w> and my right hand in this business.",
                            "target_lang_translations": {
                                "ru": "Она — мой <w>фундамент</w> и моя правая рука в этом бизнесе."
                            }
                        }
                    ],
                    "synonyms": [
                        "foundation",
                        "support",
                        "pillar",
                        "anchor"
                    ],
                    "common_phrases": [
                        "be someone's rock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то крепкое, стабильное и надежное; человек, обеспечивающий безопасность или поддержку другому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опора",
                                "target_lang_sense_clarification": "человек или вещь, дающая поддержку"
                            },
                            {
                                "target_lang_word": "фундамент",
                                "target_lang_sense_clarification": "основа чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77135d91-9851-313b-80e5-01bc0d8c83ee",
                    "sense_definition": "A lump or cube of ice.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'll have a whisky on the <w>rocks</w>, please.",
                            "target_lang_translations": {
                                "ru": "Мне виски <w>со льдом</w>, пожалуйста."
                            }
                        },
                        {
                            "text": "He poured the drink over a few <w>rocks</w> to keep it cold.",
                            "target_lang_translations": {
                                "ru": "Он налил напиток поверх нескольких <w>кубиков льда</w>, чтобы он оставался холодным."
                            }
                        }
                    ],
                    "synonyms": [
                        "ice",
                        "ice cube"
                    ],
                    "common_phrases": [
                        "on the rocks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the context of drinks"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусочек или кубик льда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со льдом",
                                "target_lang_sense_clarification": "о напитке"
                            },
                            {
                                "target_lang_word": "лед",
                                "target_lang_sense_clarification": "кубики льда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eba59b58-402c-3a03-8dd8-bc7ebaee967f",
                    "sense_definition": "A precious stone or gem, especially a diamond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Look at the size of that <w>rock</w> on her finger!",
                            "target_lang_translations": {
                                "ru": "Посмотри на размер этого <w>камня</w> у нее на пальце!"
                            }
                        },
                        {
                            "text": "She shared a photo of a gigantic <w>rock</w> on her engagement ring.",
                            "target_lang_translations": {
                                "ru": "Она поделилась фотографией гигантского <w>бриллианта</w> на своем помолвочном кольце."
                            }
                        }
                    ],
                    "synonyms": [
                        "gem",
                        "diamond"
                    ],
                    "common_phrases": [
                        "big rock"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for jewelry"
                        }
