                ],
                "senses": [
                    {
                        "sense_id": "f2355161-c294-3046-aa71-234c702f3b3c",
                        "entry_id": "49061ecd-6ff4-36a3-9ed6-5d5dbb348583",
                        "glosses": [
                            "vorgesehener Fluiddruck in einem technischen System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c63f581-789b-47b2-8dd4-0d52b91f3d71",
                                "sense_id": "f2355161-c294-3046-aa71-234c702f3b3c",
                                "text": "„Der hohe Arbeitsdruck des Dieselmotors wirkt sich als starke Hitzequelle aus (adiabatische Zustandsänderung), so dass die Stickstoffoxidproduktion, verglichen mit einem Otto-Motor, sehr groß ist.“"
                            },
                            {
                                "example_id": "e177827b-5cf9-481f-935e-4bcaffbcddf0",
                                "sense_id": "f2355161-c294-3046-aa71-234c702f3b3c",
                                "text": "Die Arbeitsdrücke der hydrostatischen Übertragungen haben seit 1935 ständig zugenommen."
                            },
                            {
                                "example_id": "3a2ca3f1-2512-41a9-beed-9b8d99783521",
                                "sense_id": "f2355161-c294-3046-aa71-234c702f3b3c",
                                "text": "Je höher der Arbeitsdruck, um so sorgfältiger müssen alle Verbindungen gedichtet sein, insbesondere die des Preßkolbens und der Pumpe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f22c9911-5a3b-3ccc-8d24-fa559f32752a",
                        "entry_id": "49061ecd-6ff4-36a3-9ed6-5d5dbb348583",
                        "glosses": [
                            "seelische Belastung, die durch Bedingungen am Arbeitsplatz ausgelöst wird"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "84ee9f87-ee6c-43eb-8bde-461e69c019ab",
                                "sense_id": "f22c9911-5a3b-3ccc-8d24-fa559f32752a",
                                "text": "Steigender Arbeitsdruck und Arbeitsstress wirken sich dagegen negativ auf die Motivation aus."
                            },
                            {
                                "example_id": "274c362a-8fad-4edc-b183-660cbc2fa5e4",
                                "sense_id": "f22c9911-5a3b-3ccc-8d24-fa559f32752a",
                                "text": "Der Arbeitsdruck ist gestiegen, und wir fühlen uns gegenüber Kunden verantwortlich für das Erreichen geforderter Arbeitsergebnisse."
                            },
                            {
                                "example_id": "e533b0ee-294f-4138-bc48-7ff0100b71d7",
                                "sense_id": "f22c9911-5a3b-3ccc-8d24-fa559f32752a",
                                "text": "Arbeitsdruck und Hetze kann physiologisch durch verschiedene Parameter wie kardiovaskuläre Aktivierung oder Kortisolspiegelerhöhungen verobjektiviert werden."
                            },
                            {
                                "example_id": "fbe770d0-5fb6-4658-bcc8-54d856cc03b7",
                                "sense_id": "f22c9911-5a3b-3ccc-8d24-fa559f32752a",
                                "text": "Wo Arbeitsdruck eine übergroße Belastung ausübt, wächst das Bedürfnis nach Spannungsausgleich und Regeneration."
                            },
                            {
                                "example_id": "7ee232ae-e426-472e-92ec-f0c49b62c2ca",
                                "sense_id": "f22c9911-5a3b-3ccc-8d24-fa559f32752a",
                                "text": "Der Index „Arbeitsdruck“ beinhaltet zum einen die Variable „Der Konkurrenzdruck in meiner Firma/Einrichtung belastet mich und zum anderen die Variable „Fühlen Sie sich durch ihre(n) Vorgesetzte(n) unter Druck gesetzt?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
