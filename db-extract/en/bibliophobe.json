                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b72612be-6d72-410c-b42d-5e84f2137319",
                        "entry_id": "93e28e5e-1de0-3c36-8c1f-feca306814be",
                        "tags": [
                            "plural"
                        ],
                        "form": "bibliophobes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a899d85-6827-3275-a99d-0e051ca246cc",
                        "entry_id": "93e28e5e-1de0-3c36-8c1f-feca306814be",
                        "glosses": [
                            "One who fears and hates books, book-learning or reading."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28707efc-6fac-47a9-b904-699bd4fd76a1",
                                "sense_id": "3a899d85-6827-3275-a99d-0e051ca246cc",
                                "text": "Now, the author of this book is probably the world's greatest bibliophobe, having ordered the burning of many books and having again and again placed himself on record against intellectuals including writers."
                            },
                            {
                                "example_id": "06085a06-34d8-4c2e-8113-4409e5ed84d3",
                                "sense_id": "3a899d85-6827-3275-a99d-0e051ca246cc",
                                "text": "Wordsworth’s genius is fully honoured, but he is also the proud bibliophobe - sacrilegiously cutting open precious pages with a used butter-knife on the kitchen table - as well as the supremely competent manager of his own interests."
                            },
                            {
                                "example_id": "2790831f-d1af-40a5-90e4-843c6145a88d",
                                "sense_id": "3a899d85-6827-3275-a99d-0e051ca246cc",
                                "text": "The bibliophobe, therefore, becomes a problem for bookmen only when he is active, as I shall now proceed to show."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "734a32aa-366f-447f-8393-3a82a78acc0b",
                        "source_entry_id": "93e28e5e-1de0-3c36-8c1f-feca306814be",
                        "source_sense_id": "3a899d85-6827-3275-a99d-0e051ca246cc",
                        "source_sense_description": "person who fears/hates books",
                        "target_lang_word": "bibliophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecac79a0-7e9b-3336-9416-d8b785b23768",
                                        "entry_id": "21616d5b-2f95-3f2d-8767-4d7c48ce5a7f",
                                        "glosses": [
                                            "Qui déteste les livres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814a0cae-e3af-4cca-972e-0035ca52519e",
                                                "sense_id": "ecac79a0-7e9b-3336-9416-d8b785b23768",
                                                "text": "Nous causons, nous rions, ce journaliste, bibliophobe à jeun, veut, quand il est ivre, que je donne à ma langue la sotte allure d’un livre (il feignit de pleurer)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bibliophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce890ab8-3423-36fe-bc2e-ae6f1f74185c",
                                        "entry_id": "80775f1c-e25c-3a0c-9c35-b0a9f5fb15b2",
                                        "glosses": [
                                            "Personne ou animal qui déteste les livres ou veut leur nuire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68bf1b5a-9762-4de3-894c-4c4df08febf6",
                                                "sense_id": "ce890ab8-3423-36fe-bc2e-ae6f1f74185c",
                                                "text": "Ce n’est pas que le bibliophobe lise Voltaire, il s’en garde bien ; mais il se félicite de trouver en Voltaire un prétexte spécieux à son dédain universel pour les livres."
                                            },
                                            {
                                                "example_id": "cbacc6f1-b88d-42f8-bbd8-b6525836919d",
                                                "sense_id": "ce890ab8-3423-36fe-bc2e-ae6f1f74185c",
                                                "text": "Les insectes ont été de tout temps le fléau des bibliothèques, on ne saurait trop mettre de soins à les préserver de ces dangereux bibliophobes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
