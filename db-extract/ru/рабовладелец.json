                                "target_senses": [
                                    {
                                        "sense_id": "ee1d9cc6-f8ec-3b9f-a160-f4391211b208",
                                        "entry_id": "ed01691b-3049-30a9-8a13-a4af5ea05c6f",
                                        "glosses": [
                                            "Someone who owns slaves."
                                        ],
                                        "tags": [],
