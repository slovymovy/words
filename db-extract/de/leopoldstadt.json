                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Leopoldstadt"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed2426a0-fc51-3d03-bd4e-82e1c7b54689",
                        "entry_id": "e2305cad-64a9-3075-9b55-e7e9f94c88a9",
                        "glosses": [
                            "zweiter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "481d8f56-2c8b-4cc7-8230-517bbdb1e29f",
                                "sense_id": "ed2426a0-fc51-3d03-bd4e-82e1c7b54689",
                                "text": "Die Leopoldstadt liegt auf einer Insel, zwischen dem Donaukanal und dem Hauptarm der Donau."
                            },
                            {
                                "example_id": "ff99f425-c844-44c4-9f0b-5e4dcadcef8b",
                                "sense_id": "ed2426a0-fc51-3d03-bd4e-82e1c7b54689",
                                "text": "Wer die Leopoldstadt seit vielen Jahren nicht mehr betreten hat, der würde sie mancherorts wohl kaum wiedererkennen."
                            },
                            {
                                "example_id": "553f0b57-cbf9-448e-b630-97e0eaa314b1",
                                "sense_id": "ed2426a0-fc51-3d03-bd4e-82e1c7b54689",
                                "text": "Der Plan eines riesigen nationalsozialistischen Parteiforums, dem die historische Leopoldstadt zum Opfer gefallen wäre, wurde infolge des Zweiten Weltkriegs nicht realisiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "658302fc-2a97-31e8-b837-db884e6b0658",
                        "entry_id": "e2305cad-64a9-3075-9b55-e7e9f94c88a9",
                        "glosses": [
                            "ehemaliger Vorort, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7495ea32-98b1-488d-bb1f-01bc9fd7e2c6",
                                "sense_id": "658302fc-2a97-31e8-b837-db884e6b0658",
                                "text": "Aus den Vorstädten Leopoldstadt und Jägerzeile, dem Prater, der Vorstadt Brigittenau sowie aus Zwischenbrücken und Teilen von Aspern und Kaiserebersdorf wurde der zweite Bezirk gebildet."
                            },
                            {
                                "example_id": "681f174f-e379-4df1-90db-e67d59e07bc6",
                                "sense_id": "658302fc-2a97-31e8-b837-db884e6b0658",
                                "text": "Die Donau fließt an den Stadtmauern entlang und trennt die Stadt von dem Vorort Leopoldstadt."
                            },
                            {
                                "example_id": "ebb37a53-7914-4a69-9fac-d2544c15f62f",
                                "sense_id": "658302fc-2a97-31e8-b837-db884e6b0658",
                                "text": "Das Zusammenleben von Juden und Christen in der Leopoldstadt war bald etwas Selbstverständliches geworden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
