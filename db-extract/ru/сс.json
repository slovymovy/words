                                            "Canadian Football"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eeb1ca4-36ab-4081-8583-d1c46087e376",
                                                "sense_id": "23a3101e-a49b-382d-8b91-f61a5892be2d",
                                                "text": "„Der Pass traf die Shoulder Pads von Oaklands SS Jack Tatum, der Fuqua deckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "SS",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c6a0a2-c0d5-3622-b3ae-24682aded7e8",
                                        "entry_id": "5159973b-6582-34d6-8d71-cfaaeb8cae33",
                                        "glosses": [
                                            "Schutzstaffel"
                                        ],
                                        "tags": [
                                            "Nationalsozialismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08fde46e-db0d-4619-9d21-1c3372e7d979",
                                                "sense_id": "f5c6a0a2-c0d5-3622-b3ae-24682aded7e8",
                                                "text": "Die Aufgaben der Organisation beschrieb Hitler in einem Führerbefehl vom 7. November 1930 wie folgt: „Die Aufgabe der SS ist zunächst die Ausübung des Polizeidienstes innerhalb der Partei.“"
                                            },
                                            {
                                                "example_id": "e2986c38-d391-4bf1-a20d-0f0b68a40991",
                                                "sense_id": "f5c6a0a2-c0d5-3622-b3ae-24682aded7e8",
                                                "text": "Im Verlauf des Zweiten Weltkriegs verübten Teile der Waffen-SS allein und in Zusammenarbeit mit der Wehrmacht zahllose Kriegsverbrechen."
                                            },
                                            {
                                                "example_id": "46af4304-addf-4806-bf1e-0b8e2915721d",
                                                "sense_id": "f5c6a0a2-c0d5-3622-b3ae-24682aded7e8",
                                                "text": "„Kapitan Klos sollte dem Publikum die intellektuelle Überlegenheit eines polnischen Spions über die deutsche SS oder die Gestapo zeigen, was bei Zuschauern unter zwölf auch gelang.“"
                                            },
                                            {
                                                "example_id": "4d4af0b2-1e95-4b49-a1e3-491e87f49f8b",
                                                "sense_id": "f5c6a0a2-c0d5-3622-b3ae-24682aded7e8",
                                                "text": "„Ich dürfe nicht zur SS, ich müsse zum Heer, sagte ich, mein Vater sei dort Offizier, und sein Herzenswunsch sei es, daß ich Offizier bei der Infanterie des Heeres würde.“"
                                            },
                                            {
                                                "example_id": "47fd1e57-4dc1-4d73-b560-393301fa59c9",
                                                "sense_id": "f5c6a0a2-c0d5-3622-b3ae-24682aded7e8",
                                                "text": "„Er war bei der SS gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b25244ef-ca62-39a3-81cb-a7b695a07dea",
                                        "entry_id": "5159973b-6582-34d6-8d71-cfaaeb8cae33",
