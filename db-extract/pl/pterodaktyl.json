                    },
                    {
                        "translation_id": "4d1c1bdf-f054-4296-bfed-d7df23743170",
                        "source_entry_id": "be93ab99-4b37-31be-bea6-ad2970279cbd",
                        "source_sense_id": "a3c694db-91d1-3687-97f3-03e6cd073d2e",
                        "target_lang_word": "pterodáctilo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pterodáctilo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3a50c15a-1c70-348a-a86e-3b0ad2d1b492",
                                        "entry_id": "5573e307-c5e5-38d0-ba51-7fc45796c681",
                                        "glosses": [
                                            "(Pterodactylus) Reptil fósil volador de la familia de los pterosaurios pterodactiloideos, caracterizado por presentar una membrana entre las extremidades anteriores y el cuerpo, que le posibilitaba el vuelo, habitó en lo que hoy es Europa y África. Vivió hace aproximadamente 155 y 150 millones de años, a finales del periodo jurásico."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14fbe9d5-17ad-4324-84ef-50050b216ed6",
                        "source_entry_id": "be93ab99-4b37-31be-bea6-ad2970279cbd",
                        "source_sense_id": "a3c694db-91d1-3687-97f3-03e6cd073d2e",
                        "target_lang_word": "pterodactylus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pterodactylus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "55a3a674-6c0c-3462-b698-d90c86e5e604",
                                        "entry_id": "60bccfa5-cfeb-3b9a-abdf-89fc3167ef7f",
                                        "glosses": [
                                            "Pterodactylus antiquus een pterosauriër die leefde in het Late Jura, de naamgever van de groep der Pterodactyloidea.\\nPterodactylus is de eerste pterosauriër waarvan wetenschappers zich bewust waren dat hij bestond: in 1784 beschreef Cosimi Allessandro Collini, de curator van het Naturalienkabinet van Karel Theodoor van Beieren, de keurvorst van de Palts, deze vondst uit de kalk van de Eichstätt die de wereld voor een raadsel stelde. Niemand wist precies wat het beest voor iets was, totdat de Duits/Franse vergelijkende anatoom Georg Kuefer - alias Georges Cuvier - in 1809 tot de conclusie kwam dat het een vliegend reptiel betrof, dat hij informeel ptero-dactyle noemde, ofwel \\\"vleugelvinger\\\", omdat het vleugelbot uit de vierde vinger van de hand bestond"
                                        ],
                                        "tags": [
                                            "reptielen"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1032bdff-1335-4ebd-bcee-70e593dd378b",
                        "source_entry_id": "be93ab99-4b37-31be-bea6-ad2970279cbd",
