{
    "word_family": [
        "gémir",
        "gémisseur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d5f22f9-0364-304b-8970-321f0f3f3fb1",
                    "sense_definition": "Son inarticulé et plaintif poussé sous l'effet de la souffrance physique ou d'une vive émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cri_plainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé laissait échapper un faible <w>gémissement</w> chaque fois qu'on tentait de le déplacer."
                        },
                        {
                            "text": "Dans le silence de la nuit, on entendait le <w>gémissement</w> continu de l'enfant malade."
                        }
                    ],
                    "synonyms": [
                        "plainte",
                        "râle"
                    ],
                    "antonyms": [
                        "rire"
                    ],
                    "common_phrases": [
                        "pousser un gémissement",
                        "étouffer un gémissement"
                    ]
                },
                {
                    "sense_id": "d3a0acbb-d627-3794-9fb2-03d2402206ec",
                    "sense_definition": "Bruit sourd ou plaintif émis par une chose soumise à une force ou sous l'effet du vent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>gémissement</w> du vent contre les vieux volets empêchait toute la maisonnée de dormir."
                        },
                        {
                            "text": "Le vieux plancher émettait un léger <w>gémissement</w> sous le poids de chacun de nos pas."
                        }
                    ],
                    "synonyms": [
                        "grincement",
                        "craquement"
                    ],
                    "common_phrases": [
                        "le gémissement du vent"
                    ]
                },
                {
                    "sense_id": "65e7a782-68a5-3b7f-9d28-7e8e74a75fd4",
                    "sense_definition": "Lamentation continue ou récrimination exprimant un mécontentement moral.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cri_plainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cessez donc ces <w>gémissements</w> stériles et proposez plutôt des solutions concrètes pour changer la situation."
                        },
                        {
                            "text": "Malgré ses constants <w>gémissements</w> sur son sort, il refusait systématiquement toute assistance extérieure."
                        }
                    ],
                    "synonyms": [
                        "lamentation",
                        "doléance"
                    ],
                    "common_phrases": [
                        "douloureux gémissements"
                    ]
                }
            ]
        }
    ]
}