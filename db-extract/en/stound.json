    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                "word": "stound",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5e30b89-1338-4ba3-b7c7-956211e98a8f",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "tags": [
                            "plural"
                        ],
                        "form": "stounds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef6bc433-ba3d-3891-94b2-1c7b82f497cf",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "An hour."
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e6219475-6b40-41b9-b10c-6f0a5bac7fb6",
                                "sense_id": "ef6bc433-ba3d-3891-94b2-1c7b82f497cf",
                                "text": "What booth wilt thou have? our king reply'd / Now tell me in this stound"
                            }
                        ]
                    },
                    {
                        "sense_id": "e36545a3-98ce-3e43-bf29-51bc623b05ff",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "A tide, season."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5a61a04f-793e-378c-983b-5552f46a95e2",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "A time, length of time, hour, while."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "7e7370ac-859e-41bf-a355-1a9daf05d5c4",
                                "sense_id": "5a61a04f-793e-378c-983b-5552f46a95e2",
                                "text": "He lay and slept, and swet a stound, / And became whole and sound."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5f63993-c91c-3524-b69f-26fb8736efa1",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "A brief span of time, moment, instant."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "ddcae5e1-e510-4590-b0a3-3ddd2da5cfdf",
                                "sense_id": "b5f63993-c91c-3524-b69f-26fb8736efa1",
                                "text": "Listen to me a little stound."
                            },
                            {
                                "example_id": "c8cf5b14-76ec-42d6-8a6d-2e0be2ce9469",
                                "sense_id": "b5f63993-c91c-3524-b69f-26fb8736efa1",
                                "text": "And in that same stound / All suddenly she swapt adown to ground."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bc9f474-c34f-37de-8f1d-a42261e8eac4",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "A moment or instance of urgency; exigence."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cec3ac22-1288-3e10-9909-072520e664d7",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "A sharp or sudden pain; a shock, an attack."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "db3649f4-7385-4e50-bb8e-35635bf558e3",
                                "sense_id": "cec3ac22-1288-3e10-9909-072520e664d7",
                                "text": "No wonder that they cried unto the Lord, and felt a stound of despair shake their courage"
                            },
                            {
                                "example_id": "9164464b-2041-4335-9a14-ed90674c02bb",
                                "sense_id": "cec3ac22-1288-3e10-9909-072520e664d7",
                                "text": "ere the point arriued, where it ought, / That seuen-fold shield, which he from Guyon brought / He cast betwene to ward the bitter stound [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc2e485a-3255-3c76-aed9-55e449032a09",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "A stroke or blow (from an object or weapon); (by extension) a lashing; scourging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974d199e-d0d8-4fd8-9bfb-e6e7c15d01ec",
                                "sense_id": "fc2e485a-3255-3c76-aed9-55e449032a09",
                                "text": "How many pipes, as many sounds Do still impart To your Sonne's hart / As many deadly wounds : How many strokes, as many stounds, Each stroke a dart, Each stound a smart, Poore captive me confounds."
                            },
                            {
                                "example_id": "c3064457-d5e0-42ad-9b6f-a73fc71a63d6",
                                "sense_id": "fc2e485a-3255-3c76-aed9-55e449032a09",
                                "text": "A colt is made of three stounds, I think; it is lighter, much, than the cat. The punishment with the colt is always given without stripping, over the clothes."
                            }
                        ]
                    },
                    {
                        "sense_id": "095c325f-db91-3ef0-8a47-a303b042abb6",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "A fit, an episode or sudden outburst of emotion; a rush."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eef3412-d689-4f28-93a1-881b28204679",
                                "sense_id": "095c325f-db91-3ef0-8a47-a303b042abb6",
                                "text": "Several stounds of pain in the cleft between great and second toe (anterior tibial nerve). I forget which side, but I think it was the right. Slight pains in left temple, > pressure. Pain in upper part of right eyeball."
                            },
                            {
                                "example_id": "4779932a-e8e6-4bcb-ace5-648bbc1f5d51",
                                "sense_id": "095c325f-db91-3ef0-8a47-a303b042abb6",
                                "text": "[…] and run away with him, almost whether he will or not, in a stound of unbearable love!"
                            }
                        ]
                    },
                    {
                        "sense_id": "98bdd0c1-12d1-3a64-aba4-0b3ee77bee02",
                        "entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "glosses": [
                            "Astonishment; amazement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bdb6730-c8a8-4b60-afbb-e040c6e507be",
                                "sense_id": "98bdd0c1-12d1-3a64-aba4-0b3ee77bee02",
                                "text": "Lightly he started up out of that stound."
                            },
                            {
                                "example_id": "44c1bdc5-e935-4ab6-88a1-1718856e5816",
                                "sense_id": "98bdd0c1-12d1-3a64-aba4-0b3ee77bee02",
                                "text": "we stood as in a stound, / And wet with tears, like dew, the ground"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a45b95aa-17ad-463e-bdde-fdd91fa21992",
                        "source_entry_id": "d1195268-c485-37c8-b242-4c73e343c6d8",
                        "source_sense_description": "a moment or instance of urgency; exigence",
                        "target_lang_word": "срочность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "срочность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bf999f7b-68f1-3fd9-b1d7-7b13b4b6f35e",
                                        "entry_id": "b827bb98-2db0-3682-ab71-336919f13c70",
                                        "glosses": [
                                            "свойство по значению прилагательного срочный"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91ab9248-c382-3e6e-8964-aa258796b45c",
                                        "entry_id": "b827bb98-2db0-3682-ab71-336919f13c70",
                                        "glosses": [
                                            "необходимость быстрого, немедленного исполнения чего-либо; спешка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbfc44a1-0112-4257-9b29-5221b3685735",
                                                "sense_id": "91ab9248-c382-3e6e-8964-aa258796b45c",
                                                "text": "Зачем такая срочность, что за нужда выдернуть из-за парты ребенка и тащить месяц через Гавайские острова, в обход немецких подлодок, через Сингапур, Таиланд, Индию, Багдад и над персидскими плоскогорьями ― ради чего?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
