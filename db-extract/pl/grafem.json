                "translations": [
                    {
                        "translation_id": "984e40e5-b6d9-49ca-b3c4-89b10e853e9f",
                        "source_entry_id": "6e32946a-e2b4-3aaf-9b68-2472d130b26c",
                        "source_sense_id": "e745fcfa-9a79-322d-b866-67ad2befd0b5",
                        "target_lang_word": "grapheme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grapheme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a20b8a36-6a2e-309d-8fe9-d92a6e7643bd",
                                        "entry_id": "bb4e2017-7b47-3dc8-952e-8a47af401ffd",
                                        "glosses": [
                                            "A fundamental unit of a writing system, corresponding to (for example) letters in the English alphabet or jamo in Korean hangul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0562fce-bfec-4376-a7ee-404be4a3b7f1",
                                                "sense_id": "a20b8a36-6a2e-309d-8fe9-d92a6e7643bd",
                                                "text": "For instance, it is convenient to refer to a single Chinese character as being a grapheme in some contexts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01721fc4-85f9-3277-be1b-1e8c1f2b170b",
                                        "entry_id": "bb4e2017-7b47-3dc8-952e-8a47af401ffd",
                                        "glosses": [
                                            "A sequence of one or more code points that are processed and displayed as a single graphical unit of a writing system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34618fcb-b211-43bc-84ba-9b1e5e918bd5",
                                                "sense_id": "01721fc4-85f9-3277-be1b-1e8c1f2b170b",
                                                "text": "Even so, it's important for Unicode-friendly applications to deal with text in their user interfaces as a series of graphemes and not as a series of Unicode code points […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd980563-5418-3b0a-b1bb-325bc5360e43",
                                        "entry_id": "bb4e2017-7b47-3dc8-952e-8a47af401ffd",
                                        "glosses": [
                                            "In alphabetic writing, the shortest group of letters composing a phoneme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9ff92d-0a96-4ad5-a274-eb9e80626dcb",
                                                "sense_id": "bd980563-5418-3b0a-b1bb-325bc5360e43",
                                                "text": "The term for a letter or combination of letters which represents a particular sound is a “grapheme”. Languages like Italian and Serbo-Croatian have very simple “grapheme–phoneme conversion” rules."
                                            },
                                            {
                                                "example_id": "40e8418d-ca19-4929-88d6-a01797aafbe3",
                                                "sense_id": "bd980563-5418-3b0a-b1bb-325bc5360e43",
                                                "text": "In terms of specific graphemes, Table 2.5 identifies the most frequent inconsistent phoneme-to-grapheme patterns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "250f0bfd-9fe9-4281-9965-ccd4b5008e22",
                        "source_entry_id": "6e32946a-e2b4-3aaf-9b68-2472d130b26c",
                        "source_sense_id": "e745fcfa-9a79-322d-b866-67ad2befd0b5",
                        "target_lang_word": "graphème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00d60da2-8b6e-356d-86d9-d43c1cfafb68",
                                        "entry_id": "b0c5d9f0-0e4f-347f-b71c-b2f47b9e9ec4",
                                        "glosses": [
                                            "Plus petit groupe de lettres représentant un phonème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c278ffc-01d3-44c7-95d3-c58e176de0a8",
                                                "sense_id": "00d60da2-8b6e-356d-86d9-d43c1cfafb68",
                                                "text": "on et om sont les graphèmes associés au phonème \\ɔ̃\\."
                                            },
                                            {
                                                "example_id": "b32581b8-5c6f-4288-89d7-647ba32cb420",
                                                "sense_id": "00d60da2-8b6e-356d-86d9-d43c1cfafb68",
                                                "text": "La phonologie permet d’associer à un graphème, c’est-à-dire à un groupe de lettres particulier (exemple : le groupe de lettres « ch ») un phonème spécifique. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 106)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "821dab4e-c84a-4e8b-a80f-3053796b5ae3",
                        "source_entry_id": "6e32946a-e2b4-3aaf-9b68-2472d130b26c",
                        "source_sense_id": "e745fcfa-9a79-322d-b866-67ad2befd0b5",
