                "senses": [
                    {
                        "sense_id": "c784b8bb-a1b0-3635-9fa1-ce2c37d9866c",
                        "entry_id": "60b6f144-615b-3df4-91a5-90eea7fa3f99",
                        "glosses": [
                            "Muter quelqu’un pour s’en débarrasser ou pour raison disciplinaire (à Hazebrouck ou ailleurs)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7d60ea-1143-4366-92f9-6bda5bfae807",
                                "sense_id": "c784b8bb-a1b0-3635-9fa1-ce2c37d9866c",
                                "text": "Puis, il y a eu cette histoire du juge Ceccaldi, de Marseille, muté à Hazebrouck, et ce titre du Canard enchaîné : « Un juge se fait hazebroucker. »"
                            },
                            {
                                "example_id": "97617a77-e77a-4a59-b0b6-cd96419902cf",
                                "sense_id": "c784b8bb-a1b0-3635-9fa1-ce2c37d9866c",
                                "text": "Peut-être pourrait-on le \"hazebroucker\" ?"
                            },
                            {
                                "example_id": "1bee2f13-6e14-447f-a932-f3c56abe4a0b",
                                "sense_id": "c784b8bb-a1b0-3635-9fa1-ce2c37d9866c",
                                "text": "Pourquoi Monsieur Lampin voulait-il venir de Hyères à Hazebrouck ? Il semble qu'à l'époque on se faisait « hazebroucker » volontairement."
                            },
                            {
                                "example_id": "48e8f0a3-ee64-4888-ab4a-919d481426d3",
                                "sense_id": "c784b8bb-a1b0-3635-9fa1-ce2c37d9866c",
                                "text": "Comment le petit juge marseillais s'est fait \"hazebroucker\";"
                            }
                        ]
                    }
                ],
