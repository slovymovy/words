                "senses": [
                    {
                        "sense_id": "bf161303-a2e3-3a47-860f-2c6b47bfbd9c",
                        "entry_id": "d839c849-01ba-3226-bd12-9308bf21bc97",
                        "glosses": [
                            "zur Beurteilung der Bildqualität von Fernsehapparaten und Monitoren sowie zur Unterstützung bei Bildeinstellung und Fehlersuche dienende Muster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a36cd48f-9cfd-48af-816d-1751c3d70df5",
                                "sense_id": "bf161303-a2e3-3a47-860f-2c6b47bfbd9c",
                                "text": "Ohne das Testbild hätten wir nie den Fehler gefunden"
                            },
                            {
                                "example_id": "291ec8f8-1328-4e74-ad9c-602dea1e9e4e",
                                "sense_id": "bf161303-a2e3-3a47-860f-2c6b47bfbd9c",
                                "text": "Das Testbild wurde in den programmfreien Zeiten gesendet."
                            },
                            {
                                "example_id": "abde75cc-87a9-43c3-8db6-bac6d37533ee",
                                "sense_id": "bf161303-a2e3-3a47-860f-2c6b47bfbd9c",
                                "text": "„Der Fernseher zeigte das Testbild.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
