                                "target_senses": [
                                    {
                                        "sense_id": "ac2d20bc-b7c5-3e1a-bd07-4bd9753b876d",
                                        "entry_id": "12882525-26a7-3b06-b6e9-18b31430bfd9",
                                        "glosses": [
                                            "Matter coughed up and expectorated from the mouth, composed of saliva and discharges from the respiratory passages such as mucus, phlegm or pus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dad4bea-9bbe-40ad-9117-b0e45ea4d195",
                                                "sense_id": "ac2d20bc-b7c5-3e1a-bd07-4bd9753b876d",
                                                "text": "In the early 1890s the work in the laboratory consisted of postmortems, urinalyses, and examination of sputums."
                                            },
                                            {
                                                "example_id": "6dfe0b08-3a58-4960-96a7-531c84beb2c2",
                                                "sense_id": "ac2d20bc-b7c5-3e1a-bd07-4bd9753b876d",
                                                "text": "At the U.S. Centers for Disease Control and Prevention in Atlanta, the boy’s sputum sat for a month, waiting for its turn in a slow process of antibody-matching analysis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b8c8d30-fee8-45e3-aeea-94830c8d936e",
                        "source_entry_id": "99ef1874-7c79-342f-8775-4affc1d504a2",
                        "source_sense_id": "f46ff253-ae17-3874-b374-dd890ec49fb2",
                        "source_sense_description": "vocht dat in de mond vloeit uit de speekselklieren",
                        "target_lang_word": "glaviot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaviot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83089422-05c3-3d9d-a2f4-39194be0f0aa",
                                        "entry_id": "1de1378e-4467-34bd-9faf-9c7bb669bf0b",
                                        "glosses": [
                                            "Glaire, crachat."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d24afdd-a6d3-415c-9604-db8467df3597",
                                                "sense_id": "83089422-05c3-3d9d-a2f4-39194be0f0aa",
                                                "text": "Près de moi, Pater parle tout seul : « c’t’un monde j’te dis » et posant sa gamelle entre les jambes il projette d’une bouche crispée en cul de poule un joli petit glaviot bien moulé qui passe en parabole par-dessus l’assemblée des convives."
                                            },
                                            {
                                                "example_id": "7f5ee231-4594-4018-a78f-cb487b819c5f",
                                                "sense_id": "83089422-05c3-3d9d-a2f4-39194be0f0aa",
                                                "text": "Il a reçu un glaviot en pleine figure."
                                            },
                                            {
                                                "example_id": "f6de24dd-8687-4916-ad2d-022df5b5733a",
                                                "sense_id": "83089422-05c3-3d9d-a2f4-39194be0f0aa",
                                                "text": "Un grand flic s’approcha, me fit face, arrondit ostensiblement de ses lèvres un glaviot qu’il me cracha au visage en m’étourdissant d’un formidable aller et retour du plat de la main."
                                            },
                                            {
                                                "example_id": "71db714b-20c4-4d2e-aa46-0e5bda74935b",
                                                "sense_id": "83089422-05c3-3d9d-a2f4-39194be0f0aa",
                                                "text": "Des hommes, tout en marchant, crachaient d’épais glaviots qui allaient s’écraser sur le trottoir."
                                            },
                                            {
                                                "example_id": "dccdcff8-1c30-41ea-8204-b36e2a17854a",
                                                "sense_id": "83089422-05c3-3d9d-a2f4-39194be0f0aa",
                                                "text": "Épuisé par ce long monologue, il se racla la gorge et souffla un énorme glaviot par-dessus bord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
