                    },
                    {
                        "translation_id": "fa15fb48-88ea-4fbe-bf7a-efc0bf32680d",
                        "source_entry_id": "3e47d104-8d15-38bb-9ea5-e87a13bc64e5",
                        "source_sense_id": "c33b661e-0393-385f-8841-039967ee1eff",
