                                "sense_id": "5e86481c-fe2c-3081-9324-5d69c975b93e",
                                "text": "Gruyère is an ancient castle and its attendant farms and houses of artisans on a conical hill amid a plain of lush pastures that still enrich the local, holed cheese."
                            },
                            {
                                "example_id": "519ed227-5f76-4172-afbc-aa5d5a85ab54",
                                "sense_id": "5e86481c-fe2c-3081-9324-5d69c975b93e",
                                "text": "Take a holed stone, find a stick that fits tightly through the hole, and lodge it firmly inside."
                            },
                            {
                                "example_id": "5fcb1e5c-5438-4f68-9a6f-a86f485427d3",
                                "sense_id": "5e86481c-fe2c-3081-9324-5d69c975b93e",
                                "text": "If you’re using a holed button, string beads from one hole to another before adding the back."
                            }
