                "senses": [
                    {
                        "sense_id": "1e738d06-ecc4-3ff8-b7f5-535c075257fc",
                        "entry_id": "dc0bffb0-c4d5-3cd4-8473-d3f1bc443c56",
                        "glosses": [
                            "Quartier de Lyon situé sur le bord est du Rhône, en face de la Presqu’île."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "e130d9fb-1593-4f4a-b23e-92ee8fbd1bb2",
                                "sense_id": "1e738d06-ecc4-3ff8-b7f5-535c075257fc",
                                "text": "Le troisième arrondissement, qui va de Préfecture à Montchat, est assez disparate en termes d’habitat et de prix."
                            },
                            {
                                "example_id": "48c0cea3-56a6-45ef-b4c5-88ec4aa399fd",
                                "sense_id": "1e738d06-ecc4-3ff8-b7f5-535c075257fc",
                                "text": "Entre les berges du Rhône, le quartier Moncey, la Part-Dieu et le cours Lafayette, le quartier de la Préfecture offre un emplacement de premier choix au cœur du 3ème arrondissement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2ff481a1-28d1-33f5-9359-160d3f584dd2",
