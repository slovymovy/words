                "senses": [
                    {
                        "sense_id": "6b8df087-04ff-3adc-9a32-a5cdaf9c2486",
                        "entry_id": "b7c09021-2d9b-33e5-b4a1-661e4f2186ba",
                        "glosses": [
                            "beschreibendes Banner auf dem Profil in einem sozialen Netzwerk"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "99fe920c-8343-471c-8712-8eadf8e8307a",
                                "sense_id": "6b8df087-04ff-3adc-9a32-a5cdaf9c2486",
                                "text": "„Bei einem neuen YouTube-Kanal erfolgt zunächst das Setup des Kanals, einschließlich der Erstellung eines ansprechenden Kanalbanners, eines Profilbildes und der Festlegung der Kanalbeschreibung.“"
                            },
                            {
                                "example_id": "efc07b63-afd1-423c-88e7-a6143b5d5be0",
                                "sense_id": "6b8df087-04ff-3adc-9a32-a5cdaf9c2486",
                                "text": "„Lade ein ansprechendes Kanallogo und Kanalbanner hoch, die deine Kanalidentität widerspiegeln.“"
                            },
                            {
                                "example_id": "a5e1e8fc-9f2a-4fcb-872e-9d8610ae9a33",
                                "sense_id": "6b8df087-04ff-3adc-9a32-a5cdaf9c2486",
                                "text": "„Gestalten Sie außerdem ein ansprechendes Kanalbanner und verwenden Sie ein aussagekräftiges Profilbild.“"
                            },
                            {
                                "example_id": "a77f6400-1ae0-4d94-a607-5a45fb2a2200",
                                "sense_id": "6b8df087-04ff-3adc-9a32-a5cdaf9c2486",
                                "text": "„Mein Kanalbanner hab ich diese Woche schon ausgetauscht, oben im Screenshot seht ihr schon die verbesserte Version.“"
                            },
                            {
                                "example_id": "05259eb1-35d6-4d25-9712-95c1a1d0586a",
                                "sense_id": "6b8df087-04ff-3adc-9a32-a5cdaf9c2486",
                                "text": "„Dein Kanalbanner ist eines der ersten Dinge, die die Leute sehen, wenn sie deinen YouTube-Kanal besuchen, also stelle sicher, dass es einprägsam und auffällig ist!“"
                            },
                            {
                                "example_id": "85a1dd1c-9dee-4a0f-b0db-e309ca0fd0bc",
                                "sense_id": "6b8df087-04ff-3adc-9a32-a5cdaf9c2486",
                                "text": "„Überspannt wird die Startseite von einem Titelbild oder Kanalbanner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
