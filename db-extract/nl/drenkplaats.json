                ],
                "senses": [
                    {
                        "sense_id": "ecfa95a2-cfca-3676-afc5-3e751e5f3faf",
                        "entry_id": "8c5394f9-dda2-3d6e-a68f-ee397c1065dd",
                        "glosses": [
                            "geschikte plek om rijdieren of vee te laten drinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60303e21-4232-4a0d-8582-3a29772a024a",
                                "sense_id": "ecfa95a2-cfca-3676-afc5-3e751e5f3faf",
                                "text": "Soms staat er ineens een poort open. Daardoor gluur je dan naar een paradijselijk landgoed, voorzien van drenkplaats, waterpomp en kapitale villa."
                            },
                            {
                                "example_id": "4bf72c84-b9aa-4b8d-9402-e37e40e6d91b",
                                "sense_id": "ecfa95a2-cfca-3676-afc5-3e751e5f3faf",
                                "text": "Door de wei tegenover het huis loopt een beekje dat via een zijdalletje in de Lesse uitmondt. (…) Na de zuivering stroomt het water in de oude badkuip die als drenkplaats dienst deed. (…) Zoveel mos en wier heeft zich intussen afgezet dat ook de koeien moeite zullen hebben eruit te drinken."
                            },
                            {
                                "example_id": "92894006-5b48-4671-afca-9fc61a0ff76a",
                                "sense_id": "ecfa95a2-cfca-3676-afc5-3e751e5f3faf",
                                "text": "“Het weinige dat ik wist,” zegt Malcolm overbescheiden, “heb ik opgedaan bij de drenkplaatsen in Soedan die in de vorige eeuw door Arabische beunhazen zijn geruïneerd met hun kamelen en hun geiten.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "a3f322ff-d799-32db-9520-38c4ec8217f3",
                        "entry_id": "8c5394f9-dda2-3d6e-a68f-ee397c1065dd",
                        "glosses": [
                            "café dat veel wordt bezocht door een specifieke groep bezoekers"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9141051a-644c-49fd-85cb-cafdbecc620f",
                                "sense_id": "a3f322ff-d799-32db-9520-38c4ec8217f3",
                                "text": "Sommige brasseries (La Coupole, Le Dôme) genieten wereldfaam. () Andere zijn lokale célébrités, zoals de al genoemde Brasserie Balzar in de rue des Ecoles, naast de Sorbonne en het Collège de France gelegen, en dus een traditionele drenkplaats voor geleerden en intellectuelen."
                            },
                            {
                                "example_id": "e0bf5b83-cb00-433f-b7ad-d652e950e664",
                                "sense_id": "a3f322ff-d799-32db-9520-38c4ec8217f3",
                                "text": "Het was niet de doorsnee binnenstadskroeg, geen drenkplaats van verzopen bejaarden, geen vertimmerd pseudobruin en geen met de behangselkwast nagepenseelde Jugendstil."
                            }
                        ]
                    }
                ],
