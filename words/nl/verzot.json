                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verzot</w> mijn tijd niet aan zulke onzinnige bezigheden.",
                            "target_lang_translations": {
