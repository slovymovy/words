                        "sense_id": "6b9812f8-1ea6-3298-99fb-bf0a03c47d18",
                        "entry_id": "8e64021f-165c-3cdf-b61b-7c572a0ea41c",
                        "glosses": [
                            "Person, die für etwas eine übermäßige Begeisterung empfindet"
                        ],
