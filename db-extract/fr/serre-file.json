                "senses": [
                    {
                        "sense_id": "beab2195-3ef4-3110-b5e4-e0559f1e5aa2",
                        "entry_id": "633f0202-842b-36a2-a9fe-556678479cfb",
                        "glosses": [
                            "Officier gradé placé derrière une troupe pour la surveiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7bcba07-a514-46cc-8857-c1da95e12f33",
                                "sense_id": "beab2195-3ef4-3110-b5e4-e0559f1e5aa2",
                                "text": "Il était en serre-file derrière la section."
                            },
                            {
                                "example_id": "dd637699-3ca8-48e8-984e-fcbb4b46464e",
                                "sense_id": "beab2195-3ef4-3110-b5e4-e0559f1e5aa2",
                                "text": "— Quatre par quatre, en serre-file. À votre rang, nom de Dieu !…"
                            },
                            {
                                "example_id": "29eaf378-d88a-4247-83df-c64f0d1a1bb8",
                                "sense_id": "beab2195-3ef4-3110-b5e4-e0559f1e5aa2",
                                "text": "Alexis se détacha du groupe des Haudouin et, joignant Tintin Maloret qui marchait en serre-file, lui donna un coup de pied."
                            },
                            {
                                "example_id": "c2fc7948-481f-445b-909d-6b47bd964add",
                                "sense_id": "beab2195-3ef4-3110-b5e4-e0559f1e5aa2",
                                "text": "Non, il me faut quatre hommes : un derrière, deux en serre-file et moi devant."
                            },
                            {
                                "example_id": "bf907a07-4df4-4bae-a961-81b91b10e818",
                                "sense_id": "beab2195-3ef4-3110-b5e4-e0559f1e5aa2",
                                "text": "Le vieux berger-chef fermait la marche, escorté de trois chiens qu'il lançait ça et là, en serre-file."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c0e5745-428f-38c2-8eb3-2bd6b66c3011",
                        "entry_id": "633f0202-842b-36a2-a9fe-556678479cfb",
                        "glosses": [
                            "Vaisseau qui marche le dernier de tous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf89967-f964-4fa8-be49-e011feff4792",
                                "sense_id": "3c0e5745-428f-38c2-8eb3-2bd6b66c3011",
                                "text": "Être le serre-file."
                            },
                            {
                                "example_id": "195d222f-1b34-4f96-966d-6826cdbf44fb",
                                "sense_id": "3c0e5745-428f-38c2-8eb3-2bd6b66c3011",
                                "text": "Vaisseau serre-file."
                            }
                        ]
                    },
                    {
                        "sense_id": "2062d868-1d9f-32d8-a07d-6cf96038354c",
                        "entry_id": "633f0202-842b-36a2-a9fe-556678479cfb",
                        "glosses": [
                            "(péjoratif) Surveillant (voir capo ou Kapo) référence nécessaire (résoudre le problème)"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "57080cd3-87f0-3feb-a97d-6319cc48bc40",
                        "entry_id": "633f0202-842b-36a2-a9fe-556678479cfb",
                        "glosses": [
                            "Lors d'une évacuation, personne chargée de vérifier que tous sont évacués et qu'il ne reste plus personne sur le lieu du sinistre."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "b0b5a23c-3f5f-4070-99e1-a80491af8e2a",
                                "sense_id": "57080cd3-87f0-3feb-a97d-6319cc48bc40",
                                "text": "En cas d'incendie dans un établissement, les équipiers d'évacuation sont chargés de sécuriser les agents :\n— le guide-file dirige les personnes vers l'issue de secours la plus proche et les accompagne au point de rassemblement ;\n— le serre-file s'assure que tout le monde a bien été évacué."
                            }
                        ]
                    }
