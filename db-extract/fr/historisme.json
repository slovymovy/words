            {
                "entry_id": "4449cad3-6635-3721-8ed8-4ce3aac6c486",
                "word": "historisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4edcb092-5209-4004-8e98-47f5b523fccd",
                        "entry_id": "4449cad3-6635-3721-8ed8-4ce3aac6c486",
                        "tags": [
                            "plural"
                        ],
                        "form": "historismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3a24463-56ac-30fb-9969-5506fe6903cf",
                        "entry_id": "4449cad3-6635-3721-8ed8-4ce3aac6c486",
                        "glosses": [
                            "Philosophie de l’histoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b98556e-afaa-4fab-b066-584517a9b72a",
                                "sense_id": "d3a24463-56ac-30fb-9969-5506fe6903cf",
                                "text": "Représentant de l’historisme allemand, Mannheim accepte de concevoir une histoire des idées à condition que celles-ci soient envigées dans leur contexte d’émergence sociologique."
                            }
                        ]
                    },
                    {
                        "sense_id": "26562920-ae03-3551-85ff-d62052b71e01",
                        "entry_id": "4449cad3-6635-3721-8ed8-4ce3aac6c486",
                        "glosses": [
                            "Souvent utilisé comme synonyme de historicisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa400d39-db65-4a68-a20d-171b71b177b5",
                                "sense_id": "26562920-ae03-3551-85ff-d62052b71e01",
                                "text": "Certaines peintures du XIXe siècle résument, par leur historisme, toute l’histoire des arts appliqués."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d68e67f-5634-4359-ad5c-26b872e40011",
                        "source_entry_id": "4449cad3-6635-3721-8ed8-4ce3aac6c486",
                        "target_lang_word": "Historismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Historismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b410e3c-2602-364e-bf17-e0eaf0d155f9",
                                        "entry_id": "0281470d-8c4b-3b32-bd0a-a73d0a7a4d55",
                                        "glosses": [
                                            "erste Epoche der modernen Geschichtswissenschaft, die die Geschichte als eine von historischen Personen vorangetriebene fortlaufende Entwicklung begreift"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c263fc4b-f206-48d0-b604-18bd6edc3c60",
                                                "sense_id": "8b410e3c-2602-364e-bf17-e0eaf0d155f9",
                                                "text": "„Nach den preußischen Reformen (um 1810) und der Gründung der ersten Berliner Universität unter Wilhelm von Humboldt hatte sich das Wissenschaftskonzept des Historismus durchgesetzt. Der Historismus unterschied sich durch einen systematischen und quellenkritischen Ansatz von der bisherigen vornehmlich philosophischen Geschichtsbetrachtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6fd17f24-3554-3a4a-bcc6-600001c7d900",
                                        "entry_id": "0281470d-8c4b-3b32-bd0a-a73d0a7a4d55",
                                        "glosses": [
                                            "Stilrichtung vor allem im 19. Jahrhundert, die auf ältere Stile zurückgreift und nachahmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da9f24a4-b444-46d3-bc3c-bf93ed28dd2c",
                                                "sense_id": "6fd17f24-3554-3a4a-bcc6-600001c7d900",
                                                "text": "„In der Nachgotik lebte der gotische Baustil auch außerhalb seiner Epoche bis in die Barockzeit weiter fort und fand in der Neugotik als Spielart des Historismus neues Interesse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd45b453-0080-33d3-b381-61dc75813edd",
                                        "entry_id": "0281470d-8c4b-3b32-bd0a-a73d0a7a4d55",
                                        "glosses": [
                                            "die Überbewertung des Geschichtlichen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3cde520e-9505-3d25-86a4-0a9d53752739",
                                        "entry_id": "0281470d-8c4b-3b32-bd0a-a73d0a7a4d55",
                                        "glosses": [
                                            "Ausdruck für einen nicht mehr gegebenen Gegenstand oder Sachverhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598f7127-9918-4618-9f4e-d9d682bc40c3",
                                                "sense_id": "3cde520e-9505-3d25-86a4-0a9d53752739",
                                                "text": "„Mindestens bleibt die DDR-Varietät in Regionalismen, Historismen, Kommunikationskonflikten und als regionale Altersvarietät teilweise erhalten.“"
                                            },
                                            {
                                                "example_id": "54cbb05a-ddd0-40d3-8f3f-dbae8c7dc523",
                                                "sense_id": "3cde520e-9505-3d25-86a4-0a9d53752739",
                                                "text": "„Als A r c h a i s m e n und H i s t o r i s m e n leben sie jedoch noch im lebendigen Sprachgebrauch, werden als alt empfunden und genutzt.“"
                                            },
                                            {
                                                "example_id": "7cbb0f72-5e7a-4781-9d63-d6521f05674f",
                                                "sense_id": "3cde520e-9505-3d25-86a4-0a9d53752739",
                                                "text": "„Nicht nur Archaismen im engeren Sinne, auch Historismen als Bezeichnungen von heute nicht mehr gebräuchlichen Sachen und historisch zurückliegenden Sachverhalten können ein spontanes Verstehen beim Lesen von Texten behindern oder gar verhindern.“"
                                            },
                                            {
                                                "example_id": "440b4250-8a79-49d6-9e15-6a229be0080c",
                                                "sense_id": "3cde520e-9505-3d25-86a4-0a9d53752739",
                                                "text": "„Manche Archaismen( besonders Historismen) bleiben seit Jahrhunderten in der Sprache bestehen, obwohl die durch dieselben bezeichneten Gegenstände längst verschwunden sind.“"
                                            },
                                            {
                                                "example_id": "f364fa5b-fad1-4bcf-8041-3197fa55a1b6",
                                                "sense_id": "3cde520e-9505-3d25-86a4-0a9d53752739",
                                                "text": "„Die intentionale Nutzung von veralteten Ausdrücken, Konstruktionen und Sprachhandlungen als Archaismen ist von den Erscheinungen altertümlicher Relikte (ANACHRONISMEN, Historismen, Sprachfossilien) und der generationalen Schichtung (age-grading) in den einzelnen Sprachstadien sowie von den Beharrungstendenzen in bestimmten stärker formalisierten Sprachbereichen (z.B. Spezial- und Institutionssprachen, Phraseologismen und Wortbildung, Namenwortschatz) abzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99bdb3a9-2c29-4e64-b76d-306165c6293b",
                        "source_entry_id": "4449cad3-6635-3721-8ed8-4ce3aac6c486",
