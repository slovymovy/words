                    {
                        "translation_id": "6b54f4d7-2725-4269-99f5-adc407260bd8",
                        "source_entry_id": "02b95967-d63e-3b3e-8e45-2dc2dbd4cb0f",
                        "source_sense_description": "type of exercise",
                        "target_lang_word": "заря́дка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "заря́дка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7abb9de8-d9f6-3fc5-bbc3-249554ed289a",
                                        "entry_id": "9445e115-b3b4-32c0-b8a0-11459ef7498e",
                                        "glosses": [
                                            "действие по значению гл. заряжать; закладывание, пополнение содержимого чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9a5f1a-876c-4d04-bcb6-1b2c4f32ae56",
                                                "sense_id": "7abb9de8-d9f6-3fc5-bbc3-249554ed289a",
                                                "text": "Дизельные подлодки вынуждены время от времени всплывать для зарядки батарей."
                                            },
                                            {
                                                "example_id": "141f15f9-8d17-463f-ab6e-54d270131eab",
                                                "sense_id": "7abb9de8-d9f6-3fc5-bbc3-249554ed289a",
                                                "text": "Трос-батарея будет вырабатывать ток и на этой глубине, но только температурный перепад между концами будет меньше и зарядка аккумуляторов будет происходить медленнее."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43b9fe2f-f954-30aa-914e-268d0f2e3fd8",
                                        "entry_id": "9445e115-b3b4-32c0-b8a0-11459ef7498e",
                                        "glosses": [
                                            "перен. то же, что физзарядка; комплекс гимнастических упражнений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c7dea2-c029-4619-a5c0-4bb8abd473f0",
                                                "sense_id": "43b9fe2f-f954-30aa-914e-268d0f2e3fd8",
                                                "text": "И представьте, пятиминутная рабочая зарядка оказалась полезней двухчасовых занятий спортом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d95bb6b-54eb-3447-8954-874e5b112fba",
                                        "entry_id": "9445e115-b3b4-32c0-b8a0-11459ef7498e",
                                        "glosses": [
                                            "перен., разг. то же, что зарядное устройство; электрический прибор для зарядки [1] аккумуляторов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2567839-4032-4f60-94c0-28fb89820ac3",
                                                "sense_id": "7d95bb6b-54eb-3447-8954-874e5b112fba",
                                                "text": "У кого есть зарядка для Nokia?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad04a32-224d-3b47-8eca-dbfda94b6766",
                                        "entry_id": "9445e115-b3b4-32c0-b8a0-11459ef7498e",
                                        "glosses": [
                                            "разг. запас энергии в аккумуляторной батарее"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87a4293-85a2-47d2-8b22-1b330d75a567",
                                                "sense_id": "aad04a32-224d-3b47-8eca-dbfda94b6766",
                                                "text": "А в мобильнике зарядка кончилась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efdc5a99-a84e-48ec-97ee-fa2218e122de",
                        "source_entry_id": "02b95967-d63e-3b3e-8e45-2dc2dbd4cb0f",
                        "source_sense_description": "type of exercise",
                        "target_lang_word": "гимна́стика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гимна́стика",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0b8c3aef-c556-32be-b87f-1f7942582aac",
                                        "entry_id": "93716186-a25b-3fe4-aac2-0b452eeedbfa",
                                        "glosses": [
                                            "система физических упражнений, способствующих общему развитию организма и укреплению здоровья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f1b742-e8b7-48d9-9db6-acec6aacd9a4",
                                                "sense_id": "0b8c3aef-c556-32be-b87f-1f7942582aac",
                                                "text": "Анна Ивановна тоже была рада перебраться в город, конечно, главным образом из-за Альфреда, которому пора было начинать его курс шведской гимнастики."
                                            },
                                            {
                                                "example_id": "0e3eb7d6-79cd-42c1-adf6-add89955cd9b",
                                                "sense_id": "0b8c3aef-c556-32be-b87f-1f7942582aac",
                                                "text": "Он стал делать гимнастику, разные повороты и приседания, от которых буквально охал и кричал диким голосом."
                                            },
                                            {
                                                "example_id": "3085b332-723d-45f8-acf2-79d8e6d3cd30",
                                                "sense_id": "0b8c3aef-c556-32be-b87f-1f7942582aac",
                                                "text": "Последнее время он усиленно занимался гимнастикой, бегал по утрам, стараясь сбросить вес."
                                            },
                                            {
                                                "example_id": "73b5c810-91c7-4adb-889c-2f1561ee8b35",
                                                "sense_id": "0b8c3aef-c556-32be-b87f-1f7942582aac",
                                                "text": "Старшеклассники могут работать за компьютером не более 30 минут. Потом обязательно нужно делать перерыв и гимнастику для глаз: поморгать, повращать зрачками, посмотреть вдаль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960329be-6c2d-3d21-9160-c06c3a832c18",
                                        "entry_id": "93716186-a25b-3fe4-aac2-0b452eeedbfa",
                                        "glosses": [
                                            "спорт. вид спорта с соревнованиями по выполнению обязательных и произвольных комплексов упражнений на силу и ловкость"
                                        ],
                                        "tags": [],
