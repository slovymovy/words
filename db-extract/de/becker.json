                    }
                ],
                "senses": [
                    {
                        "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                        "entry_id": "af07041e-b95d-3591-84d4-debf067cf693",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname; der achthäufigste Nachname in Deutschland; Vorkommen in Deutschland und Österreich fast flächendeckend, größte Dichte im südlichen Niedersachsen, Nordrhein-Westfalen, Hessen, Rheinland-Pfalz und im Saarland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7641f51b-d093-4a2d-aa7f-01b6d8d2a26e",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Becker kommt, geht der Herr Becker.“"
                            },
                            {
                                "example_id": "a328da48-ad4d-49e6-9d61-a9e1fdb1f82d",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Becker kommt und geht."
                            },
                            {
                                "example_id": "04315f90-e39e-4d3d-ab6f-7c164eeefa59",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Beckers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "25373d10-3fe6-4892-a8d8-b266034dce6d",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "An verregneten Herbsttagen ist Familie Beckers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "f2be65bb-cdc7-429c-ad29-8895af5f41c1",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Becker das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "e7e59b42-c11a-432a-ad7a-b5a37040e277",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Herr Becker wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "78d10b26-5bf9-4a43-89f2-66c04e42e3d0",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Die Beckers fliegen heute nach Südafrika."
                            },
                            {
                                "example_id": "4094c8a1-ee21-48f4-95d4-ed09bfee9186",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Der Becker trägt nie die Pullover, die die Becker ihm strickt."
                            },
                            {
                                "example_id": "7bef7ddc-9a02-4323-b790-ba4ce12b610d",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Boris Becker konnte als ein Kassenmagnet im Tennissport gelten."
                            },
                            {
                                "example_id": "bdf0a0c8-61bf-4d61-bd11-62db8d727e05",
                                "sense_id": "0de7111f-42b3-38db-ad88-d838ab89e5d9",
                                "text": "Frau Becker ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
