                    {
                        "sense_id": "aaaf8334-ca43-363d-a8a8-d751fcf342e5",
                        "entry_id": "ba0fcc75-c7ca-3e26-8ff5-cdf9f4877853",
                        "glosses": [
                            "fruchtbare Hochebene im Südosten des Zentrums von Baden-Württemberg"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "ff332878-dc3d-4be1-9909-8e3e7495265e",
                                "sense_id": "aaaf8334-ca43-363d-a8a8-d751fcf342e5",
                                "text": "„Die Filderhochebene wird von verschiedenen west-ost-orientierten flachen Talmulden durchzogen.“"
                            },
                            {
                                "example_id": "03181a64-221f-4373-896d-a4877ff7cfa2",
                                "sense_id": "aaaf8334-ca43-363d-a8a8-d751fcf342e5",
                                "text": "„Dieses besondere Kulturgut wächst nur auf den außergewöhnlich guten Lösslehmböden der Filderhochebene.“"
                            },
                            {
                                "example_id": "97e31001-f349-45db-8786-165a8bf3fc71",
                                "sense_id": "aaaf8334-ca43-363d-a8a8-d751fcf342e5",
                                "text": "„Die Touren führen von Plochingen sowohl entlang von Neckar und Fils als auch auf die Filderhochebene oder hinauf auf das Dettinger Käppele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
