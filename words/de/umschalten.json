                    "frequency": "Middle",
                    "semantic_group_id": "uebertragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einem anstrengenden Arbeitstag fällt es vielen Menschen schwer, schnell auf Erholung <w>umzuschalten</w>."
                        },
                        {
                            "text": "Die Mannschaft reagierte nach dem Gegentor sofort und <w>schaltete</w> auf Angriff <w>um</w>."
                        }
                    ],
                    "synonyms": [
                        "sich umstellen",
                        "sich anpassen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "schnell umschalten",
                        "auf Angriff umschalten"
                    ]
                },
                {
                    "sense_id": "d52cf54a-157f-31c7-bff9-f925c6c6de43",
                    "sense_definition": "im Rundfunk oder Fernsehen die Übertragung zu einem anderen Ort oder Studio weiterleiten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir beenden den Bericht vor Ort und <w>schalten</w> nun direkt ins Studio nach Berlin <w>um</w>."
                        },
                        {
                            "text": "Wegen der aktuellen Eilmeldung <w>schaltete</w> der Sender sofort zur Korrespondentin nach Paris <w>um</w>."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "ins Studio umschalten",
                        "nach Berlin umschalten"
                    ]
                }
            ]
        },
