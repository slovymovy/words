        "fr-extract.jsonl": [
            {
                "entry_id": "543a3621-83b6-3380-94d9-f908a1e0de33",
                "word": "ponceau",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f31c277-c7b1-3419-9088-3534c00c70a2",
                        "entry_id": "543a3621-83b6-3380-94d9-f908a1e0de33",
                        "glosses": [
                            "De la couleur rouge du coquelicot. #C60800"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d64c058-b302-45f9-adea-415cd5841976",
                                "sense_id": "9f31c277-c7b1-3419-9088-3534c00c70a2",
                                "text": "La cérémonie commença, il faisait chaud. Pas d’air sous la tente… il y avait de grosses dames cramoisies qui sommeillaient à l’ombre de leurs marabouts, et des messieurs chauves qui s’épongeaient la tête avec des foulards ponceau."
                            },
                            {
                                "example_id": "5517b912-28cb-4bcd-bdab-86857f93f683",
                                "sense_id": "9f31c277-c7b1-3419-9088-3534c00c70a2",
                                "text": "Lui s’était relevé, le pauvre homme ! tenant le capuchon — un capuchon de satin ponceau, mais moins ponceau que son visage, et qu’il avait, au risque d’une apoplexie, repêché sous les petits bancs, comme il avait pu…"
                            },
                            {
                                "example_id": "c696d34b-d5b3-4920-a7f9-2b9b23172c00",
                                "sense_id": "9f31c277-c7b1-3419-9088-3534c00c70a2",
                                "text": "Et, chose qu'il n'avait faite pour personne, pas même pour monsieur le curé, il boucla aux oreilles de la rossinante des rubans ponceau."
                            },
                            {
                                "example_id": "569467a9-617d-4f58-9f69-b840af17ae91",
                                "sense_id": "9f31c277-c7b1-3419-9088-3534c00c70a2",
                                "text": "Il devient ponceau de joie et proteste avec une modestie enchantée."
                            },
                            {
                                "example_id": "b64f36a2-e09b-446f-9e8a-449aaf934586",
                                "sense_id": "9f31c277-c7b1-3419-9088-3534c00c70a2",
                                "text": "Rien n’y manque : le photographe n'a oublié ni le tapis de velours ponceau et les livres dorés sur tranches, ni le fauteuil vaguement Renaissance agrémenté de punaises en cuivre et lourdement capitonné."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7fff97f-8d09-49e3-85fe-d2b734d5cbc7",
                        "source_entry_id": "543a3621-83b6-3380-94d9-f908a1e0de33",
                        "source_sense_id": "9f31c277-c7b1-3419-9088-3534c00c70a2",
