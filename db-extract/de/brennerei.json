                    {
                        "translation_id": "020f9426-1812-41df-8a00-5829a1193916",
                        "source_entry_id": "90237d25-4f6a-3cc1-9514-ccd765218358",
                        "source_sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                        "source_sense_description": "Betrieb, in dem stark alkoholhaltige Getränke destilliert werden",
                        "target_lang_word": "distilleerderij",
