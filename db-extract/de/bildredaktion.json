                "senses": [
                    {
                        "sense_id": "f17f258c-7167-36f4-a0ae-a4e730c8f5a2",
                        "entry_id": "bd83e18c-08e7-3650-bc00-84a2b3643691",
                        "glosses": [
                            "Gesamtheit der Redakteure eines Verlags, die für die Illustration zuständig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db6535f0-a9ea-42af-9899-30ef783517a6",
                                "sense_id": "f17f258c-7167-36f4-a0ae-a4e730c8f5a2",
                                "text": "„Die Bildredaktion ist ein Novum im Verlagsgebäude am Hamburger Speersort.“"
                            },
                            {
                                "example_id": "8cf2ea70-0706-417f-9b0f-5e55ef3149e9",
                                "sense_id": "f17f258c-7167-36f4-a0ae-a4e730c8f5a2",
                                "text": "„Der gebürtige Leobener ist Leiter der Bildredaktion in der Presseabteilung der Vorarlberger Landesregierung.“"
                            },
                            {
                                "example_id": "43d52111-0166-492a-a57d-7676268db088",
                                "sense_id": "f17f258c-7167-36f4-a0ae-a4e730c8f5a2",
                                "text": "„Der Mann in der Telefonzentrale versicherte ihr, dass es einen Herrn mit dem Namen Dücker weder in der Redaktion noch in der Bildredaktion noch unter den frei arbeitenden Reportern gäbe.“"
                            }
                        ],
