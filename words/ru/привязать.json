    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c8df022-4ac0-3632-885f-68305eb9835b",
                    "sense_definition": "Прикрепить кого-либо или что-либо с помощью верёвки, ремня или узла к чему-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик решил надёжно <w>привязать</w> лодку к деревянному столбу около берега реки."
                        },
                        {
                            "text": "Перед поездкой в багажнике нужно было крепко <w>привязать</w> тяжёлые коробки."
                        }
                    ],
                    "synonyms": [
                        "прикрепить"
                    ],
                    "antonyms": [
                        "отвязать"
                    ],
                    "common_phrases": [
                        "привязать собаку",
                        "привязать верёвкой",
                        "крепко привязать"
                    ]
                },
                {
                    "sense_id": "540916e7-79fe-3481-bc35-d9a49528718a",
                    "sense_definition": "Внушить чувство глубокой симпатии, любви или преданности к себе.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Своей искренней заботой и добротой она смогла <w>привязать</w> к себе всех детей в семье."
                        },
                        {
                            "text": "Новый учитель быстро сумел <w>привязать</w> к себе учеников увлекательными рассказами."
                        }
                    ],
                    "synonyms": [
                        "расположить"
                    ],
                    "antonyms": [
                        "оттолкнуть"
                    ],
                    "common_phrases": [
                        "привязать к себе"
                    ]
                },
                {
                    "sense_id": "7267bf93-744a-3066-ae1d-cff7f4a43ea8",
                    "sense_definition": "Лишить свободы передвижения, вынудить оставаться в определённом месте или при ком-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limit_freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Срочная работа над новым проектом смогла намертво <w>привязать</w> инженера к офису на всю неделю."
                        },
                        {
                            "text": "Неожиданная болезнь родственника надолго <w>привязала</w> её к дому."
                        }
                    ],
                    "synonyms": [
                        "приковать"
                    ],
                    "antonyms": [
                        "освободить"
                    ],
                    "common_phrases": [
                        "привязать к дому",
                        "привязать к месту"
                    ]
                },
                {
                    "sense_id": "71de5e60-334f-3ca5-8883-23ddc983600e",
                    "sense_definition": "Поставить в прямую зависимость от каких-либо факторов, условий или обстоятельств.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dependence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Руководство компании решило <w>привязать</w> размер годового бонуса к общим результатам продаж."
                        },
                        {
                            "text": "Правительство попыталось жёстко <w>привязать</w> курс национальной валюты к стоимости нефти."
                        }
                    ],
                    "synonyms": [
                        "соотнести"
                    ],
                    "common_phrases": [
                        "привязать к курсу",
                        "привязать к результату",
                        "привязать карту"
                    ]
                },
                {
                    "sense_id": "89f6ac3a-81ea-34f2-9a90-1d8006dd86a4",
                    "sense_definition": "Определить положение объекта на карте или схеме относительно опорных географических или пространственных ориентиров.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spatial_linking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Геодезисты должны были точно <w>привязать</w> план нового здания к существующей сетке координат."
                        },
                        {
                            "text": "Специалисты смогли успешно <w>привязать</w> старинную карту местности к современным спутниковым снимкам."
                        }
                    ],
                    "synonyms": [
                        "локализовать"
                    ],
                    "common_phrases": [
                        "привязать к местности",
                        "привязать к координатам"
                    ]
                }
            ]
        }
    ]
