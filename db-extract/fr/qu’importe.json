        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "0f4451e1-b758-3334-b985-cd384e256659",
                "word": "qu’importe",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d7c534dc-c0bb-3269-97cd-34af7fee0e87",
                        "entry_id": "0f4451e1-b758-3334-b985-cd384e256659",
                        "glosses": [
                            "C'est sans importance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01b57fbf-8942-48fe-8f52-6b9c328e3807",
                                "sense_id": "d7c534dc-c0bb-3269-97cd-34af7fee0e87",
                                "text": "Le vent qui t'apporta t'emporte\nEt, dussé-je en mourir,\nQu'importe !"
                            },
                            {
                                "example_id": "98dbcaed-4237-483b-8c03-653d08646ec8",
                                "sense_id": "d7c534dc-c0bb-3269-97cd-34af7fee0e87",
                                "text": "Mais qu’importe qu’elle l’ait remarqué ou non, cette nuit-là. Une fois tombé sous son charme, Gabriel Morange ne vit plus qu’elle, pour le reste de la soirée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dbbe7f9-b970-4949-a4c3-e6d4f0178662",
                        "source_entry_id": "0f4451e1-b758-3334-b985-cd384e256659",
                        "source_sense_id": "d7c534dc-c0bb-3269-97cd-34af7fee0e87",
                        "target_lang_word": "whatever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whatever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6fa57c-2830-3f1a-8104-38623bee0e51",
                                        "entry_id": "6782fdd9-14a1-3e51-9e1a-6d12b3f61312",
                                        "glosses": [
                                            "A thing or person whose actual name is unknown or forgotten."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ea9807-67a3-404b-947d-bfc1d2200660",
                                                "sense_id": "5f6fa57c-2830-3f1a-8104-38623bee0e51",
                                                "text": "As far as I'm concerned Alec is dead. Whatever they've got in there, that...whatever."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whatever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb99270-1727-3e70-be02-144b4a35c44d",
                                        "entry_id": "16f19cfe-6e3d-35dd-af4c-8e0ef39be627",
                                        "glosses": [
                                            "What ever; emphatic form of 'what'."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8264e46-58fa-492a-a5bf-2ce75980eec6",
                                                "sense_id": "7bb99270-1727-3e70-be02-144b4a35c44d",
                                                "text": "Good heavens! Whatever time is it?!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52650365-b5b9-32ba-96d9-a16fe88497eb",
                                        "entry_id": "16f19cfe-6e3d-35dd-af4c-8e0ef39be627",
                                        "glosses": [
                                            "Regardless of the ... that; for any ... that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7aae37b-6f56-4942-a9b9-e372e4ce7ece",
                                                "sense_id": "52650365-b5b9-32ba-96d9-a16fe88497eb",
                                                "text": "Whatever your choice, there will be consequences."
                                            },
                                            {
                                                "example_id": "831b1262-09da-4faf-9ab7-f4e935dcd7e1",
                                                "sense_id": "52650365-b5b9-32ba-96d9-a16fe88497eb",
                                                "text": "I will stick with you, whatever fate befalls us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                                        "entry_id": "16f19cfe-6e3d-35dd-af4c-8e0ef39be627",
                                        "glosses": [
                                            "Any ... that; of no matter what type or kind that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7bc3fc3-43f7-400c-94a2-0b7f92d762f8",
                                                "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                                                "text": "Whatever doubts I had were quickly dispelled."
                                            },
                                            {
                                                "example_id": "8b90a2da-a3ed-4aa2-81c2-4217389703a9",
                                                "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                                                "text": "Write down whatever thoughts come into your mind."
                                            },
                                            {
                                                "example_id": "7fa78718-7f41-4091-8a64-1709475d4790",
                                                "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                                                "text": "So may whatever tempest mars\n⁠Mid-ocean, spare thee, sacred bark;\n⁠And balmy drops in summer dark\nSlide from the bosom of the stars."
                                            },
                                            {
                                                "example_id": "8db42813-39dd-48c7-bffb-cc524a7ec74c",
                                                "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                                                "text": "As far as I'm concerned Alec is dead. Whatever they've got in there, that...whatever."
                                            },
                                            {
                                                "example_id": "0a7a6836-67f4-4457-966f-f34928889c5e",
                                                "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                                                "text": "Whatever utility the work may have outside of its stated boundaries will be largely because of such a nonprovincial approach."
                                            },
                                            {
                                                "example_id": "81ecfa8f-56b7-459c-97ad-ca87fbc248b1",
                                                "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                                                "text": "In an expression that reflects the pathos of a person without memory of a recent past, Milner quotes H.M. as saying, \"Every day is alone in itself, whatever enjoyment I've had, and whatever sorrow I've had Right now, I'm wondering. Have I done or said anything amiss? That's what worries me. It's like waking from a dream; I just don't remember.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e95caee-6d87-3d7a-b85e-77f1e986ce83",
                                        "entry_id": "16f19cfe-6e3d-35dd-af4c-8e0ef39be627",
                                        "glosses": [
                                            "Any; of no matter what type or kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c2a757-36e6-46ab-8845-8c319ecfb60d",
                                                "sense_id": "9e95caee-6d87-3d7a-b85e-77f1e986ce83",
                                                "text": "He must be stopped, whatever the cost."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whatever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fbe70aa-5092-3b7f-891d-d1e25d4b21c4",
                                        "entry_id": "f5011f5e-fa54-3338-82c2-db2588791c9c",
                                        "glosses": [
                                            "What ever; emphasised form of 'what', used to ask which thing, event, circumstance, etc."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d924ba53-eb34-4084-bf6f-21bcf2b1d363",
                                                "sense_id": "0fbe70aa-5092-3b7f-891d-d1e25d4b21c4",
                                                "text": "Whatever do you mean?"
                                            },
                                            {
                                                "example_id": "6158b581-a094-4a27-84bd-ed91227fbce2",
                                                "sense_id": "0fbe70aa-5092-3b7f-891d-d1e25d4b21c4",
                                                "text": "Whatever happened to Leon Trotsky?\nHe got an ice pick\nThat made his ears burn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abe20d2b-2aa6-3b38-893f-b4656080f939",
                                        "entry_id": "f5011f5e-fa54-3338-82c2-db2588791c9c",
                                        "glosses": [
                                            "Regardless of anything that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c62bc63b-a96e-4288-affe-73614b82fcf6",
                                                "sense_id": "abe20d2b-2aa6-3b38-893f-b4656080f939",
                                                "text": "Whatever he does, he will still lose the game."
                                            },
                                            {
                                                "example_id": "389e0198-817a-489b-bbe1-4d2c4db7f2af",
                                                "sense_id": "abe20d2b-2aa6-3b38-893f-b4656080f939",
                                                "text": "Whatever happens, stay calm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da5d0a2-a80b-35eb-a02b-ab8e3d45168d",
                                        "entry_id": "f5011f5e-fa54-3338-82c2-db2588791c9c",
                                        "glosses": [
                                            "Anything that; all that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b550a9-3490-455c-a999-452542bc46ac",
                                                "sense_id": "1da5d0a2-a80b-35eb-a02b-ab8e3d45168d",
                                                "text": "I’ll do whatever I can."
                                            },
                                            {
                                                "example_id": "2f08be72-460a-48a8-9d23-7c27a950421b",
                                                "sense_id": "1da5d0a2-a80b-35eb-a02b-ab8e3d45168d",
                                                "text": "And ſpight of Pride, and in thy Reaſon's ſpight, / One truth is clear; \"Whatever Is, is Right.\""
                                            },
                                            {
                                                "example_id": "3de005b1-8f64-4b88-ac83-617864ccb5ca",
                                                "sense_id": "1da5d0a2-a80b-35eb-a02b-ab8e3d45168d",
                                                "text": "Do whatever works."
                                            },
                                            {
                                                "example_id": "82f6fa18-c39a-40ff-b08a-34143099c839",
                                                "sense_id": "1da5d0a2-a80b-35eb-a02b-ab8e3d45168d",
                                                "text": "The ability of a segment of a glass sphere to magnify whatever is placed before it was known around the year 1000, when the spherical segment was called a reading stone, essentially what today we might term a frameless magnifying glass or plain glass paperweight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "170759fe-670b-37eb-84dc-8d466bb22a78",
                                        "entry_id": "f5011f5e-fa54-3338-82c2-db2588791c9c",
                                        "glosses": [
                                            "Anything; thing(s) of unspecified kind, or no matter what kind; sometimes used to indicate that the speaker does not care about options."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f4a541-1051-4f34-8772-0ca110cf3fa1",
                                                "sense_id": "170759fe-670b-37eb-84dc-8d466bb22a78",
                                                "text": "I don't need any of this stuff, so take whatever."
                                            },
                                            {
                                                "example_id": "1d62e866-49cd-4a61-8c07-d51e65afbbdd",
                                                "sense_id": "170759fe-670b-37eb-84dc-8d466bb22a78",
                                                "text": "\"As far as I'm concerned, Alec is dead. Whatever they've got in there, that — whatever —.\""
                                            },
                                            {
                                                "example_id": "80c982a9-2c55-4f79-956b-bd544a975617",
                                                "sense_id": "170759fe-670b-37eb-84dc-8d466bb22a78",
                                                "text": "There's a pile of stuff on that table; clippings, pamphlets, posters, whatever, that needs to be sorted and filed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whatever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                                        "entry_id": "8ce98411-e1a8-3104-935f-2a51fc33cd28",
                                        "glosses": [
                                            "At all; in any way; whatsoever."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52431de9-367a-4c76-8ac8-04e34f5a3768",
                                                "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                                                "text": "There is no point whatever in going on with this discussion."
                                            },
                                            {
                                                "example_id": "bb326d69-6dbc-4267-a3f8-e386b419cbfc",
                                                "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                                                "text": "He is quite unconscious; and, though your presence is a relief to me, you must remember that there is no hope - no hope whatever."
                                            },
                                            {
                                                "example_id": "2721e01a-7b1b-4cd5-a68d-e59024a9cdce",
                                                "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                                                "text": "So then arose the horrible confusion perpetuated ever since, of perversely different kinds of weights, jostling each other in Britain; Troy weight and Avoirdupois weight and Apothecaries' weight, wherein or whereamongst every one is at sea with regard to testing them, and no one whatever is satisfied."
                                            },
                                            {
                                                "example_id": "ce90901a-4387-4849-9881-25a251d65d25",
                                                "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes. The clear light of the bright autumn morning had no terrors for youth and health like hers."
                                            },
                                            {
                                                "example_id": "bbfc0d4d-530d-42bb-9845-562047841a58",
                                                "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                                                "text": "In the third place, the superelevation and alignment of the track, theoretically calculated for speeds of 70 to 75 m.p.h., was adequate for the 80 to 85 m.p.h. or so normally attained as maxima over the G.N. main line; but nothing whatever had been done to prepare it for the enormous increment over these figures that this run was to produce."
                                            },
                                            {
                                                "example_id": "715d0faf-1fb8-4c82-b3db-f2bcdb7ddd30",
                                                "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                                                "text": "His repetitive toil is his life and reality, and it goes on forever, and it is without any meaning whatever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca91003-1630-3c96-9605-a0d4fdcdec1e",
                                        "entry_id": "8ce98411-e1a8-3104-935f-2a51fc33cd28",
                                        "glosses": [
                                            "In what way; to what extent."
                                        ],
                                        "tags": [
                                            "interrogative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc8efa6-f7af-447f-8e63-7baca73461f4",
                                                "sense_id": "2ca91003-1630-3c96-9605-a0d4fdcdec1e",
                                                "text": "Whatever does it matter now?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whatever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                        "entry_id": "d220591f-f6a0-3938-9e96-b311819c726f",
                                        "glosses": [
                                            "A holophrastic expression used to dismiss something that the speaker doesn't care about, doesn't think important, or doesn't want to consider or discuss any further. Sometimes conceived as an ellipsis of whatever you say, implying feigned deference: whatever you say [apparently must be true]."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba70f216-a91f-4bf9-bfe8-21fcd0a6a77e",
                                                "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                                "text": "Near-synonyms: meh, so what"
                                            },
                                            {
                                                "example_id": "3e1ed833-8ac4-45f9-88fe-9109f68d847f",
                                                "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                                "text": "So you broke it? Whatever! Get a grip."
                                            },
                                            {
                                                "example_id": "1af68907-4651-435d-a079-601671d151ba",
                                                "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                                "text": "Go brush your teeth. – Whatever!"
                                            },
                                            {
                                                "example_id": "2623144d-c1b2-4fb3-b6c6-27f522051fdb",
                                                "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                                "text": "\"... between you and Irene.\" \"Iris.\" \"Whatever.\""
                                            },
                                            {
                                                "example_id": "486a79d6-ae6e-4576-ac69-62c92f28f9e6",
                                                "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                                "text": "\"... now it's Violet.\" \"Iris.\" \"Whatever.\""
                                            },
                                            {
                                                "example_id": "85d5a3f2-4d60-4d9c-9705-58f05c0ea28d",
                                                "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                                "text": "\"It's not silk, it's muslin.\" \"Whatever.\""
                                            },
                                            {
                                                "example_id": "703fcd2b-3056-4e91-94eb-4c7114815761",
                                                "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                                                "text": "Yeah, whatever you old dried up fat hog."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whatever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28b88073-fc6b-38a1-a9b9-d5f7b2ec0a70",
                                        "entry_id": "ecd3fe49-6502-3eb3-b981-c5aa962781ea",
                                        "glosses": [
                                            "Unexceptional or unimportant; blah."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1223ca2d-69ae-4a6d-bf80-757e4a23c04e",
                                                "sense_id": "28b88073-fc6b-38a1-a9b9-d5f7b2ec0a70",
                                                "text": "All in all, I guess I shouldn't be complaining, but the rest of the show, imho, was very whatever-ish."
                                            },
                                            {
                                                "example_id": "d0cc59c1-048f-42ab-98fb-88f1240c4a27",
                                                "sense_id": "28b88073-fc6b-38a1-a9b9-d5f7b2ec0a70",
                                                "text": "She's like so whatever / You can do so much better"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whatever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e740ec2-54f4-3bd4-a8eb-ff20249117ec",
                                        "entry_id": "4170126a-f392-39b6-a779-c85af681c67c",
                                        "glosses": [
                                            "Something whose exact kind or nature is unimportant; a thingy."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a22398c-7edb-46f8-9b82-0722459880d1",
                                                "sense_id": "7e740ec2-54f4-3bd4-a8eb-ff20249117ec",
                                                "text": "How would you feel if you're a plant elf, and your daily bonus is tied to the number of whatevers you produce, and then this big clumsy thing barges in and knocks your rate back for the whole week?"
                                            },
                                            {
                                                "example_id": "811e82d8-294f-44c7-9a03-633df0d0bad6",
                                                "sense_id": "7e740ec2-54f4-3bd4-a8eb-ff20249117ec",
                                                "text": "I think it's the HYDRA, the group of whatevers that rule the world, those elitists that laugh at us, joke about their environmentalist sheeples doing their bidding while they sip the best wine on the planet, ride around in private jets, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "89902f25-a2e5-4327-afc0-782bda9aff7e",
