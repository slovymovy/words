                "senses": [
                    {
                        "sense_id": "d3141fc5-4eba-3ffc-afe2-108c519e88fb",
                        "entry_id": "f4cc0837-35de-360a-bb4a-f9303a41e93d",
                        "glosses": [
                            "auffälliges senkrechtes Warn- oder Leitzeichen im Straßen- und Eisenbahnverkehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c125d7-90dc-4082-84cd-c2193350a936",
                                "sense_id": "d3141fc5-4eba-3ffc-afe2-108c519e88fb",
                                "text": "„Diese Zeichen kündigen Eisenbahnübergänge an und sind beiderseits der Straße anzubringen; die Baken mit den 3 roten schräg gestellten Balken sind unter den in Z 6a und 6b angeführten Zeichen ungefähr 240 m, die Baken mit 2 Balken ungefähr 160 m und die Baken mit einem Balken ungefähr 80 m vor dem Bahnübergang anzubringen.“"
                            },
                            {
                                "example_id": "82c8887a-ed23-4f44-b5b0-c3beb5cc177f",
                                "sense_id": "d3141fc5-4eba-3ffc-afe2-108c519e88fb",
                                "text": "„Wegen der Abschaffung von Bake & Co. bekommt Minister Tiefensee allerdings noch Gegenwind von der Opposition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a473ed7f-cd83-3ab1-9123-31c45b733536",
                        "entry_id": "f4cc0837-35de-360a-bb4a-f9303a41e93d",
                        "glosses": [
                            "auffälliges senkrechtes Warn- oder Leitzeichen auf See oder in der Binnenschifffahrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514164c4-cd98-45b7-b032-7b5a7b774174",
                                "sense_id": "a473ed7f-cd83-3ab1-9123-31c45b733536",
                                "text": "Eine Bake in der Schifffahrt dient der Navigation."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
