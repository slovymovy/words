                        "examples": [
                            {
                                "example_id": "fede5ba6-1444-4242-99c5-b896474eb665",
                                "sense_id": "e43e843f-590d-30be-95fc-27550c58c040",
                                "text": "'I thought, sir,' answered Nigel, with as much haughtiness as was consistent with the cool distance he desired to preserve, 'I thought I had told you, my name was Nigel Grahame.'\nHis eminence of Whitefriars on this burst into a loud, chuckling, impudent laugh, repeating the word, till his voice was almost inarticulate, - 'Niggle Green - Niggle Green - Niggle Green! why, my lord, you would be queered in the drinking of a penny pot of Malmsey, if you cry before you are touched.'"
                            }
                        ]
                    }
