                        "examples": [
                            {
                                "example_id": "d6118c91-c058-40cd-b110-3464e381ba51",
                                "sense_id": "ac2d2b05-ba4e-337e-b4aa-cd9ec2530435",
                                "text": "Entre Grenoble et Valence, on a formé pour dire « revenir », le verbe s’envenir, comme le bon français a fait s’enfuit. Cela donne des phrases qui étonnent les Français ignorant ce verbe régional : « Elle s’est envenue en auto-stop » ou bien, à l’impératif : « Va jouer aux cartes, mais enviens-toi de bonne heure. » — (G. Tuaillon, « Le français régional : formes de rencontre », dans Geneviève Vermès, Vingt-cinq communautés linguistiques de la France, Paris : l’Harmattan, 1988, page 295)"
                            },
                            {
                                "example_id": "e996a0af-1b32-48bd-a492-02ff876f4163",
                                "sense_id": "ac2d2b05-ba4e-337e-b4aa-cd9ec2530435",
                                "text": "On s’est envenu très doucement alors on n’a pas été trop fatigué en arrivant."
                            },
                            {
                                "example_id": "22240e6d-0c3f-458b-a9de-9a2bcb89b87d",
                                "sense_id": "ac2d2b05-ba4e-337e-b4aa-cd9ec2530435",
                                "text": "Martin, s’est envenue tout droit chez-nous !"
                            }
                        ]
                    }
