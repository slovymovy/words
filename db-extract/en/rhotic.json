                "senses": [
                    {
                        "sense_id": "db66adb9-9926-3794-9218-8c6ab8cdf585",
                        "entry_id": "7d98011a-3725-36c1-b2ee-f0f0ba559b8e",
                        "glosses": [
                            "A rhotic consonant or rhotic vowel (R-coloured vowel)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfa0872-4f38-4db3-932a-26e1cbe9ef1d",
                                "sense_id": "db66adb9-9926-3794-9218-8c6ab8cdf585",
                                "text": "It is well known that the phonetic realization of rhotics varies considerably from language to language, even from dialect to dialect. Rhotics can be realized as flaps, taps, trills (uvular, coronal or bilabial), or as assibilated or fricative variants."
                            },
                            {
                                "example_id": "7800808d-c093-4d83-8861-9636467fad95",
                                "sense_id": "db66adb9-9926-3794-9218-8c6ab8cdf585",
                                "text": "2012, Rebeka Campos-Astorkiza, 5: The Phonemes of Spanish, José Ignacio Hualde, Antxon Olarrea, Erin O'Rourke (editors), The Handbook of Hispanic Linguistics, John Wiley & Sons (Wiley-Blackwell), page 100,\nSpanish also has two rhotics, a tap /ɾ/(vibrante simple) and a trill /r/(vibrante múltiple)."
                            },
                            {
                                "example_id": "252e7eb8-fc6c-4fda-a748-504d4c1fb6cf",
                                "sense_id": "db66adb9-9926-3794-9218-8c6ab8cdf585",
                                "text": "Phonetic transcription of rhotics differs depending on whether the rhotic is a steady-state or dynamic vowel."
                            }
                        ]
                    }
                ],
