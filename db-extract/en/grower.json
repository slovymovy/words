                                "target_word": "Pflanzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "865eb04c-28ed-34a1-a23e-48d0a6ee34b6",
                                        "entry_id": "32dcde0a-e95d-333d-ac80-b453b6261a28",
                                        "glosses": [
                                            "jemand, der Pflanzen/Setzlinge in die Erde einbringt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e816b7b-3336-3253-8ea2-e6923f30a720",
                                        "entry_id": "32dcde0a-e95d-333d-ac80-b453b6261a28",
                                        "glosses": [
                                            "Inhaber eines landwirtschaftlichen Betriebs in Übersee, der mit der Produktion von pflanzlichen Produkten beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac938ede-781d-4e97-813e-e5790505788a",
                                                "sense_id": "6e816b7b-3336-3253-8ea2-e6923f30a720",
                                                "text": "„Andere Pflanzer blieben und produzierten für die Besatzer.“"
                                            },
                                            {
                                                "example_id": "4d00794c-899d-42b7-a705-a738683cf972",
                                                "sense_id": "6e816b7b-3336-3253-8ea2-e6923f30a720",
                                                "text": "„Bald zieht es ihn wieder nach Lateinamerika, er versucht sich als Pflanzer und Kautschuksammler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa613bbe-47b5-442c-bbb5-f94cb637ba1a",
                        "source_entry_id": "4cfc6435-942c-37f7-928e-424f57e1c342",
