    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0c4dd138-1e6e-36bc-9dc5-7829cbaf0b50",
                "word": "varletry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "87660836-4cd0-334c-bd37-4dee7ee2d643",
                        "entry_id": "0c4dd138-1e6e-36bc-9dc5-7829cbaf0b50",
                        "glosses": [
                            "The rabble; the crowd; the mob."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c0c04d7-e0d1-41d6-92ae-250ba903c0c9",
                                "sense_id": "87660836-4cd0-334c-bd37-4dee7ee2d643",
                                "text": "the shouting varletry of censuring Rome"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19ef1c5e-543c-4ad2-961d-b3ef22add229",
                        "source_entry_id": "0c4dd138-1e6e-36bc-9dc5-7829cbaf0b50",
                        "source_sense_id": "87660836-4cd0-334c-bd37-4dee7ee2d643",
                        "source_sense_description": "the rabble, the crowd, the mob",
                        "target_lang_word": "сбро́д",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сбро́д",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1a41a9fa-489d-3cab-a777-9fe26a7a45ad",
                                        "entry_id": "6154e836-0a67-3b7a-9313-c211e383ed86",
                                        "glosses": [
                                            "устар. группа случайно собравшихся людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea9a814-d703-4ee3-b563-6d17c4a2ed82",
                                                "sense_id": "1a41a9fa-489d-3cab-a777-9fe26a7a45ad",
                                                "text": "Войско его состояло из двадцати пяти тысяч всякого сброду."
                                            },
                                            {
                                                "example_id": "107af9d8-4ba5-4d2f-b45a-acddbb930036",
                                                "sense_id": "1a41a9fa-489d-3cab-a777-9fe26a7a45ad",
                                                "text": "Возле коровы лежал гуляка-парубок с покрасневшим, как снегирь, носом; подале храпела, сидя, перекупка с кремнями, синькою, дробью и бубликами; под телегою лежал цыган; на возу с рыбой чумак; на самой дороге раскинул ноги бородач-москаль с поясами и рукавицами… ну, всякого сброду, как водится по ярмаркам."
                                            },
                                            {
                                                "example_id": "d1dcae3a-ec54-40b9-9df2-c52ce15ddc42",
                                                "sense_id": "1a41a9fa-489d-3cab-a777-9fe26a7a45ad",
                                                "text": "Мы — так… сброд, остатки каких-то неизвестных племён, какая-то разнобоярщина - бог знает что такое!"
                                            },
                                            {
                                                "example_id": "6b56ca8e-3903-4a8e-842f-9fe9fca785f1",
                                                "sense_id": "1a41a9fa-489d-3cab-a777-9fe26a7a45ad",
                                                "text": "Особенное обстоятельство привлекает его внимание: на это раз тут как будто гулянье, толпа разодетых мещанок, баб, их мужей и всякого сброду."
                                            },
                                            {
                                                "example_id": "7edc6cd1-5e6a-4e4e-b318-84c59ac10e6d",
                                                "sense_id": "1a41a9fa-489d-3cab-a777-9fe26a7a45ad",
                                                "text": "Ясно было, что в этом сброде новых людей много мошенников, но несомненно было, что много и честных, весьма даже привлекательных лиц, несмотря на некоторые всё-таки удивительные оттенки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e40e958e-2e94-3511-a786-fd06f6bbfbf5",
                                        "entry_id": "6154e836-0a67-3b7a-9313-c211e383ed86",
                                        "glosses": [
                                            "устар. случайное и беспорядочное соединение, сочетание чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4212ade6-50e1-4201-ad42-a611acb2fdd7",
                                                "sense_id": "e40e958e-2e94-3511-a786-fd06f6bbfbf5",
                                                "text": "Оно было наполнено такими странными намёками, таким сбродом противоположностей, что я сначала почти ничего и не понял."
                                            },
                                            {
                                                "example_id": "ee316662-a9c3-48b2-8fd6-185ce33f63c5",
                                                "sense_id": "e40e958e-2e94-3511-a786-fd06f6bbfbf5",
                                                "text": "Войдите внутрь магазинчика (дверь обыкновенно с пронзительным колокольчиком), и вы увидите куски материй, лампы, статуэтки, блонды и кружева, меха и книги, женские платья, несколько стенных и столовых часов, мебель и даже цветы. Вы бы наверное не поняли, что это за сброд продаётся тут, если б не вывеска над входом."
                                            },
                                            {
                                                "example_id": "d57a3d33-7423-4541-b912-2084179f6f4f",
                                                "sense_id": "e40e958e-2e94-3511-a786-fd06f6bbfbf5",
                                                "text": "Потом, спереди разведёт палисадник, в котором не то что гулять, а повернуться негде, а сзади и по бокам настроит людских, да застольных, да амбарушек, да клетушек - и пойдёт этот нескладный сброд строений чернеть и ветшать под влиянием времени и непогод, да наполняться грязью, навозом и вонью."
                                            },
                                            {
                                                "example_id": "a0002a62-077e-4e63-a786-b2ebef69d983",
                                                "sense_id": "e40e958e-2e94-3511-a786-fd06f6bbfbf5",
                                                "text": "— Но будем, друг, откровенны: этот сброд разнотипных и разношерстных судов при нашей безалаберности являет собою только пародию на боевую эскадру."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e568c56d-9562-37b8-b379-d9374531c0d3",
                                        "entry_id": "6154e836-0a67-3b7a-9313-c211e383ed86",
                                        "glosses": [
                                            "собир., перен., презр. преступные, морально опустившиеся, антиобщественные элементы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b79873-3dbd-447a-af5c-276dd894ba33",
                                                "sense_id": "e568c56d-9562-37b8-b379-d9374531c0d3",
                                                "text": "Русскими, кроме студенчества, были одни чинуши, и притом недавно слетевшиеся сюда, почуяв, что пахнет жареным - это был, определённо говоря, всякий сброд, отбросы русской нации - щедринские «господа ташкентцы»."
                                            },
                                            {
                                                "example_id": "772ff558-1266-46fc-bbfc-38b238e5a80e",
                                                "sense_id": "e568c56d-9562-37b8-b379-d9374531c0d3",
                                                "text": "То был подвыпивший, мрачный сброд, ничего не терявший, если бы ему даже приказали меня повесить."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
