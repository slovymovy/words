                "senses": [
                    {
                        "sense_id": "c2c9b724-d243-3560-b6fe-d9d974d79fb1",
                        "entry_id": "feabc534-6d50-3568-a30f-67bd0559595b",
                        "glosses": [
                            "eine Reihe besonderer Rechte, die in einer Stadt gelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a25798-1684-402b-9380-296129c935ec",
                                "sense_id": "c2c9b724-d243-3560-b6fe-d9d974d79fb1",
                                "text": "„Im frühen Mittelalter Königspfalz, war die Ortschaft um 1227 so gewachsen, daß sie das Stadtrecht vom Mainzer Landesherrn Bischof Siegfried II. verliehen bekam.“"
                            },
                            {
                                "example_id": "71e4f181-0101-485a-b443-d74cc614e8cd",
                                "sense_id": "c2c9b724-d243-3560-b6fe-d9d974d79fb1",
                                "text": "„Erst ein Jahr später, 1922, wurde ihm das Stadtrecht zuerkannt – und so wurde Hindenburg zur jüngsten Stadt des Deutschen Reiches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
