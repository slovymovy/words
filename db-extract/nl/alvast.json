                                                "example_id": "52b39ace-b28c-42d0-bdfc-2862164751f5",
                                                "sense_id": "026dce1e-8531-3762-add7-5de38ac0f458",
                                                "text": "Was kann die schon?"
                                            },
                                            {
                                                "example_id": "a4f35848-ae0d-43b8-b0b8-fff382a8e79e",
                                                "sense_id": "026dce1e-8531-3762-add7-5de38ac0f458",
