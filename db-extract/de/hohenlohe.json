                "senses": [
                    {
                        "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                        "entry_id": "e4eafeea-5f65-3b7d-bb7f-468f584e947d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda18a16-7855-4734-81ac-ac8859d302ff",
                                "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                                "text": "Frau Hohenlohe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f265a438-244f-4fa0-bd8e-36a3fe61827f",
                                "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                                "text": "Herr Hohenlohe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "06bcc602-e87c-4169-8ab0-f4e00070d0f1",
                                "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                                "text": "Die Hohenlohes fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "7db83a59-4a4c-4458-b672-8e5cde3087af",
                                "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                                "text": "Der Hohenlohe trägt nie die Pullover, die die Hohenlohe ihm strickt."
                            },
                            {
                                "example_id": "a1186936-f73c-44ff-82dc-6b38868cc2d1",
                                "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hohenlohe kommt, geht der Herr Hohenlohe.“"
                            },
                            {
                                "example_id": "675559f7-eead-4efc-a08e-02383a246521",
                                "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                                "text": "Hohenlohe kommt und geht."
                            },
                            {
                                "example_id": "b83486c5-9ada-402d-851a-01805146c729",
                                "sense_id": "ff87f5c4-750d-39ce-bfa5-14292cdb4bd5",
                                "text": "Hohenlohes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
