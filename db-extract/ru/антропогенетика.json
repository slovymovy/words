                "senses": [
                    {
                        "sense_id": "c1eb8e3b-b0a0-3c27-8de2-7f7d60be596c",
                        "entry_id": "fcf701ad-8062-3bbf-9b9f-59cde7028dd1",
                        "glosses": [
                            "биол. раздел генетики, изучающий законы наследственности и изменчивости человеческого организма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d96c117-29d1-43d2-9bf4-870ae308290a",
                                "sense_id": "c1eb8e3b-b0a0-3c27-8de2-7f7d60be596c",
                                "text": "…Прежде чем захватить в свои руки бразды правления собственной генетической судьбой, человек должен обладать гораздо более обширными сведениями в антропогенетике, чем те, которыми он обладает сейчас."
                            },
                            {
                                "example_id": "069d5504-221e-406c-a2e5-c2872cbadcb1",
                                "sense_id": "c1eb8e3b-b0a0-3c27-8de2-7f7d60be596c",
                                "text": "…Согласно данным молекулярной антропологии и антропогенетики, первые Homo sapiens (причём и Адам, и Ева) возникли в Африке, а уже затем распространились на другие континенты."
                            }
                        ]
                    }
