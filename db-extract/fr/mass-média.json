                    }
                ],
                "senses": [
                    {
                        "sense_id": "891da657-afd3-3102-9939-6f86de9e58af",
                        "entry_id": "1aa0a319-d1c9-3a2e-8b55-17b4d50b617b",
                        "glosses": [
                            "Média qui, de par sa large diffusion, s’adresse aux masses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522c0d8c-1ed2-4057-89d3-23b1c3f9c55a",
                                "sense_id": "891da657-afd3-3102-9939-6f86de9e58af",
                                "text": "Les mass-médias sont responsables de la sinistrose ambiante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a434515-09b8-4140-90d0-f4ccbfa62d46",
                        "source_entry_id": "1aa0a319-d1c9-3a2e-8b55-17b4d50b617b",
                        "source_sense_id": "891da657-afd3-3102-9939-6f86de9e58af",
                        "target_lang_word": "Massenmedium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massenmedium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "815d6338-5ce2-3433-ac9f-41902da16cbd",
                                        "entry_id": "75c44ccf-661b-3a2a-841a-46e12d4e089c",
                                        "glosses": [
                                            "technisch produziertes Kommunikationsmittel, das der Übermittlung von Informationen unterschiedlichster Art an große Gruppen von Menschen dient"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14ef3cd1-1f65-4c1c-8f0b-d9411c33f3e6",
                                                "sense_id": "815d6338-5ce2-3433-ac9f-41902da16cbd",
                                                "text": "„Das Radio war das erste elektronische Massenmedium.“"
                                            },
                                            {
                                                "example_id": "fd227e1c-4633-42f7-9778-0528ea9e8ad5",
                                                "sense_id": "815d6338-5ce2-3433-ac9f-41902da16cbd",
                                                "text": "„Was wir über unsere Gesellschaft, ja über die Welt, in der wir leben, wissen, wissen wir durch die Massenmedien.“"
                                            },
                                            {
                                                "example_id": "77186951-8377-48d2-9f26-a4b14ff46e16",
                                                "sense_id": "815d6338-5ce2-3433-ac9f-41902da16cbd",
                                                "text": "„Dies gilt nicht nur im Hinblick auf die Massenmedien; auch andere Ursachen haben die Kommunikation weiträumiger gemacht.“"
                                            },
                                            {
                                                "example_id": "d2098a2f-546d-41df-bfa7-5eeee08e7623",
                                                "sense_id": "815d6338-5ce2-3433-ac9f-41902da16cbd",
                                                "text": "„Die Massenmedien Radio und Fernsehen führen heute zu einer weiten Verbeitung mündlicher Hochsprache, die um 1900 als Bühnenhochsprache festgelegt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84827742-e8e3-4196-b3f7-f1721c11957d",
                        "source_entry_id": "1aa0a319-d1c9-3a2e-8b55-17b4d50b617b",
                        "source_sense_id": "891da657-afd3-3102-9939-6f86de9e58af",
                        "target_lang_word": "mass medium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mass medium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c2e43a5-4b73-3653-80d4-21b8bb8aab95",
                                        "entry_id": "a90aa279-8262-3f23-8950-89f4db25e1b1",
                                        "glosses": [
                                            "Any means of public communication that reaches a large audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459db53d-1d6e-434e-9ce3-46cd4502a6bc",
                                                "sense_id": "6c2e43a5-4b73-3653-80d4-21b8bb8aab95",
                                                "text": "The Inquirer seems to be the morning paper that reaches the greatest number of the masses, but touches the classes hardly at all. The North American is second as a mass medium, perhaps, and Philadelphia authorities credit it with considerable circulation among women on account of its fashion news, furnished through the Wanamaker store."
                                            },
                                            {
                                                "example_id": "9f2e0d16-24b7-4c77-9687-c28348d89a41",
                                                "sense_id": "6c2e43a5-4b73-3653-80d4-21b8bb8aab95",
                                                "text": "It is obviously impossible to sell the average technical product to the several million readers of a big mass medium because they have neither the means nor the need for it."
                                            },
                                            {
                                                "example_id": "2cbd9deb-4c8e-4796-8b83-a0d725b6a218",
                                                "sense_id": "6c2e43a5-4b73-3653-80d4-21b8bb8aab95",
                                                "text": "Newspaper advertising is the backbone of our whole sales program. We look upon newspapers as a mass medium having practically universal acceptance by the public."
                                            },
                                            {
                                                "example_id": "7ff4a664-54d5-4992-a88d-96c5ef739217",
                                                "sense_id": "6c2e43a5-4b73-3653-80d4-21b8bb8aab95",
                                                "text": "The movie is to dramatic representation what the book was to the manuscript. It makes available to many and at many times and places what otherwise would be restricted to a few at few times and places. The movie, like the book, is a ditto device. TV shows to 50,000,000 simultaneously. Some feel that the value of experiencing a book is diminished by being extended to many minds. This notion is always implicit in the phrases “mass media,” “mass entertainment”—useless phrases obscuring the fact that English itself is a mass medium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b59efdcf-1e99-4d41-ad1b-898f6e779ab9",
                        "source_entry_id": "1aa0a319-d1c9-3a2e-8b55-17b4d50b617b",
                        "source_sense_id": "891da657-afd3-3102-9939-6f86de9e58af",
