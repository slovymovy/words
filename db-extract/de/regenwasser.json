                    {
                        "translation_id": "5ccec65e-a38f-4d90-8e34-39db4faa0dea",
                        "source_entry_id": "e0a51be7-9448-383d-b80c-a0d35078daa8",
                        "source_sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                        "source_sense_description": "Wasser aus natürlichem Niederschlag, das nicht durch Gebrauch verunreinigt wurde",
                        "target_lang_word": "rainwater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rainwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd022ed-0aae-3c94-a585-13bf84b26330",
                                        "entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                                        "glosses": [
                                            "Rainfall."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fda84d-264b-4577-9427-efd276951cbd",
                                                "sense_id": "2bd022ed-0aae-3c94-a585-13bf84b26330",
                                                "text": "In early December, as rainwaters had started the monthlong process of flooding mines and washing out rail lines, workers lined up before 1 p.m. at an easy-to-miss storefront depot in Mackay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b85ff13d-8031-32e9-98a9-dd04ab4bb80e",
                                        "entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                                        "glosses": [
                                            "Water (for a house, etc.) sourced from rain which has not joined a spring, stream or river, pond, lake or sea."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d8d3cde-59b6-4024-8470-b2dea0acac04",
                                                "sense_id": "b85ff13d-8031-32e9-98a9-dd04ab4bb80e",
                                                "text": "Constructed of hard flint stone, which came as ballast from England and is now painted coral white, the house has a fishpond, or catchment, roof, dating from 1788, to collect rainwater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eddee87-d7de-4362-b0a9-91755f9b2c8e",
                        "source_entry_id": "e0a51be7-9448-383d-b80c-a0d35078daa8",
                        "source_sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                        "source_sense_description": "Wasser aus natürlichem Niederschlag, das nicht durch Gebrauch verunreinigt wurde",
                        "target_lang_word": "eau de pluie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau de pluie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04f45f52-0043-3f26-bfb5-3882afe59d37",
                                        "entry_id": "93df090d-82fc-366b-86c7-13082ff068fe",
                                        "glosses": [
                                            "Eau telle qu’elle tombe d’un nuage en se condensant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4f7452-2121-493c-8f96-a5d0a32023d1",
                                                "sense_id": "04f45f52-0043-3f26-bfb5-3882afe59d37",
                                                "text": "L’eau de pluie contient en dissolution toutes les substances qui existent dans l’air, telles que l’oxygène, l’azote, l’acide carbonique, de petites quantités d’acide azotique, de carbonate d’ammoniaque, ou d’azotate d’ammoniaque."
                                            },
                                            {
                                                "example_id": "03476889-bace-4da7-87c2-6ed177f788d0",
                                                "sense_id": "04f45f52-0043-3f26-bfb5-3882afe59d37",
                                                "text": "À Nancy, nous avons créé des jardins d’eau alimentés grâce à la récupération d’eau de pluie et de trop pleins de la Meurthe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dec89bb2-10cf-40ba-8221-23c46c236684",
                        "source_entry_id": "e0a51be7-9448-383d-b80c-a0d35078daa8",
                        "source_sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                        "source_sense_description": "Wasser aus natürlichem Niederschlag, das nicht durch Gebrauch verunreinigt wurde",
                        "target_lang_word": "eau pluviale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau pluviale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea852b47-faa6-300a-a5ed-92d62f5c0d95",
                                        "entry_id": "5dc955e9-479a-327a-b041-e33bd1f4b635",
                                        "glosses": [
                                            "Eau de pluie, de neige fondue, etc. après avoir touché le sol ou une surface construite ou naturelle susceptible de l’intercepter ou de la récupérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b6e9d35-612a-4ca1-97e1-c8471ecd309f",
                                                "sense_id": "ea852b47-faa6-300a-a5ed-92d62f5c0d95",
                                                "text": "Les terres en général sont froides et compactes ; les eaux pluviales s'y infiltrent lentement et les rendent fort humides pendant l'hiver et le printemps ; on les désigne, dans le pays, sous le nom de gruette et de bournais."
                                            },
                                            {
                                                "example_id": "b8af71e0-22b0-4f43-b45d-aea74f290aac",
                                                "sense_id": "ea852b47-faa6-300a-a5ed-92d62f5c0d95",
                                                "text": "Les eaux pluviales peuvent être rejetées directement dans la nature."
                                            },
                                            {
                                                "example_id": "4b7dd9a3-ff4c-4df8-ae48-618878bd0b09",
                                                "sense_id": "ea852b47-faa6-300a-a5ed-92d62f5c0d95",
                                                "text": "Derrière \"imperméabilisation des sols\", il faut comprendre le recouvrement des terres par des routes et des constructions, qui ne permettent plus au sol d'absorber l’eau pluviale."
                                            },
                                            {
                                                "example_id": "19a6a961-1f9f-407f-8202-eb49bcaaf421",
                                                "sense_id": "ea852b47-faa6-300a-a5ed-92d62f5c0d95",
                                                "text": "Invisibles à l’œil nu, ces micropolluants sont emportés dans les eaux pluviales et usées qui se déversent dans les stations de traitement où ils ne font finalement que passer."
                                            },
                                            {
                                                "example_id": "cda52447-0cf4-4151-8cd5-8cf91a41a371",
                                                "sense_id": "ea852b47-faa6-300a-a5ed-92d62f5c0d95",
                                                "text": "“C’est un problème au niveau d’un dalot bouché par des déchets verts et autres détritus, accentué par la pluie, alors l’eau pluviale est passée sur la route, déformant la chaussée à certains endroits.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
