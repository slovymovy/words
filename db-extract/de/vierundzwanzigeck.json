                ],
                "senses": [
                    {
                        "sense_id": "ba2c4e59-b05c-3d18-85d7-bbd911f34f74",
                        "entry_id": "15407dad-b72b-31a3-bafb-ffb79f49deb8",
                        "glosses": [
                            "geometrische Figur mit vierundzwanzig Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "25aba249-d53d-4138-a667-ad2172a4b0ba",
                                "sense_id": "ba2c4e59-b05c-3d18-85d7-bbd911f34f74",
                                "text": "„Im ersten Teil behandelt er allgemeine Probleme des Festungsbaus, im Teil regelmäßige Polygonalanlagen vom Sechseck bis zum Vierundzwanzigeck, im dritten Teil unregelmäßige Anlagen, im vierten Teil vom Gelände bedingte Befestigungen.“"
                            },
                            {
                                "example_id": "33651e77-ad54-42e7-8733-5d1ad47af034",
                                "sense_id": "ba2c4e59-b05c-3d18-85d7-bbd911f34f74",
                                "text": "„2. für das regelmäßige Sechseck, Zwölfeck, Vierundzwanzigeck usw., […]“"
                            },
                            {
                                "example_id": "fb40967b-60fb-47fd-bfa9-eb38697f01f6",
                                "sense_id": "ba2c4e59-b05c-3d18-85d7-bbd911f34f74",
                                "text": "„Achteck, Sechzehneck usw. erhält man durch Halbieren der Zentriwinkel des Quadrats; Zwölfeck, Vierundzwanzigeck usw. durch Halbieren der Zentriwinkel des Sechsecks.“"
                            },
                            {
                                "example_id": "767bdda2-7465-4967-b365-fa228e656d13",
                                "sense_id": "ba2c4e59-b05c-3d18-85d7-bbd911f34f74",
                                "text": "„Von weitem wirkte der Querschnitt des Luftschiffes rund, aus der Nähe betrachtet, konnte man jedoch deutlich ein Vierundzwanzigeck als Querschnittsfläche erkennen.“"
                            },
                            {
                                "example_id": "3d2b9423-bbe6-4f4b-8f62-f4a7ad52d36f",
                                "sense_id": "ba2c4e59-b05c-3d18-85d7-bbd911f34f74",
                                "text": "„Als Beispiel ist hier ein System (siehe Abb. 7 und 8 auf Blatt 18) gewählt, welches den ausgeführten Schwedler’schen ähnlich ist, nämlich ein Vierundzwanzigeck mit vier Ringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
