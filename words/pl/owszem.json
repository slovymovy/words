{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "7ef04d15-1996-3a28-a4d3-cbe51bd7517f",
                    "sense_definition": "Słowo wyrażające potwierdzenie lub zgodę, używane jako odpowiedź twierdząca na pytanie lub wypowiedź.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy masz ochotę na spacer? – <w>Owszem</w>, chętnie pójdę.",
                            "target_lang_translations": {
                                "ru": "Хочешь прогуляться? – <w>Конечно</w>, с удовольствием пойду.",
                                "es": "¿Te apetece dar un paseo? – <w>Claro</w>, voy con mucho gusto."
                            }
                        },
                        {
                            "text": "Słyszałem, że zdałeś egzamin. – <w>Owszem</w>, poszło mi całkiem nieźle.",
                            "target_lang_translations": {
                                "ru": "Я слышал, ты сдал экзамен. – <w>Да</w>, всё прошло довольно неплохо.",
                                "es": "Oí que aprobaste el examen. – <w>Sí</w>, me fue bastante bien."
                            }
                        }
                    ],
                    "synonyms": [
                        "tak",
                        "oczywiście",
                        "naturalnie",
                        "jak najbardziej",
                        "rzeczywiście"
                    ],
                    "common_phrases": [
                        "ależ owszem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, выражающее подтверждение или согласие, используемое как утвердительный ответ на вопрос или высказывание.",
                        "es": "Palabra que expresa afirmación o acuerdo, utilizada como respuesta afirmativa a una pregunta o comentario."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "универсальный утвердительный ответ"
                            },
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "выражение уверенного согласия"
                            },
                            {
                                "target_lang_word": "разумеется",
                                "target_lang_sense_clarification": "формальное или категоричное подтверждение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sí",
                                "target_lang_sense_clarification": "respuesta afirmativa general"
                            },
                            {
                                "target_lang_word": "claro",
                                "target_lang_sense_clarification": "afirmación enfática o de acuerdo"
                            },
                            {
                                "target_lang_word": "por supuesto",
                                "target_lang_sense_clarification": "confirmación segura y cordial"
                            },
                            {
                                "target_lang_word": "naturalmente",
                                "target_lang_sense_clarification": "afirmación lógica o evidente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dfa51b2-553d-3227-a9cf-b55be6b2f6e2",
                    "sense_definition": "Słowo używane do zaprzeczenia negatywnej sugestii rozmówcy i potwierdzenia, że dana czynność lub stan ma jednak miejsce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contradiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Ty pewnie nigdy nie byłeś za granicą. — <w>Owszem</w>, byłem, i to kilka razy.",
                            "target_lang_translations": {
                                "ru": "— Ты, наверное, никогда не был за границей. — <w>Почему же</w>, был, и даже несколько раз.",
                                "es": "— Seguro que nunca has estado en el extranjero. — <w>Pues sí</w>, he estado, y varias veces."
                            }
                        },
                        {
                            "text": "Nie masz chyba zamiaru tam iść? – <w>Owszem</w>, właśnie tam idę.",
                            "target_lang_translations": {
                                "ru": "Ты ведь не собираешься туда идти? – <w>Да</w>, как раз туда я и иду.",
                                "es": "¿No pensarás ir allí? – <w>Al contrario</w>, justo hacia allá me dirijo."
                            }
                        }
                    ],
                    "synonyms": [
                        "tak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, используемое для возражения на отрицательное предположение собеседника и подтверждения того, что действие или состояние действительно имеет место.",
                        "es": "Palabra utilizada para contradecir una suposición negativa del interlocutor y confirmar que el hecho o estado sí se da."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "усиленное утверждение вопреки сомнению"
                            },
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "подтверждение факта"
                            },
                            {
                                "target_lang_word": "напротив",
                                "target_lang_sense_clarification": "опровержение отрицания"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sí",
                                "target_lang_sense_clarification": "afirmación en contraposición a una negación"
                            },
                            {
                                "target_lang_word": "al contrario",
                                "target_lang_sense_clarification": "para refutar una afirmación o duda negativa"
                            },
                            {
                                "target_lang_word": "pues sí",
                                "target_lang_sense_clarification": "respuesta enfática contradiciendo la sospecha ajena"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "1f98ad5a-b460-3431-9481-3e41f317f757",
                    "sense_definition": "Słowo łączące zdania, wprowadzające dopowiedzenie, które potwierdza i wzmacnia treść poprzedniej części wypowiedzi.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten projekt nie jest zły, <w>owszem</w>, jest jednym z najlepszych w tym roku.",
                            "target_lang_translations": {
                                "ru": "Этот проект неплох, <w>более того</w>, он один из лучших в этом году.",
                                "es": "Este proyecto no es malo; <w>es más</w>, es uno de los mejores de este año."
                            }
                        },
                        {
                            "text": "Nikt nie miał do niego pretensji, <w>owszem</w>, wszyscy byli mu wdzięczni.",
                            "target_lang_translations": {
                                "ru": "Никто не имел к нему претензий, <w>наоборот</w>, все были ему благодарны.",
                                "es": "Nadie le guardaba rencor; <w>al contrario</w>, todos le estaban agradecidos."
                            }
                        }
                    ],
                    "synonyms": [
                        "a nawet",
                        "co więcej",
                        "ba",
                        "powiem więcej"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, связывающее предложения и вводящее дополнение, которое подтверждает и усиливает смысл предыдущей части высказывания.",
                        "es": "Conector que une oraciones introduciendo una precisión que confirma e intensifica lo dicho anteriormente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более того",
                                "target_lang_sense_clarification": "вводная конструкция для усиления сказанного"
                            },
                            {
                                "target_lang_word": "и даже",
                                "target_lang_sense_clarification": "союз, добавляющий усиливающую информацию"
                            },
                            {
                                "target_lang_word": "наоборот",
                                "target_lang_sense_clarification": "в значении противопоставления ожидаемому"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "es más",
                                "target_lang_sense_clarification": "para añadir un dato que intensifica lo anterior"
                            },
                            {
                                "target_lang_word": "más bien",
                                "target_lang_sense_clarification": "para corregir y reforzar la idea previa"
                            },
                            {
                                "target_lang_word": "al contrario",
                                "target_lang_sense_clarification": "para oponer con fuerza a una negación precedente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}