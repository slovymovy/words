                "senses": [
                    {
                        "sense_id": "b24b7953-dcf3-32ce-8bb9-9202b9adb68a",
                        "entry_id": "393e18dd-ef29-3def-8650-b93452417ab6",
                        "glosses": [
                            "Haushaltsgerät: ein Fach zur Kühlung von Lebensmitteln, ein abgetrennter Bereich im Kühlschrank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50724fbd-17c1-43cc-a201-1b0fc45c736e",
                                "sense_id": "b24b7953-dcf3-32ce-8bb9-9202b9adb68a",
                                "text": "Es empfiehlt sich, hin und wieder das Kühlfach zu reinigen."
                            },
                            {
                                "example_id": "5c44378d-29f2-48d6-a3a8-56f13a59aa39",
                                "sense_id": "b24b7953-dcf3-32ce-8bb9-9202b9adb68a",
                                "text": "Im Kühlfach gibt es Wurst und Käse."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85be2f2d-48ce-4e6c-baf5-cce69ce5dba0",
                        "source_entry_id": "393e18dd-ef29-3def-8650-b93452417ab6",
                        "source_sense_id": "b24b7953-dcf3-32ce-8bb9-9202b9adb68a",
                        "source_sense_description": "Haushaltsgerät: ein Fach zur Kühlung von Lebensmitteln, ein abgetrennter Bereich im Kühlschrank",
                        "target_lang_word": "refrigerator shelf",
