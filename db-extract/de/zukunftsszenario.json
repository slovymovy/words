                        "entry_id": "afb758a6-e138-3d5f-91c8-455ae95bc505",
                        "glosses": [
                            "(bildliche) Vorstellung von zukünftigen Geschehnissen und Umständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "229942c6-b8d9-4414-b609-2095d352429f",
                                "sense_id": "eef20376-cb14-3a49-b4bd-5a6b20f551f2",
                                "text": "„Das Zukunftsszenario in einem Überwachungsstaat nach Abschaffung des Bargelds unter der Herrschaft einer winzigen Finanzelite bringt den Leser zu einem Vergleich mit seiner Gegenwart.“"
                            },
                            {
                                "example_id": "90e46b4f-10bf-4943-9ac0-1eb49d28456e",
                                "sense_id": "eef20376-cb14-3a49-b4bd-5a6b20f551f2",
                                "text": "„Rachel Franklin entwirft in ihrem Wissenschafts-Thriller ein bedrohliches Zukunftsszenario um Klimawandel, Ressourcenknappheit und den Kampf um das schwarze Gold.“"
                            }
                        ],
