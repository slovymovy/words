                "senses": [
                    {
                        "sense_id": "d5d31874-e48e-3333-b6ef-37766757908d",
                        "entry_id": "902d3ae9-9d6c-3dbd-8f8a-7b4d50402332",
                        "glosses": [
                            "gebied met veel drassige terreinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026bbf40-f799-4e47-a25b-56ea55b5a28f",
                                "sense_id": "d5d31874-e48e-3333-b6ef-37766757908d",
                                "text": "Vanavond werd ik verplicht om naast graaf Bryston plaats te nemen, een pretentieuze blaaskaak die zeer weinig aan het hof is geweest. Hij is de bestuurder van een of ander godverlaten moerasland in het noorden en verkeert blijkbaar in de veronderstelling dat hij, vanwege de loyaliteit van zijn voorouders aan het koningshuis, over de koninklijke familie mag zeggen wat hij wil."
                            },
                            {
                                "example_id": "4e5cf89d-5aa6-4b13-bcb3-ddd785adc0af",
                                "sense_id": "d5d31874-e48e-3333-b6ef-37766757908d",
                                "text": "De strenge voorzorgen hebben alles te maken met de unieke situatie op het Museumplein. Het heeft een ondergrond die veel weg heeft van pudding en grenst daarnaast aan belangrijke musea. ,,Het is moerasland”, zegt Kuilboer. ,,Als de grond in beweging komt, klotst die tegen de gebouwen aan.” Het protocol moet ervoor zorgen dat er geen schade wordt aangericht in de musea en woonhuizen in de omgeving."
                            }
                        ]
                    }
