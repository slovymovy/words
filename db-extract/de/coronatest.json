                ],
                "senses": [
                    {
                        "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                        "entry_id": "ae052c1f-c043-3b81-a045-411184003bb0",
                        "glosses": [
                            "Untersuchung (Test), die feststellt, ob eine Ansteckung mit SARS-CoV-2 (Coronavirus) vorliegt/vorlag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96c7df4-ba3a-4dc3-afec-5a69d4d7b7ff",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„Seit dem 9. März wurden in der Kirche knapp 10'000 Coronatests gemacht, 10 Prozent davon fielen positiv aus.“"
                            },
                            {
                                "example_id": "98a1047e-96f7-484e-9b1a-ee9cdce9760a",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "Coronatests ersetzen weder Abstands- noch Hygieneregeln."
                            },
                            {
                                "example_id": "67bc435f-0fd7-4237-8127-2cc4d7e7642c",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„Reisende, die aus einem Risikogebiet einreisen wollen, müssen einen negativen Coronatest vorlegen, der nicht älter als 48 Stunden ist.“"
                            },
                            {
                                "example_id": "e3e2316d-2eca-45a5-bc73-5cf65e723bff",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„»Gäste sind in Schleswig-Holstein herzlich willkommen. Und das gilt selbstverständlich auch für Urlauber aus einem Risikogebiet, die einen negativen Coronatest haben«, sagte Tourismusminister Bernd Buchholz (FDP).“"
                            },
                            {
                                "example_id": "e0129423-e9cd-4814-80ca-ca9667794946",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„[…] in New York [mussten] Menschen für Coronatests Schlange stehen […]“"
                            },
                            {
                                "example_id": "3ff8fa26-3259-4cb0-96c6-c3d8bba9a966",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„Beim VfB Stuttgart kam es bei Coronatests jüngst zu einem »unklaren Befund«.“"
                            },
                            {
                                "example_id": "fc543211-f584-4423-a4cc-eb8b324c5c7b",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„»Von dem Moment an, wo die Spieler in Berlin landen und den ersten Coronatest abgeben - der natürlich negativ sein muss - werden sie sich unserem sehr strikten Regulativ unterziehen müssen«\", sagte Weindorfer dem Fernsehsender rbb […].“"
                            },
                            {
                                "example_id": "17e7fb92-4fff-4e18-b79e-c07338e6ec48",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„Kaum hustet ein Schulkind, wird es zum Coronatest geschickt.“"
                            },
                            {
                                "example_id": "20ae2ab9-d499-4f02-bc55-d2065f676e9a",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„Wer Kinder hat weiß: Laufende Nasen gehören zum Alltag. Viele Eltern wenden sich deshalb an Kinderärzte und lassen Coronatests machen, um arbeiten zu können.“"
                            },
                            {
                                "example_id": "d7393cc5-ebd4-4a05-86b2-02043d8f1a7c",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "Ab Juli 2020 werden in Deutschland für einen Coronatest knapp 40 Euro vergütet."
                            },
                            {
                                "example_id": "4ef43f9f-4eaa-4b00-baf5-615f65abf0c9",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "„[Das] Bundesamtes für Gesundheit (BAG) [setzt] den Tarif für den Coronatest bis Ende April bei 180 Franken [an]. Per 30. April 2020 wurde der Tarif dann gesenkt auf 95 Franken.“"
                            },
                            {
                                "example_id": "d0ee3339-c2e2-44e5-b84b-b089bbfc05d4",
                                "sense_id": "cdb2d243-01f9-3631-b5c6-f49d6939431f",
                                "text": "[Schlagzeile:] „Südkoreas Biotechnologiefirmen arbeiten an neuen Coronatests“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
