        "fr-extract.jsonl": [
            {
                "entry_id": "a4285126-0fa3-31a3-b28a-9331b8d80769",
                "word": "méritocratique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "afb528e3-156c-4253-874d-73fe9afca344",
                        "entry_id": "a4285126-0fa3-31a3-b28a-9331b8d80769",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "méritocratiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c421429-a0b0-30df-82e2-26302d0ae0a0",
                        "entry_id": "a4285126-0fa3-31a3-b28a-9331b8d80769",
                        "glosses": [
                            "Relatif à la méritocratie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66aae95b-9e1d-43a2-9ce8-6e379f11c83c",
                                "sense_id": "6c421429-a0b0-30df-82e2-26302d0ae0a0",
                                "text": "Que le principe de la domination des plus compétents ait finalement abouti à une transformation du système social n’était évidemment pas imaginé – mais encore aujourd’hui, le discours méritocratique sert dans de nombreux pays (dont la France) à reproduire les structures sociales, en masquant la réalité de la distribution inégale des chances d’accès au capital scolaire."
                            },
                            {
                                "example_id": "d6618a69-4c20-4cb4-b147-3213a614ac81",
                                "sense_id": "6c421429-a0b0-30df-82e2-26302d0ae0a0",
                                "text": "Une société plus méritocratique ne connaît pas nécessairement une plus forte mobilité sociale. ."
                            },
                            {
                                "example_id": "3b9de844-e195-470a-9846-3c8ee4703173",
                                "sense_id": "6c421429-a0b0-30df-82e2-26302d0ae0a0",
                                "text": "Dans les concours ou sur Parcoursup – avec la « fiche avenir » – on n’attend pas seulement des titres scolaires, mais aussi une capacité à se mettre en scène. Ainsi, le mérite n’est plus seulement un principe de justice, c’est un mode de récit de soi : on s’insère dans un récit qui correspond au mythe méritocratique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "013fdd19-cac9-46a1-8e53-0a566e4f29bf",
                        "source_entry_id": "a4285126-0fa3-31a3-b28a-9331b8d80769",
                        "source_sense_id": "6c421429-a0b0-30df-82e2-26302d0ae0a0",
                        "target_lang_word": "meritokratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meritokratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "850cd526-a31b-3eb3-9845-7faa602ee600",
                                        "entry_id": "57e58abd-a4f5-3826-a596-53361d5e1b16",
                                        "glosses": [
                                            "die Meritokratie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1036fdea-4193-4cd1-9ed8-8658b6a31fff",
                                                "sense_id": "850cd526-a31b-3eb3-9845-7faa602ee600",
                                                "text": "In einer meritokratischen Gesellschaft zählt allein die Leistung des Einzelnen."
                                            },
                                            {
                                                "example_id": "80929166-dbbc-4e2e-87ca-7bbd83c4d556",
                                                "sense_id": "850cd526-a31b-3eb3-9845-7faa602ee600",
                                                "text": "„Unsere demokratischen Gesellschaften stützen sich in der Tat auf eine meritokratische Weltsicht oder zumindest auf eine meritokratische Hoffnung, das heißt den Glauben an eine Gesellschaft, in der Ungleichheiten auf Verdienst und Arbeit eher denn auf Herkunft und Kapitalrendite beruhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a31d98eb-70e3-4193-aead-f03b55ff8382",
                        "source_entry_id": "a4285126-0fa3-31a3-b28a-9331b8d80769",
                        "source_sense_id": "6c421429-a0b0-30df-82e2-26302d0ae0a0",
                        "target_lang_word": "meritocratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meritocratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80bff7f8-273a-3d2f-8377-4bd416007bdc",
                                        "entry_id": "4537df35-dc00-39c9-b30b-8f3fc4598cac",
                                        "glosses": [
                                            "Pertaining to a meritocracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc99246-f52b-4705-a897-666789e3b149",
                                                "sense_id": "80bff7f8-273a-3d2f-8377-4bd416007bdc",
                                                "text": "Sixty years on from Young’s book, a pure product of meritocratic training has emerged to write what he hopes will be the epitaph for his class."
                                            },
                                            {
                                                "example_id": "c91f51ab-fd25-429f-8184-06dec53262f9",
                                                "sense_id": "80bff7f8-273a-3d2f-8377-4bd416007bdc",
                                                "text": "And now Mr. Markovits is taking his message to the masses, with a big new book arguing that the meritocratic ideal has not only fed rampant inequality and hollowed out the middle class, but also threatens democracy itself."
                                            },
                                            {
                                                "example_id": "095b3db7-efae-42d5-b4b7-79932038cda6",
                                                "sense_id": "80bff7f8-273a-3d2f-8377-4bd416007bdc",
                                                "text": "But while the meritocratic system was intended to democratize American society, argues Yale Law School’s Daniel Markovits in his book The Meritocracy Trap, it has instead contributed to increasing inequality and the decline of the middle class."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89ea24ef-e460-416c-ac76-1a70c5194bc0",
