                ],
                "senses": [
                    {
                        "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                        "entry_id": "cbd0b74a-b10b-3b4a-b9d0-42991d011398",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f84cb5-43e2-440d-9ed1-903f9bdd8334",
                                "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                                "text": "Frau Meyerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6d513415-6554-4fa0-b275-549e3e72e084",
                                "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                                "text": "Herr Meyerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e7c19cb2-9777-40dd-b776-c8c9c903c0be",
                                "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                                "text": "Die Meyerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "efad8a2f-5140-46e7-bd99-4f7edd607896",
                                "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                                "text": "Der Meyerle trägt nie die Pullover, die die Meyerle ihm strickt."
                            },
                            {
                                "example_id": "b2b0fb3d-bf33-4d55-9484-0d78ab8db6ad",
                                "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meyerle kommt, geht der Herr Meyerle.“"
                            },
                            {
                                "example_id": "c8f64d62-cd91-4eb2-8fcf-c337f565d6e9",
                                "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                                "text": "Meyerle kommt und geht."
                            },
                            {
                                "example_id": "bb901aaa-8b9c-4830-9e38-75176e2b5bb1",
                                "sense_id": "67995504-434b-309d-b270-5b6a2c633f4e",
                                "text": "Meyerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
