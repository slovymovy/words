                    {
                        "translation_id": "b7ee105a-9fee-4624-a39e-ad56d6982d98",
                        "source_entry_id": "dddd269f-d31a-3f33-922c-387ebf500031",
                        "source_sense_id": "a229830f-5dec-3b68-b8ef-440e3e6b3dd1",
