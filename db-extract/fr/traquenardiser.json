                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e0fedbc-b2b1-4282-92fc-137c871943ce",
                                "sense_id": "b64824f1-8179-32c0-a963-a4a435ac8ff1",
                                "text": "sur ce, je me suis encore fait traquenardiser par mon ordinateur, et j'ai cours a 9h demain et je vais encore être frais comme une vieille sardine."
                            },
                            {
                                "example_id": "2eed7cd9-b607-4bfb-81c2-ef70aae55413",
                                "sense_id": "b64824f1-8179-32c0-a963-a4a435ac8ff1",
                                "text": "Mais UN JT sur France 2 ou TF1 ou France 3 qui ait manqué à traquenardiser son invité, j'en aucun souvenir."
                            },
                            {
                                "example_id": "2a31643e-640c-4477-8070-db168110fe4e",
                                "sense_id": "b64824f1-8179-32c0-a963-a4a435ac8ff1",
                                "text": "Voilà comment on se fait avoir, appâter, attraper, traquenardiser, piéger quoi !"
                            }
                        ]
                    }
