                    },
                    {
                        "translation_id": "e1eca094-72e0-4710-9b6e-cca9e1e9b025",
                        "source_entry_id": "3fe68285-f64c-3c1b-b791-0256b6f4c016",
                        "source_sense_description": "общепринятое употребление слов и выражений",
                        "target_lang_word": "usus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a32b1307-4a75-31ca-9e75-874063384854",
                                        "entry_id": "90bcff90-60c9-3c58-b4c2-2f270342277d",
                                        "glosses": [
                                            "Droit d’usage d’un bien."
                                        ],
                                        "tags": [
                                            "Latinisme en droit",
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e77db2af-7689-401a-9ad4-4e37dbb931aa",
                                                "sense_id": "a32b1307-4a75-31ca-9e75-874063384854",
                                                "text": "L’usus est l’une des trois composantes du droit de propriété."
                                            },
                                            {
                                                "example_id": "78dcd462-12bf-493f-a9cc-ab052b78cca9",
                                                "sense_id": "a32b1307-4a75-31ca-9e75-874063384854",
                                                "text": "Lecture et écriture autorisent donc la maîtrise de la langue et l’exercice qui combine le mieux ces deux usus quotidiens, c’est la rétroversion, d’abord des textes cicéroniens puis plus tard des textes empruntés à Virgile et à Horace."
                                            },
                                            {
                                                "example_id": "5b9b74ab-c502-4f7f-9625-610b484f951c",
                                                "sense_id": "a32b1307-4a75-31ca-9e75-874063384854",
                                                "text": "Pour illustrer, l’usus renvoie par exemple au fait qu’on puisse manger ou non les fruits des pommiers du verger situé sur notre terrain."
                                            },
                                            {
                                                "example_id": "72a60dfd-4e31-4f32-821e-edd99f980dfd",
                                                "sense_id": "a32b1307-4a75-31ca-9e75-874063384854",
                                                "text": "Pour en finir avec le système féodal des propriétés simultanées, composé de liens de dépendance et d’obligations mutuelles, de droits coutumiers d’accès et d’usage, la bourgeoisie française s’octroie à la Révolution un « super droit réel » fondé sur le fameux triptyque « usus, fructus, abusus » [Vanuxem, 2018]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
