        "nl-extract.jsonl": [
            {
                "entry_id": "3ec2a884-c2a4-3677-9353-2e062d739884",
                "word": "katterigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1f0aab88-5c54-4363-b38c-4be676cccb94",
                        "entry_id": "3ec2a884-c2a4-3677-9353-2e062d739884",
                        "tags": [
                            "plural"
                        ],
                        "form": "katterigheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a40548cd-3874-3e5e-9b27-78d074c1a41c",
                        "entry_id": "3ec2a884-c2a4-3677-9353-2e062d739884",
                        "glosses": [
                            "een vervelend lichamelijk gevoel dat kan ontstaan na overmatig alcoholgebruik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d9e974e-c4a4-4908-972b-07f02a26426b",
                                "sense_id": "a40548cd-3874-3e5e-9b27-78d074c1a41c",
                                "text": "Quispel had bij het ontbijt nooit iets anders gedronken dan een half flesje champagne tegen zijn katterigheid."
                            },
                            {
                                "example_id": "b96e71bc-d696-451a-abd3-84a1a44ea0b2",
                                "sense_id": "a40548cd-3874-3e5e-9b27-78d074c1a41c",
                                "text": "Drie van de vier vrienden, onder wie Sebastiaan, rijden in dezelfde auto naar Amsterdam, om Sebastiaan af te zetten. Ze zitten meer dan tien uur met elkaar in de auto. Niemand voelt zich ziek, los van de gebruikelijke katterigheid na een week après-ski."
                            }
                        ]
                    },
                    {
                        "sense_id": "c79a9c13-5fd8-3841-9e81-b11b85529732",
                        "entry_id": "3ec2a884-c2a4-3677-9353-2e062d739884",
                        "glosses": [
                            "een teleurgesteld gevoel dat ontstaat na aanvankelijke euforie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c3feaa-c7aa-4024-9c2b-693760d41ed7",
                                "sense_id": "c79a9c13-5fd8-3841-9e81-b11b85529732",
                                "text": "Het enige wat bereikt wordt, is een tijdelijke illusie van verandering. Zie ook de mars der indignado’s naar Brussel die in volstrekte katterigheid verzandde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ffbe25d-6dce-41df-a214-5c7ff55a33a6",
                        "source_entry_id": "3ec2a884-c2a4-3677-9353-2e062d739884",
                        "source_sense_id": "a40548cd-3874-3e5e-9b27-78d074c1a41c",
                        "source_sense_description": "een vervelend lichamelijk gevoel dat kan ontstaan na overmatig alcoholgebruik",
                        "target_lang_word": "hangover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hangover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1171605d-9a84-3384-b217-ae01736a3cec",
                                        "entry_id": "6b01bba3-074a-3bbd-9e29-4c6e0ccf0c90",
                                        "glosses": [
                                            "Negative effects, such as headache or nausea, caused by previous drunkenness due to (excessive) consumption of alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72eeebf1-cb6a-40f7-a8ba-cb441bbce7c5",
                                                "sense_id": "1171605d-9a84-3384-b217-ae01736a3cec",
                                                "text": "I really enjoyed yesterday’s party, but now I have the biggest hangover – I’ll not be doing that again any time soon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d478c79f-3957-3a49-9362-0014a67ab15e",
                                        "entry_id": "6b01bba3-074a-3bbd-9e29-4c6e0ccf0c90",
                                        "glosses": [
                                            "Similar negative effects caused by previous excessive consumption of another substance, such as a drug, coffee, sugar, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eac45f14-5736-407f-bec8-8e614d94f812",
                                                "sense_id": "d478c79f-3957-3a49-9362-0014a67ab15e",
                                                "text": "Don't go overboard and find yourself with a sugar hangover that lasts for days and makes your diet days that much harder."
                                            },
                                            {
                                                "example_id": "264cdb1c-b060-4d84-85c0-040de49dc8eb",
                                                "sense_id": "d478c79f-3957-3a49-9362-0014a67ab15e",
                                                "text": "So today I walk into Dr. Singer's office with a heroin hangover, a headache like hell, vomiting, shaking, jonesing. I cannot bear to admit to her that it's come to this. I've been doing so well. But I missed therapy the whole time I was locked up […]"
                                            },
                                            {
                                                "example_id": "929397b9-0d13-4b83-9a0e-db0753999117",
                                                "sense_id": "d478c79f-3957-3a49-9362-0014a67ab15e",
                                                "text": "On the other hand, I was already drunk, and wasn't a heroin hangover preferable to the alcohol kind any day of the week?"
                                            },
                                            {
                                                "example_id": "459e5143-623d-420f-b73e-dd33bed30203",
                                                "sense_id": "d478c79f-3957-3a49-9362-0014a67ab15e",
                                                "text": "We're left with our unmet needs and a sugar high that will quickly turn into a sugar hangover. So the craving rises again, calling out to us “Feed me!” and again we take the easy route and stuff it back down with food."
                                            },
                                            {
                                                "example_id": "b300981a-392e-4fcb-b125-b9125fc24a34",
                                                "sense_id": "d478c79f-3957-3a49-9362-0014a67ab15e",
                                                "text": "You know nothing about despair until you have experienced a coffee hangover. This is where you lose the run of yourself and have two double espressos in a row. Ten minutes later you have a weird feeling you are going to puke out through your toes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31b4d65c-5897-368d-8b44-a5ff91fcb863",
                                        "entry_id": "6b01bba3-074a-3bbd-9e29-4c6e0ccf0c90",
                                        "glosses": [
                                            "An unpleasant relic left from prior events."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a400678-0b12-45e4-887f-f4289b9db1f3",
                                                "sense_id": "31b4d65c-5897-368d-8b44-a5ff91fcb863",
                                                "text": "The one hangover from high school that colored part of my college career was the social requirement of having a boyfriend."
                                            },
                                            {
                                                "example_id": "98ab13e1-46c4-4f9a-924a-b9f971214814",
                                                "sense_id": "31b4d65c-5897-368d-8b44-a5ff91fcb863",
                                                "text": "While they deny the logic of history and geography, neither Gibraltar nor the Falklands will ever be truly \"safe\". One day these hangovers will somehow merge into their hinterlands and cease to be grit in the shoe of international relations. This day will be hastened if world governments take action to end tax havens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff1102b-473f-315e-9349-da5e2719653e",
                                        "entry_id": "6b01bba3-074a-3bbd-9e29-4c6e0ccf0c90",
                                        "glosses": [
                                            "A sleeping arrangement, usually in homeless shelters, over a rope."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac806e49-3c85-400f-8448-19800a9bf25d",
                                                "sense_id": "bff1102b-473f-315e-9349-da5e2719653e",
                                                "text": "At the Twopenny Hangover, the lodgers sit in a row on a bench; there is a rope in front of them, and they lean on this as though leaning over a fence. A man, humorously called the valet, cuts the rope at five in the morning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
