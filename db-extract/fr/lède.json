                        "examples": [
                            {
                                "example_id": "3c3276d4-6bfa-4ddf-bfb2-646263aaccd0",
                                "sense_id": "5b87f1cf-8d8b-3555-b452-1e45316e1e6b",
                                "text": "Étang de Lède basse."
                            },
                            {
                                "example_id": "0e1074d6-a713-4024-b7f1-4967202aa36d",
                                "sense_id": "5b87f1cf-8d8b-3555-b452-1e45316e1e6b",
                                "text": "Celle-ci [la forêt landaise] est une futaie de beaux pins, bien droits, ordinairement plus âgés et plus nombreux sur les hauteurs que dans les lèdes, futaie silencieuse, où le chant des oiseaux est rare."
                            },
                            {
                                "example_id": "057e8a91-d2a3-4c29-86dc-25fb28bb13bb",
                                "sense_id": "5b87f1cf-8d8b-3555-b452-1e45316e1e6b",
                                "text": "Il y a tout au sud de la grande lède de Montalivet un ancien chenal appelé charrin des Frayres ou Courège qui, prenant son origine vers la lède du Mourey, aboutit à la mer par une forte brèche taillée dans la dune littorale au point kilométrique 20, 500."
                            }
                        ]
                    }
