                        "entry_id": "0df28e5b-625f-39ee-a4df-a9b7f4ff3202",
                        "glosses": [
                            "pieśń zaczerpnięta z Biblii, włączona do którejś z godzin kanonicznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30809b4-2313-40fb-a1a4-c62d924b63ae",
                                "sense_id": "e2f28cfe-3ce8-3165-82f1-583394ab3f8d",
                                "text": "Jeden z biblijnych kantyków odmawia się w trakcie Nieszporów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
