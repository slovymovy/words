                },
                {
                    "sense_id": "5bca5c7f-c79e-3cd9-9ffe-981eb7909d5c",
                    "sense_definition": "Se disputer de façon bruyante et agressive avec une autre personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux voisins s'<w>engueulent</w> souvent à cause du bruit nocturne dans le couloir de l'immeuble.",
                            "target_lang_translations": {
                                "en": "The two neighbours often <w>argue</w> because of the night-time noise in the building's hallway.",
                                "ru": "Двое соседей часто <w>ругаются</w> из-за ночного шума в коридоре дома.",
                                "de": "Die beiden Nachbarn <w>streiten</w> <w>sich</w> oft wegen des nächtlichen Lärms im Hausflur.",
                                "es": "Los dos vecinos <w>discuten</w> a menudo por el ruido nocturno en el pasillo del edificio.",
                                "zh": "这两个邻居经常因为楼道里夜间的噪音而<w>吵架</w>。"
                            }
                        },
                        {
                            "text": "Hier soir, ils se sont <w>engueulés</w> pendant des heures pour une simple histoire d'argent.",
                            "target_lang_translations": {
                                "en": "Last night they <w>argued</w> for hours over a trivial money matter.",
                                "ru": "Вчера вечером они <w>ругались</w> несколько часов из-за пустякового денежного вопроса.",
                                "de": "Gestern Abend haben sie <w>sich</w> stundenlang wegen einer banalen Geldsache <w>gestritten</w>.",
                                "es": "Anoche <w>discutieron</w> durante horas por una simple cuestión de dinero.",
                                "zh": "昨天晚上他们为了一件小小的钱财问题<w>争吵</w>了好几个小时。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "s'engueuler pour un rien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To argue noisily and aggressively with another person.",
                        "ru": "Громко и агрессивно спорить с другим человеком.",
                        "de": "Sich lautstark und aggressiv mit einer anderen Person streiten. Umgangssprachlich.",
                        "es": "Discutir a gritos y con agresividad con otra persona. Uso coloquial.",
                        "zh": "大声而激烈地与他人争吵。"
                    },
