                        "cross_references": [
                            {
                                "target_word": "Tejano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faefbdad-ede3-3228-a13c-65d6001aaca2",
                                        "entry_id": "964c2c64-3104-3aa6-8bda-2b3394cd9a68",
                                        "glosses": [
                                            "A Spanish colonial settler of the region that later became Texas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "419a655c-3311-4639-a9c8-a94435e4f508",
                                                "sense_id": "faefbdad-ede3-3228-a13c-65d6001aaca2",
                                                "text": "But when Santa Anna’s forces invaded the renegade province, Seguín and other Tejano leaders joined the secessionists in proclaiming an independent Republic of Texas"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05253b78-695e-3b3c-becd-ee64de6dcc9b",
                                        "entry_id": "964c2c64-3104-3aa6-8bda-2b3394cd9a68",
                                        "glosses": [
                                            "A Texan (especially male) of Mexican descent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "127d955d-a2b1-306f-9fe8-be56b39bc006",
                                        "entry_id": "964c2c64-3104-3aa6-8bda-2b3394cd9a68",
                                        "glosses": [
                                            "Various forms of folk and popular music originating among the Mexican-American populations of Central and Southern Texas."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "204fe3b6-b94f-4a11-a590-3fddf4ef3139",
                                                "sense_id": "127d955d-a2b1-306f-9fe8-be56b39bc006",
                                                "text": "Calderon points out as evidence an increase in Tejano record sales worldwide, and the meteoric rise of the young late Tejano recording artist, Selena Quintanilla-Perez."
                                            }
                                        ]
                                    }
