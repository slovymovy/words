                    "sense_id": "4f1c155f-01a2-3695-84f2-79d092e2e4cd",
                    "sense_definition": "Faire le récit d'événements réels ou imaginaires.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand-père aime <w>raconter</w> une histoire passionnante à ses petits-enfants avant de dormir.",
                            "target_lang_translations": {
                                "en": "Grandad loves to <w>tell</w> his grandchildren an exciting story before bedtime.",
                                "ru": "Дедушка любит <w>рассказывать</w> внукам увлекательную историю перед сном.",
                                "nl": "Opa <w>vertelt</w> zijn kleinkinderen graag een spannend verhaal voor het slapengaan.",
                                "de": "Opa <w>erzählt</w> seinen Enkeln vor dem Schlafengehen gern eine spannende Geschichte.",
                                "pl": "Dziadek lubi <w>opowiadać</w> wnukom pasjonującą historię przed snem.",
                                "it": "Il nonno ama <w>raccontare</w> ai nipotini una storia avvincente prima di andare a dormire.",
                                "cs": "Dědeček rád <w>vypráví</w> vnoučatům napínavý příběh před spaním.",
                                "tr": "Dedesi, torunlarına yatmadan önce heyecanlı bir hikâye <w>anlatmayı</w> çok sever.",
                                "es": "Al abuelo le encanta <w>contar</w> una historia apasionante a sus nietos antes de dormir.",
                                "zh": "爷爷睡前喜欢给孙子孙女<w>讲</w>一个精彩的故事。"
                            }
                        },
                        {
                            "text": "Elle nous a <w>raconté</w> tous les détails de son voyage en Italie hier soir.",
                            "target_lang_translations": {
                                "en": "She <w>told</w> us all the details of her trip to Italy last night.",
                                "ru": "Она <w>рассказала</w> нам все подробности своего путешествия в Италию вчера вечером.",
                                "nl": "Gisteravond heeft ze ons alle details van haar reis naar Italië <w>verteld</w>.",
                                "de": "Sie hat uns gestern Abend alle Einzelheiten ihrer Italienreise <w>erzählt</w>.",
                                "pl": "Wczoraj wieczorem <w>opowiedziała</w> nam wszystkie szczegóły swojej podróży do Włoch.",
                                "it": "Ieri sera ci ha <w>raccontato</w> tutti i dettagli del suo viaggio in Italia.",
                                "cs": "Včera večer nám <w>vyprávěla</w> všechny podrobnosti o své cestě do Itálie.",
                                "tr": "Dün akşam bize İtalya seyahatinin bütün ayrıntılarını <w>anlattı</w>.",
                                "es": "Anoche nos <w>contó</w> todos los detalles de su viaje a Italia.",
                                "zh": "她昨晚把意大利之行的所有细节都<w>讲</w>给我们听了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conter",
                        "narrer",
                        "relater"
                    ],
                    "common_phrases": [
                        "raconter une histoire",
                        "raconter sa vie"
