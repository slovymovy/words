                    }
                ],
                "senses": [
                    {
                        "sense_id": "f695f66e-4f45-3c5f-af98-6bf12f049c67",
                        "entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "glosses": [
                            "uitwerpsel, ontlasting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7e72f8-29b3-47e1-bec4-f8a4df08498e",
                                "sense_id": "f695f66e-4f45-3c5f-af98-6bf12f049c67",
                                "text": "Als ik na een uur klaar ben, rond acht uur ’s ochtends, dan begint mijn dag. Lekker naar buiten met mijn twee honden. Af en toe daar ook nog even bukken om een drol op te rapen."
                            },
                            {
                                "example_id": "6c8aefcf-59cd-4f33-8944-c22b7632e7d7",
                                "sense_id": "f695f66e-4f45-3c5f-af98-6bf12f049c67",
                                "text": "„’r moet ’n riool zijn.... ’t Stinkt .... ’t Stinkt.... ’k Wor ’r misselijk van”.... „Da’s de emmer, oome”, zei Saartje, wijzend den hoek bij de deur. Maar de lucifer was uitgebrand. Hij streek nog een af, keerde zich om, zag den emmer zonder hengsel, bijna gevuld tot den rand met geel vocht, waarin bruine drollen opdreven."
                            }
                        ]
                    },
                    {
                        "sense_id": "75922e73-e279-3c2e-85a9-322fcc7d62e6",
                        "entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "glosses": [
                            "grof linnen, gesponnen uit restanten vlas"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a452c01f-0f27-38c0-8fe0-5eea1dd14f9b",
                        "entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "glosses": [
                            "iemand die veel grappen maakt of heel opgewekt is"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5ed6515f-7bde-4976-b33f-32bce722c28e",
                                "sense_id": "a452c01f-0f27-38c0-8fe0-5eea1dd14f9b",
                                "text": "Hy heeft dese uytnemende ende noot-volpresen Const gheleert by eenen Peeter Cock van Aelst, wiens Dochter hy naermaels trouwde, hy hadde veel gheleert uyt de handelinghe van Jeroon vanden Bosch en maeckten oock seer drollighe en viese spoockerijen, waerom hy van veel wert gheheeten Peeter den Drol."
                            }
                        ]
                    },
                    {
                        "sense_id": "939453d0-8817-33c6-ba55-a820b9b05496",
                        "entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "glosses": [
                            "fors, lelijk en vaak onvriendelijk wezen, oorspronkelijk afkomstig uit de Scandinavische mythologie"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2624ad8d-cd4d-4d13-8dbc-352232e0e71a",
                                "sense_id": "939453d0-8817-33c6-ba55-a820b9b05496",
                                "text": "Verlaten wij thans onze gewesten, om een uitstapje naar het Noorden te wagen, dan ontdekken wij weldra verscheidene sagen, waarin de duivel, onder behoud van alle of nagenoeg alle andere hoofdtrekken des verhaals, de plaats heeft geruimd voor eenen of meer reuzen, drollen of trollen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f3585e4-b3a3-402f-82fd-d7a99f469115",
                        "source_entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "source_sense_id": "f695f66e-4f45-3c5f-af98-6bf12f049c67",
                        "source_sense_description": "uitwerpsel, ontlasting",
                        "target_lang_word": "Haufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "mehrere Teile, Sachen an einem Ort übereinandergeworfen, unsortiert abgelegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145629e9-ce64-4905-b4a9-e1cac290bb7a",
                                                "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                                "text": "Der Haufen an Schrott im Vorgarten muss noch beseitigt werden."
                                            },
                                            {
                                                "example_id": "ee60e837-2580-4c50-8843-a8f8fd2e6b02",
                                                "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                                "text": "Wir haben immer noch einen Haufen an Problemen, die auf eine Lösung warten."
                                            },
                                            {
                                                "example_id": "ec4b9956-9cce-486b-a9b3-c44769ccbde6",
                                                "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                                "text": "„Einen der Haufen auf dem Boden würde sie ans Rote Kreuz spenden, und der andere gehörte ihrer drei Jahre älteren Schwester Dagný.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "mehrere Menschen, zum Beispiel an einem Ort ungeordnet versammelt"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e1ae835-cc22-49a9-8bc1-729f1140c622",
                                                "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                                "text": "Ein Haufen Menschen hatte sich da vor dem Rathaus versammelt."
                                            },
                                            {
                                                "example_id": "91c196af-d920-435e-a7d8-b84aa20fbf3c",
                                                "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                                "text": "Auf die Anzeige hat sich ein ganzer Haufen in Frage kommender Spender gemeldet."
                                            },
                                            {
                                                "example_id": "50a819ba-2f14-4429-bbfd-a9014acc8ec0",
                                                "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                                "text": "„Wir waren ein kurioser Haufen und ich hoffte, dass wir die Herausforderungen, die die Reise durch die Sahara mit sich bringen würde, meistern konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "an exponierter Stelle liegender Kot, meistens von Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64547d2c-e2b1-47c2-8175-60d5c798a611",
                                                "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                                "text": "„Es hätte mindestens eine halbe Stunde gedauert, mit mir nach Hause zu gehen, und er hatte nicht die Absicht, sich so viel wertvolle Zeit stehlen zu lassen, nur weil sein kleiner Bruder einen Haufen machen musste.“"
                                            },
                                            {
                                                "example_id": "4fa0b633-c45b-442b-9e10-915b2fc58f16",
                                                "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                                "text": "Genau in diesen Haufen musste er treten."
                                            },
                                            {
                                                "example_id": "87a0f108-8a39-4e3b-ac8d-9887c873fca6",
                                                "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                                "text": "Der Sportplatz ist von den Haufen der Hunde der Nachbarschaft eingerahmt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "30474c3a-aefb-381d-b7ee-29f44d86c72f",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "militärische Einheit"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6944a8a0-e6c8-4fa9-859f-f2107058b122",
                                                "sense_id": "30474c3a-aefb-381d-b7ee-29f44d86c72f",
                                                "text": "„Die Fähnlein bilden den Haufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "536ce96e-231c-4f3d-bc7e-476599bb0109",
                        "source_entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "source_sense_id": "f695f66e-4f45-3c5f-af98-6bf12f049c67",
                        "source_sense_description": "uitwerpsel, ontlasting",
                        "target_lang_word": "Kot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aae3ddb8-8dcd-3951-8d4e-9fc5c9a37b54",
                                        "entry_id": "cf2517d5-5224-3347-9ece-023afceba453",
                                        "glosses": [
                                            "Exkremente; Ausscheidung des Darms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f9b519-3b76-4d22-abe6-45d1aa928344",
                                                "sense_id": "aae3ddb8-8dcd-3951-8d4e-9fc5c9a37b54",
                                                "text": "Aus dem Kot der Stalltiere gewinnt man heute mehr und mehr Biogas."
                                            },
                                            {
                                                "example_id": "af687581-8e8f-4e73-a064-48c0033c55c7",
                                                "sense_id": "aae3ddb8-8dcd-3951-8d4e-9fc5c9a37b54",
                                                "text": "„Ahab Seelmann, von der Medizin aufgegeben, stopfte sich vor Todesqual den eigenen „Kot“ in den Mund, bevor er in seinem Bett starb.“"
                                            },
                                            {
                                                "example_id": "de14844d-5b49-42a6-bff6-6117c14c40b0",
                                                "sense_id": "aae3ddb8-8dcd-3951-8d4e-9fc5c9a37b54",
                                                "text": "„Er stürzte wütend den Thron des Erdgottes, dem vor dem Hause geopfert wurde, um und ließ geräuschvoll einen Haufen warmen Kot darauf ab.“"
                                            },
                                            {
                                                "example_id": "eb160325-15d5-411e-9f17-7f38b955c1d4",
                                                "sense_id": "aae3ddb8-8dcd-3951-8d4e-9fc5c9a37b54",
                                                "text": "„Nachdem Bolchowitinow zweimal die Pferde gewechselt und in anderthalb Stunden im zähflüssigen Kot der Landstrasse dreissig Werst hinter sich gebracht hatte, traf er zwischen ein und zwei Uhr nachts in Letaschowka ein.“"
                                            },
                                            {
                                                "example_id": "0fac9675-5c7b-4b49-bd6e-e1aa7a0c2df2",
                                                "sense_id": "aae3ddb8-8dcd-3951-8d4e-9fc5c9a37b54",
                                                "text": "„Sie wiesen in den Sedimenten eines Sees in Alaska Spuren menschlichen Kots nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cec5a48c-6ba7-3328-82d0-97493b47b8da",
                                        "entry_id": "cf2517d5-5224-3347-9ece-023afceba453",
                                        "glosses": [
                                            "Schmutz"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a97b72-a0d3-480d-ac33-c32b15d13e14",
                                                "sense_id": "cec5a48c-6ba7-3328-82d0-97493b47b8da",
                                                "text": "„Ich steige kaum aus dem Wagen, so werden die Hengste scheu, stampfen und schlagen aus, daß mir - ich bitte Sie! - der Kot über und über an die Beinkleider spritzt.“ (Friedrich Schiller, Kabale und Liebe, 1. Akt, 6. Szene, zitiert nach Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0b25d85-4ae2-4ab1-a591-e3cd810e56f5",
                        "source_entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "source_sense_id": "f695f66e-4f45-3c5f-af98-6bf12f049c67",
