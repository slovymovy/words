                                    {
                                        "sense_id": "76f542d6-406e-33d0-b04f-c26c81492a26",
                                        "entry_id": "39724f73-361a-3b57-8a31-e45fe92b0b02",
                                        "glosses": [
                                            "feuchtwarme Gebiete beiderseits des Äquators"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ba0226-2852-42c9-be56-25b738b41295",
                                                "sense_id": "76f542d6-406e-33d0-b04f-c26c81492a26",
                                                "text": "In den Tropen toben oft heftige Stürme."
                                            },
                                            {
                                                "example_id": "89ab036c-1ddc-4628-9a12-be3349940654",
                                                "sense_id": "76f542d6-406e-33d0-b04f-c26c81492a26",
                                                "text": "„Ein langer Aufenthalt in den Tropen hatte seine Gesichtszüge gezeichnet.“.“"
                                            },
                                            {
                                                "example_id": "888dfef6-42a3-4076-9ab9-2c3e74d04370",
                                                "sense_id": "76f542d6-406e-33d0-b04f-c26c81492a26",
                                                "text": "„Zuckerpionier Drax gelang nicht nur das Überleben in den Tropen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
