                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embargo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b17a7610-1c48-3e35-80da-24b069760b2d",
                                        "entry_id": "1cc13d54-e681-3346-be6d-3ea1cf8cb9c1",
                                        "glosses": [
                                            "Défense faite aux navires qui sont dans un port ou sur une rade d’en sortir sans permission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3041f86-86e0-419a-9386-1b0e485c1d9f",
                                                "sense_id": "b17a7610-1c48-3e35-80da-24b069760b2d",
                                                "text": "Aussitôt que le navire entra dans le port, il fut accosté par les représentants d’un soi-disant Comité provisoire, qui mit l’embargo sur le reste des provisions."
                                            },
                                            {
                                                "example_id": "e475a9b3-33a6-4314-85b2-6da117444a79",
                                                "sense_id": "b17a7610-1c48-3e35-80da-24b069760b2d",
                                                "text": "L’hypothèse la plus prometteuse repose sur une analyse de la politique menée par l’archè athénienne. Elle consiste à envisager un embargo athénien sur le commerce péloponnésien, suffisamment efficace pour interrompre le flux Péloponnèse/Crète/Afrique du Nord au cours d'une période de 60 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c90a90-9105-3998-b275-044f7aaf4449",
                                        "entry_id": "1cc13d54-e681-3346-be6d-3ea1cf8cb9c1",
                                        "glosses": [
                                            "Toute mesure tendant à empêcher la circulation d’un objet."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67cc63fc-7182-46f2-a6a3-67c3cd2c84fb",
                                                "sense_id": "44c90a90-9105-3998-b275-044f7aaf4449",
                                                "text": "Le gouvernement décréta l’embargo sur le pétrole au mois de novembre, mais cette mesure fut promptement rapportée, la France et la Grande-Bretagne ayant refusé de prendre semblable mesure."
                                            },
                                            {
                                                "example_id": "46329db7-0063-4dd8-8717-32ffd358758c",
                                                "sense_id": "44c90a90-9105-3998-b275-044f7aaf4449",
                                                "text": "La menace n’était pas vaine : de Gaulle décréta l’embargo le 2 juin 1967, précipitant selon toute vraisemblance le déclenchement de la guerre, trois jours plus tard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff01710-b29f-3345-bc0d-d6bc17e963f9",
                                        "entry_id": "1cc13d54-e681-3346-be6d-3ea1cf8cb9c1",
                                        "glosses": [
                                            "Délai avant de diffuser une information, programme, oeuvre littéraire ou travail de recherche."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
