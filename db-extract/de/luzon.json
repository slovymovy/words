                "senses": [
                    {
                        "sense_id": "999d3769-791c-3fe9-b663-5a0b47b54e13",
                        "entry_id": "88ea65cf-a2a7-316c-b3d1-efa3031fc887",
                        "glosses": [
                            "größte, nördlich gelegene Insel der Philippinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56dcc8cc-fcfe-4c52-9000-3602248cd412",
                                "sense_id": "999d3769-791c-3fe9-b663-5a0b47b54e13",
                                "text": "„Das Basislager befand sich in einer Provinzstadt im Norden der Insel Luzon, in der Cordillera Central, die das Truong-Son-Gebirge darstellen sollte, das Vietnam von Laos trennte.“"
                            },
                            {
                                "example_id": "6c7488e7-b2aa-46ec-8c4d-8f8ecbb090ff",
                                "sense_id": "999d3769-791c-3fe9-b663-5a0b47b54e13",
                                "text": "„›Ich war nicht in Korea‹, sagte der große Mann, ›ich war auf Guadalcanal und Luzon. Und da gab's keine Nigger.‹“"
                            },
                            {
                                "example_id": "39873311-5f55-4cbb-9367-4639c4f10f1c",
                                "sense_id": "999d3769-791c-3fe9-b663-5a0b47b54e13",
                                "text": "„Und wenn sie schwiegen, weil ein sechster Sinn ihnen sagte, dass Don Pepe die Ohren spitzte, polierte Teroy seine Pistole - das glänzendste Stück Metall auf ganz Luzon -, und Jojo hielt nach Jeepneys Ausschau.“"
                            },
                            {
                                "example_id": "5d5e72b9-220b-460e-a243-bc7498b148be",
                                "sense_id": "999d3769-791c-3fe9-b663-5a0b47b54e13",
                                "text": "„Ich war auf Luzon, als wir ihren Eingeborenenkönig Lumalon vernichteten und das Wort Gottes auf die Philippinen brachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
