                ],
                "senses": [
                    {
                        "sense_id": "0c052966-7276-3b44-b286-57ec939187df",
                        "entry_id": "6a2aa12e-8969-33bc-8fad-cbcd838c83dd",
                        "glosses": [
                            "Vorrichtung aus zwei Spulen die elektrische Energie transformiert, das heißt ihre charakteristische Größe Spannung ändert, die in einem Frequenzbereich von einigen 100 Hz bis zu einigen Kilohertz arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09b6f59-cee7-4e13-ad5e-a948ac254073",
                                "sense_id": "0c052966-7276-3b44-b286-57ec939187df",
                                "text": "„Die Energieversorgung besteht aus einem galvanisch trennenden Eingangsumrichter, ausgeführt als resonant schaltendes Leistungsteil mit aktiver Eingangsstromregelung, und galvanischer Trennung durch einen Mittelfrequenztransformator.“"
                            },
                            {
                                "example_id": "6ef6c377-d99b-4c78-969d-786639425caf",
                                "sense_id": "0c052966-7276-3b44-b286-57ec939187df",
                                "text": "„Andere Stromrichter, die insbesondere geeignet sind zur Stromversorgung von Schienenfahrzeugen, sind mit einem Mittelfrequenztransformator verbunden.“"
                            },
                            {
                                "example_id": "9998ab22-57b4-4da6-9ecf-2d29b1cf614b",
                                "sense_id": "0c052966-7276-3b44-b286-57ec939187df",
                                "text": "„Während konventionelle Stromrichter der Megawattklasse im PGS Labor für den Betrieb mit einer angepassten Ansteuerung ausgestattet wurden, wurde der eingesetzte Mittelfrequenztransformator mit einer Nennleistung von 5 MW zusammen mit den Industriepartnern komplett neu entwickelt und konstruiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
