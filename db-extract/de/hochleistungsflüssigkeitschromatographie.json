                "senses": [
                    {
                        "sense_id": "08b10096-ac5c-314a-974d-740ca1ed251d",
                        "entry_id": "8c6c5ccb-c116-3c62-8ea3-6554754573ac",
                        "glosses": [
                            "Verfahren zum schnellen Heraustrennen und Bestimmen einzelner Substanzen aus einem Stoffgemisch sowie zur genauen Feststellung deren vorhandener mengenmäßiger Anteile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c953ce-5eae-44da-9160-cfeb628c85b0",
                                "sense_id": "08b10096-ac5c-314a-974d-740ca1ed251d",
                                "text": "„Die Hochleistungsflüssigkeitschromatographie […] ist eine Methode zur schnellen Trennung von Substanzen unter milden Bedingungen und mit hoher Trennschärfe.“"
                            },
                            {
                                "example_id": "61cf21b6-eff4-4e84-9419-e00685ab644b",
                                "sense_id": "08b10096-ac5c-314a-974d-740ca1ed251d",
                                "text": "„Mit der Hochleistungsflüssigkeitschromatographie (HPLC) lassen sich auch thermisch labile Substanzen analysieren.“"
                            },
                            {
                                "example_id": "edcda8cf-e582-46bb-8a54-6d3d9ed1bf2f",
                                "sense_id": "08b10096-ac5c-314a-974d-740ca1ed251d",
                                "text": "„[Die Forscher] zeigten, dass es möglich ist, durch Hochleistungsflüssigkeitschromatographie […] von Dinkelmehl zu bestimmen, ob es Weizenproteine enthält […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
