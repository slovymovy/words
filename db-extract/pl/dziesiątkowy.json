                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef3473b9-3a90-3b06-8619-a8eba1800921",
                                        "entry_id": "c938a137-0eab-3d2b-b6c8-400419eee3e3",
                                        "glosses": [
                                            "A decimal place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8e316b-1fc5-4177-953c-5bf88a6ddb7f",
                                                "sense_id": "ef3473b9-3a90-3b06-8619-a8eba1800921",
                                                "text": "Pi has a value of 3.142, to three decimals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bac52af-1b11-377a-8072-8ac99961972f",
                                        "entry_id": "c938a137-0eab-3d2b-b6c8-400419eee3e3",
                                        "glosses": [
                                            "A decimal point."
                                        ],
                                        "tags": [
