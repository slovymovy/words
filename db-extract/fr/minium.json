                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5f6b23e-c706-3be3-af45-94dd01b07158",
                        "entry_id": "8da2b698-1121-3efa-8584-56215ea20a76",
                        "glosses": [
                            "Oxyde de plomb de couleur rouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94414ef7-b2cb-4104-8d10-7f4ba5e58938",
                                "sense_id": "d5f6b23e-c706-3be3-af45-94dd01b07158",
                                "text": "Le minium s’obtient par la calcination du plomb dans un four."
                            },
                            {
                                "example_id": "7fc95fde-fe12-490f-8d78-2352ce1a5c8a",
                                "sense_id": "d5f6b23e-c706-3be3-af45-94dd01b07158",
                                "text": "Le minium (Pb₃O₄), utilisé comme peinture, servait aux Grecs à badigeonner leurs navires pour en protéger le bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                        "entry_id": "8da2b698-1121-3efa-8584-56215ea20a76",
                        "glosses": [
                            "Couleur à l’huile, à base de minium."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e1dabed7-22dc-4375-9000-e557dca7ce41",
                                "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                                "text": "On donne au fer une première couche de minium pour l’empêcher de rouiller."
                            },
                            {
                                "example_id": "fa336fdc-dfe8-4d02-a962-2c9cee518b2b",
                                "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                                "text": "Emporte ce bidon de minium…"
                            },
                            {
                                "example_id": "e15e16f3-15df-40f9-ae59-8ab864290240",
                                "sense_id": "20ab15f7-169f-3e93-847e-e0ba45dc6846",
                                "text": "Un léger coup de lime pour enlever une bavure, un soupçon d’antirouille orangée que l’on nomme minium, deux petits pas de recul façon Vélasquez contemplant ses Ménines, les bruits des locos comme fond sonore, alors elle est pas belle la vie ?"
                            }
                        ]
                    }
                ],
