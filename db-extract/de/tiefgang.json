                        ],
                        "form": "den Tiefgang"
                    },
                    {
                        "form_id": "63fd03b3-46a3-41b3-8ec8-0ae82f79a87d",
                        "entry_id": "fe9fa0b0-8f06-3e93-b64c-6db430e484b9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tiefgänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d686701-e98a-3da2-81a2-a30a28081cf0",
                        "entry_id": "fe9fa0b0-8f06-3e93-b64c-6db430e484b9",
                        "glosses": [
                            "die senkrechte Länge, die die Differenz zwischen der Wasseroberfläche und dem tiefsten Punkt eines Schiffes beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54007672-3ebf-4561-9ff2-8f5f6c583fe1",
                                "sense_id": "8d686701-e98a-3da2-81a2-a30a28081cf0",
                                "text": "Je mehr Container oder Waren ein Schiff geladen hat, um so mehr Tiefgang hat es auch."
                            },
                            {
                                "example_id": "6695adb2-a137-429e-a13f-a63e04ac4bc9",
                                "sense_id": "8d686701-e98a-3da2-81a2-a30a28081cf0",
                                "text": "Der JadeWeserPort ist der einzige Hafen in Deutschland, den Schiffe unabhängig von Beladung, Tiefgang und Wasserstand anlaufen können. Mit vollem Gewicht an Bord hätte die \"MSC Oscar\" etwa 16 Meter Tiefgang. Beim Einlaufen nach Bremerhaven war das Schiff auf seiner Jungfernfahrt jedoch nicht voll beladen und kam auf knapp 13 Meter Tiefgang."
                            },
                            {
                                "example_id": "dd24777f-867f-4715-9d68-a725c4548552",
                                "sense_id": "8d686701-e98a-3da2-81a2-a30a28081cf0",
                                "text": "Da wir gerade bei Schiffen sind: Ballast, ein Wort aus der Seemannssprache, bezeichnet jene Last, die dem Schiff Tiefgang, Gleichgewicht und damit optimale Wasserlage geben soll."
                            },
                            {
                                "example_id": "67b43ce0-5627-45d1-a2f6-4f9eefb28e40",
                                "sense_id": "8d686701-e98a-3da2-81a2-a30a28081cf0",
                                "text": "Nach dem Willen der Planer sollen in Zukunft Schiffe bis 13,50 Meter Tiefgang jederzeit Hamburg erreichen können. Bisher sind nur 12,50 Meter möglich. Bei Hochwasser sollen sogar Schiffe mit bis zu 14,50 Meter Tiefgang nach Hamburg fahren können."
                            },
                            {
                                "example_id": "e31636ce-5424-4df7-8b31-0fd01f682c17",
                                "sense_id": "8d686701-e98a-3da2-81a2-a30a28081cf0",
                                "text": "„Nutzen Schiffe die Flutwelle, um den Hamburger Hafen zu erreichen oder zu verlassen, dürfen sie höhere Tiefgänge aufweisen.“"
                            },
                            {
                                "example_id": "05295e49-ce77-4813-b5a8-31d785735a1e",
                                "sense_id": "8d686701-e98a-3da2-81a2-a30a28081cf0",
                                "text": "„‚Die kennen unsere Schiffe fast besser als wir‘, sagt Sieck, ‚und wollen alles über Tiefgänge und Wendekreise wissen.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6dfa1781-f895-31ab-93e3-a239529012d8",
                        "entry_id": "fe9fa0b0-8f06-3e93-b64c-6db430e484b9",
                        "glosses": [
                            "der anspruchsvolle Gehalt oder die Substanz eines Gedankens oder eines Textes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4dc625e-7e49-48c6-a339-57e8d1995074",
                                "sense_id": "6dfa1781-f895-31ab-93e3-a239529012d8",
                                "text": "[Es] gibt aber auch Bücher, die sowohl Erfolg haben als auch intellektuellen Tiefgang, etwa die Werke von [den indonesischen Autoren] Ayu Utami, Seno Gumira Ajidarma oder Eka Kurniawan."
                            },
                            {
                                "example_id": "0a3e0a86-3770-4537-861c-4ba05a6a039e",
                                "sense_id": "6dfa1781-f895-31ab-93e3-a239529012d8",
                                "text": "Der 65-Jährige [Dieter Kosslick soll] als Chefkurator [der Berliner Filmfestspiele] auch für den nötigen Tiefgang bei der Filmauswahl sorgen."
                            },
                            {
                                "example_id": "23b02bb7-9689-4a89-b6f8-1c5ddaa00fdf",
                                "sense_id": "6dfa1781-f895-31ab-93e3-a239529012d8",
                                "text": "\"So glücklich war ich noch nie\" ist eine sehr unterhaltsame, glänzend gespielte Gaunerkomödie mit Tiefgang."
                            },
                            {
                                "example_id": "cb873bf6-3230-4807-853d-621068abaf54",
                                "sense_id": "6dfa1781-f895-31ab-93e3-a239529012d8",
                                "text": "„Indiens Geschichte hat einen großen Tiefgang.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
