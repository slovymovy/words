                    },
                    {
                        "translation_id": "d0de84cc-8732-4e63-975a-73de79c8e3ef",
                        "source_entry_id": "43dc22b0-4eb6-3969-b6f5-b0f711183522",
                        "source_sense_id": "decb11d0-ca27-39b0-a3f5-54948bdd11b1",
                        "target_lang_word": "criminelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62ca8300-10ad-3e09-a98b-d2b0b4d99f19",
                                        "entry_id": "8ca97f02-fb70-370e-91df-7252ec13ab88",
                                        "glosses": [
                                            "Celle qui est convaincue de crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36682fb-a4f9-4147-aac9-124576b43845",
                                                "sense_id": "62ca8300-10ad-3e09-a98b-d2b0b4d99f19",
                                                "text": "Pour Frances, c’est une conspiratrice et une criminelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5702f3cd-1061-3569-add7-b75ce2f3661a",
                                        "entry_id": "8ca97f02-fb70-370e-91df-7252ec13ab88",
                                        "glosses": [
                                            "Police criminelle."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ac904ea-4a76-4aa7-82e2-4775217c14e5",
                                                "sense_id": "5702f3cd-1061-3569-add7-b75ce2f3661a",
                                                "text": "Le capitaine annonça solennellement à Sarah qu'il lui enverrait sous peu le lieutenant Adam Ovambo, l'un de ses meilleurs éléments, un ancien de la criminelle du Cap, chargé depuis peu de ce coin perdu et brousseux d'Afrique du Sud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "criminelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eee035e9-f48d-309e-bed2-513ce525d2c3",
                                        "entry_id": "c4da0b51-8e50-390b-bb78-2e220a6e30fa",
                                        "glosses": [
                                            "Féminin singulier de criminel."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba482b8-94bb-4d4b-bc9e-9e34077db00a",
                                                "sense_id": "eee035e9-f48d-309e-bed2-513ce525d2c3",
                                                "text": "Mue par une pensée diabolique, cette criminelle Allemande lança le jeune Fritz, à l’âge de vingt et un ans, dans des dissipations antigermaniques."
                                            },
                                            {
                                                "example_id": "b60dd9c1-865e-43ca-8b29-9e603511027c",
                                                "sense_id": "eee035e9-f48d-309e-bed2-513ce525d2c3",
                                                "text": "Ce livre pratique de Bruno Fuligny vous donnera toutes les cartes pour devenir un agent secret et retrouver l’organisation criminelle qui a siphonné votre compte formation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ecec1e2-9abc-4de1-b883-748b55eb50fa",
                        "source_entry_id": "43dc22b0-4eb6-3969-b6f5-b0f711183522",
                        "source_sense_id": "decb11d0-ca27-39b0-a3f5-54948bdd11b1",
                        "target_lang_word": "scélérate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scélérate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6303206f-7517-30a6-9499-64c459e729c3",
                                        "entry_id": "abfeed93-1c10-3bdc-b777-3ec0adc34497",
                                        "glosses": [
                                            "Celle qui manifeste des intentions ou des sentiments criminels et perfides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba1e7d14-08d6-4ed1-96a5-79c1b9abf9b5",
                                                "sense_id": "6303206f-7517-30a6-9499-64c459e729c3",
                                                "text": "Elle s'attacha à la magie, et, quand elle sut assez de cet art diabolique pour exécuter l'horrible dessein qu'elle méditait, la scélérate mena mon fils dans un lieu écarté."
                                            },
                                            {
                                                "example_id": "4770486b-fb77-40ee-b2e4-e2f52ae9553e",
                                                "sense_id": "6303206f-7517-30a6-9499-64c459e729c3",
                                                "text": "— Voyons, pensa-t-il en se retirant et en répondant à peine aux reproches de Ketty, voyons, ne soyons pas un sot ; décidément cette femme est une grande scélérate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scélérate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c9d5bcb-7c0e-3e35-bb9d-01467efbb20a",
                                        "entry_id": "18d45969-4db0-374a-beee-7215007a0952",
                                        "glosses": [
                                            "Féminin singulier de scélérat."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e2752a0-4a8b-4701-b137-b4264e7a2af1",
                                                "sense_id": "3c9d5bcb-7c0e-3e35-bb9d-01467efbb20a",
                                                "text": "Mais s’il revient aujourd’hui sur les évènements qui ont ensanglanté ce dernier pays, c’est que cette guerre scélérate, pour reprendre l’expression de notre ancien ambassadeur au Salvador, Alain Rouquié, a été aussi un terrain d’expérimentation grandeur nature pour les États-Unis. Il s’agissait, sur fond de Guerre froide, de juguler la contagion marxiste et donc d’adresser un sérieux avertissement aux autres pays de la région qui seraient tentés de rompre avec le grand protecteur nord-américain."
                                            },
                                            {
                                                "example_id": "46934e93-c812-4c6f-96b1-2e6c110cda83",
                                                "sense_id": "3c9d5bcb-7c0e-3e35-bb9d-01467efbb20a",
                                                "text": "Les lois scélérates sont une série de trois lois liberticides votées dans l’urgence afin de lutter contre les actions anarchistes qui menaçaient de déstabiliser des pans entiers du système."
                                            },
                                            {
                                                "example_id": "78631bc7-7f35-4a50-990c-8cb0e2210f19",
                                                "sense_id": "3c9d5bcb-7c0e-3e35-bb9d-01467efbb20a",
                                                "text": "Une première faute les jeta l’un et l’autre dans la voie scélérate qu’ils ont suivie jusqu’à leur fin misérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
