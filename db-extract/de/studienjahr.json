                "senses": [
                    {
                        "sense_id": "aa9c2876-712d-3bc1-a536-98cba88a6622",
                        "entry_id": "8a48ef6c-b09f-36bf-b5e9-b3c9d966ad6e",
                        "glosses": [
                            "Zeitraum eines Jahres, in dem studiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e86c5793-425d-4fb1-8e63-1bf0066867cb",
                                "sense_id": "aa9c2876-712d-3bc1-a536-98cba88a6622",
                                "text": "„Ironischerweise fielen seine Studienjahre in Göttingen und Cambridge in eine Periode, in der die führenden Physiker der Welt diesen schönen Traum allmählich aufgaben.“"
                            },
                            {
                                "example_id": "95188529-6ede-4108-8422-1524e5695488",
                                "sense_id": "aa9c2876-712d-3bc1-a536-98cba88a6622",
                                "text": "„Bevor sie abreisten, feierten die Kommilitonen aber noch mit einer Fülle von Bällen, Kneipen und Stiftungsfesten das absolvierte Studienjahr.“"
                            },
                            {
                                "example_id": "e18cd689-acdd-4929-92cb-ec637d9dcbc5",
                                "sense_id": "aa9c2876-712d-3bc1-a536-98cba88a6622",
                                "text": "„Während seiner Studienjahre ist von dieser Problematik noch wenig zu bemerken.“"
                            },
                            {
                                "example_id": "880197f7-d3a4-421e-af09-7ddcf783df30",
                                "sense_id": "aa9c2876-712d-3bc1-a536-98cba88a6622",
                                "text": "„In seinem ersten Studienjahr hatte Roth sein Glück bei Cheerleaderinnen wie Pat McCall und Annette Littlefield versucht, die jedoch in Sachen Petting gar nichts zuließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
