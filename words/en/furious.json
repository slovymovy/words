                {
                    "sense_id": "d326d21a-0c05-3b23-892d-4eb9727fbd4a",
                    "sense_definition": "Feeling or showing extreme anger or rage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer became <w>furious</w> when he realized the store had overcharged him for the repair.",
                            "target_lang_translations": {
                                "ru": "Клиент пришел в <w>ярость</w>, когда понял, что магазин взял с него лишние деньги за ремонт.",
                                "nl": "De klant werd <w>woedend</w> toen hij besefte dat de winkel hem te veel had gerekend voor de reparatie.",
                                "pl": "Klient stał się <w>wściekły</w>, gdy zdał sobie sprawę, że sklep policzył mu za dużo za naprawę.",
                                "de": "Der Kunde wurde <w>wütend</w>, als er feststellte, dass das Geschäft ihm zu viel für die Reparatur berechnet hatte.",
                                "fr": "Le client est devenu <w>furieux</w> lorsqu'il s'est rendu compte que le magasin lui avait facturé trop cher la réparation.",
                                "it": "Il cliente si è <w>infuriato</w> quando si è reso conto che il negozio gli aveva fatto pagare troppo per la riparazione.",
                                "cs": "Zákazník byl <w>nepříčetný vzteky</w>, když si uvědomil, že mu obchod naúčtoval za opravu příliš mnoho.",
                                "tr": "Müşteri, mağazanın onarım için kendisinden fazla ücret aldığını fark edince <w>küplere bindi</w>.",
                                "es": "El cliente se puso <w>furioso</w> cuando se dio cuenta de que la tienda le había cobrado de más por la reparación."
                            }
                        },
                        {
                            "text": "She was <w>furious</w> at her brother for breaking her favorite camera without even apologizing.",
                            "target_lang_translations": {
                                "ru": "Она была <w>разгневана</w> на брата за то, что он сломал её любимую камеру и даже не извинился.",
                                "nl": "Ze was <w>woedend</w> op haar broer omdat hij haar favoriete camera had gebroken zonder zelfs maar zijn excuses aan te bieden.",
                                "pl": "Była <w>wściekła</w> na swojego brata za to, że zepsuł jej ulubiony aparat i nawet nie przeprosił.",
                                "de": "Sie war <w>zornig</w> auf ihren Bruder, weil er ihre Lieblingskamera kaputtgemacht hatte, ohne sich überhaupt zu entschuldigen.",
                                "fr": "Elle était <w>furieuse</w> contre son frère pour avoir cassé son appareil photo préféré sans même s'excuser.",
                                "it": "Era <w>furiosa</w> con suo fratello per averle rotto la macchina fotografica preferita senza nemmeno chiedere scusa.",
                                "cs": "Byla na svého bratra <w>rozzuřená</w>, protože jí rozbil oblíbený fotoaparát a ani se neomluvil.",
                                "tr": "En sevdiği kamerasını kırıp özür bile dilemediği için erkek kardeşine çok <w>öfkeliydi</w>.",
                                "es": "Ella estaba <w>furiosa</w> con su hermano por romper su cámara favorita sin siquiera disculparse."
                            }
                        }
                    ],
                    "synonyms": [
