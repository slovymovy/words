                "senses": [
                    {
                        "sense_id": "b7b21075-61ad-3db9-94a4-f47315e5fe9d",
                        "entry_id": "014f435c-9140-3142-9e4a-db681e2a0d78",
                        "glosses": [
                            "открыть (дверь, окно и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34fe6101-5824-48b9-a4a9-0b43c6347a55",
                                "sense_id": "b7b21075-61ad-3db9-94a4-f47315e5fe9d",
                                "text": "— Ну, теперь кто хочешь, хоть головой в ворота бейся, не отворю."
                            },
                            {
                                "example_id": "556f2858-f9d0-43fc-84b3-ba7159c94c0c",
                                "sense_id": "b7b21075-61ad-3db9-94a4-f47315e5fe9d",
                                "text": "И вы будьте подобны людям, ожидающим возвращения господина своего с брака, дабы, когда придёт и постучит, тотчас отворить ему."
                            }
                        ]
                    },
                    {
                        "sense_id": "88597862-f7cd-3def-a7f9-aced8f9665f6",
                        "entry_id": "014f435c-9140-3142-9e4a-db681e2a0d78",
                        "glosses": [
                            "открыв, раскрыв, распахнув створки, дверь или убрав иную преграду, сделать доступным вход куда-либо, выход откуда-либо"
                        ],
