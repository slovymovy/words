                ],
                "senses": [
                    {
                        "sense_id": "1044fc76-7ee4-3ecb-a27a-60e99de80229",
                        "entry_id": "f7e02e15-3be6-3ab7-801e-025bb4043e5a",
                        "glosses": [
                            "A coffee from Starbucks."
                        ],
                        "tags": [
                            "countable",
                            "metonymically",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e08d3d4c-3f8e-4792-86f9-faa2a0730d39",
                                "sense_id": "1044fc76-7ee4-3ecb-a27a-60e99de80229",
                                "text": "I swear, if I had been drinking my Starbucks today it would have gone up my nose."
                            },
                            {
                                "example_id": "e2040a85-a61a-448e-b474-d7f4765481c3",
                                "sense_id": "1044fc76-7ee4-3ecb-a27a-60e99de80229",
                                "text": "One part-time sociologist made an even more damning indictment: “Calling yourself a coffee nerd while drinking Starbucks is like calling yourself a beer nerd while drinking Budweiser.”"
                            },
                            {
                                "example_id": "ca43e275-7854-4d4a-aad7-a153107fa2c8",
                                "sense_id": "1044fc76-7ee4-3ecb-a27a-60e99de80229",
                                "text": "I read it straight through while I drank three Starbucks."
                            },
                            {
                                "example_id": "33cc5bcb-2eae-45c4-97ef-a680942b8218",
                                "sense_id": "1044fc76-7ee4-3ecb-a27a-60e99de80229",
                                "text": "“Good, have they got coffee?” Lorraine nodded. “Yes, they’ve been in since about eight and brought Starbucks.”"
                            },
                            {
                                "example_id": "cc99b930-6dde-423d-9bfd-dba81a5ba5ee",
                                "sense_id": "1044fc76-7ee4-3ecb-a27a-60e99de80229",
                                "text": "US Weekly’s regular photographic feature, “Stars: They’re Just Like Us!” which features celebrities engaged in such mundanities as pumping their own gas or drinking Starbucks, is a direct visual demonstration of this condescending simulated intimacy."
                            }
                        ]
                    }
