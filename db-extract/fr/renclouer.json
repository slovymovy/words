                        "glosses": [
                            "Enclouer de nouveau ; renforcer l'enclouage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e6562fba-2426-425e-a505-b79c56fa50bd",
                                "sense_id": "34ae6a3a-de75-39b0-aaa2-a5402d717ecc",
                                "text": "Je la reprends au vol, je la refixe sur l’outil de Sulpice toujours prêt à la renclouer ; je lui redarde mon vit au derrière ; […]."
                            },
                            {
                                "example_id": "f6dfb728-3b07-43c7-a451-95ee6885af37",
                                "sense_id": "34ae6a3a-de75-39b0-aaa2-a5402d717ecc",
                                "text": "Buvons cinq coups, buvons en six,\nÀ la santé du Duc de Guise,\nQu'est là pour renclouer la barque."
                            }
                        ]
                    }
