                "senses": [
                    {
                        "sense_id": "5536b730-da81-3d0b-9a14-43927f6c72ae",
                        "entry_id": "2a3f8195-f8c4-31b8-87cc-1ef126b13674",
                        "glosses": [
                            "weibliche Person, die beruflich Fenster herstellt, repariert sowie ein- und ausbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bcf13b5-192e-4335-a09b-e8dc5dc406d3",
                                "sense_id": "5536b730-da81-3d0b-9a14-43927f6c72ae",
                                "text": "„Ganz am Anfang ihres Arbeitsbeginnes, war sie Fensterbauerin (also Fenster in Neubauten bzw. Altbauten einzusetzen).“"
                            },
                            {
                                "example_id": "c8ae6efc-755e-45f9-9a22-0269871fdca0",
                                "sense_id": "5536b730-da81-3d0b-9a14-43927f6c72ae",
                                "text": "„Seit einem Jahr bin ich ausgebildete Glaser- und Fensterbauerin und arbeite in einem 3-Mann-Betrieb, was natürlich sehr zu meiner Selbstständigkeit beiträgt.“"
                            },
                            {
                                "example_id": "7e765378-9581-437b-9448-63931ab12e76",
                                "sense_id": "5536b730-da81-3d0b-9a14-43927f6c72ae",
                                "text": "„»Dass die Handwerker nicht wollen, stimmt nicht. Viele können auch nicht. Die Betriebe können nur das abarbeiten, was sie in der Lage sind, personell zu stemmen«, sagt die Fensterbauerin [Alexandra Bühler-Florath].“"
                            },
                            {
                                "example_id": "1717a401-6e67-4549-a011-337b4926951d",
                                "sense_id": "5536b730-da81-3d0b-9a14-43927f6c72ae",
                                "text": "„Vertreten waren unter anderem Architektinnen und Architekten, Bauingenieurinnen und Bauingenieure sowie Fensterbauerinnen und Fensterbauer.“"
                            },
                            {
                                "example_id": "6e9adaea-369d-40da-94e9-d1fe637528b7",
                                "sense_id": "5536b730-da81-3d0b-9a14-43927f6c72ae",
                                "text": "„Die Möbelschreinerin, die im Familienbetrieb als Fensterbauerin tätig ist, hat den Schrank selber gezimmert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
