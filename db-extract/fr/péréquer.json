                "senses": [
                    {
                        "sense_id": "7a80fad6-66d6-3f1a-88c7-5cb1d20afb2a",
                        "entry_id": "b0d51960-018e-3986-a45d-338b03c907cb",
                        "glosses": [
                            "Assurer une péréquation, répartir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661fd841-3bc8-4522-8479-21e220928d84",
                                "sense_id": "7a80fad6-66d6-3f1a-88c7-5cb1d20afb2a",
                                "text": "La défenderesse répond, tout d'abord, par des explications sur le concept de péréquation. Péréquater, ou péréquer, signifie répartir équitablement des charges, adapter des valeurs l'une à l'autre."
                            },
                            {
                                "example_id": "fd26bf22-46a7-4abe-b363-aac0f0b6baf1",
                                "sense_id": "7a80fad6-66d6-3f1a-88c7-5cb1d20afb2a",
                                "text": "En réduisant le handicap naturel qu'est pour une PME un manque de volume suffisant pour péréquer les risques, on corrigerait un déséquilibre qui, en se prolongeant, menacerait nos institutions politiques."
                            }
                        ]
                    }
