                    {
                        "translation_id": "f509c428-323f-45ee-8f1d-ba660465dc83",
                        "source_entry_id": "134e27a4-862c-3fb1-9d70-a538895ffcb1",
                        "source_sense_id": "c1a6ff47-593a-3a03-8bfc-0baea51b3df3",
                        "target_lang_word": "four à chaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "four à chaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b54ad68-a704-3211-9fd2-23d7b5ef83ed",
                                        "entry_id": "3972072d-6ff3-34d8-a929-00fd2bde60e8",
                                        "glosses": [
                                            "Four industriel dans lequel on transforme le calcaire en chaux, par cuisson à haute température."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d8352b-ecd1-4db4-b0ef-d90d3ca457c7",
                                                "sense_id": "7b54ad68-a704-3211-9fd2-23d7b5ef83ed",
                                                "text": "C’est pour m’assurer de ce fait que je fis ramasser autour du four à chaux une grande quantité de ces pierres que les chaufourniers appellent du biscuit, & qu’ils jettent, comme n’étant pas assez calcinées : en effet quand on les met dans l’eau, elles ne font point d’effervescence & ne se dissolvent pas."
                                            },
                                            {
                                                "example_id": "f28d0519-5521-4662-a2fd-3a19ab1211dd",
                                                "sense_id": "7b54ad68-a704-3211-9fd2-23d7b5ef83ed",
                                                "text": "« Hier après-midi, la gendarmerie de Caudebec, avertie qu’un bûcheron avait entendu des cris de femme appelant au secours et qui sortaient d’un ancien four à chaux situé sur la lisière de la forêt de Maulévrier, mit en campagne un brigadier et un gendarme. »"
                                            },
                                            {
                                                "example_id": "837d4c18-16a3-4c04-aee0-60dca4ecc2d5",
                                                "sense_id": "7b54ad68-a704-3211-9fd2-23d7b5ef83ed",
                                                "text": "Nous avançons dans un paysage de crayères et d’anciens fours à chaux. Les parapets effondrés, les murs et les fourneaux en pierres appareillées ressemblent à des fortifications abandonnées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b5984da-8ffc-3e7a-aa83-ad33eac7c4a7",
                                        "entry_id": "3972072d-6ff3-34d8-a929-00fd2bde60e8",
                                        "glosses": [
                                            "Meuble représentant le four du même nom dans les armoiries. Il est représenté de front avec généralement le foyer d'un émail différent du bâti. À rapprocher de four."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f06828bf-f6a1-4623-9c92-6be2b9529164",
                                                "sense_id": "5b5984da-8ffc-3e7a-aa83-ad33eac7c4a7",
                                                "text": "D’azur au four à chaux d’argent maçonné de sable au foyer de gueules, accompagné de trois fleurs de lys d’or, deux en chef accostant la cheminée du four, une en pointe, qui est de la commune de Chaufour-lès-Bonnières → voir illustration « armoiries avec un four à chaux »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
