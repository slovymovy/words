                    {
                        "translation_id": "f86a9a40-8b6a-4833-afa0-1672e0227225",
                        "source_entry_id": "22320e27-feb4-3010-a86a-3ce49e3329f7",
                        "source_sense_id": "6b26f816-5b4c-39be-8d3a-28a8088e8712",
