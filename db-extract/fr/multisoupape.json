                        "entry_id": "17a33813-a04a-3198-a41d-7d7704c1eec9",
                        "glosses": [
                            "Se dit d'un moteur à explosion qui possède plus d'une soupape d'admission et/ou plus d'une soupape d'échappement par cylindre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9ed05bda-a28b-4f33-a736-3afb3a6303b6",
                                "sense_id": "08be8c93-6ee4-3194-82c6-6cdfff500489",
                                "text": "… pendant lesquelles auront vu le jour le Tdi, le turbo à géométrie variable, des culasses multisoupapes sur des motorisations diesel."
                            },
                            {
                                "example_id": "c34e3b25-821a-4226-a00a-8e94cd254a57",
                                "sense_id": "08be8c93-6ee4-3194-82c6-6cdfff500489",
                                "text": "Cette solution est assez coûteuse, en particulier pour les moteurs multisoupapes fabriqués en moyenne série."
                            }
                        ]
                    }
