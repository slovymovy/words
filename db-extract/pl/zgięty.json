                                    },
                                    {
                                        "sense_id": "c4101a5d-2141-354b-bbf4-c59e11b0db59",
                                        "entry_id": "ba98fdcc-6196-32da-bbe5-d4e0ff4400b6",
                                        "glosses": [
                                            "Homosexual."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3292f3c8-9613-4912-9011-852cd8cd0ef1",
                                                "sense_id": "c4101a5d-2141-354b-bbf4-c59e11b0db59",
                                                "text": "Asked bluntly by Julie Webb of the NME whether he was “bent” in December 1974, Freddie answered evasively: “You're a crafty cow. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a195d29-b1f1-3102-96c1-77219a462281",
                                        "entry_id": "ba98fdcc-6196-32da-bbe5-d4e0ff4400b6",
                                        "glosses": [
                                            "Determined or insistent; inclined, set."
                                        ],
                                        "tags": [
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bfa5562-bf25-4d51-9d7a-c0bf440914ae",
                                                "sense_id": "2a195d29-b1f1-3102-96c1-77219a462281",
                                                "text": "He was bent on going to Texas, but not even he could say why."
                                            },
                                            {
                                                "example_id": "8ee32cef-fa86-4526-a2f2-8d26d850138a",
                                                "sense_id": "2a195d29-b1f1-3102-96c1-77219a462281",
                                                "text": "They were bent on mischief."
                                            },
                                            {
                                                "example_id": "51ade2a7-103a-403b-8761-1ba36e050cc0",
                                                "sense_id": "2a195d29-b1f1-3102-96c1-77219a462281",
                                                "text": "[…]in the ape posse, bent on vengeance, traversing landscapes clothed in snow and bristling with California red fir and silver pine, spooking human stragglers, and running across fresh graves as they search for the nameless colonel and try to piece together why the humans are killing each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471a8ea2-7404-3ebe-ace0-57217b0dd98a",
                                        "entry_id": "ba98fdcc-6196-32da-bbe5-d4e0ff4400b6",
                                        "glosses": [
                                            "Annoyed; out of sorts; having a bee in one's bonnet."
                                        ],
                                        "tags": [
                                            "with about"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aff092e-9035-49f5-aa5f-14e191251a43",
                                                "sense_id": "471a8ea2-7404-3ebe-ace0-57217b0dd98a",
                                                "text": "Near-synonym: butthurt"
                                            },
                                            {
                                                "example_id": "3b0b67fd-6db9-43ec-9213-f2e0ad3490ca",
                                                "sense_id": "471a8ea2-7404-3ebe-ace0-57217b0dd98a",
                                                "text": "She was bent about \"certain kinds of people\" having civil rights; she wanted to roll those back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a9a17a-6d90-3167-9579-9fe04f4d2c28",
                                        "entry_id": "ba98fdcc-6196-32da-bbe5-d4e0ff4400b6",
                                        "glosses": [
                                            "leading a life of crime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94a25226-29ec-38ab-ad8a-1b7a211d97c6",
                                        "entry_id": "ba98fdcc-6196-32da-bbe5-d4e0ff4400b6",
                                        "glosses": [
                                            "Inaccurately aimed."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "699c687b-8ce1-47c6-a070-c89a70d2549e",
                                                "sense_id": "94a25226-29ec-38ab-ad8a-1b7a211d97c6",
                                                "text": "That shot was so bent it left the pitch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ded8b5-c983-39b2-a7e8-ec8b145fcd3e",
                                        "entry_id": "ba98fdcc-6196-32da-bbe5-d4e0ff4400b6",
                                        "glosses": [
                                            "Suffering from the bends."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4ac710b-698c-37dc-a650-41c0998792ea",
                                        "entry_id": "ba98fdcc-6196-32da-bbe5-d4e0ff4400b6",
                                        "glosses": [
                                            "High from both marijuana and alcohol."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84bae3ce-dadf-4817-8eb2-218e22f4b3ed",
                                                "sense_id": "d4ac710b-698c-37dc-a650-41c0998792ea",
                                                "text": "Man, I am so bent right now!"
                                            }
                                        ]
                                    }
                                ]
                            },
