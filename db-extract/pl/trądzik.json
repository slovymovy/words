                                    {
                                        "sense_id": "7e1a969f-d33e-3bc3-9a17-9bdddad62282",
                                        "entry_id": "db2cdbf6-fe90-3e73-93cd-b7beb500d0e8",
                                        "glosses": [
                                            "A skin condition, usually of the face, that is common in adolescents. It is characterised by red pimples, and is caused by the inflammation of sebaceous glands through bacterial infection."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbaf0b20-59be-426c-a707-1d24b5a24312",
                                                "sense_id": "7e1a969f-d33e-3bc3-9a17-9bdddad62282",
                                                "text": "He struggled with severe acne during his teenage years."
                                            },
                                            {
                                                "example_id": "8fa11296-3591-46ec-b699-4009b61f1dad",
                                                "sense_id": "7e1a969f-d33e-3bc3-9a17-9bdddad62282",
                                                "text": "The dermatologist prescribed a cream to treat her acne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "485b7fee-cecc-3847-92e9-8002bf9a29b5",
                                        "entry_id": "db2cdbf6-fe90-3e73-93cd-b7beb500d0e8",
                                        "glosses": [
                                            "A pattern of blemishes in an area of skin resulting from the skin condition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "984fa2be-7bc9-4a0a-a3ef-d67730b24320",
                        "source_entry_id": "adb254f2-32a5-31ec-a200-72ce77f9498c",
                        "source_sense_id": "d3bd0a37-79a5-3bfb-9405-39094f29883b",
                        "target_lang_word": "akné",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akné",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                        "entry_id": "ad9675a5-469a-3611-8f77-b817283979fe",
                                        "glosses": [
                                            "kožní onemocnění — zánět mazového váčku projevující se vznikem tzv. komedonů, čili uhrů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2545b7e-4444-45ed-ae57-b3f9f60d0038",
                                                "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                                "text": "Mnohé z nás akné v pubertě pěkně potrápilo, někdo musí tento problém řešit dodnes."
                                            },
                                            {
                                                "example_id": "9c314f3b-d7bc-4ec7-a005-62a713bbf01e",
                                                "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                                "text": "Akné sužuje devět z deseti dospívajících. Za problémy s pletí mohou v pubertě hlavně hormonální bouře, kterými tělo dospívajících prochází."
                                            },
                                            {
                                                "example_id": "3ac3c8f8-d704-41d9-92b0-83038c9886a8",
                                                "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                                "text": "Máte prosím nějaký osvědčený přípravek, který můžete doporučit pro zmírnění tvorby akné? Dcera je v pubertě, na obličeji i po ramenou se jí tvoří akné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7261ee95-0e1d-4109-bb38-6dacc2e379e2",
                        "source_entry_id": "adb254f2-32a5-31ec-a200-72ce77f9498c",
                        "source_sense_id": "d3bd0a37-79a5-3bfb-9405-39094f29883b",
                        "target_lang_word": "acné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                        "entry_id": "dca185d5-7589-30a3-bc21-e74a07736218",
                                        "glosses": [
                                            "Dermatose inflammatoire et pustuleuse du visage ou de la partie supérieure du thorax, due à une inflammation des follicules pilosébacés (les glandes sécrétant le sébum, à la racine des poils) avec formation de comédons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa7e2a9-6732-467d-a509-226095c3ca47",
                                                "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                                "text": "Son visage est abimé par une acné sévère."
                                            },
                                            {
                                                "example_id": "1fdd739c-9c85-49ad-bba6-c127c694110a",
                                                "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                                "text": "L'acné est une dermatose chronique évoluant par poussées, très fréquente à la puberté."
                                            },
                                            {
                                                "example_id": "91f84aef-3224-4ebb-8cf4-a8a47b69adff",
                                                "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                                "text": "Observée de suffisamment haut dans l’exosphère, une explosion nucléaire ressemble à l’éclosion d’un bouton d’acné. — (Daniel Nayeri, Coco et Cloclo, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 293)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2aeb8f2-a4ee-4fb3-9839-7a426933f384",
                        "source_entry_id": "adb254f2-32a5-31ec-a200-72ce77f9498c",
                        "source_sense_id": "d3bd0a37-79a5-3bfb-9405-39094f29883b",
                        "target_lang_word": "acné",
