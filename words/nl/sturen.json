                    "sense_id": "8648fc2e-4310-33a8-b48b-884875109e66",
                    "sense_definition": "Iets, zoals een brief, bericht of pakket, naar een ontvanger of bestemming doen toekomen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verzenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zal je morgen een lange brief <w>sturen</w> met al het nieuws.",
                            "target_lang_translations": {
                                "en": "I will <w>send</w> you a long letter tomorrow with all the news.",
                                "ru": "Я <w>отправлю</w> тебе завтра длинное письмо со всеми новостями.",
                                "pl": "Jutro <w>wyślę</w> ci długi list ze wszystkimi nowościami."
                            }
                        },
                        {
                            "text": "Heb jij dat grappige berichtje naar je vrienden <w>gestuurd</w>?",
                            "target_lang_translations": {
                                "en": "Did you <w>send</w> that funny message to your friends?",
                                "ru": "Ты <w>отправил</w> это смешное сообщение своим друзьям?",
                                "pl": "Czy <w>wysłałeś</w> tę śmieszną wiadomość do swoich znajomych?"
                            }
                        }
                    ],
                    "synonyms": [
                        "zenden",
                        "verzenden",
                        "opsturen"
                    ],
                    "common_phrases": [
                        "een brief sturen",
                        "een berichtje sturen",
                        "een kaartje sturen",
                        "geld sturen"
