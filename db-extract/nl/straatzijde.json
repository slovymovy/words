                        "glosses": [
                            "de kant van een gebouw die dichtbij de straat is gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33449f87-571f-4d7b-890b-95f54c87b379",
                                "sense_id": "a43d37da-ab19-3782-b316-0c3ecaa67d59",
                                "text": "Het karakteristieke geluid van de koebel, die in een zijkamertje aan de straatzijde van het plafond afhing, had Quispel al op afstand door de stille avond gehoord."
                            },
                            {
                                "example_id": "cc47121b-1fca-4e06-a8cc-df4f99f92990",
                                "sense_id": "a43d37da-ab19-3782-b316-0c3ecaa67d59",
                                "text": "Dorpshoes Erve Boerrigter aan de Plechelmusstraat heeft in de nacht van vrijdag op zaterdag ongenode gasten op bezoek gehad. Zonder dat de directe omwonenden daar iets van merkten, werden zowel een raam aan de straatzijde als de centrale toegangsdeur met grof geweld geforceerd."
                            }
                        ]
                    }
