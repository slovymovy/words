                    },
                    {
                        "translation_id": "0530f3ce-024a-4c0f-b542-5d2e79511d87",
                        "source_entry_id": "3221368b-d80b-33fb-94b7-aca3c331ef53",
                        "source_sense_id": "0353dc0f-209a-3076-953c-0359edaeda6c",
                        "target_lang_word": "zangeres",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zangeres",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "780fecd1-1e9b-3471-8b8f-f06ff0651858",
                                        "entry_id": "93db0c5a-f2c2-35e9-ab26-ebda6c3ccf0a",
                                        "glosses": [
                                            "vrouwelijke vorm van zanger"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c554ef9-57ec-42f0-9ce3-a8d32ca1c39c",
                                                "sense_id": "780fecd1-1e9b-3471-8b8f-f06ff0651858",
                                                "text": "Die band heeft een hele goede zangeres."
                                            },
                                            {
                                                "example_id": "163d0401-cd9b-477b-9ab3-3690ac8ba35c",
                                                "sense_id": "780fecd1-1e9b-3471-8b8f-f06ff0651858",
                                                "text": "Zangeres Sita won meerdere TMF Awards en kijkt daar met plezier op terug: 'Ik stond er op het podium met Janet Jackson' Véras Fawaz (31) is regisseur van videoclips van artiesten als Joost Klein, Goldband en Bizzey. \"Ik ben opgegroeid in Stadskanaal, in het noorden. TMF was de plek waar we konden dromen van de wereld.\""
                                            },
                                            {
                                                "example_id": "8b05f51f-7fab-4e75-9bd4-7e8df4bad89e",
                                                "sense_id": "780fecd1-1e9b-3471-8b8f-f06ff0651858",
                                                "text": "De outfit komt 'met alle toeters en bellen', inclusief de aanpassingen die Whitney zelf heeft gedaan. In het grijze pak dat de zangeres onder de outfit droeg, zitten zelfs nog wat gaten die er tijdens de opnames zijn ingekomen. Ook missen er daardoor wat chromen balletjes die aan het pak zaten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f6974d9-a9f2-4b00-99ba-4b7372cf15fc",
                        "source_entry_id": "3221368b-d80b-33fb-94b7-aca3c331ef53",
                        "source_sense_id": "0353dc0f-209a-3076-953c-0359edaeda6c",
                        "target_lang_word": "Sängerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sängerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                        "entry_id": "5fe15538-19a4-3976-8172-2dce1f06139a",
                                        "glosses": [
                                            "eine weibliche Person, die berufsmäßig singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ac3999-028f-4a1e-87c5-d5ccbecff446",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "Pink, Christina Aguilera, Lil' Kim und Mya waren die Sängerinnen von „Lady Marmalade“."
                                            },
                                            {
                                                "example_id": "fd53d6cc-e810-4629-8441-8d06229e0f99",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Da ist eine schwarze Sängerin mit einer schönen Stimme.“"
                                            },
                                            {
                                                "example_id": "07c18ff4-22a4-4ef6-8dd5-58e2f161b372",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Sie war Sängerin, er hatte sie unterrichtet.“"
                                            },
                                            {
                                                "example_id": "3468df7e-917f-4662-a22f-4aeb021728d1",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Im zweiten Akt verkleidet die Gräfin, die sich von dem kleinen Schäker und Draufgänger gern anhimmeln lässt, den jungen Mann, der von einer Sängerin gespielt wird, in eine junge Frau.“"
                                            },
                                            {
