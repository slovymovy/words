                "senses": [
                    {
                        "sense_id": "c4a34540-2137-3d12-991b-aa27efef897a",
                        "entry_id": "ec4540d8-b92d-3ea9-b360-4807c75766b9",
                        "glosses": [
                            "Description du poumon."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a99ea65c-cee5-3024-b4a7-6c73dcb70a92",
                        "entry_id": "ec4540d8-b92d-3ea9-b360-4807c75766b9",
                        "glosses": [
                            "Étude des mouvements respiratoires, en particulier quand ils ont été enregistrés par un pneumographe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c7bcf3-4b14-428e-8266-6f36714edad0",
                                "sense_id": "a99ea65c-cee5-3024-b4a7-6c73dcb70a92",
                                "text": "L’étude des tracés graphiques des mouvements respiratoires de la paroi thoracique constitue l’objet de la pneumographie ou spirographie."
                            },
                            {
                                "example_id": "10f92e93-324c-4553-8263-16b0baa4ecac",
                                "sense_id": "a99ea65c-cee5-3024-b4a7-6c73dcb70a92",
                                "text": "Exemple de technique psychophysiologique, la pneumographie … est l’étude du rythme respiratoire et de ses variations en fonction des conditions physiologiques et des situations dans lesquelles se trouve un sujet."
                            }
                        ]
                    },
                    {
                        "sense_id": "310fb405-b2e9-30e8-8fa7-b7bbecad2b95",
                        "entry_id": "ec4540d8-b92d-3ea9-b360-4807c75766b9",
                        "glosses": [
                            "Radiographie effectuée après insufflation d’air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a275beb-1470-4d9d-8623-69d24bcfd1bd",
                                "sense_id": "310fb405-b2e9-30e8-8fa7-b7bbecad2b95",
                                "text": "On peut réaliser la pneumographie cérébrale de deux manières. L’usage tend à réserver le nom de ventriculographie à l’injection directe d’air dans les ventricules selon les indications de Dandy (1918)."
                            }
                        ]
                    }
                ],
