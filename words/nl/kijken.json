                        {
                            "text": "Hij zat de hele middag videoclips te <w>kijken</w>.",
                            "target_lang_translations": {
                                "ru": "Он весь день сидел и <w>смотрел</w> видеоклипы.",
                                "en": "He sat <w>watching</w> music videos all afternoon.",
                                "pl": "Całe popołudnie siedział i <w>oglądał</w> teledyski.",
                                "de": "Er saß den ganzen Nachmittag da und <w>schaute</w> sich Videoclips an.",
                                "fr": "Il a passé tout l'après-midi à <w>regarder</w> des clips vidéo.",
                                "it": "È rimasto tutto il pomeriggio a <w>guardare</w> videoclip.",
                                "cs": "Celé odpoledne proseděl u <w>sledování</w> videoklipů.",
                                "tr": "Bütün öğleden sonra oturup video klipler <w>izledi</w>.",
                                "es": "Se pasó toda la tarde <w>viendo</w> videoclips."
                            }
