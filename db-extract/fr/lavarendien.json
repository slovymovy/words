                "senses": [
                    {
                        "sense_id": "4a1844e5-05d0-3f4b-9edd-bcd81c604f86",
                        "entry_id": "96b7bc86-961f-3472-a7ae-701c760c1f52",
                        "glosses": [
                            "Qui appartient à l’écrivain Jean de La Varende ou à son œuvre, ou qui évoque son univers littéraire ou son style d’écriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba235cbb-7693-418f-816b-fc503c0640f7",
                                "sense_id": "4a1844e5-05d0-3f4b-9edd-bcd81c604f86",
                                "text": "Mabire n’a jamais caché la fascination exercée par le maître du Chamblac, pas plus que ses réticences à l’égard de l’univers lavarendien."
                            },
                            {
                                "example_id": "6ec370ef-faa2-449f-b326-c06290bee9b6",
                                "sense_id": "4a1844e5-05d0-3f4b-9edd-bcd81c604f86",
                                "text": "Henry de Montherlant et Jean de La Varende appartiennent tous deux à des familles de la petite noblesse française. La prédilection montherlantienne pour l’espace méditerranéen et la préférence lavarendienne pour sa terre natale, la Normandie, lieux empreints d’un fort lien avec le passé, fournissent à ces auteurs la matière d’un grand nombre de récits écrits durant l’entre-deux-guerres."
                            },
                            {
                                "example_id": "faec143d-0f00-498e-90f7-caff30823996",
                                "sense_id": "4a1844e5-05d0-3f4b-9edd-bcd81c604f86",
                                "text": "S’il n’est pas le livre le plus connu du maître de Chamblac, ce roman est probablement le plus lavarendien de toute son œuvre. C’est aussi un hommage au modèle de l’auteur : Jules Barbey d’Aurevilly, dont il revendique l’héritage littéraire."
                            },
                            {
                                "example_id": "d160aa65-5ff5-47f7-a9ab-84a16c0fde93",
                                "sense_id": "4a1844e5-05d0-3f4b-9edd-bcd81c604f86",
                                "text": "À partir d’un tableau pittoresque, aux accents lavarendiens, de la vie quotidienne d’une famille aristocratique de province après la guerre, le livre bascule peu à peu dans le drame d’un huis-clos étouffant entre le marquis et ses descendants."
                            }
                        ]
                    }
