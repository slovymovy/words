                                "example_id": "d61fabda-2201-4606-8a19-ad9a29e35a01",
                                "sense_id": "8276aebe-1236-366a-9a67-798edac775f1",
                                "text": "Et aussi ces femmes auvergnates allant aux champs, un outil sous le bras, poussant une chèvre barbichue, une vache rousse efflanquée, cornes hautes."
                            },
                            {
                                "example_id": "10f17b83-b9be-4639-9d34-8c4accad94a3",
                                "sense_id": "8276aebe-1236-366a-9a67-798edac775f1",
                                "text": "L’homme, barbichu et grassouillet, se tient assis sur une banquette en cuir, dans un coin du restaurant."
                            }
                        ]
                    }
