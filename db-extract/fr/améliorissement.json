                "word": "améliorissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c02d472-a0b0-45ce-92f3-26c309255d5f",
                        "entry_id": "e9f2bfc8-9fe2-30a2-9dac-dbc0b779f203",
