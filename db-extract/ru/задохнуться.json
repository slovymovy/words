                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "задо́хну́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a7cc862-5779-359a-9f4c-ec0c737c145a",
                        "entry_id": "1b3e831b-fcb3-3252-b053-6c729748ade5",
                        "glosses": [
                            "умереть от недостатка воздуха, от удушья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42bd7bc4-43bf-462f-bbce-0951b4f431c2",
                                "sense_id": "8a7cc862-5779-359a-9f4c-ec0c737c145a",
                                "text": "― Что ты сделала? Тут же задохнуться можно! В квартире стоял аромат стухшей в вазе воды."
                            },
                            {
                                "example_id": "18bc041b-62c7-4987-9afe-8d0d5abdbaec",
                                "sense_id": "8a7cc862-5779-359a-9f4c-ec0c737c145a",
                                "text": "― Но вы не понимаете, если он не смоет краску в течение сорока минут, он может задохнуться, ― попыталась объяснить сложность ситуации Инна."
                            }
                        ]
                    },
                    {
                        "sense_id": "44451d22-391e-3ba5-8adb-282571c27ec1",
                        "entry_id": "1b3e831b-fcb3-3252-b053-6c729748ade5",
                        "glosses": [
                            "стать затхлым"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "845466ee-4845-325c-99b4-cc12c1066f55",
                        "entry_id": "1b3e831b-fcb3-3252-b053-6c729748ade5",
                        "glosses": [
                            "перен. с трудом переносить, выдерживать что-либо; страдать из-за отсутствия благоприятных условий для развития"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "57d11e95-f817-3937-85c4-943cb1b78777",
                        "entry_id": "1b3e831b-fcb3-3252-b053-6c729748ade5",
                        "glosses": [
                            "разг. испытать затруднение в дыхании, стеснение в груди от какого-либо сильного чувства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c3956db-12af-4451-93a3-51763f4c1b5b",
                                "sense_id": "57d11e95-f817-3937-85c4-943cb1b78777",
                                "text": "Ожгло огнём, безумие ударило в голову, он задохнулся от почти равной страданию радости, рванулся, чтоб на ходу выпрыгнуть из машины."
                            }
                        ]
                    }
                ],
