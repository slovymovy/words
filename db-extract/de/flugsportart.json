                "senses": [
                    {
                        "sense_id": "f07b6019-40b0-383f-9264-f908f1bfdad5",
                        "entry_id": "624f1bb8-6b63-3635-92a3-034737cf70ba",
                        "glosses": [
                            "sportliche Disziplin, die mit fliegerischen Techniken im Luftraum ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c77bf3-193e-456e-8cb6-6c2237b2374c",
                                "sense_id": "f07b6019-40b0-383f-9264-f908f1bfdad5",
                                "text": "„Nach der in meiner Befragung erkundeten öffentlichen Meinung zählen […] die Extremformen des Bergsteigens, Skifahrens, Snowboardens und Skatens, die unterschiedlichen Fallschirmsportarten, die Flugsportarten Gleitschirm-, Drachen- und Segelfliegen, die Wildwassersportarten, Formen des Tiefseetauchens wie Wracktauchen und Haitauchen, aber auch das Bahnsurfen und das Bungee-Jumping zu den meistgenannten spielerisch-sportlichen Betätigungen mit hohem Wagnischarakter.“"
                            },
                            {
                                "example_id": "58404cf2-79f7-44ac-a48b-c652274f2307",
                                "sense_id": "f07b6019-40b0-383f-9264-f908f1bfdad5",
                                "text": "„Gleitschirm: Ein Naturerlebnis der besonderen Art bietet diese relativ neue Flugsportart.“"
                            },
                            {
                                "example_id": "f6616e78-93c4-4cd6-a30e-9aa0adecb7b8",
                                "sense_id": "f07b6019-40b0-383f-9264-f908f1bfdad5",
                                "text": "„Gleitschirmfliegen gelte als äußerst sichere Flugsportart.“"
                            },
                            {
                                "example_id": "c84df427-7954-4769-81a3-63ec63582c26",
                                "sense_id": "f07b6019-40b0-383f-9264-f908f1bfdad5",
                                "text": "„Wohl kaum eine adere [sic!] Flugsportart kommt dem freien Fliegen so nah wie das Drachen- oder Gleitschirmfliegen.“"
                            },
                            {
                                "example_id": "b2dadee8-c41b-49a6-ac4d-ed72d0deb3aa",
                                "sense_id": "f07b6019-40b0-383f-9264-f908f1bfdad5",
                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
