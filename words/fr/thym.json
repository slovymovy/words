                    "frequency": "Middle",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ajoute un brin de <w>thym</w> frais dans la sauce pour parfumer le plat."
                        },
                        {
                            "text": "Dans les collines du Midi, le <w>thym</w> sauvage embaume l'air chaud en été."
                        }
                    ],
                    "synonyms": [
                        "farigoule",
                        "farigoulette"
                    ],
