                                        "glosses": [
                                            "Engel mit einer wichtigen, herausragenden Rolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b429b1-ec48-409e-9d44-60e9af9c39da",
                                                "sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                                                "text": "In der Bibel gibt es einen Erzengel namens Michael."
                                            },
                                            {
                                                "example_id": "663c9c25-f05b-4137-96a3-9e14191e616e",
                                                "sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                                                "text": "„So sauber und gut erhalten war alles, als werde der Erzengel jeden Moment in seiner Kirche erwartet.“"
                                            },
                                            {
                                                "example_id": "c0306a0d-04a4-4166-a59f-979a50fc5162",
                                                "sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                                                "text": "„Aber am Lager der Wöchnerin mit dem Kind im Arm halten Erzengel Wache.“"
                                            }
                                        ],
