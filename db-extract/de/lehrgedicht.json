                "senses": [
                    {
                        "sense_id": "bee202f9-55a9-3782-a549-ddd66a7a33c6",
                        "entry_id": "9c5c220b-db5f-39e3-9fe4-991fc3c18d91",
                        "glosses": [
                            "Gedicht mit lehrhaftem Inhalt"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "9fbe4118-b084-426e-8cd5-a7059c17a781",
                                "sense_id": "bee202f9-55a9-3782-a549-ddd66a7a33c6",
                                "text": "Lehrgedichte sollen ausdrücklich Wissen vermitteln und sich dabei poetischer Mittel bedienen."
                            },
                            {
                                "example_id": "5a92f7b6-87ec-463c-9881-c53b965ffe45",
                                "sense_id": "bee202f9-55a9-3782-a549-ddd66a7a33c6",
                                "text": "„Lukrez will in seinem Lehrgedicht zeigen, dass eine solche Weltbetrachtung, die selbstverständlich den Menschen und sein Seelenleben mit einbezieht, restlos aufgeht und also kein Grund besteht, sich über eine Welt-hinter-der-Welt Sorgen zu machen oder das Leben auf eine solche auszurichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
