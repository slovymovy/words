                },
                {
                    "sense_id": "38001d5b-4f12-3d39-b0ed-a255ede763ac",
                    "sense_definition": "Causing irritation or annoyance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>teasing</w> itch from the mosquito bite drove her crazy.",
                            "target_lang_translations": {
                                "ru": "<w>Раздражающий</w> зуд от укуса комара сводил её с ума."
                            }
                        },
                        {
                            "text": "A <w>teasing</w> wind blew dust into their eyes all afternoon.",
                            "target_lang_translations": {
                                "ru": "<w>Назойливый</w> ветер весь день задувал им пыль в глаза."
