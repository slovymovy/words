                                            {
                                                "example_id": "3b2509e7-d2ff-42da-ba31-f3159e02e8b5",
                                                "sense_id": "76d42677-bc3f-3b93-85ca-4f167fbb089f",
                                                "text": "Niemcy atakują Polskę bez wypowiedzenia wojny"
                                            }
