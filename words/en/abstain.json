{
    "word_family": [
        "abstinence",
        "abstinent",
        "abstainer",
        "abstention"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f11dd4e-4fbb-369e-ac98-b995ac9a7684",
                    "sense_definition": "To voluntarily refrain from an action or self-indulgence, especially one that is considered unhealthy or improper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In order to improve his health, Rob decided to <w>abstain</w> from smoking.",
                            "target_lang_translations": {
                                "ru": "Чтобы поправить здоровье, Роб решил <w>воздержаться</w> от курения.",
                                "zh": "为了改善健康，罗布决定<w>戒</w>烟。"
                            }
                        },
                        {
                            "text": "The doctor advised the patient to <w>abstain</w> from alcohol while taking the new medication.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал пациенту <w>воздерживаться</w> от алкоголя во время приема нового лекарства.",
                                "zh": "医生建议该患者在服用这种新药期间<w>克制</w>饮酒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forbear",
                        "forgo",
                        "refrain"
                    ],
                    "antonyms": [
                        "indulge"
                    ],
                    "common_phrases": [
                        "abstain from alcohol",
                        "abstain from smoking",
                        "abstain from meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добровольно отказываться от какого-либо действия или удовольствия, особенно если оно считается вредным или неуместным.",
                        "zh": "自觉地戒除或克制某种行为或嗜好（尤指被认为有害健康或不当之事）"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздерживаться",
                                "target_lang_sense_clarification": "от вредных привычек или удовольствий"
                            },
                            {
                                "target_lang_word": "отказываться",
                                "target_lang_sense_clarification": "от чего-либо по собственному желанию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戒除",
                                "target_lang_sense_clarification": "戒掉不良嗜好或习惯"
                            },
                            {
                                "target_lang_word": "克制",
                                "target_lang_sense_clarification": "抑制冲动或欲望"
                            },
                            {
                                "target_lang_word": "戒",
                                "target_lang_sense_clarification": "戒烟、戒酒等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62d2a7d0-3f6e-3296-b7cf-b897526f72e4",
                    "sense_definition": "To formally decline to vote either for or against a proposal or motion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>abstain</w> from this vote, as I have no particular preference.",
                            "target_lang_translations": {
                                "ru": "Я <w>воздерживаюсь</w> при этом голосовании, так как у меня нет особых предпочтений.",
                                "zh": "我在此次投票中<w>弃权</w>，因为我没有特别的偏好。"
                            }
                        },
                        {
                            "text": "Several members of the committee chose to <w>abstain</w> from voting on the controversial new policy.",
                            "target_lang_translations": {
                                "ru": "Несколько членов комитета решили <w>воздержаться</w> от голосования по спорной новой политике.",
                                "zh": "委员会的几名成员选择在这项有争议的新政策表决中<w>弃权</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "vote"
                    ],
                    "common_phrases": [
                        "abstain from voting",
                        "decide to abstain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально отказаться от голосования «за» или «против» какого-либо предложения или ходатайства.",
                        "zh": "在表决中正式声明弃权，既不投赞成票也不投反对票"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздержаться",
                                "target_lang_sense_clarification": "при голосовании"
                            },
                            {
                                "target_lang_word": "не участвовать",
                                "target_lang_sense_clarification": "в голосовании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弃权",
                                "target_lang_sense_clarification": "在投票或表决时不表态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce147820-ae18-3018-9a68-10c042d5256b",
                    "sense_definition": "To fast or deliberately avoid eating food for a specific period, often for religious or health reasons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "refrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the religious holiday, many people <w>abstain</w> from food until sunset.",
                            "target_lang_translations": {
                                "ru": "Во время религиозного праздника многие люди <w>воздерживаются</w> от пищи до захода солнца.",
                                "zh": "在这个宗教节日期间，许多人日落之前都会<w>禁食</w>。"
                            }
                        },
                        {
                            "text": "The monks would <w>abstain</w> from all solid food during their week of silent meditation.",
                            "target_lang_translations": {
                                "ru": "Монахи <w>воздерживались</w> от любой твердой пищи в течение недели безмолвной медитации.",
                                "zh": "在为期一周的静修冥想期间，僧侣们会<w>斋戒</w>，不进任何固体食物。"
                            }
                        }
                    ],
                    "antonyms": [
                        "feast"
                    ],
                    "common_phrases": [
                        "abstain from food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поститься или намеренно избегать приема пищи в течение определенного периода, часто по религиозным соображениям или по состоянию здоровья.",
                        "zh": "（通常出于宗教或健康原因）在特定时期内禁食或斋戒"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздерживаться",
                                "target_lang_sense_clarification": "от пищи"
                            },
                            {
                                "target_lang_word": "поститься",
                                "target_lang_sense_clarification": "соблюдать пост"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斋戒",
                                "target_lang_sense_clarification": "宗教性的禁食祈福"
                            },
                            {
                                "target_lang_word": "禁食",
                                "target_lang_sense_clarification": "停止进食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e11847d1-18ef-3b5a-bfca-2774a905e697",
                    "sense_definition": "To hinder, keep back, or withhold something or someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "withhold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient laws were designed to <w>abstain</w> men from marrying outside their social class.",
                            "target_lang_translations": {
                                "ru": "Древние законы были призваны <w>удерживать</w> мужчин от браков вне их социального класса.",
                                "zh": "这些古老的法律旨在<w>阻止</w>男子与阶级之外的人通婚。"
                            }
                        },
                        {
                            "text": "He sought to <w>abstain</w> the information from the public until the investigation was complete.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>скрыть</w> информацию от общественности до завершения расследования.",
                                "zh": "在调查完成之前，他试图对公众<w>扣留</w>这些信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "withhold"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This transitive usage is no longer common in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствовать, сдерживать или скрывать что-либо или кого-либо (устаревшее значение).",
                        "zh": "（古义）阻止、阻拦，或隐匿、扣留某物"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "кого-либо от действия"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "информацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻止",
                                "target_lang_sense_clarification": "拦阻某人做某事"
                            },
                            {
                                "target_lang_word": "扣留",
                                "target_lang_sense_clarification": "保留或隐瞒不公开"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}