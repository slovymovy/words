                                        "entry_id": "b339cd03-47e4-3ffb-a3c9-4e6285047e97",
                                        "glosses": [
                                            "jemand, der das gesamte Wissen seiner Zeit in Form einer Enzyklopädie zusammenfasst oder herausgibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abfaeb71-0aaf-4d74-ba8b-ded1c491364f",
                                                "sense_id": "7cd569a9-701f-3c74-9107-c841b7cf4912",
                                                "text": "„Hier ist de Sade wesentlich radikaler und mutiger als selbst die meisten Enzyklopädisten, obschon diese Haltung durch die lange Haftabgeschlossenheit in Vincennes und dann in der Bastille kaum zum Zuge kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
