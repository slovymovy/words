                "senses": [
                    {
                        "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                        "entry_id": "1964d698-8281-3fc5-909e-58cc5ec11d3e",
                        "glosses": [
                            "englischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb1051c-7458-4cd6-bbac-8ad2f32484c5",
                                "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                                "text": "Frau Simpson ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c6ce4d4c-fab3-4c8b-839b-c0f61b062370",
                                "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                                "text": "Herr Simpson wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "022ec1af-2cfe-4c8c-81ba-5d6a966f55e3",
                                "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                                "text": "Die Simpsons fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0b9fc10f-824e-437e-96ce-a545364fda3f",
                                "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                                "text": "Der Simpson trägt nie die Schals, die die Simpson ihm strickt."
                            },
                            {
                                "example_id": "400668d6-7724-4d02-b41f-cb8cd5f14712",
                                "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Simpson kommt, geht der Herr Simpson.“"
                            },
                            {
                                "example_id": "5cfe295f-e12b-44a0-bdc2-bebccdc1a93d",
                                "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                                "text": "Simpson kommt und geht."
                            },
                            {
                                "example_id": "3975c0c2-f1dd-479b-9525-c296b5b7331c",
                                "sense_id": "a2d72f1c-b374-3323-a86d-72b34d6fdd45",
                                "text": "Simpsons kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
