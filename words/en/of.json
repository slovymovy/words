                {
                    "sense_id": "77c14c32-b03a-3407-993a-8b6524f86dba",
                    "sense_definition": "Initialism of Old French.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "languages",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "The etymology of the word can be traced back to <w>OF</w> roots.",
                            "target_lang_translations": {
                                "ru": "Этимологию слова можно проследить до <w>старофранцузских</w> корней."
