                "senses": [
                    {
                        "sense_id": "21f04a7b-46d2-3ef8-99a7-f8d26b53aa4f",
                        "entry_id": "38d4d4cb-580c-3810-b176-2fa8765316d4",
                        "glosses": [
                            "нашивной кусок материи, закрывающий прореху на мужских штанах, расположенную спереди по линии соединения брючин"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7babfecc-4223-4fa2-84be-9d20529e2e41",
                                "sense_id": "21f04a7b-46d2-3ef8-99a7-f8d26b53aa4f",
                                "text": "Разрежьте старенькие джинсы (протёрлись, укоротились) по уровню бедер, сохраняя гульфик."
                            }
                        ]
                    },
                    {
                        "sense_id": "5496dfbd-5f67-3757-8ef2-d0c5714daa33",
                        "entry_id": "38d4d4cb-580c-3810-b176-2fa8765316d4",
                        "glosses": [
                            "элемент доспеха, служащий для защиты гениталий"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc91a0b0-af53-4c86-94fe-d058a9ffedb2",
                        "source_entry_id": "38d4d4cb-580c-3810-b176-2fa8765316d4",
                        "source_sense_description": "элемент одежды",
                        "target_lang_word": "brachetta",
