                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3addded-3b48-4238-b90e-9e69d073e687",
                                "sense_id": "3f7641fd-cf3f-3058-8129-bf9a03833d00",
                                "text": "Doris war die Ehefrau des Begründers der „jüngeren Tyrannis“ in Syrakus."
                            },
                            {
                                "example_id": "f05b86c0-8311-4809-828b-4cb3ceb306b9",
                                "sense_id": "3f7641fd-cf3f-3058-8129-bf9a03833d00",
                                "text": "Doris ist in der griechischen Mythologie eine Okeanide."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f25f4c7c-089d-413f-b002-09fdbe8cfd07",
