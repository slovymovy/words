                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tollpatschig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66ce7d84-6a6a-379f-8677-7d737876bea9",
                                        "entry_id": "138d5708-194c-3156-a604-05041d847963",
                                        "glosses": [
                                            "ungeschickt, tölpelhaft agierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cc1ae89-ad3e-4650-b2b3-185970eb85a2",
                                                "sense_id": "66ce7d84-6a6a-379f-8677-7d737876bea9",
                                                "text": "Tollpatschig wie er ist, kippte er beim Aufstehen sein volles Glas um."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c4c15fd-3628-4b3f-a959-76a99a099383",
                        "source_entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                        "source_sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                        "target_lang_word": "awkwardly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awkwardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83366d5c-2f2e-31ba-a00d-24443b934ad1",
                                        "entry_id": "5be128d0-c7e9-30e2-a385-12fb83e379e9",
                                        "glosses": [
                                            "In an awkward manner; with discomfort or lack of coordination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57754ca5-4305-4821-8d5f-77f5e3ff6acd",
                                                "sense_id": "83366d5c-2f2e-31ba-a00d-24443b934ad1",
                                                "text": "A poorly finished trunk has an awkwardly high liftover and no useful handhold on its lid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38eb21a5-00c2-4819-ae48-bc253561e3a0",
                        "source_entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                        "source_sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                        "target_lang_word": "carelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Giving the appearance of carelessness; relaxedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8156b1-f80e-4106-a27e-65fb7b5b85c6",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "The papers were carelessly strewn on the table."
                                            },
                                            {
                                                "example_id": "c1542fe3-8aa4-46b6-abb7-4b3840f404e0",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "Let us try to imagine the qualms of some Fifth Avenue florist if he could but see so many potential boutonnières, at a dollar apiece, so carelessly heaped up in baskets, lining the dingy pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Done without care or attention; inattentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cd05c4-3647-4311-b5dc-962173fd5149",
                                                "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                                "text": "Distracted by the salesperson, he carelessly read the contract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeb77aec-3974-421c-9359-1077fed5e420",
                        "source_entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                        "source_sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                        "target_lang_word": "maladroitly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maladroitly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08071886-aa67-3889-bb86-f02d2c58e15d",
                                        "entry_id": "0e97f23d-2842-3335-a0ca-bef086f7fb75",
                                        "glosses": [
                                            "In a maladroit manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9af92df-de0e-4fd4-b575-90c4d19fc9b1",
                                                "sense_id": "08071886-aa67-3889-bb86-f02d2c58e15d",
                                                "text": "There was only one chair, and they offered it to her. They stood over her, maladroitly, apparently unsure how to proceed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "879ca8a2-b898-4b11-ae54-0dd916c11a56",
                        "source_entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                        "source_sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                        "target_lang_word": "sloppily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sloppily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50f2afab-321e-3843-aaa8-b10930c2d4d6",
                                        "entry_id": "bbec266f-8d15-3392-8d90-4c98f7450245",
                                        "glosses": [
                                            "In a sloppy manner, not neatly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19deb296-b15a-4636-8247-d5e7b2bb6be4",
                                                "sense_id": "50f2afab-321e-3843-aaa8-b10930c2d4d6",
                                                "text": "[…] as soul-deadeningly, eye-strainingly, sleep-inducingly boring as going through fourteen file boxes of sloppily photostatted bank records."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1e2f38e-6925-4a62-bb35-ec4d3b2aaa9c",
