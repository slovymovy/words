                "senses": [
                    {
                        "sense_id": "eae5893a-f431-3d7b-8fa2-0abf040f26b2",
                        "entry_id": "429d8fdd-31e4-3d41-a95d-eb9d96363555",
                        "glosses": [
                            "One who moralises within a fandom space, especially over sexual content and shipping."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f8dcdb9c-7716-445e-9c88-0acd8e5d3aae",
                                "sense_id": "eae5893a-f431-3d7b-8fa2-0abf040f26b2",
                                "text": "Fantis condemn \"problematic\" ships & fanfic more often and with more vigor than they condemn harassment in fandom."
                            },
                            {
                                "example_id": "4d91e6db-0d46-4216-8ad1-9c06c487d7d2",
                                "sense_id": "eae5893a-f431-3d7b-8fa2-0abf040f26b2",
                                "text": "I love toxic ships, but I was so turned off by the fantis that I visibly cringe whenever I see it"
                            },
                            {
                                "example_id": "4759aa72-2142-48d3-b106-577bb8aa6e00",
                                "sense_id": "eae5893a-f431-3d7b-8fa2-0abf040f26b2",
                                "text": "I’m just so sick of fantis acting like every proshipper only ships the most fxcked up nasty stuff when some of us don’t want to touch the extreme fictional stuff."
                            }
                        ]
                    }
                ],
