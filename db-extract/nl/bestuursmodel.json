                        "examples": [
                            {
                                "example_id": "0d7db690-4970-4bd7-ba12-5ec9d65539b2",
                                "sense_id": "58a06530-5cb6-388f-b7da-e2ed7e6b34a1",
                                "text": "De licentiecommissie legde Twente een Europees verbod van drie jaar op. Ook zou de licentie van de club ingetrokken worden als de club niet zou meewerken aan een onafhankelijk onderzoek en het bestuursmodel niet ingrijpend zou veranderen."
                            },
                            {
                                "example_id": "3b0770ca-9391-4673-b236-38248b258cbb",
                                "sense_id": "58a06530-5cb6-388f-b7da-e2ed7e6b34a1",
                                "text": "De SP vindt dat de organisatie van Hogescholen en Universiteiten heel anders moet, en roept minister Bussemaker op zo snel mogelijk met een heel nieuw bestuursmodel te komen."
                            },
                            {
                                "example_id": "eefd133c-9a08-44f1-9544-4aee5498cd77",
                                "sense_id": "58a06530-5cb6-388f-b7da-e2ed7e6b34a1",
                                "text": "Wiebes wil weer meer controle krijgen over de Belastingdienst en verandert het bestuursmodel. De Belastingdienst heeft straks niet langer een raad van bestuur, maar valt via een directeur-generaal rechtstreeks onder het ministerie van Financiën."
                            }
