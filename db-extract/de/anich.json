                ],
                "senses": [
                    {
                        "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                        "entry_id": "2c8da622-00ad-3f5b-8eb5-7a3653c6da44",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164ae30c-8bf5-4a56-9558-497bead559c9",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "Frau Anich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "78cb7531-b7c2-4ed3-bc3f-f51ba2e0221e",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "Herr Anich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "678c31b6-709d-4871-982e-bfde274266c5",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "Die Anichs kommen heute aus der Innerschweiz."
                            },
                            {
                                "example_id": "2cef4c93-1846-4d36-a41c-517cbf717325",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "Der Anich trägt nie die Schals, die die Anich ihm strickt."
                            },
                            {
                                "example_id": "b5e3ffc7-23f7-4a8a-a7f0-9edb94092f2b",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Anich kommt, geht der Herr Anich.“"
                            },
                            {
                                "example_id": "ce920aa2-d845-496e-8658-c40cb2c066f4",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "Anich kommt und geht."
                            },
                            {
                                "example_id": "d8f10c0b-20fa-4c92-aec6-3d0b9d47b458",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "Anichs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e8b0f9e0-448d-47e0-838e-d7263e90452d",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "An verregneten Herbsttagen ist Familie Anichs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "7fe06aac-ddde-49d6-aec4-924525f50631",
                                "sense_id": "a913360a-4a0a-3d85-8534-6bb0789de4d1",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Anich das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
