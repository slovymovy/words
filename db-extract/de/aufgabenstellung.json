                ],
                "senses": [
                    {
                        "sense_id": "6f5d645a-6802-3fe4-80d5-239744c536a8",
                        "entry_id": "cde7899b-eecb-37a8-a6a9-3d0d1e63f7ee",
                        "glosses": [
                            "Thema oder Problematik, mit der sich jemand zu beschäftigen oder auseinanderzusetzen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14ffde3-654c-4b18-89e8-35d60db9434f",
                                "sense_id": "6f5d645a-6802-3fe4-80d5-239744c536a8",
                                "text": "„Diese Seminararbeit beschäftigt sich mit dem Thema Wissensmanagement und geht auf sechs verschiedene Aufgabenstellungen ein, die im nächsten Unterkapitel beschrieben werden.“"
                            },
                            {
                                "example_id": "d93b41a1-a420-448e-bba8-9dfacff8eeb2",
                                "sense_id": "6f5d645a-6802-3fe4-80d5-239744c536a8",
                                "text": "„Der hier behandelte Typ der Aufgabenstellung ist in zentralen Klassenarbeiten und Abiturthemen geläufig.“"
                            },
                            {
                                "example_id": "e7aaf648-147e-41f0-aa87-0362e4a98589",
                                "sense_id": "6f5d645a-6802-3fe4-80d5-239744c536a8",
                                "text": "„Die Forschungsbeiträge der Wirtschafts- und Verkehrswissenschaft sind nur in Teilen für die Aufgabenstellung dieser Arbeit relevant.“"
                            },
                            {
                                "example_id": "9f6581de-4a7e-42ac-9002-825e3b70e111",
                                "sense_id": "6f5d645a-6802-3fe4-80d5-239744c536a8",
                                "text": "„Das Buch gibt in komprimierter Form einen umfassenden und realistischen Überblick über die wesentlichen Aufgabenstellungen des Personalwesens im betrieblichen Arbeitsalltag, von der Einstellung bis zur Entlassung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
