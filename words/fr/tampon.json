                    ],
                    "synonyms": [
                        "bouchon"
                    ]
                },
                {
                    "sense_id": "4123028f-ef60-36df-bc96-7eb74c5a1b8a",
                    "sense_definition": "Petite masse de compresse, d'ouate ou d'étoffe servant à nettoyer, désinfecter ou étancher.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière désinfecte soigneusement la plaie avec un petit <w>tampon</w> imbibé d'alcool."
                        },
                        {
                            "text": "Le restaurateur applique le vernis sur le meuble en se servant d'un <w>tampon</w>."
