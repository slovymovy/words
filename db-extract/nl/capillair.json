                    {
                        "translation_id": "558a1d81-04a8-48ea-a8aa-a5793d447125",
                        "source_entry_id": "993eb6a5-444b-38fc-9380-c11a2278ab52",
                        "source_sense_id": "e347abf8-0081-3137-a764-059f69efe80b",
