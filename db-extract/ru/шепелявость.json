                    },
                    {
                        "translation_id": "a0f532d2-0d90-4956-92f1-c58d33e8ff4a",
                        "source_entry_id": "c0d01a69-3bee-38ff-99c7-5f9ea21b9fc5",
                        "source_sense_id": "0c205bd0-a51a-3123-91fc-83b3afeb5f63",
                        "target_lang_word": "chuintement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chuintement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd359926-c49d-3aa7-841b-c21f23780ca4",
                                        "entry_id": "53289408-efd5-3a21-a4c6-eb49f7d79485",
                                        "glosses": [
                                            "Son d’une consonne qui chuinte."
                                        ],
                                        "tags": [
                                            "Phonétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d6b4e3-b993-4825-a160-f218bb40b66a",
                                                "sense_id": "dd359926-c49d-3aa7-841b-c21f23780ca4",
                                                "text": "Dans le Marlois, en effet, le traitement habituel du C devant A est le chuintement, et notamment quand il s’agit de toponymes."
                                            },
                                            {
                                                "example_id": "86eec0ac-19c2-4f31-b7a9-45a3873fc1fe",
                                                "sense_id": "dd359926-c49d-3aa7-841b-c21f23780ca4",
                                                "text": "Un léger chuintement gênait son élocution"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21adf1c-3c02-351e-9a7b-c944b12fff6a",
                                        "entry_id": "53289408-efd5-3a21-a4c6-eb49f7d79485",
                                        "glosses": [
                                            "Cri de la chouette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c4a20c-2280-47ce-8c63-a55fda71db9b",
                                                "sense_id": "c21adf1c-3c02-351e-9a7b-c944b12fff6a",
                                                "text": "Il entendait aussi […], deux ou trois couples de ces funèbres hulottes, dont le chuintement retentissait comme une plainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                        "entry_id": "53289408-efd5-3a21-a4c6-eb49f7d79485",
                                        "glosses": [
                                            "Bruit que produit quelque chose qui chuinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f547758-f4a6-4dad-adf0-62df1204b317",
                                                "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                                "text": "M. Chavanais entendit le bruit des chaises, le claquement d’un chiffon, le chuintement du balai, des heurts d’assiettes tandis que son esprit retournait sous le dôme des rhododendrons."
                                            },
                                            {
                                                "example_id": "74bd1d48-0dd6-43d8-bc91-ef4c9c009f33",
                                                "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                                "text": "Je me suis mise à entendre un chuintement, comme si une radio cachée au fond de ma tête grésillait délicatement."
                                            },
                                            {
                                                "example_id": "d0a39c77-0bce-4fc3-9bf5-0d6c9d48f7a4",
                                                "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                                "text": "Le train est arrivé sur moi, tête baissée, entouré de vapeurs, d’éclairs d’acier noir, de clignements de roues et de chuintements engorgés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f358a4cd-3342-46d1-bfc6-6637c6719fd9",
                        "source_entry_id": "c0d01a69-3bee-38ff-99c7-5f9ea21b9fc5",
                        "source_sense_id": "0c205bd0-a51a-3123-91fc-83b3afeb5f63",
                        "target_lang_word": "zézaiement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zézaiement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                        "entry_id": "f615b343-a7b4-3a8b-b16c-6cb932d8ed79",
                                        "glosses": [
                                            "Fait de zézayer, vice de prononciation par lequel on donne aux sons \\\\ʒ, s\\\\ (j ou s) le son \\\\z\\\\ (z)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ec9a0a-b12d-4493-b602-bb43ab68f74e",
                                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                                "text": "Le désespoir de sa vie était qu’affligé d’un zézaiement un peu enfantin, il n’avait pu, dans la magistrature debout, remplir son mérite, car il se piquait d’être un grand orateur."
                                            },
                                            {
                                                "example_id": "9a64c5a3-12a6-4a6b-9718-e02539d5cc7d",
                                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                                "text": "Elle avait deux ans de moins que moi et parlait encore avec un zézaiement qui me faisait sentir toute la supériorité que j’avais sur elle."
                                            },
                                            {
                                                "example_id": "5073b7d2-1280-4926-850b-ac51e2baee17",
                                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                                "text": "N'ayez crainte ! répliqua Pepette qui, malgré ses airs de colosse, avait une petite voix et un très léger zézaiement."
                                            },
                                            {
                                                "example_id": "ef8c2aa0-aa2b-4c92-b57e-ccdceb133f9f",
                                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                                "text": "Ça fait que les Ritals qui mettent un peu le nez hors de leurs ghettos de Ritals se débrouillent vite fait avec le français. Mais, aussi longtemps puissent-ils vivre, ils seront quand même toujours trahis par le zézaiement. Rien à faire, ils zozotent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
