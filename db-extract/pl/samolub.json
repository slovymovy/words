                        "source_sense_id": "43fc4554-7f39-3945-b598-953291c66be7",
                        "target_lang_word": "самолюб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "самолюб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5a98ef9f-bce6-3add-954e-6ecaaf4eb9f0",
                                        "entry_id": "b032fd3f-cc40-3e72-8db8-655251be701d",
                                        "glosses": [
                                            "разг. то же, что самолюбец; себялюбивый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1fa1006-5a58-495f-91b6-683d979d0269",
                                                "sense_id": "5a98ef9f-bce6-3add-954e-6ecaaf4eb9f0",
                                                "text": "— А потому, что он самолюб, и эту надпись вам больше ничего, как в конфуз сделал."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "самолюб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ee040ce7-bd8b-3b40-a487-e74ac742ce26",
                                        "entry_id": "9c3e3e23-aa65-34d7-999c-3774aa75001d",
                                        "glosses": [
                                            "воен. жарг. и мол. тот, кто мастурбирует, занимается мастурбацией; онанист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce1d37c-a126-4120-ab5e-3c51707be558",
                                                "sense_id": "ee040ce7-bd8b-3b40-a487-e74ac742ce26",
                                                "text": "Кстати. Нельзя не отметить также широкое распространение среди солдат онанизма. Частенько ночью в туалете можно было словить такого «самолюба». Но им обычно не везло. Где ловили — били до полусмерти."
                                            }
