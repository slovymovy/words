        "fr-extract.jsonl": [
            {
                "entry_id": "c43a2436-2c1c-3c6c-9217-5fd4f4ed618c",
                "word": "ravalement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b995699-e3d8-42d0-9e45-190e5e6620ed",
                        "entry_id": "c43a2436-2c1c-3c6c-9217-5fd4f4ed618c",
                        "tags": [
                            "plural"
                        ],
                        "form": "ravalements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27bd6955-e423-344d-b38b-8f2514c86829",
                        "entry_id": "c43a2436-2c1c-3c6c-9217-5fd4f4ed618c",
                        "glosses": [
                            "Travail qu’on fait à un mur, à une façade, etc., lorsque, après les avoir élevés, on les crépit de haut en bas ; résultat de ce travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7c9eee7-1da8-47c6-9191-b1b8446a243b",
                                "sense_id": "27bd6955-e423-344d-b38b-8f2514c86829",
                                "text": "Faire le ravalement d’un mur."
                            },
                            {
                                "example_id": "bf965bf4-e2e3-4b7c-93c4-f9b2a1fa38a2",
                                "sense_id": "27bd6955-e423-344d-b38b-8f2514c86829",
                                "text": "Le ravalement de cette maison est de plâtre."
                            },
                            {
                                "example_id": "4349bc50-6fce-4189-9f93-e578961633c6",
                                "sense_id": "27bd6955-e423-344d-b38b-8f2514c86829",
                                "text": "Le ravalement consiste à tailler les pierres lorsqu’elles sont déjà en place dans la voûte."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2882a3e-8b03-36e5-a81e-26c7f085dfd9",
                        "entry_id": "c43a2436-2c1c-3c6c-9217-5fd4f4ed618c",
                        "glosses": [
                            "Nettoyage extérieur d’une construction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20bd8edc-1239-45b3-ac3b-0c12def24c81",
                                "sense_id": "d2882a3e-8b03-36e5-a81e-26c7f085dfd9",
                                "text": "On vient de terminer le ravalement de cette maison."
                            },
                            {
                                "example_id": "80d65183-7418-4d71-818c-b99ba1232954",
                                "sense_id": "d2882a3e-8b03-36e5-a81e-26c7f085dfd9",
                                "text": "Une seconde campagne de rénovation a été menée entre 1995 et 1998, consistant en un ravalement de l’immeuble, à une mise aux normes des locaux (avec le soutien de la municipalité), un renouvellement des équipements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69846499-7fe1-466c-976d-e3a75006c724",
                        "source_entry_id": "c43a2436-2c1c-3c6c-9217-5fd4f4ed618c",
                        "target_lang_word": "renovatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renovatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                        "entry_id": "ca0a094e-1198-3e94-8160-72e0c1fe1032",
                                        "glosses": [
                                            "het opnieuw bewoonbaar maken van een huis of wijk door een grote verbouwing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de390080-5387-4721-be31-dbc59d0cf72a",
                                                "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                                "text": "Er worden hier momenteel renovaties uitgevoerd."
                                            },
                                            {
                                                "example_id": "f4da0c63-c03a-46a2-948c-f4a370385a94",
                                                "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                                "text": "Het museum is de komende jaren nog dicht voor renovatie. Vorig jaar opende koning Willem-Alexander het internationaal geroemde Depot Boijmans van Beuningen. Het was het eerste kunstdepot ter wereld dat toegankelijk is voor publiek en kwam mede uit de koker van Ex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32347b9b-a17e-3879-84bf-ae15d43ea1d1",
                                        "entry_id": "ca0a094e-1198-3e94-8160-72e0c1fe1032",
                                        "glosses": [
                                            "de laatste aanmaning tot betaling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4927327-30af-4f9d-bfcf-b638438a6141",
                                                "sense_id": "32347b9b-a17e-3879-84bf-ae15d43ea1d1",
                                                "text": "De renovatie is gisteren verstuurd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c6a4ae5-f02f-4496-ac10-4f1b7926cdb2",
                        "source_entry_id": "c43a2436-2c1c-3c6c-9217-5fd4f4ed618c",
                        "target_lang_word": "herstelling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herstelling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e34253d3-b2a9-308e-ae8c-d0e28f1b4dd1",
                                        "entry_id": "b6b7b81c-65d7-3e3c-a40d-3692f8257e8b",
                                        "glosses": [
                                            "weer in orde maken van iets wat stuk is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9ddc7d2-816d-44f7-a742-df765629315f",
                                                "sense_id": "e34253d3-b2a9-308e-ae8c-d0e28f1b4dd1",
                                                "text": "De schuit had dikwijls herstelling nodig, hij zag wel dat zij nog maar kort mee zou kunnen en dat hij een andere zou moeten hebben ook al keerde Marie niet weerom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e3c2c5-f892-3bf5-b01d-f9045fd89664",
                                        "entry_id": "b6b7b81c-65d7-3e3c-a40d-3692f8257e8b",
                                        "glosses": [
                                            "ongedaan maken van nadelen die het gevolg zijn van onrecht"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83da7572-3e00-3035-8112-9bdf55eef93a",
                                        "entry_id": "b6b7b81c-65d7-3e3c-a40d-3692f8257e8b",
                                        "glosses": [
                                            "terugkeer naar hoe het eerder was"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2739fc11-eed5-4104-acb4-805197d30f89",
                                                "sense_id": "83da7572-3e00-3035-8112-9bdf55eef93a",
                                                "text": "De ironie daarbij was dat de patriotten om het hardst betoogden dat zij helemaal niets nieuws wilden, maar juist uit waren op \"Grondwettige Herstelling\", zoals de titel van hun belangrijkste programmatische geschrift luidde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fda4fe87-6fe6-3acf-aceb-5bfdc2d986d4",
                                        "entry_id": "b6b7b81c-65d7-3e3c-a40d-3692f8257e8b",
                                        "glosses": [
                                            "gezond worden of maken"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "752b367d-fd13-472f-91e6-d0a9ae9418d1",
                                                "sense_id": "fda4fe87-6fe6-3acf-aceb-5bfdc2d986d4",
                                                "text": "Haar herstelling had maanden geduurd. Nu werd ze beter; nu zou ze weldra weer kunnen beginnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
