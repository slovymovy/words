                    },
                    {
                        "translation_id": "85be3e20-f22e-4c7e-a81c-f6ea8c6124da",
                        "source_entry_id": "c7b5f3f0-7f62-310d-9cfa-ac6698692fa2",
                        "source_sense_id": "b86df20b-aff3-3c0e-a656-6334beb44f27",
                        "target_lang_word": "Waschfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2119b2b-772d-3322-b2d5-4b6a7a01f475",
                                        "entry_id": "a78e3ade-fbf8-3f29-a56b-9d854c524413",
                                        "glosses": [
                                            "Frau, die gewerbsmäßig wäscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d775e84a-a682-4fea-9195-d3107e6f1364",
                                                "sense_id": "e2119b2b-772d-3322-b2d5-4b6a7a01f475",
                                                "text": "„Mit dem Französischparlieren kam eine schlesische Waschfrau im unruhigen Jahre 1807 viel wendiger zu Rande.“"
                                            },
                                            {
                                                "example_id": "a49f57e7-6d86-4d84-bd01-9c4f61dbc41d",
                                                "sense_id": "e2119b2b-772d-3322-b2d5-4b6a7a01f475",
                                                "text": "„Sie sah aus wie eine ärgerliche, schöne Waschfrau und gleichzeitig wie etwas, das vom Mond hergeflogen war und sich nicht zurechtfinden konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b17f68b6-1874-447b-8f28-68fefeb5a4d5",
                        "source_entry_id": "c7b5f3f0-7f62-310d-9cfa-ac6698692fa2",
                        "source_sense_id": "b86df20b-aff3-3c0e-a656-6334beb44f27",
                        "target_lang_word": "Wäscherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wäscherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cf3e53b-fea5-30e4-adae-49d15904f54d",
                                        "entry_id": "10ad4c4f-e710-3ec3-98c7-52ec759e82dc",
                                        "glosses": [
                                            "weibliche Person, die berufsmäßig Wäsche wäscht"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eefdbfc-ae63-47f1-b6f4-cb1a5e52837b",
                                                "sense_id": "8cf3e53b-fea5-30e4-adae-49d15904f54d",
                                                "text": "„Während die vermögende Oberklasse an ihrem bewährten und vertrauenswürdigen Personal überwiegend festhielt und höchstens die Hilfskräfte reduzierte, traf es in den viel zahlreicheren bürgerlichen und kleinbürgerlichen Haushalten Zehntausende Dienstmädchen, Zugehfrauen, Köchinnen und Wäscherinnen.“"
                                            },
                                            {
                                                "example_id": "65c6b917-f396-4333-a389-4ecccc8a0408",
                                                "sense_id": "8cf3e53b-fea5-30e4-adae-49d15904f54d",
                                                "text": "„Die Wäscherin und Köchin, Wams- und Topfflickerin, Schnapshändlerin und Lagerhure gilt als lebens- und überlebenskluges Kriegsweib der Söldnerheere, seit Grimmelshausen hundert Jahre nach der Lutherzeit seiner Mutter Courage des Dreißigjährigen Krieges ein Denkmal gesetzt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
