                            {
                                "target_lang_word": "скоропостижность",
                                "target_lang_sense_clarification": "очень быстрая, внезапная кончина или проявление"
                            },
                            {
                                "target_lang_word": "стремительность",
                                "target_lang_sense_clarification": "быстрота и резкость развития событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9450634-82f0-354b-81a8-3964c94e8471",
                    "sense_definition": "cecha spraw wymagających natychmiastowego działania lub rozstrzygnięcia",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze względu na szczególną <w>nagłość</w> sprawy spotkanie zwołano w trybie pilnym.",
                            "target_lang_translations": {
                                "ru": "Ввиду особой <w>срочности</w> дела встречу созвали в экстренном порядке."
                            }
                        },
                        {
                            "text": "W obliczu wielkiej <w>nagłości</w> tego problemu musieliśmy natychmiast podjąć decyzję.",
                            "target_lang_translations": {
                                "ru": "Перед лицом чрезвычайной <w>неотложности</w> этой проблемы нам пришлось немедленно принять решение."
                            }
                        }
