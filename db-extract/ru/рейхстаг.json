                                        "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "Reichstag zur Zeit des Nationalsozialismus (1933–1945)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1fc125-48c4-4881-a8f0-7f2298371fee",
                                                "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                                "text": "Noch während der Zeit des Nationalsozialismus fanden Wahlen zum deutschen Reichstag statt."
                                            },
                                            {
                                                "example_id": "4857f2e5-de23-4c37-a7eb-b082f8a9b110",
                                                "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                                "text": "„In der Nacht des 23. Februar brennt der Reichstag.“"
                                            },
                                            {
                                                "example_id": "c12f61d0-1b32-46f9-9838-ebe9dfb057b8",
                                                "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                                "text": "„Die Entmachtung des Reichstages durch das ‚Ermächtigungsgesetz‘ vom 23. März 1933 und seine Denaturierung zum durch Diäten finanzierten ‚teuersten Gesangverein der Welt‘ zur Ehrung der Staatsspitze löste ebenso wenig Widerstand aus wie das Ende der Parteien im Sommer 1933.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1g\""
                                    },
