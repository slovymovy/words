                                        "sense_id": "774f29ec-c83d-3288-9508-fbd29f56aeab",
                                        "entry_id": "e0813bfc-081b-3f76-aaab-3beea2425a2a",
                                        "glosses": [
                                            "von pulverartiger Beschaffenheit; von sehr feiner Konsistenz; wie Puder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a044684-4424-421b-af0c-03c7d9633dbd",
                                                "sense_id": "774f29ec-c83d-3288-9508-fbd29f56aeab",
                                                "text": "„Der Sand ist fein und pudrig, nicht wie die blassen Kristalle an der Küste, und er kann sich mit der Wucht von anflutendem Wasser vorwärtsbewegen.“"
                                            },
                                            {
                                                "example_id": "c6a6ecad-c66e-452e-ae07-ddf69b764e4e",
                                                "sense_id": "774f29ec-c83d-3288-9508-fbd29f56aeab",
                                                "text": "„Er mochte den Umgang mit dem pudrig-feinen Mehl, das der Müller aus dem Nachbarsort zweimal wöchentlich lieferte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5987e2fc-4c8f-4c4f-8dd1-fa424b977cd8",
                        "source_entry_id": "2746255e-2a02-308e-b5c9-227c6cbf2f54",
                        "source_sense_id": "2cd662fd-feb3-3d97-938c-c7599049b1e2",
