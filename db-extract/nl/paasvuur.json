                "senses": [
                    {
                        "sense_id": "de29f3b2-a986-3e16-83e1-b87ce02bb715",
                        "entry_id": "64cdd465-1382-3e30-b8be-17428a166a54",
                        "glosses": [
                            "een groot vuur dat men op eerste of tweede Paasdag aansteekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7412a3b-16d9-49aa-8931-b9c0bbadd8c0",
                                "sense_id": "de29f3b2-a986-3e16-83e1-b87ce02bb715",
                                "text": "Zondagavond zijn er veel paasvuren ontstoken in het oosten van Nederland. De grootste brandt in het Overijsselse Dijkerhoek. Daar werd het paasvuur rond 20.00 uur aangestoken."
                            },
                            {
                                "example_id": "7e1e299f-ee11-4763-8ee0-8425de802403",
                                "sense_id": "de29f3b2-a986-3e16-83e1-b87ce02bb715",
                                "text": "De ANWB verwacht dat vrijdag veel dagjesmensen erop uit trekken. Verder wordt het met name maandag (tweede paasdag) druk, door dagtripjes en terugkerend vakantieverkeer. Rond de paasdagen openen veel pretparken weer hun deuren. In het oosten van het land gaan veel mensen kijken naar de paasvuren."
                            }
                        ]
                    }
