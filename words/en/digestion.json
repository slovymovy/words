                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anaerobic <w>digestion</w> is widely used to convert organic waste into renewable energy.",
                            "target_lang_translations": {
