                                        "entry_id": "4289f3d7-bf4a-31eb-817e-3465c474649f",
                                        "glosses": [
                                            "Transformations des faits linguistiques dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7666bca-a079-439c-a640-e8eb2744d054",
                                                "sense_id": "2999d226-db3e-369a-87c4-f7a4c907b0ab",
                                                "text": "Un instantané de l'état d'une langue à un instant donné est une synchronie. La succession de ces derniers constitue la diachronie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd9c21b-6939-35d4-8c93-5b374199dee2",
                                        "entry_id": "4289f3d7-bf4a-31eb-817e-3465c474649f",
                                        "glosses": [
                                            "Discipline consistant à étudier ces évolutions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "184af47a-5b84-4551-b232-d1daf35f1149",
                                                "sense_id": "2dd9c21b-6939-35d4-8c93-5b374199dee2",
                                                "text": "La distinction entre synchronie et diachronie s'appliquait essentiellement, dans l'esprit de F. de Saussure, aux études linguistiques concrètes : états de langue déterminés, évolution de langues déterminées."
                                            }
                                        ]
                                    }
