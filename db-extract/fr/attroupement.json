                                        "entry_id": "3d6f2430-3fe4-36aa-8c9b-a9c126161a74",
                                        "glosses": [
                                            "Zusammenstreben vieler Menschen aus einem bestimmten Anlass"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a4d5c6-32a8-4b06-91aa-405abac88cf6",
                                                "sense_id": "c0a65983-3b7b-3776-81a7-521a21e7d764",
                                                "text": "Bei der kostenlosen Verlosung der Rockkonzertkarten entstand ein unaufhaltsamer Menschenauflauf, der bald außer Kontrolle geriet und den Verlosungsstand bestürmte."
                                            },
                                            {
                                                "example_id": "9d4a5008-1ed5-4899-a2ac-c2363f259787",
                                                "sense_id": "c0a65983-3b7b-3776-81a7-521a21e7d764",
                                                "text": "„Und dort war ein Menschenauflauf.“"
                                            },
                                            {
                                                "example_id": "80ee514b-c76e-444e-a50a-ca57b19a1998",
                                                "sense_id": "c0a65983-3b7b-3776-81a7-521a21e7d764",
                                                "text": "„Der Dolmetscher ritt auf den Menschenauflauf zu.“"
                                            },
                                            {
                                                "example_id": "b8388245-3fe4-4a72-8c00-9d79c264a3e6",
                                                "sense_id": "c0a65983-3b7b-3776-81a7-521a21e7d764",
                                                "text": "„Der Menschenauflauf bei Muzorewas Rückkehr nach Salisbury verstärkte bei ihm – und bei Smith – den Eindruck, er sei der eigentlich populäre Führer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
