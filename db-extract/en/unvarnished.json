{
    "word": "unvarnished",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "274b8107-667f-38b3-a614-ab82095fbe15",
                "word": "unvarnished",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f937c359-881d-3d9d-bccb-4975fa055630",
                        "entry_id": "274b8107-667f-38b3-a614-ab82095fbe15",
                        "glosses": [
                            "Not having been coated with varnish."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e94e5c3e-51c7-4cf3-b034-a198305f2112",
                                "sense_id": "f937c359-881d-3d9d-bccb-4975fa055630",
                                "text": "unvarnished furniture"
                            }
                        ]
                    },
                    {
                        "sense_id": "25409088-5770-32c9-8684-9cae0f6edc70",
                        "entry_id": "274b8107-667f-38b3-a614-ab82095fbe15",
                        "glosses": [
                            "Natural, unmodified, unembellished, not exaggerated."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "46233f25-ab43-4943-94a5-3c6d35f061a5",
                                "sense_id": "25409088-5770-32c9-8684-9cae0f6edc70",
                                "text": "She told the unvarnished truth."
                            },
                            {
                                "example_id": "5f405bd5-544c-4e68-8977-fc10eb46bfb3",
                                "sense_id": "25409088-5770-32c9-8684-9cae0f6edc70",
                                "text": "There were no socialist countries or liberation movements to blame for World War I. It was a plain, unvarnished racist war for colonial empire."
                            },
                            {
                                "example_id": "2f07f84d-20d8-46f2-9f73-1d9ece36c061",
                                "sense_id": "25409088-5770-32c9-8684-9cae0f6edc70",
                                "text": "The unprofessional production of the skits, shot on handheld digital video without the assistance of a 'steady cam' device, contributes to their unvarnished allure."
                            },
                            {
                                "example_id": "23802a73-9448-44c6-90bd-53bfab15569b",
                                "sense_id": "25409088-5770-32c9-8684-9cae0f6edc70",
                                "text": "Boris Johnson the \"ersatz Churchill\" needed the real one to remain untouchable and unvarnished to serve his own narrative as his latter-day incarnation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "884bc279-05ed-4de2-b16a-9df25eae31cf",
                        "source_entry_id": "274b8107-667f-38b3-a614-ab82095fbe15",
                        "source_sense_description": "not having been coated with varnish",
                        "target_lang_word": "unbehandelt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbehandelt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8074eb-beda-363e-9724-8c2e97a4b079",
                                        "entry_id": "f53207c2-e7c1-378d-a698-b11267e207bc",
                                        "glosses": [
                                            "ohne Einsatz von chemischen Mitteln bearbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33438dcf-66ed-4479-83e3-66fce14b4246",
                                                "sense_id": "ba8074eb-beda-363e-9724-8c2e97a4b079",
                                                "text": "Unbehandelte Milch gilt manchen als gesünder und für Allergiker verträglicher als das Pendant aus dem Supermarkt."
                                            },
                                            {
                                                "example_id": "1682b609-ab9a-4af3-aa47-e3274b74e2e8",
                                                "sense_id": "ba8074eb-beda-363e-9724-8c2e97a4b079",
                                                "text": "Unbehandeltes Holz trocknet mit der Zeit aus und neigt zum Vergrauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35ec4076-5b12-3fa0-86ce-53ad49e47a22",
                                        "entry_id": "f53207c2-e7c1-378d-a698-b11267e207bc",
                                        "glosses": [
                                            "durch keine medizinische Behandlung versorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65490539-0b7a-4037-b92a-ce3e53c14ed7",
                                                "sense_id": "35ec4076-5b12-3fa0-86ce-53ad49e47a22",
                                                "text": "Die akute Phase der Erkrankung dauert unbehandelt Wochen bis Monate."
                                            },
                                            {
                                                "example_id": "93408a7a-1de5-4070-97a6-5574188ff2c2",
                                                "sense_id": "35ec4076-5b12-3fa0-86ce-53ad49e47a22",
                                                "text": "Da eine unbehandelte Streptokokkeninfektion selten zu schweren Komplikationen führen kann, ist die genaue Abklärung der Ursache und eine adäquate Behandlung wichtig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d52d6569-cdf4-39d4-851a-814e8cdcb882",
                                        "entry_id": "f53207c2-e7c1-378d-a698-b11267e207bc",
                                        "glosses": [
                                            "nicht diskutiert, nicht erörtert"
                                        ],
                                        "tags": [
                                            "von Themen oder Materien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f549236-5e2e-4668-ad34-22fca238569a",
                                                "sense_id": "d52d6569-cdf4-39d4-851a-814e8cdcb882",
                                                "text": "Nicht gelöste und unbehandelte Probleme gehören auf die Tagesordnung der nächsten Besprechung."
                                            },
                                            {
                                                "example_id": "b3037638-6df7-4f9b-82c2-da4afded7214",
                                                "sense_id": "d52d6569-cdf4-39d4-851a-814e8cdcb882",
                                                "text": "Schließlich lenken neue Themen und Probleme von bereits implementierten Entscheidungen ab, und viele unbehandelte Themen dämpfen die Erwartungen im Hinblick auf neue."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a1d23c1-74f5-4f01-a483-8005fa77ea0a",
                        "source_entry_id": "274b8107-667f-38b3-a614-ab82095fbe15",
                        "source_sense_description": "natural, unmodified, unembellished, not exaggerated",
                        "target_lang_word": "ungeschminkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungeschminkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f89ed2be-7a51-3203-84c8-8b345bac8f8f",
                                        "entry_id": "b8ea5193-85ff-371f-b2af-3abc954a336f",
                                        "glosses": [
                                            "keine Schminke tragend"
                                        ],
                                        "tags": [
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b18b4236-1161-4ea5-b44f-ba5d71aab4e2",
                                                "sense_id": "f89ed2be-7a51-3203-84c8-8b345bac8f8f",
                                                "text": "Zufrieden betrachtete sie ihr ungeschminktes Gesicht im Spiegel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "582e5b4b-78f3-39ab-a6a9-536ec0efd288",
                                        "entry_id": "b8ea5193-85ff-371f-b2af-3abc954a336f",
                                        "glosses": [
                                            "freiheraus; nicht beschönigend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "200d0335-ab7f-49e0-be03-a6d58aa12bc8",
                                                "sense_id": "582e5b4b-78f3-39ab-a6a9-536ec0efd288",
                                                "text": "Ungeschminkt sagte er ihr die Meinung."
                                            },
                                            {
                                                "example_id": "ccaadc08-210d-48bf-982a-468bffc38c9c",
                                                "sense_id": "582e5b4b-78f3-39ab-a6a9-536ec0efd288",
                                                "text": "„In einem Bericht an den Aufsichtsrat zeichnet der neue Chef der DB Netz AG, Philipp Nagl, ein ungeschminktes Bild des schlechten Zustandes der Bahnanlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
