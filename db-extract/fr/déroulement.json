                                        "sense_id": "ed2791ab-14e1-35bf-8c09-f63315264663",
                                        "entry_id": "47c87bd3-5b8f-3949-aa71-fbf867e216ab",
                                        "glosses": [
                                            "The process by which a mature multicellular organism or part of an organism is produced by the addition of new cells."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
