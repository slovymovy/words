                    {
                        "translation_id": "d0685ffd-d999-47b4-a57f-ae53a30befa5",
                        "source_entry_id": "29edccaf-8536-3eed-b425-36dfa327b33b",
                        "source_sense_description": "spend winter time in a dormant or inactive state",
                        "target_lang_word": "hiberner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiberner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb8749d-f46a-388c-be14-175100f61a33",
                                        "entry_id": "73fd2f9c-62be-3d88-84f9-72f13cad3805",
                                        "glosses": [
                                            "Passer l'hiver en ayant ses fonctions vitales ralenties, dans un état d'engourdissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f4a90e7-c77d-4a6e-a2ae-5576cee37893",
                                                "sense_id": "fcb8749d-f46a-388c-be14-175100f61a33",
                                                "text": "Quant à hiberner, il s'emploie en parlant de certains animaux qui dorment pendant l'hiver d'un sommeil prolongé."
                                            },
                                            {
                                                "example_id": "1011cec0-1509-4f17-8e8e-ee425425478f",
                                                "sense_id": "fcb8749d-f46a-388c-be14-175100f61a33",
                                                "text": "Le site de la Jalle regroupe tous les milieux dont elles ont besoin. Des petites mares forestières dans l’aulnaie pour hiberner : elles s’enfouissent dans la vase tout l’hiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "145981de-69ff-39c8-8d19-dd9ff0b31b9b",
                                        "entry_id": "73fd2f9c-62be-3d88-84f9-72f13cad3805",
                                        "glosses": [
                                            "Pour un ordinateur, être à l’arrêt tout en gardant stocké l’état actif en mémoire non-volatile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e106e628-79b8-4603-854a-21fd54f34c18",
                        "source_entry_id": "29edccaf-8536-3eed-b425-36dfa327b33b",
                        "source_sense_description": "spend winter time in a dormant or inactive state",
                        "target_lang_word": "hiverner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiverner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22ffbe8e-3f14-3645-9d49-7d7bba027578",
                                        "entry_id": "3f43fd9d-9d11-3284-ba2c-01d2c00b2031",
                                        "glosses": [
                                            "Passer l’hiver, la mauvaise saison, en parlant des troupes, des navires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cccaf08-59df-467c-8449-e96cff9aa896",
                                                "sense_id": "22ffbe8e-3f14-3645-9d49-7d7bba027578",
                                                "text": "Il n'étoit pas possible que ses Troupes hivernassent en deçà des Monts , faute de Places fortes pour s'y maintenir: ainsi il les rappela sans attendre que les neiges en fermassent les passages."
                                            },
                                            {
                                                "example_id": "114dddd2-1183-437c-b8a4-4c240c44d46f",
                                                "sense_id": "22ffbe8e-3f14-3645-9d49-7d7bba027578",
                                                "text": "Avant qu'un phoquier norvégien venu par hasard dans cette région ne les rapatriât, ils durent hiverner pendant trois années consécutives !"
                                            },
                                            {
                                                "example_id": "6a309a7b-5494-4126-9c38-e06ee43546e1",
                                                "sense_id": "22ffbe8e-3f14-3645-9d49-7d7bba027578",
                                                "text": "En 1838, la profondeur du port et le nombre des poteaux permettaient d'y faire hiverner 5 vaisseaux, 5 frégates et 6 petits navires. En 1774, il y hivernait 6 vaisseaux de 60 canons, 4 frégates de 36, 3 pinks et 14 autres petits navires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c5ba85f-5c5a-35fd-b8ff-ca3864e25519",
                                        "entry_id": "3f43fd9d-9d11-3284-ba2c-01d2c00b2031",
                                        "glosses": [
                                            "Passer l'hiver dans un lieu tempéré, en parlant de certains animaux migrateurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fb2db72-06b8-476c-86dd-3d582124ea55",
                                                "sense_id": "9c5ba85f-5c5a-35fd-b8ff-ca3864e25519",
                                                "text": "Ceux de l'Europe du Nord et centrale vont hiverner surtout en Europe méridionale et régulièrement aussi en Afrique du Nord. En automne, des milliers d'oiseaux traversent la France ou s'y installent pour hiverner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53540b2-99d1-3d3a-9673-544f507a66a0",
                                        "entry_id": "3f43fd9d-9d11-3284-ba2c-01d2c00b2031",
                                        "glosses": [
                                            "Passer l’hiver en repos biologique, en parlant des graines, des insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb3ac41-7385-41d8-aa48-0b9b7ad805aa",
                                                "sense_id": "e53540b2-99d1-3d3a-9673-544f507a66a0",
                                                "text": "Les chrysalides, qui avaient un aspect absolument normal, hivernèrent."
                                            },
                                            {
                                                "example_id": "3a25382a-0084-4e82-8123-daff91362041",
                                                "sense_id": "e53540b2-99d1-3d3a-9673-544f507a66a0",
                                                "text": "Une partie des larves des deuxième et troisième stades et toutes celles du quatrième stade hivernèrent."
                                            },
                                            {
                                                "example_id": "a0ba4a15-90ce-4d47-93b4-39a309a15797",
                                                "sense_id": "e53540b2-99d1-3d3a-9673-544f507a66a0",
                                                "text": "Ce Charançon pullule principalement dans les zones de culture de la Betterave, il hiverne dans les betteravières de l'année précédente et émigre au printemps, dès sa sortie, vers les nouvelles plantations consécutives à l’assolement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340773b8-e639-3b32-bffc-891b9e496fd6",
                                        "entry_id": "3f43fd9d-9d11-3284-ba2c-01d2c00b2031",
                                        "glosses": [
                                            "Mettre les bestiaux à l’abri dans les étables, pour l'hiver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e0e304-5778-4d66-acb3-d96790fef8e9",
                                                "sense_id": "340773b8-e639-3b32-bffc-891b9e496fd6",
                                                "text": "Et même, certaines familles n’hivernaient aucune vache. Il en était ainsi de toutes les familles de la Bérarde. En été, elles prenaient en pension une vache louée à un propriétaire de la plaine de l'Oisans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75267dcb-c6b8-3158-969f-ceedfa1b9263",
                                        "entry_id": "3f43fd9d-9d11-3284-ba2c-01d2c00b2031",
                                        "glosses": [
                                            "Donner, à une terre, un dernier labour avant l’hiver."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
