                "senses": [
                    {
                        "sense_id": "40c4ff99-74c8-3971-a2f9-997fac77b603",
                        "entry_id": "013e7c49-ec92-3647-bd71-94c6aae195d1",
                        "glosses": [
                            "met een flauwe smaak"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "93ff7898-0693-41f5-91b4-e948afc16349",
                                "sense_id": "40c4ff99-74c8-3971-a2f9-997fac77b603",
                                "text": "Misschien een ideetje voor bij een tegenvallend diner, als de ober de - overigens toch al tegen de etiquette indruisende - vraag stelt ‘of het gesmaakt heeft’. Antwoord dan eens iets anders dan het laffe ‘goed’, en straf hem met ‘de soep was weeps, de kaassoufflé had een smodderig mondgevoel, totaal puf dus’."
                            }
                        ]
                    },
                    {
                        "sense_id": "a77f3b4a-570d-34f5-98c1-49fc181982b6",
                        "entry_id": "013e7c49-ec92-3647-bd71-94c6aae195d1",
                        "glosses": [
                            "met een zwakke, slappe houding"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2405c98f-20d2-4e99-9340-c44a24411533",
                                "sense_id": "a77f3b4a-570d-34f5-98c1-49fc181982b6",
                                "text": "Op straat loopt hij eerst zinneloos, verbijsterd voort, en weldra breekt er een opstandigheid in hem op, hij wil al die gevoeligheid van zich afschudden, al die verwijfdheid, wat kan hij met die goedheid van Mathilde aanvangen? Ze maakt hem week en weeps."
                            }
                        ]
                    },
                    {
                        "sense_id": "da3bed41-1cf9-3e30-b436-fbecac58a65d",
                        "entry_id": "013e7c49-ec92-3647-bd71-94c6aae195d1",
                        "glosses": [
                            "zich uit schrikachtigheid onrustig gedragend of achteruit schoppend"
                        ],
                        "tags": [
                            "paardrijden",
                            "van een paard"
                        ],
                        "examples": [
                            {
                                "example_id": "fee96afe-c6fd-45f1-ba60-941c672fece6",
                                "sense_id": "da3bed41-1cf9-3e30-b436-fbecac58a65d",
                                "text": "Benaomd sunt dat he 'n trap van zien weepse roene had het en nait meer mit nao 't laand tou ken; (…)"
                            }
                        ]
                    }
