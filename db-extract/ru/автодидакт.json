                ],
                "senses": [
                    {
                        "sense_id": "f732f166-4a4c-364f-b66c-d4616a627d52",
                        "entry_id": "ddda076e-f1f6-3698-bc4f-8e0b3d29f116",
                        "glosses": [
                            "книжн. человек, самостоятельно получивший образование высокого уровня вне стен какого-либо учебного заведения, без помощи обучающего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ceed6d-fab8-4259-a9e2-37cca78a6882",
                                "sense_id": "f732f166-4a4c-364f-b66c-d4616a627d52",
                                "text": "Чувство призвания у меня всегда было сильно и всегда мною руководило. Я всегда был автодидактом и никто никогда не руководил моим умственным развитием. Благодаря этому во мне выработалась самостоятельность и внутренняя свобода."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f3f652b-3be9-4167-9c7f-5ae51ebe6987",
                        "source_entry_id": "ddda076e-f1f6-3698-bc4f-8e0b3d29f116",
                        "source_sense_id": "f732f166-4a4c-364f-b66c-d4616a627d52",
                        "target_lang_word": "autodidact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodidact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                        "entry_id": "8cac2d64-0285-3b79-b3a9-8fbac9e5a21e",
                                        "glosses": [
                                            "A self-taught person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f618d195-6ca0-4696-8999-0895475c0cc5",
                                                "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                                "text": "Leonardo Da Vinci is one of the greatest autodidacts."
                                            },
                                            {
                                                "example_id": "f12b5784-ec6a-487f-972c-0595ecbbdc6c",
                                                "sense_id": "188e02ae-2132-3074-bffd-4cff1c690b49",
                                                "text": "For an autodidact, for somebody who plays by ear like me, the ukulele is ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "214011ce-0e0a-4879-ad9b-fccf048591ce",
                        "source_entry_id": "ddda076e-f1f6-3698-bc4f-8e0b3d29f116",
                        "source_sense_id": "f732f166-4a4c-364f-b66c-d4616a627d52",
