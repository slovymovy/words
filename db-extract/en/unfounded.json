                                                "example_id": "ddd77d83-1382-4276-b5ab-fe61b4b6713e",
                                                "sense_id": "de1fd600-a81d-3822-8ae3-d64eac00cf81",
                                                "text": "Er ist grundlos entlassen worden."
                                            },
                                            {
                                                "example_id": "0912043c-bb5a-4969-b624-b69afee79ed0",
                                                "sense_id": "de1fd600-a81d-3822-8ae3-d64eac00cf81",
                                                "text": "Der Vorgesetzte hat ihn nicht ganz grundlos heruntergeputzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05ef7635-efa7-3b64-8d0a-819019c2d295",
