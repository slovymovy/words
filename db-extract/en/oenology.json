                                "target_senses": [
                                    {
                                        "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                        "entry_id": "5862086e-c2c8-351c-a4c5-601496f8265d",
                                        "glosses": [
                                            "Kultivierung von Weinreben zur Gewinnung von Wein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3201e305-1239-4248-8618-2bed024dab9d",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "Der Weinbau wird nördlich der Alpen schon über 2000 Jahre betrieben."
                                            },
                                            {
                                                "example_id": "f885844e-1b9d-4908-a2b9-3220b1cbef63",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "„Der Weinbau besitzt in Koblenz eine mindestens 2000 Jahre alte Tradition.“"
                                            },
                                            {
                                                "example_id": "3d90f184-621e-4b2a-9413-a9ba417d3a82",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "„Wo der Weinbau nicht mehr lohnte, wandte man sich gerne dem Fremdenverkehr zu.“"
                                            },
                                            {
                                                "example_id": "693568d5-2b21-4eba-bd31-687a5c731e13",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "„Die Landschaft um Meißen ist seit Jahrhunderten vom Weinbau geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e8379e-3549-4fe8-9e1c-017e8c6b6c36",
                        "source_entry_id": "9531adaa-5588-3806-8cf0-3e3514a2430b",
                        "source_sense_id": "83903879-1a8a-3155-bec8-c7a5e0e58c65",
                        "source_sense_description": "scientific study of wines",
                        "target_lang_word": "Weinkunde",
                        "target_lang_code": "de",
                        "note": "especially gastronomy",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6687469-00bf-3c0b-9c94-982abeecc64a",
                                        "entry_id": "5e41ce7c-8d69-3ba2-8a69-497bd6ee64ca",
                                        "glosses": [
                                            "Wissenschaft vom Wein und Weinbau"
                                        ],
                                        "tags": [
                                            "Weinkultur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf37176c-248b-43a7-8e2b-6f6556218a54",
                                                "sense_id": "e6687469-00bf-3c0b-9c94-982abeecc64a",
                                                "text": "„In 360 theoretischen Unterrichtsstunden wurden die Teilnehmer in den Fächern allgemeine Getränkekunde, Weinkunde, Weinempfehlung, Sensorik und kaufmännische Grundlagen unterrichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Weinkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6033c9a-d7d3-360f-a511-782a9de2089e",
                                        "entry_id": "cc12c589-ab77-3f2d-959e-6ced244f23c1",
                                        "glosses": [
                                            "Käufer, Abnehmer von Wein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51845867-3733-46c5-81c0-f6cb5487d4c5",
                                                "sense_id": "f6033c9a-d7d3-360f-a511-782a9de2089e",
                                                "text": "„Zu solchen Beziehungen, die einen Anruf rechtfertigen, gehöre auch der Kontakt, den ein Weinkunde mit dem Vertreter einer Weinhandlung unterhalte.“"
                                            },
                                            {
                                                "example_id": "30255587-0a73-47dd-adb0-47e79efd063a",
                                                "sense_id": "f6033c9a-d7d3-360f-a511-782a9de2089e",
                                                "text": "„Die Weinkunden, die natürlich nichts davon wussten und die auch nichts schmeckten, kauften folglich eine andere Qualität als die, die sie glaubten zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
