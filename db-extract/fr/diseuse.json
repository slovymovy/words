                        "sense_id": "f56dd1e2-6ac2-34fe-813e-56def40c2c8c",
                        "entry_id": "7e05e767-4ca1-3f38-9d0f-9069ce4bb8f1",
                        "glosses": [
                            "Celle qui dit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d32eb4-0865-46a7-9c60-c5ae5aa77fba",
                                "sense_id": "f56dd1e2-6ac2-34fe-813e-56def40c2c8c",
                                "text": "Sur le chemin entre les tombes, la diseuse de prières met le pied sur une marguerite."
                            },
                            {
                                "example_id": "1515d805-80de-44ed-81be-338587ab6b89",
                                "sense_id": "f56dd1e2-6ac2-34fe-813e-56def40c2c8c",
                                "text": "Elle avait consulté une voyante, diseuse de mauvaise aventure, qui lui avait annoncé qu’elle ne reverrait plus ses trois enfants."
                            },
                            {
                                "example_id": "dc5b1173-1884-4eaf-965a-6891dab8fb94",
                                "sense_id": "f56dd1e2-6ac2-34fe-813e-56def40c2c8c",
                                "text": "Depuis nombre d’années, la vieille diseuse de légendes, Fuldrade d’Obernay, s’était établie dans ces décombres avec ses deux chèvres."
                            }
                        ]
                    }
                ],
