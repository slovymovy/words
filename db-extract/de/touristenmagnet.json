                "senses": [
                    {
                        "sense_id": "dee98e0d-a53a-3b5f-954c-bb78bd1a21ef",
                        "entry_id": "87dc5b45-6742-313c-ab83-10dd2fe6cc8d",
                        "glosses": [
                            "etwas, dass Touristen anlockt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e877768a-adbf-4d33-a63e-025fbaa5c4be",
                                "sense_id": "dee98e0d-a53a-3b5f-954c-bb78bd1a21ef",
                                "text": "„Der nördliche Gardasee ist mit seinen eleganten Promenaden und den attraktiven Angeboten für Freizeitsportler einer der großen Touristenmagnete des Trentino.“"
                            },
                            {
                                "example_id": "e87480f3-230f-4383-a993-0c249b3910a7",
                                "sense_id": "dee98e0d-a53a-3b5f-954c-bb78bd1a21ef",
                                "text": "„Das Schloss Schönbrunn ist nicht nur ein Touristenmagnet mit zwei Millionen Besuchern pro Jahr, sondern noch immer ein wenig attraktiver Verkehrsknotenpunkt.“"
                            },
                            {
                                "example_id": "48f421e5-8d5c-42bd-9dfe-f75dc9801e43",
                                "sense_id": "dee98e0d-a53a-3b5f-954c-bb78bd1a21ef",
                                "text": "„Unter den 23 Orten, die in Berlin als besonders gefährlich gelten, ist zwar kein einziger in Pankow, doch Touristenmagnete wie Mauerpark, Kulturbrauerei und der besondere Flair des Prenzlauer Bergs locken eben auch Kriminelle an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
