    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7136a78-8feb-32f8-9978-b22291a0a67b",
                    "sense_definition": "The baseball player positioned behind home plate who catches pitches thrown by the pitcher.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_baseball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>catcher</w> signaled to the pitcher before crouching behind the plate.",
                            "target_lang_translations": {
                                "zh": "<w>捕手</w>在本垒后方蹲下之前向投手示意。"
                            }
                        },
                        {
                            "text": "He wore heavy protective gear because the <w>catcher</w> takes many hard impacts.",
                            "target_lang_translations": {
                                "zh": "他穿戴着厚重的防护装备，因为<w>捕手</w>要承受很多剧烈撞击。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "baseball catcher",
                        "catcher's mitt",
                        "catcher's mask"
                    ],
                    "target_lang_definitions": {
                        "zh": "（棒球运动中的）捕手，蹲在击球员后方本垒处接投手的球。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "捕手",
                                "target_lang_sense_clarification": "棒球运动中的接球球员"
                            },
                            {
                                "target_lang_word": "接手",
                                "target_lang_sense_clarification": "棒球中接投手投球的队员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "898f6309-c7b9-3cae-8d30-b6eed3fabaa2",
                    "sense_definition": "A person or thing that catches someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_catching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog proved to be an excellent <w>catcher</w> of flying frisbees.",
                            "target_lang_translations": {
                                "zh": "事实证明，这只狗是一位出色的飞盘<w>捕手</w>。"
                            }
                        },
                        {
                            "text": "In ancient times, a specialized rat <w>catcher</w> was hired to control pests.",
                            "target_lang_translations": {
                                "zh": "在古代，人们会雇佣专门的灭鼠<w>人员</w>来控制害虫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dog catcher",
                        "rat catcher",
                        "dream catcher"
                    ],
                    "target_lang_definitions": {
                        "zh": "捕捉者，捕获人或物的人或装置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "捕捉者",
                                "target_lang_sense_clarification": "抓捕人或动物的人或物"
                            },
                            {
                                "target_lang_word": "捕手",
                                "target_lang_sense_clarification": "擅长接球或捕捉的人或动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53eb0bdf-0041-3b5d-bcc7-a35a8672e9d5",
                    "sense_definition": "The webbed glove worn by an ice hockey goaltender to catch the puck.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_hockey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goaltender snagged the puck out of the air using his <w>catcher</w>.",
                            "target_lang_translations": {
                                "zh": "守门员用他的<w>接球手套</w>将空中的冰球拦截抓获。"
                            }
                        },
                        {
                            "text": "A quick reaction with the <w>catcher</w> prevented an easy goal.",
                            "target_lang_translations": {
                                "zh": "<w>接球手套</w>的迅速反应防止了一记轻易的进球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trapper"
                    ],
                    "common_phrases": [
                        "catcher glove"
                    ],
                    "target_lang_definitions": {
                        "zh": "（冰球守门员用于接冰球的）接球手套。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "接球手套",
                                "target_lang_sense_clarification": "冰球守门员专用的带网手套"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c5b23d-6ed8-36f6-84ec-27c135d0ab03",
                    "sense_definition": "The receptive or passive partner during sexual activity between men.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_sexuality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the conversation, he referred to his role as the <w>catcher</w>.",
                            "target_lang_translations": {
                                "zh": "在对话中，他提到自己的角色是<w>受</w>。"
                            }
                        },
                        {
                            "text": "The phrase distinguishes between the pitcher and the <w>catcher</w> in slang.",
                            "target_lang_translations": {
                                "zh": "这个俚语区分了攻方与<w>受方</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bottom"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal sexual slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（男同性性行为中的）被动方，受方。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "受",
                                "target_lang_sense_clarification": "男同性恋关系中的被动一方"
                            },
                            {
                                "target_lang_word": "被动方",
                                "target_lang_sense_clarification": "性行为中接受的一方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36681457-3831-3a46-b2e2-c0bc7cfca2d7",
                    "sense_definition": "A professional or competitive wrestler.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_wrestling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran <w>catcher</w> demonstrated a classic grappling technique on the mat.",
                            "target_lang_translations": {
                                "zh": "这位经验丰富的<w>摔跤手</w>在垫子上演示了一项经典的缠斗技术。"
                            }
                        },
                        {
                            "text": "Old tournament records listed each seasoned <w>catcher</w> by weight class.",
                            "target_lang_translations": {
                                "zh": "古老的锦标赛记录按体重级别列出了每位资深<w>摔角选手</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dated usage in wrestling"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "职业摔跤手，摔角选手（旧称）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摔跤手",
                                "target_lang_sense_clarification": "从事抓抱摔跤的运动员"
                            },
                            {
                                "target_lang_word": "角力选手",
                                "target_lang_sense_clarification": "参加摔角比赛的选手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cceb5311-deae-3ed1-b999-344d2f3d1208",
                    "sense_definition": "A mechanical device fitted to a moving train designed to pick up mail pouches without stopping.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steam locomotive extended its <w>catcher</w> to grab the mail sack as it sped past the station.",
                            "target_lang_translations": {
                                "zh": "蒸汽机车飞速驶过车站时伸出<w>挂邮钩</w>抓住了邮袋。"
                            }
                        },
                        {
                            "text": "Inspectors checked the iron <w>catcher</w> before the postal train departed.",
                            "target_lang_translations": {
                                "zh": "在邮政列车出发前，检查员检查了铁制的<w>抓信器</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mail catcher"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historic railway terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（火车行驶时不停车抓取路旁邮袋的）挂邮袋钩装置，接邮装置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挂邮钩",
                                "target_lang_sense_clarification": "列车上抓取邮袋的机械臂钩"
                            },
                            {
                                "target_lang_word": "抓信器",
                                "target_lang_sense_clarification": "列车不停车接收邮袋的机械装置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
