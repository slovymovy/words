                "senses": [
                    {
                        "sense_id": "c78b4d6f-18f3-3b02-9531-b51db0f07de1",
                        "entry_id": "09d34938-6d06-3c51-b4e4-7893a6ec1cd3",
                        "glosses": [
                            "Spaziergang an den Weihnachtsfeiertagen"
