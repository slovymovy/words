                "senses": [
                    {
                        "sense_id": "3f8676e8-9b7a-3903-80ea-9237b09e8f60",
                        "entry_id": "4a0ed201-bae5-3dd6-bc97-e4cef414a04d",
                        "glosses": [
                            "eine Liste von Wünschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42fe79f-1f1c-4851-aeae-09453e069b21",
                                "sense_id": "3f8676e8-9b7a-3903-80ea-9237b09e8f60",
                                "text": "Wer arbeitet schon gerne Wunschlisten ab?"
                            },
                            {
                                "example_id": "8275c503-37a8-4038-9c90-c5bff0944114",
                                "sense_id": "3f8676e8-9b7a-3903-80ea-9237b09e8f60",
                                "text": "„Der letzte Punkt auf meiner Wunschliste für Kapstadt war eine Bootsfahrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d84db19b-8e5b-49c8-a2bf-6f5a26027c9b",
                        "source_entry_id": "4a0ed201-bae5-3dd6-bc97-e4cef414a04d",
                        "source_sense_id": "3f8676e8-9b7a-3903-80ea-9237b09e8f60",
                        "source_sense_description": "eine Liste von Wünschen",
                        "target_lang_word": "wish list",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wish list",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b72977ab-34ed-3d28-a30f-a39ed25b180b",
                                        "entry_id": "8bd11b86-4717-378e-af93-2cad8aad8478",
                                        "glosses": [
                                            "A list of desired things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7635f39-87a4-4797-b5bc-82a31a36ab38",
                                                "sense_id": "b72977ab-34ed-3d28-a30f-a39ed25b180b",
                                                "text": "Also on the wish list is completion of the Borders Railway, electrification to Stirling/Perth/Inverness and Dundee/Aberdeen, as well as upgrades to the Cumbrian Coast Line and electrification of Barrow-Carnforth and Windermere-Oxenholme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe1091b2-50d9-4bd8-8d5a-cb03a9b5ac58",
                        "source_entry_id": "4a0ed201-bae5-3dd6-bc97-e4cef414a04d",
                        "source_sense_id": "3f8676e8-9b7a-3903-80ea-9237b09e8f60",
                        "source_sense_description": "eine Liste von Wünschen",
                        "target_lang_word": "wishlist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wishlist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea48f30-9df0-389a-8db9-240b7909a28f",
                                        "entry_id": "fd0e7e1d-8b32-3c17-b011-eb5578da6438",
