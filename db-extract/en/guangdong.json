                                                "sense_id": "bc1bcf9a-7ea0-3c73-8354-f5810a7cac02",
                                                "text": "Der Kanton Mersch hat keine Grenze mit einem anderen Staat."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2ea96d98-7e44-3dfa-88bb-721f9c72e454",
