                                        "entry_id": "981d1b30-18fd-3c01-9e06-1dc854fdf6f9",
                                        "glosses": [
                                            "A transliteration of the Ancient Greek male given name Ἀρχιμήδης (Arkhimḗdēs), notably borne by Archimedes of Syracuse, an Ancient Greek mathematician, physicist and engineer (c. 287–212 BCE)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "574b1a90-a7d2-3751-acf2-f8e62f7e098e",
                                        "entry_id": "981d1b30-18fd-3c01-9e06-1dc854fdf6f9",
                                        "glosses": [
                                            "A large lunar impact crater on the eastern edges of the Mare Imbrium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7fa332e-96a7-49ca-add2-772f51b8708b",
                        "source_entry_id": "1023279a-852a-3a87-bb24-8a1257737ceb",
                        "source_sense_id": "b010b044-246d-3990-810c-d68cc0218b75",
                        "source_sense_description": "(antiker) griechischer Mathematiker und Physiker, auch Archimedes von Syrakus",
                        "target_lang_word": "Archimède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archimède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc1752f-57e0-320a-8fc5-2a64b65f51c1",
                                        "entry_id": "95f88833-7bf0-301a-9aa3-79cac8831ddc",
                                        "glosses": [
                                            "Scientifique grec né en 287 av. J.-C. et mort en 212 av. J.-C."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c5e87d-9485-4552-a02d-99a5d12215cc",
                                                "sense_id": "9bc1752f-57e0-320a-8fc5-2a64b65f51c1",
                                                "text": "Archimède de Syracuse (287–212 av. J.-C.) a laissé un grand nombre d’ouvrages dont quelques-uns nous sont parvenus en entier, entre autres un traité de « De Æquiponderantibus » qui renferme des propositions sur le levier et le centre de gravité, et que nous examinerons tout d’abord."
                                            },
                                            {
                                                "example_id": "c66b0218-33de-4ce9-bb28-ee1fefe1523e",
                                                "sense_id": "9bc1752f-57e0-320a-8fc5-2a64b65f51c1",
                                                "text": "La neige en mai n’est pas non plus déroutante, ni Archimède faisant de la géométrie pendant le siège de Syracuse."
                                            },
                                            {
                                                "example_id": "c19d0f8a-0e8c-4a96-b209-3f7346518136",
                                                "sense_id": "9bc1752f-57e0-320a-8fc5-2a64b65f51c1",
                                                "text": "Cette fois, le voici lancé à la poursuite du cadran d’Archimède, un artefact qui permet de localiser les failles spatiotemporelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Archimède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83a55713-f4bf-36a0-be0f-db6cbd1891c2",
                                        "entry_id": "47e365e7-6d41-3d89-9414-511c368ea847",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2be7fe4-1e86-44bb-aba1-1cbff5a1e332",
                                                "sense_id": "83a55713-f4bf-36a0-be0f-db6cbd1891c2",
                                                "text": "Gerty Archimède croit en la puissance du droit autant qu’en la puissance de la rue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Archimède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea3581d-7dd2-35af-9368-4d28b2808b57",
                                        "entry_id": "07a89a8f-d574-36ba-a6f6-5f8550b38b0f",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299603b7-1876-40a6-a37f-447af4ce56c9",
                                                "sense_id": "1ea3581d-7dd2-35af-9368-4d28b2808b57",
                                                "text": "Eh bien, Archimède, tu pars!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
