                "senses": [
                    {
                        "sense_id": "158cec0e-17c0-3e29-893e-0079ab5e0bcf",
                        "entry_id": "b6388aec-7d90-3d54-bc22-87b52d08b1e9",
                        "glosses": [
                            "Geldsammlung, die die Verbundenheit der Gläubigen mit dem Papst ausdrückt und karitativen und apostolischen Zwecken dient"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "b1eecc7d-2953-4386-8d95-2d14768dee29",
                                "sense_id": "158cec0e-17c0-3e29-893e-0079ab5e0bcf",
                                "text": "„Der Peterspfennig ist der bezeichnendste Ausdruck der Teilhabe aller Gläubigen an den wohltätigen Initiativen des Bischofs von Rom für die Weltkirche. Diese Geste hat nicht nur einen praktischen, sondern auch einen deutlichen symbolischen Wert als Zeichen der Einheit mit dem Papst und der Sorge für die Bedürfnisse der Brüder und Schwestern, und deshalb besitzt euer Dienst einen vornehmlich kirchlichen Wert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
