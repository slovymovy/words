                    {
                        "translation_id": "921266b7-a3be-4009-a361-8653a77c06c0",
                        "source_entry_id": "67422a40-f860-3161-a31b-4816498d9104",
                        "target_lang_word": "Hydraulik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hydraulik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6a7ac7-844b-3f19-88b1-b86b94e9c694",
                                        "entry_id": "a482ee49-57e6-32ba-91e3-5c2cc1c36ac3",
                                        "glosses": [
                                            "Ingenieurwissenschaft, die sich mit Strömungen von Flüssigkeiten befasst"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd5bb169-062b-46b1-a2a9-556ab4a81443",
                                                "sense_id": "3f6a7ac7-844b-3f19-88b1-b86b94e9c694",
                                                "text": "„Die Darcy-Weisbach-Gleichung ist eine wichtige Formel in der Hydraulik von Rohrströmungen.“"
                                            },
                                            {
                                                "example_id": "beede422-9061-432d-870e-9bedc46135b1",
                                                "sense_id": "3f6a7ac7-844b-3f19-88b1-b86b94e9c694",
                                                "text": "„Sie kennen sich mit Informatik, Hydraulik und Pneumatik aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0c78191-b575-3f92-9983-42f026543a5b",
                                        "entry_id": "a482ee49-57e6-32ba-91e3-5c2cc1c36ac3",
                                        "glosses": [
                                            "ein oder mehrere technische Geräte, die eine Flüssigkeit für Signal-, Kraft- oder Energieübertragung nutzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc2106a-8d2f-4fac-858e-1fbc438de9a8",
                                                "sense_id": "e0c78191-b575-3f92-9983-42f026543a5b",
                                                "text": "„Die Hydropneumatik ist ein Federungssystem, das mittels Hydraulik und Pneumatik die Funktionen von Dämpfung und Federung leistet.“"
                                            },
                                            {
                                                "example_id": "394d4e4e-fdf1-47b1-80cc-697d0a69c105",
                                                "sense_id": "e0c78191-b575-3f92-9983-42f026543a5b",
                                                "text": "„Gleichzeitig ist damit auch die Zahl der unterschiedlichen Hydrauliken erfaßt, die maßgeblich für den Dokumentations- und Prüfaufwand verantwortlich sind.“"
                                            },
                                            {
                                                "example_id": "ad5d2134-98de-45fa-b312-01d2f57b3abd",
                                                "sense_id": "e0c78191-b575-3f92-9983-42f026543a5b",
                                                "text": "„Drucksensoren kommen sehr häufig im Zusammenhang mit Motoren, Turbinen, Hydrauliken und chemischen Anlagen vor, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
