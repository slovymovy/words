{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4667fb23-5905-3fc0-afc2-23d5589460d5",
                    "sense_definition": "A medium-sized wild dog native to Africa and Asia.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jackal</w> scavenged for food near the edge of the village at night.",
                            "target_lang_translations": {
                                "cs": "<w>Šakal</w> v noci hledal potravu na okraji vesnice."
                            }
                        },
                        {
                            "text": "A hungry <w>jackal</w> howled loudly under the bright desert moon.",
                            "target_lang_translations": {
                                "cs": "Hladový <w>šakal</w> hlasitě výl pod jasným pouštním měsícem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Středně velká divoká psovitá šelma žijící v Africe a Asii."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šakal",
                                "target_lang_sense_clarification": "obecné označení pro psovitou šelmu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06127e50-7a73-37ea-9cb5-7373afbdcb02",
                    "sense_definition": "A person who acts in an opportunistic or dishonest way to benefit from others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was seen as a political <w>jackal</w> who only supported the winning side.",
                            "target_lang_translations": {
                                "cs": "Byl vnímán jako politický <w>oportunista</w>, který podporoval pouze vítěznou stranu."
                            }
                        },
                        {
                            "text": "The corrupt official acted like a <w>jackal</w> during the economic crisis.",
                            "target_lang_translations": {
                                "cs": "Zkorumpovaný úředník se během ekonomické krize choval jako <w>vyžírka</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opportunist",
                        "collaborator"
                    ],
                    "target_lang_definitions": {
                        "cs": "Člověk, který jedná oportunisticky nebo nečestně, aby těžil z druhých."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "oportunista",
                                "target_lang_sense_clarification": "člověk využívající příležitosti bez ohledu na zásady"
                            },
                            {
                                "target_lang_word": "vyžírka",
                                "target_lang_sense_clarification": "hanlivé označení pro někoho, kdo parazituje na druhých"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44066c0a-6bcd-3023-8b55-f7046593a545",
                    "sense_definition": "A person who performs menial or routine tasks for someone else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assistant felt like a mere <w>jackal</w> doing all the boring office work.",
                            "target_lang_translations": {
                                "cs": "Asistent se cítil jako pouhý <w>poskok</w>, který dělá veškerou nudnou kancelářskou práci."
                            }
                        },
                        {
                            "text": "He refused to be a <w>jackal</w> for his demanding and ungrateful boss.",
                            "target_lang_translations": {
                                "cs": "Odmítl být <w>lokajem</w> svého náročného a nevděčného šéfa."
                            }
                        }
                    ],
                    "synonyms": [
                        "dogsbody",
                        "lackey"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která vykonává podřadné nebo rutinní úkoly pro někoho jiného."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poskok",
                                "target_lang_sense_clarification": "člověk vykonávající podřadné úkoly pro někoho mocnějšího"
                            },
                            {
                                "target_lang_word": "lokaj",
                                "target_lang_sense_clarification": "ponížený služebník nebo přisluhovač"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c970f29-b9c2-3eb7-a533-932091c68393",
                    "sense_definition": "A playing card featuring a jack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played the <w>jackal</w> to win the final round of the game.",
                            "target_lang_translations": {
                                "cs": "Zahrál <w>spodka</w>, aby vyhrál poslední kolo hry."
                            }
                        },
                        {
                            "text": "The deck was missing the <w>jackal</w> card.",
                            "target_lang_translations": {
                                "cs": "V balíčku chyběla karta <w>kluka</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jack"
                    ],
                    "target_lang_definitions": {
                        "cs": "Hrací karta s vyobrazením kluka (spodka)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spodek",
                                "target_lang_sense_clarification": "karta s hodnotou 11 v mariášových kartách"
                            },
                            {
                                "target_lang_word": "kluk",
                                "target_lang_sense_clarification": "karta s hodnotou 11 v žolíkových kartách"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30c89feb-74bf-3a4b-856c-4c0c55404b89",
                    "sense_definition": "A player who steals the ball during a tackle in rugby.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flanker performed a perfect <w>jackal</w> to win a penalty for his team.",
                            "target_lang_translations": {
                                "cs": "Rváček předvedl perfektní <w>jackal</w> a vybojoval pro svůj tým trestný kop."
                            }
                        },
                        {
                            "text": "The referee penalized the player for failing to release the ball after the <w>jackal</w>.",
                            "target_lang_translations": {
                                "cs": "Rozhodčí potrestal hráče za to, že po <w>jackalu</w> nepustil míč."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hráč, který v ragby ukradne míč soupeři během skládky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jackal",
                                "target_lang_sense_clarification": "převzatý sportovní termín pro tuto specifickou herní situaci"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "524848d3-79a7-3659-96f5-2c9403bf1dfa",
                    "sense_definition": "To perform menial or routine tasks for someone else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>jackalled</w> for the wealthy merchant to earn a small wage.",
                            "target_lang_translations": {
                                "cs": "Pro bohatého kupce <w>poskokovali</w>, aby si vydělali malou mzdu."
                            }
                        },
                        {
                            "text": "He refused to <w>jackal</w> for the corrupt organization any longer.",
                            "target_lang_translations": {
                                "cs": "Odmítl pro zkorumpovanou organizaci dále <w>poskokovat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "toil",
                        "drudge"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vykonávat podřadné nebo rutinní úkoly pro někoho jiného."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poskokovat",
                                "target_lang_sense_clarification": "vykonávat podřadnou práci pro někoho"
                            },
                            {
                                "target_lang_word": "dřít",
                                "target_lang_sense_clarification": "těžce a rutinně pracovat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}