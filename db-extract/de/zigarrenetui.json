                        "examples": [
                            {
                                "example_id": "0f57a053-79d1-4695-b864-5f108cbcca8b",
                                "sense_id": "63a7e153-ee45-3c66-861b-5ec7ba07c558",
                                "text": "„Er trat, als er so sprach, vom Fenster an die Spiegelkonsole, wo neben Uhr und Notizbuch auch ein Zigarrenetui lag.“"
                            },
                            {
                                "example_id": "3d98bdde-8d61-4ba3-ad0c-7fb545d08eb9",
                                "sense_id": "63a7e153-ee45-3c66-861b-5ec7ba07c558",
                                "text": "„Der erschien dem Grenadier mit seinem dunklen Anzug, dem Zigarrenetui in der Westentasche und dem Duft nach Pomade und gutem Tabak wie ein leibhaftiger Kriegsgewinnler.“"
                            }
                        ],
