                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les registres paroissiaux du dix-septième siècle, le seigneur local est qualifié d'<w>écuyer</w>."
                        },
                        {
                            "text": "Bien qu'il fût seulement <w>écuyer</w>, il possédait un domaine foncier fort étendu."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
