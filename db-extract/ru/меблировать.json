                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dc42ccd-b07f-463b-8265-cb43f0c73c80",
                                                "sense_id": "a12a25d5-f71e-3fd1-98eb-4045d41f6b2f",
                                                "text": "Cette étoffe meuble bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "803510c6-5569-3c2a-9211-e99774d107e7",
                                        "entry_id": "a165869b-ca0d-39f1-9118-3eb9fec7e385",
                                        "glosses": [
                                            "Garnir de ce qui est nécessaire pour faire valoir un bien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff339686-4a40-42dc-8bda-61bcd5dd1130",
                                                "sense_id": "803510c6-5569-3c2a-9211-e99774d107e7",
                                                "text": "Meubler une usine de machines-outils"
                                            },
                                            {
                                                "example_id": "6f66d4a6-8ab8-455c-9d42-7b773d8af7a0",
                                                "sense_id": "803510c6-5569-3c2a-9211-e99774d107e7",
                                                "text": "Meubler une ferme de bestiaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7dcc60f-10fc-3f15-ba84-04f0d8e50b9e",
                                        "entry_id": "a165869b-ca0d-39f1-9118-3eb9fec7e385",
                                        "glosses": [
                                            "Garnir de biens."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b679e169-dacd-49b7-b2dd-f3c1a3cf23d9",
                                                "sense_id": "f7dcc60f-10fc-3f15-ba84-04f0d8e50b9e",
                                                "text": "Mais le couteau, plus étroit que la masse qui sert à en assurer la chute, offre l'apparence dérisoire d'un taille-crayons; mieux, d'un chicot tranchant qui meublerait à lui seul la mâchoire d'un requin."
                                            },
                                            {
                                                "example_id": "2d7b9f98-3c8b-4d30-b53f-f642c21e09c1",
                                                "sense_id": "f7dcc60f-10fc-3f15-ba84-04f0d8e50b9e",
                                                "text": "Une cave qui est bien meublée de vins de différentes espèces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60979f57-c9a4-3ec0-bee1-9795fa91c6c9",
                                        "entry_id": "a165869b-ca0d-39f1-9118-3eb9fec7e385",
                                        "glosses": [
                                            "Parler pour éviter le silence dans une conversation, ajouter des éléments superflus pour combler un vide dans un scénario, un spectacle, un discours."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c1c269-22d4-4b20-ae33-d699b8b6290a",
                                                "sense_id": "60979f57-c9a4-3ec0-bee1-9795fa91c6c9",
                                                "text": "Il passait l’essentiel de son temps à lui faire la conversation pour meubler l’attente."
                                            },
                                            {
                                                "example_id": "1abf935d-411e-44fe-93da-533938ceac9d",
                                                "sense_id": "60979f57-c9a4-3ec0-bee1-9795fa91c6c9",
                                                "text": "Ce qui est certain, c’est que le temps est long, dans ces conditions, et nous pousse à le meubler d’agissements qui, comment dire, qui peuvent à première vue paraître raisonnables, mais dont nous avons l’habitude."
                                            },
                                            {
                                                "example_id": "f099778c-6cde-4b1f-9d0f-f90e0b98590c",
                                                "sense_id": "60979f57-c9a4-3ec0-bee1-9795fa91c6c9",
                                                "text": "Meubler la conversation."
                                            },
                                            {
                                                "example_id": "cbc32e12-63e8-4cfd-a336-b80f5e034919",
                                                "sense_id": "60979f57-c9a4-3ec0-bee1-9795fa91c6c9",
                                                "text": "On sent que les auteurs de la série ont eu besoin de meubler un peu pendant cette saison, ça aurait pu être beaucoup plus court !"
                                            },
                                            {
                                                "example_id": "f981d1ec-f9d7-4f12-a52a-d9200213b719",
                                                "sense_id": "60979f57-c9a4-3ec0-bee1-9795fa91c6c9",
                                                "text": "Le musée du ginseng est fermé pour travaux. Pour meubler, l’équipe de tournage me demande de dessiner pour la caméra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f9a5ba7-7556-37a3-a0d5-82db204ad6cb",
                                        "entry_id": "a165869b-ca0d-39f1-9118-3eb9fec7e385",
                                        "glosses": [
                                            "Acquérir des meubles, s’installer, en parlant des personnes."
                                        ],
