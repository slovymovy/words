                "senses": [
                    {
                        "sense_id": "8d0727dd-b436-3e5b-840e-da1537eb0d0e",
                        "entry_id": "f436875e-50a3-3512-aeed-ecc376a10d1d",
                        "glosses": [
                            "спец. не имеющий внешней твёрдой оболочки, не защищенный корпусом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26ad170-50e9-4fac-b33a-b8096fbc12ee",
                                "sense_id": "8d0727dd-b436-3e5b-840e-da1537eb0d0e",
                                "text": "Бескорпусные фильтры позади горячего радиатора ― красивая игрушка и выброшенные деньги."
                            },
                            {
                                "example_id": "c1a3bf55-8135-489d-86cd-57964b72dd94",
                                "sense_id": "8d0727dd-b436-3e5b-840e-da1537eb0d0e",
                                "text": "Подпаивать провода нужно к печатным проводникам, идущих от выбранных контактов, стараясь не испортить бескорпусную микросхему."
                            }
                        ]
                    }
