                    {
                        "translation_id": "7986342b-c40c-4b3a-b53c-55322982af5f",
                        "source_entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                        "source_sense_id": "738acd21-3e19-36d8-bec1-80a1b5de629a",
                        "source_sense_description": "insult or barb",
                        "target_lang_word": "нае́зд",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нае́зд",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ea785d91-b1fe-3033-b393-4a7f98bfb5c7",
                                        "entry_id": "8b63f5af-278d-3517-a723-b66b18fc7b2c",
                                        "glosses": [
                                            "действие по значению гл. наезжать, наехать; проезд колёсами по чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c6fd841-b0ef-433d-b512-02a9ecb045c7",
                                                "sense_id": "ea785d91-b1fe-3033-b393-4a7f98bfb5c7",
                                                "text": "Наезд на пешехода."
                                            },
                                            {
                                                "example_id": "fe1bb692-d5e0-48b8-bc0f-e04d0f78a75d",
                                                "sense_id": "ea785d91-b1fe-3033-b393-4a7f98bfb5c7",
                                                "text": "Перед самым наездом на «лежачего полицейского» нужно отпустить тормоз."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e7ba68-74bd-3c26-80a5-95c4b5a414d8",
                                        "entry_id": "8b63f5af-278d-3517-a723-b66b18fc7b2c",
                                        "glosses": [
                                            "приезд множества людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8b6d44-b6f3-4bc5-964c-5c2a5ac4b5ba",
                                                "sense_id": "a7e7ba68-74bd-3c26-80a5-95c4b5a414d8",
                                                "text": "наезд гостей"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1abce2d-44d6-3f54-b892-440afe95da1c",
                                        "entry_id": "8b63f5af-278d-3517-a723-b66b18fc7b2c",
                                        "glosses": [
                                            "приезд кого-либо на непродолжительное время"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abae2deb-8002-4c0e-aacf-3685fb179c66",
                                                "sense_id": "a1abce2d-44d6-3f54-b892-440afe95da1c",
                                                "text": "За пять лет между моими наездами русских в Копенгагене стало больше, и они изменились."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86410d3-7421-3ab1-b346-8de273e0a934",
                                        "entry_id": "8b63f5af-278d-3517-a723-b66b18fc7b2c",
                                        "glosses": [
                                            "истор. способ исполнения решения суда в старом польском законодательстве, вооружённое нападение с целью отъёма собственности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8db8d9-311f-4992-bb0e-ca6342a12f13",
                                                "sense_id": "b86410d3-7421-3ab1-b346-8de273e0a934",
                                                "text": "«Пан Тадеуш, или последний наезд в Литве. Шляхетская история 1811–1812 годов в двенадцати книгах, писанная стихами»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861d84ee-d51a-3ce8-a6fe-7fc1269aac3c",
                                        "entry_id": "8b63f5af-278d-3517-a723-b66b18fc7b2c",
                                        "glosses": [
                                            "жарг. крим. нападение или посягательство на чьи-либо интересы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa62e6da-a4ce-4157-8c2f-dc2191188eeb",
                                                "sense_id": "861d84ee-d51a-3ce8-a6fe-7fc1269aac3c",
                                                "text": "Варварский «наезд» на ЮКОС — результат того, что Ходорковский решил порвать с круговой порукой олигархов, перестать заглядывать Кремлю в рот."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7415f3f-68a7-3ffa-a4e9-deb467f1839e",
                                        "entry_id": "8b63f5af-278d-3517-a723-b66b18fc7b2c",
                                        "glosses": [
                                            "кино увеличение изображения при фото- и киносъёмке изменением фокусного расстояния объектива или приближением камеры к объекту"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd78d6cf-7240-35f3-9a15-64cafe902c11",
                                        "entry_id": "8b63f5af-278d-3517-a723-b66b18fc7b2c",
                                        "glosses": [
                                            "жарг. нападки на кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9bafea-2b44-407e-a958-68ab29f5cf40",
                                                "sense_id": "fd78d6cf-7240-35f3-9a15-64cafe902c11",
                                                "text": "После простодушных, искренних признаний телеведущего в нелюбви к творчеству известного писателя на него начался наезд в прессе со стороны поклонников мастера."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e9f6668-3e76-4803-8781-061616903d1b",
                        "source_entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                        "source_sense_id": "738acd21-3e19-36d8-bec1-80a1b5de629a",
                        "source_sense_description": "insult or barb",
                        "target_lang_word": "колкость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "колкость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd8c5f8-9e20-3020-afa7-6d3cfdb0938e",
                                        "entry_id": "2d5f73a9-3876-3684-b430-43347caba505",
                                        "glosses": [
                                            "способность наносить уколы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1168a486-2e4a-4fa8-b346-e357afd4b829",
                                                "sense_id": "9bd8c5f8-9e20-3020-afa7-6d3cfdb0938e",
                                                "text": "Относительным неудобством нитей является колкость их кончиков, что требует от хирурга определенных навыков при наложении швов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c1485ff-bb8e-36b3-b362-5d15ba2a403d",
                                        "entry_id": "2d5f73a9-3876-3684-b430-43347caba505",
                                        "glosses": [
                                            "перен., неисч. злобная насмешливость, язвительность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1d51c9-d15a-4e63-8684-1b948c0816a7",
                                                "sense_id": "9c1485ff-bb8e-36b3-b362-5d15ba2a403d",
                                                "text": "Теперь, когда он так далеко, для всех, кто при жизни им восхищался или кто избегал встреч, образ Тендрякова, можно сказать, смягчился, исчезли углы, а колкость и агрессия обернулись тем, чем и были, чем питались искони: широтой познаний, активным присутствием духа..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5900b206-4cc3-3dd0-a724-8d6ed1b21ce5",
                                        "entry_id": "2d5f73a9-3876-3684-b430-43347caba505",
                                        "glosses": [
                                            "перен., исч. злобная насмешка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88da0cdc-e876-4fad-b429-107574a18dfb",
                                                "sense_id": "5900b206-4cc3-3dd0-a724-8d6ed1b21ce5",
                                                "text": "Аня помалкивала или отпускала реплики не по существу, главным образом колкости в адрес хозяина и холостяцкого убранства его жилища."
                                            },
                                            {
                                                "example_id": "7bd100d4-db33-4bf6-b3bb-0cd657289439",
                                                "sense_id": "5900b206-4cc3-3dd0-a724-8d6ed1b21ce5",
                                                "text": "Страсть её была в том, чтобы отпускать тонкие колкости и намеки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c04ab370-dd88-3196-a139-7459f60a9c58",
                                        "entry_id": "2d5f73a9-3876-3684-b430-43347caba505",
                                        "glosses": [
                                            "разг. удобность для колки, лёгкость раскалывания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ef8d2aa-c249-4454-9e77-bdaf13430c55",
                                                "sense_id": "c04ab370-dd88-3196-a139-7459f60a9c58",
                                                "text": "К использованию сосны в строительстве располагает также её высокая колкость."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
