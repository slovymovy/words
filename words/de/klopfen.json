                    ]
                },
                {
                    "sense_id": "8da6f3f1-c018-30bf-a673-4ab281344d55",
                    "sense_definition": "durch periodische oder wiederholte Schläge ein rhythmisches Geräusch erzeugen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "klopfen_schlagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der alte Motor begann nach einigen Minuten seltsam unruhig zu <w>klopfen</w>."
                        },
                        {
                            "text": "Die ganze Nacht <w>klopften</w> die alten Heizungsrohre im Keller."
                        }
                    ],
                    "synonyms": [
                        "hämmern",
                        "trommeln"
                    ],
                    "common_phrases": [
