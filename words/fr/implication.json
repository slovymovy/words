                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a soutenu qu'il y avait une évidente <w>implication</w> entre ces deux déclarations."
