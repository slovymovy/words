                        "entry_id": "2797a93d-c11d-36d0-bb95-82d3781d7cd6",
                        "glosses": [
                            "État d’une personne absorbée."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7526bfca-fb45-433d-bbf2-a58fdd3e974b",
                                "sense_id": "dff2c0bf-2aaa-390b-b981-cff436975bba",
                                "text": "L’absorbement de l’âme dans la méditation."
                            },
                            {
                                "example_id": "398efb68-31cd-4a11-ad5e-74f8aa066c78",
                                "sense_id": "dff2c0bf-2aaa-390b-b981-cff436975bba",
                                "text": "Dans son absorbement il ne s’aperçut de rien."
                            },
                            {
                                "example_id": "10434c16-4e52-45da-9973-bedb603750b2",
                                "sense_id": "dff2c0bf-2aaa-390b-b981-cff436975bba",
                                "text": "L'absorbement veut dire que les personnages sont perdus dans leurs pensées ou leurs occupations, au point d'ignorer leur environnement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
