        "fr-extract.jsonl": [
            {
                "entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                "word": "prêche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dcd8bd1d-4ec9-4ad8-b79a-b86e7f3291c9",
                        "entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "prêches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23a4afb5-7f87-3f0f-a6f7-8156f876d171",
                        "entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                        "glosses": [
                            "Discours, sermon tenu devant une assemblée de croyants dans un but d’enseignement, d’édification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15384800-e07e-4e05-adf2-2c2dcbe1fe46",
                                "sense_id": "23a4afb5-7f87-3f0f-a6f7-8156f876d171",
                                "text": "Jamais à l’école. Jamais de boulot. Des pérégrinations messianiques à travers l’Asie, des prêches d’une virulence absolue et une haine implacable à l’encontre du monde entier."
                            },
                            {
                                "example_id": "b8c86115-6774-4cea-93c8-b5b2eb7d41e3",
                                "sense_id": "23a4afb5-7f87-3f0f-a6f7-8156f876d171",
                                "text": "\"Cette charge revenait aux prophètes\", déclare Hassan Ali Kasi à l'AFP dans la capitale Islamabad. \"L'un des tout premiers éléments du prêche, c'était la récitation. C'est aussi vieux que l'islam.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "8b19b7bc-8de8-378e-889e-57171bd2a3a5",
                        "entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                        "glosses": [
                            "Sermons que les ministres de la religion protestante font dans leurs temples."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c7467138-9e05-4c1a-a85e-0b409690162e",
                                "sense_id": "8b19b7bc-8de8-378e-889e-57171bd2a3a5",
                                "text": "Aller, assister au prêche."
                            },
                            {
                                "example_id": "777102b7-8b4f-4934-b80e-01d36b4c44f6",
                                "sense_id": "8b19b7bc-8de8-378e-889e-57171bd2a3a5",
                                "text": "Monsieur d’Espard, qui a suivi cette affaire, m’a menée à l’Oratoire où cette femme va au prêche, car elle est protestante."
                            },
                            {
                                "example_id": "87e2d854-8af2-44f6-b801-865881a5b25a",
                                "sense_id": "8b19b7bc-8de8-378e-889e-57171bd2a3a5",
                                "text": "Jobs au contraire, amaigri par la maladie, son visage soucieux, piqué d’une barbe clairsemée, douloureusement posé sur sa main droite, évoque un de ces évangélistes itinérants au moment où, se retrouvant pour la dixième fois peut-être à débiter ses prêches devant une assistance clairsemée et indifférente, il est tout à coup envahi par le doute."
                            }
                        ]
                    },
                    {
                        "sense_id": "06c7baab-4c69-33aa-84ee-50f770e7c359",
                        "entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                        "glosses": [
                            "Discours moralisateur et ennuyeux."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05821acc-4f77-4816-82c9-757919f25c5f",
                        "source_entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                        "target_lang_word": "Predigt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Predigt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                        "entry_id": "cb14f869-57f2-3e9d-982e-6b7db252c802",
                                        "glosses": [
                                            "religiöse Ansprache durch einen Prediger an die Gläubigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9487cb91-b804-4a15-ba26-b3ec5c59867d",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "Bei der Predigt am letzten Sonntag sprach der Priester über die Heilbarkeit der Homophobie."
                                            },
                                            {
                                                "example_id": "7e654e3e-4f6e-47ff-9961-892be800ad3b",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„Die Predigten dieses Mannes ärgerten mich nicht, ich suchte mein Vergnügen darin, herauszubringen, wie er eigentlich auf seine Feststellungen kam.“"
                                            },
                                            {
                                                "example_id": "dbd8cff5-25f0-413d-8ec3-2eeba9bc63cf",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„In seinen Predigten hatte der Mystiker das Loslassen, letztlich auch von sich selbst, als die Voraussetzung benannt, Gott in sich einlassen zu können.“"
                                            },
                                            {
                                                "example_id": "3ffae972-4874-4440-8824-bf59073b4571",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„Als er eintraf, bestellte er für fünf Dollar Tricks, die er bei seinen Predigten vorführen wollte.“"
                                            },
                                            {
                                                "example_id": "86031b48-acd8-45f7-80be-23c829b253fe",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„Da war der alte Lenkes endlich in den Ruhestand geschickt worden, und seine ständigen Predigten von Gottes Strafe, dem ewigen Fegefeuer und dem Jüngsten Gericht hatten ein Ende gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7b5e184-ff16-3014-8c7c-68804ec22212",
                                        "entry_id": "cb14f869-57f2-3e9d-982e-6b7db252c802",
                                        "glosses": [
                                            "eine an Moral oder Gewissen appellierende Ansprache, um jemanden auf ein Fehlverhalten aufmerksam zu machen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f55e31c-c528-4c6e-98a7-4dcf279f353a",
                                                "sense_id": "e7b5e184-ff16-3014-8c7c-68804ec22212",
                                                "text": "Anstatt mir hier eine Predigt zu halten, solltest du lieber mit gutem Beispiel vorangehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ac49cdf-ca9a-437f-af7a-1614667d063e",
                        "source_entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                        "target_lang_word": "sermon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sermon",
