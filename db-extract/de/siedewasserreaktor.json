                    {
                        "sense_id": "eb529f83-1d2a-32d7-84ea-7fb9fa75dedb",
                        "entry_id": "0a93454b-b011-3624-8148-f02269de15ef",
                        "glosses": [
                            "Atomreaktor, in dem mit Hilfe von Wärme, die bei der Kernspaltung entsteht, Wasser erhitzt und damit Energie erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e7fd144-e737-4275-9079-cb624d9c7078",
                                "sense_id": "eb529f83-1d2a-32d7-84ea-7fb9fa75dedb",
                                "text": "Die Leistung des Siedewasserreaktors wird zwischen etwa 60 und 100 Prozent durch Verändern der Umlaufgeschwindigkeit des Wassers, und damit des Dampfblasengehalts im Reaktor geregelt."
                            }
                        ],
