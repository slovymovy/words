                "senses": [
                    {
                        "sense_id": "05d4bcf3-fd48-3e60-8fc3-01772727077d",
                        "entry_id": "e3d17ee6-2751-39b6-b666-9f3a0c669f1e",
                        "glosses": [
                            "etwas nur vorläufig in Ordnung Gebrachtes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c71be4-50c3-4810-a3ce-5d249354ca26",
                                "sense_id": "05d4bcf3-fd48-3e60-8fc3-01772727077d",
                                "text": "„Island ist geologisch gesehen noch ein Provisorium, eine junge Insel in der Pubertät, die ständig ihre Form verändert.“"
                            },
                            {
                                "example_id": "8ce131df-bb01-405f-8ff9-2d97f8feea75",
                                "sense_id": "05d4bcf3-fd48-3e60-8fc3-01772727077d",
                                "text": "„Doch dieses Provisorium wird zum Dauerzustand.“"
                            },
                            {
                                "example_id": "3c45c007-c0f2-4b39-9298-e5d022acfcf8",
                                "sense_id": "05d4bcf3-fd48-3e60-8fc3-01772727077d",
                                "text": "„Für Kiew war die Präsenz der russischen Schwarzmeerflotte ein Provisorium.“"
                            },
                            {
                                "example_id": "3f8cfb4e-6908-4162-b01c-6f2c4317bcb5",
                                "sense_id": "05d4bcf3-fd48-3e60-8fc3-01772727077d",
                                "text": "„Mehr als dreitausend verwundete Soldaten mussten in Provisorien verlegt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
