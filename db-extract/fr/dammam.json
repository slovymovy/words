                        "glosses": [
                            "Nom donné en Iran à un tambour cérémonial à deux faces en peau de chèvre, plus large que haut, qu'on appelle davul ailleurs en Asie Mineure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1348513-7fe0-4d15-ac53-2a6d3ef19816",
                                "sense_id": "cf433a30-e352-3c95-85d5-e214f7fa514d",
                                "text": "Le dammam se joue debout. Une courroie de cuir attachée au cadre passe sur l'épaule gauche du joueur. L'instrument est suspendu horizontalement, ou légèrement en oblique, au-dessus de la taille, sur le côté gauche du corps."
                            }
                        ]
                    }
