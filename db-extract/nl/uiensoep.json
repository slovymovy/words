                "translations": [
                    {
                        "translation_id": "bff3e2fb-9b33-4d71-b440-f30afad193ba",
                        "source_entry_id": "41c676db-124a-38f9-b2b9-e238569d5670",
                        "source_sense_id": "7cd4d87a-3c34-300f-8212-ddaa87314e13",
                        "source_sense_description": "een uit uien bereide soep",
                        "target_lang_word": "Zwiebelsuppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwiebelsuppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3dffe6a-abe7-3663-870b-024e301988d6",
                                        "entry_id": "396c79fb-3fd0-34b6-9604-3b59b76f6ca4",
                                        "glosses": [
                                            "klare Suppe mit gedünsteten Zwiebeln als Hauptzutat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "971c06a7-ca38-41ff-a28b-08505a634e72",
                                                "sense_id": "e3dffe6a-abe7-3663-870b-024e301988d6",
                                                "text": "„Wer Zeit und großen Hunger hat, dem seien als Vorspeisen die Zwiebelsuppe mit Croûtons, die Soljanka mit Toast oder das Omelette mit Champignons empfohlen.“"
                                            },
                                            {
                                                "example_id": "d8b48f26-c0ad-4a90-b755-a8c9176612bb",
                                                "sense_id": "e3dffe6a-abe7-3663-870b-024e301988d6",
                                                "text": "„Oben saßen einige Paare und aßen Zwiebelsuppe.“"
                                            },
                                            {
                                                "example_id": "b350ffe0-9412-4834-8a58-c159b77e2922",
                                                "sense_id": "e3dffe6a-abe7-3663-870b-024e301988d6",
                                                "text": "„Ein intensiver Geruch nach Zwiebelsuppe hatte sich verbreitet.“"
                                            },
                                            {
                                                "example_id": "4945bac3-4fff-4733-971e-397a0a5c8110",
                                                "sense_id": "e3dffe6a-abe7-3663-870b-024e301988d6",
                                                "text": "„Man hatte ihnen eine Zwiebelsuppe zubereitet, ferner ein Huhn, Speck und hartgekochte Eier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
