            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67d9c792-e406-3b78-a23a-feec695d2997",
                    "sense_definition": "kończyć wypowiedź, mówić coś do końca",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lubi <w>dopowiadać</w> każdą historię do końca, nawet gdy słuchacze już ziewają.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>договаривать</w> каждую историю до конца, даже когда слушатели уже зевают."
                            }
                        },
                        {
                            "text": "Pozwól mi <w>dopowiadać</w> zdania do końca, zanim zaczniesz mi przerywać.",
                            "target_lang_translations": {
                                "ru": "Дай мне <w>договаривать</w> фразы до конца, прежде чем начнёшь перебивать."
                            }
                        }
                    ],
                    "synonyms": [
                        "dokańczać"
                    ],
                    "common_phrases": [
                        "dopowiadać do końca"
                    ],
                    "target_lang_definitions": {
                        "ru": "закончить высказывание, договорить до конца"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "договаривать",
                                "target_lang_sense_clarification": "доводить высказывание до конца"
                            },
                            {
                                "target_lang_word": "заканчивать",
                                "target_lang_sense_clarification": "заканчивать мысль, фразу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c41367ba-312f-3dda-96d0-dc67a5856c0a",
                    "sense_definition": "dodawać coś do już wypowiedzianych słów, uzupełniać wypowiedź",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po każdej prezentacji <w>dopowiada</w> kilka słów od siebie.",
                            "target_lang_translations": {
                                "ru": "После каждой презентации он <w>добавляет</w> несколько слов от себя."
                            }
                        },
                        {
                            "text": "W trakcie dyskusji każdy <w>dopowiadał</w> swoje uwagi do raportu.",
                            "target_lang_translations": {
                                "ru": "В ходе дискуссии каждый <w>добавлял</w> свои замечания к отчёту."
                            }
                        }
                    ],
                    "synonyms": [
                        "domawiać"
                    ],
                    "common_phrases": [
                        "dopowiadać kilka słów"
                    ],
                    "target_lang_definitions": {
                        "ru": "добавить что-то к уже сказанному, дополнить высказывание"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добавлять",
                                "target_lang_sense_clarification": "добавлять к сказанному"
                            },
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "дополнять высказывание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "facc1449-1a19-374b-800b-8a77a9bb4a30",
                    "sense_definition": "dawać komuś wskazówkę, podpowiadać coś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel często <w>dopowiada</w> uczniom odpowiedzi, gdy zapominają definicji.",
                            "target_lang_translations": {
                                "ru": "Учитель часто <w>подсказывает</w> ученикам ответы, когда они забывают определения."
                            }
                        },
                        {
                            "text": "Nie lubię <w>dopowiadać</w> rozwiązań, wolę, żeby uczniowie sami na nie wpadali.",
                            "target_lang_translations": {
                                "ru": "Я не люблю <w>подсказывать</w> решения, пусть ученики додумываются сами."
                            }
                        }
                    ],
                    "synonyms": [
                        "podpowiadać"
                    ],
                    "target_lang_definitions": {
                        "ru": "дать кому-то подсказку, подсказать что-то"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсказывать",
                                "target_lang_sense_clarification": "подсказывать ответ, решение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}