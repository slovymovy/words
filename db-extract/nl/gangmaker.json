                "senses": [
                    {
                        "sense_id": "9fc8bb63-96cf-3a86-8ad6-75806fc6634b",
                        "entry_id": "d2842206-9081-3857-ab9d-5392ce334c8d",
                        "glosses": [
                            "life and soul of the party"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "bf25f90d-e7b5-4d7b-8174-cd6053980302",
                                "sense_id": "9fc8bb63-96cf-3a86-8ad6-75806fc6634b",
                                "text": "Marie is altijd de gangmaker op feestjes.",
                                "translation": "Marie is always the life and soul of the party at gatherings.",
                                "english": "Marie is always the life and soul of the party at gatherings."
                            },
                            {
                                "example_id": "6250b8c3-5ee6-492e-94f9-26a17bd19bc1",
                                "sense_id": "9fc8bb63-96cf-3a86-8ad6-75806fc6634b",
                                "text": "Een goede DJ kan een echte gangmaker zijn.",
                                "translation": "A good DJ can be a real life and soul of the party.",
                                "english": "A good DJ can be a real life and soul of the party."
                            },
                            {
                                "example_id": "9db20b19-f773-4709-a092-1424fd26279a",
                                "sense_id": "9fc8bb63-96cf-3a86-8ad6-75806fc6634b",
                                "text": "Iedereen houdt van Peter; hij is de gangmaker in onze vriendengroep.",
                                "translation": "Everyone loves Peter; he's the life and soul of the party in our group of friends.",
                                "english": "Everyone loves Peter; he's the life and soul of the party in our group of friends."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf9b31a9-3ae6-305a-abe2-aff242512221",
                        "entry_id": "d2842206-9081-3857-ab9d-5392ce334c8d",
                        "glosses": [
                            "pacemaker, pacesetter (a runner who sets the pace for other runners)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "07f9f6e6-75d6-4c62-8604-48504302d70e",
                                "sense_id": "cf9b31a9-3ae6-305a-abe2-aff242512221",
                                "text": "Tijdens de marathon had de organisatie een gangmaker om de lopers te helpen.",
                                "translation": "During the marathon, the organizers had a pacemaker to assist the runners.",
                                "english": "During the marathon, the organizers had a pacemaker to assist the runners."
                            },
                            {
                                "example_id": "c7f3ca57-b513-4f3d-9e8a-7fe7862ddf8e",
                                "sense_id": "cf9b31a9-3ae6-305a-abe2-aff242512221",
                                "text": "De gangmaker zette een strak tempo voor de race.",
                                "translation": "The pacesetter set a brisk pace for the race.",
                                "english": "The pacesetter set a brisk pace for the race."
                            },
                            {
                                "example_id": "3c014b66-08aa-4ff4-a27a-056f741e6234",
                                "sense_id": "cf9b31a9-3ae6-305a-abe2-aff242512221",
                                "text": "Het hebben van een goede gangmaker kan cruciaal zijn in langeafstandsraces.",
                                "translation": "Having a good pacemaker can be crucial in long-distance races.",
                                "english": "Having a good pacemaker can be crucial in long-distance races."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bb06309-5c86-378b-bf65-5e9b465afb2e",
