                    },
                    {
                        "translation_id": "3eae9abd-f39e-46b1-9bc3-3a8f5b7dfe5b",
                        "source_entry_id": "3c3fe3c1-15dc-3682-b856-89b70444498b",
                        "source_sense_id": "d3a96f64-831e-332e-b09d-b805dfa96450",
                        "target_lang_word": "organisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c213929b-0ca5-3ed9-ad99-ab09fa446d07",
                                        "entry_id": "4493262d-8e3b-327f-97e7-22eb62de456d",
                                        "glosses": [
                                            "Action d’organiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b16af19-8c10-4020-b78e-030e199ee0c1",
                                                "sense_id": "c213929b-0ca5-3ed9-ad99-ab09fa446d07",
                                                "text": "C’est la reine de l’organisation !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f3dd20d-3dab-3533-b33e-4610e8023cc2",
                                        "entry_id": "4493262d-8e3b-327f-97e7-22eb62de456d",
                                        "glosses": [
                                            "Manière dont un corps est organisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037a80ae-4798-4b37-9836-e2d16aa5ffe0",
                                                "sense_id": "5f3dd20d-3dab-3533-b33e-4610e8023cc2",
                                                "text": "L’organisation du corps humain. — L’organisation des végétaux."
                                            },
                                            {
                                                "example_id": "a65ff5a2-107a-4127-a5e7-b100121eb820",
                                                "sense_id": "5f3dd20d-3dab-3533-b33e-4610e8023cc2",
                                                "text": "Peut-être que Jeanne était trempée pour supporter héroïquement la souffrance. Peut-être aussi qu’elle avait une de ces organisations exceptionnelles, si parfaites, que la douleur physique semble n’avoir pas de prise sur elles."
                                            },
                                            {
                                                "example_id": "af67b6ce-f8e3-4cf1-8aa4-149bdc770754",
                                                "sense_id": "5f3dd20d-3dab-3533-b33e-4610e8023cc2",
                                                "text": "Le teint pâle, d’une blancheur bleuâtre, révélait une organisation maladive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e9dd6b-03a2-3630-9073-1c93b3f6198b",
                                        "entry_id": "4493262d-8e3b-327f-97e7-22eb62de456d",
                                        "glosses": [
                                            "Manière dont un État, une collectivité, un établissement public ou une entreprise, est organisé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46fdec09-9d3b-4929-8222-4c42cc95b58e",
                                                "sense_id": "f7e9dd6b-03a2-3630-9073-1c93b3f6198b",
                                                "text": "Toute l’histoire classique est dominée par la guerre conçue héroïquement ; les institutions des républiques grecques eurent, à l’origine, pour base l’organisation d’armées de citoyens ; […]."
                                            },
                                            {
                                                "example_id": "5e500fe6-f525-47ff-8bee-a28e369c955e",
                                                "sense_id": "f7e9dd6b-03a2-3630-9073-1c93b3f6198b",
                                                "text": "L’installation d’une filature doit comprendre également une organisation du système de ventilation, d’humidification et de chauffage."
                                            },
                                            {
                                                "example_id": "a0d4c384-4eaa-4842-9823-29440398a41c",
                                                "sense_id": "f7e9dd6b-03a2-3630-9073-1c93b3f6198b",
                                                "text": "Toute une organisation formidable d’écumeurs et d’inutiles, vivant grassement, tripatouillant, combinant, s’enrichissant, sans produire quoi que ce fût d’utile."
                                            },
                                            {
                                                "example_id": "a31e8ad6-d0d3-41d3-8731-c04b6573d409",
                                                "sense_id": "f7e9dd6b-03a2-3630-9073-1c93b3f6198b",
                                                "text": "Les Allemands ont considérablement embelli Strasbourg et nombre d’Alsaciens préféraient l’organisation allemande au laisser-aller français."
                                            },
                                            {
                                                "example_id": "4e5926fe-209c-49ed-a6a7-0acf5eb9f762",
                                                "sense_id": "f7e9dd6b-03a2-3630-9073-1c93b3f6198b",
                                                "text": "Les plébiscitaires n’avaient pas d'influence électorale comparable à celle des impérialistes, mais ils possédaient à Paris une organisation assez forte comportant des comités d’arrondissement et de quartier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94d03429-3828-35d1-aeca-416c3006e1fd",
                                        "entry_id": "4493262d-8e3b-327f-97e7-22eb62de456d",
                                        "glosses": [
                                            "Association ; institution."
                                        ],
                                        "tags": [
                                            "collective",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86c3c85f-a316-4551-b417-a6747f5296ae",
                                                "sense_id": "94d03429-3828-35d1-aeca-416c3006e1fd",
                                                "text": "La création des jurandes et des maîtrises leur fut funeste, car ces organisations n’étaient pas seulement professionnelles mais religieuses."
                                            },
                                            {
                                                "example_id": "8e862dff-29d8-4cba-a3a7-02e0a55e6ede",
                                                "sense_id": "94d03429-3828-35d1-aeca-416c3006e1fd",
                                                "text": "Le film du passé revivait avec ces femmes héroïques des organisations prolétariennes des années 30 qui rejoignirent le Kampfbund (Alliance du combat) contre le fascisme, tandis que les cercles féministes ou tout simplement féminins de la bourgeoisie se sabordaient ou étaient absorbés par la NS-Frauenschaft, l’organisation nazie des femmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
