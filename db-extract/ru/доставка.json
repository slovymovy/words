                                        "entry_id": "7a73f5c9-62e9-3c11-b34b-3be00784c762",
                                        "glosses": [
                                            "The item which has been conveyed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d27f9eff-c560-4b36-b877-ac99ad0fe200",
                                                "sense_id": "2f922ad9-f1d8-3c9b-b8a6-26fb1fb65814",
                                                "text": "Your delivery is on the table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0152c188-7538-3b6e-aacb-5006a6b30c10",
                                        "entry_id": "7a73f5c9-62e9-3c11-b34b-3be00784c762",
                                        "glosses": [
                                            "The act of giving birth"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f9f5a0-f145-4bc7-b691-aeb9e4561058",
                                                "sense_id": "0152c188-7538-3b6e-aacb-5006a6b30c10",
                                                "text": "The delivery was painful."
                                            },
                                            {
                                                "example_id": "f2d3e6e9-5657-4f8e-a371-1223f06ac58c",
                                                "sense_id": "0152c188-7538-3b6e-aacb-5006a6b30c10",
                                                "text": "During pregnancy, the Queen had been more than twice as wide as she was tall, and the act of delivery took three months and six days after it had begun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67fffbb0-4c9c-311c-b669-909420e1a100",
                                        "entry_id": "7a73f5c9-62e9-3c11-b34b-3be00784c762",
                                        "glosses": [
                                            "A pitching motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
