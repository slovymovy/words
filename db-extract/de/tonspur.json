                "senses": [
                    {
                        "sense_id": "404d3def-2a96-33a9-af3d-3ffb9963ee86",
                        "entry_id": "7ea9aaab-4ab4-3948-8121-851fe45e243e",
                        "glosses": [
                            "in der analogen Technik der für die Wiedergabe von Audiosignalen reservierte Teil auf einem Filmstreifen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68d34eb-e093-4cfd-b93a-ac3536ff0881",
                                "sense_id": "404d3def-2a96-33a9-af3d-3ffb9963ee86",
                                "text": "Anders als bei Dokumentar-Filmen üblich, folgt die Regisseurin von vornherein konsequent der Musik. Zuerst wurde die Tonspur geschnitten und erst danach die dazu passenden Bilder gedreht."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "261d4240-3af2-3a66-b7dd-2d5edb3014eb",
                        "entry_id": "7ea9aaab-4ab4-3948-8121-851fe45e243e",
                        "glosses": [
                            "in der analogen Technik der Anteil eines Tonbandes/Magnetstreifens, der für ein Monosignal benötigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a77d57-0eea-4b78-badb-627fc6fd9cfb",
                                "sense_id": "261d4240-3af2-3a66-b7dd-2d5edb3014eb",
                                "text": "[Audio-Kompaktkassette]: Bei Mono-Aufnahmen enthalten die Bänder zwei Tonspuren, eine für jede Richtung. Mit Stereo-Aufnahmen bespielte Bänder enthalten vier – entsprechend schmalere – Tonspuren, zwei für jede Laufrichtung."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "0294f117-3ea8-39f9-ad40-d5c37902289b",
                        "entry_id": "7ea9aaab-4ab4-3948-8121-851fe45e243e",
                        "glosses": [
                            "in der Digitaltechnik die parallel aufgezeichneten Monosignale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1256092-fbdc-41db-b2e1-95a77a14a33f",
                                "sense_id": "0294f117-3ea8-39f9-ad40-d5c37902289b",
                                "text": "Mohr zählt überzeugend mehrere Schwächen von Soundslides auf. Ja, es nervt, dass man innerhalb von Soundslides die Tonspur nachträglich nicht bearbeiten kann."
                            }
                        ],
                        "sense_index_json": "\"1c\""
                    },
                    {
                        "sense_id": "aca0bae2-24df-34bf-a9f1-c5b4956a8151",
                        "entry_id": "7ea9aaab-4ab4-3948-8121-851fe45e243e",
                        "glosses": [
                            "(bei der Wortkombination auf der Tonspur): mündlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa7ee9a-c59e-4f52-aca7-9e01cd1dc1b9",
                                "sense_id": "aca0bae2-24df-34bf-a9f1-c5b4956a8151",
                                "text": "„Diese Absonderungen von Sprechblasen von unserem Vorsitzenden, die sind einfach furchtbar: \"sich committen\" oder \"auf der Tonspur\", das ist doch kein Deutsch!“"
                            },
                            {
                                "example_id": "0c2dc4d9-2b6d-43f3-99c8-065b26d2814c",
                                "sense_id": "aca0bae2-24df-34bf-a9f1-c5b4956a8151",
                                "text": "Als er da vorhin so am Flipchart stand und wirklich alles auf der Tonspur rüberbrachte, dachte jeder einzelne von uns: Mein Gott, wie ist der denn unterwegs! Ein Vortrag ganz ohne PowerPoint?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
