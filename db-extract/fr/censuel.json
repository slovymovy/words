                ],
                "senses": [
                    {
                        "sense_id": "e462c499-f925-3055-b6e0-bd67077ce874",
                        "entry_id": "2ac3b936-2fd2-3510-9d64-2b8b224964f7",
                        "glosses": [
                            "Qui a rapport au cens."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": [
                            {
                                "example_id": "d103fad0-896d-409d-9408-31bf93053e7b",
                                "sense_id": "e462c499-f925-3055-b6e0-bd67077ce874",
                                "text": "Le droit d’indemnité du seigneur [pour biens passant en main morte] s’estime au cinquieme denier de la valeur de la chose censuelle [de la censive]."
                            },
                            {
                                "example_id": "fa53b5a2-cc05-446a-908e-0bf5e431d201",
                                "sense_id": "e462c499-f925-3055-b6e0-bd67077ce874",
                                "text": "Le seigneur feodal ou censuel [à qui le cens est dû]."
                            },
                            {
                                "example_id": "339b628c-c1a1-4930-81a6-e5fee0725e3f",
                                "sense_id": "e462c499-f925-3055-b6e0-bd67077ce874",
                                "text": "Celuy qui tient heritage en censive doit, au jour et lieu accoustumé, payer le droit de cens au seigneur censuel."
                            },
                            {
                                "example_id": "8a46fa25-ec92-4555-85f3-8fd53788cd2f",
                                "sense_id": "e462c499-f925-3055-b6e0-bd67077ce874",
                                "text": "De l’heritage censuel et roturier, l’acquesteur peut prendre saisine et possession, sans le consentement du seigneur censier et justicier."
                            },
                            {
                                "example_id": "e42c30ff-036b-494c-9403-d9c118f7816a",
                                "sense_id": "e462c499-f925-3055-b6e0-bd67077ce874",
                                "text": "La tenure féodale et la tenure censuelle."
                            },
                            {
                                "example_id": "78c59029-61ac-4b9f-9770-9b1d42fc7ef3",
                                "sense_id": "e462c499-f925-3055-b6e0-bd67077ce874",
                                "text": "Ce capitulaire où Charles le Chauve parle des terres censuelles dont le cens avait appartenu au roi."
                            }
                        ]
                    }
                ],
