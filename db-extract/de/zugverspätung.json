                            {
                                "example_id": "058c12b8-75b8-46bc-8d82-542a065c8a74",
                                "sense_id": "a5748a62-1ed7-3587-9fca-b8ec4b6f579d",
                                "text": "Während des Streiks am Wochenende gab es viele Zugverspätungen."
                            },
                            {
                                "example_id": "55855a48-8518-47eb-a7ab-8670dfd72311",
                                "sense_id": "a5748a62-1ed7-3587-9fca-b8ec4b6f579d",
                                "text": "„Im Falle einer Zugverspätung gibt es seit dem 29.07.2009 für die gesamte Reisekette, von S- Bahn bis ICE Entschädigungsregelungen.“"
                            },
                            {
                                "example_id": "343d6b4d-0d4f-47c7-9bd5-eb2f25745ffb",
                                "sense_id": "a5748a62-1ed7-3587-9fca-b8ec4b6f579d",
                                "text": "„Ein Reisender, der seinen Flug wegen der Zugverspätung überhaupt nicht mehr erreichte, zog vor Gericht.“"
