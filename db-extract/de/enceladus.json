                ],
                "senses": [
                    {
                        "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                        "entry_id": "8312825a-aa09-3b4e-b820-52a69d67cad2",
                        "glosses": [
                            "Mond des Planeten Saturn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b65c18-2207-47b0-93d6-c01fc75298b8",
                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                "text": "Im Jahre 2005, als Cassini auf der Nachtseite des Enceladus vorbeiflog, erspähte die Sonde Streulicht von Geysir-artigen Eruptionen von Eispartikeln, die offenbar aus Rissen in der Nähe des Südpols stammten (…)."
                            },
                            {
                                "example_id": "a26b4db4-7d59-49a2-b9cc-c3e5b2caf7bd",
                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                "text": "Unter kilometerdicken Eisschichten am Südpol des Saturnmondes Enceladus könnte ein riesiger Ozean liegen."
                            },
                            {
                                "example_id": "15da368a-9253-4eb4-abba-1f8de32cdbf1",
                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                "text": "Tief im Saturnmond Enceladus sprudeln heiße Quellen am Boden eines unterirdischen Ozeans."
                            },
                            {
                                "example_id": "05c2db1c-ebde-4955-9cc6-fb0d8938fed4",
                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                "text": "Die Eispartikel von Enceladus speisen einen eigenen Saturnring, den sogenannten E-Ring, wie die Beobachtungen gezeigt haben."
                            },
                            {
                                "example_id": "e4191630-de9c-4439-8add-6126b904e689",
                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                "text": "Die Forscher hatten bereits gewusst, dass Enceladus wegen Resonanzen mit anderen Monden Gezeitenreibung erfahren muss, aber sie waren doch überrascht, dass diese intensiv genug ist, um geologische Aktivität zu ermöglichen."
                            },
                            {
                                "example_id": "08f4f39d-e155-4708-a0d6-8a01e34899d3",
                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                "text": "Diese Erwärmung beginnt nun aber Energie aus dem von Dione veränderten Orbit abzuführen, was die Umlaufbahn von Enceladus langsam wieder in den nahezu kreisförmigen Zustand zurückführt und den Mond erneut auskühlt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
