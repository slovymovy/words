                        "entry_id": "6a12cc96-3e93-390f-9de7-ccda2d7dcbba",
                        "glosses": [
                            "znajdowany bardzo rzadko albo nieobserwowany przedtem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a522c6-bfcb-4c42-bff4-9644f1d5cd2a",
                                "sense_id": "2fc9d510-ee29-3112-8542-c6792297d44c",
                                "text": "Sprzęg, usił, strwon, paskuda, postronić, dodajmy — półbabek, wszystko to słowa niespotykane w codziennej polszczyźnie."
                            },
                            {
                                "example_id": "4dec44cc-4cdd-4e16-a7ec-5e7e3986b058",
                                "sense_id": "2fc9d510-ee29-3112-8542-c6792297d44c",
                                "text": "Jego wadą była niespotykana zawziętość, nikt nie był w stanie przemówić mu do rozsądku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14d6f395-1cc4-4369-902a-f3747a3f5f25",
                        "source_entry_id": "6a12cc96-3e93-390f-9de7-ccda2d7dcbba",
                        "source_sense_id": "2fc9d510-ee29-3112-8542-c6792297d44c",
                        "target_lang_word": "unprecedented",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unprecedented",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a822bfb-f497-36f2-acca-7b4866cd9262",
                                        "entry_id": "bfd21fcf-283e-3239-81a6-9d580d11e17c",
                                        "glosses": [
                                            "Never before seen, done, or experienced; without precedent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b9f4906-6b34-428c-a393-abaa66a8e9ff",
                                                "sense_id": "2a822bfb-f497-36f2-acca-7b4866cd9262",
                                                "text": "With the descent of the cold war, relations between the two countries (for this is, to all intents and purposes, what they became after the end of the war) were almost completely broken off, with whole families split for the ensuing decades, some for ever. This event and its after-effects, along with the war against the Japanese in the 1940s, was to cast a long shadow over the years ahead, and led to the creation of the wholly unprecedented worship of Kim Il-sung, and his elevation to almost God-like status. It was also to create the system in which his son was to occupy almost as impossibly elevated a position."
                                            },
                                            {
                                                "example_id": "2e8f749e-7f14-4807-81cb-fff1ba00e861",
                                                "sense_id": "2a822bfb-f497-36f2-acca-7b4866cd9262",
                                                "text": "On October 6, 1927, Warner Bros. released The Jazz Singer, the first sound-synched feature film, prompting a technological shift of unprecedented speed and unstoppable force. Within two years, nearly every studio release was a talkie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
