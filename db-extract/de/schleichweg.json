                        "cross_references": [
                            {
                                "target_word": "rat run",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f617410-83c4-30e6-be0b-a9c0c629ae42",
                                        "entry_id": "84ab3ecd-4e82-3c8f-9116-1947ab9bf900",
                                        "glosses": [
                                            "A small, usually minor road used by a significant amount of traffic as a short cut or to avoid congestion on more major routes."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7938de-6e13-41ea-8855-ce64c8a384c2",
                                                "sense_id": "4f617410-83c4-30e6-be0b-a9c0c629ae42",
                                                "text": "This week Wykeham Street in Scarborough was named as the worst rat run in Britain. […] A ‘rat run’ sounds like some sort of charity jog by rodents keen to improve their image, but it is of course a side street that suffers from being heavily used by through-traffic as a short-cut."
                                            }
                                        ]
                                    }
                                ]
                            },
