                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An alphabet can be considered <w>defective</w> if it lacks symbols for essential vowel sounds."
                        },
                        {
                            "text": "The historical script was <w>defective</w> in representing the full range of consonants."
                        }
                    ],
                    "common_phrases": [
                        "defective writing system"
                    ]
                },
                {
                    "sense_id": "ac308469-ea2e-3f92-9f50-a9966ce2b7e4",
                    "sense_definition": "Having a root whose final consonant is weak.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "semitic_grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Arabic grammar, a <w>defective</w> root ends in a weak letter like ya or waw."
                        },
                        {
                            "text": "Students of Semitic languages must learn how to conjugate a <w>defective</w> verb."
                        }
                    ],
                    "common_phrases": [
                        "defective root"
                    ]
                }
            ]
        },
