                ],
                "senses": [
                    {
                        "sense_id": "7dcdcf4a-7576-33c7-9096-12eaf0e4bff1",
                        "entry_id": "e03d6ecd-cc1d-395d-94f4-4168bf662d07",
                        "glosses": [
                            "kunstgerechtes Vortragen (einer Dichtung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c8c110-57a0-4538-8661-e345024099b9",
                                "sense_id": "7dcdcf4a-7576-33c7-9096-12eaf0e4bff1",
                                "text": "Die humoristische Deklamation des Sprechers war ausgezeichnet."
                            },
                            {
                                "example_id": "288c3b20-168b-4397-a577-f2c05a92396a",
                                "sense_id": "7dcdcf4a-7576-33c7-9096-12eaf0e4bff1",
                                "text": "„Etliche gaben ihrer Rührung darüber Ausdruck, daß der Geist noch bewahrte, was ihnen an Schulwissen und Bildung längst abhanden gekommen sei; einzelne lobten das Organ des Archivars bei der Deklamation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0f3b866-6493-3917-94b6-cb3e1acc79b1",
                        "entry_id": "e03d6ecd-cc1d-395d-94f4-4168bf662d07",
                        "glosses": [
                            "übertriebene Redeweise"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f1b7e9f-dda7-4f84-a94a-838636d44b16",
                        "source_entry_id": "e03d6ecd-cc1d-395d-94f4-4168bf662d07",
                        "source_sense_id": "7dcdcf4a-7576-33c7-9096-12eaf0e4bff1",
                        "source_sense_description": "kunstgerechtes Vortragen (einer Dichtung)",
                        "target_lang_word": "declamation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "declamation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cca41829-ea0c-35d6-9493-b6b53d0d7d29",
                                        "entry_id": "ab45a6fb-cc57-37da-983f-47f3d5d0f578",
                                        "glosses": [
                                            "The act or art of declaiming; rhetorical delivery; loud speaking in public."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cbf1447-10b3-37b0-b258-e93233afa82e",
                                        "entry_id": "ab45a6fb-cc57-37da-983f-47f3d5d0f578",
                                        "glosses": [
                                            "The act or art of declaiming; rhetorical delivery; loud speaking in public.",
                                            "The public recitation of speeches as an exercise in schools and colleges."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3385cf05-1fb1-46bf-a663-ce4b444ccc54",
                                                "sense_id": "4cbf1447-10b3-37b0-b258-e93233afa82e",
                                                "text": "His recitations were prompt and correct, and his answers were given with confidence. But perhaps he did himself most credit in declamation. He had always been very fond of that, and though he had never received and scientific instruction in it, he possessed a natural grace and a deep feeling of earnestness which made success easy. He had selected an extract from Webster--the reply to the Hayne--and this was the showpiece of the afternoon. The rest of the declamation was crude enough, but Harry's impressed even the most ignorant of his listeners as superior for a boy of his age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd73f13-b086-3d93-a0c1-80fbb7a4f8a0",
                                        "entry_id": "ab45a6fb-cc57-37da-983f-47f3d5d0f578",
                                        "glosses": [
                                            "A set or harangue; declamatory discourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c02f8977-2051-3b0e-9b0c-92d733630287",
                                        "entry_id": "ab45a6fb-cc57-37da-983f-47f3d5d0f578",
                                        "glosses": [
                                            "Pretentious rhetorical display, with more sound than sense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caf3f2d6-fee1-4900-8399-b9410b4b06b5",
                                                "sense_id": "c02f8977-2051-3b0e-9b0c-92d733630287",
                                                "text": "mere declamation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ec09527-b92f-424e-a720-6b7c201235d9",
                        "source_entry_id": "e03d6ecd-cc1d-395d-94f4-4168bf662d07",
                        "source_sense_id": "7dcdcf4a-7576-33c7-9096-12eaf0e4bff1",
                        "source_sense_description": "kunstgerechtes Vortragen (einer Dichtung)",
                        "target_lang_word": "harangue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harangue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2db8b242-3139-3fbd-9765-a522c789e91a",
                                        "entry_id": "a7ee8ccf-8453-368b-b73f-337e0a18d6f7",
                                        "glosses": [
                                            "An impassioned, disputatious public speech."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                        "entry_id": "a7ee8ccf-8453-368b-b73f-337e0a18d6f7",
                                        "glosses": [
                                            "A tirade, harsh scolding or rant, whether spoken or written."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f9747e-8b80-41d8-afc6-798b5c78bcb5",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "She gave her son a harangue about the dangers of playing in the street."
                                            },
                                            {
                                                "example_id": "05c2d65a-4a56-4d27-ad38-b51e1441a2b6",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "The priest took thirty minutes to deliver his harangue on timeliness, making the entire service run late."
                                            },
                                            {
                                                "example_id": "96f8ebd2-df18-440a-97dc-82ed296dea77",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "The king addresses his people, and the heaviest impost is levied with acclamations—the general harangues his troops, and thousands rush upon the smoking cannon and the gleaming bayonets—the lover whispers his mistress, and she forgets even herself for his sake."
                                            },
                                            {
                                                "example_id": "59628961-6b11-49bb-95fc-0dfe6ebcf1d6",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "But he continued his harangue without waiting for a reply."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harangue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                        "entry_id": "aef5aeb1-bac3-3f47-a8fc-fb45b263d602",
                                        "glosses": [
                                            "To give a forceful and lengthy lecture or criticism to someone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "775e4aa5-eba2-48f9-ab62-c6dbe7a47f47",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "The angry motorist leapt from his car to harangue the other driver."
                                            },
                                            {
                                                "example_id": "60b171c8-c806-40ab-aeb8-52a0d76ec22a",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "He has vamp'd an old speech, and the court to their sorrow, / Shall hear him harangue against Prior to morrow."
                                            },
                                            {
                                                "example_id": "3558b921-d21c-4684-af73-4650e22a5862",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "This picture of her consequence had some effect, for no one loved better to lead than Maria;—and with far more good humour she answered, \"I am much obliged to you, Edmund;—you mean very well, I am sure—but I still think you see things too strongly; and I really cannot undertake to harangue all the rest upon a subject of this kind.—There would be the greatest indecorum I think.\""
                                            },
                                            {
                                                "example_id": "3f34d768-3132-416d-9597-0cc8c0e06ef4",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "It's a tradition that when you harangue the multitudes, you stand on a soapbox."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76cc15bb-2cf7-4723-ac8e-fec70848fd5a",
                        "source_entry_id": "e03d6ecd-cc1d-395d-94f4-4168bf662d07",
                        "source_sense_id": "7dcdcf4a-7576-33c7-9096-12eaf0e4bff1",
