                ],
                "translations": [
                    {
                        "translation_id": "cdaf1af9-53f6-4d8a-a074-571e98fe712e",
                        "source_entry_id": "e500c83d-2d89-378c-b6b3-acfc75217bb3",
                        "source_sense_id": "36b9f66e-d439-33ec-a3da-eabee097b421",
                        "source_sense_description": "Linguistik: Stelle in einem Text",
                        "target_lang_word": "passage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3317ebbc-a704-363d-942e-c3696bc83972",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Action de passer."
                                        ],
                                        "tags": [],
                                        "note": "Il peut avoir pour complément celui ou ceux qui passent, ou le lieu par où passe l’agent de cette action",
                                        "examples": [
                                            {
                                                "example_id": "976327a0-3df7-42fb-9441-a4cc751d1412",
                                                "sense_id": "3317ebbc-a704-363d-942e-c3696bc83972",
                                                "text": "Le plus grand ennui du voyage en Islande est le passage des rivières. […]. Elles sont si nombreuses, avec leurs tributaires, qu’on en traverse souvent une douzaine dans le cours d’une étape."
                                            },
                                            {
                                                "example_id": "ab243a2f-bc88-4891-975e-ce87b3822f50",
                                                "sense_id": "3317ebbc-a704-363d-942e-c3696bc83972",
                                                "text": "On ne voyait pas les tramways. […]. Pourtant les quais où ils roulaient, avec des piaulements plaintifs, n’étaient guère éloignés, car la rue, quelquefois, tremblait à leur passage […]."
                                            },
                                            {
                                                "example_id": "7ed76f82-da87-4bbc-8f82-bde98ea65ef8",
                                                "sense_id": "3317ebbc-a704-363d-942e-c3696bc83972",
                                                "text": "Le passage du fleuve, large en ce point de deux cents mètres, se fait au moyen d’embarcations plates de six à dix mètres de long."
                                            },
                                            {
                                                "example_id": "cbedf528-537e-491c-8701-f611763c8415",
                                                "sense_id": "3317ebbc-a704-363d-942e-c3696bc83972",
                                                "text": "Vous devez en être à 6 ou 7 mois, çomment ça se passe? - Impeccable, si on oublie le passage aux toilettes toutes les 5 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e318e8b9-9cd6-33b8-ace0-0100bd895c92",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Cette action en parlant des animaux migrateurs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b87e8a-1097-47ba-9512-3ff91dd5ee81",
                                                "sense_id": "e318e8b9-9cd6-33b8-ace0-0100bd895c92",
                                                "text": "Le passage des ramiers, des cailles, des bécasses."
                                            },
                                            {
                                                "example_id": "6740514d-9d03-4cfb-9b7c-1250d7b226a6",
                                                "sense_id": "e318e8b9-9cd6-33b8-ace0-0100bd895c92",
                                                "text": "Le passage des harengs, des morues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3d77dbe-93a1-30a2-aa00-3a1a01a9a621",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Cette action en parlant des liquides et des gaz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf242642-6cbd-4e1e-8ea8-e71631a4c721",
                                                "sense_id": "a3d77dbe-93a1-30a2-aa00-3a1a01a9a621",
                                                "text": "Faire une ouverture pour le passage de l’air, de la fumée."
                                            },
                                            {
                                                "example_id": "f150cc64-d6bd-4fc6-83c7-a99b0b67a54a",
                                                "sense_id": "a3d77dbe-93a1-30a2-aa00-3a1a01a9a621",
                                                "text": "Lever une vanne pour permettre le passage de l’eau dans une rigole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac1a0105-48fd-3ffe-be8e-f03a2bfa2dbf",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Interposition d’un astre entre l’œil d’un observateur et d’autres corps célestes : transit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30db84c5-88b7-4521-9bea-ed0bf29583b3",
                                                "sense_id": "ac1a0105-48fd-3ffe-be8e-f03a2bfa2dbf",
                                                "text": "Observer le passage de Vénus sur le disque du Soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a61e18b-19ec-355b-9833-52e048f01ca9",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Transition."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e41c9566-bed4-4a18-b455-9639daf9c64c",
                                                "sense_id": "4a61e18b-19ec-355b-9833-52e048f01ca9",
                                                "text": "Le passage du crétacé inférieur à la craie se voit bien quand on traverse le Vallage, de Vouziers à Tourcelles-Chaumont par exemple."
                                            },
                                            {
                                                "example_id": "46a6d024-f7f0-4611-9ab6-d7bfcecb85c9",
                                                "sense_id": "4a61e18b-19ec-355b-9833-52e048f01ca9",
                                                "text": "Le passage d’une teinte à une autre, dans un tableau."
                                            },
                                            {
                                                "example_id": "f5faf94d-8867-4847-9153-ad8d25a94cca",
                                                "sense_id": "4a61e18b-19ec-355b-9833-52e048f01ca9",
                                                "text": "Le passage d’un ton, d’un mode à un autre, dans un morceau de musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477d8d01-2b3a-3644-8ae2-d2e90902be99",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Changement d’une situation, d’une disposition d’âme en une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cf899de-8a81-4157-98b3-8002f4a45c20",
                                                "sense_id": "477d8d01-2b3a-3644-8ae2-d2e90902be99",
                                                "text": "Le passage d’une vie mondaine à une vie chrétienne."
                                            },
                                            {
                                                "example_id": "5004d617-ea19-4902-bd37-46e28759d598",
                                                "sense_id": "477d8d01-2b3a-3644-8ae2-d2e90902be99",
                                                "text": "Le passage d’une confiance excessive à une méfiance exagérée."
                                            },
                                            {
                                                "example_id": "f8159cb0-541f-4bdf-9561-2ac8c234d727",
                                                "sense_id": "477d8d01-2b3a-3644-8ae2-d2e90902be99",
                                                "text": "La vie n’est qu’un passage, Elle est courte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95048d44-ab98-3c55-850f-0cf07d85557d",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Lieu par où l’on passe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26a0fbe2-bb9b-4338-b50e-167aae0058b7",
                                                "sense_id": "95048d44-ab98-3c55-850f-0cf07d85557d",
                                                "text": "Il n’étoit pas possible que ses Troupes hivernassent en deçà des Monts , faute de Places fortes pour s’y maintenir: ainsi il les rappela sans attendre que les neiges en fermassent les passages."
                                            },
                                            {
                                                "example_id": "09ecfd17-bfac-420b-8528-2c929a9381aa",
                                                "sense_id": "95048d44-ab98-3c55-850f-0cf07d85557d",
                                                "text": "À la fin d’un long voyage, un navire doit traverser ce passage dangereux pour y porter ses marchandises, et le traverser encore pour revenir jusqu’au lieu du départ."
                                            },
                                            {
                                                "example_id": "005e3609-56fc-4117-bf7f-d45b5c7246e2",
                                                "sense_id": "95048d44-ab98-3c55-850f-0cf07d85557d",
                                                "text": "Mais le passage était si étroit, et le vertugadin de la reine de Navarre si large, que sa robe de soie effleura l’habit du jeune homme […]"
                                            },
                                            {
                                                "example_id": "9aaa8e68-c56c-4ca4-9584-c742614e3688",
                                                "sense_id": "95048d44-ab98-3c55-850f-0cf07d85557d",
                                                "text": "[…] qu'avant les grandes bandes blanches qui permettent de traverser les rues en toute quiétude ou de se faire écraser dans son droit, il y avait de jolis clous argentés qui délimitaient les passages pour piétons."
                                            },
                                            {
                                                "example_id": "9a5a963a-eead-43f6-9bd2-4307dec19394",
                                                "sense_id": "95048d44-ab98-3c55-850f-0cf07d85557d",
                                                "text": "Cahin-caha, après avoir déposé tous ses passagers palestiniens et franchi encore quelques passages difficiles sur une route semée de chicanes, de ralentisseurs et de nids-de-poule, le taxi atteint notre troisième checkpoint, Zatara."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68bb6925-5013-3e1f-83fb-da4cb075e298",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Lieu où passe le gibier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5731d37d-9901-4b54-bf04-a89989707337",
                                                "sense_id": "68bb6925-5013-3e1f-83fb-da4cb075e298",
                                                "text": "Le Frisé, un jouvenceau d’un an, capricieux et fantasque en diable, lui donnait surtout du fil à retordre, cherchant à profiter de tous les passages frayés dans l’une ou l’autre haie pour s’éclipser subitement."
                                            },
                                            {
                                                "example_id": "32a8afe6-91d1-4d81-a29c-2418281dee2a",
                                                "sense_id": "68bb6925-5013-3e1f-83fb-da4cb075e298",
                                                "text": "[…] j’appris qu’il était d’autres joies que celles d’épier sous un arbre l’approche d’un ramier ou de placer le soir sur un passage dans les taillis d’invisibles lacets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddf02449-541d-3779-b9e5-ef325192d9aa",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Traversée : composant, élément permettant à l’électricité, à un fluide, à la lumière voire à une action mécanique de passer à travers une paroi."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072453b1-6db7-442f-9511-4b2599cf9730",
                                                "sense_id": "ddf02449-541d-3779-b9e5-ef325192d9aa",
                                                "text": "La figure 25 donne plusieurs exemples de réalisation : le passage du courant refroidi, la fiche multibroche, le passage coaxial 50 Ω et le passage haute tension étuvable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe15467-3250-3c92-aa55-41e7fa6dbfaa",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Galerie couverte et réservé aux piétons, qui servent de dégagement aux rues voisines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280d84a0-9829-440a-8ff1-451f99decc13",
                                                "sense_id": "7fe15467-3250-3c92-aa55-41e7fa6dbfaa",
                                                "text": "Un second passage, qui menait du faubourg du Temple aux étroites voies désertes du onzième arrondissement, me réservait des surprises. À peu près sur toute la longueur, et des deux côtés, il était flanqué d’hôtels meublés au piteux éclairage […]"
                                            },
                                            {
                                                "example_id": "ae590e0e-8090-4b60-82bb-464a2ab5e226",
                                                "sense_id": "7fe15467-3250-3c92-aa55-41e7fa6dbfaa",
                                                "text": "À cet instant, dans le passage, d’autres voix s’élevèrent, accompagnées d’un martèlement de pas précipités."
                                            },
                                            {
                                                "example_id": "6ad86c97-7411-4618-851b-758b161c02fe",
                                                "sense_id": "7fe15467-3250-3c92-aa55-41e7fa6dbfaa",
                                                "text": "Un passage pavé de dalles et couvert d’un vitrage."
                                            },
                                            {
                                                "example_id": "1a644f7c-a829-485c-8c71-145cf2c6c910",
                                                "sense_id": "7fe15467-3250-3c92-aa55-41e7fa6dbfaa",
                                                "text": "La plupart des passages sont fermés de portes ou de grilles pendant la nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "122a3b17-8898-3c22-ac80-1378080405be",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Va-et-vient ; fréquentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4332ff4b-dbe2-4271-bfd2-7eab199d40b7",
                                                "sense_id": "122a3b17-8898-3c22-ac80-1378080405be",
                                                "text": "Il y a beaucoup de passage à cet endroit. C’est bon pour les affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d68aefc2-6aab-36de-8ed8-3b8f83210ae4",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Droit général ou particulier de passer sur la propriété d’autrui, par prescription ou par convention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25dc7a9f-d602-4a1f-92fc-4f3c8717cfb7",
                                                "sense_id": "d68aefc2-6aab-36de-8ed8-3b8f83210ae4",
                                                "text": "Passage de souffrance, de servitude."
                                            },
                                            {
                                                "example_id": "1bd004d2-aa15-4c4b-9f56-24b1d5c86827",
                                                "sense_id": "d68aefc2-6aab-36de-8ed8-3b8f83210ae4",
                                                "text": "Il doit un passage par son parc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ebe903a-0128-3580-a0f5-9272f48a9633",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Péage pour traverser une rivière dans un bac ou dans un bateau, pour passer sur un pont, par une écluse, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299e7739-b244-4b6a-b3ba-42e96e3568b5",
                                                "sense_id": "0ebe903a-0128-3580-a0f5-9272f48a9633",
                                                "text": "Payez le passage, votre passage."
                                            },
                                            {
                                                "example_id": "2e7553a4-fbfd-42b0-9919-cd70023feb8c",
                                                "sense_id": "0ebe903a-0128-3580-a0f5-9272f48a9633",
                                                "text": "Ce passage de pont appartient à la ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3210692b-2a92-3577-88cf-4c55ef00cc9e",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Somme qu’il faut payer pour un voyage sur mer, pour une traversée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec95394-5898-4b2e-bc34-702768b51f80",
                                                "sense_id": "3210692b-2a92-3577-88cf-4c55ef00cc9e",
                                                "text": "II avait donc décidé de s'embarquer pour l’Irlande, où il pleut plus qu'en Écosse ; mais comme il a un défaut de prononciation, on lui a donné à Leith un passage pour l’Islande."
                                            },
                                            {
                                                "example_id": "bfdcc0d4-fb74-4c53-9322-94b475d2c64f",
                                                "sense_id": "3210692b-2a92-3577-88cf-4c55ef00cc9e",
                                                "text": "Voici le passage et le billet de chemin de fer du prote que nous avons en vain attendu à la gare d’Orsay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68872214-6dbb-3cda-8f10-bd2028fb68c0",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Partie du texte d’un ouvrage, d'un article, d'un document, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcdd26af-e3fe-4488-aec0-1ec792f2bba7",
                                                "sense_id": "68872214-6dbb-3cda-8f10-bd2028fb68c0",
                                                "text": "Aristote n'a connu que le bras hectocotylisé des octopus, comme on peut s'en convaincre facilement par la lecture attentive des passages en question, mais il l'a connu fort exactement."
                                            },
                                            {
                                                "example_id": "630d1c1d-1246-4eb8-afb4-e91190a5a1c5",
                                                "sense_id": "68872214-6dbb-3cda-8f10-bd2028fb68c0",
                                                "text": "Revenons à l’œuvre de Stirner. Un des passages les plus remarquables de L’Unique et sa Propriété est celui où il définit la bourgeoisie par rapport aux déclassés."
                                            },
                                            {
                                                "example_id": "7c8a925d-9a0f-4bd1-921b-f94c4f801908",
                                                "sense_id": "68872214-6dbb-3cda-8f10-bd2028fb68c0",
                                                "text": "À cette occasion, il me revient à l’esprit certain passage de Marcel Schwob, cet admirable artiste qu’il est toujours précieux de relire […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87148997-1e39-3d6e-a306-448d09ab5efd",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Quelques mesures ou quelques phrases d’une œuvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb872140-6eff-48c5-86be-6b6ca0a59ae8",
                                                "sense_id": "87148997-1e39-3d6e-a306-448d09ab5efd",
                                                "text": "Cette position de retrait permet à Miles de dissimuler bon nombre de ratés dans les exposés et une certaine tendance à canarder dans les passages difficiles."
                                            },
                                            {
                                                "example_id": "347600d4-f834-4a73-814a-30705105bc9a",
                                                "sense_id": "87148997-1e39-3d6e-a306-448d09ab5efd",
                                                "text": "Au Bois, je fredonnais des phrases de la sonate de Vinteuil. Je ne souffrais plus beaucoup de penser qu’Albertine me l’avait tant de fois jouée, car presque tous mes souvenirs d’elle étaient entrés dans ce second état chimique où ils ne causent plus d’anxieuse oppression au cœur, mais de la douceur. Par moments, dans les passages qu’elle jouait le plus souvent, où elle avait l’habitude de faire telle réflexion qui me paraissait alors charmante, de suggérer telle réminiscence […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d9eb8e-9356-3f5b-855c-bae462c042c5",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Procédé de sous-culture de cellules animales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c1b5ba0-d8f0-3a25-8f8b-d488f83c896f",
                                        "entry_id": "d308b65b-4611-3d8a-be55-90b6eceaf42f",
                                        "glosses": [
                                            "Sorte d’allure lente du cheval."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9808186f-8b09-4e40-9b59-c18a82f509e7",
                                                "sense_id": "6c1b5ba0-d8f0-3a25-8f8b-d488f83c896f",
                                                "text": "Le passage ou passège est un pas écouté, rassemblé et relevé, qui a l’action du trot, quoique plus raccourci, et plus mesuré et aussi plus cadencé que le pas ordinaire."
                                            }
                                        ]
                                    }
                                ]
