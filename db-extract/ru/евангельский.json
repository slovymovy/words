                                "target_senses": [
                                    {
                                        "sense_id": "f091c7f4-8b27-394e-99e4-1ec8f759a114",
                                        "entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                                        "glosses": [
                                            "Pertaining to the doctrines or teachings of the Christian gospel or Christianity in general."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "664eb37b-30a6-3fdf-8579-4d0bd2580d9e",
                                        "entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                                        "glosses": [
                                            "Pertaining to the gospel(s) of the Christian New Testament."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5658844b-34d4-3518-846e-9b662cb95508",
                                        "entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                                        "glosses": [
                                            "Protestant; specifically Lutheran and Calvinist churches in continental Europe as well as their offshoots in North America."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14db5b59-da2b-372e-a9ed-ddb3f872dbab",
                                        "entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                                        "glosses": [
                                            "Pertaining to a movement in Protestant Christianity that stresses personal conversion and the authority of the Bible (evangelicalism)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c647a2e8-1858-48ec-a300-5c980dc62381",
                                                "sense_id": "14db5b59-da2b-372e-a9ed-ddb3f872dbab",
                                                "text": "“They wave their Bibles at passersby, screaming their condemnations,” writes Kurt Eichenwald of evangelical Christians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "291af922-59b9-3fb4-a4d7-e8c0fa0384d4",
                                        "entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                                        "glosses": [
                                            "Pertaining to Islamic groups that are dedicated to dawah and preaching the Quran and sunnah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfda4121-370f-4ecc-a155-641850097175",
                                                "sense_id": "291af922-59b9-3fb4-a4d7-e8c0fa0384d4",
                                                "text": "When the mosque came under the influence of an evangelical Muslim group (Jamaati Tableegh), the formerly congenial situation changed noticeably."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "620676b5-f367-3a32-a156-37eb2331bba3",
                                        "entry_id": "28baa021-4b92-3408-ad8f-5883eeb3bd7d",
                                        "glosses": [
                                            "Zealously enthusiastic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "evangelical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b60c92e3-fc33-373f-beaf-a2e4951d6881",
                                        "entry_id": "05b2b01e-0936-3637-ac3b-bf0708950593",
                                        "glosses": [
                                            "A member of an evangelical church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d7c2314-640a-493f-a6fc-d34d67542e7e",
                                                "sense_id": "b60c92e3-fc33-373f-beaf-a2e4951d6881",
                                                "text": "Furthermore, what would otherwise be good points about the sort of selective literalism that renders homosexuality an unpardonable sin but shrugs off Sarah Palin’s biblically forbidden pearl earrings are lost in Eichenwald’s assumption that evangelicals make these decisions “with less care than they exercise in selecting side orders for lunch.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26b2dffb-c704-3b1a-96ad-d3e7a60f19a3",
                                        "entry_id": "05b2b01e-0936-3637-ac3b-bf0708950593",
                                        "glosses": [
                                            "An advocate of evangelicalism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
