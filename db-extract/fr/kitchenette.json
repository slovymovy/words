        "fr-extract.jsonl": [
            {
                "entry_id": "81c727ba-59c0-357c-8fd3-d3609ea84fff",
                "word": "kitchenette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7da1acc-fc2d-499f-9602-0aa280fba7d1",
                        "entry_id": "81c727ba-59c0-357c-8fd3-d3609ea84fff",
                        "tags": [
                            "plural"
                        ],
                        "form": "kitchenettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02f9ea61-3293-3a50-9f7c-8cca328d5428",
                        "entry_id": "81c727ba-59c0-357c-8fd3-d3609ea84fff",
                        "glosses": [
                            "Cuisine de petites dimensions, équipée du strict nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b354256-26d5-478e-aa9e-b5ece73306cd",
                                "sense_id": "02f9ea61-3293-3a50-9f7c-8cca328d5428",
                                "text": "Tout ce sucre m’a donné soif. Je vais boire deux grands verres d’eau dans la kitchenette."
                            },
                            {
                                "example_id": "9015e389-a6f8-4b6d-8d64-811660588b9c",
                                "sense_id": "02f9ea61-3293-3a50-9f7c-8cca328d5428",
                                "text": "Ils sont entièrement équipés avec salle de bains et baignoire et une kitchenette ultra moderne avec plaques en vitrocéramique, micro-ondes, cafetière à dosettes, réfrigérateur et mini-lave-vaisselle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dac3ca53-1231-4522-93b1-2589b63c3e47",
                        "source_entry_id": "81c727ba-59c0-357c-8fd3-d3609ea84fff",
                        "source_sense_id": "02f9ea61-3293-3a50-9f7c-8cca328d5428",
                        "target_lang_word": "kitchenette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kitchenette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a476eaf3-99dd-3418-801b-33479fa7e7e6",
                                        "entry_id": "6a2f30cb-a3a4-3740-904e-c38fd5b1a5ee",
                                        "glosses": [
                                            "A small kitchen or area for preparing food, often just a part of a room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d317d2-37b1-439e-97d7-3748a01445b6",
                                                "sense_id": "a476eaf3-99dd-3418-801b-33479fa7e7e6",
                                                "text": "It is a kind of large cellar with a kitchenette and a bathroomette adjoining."
                                            },
                                            {
                                                "example_id": "0ea0c570-108f-412c-a712-9624933f6c3b",
                                                "sense_id": "a476eaf3-99dd-3418-801b-33479fa7e7e6",
                                                "text": "Rona disappeared into the little kitchenette and Nicol made a recce of the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25440c16-fa2c-4f13-b9a7-f041b3316fda",
                        "source_entry_id": "81c727ba-59c0-357c-8fd3-d3609ea84fff",
                        "source_sense_id": "02f9ea61-3293-3a50-9f7c-8cca328d5428",
                        "target_lang_word": "kitchenette",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kitchenette",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5221cac1-de49-3ae9-9a1f-c95fa4310225",
                                        "entry_id": "1f983cfe-b5dd-33f8-bc0a-a73649dee9da",
                                        "glosses": [
                                            "minikeuken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b1e6425-5092-4c91-8946-a0510251e000",
                                                "sense_id": "5221cac1-de49-3ae9-9a1f-c95fa4310225",
                                                "text": "Net als alle voorgaande modellen is ook deze jacht ontworpen door de Britse architect Tony Castro. Het sportjacht beschikt over twee volwaardige slaaphutten, een ruime salon en een kitchenette benedendeks. Op het achterdek bevindt zich nog een tweede kitchenette. Het interieur is modern afgewerkt."
                                            },
                                            {
                                                "example_id": "6727996b-5e3b-487b-8d25-2df018f41114",
                                                "sense_id": "5221cac1-de49-3ae9-9a1f-c95fa4310225",
                                                "text": "Menig expat, profvoetballer en interim-bestuurder heeft Hotel Hengelo als tijdelijk huis mogen beschouwen, met extra voorzieningen zoals een kitchenette, grotere koelkast en meer kastruimte dan op een normale hotelkamer."
                                            },
                                            {
                                                "example_id": "5482285d-df96-41b7-abd9-7abb8feae15a",
                                                "sense_id": "5221cac1-de49-3ae9-9a1f-c95fa4310225",
                                                "text": "Dankzij verschillende restauraties wordt Hof van Wouw gerekend tot één van de mooiste en meest authentiek hofjes van Den Haag waar je je voor even terug waant in de 17e eeuw. Gelukkig voor de bewoners is er binnenshuis in de loop van de tijd wel het één en ander veranderd. Waar tot 1904 de behoefte gedaan moest worden in twee hokken in de tuin, zijn er nu sanitaire voorzieningen in de huisjes en de bedsteden zijn vervangen door kitchenettes\", aldus Kammerlingh Onnes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
