                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ca0286c5-657f-3cac-a653-061b9aacf318",
                                        "entry_id": "21e730b0-d519-3f9a-bf0b-cdbc1ac8bb2a",
                                        "glosses": [
                                            "kupić od kogoś to, co ta osoba wcześniej kupiła dla siebie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f1d049-a6c0-4876-bf52-1fdf7e446cb9",
                                                "sense_id": "ca0286c5-657f-3cac-a653-061b9aacf318",
                                                "text": "Chcę odkupić od sąsiada kawałek działki, żeby poszerzyć sobie dojazd do głównej drogi."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7c37f14f-eb9b-3149-a0dd-1c059832475c",
                                        "entry_id": "21e730b0-d519-3f9a-bf0b-cdbc1ac8bb2a",
                                        "glosses": [
                                            "kupić od kogoś to, co już niegdyś należało do kupującego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e06444a-da04-44fd-af99-1b1f3a8d029f",
                                                "sense_id": "7c37f14f-eb9b-3149-a0dd-1c059832475c",
                                                "text": "Były właściciel może ziemię odkupić w drodze pierwszeństwa po cenie ustalonej przez rzeczoznawcę"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "ac561d3c-ca03-3fa2-abbc-5ed1bb6e18c7",
                                        "entry_id": "21e730b0-d519-3f9a-bf0b-cdbc1ac8bb2a",
                                        "glosses": [
                                            "zrekompensować komuś stratę, kupując mu przedmiot taki sam lub o podobnej wartości do zniszczonego czy zgubionego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09cdd36d-06e4-4bc2-8440-3a7d577d3cbc",
                                                "sense_id": "ac561d3c-ca03-3fa2-abbc-5ed1bb6e18c7",
                                                "text": "Kolejny wydatek. Pies pogryzł książkę, którą wypożyczyłam z biblioteki. Muszę odkupić nową."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "a9c24417-a80a-3c42-b277-23a2f3111993",
                                        "entry_id": "21e730b0-d519-3f9a-bf0b-cdbc1ac8bb2a",
                                        "glosses": [
                                            "wynagrodzić, odpokutować wyrządzoną przez siebie lub kogoś innego krzywdę czy zło"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c72c956-9bad-481e-8623-5bf93873cd33",
                                                "sense_id": "a9c24417-a80a-3c42-b277-23a2f3111993",
                                                "text": "Miało to im uświadomić, że najbardziej zatwardziały grzesznik ma możność odkupić swą winę, gdy publicznie wyrazi skruchę"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "b686a7d1-d8c4-3edc-a7c1-3063d95e4767",
                                        "entry_id": "21e730b0-d519-3f9a-bf0b-cdbc1ac8bb2a",
                                        "glosses": [
                                            "zbawić poprzez ofiarę z siebie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e6cf8fc-333e-4832-ab7c-f556702a1a61",
                                                "sense_id": "b686a7d1-d8c4-3edc-a7c1-3063d95e4767",
                                                "text": "Nie powiem, że człowiek jest to śmieszne bydlę, albowiem Pan nasz, Jezus Chrystus, odkupił go krwią swoją drogocenną"
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "odkupić",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "319031ed-16ca-3095-8a87-f7ae110556d1",
                                        "entry_id": "7bab8e8a-429c-3552-816a-0bc2cc84111a",
                                        "glosses": [
                                            "odpokutować, wynagrodzić wyrządzoną przez siebie krzywdę lub zło"
