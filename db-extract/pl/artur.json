                    {
                        "translation_id": "b98c35ae-b705-40e2-a4f9-84a473e8df46",
                        "source_entry_id": "ffd6b41e-aea9-3674-bfab-9668bcc54455",
                        "source_sense_id": "a88909d9-9a3a-3bcf-b550-12b77f569241",
                        "target_lang_word": "Arthur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arthur",
