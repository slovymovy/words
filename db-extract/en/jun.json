                "translations": [
                    {
                        "translation_id": "0b127079-813d-487d-a2ba-f27f5857665d",
                        "source_entry_id": "c96e7f2d-8a3b-38f1-bc98-77c772531e42",
                        "source_sense_id": "4a6ff339-c4bd-3840-9668-2778ed8fd45d",
                        "source_sense_description": "Abkürzung für: June (Juni)",
                        "target_lang_word": "Juni",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juni",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                        "entry_id": "fa7c9fd1-864b-3cf0-9eba-abf92010315c",
                                        "glosses": [
                                            "der sechste Monat im Jahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62f90539-b9e6-411b-9b1d-58c479b2f518",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "Der Juni folgt auf den Mai."
                                            },
                                            {
                                                "example_id": "aaa4314d-3419-4585-896e-d7a11e31055a",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "Jedes Jahr im Juni besuche ich ein Open-Air-Konzert."
                                            },
                                            {
                                                "example_id": "c42d7344-a4d9-4514-92ad-3c105ccd7777",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "„Wegen der Ausbreitung des Coronavirus wurde das Konzert von Alicia Keys in Hamburg im Juni 2020 abgesagt.“"
                                            },
                                            {
                                                "example_id": "a7eaf501-68c3-4111-83cb-d0e5282bb62d",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "„Am Broadway sorgt das Musical schon viele Jahre zuvor für Furore, bevor es im Juni 1978 in die Kinos kommt.“"
                                            },
                                            {
                                                "example_id": "b16cd899-f55e-4449-8842-3d834ca2070e",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "„Der Erlass des Gesetzes Ende Juni als Reaktion auf die seit einem Jahr anhaltenden Demonstrationen in Hongkong war international auf scharfe Kritik gestoßen.“"
                                            },
                                            {
                                                "example_id": "e0b8c984-c86b-4e33-975e-82c59450d79e",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "Anfang Juni werden wir in den Urlaub fahren."
                                            },
                                            {
                                                "example_id": "efa9d259-b683-4071-9560-e4d2f614bae7",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "„Die Sternkarte zeigt den Sternenhimmel, wie er Anfang Juni um ein Uhr nachts aussieht, zur Monatsmitte schon um Mitternacht und Ende Juni bereits um elf Uhr.“"
                                            },
                                            {
                                                "example_id": "1db1d487-54a7-44a8-bc16-10960a19f3e3",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "„Die 40 Quadratkilometer große Insel wird während des jährlichen Monsuns zwischen Juni und September regelmäßig überflutet […].“"
                                            },
                                            {
                                                "example_id": "0061bd19-73bd-47be-925e-4d9eb8706c0a",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "[Das Projekt läuft] „insgesamt vier Jahre bis Juni 2021.“"
                                            },
                                            {
                                                "example_id": "c3091c2f-3a60-428a-8a93-279f8da98908",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "[Zeitungen:] In der Ausgabe vom Juni zeigen wir ihnen die schönsten Grillrezepte."
                                            },
                                            {
                                                "example_id": "8264e8fb-8767-42f6-9b9d-8d52b3e36eba",
                                                "sense_id": "aa1c136b-84f2-381f-8485-064ce616d724",
                                                "text": "[Tourismus in der Coronapandemie:] „Es wird Juni, bis die ersten Hausgäste in die Pension Hus achtern Diek von Alina und Steffan Griebel kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
