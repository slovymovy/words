                        "glosses": [
                            "historische Entwicklung des Fußballspiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be292c9-2d36-4571-b26a-acd7fd9192b9",
                                "sense_id": "fe740b69-4ed2-30a9-b6e7-795d0f24223c",
                                "text": "Höhepunkte der Fußballgeschichte sind die Europa- und die Weltmeisterschaften."
                            },
                            {
                                "example_id": "c6674208-6ba2-4125-bdbd-e3e838059c10",
                                "sense_id": "fe740b69-4ed2-30a9-b6e7-795d0f24223c",
                                "text": "„Einer der frappierendsten Momente der Fußballgeschichte trug sich im Sommer 2006 im Finale der Weltmeisterschaft in Deutschland zu - als Folge eines Trashtalks, dessen Inhalt erst viel später öffentlich wurde.“"
                            },
                            {
                                "example_id": "7e278554-e8d0-461a-900e-12bbf96f7ce5",
                                "sense_id": "fe740b69-4ed2-30a9-b6e7-795d0f24223c",
                                "text": "„Die Weltmeisterschaft 1978 gilt als Sündenfall der Fußballgeschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe9bca84-fca3-3c6f-9231-ea2d3564e021",
                        "entry_id": "17c0a017-6cbd-379d-af9f-c7f68afda633",
                        "glosses": [
