                                        "entry_id": "65b01c01-a72d-34d6-95d5-ab5d75c225bb",
                                        "glosses": [
                                            "Taille des légumes en dés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c97b296-f002-4653-8869-6271eb039263",
                                                "sense_id": "3fbe0d91-d85f-3fec-a23c-59769fa0fad4",
                                                "text": "Utilisant la même technique que la brunoise et la macédoine, la mirepoix correspond à une taille de légumes en cubes de 1 à 1,5 cm de côté."
                                            }
                                        ]
                                    }
                                ]
