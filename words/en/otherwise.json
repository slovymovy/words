{
    "word_family": [
        "other"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b62cb072-5602-3c89-a6bb-5ed48294a86d",
                    "sense_definition": "Used to say what will happen if a specific condition is not met or if something is not done.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have to open your umbrella, <w>otherwise</w> you'll get wet.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно открыть зонт, <w>иначе</w> ты промокнешь.",
                                "zh": "你得撑开伞，<w>否则</w>你会淋湿的。"
                            }
                        },
                        {
                            "text": "Please hurry up, <w>otherwise</w> we will miss the train.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поторопись, <w>а не то</w> мы опоздаем на поезд.",
                                "zh": "请快点，<w>不然</w>我们要错过火车了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "else",
                        "if not"
                    ],
                    "common_phrases": [
                        "do it otherwise",
                        "unless otherwise noted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания того, что произойдет, если определенное условие не будет выполнено или действие не будет совершено.",
                        "zh": "用于说明如果某个条件未满足或某事未做将会发生什么。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иначе",
                                "target_lang_sense_clarification": "в противном случае"
                            },
                            {
                                "target_lang_word": "а не то",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否则",
                                "target_lang_sense_clarification": "在其他情况下"
                            },
                            {
                                "target_lang_word": "不然",
                                "target_lang_sense_clarification": "如果不这样"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                    "sense_definition": "In a different way or manner; differently.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You may have a point, but I think <w>otherwise</w>.",
                            "target_lang_translations": {
                                "ru": "Возможно, вы правы, но я думаю <w>иначе</w>.",
                                "zh": "你说的可能有道理，但我有<w>不同</w>的看法。"
                            }
                        },
                        {
                            "text": "It is not permitted to sell or <w>otherwise</w> distribute any copies of this book.",
                            "target_lang_translations": {
                                "ru": "Запрещается продавать или <w>иным образом</w> распространять любые копии этой книги.",
                                "zh": "禁止出售或<w>以其他方式</w>分发本书的任何副本。"
                            }
                        }
                    ],
                    "synonyms": [
                        "elsewise",
                        "contrarily",
                        "contrastingly"
                    ],
                    "antonyms": [
                        "likewise"
                    ],
                    "common_phrases": [
                        "think otherwise",
                        "suggest otherwise",
                        "stated otherwise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Другим способом или образом; по-другому.",
                        "zh": "以不同的方式或手段；不同地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иначе",
                                "target_lang_sense_clarification": "по-другому, иным способом"
                            },
                            {
                                "target_lang_word": "по-иному",
                                "target_lang_sense_clarification": "другим образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "另外",
                                "target_lang_sense_clarification": "以其他方式"
                            },
                            {
                                "target_lang_word": "以其他方式",
                                "target_lang_sense_clarification": "用不同的手段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "189f398f-6c85-3486-b669-8b94cba6cf50",
                    "sense_definition": "Except for the thing just mentioned; in all other respects.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost his temper once in a while, but <w>otherwise</w> he behaved rationally.",
                            "target_lang_translations": {
                                "ru": "Время от времени он выходил из себя, но <w>в остальном</w> вел себя рационально.",
                                "zh": "他偶尔会发脾气，但<w>在其他方面</w>表现得很理智。"
                            }
                        },
                        {
                            "text": "There was one rotten apple in an <w>otherwise</w> perfect batch.",
                            "target_lang_translations": {
                                "ru": "В этой <w>в остальном</w> идеальной партии было одно гнилое яблоко.",
                                "zh": "在<w>其余</w>都很完美的一批苹果中，有一个烂苹果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apart from that"
                    ],
                    "common_phrases": [
                        "an otherwise perfect",
                        "but otherwise fine"
                    ],
                    "target_lang_definitions": {
                        "ru": "За исключением только что упомянутого; во всех остальных отношениях.",
                        "zh": "除了刚才提到的事物之外；在所有其他方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в остальном",
                                "target_lang_sense_clarification": "во всех других отношениях"
                            },
                            {
                                "target_lang_word": "в других отношениях",
                                "target_lang_sense_clarification": "кроме указанного"
                            },
                            {
                                "target_lang_word": "впрочем",
                                "target_lang_sense_clarification": "устаревающее значение 'в остальном'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在其他方面",
                                "target_lang_sense_clarification": "除了提到的那一点外"
                            },
                            {
                                "target_lang_word": "其余",
                                "target_lang_sense_clarification": "剩下的部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24a8db84-800c-3f5e-944a-21f8a5b9ac53",
                    "sense_definition": "Being different from what has been mentioned or supposed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He said he didn’t do it, but the evidence was <w>otherwise</w>.",
                            "target_lang_translations": {
                                "ru": "Он сказал, что не делал этого, но улики говорили об <w>обратном</w>.",
                                "zh": "他说他没做，但证据却表明<w>相反</w>的情况。"
                            }
                        },
                        {
                            "text": "Statistics need lots of information, digital and <w>otherwise</w>.",
                            "target_lang_translations": {
                                "ru": "Для статистики нужно много информации, цифровой и <w>другой</w>.",
                                "zh": "统计数据需要大量信息，无论是数字形式的还是<w>其他</w>形式的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital and otherwise",
                        "legal or otherwise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличающийся от того, что было упомянуто или предположено.",
                        "zh": "与所提到或假设的情况不同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иной",
                                "target_lang_sense_clarification": "другой, отличный от упомянутого"
                            },
                            {
                                "target_lang_word": "другой",
                                "target_lang_sense_clarification": "противоположный или отличный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相反",
                                "target_lang_sense_clarification": "与事实相反"
                            },
                            {
                                "target_lang_word": "其他",
                                "target_lang_sense_clarification": "不同于上述的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}