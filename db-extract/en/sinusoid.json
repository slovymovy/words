                    {
                        "sense_id": "cea98459-376c-34c8-8653-996f758b1315",
                        "entry_id": "ad43a8d5-2307-3c6f-933a-172ac2761d8a",
                        "glosses": [
                            "Any of several channels through which venous blood passes in various organs."
                        ],
                        "tags": [],
                        "examples": [
