                                            {
                                                "example_id": "76b6d8bd-9627-415d-af8a-453c40fd1aab",
                                                "sense_id": "945e7808-8d8d-3d31-88dd-b5d915d43831",
                                                "text": "Das Geschäft befindet sich in der Stuttgarter Stadtmitte."
                                            }
