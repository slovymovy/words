        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1db324af-711e-34a9-9898-b716bea16151",
                "word": "promptitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cb1dc41a-c71e-4c3b-9c29-00ba196ca1f8",
                        "entry_id": "1db324af-711e-34a9-9898-b716bea16151",
                        "tags": [
                            "plural"
