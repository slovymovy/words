                                "target_senses": [
                                    {
                                        "sense_id": "3b2952db-1094-3559-95f0-254b6270a4c3",
                                        "entry_id": "26b658e0-4714-3efa-8101-d6d94ada156d",
                                        "glosses": [
                                            "Plisser en contractant, en resserrant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d587658e-6544-4efe-95fc-18d3b504bb0d",
                                                "sense_id": "3b2952db-1094-3559-95f0-254b6270a4c3",
                                                "text": "Froncer le sourcil, les sourcils."
                                            },
                                            {
                                                "example_id": "11a26158-dc8f-42ae-936a-26668d702f8e",
                                                "sense_id": "3b2952db-1094-3559-95f0-254b6270a4c3",
                                                "text": "Il en fronça le sourcil de chagrin, de colère."
                                            },
                                            {
                                                "example_id": "a595419f-016e-46e1-9263-cd980fe9678f",
                                                "sense_id": "3b2952db-1094-3559-95f0-254b6270a4c3",
                                                "text": "Elle fronçait le nez pour saisir le sens de ce Français écarlate qui parlait si vite."
                                            },
                                            {
                                                "example_id": "82ccaf8b-7613-41cc-90cd-678f3f12166c",
                                                "sense_id": "3b2952db-1094-3559-95f0-254b6270a4c3",
                                                "text": "Les chiens, attachés pour la route, fronçaient encore leurs babines en arrêt, comme s’ils s’apprêtaient à s’élancer de nouveau dans les taillis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4437d1-98b0-33fd-8fe1-89955f23794c",
                                        "entry_id": "26b658e0-4714-3efa-8101-d6d94ada156d",
                                        "glosses": [
                                            "Plisser une étoffe, du linge de plis menus et serrés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad742efd-7dde-4de8-8b68-5525231c7e55",
                                                "sense_id": "5d4437d1-98b0-33fd-8fe1-89955f23794c",
                                                "text": "Puis, les coutures des bas, légèrement froncées, comme de longues chenilles et les creux articulés de l'attache des genoux."
                                            },
                                            {
                                                "example_id": "8c04fdbd-6caa-4b41-a8db-a32f1131d296",
                                                "sense_id": "5d4437d1-98b0-33fd-8fe1-89955f23794c",
                                                "text": "Froncer le devant d’une chemise."
                                            },
                                            {
                                                "example_id": "9306a37b-1ac1-4d90-aa33-604f9ac7791e",
                                                "sense_id": "5d4437d1-98b0-33fd-8fe1-89955f23794c",
                                                "text": "Froncer des poignets. — Froncer une jupe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
