                {
                    "sense_id": "7f407416-cb8f-36d3-bf1c-5582542d57a8",
                    "sense_definition": "A long, thin piece of land or a specific narrow area.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The countries were in dispute over the ownership of a <w>strip</w> of desert about 100 metres wide.",
                            "target_lang_translations": {
                                "ru": "Страны спорили из-за права собственности на <w>полосу</w> пустыни шириной около 100 метров.",
                                "zh": "这些国家因争夺一片约100米宽的沙漠<w>地带</w>的所有权而发生纠纷。"
                            }
                        },
                        {
                            "text": "A narrow <w>strip</w> of land connects the peninsula to the mainland.",
                            "target_lang_translations": {
                                "ru": "Узкая <w>полоска</w> земли соединяет полуостров с материком.",
                                "zh": "一条狭长的<w>地带</w>将半岛与大陆连接起来。"
                            }
                        }
                    ],
                    "common_phrases": [
