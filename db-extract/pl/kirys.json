                                        "glosses": [
                                            "A piece of armor that covers the chest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7280b2fe-4922-3903-9bef-4ac821a56734",
                                        "entry_id": "cca35639-4f9b-388f-a705-b4bb60cc8d8f",
                                        "glosses": [
                                            "A piece of armor that covers the torso; a cuirass, the breast- (front) and back-plate, taken together as a unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd320495-73f0-441b-a068-6f0dd9c709ff",
                                                "sense_id": "7280b2fe-4922-3903-9bef-4ac821a56734",
                                                "text": "He wears a Thracian-style helmet that protects most of his head and face, and a breastplate or \"cuirass\" covering his back and chest, both made of bronze."
                                            },
                                            {
                                                "example_id": "6138c169-d0f9-49a3-8906-3516d83e0a73",
                                                "sense_id": "7280b2fe-4922-3903-9bef-4ac821a56734",
                                                "text": "A massive hand grabbed the back of his breastplate and pulled him back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbcfba66-b83a-3b54-bab8-cf61d1386803",
                                        "entry_id": "cca35639-4f9b-388f-a705-b4bb60cc8d8f",
                                        "glosses": [
                                            "A piece of horse tack designed to prevent the saddle slipping backwards."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d07e9f1b-6de5-31f5-a53c-6d12dad29f65",
                                        "entry_id": "cca35639-4f9b-388f-a705-b4bb60cc8d8f",
                                        "glosses": [
                                            "A piece of silicone in the shape of women's breasts worn by drag queens and other female impersonators to simulate a female body shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dedae24a-ac45-3ff5-830b-37aa49b0f764",
                                        "entry_id": "cca35639-4f9b-388f-a705-b4bb60cc8d8f",
                                        "glosses": [
                                            "An embroidered square of linen worn on the breast of the Jewish high priest, bearing twelve precious stones, each inscribed with the name of one of the tribes of Israel."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c11e4aed-1c55-4fdb-8b5c-bc4609e844de",
                        "source_entry_id": "ff2d48c3-4306-3cf5-b1b1-13c0f25a70a0",
                        "source_sense_id": "eb30a4da-db69-344c-af60-0d770a4f96e6",
