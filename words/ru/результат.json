    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6de0c87-9901-3903-a0d4-64ff694b568c",
                    "sense_definition": "То, что получилось по завершении какого-либо действия или процесса; конечный итог, следствие.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот эксперимент дал неожиданный <w>результат</w>.",
                            "target_lang_translations": {
                                "en": "This experiment yielded an unexpected <w>result</w>.",
                                "zh": "这项实验得出了一个意想不到的<w>结果</w>。"
                            }
                        },
                        {
                            "text": "В <w>результате</w> долгих переговоров стороны подписали важный контракт.",
                            "target_lang_translations": {
                                "en": "As a <w>result</w> of long negotiations, the parties signed an important contract.",
                                "zh": "<w>经过</w>长时间的谈判，双方签署了一份重要合同。"
                            }
                        },
                        {
                            "text": "Мы надеемся на положительный <w>результат</w> нашей работы.",
                            "target_lang_translations": {
                                "en": "We hope for a positive <w>result</w> from our work.",
                                "zh": "我们希望我们的工作能取得积极的<w>成果</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "итог",
                        "следствие",
                        "последствие",
                        "исход",
                        "плод",
                        "продукт"
                    ],
                    "antonyms": [
                        "предпосылка"
                    ],
                    "common_phrases": [
                        "в результате",
                        "дать результат",
                        "положительный результат",
                        "конечный результат",
                        "без результата"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that happens or exists because of something else; the final consequence of an action or process.",
                        "zh": "某项行动或过程结束后所产生的情况；最终的后果或结论。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "result",
                                "target_lang_sense_clarification": "general consequence"
                            },
                            {
