                                "target_senses": [
                                    {
                                        "sense_id": "c7c5742d-8944-3eac-8d2d-c9391ba3a887",
                                        "entry_id": "77666021-de68-3fce-8620-438239442f6b",
                                        "glosses": [
                                            "The act of imposing taxes and the fact of being taxed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb1c9f44-c392-4f4f-8d20-e77cd65f5bc5",
                                                "sense_id": "c7c5742d-8944-3eac-8d2d-c9391ba3a887",
                                                "text": "Some of this will be down to breakthrough science and technology, breakthrough business models and breakthroughs in behaviour change, but we also need an intensifying focus on public policy, in areas like accounting, reporting and taxation, the last spotlighted by Shaxson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132af971-459b-363a-b2ce-8eb4ed142acf",
                                        "entry_id": "77666021-de68-3fce-8620-438239442f6b",
                                        "glosses": [
                                            "A particular system of taxing people or companies"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99e4ec1d-f5d8-33db-99ee-2292fa42e4b0",
                                        "entry_id": "77666021-de68-3fce-8620-438239442f6b",
                                        "glosses": [
                                            "The revenue gained from taxes"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dbdf43c-bc7c-411e-9a7c-fba4001c45d4",
                        "source_entry_id": "18b83917-a8b9-35a8-b03d-7fad54c01755",
                        "target_lang_word": "Besteuerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besteuerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                        "entry_id": "2fcc90e8-7d45-33b4-8e27-7c4d52142a0f",
                                        "glosses": [
                                            "das Erheben von Steuern für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e0fd3c-26b7-4bbe-8a91-62e10b74d268",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Betrugsanfällig bleibt der Handel mit den CO₂-Verschmutzungsrechten trotzdem — weil die Besteuerung EU-weit nach wie vor nicht einheitlich geregelt ist.“"
                                            },
                                            {
                                                "example_id": "bc531dea-666f-4db7-91fc-f31a563aa73a",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Für Ricardo besteht die einzige logisch und politisch befriedigende Lösung in einer immer höheren Besteuerung der Bodenrente.“"
                                            },
                                            {
                                                "example_id": "ef64baed-14c2-4d5e-a400-cd8c3d9ee7e5",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Sie forderten deshalb eine höhere Besteuerung und eine Verstaatlichung des Abbaus.“"
                                            },
                                            {
                                                "example_id": "498cd2d4-d50e-4a02-ba41-2b31d937e50b",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Die Münzverrufung brachte dem Münzherren einen Gewinn, dem Münzbesitzer aber einen realen Verlust und stellte gleichsam eine Form indirekter Besteuerung dar.“"
                                            },
                                            {
                                                "example_id": "13ba2880-a87f-42c8-b20a-421a4515ecce",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Das erschwerte ihre Besteuerung, so dass man einen Judenpfennig erhob, und zwar abweichend von der üblichen Praxis auf jedes einzelne Mitglied der Familie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f3a9990-b3ca-41b2-89aa-52be264e44da",
                        "source_entry_id": "18b83917-a8b9-35a8-b03d-7fad54c01755",
                        "target_lang_word": "taxation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "298e9b97-aa91-339e-a6d9-6e2aa32b06d4",
                                        "entry_id": "5b5d224b-f3e6-322a-bd5e-14079c838eab",
                                        "glosses": [
                                            "Action de taxer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612c08ae-f617-4394-aef0-bdbfd346974b",
                                                "sense_id": "298e9b97-aa91-339e-a6d9-6e2aa32b06d4",
                                                "text": "La taxation d’une denrée."
                                            },
                                            {
                                                "example_id": "d617c49c-b5e2-4b69-8790-216cb1ab52b5",
                                                "sense_id": "298e9b97-aa91-339e-a6d9-6e2aa32b06d4",
                                                "text": "La taxation de ce paquet est trop forte."
                                            },
                                            {
                                                "example_id": "eac869a0-7189-468e-a322-71abe480a79f",
                                                "sense_id": "298e9b97-aa91-339e-a6d9-6e2aa32b06d4",
                                                "text": "La taxation des frais d’un procès."
                                            },
                                            {
                                                "example_id": "f90c833f-ae5d-41b7-bd21-dc35749c50a1",
                                                "sense_id": "298e9b97-aa91-339e-a6d9-6e2aa32b06d4",
                                                "text": "Il faut savoir que la grande cause de la révolte des colonies américaines en 1775 avait été la taxation des colons pour payer les coûts énormes de la conquête du Canada, effectuée par les troupes britanniques de 1754 à 1763 pour protéger les territoires américains contre les incursions des Français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
