                        "source_sense_id": "43296334-a12b-3b79-bc51-00a6b74ae8b9",
                        "target_lang_word": "compact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bd49805-8093-3f63-b621-c8b4e67854ca",
                                        "entry_id": "dadad563-66d8-3b15-850a-5c9e39eead9c",
                                        "glosses": [
                                            "An agreement or contract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4770901b-9081-48f2-9592-c952240a04ae",
                                                "sense_id": "0bd49805-8093-3f63-b621-c8b4e67854ca",
                                                "text": "President Biden laid out an ambitious agenda on Wednesday night to rewrite the American social compact by vastly expanding family leave, child care, health care, preschool and college education for millions of people to be financed with increased taxes on the wealthiest earners."
                                            },
                                            {
                                                "example_id": "27e19cd3-d549-41b8-89aa-b3bf035df4bf",
                                                "sense_id": "0bd49805-8093-3f63-b621-c8b4e67854ca",
                                                "text": "After taking over this month as president of the U.S. Conference of Mayors, a nonpartisan coalition of city mayors, he urged members to sign a “crypto compact” calling on the federal government to eschew overly aggressive regulation of the industry."
                                            },
                                            {
                                                "example_id": "2b87b7f7-989f-4bbd-be41-bbb726d5d46f",
                                                "sense_id": "0bd49805-8093-3f63-b621-c8b4e67854ca",
                                                "text": "Countering this in international media by offering more balanced views for a global audience is near impossible as censorship is rife. There almost seems to be a global compact to control the narrative, a propaganda war powered by today’s digital technology."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "228cdbb4-e7bf-3735-aa51-9cf12dec1132",
                                        "entry_id": "1d2b221f-d8a5-338e-8dd6-bab0f1771752",
                                        "glosses": [
                                            "To form an agreement or contract."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6b9c15-a7db-4d5b-8935-c6709a5d653a",
                                                "sense_id": "228cdbb4-e7bf-3735-aa51-9cf12dec1132",
                                                "text": "In return for the sovereign's protection, they compacted to police the content of public literature."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "836a1b35-ecc0-3703-aa1a-9834b0a93917",
                                        "entry_id": "58542b4f-f819-3240-a08b-96345837036f",
                                        "glosses": [
                                            "Agreed, contracted."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe3a9869-78b5-444d-bc02-67666d9f4dce",
                                                "sense_id": "836a1b35-ecc0-3703-aa1a-9834b0a93917",
                                                "text": "O Gorice XI., most glorious King of Witchland, and O Lord Goldry Bluszco, captain of the hosts of Demonland, it is compact betwixt you, and made fast by mighty oaths whereof I, the Red Foliot, am keeper, that ye shall wrastle three falls together on these conditions, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e294fc40-ab6b-32f1-a4f6-686468504dcf",
                                        "entry_id": "5b637d60-c6a4-3f08-ba5f-5ba07128fbea",
                                        "glosses": [
                                            "Closely packed or densely constituted; having much material in a small volume."
                                        ],
                                        "tags": [],
                                        "examples": [
