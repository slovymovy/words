                ],
                "senses": [
                    {
                        "sense_id": "183d18df-dbd0-3951-98e8-2c3ac1560e2e",
                        "entry_id": "ab5865e5-be42-3c0b-8203-563fdab216ba",
                        "glosses": [
                            "Deutsches Mittelgebirge: abgegrenzt durch die Flüsse Rhein im Westen, die Sieg im Norden, im Süden die Lahn und im Osten die Dill, ein Nebenfluss der Lahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f554d92c-856d-41f5-a753-65b922391793",
                                "sense_id": "183d18df-dbd0-3951-98e8-2c3ac1560e2e",
                                "text": "Der Westerwald ist geologisch ein Teil des Rheinischen Schiefergebirges."
                            },
                            {
                                "example_id": "e696efed-30ac-48e6-9c75-44fefc9e068c",
                                "sense_id": "183d18df-dbd0-3951-98e8-2c3ac1560e2e",
                                "text": "„»Die Kirsche reift daselbst nicht mehr …«, dieses einem Bannfluch gleichkommende Wort über den Westerwald fand sich im Konversationslexikon der Großeltern. … Gewiß, bei genauerem Lesen gab das Lexikon preis, dies gelte nur für Höhenlagen über 480 Meter. Aber davon gibt es im Westerwald nicht wenige … Mußte es dort dem Dasein nicht einfach an Fülle mangeln?“"
                            },
                            {
                                "example_id": "0fd3882a-2313-4d0b-8bb0-bba4eee1c813",
                                "sense_id": "183d18df-dbd0-3951-98e8-2c3ac1560e2e",
                                "text": "„Oh, du schöner Westerwald, über deinen Höhen pfeift der Wind so kalt …“ (Refrain des Westerwaldliedes)"
                            },
                            {
                                "example_id": "2dfad90d-cf13-4701-9682-2e05c64a8c33",
                                "sense_id": "183d18df-dbd0-3951-98e8-2c3ac1560e2e",
                                "text": "Im Westerwald gibt es nördlich der Lahn „beträchtliche Tonvorkommen. Zentrum der hierauf fußenden Keramikindustrie ist Höhr-Grenzhausen im sogenannten Kannebäckerland.“ (aus: Merian: Der Westerwald, Heft 5 / XXI (Mai 1968), Seite 97)"
                            },
                            {
                                "example_id": "3dbab425-5ad9-4fd3-b45b-001b8ba2f58a",
                                "sense_id": "183d18df-dbd0-3951-98e8-2c3ac1560e2e",
                                "text": "„Ich war schon in der Sekunda so alt wie der Westerwald.“ (Zitat von Thomas Mann)"
                            },
                            {
                                "example_id": "16a70c64-3c77-459e-845a-92b3bb9bc76b",
                                "sense_id": "183d18df-dbd0-3951-98e8-2c3ac1560e2e",
                                "text": "„Meine Eltern kamen aus einem kleinen Ort den nördlichen Westerwaldes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9edb2a33-f4a8-3853-9d4d-c46601d67f78",
                        "entry_id": "ab5865e5-be42-3c0b-8203-563fdab216ba",
                        "glosses": [
                            "Waldgebiet im Obereichsfeld (Thüringen), nahe der Stadt Heilbad Heiligenstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b9b01e7-b03c-4071-927b-7c19bd837696",
                                "sense_id": "9edb2a33-f4a8-3853-9d4d-c46601d67f78",
                                "text": "Ein Waldgebiet im Obereichsfeld heißt ebenfalls Westerwald."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
