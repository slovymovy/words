                                        "sense_id": "d0c23e1f-ee85-3dbc-9576-86e552b7e2f8",
                                        "entry_id": "c0fce9c3-3936-3344-b437-eb8cfb1b8467",
                                        "glosses": [
                                            "Synonym of vitrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab2b3d3-649d-43c6-a162-4911c3bbdf82",
                                                "sense_id": "d0c23e1f-ee85-3dbc-9576-86e552b7e2f8",
                                                "text": "In Osaka, the big action scenes take place with arrows as well as swords, amid glass display cases holding samurai costumes, a classic Wick setting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e57c913d-20d4-4aaf-a209-11818eba456a",
                        "source_entry_id": "4db7c540-2b8c-39e8-8103-6e27f14a0449",
                        "source_sense_id": "9ff8259f-534d-3920-9cb2-823e0e19a10e",
                        "target_lang_word": "shop window",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shop window",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cff0c86c-fcfb-3532-a6b2-29bf9e6658bd",
                                        "entry_id": "afbc59ac-7ed5-331f-9383-8ed8bf9b7937",
                                        "glosses": [
                                            "A large window at the front of a shop, behind which items for sale are displayed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6908e088-1207-4ff1-b738-0ffc866f1e5d",
                                                "sense_id": "cff0c86c-fcfb-3532-a6b2-29bf9e6658bd",
                                                "text": "The passenger carriage was recognised as one of the \"shop windows\" of the railways and thus an essential element in the important work of achieving a greatly improved public image."
                                            },
                                            {
                                                "example_id": "45b86001-d1d5-411a-ad79-f330780c80e0",
                                                "sense_id": "cff0c86c-fcfb-3532-a6b2-29bf9e6658bd",
                                                "text": "The enthusiasm with which the private industry has treated the high speed rail concept can do the Corporation some good, and maybe even encourage the completion of the originally proposed electrification from New Haven to Boston. It will then have a high speed 'shop window', comparable with any in the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
