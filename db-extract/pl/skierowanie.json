                "senses": [
                    {
                        "sense_id": "1fbd008f-e538-3974-a075-dddfd735566b",
                        "entry_id": "1f1f6cf1-5423-3668-9e63-3e739c16fdda",
                        "glosses": [
                            "rodzaj pisemnego polecenia przyjęcia kogoś przez określoną placówkę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb28ffd2-acc8-4884-8dc9-02a38d45fe3d",
                                "sense_id": "1fbd008f-e538-3974-a075-dddfd735566b",
                                "text": "Dostałem skierowanie do sanatorium rehabilitacji onkologicznej."
                            },
                            {
                                "example_id": "08d5d48d-ea23-4da1-9f45-d117073d0948",
                                "sense_id": "1fbd008f-e538-3974-a075-dddfd735566b",
                                "text": "Po chwili miałem skierowanie do urologa."
                            },
                            {
                                "example_id": "02d2aaed-0a22-4624-9d86-bd10a4d679bb",
                                "sense_id": "1fbd008f-e538-3974-a075-dddfd735566b",
                                "text": "Dość częstym błędem … jest pomijanie w skierowaniach na badania lekarskie czynności pracy na wysokości powyżej 1 m."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6874ff94-896a-3655-9b77-4a1be636b0be",
                        "entry_id": "1f1f6cf1-5423-3668-9e63-3e739c16fdda",
                        "glosses": [
                            "rzecz. odczas. od skierować"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007fdfbd-3fdb-4880-8f43-1417f6a84a83",
                                "sense_id": "6874ff94-896a-3655-9b77-4a1be636b0be",
                                "text": "Z powodu skierowania do pracy za granicą, pracownik dostał ekwiwalent pieniężny za niewykorzystany urlop."
                            },
                            {
                                "example_id": "d7d3b934-9619-4322-96c8-fd00e398dfea",
                                "sense_id": "6874ff94-896a-3655-9b77-4a1be636b0be",
                                "text": "Sąd zdecydował o skierowaniu go na przymusowe leczenie."
                            },
                            {
                                "example_id": "5fa3c34e-4f07-41cf-841a-d7c24cf2562c",
                                "sense_id": "6874ff94-896a-3655-9b77-4a1be636b0be",
                                "text": "Dobra głowica panoramiczna i stabilny statyw umożliwiają precyzyjne skierowanie lunety na wybrany obiekt oraz dokładne ustawienie ostrości."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96e9ce44-4d65-42c4-bcc1-2fc896cacc70",
                        "source_entry_id": "1f1f6cf1-5423-3668-9e63-3e739c16fdda",
                        "source_sense_id": "1fbd008f-e538-3974-a075-dddfd735566b",
