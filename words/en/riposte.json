{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39ef7dbf-7214-37f2-b623-ca8affcf2c6b",
                    "sense_definition": "A quick and usually witty or sharp response to a remark or criticism.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_retort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She delivered a sharp <w>riposte</w> that left her opponent completely speechless.",
                            "target_lang_translations": {
                                "zh": "她做出了尖锐的<w>反驳</w>，让对手哑口无言。"
                            }
                        },
                        {
                            "text": "His clever <w>riposte</w> quickly defused the tension in the crowded room.",
                            "target_lang_translations": {
                                "zh": "他巧妙的<w>妙语回击</w>迅速化解了拥挤房间里的紧张气氛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retort"
                    ],
                    "common_phrases": [
                        "sharp riposte",
                        "witty riposte",
                        "swift riposte"
                    ],
                    "target_lang_definitions": {
                        "zh": "（对批评或评论的）机敏反驳，尖锐回击"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反驳",
                                "target_lang_sense_clarification": "指机敏、尖锐的言语回击"
                            },
                            {
                                "target_lang_word": "妙语回击",
                                "target_lang_sense_clarification": "指风趣敏捷的回答"
                            },
                            {
                                "target_lang_word": "回击",
                                "target_lang_sense_clarification": "言语上的反击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d846328b-4e1e-3b41-be42-1c29f489e973",
                    "sense_definition": "A rapid answer or reply to a question, problem, or action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbal_retort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company issued a formal statement as a prompt <w>riposte</w> to the allegations.",
                            "target_lang_translations": {
                                "zh": "该公司发表了一份正式声明，作为对这些指控的迅速<w>回应</w>。"
                            }
                        },
                        {
                            "text": "Her immediate <w>riposte</w> showed that she had anticipated the difficult question.",
                            "target_lang_translations": {
                                "zh": "她立即做出的<w>答复</w>表明她早已料到这个棘手的问题。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（对问题、指控或行动的）迅速应对，快速回应"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "回应",
                                "target_lang_sense_clarification": "对行动或提问的反应"
                            },
                            {
                                "target_lang_word": "答复",
                                "target_lang_sense_clarification": "快速的回答或表态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22c8f44b-05d2-36e8-9754-d554a7af083a",
                    "sense_definition": "A retaliatory move or counterattack in a fight, sport, or competition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "combat_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The visiting football team staged a swift <w>riposte</w> by scoring immediately after halftime.",
                            "target_lang_translations": {
                                "zh": "客场足球队在半场结束后立即进球，发动了迅速的<w>反击</w>。"
                            }
                        },
                        {
                            "text": "The army launched an unexpected <w>riposte</w> against the advancing enemy troops.",
                            "target_lang_translations": {
                                "zh": "军队对推进中的敌军发起了出其不意的<w>还击</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（战斗、比赛或对抗中的）反击，回击行动"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反击",
                                "target_lang_sense_clarification": "战斗或竞技中的还击"
                            },
                            {
                                "target_lang_word": "还击",
                                "target_lang_sense_clarification": "对敌方行动的报复性打击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7848e3cb-34fb-3daf-8543-4cebbfffbd8d",
                    "sense_definition": "In fencing, a return thrust delivered immediately after parrying an opponent's attack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "combat_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fencer blocked the incoming blade and executed a perfect <w>riposte</w> to score a point.",
                            "target_lang_translations": {
                                "zh": "击剑手挡开了迎面而来的剑，随后完成了一记漂亮的<w>还击</w>得分。"
                            }
                        },
                        {
                            "text": "Mastering the timing of the <w>riposte</w> takes years of dedicated practice.",
                            "target_lang_translations": {
                                "zh": "掌握<w>还击</w>的时机需要多年的刻苦练习。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "击剑运动中防守后的还击刺击动作"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "还击",
                                "target_lang_sense_clarification": "击剑术语，指防守后的反攻"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10dc0b7b-a8db-3047-8789-99e4ef6cf7a6",
                    "sense_definition": "To respond quickly, sharply, or wittily to a statement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbal_retort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked if she was nervous, she <w>riposted</w> that she was born ready.",
                            "target_lang_translations": {
                                "zh": "被问及是否紧张时，她<w>反驳</w>说自己生来就准备好了。"
                            }
                        },
                        {
                            "text": "He took a moment before he <w>riposted</w> with a sarcastic smile.",
                            "target_lang_translations": {
                                "zh": "他顿了一下，随即带着讽刺的微笑<w>回敬</w>道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retort"
                    ],
                    "target_lang_definitions": {
                        "zh": "机敏或尖锐地反驳，回敬"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反驳",
                                "target_lang_sense_clarification": "言辞敏捷地回击"
                            },
                            {
                                "target_lang_word": "回敬",
                                "target_lang_sense_clarification": "用言语予以回应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "732b0c57-78da-3f73-8be1-06d67e7b0ba4",
                    "sense_definition": "In fencing, to execute a return thrust immediately after successfully parrying an opponent's blade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "combat_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She parried the thrust smoothly and instantly <w>riposted</w> against her opponent.",
                            "target_lang_translations": {
                                "zh": "她流畅地挡开直刺，并立即向对手<w>还击</w>。"
                            }
                        },
                        {
                            "text": "A skilled swordsman must learn how to parry and <w>riposte</w> in a single fluid movement.",
                            "target_lang_translations": {
                                "zh": "熟练的剑客必须学会如何一气呵成地格挡与<w>还击</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（击剑中）防守后迅速还击"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "还击",
                                "target_lang_sense_clarification": "击剑中防守后出剑"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}