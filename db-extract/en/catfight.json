{
    "word": "catfight",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0d9fcfdd-06c6-31b4-a561-b3710f493621",
                "word": "catfight",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "342793fc-5dcb-4b8a-8920-b35e82ef39e9",
                        "entry_id": "0d9fcfdd-06c6-31b4-a561-b3710f493621",
                        "tags": [
                            "plural"
                        ],
                        "form": "catfights"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f739ec12-70cc-3ac9-87a8-018aeadfcaf0",
                        "entry_id": "0d9fcfdd-06c6-31b4-a561-b3710f493621",
                        "glosses": [
                            "A fight between cats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e282e9-87c7-41b4-970f-5c2c6596f990",
                                "sense_id": "f739ec12-70cc-3ac9-87a8-018aeadfcaf0",
                                "text": "The caterwauling from the catfight in the back yard was awful; I couldn't get to sleep until it was over."
                            }
                        ]
                    },
                    {
                        "sense_id": "028d8170-d59d-3d93-af52-201d23effc02",
                        "entry_id": "0d9fcfdd-06c6-31b4-a561-b3710f493621",
                        "glosses": [
                            "A fight or bickering, especially between women."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "81e0a6e4-2aea-4c66-8857-386199b79105",
                                "sense_id": "028d8170-d59d-3d93-af52-201d23effc02",
                                "text": "Nancy and Sheila got into a catfight when Nancy's boyfriend cheated on her with Sheila."
                            },
                            {
                                "example_id": "f99e6a67-e66e-4fe2-93a5-f04a354fcc2c",
                                "sense_id": "028d8170-d59d-3d93-af52-201d23effc02",
                                "text": "Female conflict, seen in this kind of structure, works conveniently—it takes note of aggression in women and sets it against other women. Men are spared. The audience applauds. Everyone loves a catfight."
                            },
                            {
                                "example_id": "74ceeb54-8d04-4aa7-a050-cf416c15c141",
                                "sense_id": "028d8170-d59d-3d93-af52-201d23effc02",
                                "text": "There was a time when I would get furious and fire off an angry note if someone cast me in a catfight with a woman colleague. I assumed that catfights would fade as women progressed. They seemed so retro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e24ff2d-a350-40aa-a9e1-6e3ed4a57256",
                        "source_entry_id": "0d9fcfdd-06c6-31b4-a561-b3710f493621",
                        "source_sense_description": "fight between women — see also bitch fight",
                        "target_lang_word": "crêpage de chignons",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crêpage de chignons",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08241262-6c67-357a-8844-b01535ee6a18",
                                        "entry_id": "c94c56e3-1de7-3008-a471-d7fabb6cc401",
                                        "glosses": [
                                            "Dispute où l'on en vient aux mains, généralement entre deux femmes."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c7ab46-2195-4f5e-bcf4-3f5bc80222ee",
                                                "sense_id": "08241262-6c67-357a-8844-b01535ee6a18",
                                                "text": "Un conflit entre mec est un combat franc et régulier. Entre nanas, un crêpage de chignons ! Lâchez le nous cinq minutes, le chignon, et regardez du côté des mecs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92ea03b5-0b2e-49ed-beb7-f474d8d49cbb",
