                        ],
                        "examples": [
                            {
                                "example_id": "aa03aeda-602f-4039-a85c-b69320fe6c86",
                                "sense_id": "6778cd22-e16e-39fd-8856-0aebcc022d0f",
                                "text": "D'après un texte de Pline, le pompholyx se produit pendant la purification de l'airain ; ou bien encore, en projetant le jet des soufflets sur la cadmie."
                            }
                        ]
                    },
                    {
                        "sense_id": "81d5fcad-17fa-34dd-83df-71943e511f60",
                        "entry_id": "f22e3467-54b4-32b1-b2fa-82f515bd4962",
                        "glosses": [
                            "Éruption bulleuse semblable au pemphigus, dyshidrose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc3fc37-4e0c-4280-b0a3-6fae56985781",
                                "sense_id": "81d5fcad-17fa-34dd-83df-71943e511f60",
                                "text": "Le pompholyx lavé en suc de morelle ou plantain profite bien aux chancres ulcerés."
                            }
                        ]
                    }
