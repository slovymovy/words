        "de-extract.jsonl": [
            {
                "entry_id": "4e4e4862-d57b-3a1a-8596-5e92663da37c",
                "word": "frankincense",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b2af84b-a5e6-3ad3-bf0d-32516bcb9eb8",
                        "entry_id": "4e4e4862-d57b-3a1a-8596-5e92663da37c",
                        "glosses": [
                            "Der Weihrauch, ein aus der Weihrauchbaum-Art Boswellia thurifera gewonnenes Harz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80706dd2-174a-4b0f-9ec1-d763fe1f49b2",
                                "sense_id": "7b2af84b-a5e6-3ad3-bf0d-32516bcb9eb8",
                                "text": "They presented him with gifts of gold, frankincense and myrrh."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60de0af9-82b3-482f-8985-2e9991ddf2fd",
                        "source_entry_id": "4e4e4862-d57b-3a1a-8596-5e92663da37c",
                        "source_sense_id": "7b2af84b-a5e6-3ad3-bf0d-32516bcb9eb8",
                        "target_lang_word": "Weihrauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weihrauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddee508-846b-384b-ac58-ffe4b250e7be",
                                        "entry_id": "ad75e611-2ea3-300a-ae89-1f157aa437bf",
                                        "glosses": [
                                            "Harz, das von Weihrauchbäumen gewonnen wird und bei Verbrennung einen typischen Geruch abgibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d3a27de-2dda-488c-a0ca-d9462aa9e280",
                                                "sense_id": "4ddee508-846b-384b-ac58-ffe4b250e7be",
                                                "text": "„Die Leute, die das Muttergottesbild an Handtüchern getragen hatten, wurden abgelöst, die Mesner zündeten wieder Weihrauch an, und der Gottesdienst nahm seinen Anfang.“"
                                            },
                                            {
                                                "example_id": "38cd0a9b-34a9-47d2-b759-d06c17d1b0e9",
                                                "sense_id": "4ddee508-846b-384b-ac58-ffe4b250e7be",
                                                "text": "Wir benutzen reinen Weihrauch aus dem Sultanat Oman."
                                            },
                                            {
                                                "example_id": "ad219fbd-42e1-4592-9429-98d1185b3df7",
                                                "sense_id": "4ddee508-846b-384b-ac58-ffe4b250e7be",
                                                "text": "„Frau Mondtraut hatte sich in die Halle für den Buddha-Dienst begeben, um Weihrauch anzuzünden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03f3604d-b976-377d-a4c4-dfaa6b37e4ae",
                                        "entry_id": "ad75e611-2ea3-300a-ae89-1f157aa437bf",
                                        "glosses": [
                                            "Rauch des Harzes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8a04a07-17c8-4d0f-97da-63e22e6596be",
                                                "sense_id": "03f3604d-b976-377d-a4c4-dfaa6b37e4ae",
                                                "text": "Zu viel Weihrauch beleidigt die Nase."
                                            },
                                            {
                                                "example_id": "463cadc6-f850-442f-b9a5-5fe0c04e5853",
                                                "sense_id": "03f3604d-b976-377d-a4c4-dfaa6b37e4ae",
                                                "text": "Dieser Weihrauch duftet ganz vorzüglich."
                                            },
                                            {
                                                "example_id": "0b3e025c-10bd-449f-8675-f5892c34e31b",
                                                "sense_id": "03f3604d-b976-377d-a4c4-dfaa6b37e4ae",
                                                "text": "„Ich roch nach Weihrauch.“"
                                            },
                                            {
                                                "example_id": "5f8861e9-0385-4548-b883-f5520a31481c",
                                                "sense_id": "03f3604d-b976-377d-a4c4-dfaa6b37e4ae",
                                                "text": "„Und drinnen öffnet sich der Vorhang, Priester treten Weihrauch schwenkend ein, dann ein kleiner, schmaler Mann mit Vollbart und einem fein geschnittenen Gesicht.“"
                                            },
                                            {
                                                "example_id": "336fbbbe-f667-4327-8099-569f5dfbc098",
                                                "sense_id": "03f3604d-b976-377d-a4c4-dfaa6b37e4ae",
                                                "text": "„Während der Pfarrer den Heiligen Geist aussandte, die Gemeinde betete, der Chor die Himmel rühmen ließ, während Weihrauch wie süßlicher Nebel durchs Kirchenschiff wallte, verliebte sich Hans Tönnies in die Maria, und das schon eine Woche nach seiner Heimkehr aus Kriegsgefangenschaft.“"
                                            },
                                            {
                                                "example_id": "c7252093-aff7-47e9-bc06-684fdf99a564",
                                                "sense_id": "03f3604d-b976-377d-a4c4-dfaa6b37e4ae",
                                                "text": "„Der Weihrauch strich durch den Raum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
