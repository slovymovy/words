                        "glosses": [
                            "Relatif aux Cupisniques, à Cupisnique ou à sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a99a7480-5b1c-4d95-a431-30c5cfdda994",
                                "sense_id": "1dfdf472-b6ae-37d0-b52b-fc4868213148",
                                "text": "L’étude d’un flacon à bec en forme d’étrier du Musée de Brooklyn, recueilli en 1930 chez les Mangbetous du Congo septentrional, révèle des caractéristiques identiques à celles des flacons analogues de style cupisnique découvert au Pérou et datant du Iᵉʳ millénaire av. J.-C."
                            },
                            {
                                "example_id": "5e758480-3f24-4f0e-8ec8-d21537f86e4b",
                                "sense_id": "1dfdf472-b6ae-37d0-b52b-fc4868213148",
                                "text": "Courant autour du patio tendu de colonnes en bois, les onze salles de ce musée nous renseignent sur les cultures cupisnique, salinar, virú, chimú et inca."
                            },
                            {
                                "example_id": "ac302859-2bea-417a-b8e6-42b7e3a16d95",
                                "sense_id": "1dfdf472-b6ae-37d0-b52b-fc4868213148",
                                "text": "Tout commence par le nord du Pérou, où s’est développée la culture cupisnique (1200-500 avant J.-C.), étudiée par l’archéologue péruvien Rafael Larco Hoyle (1901-1966), fondateur du Musée Larco de Lima."
                            }
                        ]
                    }
