{
    "word_family": [
        "delighted",
        "delightful",
        "delightfully"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0399ac7-49be-3cb0-91dc-698bc73e38b1",
                    "sense_definition": "A feeling of great pleasure, satisfaction, or happiness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children opened their presents with squeals of <w>delight</w>.",
                            "target_lang_translations": {
                                "ru": "Дети открывали подарки с визгом от <w>восторга</w>.",
                                "nl": "De kinderen openden hun cadeautjes met gilletjes van <w>vreugde</w>.",
                                "pl": "Dzieci otwierały prezenty z piskami <w>radości</w>.",
                                "de": "Die Kinder öffneten ihre Geschenke mit Freudenschreien vor <w>Entzückung</w>."
                            }
                        },
                        {
                            "text": "To my <w>delight</w>, the sun came out just in time for the picnic.",
                            "target_lang_translations": {
                                "ru": "К моей <w>радости</w>, солнце выглянуло как раз к пикнику.",
                                "nl": "Tot mijn <w>vreugde</w> kwam de zon precies op tijd voor de picknick tevoorschijn.",
                                "pl": "Ku mojej <w>radości</w>, słońce wyszło w samą porę na piknik.",
                                "de": "Zu meiner <w>Freude</w> kam die Sonne gerade rechtzeitig für das Picknick heraus."
                            }
                        }
                    ],
                    "synonyms": [
                        "joy",
                        "happiness",
                        "glee",
                        "pleasure",
                        "gladness"
                    ],
                    "antonyms": [
                        "sorrow",
                        "displeasure",
                        "misery"
                    ],
                    "common_phrases": [
                        "with delight",
                        "to someone's delight",
                        "squeal with delight",
                        "take delight in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство огромного удовольствия, удовлетворения или счастья.",
                        "nl": "Een gevoel van groot plezier, voldoening of geluk.",
                        "pl": "Uczucie wielkiej przyjemności, satysfakcji lub szczęścia.",
                        "de": "Ein Gefühl von großer Freude, Zufriedenheit oder Glück."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восторг",
