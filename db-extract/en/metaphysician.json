                                        "entry_id": "1c85dcdd-d775-3fb1-9a91-fb5a1d2bcc93",
                                        "glosses": [
                                            "Philosoph, der sich mit der theoretischen Philosophie, der Metaphysik, beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959732fb-d833-406a-8797-9d63e37f012e",
                                                "sense_id": "3841a75b-f3f6-3452-a8b6-57dd888a5eb7",
                                                "text": "Ein bekannter Metaphysiker war der Philosoph Immanuel Kant."
                                            },
                                            {
                                                "example_id": "bf6a9d67-9fe1-4f82-911a-2998fda81383",
                                                "sense_id": "3841a75b-f3f6-3452-a8b6-57dd888a5eb7",
                                                "text": "„Der junge Studiosus wagte es, sich in eine Diskussion einzuschalten, die die größten Metaphysiker der Neuzeit, Descartes und Leibniz, entzweit hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
