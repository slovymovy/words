                "senses": [
                    {
                        "sense_id": "cf03d41c-2345-3ebb-8773-cb45c3ca4ed5",
                        "entry_id": "569838d4-70a6-3ee8-aa69-d692c0bf064d",
                        "glosses": [
                            "der auslieferungsfähige, aber noch nicht ausgestattete Sekt (das heißt noch vor einer gegebenenfalls durchzuführenden Dosage) im Gegensatz zu dem Rohsekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec62bc38-10e7-4639-a242-81be9817055e",
                                "sense_id": "cf03d41c-2345-3ebb-8773-cb45c3ca4ed5",
                                "text": "„Die deutsche Variante „Rohkost“ bietet die wunderbare Gelegenheit, die einzelnen Phasen der Sektwerdung nachzuvollziehen. Zuerst startet man beim Grundwein, gefolgt vom Rohsekt, der noch nicht degorgiert ist, und endet mit dem Fertigsekt. Von den Rohsekten wurde der Name Rohkost abgeleitet. Es ist schon beeindruckend, welche Veränderung der Sekt im Laufe der verschiedenen Verarbeitungsschritte annimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
