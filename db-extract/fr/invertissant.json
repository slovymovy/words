                        ],
                        "examples": [
                            {
                                "example_id": "1c78b002-613d-492c-a46b-1b01fa08a233",
                                "sense_id": "061fd03f-f548-35fc-b093-7b2238e690bd",
                                "text": "Les disaccharides sont invertis par les ferments invertissants, les monoses résultants subissent alors la fermentation alcoolique."
                            },
                            {
                                "example_id": "9d8f943a-d93a-431c-b926-804170fe742f",
                                "sense_id": "061fd03f-f548-35fc-b093-7b2238e690bd",
                                "text": "M. Vandevelde signale a propos de cette communication, qu'il a reconnu que des extraits aqueux de malt vert présentent des propriétés invertissantes."
                            },
                            {
                                "example_id": "0f56e183-b509-4f40-9f0f-fcf0e32c3582",
                                "sense_id": "061fd03f-f548-35fc-b093-7b2238e690bd",
                                "text": "Il n'était cependant arrivé ni à Hansen, ni aux auteurs susnommés, d'extraire par l'eau, de la levure fraîche ou sèche, un enzyme invertissant, qui effectuât la décomposition précédente en glucose et lévulose."
                            }
                        ]
                    }
