    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2360ae8c-6384-370b-a3a8-fb3ff109a9e2",
                    "sense_definition": "Niewielka walizka lub torba na podręczne przybory i rzeczy osobiste, używana w podróży.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "bagaż",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Portier raportował, że <w>neseser</w> przywieziono z dworca przed godziną.",
                            "target_lang_translations": {
                                "ru": "Портье доложил, что <w>несессер</w> привезли с вокзала час назад."
                            }
                        },
                        {
                            "text": "W swoim skórzanym <w>neseserze</w> trzymała wszystkie niezbędne kosmetyki.",
                            "target_lang_translations": {
                                "ru": "В своем кожаном <w>несессере</w> она держала все необходимые косметические средства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skórzany neseser",
                        "spakować neseser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой чемоданчик или сумка для туалетных принадлежностей и личных вещей, используемая в поездках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несессер",
                                "target_lang_sense_clarification": "дорожный набор с туалетными принадлежностями"
                            },
                            {
                                "target_lang_word": "косметичка",
                                "target_lang_sense_clarification": "сумка для косметики и мелких предметов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff519655-f5be-37bc-b962-1cb173eb76a8",
                    "sense_definition": "Sztywna teczka lub mała walizka służąca do przenoszenia dokumentów.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bagaż",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prawnik zamknął swój <w>neseser</w> i wyszedł z sali sądowej.",
                            "target_lang_translations": {
                                "ru": "Адвокат закрыл свой <w>дипломат</w> и вышел из зала суда."
                            }
                        },
                        {
                            "text": "Wszystkie ważne umowy schował do eleganckiego <w>nesesera</w>.",
                            "target_lang_translations": {
                                "ru": "Все важные договоры он спрятал в элегантный <w>дипломат</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "teczka"
                    ],
                    "common_phrases": [
                        "elegancki neseser",
                        "otworzyć neseser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жесткий портфель или небольшой чемодан для переноски документов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломат",
                                "target_lang_sense_clarification": "жесткий деловой портфель"
                            },
                            {
                                "target_lang_word": "портфель",
                                "target_lang_sense_clarification": "сумка для бумаг и документов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}