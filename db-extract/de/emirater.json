                    {
                        "sense_id": "a7a4437f-7725-3e4c-b722-c8e593a41b84",
                        "entry_id": "85d2b7d6-60e2-3c80-b675-af93276f9efc",
                        "glosses": [
                            "einheimischer Einwohner oder Staatsangehöriger der Vereinigten Arabischen Emirate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722cf6ef-cc9a-4f3b-9406-563613cb3d7b",
                                "sense_id": "a7a4437f-7725-3e4c-b722-c8e593a41b84",
                                "text": "„In der ersten Reihe harren die Emirater in ihren Dishdashas aus und scheinen sich zu fragen, ob alle Menschen im Westen so sind.“"
                            },
                            {
                                "example_id": "3b6f283d-1879-4007-8c21-8c31db43dbfd",
                                "sense_id": "a7a4437f-7725-3e4c-b722-c8e593a41b84",
                                "text": "„Englisch ist gängige Geschäftssprache, die unter den Emiratern und den Gastarbeitern weitverbreitet ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
