                ],
                "senses": [
                    {
                        "sense_id": "196f3c34-edcb-3da9-8631-7cae3277e82c",
                        "entry_id": "f93e71cd-fa38-33db-bd9a-96fb6f5bb664",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным фигура (в знач. стилистический приём, словесный оборот, используемый для усиления выразительности речи)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f8822dfc-f072-36cf-be66-10611876009d",
                        "entry_id": "f93e71cd-fa38-33db-bd9a-96fb6f5bb664",
                        "glosses": [
                            "перен. иносказательный, переносный, образный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33dac45c-7bd7-4450-a82d-94e1aa3fc064",
                                "sense_id": "f8822dfc-f072-36cf-be66-10611876009d",
                                "text": "Есть еще слова, например: ослепление, кои в одном только метафорическом смысле употребляются; но хотя они и не поставляются нигде в собственном смысле, однако объяснение должно упадать всегда на смысл собственный, с примечанием притом, что обычай не позволяет употреблять сего слова иначе, как в смысле фигуральном."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c910f7f1-5b83-432c-9ea2-7b92515f85b0",
                        "source_entry_id": "f93e71cd-fa38-33db-bd9a-96fb6f5bb664",
                        "source_sense_description": "иносказательный, переносный, образный",
                        "target_lang_word": "übertragen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "übertragen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4188add3-549e-374e-94db-1f29f16ca7fb",
                                        "entry_id": "52d72e0d-8918-3526-9a36-f00309549c5e",
                                        "glosses": [
                                            "ein Wort nicht im ursprünglichen Sinne verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9a27b20-5e69-4dec-b0cb-fdfdd11fd0f1",
                                                "sense_id": "4188add3-549e-374e-94db-1f29f16ca7fb",
                                                "text": "In den meisten Wörterbüchern kommt das Wort „Seitensprung“ nur in der übertragenen Bedeutung vor."
                                            },
                                            {
                                                "example_id": "91e959dd-0bd0-404f-8182-6f3e9e3493b1",
                                                "sense_id": "4188add3-549e-374e-94db-1f29f16ca7fb",
                                                "text": "Das meinte ich sowohl im wörtlichen, wie im übertragenen Sinne."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "013b3ad8-435e-3cae-bab5-01622f6c1762",
                                        "entry_id": "52d72e0d-8918-3526-9a36-f00309549c5e",
                                        "glosses": [
                                            "gebraucht, wiederverkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0451026f-5227-48d2-8c2a-b6d0a5ff3147",
                                                "sense_id": "013b3ad8-435e-3cae-bab5-01622f6c1762",
                                                "text": "Fahranfänger kaufen sich oft ein übertragenes Auto, weil dann der erste Schaden nicht so weh tut."
                                            },
                                            {
                                                "example_id": "2dc8e31c-6e67-4b9c-8b13-4783e761f6b9",
                                                "sense_id": "013b3ad8-435e-3cae-bab5-01622f6c1762",
                                                "text": "„1968 kaufte ich mir ein übertragenes Auto.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "übertragen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06fdf46a-cac1-3ce5-924f-381d2ce08436",
                                        "entry_id": "7a1cd9af-c810-36a6-97e6-ca52c877c126",
                                        "glosses": [
                                            "jemandem eine Aufgabe anvertrauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bbd212f-e60c-4b30-867e-5d7fc8b88d79",
                                                "sense_id": "06fdf46a-cac1-3ce5-924f-381d2ce08436",
                                                "text": "Er hat sein Amt an einen Unbekannten übertragen."
                                            },
                                            {
                                                "example_id": "d20a7131-9cc2-41cc-b0fc-3a0b9664987a",
                                                "sense_id": "06fdf46a-cac1-3ce5-924f-381d2ce08436",
                                                "text": "Mir wurde die Verantwortung übertragen, und ich drücke mich nicht vor ihr."
                                            },
                                            {
                                                "example_id": "ce1a1a62-55cd-400a-885b-2a0a10eb2e04",
                                                "sense_id": "06fdf46a-cac1-3ce5-924f-381d2ce08436",
                                                "text": "„Die asiatische Tigermücke überträgt viele gefährliche tropische Krankheiten wie Chikungunya, Dengue und Zika , die es in Deutschland bislang nicht gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99e72a43-a836-3f39-a7d7-8ec69a2d69d5",
                                        "entry_id": "7a1cd9af-c810-36a6-97e6-ca52c877c126",
                                        "glosses": [
                                            "eine Krankheit an jemanden weitergeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "587f04d1-13d0-469b-8c61-d40ad6b46351",
                                                "sense_id": "99e72a43-a836-3f39-a7d7-8ec69a2d69d5",
                                                "text": "Zecken übertragen FSME und Borreliose."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1c36c93-f7de-3f53-9dab-615796436188",
                                        "entry_id": "7a1cd9af-c810-36a6-97e6-ca52c877c126",
                                        "glosses": [
                                            "etwas, was an anderer Stelle schon steht, nochmals schreiben; etwas kopieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239d03a3-0f98-4011-acc2-cc9850fcacd6",
                                                "sense_id": "b1c36c93-f7de-3f53-9dab-615796436188",
                                                "text": "Die Beträge müssen nochmals in dieses Formular übertragen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9e6ebce1-f81d-3689-8d7c-de6b06007c64",
                                        "entry_id": "7a1cd9af-c810-36a6-97e6-ca52c877c126",
                                        "glosses": [
                                            "etwas in seiner Form, nicht aber in seinem Wesen oder seinem Informationsgehalt verändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f52676d-bb86-415e-8da1-5efde69ca8d0",
                                                "sense_id": "9e6ebce1-f81d-3689-8d7c-de6b06007c64",
                                                "text": "Die Originalfassung eines Musikstückes kann auf ein anderes Instrument übertragen werden."
                                            },
                                            {
                                                "example_id": "f20ec762-885c-4c8e-83ad-3444a44fcde1",
                                                "sense_id": "9e6ebce1-f81d-3689-8d7c-de6b06007c64",
                                                "text": "Sie überträgt den englischen Text ins Deutsche."
                                            },
                                            {
                                                "example_id": "77777c41-f6c6-44e8-87b6-d4c6291b658d",
                                                "sense_id": "9e6ebce1-f81d-3689-8d7c-de6b06007c64",
                                                "text": "„Heutige Krankheitsbezeichnungen lassen sich nicht ohne weiteres auf ältere Krankheitsbeschreibungen und -konzepte übertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "81a2afb6-af54-3e8d-8f80-72c5dc5d919c",
                                        "entry_id": "7a1cd9af-c810-36a6-97e6-ca52c877c126",
                                        "glosses": [
                                            "eine Veranstaltung aufzeichnen und senden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd1343e-bd07-40fe-b2ef-635ddf5e0649",
                                                "sense_id": "81a2afb6-af54-3e8d-8f80-72c5dc5d919c",
                                                "text": "Die Pressekonferenz übertragen wir live."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "d982aaf3-72f3-3780-b1c8-2d76b17fc322",
                                        "entry_id": "7a1cd9af-c810-36a6-97e6-ca52c877c126",
                                        "glosses": [
                                            "Eigentum übergeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac56aaa-a204-404d-b264-ce1d08574ee6",
                                                "sense_id": "d982aaf3-72f3-3780-b1c8-2d76b17fc322",
                                                "text": "„Doch was passiert, wenn ein Ehegatte während der Ehe dem anderen die Hälfte der Wohnung übertragen hat?“"
                                            },
                                            {
                                                "example_id": "cf26a906-52f3-4c43-bffd-ba10b10fd234",
                                                "sense_id": "d982aaf3-72f3-3780-b1c8-2d76b17fc322",
                                                "text": "„Dagegen richtet sich die fristgerechte und zulässige Berufung, in der Herr R. durch seinen Rechtsvertreter im Wesentlichen vorbringt, dass er die Fahrt mit seinem Sohn zusammen durchgeführt habe, weil er diesem jenen Waldteil zeigen habe wollen, welcher ihm vom Bruder des Beschuldigten übertragen worden sei.“?"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "übertragen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bf80eb-f86f-314f-89de-04c2c32288dd",
                                        "entry_id": "f28b4ac1-b531-3f00-9773-d9521a5ffe03",
                                        "glosses": [
                                            "Partizip Perfekt des Verbs übertragen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "perfect"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
