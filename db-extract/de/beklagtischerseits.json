                        "glosses": [
                            "seitens des Beklagten, durch den Beklagten"
                        ],
                        "tags": [
                            "Recht; heute ungebräuchlich"
                        ],
                        "examples": [
                            {
                                "example_id": "a3456a7c-2a95-4c89-8be4-f80292dd8119",
                                "sense_id": "2e08deaf-19e6-3a24-ac0b-9705ab0741b1",
                                "text": "„Beklagtischerseits wurden zwei Beschwerden aufgestellt: […]“"
                            },
                            {
                                "example_id": "cbbfc4f5-3f53-43ca-95c2-c948a8c12861",
                                "sense_id": "2e08deaf-19e6-3a24-ac0b-9705ab0741b1",
                                "text": "„Die beklagtischerseits geltend gemachte Beschränkung der klägerischen Weideberechtigung ist aus dem Wesen des Realrechts nicht abzuleiten […]“"
                            },
                            {
                                "example_id": "9bef97a5-7a7d-4006-9770-e645763da672",
                                "sense_id": "2e08deaf-19e6-3a24-ac0b-9705ab0741b1",
                                "text": "„Die Vorinstanz hat zutreffend darauf hingewiesen, dass entgegen der Darstellung der Klägerin beklagtischerseits nicht behauptet wird, die Qualität der Wasser beurteile sich ausschliesslich nach ihrem Gesamtgehalt an mineralischen Substanzen […]“"
                            },
                            {
                                "example_id": "48dc8646-b680-4d5a-b565-3991909aa5a1",
                                "sense_id": "2e08deaf-19e6-3a24-ac0b-9705ab0741b1",
                                "text": "„Mit Bezug auf die beklagtischerseits ebenfalls zur Verrechnung gestellten Rückforderungs- bzw. Herabsetzungsansprüche aus Mängeln der Mietsache verwies die Vorinstanz alsdann auf die ihrer Ansicht nach zutreffenden Erwägungen der Erstinstanz […]“"
                            },
                            {
                                "example_id": "b5cc37e0-939a-4145-8a33-49179a639b4c",
                                "sense_id": "2e08deaf-19e6-3a24-ac0b-9705ab0741b1",
                                "text": "„Beklagtischerseits unbestritten geblieben ist, dass die Wohnung des Gesuchsgegners grundsätzlich als Familienwohnung für den Kläger und die beiden Kinder geeignet ist […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
