                "senses": [
                    {
                        "sense_id": "953e4d43-eed9-3058-b12e-294144ba81ef",
                        "entry_id": "9ccfa923-1254-3884-bda3-c539b08fe79f",
                        "glosses": [
                            "(amtlich ausgestelltes) Schreiben, das den Grenzübertritt ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be40348d-28d1-4f67-899e-353f0b195d7c",
                                "sense_id": "953e4d43-eed9-3058-b12e-294144ba81ef",
                                "text": "„Jedes Kind braucht sein eigenes Reisedokument – nur welches?“"
                            },
                            {
                                "example_id": "2bf8b2c7-476e-46ad-85cc-9c209eb7eb55",
                                "sense_id": "953e4d43-eed9-3058-b12e-294144ba81ef",
                                "text": "„[1959] wurde […] der Schutzbrief als internationales Reisedokument geschaffen, […]“"
                            },
                            {
                                "example_id": "c6105109-e220-478b-8dc9-b89e494373b2",
                                "sense_id": "953e4d43-eed9-3058-b12e-294144ba81ef",
                                "text": "„Als ich ihn öffnete, begriff ich, dass es ein Passetui war, eine kleine Mappe für Ausweise und andere Reisedokumente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
