                "senses": [
                    {
                        "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                        "entry_id": "402975ac-a79a-3ab0-a5b5-c14353b11369",
                        "glosses": [
                            "dunkler, meist auch nachhallender, schmetternder Ton Nachdruck^([1]), Nachhall, Schwung^([3]), Effet, Karacho, Schmackes, Tusch, Wucht"
                        ],
                        "tags": [
                            "auch übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "ba8eb2f3-8dd3-4700-ac22-4d5c7cb164eb",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„Je schwerer das Teilchen, das entstehen soll, desto mehr Wums beim Aufprall ist nötig.“"
                            },
                            {
                                "example_id": "ededb4ba-274a-4af6-92e6-825c911f895d",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„Dann legt er den Rückwärtsgang ein, setzt mit Wums zurück und knallt genau wie Willeke gegen den Bordstein.“"
                            },
                            {
                                "example_id": "34a63e26-30c3-4495-b98a-60c01cbe22ca",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„Das Geheimnis der Kapelle, die vor fünf Jahren gegründet wurde und bei allen sehr gut ankommt, verriet der Leiter und Organisator, ‚Commander‘ von der Kapelle genannt, Christian Limpert: ‚Wir machen Blasmusik mit den richtigen Wums‘, sagte er kurz und bündig.“"
                            },
                            {
                                "example_id": "d3602433-c415-4314-9b8e-f165e1a687e3",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„Was ganz und gar nicht original ist, ist allerdings der Antrieb: Die Turbine stammt aus einem amerikanischen Kampfjet und hat auch genauso viel Wums: 20 000 PS.“"
                            },
                            {
                                "example_id": "b1eca5c5-647c-434e-87fc-03f6bc5c5b71",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„»Viel mehr Wums«, bestätigte Henri.“"
                            },
                            {
                                "example_id": "1cc3f450-eca2-4cc3-98b0-c44b67fe0dd6",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„Am Schlagzeug ergänzt ihn die bezaubernde Celeste Spina, die trotz Schwangerschaft mit viel Wums zu Werke ging.“"
                            },
                            {
                                "example_id": "6ebde6ec-2336-4652-baf9-3bb909ae0b1a",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„‚Das gibt einen ordentlichen Wums‘, sagte Wollenweber.“"
                            },
                            {
                                "example_id": "6a6a65af-1d51-4864-be9d-32566f9f042e",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„Allerdings war bei Werner sehr viel mehr Wums dahinter als bei seinem Bruder, der sich mit einem Kanister Benzin und einem Feuerzeug begnügte.“"
                            },
                            {
                                "example_id": "b1ecb5ec-187e-41d7-9b6e-91a69437ab81",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„»[…] Ich habe einen schönen Actionstreifen besorgt, damit du gleich mal siehst, wie viel Wums hinter der Anlage steckt.« Eine Sekunde später ist es wieder dunkel, Paul sitzt neben mir und startet den Film mit ordentlich Wums.“"
                            },
                            {
                                "example_id": "aeec2a94-a120-4f8e-b157-e9b0ffd7f796",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„‚Irgendeine? Du willst wissen, was irgendeine Mine kostet? Und deshalb kommst du hierher?‘ – ‚Die teuerste.‘ –‚Die teuerste? Eine mit Wums oder was?‘“"
                            },
                            {
                                "example_id": "bc0aa405-4d47-4728-96e1-9c9e44d87b1c",
                                "sense_id": "0fd89d7f-df89-31d1-b7c7-fbd56b4e1ccb",
                                "text": "„Nein, wohl eher ein Hartkäse wie Parmesan oder Pecorino. Die hatten genug Wums und eine harte Rinde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
