                        ],
                        "examples": [
                            {
                                "example_id": "2b6aabf5-97be-4c1d-8ae8-07a68c71fe15",
                                "sense_id": "cb1fe4e9-68d6-3180-8bfd-f8d7a65e349c",
                                "text": "Les avelanèdes servent, dans quelques pays, pour passer les cuirs."
                            },
                            {
                                "example_id": "74939e42-2378-4530-a577-11c20fcf7e15",
                                "sense_id": "cb1fe4e9-68d6-3180-8bfd-f8d7a65e349c",
                                "text": "L'avelanède arrive en sacs de corda, pesant 90 à 100 kilogrammes. Quelquefois Marseille la reçoit en vrague, c'est-à-dire à nu dans les navires, et, pour l'expédier, la met en barriques et balles de différents poids."
                            }
                        ]
