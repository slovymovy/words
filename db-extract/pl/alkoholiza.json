                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcoolyse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc17f68f-c832-33ba-ab4b-690e2fed066d",
                                        "entry_id": "ead4d33f-7c0f-36d1-8c7a-f464dd64ad5e",
                                        "glosses": [
                                            "Réaction de solvolyse dont l’agent est un alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2af3b3e-6e98-4f20-b717-7405bc2844c8",
                                                "sense_id": "dc17f68f-c832-33ba-ab4b-690e2fed066d",
                                                "text": "On peut, sur les principes décrits, éliminer un reste carbobenzyloxyle par hydrolyse bromhydrique, un reste carbophényloxyle par hydrogénolyse, détosyler par réduction au sodium, déformyler par alcoolyse, déphtalyler par l’hydrazine."
                                            },
                                            {
                                                "example_id": "8fa2b315-0395-4a44-a647-09af8603821e",
                                                "sense_id": "dc17f68f-c832-33ba-ab4b-690e2fed066d",
                                                "text": "Les esters peuvent encore subir des alcoolyses et des interesterifications ; leur statut ne change pas mais des radicaux sont permutés."
                                            },
                                            {
                                                "example_id": "53328a8f-3351-40ff-b978-cde891272dad",
                                                "sense_id": "dc17f68f-c832-33ba-ab4b-690e2fed066d",
                                                "text": "La gamme de l’entreprise s’est également enrichie avec les Cerester, des cires-esters obtenues par alcoolyse des triglycérides des huiles végétales, ou encore les Phytowax, des cires végétales obtenues par hydrogénation des Cerester olive."
                                            }
                                        ]
                                    }
                                ]
