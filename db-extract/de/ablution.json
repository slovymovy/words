                "senses": [
                    {
                        "sense_id": "a754dfd9-ea1b-3a46-b845-87af9261ab45",
                        "entry_id": "507246ed-40bf-35d0-808a-37e5f23e6a9b",
                        "glosses": [
                            "eine rituelle Waschung von Kultobjekten, der Hände oder des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c08c43aa-c742-4845-ba14-e32381be1cb5",
                                "sense_id": "a754dfd9-ea1b-3a46-b845-87af9261ab45",
                                "text": "Der wichtigste Zweck dieses hinduistischen Fests liegt in der rituellen Ablution an einem besonders heiligen Ort."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "693100ac-e798-3801-aef9-537c1a290a04",
                        "entry_id": "507246ed-40bf-35d0-808a-37e5f23e6a9b",
                        "glosses": [
                            "Säuberung des Kelches und der Finger des Priesters nach Erteilung der Kommunion"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "9df56828-5fcf-40c8-9ebf-d20e82b086ba",
                                "sense_id": "693100ac-e798-3801-aef9-537c1a290a04",
                                "text": "„Im Hinblick darauf, daß im behandelten Zeitabschnitt die Darreichung der Ablution ein von der Kirche vorgeschriebenes Ritual war, kann ich keine plausible Erklärung dafür finden, daß wir in einigen Gemeinden niemals, anderswo aber nur in einem bestimmten Zeitabschnitt keine auf die Ablution hinweisenden Gegenstände unter den erfaßten Kirchengeräten vorfinden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f3f79a39-8928-3364-99c1-8f37272920ce",
                        "entry_id": "507246ed-40bf-35d0-808a-37e5f23e6a9b",
                        "glosses": [
                            "durch Meeresströmungen verursachte Abtragung von Sedimenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e44eb94-83b5-402c-9a5b-725a0028e2ce",
                                "sense_id": "f3f79a39-8928-3364-99c1-8f37272920ce",
                                "text": "Die Ablution von küstennahen Meeresströmungen kann den Küstenverlauf beträchtlich verändern."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
