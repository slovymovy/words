                        "cross_references": [
                            {
                                "target_word": "Zopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edb709b4-8ca9-3b48-91b7-3ad542144d91",
                                        "entry_id": "a41bee15-5a27-3b08-8028-b192f87913f1",
                                        "glosses": [
                                            "aus mehreren Strängen (meist drei) geflochtenes Kopfhaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d739245a-b3c2-4106-a561-34d892e23769",
                                                "sense_id": "edb709b4-8ca9-3b48-91b7-3ad542144d91",
                                                "text": "„Line, die schon vorher das Weißzeug beiseite gelegt und ihren blonden Zopf halb aufgeflochten hatte, schlug jetzt mit dem losen Büschel über ihre linke Hand und sagte: »Will es mir noch überlegen, Herr Geelhaar. Ein armes Mädchen hat nichts als seinen Ruf.«“"
                                            },
                                            {
                                                "example_id": "4fd5d31b-0d7b-44c4-918d-531b8831c8c4",
                                                "sense_id": "edb709b4-8ca9-3b48-91b7-3ad542144d91",
                                                "text": "„Weil sie sich daran übergesehen hatte, ließ Renate sich von Mama die Zöpfe abschneiden.“"
                                            },
                                            {
                                                "example_id": "398c78f5-9818-435e-83f4-6c63c2ab70cd",
                                                "sense_id": "edb709b4-8ca9-3b48-91b7-3ad542144d91",
                                                "text": "„Drei geflochtene Zöpfe hingen über den schlanken Nacken der Frau.“"
                                            },
                                            {
                                                "example_id": "63d2c722-7189-4926-8cca-a3184e8017dc",
                                                "sense_id": "edb709b4-8ca9-3b48-91b7-3ad542144d91",
                                                "text": "„Sie hatte gehofft, Sisi könne ihr mit den Zöpfen helfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5974adc-97c7-3866-bfcf-14aed788f44e",
                                        "entry_id": "a41bee15-5a27-3b08-8028-b192f87913f1",
                                        "glosses": [
                                            "das obere, dünnere Ende eines Baumstammes"
                                        ],
                                        "tags": [
                                            "Dinge in der Form eines Zopfes gemäß obiger Definition",
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dba32db-2be7-4e5b-8969-aa857607caf8",
                                                "sense_id": "d5974adc-97c7-3866-bfcf-14aed788f44e",
                                                "text": "Die Pferde zogen den Stamm mit dem Zopf voran aus dem Wald."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "bf5f550b-e978-342b-8d54-f987373b805b",
                                        "entry_id": "a41bee15-5a27-3b08-8028-b192f87913f1",
                                        "glosses": [
                                            "leichter Rausch"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e837384-cd81-4b35-9ac8-7c963a0552b2",
                                                "sense_id": "bf5f550b-e978-342b-8d54-f987373b805b",
                                                "text": "Nachdem er sich einen Zopf angetrunken hat, zog er sich in eine Stubenecke zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "c3a3dbbf-d040-3738-a9d3-bd54b3326068",
                                        "entry_id": "a41bee15-5a27-3b08-8028-b192f87913f1",
                                        "glosses": [
                                            "überholter Brauch, alte Ansicht"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c15f65-d485-4122-ab08-b650065d0d2d",
                                                "sense_id": "c3a3dbbf-d040-3738-a9d3-bd54b3326068",
                                                "text": "Was sollen denn diese alten Zöpfe? Wieso kommst du mit diesen alten Geschichten wieder an? Das ist doch durch, oder?"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "5cf0db25-74d6-37ee-a277-f88c749f7a6e",
                                        "entry_id": "a41bee15-5a27-3b08-8028-b192f87913f1",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "554f794c-53c0-4624-803b-fe19a6086ada",
                                                "sense_id": "5cf0db25-74d6-37ee-a277-f88c749f7a6e",
                                                "text": "„Vorbei an einer Fee im blauen Kleid, die aus einem Vorhang aus weißen Schnüren Zöpfe flicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8ae21f84-64d3-3d80-a529-4eaca21411d3",
                                        "entry_id": "a41bee15-5a27-3b08-8028-b192f87913f1",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff657d2e-d4dc-4192-831d-9168b90c4dba",
                                                "sense_id": "8ae21f84-64d3-3d80-a529-4eaca21411d3",
                                                "text": "Am Nachmittag gab es noch Kaffee, Kuchen und einen Zopf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
