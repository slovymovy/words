                "senses": [
                    {
                        "sense_id": "e46edf0d-d463-32a1-a285-014d11feda2e",
                        "entry_id": "9858b6ed-a63e-3a7c-a7cf-cbdf68cfdcfc",
                        "glosses": [
                            "Homme qui bidouille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7dc3d0e-0d4e-4b87-b8e3-7c5427fa6bf3",
                                "sense_id": "e46edf0d-d463-32a1-a285-014d11feda2e",
                                "text": "Un hacker connu sous le pseudonyme de Musclenerd, très actif dans la communauté des « bidouilleurs » de l’iPhone, a revendiqué le débridage ou « jailbreak » (« évasion de prison ») de l’iPad, la nouvelle tablette tactile d’Apple, moins de quarante-huit heures après sa sortie aux États-Unis."
                            },
                            {
                                "example_id": "47b89a91-431c-49b9-9886-f62578c5babf",
                                "sense_id": "e46edf0d-d463-32a1-a285-014d11feda2e",
                                "text": "Tandis que l’adjointe aux cultures (sic) de Grenoble propose que soit installé dans les espaces débarrassés des bouquins un « fab lab », coûteuse machine numérique pour bidouilleurs high-tech."
                            },
                            {
                                "example_id": "04df8cd1-08c3-4b82-ba49-b72295167c9f",
                                "sense_id": "e46edf0d-d463-32a1-a285-014d11feda2e",
                                "text": "Les bidouilleurs de moteurs, qui adorent gonfler les performances des voitures les plus banales pour mieux surprendre leur monde, sont priés d’aller voir ailleurs."
                            },
                            {
                                "example_id": "c705064f-645f-4815-a8d7-8df3e1bb4c05",
                                "sense_id": "e46edf0d-d463-32a1-a285-014d11feda2e",
                                "text": "Les espions sont devenus des agents de renseignement habilités, ultraqualifiés, surcontrôlés. […]. Mister Q, le bidouilleur de Bond, est devenu expert en numérique. Il traque les logiciels espions, fait parler les données et la reconnaissance faciale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf9307ab-dc90-4da1-831d-1f5c7a6f1b57",
