                    {
                        "translation_id": "9a763e5b-2422-442b-9621-18f05599a02f",
                        "source_entry_id": "aa3d880f-1684-3b6e-ba91-e921749695f9",
                        "source_sense_id": "72eb9b3c-17b7-322f-a7b0-0ac7b76356fe",
                        "target_lang_word": "competent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "competent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Having sufficient skill, knowledge, ability, or qualifications."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89350273-d8cc-4bf1-b25e-6c12884199da",
                                                "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                                "text": "He is a competent skier and an expert snowboarder."
                                            },
                                            {
                                                "example_id": "771532ae-d746-4da6-98e5-d657990b9ae8",
                                                "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                                "text": "I believe in that myself because it has been explained by competent men as the convolutions of the grey matter."
                                            },
                                            {
                                                "example_id": "9cfa09c6-3425-4bdb-90a4-cf5c49649684",
                                                "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                                "text": "That as a competent keyless citizen he had proceeded energetically from the unknown to the known through the incertitude of the void."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Having jurisdiction or authority over a particular issue or question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4526445c-9655-4139-a33e-068d7d6e632b",
                                                "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                                                "text": "For any disagreements arising from this contract, the competent court shall be the Springfield Circuit Court."
                                            },
                                            {
                                                "example_id": "0a307a4a-1990-41f3-a04a-84b29b6065e4",
                                                "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                                                "text": "judicial authority having competent jurisdiction"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8610abb-87e5-3107-b1fe-ddcad8fb544f",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Adequate for the purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ed5c2c-5424-46c5-b759-8de43c460cff",
                                                "sense_id": "c8610abb-87e5-3107-b1fe-ddcad8fb544f",
                                                "text": "For if they [birds] had been Viviparous, the burthen of their womb, if they had brought forth any competent number at a time, had been ſo big and heavy, that their wings would have failed them, and ſo every body would have had the wit to catch the Old one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3dad82-30f7-3549-ad68-fba7eb70a7c6",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Functionally in order; functioning adequately."
                                        ],
                                        "tags": [
                                            "of an organ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5bc40ff-76cc-4d27-a98f-3595bb0f9f1c",
                                                "sense_id": "4e3dad82-30f7-3549-ad68-fba7eb70a7c6",
                                                "text": "a competent sphincter;   a competent cervix;   a competent immune system"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ff79dbc-6430-3397-8be0-a590aeb3379a",
