            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6c39016-4713-3dcf-8618-d0d8d819134f",
                    "sense_definition": "een apparaat of functie aanzetten of in werking stellen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "apparatuur bedienen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om het alarm <w>in</w> te <w>schakelen</w> voordat je het huis verlaat.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>switch on</w> the alarm before you leave the house."
                            }
                        },
                        {
                            "text": "Hij had de meetapparatuur net <w>ingeschakeld</w> toen de vulkaan heftig vuur begon te spugen.",
                            "target_lang_translations": {
                                "en": "He had just <w>activated</w> the measuring equipment when the volcano began to spew fire violently."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanzetten",
                        "activeren"
                    ],
                    "antonyms": [
                        "uitschakelen"
                    ],
                    "common_phrases": [
                        "het alarm inschakelen",
                        "de hulp inschakelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To turn on or activate a device or function"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to switch on",
                                "target_lang_sense_clarification": "to activate a device using a switch"
                            },
                            {
                                "target_lang_word": "to turn on",
                                "target_lang_sense_clarification": "to start a machine or light"
                            },
                            {
                                "target_lang_word": "to activate",
                                "target_lang_sense_clarification": "to make a system or function operational"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "995151dd-ef3e-3a01-b5b6-5e602fe2d832",
                    "sense_definition": "de hulp van een persoon of organisatie vragen bij een bepaalde zaak",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hulp betrekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie besloot een expert <w>in</w> te <w>schakelen</w> om het bewijsmateriaal te onderzoeken.",
                            "target_lang_translations": {
                                "en": "The police decided to <w>call in</w> an expert to examine the evidence."
                            }
                        },
                        {
                            "text": "Hij had een privédetective <w>ingeschakeld</w> om zijn vermiste broer te vinden.",
                            "target_lang_translations": {
                                "en": "He had <w>engaged</w> a private detective to find his missing brother."
                            }
                        }
                    ],
                    "synonyms": [
                        "betrekken",
                        "raadplegen",
                        "erbij halen"
                    ],
                    "common_phrases": [
                        "een advocaat inschakelen",
                        "de politie inschakelen",
                        "hulp inschakelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To call in or involve the help of a person or organization for a specific matter"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to call in",
                                "target_lang_sense_clarification": "to ask for professional help or services"
                            },
                            {
                                "target_lang_word": "to involve",
                                "target_lang_sense_clarification": "to bring someone into a situation for assistance"
                            },
                            {
                                "target_lang_word": "to engage",
                                "target_lang_sense_clarification": "to hire or use the services of a professional"
                            }
                        ]
                    }
                }
            ]
        }
    ]
