                                "target_senses": [
                                    {
                                        "sense_id": "8589c27d-0500-3770-acda-c4b5f88640c9",
                                        "entry_id": "5332225a-517d-3717-b7e8-f8299b27fefa",
                                        "glosses": [
                                            "spindelförmiges, im Wasser jagendes Raubtier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9376adbb-596b-4ba1-b548-21104c766599",
                                                "sense_id": "8589c27d-0500-3770-acda-c4b5f88640c9",
                                                "text": "Robben kommen in Deutschland zum Beispiel an der Nordsee vor."
                                            },
                                            {
                                                "example_id": "7a9f8374-9aa0-473c-a01f-f27964e7777d",
                                                "sense_id": "8589c27d-0500-3770-acda-c4b5f88640c9",
                                                "text": "„Vielleicht war es eine große Robbe oder ein Walross, das sich bei dem schönen Wetter sonnte.“"
                                            },
                                            {
                                                "example_id": "86d20a77-3566-4d20-a7ff-88b0d997da4b",
                                                "sense_id": "8589c27d-0500-3770-acda-c4b5f88640c9",
                                                "text": "„Es wurden also Ausweichzonen geschaffen, in denen die Robben ungestört sind.“"
                                            },
                                            {
                                                "example_id": "4e226b23-4659-40ee-85f7-7fae05c001de",
                                                "sense_id": "8589c27d-0500-3770-acda-c4b5f88640c9",
                                                "text": "„Auf den flachen Sandbänken des Eilands sonnten sich große Robben, die sich der Ingenieur bei Gelegenheit einmal näher anschauen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
