                "translations": [
                    {
                        "translation_id": "3fe4dedd-b903-4cfb-94c2-71ba52cae699",
                        "source_entry_id": "731fff1f-906f-30cb-9f40-c3ad0b1ee595",
                        "source_sense_id": "1506e77f-a894-3bc3-afc2-64f8d80b0371",
