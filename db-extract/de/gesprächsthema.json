                "senses": [
                    {
                        "sense_id": "5df6d42f-2d0a-396c-8f01-c99716b22921",
                        "entry_id": "58607479-f3d6-38e9-9fb3-7430d39f5279",
                        "glosses": [
                            "Thema, über das ein Gespräch stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a8d10e-f7cb-421b-9481-6df2887c5a30",
                                "sense_id": "5df6d42f-2d0a-396c-8f01-c99716b22921",
                                "text": "„Fortan gab es auf dem Hof kein anderes Gesprächsthema mehr.“"
                            },
                            {
                                "example_id": "57589e23-6146-4a66-aae7-c580a4a19817",
                                "sense_id": "5df6d42f-2d0a-396c-8f01-c99716b22921",
                                "text": "„Der Gast mußte sich nie die Mühe machen, selbst irgendein Gesprächsthema zu finden.“"
                            },
                            {
                                "example_id": "6cd1f438-4e06-4ffc-811b-e92fb2094e91",
                                "sense_id": "5df6d42f-2d0a-396c-8f01-c99716b22921",
                                "text": "„Nach einem ausgiebigen zweiten Frühstück mit außergewöhnlichen Gesprächsthemen sattelten wir erneut unsere Räder.“"
                            },
                            {
                                "example_id": "07369cf5-f66f-4fc6-bfc1-3dddd82631db",
                                "sense_id": "5df6d42f-2d0a-396c-8f01-c99716b22921",
                                "text": "„Die Gesprächsthemen waren verbraucht, die Verhandlungspartner erschöpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
