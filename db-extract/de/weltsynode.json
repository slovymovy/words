                "senses": [
                    {
                        "sense_id": "a792ef5c-695a-382b-a58f-79fa99973eb8",
                        "entry_id": "9c2b0df9-a203-35be-8e0b-892c4fd29a38",
                        "glosses": [
                            "weltweite Bischofssynode"
                        ],
                        "tags": [
                            "römisch-katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "6fc9735e-b202-42dc-a88a-8c85e6c0bc82",
                                "sense_id": "a792ef5c-695a-382b-a58f-79fa99973eb8",
                                "text": "„Kritisch hat die von Jesuiten geleitete züricher Halbmonatsschrift ›Orientierung‹ in zwei Nummern über die ›Sechste Ordentliche Vollversammlung‹ der Weltsynode der katholischen Bischöfe berichtet, die vom 29. September bis zum 29. Oktober in Rom getagt hat.“"
                            },
                            {
                                "example_id": "744bba07-6279-4d55-8e4f-ced3dc50bda0",
                                "sense_id": "a792ef5c-695a-382b-a58f-79fa99973eb8",
                                "text": "„Er sagte während der ersten Woche der Weltsynode der katholischen Bischöfe […]: ‚Seit Jahrzehnten greift der Glaube an den Menschen um sich, um den Glauben an Gott zu ersetzen.‘“"
                            },
                            {
                                "example_id": "98bb5382-4eff-4bfd-b224-3362fc943b9e",
                                "sense_id": "a792ef5c-695a-382b-a58f-79fa99973eb8",
                                "text": "„Aus Verantwortung gegenüber den Gemeinden und mit einem klaren Blick für afrikanische (und weltkirchliche) pastorale Erfordernisse schlägt Bischof Lobinger die Weihe von Gemeindeleiterteams vor, deren Einführung nach seiner Vorstellung nach gründlichen Studien auf einer Weltsynode der Bischöfe oder auf einem Konzil diskutiert und entschieden werden müsste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f6e5c83b-7c30-3203-bf44-4ccb1ab24b93",
                        "entry_id": "9c2b0df9-a203-35be-8e0b-892c4fd29a38",
                        "glosses": [
                            "weltweiter synodaler Beratungsprozess auf verschiedenen Ebenen mit am Ende einer Versammlung der Bischofssynode, an der auch Ordensleute und Laien teilnehmen"
                        ],
                        "tags": [
                            "römisch-katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "333d88e5-835a-451b-9cc4-36f7bfc4d1d0",
                                "sense_id": "f6e5c83b-7c30-3203-bf44-4ccb1ab24b93",
                                "text": "„Die sogenannte ‚kontinentale Etappe‘ der vom Papst auf den Weg gebrachten Weltsynode ist am Freitag, 31. März, offiziell zu Ende gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
