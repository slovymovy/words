                        "entry_id": "4ae0d530-3335-3fb2-9fe6-78d8ea9d892c",
                        "glosses": [
                            "Angehöriger eines zu den Khoikhoi zählenden Volkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1944f1a1-e6fa-4262-b38b-5f6b874cd222",
                                "sense_id": "239614a7-f1fa-33b9-8511-c028a96711d7",
                                "text": "Er ist Nama."
                            },
                            {
                                "example_id": "5b278158-adee-4535-958a-afc0afd762d8",
                                "sense_id": "239614a7-f1fa-33b9-8511-c028a96711d7",
                                "text": "„Die deutschen Soldaten wurden zudem gebraucht, um die weiter südlich lebenden Nama - von den Deutschen abschätzig »Hottentotten« genannt - zu bekämpfen.“"
                            },
                            {
                                "example_id": "c20c59eb-f937-4156-8665-7b1624bd4f2e",
                                "sense_id": "239614a7-f1fa-33b9-8511-c028a96711d7",
                                "text": "„Dabei kannte das traditionelle Recht der Nama keine ausschließliche Nutzung von Wasserstellen, Weiden oder Wegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
