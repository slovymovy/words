                        "examples": [
                            {
                                "example_id": "5cd9f32b-9071-43b6-b79f-96341a0bcacd",
                                "sense_id": "2d32570f-721e-3152-970e-2e9dfa8da91f",
                                "text": "„Court spurtete weiter, übers weite Grün auf einen dichteren Kiefernhain zu, und gerade als er zu hoffen wagte, er hab es geschafft, ohne dass sie auf ihn schossen, bellte hinter ihm das MP5-Feuer los.“"
                            },
                            {
                                "example_id": "f0037df2-adbf-4812-8a6f-efe705e5224e",
                                "sense_id": "2d32570f-721e-3152-970e-2e9dfa8da91f",
                                "text": "„Einmal musste der Wagen einem dichten Kiefernhain ausweichen, der bis ans Ufer reichte; die Männer umrundeten ihn auf der Landseite, nur Miller folgte dem Fluss.“"
                            }
                        ],
