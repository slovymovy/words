                        "examples": [
                            {
                                "example_id": "b20b65a9-1dd1-4e91-ac0e-c0485237d1ff",
                                "sense_id": "9618a050-9262-3b91-9c78-286093d0115a",
                                "text": "Vandaag worden de in pekelwater ingemaakte weegbreenopjes geproefd."
                            },
                            {
                                "example_id": "acb8f46c-d683-496e-a844-de33bb440ee3",
                                "sense_id": "9618a050-9262-3b91-9c78-286093d0115a",
                                "text": "De wegbeheerders worden dringend opgeroepen het schaarse zout waar mogelijk te gebruiken voor de aanmaak van pekelwater. Daardoor kan er vijf keer zo vaak worden gestrooid dan met alleen zout, aldus Rijkswaterstaat."
                            },
                            {
                                "example_id": "3552c0c8-f253-466f-b204-fb259101b17b",
                                "sense_id": "9618a050-9262-3b91-9c78-286093d0115a",
                                "text": "De Groningse ondernemer Bert Alfing uit Termunterzijl denkt de oplossing te hebben gevonden voor het tekort aan strooizout. Alfing heeft een machine ontwikkeld die pekelwater over het wegdek sproeit, liet hij maandag weten. Pekelwater is volgens hem een goed alternatief om wegen sneeuw- en ijsvrij te maken."
                            }
                        ]
                    },
