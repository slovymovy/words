                "senses": [
                    {
                        "sense_id": "512c9a9a-b0df-317e-be33-503b842a0ba7",
                        "entry_id": "c243a9f6-9a1d-3b8b-ab28-429a9ed9dc3d",
                        "glosses": [
                            "durch das Verbrennen von Kerosin betriebene Lampe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79fbd32-708d-431d-b879-808f2a03657b",
                                "sense_id": "512c9a9a-b0df-317e-be33-503b842a0ba7",
                                "text": "„Ein Wunder, dass Lovecraft mit seiner Kerze und Kerosinlampe nicht das Haus in Brand setzte.“"
                            },
                            {
                                "example_id": "b1f0ae37-0d6d-4e9c-b64d-623f413abc52",
                                "sense_id": "512c9a9a-b0df-317e-be33-503b842a0ba7",
                                "text": "„Seine Hände flogen wie wild hin und her, seine stampfenden Füße wirbelten Staub hoch in die Luft und der gelbliche Strahl der Kerosinlampe tauchte ihn in golden schimmerndes Licht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
