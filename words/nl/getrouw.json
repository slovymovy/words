                        "es": "Alguien que sigue brindando apoyo y lealtad a una persona, creencia o principio."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "faithful",
                                "target_lang_sense_clarification": "loyal and constant in support"
