                    "sense_definition": "Een kortstondige periode van neerslag, zoals regen, hagel of sneeuw.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De plotselinge <w>bui</w> zorgde voor veel ongelukken op de weg.",
                            "target_lang_translations": {
                                "en": "The sudden <w>shower</w> caused many accidents on the road.",
                                "ru": "Внезапный <w>ливень</w> стал причиной множества аварий на дороге.",
                                "pl": "Nagła <w>ulewa</w> spowodowała wiele wypadków na drodze.",
                                "de": "Der plötzliche <w>Schauer</w> verursachte viele Unfälle auf der Straße.",
                                "fr": "L'un <w>averse</w> soudaine a causé de nombreux accidents sur la route.",
                                "it": "L'improvviso <w>acquazzone</w> ha causato molti incidenti sulla strada.",
                                "cs": "Náhlá <w>přeháňka</w> způsobila na silnici mnoho nehod.",
                                "tr": "Ani <w>sağanak</w> yolda birçok kazaya neden oldu.",
                                "es": "El repentino <w>chubasco</w> causó muchos accidentes en la carretera."
                            }
                        },
                        {
                            "text": "We wachten even binnen tot de zware <w>bui</w> overgetrokken is.",
                            "target_lang_translations": {
                                "en": "We'll wait inside for a bit until the heavy <w>shower</w> has passed.",
                                "ru": "Мы подождем внутри, пока сильный <w>ливень</w> не пройдет.",
                                "pl": "Poczekamy chwilę w środku, aż ta silna <w>ulewa</w> przejdzie.",
                                "de": "Wir warten kurz drinnen, bis der schwere <w>Schauer</w> vorbeigezogen ist.",
                                "fr": "Nous attendons un peu à l'intérieur que la forte <w>averse</w> soit passée.",
                                "it": "Aspettiamo un attimo dentro finché il forte <w>rovescio</w> non sarà passato.",
                                "cs": "Počkáme chvíli uvnitř, dokud ten silný <w>leják</w> nepřejde.",
                                "tr": "Şiddetli <w>sağanak</w> geçene kadar içeride biraz bekleyeceğiz.",
                                "es": "Esperaremos un momento adentro hasta que pase el fuerte <w>aguacero</w>."
                            }
                        }
