                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eba9eae2-b428-3ba2-beaf-ea07201782cb",
                                        "entry_id": "c100d500-237c-3a02-97e2-f5357760fed5",
                                        "glosses": [
                                            "Poisson d’eau douce d’Amérique du Nord de la famille des Catostomidae."
                                        ],
                                        "tags": [],
