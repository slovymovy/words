                                "example_id": "13830a40-011e-40aa-bd93-347155818f0f",
                                "sense_id": "55b7951b-8c1c-32e0-92c9-b2f4d08e0aa2",
                                "text": "„Sie trug ein weißes, mit Blumen besticktes Sommerkleidchen.“"
                            },
                            {
                                "example_id": "d59ed5eb-fb3f-4a6e-9aaf-61e2f47b6341",
                                "sense_id": "55b7951b-8c1c-32e0-92c9-b2f4d08e0aa2",
                                "text": "„Diese Engel, so hübsch in ihren mit Blumen bedruckten Sommerkleidchen, mit ihren adrett zurückgebundenen Haaren.“"
                            }
