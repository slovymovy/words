{
    "word_family": [
        "deplete",
        "depletion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9041a0d8-7828-3622-bb3f-b10ac2486c40",
                    "sense_definition": "Used up or expended so that little or nothing remains.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhausted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>depleted</w> battery could no longer power the device for more than a few minutes.",
                            "target_lang_translations": {
                                "pl": "<w>Wyczerpana</w> bateria nie była już w stanie zasilać urządzenia przez więcej niż kilka minut."
                            }
                        },
                        {
                            "text": "After the long drought, the town's water supply was completely <w>depleted</w>.",
                            "target_lang_translations": {
                                "pl": "Po długiej suszy zapasy wody w mieście zostały całkowicie <w>wyczerpane</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spent",
                        "used up",
                        "consumed",
                        "exhausted",
                        "expended",
                        "gone",
                        "finished",
                        "low"
                    ],
                    "antonyms": [
                        "overflowing",
                        "plentiful",
                        "replete",
                        "undepleted",
                        "unexpended"
                    ],
                    "common_phrases": [
                        "depleted resources",
                        "severely depleted"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zużyty lub wyczerpany w taki sposób, że pozostało go niewiele lub wcale."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyczerpany",
                                "target_lang_sense_clarification": "odnoszące się do zasobów lub energii"
                            },
                            {
                                "target_lang_word": "zużyty",
                                "target_lang_sense_clarification": "odnoszące się do materiałów lub zapasów"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e662b0f7-89f7-36d6-9846-159eb3b437fb",
                    "sense_definition": "Simple past and past participle of <w>deplete</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhausted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>depleted</w> its cash reserves to pay for the new factory equipment.",
                            "target_lang_translations": {
                                "pl": "Firma <w>wyczerpała</w> swoje rezerwy gotówkowe, aby zapłacić za nowy sprzęt fabryczny."
                            }
                        },
                        {
                            "text": "They have <w>depleted</w> all the available options before deciding to close the project.",
                            "target_lang_translations": {
                                "pl": "Zanim zdecydowali się zamknąć projekt, <w>wyczerpali</w> wszystkie dostępne opcje."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego czasownika 'deplete' (wyczerpywać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyczerpał",
                                "target_lang_sense_clarification": "forma czasu przeszłego"
                            },
                            {
                                "target_lang_word": "wyczerpany",
                                "target_lang_sense_clarification": "imiesłów bierny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}