                                    },
                                    {
                                        "sense_id": "151ba6d5-daf4-356a-a429-e9c8501eb8f4",
                                        "entry_id": "02964e7d-35e1-320f-ba42-cbdc12979de4",
                                        "glosses": [
                                            "Prohibición o imposibilidad de ejercer un cargo u oficio, en especial uno público, generalmente como castigo o por un conflicto de intereses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64e1b88-5d2e-4380-ba4e-74b11f1ee843",
                                                "sense_id": "151ba6d5-daf4-356a-a429-e9c8501eb8f4",
                                                "text": "Su corrupción finalmente le trajo la destitución e inhabilidad para ser elegido en votaciones futuras."
                                            }
