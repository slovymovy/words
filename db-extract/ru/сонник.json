                    {
                        "sense_id": "6f40a7da-c02c-3298-a18f-1b337636431c",
                        "entry_id": "289bdb30-8083-3edb-8489-45f6e789f8da",
                        "glosses": [
                            "книга, содержащая толкование снов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b70adc9-a3d1-4ccd-bbd8-47f343945690",
                                "sense_id": "6f40a7da-c02c-3298-a18f-1b337636431c",
                                "text": "То вдруг велит науки прекратить, а молодых людей исключительно с одними сонниками знакомить, а потом, смотришь, сонники в печку полетели, а науки опять в чести сделались."
                            }
                        ]
                    }
