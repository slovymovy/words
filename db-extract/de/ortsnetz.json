                                    {
                                        "sense_id": "f212e84f-4ef5-3ed6-83a0-6359f9acf16f",
                                        "entry_id": "14223175-587f-34a8-b661-d95f0c599da2",
                                        "glosses": [
                                            "Ensemble connexe, à caractère privatif, de moyens de communication établi sur un site restreint, pourvu de règles de gestion du trafic et permettant des échanges internes d’informations de toute nature, notamment sous forme de données, sons, images, etc."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6250d76d-3dd6-495c-b87b-b1a5261db664",
                                                "sense_id": "f212e84f-4ef5-3ed6-83a0-6359f9acf16f",
                                                "text": "Deux ordinateurs reliés entre eux forment un réseau local."
                                            },
                                            {
                                                "example_id": "6472227e-aaed-4809-9925-6c003d95567a",
                                                "sense_id": "f212e84f-4ef5-3ed6-83a0-6359f9acf16f",
                                                "text": "Apple invente les micro-ordinateurs type MacIntosh munis d’écrans graphiques (copiés sur ceux du centre de recherches de Xerox). Et la notion de réseau local se développe, notamment le réseau Éthernet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
