                ],
                "senses": [
                    {
                        "sense_id": "46efe2cb-fb2c-3e62-abb0-ce077786020b",
                        "entry_id": "44768310-4b2f-3afc-b97e-6aae532b0d3f",
                        "glosses": [
                            "den Süden Kaliforniens (Südkalifornien) betreffend, zu ihm gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5225c850-6fc9-47b4-b60e-3a91d04f406d",
                                "sense_id": "46efe2cb-fb2c-3e62-abb0-ce077786020b",
                                "text": "„Weil der Pilot sein Fluggerät von der enormen Hitze fernhalten musste, zeigte die Kamera ein Panorama der südkalifornischen Küstenregion rund um den Hafen.“"
                            },
                            {
                                "example_id": "66ad5fc7-f9c3-4b2c-af8c-975bb68098fb",
                                "sense_id": "46efe2cb-fb2c-3e62-abb0-ce077786020b",
                                "text": "„Er schlug die Augen auf und blickte durch die gläserne Schiebetür, hinter der die Sonne wie eine fette Orange im Dunst des südkalifornischen Morgens hockte.“"
                            },
                            {
                                "example_id": "cfece509-434d-411c-9d81-8c90a092a249",
                                "sense_id": "46efe2cb-fb2c-3e62-abb0-ce077786020b",
                                "text": "„›Diese Hunde haben insgesamt sechzehn gewonnen. Südkalifornischer Rekord für einen einzelnen Stall.‹“"
