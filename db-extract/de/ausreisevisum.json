                "senses": [
                    {
                        "sense_id": "71884fe3-8300-32b6-ba4e-c3801d518481",
                        "entry_id": "7b8baa67-312f-369b-84ef-2f2227b935a2",
                        "glosses": [
                            "Bestätigung, die für das Verlassen eines Landes erforderlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b555c72-b0c3-44f7-85d0-d1274de4f986",
                                "sense_id": "71884fe3-8300-32b6-ba4e-c3801d518481",
                                "text": "Für die Ausreise aus unserem Land benötigt man ein Ausreisevisum."
                            },
                            {
                                "example_id": "db986900-5e53-40fb-9cc3-6289329b2b36",
                                "sense_id": "71884fe3-8300-32b6-ba4e-c3801d518481",
                                "text": "„Er konnte weder ein Ausreisevisum aus Frankreich noch ein Einreisevisum nach Spanien bekommen.“"
                            },
                            {
                                "example_id": "aaa36b33-c964-4f2f-821c-118c8f9f5ec0",
                                "sense_id": "71884fe3-8300-32b6-ba4e-c3801d518481",
                                "text": "„Was er nämlich nicht besaß, war ein Ausreisevisum aus Frankreich, das die Vichy-Regierung damals prinzipiell verweigerte, um der Gestapo gefällig zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
