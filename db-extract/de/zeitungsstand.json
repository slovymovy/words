                        "examples": [
                            {
                                "example_id": "6b197d45-a95a-46e1-a742-e78f6d4a4de6",
                                "sense_id": "bc8b85e3-a470-353b-818c-1e98dd4c0b2a",
                                "text": "„An der Chausseestraßen-Ecke ist ein Zeitungsstand im Hausflur, da stehen welche, quasseln.“"
                            },
                            {
                                "example_id": "3c1acec8-7992-49f4-aaa7-d6029c66b967",
                                "sense_id": "bc8b85e3-a470-353b-818c-1e98dd4c0b2a",
                                "text": "„An einer Kreuzung, direkt neben einem Zeitungsstand hockte ein Alter neben einem Stuhl mit rotem Bezug.“"
                            },
                            {
                                "example_id": "63753b46-5514-46ff-ba82-e6bc2bb05640",
                                "sense_id": "bc8b85e3-a470-353b-818c-1e98dd4c0b2a",
                                "text": "„Ich kam zu einem Zeitungsstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
