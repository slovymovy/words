                    {
                        "translation_id": "b8c3de99-47e4-4f45-8b56-fe8d88f3cc08",
                        "source_entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                        "source_sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                        "target_lang_word": "medeleerling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medeleerling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff824d4-d4f1-3c86-9c83-9cce6413a510",
                                        "entry_id": "185baa49-0a53-3ea9-9599-e2ec7f860dd0",
                                        "glosses": [
                                            "iemand waarmee men samen op school zit; iemand waarmee men samen les heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb27c784-4d38-4da3-9973-472e066d7f91",
                                                "sense_id": "3ff824d4-d4f1-3c86-9c83-9cce6413a510",
                                                "text": "De leerling van het Corbulo College in Voorburg die ervan wordt verdacht dat hij een medeleerling met een mes heeft doodgestoken, werd jarenlang stelselmatig en intensief gepest. Dat zegt advocaat Hajé Weisfelt, die de 16-jarige verdachte Anthony bijstaat."
                                            },
                                            {
                                                "example_id": "1235446b-54af-472e-9ecf-7fad9d3f5c8c",
                                                "sense_id": "3ff824d4-d4f1-3c86-9c83-9cce6413a510",
                                                "text": "Na het dodelijke steekincident op het Corbulo-college is de discussie over pesten weer opgelaaid. De gepeste 16-jarige Anthony stak zijn 15-jarige medeleerling Wesley neer, die overleed aan zijn verwondingen. Hebben programma's op scholen om pesten tegen te gaan wel zin?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "662c0e0d-404f-471b-991a-67e50f98aaec",
                        "source_entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                        "source_sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                        "target_lang_word": "klasgenoot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klasgenoot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4fffa858-76a0-3a0f-8573-818a49d39705",
                                        "entry_id": "0a0a75a1-6121-3238-a74c-4dcfb9cc6c0a",
                                        "glosses": [
                                            "een medeleerling, iemand die in dezelfde schoolklas zit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20cdae98-5188-4ede-8769-e471ac74d0c6",
                                                "sense_id": "4fffa858-76a0-3a0f-8573-818a49d39705",
                                                "text": "De mening van klasgenoten is vaak belangrijker dan wat de leraar vindt."
                                            },
                                            {
                                                "example_id": "8b234df1-83f1-4856-98d6-097844ce8af0",
                                                "sense_id": "4fffa858-76a0-3a0f-8573-818a49d39705",
                                                "text": "Opperste concentratie in de coulissen van De Bond. Gespannen staan de leerlingen uit groep 8C van de basisschool Drie-eenheid maandagmorgen naar hun klasgenoten te kijken die op dat moment in de schijnwerpers staan. Als er al wat wordt gezegd, gebeurt dat op een fluistertoon die op de bühne niet te horen is."
                                            },
                                            {
                                                "example_id": "57e98a35-5659-4cbe-8346-61639c8cddea",
                                                "sense_id": "4fffa858-76a0-3a0f-8573-818a49d39705",
                                                "text": "Ernst Jünger was de favoriete schrijver van al zijn klasgenoten. Er werd gezegd dat hij nu de meest gelezen Duitse schrijver ooit was geworden. Hoe dat precies kon, was niet helemaal duidelijk, hij kon nu toch niet al meer lezers hebben dan Goethe? Niet in heel Duitsland toch?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
