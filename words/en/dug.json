                                "target_lang_sense_clarification": "Präteritum von graben"
                            },
                            {
                                "target_lang_word": "gegraben",
                                "target_lang_sense_clarification": "Partizip Perfekt von graben"
                            }
                        ]
                    }
                }
            ]
        },
        {
