            "senses": [
                {
                    "sense_id": "7d86199c-8b95-353d-9926-79a2ba2e3fae",
                    "sense_definition": "Shrivelled, shrunken or faded, especially due to lack of water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vase was filled with <w>withered</w> flowers that had not been watered for over a week.",
                            "target_lang_translations": {
                                "de": "Die Vase war mit <w>verwelkten</w> Blumen gefüllt, die seit über einer Woche nicht mehr gegossen worden waren.",
                                "nl": "De vaas was gevuld met <w>verwelkte</w> bloemen die al meer dan een week geen water hadden gehad."
                            }
                        },
                        {
                            "text": "He stared at the <w>withered</w> leaves scattered across the dry garden path.",
                            "target_lang_translations": {
                                "de": "Er starrte auf die <w>verdorrten</w> Blätter, die auf dem trockenen Gartenweg verstreut lagen.",
                                "nl": "Hij staarde naar de <w>verdorrde</w> bladeren die verspreid lagen over het droge tuinpad."
                            }
                        }
                    ],
                    "synonyms": [
                        "shriveled",
                        "shrunken",
                        "faded",
                        "dried-up"
                    ],
                    "antonyms": [
                        "fresh",
                        "blooming",
                        "flourishing"
                    ],
                    "common_phrases": [
                        "withered flowers",
                        "withered leaves",
                        "withered branches"
                    ],
                    "target_lang_definitions": {
                        "de": "Schrumpelig, geschrumpft oder verblasst, insbesondere aus Mangel an Wasser.",
                        "nl": "Verschrompeld, ingedroogd of verlept, vooral door een gebrek aan water."
                    },
                    "translations": {
