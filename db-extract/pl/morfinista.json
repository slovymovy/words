                    {
                        "translation_id": "01759564-109f-45d5-93f3-2d1751ca87f7",
                        "source_entry_id": "37787a28-67e5-3e99-873e-1a02d5630c75",
                        "source_sense_id": "4e1c3e50-e150-3d6a-bf25-791490fcb93f",
                        "target_lang_word": "morphinomane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morphinomane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6544cba5-5157-35ce-bf6d-9af5d2a2b3b6",
                                        "entry_id": "3e9eccce-396d-3080-9181-be0b5f0abdeb",
                                        "glosses": [
                                            "Qui a contracté l’habitude de la morphine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50cea1b9-60be-4a6d-b04f-e20c62e0f36e",
                                                "sense_id": "6544cba5-5157-35ce-bf6d-9af5d2a2b3b6",
                                                "text": "Nous devons ici faire quelques réserves cependant : l’éthéromanie ne suffit pas à expliquer chez notre malade les actes dont il s'agit ; mais plus tard, lorsqu'elle sera devenue morphinomane, elle commettra de nouveaux vols ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morphinomane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8596e601-9865-3c21-8b23-57518fd40784",
                                        "entry_id": "62c31caf-d5f6-3db1-a7ac-aef7ceee8abb",
                                        "glosses": [
                                            "Celui ou celle qui a contracté l’habitude de la morphine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9aa1fa1-302b-47f2-8d2b-fa2da92d9880",
                                                "sense_id": "8596e601-9865-3c21-8b23-57518fd40784",
                                                "text": "Blanche, la morphinomane, riait sans comprendre et Suzanne, machinale, lui donnait le bras…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1245678-9b5a-48c8-b741-43b51f6f8a93",
                        "source_entry_id": "37787a28-67e5-3e99-873e-1a02d5630c75",
                        "source_sense_id": "4e1c3e50-e150-3d6a-bf25-791490fcb93f",
                        "target_lang_word": "morfinómano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b98656cd-e284-41ba-9378-052c2c24c5e0",
                        "source_entry_id": "37787a28-67e5-3e99-873e-1a02d5630c75",
                        "source_sense_id": "4e1c3e50-e150-3d6a-bf25-791490fcb93f",
                        "target_lang_word": "Morphinist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morphinist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                        "entry_id": "3be94dd2-f27c-3b0a-a7c0-795722e17966",
                                        "glosses": [
                                            "eine Person, die nach Morphium süchtig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771a9ac1-a3ca-4479-a68f-af16a0c356d1",
                                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                                "text": "Unter Ärzten und deren Patienten gibt es nicht wenige langjährige Morphinisten."
                                            },
                                            {
                                                "example_id": "ddbe3124-b60b-4027-9454-fcd1fdabe9aa",
                                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                                "text": "Als schließlich das Deutsche Reich 1929 das Internationale Opiumabkommen von 1912 unterschrieb, war schlagartig mit der Legalität Schluß, und die Morphinisten starben wie die Fliegen, falls es ihnen nicht gelang, sich illegal ihre tägliche Dosis zu besorgen."
                                            },
                                            {
                                                "example_id": "aa2df947-57af-4975-85a1-9b15a92fee6e",
                                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                                "text": "„Er ist noch kein Morphinist, weit entfernt, er kommt manchmal fünf, sechs Tage ohne Morphium aus, aber wenn Schwierigkeiten auf seinem Lebenswege auftauchen, und diese Schwierigkeiten häufen sich jetzt während des Krieges immer mehr, so nimmt er Morphium.“"
                                            },
                                            {
                                                "example_id": "99696cf1-5a0e-432b-9440-a48421712fd9",
                                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                                "text": "„Bei Morphinisten wurde Insulin gegen die Entziehungserscheinungen verwandt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f28dfeb-7838-4b4d-9c01-62c46f1133f9",
                        "source_entry_id": "37787a28-67e5-3e99-873e-1a02d5630c75",
                        "source_sense_id": "4e1c3e50-e150-3d6a-bf25-791490fcb93f",
