                            {
                                "example_id": "54d09250-ce0f-4fbe-a2cf-610273729a06",
                                "sense_id": "def8f9b9-d2c9-336a-8fcb-732ceb7dc3a9",
                                "text": "„Pennsylvania ist geprägt durch Laubwälder und Hügelland.“"
                            },
                            {
                                "example_id": "4cae5f01-9d32-42ee-a4e9-daa16f939b05",
                                "sense_id": "def8f9b9-d2c9-336a-8fcb-732ceb7dc3a9",
                                "text": "[4. Novmber 2024:] „Den Tag vor der Wahl verbringt Vizepräsidentin Harris (60) komplett im Swing State Pennsylvania, der zu den wenigen besonders umkämpften Bundesstaaten gehört, die mal die eine, mal die andere Partei bevorzugen.“"
                            },
                            {
                                "example_id": "bd7f615a-3eb9-4a9d-9a8e-b78b86fb634c",
                                "sense_id": "def8f9b9-d2c9-336a-8fcb-732ceb7dc3a9",
                                "text": "[4. Novmber 2024:] „Ein Gesamtsieg ohne Pennsylvania ist für beide Kandidaten schwer erreichbar.“"
                            },
                            {
                                "example_id": "3e1828b8-17f0-46b0-95ed-1b4f299aecde",
                                "sense_id": "def8f9b9-d2c9-336a-8fcb-732ceb7dc3a9",
                                "text": "Bei einer Bohrung im US-Bundesstaat Pennsylvania ist diese Angst bereits zur Realität geworden. 14 Hausbrunnen wurden verseucht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
