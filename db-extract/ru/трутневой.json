                ],
                "senses": [
                    {
                        "sense_id": "a03771aa-57d9-3347-9db0-87171fb3ffe1",
                        "entry_id": "822db251-bf5a-3a9c-bb63-ceb5b33e8d20",
                        "glosses": [
                            "drone, male bee"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "386a14d8-0b4c-4f67-88f1-a4f90d0725af",
                                "sense_id": "a03771aa-57d9-3347-9db0-87171fb3ffe1",
                                "text": "Все лю́ди э́той па́ртии лови́ли рубли́, кресты́, чины́, и в э́том ловле́нии следи́ли то́лько за направле́нием флю́гера ца́рской ми́лости, и то́лько что замеча́ли, что флю́гер обрати́лся в одну́ сто́рону, как всё э́то трутнево́е населе́ние а́рмии начина́ло дуть в ту же сто́рону, так что госуда́рю тем трудне́е бы́ло поверну́ть его́ в другу́ю.",
                                "translation": "All the men of this party were fishing for rubles, decorations, and promotions, and in this pursuit watched only the weathercock of imperial favor, and directly they noticed it turning in any direction, this whole drone population of the army began blowing hard that way, so that it was all the harder for the Emperor to turn it elsewhere.",
                                "english": "All the men of this party were fishing for rubles, decorations, and promotions, and in this pursuit watched only the weathercock of imperial favor, and directly they noticed it turning in any direction, this whole drone population of the army began blowing hard that way, so that it was all the harder for the Emperor to turn it elsewhere."
                            }
                        ]
                    }
