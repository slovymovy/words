                            {
                                "example_id": "6463855f-a5d6-42a5-b7b2-81d5844a2bd0",
                                "sense_id": "188de37b-88cc-30ce-8e02-6da5f5546c15",
                                "text": "„Ilja nahm einen Eimer Wasser, tröpfelte ein wenig Rum hinein, kam damit zu Marja Genrichowna und bat sie, mit dem Fingerchen umzurühren.“"
                            },
                            {
                                "example_id": "8780ed9d-5914-4a27-a7c7-24e51d71a9eb",
                                "sense_id": "188de37b-88cc-30ce-8e02-6da5f5546c15",
                                "text": "„Ihre Fingerchen lagen schlaff in meiner Faust.“"
                            }
                        ],
