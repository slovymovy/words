                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0c713595-abed-424e-92ad-9bd33814af51",
                        "source_entry_id": "35a56e77-3308-3a5c-a10d-eb0699f59291",
                        "source_sense_id": "67df8d9e-5dd6-3aa1-b678-b70fa18208c3",
                        "target_lang_word": "lycien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lycien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87f2db34-dbe6-36ad-8438-4063f0451da7",
                                        "entry_id": "30398eaf-6164-315d-981b-5c4afcffa616",
                                        "glosses": [
                                            "Relatif à la Lycie, aux Lyciens."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a6cdc8b-ae03-4792-839f-bdffcccfba5a",
                                                "sense_id": "87f2db34-dbe6-36ad-8438-4063f0451da7",
                                                "text": "Au VIIᵉ siècle avant J.-C. le pays lycien, comme toute l'Asie Mineure, est envahi par les Perses."
                                            },
                                            {
                                                "example_id": "7bb34b14-b186-41cb-a04f-4289cc79be6f",
                                                "sense_id": "87f2db34-dbe6-36ad-8438-4063f0451da7",
                                                "text": "Le scepticisme semble mal inspiré quand il s’attaque aux souvenirs les plus vivants de la conscience populaire. Aussi n’est-ce pas sans une vive satisfaction que j’ai trouvé moyen de concilier l’autorité de la complainte avec le silence des anciens biographes du pontife lycien."
                                            },
                                            {
                                                "example_id": "65911d1a-2f15-4989-806c-5c91007018a9",
                                                "sense_id": "87f2db34-dbe6-36ad-8438-4063f0451da7",
                                                "text": "Sur le site de Pinara, des milliers de tombeaux lyciens ont été creusés dans les falaises, témoignant d’un riche passé dont ne demeurent aujourd’hui que des ruines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lycien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c74a9c0d-257c-3dbf-b187-89a6d8583b97",
                                        "entry_id": "a04ab968-bbe2-33c2-aa12-df09df69d63a",
                                        "glosses": [
                                            "Langue de la famille indo-européenne, de la branche des langues anatoliennes, des Vᵉ et IVᵉ siècles av. J.-C."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ebae7f-b683-4b95-910d-35ba3852d72d",
                                                "sense_id": "c74a9c0d-257c-3dbf-b187-89a6d8583b97",
                                                "text": "Le lycien est bien attesté par les nombreuses inscriptions des Vᵉ et IVᵉ siècles avant J.-C., et par une cinquantaine de pièces de monnaie (découvertes sur la côte sud de la Turquie actuelle)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
