                        "cross_references": [
                            {
                                "target_word": "Edith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "723f99e4-baf5-3f5a-815e-9d25fe0316cc",
                                        "entry_id": "a04609fe-92c7-3cd7-8a58-c9f7614612c8",
                                        "glosses": [
                                            "A female given name from Old English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b9ce51-eb00-40f3-8083-806df2d791c0",
                                                "sense_id": "723f99e4-baf5-3f5a-815e-9d25fe0316cc",
                                                "text": "Edith's pretty, but it looks / Better in old English books."
                                            },
                                            {
                                                "example_id": "d99e58bd-23fe-45de-8fd1-49938d27db87",
                                                "sense_id": "723f99e4-baf5-3f5a-815e-9d25fe0316cc",
                                                "text": "But suppose she had had an elder sister with a beautiful name like Edith. My conviction was deep and immovable that had I been named something really pretty like that, I would have found it easy to sew neatly and know my lessons."
                                            },
                                            {
                                                "example_id": "d5c1a891-b047-40a2-b734-0fdb3e01f02e",
                                                "sense_id": "723f99e4-baf5-3f5a-815e-9d25fe0316cc",
                                                "text": "- - but they went and gave it to this woman named Edith, if you can believe that any woman with a name like Edith would have a clue about what's fashionable.\" \"Edith Head?\" I said. \"The Oscar-winning costume designer?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4873e113-f6f8-45a5-8a6d-0f68a4fc390f",
                        "source_entry_id": "078f3206-2d3c-31f7-9066-f3feb01b297b",
                        "source_sense_id": "11d048ab-9082-31c7-91f7-e3609431106a",
