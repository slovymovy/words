                ],
                "senses": [
                    {
                        "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                        "entry_id": "acb711e9-08c9-3a86-b751-18d91d20cb7e",
                        "glosses": [
                            "(meist kleines) Haus, das vorwiegend im Sommer genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f1c070-6ece-4e2d-b12e-20e760ec840c",
                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                "text": "„Wieso kommen noch immer jährlich dutzende Menschen zum Sommerhaus von Heidegger?“"
                            },
                            {
                                "example_id": "e2817acc-e60c-4d1e-b091-7cf4500d62c7",
                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                "text": "„Das gemietete Sommerhaus teilten sie sich stets mit zwei anderen Familien: Bill und Lena Weber, deren Sohn Herbie in Sandys Alter war, und Joe und Selma Green, deren hübsche Tochter Ruth drei Jahre älter war als Philip.“"
                            },
                            {
                                "example_id": "4c9c69fe-3c43-41a8-82ca-824670b1fb20",
                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                "text": "„Im Sommerhaus in der Etage rechts haben wir unsere Betten gefunden.“"
                            },
                            {
                                "example_id": "941da7ce-bc7b-4238-aa0c-b1534757dd0f",
                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                "text": "„Sie waren zusammen mit ihren Eltern ins Sommerhaus gefahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "704c990b-6101-4560-b286-ce052c563f6a",
                        "source_entry_id": "acb711e9-08c9-3a86-b751-18d91d20cb7e",
                        "source_sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                        "source_sense_description": "(meist kleines) Haus, das vorwiegend im Sommer genutzt wird",
                        "target_lang_word": "maison de campagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison de campagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                        "entry_id": "98ceddbc-2272-3f2e-9e43-dafee23e4620",
                                        "glosses": [
                                            "Résidence de repos ou de loisir, en zone rurale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df22f40d-3c9c-4421-affc-08586b5122c1",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Nous avons notre petite ferme-modèle, absolument comme le gouvernement, c’est notre maison de campagne, elle est à trois lieues d’ici, sur la route d’Italie, près de Villeneuve-Saint-Georges."
                                            },
                                            {
                                                "example_id": "4edb9e0f-ba8c-4fb9-b4af-f42c7355becc",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Son épouse, avertie de cet accident, étant venue le prendre dans une basterne pour le conduire dans une maison de campagne, il recouvra son bon sens."
                                            },
                                            {
                                                "example_id": "8d9d85f9-7e19-4736-be7b-ae9d4445d92f",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Il n'y a de sécurité nulle part. Jean Oudin de Verpel, abbé de Mouzon, s'était retiré au Petit-Remilly, où les Bénédictins avaient une maison de campagne, avec une chapelle qui subsista jusqu'au XVIIIᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
