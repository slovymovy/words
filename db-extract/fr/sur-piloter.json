                "senses": [
                    {
                        "sense_id": "a870296b-5f7b-351e-87af-6d01a94f1525",
                        "entry_id": "e1dae746-0908-36cc-a381-e35105832cb1",
                        "glosses": [
                            "Piloter en agissant sur les commandes plus que nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcdd8ab1-11ea-4f84-9b17-28f67af1cf1f",
                                "sense_id": "a870296b-5f7b-351e-87af-6d01a94f1525",
                                "text": "Lorsqu'un pilote de catégorie égale est sur le point de vous dépasser (même tour), si ce dernier est notoirement plus rapide que vous, ne sur-pilotez pas pour empêchez votre dépassement."
                            },
                            {
                                "example_id": "5e2a53a3-8f6c-4d05-a653-38a57515e321",
                                "sense_id": "a870296b-5f7b-351e-87af-6d01a94f1525",
                                "text": "Bon il faut juste éviter de sur-piloter, et les débattements sont COURTS."
                            }
                        ]
                    }
