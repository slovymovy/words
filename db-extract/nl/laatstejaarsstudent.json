                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b374c60-3674-482a-8f84-8e1cde0000fb",
                        "source_entry_id": "6de47e7f-5709-3096-8908-8ac4331fb570",
                        "source_sense_id": "b4b4052e-d877-3b26-8ad8-b23546919aa3",
                        "source_sense_description": "een student die bezig is met het laatste jaar van zijn studie",
                        "target_lang_word": "Student",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Student",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                        "entry_id": "3cdb4f39-2955-3daa-bf28-6483c55cc833",
                                        "glosses": [
                                            "Person, die an einer Universität oder Fachhochschule studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30bf535-8676-4587-9cb6-623fa1923cd7",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "Sind Sie Student dieser Universität?"
                                            },
                                            {
                                                "example_id": "eac7a33f-205f-461d-9702-dbc92eb055cb",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Es war normal, dass ich mich ihnen anschloss, da wir keinen Zugang zu den reichen Studenten hatten, der Mehrzahl unserer Kommilitonen.“"
                                            },
                                            {
                                                "example_id": "158cfe27-3175-459b-b19d-29817bdce361",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Es war die Zeit, als sich die Jugend an der Universität noch siezte, als Studenten Anzüge und Krawatten trugen und ihre Kommilitoninnen Kleider mit weißen Kragen oder Perlenketten.“"
                                            },
                                            {
                                                "example_id": "cf5ec9b2-1408-41af-bd6a-b70389c4eeb5",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Die meisten Studenten sind Krüppel und Kranke, die der Krieg freigab.“"
                                            },
                                            {
                                                "example_id": "7e816e7d-7db8-429c-9be1-0b40eae3d2b1",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Junge Leute, eben auch meine Studenten und Studentinnen, waren fasziniert von dem neuen Modell, als sie erstmals davon Kenntnis erhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
