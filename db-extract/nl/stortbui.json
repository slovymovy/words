                    },
                    {
                        "sense_id": "6e2e34ff-7eb6-3375-aa68-4a8dc14ab580",
                        "entry_id": "e559a626-007c-3751-9cb6-ba25ab37f9f1",
                        "glosses": [
                            "wordt ook in figuurlijke zin gebruikt als iemand veel zegt en/of lawaai maakt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea8463fd-4ce6-4865-b6e2-fae6c5754537",
                                "sense_id": "6e2e34ff-7eb6-3375-aa68-4a8dc14ab580",
                                "text": "nadat hij zich op zijn vinger had geslagen liet hij een stortbui van scheldwoorden horen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9be28ac5-a70d-47fe-b3d4-e40fa0840bd7",
                        "source_entry_id": "e559a626-007c-3751-9cb6-ba25ab37f9f1",
                        "target_lang_word": "Platzregen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platzregen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5b6d84e-ba48-3345-926a-5a84b500157f",
                                        "entry_id": "4aa1909f-9aea-385e-9124-653c8bd95a3d",
                                        "glosses": [
                                            "plötzlich einsetzender, starker Regen, der nur von kurzer Dauer ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb1870d-702a-437f-ba3a-c66851b70d77",
                                                "sense_id": "d5b6d84e-ba48-3345-926a-5a84b500157f",
                                                "text": "Beim Spazieren erwischte mich ein Platzregen und ich kam komplett nass zu Hause an."
                                            },
                                            {
                                                "example_id": "f94d8d89-8d88-4f1e-958a-cc4064d7b4de",
                                                "sense_id": "d5b6d84e-ba48-3345-926a-5a84b500157f",
                                                "text": "„Als ich nachhause ging, machte ich wieder den Umweg über die Rudolf-Harbig-Straße, wurde von einem Platzregen überrascht und war bald naß bis auf die Haut.“"
                                            },
                                            {
                                                "example_id": "f68c2c19-689e-40d6-8943-a00121987166",
                                                "sense_id": "d5b6d84e-ba48-3345-926a-5a84b500157f",
                                                "text": "„Neulich stieg mir während eines Platzregens ein Herr ohne Mantel zu, der mich umgehend ersuchte, die Heizung auf- und das Fenster hochzudrehen, um ohne Gefahr für seine Gesundheit die Kleidung zu trocknen.“"
                                            },
                                            {
                                                "example_id": "8c067378-2534-4e30-9f1e-a19934447928",
                                                "sense_id": "d5b6d84e-ba48-3345-926a-5a84b500157f",
                                                "text": "„Der Platzregen und der Gegenwind waren so stark, daß sie nichts tun konnte, als mir erbittert vorzuhalten, ich bringe sie um ihre Ehre, denn der Kutscher müsse sie doch sehen.“"
                                            },
                                            {
                                                "example_id": "62aa8664-bf30-4b32-80b4-0decaee2da0a",
                                                "sense_id": "d5b6d84e-ba48-3345-926a-5a84b500157f",
                                                "text": "„Ununterbrochen prasselte der Platzregen gegen die Felswand und Böen heulten um die Felsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5322489-37ab-426a-9ec8-ae749cc21901",
                        "source_entry_id": "e559a626-007c-3751-9cb6-ba25ab37f9f1",
                        "target_lang_word": "downpour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                        "entry_id": "ec5200c8-e9cd-3c86-8ec8-954e09d92f0c",
                                        "glosses": [
                                            "A heavy rain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75af58f8-8d09-405d-9e47-bf50b5a7e750",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "They got caught in a downpour without an umbrella and came back soaked."
                                            },
                                            {
                                                "example_id": "d5815f23-7541-4881-8c00-2cb063b41a22",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "I left Inverness on a Saturday afternoon in July in a steady downpour of rain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                        "entry_id": "1202e03f-54e7-3654-97a3-65b309fc9e33",
                                        "glosses": [
                                            "To pour down; rain heavily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8f2804-c6ae-4f28-9011-a09c406d91af",
                                                "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                                "text": "It started to downpour, so Billy and I made our way back to our house, with Scotty following—or so I thought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b6d35f2-990f-4479-8043-e55b98235020",
                        "source_entry_id": "e559a626-007c-3751-9cb6-ba25ab37f9f1",
                        "target_lang_word": "averse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "averse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                        "entry_id": "7e1ba687-dc40-3b37-b164-97fb2c41866c",
                                        "glosses": [
                                            "Pluie soudaine, abondante et généralement brève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4efa2031-56b5-480d-82d8-ba69a5f88e3a",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Le vent du sud-ouest, frappant en plein sur ma porte, en avait si bien relâché les jointures, qu’à la moindre averse j’étais inondé."
                                            },
                                            {
                                                "example_id": "11169490-5844-49e2-9b4e-94b6dd524321",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Souvent on voit la partie inférieure du nuage s’effranger en averses pour inonder de pluie les pentes basses, tandis que plus haut les vapeurs plus froides se déchargent de flocons de neige."
                                            },
                                            {
                                                "example_id": "1dc85a51-8715-414d-8a67-1ed9673958e4",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Bien que, par intervalles, de brèves et pâles soleillées courussent sur les chemins défoncés, sur les prairies semées de flaques miroitantes, on pressentait que l’accalmie serait de peu de durée, et que l’averse recommencerait avant la fin du jour."
                                            },
                                            {
                                                "example_id": "c7518bd7-4205-48ce-ab51-2f2192e55acf",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "A peine nos tentes sont-elles dressées, qu’une averse diluvienne s’abat sur le camp."
                                            },
                                            {
                                                "example_id": "d8b8cf5d-e0ea-4745-9e5b-6b10b2c58e43",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Il pleuvait. Par instants, on entendait l’averse s’écraser contre la verrière du haut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29297b87-b898-431d-8d84-200aef0e01a7",
                        "source_entry_id": "e559a626-007c-3751-9cb6-ba25ab37f9f1",
                        "target_lang_word": "drache",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3288810-3892-3efe-b121-121f54f3017e",
                                        "entry_id": "307c645e-6e33-3675-b15c-54bcc01f7546",
                                        "glosses": [
                                            "Pluie forte et subite ; averse."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Nord de la France",
                                            "Ardennes",
                                            "Lorraine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea416b0-c36f-44eb-b11a-5b02d92cbf21",
                                                "sense_id": "f3288810-3892-3efe-b121-121f54f3017e",
                                                "text": "Après avoir, toute la journée, parcouru les sections de vote, — je me rappelle un certain dimanche trempé de cette pluie brabançonne que l'on nomme là-bas la drache, pluie qui me fut impitoyable et me prit au petit matin dans la rue […]."
                                            },
                                            {
                                                "example_id": "7dfbbc2d-4a6d-4adb-a256-b70515dbf464",
                                                "sense_id": "f3288810-3892-3efe-b121-121f54f3017e",
                                                "text": "Ce matin, on a eu une drache carabinée, que Jef ne voyait plus rien à travers mon pare-brise !"
                                            },
                                            {
                                                "example_id": "158ec1be-4965-4273-b776-b89569f3b364",
                                                "sense_id": "f3288810-3892-3efe-b121-121f54f3017e",
                                                "text": "Place Saint-Denis, une drache l'accueillit à sa descente. Bien protégés, les passants réfugiés en dessous des auvents transformés pour la cause en abris provisoires, contemplaient le garçon qui accélérait sa marche en maugréant du fait qu'il n'avait, pour une fois, pas emporté de parapluie."
                                            },
                                            {
                                                "example_id": "57735a4f-27b8-44b1-9cee-77c5d724e3be",
                                                "sense_id": "f3288810-3892-3efe-b121-121f54f3017e",
                                                "text": "Car aujourd’hui, je vous dis pas, c’est drache sur drache, ça finit pas de cesser, comme dit Erik."
                                            },
                                            {
                                                "example_id": "d8308c6e-54f8-43fd-81c3-70c2c072260a",
                                                "sense_id": "f3288810-3892-3efe-b121-121f54f3017e",
                                                "text": "Dans la région minière du nord de la France, que Szczepan Twardoch évoque brièvement et qui semble proche de sa Silésie natale, une « drache » est une forte pluie. L'indice est-il pertinent ? À n'en pas douter, c'est une pluie de mots, d'expressions étrangères, qui attend le lecteur au fil des pages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbf78852-b5c9-39d2-b4e4-4e79085d3247",
                                        "entry_id": "307c645e-6e33-3675-b15c-54bcc01f7546",
                                        "glosses": [
                                            "Tournée générale."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "566698de-b0b8-4059-b259-d20e90d65b3f",
                                                "sense_id": "bbf78852-b5c9-39d2-b4e4-4e79085d3247",
                                                "text": "J'essaie de m'y engloutir mais tout à coup, devant moi surgit ta tête de morue.\n— Remets une drache, Miss.\nJe refais surface, me dirige vers la pompe à bière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dfb7ba8-a634-38c7-a069-c1b68bf0d2d0",
                                        "entry_id": "e3ec874c-4b28-3efc-a745-f24208ae2e6f",
                                        "glosses": [
                                            "Nom donné aux restes constitués par l'orge ayant servi à la fabrication de la bière."
                                        ],
                                        "tags": [
                                            "Régionalisme",
                                            "information à préciser ou à vérifier"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "drache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "778a080b-93bb-30cd-8be5-0bd053d768ca",
                                        "entry_id": "e32fbeaf-20e0-3780-bbba-fd5544a3023f",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de dracher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c0fd7a5-3c86-4589-a27c-a5ddd3399eb4",
                                                "sense_id": "778a080b-93bb-30cd-8be5-0bd053d768ca",
                                                "text": "Les savoureux jeux de mots sont déclinés en cartes postales, tee-shirts et casquettes : « Rodin des Bois », « Complètement Miró », « Le Titien à sa mémère », « À Bruxelles, il ne pleut jamais mais qu’est-ce qu’il drache », « Oui, mais non » à dégoter au BOZAR SHOP."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc2054b4-ca1e-304c-b3ab-55a38f47a1c2",
                                        "entry_id": "e32fbeaf-20e0-3780-bbba-fd5544a3023f",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de dracher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fea55e3-2d1f-4db8-93d8-dc8cf1f2febc",
                                                "sense_id": "dc2054b4-ca1e-304c-b3ab-55a38f47a1c2",
                                                "text": "Qu'il tombe des cordes ou qu'il bruine, qu'il drache ou qu'il gouttine, ça mouille !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
