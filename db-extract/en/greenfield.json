                ],
                "senses": [
                    {
                        "sense_id": "6f71ad46-8e0b-39ed-ace5-9f532d93835a",
                        "entry_id": "e6e80f2a-287b-3e7f-bc38-b60c3edcadba",
                        "glosses": [
                            "A site, to be used for housing or commerce, whose previous use (if any) was agricultural."
                        ],
                        "tags": [
                            "attributive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "84d862b7-0db1-488e-a51c-6e8bb4476070",
                                "sense_id": "6f71ad46-8e0b-39ed-ace5-9f532d93835a",
                                "text": "greenfield development"
                            },
                            {
                                "example_id": "67ea73c3-80a5-41b9-8ad8-5275275ad11c",
                                "sense_id": "6f71ad46-8e0b-39ed-ace5-9f532d93835a",
                                "text": "In 2007 Mr Gilbert [Dan Gilbert] made the then remarkable decision to move Quicken Loans’ suburban headquarters downtown. Mr Gilbert says that the initial thinking was humdrum—the firm’s lease was expiring, the business was growing, and he didn’t want to build a new greenfield campus. But he also had a bigger idea in mind. “We needed to keep young people here [in Michigan] and make sure they weren’t going to places like Chicago,” he says. “We knew that young people did not want to work in suburbs.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
