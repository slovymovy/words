{
    "word_family": [
        "égoïsme",
        "égoïstement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f870420e-65ed-3ff3-b1d9-db5cbfe72d66",
                    "sense_definition": "Qui ne pense qu'à soi et à son propre intérêt au détriment des autres.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse toujours de prêter ses affaires parce qu'il est trop <w>égoïste</w> pour partager."
                        },
                        {
                            "text": "Elle n'a jamais été une personne <w>égoïste</w> et cherche constamment à aider ses proches."
                        }
                    ],
                    "synonyms": [
                        "égocentrique"
                    ],
                    "antonyms": [
                        "altruiste"
                    ]
                },
                {
                    "sense_id": "b18377ce-2a5c-3390-9465-23daeaa4a154",
                    "sense_definition": "Qui découle de la recherche exclusive de son propre avantage, en parlant d'un acte ou d'une attitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prendre cette décision sans consulter l'équipe a été perçu comme un acte <w>égoïste</w>."
                        },
                        {
                            "text": "Son comportement <w>égoïste</w> a fini par détruire la confiance entre les deux associés."
                        }
                    ],
                    "antonyms": [
                        "altruiste"
                    ],
                    "common_phrases": [
                        "comportement égoïste",
                        "choix égoïste"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3827849a-edd3-352b-9393-9621d2aa8538",
                    "sense_definition": "Personne qui subordonne tout à son intérêt personnel et fait preuve d'égoïsme.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne te comporte pas comme un <w>égoïste</w> en pensant seulement à ton propre confort."
                        },
                        {
                            "text": "Cet <w>égoïste</w> ne se soucie guère du mal qu'il cause autour de lui."
                        }
                    ],
                    "synonyms": [
                        "égocentrique"
                    ],
                    "antonyms": [
                        "altruiste"
                    ],
                    "common_phrases": [
                        "sale égoïste",
                        "parfait égoïste"
                    ]
                }
            ]
        }
    ]
}