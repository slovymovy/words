                ],
                "senses": [
                    {
                        "sense_id": "d58895a7-3917-3a7f-8b9d-d756983c8d9a",
                        "entry_id": "035b2534-aa46-3fe4-9736-3fe9843d80b9",
                        "glosses": [
                            "Compiler à un niveau méta."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97053609-c355-4257-8af2-3254e38de25f",
                                "sense_id": "d58895a7-3917-3a7f-8b9d-d756983c8d9a",
                                "text": "Ils se sont contenté de métacompiler tout ça en regroupant par éditeurs, et bingo, here his the tableau."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d1a5e59-b1d2-321e-8df6-c5aa8eac784f",
                        "entry_id": "035b2534-aa46-3fe4-9736-3fe9843d80b9",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d06243-1781-4238-8712-2b9a0d16da83",
                                "sense_id": "2d1a5e59-b1d2-321e-8df6-c5aa8eac784f",
                                "text": "Le texte source à métacompiler est interprété mot-à-mot en une seule passe."
                            },
                            {
                                "example_id": "c7bf867c-7278-434c-bf63-e8adeed54bda",
                                "sense_id": "2d1a5e59-b1d2-321e-8df6-c5aa8eac784f",
                                "text": "Il était si rapide que, lorsqu'il était lancé depuis une disquette, il pouvait démarrer et se métacompiler lui-même depuis la disquette avant que le lecteur n'atteigne sa vitesse de croisière."
                            }
                        ]
                    }
                ],
