                "senses": [
                    {
                        "sense_id": "cd3d6ac6-01e8-3317-bcb5-179c6bd63216",
                        "entry_id": "c9eac670-787e-34e7-9cd3-39bb7ad1bbaa",
                        "glosses": [
                            "ein- oder zweimanualiges Harmonium mit Orgelpedal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ee1653-51aa-4a33-b73a-5ebd726368b1",
                                "sense_id": "cd3d6ac6-01e8-3317-bcb5-179c6bd63216",
                                "text": "„Ein Konzert mit dem Barock-Ensemble “Uccellini” der Uckermärkischen Musik- und Kunstschule “Friedrich Wilhelm von Redern” für die Restaurierung des Pedalharmoniums der Dorfkirche Herzsprung findet am 3. August um 16 Uhr in der Dorfkirche Herzsprung statt.“"
                            },
                            {
                                "example_id": "650e5aa0-d867-4f07-89c2-d860df71427a",
                                "sense_id": "cd3d6ac6-01e8-3317-bcb5-179c6bd63216",
                                "text": "„Die St. Ingberter Martin-Luther-Kirche ist stolz auf seinen Erwerb: ein historisches Pedalharmonium.“"
                            },
                            {
                                "example_id": "30ba0e69-1e50-489a-b24a-5b7e9c49f019",
                                "sense_id": "cd3d6ac6-01e8-3317-bcb5-179c6bd63216",
                                "text": "„Nun konnten sich die Freunde klassischer Musik zur Halbzeit des Musiksommers Wiehe 2010 beim ersten Wieheschen Wandelkonzert sowohl in der Sankt-Ursula-Kirche an dem zarten singenden Klang des Pedalharmoniums als auch anschließend in der Sankt-Bartholomäus-Kirche an den leisen und teils auch typisch dynamischen Orgelklängen erfreuen.“"
                            },
                            {
                                "example_id": "0d06d171-f581-43dc-a9ed-7687e1e5b13c",
                                "sense_id": "cd3d6ac6-01e8-3317-bcb5-179c6bd63216",
                                "text": "„Später wurden in St. Marien ein Pedalharmonium und schließlich eine elektronische Orgel angeschafft.“"
                            },
                            {
                                "example_id": "6d8bc486-2c2a-460c-8242-97dd8f94b7ef",
                                "sense_id": "cd3d6ac6-01e8-3317-bcb5-179c6bd63216",
                                "text": "„Es wird auch geübt und gespielt an den verschiedenen Instrumenten, die im \"Haus der Kirchenmusik\" zur Verfügung stehen: neben den Orgeln in der Schlosskirche und in der Kapelle sind dies zwei digitale Orgeln, ein Pedalharmonium und Klaviere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
