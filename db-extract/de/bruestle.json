                "senses": [
                    {
                        "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                        "entry_id": "d08ad0e0-c45f-3592-8e93-bc567811b872",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d8d6394-3c54-471e-a5b7-98d78ef0a1b2",
                                "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                                "text": "Frau Bruestle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b0914605-1726-44dc-8960-e71d5778425f",
                                "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                                "text": "Herr Bruestle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "56285e66-e04e-4a4e-9303-7a43e0074988",
                                "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                                "text": "Die Bruestles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5414820e-26cf-4fd9-b651-4959c68a3fda",
                                "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                                "text": "Der Bruestle trägt nie die Schals, die die Bruestle ihm strickt."
                            },
                            {
                                "example_id": "b54fac7a-b737-4654-af37-68117ac04a97",
                                "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bruestle kommt, geht der Herr Bruestle.“"
                            },
                            {
                                "example_id": "9ebbe1aa-a8d9-4d98-860f-0ee845f712f1",
                                "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                                "text": "Bruestle kommt und geht."
                            },
                            {
                                "example_id": "7fcdbdda-b8ed-45a3-8cba-b9743ac22fc3",
                                "sense_id": "6b9a9713-5e27-376c-9868-77951bf4aa89",
                                "text": "Bruestles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
