                                        "glosses": [
                                            "każdy byt duchowy stojący w hierarchii niebiańskiej wyżej niż chór aniołów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c650bb-82bf-4474-a235-c0989afef412",
                                                "sense_id": "740889c6-e292-3eac-8adf-089d59fb9aba",
                                                "text": "Ty czasem dzierżysz i miecz archanioła"
                                            },
                                            {
                                                "example_id": "56e21972-2821-4f98-8538-5522f98f3bfa",
                                                "sense_id": "740889c6-e292-3eac-8adf-089d59fb9aba",
                                                "text": "Święty Michale Archaniele, wspomagaj nas w walce, a przeciw niegodziwości i zasadzkom złego ducha bądź naszą obroną"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ccf0114-ff47-4806-bb6f-0abd54d94eaf",
                        "source_entry_id": "d6f7fb91-63b4-3bf4-a2c7-79916b52ed20",
                        "source_sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                        "source_sense_description": "Engel mit einer wichtigen, herausragenden Rolle",
                        "target_lang_word": "arcanjo",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcanjo",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "42e83c27-311c-3491-a877-608186f87879",
                                        "entry_id": "dfbd3aec-13a4-399e-bcb6-5252f705920c",
                                        "glosses": [
                                            "chefe dos anjos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e0fc421-1475-480f-a211-17954f114a08",
                                                "sense_id": "42e83c27-311c-3491-a877-608186f87879",
                                                "text": "A estátua, esculpida em concreto, vai representar São Miguel Arcanjo, considerado o chefe supremo dos anjos fiéis a Deus, segundo a crença católica."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a677859e-34b7-4ae9-8316-d7a1baaf34ff",
                        "source_entry_id": "d6f7fb91-63b4-3bf4-a2c7-79916b52ed20",
                        "source_sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                        "source_sense_description": "Engel mit einer wichtigen, herausragenden Rolle",
                        "target_lang_word": "архангел",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "архангел",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "78129ac0-9b0c-3e2b-8756-fc4edfb68c94",
                                        "entry_id": "488dfe39-3bc3-3766-9506-fc87c437e3b5",
                                        "glosses": [
                                            "религ. согласно Библии, высший по чину ангел; у теологов — предпоследний чин в небесной иерархии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cd366d-f93d-4463-982e-f47c6a170b24",
                                                "sense_id": "78129ac0-9b0c-3e2b-8756-fc4edfb68c94",
                                                "text": "Лишь на секунду ты останавливаешь свой взгляд на мне, и я называю тебя по имени, и мне кажется, что, если бы явился архангел с белыми крыльями, в нём было бы меньше нежности."
                                            },
                                            {
                                                "example_id": "39eda93e-cb8c-4c65-8543-cf51df561730",
                                                "sense_id": "78129ac0-9b0c-3e2b-8756-fc4edfb68c94",
                                                "text": "В 1471 художник вступил в Братство архангела Рафаила, для алтаря которого в церкви Санто-Спирито написал одну из своих лучших работ ― «Товий и три архангела» (галерея Уффици, Флоренция)."
                                            },
                                            {
                                                "example_id": "4a638c6b-0a6f-4424-ab63-cba5f1366908",
                                                "sense_id": "78129ac0-9b0c-3e2b-8756-fc4edfb68c94",
                                                "text": "Ведь небесная иерархия, как известно, многообразна. Есть херувимы, серафимы, престолы, господства, архангелы. А может, она ангел-хранитель?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
