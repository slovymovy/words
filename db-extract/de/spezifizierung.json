                "senses": [
                    {
                        "sense_id": "f7cd2b38-7e0a-3d98-acd0-82e04418470e",
                        "entry_id": "33a782e6-f823-31da-979d-fbd95b911d15",
                        "glosses": [
                            "genaue Beschreibung und Festlegung von Eigenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e71342-c5fe-4174-ad9c-cef9536f4e15",
                                "sense_id": "f7cd2b38-7e0a-3d98-acd0-82e04418470e",
                                "text": "Bei der Spezifizierung wird darauf geachtet, dass Anforderungen eindeutig und realisierbar sind, sowie sich nicht widersprechen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ddeb344-a36d-3ad8-a617-fb06f8a64591",
                        "entry_id": "33a782e6-f823-31da-979d-fbd95b911d15",
                        "glosses": [
                            "Untergliederung in einzelne spezielle Untereinheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad3dcf6-37d3-4107-a8b7-343c0e2b118c",
                                "sense_id": "8ddeb344-a36d-3ad8-a617-fb06f8a64591",
                                "text": "„Damit reagiert der Staat mit einer Differenzierung und Spezifizierung organisationaler Gestaltung, welche im Verwaltungsbereich vielfach auf bestimmte Klientengruppen ausgerichtet ist.“"
                            },
                            {
                                "example_id": "1d3cc6fa-489e-4357-8729-5b68d5493fdf",
                                "sense_id": "8ddeb344-a36d-3ad8-a617-fb06f8a64591",
                                "text": "„Die Determination der R7-Zelle lieferte ein gutes Modell für die Spezifizierung der Zellen im Auge.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
