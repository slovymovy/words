{
    "word_family": [
        "universe",
        "universality",
        "universally",
        "universalize",
        "universalism",
        "university"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7f9a4b6a-f65a-3c55-9579-fb251cda7355",
                    "sense_definition": "Relating to or done by all people or things in the world or in a particular group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "commonality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie received <w>universal</w> acclaim from critics and audiences around the globe.",
                            "target_lang_translations": {
                                "ru": "Фильм получил <w>всеобщее</w> признание критиков и зрителей по всему миру.",
                                "zh": "这部电影获得了全球评论家和观众<w>普遍</w>的赞誉。"
                            }
                        },
                        {
                            "text": "Music is often described as a <w>universal</w> language that everyone can understand.",
                            "target_lang_translations": {
                                "ru": "Музыку часто называют <w>универсальным</w> языком, который понятен каждому.",
                                "zh": "音乐常被描述为一种每个人都能听懂的<w>通用</w>语言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "general",
                        "generic"
                    ],
                    "antonyms": [
                        "nonuniversal"
                    ],
                    "common_phrases": [
                        "universal language",
                        "universal appeal",
                        "universal truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся ко всем людям или вещам в мире или в определенной группе; совершаемый всеми.",
                        "zh": "指全世界或特定群体中所有的人或事物都具备的，或由他们共同完成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всеобщий",
                                "target_lang_sense_clarification": "касающийся всех без исключения"
                            },
                            {
                                "target_lang_word": "всемирный",
                                "target_lang_sense_clarification": "распространенный по всему миру"
                            },
                            {
                                "target_lang_word": "общечеловеческий",
                                "target_lang_sense_clarification": "относящийся ко всему человечеству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普遍的",
                                "target_lang_sense_clarification": "指在广泛范围内存在或适用的"
                            },
                            {
                                "target_lang_word": "全人类的",
                                "target_lang_sense_clarification": "指涉及整个人类社会的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f138ef28-559d-3883-ac6d-c9eeeb3ebf9f",
                    "sense_definition": "Applicable to or true for all members of a specific group, class, or category.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commonality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company introduced a <w>universal</w> fare for all passengers regardless of the distance traveled.",
                            "target_lang_translations": {
                                "ru": "Компания ввела <w>единый</w> тариф для всех пассажиров, независимо от пройденного расстояния.",
                                "zh": "公司为所有乘客引入了<w>统一</w>票价，无论行程远近。"
                            }
                        },
                        {
                            "text": "In logic, a <w>universal</w> proposition applies to every member of a set.",
                            "target_lang_translations": {
                                "ru": "В логике <w>общее</w> суждение применимо к каждому члену множества.",
                                "zh": "在逻辑学中，全称命题适用于集合中的每一个成员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "general"
                    ],
                    "antonyms": [
                        "nonuniversal"
                    ],
                    "common_phrases": [
                        "universal fare",
                        "universal rule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применимый ко всем членам определенной группы, класса или категории.",
                        "zh": "适用于特定群体、类别或范畴内所有成员的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единый",
                                "target_lang_sense_clarification": "общий для всех членов группы"
                            },
                            {
                                "target_lang_word": "универсальный",
                                "target_lang_sense_clarification": "подходящий для любого случая в рамках категории"
                            },
                            {
                                "target_lang_word": "всеобщий",
                                "target_lang_sense_clarification": "распространяющийся на всю группу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "统一的",
                                "target_lang_sense_clarification": "指对所有成员标准一致的"
                            },
                            {
                                "target_lang_word": "通用的",
                                "target_lang_sense_clarification": "指在特定范围内均可适用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45a20740-6367-38c2-a716-4d33a708dee5",
                    "sense_definition": "Designed to be used for many different purposes or to fit many different sizes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "utility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a <w>universal</w> wrench to fix the various bolts on the old bicycle.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>универсальный</w> ключ, чтобы закрутить разные болты на старом велосипеде.",
                                "zh": "他用一把<w>万能</w>扳手修理了旧自行车上各种各样的螺栓。"
                            }
                        },
                        {
                            "text": "This <w>universal</w> remote control can operate the television, the stereo, and the DVD player.",
                            "target_lang_translations": {
                                "ru": "Этот <w>универсальный</w> пульт дистанционного управления может управлять телевизором, стереосистемой и DVD-плеером.",
                                "zh": "这个<w>通用</w>遥控器可以控制电视、音响和DVD播放机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "general-purpose",
                        "multi-purpose"
                    ],
                    "common_phrases": [
                        "universal wrench",
                        "universal remote",
                        "universal joint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для использования в различных целях или подходящий для разных размеров.",
                        "zh": "设计用于多种不同用途，或适用于多种不同尺寸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "универсальный",
                                "target_lang_sense_clarification": "многофункциональный"
                            },
                            {
                                "target_lang_word": "всесторонний",
                                "target_lang_sense_clarification": "охватывающий разные аспекты применения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "万能的",
                                "target_lang_sense_clarification": "指功能多样，能解决多种问题的"
                            },
                            {
                                "target_lang_word": "通用的",
                                "target_lang_sense_clarification": "指可用于多种设备或场合的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f2e3824-4197-3587-a849-28d1cf298610",
                    "sense_definition": "Of or relating to the entire universe or cosmos.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cosmic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are searching for <w>universal</w> laws that govern the movement of all celestial bodies.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут <w>вселенские</w> законы, управляющие движением всех небесных тел.",
                                "zh": "科学家们正在寻找支配所有天体运动的<w>宇宙</w>定律。"
                            }
                        },
                        {
                            "text": "The expansion of space is a <w>universal</w> phenomenon that affects every galaxy.",
                            "target_lang_translations": {
                                "ru": "Расширение пространства — это <w>космическое</w> явление, затрагивающее каждую галактику.",
                                "zh": "空间膨胀是一种影响每个星系的<w>普遍</w>现象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "universal laws",
                        "universal constants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся ко всей вселенной или космосу.",
                        "zh": "属于整个宇宙或与宇宙相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вселенский",
                                "target_lang_sense_clarification": "масштаба всей Вселенной"
                            },
                            {
                                "target_lang_word": "космический",
                                "target_lang_sense_clarification": "относящийся к космосу"
                            },
                            {
                                "target_lang_word": "мировой",
                                "target_lang_sense_clarification": "в значении физического мира/вселенной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宇宙的",
                                "target_lang_sense_clarification": "指涉及整个宇宙范围的"
                            },
                            {
                                "target_lang_word": "普遍的",
                                "target_lang_sense_clarification": "指在自然界中恒久适用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ca7f5a6-0c33-333e-952c-3e3e3fcbe064",
                    "sense_definition": "Existing everywhere or involving everything; unlimited in scope or spirit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cosmic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet spoke of a <w>universal</w> spirit that connects every living being in the world.",
                            "target_lang_translations": {
                                "ru": "Поэт говорил о <w>вселенском</w> духе, который связывает каждое живое существо в мире.",
                                "zh": "诗人谈到了一种连接世界上每一个生命的<w>普遍</w>精神。"
                            }
                        },
                        {
                            "text": "His knowledge seemed almost <w>universal</w>, covering every subject from history to physics.",
                            "target_lang_translations": {
                                "ru": "Его знания казались почти <w>всеобъемлющими</w>, охватывая все предметы от истории до физики.",
                                "zh": "他的知识似乎<w>无所不包</w>，涵盖了从历史到物理的每一个学科。"
                            }
                        }
                    ],
                    "synonyms": [
                        "infinite"
                    ],
                    "common_phrases": [
                        "universal spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий повсюду или охватывающий всё; неограниченный по масштабу или духу.",
                        "zh": "存在于各处或包含一切；在范围或精神上不受限制的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всеобъемлющий",
                                "target_lang_sense_clarification": "охватывающий абсолютно всё"
                            },
                            {
                                "target_lang_word": "безграничный",
                                "target_lang_sense_clarification": "не имеющий пределов"
                            },
                            {
                                "target_lang_word": "вселенский",
                                "target_lang_sense_clarification": "всеобщий и безграничный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无所不包的",
                                "target_lang_sense_clarification": "指涵盖范围极广的"
                            },
                            {
                                "target_lang_word": "普遍的",
                                "target_lang_sense_clarification": "指无处不在的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "490d4935-0a78-3efd-bf75-fcf484ace1b9",
                    "sense_definition": "A concept, property, or characteristic that can be applied to many different individual things.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers have long debated whether a <w>universal</w> like redness exists independently of red objects.",
                            "target_lang_translations": {
                                "ru": "Философы давно спорят о том, существует ли такая <w>универсалия</w>, как «краснота», независимо от красных объектов.",
                                "zh": "哲学家们长期以来一直在争论像“红色”这样的<w>共相</w>是否独立于红色物体而存在。"
                            }
                        },
                        {
                            "text": "In this linguistic theory, certain grammatical structures are considered to be <w>universals</w> found in all languages.",
                            "target_lang_translations": {
                                "ru": "В этой лингвистической теории определенные грамматические структуры считаются <w>универсалиями</w>, встречающимися во всех языках.",
                                "zh": "在这种语言学理论中，某些语法结构被认为是所有语言中都存在的<w>普遍性</w>特征。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "linguistic universals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понятие, свойство или характеристика, которые могут быть применены ко многим различным отдельным вещам (универсалия).",
                        "zh": "可以应用于许多不同个体事物的概念、属性或特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "универсалия",
                                "target_lang_sense_clarification": "философский или лингвистический термин"
                            },
                            {
                                "target_lang_word": "всеобщее",
                                "target_lang_sense_clarification": "абстрактное общее свойство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共相",
                                "target_lang_sense_clarification": "哲学中指普遍存在的属性"
                            },
                            {
                                "target_lang_word": "普遍性",
                                "target_lang_sense_clarification": "指在所有语言或事物中共同存在的特征"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}