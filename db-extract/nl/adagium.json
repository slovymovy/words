                                "target_senses": [
                                    {
                                        "sense_id": "9228eeec-4566-3c47-a15c-000f4348e45c",
                                        "entry_id": "5d684f1d-1494-34e5-b8ee-30fe2914ac74",
                                        "glosses": [
                                            "An old saying which has obtained credit by long use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e84308d8-ab05-4b26-a44e-f66f474cfc48",
                                                "sense_id": "9228eeec-4566-3c47-a15c-000f4348e45c",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee72bc7-a340-398a-8caa-6831fad858fc",
                                        "entry_id": "5d684f1d-1494-34e5-b8ee-30fe2914ac74",
                                        "glosses": [
                                            "An old saying which has been overused or considered a cliché; a trite maxim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60581145-33ef-4cb6-a639-99f6f773f5de",
                                                "sense_id": "1ee72bc7-a340-398a-8caa-6831fad858fc",
                                                "text": "Like the poore Cat i’ th’ Addage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1dfe4c5-5c5d-44f2-9b5c-f390cd10fda9",
                        "source_entry_id": "2a6d9175-6802-3551-9958-bb294471f636",
                        "source_sense_id": "d0cf1556-bd26-3561-ad88-e419aee4b44a",
