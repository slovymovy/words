                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bd335641-2901-4761-8a05-82b20fce878b",
                        "entry_id": "6cd07fc8-9f6c-3b9d-bf90-b65ba8d67253",
                        "tags": [
                            "plural"
                        ],
                        "form": "rapidities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbf691c9-0c3c-3420-8367-25ca37efe334",
                        "entry_id": "6cd07fc8-9f6c-3b9d-bf90-b65ba8d67253",
                        "glosses": [
                            "speed, swiftness; the condition of being rapid"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7fcd0595-57cb-4094-9e99-0cfe126b2930",
                                "sense_id": "bbf691c9-0c3c-3420-8367-25ca37efe334",
                                "text": "Although appreciating the rapidity and frequency of the Southern electric services I was now to use on short journeys, I became more than ever convinced that electric traction offers very little of interest to the dyed-in-the-wool railwayist."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef594758-21a0-3a71-b6f2-94591afa7244",
                        "entry_id": "6cd07fc8-9f6c-3b9d-bf90-b65ba8d67253",
                        "glosses": [
                            "A measure of velocity relative to the speed of light; defined as artanh(v), where artanh is the hyperbolic arctangent, and v = speed (with c = speed of light = 1)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6c07e253-6d2b-3ed4-a11a-ae6b1e02a5a8",
                        "entry_id": "6cd07fc8-9f6c-3b9d-bf90-b65ba8d67253",
                        "glosses": [
                            "A measure of the velocity of a particle in a beam relative to the beam's axis"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8842bdd2-4a89-426f-92ef-e39d4a4a0e9c",
                        "source_entry_id": "6cd07fc8-9f6c-3b9d-bf90-b65ba8d67253",
                        "source_sense_description": "speed, swiftness",
                        "target_lang_word": "rapidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "814cfd9d-77c4-3d1d-a2de-4b3634f83fde",
                                        "entry_id": "404dd516-92c2-3ef4-8037-51c56906ccef",
                                        "glosses": [
                                            "Célérité, grande vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5989b0ef-69df-41f0-80bf-f54eb232283e",
                                                "sense_id": "814cfd9d-77c4-3d1d-a2de-4b3634f83fde",
                                                "text": "A de grandes altitudes planaient les frégates et les phaétons, qui tombaient souvent avec une rapidité vertigineuse pour arracher en l'air leur proie aux oiseaux de mer plongeurs."
                                            },
                                            {
                                                "example_id": "fdf07a5d-24af-4992-8bdf-913bf248a777",
                                                "sense_id": "814cfd9d-77c4-3d1d-a2de-4b3634f83fde",
                                                "text": "Jamais la droite ne se mouvait sans que l’œil droit examinât les circonstances extérieures avec cette rapidité placide particulière au voleur et à l’espion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                        "entry_id": "404dd516-92c2-3ef4-8037-51c56906ccef",
                                        "glosses": [
                                            "Il s’emploie aussi figurément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb69131f-887b-4fd5-b02c-80c3376ab221",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "Cependant, au cours de nos travaux, l'espace libre se rétrécit, comme la peau de chagrin de Balzac, avec une déconcertante rapidité."
                                            },
                                            {
                                                "example_id": "2056ce09-0743-4c9f-94f2-12393a6f62dd",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de ses conquêtes a déconcerté l’ennemi."
                                            },
                                            {
                                                "example_id": "c994944e-39f0-45dd-b790-5a6c306061f8",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de ses progrès me confond."
                                            },
                                            {
                                                "example_id": "b577c200-8550-4167-bb9f-f34de75216ca",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de la pensée."
                                            },
                                            {
                                                "example_id": "5c3bb079-ac80-485c-bb97-f1ccb540e37d",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de l’élocution."
                                            },
                                            {
                                                "example_id": "3cfad833-6119-449d-8b8c-20a891548a67",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "J’aime la rapidité de son style."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74421cf2-46d1-44f5-8ac6-c97452c559c4",
                        "source_entry_id": "6cd07fc8-9f6c-3b9d-bf90-b65ba8d67253",
                        "source_sense_description": "speed, swiftness",
                        "target_lang_word": "célérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "célérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2439c72e-1ff2-31dc-a19f-800804387cdf",
                                        "entry_id": "196ba7e8-e9a7-3ab4-9eca-38971b44e0c2",
                                        "glosses": [
                                            "Promptitude dans l’exécution, activité rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ba7a0f-0ff4-44e1-b1e2-91082c8b2c2c",
                                                "sense_id": "2439c72e-1ff2-31dc-a19f-800804387cdf",
                                                "text": "Le nom d’Ivanhoé ne fut pas plutôt prononcé qu’il vola de bouche en bouche avec toute la célérité qu’il put recevoir de l’ardeur et de la curiosité."
                                            },
                                            {
                                                "example_id": "fefe507c-b168-4502-9d4a-c33a10b5eeca",
                                                "sense_id": "2439c72e-1ff2-31dc-a19f-800804387cdf",
                                                "text": "Cependant, le pillage continuait avec une célérité et un ordre dans le désordre qui faisaient honneur aux connaissances pratiques des pirates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38518a59-cc37-362b-9797-5cd47e27d538",
                                        "entry_id": "196ba7e8-e9a7-3ab4-9eca-38971b44e0c2",
                                        "glosses": [
                                            "Vitesse d’une onde."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92852aea-0ec6-4a2b-8e1a-60a393ae0b96",
                                                "sense_id": "38518a59-cc37-362b-9797-5cd47e27d538",
                                                "text": "La célérité du son est affectée par les milieux qu’il traverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9798a56f-73b3-353d-a082-087b39e67473",
                                        "entry_id": "196ba7e8-e9a7-3ab4-9eca-38971b44e0c2",
                                        "glosses": [
                                            "Vitesse de propagation de la lumière dans le vide."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
