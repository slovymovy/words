                "senses": [
                    {
                        "sense_id": "88f763cd-76ee-3663-949e-3bbf0b677d25",
                        "entry_id": "f47c1d3f-16ca-3bdb-95a3-301450fb75a0",
                        "glosses": [
                            "Eigenschaft/Merkmal/Tatsache, dass etwas nicht rückgängig, ungetan gemacht werden kann, es nicht umkehrbar (reversibel) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc72abe-ecff-4ae1-9976-242df7cca65f",
                                "sense_id": "88f763cd-76ee-3663-949e-3bbf0b677d25",
                                "text": "„Ergibt eine standardisierte EEG-Ableitung eine hirnelektrische Stille (Nullinien-EEG) (Anmerkung 6), so kann die Irreversibilität des Hirnfunktionsausfalls ohne weitere Beobachtungszeit festgestellt werden.“"
                            },
                            {
                                "example_id": "f9d7ed9f-6482-4b38-900a-f936b7c65383",
                                "sense_id": "88f763cd-76ee-3663-949e-3bbf0b677d25",
                                "text": "„Jede Investition ist verbunden mit Unsicherheit, Irreversibilität und Flexibilität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6049fc9-a888-4096-83a6-121754a687c8",
                        "source_entry_id": "f47c1d3f-16ca-3bdb-95a3-301450fb75a0",
                        "source_sense_id": "88f763cd-76ee-3663-949e-3bbf0b677d25",
                        "target_lang_word": "irreversibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreversibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                        "entry_id": "af279339-d4e1-3879-a8bd-b0177f422c03",
                                        "glosses": [
                                            "The quality of being irreversible; the lack of an ability to be reversed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f4761c8-cf4a-44c3-842f-3ba741a2d0cf",
                                                "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                                "text": "1806, Samuel Barnard, The Essence, Spirituality, and Glorious Issue, of the Religion of Christ Jesus, to All God's Chosen, W. Nicholson, page 279,\nNow if the irreversibility of God's gifts to his people, be considered, what joy for those who feel within a wicked heart."
                                            },
                                            {
                                                "example_id": "22de059a-b30c-42da-8c57-a2bad6c13fcd",
                                                "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                                "text": "1911, Power, Hill Pub. Co., page 171,\nBut because of irreversibilities in the engine, all of this theoretical conversion is not realized and some internal energy remains in the steam exhausting from the engine."
                                            },
                                            {
                                                "example_id": "b893b1a2-d462-466d-98a3-09fa9306a095",
                                                "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                                "text": "2007, Mark Currie, About Time: Narrative, Fiction and the Philosophy of Time, Edinburgh University Press, →ISBN, page 103,\nPaul Horwich, for example, in Asymmetries in Time, includes the laws of thermodynamics in a list of ten temporally asymmetric phenomena which operate in our conceptual system. Seen in this way, where the irreversibility of time is inseparable from rationality itself, the argument against backwards time tends to be expressed in terms of consequences, or the fear that time reversal is paramount to irrationality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57a25bb0-b0b5-48f1-94ba-007c241214f0",
                        "source_entry_id": "f47c1d3f-16ca-3bdb-95a3-301450fb75a0",
                        "source_sense_id": "88f763cd-76ee-3663-949e-3bbf0b677d25",
                        "target_lang_word": "irréversibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irréversibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3da420a7-f64f-3a19-8cd5-0deecc5b17e2",
                                        "entry_id": "9ba615e7-353c-3bd7-bb95-fd8ff2ab3cd1",
                                        "glosses": [
                                            "État de ce qui est irréversible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f3911a-695a-4f1a-b261-822631205ccf",
                                                "sense_id": "3da420a7-f64f-3a19-8cd5-0deecc5b17e2",
                                                "text": "Or, avant même de découvrir les notions d’entropie et d’irréversibilité, notre civilisation a valorisé la flèche du temps par l’idéologie du progrès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
