                                "target_senses": [
                                    {
                                        "sense_id": "2c70b943-4a4c-3280-aff2-ac68475df34b",
                                        "entry_id": "1f68624b-d353-37b9-995c-ed9d0eac02ef",
                                        "glosses": [
                                            "Déesse de la jeunesse, de la vitalité et de la vigueur, échansonne des dieux de l’Olympe jusqu’à ce qu’elle soit mariée à Héraclès."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c67c055-9bd7-4122-950d-2b31ace304f5",
                                                "sense_id": "2c70b943-4a4c-3280-aff2-ac68475df34b",
                                                "text": "La gentille échansonne\nQu’on nomme Hébé, malignement sourit,\nEt de nectar à coups pressés l’entonne."
                                            },
                                            {
                                                "example_id": "264a1e23-a8c2-4b24-a02e-f0999083906e",
                                                "sense_id": "2c70b943-4a4c-3280-aff2-ac68475df34b",
                                                "text": "La Soubrette obéit avec autant de grâce que de dextérité. Hébé versant le nectar ne s’y fût pas mieux prise. Elle faisait bien tout ce qu’elle faisait."
                                            },
                                            {
                                                "example_id": "a79cd779-0740-4600-8c76-f39398cb8cff",
                                                "sense_id": "2c70b943-4a4c-3280-aff2-ac68475df34b",
                                                "text": "Faut-il parler net ? un Hercule a besoin d'une Hébé. Il y a ici des paysannes très jolies…"
                                            },
                                            {
                                                "example_id": "74893a4b-7413-456b-b650-67be5b3a8e71",
                                                "sense_id": "2c70b943-4a4c-3280-aff2-ac68475df34b",
                                                "text": "Elle lui laisse aux doigts un verre plein, et s’en va, Hébé indifférente, servir Antoine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8690c2-cca5-3237-88f8-189e32deda60",
                                        "entry_id": "1f68624b-d353-37b9-995c-ed9d0eac02ef",
                                        "glosses": [
                                            "(6) Hébé, internationalement (6) Hebe, planète mineure."
                                        ],
