{
    "word_family": [
        "equal",
        "equality",
        "inequality",
        "equalize",
        "unequal",
        "equalizer"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                    "sense_definition": "In an equal manner or into equal parts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prize money was shared <w>equally</w> among the three winners.",
                            "target_lang_translations": {
                                "ru": "Призовой фонд был разделен <w>поровну</w> между тремя победителями.",
                                "zh": "奖金在三位获胜者之间<w>平均</w>分配了。"
                            }
                        },
                        {
                            "text": "It is important to treat everyone <w>equally</w> regardless of their background.",
                            "target_lang_translations": {
                                "ru": "Важно относиться ко всем <w>одинаково</w> вне зависимости от их происхождения.",
                                "zh": "无论背景如何，<w>平等地</w>对待每个人都很重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "evenly",
                        "fairly"
                    ],
                    "antonyms": [
                        "unequally"
                    ],
                    "common_phrases": [
                        "share equally",
                        "divide equally",
                        "treat equally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Равным образом или на равные части",
                        "zh": "以相等的方式或分成相等的份数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поровну",
                                "target_lang_sense_clarification": "на равные части"
                            },
                            {
                                "target_lang_word": "одинаково",
                                "target_lang_sense_clarification": "равным образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平均",
                                "target_lang_sense_clarification": "分成相等的份数"
                            },
                            {
                                "target_lang_word": "平等地",
                                "target_lang_sense_clarification": "以相等的方式对待"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "665410fc-a4e5-30ed-ad95-26b596086072",
                    "sense_definition": "To the same degree or level.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Both candidates are <w>equally</w> qualified for the position.",
                            "target_lang_translations": {
                                "ru": "Оба кандидата <w>одинаково</w> квалифицированы для этой должности.",
                                "zh": "两位候选人对该职位的胜任程度<w>同样</w>高。"
                            }
                        },
                        {
                            "text": "It is <w>equally</w> important to get enough sleep as it is to exercise.",
                            "target_lang_translations": {
                                "ru": "<w>В равной степени</w> важно высыпаться и заниматься спортом.",
                                "zh": "保证充足的睡眠与锻炼身体<w>同样</w>重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equivalently",
                        "just as"
                    ],
                    "antonyms": [
                        "unequally"
                    ],
                    "common_phrases": [
                        "equally important",
                        "equally effective",
                        "equally likely"
                    ],
                    "target_lang_definitions": {
                        "ru": "В равной степени или на том же уровне",
                        "zh": "达到相同的程度或水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одинаково",
                                "target_lang_sense_clarification": "в той же мере"
                            },
                            {
                                "target_lang_word": "в равной степени",
                                "target_lang_sense_clarification": "формальное выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同样",
                                "target_lang_sense_clarification": "程度相同"
                            },
                            {
                                "target_lang_word": "在同等程度上",
                                "target_lang_sense_clarification": "正式表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd4e538a-0714-3012-b072-70395f0449cf",
                    "sense_definition": "Used to introduce a statement that is as relevant or important as what was just said.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy will save money, but <w>equally</w>, it might reduce the quality of service.",
                            "target_lang_translations": {
                                "ru": "Новая политика сэкономит деньги, но <w>в то же время</w> может снизить качество обслуживания.",
                                "zh": "新政策会节省开支，但<w>同样地</w>，它也可能会降低服务质量。"
                            }
                        },
                        {
                            "text": "We must focus on sales, but <w>equally</w>, we cannot ignore customer satisfaction.",
                            "target_lang_translations": {
                                "ru": "Мы должны сосредоточиться на продажах, но <w>в то же время</w> не можем игнорировать удовлетворенность клиентов.",
                                "zh": "我们必须关注销售，但<w>与此同时</w>，我们也不能忽视客户满意度。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения утверждения, которое так же важно, как и предыдущее",
                        "zh": "用于引出与前述内容同样重要或相关的话题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в то же время",
                                "target_lang_sense_clarification": "вводная конструкция"
                            },
                            {
                                "target_lang_word": "в равной степени",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同样地",
                                "target_lang_sense_clarification": "用于转折或补充说明"
                            },
                            {
                                "target_lang_word": "与此同时",
                                "target_lang_sense_clarification": "表示并列或补充"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}