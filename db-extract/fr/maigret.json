                "senses": [
                    {
                        "sense_id": "c41bc3be-e403-3435-9ac5-8037ab143cab",
                        "entry_id": "2464ae18-0333-3079-b268-bf41e4f748a9",
                        "glosses": [
                            "Un peu trop maigre, chétif, maigrichon."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "98f6f98d-4168-4d24-b4cc-f2d2a69fd610",
                                "sense_id": "c41bc3be-e403-3435-9ac5-8037ab143cab",
                                "text": "C'était une fillette encore maigrette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9aaca907-6579-4588-8b6e-347294a8da9c",
                        "source_entry_id": "2464ae18-0333-3079-b268-bf41e4f748a9",
                        "source_sense_id": "c41bc3be-e403-3435-9ac5-8037ab143cab",
                        "target_lang_word": "dünn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dünn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "von geringer Dicke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f72df0cc-ac7e-462b-8e53-1d072b787234",
                                                "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                                "text": "Ich hätte gerne eine dünne Scheibe Brot."
                                            },
                                            {
                                                "example_id": "ef2075b4-762e-487f-98ce-cb5107896646",
                                                "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                                "text": "Das ist ja mal ein dünnes Kind."
                                            },
                                            {
                                                "example_id": "c474b565-d320-4c99-85be-3edb80079fc4",
                                                "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                                "text": "Aus einem Rezept: Eine große, beschichtete Pfanne erhitzen, 3 EL Öl dazugebe und die Hälfte der Kartoffeln locker einstreuen, so dass ein 0,5 cm dünner und 24 cm großer Kartoffelpfannkuchen entsteht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "wenig ausmachend, von geringem Ausmaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ddfd773-3814-47fb-8180-52cf9404c94f",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "Der Landstrich ist dünn besiedelt."
                                            },
                                            {
                                                "example_id": "ae1cadc2-45e3-4acb-a72a-700ae2809a9f",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "In der Höhe herrscht dünne Luft."
                                            },
                                            {
                                                "example_id": "1b4ac1c2-e36c-4382-a7a3-c35cde9fe0df",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "„Weiter vom Äquator entfernt, ist die Biosphäre dünner besiedelt.“"
                                            },
                                            {
                                                "example_id": "911a0bdf-c644-4d91-9676-898359ba5aeb",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "Noch gehört Russlands Finanzpolster zu den größten der Welt - doch es wird dünner. Erstmals seit 2009 liegen in Moskau weniger als 400 Milliarden Dollar auf der hohen Kante."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bed75f66-2a3f-3a49-a4df-14d537fe8aa8",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "viel Wasser oder Flüssigkeit enthaltend; wenig gehaltvoll an Nährstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f31ee77-f150-40c9-a7cf-9622aacc43b3",
                                                "sense_id": "bed75f66-2a3f-3a49-a4df-14d537fe8aa8",
                                                "text": "„Diese dünne Suppe schmeckt nach nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "wenig gehaltvoll in der Aussage, wenig fundiert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfdd1c92-3874-463f-9d48-74593e5f4a2f",
                                                "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                                "text": "„Deine Argumentation ist ziemlich dünn.“"
                                            },
                                            {
                                                "example_id": "b20ba41f-1cfb-4f0f-8e93-1a1b14fc910b",
                                                "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                                "text": "Wenn man die durchschnittliche Verweildauer von Vorstandsvorsitzenden deutscher Dax-Unternehmen als Grundlage nimmt, dann sind wirklich kompetente Manager dünn gesät."
                                            },
                                            {
                                                "example_id": "1faff5b8-2f89-48ae-b709-12881183d1aa",
                                                "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                                "text": "Es ist eine Art von Hollywood-Kino, wie wir sie vor 30 bis 40 Jahren einmal hatten: naiv und patriotisch, dramaturgisch dünn und lediglich auf den Effekt hin inszeniert. Der Geschehnisse des 2. Weltkrieges verkommen zur Kulisse für platte Späße und ein bisschen Action."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "64865466-09ba-3442-9963-6decd19abf88",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "kraftlos, leise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713c851d-c894-437d-a794-ca8c8cbe345b",
                                                "sense_id": "64865466-09ba-3442-9963-6decd19abf88",
                                                "text": "Wenn [Sachsens Chefin des Deutschen Gewerkschafts Bundes (DGB)] Iris Kloppich auf Marktplätzen ins Mikrofon spricht, hält ihre dünne Stimme nicht lange durch."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "504b3ef8-200f-487b-b435-6bdc68a73d80",
                        "source_entry_id": "2464ae18-0333-3079-b268-bf41e4f748a9",
