            "senses": [
                {
                    "sense_id": "ef5aef5d-e705-3c26-aaec-41326cfd2ba9",
                    "sense_definition": "Многоместный автомобиль для перевозки пассажиров по установленному маршруту.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я видел, как они садились в <w>автобус</w>.",
                            "target_lang_translations": {
                                "en": "I saw them getting on the <w>bus</w>."
                            }
                        },
                        {
                            "text": "Лыжники возле университета садились в <w>автобус</w>.",
                            "target_lang_translations": {
                                "en": "The skiers near the university were getting on the <w>bus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "маршрутка"
                    ],
                    "common_phrases": [
                        "городской автобус",
                        "ждать автобус",
                        "сесть в автобус"
                    ],
                    "target_lang_definitions": {
                        "en": "A large motor vehicle designed to carry many passengers along a fixed route."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bus",
                                "target_lang_sense_clarification": "A motor vehicle for transporting large numbers of people along roads."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e811aa9-a219-3d49-8f64-995a848f2469",
                    "sense_definition": "Оборонительная тактика в футболе с участием почти всех игроков команды.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Команда решила поставить <w>автобус</w> перед своими воротами, чтобы удержать ничью.",
                            "target_lang_translations": {
                                "en": "The team decided to <w>park the bus</w> in front of their goal to hold onto a draw."
                            }
                        },
                        {
                            "text": "Тренер приказал игрокам выстроить <w>автобус</w> в защите до конца матча.",
                            "target_lang_translations": {
                                "en": "The coach ordered the players to <w>park the bus</w> in defense until the end of the match."
                            }
                        }
                    ],
                    "synonyms": [
                        "глухая оборона"
                    ],
                    "common_phrases": [
                        "поставить автобус"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "используется в спортивном контексте"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A defensive football tactic where a team keeps almost all players in their own half to prevent the opponent from scoring."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "park the bus",
                                "target_lang_sense_clarification": "A common football idiom for a highly defensive strategy."
                            }
                        ]
                    }
                }
            ]
        }
    ]
