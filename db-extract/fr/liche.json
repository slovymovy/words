                ],
                "senses": [
                    {
                        "sense_id": "a6422125-6f28-3c8d-9732-b0ac38fe6d2a",
                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                        "glosses": [
                            "Variante de lèche."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c7b36600-7de4-4303-b2d3-0c3056114805",
                                "sense_id": "a6422125-6f28-3c8d-9732-b0ac38fe6d2a",
                                "text": "D'une mine revêche la paysanne donna du beurre, poussa le chapeau de la table posée sur un coffre, coupa des liches de pain, cassa ses œufs dans un plat de terre jaune."
                            }
                        ]
                    },
                    {
                        "sense_id": "c870a5cf-815b-381e-8a19-35a7c3a10c3b",
                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                        "glosses": [
                            "Fait de bien manger."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8accb2c7-ee32-3c67-a4db-471a0d38b8d4",
                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                        "glosses": [
                            "Fait de boire, de s’enivrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d70623-dfd1-4daa-93d3-05d899354589",
                                "sense_id": "8accb2c7-ee32-3c67-a4db-471a0d38b8d4",
                                "text": "Ma pauvre Amélie n’a plus eu la force de vivre, je l’ai retrouvée pendue un beau matin dans l’arbre que vous voyez en face de l’entrée, moi je me suis réfugié dans la liche pour oublier, mais j’ai rien oublié."
                            }
                        ]
                    },
                    {
                        "sense_id": "2da58e1b-48da-3626-9133-d5bea1bb6242",
                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                        "glosses": [
                            "Lichette, un petit peu de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3ff1da-0d91-4943-b738-34625e1a8d2f",
                                "sense_id": "2da58e1b-48da-3626-9133-d5bea1bb6242",
                                "text": "Je n’avais pas besoin de faire une liste pour me souvenir qu’il fallait rapporter une liche de pâté dans la pointe, deux centimètres de rillettes du Mans, du bricheton, du fromtogom ou trois betteraves."
                            }
                        ]
                    }
                ],
