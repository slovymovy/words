                "senses": [
                    {
                        "sense_id": "9c312b42-d299-3d22-b96a-b26f2441d0f1",
                        "entry_id": "8cc9388a-f4c4-38f2-ba6c-587e9643859c",
                        "glosses": [
                            "situatie waarin iets de kleinste hoeveelheid energie bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f605cb-13f4-4964-8477-2bedb63f50cf",
                                "sense_id": "9c312b42-d299-3d22-b96a-b26f2441d0f1",
                                "text": "Het hele universum bevroor voor hem, stopte alle beweging en alles kwam, van sterren tot atomen, in een rusttoestand, met de sterren als talloze koude punten zonder afmetingen, die het koude licht van een wereld daarbuiten weerspiegelden."
                            }
                        ]
                    },
                    {
                        "sense_id": "771e7df9-cd61-3c94-b522-f7b19a1acc68",
                        "entry_id": "8cc9388a-f4c4-38f2-ba6c-587e9643859c",
                        "glosses": [
                            "situatie dat iets of iemand in rust is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107829c8-1cf3-4cd7-b71e-a4a50c452d1a",
                                "sense_id": "771e7df9-cd61-3c94-b522-f7b19a1acc68",
                                "text": "De borrelende soep bevond zich waarschijnlijk in een perfecte evenwichtstoestand sommige deeltjes gaven het vacuüm een positieve energie, andere een negatieve, met als resultaat een rusttoestand."
                            },
                            {
                                "example_id": "e5cf2dd5-9a14-48e6-a877-e08b40574d3c",
                                "sense_id": "771e7df9-cd61-3c94-b522-f7b19a1acc68",
                                "text": ",,Er is ondertussen al heel wat onderzoek uitgevoerd naar de effecten van cafeïne op onze cognitieve en motorische activiteiten”, vertelt professor Patrick Cras, afdelingshoofd neurologie bij het Universitair Ziekenhuis Antwerpen. ,,Cafeïne is een stimulerende stof met effect op het orthosympathische zenuwstelsel, dat reactietijden verbetert en het lichaam uit rusttoestand haalt: dat weten we dus al langer dan vandaag.”"
                            }
                        ]
                    }
