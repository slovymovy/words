{
    "word_family": [
        "astounding",
        "astoundment",
        "astoundingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17ee1fdb-a0e6-37c5-9b0e-374194676a5e",
                    "sense_definition": "To fill with sudden wonder or amazement; to shock or bewilder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician's final trick will <w>astound</w> the entire audience.",
                            "target_lang_translations": {
                                "ru": "Финальный фокус фокусника <w>поразит</w> всю аудиторию."
                            }
                        },
                        {
                            "text": "The sheer scale of the project continues to <w>astound</w> experts in the field.",
                            "target_lang_translations": {
                                "ru": "Огромный масштаб проекта продолжает <w>изумлять</w> экспертов в этой области."
                            }
                        }
                    ],
                    "synonyms": [
                        "amaze",
                        "astonish",
                        "stun"
                    ],
                    "common_phrases": [
                        "utterly astound",
                        "completely astound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать сильное удивление, изумление или шок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поража́ть",
                                "target_lang_sense_clarification": "производить сильное впечатление, удивлять"
                            },
                            {
                                "target_lang_word": "изумля́ть",
                                "target_lang_sense_clarification": "вызывать очень сильное удивление"
                            },
                            {
                                "target_lang_word": "удивля́ть",
                                "target_lang_sense_clarification": "приводить в удивление необычайностью чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6b0b112-5a2f-3887-9390-e28e830d6f70",
                    "sense_definition": "Stunned, astonished, or bewildered.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood <w>astound</w> at the news of his sudden promotion.",
                            "target_lang_translations": {
                                "ru": "Он стоял <w>ошеломлённый</w> новостью о своем внезапном повышении."
                            }
                        },
                        {
                            "text": "The traveler remained <w>astound</w> by the beauty of the ancient ruins.",
                            "target_lang_translations": {
                                "ru": "Путешественник оставался <w>изумлённым</w> красотой древних руин."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "stunned"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изумленный, ошеломленный или сбитый с толку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошеломлённый",
                                "target_lang_sense_clarification": "крайне удивленный, пораженный чем-либо"
                            },
                            {
                                "target_lang_word": "изумлённый",
                                "target_lang_sense_clarification": "выражающий сильное удивление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}