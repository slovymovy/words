                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9506684-b9fe-49a9-9846-380bf959c109",
                                                "sense_id": "776d3137-3414-363e-88c9-dddf4b04c963",
                                                "text": "Wenn ein Fußgänger auf dem Fahrradweg steht, versucht der Radfahrer auszuweichen."
                                            },
                                            {
                                                "example_id": "92985193-3bbe-4aef-bd8e-f1166fb6466f",
                                                "sense_id": "776d3137-3414-363e-88c9-dddf4b04c963",
                                                "text": "Dem Baumstamm auf der Straße konnte ich in letzter Sekunde noch ausweichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f7c9e71-982f-38aa-973c-4165cb1805eb",
