                "senses": [
                    {
                        "sense_id": "ab47123b-6ab6-3b2c-894a-ee273e3cde32",
                        "entry_id": "0bf54b6d-0319-3cad-b51e-6d45163b5591",
                        "glosses": [
                            "eine Varietät des Griechischen, die neugriechische Volkssprache; Vergleiche auch Katharevousa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa23c72-2a25-40fa-ad2d-f2ff60950fcc",
                                "sense_id": "ab47123b-6ab6-3b2c-894a-ee273e3cde32",
                                "text": "„Sie folgen darin einem berühmten Vorbild, denn Sitia ist die Heimat von Vitzentzos Kornaros, der in der ersten Hälfte des 17. Jh. in der griechischen Volkssprache Dimotiki das Werk ›Erotokritos‹ verfaßte.“"
                            },
                            {
                                "example_id": "eb4da9ff-e5c9-4392-8c5f-b738f1ab0903",
                                "sense_id": "ab47123b-6ab6-3b2c-894a-ee273e3cde32",
                                "text": "„Den Status der Dimotiki kann man besser mit einem Terminus wie Pop-Varietät (popular variety) beschreiben, denn im Unterschied zur bildungssprachlichen Katharevussa ist die Dimotiki volkstümlich, also populär.“"
                            },
                            {
                                "example_id": "9442fddb-fd1d-45c4-93e0-1fcfd2f630a5",
                                "sense_id": "ab47123b-6ab6-3b2c-894a-ee273e3cde32",
                                "text": "„Es wird allerdings nicht auf die stark an das Altgriechische angelehnte 'Kunstsprache' Katharevusa zurückgegriffen, sondern möglichst auf die neugriechische Umgangssprache Dimotiki.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
