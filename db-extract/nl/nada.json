                        "sense_id": "fbb07c87-adbc-3345-b199-6f8d1d508450",
                        "entry_id": "8fffa230-5e62-3554-8b9d-fcec860322f4",
                        "glosses": [
                            "helemaal niets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d76a1f8-b900-4dd7-9f8f-68e7b4ea5aac",
                                "sense_id": "fbb07c87-adbc-3345-b199-6f8d1d508450",
                                "text": "Drie uur zwoegen, en wat leverde het op? Niets, noppes, nada, niente."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a4c1061-5249-44e4-88aa-e252d7c6bc38",
                        "source_entry_id": "8fffa230-5e62-3554-8b9d-fcec860322f4",
                        "source_sense_id": "fbb07c87-adbc-3345-b199-6f8d1d508450",
                        "source_sense_description": "niets",
                        "target_lang_word": "nil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0f62d54-0440-3d4e-aa1d-73f37d685fc0",
                                        "entry_id": "dee36d7f-642f-37c3-b8ff-8449214d526a",
                                        "glosses": [
                                            "Nothing; zero."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47733c4b-09a2-4646-915c-d5572d83f104",
                                                "sense_id": "b0f62d54-0440-3d4e-aa1d-73f37d685fc0",
                                                "text": "Sedatives, contrary to popular lay and medical opinion, are invaluable in those who are not aided by the simpler means. Bromides, barbital and its innumerable offspring may be used with success, their administration being supplemented with a word of warning as to the evasion of any advice from the community grandmothers contrary to its use. The danger of forming a habit is to my mind nil, except in the few instances in which patients have felt that if a little is good more is better. The necessity for not advising the patient of the nature of the remedy, except that it is not a “dope,” is obvious. An alternation of remedies is advisable in long standing cases, and its practice never reveals any tendency to habit formation."
                                            },
                                            {
                                                "example_id": "8a8c59a9-550c-4717-a019-957ec58f718b",
                                                "sense_id": "b0f62d54-0440-3d4e-aa1d-73f37d685fc0",
                                                "text": "As to Aristotle's influence on him, we are left free to conjecture whatever seems to us most plausible. For my part, I should suppose it nil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab8f9503-6654-3df7-aab4-68504a5b1963",
                                        "entry_id": "dee36d7f-642f-37c3-b8ff-8449214d526a",
                                        "glosses": [
                                            "A score of zero"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45063d73-d58a-47fd-b825-0ae4e1afd7f4",
                                                "sense_id": "ab8f9503-6654-3df7-aab4-68504a5b1963",
                                                "text": "The football match ended in a nil-nil draw."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735a28ee-6aeb-36c3-8eb0-a02f270c6075",
                                        "entry_id": "c7bbc6be-daaf-355a-b9a3-f3632eaf5b9e",
                                        "glosses": [
                                            "No, not any."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5172b713-38b4-4679-95db-b6ae12dc571b",
                                                "sense_id": "735a28ee-6aeb-36c3-8eb0-a02f270c6075",
                                                "text": "But after two or three hours and nil results, you have to accept that the trail is cold and you can't justify that level of manpower."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
