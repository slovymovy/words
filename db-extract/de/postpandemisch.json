                ],
                "senses": [
                    {
                        "sense_id": "191fdf74-edfe-3b50-a8f7-71284ebde0e9",
                        "entry_id": "52c7c38f-d8ba-31c3-9bd3-0efa83004ed0",
                        "glosses": [
                            "nach einer Pandemie; nach dem Ende einer Pandemie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd2310ee-f787-4f4b-a9f2-234fc2cea84a",
                                "sense_id": "191fdf74-edfe-3b50-a8f7-71284ebde0e9",
                                "text": "„In einer weiteren, jetzt in »Nature« veröffentlichten Untersuchung befragten die Forscher rund 5100 Personen in zehn verschiedenen Ländern nach ihrer postpandemischen Wut auf Politiker, Wissenschaftler und das politische System als Ganzes.“"
                            },
                            {
                                "example_id": "fdfb0844-8c8b-4742-9059-9e736679c8b1",
                                "sense_id": "191fdf74-edfe-3b50-a8f7-71284ebde0e9",
                                "text": "„Die postpandemische Gesellschaft zieht herauf, die Umrisse lassen sich vielleicht schon erahnen.“"
                            },
                            {
                                "example_id": "e1ed76da-f6a0-49a5-8561-31533242aade",
                                "sense_id": "191fdf74-edfe-3b50-a8f7-71284ebde0e9",
                                "text": "„Nein, die gegenwärtige Praxis im Umgang mit knappen Ressourcen wird postpandemisch keine wesentliche Rolle mehr spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
