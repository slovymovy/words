                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To wydarzenie pozostawiło <żywy> ślad w pamięci wszystkich mieszkańców.",
