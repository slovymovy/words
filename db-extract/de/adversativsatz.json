                "senses": [
                    {
                        "sense_id": "8719ed19-53cc-36a9-9af3-f157dc79e8a7",
                        "entry_id": "3302f96e-7937-3aca-8d29-5dcaac134549",
                        "glosses": [
                            "Gliedsatz, speziell Adverbialsatz, der einen Gegensatz zu dem im Hauptsatz Genannten angibt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "3cdddf4c-42d4-4af2-9b94-ae69677b2e38",
                                "sense_id": "8719ed19-53cc-36a9-9af3-f157dc79e8a7",
                                "text": "In dem Satz „Er geht lieber zum Fußball, statt dass er mir einmal zu Hilfe kommt“ ist der Gliedsatz „statt dass er mir einmal zu Hilfe kommt“ ein Adversativsatz; er gibt einen Gegensatz zwischen zwei Handlungsmöglichkeiten an. Adversativsätze werden oft mit „statt dass“, „während“ oder „wohingegen“ eingeleitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
