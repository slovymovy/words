                        "entry_id": "79478fc3-b784-33dd-ba03-c448d0d1a98b",
                        "glosses": [
                            "Nom vernaculaire de l’arroche des jardins (Atriplex hortensis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9e0283-1ce7-4742-a6ef-222b65ef4288",
                                "sense_id": "71e31541-8df8-39ca-b05d-77c64b7c8342",
                                "text": "ARROCHE, genre de plante de la famille des chénopodées, dont la principale espèce, l'arroche des jardins, est aussi connue sous les noms de belle-dame, bonne-dame, et follette."
                            }
                        ]
                    },
