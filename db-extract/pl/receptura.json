                ],
                "translations": [
                    {
                        "translation_id": "03b6705a-0874-4a9e-b785-1eb207100378",
                        "source_entry_id": "29dfbfcf-febf-367d-89cf-c2688f24a5b8",
                        "source_sense_id": "93ae9a34-a4e4-3555-acec-15bd4e7b7b09",
                        "target_lang_word": "formula",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formula",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eac64b2b-1e64-36ed-9035-d2d73d9b0685",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "Any mathematical rule expressed symbolically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d67d6c35-cc54-4583-8a7b-5f5ba3ad482c",
                                                "sense_id": "eac64b2b-1e64-36ed-9035-d2d73d9b0685",
                                                "text": "x=(-b±√)/(2a) is a formula for finding the roots of the quadratic equation ax² + bx + c = 0."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b11e9e-2a3d-38c6-bb18-aeffe5428e64",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "A symbolic expression of the structure of a compound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba8a1a5f-a1a7-42dc-ad73-2e6d67163a23",
                                                "sense_id": "59b11e9e-2a3d-38c6-bb18-aeffe5428e64",
                                                "text": "H₂O is the formula for water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "835199c5-2b3a-32fa-990a-8c12a1a264df",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "A plan or method for dealing with a problem or for achieving a result."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4f2604-a10b-400c-88de-6facfe13cc44",
                                                "sense_id": "835199c5-2b3a-32fa-990a-8c12a1a264df",
                                                "text": "The company's winning formula includes excellent service and quality products."
                                            },
                                            {
                                                "example_id": "99f97578-4b82-4b0b-a734-7f6ed3d27eec",
                                                "sense_id": "835199c5-2b3a-32fa-990a-8c12a1a264df",
                                                "text": "Shakespeare has gone back to the formula of last season, by encouraging his players to press high up the pitch and restoring Shinji Okazaki to the starting XI to scurry around between midfield and attack."
                                            },
                                            {
                                                "example_id": "49934b47-4351-4091-9900-c738412a8d96",
                                                "sense_id": "835199c5-2b3a-32fa-990a-8c12a1a264df",
                                                "text": "Delays, large and small, have a huge variety of causes, so there is no magic formula for preventing them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e92c681f-74c8-38ac-bdd4-a0b0e4d9850c",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "A formulation; a prescription; a mixture or solution made in a prescribed manner; the identity and quantities of ingredients of such a mixture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d9eb25-0c75-4586-a986-7d51e731338a",
                                                "sense_id": "e92c681f-74c8-38ac-bdd4-a0b0e4d9850c",
                                                "text": "The formula of the rocket fuel has not been revealed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37384a96-8a4b-3a43-baf9-2833ee06f605",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "A fixed phrase or set of words intended to be interpeted non-literally, typically used attitudinally or as part of convention; a formulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f5dc90b-6337-45b0-94d8-fb7225b7824f",
                                                "sense_id": "37384a96-8a4b-3a43-baf9-2833ee06f605",
                                                "text": "Avoid the typical epistolic formalae, such as \"Kind regards\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "854ccc94-fe39-38b2-96f5-e9c23c9755df",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "A formal statement of doctrine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d98b3a45-a081-4310-88cc-cd343bb77f20",
                                                "sense_id": "854ccc94-fe39-38b2-96f5-e9c23c9755df",
                                                "text": "The extract from the Missal of Constance, which was printed before the editio princeps […] does not contain the formulae for Advent, Sundays after Epiphany, Lent and the Sundays after Easter and Pentecost; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df594b5b-9f89-3742-b5e1-eae7374eabb2",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "Ellipsis of infant formula, drink given to babies to substitute for mother's milk."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "314dd205-1348-45e6-b8fc-c0a5674ac195",
                                                "sense_id": "df594b5b-9f89-3742-b5e1-eae7374eabb2",
                                                "text": "They tried switching formulas, and it seemed to work: the baby seemed more content while feeding."
                                            },
                                            {
                                                "example_id": "409d9aba-5de1-48a7-8f4c-bf2b2669e62d",
                                                "sense_id": "df594b5b-9f89-3742-b5e1-eae7374eabb2",
                                                "text": "Many women advocate for formula, insisting that women who advocate breast-feeding have become self-righteous “lactavists,” as one writer puts it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d390bc7f-953d-3f20-8fe8-c802f56e4bf2",
                                        "entry_id": "caf8220b-90d3-3c6b-a78a-4e65eaa22f2b",
                                        "glosses": [
                                            "A syntactic expression of a proposition, built up from quantifiers, logical connectives, variables, relation and operation symbols, and, depending on the type of logic, possibly other operators such as modal, temporal, deontic or epistemic ones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bbc6bb6-5499-4645-84cd-3181d5bfe9e8",
                        "source_entry_id": "29dfbfcf-febf-367d-89cf-c2688f24a5b8",
