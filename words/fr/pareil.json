    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6b0b5b92-1be1-3c26-ab66-3911369bdefa",
                    "sense_definition": "Qui est semblable ou identique à une autre personne ou à une autre chose, qui lui ressemble beaucoup.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux robes sont presque <w>pareilles</w>, mais la couleur est différente."
                        },
                        {
                            "text": "Il est <w>pareil</w> à son père : calme, patient et toujours souriant."
                        },
                        {
                            "text": "Mon frère et moi, nous avons des yeux <w>pareils</w>."
                        }
                    ],
                    "synonyms": [
                        "identique",
                        "similaire",
                        "semblable"
                    ],
                    "antonyms": [
                        "différent"
                    ],
                    "common_phrases": [
                        "pareil à",
                        "presque pareil",
                        "tout à fait pareil"
                    ]
                },
                {
                    "sense_id": "869d4719-fc92-38fb-89b0-1e5d4ab21df9",
                    "sense_definition": "Tel, de cette nature, de cette sorte ; se dit pour désigner une chose du même genre que celle dont on parle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'ai jamais vu une chose <w>pareille</w> de toute ma vie."
                        },
                        {
                            "text": "En <w>pareil</w> cas, il vaut mieux appeler un médecin tout de suite."
                        },
                        {
                            "text": "Comment peut-on dire une <w>pareille</w> bêtise devant tout le monde ?"
                        }
                    ],
                    "synonyms": [
                        "tel"
                    ],
                    "common_phrases": [
                        "en pareil cas",
                        "une chose pareille",
                        "par un temps pareil"
                    ]
                },
                {
                    "sense_id": "f17086b3-f7a2-3353-b48b-b04b1a1e0f5c",
                    "sense_definition": "De même, la même chose (emploi elliptique, utilisé pour dire que ce qui vient d'être dit vaut aussi pour autre chose ou quelqu'un d'autre).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour mon frère, <w>pareil</w> : il n'a rien compris à l'exercice."
                        },
                        {
                            "text": "Elle déteste le froid, et moi <w>pareil</w>, alors nous restons à la maison."
                        }
                    ],
                    "common_phrases": [
                        "pareil pour"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier, surtout à l'oral"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2cc8027d-8235-33f2-9d49-6db90e236d6c",
                    "sense_definition": "De la même manière, à l'identique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elles étaient habillées <w>pareil</w> pour la fête de l'école."
                        },
                        {
                            "text": "Mon frère et moi, nous pensons <w>pareil</w> sur ce sujet."
                        },
                        {
                            "text": "Si tu fais comme lui, je ferai <w>pareil</w>."
                        }
                    ],
                    "antonyms": [
                        "différemment"
                    ],
                    "common_phrases": [
