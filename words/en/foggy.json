    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0393d19c-2f71-3248-a268-0659484fcfe3",
                    "sense_definition": "Full of or obscured by thick mist or fog, making it difficult to see.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather_and_visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers were advised to slow down on the <w>foggy</w> morning because visibility was poor.",
                            "target_lang_translations": {
                                "fr": "Il a été conseillé aux conducteurs de ralentir en cette matinée <w>brumeuse</w> en raison de la mauvaise visibilité."
                            }
                        },
                        {
                            "text": "Apart from a cold and <w>foggy</w> day, the rest of the week was bright and sunny.",
                            "target_lang_translations": {
                                "fr": "À part une journée froide et <w>brumeuse</w>, le reste de la semaine a été lumineux et ensoleillé."
                            }
                        }
                    ],
                    "synonyms": [
                        "misty",
                        "hazy"
                    ],
                    "antonyms": [
                        "clear",
                        "sunny"
                    ],
                    "common_phrases": [
                        "foggy morning",
                        "foggy day",
                        "foggy weather"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rempli ou obscurci par un épais brouillard ou une brume dense, réduisant la visibilité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "brumeux",
                                "target_lang_sense_clarification": "temps ou paysage enveloppé de brume"
                            },
                            {
                                "target_lang_word": "embrumé",
                                "target_lang_sense_clarification": "couvert de brouillard ou de brume"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d807e910-a777-3f8a-9ad9-ed0c39f0da23",
                    "sense_definition": "Mentally unclear, confused, or indistinct.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mind felt completely <w>foggy</w> after waking up from the deep sleep.",
                            "target_lang_translations": {
                                "fr": "Son esprit était complètement <w>embrumé</w> après s'être réveillé de ce sommeil profond."
                            }
                        },
                        {
                            "text": "I only have a <w>foggy</w> memory of what happened during that busy week.",
                            "target_lang_translations": {
                                "fr": "Je n'ai qu'un souvenir <w>flou</w> de ce qui s'est passé pendant cette semaine chargée."
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "muddled",
                        "befuddled",
                        "vague"
                    ],
                    "antonyms": [
                        "sharp",
                        "clear"
                    ],
                    "common_phrases": [
                        "foggy memory",
                        "foggy mind",
                        "not have the foggiest idea"
                    ],
                    "target_lang_definitions": {
                        "fr": "Peu clair mentalement, confus, vague ou indistinct."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "embrumé",
                                "target_lang_sense_clarification": "esprit ou pensées confus et peu clairs"
                            },
                            {
                                "target_lang_word": "brumeux",
                                "target_lang_sense_clarification": "souvenir ou idée vague et imprécis"
                            },
                            {
                                "target_lang_word": "engourdi",
                                "target_lang_sense_clarification": "esprit ralenti ou manquant de vivacité"
                            },
                            {
                                "target_lang_word": "flou",
                                "target_lang_sense_clarification": "souvenir indistinct ou imprécis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98c89139-f215-3beb-abea-2d4d2a8a907a",
                    "sense_definition": "Relating to or covered with aftermath or coarse grass left behind after cutting, or with moss.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep were allowed to feed on the <w>foggy</w> grass throughout the damp winter months.",
                            "target_lang_translations": {
                                "fr": "Les moutons ont pu se nourrir de l'<w>herbe de regain</w> tout au long des mois humides d'hiver."
                            }
                        },
                        {
                            "text": "Cattle grazed peacefully across the wide and <w>foggy</w> meadow late in the season.",
                            "target_lang_translations": {
                                "fr": "Le bétail paissait paisiblement dans la vaste prairie de <w>regain</w> tard dans la saison."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to aftermath or coarse grass left standing"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in regional agricultural descriptions"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Relatif à de l'herbe haute, grossière ou au regain laissé sur pied après la fauche, ou couvert de mousse."
                    },
                    "translations": {
                        "fr": []
                    }
                }
            ]
        }
    ]
}