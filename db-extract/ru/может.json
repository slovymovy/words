                "entry_id": "5b207c40-e864-3cd9-8df1-a8bd008cca6f",
                "word": "может",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "512088e8-1777-3e29-9ecf-de30e21235f1",
                        "entry_id": "5b207c40-e864-3cd9-8df1-a8bd008cca6f",
                        "glosses": [
                            "может быть; возможно; вероятно"
                        ],
                        "tags": [
                            "употребляется при выражении неуверенного подтверждения"
                        ],
                        "examples": [
                            {
                                "example_id": "678cecb6-7af9-4155-85fa-e9428080c73a",
                                "sense_id": "512088e8-1777-3e29-9ecf-de30e21235f1",
                                "text": "Степаныч мужик богобоязненный; может, он молится этому угоднику, ну и носит на лице молитвенника печать; да ты вовсе и не понимаешь, брат, сих, можно сказать, эмблематических начертаний; а кощунства никакого тут нет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69eaf69c-b837-4329-8854-50c81aa7a6be",
                        "source_entry_id": "5b207c40-e864-3cd9-8df1-a8bd008cca6f",
                        "source_sense_id": "512088e8-1777-3e29-9ecf-de30e21235f1",
                        "target_lang_word": "probably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "probably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                        "entry_id": "9bf83edc-da60-354a-a451-2e5a06dcde06",
                                        "glosses": [
                                            "In all likelihood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0771d08f-2890-4085-91bd-2db9514ceacc",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "He probably will arrive tomorrow."
                                            },
                                            {
                                                "example_id": "a8f6ab86-a241-4e97-a094-9f79f409cd5e",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably he'll arrive tomorrow."
                                            },
                                            {
                                                "example_id": "c64c27a4-3184-4fcf-befb-c946c4605a67",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "It is probably too late for amends."
                                            },
                                            {
                                                "example_id": "4dcfb15c-72e1-442f-a97d-d7ef680beedd",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "It probably is too late for amends."
                                            },
                                            {
                                                "example_id": "f19817ff-0a76-493f-8ca5-5737e843fc2a",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "She probably has arrived by now."
                                            },
                                            {
                                                "example_id": "8018e839-ce26-418c-8b1b-b20d909e3c46",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "She has probably arrived by now."
                                            },
                                            {
                                                "example_id": "dd514415-8f91-4104-b79e-37b1bf925ff1",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably she has arrived by now."
                                            },
                                            {
                                                "example_id": "36c31054-dc7f-464a-be9d-298b0be2fd9d",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "He'll probably arrive tomorrow."
                                            },
                                            {
                                                "example_id": "549698ed-29d3-43bd-8710-acfb4ef08179",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably it is too late for amends."
                                            },
                                            {
                                                "example_id": "39796ad0-3c6a-440f-844a-39326eaa5e02",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes[…]. And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            },
                                            {
                                                "example_id": "90162654-b440-4543-9e91-ed126046e67b",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close[…]above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them. Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "faff6e96-aef5-4695-9025-6aa367f6923f",
                        "source_entry_id": "5b207c40-e864-3cd9-8df1-a8bd008cca6f",
                        "source_sense_id": "512088e8-1777-3e29-9ecf-de30e21235f1",
                        "target_lang_word": "perhaps",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perhaps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                        "entry_id": "ad07d514-0a7a-35f0-ad74-4fbab5f6b81c",
                                        "glosses": [
                                            "Possibly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21dbfdf4-08dc-40d1-b8e8-e8a24b6f507c",
                                                "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                                "text": "Perhaps John will come over for dinner."
                                            },
                                            {
                                                "example_id": "c47ff0b3-9815-47d2-9922-8ef718f9eb8b",
                                                "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                                "text": "There was a perhaps credible witness."
                                            },
                                            {
                                                "example_id": "88d580a7-cdec-4942-a3ba-5e31cfcdf78b",
                                                "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                                "text": "He was seriously wounded, perhaps fatally."
                                            },
                                            {
                                                "example_id": "b246ec1d-a7cb-4ea1-a734-6a5e58909713",
                                                "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed."
                                            },
                                            {
                                                "example_id": "e8cc1642-af30-4ddb-b99e-2a84abb455e1",
                                                "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "3d36bc7e-6e33-4344-8e1e-b8a318ae206a",
                                                "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            },
                                            {
                                                "example_id": "a2c9c859-4a54-40df-aeea-1dd16d9c7533",
                                                "sense_id": "51db0f5d-059c-31aa-b76d-3beac31130d2",
                                                "text": "However, before most of this was experimentally and observationally discovered, they were perhaps best known for their “almost unique” ability to squirt ink when harangued, creating a smokescreen before jetting off to safety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a41e3fa0-ce57-3575-9a08-1d331cacbeb0",
                                        "entry_id": "ad07d514-0a7a-35f0-ad74-4fbab5f6b81c",
                                        "glosses": [
                                            "By chance."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f71369de-9216-4627-ad75-768da5d8068a",
                                                "sense_id": "a41e3fa0-ce57-3575-9a08-1d331cacbeb0",
                                                "text": "[…] will live until he dies perhaps, and then lie down in clover."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perhaps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8ad938-8367-334b-b87b-45e52c2bf659",
                                        "entry_id": "13fdd849-91bf-335d-8f8e-309d0d751e4b",
                                        "glosses": [
                                            "An uncertainty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12b596e-23d3-40b6-a440-2702b263a123",
                                                "sense_id": "2e8ad938-8367-334b-b87b-45e52c2bf659",
                                                "text": "I cannot conceive what atheism, or skepticism, or positivism could do for me now, with their negations, and endless and contradictory perhapses, and perhapses, and perhapses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fddd53d-fe44-4a65-ad46-2dab49abf194",
                        "source_entry_id": "5b207c40-e864-3cd9-8df1-a8bd008cca6f",
                        "source_sense_id": "512088e8-1777-3e29-9ecf-de30e21235f1",
                        "target_lang_word": "maybe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maybe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20e18ae1-a6a4-3b27-8008-a4af05713a8a",
                                        "entry_id": "2b13f53b-b626-3b03-861f-57315a387c4c",
                                        "glosses": [
                                            "Perhaps, possibly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7efc7b21-ae38-417e-b203-005ef7fb29b0",
                                                "sense_id": "20e18ae1-a6a4-3b27-8008-a4af05713a8a",
                                                "text": "A small extra effort now can maybe save you much work later."
                                            },
                                            {
                                                "example_id": "6ea5bddb-ee5c-4834-8c8f-93c9b38d66f2",
                                                "sense_id": "20e18ae1-a6a4-3b27-8008-a4af05713a8a",
                                                "text": "Maybe I was imagining it, but I could swear that the dog understood what I was saying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f619ce02-3add-3ced-a921-06b322f548c8",
                                        "entry_id": "2b13f53b-b626-3b03-861f-57315a387c4c",
                                        "glosses": [
                                            "Perhaps that is true (expressing no commitment to a decision or a neutral viewpoint to a statement)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99a8108-bc7a-4102-b963-657f19f3a129",
                                                "sense_id": "f619ce02-3add-3ced-a921-06b322f548c8",
                                                "text": "Okay. See you later, maybe. — Maybe I’ll see you later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f968a627-407d-31a7-a797-980a4fa761ca",
                                        "entry_id": "2b13f53b-b626-3b03-861f-57315a387c4c",
                                        "glosses": [
                                            "Certainly."
                                        ],
                                        "tags": [
                                            "UK",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c57e23f9-2ae4-4ae6-bf07-006777faebf6",
                                                "sense_id": "f968a627-407d-31a7-a797-980a4fa761ca",
                                                "text": "Maybe not the best idea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maybe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53201c13-b25f-367f-aa58-2d616fd2b857",
