                            },
                            {
                                "target_lang_word": "trepidation",
                                "target_lang_sense_clarification": "feeling of fear or agitation about something that may happen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0891326-1680-33a7-875b-7c58b88a0320",
                    "sense_definition": "uczucie nabożnej czci i szacunku połączone z lękiem przed majestatem Boga",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni modlili się w skupieniu i z wielką <w>bojaźnią</w> Bożą w sercach.",
                            "target_lang_translations": {
                                "en": "The faithful prayed in concentration and with great <w>fear</w> of God in their hearts."
                            }
                        },
                        {
                            "text": "Kaznodzieja przypominał parafianom, czym jest prawdziwa <w>bojaźń</w> wobec stwórcy.",
                            "target_lang_translations": {
                                "en": "The preacher reminded the parishioners what true <w>awe</w> toward the Creator really is."
                            }
                        }
                    ],
                    "antonyms": [
