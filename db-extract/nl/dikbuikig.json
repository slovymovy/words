                        "sense_id": "d694f0fc-7ea2-3051-aa82-7cb3b9216422",
                        "entry_id": "533e7f76-1147-3677-8949-c53802682a8a",
                        "glosses": [
                            "met een dikke buik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e089b2ed-af20-4043-b0fd-7a4d1888ef78",
                                "sense_id": "d694f0fc-7ea2-3051-aa82-7cb3b9216422",
                                "text": "Hij heeft jarenlang motorgereden, drinkt overvloedige hoeveelheden bier en springt zo vaak als maar kan dikbuikig het water in."
                            },
                            {
                                "example_id": "156e12f4-14af-49e7-a392-7019e695ea00",
                                "sense_id": "d694f0fc-7ea2-3051-aa82-7cb3b9216422",
                                "text": "Ik geniet trouwens ook erg van de vrijdagavondsenioren die voor de buis roepen dat ze zó van de Leeuwinnen winnen. Laten we het één keer doen, mensen. Elf dikbuikige mannelijke amateurs tegenover Sari en co."
                            }
                        ]
                    }
