                ],
                "senses": [
                    {
                        "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                        "entry_id": "f4528ff7-3ff1-30a1-92d0-85b8de69b8b4",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2663772-f7a7-461b-8957-f8a19a5f90f2",
                                "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                                "text": "Frau Fontane ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a3825dce-f065-4e60-b55a-f712ca53bbb2",
                                "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                                "text": "Herr Fontane wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cdca07c2-64df-471a-80cc-e0febd69b182",
                                "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                                "text": "Die Fontanes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a5b476a4-8337-47d3-aeed-ff950627d5a8",
                                "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                                "text": "Der Fontane trägt nie die Schals, die die Fontane ihm strickt."
                            },
                            {
                                "example_id": "202642d7-dff4-494b-80ee-7df023261e4d",
                                "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fontane kommt, geht der Herr Fontane.“"
                            },
                            {
                                "example_id": "f3c249cf-a060-456d-a123-4d088671334c",
                                "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                                "text": "Fontane kommt und geht."
                            },
                            {
                                "example_id": "6a6b9630-3874-43e4-b364-f132206577f2",
                                "sense_id": "0c244d24-c168-3395-a715-82d392a6b4c9",
                                "text": "Fontanes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
