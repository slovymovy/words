                "senses": [
                    {
                        "sense_id": "c609ff2f-f4e9-3693-be22-f4cfd51d1087",
                        "entry_id": "e8904b77-7e03-3835-baf5-ebeb3ffa66b7",
                        "glosses": [
                            "zagłębienie w nawierzchni drogi wyjeżdżone kołami pojazdów lub wybite kopytami zwierząt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d5c88f-236b-43e9-b324-4fc52b4cb279",
                                "sense_id": "c609ff2f-f4e9-3693-be22-f4cfd51d1087",
                                "text": "Polna droga, którą przeganiano bydło, pełna była wybojów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa32b3e7-7560-401c-86e7-6002ea21948f",
                        "source_entry_id": "e8904b77-7e03-3835-baf5-ebeb3ffa66b7",
                        "source_sense_id": "c609ff2f-f4e9-3693-be22-f4cfd51d1087",
                        "target_lang_word": "nid-de-poule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nid-de-poule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                        "entry_id": "cb1710cf-2b5f-3b38-8fd6-9a568ba90415",
                                        "glosses": [
                                            "Variante de nid de poule."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff0b404-0908-4f4e-b079-8e3b69e398c7",
                                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                                "text": "Bien que projeté souvent au plafond à cause des nids-de-poule qui en ce temps n’étaient pas rares sur les nationales françaises, mon oncle Henri gardait l’air serein des samouraïs face à la mort."
                                            },
                                            {
                                                "example_id": "770f49b7-2bdf-4084-9c6c-f5aacd94d4b7",
                                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                                "text": "Cahin-caha, après avoir déposé tous ses passagers palestiniens et franchi encore quelques passages difficiles sur une route semée de chicanes, de ralentisseurs et de nids-de-poule, le taxi atteint notre troisième checkpoint, Zatara."
                                            },
                                            {
                                                "example_id": "a0d80ee8-45d2-4412-8d09-22112ec2ebbc",
                                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                                "text": "La route étroite et non goudronnée, grêlée de nids-de-poule, ne cessait de monter et descendre, tout droit devant elle."
                                            },
                                            {
                                                "example_id": "53f77896-6e31-457f-a5b1-ee0dcc0e3dff",
                                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                                "text": "Les faits se sont déroulés en fin d’après-midi : selon une source judiciaire, citée par nos confrères de Lille Actu, la victime s’est fait surprendre par un nid-de-poule avant de tomber sur la tête."
                                            },
                                            {
                                                "example_id": "be6105bb-4ad7-449c-a867-c269b6f6e511",
                                                "sense_id": "2711ae57-f55f-34cd-b481-635f82801f6c",
                                                "text": "Tu es très bien habillé ! Par contre je ne sais pas quel imbécile t'a coupé les cheveux, c'est raté, il y a des nids-de-poule partout !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79fb51da-29ef-45a0-8e46-5d1cff80013c",
                        "source_entry_id": "e8904b77-7e03-3835-baf5-ebeb3ffa66b7",
                        "source_sense_id": "c609ff2f-f4e9-3693-be22-f4cfd51d1087",
                        "target_lang_word": "Schlagloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlagloch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                        "entry_id": "f99f03bf-4359-37ff-bd36-fb6aea1d8d19",
                                        "glosses": [
                                            "Loch in der Straßenoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7827c42f-5107-4ed6-a59e-2e330c0e61b8",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "Das Schlagloch in unserer Einfahrt wird immer größer."
                                            },
                                            {
                                                "example_id": "f43cee7b-08a2-4d46-ae4e-70ffce9c355c",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "Nach dem harten Winter sind die Straßen wieder voller Schlaglöcher."
                                            },
                                            {
                                                "example_id": "460a2b25-ebc4-4754-b2ba-098380d74f9f",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "In den Schlaglöchern sammelt sich das Wasser."
                                            },
                                            {
                                                "example_id": "35695c47-295a-478d-98af-f945c4254cf0",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "„Über eine Schotterpiste mit tiefen Schlaglöchern fahren wir vorsichtig bis zum Ende einer Straße.“"
                                            },
                                            {
                                                "example_id": "3f5f9f4a-76dd-4097-b019-0a50445d6494",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "„Von den Bergen läuft klares Quellwasser über die Fahrbahn, auf der Schlaglöcher den Asphalt teilweise fast vollständig verdrängt haben.“"
                                            },
                                            {
                                                "example_id": "314d008d-aed5-4c11-9b45-7da2bb1a821c",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "„Hier im Süden gehört das Schlagloch zur Straße wie das Blitzgerät.“"
                                            },
                                            {
                                                "example_id": "0fc98fbb-8a13-4636-955f-d8cbac495a9b",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "„Es gab einige Schlaglöcher und etwas Schotter, aber nichts Außergewöhnliches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
