                ],
                "senses": [
                    {
                        "sense_id": "e470eebb-b842-3ad2-9650-d24d25b60049",
                        "entry_id": "082898d3-2c9e-3138-bdd6-7815da40a06e",
                        "glosses": [
                            "Region, in der eine bestimmte Sprache vorkommt, während um sie herum eine andere Sprache verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f0caa52-8f32-47e8-beb7-9363bc42926a",
                                "sense_id": "e470eebb-b842-3ad2-9650-d24d25b60049",
                                "text": "Sprachinseln sind z.B. das Saterfriesische in Niedersachsen und die deutschen Sprachregionen in Amerika, Russland, Siebenbürgen und vielen anderen Regionen der Erde."
                            },
                            {
                                "example_id": "0e88c9d8-a4d1-4672-90eb-8b57363c25da",
                                "sense_id": "e470eebb-b842-3ad2-9650-d24d25b60049",
                                "text": "„Weitere bairische Sprachinseln des Mittelalters sind Pladen und Zahre in Oberitalien…“"
                            },
                            {
                                "example_id": "f49a1a00-2680-41c8-9a96-edf7361a8957",
                                "sense_id": "e470eebb-b842-3ad2-9650-d24d25b60049",
                                "text": "„Sprachinseln sind punktuell oder flächenhaft auftretende, relativ kleine geschlossene Sprach- und Siedlungsgemeinschaften in einem anderssprachigen, relativ größeren Gebiet.“"
                            },
                            {
                                "example_id": "1df8edfd-29a8-49fa-b828-cef3184b6674",
                                "sense_id": "e470eebb-b842-3ad2-9650-d24d25b60049",
                                "text": "„Seit langem weicht das Deutsche auch an der Südgrenze seines Gebietes streckenweise zurück; besonders gefährdet ist es in den vorgelagerten Sprachinseln.“"
                            },
                            {
                                "example_id": "ac93b3c5-20ec-4671-b45e-7d0de6ae1d2d",
                                "sense_id": "e470eebb-b842-3ad2-9650-d24d25b60049",
                                "text": "„Daß das Deutsche im Prag der Jahrhundertwende eine Sprachinsel darstellte, kann man nicht bestreiten.“"
                            },
                            {
                                "example_id": "23f67577-09e3-444a-956b-2905867b123b",
                                "sense_id": "e470eebb-b842-3ad2-9650-d24d25b60049",
                                "text": "„Es waren Bewohner der Sprachinsel »Dolnaer Hütte«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
