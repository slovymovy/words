                "senses": [
                    {
                        "sense_id": "6cccf47b-42b2-3590-82da-077576162c8d",
                        "entry_id": "2a6ba056-790e-37ef-bb66-30375e5671f5",
                        "glosses": [
                            "Nom de tous les crinoïdes qui, au stade adulte, ne sont pas fixés, et qui constituent l’ordre des Comatulida."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49bdc229-6ec7-4a1f-93fd-d6dd501cc49e",
                                "sense_id": "6cccf47b-42b2-3590-82da-077576162c8d",
                                "text": "Au cours de leur développement, les larves de comatules vivent fixées au fond de la mer par une tige, mais celle-ci est rompue à la métamorphose de maturité et la^([sic]) crinoïde juvénile obtient la possibilité de nage libre."
                            },
                            {
                                "example_id": "94d5d158-06c9-42a9-b37a-2de5e2a2ee9d",
                                "sense_id": "6cccf47b-42b2-3590-82da-077576162c8d",
                                "text": "Les comatules se tiennent dans le courant et sont surtout actives la nuit."
                            },
                            {
                                "example_id": "65f901fa-3a80-4f46-8b25-0bfde314b058",
                                "sense_id": "6cccf47b-42b2-3590-82da-077576162c8d",
                                "text": "Les comatules ont un corps en forme de calice d’où partent 10 bras rayonnants portant des pinnules."
                            }
                        ]
                    }
                ],
                "translations": [
