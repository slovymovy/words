                        ],
                        "examples": [
                            {
                                "example_id": "c1f80631-5137-45dd-8c69-de212bdba561",
                                "sense_id": "bb559251-daba-37ea-b3f9-ac1903d36ab7",
                                "text": "De bestrijding van de waterrat, rioolrat of bruine rat (Rattus norvegicus) is een vak apart."
                            }
                        ]
                    },
                    {
                        "sense_id": "91073ddc-5c22-3b3c-b14e-daa6824bd068",
                        "entry_id": "f9986c26-aaf9-3f78-982f-3e1051fa71f1",
                        "glosses": [
                            "opdringerige journalist"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "36b920d0-f85d-42e7-9953-6ce9c11952ad",
                                "sense_id": "91073ddc-5c22-3b3c-b14e-daa6824bd068",
                                "text": "'Dit moet stoppen', zei X. in het Radio 1-programma De Nieuws BV. De PVV'er is boos dat zijn naam tijdens de uitzending op de achtergrond was te zien met de krantenkop dat hij werd beschuldigd van vrouwenmishandeling. X. is hier nooit voor vervolgd en hij is er klaar mee dat 'bepaalde rioolratten' hierover doorgaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c4a5ae5-8974-3666-8bf3-e91944906b8a",
                        "entry_id": "f9986c26-aaf9-3f78-982f-3e1051fa71f1",
                        "glosses": [
                            "gemeen persoon"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d8c8100b-b4bd-43a9-b0d3-082afdeb1d23",
                                "sense_id": "7c4a5ae5-8974-3666-8bf3-e91944906b8a",
                                "text": "‘Fuck you’ roepen tegen een agent mag, aldus de rechter. ‘Mierenneuker’ ook. Maar ‘eikel’ en ‘smerige rioolrat’, dat tolereert justitie niet.- Rechters oordelen divers over de strafbaarheid van schuttingtaal."
                            }
                        ]
                    }
                ],
