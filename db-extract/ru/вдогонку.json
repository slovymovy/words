                    {
                        "sense_id": "70b81cff-b1c0-3248-b168-a46fcc1eff8a",
                        "entry_id": "f419de3d-e80c-3603-9745-2adb5cce88f0",
                        "glosses": [
                            "追隨地，緊跟地"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7d7c9060-ec8b-4e5d-9bdc-c716b348a11f",
