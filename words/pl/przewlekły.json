                    "sense_id": "dffde118-34e5-300c-9fe7-d97055024742",
                    "sense_definition": "o chorobie lub dolegliwości: trwający przez długi czas, trudny do wyleczenia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz zdiagnozował u pacjenta <w>przewlekłe</w> zapalenie oskrzeli, które wymaga stałej opieki medycznej.",
                            "target_lang_translations": {
                                "ru": "Врач диагностировал у пациента <w>хронический</w> бронхит, требующий постоянного медицинского наблюдения."
                            }
                        },
                        {
                            "text": "Osoby starsze często zmagają się z <w>przewlekłym</w> bólem stawów.",
                            "target_lang_translations": {
                                "ru": "Пожилые люди часто сталкиваются с <w>хронической</w> суставной болью."
                            }
                        }
                    ],
                    "synonyms": [
                        "chroniczny"
                    ],
                    "antonyms": [
                        "ostry",
                        "napadowy"
                    ],
                    "common_phrases": [
                        "przewlekła choroba",
                        "przewlekły ból",
                        "przewlekłe zapalenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "о болезни или недуге: длящийся долгое время, трудноизлечимый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хронический",
                                "target_lang_sense_clarification": "о болезни, недуге"
                            },
                            {
                                "target_lang_word": "затяжной",
                                "target_lang_sense_clarification": "о болезни, кашле, боли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a21f03a5-0f59-3416-a9fb-89f8dde4796d",
                    "sense_definition": "trwający zbyt długo, przeciągający się w czasie",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wielu godzinach trudnych rozmów wreszcie zakończono te <w>przewlekłe</w> negocjacje pokojowe.",
                            "target_lang_translations": {
                                "ru": "После долгих часов трудных переговоров эти <w>затяжные</w> мирные переговоры наконец завершились."
                            }
                        },
                        {
                            "text": "Z powodu braków kadrowych w sądzie doszło do <w>przewlekłego</w> procesu.",
                            "target_lang_translations": {
                                "ru": "Из-за нехватки кадров в суде процесс стал <w>затяжным</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przewlekłe negocjacje",
                        "przewlekły proces",
                        "przewlekły spór"
                    ],
                    "target_lang_definitions": {
