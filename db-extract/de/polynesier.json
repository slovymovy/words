                                        "glosses": [
                                            "Habitant de la Polynésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c3ca6c-a0e1-40c1-a1be-c61a9193780b",
                                                "sense_id": "e300551e-aed5-3bde-9243-8a496adaa31a",
                                                "text": "D’après une enquête publiée en 2014 par le Sunday Times, Mohamed Bin Hammam a offert, en novembre 2010, 305 000 € au Polynésien Reynald Temarii, président de la Confédération d’Océanie de 2004 à 2010, afin de favoriser l’attribution de la Coupe du monde 2022 au Qatar un mois plus tard."
                                            }
                                        ]
