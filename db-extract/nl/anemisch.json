                                    {
                                        "sense_id": "a3ae5897-e312-3375-8aa3-40530f3ee022",
                                        "entry_id": "4462bfb8-1b23-3dc3-902b-e6c183ace629",
                                        "glosses": [
                                            "Weak; listless; lacking power, vigor, vitality, or colorfulness."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "174e6a3e-ef03-4dac-8370-8b6f046add51",
                                                "sense_id": "a3ae5897-e312-3375-8aa3-40530f3ee022",
                                                "text": "Near-synonyms: enervated, underoxygenated"
                                            },
                                            {
                                                "example_id": "753b67e1-5a2c-4a9a-a081-80e4e4f93bfa",
                                                "sense_id": "a3ae5897-e312-3375-8aa3-40530f3ee022",
                                                "text": "[H]e was one of those weak creatures full of a shifty cunning - who face neither God nor man, who face not even themselves, void of pride, timorous, anæmic, hateful souls."
                                            },
                                            {
                                                "example_id": "c80c90ed-aeb2-4a1d-b242-d680337fc459",
                                                "sense_id": "a3ae5897-e312-3375-8aa3-40530f3ee022",
                                                "text": "My ordinarily even disposition was shattered, I thought, beyond repair — a condition that was not improved by my utter abhorrence of a diet of infant's food and anemic vegetables."
                                            }
                                        ]
                                    }
                                ]
