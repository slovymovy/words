                                "target_senses": [
                                    {
                                        "sense_id": "c1474448-640b-3817-8577-6f19be88f24d",
                                        "entry_id": "82e8df81-26ea-3a62-a8c6-10c474941dfa",
                                        "glosses": [
                                            "Lehre, nach der alle Daseinsformen im Universum (physikalische, biologische, kulturelle) die Tendenz aufweisen, sich zu höher integrierten Einheiten zusammenzuschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e128edb-524e-40fb-8179-4bc626c444f6",
                                                "sense_id": "c1474448-640b-3817-8577-6f19be88f24d",
                                                "text": "Ein Kernsatz des Holismus lautet: „Das Ganze ist mehr als die Summe seiner Teile.“"
                                            },
                                            {
                                                "example_id": "3df36639-a2b7-481c-a6d1-3e66a1b5e59a",
                                                "sense_id": "c1474448-640b-3817-8577-6f19be88f24d",
                                                "text": "Der Holismus postuliert den Primat des Ganzen über seine Teile."
                                            },
                                            {
                                                "example_id": "947c5c3e-5914-4113-8bc4-4b0e211d7b8a",
                                                "sense_id": "c1474448-640b-3817-8577-6f19be88f24d",
                                                "text": "Als bedeutende Vertreter des Holismus in der Biologie bzw. Anthropologie gelten: John Scott Haldane (The philosophical Basis of Biology, London 1931) und Teilhard de Chardin (Der Mensch im Kosmos, 1955)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
