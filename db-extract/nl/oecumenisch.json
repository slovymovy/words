                "senses": [
                    {
                        "sense_id": "b8a912ce-7903-3f0c-80d9-a463df6b954a",
                        "entry_id": "d45bd830-f2d6-3645-940c-fb238c5287ce",
                        "glosses": [
                            "tussen kerken, van meerdere kerkgenootschappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74499145-62a3-4cfb-9296-3b76a6e4baa1",
                                "sense_id": "b8a912ce-7903-3f0c-80d9-a463df6b954a",
                                "text": "Bij het oecumenisch overleg konden de protestante en katholieke afgevaardigden het niet helemaal eens worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99535167-a215-42aa-9b4d-0ab69a8751d0",
                        "source_entry_id": "d45bd830-f2d6-3645-940c-fb238c5287ce",
                        "source_sense_id": "b8a912ce-7903-3f0c-80d9-a463df6b954a",
                        "source_sense_description": "tussen kerken, van meerdere kerkgenootschappen",
                        "target_lang_word": "ökumenisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ökumenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f32c2ff5-919b-3e45-8f26-a12c28feb841",
                                        "entry_id": "caa4c045-91a5-35df-83f3-846c14efda25",
                                        "glosses": [
                                            "die gesamte vom Menschen bewohnte Erde betreffend, der Lebensraum auf der Erde"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d62404e8-e5a1-49ce-835f-d31c98c5e5dd",
                                                "sense_id": "f32c2ff5-919b-3e45-8f26-a12c28feb841",
                                                "text": "„Seitdem der Glaube aufgehört hat, dass ein Gott die Schicksale der Welt im Grossen leite und, trotz aller anscheinenden Krümmungen im Pfade der Menschheit, sie doch herrlich hinausführe, müssen die Menschen selber sich ökumenische, die ganze Erde umspannende Ziele stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                        "entry_id": "caa4c045-91a5-35df-83f3-846c14efda25",
                                        "glosses": [
                                            "die Bestrebungen von Christen nach Einigung in religiösen Fragen betreffend; gemeinsam von katholischen und evangelischen Christen getragen"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce399e3-0b0f-4d92-b9df-69624af89359",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„Vor zehn Jahren luden am Rande des ersten ökumenischen Kirchentags in Berlin evangelische und katholische Christen zu einem gemeinsamen Abendmahl in die Berliner Gethsemanekirche ein.“"
                                            },
                                            {
                                                "example_id": "b911775c-de08-4f30-8d89-2f22916811e5",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„Für 2021 ist zum dritten Mal ein Ökumenischer Kirchentag geplant.“ [Anmerkung: ökumenisch wird als Adjektiv kleingeschrieben, solange es nicht Bestandteil von Eigennamen ist, beispielsweise in \"Ökumenischer Rat der Kirchen\": im Beispiel ist es also fälschlicherweise großgeschrieben)]"
                                            },
                                            {
                                                "example_id": "98849e8c-c8cc-4126-89d9-e29d945f051f",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„Mit einem Gottesdienst […] in Bochum ist heute das eintägige ökumenische Fest „Wie im Himmel so auf Erden“ zu Ende gegangen.“"
                                            },
                                            {
                                                "example_id": "112ff1ec-d91f-4a00-8e28-abee5dc37650",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„Bis zum 11. Mai läuft die Kampagne [Anmerkung: der beiden christlichen Kirchen in Deutschland], die am Sonnabend mit einem ökumenischen Gottesdienst in der Marktkirche in Hannover eröffnet worden ist.“"
                                            },
                                            {
                                                "example_id": "9f3f9dbd-335c-47d7-9474-d472d1e22d7d",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„In der Münchner Frauenkirche fand am Nachmittag ein ökumenischer Gedenkgottesdienst zum Amoklauf am 22. Juli im Olympia Einkaufszentrum statt.“"
                                            },
                                            {
                                                "example_id": "9709293c-b34e-4252-87da-eee658eaa659",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„In wenigen Monaten starten die 42. Passionsspiele in Oberammergau. Erstmals gab es den Segen ökumenisch von beiden Kirchen.“"
                                            },
                                            {
                                                "example_id": "68292540-a75f-4191-9f9a-668413d6115c",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„»Die Beziehungen der Rumänischen Orthodoxen Kirche zur Römisch-Katholischen Kirche sind absolut elegant und basieren auf einem ökumenischen Dialog, der als historisch angesehen werden kann«, versicherte der Sprecher des rumänisch-orthodoxen Patriarchats, Vasile Banescu, im DW-Interview.“"
                                            },
                                            {
                                                "example_id": "83d8ee08-6f11-4783-9596-34ba3c3bb88f",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„Am geplanten ökumenischen Krankenhaus in Flensburg sollen keine Schwangerschaftsabbrüche durchgeführt werden. Darauf haben sich die beiden kirchlichen Träger Diakonie und Malteser geeinigt.“"
                                            },
                                            {
                                                "example_id": "916bb6ea-aee2-4718-81cb-7fc4b7e4a840",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„Die geplante ökumenische Eucharistiefeier in Dübendorf fand nicht statt. Aus Angst vor negativen Folgen nahmen die zwei katholischen Priester nur als Gäste am stattdessen durchgeführten Abendmahl teil. Der orthodoxe Priester erschien gar nicht.“"
                                            },
                                            {
                                                "example_id": "d48d4b39-ce35-492d-ac58-dc2ee4a3bb1a",
                                                "sense_id": "731b9d84-98d4-376c-b7b3-09c5338fa342",
                                                "text": "„17 Uhr Beginn Martinsumzug in der Innenstadt mit dem Heiligen Martin auf dem Pferd zur Kreuzkirche. […] 17:30 Uhr beginnt eine ökumenische Andacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1738e40f-b7d9-3657-9e1a-621576a4b16a",
                                        "entry_id": "caa4c045-91a5-35df-83f3-846c14efda25",
                                        "glosses": [
                                            "alle katholischen Christen (der gesamten Welt) umfassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff2a8412-3d3e-47bc-a035-29eb80c67aab",
                                                "sense_id": "1738e40f-b7d9-3657-9e1a-621576a4b16a",
                                                "text": "„1590 erkennt eine ökumenische Synode in Konstantinopel das neue Patriarchat als eigenständige (autokephale) Kirche mit völliger Rechts-, Verwaltungs- und Lehrautonomie an“."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7b782fb-2ba6-4794-a0c1-81aada9f2a91",
                        "source_entry_id": "d45bd830-f2d6-3645-940c-fb238c5287ce",
