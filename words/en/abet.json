    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6e7f5b0-d0e7-34c8-87d8-52a42ae4e379",
                    "sense_definition": "To assist or encourage someone in the commission of a crime or wrongdoing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accomplice was charged with <w>aiding</w> and <w>abetting</w> the bank robbery."
                        },
                        {
                            "text": "He was accused of <w>abetting</w> the criminal activities of the local gang."
                        }
                    ],
                    "synonyms": [
                        "collude",
                        "conspire",
                        "connive"
                    ],
                    "antonyms": [
                        "deter"
                    ],
                    "common_phrases": [
                        "aid and abet"
                    ]
                },
                {
                    "sense_id": "8254f5d8-8fa0-3eb8-950d-fc6d0cf0a573",
                    "sense_definition": "To support, maintain, or provide aid to a cause, opinion, or action.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His ambitious project was <w>abetted</w> by a generous grant from the foundation."
                        },
                        {
                            "text": "The harsh weather <w>abetted</w> our efforts to stay indoors and finish the book."
                        }
                    ],
                    "synonyms": [
                        "support",
                        "promote",
                        "sanction"
                    ],
                    "antonyms": [
                        "counteract",
                        "hurdle"
                    ]
                },
                {
                    "sense_id": "15fd350e-e366-3765-82ba-6950b4d534d8",
                    "sense_definition": "To urge on or stimulate someone to perform a desirable action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "encouragement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach <w>abetted</w> the young athlete to push past her personal limits."
                        },
                        {
                            "text": "Friends <w>abetted</w> his decision to pursue a career in the arts."
                        }
                    ],
                    "synonyms": [
                        "encourage",
                        "urge",
                        "instigate"
                    ]
                }
            ]
        },
