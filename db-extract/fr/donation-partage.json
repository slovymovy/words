                        "entry_id": "bb0abef3-cec3-3c46-9472-9b431b4ef412",
                        "glosses": [
                            "Transmission de bien notarié à parts non obligatoirement égales évaluées à la donation et non au décès du donateur."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "e2887b35-a1be-4e99-9546-5f8d612d5b08",
                                "sense_id": "4e931676-0462-3cf3-9e79-91c0a32f7b4a",
                                "text": "Pour éviter cela, mieux vaut passer par une donation-partage. Réalisée devant un notaire, elle fige la valeur des biens donnés au jour de la donation."
                            },
                            {
                                "example_id": "82c3580a-2050-4c08-9944-bfc275fd22c7",
                                "sense_id": "4e931676-0462-3cf3-9e79-91c0a32f7b4a",
                                "text": "La donation-partage, elle, est préconisée si le donateur a au moins deux enfants et souhaite leur transmettre un ou plusieurs biens."
                            }
                        ]
                    }
