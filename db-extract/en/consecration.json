                                        "entry_id": "4760fd93-dd83-319a-90ad-70585c54db15",
                                        "glosses": [
                                            "gebeurtenis of rituele handeling waardoor personen, plaatsen of zaken aan een godheid of hogere macht worden toegeheiligd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed9e1b1-e992-4a8d-8587-50a5e175afd7",
                                                "sense_id": "0d2c8553-1b97-3eeb-9c7b-201e10cc0968",
                                                "text": "Prinses Beatrix zou niet houden van de katholieke kerk, zo wordt vaak beweerd. In de kathedraal Sint Bavo bleek gisteren het tegendeel. Nadat zij de plechtige wijding van het gerestaureerde middenschip bijwoonde, gaf de prinses aan dat zij nog eens terugkomt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd374994-d0cc-3946-92e7-709141374a3d",
                                        "entry_id": "4760fd93-dd83-319a-90ad-70585c54db15",
                                        "glosses": [
                                            "sacrament waarmee een man gelijkvormig wordt gemaakt aan Jezus en daarom in zijn naam kan handelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8528ab-c2b9-4e12-92ff-15409c6fdb78",
                                                "sense_id": "dd374994-d0cc-3946-92e7-709141374a3d",
                                                "text": "Het sacrament van de wijding is een van de zeven sacramenten van de katholieke kerk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
