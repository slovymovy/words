                                "target_senses": [
                                    {
                                        "sense_id": "9bb50072-a065-343c-b4ed-099670d7bdde",
                                        "entry_id": "00ed645e-be8b-3c9a-ad90-a2140186d559",
                                        "glosses": [
                                            "Dícese del lenguaje oral o escrito elevado y que suena muy bien, en especial el que va acompañado de afectación."
                                        ],
                                        "tags": [
                                            "Retórica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89387ed3-61ff-4e71-adf6-6ca94827aa6e",
                                                "sense_id": "9bb50072-a065-343c-b4ed-099670d7bdde",
                                                "text": "Winston reflexionó. No se le ocurrió ninguna pregunta y menos aún sintió el impulso de decir alguna banalidad altisonante."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9759eea-e6a3-4d3e-80dd-50998031ca15",
                        "source_entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "target_lang_word": "rimbombante",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rimbombante",
