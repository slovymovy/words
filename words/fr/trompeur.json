                    ]
                },
                {
                    "sense_id": "c9c32359-4038-3e66-928e-e5090e46efb1",
                    "sense_definition": "Qui est destiné à tromper délibérément, qui manque de loyauté ou de sincérité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mensonge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vendeur a utilisé des arguments <w>trompeurs</w> pour convaincre le client d'acheter ce produit défectueux."
                        },
                        {
                            "text": "Méfie-toi de ses belles paroles, car il a souvent un comportement <w>trompeur</w> avec les nouveaux employés."
                        }
                    ],
                    "synonyms": [
                        "mensonger",
                        "fourbe",
                        "déloyal"
                    ],
                    "antonyms": [
                        "honnête",
                        "sincère",
                        "loyal"
                    ],
                    "common_phrases": [
                        "discours trompeur",
                        "publicité trompeuse"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "243511be-4cba-325d-926b-fd28d8f0ac76",
                    "sense_definition": "Personne qui trompe ou qui dupe les autres.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce séducteur invétéré était un redoutable <w>trompeur</w> qui brisait le cœur de toutes ses prétendantes."
                        },
                        {
                            "text": "Le vieux proverbe nous rappelle qu'un <w>trompeur</w> finit toujours par trouver plus rusé que lui."
                        }
                    ],
                    "synonyms": [
                        "imposteur",
                        "tricheur",
                        "menteur"
                    ],
                    "common_phrases": [
                        "à trompeur trompeur et demi"
                    ]
                }
            ]
        }
