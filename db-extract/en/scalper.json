            {
                "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                "word": "scalper",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "42e2a71d-1a7b-4b91-a3a2-a87c9cdd1295",
                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                        "tags": [
