                "senses": [
                    {
                        "sense_id": "d139a7a5-06f8-3508-98f0-88973acfd0d5",
                        "entry_id": "8877aae4-f7b2-32e2-8913-7129ee5fd85b",
                        "glosses": [
                            "Teil eines Verbrennungsmotors, der Zylinder, Kurbelwellenlagerung und bei wassergekühlten Motoren den Wassermantel vereint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa367de-ca88-4278-b28e-4ad47fb7d4a3",
                                "sense_id": "d139a7a5-06f8-3508-98f0-88973acfd0d5",
                                "text": "„Der Motorblock liefert einen wesentlichen Bestandteil zur Dynamik des Antriebsstranges.“"
                            },
                            {
                                "example_id": "2ea4189a-6140-45ad-a5e8-3a55c8100c89",
                                "sense_id": "d139a7a5-06f8-3508-98f0-88973acfd0d5",
                                "text": "„Sie entdeckten, dass der Motorblock dreimal denselben Standardbolzen enthielt, der jeweils für einen anderen technischen Bestandteil verwendet wurde.“"
                            },
                            {
                                "example_id": "f01d4f0c-a5ed-4722-9e1a-c321d6e780d0",
                                "sense_id": "d139a7a5-06f8-3508-98f0-88973acfd0d5",
                                "text": "„Zusätzlich wurde bei meinem Modell rechts und links unterhalb des Motorblocks noch ein Gewichtsträger angeschraubt.“"
                            },
                            {
                                "example_id": "fd8c6842-76d1-4c19-a2bc-c5f52291a48f",
                                "sense_id": "d139a7a5-06f8-3508-98f0-88973acfd0d5",
                                "text": "„Im Motorraum neigt die Wasserpumpe zu Inkontinenz, Indiz ist Wasseraustritt am Lüftungsschlitz des Motorblocks am vorderen Vergaser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
