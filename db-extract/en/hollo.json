                "senses": [
                    {
                        "sense_id": "b5221db8-9b9b-38d8-9907-84fc63e2c5ef",
                        "entry_id": "945a0c2e-2730-3148-8dba-0bbd0b586040",
                        "glosses": [
                            "Hey, hello"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "147a856a-3493-405f-9297-c83e1900aff9",
                                "sense_id": "b5221db8-9b9b-38d8-9907-84fc63e2c5ef",
                                "text": "And then to Apollo hollo, trees, hollo."
                            },
                            {
                                "example_id": "ee70d60f-cbf7-4c53-aa00-c07578a11ed0",
                                "sense_id": "b5221db8-9b9b-38d8-9907-84fc63e2c5ef",
                                "text": "Presently up came the clerk; and when he saw his master, the parson, running after the three girls, he was greatly surprised, and said, \"Hollo! hollo! your reverence! whither so fast!"
                            }
                        ]
                    },
                    {
                        "sense_id": "0e25e0f4-d440-3263-9c55-da4488c88d14",
                        "entry_id": "945a0c2e-2730-3148-8dba-0bbd0b586040",
                        "glosses": [
                            "hello (expressing puzzlement or discovery)"
                        ],
                        "tags": [
                            "UK",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c643997b-b5f5-4d03-b942-ec4eeb6f97f6",
                                "sense_id": "0e25e0f4-d440-3263-9c55-da4488c88d14",
                                "text": "‘Hollo!’ he cried. ‘The blind’s down!’ I had noticed, when we were outside, that the blind was down at the front room window."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0c7b7c65-28a2-37f6-9a00-b1a73342cf24",
