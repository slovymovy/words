                ],
                "senses": [
                    {
                        "sense_id": "0b717917-c34d-350c-9777-b12856697ae2",
                        "entry_id": "867ffdeb-54be-3f29-a32f-b6eef1e046d4",
                        "glosses": [
                            "страд. прич. прош. вр. от ободрить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "5040a06f-b75b-416b-a1a7-b1a733034f55",
                                "sense_id": "0b717917-c34d-350c-9777-b12856697ae2",
                                "text": "«Чудная, ненаглядная Оксана, позволь поцеловать тебя!» произнёс ободрённый кузнец…"
                            },
                            {
                                "example_id": "c34d23e9-ae97-42b9-8e8f-cfe14556d9dc",
                                "sense_id": "0b717917-c34d-350c-9777-b12856697ae2",
                                "text": "Но Ипполит Кириллович был ободрён: никогда-то ему до сих пор не аплодировали!"
                            },
                            {
                                "example_id": "75c20afd-94df-41dc-a4de-32d2762123b6",
                                "sense_id": "0b717917-c34d-350c-9777-b12856697ae2",
                                "text": "Кутузов, сопровождая свои ободрённые победой отряды, ехал то в крытых санях, то в коляске и даже, смотря по пути, на дрожках."
                            }
                        ]
                    }
                ],
