                ],
                "senses": [
                    {
                        "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                        "entry_id": "e37b4556-c115-33c6-8d13-491817c9ab1a",
                        "glosses": [
                            "ein besonders gelungenes Werk eines Autors oder Musikers; ein vom Publikum besonders gemochtes Stück"
                        ],
                        "tags": [
                            "Theater",
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "91b2dc50-9640-4c46-bf68-18def80186c2",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "„Mehr als 300 Mal haben die beiden dieses Erfolgsstück auf der Theaterbühne in Paris gespielt.“"
                            },
                            {
                                "example_id": "8074d6e5-2fd8-473f-9c06-6ee0189f5c82",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "Die Dreigroschenoper ist das Erfolgsstück von Bertolt Brecht und Kurt Weill."
                            },
                            {
                                "example_id": "9a8ffdd8-74af-40cb-a64a-f4c3919dc569",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "[Nicole Heesters debütierte 1954] „am Wiener Volkstheater in der Titelrolle des Erfolgsstücks Gigi.“"
                            },
                            {
                                "example_id": "cf1d8ed1-5cba-4bf7-ad50-162b09fd3ee5",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "„\"Linie 1\" hat seine 2000. Vorstellung - in Korea“ – […] „Zu dem jetzigen Jubiläum wurde das Grips Theater mit dem Berliner Original des Erfolgsstückes von Volker Ludwig und Birger Heymann, das seit 1986 auf dem Spielplan am Hansaplatz steht, eingeladen.“"
                            },
                            {
                                "example_id": "87967705-d862-47ed-b460-ba4079ba5bcc",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "„Im Dezember 2006 stand Schoenfelder im Alter von 90 Jahren bereits wieder in der Farce Verdammt lang her im Renaissance-Theater in Berlin auf der Bühne. Auch ein Jahr später spielte er wiederum in dem Erfolgsstück mit.“"
                            },
                            {
                                "example_id": "b0f8ff93-6cce-4aaa-a212-353a3bff751c",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "[Piraten von Penzance von 1879:] „Klar, da treten herrlich beschränkte und gleichzeitig edelmütige Seeräuber auf, aber eigentlich ging es den Machern damals um ganz andere Piraten, nämlich die, die sich an geistigem Eigentum vergreifen, also schamlos Erfolgsstücke nachspielen, ohne den Autoren dafür auch nur einen Penny zu bezahlen.“"
                            },
                            {
                                "example_id": "fd073822-91a6-4637-a48a-889dd05dd434",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "[Bootsy Collins:] „Collins Bass ist zum Beispiel in James Browns Erfolgsstück Get Up (I Feel Like Being A) Sex Machine zu hören.“"
                            },
                            {
                                "example_id": "0d6cd201-253c-4a85-870b-406b1f900a73",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "[…] „Mahlers in jeder Hinsicht grandiose Zweite Sinfonie entwickelte sich langsam, aber stetig zum Erfolgsstück und wird heute in einem Atemzug mit Beethovens Neunter genannt.“"
                            },
                            {
                                "example_id": "8a05c9b6-e4b1-4b06-83ca-b97b9f911a3d",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "„Hörbar hat sich Helena Munktell bei der Komposition ihrer Violinsonate an dem Erfolgsstück von César Franck orientiert – in der zyklischen Anlage und im schwerblütigen Tonfall.“"
                            },
                            {
                                "example_id": "fffebc88-8b86-4b2b-b2d3-edf3f31d6db3",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "„Einspielungen der anderen zahlreichen Werke Milhauds sucht man dagegen oft vergebens, abgesehen von frühen Erfolgsstücken wie „La Création du monde“ und „Le Bœuf sur le toit“.“"
                            },
                            {
                                "example_id": "67062a7b-c187-48f2-92a9-a41bd8b13478",
                                "sense_id": "54aecd88-c2d4-30c6-9cfc-8ccca5483f03",
                                "text": "„Beethovens Violinkonzert ist allgegenwärtig, im Konzertsaal wie auf Schallplatte. Doch es war nicht das Erfolgsstück von Anfang an, kein typisches Virtuosenkonzert, in dem der Solist glänzen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
