                ],
                "senses": [
                    {
                        "sense_id": "98465a23-1905-3109-a748-7a9b81232a44",
                        "entry_id": "ba0e6ea9-c1ee-3e38-9ffc-856d85eb846d",
                        "glosses": [
                            "перенесенный ледником на большое расстояние"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f6e82b-2b29-47be-8f32-12017d186520",
                                "sense_id": "98465a23-1905-3109-a748-7a9b81232a44",
                                "text": "Нельзя мимо пройти без страха и умиления; так, кажется, и рухнет этот эрратический утес на ноги!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84e64767-e940-4ad7-8c5a-5a476b0c1b56",
                        "source_entry_id": "ba0e6ea9-c1ee-3e38-9ffc-856d85eb846d",
                        "source_sense_id": "98465a23-1905-3109-a748-7a9b81232a44",
                        "target_lang_word": "erratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2dc52d0-7d84-33a8-aef4-f686f056676f",
                                        "entry_id": "fc8832eb-f3d6-39fb-aed9-4be4ee67c308",
                                        "glosses": [
                                            "verirrt, verstreut, weit weg vom Ursprung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2646e2e0-5d17-420b-aee0-f24f4389f4af",
                                                "sense_id": "d2dc52d0-7d84-33a8-aef4-f686f056676f",
                                                "text": "Findlinge sind erratische Gesteine, die noch heute als Zeugen der Eiszeit gefunden werden können."
                                            },
                                            {
                                                "example_id": "67f518cc-9cbf-4ce2-a02b-10d385654626",
                                                "sense_id": "d2dc52d0-7d84-33a8-aef4-f686f056676f",
                                                "text": "„Selbst wenn es sich bei dieser … Vermutung um einen von Kluges berühmten pseudodokumentarischen Kunstgriffen handeln sollte, hat es sicher seine Richtigkeit mit dem solchermaßen identifizierten Syndrom, haftet doch den Berichten derer, die mit dem blanken Leben davongekommen sind, in aller Regel etwas Diskontinuierliches an, eine eigenartig erratische Qualität, die so unvereinbar ist mit einer normalen Erinnerungsinstanz, daß sie leicht den Anschein von Erfindung und Kolportage erweckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33339844-a8e9-36c3-bc3e-c43697ee39d5",
                                        "entry_id": "fc8832eb-f3d6-39fb-aed9-4be4ee67c308",
                                        "glosses": [
                                            "zufällig, unvorhersehbar"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9b7dae2-89bc-4d5d-8065-8bc84dc4f1e6",
                                                "sense_id": "33339844-a8e9-36c3-bc3e-c43697ee39d5",
                                                "text": "„In Libyen ist ein populistisch-revolutionäres Regime entstanden, dessen Entwicklung im Wesentlichen von den Inspirationen seines erratischen Führers abhängt; […]“"
                                            },
                                            {
                                                "example_id": "32e60d98-2f74-49e8-b89b-d4f82319fe34",
                                                "sense_id": "33339844-a8e9-36c3-bc3e-c43697ee39d5",
                                                "text": "„Seine krasse Fehlprognose und die erratische Orakelei vieler seiner Kollegen brachten ihn radikal zum Umdenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
