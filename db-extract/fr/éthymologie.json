                        "examples": [
                            {
                                "example_id": "6c0012b2-418f-4ffb-aa7d-3072094c2102",
                                "sense_id": "34a5e5d4-f68f-39c0-b580-6c8eb4a25cb2",
                                "text": "Or la Theologie selon l'Ethymologie de son nom parle & discourt de Dieu […]"
                            },
                            {
                                "example_id": "04c68096-546e-48a1-ae8a-597c11d326b9",
                                "sense_id": "34a5e5d4-f68f-39c0-b580-6c8eb4a25cb2",
                                "text": "Et par son invention depuis on l’a appellée sur l’éthymologie de son nom Rost, ou Rosty."
                            },
                            {
                                "example_id": "350b630b-71ae-4d00-ae66-172728323cf2",
                                "sense_id": "34a5e5d4-f68f-39c0-b580-6c8eb4a25cb2",
                                "text": "On a supposé dans tout ce qui précède, que l’atome comme l'indique l’éthymologie du mot, est insécable."
                            },
                            {
                                "example_id": "d811d335-0580-40cf-b9bc-1c6df03d406e",
                                "sense_id": "34a5e5d4-f68f-39c0-b580-6c8eb4a25cb2",
                                "text": "La notion de combat est dans l’éthymologie même du mot « démocratie » et la constitution d’adversaires est essentielle."
                            }
                        ]
                    }
