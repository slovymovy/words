                        "source_sense_description": "Zoologie, speziell Ichthyologie: junger Aal, der noch durchsichtig ist",
                        "target_lang_word": "glass eel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glass eel",
