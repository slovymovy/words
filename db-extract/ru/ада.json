                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00855f01-f3ba-4608-b61e-1aeaaac4aacf",
                                                "sense_id": "2fed4caf-0b0b-331f-ba83-d381ead9b10f",
                                                "text": "If anything, Ada is actually fairly easy to learn. The syntax is so explicit, that it is much more difficult to misunderstand what the code is doing than in C/C++."
                                            }
                                        ]
                                    },
