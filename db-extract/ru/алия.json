                                "target_senses": [
                                    {
                                        "sense_id": "3d96154e-424c-3d86-b7d0-ccfab216b000",
                                        "entry_id": "b5988199-4f80-3841-846b-e1b807bbaeb2",
                                        "glosses": [
                                            "The calling up of someone to the bimah for the reading of the Torah."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3f08541-bbf8-3266-80e7-7d259cc83d53",
                                        "entry_id": "b5988199-4f80-3841-846b-e1b807bbaeb2",
                                        "glosses": [
                                            "The immigration of Jews to Israel."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a319359-fca0-4d58-9f9f-f2d6cab12bf0",
                                                "sense_id": "e3f08541-bbf8-3266-80e7-7d259cc83d53",
                                                "text": "In the past, Yemenite Jews did not have a Bar Mitzvah ceremony at all; they first encountered this ceremony when they made Aliyah to Israel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2cc7d2-2485-3c33-9355-23ff08d2f81e",
                                        "entry_id": "b5988199-4f80-3841-846b-e1b807bbaeb2",
                                        "glosses": [
                                            "One of the major waves of immigration of Jews to Israel."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aliyah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1176dee6-c0d2-34d9-a55a-e35a10488930",
                                        "entry_id": "321ecafa-0bec-3021-aa7e-6283e6bffb1c",
                                        "glosses": [
                                            "To make aliyah, to immigrate to Israel."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e66fb53-69a5-4a42-a997-2067833b25db",
                                                "sense_id": "1176dee6-c0d2-34d9-a55a-e35a10488930",
                                                "text": "Anti-Semitism is a method of fooling Jews into aliyahing to Israel, the homeland, the sanctuary, in the pretence they will be safe. In the last 50 years how many Jews have died in Israel as a result of anti Jewish attacks....and how many have died in the diaspora?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dce651b-fbe6-474b-8b32-e5aadc8e5d96",
                        "source_entry_id": "a7196702-45e9-37b6-b9f4-208c5826aa48",
                        "target_lang_word": "Alija",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alija",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27cbdc9b-7ff3-34a3-9abb-e1395ee7b574",
                                        "entry_id": "c0fe7888-2080-3325-be9d-723d481280de",
                                        "glosses": [
                                            "die Rückkehr oder Emigration von Juden als Einzelne oder in Gruppen in das Gebiet von Israel/Palästina"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ebc7383-a05a-47c9-acc4-81935a3c5c33",
                                                "sense_id": "27cbdc9b-7ff3-34a3-9abb-e1395ee7b574",
                                                "text": "Mit der ersten (modernen) Alija von 1882–1903 kamen 20.000 bis 30.000 Einwanderer aus Osteuropa, Russland, Rumänien und dem Jemen in die südliche Levante, die damals zum Osmanischen Reich gehörte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a71b13dc-d42b-3c33-b4c3-d3a172276827",
                                        "entry_id": "c0fe7888-2080-3325-be9d-723d481280de",
                                        "glosses": [
                                            "kurz für Alijah laTorah; (Aufruf zur) Toralesung"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93090aca-2bef-4aba-856b-d4827db1c13d",
                                                "sense_id": "a71b13dc-d42b-3c33-b4c3-d3a172276827",
                                                "text": "„Während der Toralesung am Schabbat erhalten acht Männer vom Gabbai (Synagogendiener) eine Alija zur Tora. Für jeden Aufgerufenen gibt es einen Toraabschnitt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
