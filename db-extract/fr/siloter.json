                        "glosses": [
                            "Procéder à l'extinction complète de la chaux contenue dans un ciment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ad6fa09-c36e-4b50-b011-81b373dabf71",
                                "sense_id": "dfa75105-fb9c-3a66-8c23-75eec61413ae",
                                "text": "On remarque de suite que les grappiers utilisés sont très expansifs, ce qui oblige à siloter le ciment mixte parfois pendant plusieurs mois."
                            },
                            {
                                "example_id": "c8efc437-2b5b-4ad1-8ef6-b8734711f668",
                                "sense_id": "dfa75105-fb9c-3a66-8c23-75eec61413ae",
                                "text": "M. Le Chatelier a indiqué comme moyen rapide de siloter les ciments, de les chauffer à 100 degrés après y avoir ajouté de l'eau sous forme de ciment ayant déjà fait prise."
                            }
                        ]
                    }
