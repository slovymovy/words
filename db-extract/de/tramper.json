                                    },
                                    {
                                        "sense_id": "95f177e6-dc6f-3e79-bcfd-6d3fb4377b04",
                                        "entry_id": "5b9d3099-be19-3ce9-9116-5d3c8229bace",
                                        "glosses": [
                                            "An item attached to a travel bug and hidden in a geocache to be found and transported to other caches or around the world."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbbb7ad4-eb18-3835-8046-5c6a0533ed1e",
                                        "entry_id": "5b9d3099-be19-3ce9-9116-5d3c8229bace",
                                        "glosses": [
                                            "A dance move in which the dancer mimics the motions of someone thumbing a ride."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4c7ea7-995b-3715-b1fc-20de19097ade",
                                        "entry_id": "5b9d3099-be19-3ce9-9116-5d3c8229bace",
                                        "glosses": [
                                            "A bur that attaches and clings to clothing, or a bur-bearing plant."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0573f9e3-16cf-3c71-b0a7-29ffa628b6bd",
                                        "entry_id": "5b9d3099-be19-3ce9-9116-5d3c8229bace",
                                        "glosses": [
                                            "An advertisement at the end of a programme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb6e1f4-a54c-45e5-887a-9e707cbb32bb",
                                                "sense_id": "0573f9e3-16cf-3c71-b0a7-29ffa628b6bd",
                                                "text": "[…] and networks have taken steps to modify or eliminate the bunching of spots and commercials between programs which results from the use of hitchhikers and cowcatchers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ef95546-450a-463b-8d7b-fa1da8138210",
                        "source_entry_id": "53fbf09b-4e5f-3a98-a55c-da14451fe6f5",
                        "source_sense_id": "ed206545-d187-3b12-ad80-53ee1ef0c333",
                        "source_sense_description": "jemand, der per Anhalter reist",
                        "target_lang_word": "auto-stoppeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auto-stoppeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf87b00-77da-33c7-9fcc-88e22fa149aa",
                                        "entry_id": "a574153e-e66d-38ec-ac2c-531dd5d53ad2",
                                        "glosses": [
                                            "Personne qui fait de l’autostop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ece9e08-81e0-4838-b4a6-4c77d6f426b1",
                                                "sense_id": "9bf87b00-77da-33c7-9fcc-88e22fa149aa",
                                                "text": "La tenue idéale pour un auto-stoppeur est le short blanc bien repassé, la chemise impeccable, les chaussettes blanches et les chaussures de tennis. La barbe, le collier et les moustaches ne bénéficient pas d'un préjugé favorable."
                                            },
                                            {
                                                "example_id": "703c558a-b5a4-4d0f-9c1e-99461b2aacc1",
                                                "sense_id": "9bf87b00-77da-33c7-9fcc-88e22fa149aa",
                                                "text": "De là est née l’idée de recourir à l’auto-stop, mais cela d'une manière organisée donnant un maximum de satisfaction et de garantie aussi bien à l’automobiliste qu'à l’auto-stoppeur. Ainsi fut créée par l'initiative privée dans le courant du mois de mai 1978, une association sans but lucratif, dénommée \"Taxistop\"."
                                            },
                                            {
                                                "example_id": "d5e727b6-cf4d-4cff-a547-6297aee9fc2e",
                                                "sense_id": "9bf87b00-77da-33c7-9fcc-88e22fa149aa",
                                                "text": "En France, nombre d’auto-stoppeurs (étrangers en particulier) se voient refuser de l'eau, même en rase campagne. La discrimination à leur endroit dépasse souvent, en Occident, tout ce que l'on peut imaginer de méfiance et de mépris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
