                "senses": [
                    {
                        "sense_id": "4b3ee47a-c091-3645-b348-347378f3a11a",
                        "entry_id": "e4ee7314-3f4d-3371-99de-2e2fd0bf2d2b",
                        "glosses": [
                            "To issue an Anti-Social Behaviour Order to."
                        ],
                        "tags": [
                            "British",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4f1fe5a1-3be8-42d3-95a2-8457da5e0edd",
                                "sense_id": "4b3ee47a-c091-3645-b348-347378f3a11a",
                                "text": "Yes he will probably end up in the criminal justice system in a few years time - but if we ASBO him now he's going to end up there an awful lot quicker because he will breach it."
                            },
                            {
                                "example_id": "542acfae-7b3c-4577-869f-97f02c0bca91",
                                "sense_id": "4b3ee47a-c091-3645-b348-347378f3a11a",
                                "text": "\"Shut up, both of you. I've got the police here. You'll get asboed,\" Sally shouted"
                            },
                            {
                                "example_id": "0f223a20-b4f6-4f15-925d-2b22003b26f9",
                                "sense_id": "4b3ee47a-c091-3645-b348-347378f3a11a",
                                "text": "The redemptive storyline reminded me of the importance, in my own practice, of continuing to learn from the understanding of others' experiences and interactions in negotiating the new penal landscape of \"ASBOing\", portrayed so well in Rhodes' novel."
                            }
                        ]
                    }
