                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de3723d7-8e28-32fa-9a19-283e64aafda3",
                        "entry_id": "5f710d64-4ad7-3ef9-b493-25ce8c14cdce",
                        "glosses": [
                            "meist Plural: Gesamtheit der Einheiten eines Staates, die dazu da sind, diesen zu verteidigen"
                        ],
