                        "glosses": [
                            "To acquire, to procure."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b97c646f-016b-4327-865b-12e0af2fadd5",
                                "sense_id": "820fb78a-ce84-3194-baf4-96200f75c73e",
                                "text": "Frankneſs and openneſs conciliate confidence. We truſt the man who ſeems willing to truſt us."
                            }
                        ]
                    },
                    {
                        "sense_id": "3806943a-8ad9-30e3-bb50-5cca1e52b2e5",
                        "entry_id": "55c714a9-225c-335b-a7a5-bb551de33761",
                        "glosses": [
                            "To reconcile (discordant theories, demands etc.); to make compatible, bring together."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "62909da0-8334-45d7-9ac4-f58f6574c236",
                                "sense_id": "3806943a-8ad9-30e3-bb50-5cca1e52b2e5",
                                "text": "It must surely then happen, to a much greater degree, in a great nation, whose government is suddenly dissolved by the resolution of the people; and which, in taking a new form, has so many jarring interests to conciliate […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c3c3d92-9540-314f-858c-52d4e3ae3604",
                        "entry_id": "55c714a9-225c-335b-a7a5-bb551de33761",
                        "glosses": [
                            "To make calm and content, or regain the goodwill of; to placate; to propitiate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "25836af4-0c46-46a5-b488-f6740622eafe",
                                "sense_id": "9c3c3d92-9540-314f-858c-52d4e3ae3604",
                                "text": "`Surely, my father,' I answered courteously, feeling certain that I should do well to conciliate this ancient Mammon of Unrighteousness."
                            }
                        ]
                    },
                    {
                        "sense_id": "019a7e0a-761a-33a2-82dd-8c17075a29c5",
                        "entry_id": "55c714a9-225c-335b-a7a5-bb551de33761",
                        "glosses": [
                            "To mediate in a dispute."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a048245-67a4-4187-be86-a2c066e70887",
                        "source_entry_id": "55c714a9-225c-335b-a7a5-bb551de33761",
                        "source_sense_description": "make calm and content",
                        "target_lang_word": "beschwichtigen",
