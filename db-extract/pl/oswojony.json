                        "examples": [
                            {
                                "example_id": "cb18291e-a795-49e9-b31e-defe313465ac",
                                "sense_id": "351af2e2-fffc-3398-a2c0-4bbeac1ac605",
                                "text": "Z plagą mrówek poradziłem sobie, kupując oswojonego mrównika."
