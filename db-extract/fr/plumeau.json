                        "cross_references": [
                            {
                                "target_word": "пипидастр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "29c8ccb4-42a7-3b44-a013-901e4151c6e6",
                                        "entry_id": "5f6cfaf8-c4a2-385e-a015-a7a0a42e4414",
                                        "glosses": [
                                            "разг. метёлка для смахивания пыли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d73003bd-244c-45e0-a0b5-8f55e8c0cb4e",
                                                "sense_id": "29c8ccb4-42a7-3b44-a013-901e4151c6e6",
                                                "text": "В перерывах между реставрациями сотрудники музея «играют в горничных»: с самых хрупких предметов пыль снимают кистями из птичьих перьев, для менее нежных деталей интерьера используют обычные пипидастры — китайские синтетические метёлки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b797db8-48b7-3ea1-9a1a-26f6b325ac37",
                                        "entry_id": "5f6cfaf8-c4a2-385e-a015-a7a0a42e4414",
                                        "glosses": [
                                            "проф. помпон для чирлидинга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec4e4c6-0dba-491e-8d13-54edfda6bd8e",
                                                "sense_id": "4b797db8-48b7-3ea1-9a1a-26f6b325ac37",
                                                "text": "В другом уголке зала «обкатывают» номер чирлидеры. Девушки в цветных трико выделывают сложные акробатические трюки, а в промежутках между ними не забывают махать помпонами. Кстати, как выяснилось, эти самые помпоны для чирлидинга называются смешным словом «пипидастры». И используются они для привлечения внимания зрителей."
                                            }
                                        ]
                                    }
                                ]
                            },
