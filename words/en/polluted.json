    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f11d4927-298b-39cf-b6e3-ce284f42ebd1",
                    "sense_definition": "Made unclean, impure, or harmful to health, usually by chemicals or waste.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is too <w>polluted</w> for anyone to swim in safely.",
                            "target_lang_translations": {
                                "ru": "Река слишком <w>загрязнена</w>, чтобы в ней можно было безопасно купаться.",
                                "tr": "Nehir, kimsenin güvenle yüzemeyeceği kadar <w>kirli</w>.",
                                "zh": "这条河被<w>污染</w>得太严重，没人能安全地在里面游泳。",
                                "es": "El río está demasiado <w>contaminado</w> para que alguien nade en él de forma segura."
                            }
                        },
                        {
                            "text": "Many people in the city suffer from health issues caused by <w>polluted</w> air.",
                            "target_lang_translations": {
                                "ru": "Многие жители города страдают от проблем со здоровьем, вызванных <w>загрязнённым</w> воздухом.",
                                "tr": "Şehirdeki birçok insan, <w>kirli</w> havanın neden olduğu sağlık sorunlarından muzdarip.",
                                "zh": "城里许多人因<w>受污染</w>的空气而患有健康问题。",
                                "es": "Muchas personas en la ciudad sufren problemas de salud causados por el aire <w>contaminado</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foul",
                        "contaminated",
                        "dirty"
                    ],
                    "antonyms": [
                        "uncontaminated",
                        "unpolluted"
                    ],
                    "common_phrases": [
                        "polluted air",
                        "polluted water",
                        "heavily polluted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный грязным, нечистым или вредным для здоровья, обычно из-за химикатов или отходов.",
                        "tr": "Genellikle kimyasallar veya atıklar nedeniyle kirlenmiş, saflığı bozulmuş veya sağlığa zararlı hale getirilmiş.",
                        "zh": "指因化学物质或废弃物而变得不洁净、受污染或对健康有害。",
                        "es": "Que ha sido hecho impuro, sucio o dañino para la salud, generalmente debido a químicos o desechos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнённый",
                                "target_lang_sense_clarification": "содержащий вредные примеси"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kirli",
                                "target_lang_sense_clarification": "çevre, hava, su vb. için"
                            },
                            {
                                "target_lang_word": "kirlenmiş",
                                "target_lang_sense_clarification": "atıklarla kirlenmiş"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受污染的",
                                "target_lang_sense_clarification": "指环境、水或空气被有害物质破坏"
                            },
                            {
                                "target_lang_word": "脏的",
                                "target_lang_sense_clarification": "指不洁净的状态"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "contaminado",
                                "target_lang_sense_clarification": "general para sustancias o entornos"
                            },
                            {
                                "target_lang_word": "polucionado",
                                "target_lang_sense_clarification": "específico para aire o medio ambiente"
                            },
                            {
                                "target_lang_word": "sucio",
                                "target_lang_sense_clarification": "término general para falta de limpieza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb9d693c-59e5-3a8d-8366-c13bb3ba3697",
                    "sense_definition": "Extremely intoxicated with alcohol.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got absolutely <w>polluted</w> at the party and had to take a taxi home.",
                            "target_lang_translations": {
                                "ru": "Он <w>напился в хлам</w> на вечеринке, и ему пришлось ехать домой на такси.",
                                "tr": "Partide <w>zil zurna sarhoş</w> oldu ve eve taksiyle dönmek zorunda kaldı.",
                                "zh": "他在派对上<w>烂醉如泥</w>，不得不打车回家。",
                                "es": "Se puso <w>borracho perdido</w> en la fiesta y tuvo que tomar un taxi a casa."
                            }
                        },
                        {
                            "text": "They were so <w>polluted</w> by midnight that they could barely stand up.",
                            "target_lang_translations": {
                                "ru": "К полуночи они были настолько <w>пьяны</w>, что едва могли стоять на ногах.",
                                "tr": "Gece yarısına doğru o kadar <w>sarhoştular</w> ki ayakta zor durabiliyorlardı.",
                                "zh": "到午夜时他们已经<w>大醉</w>，几乎站不稳了。",
                                "es": "Estaban tan <w>ebrios</w> a medianoche que apenas podían mantenerse en pie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "absolutely polluted"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии сильного алкогольного опьянения.",
                        "tr": "Alkolün etkisiyle aşırı derecede sarhoş olmuş.",
                        "zh": "指醉得非常厉害。",
                        "es": "En estado de embriaguez extrema por consumo de alcohol."
                    },
                    "translations": {
