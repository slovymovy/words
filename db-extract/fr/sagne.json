                        "examples": [
                            {
                                "example_id": "fed2c82e-6642-46ba-a32b-d48027ae97c0",
                                "sense_id": "d03df8c6-7ae1-39cd-9099-d81ef509a78c",
                                "text": "La sagne, le roseau camarguais inséparable du paysage et du mode de vie du territoire, tapisse les parois sur lesquelles sont accrochés les tableaux, créant des allées végétales qui conduisent jusqu'à l'autel."
                            }
                        ]
                    }
