                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "Particularly with reference to waves, to reach a peak."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56f9551a-ea09-3c22-ae4e-a839778fbd53",
                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "To reach the crest of (e.g. a hill or mountain)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a413c39-dcac-4562-946f-d39dc318999f",
                                                "sense_id": "56f9551a-ea09-3c22-ae4e-a839778fbd53",
                                                "text": "the land rolls gently, so that, upon cresting a low rise or passing a copse of wind turbines, you suddenly spot a lot full of lorries or a complex of gigantic sheds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a729ea-ec0c-3943-a993-a2d1c1422019",
                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "To furnish with, or surmount as, a crest; to serve as a crest for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "374bdd56-52a7-45a5-97b3-552ba097348f",
                                                "sense_id": "f0a729ea-ec0c-3943-a993-a2d1c1422019",
                                                "text": "His legs bestrid the ocean, his reared arm / Crested the world."
                                            },
                                            {
                                                "example_id": "4204afaf-325d-4de1-a148-6404b573f0fe",
                                                "sense_id": "f0a729ea-ec0c-3943-a993-a2d1c1422019",
                                                "text": "groves of clouds that crest the mountain's brow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04f5af1-8fdb-3afd-8dd0-461a92799b66",
                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "To mark with lines or streaks like waving plumes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072467ed-bd7a-4eb1-9158-9950bf90a202",
                                                "sense_id": "d04f5af1-8fdb-3afd-8dd0-461a92799b66",
                                                "text": "Like as the shining skie in summers night, / What time the dayes with scorching heat abound, / Is creasted all with lines of firie light"
                                            }
                                        ]
                                    }
                                ]
                            }
