                        "examples": [
                            {
                                "example_id": "19898645-9e71-440b-b480-58b7e66fcb5f",
                                "sense_id": "a58102f4-7016-336f-9677-74f1a2c08c43",
                                "text": "Acteur Jason Priestley heeft spijt. Spijt van zijn voortijdige vertrek uit Beverly Hills 90210 (1990-2000), de televisieserie die zijn leven veranderde, en spijt van de losbandige jaren die daarop volgden. Hoewel hij het kettingroken, zuipen en autoracen inmiddels heeft verruild voor het savoureren van goede wijnen met zijn vrouw Naomi en het dollen met hun donderstenen Ava en Dashiell, drukken Priestleys zonden nog zwaar op zijn geweten, blijkens zijn onlangs verschenen memoires."
                            }
                        ]
                    }
