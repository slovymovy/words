                "senses": [
                    {
                        "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                        "entry_id": "81c1e8af-cbb1-3637-a7aa-a6768c1e56bd",
                        "glosses": [
                            "im Ofen überbackenes, italienisches Nudelgericht, das aus Schichten von Teigplatten und Füllung (zum Beispiel Hackfleisch oder Gemüse) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd3dec8-6025-4ded-a6f9-dbf7c210228e",
                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                "text": "Heute koche ich eine Lasagne mit Spinat und Lachs."
                            },
                            {
                                "example_id": "df3112a6-7ca4-4749-b204-d79f4afd5991",
                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                "text": "Zur Auswahl standen verschiedene Lasagnen, gefüllt mit Hackfleisch, Gemüse oder Fisch."
                            },
                            {
                                "example_id": "96c4ba31-e496-4423-9a80-7f79acf0ec5e",
                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                "text": "„Ich hätte jetzt nicht einmal die Lasagne hinuntergebracht, von der ich gelegentlich träumte.“"
                            },
                            {
                                "example_id": "dedd9ef6-9258-40e3-ae1c-f964bddfbd1f",
                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                "text": "„Ola beugte sich vor und schnitt noch ein Stück Lasagne ab, das er auf meinen Teller legte, ehe er sich selbst auch noch eins nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8aa8947-767e-4505-a418-70706a1481f7",
                        "source_entry_id": "81c1e8af-cbb1-3637-a7aa-a6768c1e56bd",
                        "source_sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                        "source_sense_description": "italienisches Nudelgericht mit Füllung",
                        "target_lang_word": "lasagna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasagna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63513df5-0ee3-3aad-832b-0645674c0b35",
                                        "entry_id": "f2763edf-b4e6-3791-a766-4f66c0e93ca9",
                                        "glosses": [
                                            "A flat sheet of pasta."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e49575a-6438-34a2-a73f-0cf0fda7e22a",
                                        "entry_id": "f2763edf-b4e6-3791-a766-4f66c0e93ca9",
                                        "glosses": [
                                            "An Italian baked dish comprising layers of such pasta with various ingredients (usually a meat ragù (chiefly Bolognese), a fish ragù or a vegetarian/vegetable ragù with bechamel sauce)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5068268-60ab-49e1-93d9-2c645c50da83",
                                                "sense_id": "9e49575a-6438-34a2-a73f-0cf0fda7e22a",
                                                "text": "I’m going to fix you a cup of coffee and a plate of lasagna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3175e1-3760-368a-b73a-39d77d5dc434",
                                        "entry_id": "f2763edf-b4e6-3791-a766-4f66c0e93ca9",
                                        "glosses": [
                                            "A combination or layering of things."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d383db29-689b-42f6-b900-44f31bbe1537",
                                                "sense_id": "cc3175e1-3760-368a-b73a-39d77d5dc434",
                                                "text": "Kristofer'd gotten it through his head shortly after their arrival to swim naked in the lake, such as it was, and his skin blemished into a lasagna of red hives, white welts, and disarming yellowish spots."
                                            },
                                            {
                                                "example_id": "827b45dd-a8ed-4e2b-b04a-4a3f5c1d14e2",
                                                "sense_id": "cc3175e1-3760-368a-b73a-39d77d5dc434",
                                                "text": "Unfortunately, typical mattresses are often a lasagna of nonbiodegradable synthetics, pesticides, and potentially carcinogenic toxins."
                                            },
                                            {
                                                "example_id": "0553cdb5-bb23-40f1-9639-fc361f763c0f",
                                                "sense_id": "cc3175e1-3760-368a-b73a-39d77d5dc434",
                                                "text": "It's sort of a lasagna of ideas about time and dreams."
                                            },
                                            {
                                                "example_id": "10628c5f-8267-4f82-bd96-39b0cbb07528",
                                                "sense_id": "cc3175e1-3760-368a-b73a-39d77d5dc434",
                                                "text": "“Everything about us is just one layer of lies after another. We're a lasagna of lies. This is a terrible basis for a relationship.”"
                                            },
                                            {
                                                "example_id": "c46df4b8-bf22-4ee3-a974-e5597b076f4e",
                                                "sense_id": "cc3175e1-3760-368a-b73a-39d77d5dc434",
                                                "text": "CHOCOLATE LASAGNA / Who says lasagna is only a main dish? Serve this easy, no-bake lasagna for dessert. / Ingredients / 2 3.9-ounce packages (110 g) instant chocolate pudding mix / 2 cups (473 mL) milk / 8 ounces (227g) whipped topping / 16 graham crackers, chocolate or plan / 1 1/2 cups (75g) mini marshmallows / chocolate syrup"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fab990e-a3b5-4167-afd9-db076f08660f",
                        "source_entry_id": "81c1e8af-cbb1-3637-a7aa-a6768c1e56bd",
                        "source_sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                        "source_sense_description": "italienisches Nudelgericht mit Füllung",
                        "target_lang_word": "lasagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                                        "entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                                        "glosses": [
                                            "Plat traditionnel italien qui se prépare avec des couches de pâtes superposées, accompagnées d’une sauce contenant des tomates, du fromage et de la viande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce6bc6d-0b26-4712-bd69-1a1a3349da4f",
                                                "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                                                "text": "Les recettes de lasagnes abondent, à la bolognaise, aux courgettes, aux fruits de mer, aux poireaux et au lard, gratinées à la toscane, aux épinards…"
                                            },
                                            {
                                                "example_id": "dc50dbdc-d0cf-4b43-9982-47d0041786ee",
                                                "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                                                "text": "Il était mort dans un restaurant Viale du Trastevere et sans doute mangeait-il un plat de ces lasagnes vertes qu’il aimait tant."
                                            },
                                            {
                                                "example_id": "acba76de-fbf7-4d76-add1-9c0a6c21664a",
                                                "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                                                "text": "Donner un nom d'empereur à ma lasagne d'aubergines grillées, c'est une façon de la « snobiser » un peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00a2b554-f346-335d-8b66-4dacd395a8a1",
                                        "entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                                        "glosses": [
                                            "Type de pâtes utilisé pour préparer le plat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e2333a7-3f58-3ab8-af08-752088644848",
                                        "entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                                        "glosses": [
                                            "Technique agricole alternant des couches de résidus bruns (secs) et de résidus verts (frais), une bonne couche de terreau termine le tout et permet de semer ou planter directement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c04a36f8-cfca-41d1-b7a9-ca22841b4e09",
                                                "sense_id": "8e2333a7-3f58-3ab8-af08-752088644848",
                                                "text": "Pour un potager luxuriant et sans trop d’efforts, il existe la technique du jardin en lasagnes. Quelques cartons, des couches successives de déchets de tonte, compost et autres disposés en andain suffisent à créer un lit de nutriments ultra concentrés pour des végétaux en pleine santé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
