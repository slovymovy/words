                {
                    "sense_id": "40c6e3f8-c748-3fd9-aee9-7cd81d972a0b",
                    "sense_definition": "Without question or doubt; used to emphasize superlatives.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was <w>easily</w> the best meal I have ever eaten.",
                            "target_lang_translations": {
                                "ru": "Это была <w>безусловно</w> лучшая еда, которую я когда-либо ел.",
                                "zh": "那<w>绝对</w>是我吃过最好的一顿饭。",
                                "nl": "Dat was <w>veruit</w> de beste maaltijd die ik ooit heb gegeten.",
                                "pl": "To był <w>zdecydowanie</w> najlepszy posiłek, jaki kiedykolwiek jadłem.",
                                "de": "Das war <w>zweifellos</w> das beste Essen, das ich je gegessen habe.",
                                "fr": "C'était <w>sans conteste</w> le meilleur repas que j'aie jamais mangé.",
                                "it": "È stato <w>senza dubbio</w> il miglior pasto che abbia mai mangiato.",
                                "cs": "To bylo <w>jednoznačně</w> nejlepší jídlo, jaké jsem kdy jedl.",
                                "tr": "Bu <w>kesinlikle</w> yediğim en iyi yemekti.",
                                "es": "Esa fue <w>sin duda</w> la mejor comida que he probado."
                            }
                        },
                        {
                            "text": "She is <w>easily</w> the smartest student in the class.",
                            "target_lang_translations": {
                                "ru": "Она <w>бесспорно</w> самая умная ученица в классе.",
                                "zh": "她<w>无疑</w>是班里最聪明的学生。",
                                "nl": "Zij is <w>veruit</w> de slimste leerling van de klas.",
                                "pl": "Ona jest <w>bez wątpienia</w> najmądrzejszą uczennicą w klasie.",
                                "de": "Sie ist <w>definitiv</w> die klügste Schülerin in der Klasse.",
                                "fr": "Elle est <w>de loin</w> l'élève la plus intelligente de la classe.",
                                "it": "È <w>nettamente</w> la studentessa più intelligente della classe.",
                                "cs": "Je <w>bezpochyby</w> nejchytřejší studentkou ve třídě.",
                                "tr": "O, <w>şüphesiz</w> sınıftaki en zeki öğrenci.",
                                "es": "Ella es <w>claramente</w> la estudiante más inteligente de la clase."
                            }
                        }
