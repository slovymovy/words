                "senses": [
                    {
                        "sense_id": "7e7ac1c2-35ba-332e-9eb3-f95f3d91d721",
                        "entry_id": "5d12e4a6-8b2c-3a73-93fc-3a2cd12defbc",
                        "glosses": [
                            "свойство по прилагательному экстравагантный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e89579-9453-433a-be60-c74b98fd1b46",
                                "sense_id": "7e7ac1c2-35ba-332e-9eb3-f95f3d91d721",
                                "text": "Я ненавижу экстравагантность, но никак нельзя сегодня поступать иначе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4418eea-16c9-4b87-bea6-dde7c98d271c",
                        "source_entry_id": "5d12e4a6-8b2c-3a73-93fc-3a2cd12defbc",
                        "source_sense_id": "7e7ac1c2-35ba-332e-9eb3-f95f3d91d721",
                        "target_lang_word": "eccentricity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eccentricity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5034fbb-7c64-3163-b356-c893a02b93e8",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The quality of being eccentric or odd; any eccentric behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "339b790b-90c8-4746-bba0-63d487be8686",
                                                "sense_id": "a5034fbb-7c64-3163-b356-c893a02b93e8",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727e160a-eec2-3b86-91c5-aa65573f1403",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The ratio, constant for any particular conic section, of the distance of a point from the focus to its distance from the directrix."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3129855c-1edf-4f53-a657-04d4ede9f78b",
                                                "sense_id": "727e160a-eec2-3b86-91c5-aa65573f1403",
                                                "text": "For an ellipse, the eccentricity is the ratio of the distance from the center to a focus divided by the length of the semi-major axis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ec51835-1b39-3aa8-adfd-98d6a9cbe05c",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The eccentricity of the conic section (usually an ellipse) defined by the orbit of a given object around a reference object (such as that of a planet around the sun)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14b85c92-d9dc-38b6-b484-3423297e826b",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The farthest distance from a vertex to any other vertex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5fd615b-2024-4aad-a852-a397a2b4c84a",
                        "source_entry_id": "5d12e4a6-8b2c-3a73-93fc-3a2cd12defbc",
                        "source_sense_id": "7e7ac1c2-35ba-332e-9eb3-f95f3d91d721",
                        "target_lang_word": "extravagance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravagance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66b6180c-7438-357d-8ef0-e14b003c1c4b",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Excessive or superfluous expenditure of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Prodigality, as of anger, love, expression, imagination, or demands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5056dfc9-91b6-4998-83e7-6592ac44d674",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "The visions of romance were over. Catherine was completely awakened. Henry’s address, short as it had been, had more thoroughly opened her eyes to the extravagance of her late fancies than all their several disappointments had done."
                                            },
                                            {
                                                "example_id": "e099f61e-fcbd-453c-b3ef-d95820a56bba",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire. In fact, that arm-chair had been an extravagance of Mrs. Bunting. She had wanted her husband to be comfortable after the day's work was done, and she had paid thirty-seven shillings for the chair."
                                            },
                                            {
                                                "example_id": "afbb4dbe-44e0-425b-b091-8194940c17ac",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "At the same time he will need most carefully to avoid anything resembling extravagance or overstatement. While no socialist heorist has ever been known to discredit himself with his fellows even by the silliest of proposals, the old-fashioned liberal will damn himself by an impracticable suggestion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Something extravagant; something done out of extravagance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b272a4-3b47-4e9d-bed5-09ba69eb0765",
                                                "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                                "text": "That luxury car is an extravagance you can't afford."
                                            },
                                            {
                                                "example_id": "24120f39-2eab-4e66-8d1b-38a6bc366309",
                                                "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                                "text": "There were no limos or extravagances at this point, because we all wanted to make as much money as possible. We played it cheap. No huge catering bills, no wild parties, not even upgraded hotel rooms. Whenever we arrived at an airport Robin would be there to meet us in a rented SUV or big sedan, and we'd head to the gig on our own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cfa376b-60e4-4f40-83c8-b2467fc5d572",
                        "source_entry_id": "5d12e4a6-8b2c-3a73-93fc-3a2cd12defbc",
                        "source_sense_id": "7e7ac1c2-35ba-332e-9eb3-f95f3d91d721",
