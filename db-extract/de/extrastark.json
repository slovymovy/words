                ],
                "senses": [
                    {
                        "sense_id": "e875608a-c923-3592-94eb-8d434115751e",
                        "entry_id": "e838e082-8d2f-3706-95f5-4efbc45fdae7",
                        "glosses": [
                            "besonders stark, stärker als üblich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289b5cfe-43cb-41b2-9135-c2a2675214ee",
                                "sense_id": "e875608a-c923-3592-94eb-8d434115751e",
                                "text": "„Er packte die lose Ecke der Plane und zog sie wieder über die auf der Ladefläche liegenden Leichen, die einzeln in extrastarke blaue Folie gehüllt und mit Klebeband umwickelt waren.“"
                            },
                            {
                                "example_id": "7299f51e-e6bf-453e-863b-7d55b96fa6e3",
                                "sense_id": "e875608a-c923-3592-94eb-8d434115751e",
                                "text": "„Die Entzündung kam daher, dass ich die Gebrauchsanleitung auf einer Tube Magic-Enthaarungscreme für Männer nicht gelesen hatte. Das Zeug war extrastark und eigentlich für Schwarze gedacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
