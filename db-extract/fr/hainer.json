                ],
                "senses": [
                    {
                        "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                        "entry_id": "52747b71-fe00-36f8-bc7c-ea1c7a1f43a2",
                        "glosses": [
                            "Haïr."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a0a7f006-1485-49f4-a090-46a615c4b80c",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Nous tous hainons les intimidateurs, mais en désaccord sur qui ils sont."
                            },
                            {
                                "example_id": "5bc6bbe7-afdd-4ae1-b900-e6a93e597025",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Je te haine, tu me haines, nous nous hainons ..... l’amour malade !"
                            },
                            {
                                "example_id": "45a9e764-8e88-4048-8e16-55bac3b3dd90",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Allez, bonne soirée et n'oubliez pas : hainez-vous les uns les autres !"
                            },
                            {
                                "example_id": "9a2025da-cd07-42c2-a43e-84f4ab6372e7",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Montpellier : Saurel - Delafosse, pourquoi ils \"s’hainent\"."
                            },
                            {
                                "example_id": "2c048d77-18c9-4958-a8c5-2332f2421a2e",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Hainons-nous les uns les autres."
                            },
                            {
                                "example_id": "b7815c6a-cd7e-41b4-a478-e3c590eff316",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Alors, pour ne pas se faire sucer le sang, ils devaient pouvoir se défendre et se retrouvaient à appuyer financièrement tout ce qu'ils hainaient viscéralement."
                            },
                            {
                                "example_id": "79255f08-6a5c-4f15-afab-07ed9d3ca281",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Les haineux hainent sur ce topic"
                            },
                            {
                                "example_id": "672c1d83-565a-48df-9353-87dbe5743abb",
                                "sense_id": "fd32b0ca-d3f4-3e08-9a85-b0c968c4be34",
                                "text": "Allemagne: ceux qui hainent ne prendront plus le train"
                            }
                        ]
                    }
                ],
