                        "examples": [
                            {
                                "example_id": "31ba3c02-c1d2-4591-b25b-8badecc5a7c4",
                                "sense_id": "d5032ea4-22f2-367d-accc-cde6a6d735c2",
                                "text": "\"Wij hebben al in de jaren negentig gezegd dat CO2 wel degelijk een probleem kon zijn en dat het een impact op het klimaat had. Daar heeft Shell nooit kiekeboe over gespeeld\", zei Van der Veer dinsdag op NPO Radio 1."
                            },
                            {
                                "example_id": "633775fd-cb6a-4ff9-b056-4e1f632588c0",
                                "sense_id": "d5032ea4-22f2-367d-accc-cde6a6d735c2",
                                "text": "In zijn programma ging hij bij mensen thuis koken en nam daarbij geen blad voor de mond. Een fragment waarin hij een ’gehaktbal Kiekeboe’ (een gehaktbal met een ei erin) maakte werd in DWDD genomineerd voor tv-moment van het jaar, mede vanwege zijn legendarische woorden „Die nagels worden vanzelf wel schoon in het gehakt.”"
                            }
                        ]
                    }
