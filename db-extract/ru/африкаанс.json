                    {
                        "translation_id": "493b12fd-cd33-4875-b7b3-b06906ae23fc",
                        "source_entry_id": "ad1f1e70-20dd-3e7e-b2d9-80a76e2b9d25",
                        "source_sense_id": "5fb6013d-67fa-3695-a023-c01ec8da45ab",
                        "target_lang_word": "afrikaans",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afrikaans",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3e388fbe-2651-3036-a735-bd09fe9f2b3a",
                                        "entry_id": "c29b4c89-4f44-3335-a75b-d76f5c8bc5da",
                                        "glosses": [
                                            "Idioma germánico derivado del neerlandés, hablado principalmente en Sudáfrica y Namibia, que evolucionó de la que hablaban los colonos holandeses (afrikáners) que habitaban la Colonia del Cabo. Actualmente es una de las lenguas oficiales de la República Sudafricana."
                                        ],
                                        "tags": [
                                            "Glotónimos",
                                            "grafía menos común en español"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6d84f0b-fd14-4aaf-aa71-f01a94644bcd",
                                                "sense_id": "3e388fbe-2651-3036-a735-bd09fe9f2b3a",
                                                "text": "Así pues, el movimiento encaminado a crear un afrikaans normativo escrito acompañó el crecimiento del nacionalismo afrikaner. El afrikaans era un símbolo colectivo de la identidad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea4dca13-0327-4af7-be22-e7efcef2c495",
                        "source_entry_id": "ad1f1e70-20dd-3e7e-b2d9-80a76e2b9d25",
                        "source_sense_id": "5fb6013d-67fa-3695-a023-c01ec8da45ab",
