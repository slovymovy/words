                        "cross_references": [
                            {
                                "target_word": "contrainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f1d617-f70e-3c6d-bb34-5cd7d69cc58f",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Violence qu’on exerce contre quelqu’un, pour l’obliger à faire quelque chose malgré lui ou pour l’empêcher de faire ce qu’il voudrait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857291cf-2807-44e4-bba5-aa714ddb7619",
                                                "sense_id": "d6f1d617-f70e-3c6d-bb34-5cd7d69cc58f",
                                                "text": "Tant que l’homme est comprimé, tant que la contrainte des iniquités sociales le maintient prostré, l’on est en droit d’espérer beaucoup de l’inéclos qu’il porte en lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e10d7e9-ff73-3624-8460-c7d202a3d486",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "État de celui à qui on fait cette violence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bae28de1-3e07-41c1-b4d1-f9eecbcdbbc2",
                                                "sense_id": "1e10d7e9-ff73-3624-8460-c7d202a3d486",
                                                "text": "La pénible contrainte où il est. Vivre dans la contrainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4648d45-9647-3669-97df-f7443f33097a",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Retenue que le respect, la considération, ou quelque autre cause, obligent d’avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f92f8bf6-14ea-46c4-bb15-c2a4093ee4e5",
                                                "sense_id": "e4648d45-9647-3669-97df-f7443f33097a",
                                                "text": "La contrainte qu’imposent les bienséances. C’est une grande contrainte que d’être obligé de se taire en de certaines occasions."
                                            },
                                            {
                                                "example_id": "7d8a0f77-c9cb-4b67-ab61-bf3ef305b22e",
                                                "sense_id": "e4648d45-9647-3669-97df-f7443f33097a",
                                                "text": "La contrainte de la mesure, de la rime, La gêne, la discipline qu’imposent quelquefois aux poètes les règles de la mesure et les difficultés de la rime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9758a18e-06f7-3b87-9ae4-083df0f51373",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Tout acte par lequel on force quelqu’un à faire ou à donner une chose."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e2e9239-044f-3b2e-9dde-3dfbd4008762",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Mandement, exécutoire décerné par l’administration du fisc contre son débiteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2797f336-7d45-4e68-b10a-39c894e281ae",
                                                "sense_id": "5e2e9239-044f-3b2e-9dde-3dfbd4008762",
                                                "text": "Porteur de contraintes. Décerner une contrainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08627d2a-35fc-3859-ba98-886898b074de",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Condition à satisfaire."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "176cc161-0b7d-49eb-9897-8ee2c71baaf7",
                                                "sense_id": "08627d2a-35fc-3859-ba98-886898b074de",
                                                "text": "Pourtant, se lancer dans le halal ressemble à un chemin de croix… Les contraintes de production ne sont pas insurmontables, mais l’industriel doit se plonger dans le maquis d’un système de certification bien éloigné de celui des labels classiques […]."
                                            },
                                            {
                                                "example_id": "21e5947f-1876-48d8-a628-8198961b567f",
                                                "sense_id": "08627d2a-35fc-3859-ba98-886898b074de",
                                                "text": "Avec la vogue du récréotourisme, la population locale prend conscience des autres potentialités du lac et des contraintes imposées par le mode d'exploitation industrielle de cette ressource naturelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c352d26-1834-3ac5-bb11-8ba54b97bfb9",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Résultat des efforts internes qui naissent dans un objet lorsqu’on le déforme : contrainte mécanique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "796c966a-a719-4fe8-afe5-9f42788cb1c6",
                                                "sense_id": "7c352d26-1834-3ac5-bb11-8ba54b97bfb9",
                                                "text": "L'étude des contraintes appliquées aux matériaux est aussi très utile dans le domaine des infrastructures, pour étudier la résistance d’un pont ou mettre au point des bâtiments antisismiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f4adcf4-5942-3baa-9e03-37278fcdf019",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Règle de gestion qui réduit la liberté d'action sur une table ou un champ de la base de donnée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "950f769a-2d94-35cd-8971-2f332d663436",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Équation ou inéquation qui restreint le domaine où on cherche à optimiser la fonction objectif."
                                        ],
                                        "tags": [
                                            "Optimisation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b06fd22e-60d0-3c4a-8a72-0195594c28d2",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Contrainte volontaire pour la créativité. À relever tel un défi ou pour lutter contre la page blanche. l'OuLiPo parle de contrainte libératoire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "contrainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d4d4e9-8c48-32a5-b82e-6ba676d659f1",
                                        "entry_id": "36fdc906-e06b-3405-96e8-a2b31548d758",
                                        "glosses": [
                                            "Féminin singulier de contraint."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "371c747c-e000-46bd-b7aa-d83e5dc04144",
                                                "sense_id": "d2d4d4e9-8c48-32a5-b82e-6ba676d659f1",
                                                "text": "Une seule usine, employant une vingtaine d’ouvriers, existe à Vatan et la main-d’œuvre masculine, hormis celle du bâtiment, se voit contrainte d’aller travailler dans les villes voisines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contrainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d80ba97d-9585-31c7-b3d3-07a77c498af9",
                                        "entry_id": "311d4d22-8f41-3d73-9ba0-3c31d1244de6",
                                        "glosses": [
                                            "Participe passé féminin singulier de contraindre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2f19aa-7d03-4aed-af91-84664f03ca41",
                                                "sense_id": "d80ba97d-9585-31c7-b3d3-07a77c498af9",
                                                "text": "Si on mélange tous les produits, on crée un liquide marabouté qui va permettre de débouffoniser cet objet, que je serai malheureusement ensuite contrainte de jeter dans le Lez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b35023a-3b1a-4774-bf86-51a0de14b40f",
                        "source_entry_id": "38d962d4-9ff7-3e8f-bc36-ca51e3601214",
                        "source_sense_id": "5227e1c7-d4c4-358a-a69a-1e9aa9fab012",
                        "target_lang_word": "prix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b22c2c8e-ce8c-332f-a43f-68054af0b21a",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Estimation d’une chose, ce qu’elle se vend, ce qu’on l’achète, ce qu’on la paie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ab092a-ad22-4700-a958-a7aa024b7f28",
                                                "sense_id": "b22c2c8e-ce8c-332f-a43f-68054af0b21a",
                                                "text": "Le sucre était connu des anciens qui ne l’employaient qu’en très-petite quantité et comme médicament ; il y a 200 ans à peine, il se vendait seulement chez les pharmaciens, à un prix très-élevé."
                                            },
                                            {
                                                "example_id": "09d1fe09-abb3-441a-9ce3-46767ca9b8ea",
                                                "sense_id": "b22c2c8e-ce8c-332f-a43f-68054af0b21a",
                                                "text": "Nul n’oserait contester que, depuis 1918, les spéculations sur les denrées alimentaires ont été générales et sans frein. Le public se doute bien un peu qu’on l’affame et que les hauts prix maintenus malgré toutes les tentatives sont factices. Mais qui accuser ?"
                                            },
                                            {
                                                "example_id": "696248f8-a66a-4a3c-9826-6502418acc17",
                                                "sense_id": "b22c2c8e-ce8c-332f-a43f-68054af0b21a",
                                                "text": "[…], depuis la Seconde Guerre mondiale, les nations d’Europe occidentale ont laissé dépérir leur industrie charbonnière, tant il était facile de se procurer, en abondance et à bas prix, le pétrole du Proche et du Moyen-Orient."
                                            },
                                            {
                                                "example_id": "f77e6649-4ee3-4357-9268-59835e81e18e",
                                                "sense_id": "b22c2c8e-ce8c-332f-a43f-68054af0b21a",
                                                "text": "Il existe aujourd’hui des masques de soudeur automatiques pour un prix d’environ 100 € qui s’opacifient instantanément lorsque l’arc électrique se produit ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc836bc9-b26f-36e9-aa96-8e8dca03fd4b",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Valeur financière donnée à un objet exprimée en unité monétaire d’un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f714c0-1ad3-4259-a3b2-f019b0b66cc0",
                                                "sense_id": "cc836bc9-b26f-36e9-aa96-8e8dca03fd4b",
                                                "text": "[…], des marchands d’un champagne dont la médiocrité n’était dépassée que par son prix qui ne cessait de monter, ne se préoccupaient plus, à Montmartre comme à Montparnasse, que d’adapter les soi-disants plaisirs de Paris à des images étrangères et le plus souvent chromolithographiques."
                                            },
                                            {
                                                "example_id": "1429072f-2cd3-4548-8a06-667d498b16b8",
                                                "sense_id": "cc836bc9-b26f-36e9-aa96-8e8dca03fd4b",
                                                "text": "Pour tous les ouvriers et toutes les ouvrières du textile la condition empirait avec la hausse des prix, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7671bedb-03ba-3b52-8c46-faaba24b7f98",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Ce qu’il faut payer en contrepartie d’un bien ou d’un service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2183525c-02e0-48f8-bd5e-456f7777b31d",
                                                "sense_id": "7671bedb-03ba-3b52-8c46-faaba24b7f98",
                                                "text": "On vient en foule me réclamer le prix du louage, mais je n’ai un peu d’argent qu’à Nouakchott. Les propriétaires devront donc attendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed96a29c-abb8-3cd9-8ebe-bb229c73a4df",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Coût, dépense, pour obtenir quelque avantage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e52f149-50fb-4f5e-98c5-ad54d5840d31",
                                                "sense_id": "ed96a29c-abb8-3cd9-8ebe-bb229c73a4df",
                                                "text": "Les Américains s’étaient rendu compte du prix que leur coûteraient leurs tergiversations,et ils voulurent frapper un grand coup, de toutes leurs forces, […]."
                                            },
                                            {
                                                "example_id": "47435b13-d9c4-44be-99d5-81fe0e1cbd4c",
                                                "sense_id": "ed96a29c-abb8-3cd9-8ebe-bb229c73a4df",
                                                "text": "Il a acheté la victoire au prix de son sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8494282-af2d-30fa-8e72-53074fcfe989",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Mérite d’une personne, excellence d’une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e557b8b-446d-4ebf-bbc7-7380911f9284",
                                                "sense_id": "c8494282-af2d-30fa-8e72-53074fcfe989",
                                                "text": "Je connais tout le prix de votre affection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9806357f-4359-37e3-8df9-e1a54e42e4ab",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Récompense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "019ac1c9-bbdf-404a-b47d-1e3c2f015c52",
                                                "sense_id": "9806357f-4359-37e3-8df9-e1a54e42e4ab",
                                                "text": "On doit faire de bonnes actions sans en attendre aucun prix."
                                            },
                                            {
                                                "example_id": "f5d69721-b023-460a-ab71-e5c1dbb4e508",
                                                "sense_id": "9806357f-4359-37e3-8df9-e1a54e42e4ab",
                                                "text": "Ce retour épuisant sur soi-même était peut-être au moment d’obtenir son prix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "791caabd-7eed-35d1-a42b-3d549d4414c0",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Récompense.",
                                            "Récompense accordée au vainqueur d’une compétition ou d’un concours."
                                        ],
                                        "tags": [
                                            "especially",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "753b8cd0-2c73-4af5-b60d-d58cf159b9a6",
                                                "sense_id": "791caabd-7eed-35d1-a42b-3d549d4414c0",
                                                "text": "Les compliments de ce maire quand Pasteur obtint, à la fin de la rhétorique, plus de prix qu’il ne pouvait en porter; les nouveaux conseils de Romanet réveillèrent l’ambition normalienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc18d12e-9505-3ba9-b0aa-4812052a9dc3",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Récompense.",
                                            "Joint à la désignation de la récompense, se dit aussi du gagnant ou de l’ouvrage qui a remporté cette récompense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aec5903-a0d8-496c-86eb-a64b5c785b79",
                                                "sense_id": "bc18d12e-9505-3ba9-b0aa-4812052a9dc3",
                                                "text": "Ce peintre est un prix de Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91475f7e-b49d-3e77-a587-d2a9ac6d811c",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Récompense.",
                                            "Compétition ou concours où est offerte cette récompense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03586c7-6e66-46f6-b775-7a65a6a65a80",
                                                "sense_id": "91475f7e-b49d-3e77-a587-d2a9ac6d811c",
                                                "text": "Nos pères étaient donc plus sages que nous lorsqu’ils repoussaient l’idée des courses. En 1820 il se présentait seulement sur nos hippodromes 120 concurrents se disputant 60 prix."
                                            },
                                            {
                                                "example_id": "a3b847e7-10f3-4509-9f42-c8bdcca444d6",
                                                "sense_id": "91475f7e-b49d-3e77-a587-d2a9ac6d811c",
                                                "text": "Chaque dernier jeudi d'octobre, l’Académie française ouvre le bal des prix littéraires d'automne en décernant son Grand Prix du roman. Une semaine après, viennent le Goncourt et le Renaudot. Puis le Fémina et l’Interallié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b529b11f-8149-344d-bf82-7bbb5c85eacb",
                                        "entry_id": "32d8c936-1edd-3fff-89ef-ff6d621d3954",
                                        "glosses": [
                                            "Châtiment, expiation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4680210-e188-4394-b5e3-185f71d8b4eb",
                                                "sense_id": "b529b11f-8149-344d-bf82-7bbb5c85eacb",
                                                "text": "Il a reçu le prix de ses forfaits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
