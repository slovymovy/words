                    {
                        "form_id": "51bb3d22-a7ab-4153-80fa-33d9d69e8a53",
                        "entry_id": "df27ce0a-777f-3c04-9bbb-9808fc00b61a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Reichspogromnacht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26f0136b-919e-3cd6-b9f1-1143df3cc928",
                        "entry_id": "df27ce0a-777f-3c04-9bbb-9808fc00b61a",
                        "glosses": [
                            "die Nacht vom 9. auf den 10. November 1938, in der viele Deutsche unter Anleitung der SA jüdische Synagogen in Brand steckten, jüdische Geschäfte plünderten und zerstörten und ca. 400 deutsche Juden töteten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fd9606-0931-4385-92e6-9bad449ceade",
                                "sense_id": "26f0136b-919e-3cd6-b9f1-1143df3cc928",
                                "text": "„In Deutschland wird heute [am 9. November] an den Mauerfall vor 22 Jahren und die Reichspogromnacht 1938 erinnert.“"
                            },
                            {
                                "example_id": "08737db3-8205-4a0c-b220-96fee03eea34",
                                "sense_id": "26f0136b-919e-3cd6-b9f1-1143df3cc928",
                                "text": "„Von Jüngeren wird man beim Stichwort „Reichspogromnacht“ erst einmal blöd angeguckt. Pogromnacht - was ist das? Auch der Begriff „Reichskristallnacht“ sagt oft nichts. Bei meiner Generation ist dann glaube ich schon Ebbe angesagt, da ist nicht viel Wissen vorhanden. Und das ist sehr schade.“"
                            },
                            {
                                "example_id": "9e382f44-70fd-4129-8edf-51c395317509",
                                "sense_id": "26f0136b-919e-3cd6-b9f1-1143df3cc928",
                                "text": "„Die Reichspogromnacht vom 9. auf den 10. November betraf auch Danzig.“"
                            },
                            {
                                "example_id": "f0ebaf8b-db83-4e1f-9a8e-ae7f49f6a776",
                                "sense_id": "26f0136b-919e-3cd6-b9f1-1143df3cc928",
                                "text": "„Das erste Mal, dass Roth etwas von der unbarmherzigen Vefolgung von Juden durch die Nazis erfuhr, war wahrscheinlich nach der Reichspogromnacht am 9. November 1938, als in Deutschland einundneunzig Juden getötet, dreißigtausend verhaftet und Tausende Synagogen und jüdische Geschäfte zerstört wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
