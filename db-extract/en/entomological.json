                                    {
                                        "sense_id": "45f6c634-72b5-37cb-b6db-9673582746dd",
                                        "entry_id": "ec097d22-e3be-383a-844a-7f230bd3bdb0",
                                        "glosses": [
                                            "Relatif à l’entomologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be7b6e23-98b6-4697-be01-c8ee8b2a4b4d",
                                                "sense_id": "45f6c634-72b5-37cb-b6db-9673582746dd",
                                                "text": "L'illustration entomologique demeure bien présente cependant, ainsi qu'en témoigne les nombreux ouvrages de vulgarisation et guides pratiques que nous offre l'édition de masse, mais elle met en œuvre d'autres techniques, au premier rang desquelles se situe, la macrophotographie."
                                            },
                                            {
                                                "example_id": "49b067ea-e9db-45d4-acf1-7cdba340474a",
                                                "sense_id": "45f6c634-72b5-37cb-b6db-9673582746dd",
                                                "text": "\"L'art de Kafka consiste à accumuler d'un côté les caractéristiques entomologiques de Gregor, tout le triste détail de son accoutrement d'insecte, et de l'autre à conserver vivante et limpide sa fine et douce lecture humaine aux yeux du lecteur.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b98bd95b-5c51-4cae-b2bf-bc548cf44cd5",
                        "source_entry_id": "e18017e8-670d-31a5-8bac-bcc7dcee5375",
                        "source_sense_id": "6d71d6d2-c74f-3dc5-b315-83195b88b805",
                        "source_sense_description": "of or pertaining to entomology",
                        "target_lang_word": "entomologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entomologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6606a5ff-6f7b-336a-ac83-78e61145b4f7",
                                        "entry_id": "f76e4d9a-9806-3e39-b8a4-e582386f6a96",
                                        "glosses": [
                                            "die Entomologie betreffend; auf der Entomologie beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa562c1-0e03-4efd-b181-2e219e29cb6e",
                                                "sense_id": "6606a5ff-6f7b-336a-ac83-78e61145b4f7",
                                                "text": "Benannt wurde die Medaille nach dem Österreicher Friedrich Moritz Brauer (1832–1904), der ab 1876 als Kustos für Diptera und Neuroptera an der entomologischen Sammlung im Naturhistorischen Museum Wien tätig war."
                                            },
                                            {
                                                "example_id": "163b0aa7-818e-4c65-8970-ea4772be262a",
                                                "sense_id": "6606a5ff-6f7b-336a-ac83-78e61145b4f7",
                                                "text": "In der Zwischenzeit hatte sich durch berufliche und private Veränderungen die Möglichkeit ergeben, mehrere Jahre hintereinander in entomologisch wenig erforschten Ländern und Gebieten zu leben und dort auch systematisch zu sammeln, zuerst vier Jahre in Sibirien, dann vier Jahre in Armenien und im restlichen Südkaukasus, schließlich sechs Jahre in ganz China."
                                            },
                                            {
                                                "example_id": "64504b34-0e01-443a-80cb-933750492977",
                                                "sense_id": "6606a5ff-6f7b-336a-ac83-78e61145b4f7",
                                                "text": "Entomologisch betrachtet ist ein geschlossener Buchen-Hallenwald oder schlimmer noch ein Fichtenforst eine ziemlich langweilige Angelegenheit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
