                        "entry_id": "5a0b6a7c-4b4d-37a1-b7e3-d2c2c5d584f6",
                        "glosses": [
                            "A ticket book, a collection of tickets in the form of a booklet often sold at a discount to single tickets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d6b39d-b4fb-45a3-b3ee-54da8f14794b",
                                "sense_id": "3527c45d-a355-3094-9f4a-50112d64fb4f",
                                "text": "Rather than buy each ticket individually, you can buy a carnet of ten tickets for a lower price."
                            }
                        ]
                    },
                    {
                        "sense_id": "13181643-e909-3c81-901e-7a77a670bfc0",
                        "entry_id": "5a0b6a7c-4b4d-37a1-b7e3-d2c2c5d584f6",
                        "glosses": [
                            "A customs document that allows the temporary duty-free importation of a particular article"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f33e3ad-3a27-406d-a1a9-98718f7ae988",
                                "sense_id": "13181643-e909-3c81-901e-7a77a670bfc0",
                                "text": "If you plan to sell your car, of course, a carnet is the last thing you need: if the vehicle isn't correctly stamped in and out of each country you'll lose your deposit."
                            }
                        ]
                    },
                    {
                        "sense_id": "35f28e89-0bd3-39ee-9e88-40f14360d27b",
