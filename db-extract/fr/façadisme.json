                    },
                    {
                        "translation_id": "fbc1f667-6708-4981-9c1f-f2f6e4ae06dd",
                        "source_entry_id": "f9991248-b673-3e8b-a480-8229d4de26df",
                        "source_sense_id": "da2a761a-1309-334a-a315-f64ea0a575cf",
                        "target_lang_word": "facadism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facadism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecf85adb-559e-30d2-9a32-ce775d6e0755",
                                        "entry_id": "7a83cdc4-93b3-33e1-9e6f-df03ab0dfd9f",
                                        "glosses": [
                                            "the practice of retaining only the facade of an old building when redeveloping a site."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4887321-10f1-4876-a6d0-4c2e1cbc4416",
                                                "sense_id": "ecf85adb-559e-30d2-9a32-ce775d6e0755",
                                                "text": "The Construction of new buildings behind historic facades, better know as facade retention or ‘facadism’, is a unique phase in the history of architecture."
                                            },
                                            {
                                                "example_id": "893cfdbc-13a9-4a99-a686-87e0e3d590e0",
                                                "sense_id": "ecf85adb-559e-30d2-9a32-ce775d6e0755",
                                                "text": "In Chapter 10 the author goes on to explore the ways in which new development can be inserted in cityscapes through various means. In particular he examines the increased use of facadism..."
                                            },
                                            {
                                                "example_id": "df3ef93b-46ad-49d9-9b18-2e96e3189b38",
                                                "sense_id": "ecf85adb-559e-30d2-9a32-ce775d6e0755",
                                                "text": "Local officers are happy with façadism because it means the townscape stays intact — and nobody should ask what happens behind the facing walls"
                                            },
                                            {
                                                "example_id": "44e40c20-f115-4d89-b6e5-144b1ef38e8a",
                                                "sense_id": "ecf85adb-559e-30d2-9a32-ce775d6e0755",
                                                "text": "Façadism, with its emphasis on show and its disregard for authenticity, is very much a postmodern approach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fbc67e9-1126-33fb-aeb6-f1892488e933",
                                        "entry_id": "7a83cdc4-93b3-33e1-9e6f-df03ab0dfd9f",
                                        "glosses": [
                                            "a method where the facade is designed and/or constructed independently of the remainder of the rest of the building."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
