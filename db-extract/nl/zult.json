                        ],
                        "examples": [
                            {
                                "example_id": "a9b7e5fd-8365-4700-b188-114412ee5104",
                                "sense_id": "21162449-b899-3bfb-a2cb-13025f1b8ed1",
                                "text": "\"Je zult\", \"ge zult\" en \"u zult\" zijn alledrie goed Nederlands."
                            },
                            {
                                "example_id": "11f16379-dad0-42ac-a4dd-21e42209efe9",
                                "sense_id": "21162449-b899-3bfb-a2cb-13025f1b8ed1",
                                "text": "'Denk eens aan alles wat je te eten zult krijgen, Nella,' had haar broer Carel gezegd."
                            },
                            {
                                "example_id": "d7d815ab-ab01-42a9-ae08-a1d00fd27d53",
                                "sense_id": "21162449-b899-3bfb-a2cb-13025f1b8ed1",
                                "text": "Wee u, die nu overvloed hebt, want gij zult hongeren."
                            },
                            {
                                "example_id": "643f5dc8-1542-4ad6-865a-2dd53139036f",
                                "sense_id": "21162449-b899-3bfb-a2cb-13025f1b8ed1",
                                "text": "Wee u, die nu lacht, want gij zult smart hebben en wenen."
                            }
                        ]
                    },
