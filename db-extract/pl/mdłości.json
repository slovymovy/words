                    },
                    {
                        "translation_id": "503dca01-dfb7-4e6b-9387-237af3b3f57d",
                        "source_entry_id": "ff1fd5de-fdba-384f-be38-d565549814e6",
                        "source_sense_id": "e07c26c6-acc2-3c73-bf41-0dfb18f507ec",
                        "target_lang_word": "Übelkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übelkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4c1ff36-1af5-3aa5-ad2c-428505faed26",
                                        "entry_id": "f6c1a048-ae4b-3304-8d51-6ca6a57f45ea",
                                        "glosses": [
                                            "eine Befindlichkeitsstörung, die auch als „flaues“ Gefühl in der Magengegend und Brechreiz bezeichnet wird. Sie kann physiologisch als Schutzfunktion nach Aufnahme von Schadstoffen oder als Symptom einer Krankheit auftreten. Manchmal verschwindet die Übelkeit nach Erbrechen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae8127e1-cc12-4dd1-8919-b5bd541dd854",
                                                "sense_id": "a4c1ff36-1af5-3aa5-ad2c-428505faed26",
                                                "text": "Er litt oft an Übelkeit."
                                            },
                                            {
                                                "example_id": "052614d2-54ea-4b0f-9bfb-c01fde0933be",
                                                "sense_id": "a4c1ff36-1af5-3aa5-ad2c-428505faed26",
                                                "text": "„Vielleicht war es das, was mir solch eine niederdrückende Übelkeit bereitete.“"
                                            },
                                            {
                                                "example_id": "c1ba2970-0b8f-4416-9f5e-81093b9c0cbc",
                                                "sense_id": "a4c1ff36-1af5-3aa5-ad2c-428505faed26",
                                                "text": "„Er gehörte ihr, und als er dann aufs College ging, war ich nicht mehr bereit, mich um jemanden zu bemühen, dem ich nur Übelkeit verursachte.“"
                                            },
                                            {
                                                "example_id": "2b5e5bc9-822e-4f11-b0d1-98ad4ba5e71f",
                                                "sense_id": "a4c1ff36-1af5-3aa5-ad2c-428505faed26",
                                                "text": "„Übelkeit stieg in ihm auf, und er kämpfte dagegen an.“"
                                            },
                                            {
                                                "example_id": "4d40dd87-c028-48ec-a45f-d1e119bc3462",
                                                "sense_id": "a4c1ff36-1af5-3aa5-ad2c-428505faed26",
                                                "text": "„Auch daß ich Hunger hatte, daß eine leichte Übelkeit in mir kreiste wie Flüssigkeit in einem Destillierkolben – das alles geschah neben mir.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9d6afa3-bd55-40c9-8dfb-30e50c994a44",
                        "source_entry_id": "ff1fd5de-fdba-384f-be38-d565549814e6",
                        "source_sense_id": "e07c26c6-acc2-3c73-bf41-0dfb18f507ec",
                        "target_lang_word": "тошнота",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тошнота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b6911eba-97c6-3fc1-810b-76eb2c069943",
                                        "entry_id": "89dc49be-f18b-3b54-8f16-aa296cfb2749",
                                        "glosses": [
                                            "своеобразное состояние, тягостное ощущение в подложечной области и глотке, обычно предшествующее рвоте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3644b00-24a9-4290-89ea-0cc5ffff367c",
                                                "sense_id": "b6911eba-97c6-3fc1-810b-76eb2c069943",
                                                "text": "От пива его мучила тошнота, и когда он лег, лепной потолок, скудно озаренный свечой, заколыхался, завертелся и поплыл."
                                            },
                                            {
                                                "example_id": "f7f930df-56df-41d2-8587-fb0f044c8b3a",
                                                "sense_id": "b6911eba-97c6-3fc1-810b-76eb2c069943",
                                                "text": "Меня растрясло и накалило солнцем, дома я пообедал не очень осторожно, лег спать, не заснул и к вечеру встал с головной болью и тошнотой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a67a0640-be27-3f23-9f07-b8a4c0cac9fd",
                                        "entry_id": "89dc49be-f18b-3b54-8f16-aa296cfb2749",
                                        "glosses": [
                                            "перен. отвращение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d651fd25-53a8-4c6d-b135-ecb37b181e17",
                                                "sense_id": "a67a0640-be27-3f23-9f07-b8a4c0cac9fd",
                                                "text": "А местным жителям, аборигенам, так сказать, моя личность до тошноты примелькалась."
                                            },
                                            {
                                                "example_id": "b94a4511-d437-49d1-9a40-925fd8b90f5d",
                                                "sense_id": "a67a0640-be27-3f23-9f07-b8a4c0cac9fd",
                                                "text": "Переживания родственников оперируемых больных ему до тошноты надоели."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
