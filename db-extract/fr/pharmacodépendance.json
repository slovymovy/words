                        "entry_id": "e9255352-9a76-30da-be0b-2454a245c108",
                        "glosses": [
                            "État de dépendance psychique ou physique, résultant de la prise périodique ou continue d’un médicament ou de tout autre produit psychoactif."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4114b30e-85bd-4efd-a46b-2e915ecb0725",
                                "sense_id": "3225f74b-81da-35a7-95e6-f058a20b6d93",
                                "text": "En prolongeant l’usage de ces médicaments, le médecin fait lentement entrer son malade en pharmacodépendance."
                            },
                            {
                                "example_id": "d02484b2-254c-4d84-8408-c610ad46ae71",
                                "sense_id": "3225f74b-81da-35a7-95e6-f058a20b6d93",
                                "text": "L’usage prolongé de nombreux produits peut entrainer une pharmacodépendance ou dépendance physique, celle-ci n’allant pas forcément de pair avec un potentiel toxicomanogène de ceux-ci …"
                            }
                        ]
                    }
