                    {
                        "translation_id": "6c8cc25b-5bd8-4fb7-9608-55effb1ea807",
                        "source_entry_id": "1b025930-1107-37f6-ad5a-458d21ab9c41",
                        "source_sense_id": "e04726a6-2cc1-3e83-8634-1c28320ef816",
                        "source_sense_description": "hangend sierraad",
                        "target_lang_word": "Anhänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anhänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ddd8067-c7d4-3c10-820c-bb9714ba2df7",
                                        "entry_id": "b194256a-2501-34ca-a15c-db20bdcd8562",
                                        "glosses": [
                                            "Fahrzeug, das über keinen eigenen Antrieb verfügt und hinter Kraftfahrzeugen mitgeführt wird"
                                        ],
                                        "tags": [
                                            "Verkehrswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b20f99-3e69-4659-ab0f-d4ca88d646ac",
                                                "sense_id": "0ddd8067-c7d4-3c10-820c-bb9714ba2df7",
                                                "text": "Die Möbel werden auf den Anhänger geladen."
                                            },
                                            {
                                                "example_id": "7ae74025-ab56-434d-898a-076089b22ebd",
                                                "sense_id": "0ddd8067-c7d4-3c10-820c-bb9714ba2df7",
                                                "text": "„Val schaute im Anhänger nach.“"
                                            },
                                            {
                                                "example_id": "1bf81e1d-9298-4ef2-8bc5-d6fc65b7d944",
                                                "sense_id": "0ddd8067-c7d4-3c10-820c-bb9714ba2df7",
                                                "text": "„Gunther saß im Anhänger hinter dem Lastwagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75f788e6-15e6-30da-9f5c-9bb0785c4547",
                                        "entry_id": "b194256a-2501-34ca-a15c-db20bdcd8562",
                                        "glosses": [
                                            "Schmuckstück, das an einem Band oder an einer Kette befestigt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48962301-e8ad-4d00-b390-7264861a1f3e",
                                                "sense_id": "75f788e6-15e6-30da-9f5c-9bb0785c4547",
                                                "text": "Der Anhänger in Herzform hängt an Lisas Halskette."
                                            },
                                            {
                                                "example_id": "8f3aaac6-bf16-46ed-bcf5-8b92d83a594b",
                                                "sense_id": "75f788e6-15e6-30da-9f5c-9bb0785c4547",
                                                "text": "„Sie entfernte einen Anhänger von seinem Hals, und ich nahm ihm seine Börse und Uhr ab und gab sie ihr.“"
                                            },
                                            {
                                                "example_id": "edccbb48-7a49-4e46-a860-2e7c69ba843b",
                                                "sense_id": "75f788e6-15e6-30da-9f5c-9bb0785c4547",
                                                "text": "„Am Rückspiegel baumelt ein Anhänger von Real Madrid.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a0318caa-99ab-36b8-8e51-ab74f08df25f",
                                        "entry_id": "b194256a-2501-34ca-a15c-db20bdcd8562",
                                        "glosses": [
                                            "Namensschild für Gepäckstücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be173deb-73cc-4a60-b5aa-7930be14a3e7",
                                                "sense_id": "a0318caa-99ab-36b8-8e51-ab74f08df25f",
                                                "text": "Beschrifte doch bitte noch die Anhänger, bevor wir zum Flughafen fahren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1b1e5075-7762-341e-9eeb-c223c550b23c",
                                        "entry_id": "b194256a-2501-34ca-a15c-db20bdcd8562",
                                        "glosses": [
                                            "Band zum Anhängen eines Kleidungsstückes oder Ähnliches"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecf32312-450b-49df-8669-5bbfe77737ae",
                                                "sense_id": "1b1e5075-7762-341e-9eeb-c223c550b23c",
                                                "text": "Weil du immer so an deinem Handtuch zerrst, ist der Anhänger schon wieder abgerissen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0fd13cc8-2d0b-37e1-8aa6-d2e1a763fb75",
                                        "entry_id": "b194256a-2501-34ca-a15c-db20bdcd8562",
                                        "glosses": [
                                            "Person, die einer Gruppe oder einer Partei angehört beziehungsweise diese unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad32da2-27c4-445b-a16b-142c6d8d3104",
                                                "sense_id": "0fd13cc8-2d0b-37e1-8aa6-d2e1a763fb75",
                                                "text": "Neonazis sind Anhänger nationalsozialistischen Gedankenguts."
                                            },
                                            {
                                                "example_id": "0b5b3f85-3373-4da1-8529-e76cd77f1d88",
                                                "sense_id": "0fd13cc8-2d0b-37e1-8aa6-d2e1a763fb75",
                                                "text": "„Die ganze Band stellt sich geschlossen hinter Billie, damit sie nicht unter Diskriminierungen zu leiden hat, und Artie Shaw wird des Öfteren deutlich, wenn er auf hartnäckige Anhänger der Rassentrennung trifft.“"
                                            },
                                            {
                                                "example_id": "fd8dd216-de46-48f0-bce0-4fe1213aaad9",
                                                "sense_id": "0fd13cc8-2d0b-37e1-8aa6-d2e1a763fb75",
                                                "text": "„Doch den ultrakonservativen Anhängern einer wortgetreuen Auslegung gilt jede Veränderung als Hochverrat.“"
                                            },
                                            {
                                                "example_id": "7eab4d99-0166-44e3-9ca5-0b9f62845287",
                                                "sense_id": "0fd13cc8-2d0b-37e1-8aa6-d2e1a763fb75",
                                                "text": "„Zum Jahreswechsel werden 50 Regierungssoldaten verhaftet unter dem Vorwurf, heimliche Anhänger des abgesetzten Premiers zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
