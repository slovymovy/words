    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "a0395919-75b0-3a55-bc95-b7a17d12f32b",
                    "sense_definition": "The speaker or writer, referred to as the grammatical subject, of a sentence.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronoun_subject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>I</w> am very happy to see you here today.",
                            "target_lang_translations": {
                                "ru": "<w>Я</w> очень рад видеть вас здесь сегодня.",
                                "de": "<w>Ich</w> freue mich sehr, dich heute hier zu sehen."
                            }
                        },
                        {
                            "text": "<w>I</w> think we should go to the park.",
                            "target_lang_translations": {
                                "ru": "<w>Я</w> думаю, нам стоит пойти в парк.",
                                "de": "<w>Ich</w> denke, wir sollten in den Park gehen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "I am",
                        "I think",
                        "I know",
                        "I would like",
                        "I have"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорящий или пишущий, выступающий в роли грамматического подлежащего в предложении.",
                        "de": "Die sprechende oder schreibende Person, die als grammatikalisches Subjekt in einem Satz fungiert."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я",
                                "target_lang_sense_clarification": "личное местоимение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ich",
                                "target_lang_sense_clarification": "Personalpronomen, 1. Person Singular"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12986075-cffc-3a99-9556-0d945133a034",
                    "sense_definition": "Alternative letter-case form of I.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pronoun_subject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "sorry <w>i</w> can't come to the party tonight.",
                            "target_lang_translations": {
                                "ru": "извини, <w>я</w> не смогу прийти на вечеринку сегодня вечером.",
                                "de": "Entschuldigung, <w>ich</w> kann heute Abend nicht zur Party kommen."
                            }
                        },
                        {
                            "text": "when <w>i</w> fix my computer, I will email you.",
                            "target_lang_translations": {
                                "ru": "когда <w>я</w> починю свой компьютер, я напишу тебе.",
                                "de": "Wenn <w>ich</w> meinen Computer repariert habe, schreibe <w>ich</w> dir eine E-Mail."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "internet slang or text messaging"
                        },
                        {
                            "trait_type": "form",
                            "comment": "lowercase"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания местоимения \"I\" строчной буквой (обычно в неформальной переписке).",
                        "de": "Kleingeschriebene Variante des Pronomens „ich“ (häufig in informeller Kommunikation)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я",
                                "target_lang_sense_clarification": "неформальное написание"
