                    {
                        "sense_id": "574fbdce-a541-32c9-a138-a4fc683ebb2a",
                        "entry_id": "5d17762e-665a-3aed-9b5c-1afe8cd3f21e",
                        "glosses": [
                            "Möbel für den Gärten, die im Garten aufgestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd246086-285d-4ef6-8cd1-883048073c26",
                                "sense_id": "574fbdce-a541-32c9-a138-a4fc683ebb2a",
                                "text": "„Elegante Gartenmöbel standen unter großen Sonnenschirmen auf der langgestreckten Veranda, die Eingangstür war breit und kunstvoll verziert.“"
                            },
                            {
                                "example_id": "df95214c-4254-4b92-bff8-206f9fec03eb",
                                "sense_id": "574fbdce-a541-32c9-a138-a4fc683ebb2a",
                                "text": "„Obi breitete gerade eine Plane über den Gartenmöbeln aus, um sie vor dem angekündigten Regen zu schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
