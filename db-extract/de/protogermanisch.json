                "senses": [
                    {
                        "sense_id": "ceec8bb6-b339-3c63-8e75-141037528569",
                        "entry_id": "d0e01d79-9947-3e40-b3bc-cf5699a1ac76",
                        "glosses": [
                            "hypothetische Vorläufersprache aller germanischen Sprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44568979-abfb-4488-b9f6-d438fe3898dc",
                                "sense_id": "ceec8bb6-b339-3c63-8e75-141037528569",
                                "text": "„Dies alles bedeutet mE, daß nach der Akzentfixierung die Aufhebung der Autonomie der Silbe folgt, aber auch dies noch im Protogermanischen.“"
                            },
                            {
                                "example_id": "78a137bf-97dd-4431-b3dd-fc1657bad5a8",
                                "sense_id": "ceec8bb6-b339-3c63-8e75-141037528569",
                                "text": "„Es gibt jedoch einen anderen geo- grafischen Terminus, der aus dem Protogermanischen übernommen wurde und von der Errichtung von Altären zeugt.“"
                            },
                            {
                                "example_id": "4580f754-c1b7-43b7-926d-459b271cd9e1",
                                "sense_id": "ceec8bb6-b339-3c63-8e75-141037528569",
                                "text": "„Das Faszinierende an Trollen ist: Es gibt sie in ganz Nordeuropa, die Wortbedeutung stammt sogar aus dem Protogermanischen, also der Sprache der allerersten Germanen, die im Lederschlüpfer durch den Schwarzwald schepperten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
