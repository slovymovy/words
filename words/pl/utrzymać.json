{
    "word_family": [
        "utrzymywać",
        "utrzymanie",
        "utrzymanek",
        "utrzymanka",
        "trzymać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b502507e-b13d-3d5b-8043-dcb6e83df6b2",
                    "sense_definition": "sprawić, że ktoś lub coś pozostaje w określonym stanie, położeniu lub porządku",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zachowanie_stanu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <w>utrzymać</w> czystość w całym pokoju przed przyjazdem gości.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>поддержать</w> чистоту во всей комнате перед приездом гостей."
                            }
                        },
                        {
                            "text": "Trudno było <w>utrzymać</w> spokój podczas tak gorącej dyskusji.",
                            "target_lang_translations": {
                                "ru": "Трудно было <w>сохранить</w> спокойствие во время столь горячей дискуссии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać porządek",
                        "utrzymać spokój"
                    ],
                    "target_lang_definitions": {
                        "ru": "сохранить что-либо или кого-либо в определённом состоянии, положении или порядке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранить",
                                "target_lang_sense_clarification": "порядок, спокойствие"
                            },
                            {
                                "target_lang_word": "поддержать",
                                "target_lang_sense_clarification": "чистоту, порядок"
                            },
                            {
                                "target_lang_word": "удержать",
                                "target_lang_sense_clarification": "спокойствие, состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c5615f5-f480-3ee8-8035-d0d515a1e2b0",
                    "sense_definition": "nie stracić kontroli nad czymś, zachować pozycję lub stabilność",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kontrola_stabilnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na śliskim chodniku z trudem <w>utrzymał</w> równowagę i o mało nie upadł.",
                            "target_lang_translations": {
                                "ru": "На скользком тротуаре он с трудом <w>удержал</w> равновесие и чуть не упал."
                            }
                        },
                        {
                            "text": "Kierowca zdołał <w>utrzymać</w> kontrolę nad pojazdem na ostrym zakręcie.",
                            "target_lang_translations": {
                                "ru": "Водитель сумел <w>сохранить</w> контроль над машиной на крутом повороте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać równowagę",
                        "utrzymać kontrolę"
                    ],
                    "target_lang_definitions": {
                        "ru": "не потерять контроль над чем-либо, сохранить положение или устойчивость"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удержать",
                                "target_lang_sense_clarification": "равновесие, контроль"
                            },
                            {
                                "target_lang_word": "сохранить",
                                "target_lang_sense_clarification": "устойчивость, контроль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27136c6a-0bff-3366-b539-20aa73ac63b6",
                    "sense_definition": "zapewnić komuś lub sobie środki do życia, pokrywając koszty utrzymania",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finanse_byt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pracował na dwa etaty, aby samodzielnie <w>utrzymać</w> całą rodzinę.",
                            "target_lang_translations": {
                                "ru": "Он работал на две ставки, чтобы в одиночку <w>содержать</w> всю семью."
                            }
                        },
                        {
                            "text": "Z tej małej pensji trudno będzie <w>utrzymać</w> duże mieszkanie w centrum.",
                            "target_lang_translations": {
                                "ru": "На эту маленькую зарплату трудно будет <w>содержать</w> большую квартиру в центре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać rodzinę",
                        "utrzymać dom"
                    ],
                    "target_lang_definitions": {
                        "ru": "обеспечить средствами к существованию, покрывая расходы на проживание"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "семью, дом"
                            },
                            {
                                "target_lang_word": "прокормить",
                                "target_lang_sense_clarification": "семью"
                            },
                            {
                                "target_lang_word": "обеспечить",
                                "target_lang_sense_clarification": "материально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "343a46c0-1aea-33dc-9dfe-ccefb0af9e7c",
                    "sense_definition": "dźwignąć i nie pozwolić czemuś upaść lub zmienić położenia; podeprzeć",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne_trzymanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Te stare półki nie zdołają <w>utrzymać</w> tak wielu ciężkich książek.",
                            "target_lang_translations": {
                                "ru": "Эти старые полки не смогут <w>выдержать</w> столько тяжёлых книг."
                            }
                        },
                        {
                            "text": "Złapał spadającą drabinę i z wysiłkiem <w>utrzymał</w> ją w pionie.",
                            "target_lang_translations": {
                                "ru": "Он перехватил падающую лестницу и с усилием <w>удержал</w> её вертикально."
                            }
                        }
                    ],
                    "synonyms": [
                        "podtrzymać"
                    ],
                    "common_phrases": [
                        "utrzymać ciężar"
                    ],
                    "target_lang_definitions": {
                        "ru": "поднять и не дать упасть или сдвинуться; выдержать физически"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удержать",
                                "target_lang_sense_clarification": "тяжесть, падающий предмет"
                            },
                            {
                                "target_lang_word": "поддержать",
                                "target_lang_sense_clarification": "не дать упасть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca43558a-b956-3011-a469-7a3cbf1c9bc5",
                    "sense_definition": "nie załamać się pod ciężarem czegoś, znieść obciążenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne_trzymanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Konstrukcja mostu z łatwością <w>utrzyma</w> przejazd ciężkich samochodów.",
                            "target_lang_translations": {
                                "ru": "Конструкция моста с лёгкостью <w>выдержит</w> проезд тяжёлых грузовиков."
                            }
                        },
                        {
                            "text": "Cienki lód na stawie na pewno nie <w>utrzyma</w> dorosłego człowieka.",
                            "target_lang_translations": {
                                "ru": "Тонкий лёд на пруду точно не <w>выдержит</w> взрослого человека."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "не сломаться и не провалиться под тяжестью, выдержать нагрузку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдержать",
                                "target_lang_sense_clarification": "вес, нагрузку"
                            },
                            {
                                "target_lang_word": "вынести",
                                "target_lang_sense_clarification": "тяжесть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97ef190a-871f-3d0d-944d-13b1ee747605",
                    "sense_definition": "sprawić, że ktoś nie odejdzie lub nie opuści jakiegoś miejsca albo relacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szef zaoferował mu podwyżkę, by <w>utrzymać</w> cennego pracownika w firmie.",
                            "target_lang_translations": {
                                "ru": "Начальник предложил ему прибавку к зарплате, чтобы <w>удержать</w> ценного сотрудника в компании."
                            }
                        },
                        {
                            "text": "Nawet obietnice nie pomogły i nie <w>utrzymały</w> go w tej drużynie.",
                            "target_lang_translations": {
                                "ru": "Даже обещания не помогли и не <w>удержали</w> его в этой команде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać pracownika"
                    ],
                    "target_lang_definitions": {
                        "ru": "не дать кому-либо уйти, уволиться или разорвать отношения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удержать",
                                "target_lang_sense_clarification": "работника, человека от ухода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32efba15-7a28-35ec-a0fd-3aa5d2206afe",
                    "sense_definition": "dbać o coś tak, aby nie niszczało i zachowało odpowiednią sprawność lub wygląd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zachowanie_stanu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Właściciel dokładał starań, aby <w>utrzymać</w> zabytek w dobrym stanie technicznym.",
                            "target_lang_translations": {
                                "ru": "Владелец прилагал усилия, чтобы <w>поддерживать</w> памятник старины в хорошем техническом состоянии."
                            }
                        },
                        {
                            "text": "Wymaga to wiele pracy, by <w>utrzymać</w> ogród w należytym porządku.",
                            "target_lang_translations": {
                                "ru": "Требуется много труда, чтобы <w>содержать</w> сад в должном порядке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać w dobrym stanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "поддерживать в надлежащем состоянии, порядке и исправности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "в порядке, в чистоте"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "в хорошем состоянии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "728d2519-63d7-30a4-b99e-99d50a05f184",
                    "sense_definition": "zachować z kimś kontakt, więź lub dobre relacje",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo upływu wielu lat zdołali <w>utrzymać</w> kontakt z dawnymi przyjaciółmi.",
                            "target_lang_translations": {
                                "ru": "Несмотря на прошедшие годы, они сумели <w>сохранить</w> связь со старыми друзьями."
                            }
                        },
                        {
                            "text": "Firma stara się za wszelką cenę <w>utrzymać</w> dobre relacje z klientami.",
                            "target_lang_translations": {
                                "ru": "Компания всеми силами старается <w>поддерживать</w> хорошие отношения с клиентами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać kontakt",
                        "utrzymać relacje"
                    ],
                    "target_lang_definitions": {
                        "ru": "сохранить связь, контакты или хорошие отношения с кем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранить",
                                "target_lang_sense_clarification": "связь, контакт"
                            },
                            {
                                "target_lang_word": "поддержать",
                                "target_lang_sense_clarification": "отношения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce4465ed-f091-331d-9297-c0a89b284f85",
                    "sense_definition": "nie dać się wyprzeć lub usunąć; zachować zajmowane miejsce mimo trudności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obrona_pozycja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz zespół zdołał <w>utrzymać</w> prowadzenie do samego końca meczu.",
                            "target_lang_translations": {
                                "ru": "Наша команда сумела <w>удержать</w> лидерство до самого конца матча."
                            }
                        },
                        {
                            "text": "W obliczu silnej konkurencji spółka <w>utrzymała</w> pozycję lidera na rynku.",
                            "target_lang_translations": {
                                "ru": "В условиях сильной конкуренции компания <w>сохранила</w> позицию лидера на рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstać"
                    ],
                    "common_phrases": [
                        "utrzymać pozycję",
                        "utrzymać prowadzenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "не уступить своего положения или места вопреки трудностям или конкуренции"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удержать",
                                "target_lang_sense_clarification": "лидерство, позиции"
                            },
                            {
                                "target_lang_word": "сохранить",
                                "target_lang_sense_clarification": "преимущество, позицию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cc0d180-d914-3782-a097-761a47fb32eb",
                    "sense_definition": "pozostać niezmiennym lub trwać przez dłuższy czas w tym samym stanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Synoptycy przewidują, że słoneczna pogoda <w>utrzyma</w> się jeszcze przez kilka dni.",
                            "target_lang_translations": {
                                "ru": "Синоптики прогнозируют, что солнечная погода <w>продержится</w> ещё несколько дней."
                            }
                        },
                        {
                            "text": "Ta wysoka cena nie <w>utrzyma</w> się długo na wolnym rynku.",
                            "target_lang_translations": {
                                "ru": "Такая высокая цена долго не <w>продержится</w> на свободном рынке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać się przez kilka dni"
                    ],
                    "target_lang_definitions": {
                        "ru": "продержаться, остаться без изменений на протяжении какого-то времени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продержаться",
                                "target_lang_sense_clarification": "о погоде, ценах"
                            },
                            {
                                "target_lang_word": "сохраниться",
                                "target_lang_sense_clarification": "о состоянии"
                            },
                            {
                                "target_lang_word": "удержаться",
                                "target_lang_sense_clarification": "на прежнем уровне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd285914-a0f1-312a-a3b8-c457ca620add",
                    "sense_definition": "zapewnić sobie środki na własne mieszkanie, wyżywienie i codzienne wydatki",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finanse_byt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po ukończeniu studiów musi sam się <w>utrzymać</w> w dużym mieście.",
                            "target_lang_translations": {
                                "ru": "После окончания учёбы ему приходится самому <w>обеспечивать себя</w> в большом городе."
                            }
                        },
                        {
                            "text": "Trudno było <w>utrzymać</w> się z dorywczych zleceń podczas kryzysu.",
                            "target_lang_translations": {
                                "ru": "Трудно было <w>прожить</w> на случайные подработки во время кризиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać się samodzielnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "обеспечить самого себя необходимыми средствами для жизни"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокормить себя",
                                "target_lang_sense_clarification": "самостоятельно"
                            },
                            {
                                "target_lang_word": "обеспечить себя",
                                "target_lang_sense_clarification": "материально"
                            },
                            {
                                "target_lang_word": "прожить",
                                "target_lang_sense_clarification": "на какие-либо средства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edfd53bc-198b-3780-b258-fa57ef04a4d9",
                    "sense_definition": "opanować swoje emocje, reakcje lub impulsy; powstrzymać się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kontrola_stabilnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Był tak wściekły, że z trudem <w>utrzymał</w> się na wodzy i nie krzyknął.",
                            "target_lang_translations": {
                                "ru": "Он был так взбешён, что с трудом <w>сдержался</w> и не закричал."
                            }
                        },
                        {
                            "text": "Zobaczywszy zabawną scenę, nikt nie zdołał <w>utrzymać</w> powagi na sali.",
                            "target_lang_translations": {
                                "ru": "Увидев забавную сцену, никто в зале не смог <w>сохранить</w> невозмутимость."
                            }
                        }
                    ],
                    "synonyms": [
                        "powstrzymać się",
                        "powściągnąć się"
                    ],
                    "common_phrases": [
                        "utrzymać nerwy na wodzy",
                        "utrzymać powagę"
                    ],
                    "target_lang_definitions": {
                        "ru": "совладать со своими эмоциями, порывами; сдержаться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержать",
                                "target_lang_sense_clarification": "себя, эмоции"
                            },
                            {
                                "target_lang_word": "удержать",
                                "target_lang_sense_clarification": "серьёзность, смех"
                            },
                            {
                                "target_lang_word": "сдержаться",
                                "target_lang_sense_clarification": "не поддаться порыву"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22cfc31e-30c2-3bd0-886d-d652c691b7f6",
                    "sense_definition": "nadać czemuś jednolity ton, formę lub konwencję stylistyczną",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stylistyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cały artykuł prasowy został <w>utrzymany</w> w ironicznym i krytycznym tonie.",
                            "target_lang_translations": {
                                "ru": "Вся газетная статья была <w>выдержана</w> в ироничном и критическом тоне."
                            }
                        },
                        {
                            "text": "Wnętrze zabytkowej kamienicy architekt <w>utrzymał</w> w stylu modernistycznym.",
                            "target_lang_translations": {
                                "ru": "Интерьер старинного доходного дома архитектор <w>выдержал</w> в модернистском стиле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utrzymać w tonie",
                        "utrzymać w stylu"
                    ],
                    "target_lang_definitions": {
                        "ru": "выдержать что-либо в едином тоне, стиле или манере"
                    },
                    "translations": {
                        "ru": [
