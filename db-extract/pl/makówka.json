                                        "entry_id": "28f2f008-0e03-32a3-89b3-1369b2a17e35",
                                        "glosses": [
                                            "верхняя оконечность, вершина чего-либо; макушка (дерева, дома, горы и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "637ef57a-b47a-4296-b044-570ea6364026",
                                                "sense_id": "caa1e020-fbe8-38a0-9374-b0a8ce409ef5",
                                                "text": "Ветер и вправду с утра шумел, серебря маковки тополей, легко пригибая их."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "500675c4-f8e0-3ef3-8343-b807c576d9ee",
                                        "entry_id": "28f2f008-0e03-32a3-89b3-1369b2a17e35",
                                        "glosses": [
                                            "верхняя часть головы; макушка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f0a7d0-98bb-4f2e-9897-a0b8ba1ef3b9",
                                                "sense_id": "500675c4-f8e0-3ef3-8343-b807c576d9ee",
                                                "text": "Данилов встал, обнял сына и поцеловал его в стриженую маковку."
                                            }
                                        ]
