                "senses": [
                    {
                        "sense_id": "a3b57155-6106-3aa0-a5c9-0a9f2c98bb94",
                        "entry_id": "ca4bfa38-c5bb-3054-a20b-9144d568b9ea",
                        "glosses": [
                            "Arbeitsgerät, das zur Verteilung und zum Wenden von Mähgut dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6baeb995-8d22-4252-80bf-dc8b64e73377",
                                "sense_id": "a3b57155-6106-3aa0-a5c9-0a9f2c98bb94",
                                "text": "Der maschinelle Heuwender kam Anfang der 60er Jahre mit der Mechanisierung der Landwirtschaft auf."
                            },
                            {
                                "example_id": "5ab2d3fb-c662-44f6-8699-86511a18dd01",
                                "sense_id": "a3b57155-6106-3aa0-a5c9-0a9f2c98bb94",
                                "text": "„Guter Song, rief Jóhannes, nachdem Haraldur den Heuwender und den Motor abgestellt hatte und aus dem Fahrerhaus ins Gras gesprungen war, schlank, braun gebrannt, in Bluejeans und einem karierten Arbeitshemd, das zuzuknöpfen er offenbar nicht für nötig hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
