                    ],
                    "target_lang_definitions": {
                        "ru": "характерный протяжный, меняющийся по высоте звук сирены спецтранспорта",
                        "cs": "charakteristický táhlý, kolísavý tón sirény záchranných složek"
                    },
                    "translations": {
