                                    {
                                        "sense_id": "d20be75c-8471-3a18-bc0f-a4b00f4cb3e5",
                                        "entry_id": "555a635a-5817-30d4-b483-35d3e6fc7c6e",
                                        "glosses": [
                                            "A brown pigment made from soot, especially from beech wood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e018af0-a3b7-3b98-99b8-20ba75c53724",
                                        "entry_id": "555a635a-5817-30d4-b483-35d3e6fc7c6e",
                                        "glosses": [
                                            "A mid-to-dark brown color resembling the pigment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f1e02a-1aff-4a17-a198-d7c791dd49f9",
                                                "sense_id": "0e018af0-a3b7-3b98-99b8-20ba75c53724",
                                                "text": "[O]h! what an object he was! The rings round his eyes were of the colour of bistre […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdaf52e0-d187-4484-b975-941317f6a614",
