                {
                    "sense_id": "c8fc3dd6-c812-315b-9fff-01bf10621fc6",
                    "sense_definition": "Een stuk grond, een kavel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer kocht een extra <w>perceel</w> om zijn maïsveld uit te breiden.",
                            "target_lang_translations": {
                                "en": "The farmer bought an extra <w>plot</w> to expand his cornfield."
                            }
                        },
                        {
                            "text": "Dit <w>perceel</w> grond is uitermate geschikt voor woningbouw.",
                            "target_lang_translations": {
                                "en": "This <w>parcel</w> of land is extremely suitable for residential construction."
                            }
                        }
                    ],
                    "synonyms": [
                        "kavel",
                        "kaveling"
                    ],
                    "common_phrases": [
                        "een perceel grond"
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of land, a plot"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plot",
                                "target_lang_sense_clarification": "of land"
                            },
                            {
                                "target_lang_word": "parcel",
                                "target_lang_sense_clarification": "of land"
                            },
                            {
                                "target_lang_word": "lot",
                                "target_lang_sense_clarification": "of land"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f3d1e6-8cd7-3122-9522-45b366b7cd1d",
                    "sense_definition": "Een stuk grond waarvoor één rechtsorde geldt, dat wil zeggen dezelfde eigenaar en hetzelfde eigendomsrecht",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "grond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>percelen</w> worden geregistreerd bij het Kadaster.",
                            "target_lang_translations": {
                                "en": "The <w>parcels</w> are registered with the Land Registry."
                            }
                        },
                        {
                            "text": "Elk kadastraal <w>perceel</w> heeft een uniek nummer gekregen.",
                            "target_lang_translations": {
                                "en": "Each cadastral <w>plot</w> has been given a unique number."
                            }
                        }
                    ],
                    "synonyms": [
                        "kavel"
                    ],
                    "common_phrases": [
                        "kadastraal perceel"
                    ],
                    "target_lang_definitions": {
                        "en": "A registered piece of land under a single ownership and legal status"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parcel",
                                "target_lang_sense_clarification": "cadastral or registered plot of land"
                            },
                            {
                                "target_lang_word": "plot",
                                "target_lang_sense_clarification": "registered land unit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12f4a19e-efa8-3414-bf42-6bc7bb157f5c",
                    "sense_definition": "Een gebouw of pand, vaak met de bijbehorende grond",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gebouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweer moest uitrukken omdat er brand was uitgebroken in het naastgelegen <w>perceel</w>.",
                            "target_lang_translations": {
                                "en": "The fire department had to turn out because a fire had broken out in the adjacent <w>premises</w>."
                            }
                        },
                        {
                            "text": "Dit historische <w>perceel</w> in de binnenstad staat al jaren te koop.",
                            "target_lang_translations": {
                                "en": "This historic <w>property</w> in the city center has been for sale for years."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A building or premises, often including the associated land"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "premises",
                                "target_lang_sense_clarification": "building and land"
                            },
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "building or real estate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89f91f3d-e162-32c1-be2b-8679afe4ec14",
                    "sense_definition": "Een onroerend goed bestaande uit een gebouw en het bijbehorende erf",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gebouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eigenaar is verantwoordelijk voor het onderhoud van het gehele <w>perceel</w>.",
                            "target_lang_translations": {
                                "en": "The owner is responsible for the maintenance of the entire <w>property</w>."
                            }
                        },
                        {
                            "text": "Het betreden van dit <w>perceel</w> zonder toestemming is streng verboden.",
                            "target_lang_translations": {
                                "en": "Entering these <w>premises</w> without permission is strictly prohibited."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A real estate property consisting of a building and its surrounding yard or grounds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "real estate including building and yard"
                            },
                            {
                                "target_lang_word": "premises",
                                "target_lang_sense_clarification": "building and surrounding grounds"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "841e142f-860b-3490-979b-1d1df7777d4a",
                    "sense_definition": "Een partij of kavel goederen die op een veiling wordt aangeboden",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "veiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het laatste <w>perceel</w> van de veiling bracht onverwacht veel geld op.",
                            "target_lang_translations": {
                                "en": "The last <w>lot</w> of the auction fetched an unexpectedly large amount of money."
                            }
                        },
                        {
                            "text": "De opbieder kocht een groot <w>perceel</w> antieke boeken.",
                            "target_lang_translations": {
                                "en": "The bidder bought a large <w>lot</w> of antique books."
                            }
                        }
                    ],
                    "synonyms": [
                        "kavel"
                    ],
                    "target_lang_definitions": {
