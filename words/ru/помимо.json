                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой комнате никого не было <w>помимо</w> нас двоих.",
                            "target_lang_translations": {
                                "en": "There was no one in this room <w>besides</w> the two of us.",
                                "zh": "房间里<w>除了</w>我们俩，没有别人。",
                                "nl": "Er was niemand in deze kamer <w>behalve</w> wij tweeën.",
                                "pl": "W tym pokoju nie było nikogo <w>oprócz</w> nas dwojga.",
                                "de": "In diesem Raum war niemand <w>außer</w> uns beiden.",
                                "fr": "Il n'y avait personne dans cette pièce <w>à part</w> nous deux.",
                                "it": "In questa stanza non c'era nessuno <w>tranne</w> noi due.",
                                "cs": "V té místnosti nebyl nikdo <w>kromě</w> nás dvou.",
                                "tr": "Bu odada ikimizden <w>başka</w> kimse yoktu.",
                                "es": "No había nadie en esta habitación <w>salvo</w> nosotros dos."
                            }
                        },
                        {
                            "text": "Никто, <w>помимо</w> директора, не знал об этом решении.",
                            "target_lang_translations": {
                                "en": "No one <w>other than</w> the director knew about this decision.",
                                "nl": "Niemand <w>behalve</w> de directeur wist van dit besluit.",
                                "pl": "Nikt <w>oprócz</w> dyrektora nie wiedział o tej decyzji.",
                                "de": "Niemand <w>außer</w> dem Direktor wusste von dieser Entscheidung.",
                                "fr": "Personne, <w>à part</w> le directeur, n'était au courant de cette décision.",
                                "it": "Nessuno, <w>tranne</w> il direttore, sapeva di questa decisione.",
                                "cs": "Nikdo <w>kromě</w> ředitele o tom rozhodnutí nevěděl.",
                                "tr": "Müdür <w>dışında</w> kimse bu karardan haberdar değildi.",
                                "es": "Nadie, <w>salvo</w> el director, sabía nada de esa decisión.",
                                "zh": "<w>除了</w>校长，没有人知道这个决定。"
                            }
                        }
