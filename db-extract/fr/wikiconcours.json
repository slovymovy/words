                "entry_id": "74f52e1d-9238-362b-96ac-ab53507406ba",
                "word": "Wikiconcours",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02694ef0-5d02-3533-be00-31f4e7c94843",
                        "entry_id": "74f52e1d-9238-362b-96ac-ab53507406ba",
                        "glosses": [
                            "Concours organisé sur Wikipédia, lors duquel plusieurs équipes de contributeurs participent à l’amélioration des articles, pendant deux mois."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "ab15f0b1-02a9-4af8-8dce-8531d418216b",
                                "sense_id": "02694ef0-5d02-3533-be00-31f4e7c94843",
                                "text": "Le Wikiconcours est l’événement rédactionnel collaboratif par excellence de Wikipédia."
                            },
                            {
                                "example_id": "3b3f43bf-df23-4868-8f92-2fe73b3119bd",
                                "sense_id": "02694ef0-5d02-3533-be00-31f4e7c94843",
                                "text": "Avez-vous déjà entendu parler des Wikiconcours ? Le wikiconcours est un concours de rédaction collaboratif qui existe depuis 2006. L’objectif du concours est d’améliorer la qualité des articles de l’encyclopédie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6bfcab2-d6ff-326a-a621-0182b70e7602",
                        "entry_id": "74f52e1d-9238-362b-96ac-ab53507406ba",
                        "glosses": [
                            "Dans le cadre scolaire, principalement lycéen, au cours duquel les élèves à Wikipédia, en partenariat avec l’encyclopédie en ligne."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "22fbedde-9cf5-483b-abdb-391ef7a25427",
                                "sense_id": "f6bfcab2-d6ff-326a-a621-0182b70e7602",
                                "text": "Des élèves du lycée Renaudeau ont été distingués dans le cadre du Wikiconcours, organisé en lien avec la célèbre encyclopédie universelle contributive, Wikipedia."
                            },
                            {
                                "example_id": "0af9cb9f-19ed-4007-aaa1-aa7448f459eb",
                                "sense_id": "f6bfcab2-d6ff-326a-a621-0182b70e7602",
                                "text": "La classe de 1ʳᵉ S3 (scientifique) de La Pérouse-Kerichen est la lauréate nationale du prix de la contribution au Wikiconcours."
                            }
                        ]
                    }
