                "senses": [
                    {
                        "sense_id": "67b8a3fb-bd82-3fdc-994b-124ea941fbd4",
                        "entry_id": "110eba2b-fd59-3016-9b82-619a6e4a3d59",
                        "glosses": [
                            "Consulter (un médecin, en particulier) à distance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a46e4f-8280-4d1a-b4a3-1cb09a5b3faa",
                                "sense_id": "67b8a3fb-bd82-3fdc-994b-124ea941fbd4",
                                "text": "Un décret publié lundi soir facilitera les consultations en ligne remboursables (l’idéal est de « téléconsulter » son généraliste qui connaît bien le parcours de soins de son patient, mais le décret élargit le recours à un praticien de son territoire)."
                            },
                            {
                                "example_id": "0a789d96-3321-4a6c-80d1-270df5b559fe",
                                "sense_id": "67b8a3fb-bd82-3fdc-994b-124ea941fbd4",
                                "text": "On n’a quasi plus de consultations présentielles, le gouvernement dit qu’il faut téléconsulter."
                            }
                        ]
                    }
