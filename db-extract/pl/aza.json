                            {
                                "example_id": "0e8a4529-b9fc-49b7-9d8b-5a2c83191da7",
                                "sense_id": "8e0e2c89-ae8f-3b88-b74f-43d715208dca",
                                "text": "Według innej legendy Joanna z Azy słynęła z troski o biednych, których hojnie obdarowywała jałmużną"
