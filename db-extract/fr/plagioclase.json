                                        "entry_id": "279cc555-a310-3248-bd34-38a42e3f8fa1",
                                        "glosses": [
                                            "Any of a group of aluminum silicate feldspathic minerals ranging in their ratio of calcium to sodium."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57aefa6d-4b28-408b-b352-b70af7d590c5",
                                                "sense_id": "777fe786-9cba-3528-b3dc-b31d1febe34f",
                                                "text": "These crystals are of one of the most abundant minerals in nature – feldspar; furthermore, they are of a particular kind of feldspar rich in the element calcium, termed plagioclase."
                                            }
                                        ]
                                    }
                                ]
