                "senses": [
                    {
                        "sense_id": "e27beaec-a76a-355f-a345-0527d57abae7",
                        "entry_id": "bda415c9-6c4e-37e7-a2b4-d8fbf2279870",
                        "glosses": [
                            "idealer Mensch, der geistig über gewöhnliche Menschen hinausgewachsen und zum Herrschen bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53789606-efee-4b29-adea-60e7f90d38e3",
                                "sense_id": "e27beaec-a76a-355f-a345-0527d57abae7",
                                "text": "Der Philosoph Friedrich Nietzsche schrieb, dass es noch nie einen Übermenschen gab, Johann Wolfgang von Goethe oder Napoleon Bonaparte kamen ihm allerdings schon nahe an das Bild des Übermenschen heran."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23f392a2-b4e7-4809-8930-98363fd2a97b",
                        "source_entry_id": "bda415c9-6c4e-37e7-a2b4-d8fbf2279870",
                        "source_sense_id": "e27beaec-a76a-355f-a345-0527d57abae7",
                        "target_lang_word": "super-human, super-man",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "796ff01d-2be5-4fb5-b95f-c9b28906251d",
                        "source_entry_id": "bda415c9-6c4e-37e7-a2b4-d8fbf2279870",
                        "source_sense_id": "e27beaec-a76a-355f-a345-0527d57abae7",
                        "target_lang_word": "surhomme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surhomme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a969d9-37ab-363d-bd13-7bcad8ce2b41",
                                        "entry_id": "2832780e-d11e-3c94-964b-37e43c5c9b10",
                                        "glosses": [
                                            "Homme considéré comme dépassant au moral la mesure ordinaire de la nature humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207594b2-8f48-4fc3-b8ca-dffea91dfbbd",
                                                "sense_id": "b9a969d9-37ab-363d-bd13-7bcad8ce2b41",
                                                "text": "En fait, le surhomme apparait comme l’antitype de l’homme démocratique."
                                            },
                                            {
                                                "example_id": "61447d27-4549-43f0-a355-4094c4d3878b",
                                                "sense_id": "b9a969d9-37ab-363d-bd13-7bcad8ce2b41",
                                                "text": "Un et un font un lorsque l’addition porte sur l'homme et sur Dieu et qu’on ne confond ni le premier avec un sous-Dieu, ni le second avec un surhomme."
                                            },
                                            {
                                                "example_id": "981c9059-e159-43c2-934f-8b84ec64e4f5",
                                                "sense_id": "b9a969d9-37ab-363d-bd13-7bcad8ce2b41",
                                                "text": "Le surhomme est seul. Il peut avoir des amis, des complices, mais qui n'arrivent pas à sa cheville. Sherlock Holmes formait un couple avec le Dr. Watson, mais c'est qu'il avait besoin d'un historiographe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f9724c5-e7d6-3f89-89c0-d51035ae5d70",
                                        "entry_id": "2832780e-d11e-3c94-964b-37e43c5c9b10",
                                        "glosses": [
                                            "Personne dépassant la force physique ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf7d86b-b4fe-4c94-a814-047a40cfda6f",
                                                "sense_id": "6f9724c5-e7d6-3f89-89c0-d51035ae5d70",
                                                "text": "À dix sur un, ça se croit surhomme"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55cdd83-3da5-3674-b4ea-cc033b03ee3e",
                                        "entry_id": "2832780e-d11e-3c94-964b-37e43c5c9b10",
                                        "glosses": [
                                            "Dans la pensée de Nietzsche et dans le décadentisme, homme qui accepte la vie terrestre comme unique réalité avec courage, qui redonne du sens à la vie terrestre, ne se faisant pas d’illusion, qui ne fait pas appel à une réflexion rationnelle et qui se dépasse lui-même grâce à la volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e201b6-0b53-445d-a327-89112fa733e9",
                                                "sense_id": "e55cdd83-3da5-3674-b4ea-cc033b03ee3e",
                                                "text": "« Voici, je vous enseigne le Surhomme. Le Surhomme est le sens de la terre. Que votre volonté dise : Que le Surhomme soit le sens de la terre. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79198714-98a9-4d0c-8316-2435e5c8e7f6",
                        "source_entry_id": "bda415c9-6c4e-37e7-a2b4-d8fbf2279870",
