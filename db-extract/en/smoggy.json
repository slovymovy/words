                        "examples": [
                            {
                                "example_id": "241bd5d4-47ee-4727-b3ce-e455614ddef4",
                                "sense_id": "aa4d8d01-73f9-359f-8cf4-424686300754",
                                "text": "It was another smoggy day in Los Angeles."
                            },
                            {
                                "example_id": "e7dc41f2-1faf-419a-9d33-a43ec4155591",
                                "sense_id": "aa4d8d01-73f9-359f-8cf4-424686300754",
                                "text": "In Los Angeles, that means relatively cool with few temperature inversions that trap the gases that help make the region the smoggiest in the country."
                            },
                            {
                                "example_id": "0bae47b0-964e-4266-8763-7b9cf5dace45",
                                "sense_id": "aa4d8d01-73f9-359f-8cf4-424686300754",
                                "text": "She was all right. The abuse she was suffering wouldn't hurt her. The bright sun would forget all about it. The smoggy sky would turn brown studies to gold. (What crap.)"
                            },
                            {
                                "example_id": "92a61698-cee8-443d-ae74-b3999fa28b76",
                                "sense_id": "aa4d8d01-73f9-359f-8cf4-424686300754",
                                "text": "Even the clearest distinction between the two cities — climate — has been smoggier of late."
                            }
                        ]
                    }
