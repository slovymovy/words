                "senses": [
                    {
                        "sense_id": "3075a693-61df-33dc-8862-e83664021e14",
                        "entry_id": "bc5b566a-d876-3945-9e38-65158330dbce",
                        "glosses": [
                            "męska odmiana anoreksji; zaburzenie polegające na obsesyjnej dbałości o masę mięśniową bazujące na przekonaniu, że nie jest się wystarczająco muskularnym/że nie ma się wystarczająco dużych mięśni; obsesja na punkcie umięśnionego ciała"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "65b35839-05af-4038-8d16-a0077198026c",
                                "sense_id": "3075a693-61df-33dc-8862-e83664021e14",
                                "text": "Ćwiczenia fizyczne są w ich wykonaniu zachowaniami kompulsywnymi, kompensującymi wyobrażeniowe niedostatki dotyczące fizycznego wyglądu (np. bigoreksja w przypadku kulturystów permanentnie niezadowolonych ze swojego wyglądu)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba53de28-1c0e-4eb9-8d25-0de1dd7d0f84",
                        "source_entry_id": "bc5b566a-d876-3945-9e38-65158330dbce",
                        "source_sense_id": "3075a693-61df-33dc-8862-e83664021e14",
                        "target_lang_word": "bigorexia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigorexia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4f9a0e7-c5af-36da-b052-0dc7148f17eb",
                                        "entry_id": "e4733f54-daf8-3d46-9dda-986fdaac63c4",
                                        "glosses": [
                                            "A mental disorder in which the sufferer perceives himself to have inadequate musculature; most common among bodybuilders"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7e5c7d1-f2e0-4076-8937-977187e1cd8e",
                                                "sense_id": "d4f9a0e7-c5af-36da-b052-0dc7148f17eb",
                                                "text": "The quest for perfect pecs is so strong that psychiatrists now sometimes refer to it as “bigorexia,” a form of muscle dysmorphia exhibited mostly by men and characterized by excessive weight lifting, a preoccupation with not feeling muscular enough and a strict adherence to eating foods that lower weight and build muscle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8485d0c6-1cb3-4765-84bb-5bdb6918eb8e",
                        "source_entry_id": "bc5b566a-d876-3945-9e38-65158330dbce",
                        "source_sense_id": "3075a693-61df-33dc-8862-e83664021e14",
                        "target_lang_word": "muscle dysmorphia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muscle dysmorphia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef089c8f-da36-385f-9fd2-75d884a2a1bf",
                                        "entry_id": "a1a9732e-0049-333a-bb60-7e99f0a07bd9",
                                        "glosses": [
                                            "A disorder in which a person becomes obsessed with the idea that they are not muscular enough."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
