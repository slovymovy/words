                                        "sense_id": "58dc6a9c-ed5a-38b2-a788-dbf03ab0d0fb",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "The sudden onset of a disease or condition."
                                        ],
                                        "tags": [],
