                    {
                        "sense_id": "5afd6750-4882-3f2e-8c73-910dd83b8a87",
                        "entry_id": "2f35b0d2-6028-3692-b632-8d1b4d222dfd",
                        "glosses": [
                            "dziedzina plastyki artystycznej i użytkowej zajmująca się wyrobami z metali"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd4ecd09-4fbd-451b-ae1b-2b4dcc234f92",
                                "sense_id": "5afd6750-4882-3f2e-8c73-910dd83b8a87",
                                "text": "W pojęciu szerokim metaloplastyka obejmuje również kowalstwo artystyczne, złotnictwo oraz wszystkie inne techniki obróbki metali znane od starożytności"
                            },
                            {
                                "example_id": "628ada1b-cde2-4ab7-90b3-dd6b90b31a0f",
                                "sense_id": "5afd6750-4882-3f2e-8c73-910dd83b8a87",
                                "text": "Do najwspanialszych dzieł metaloplastyki średniowiecznej zaliczyć można drzwi katedr zdobione scenami z życia Chrystusa czy świętych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f09b9e15-1342-3491-a9f2-dba21f958a53",
