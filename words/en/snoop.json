                            {
                                "target_lang_word": "çırpmak",
                                "target_lang_sense_clarification": "bir şeyi el çabukluğuyla çalmak"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zwędzić",
                                "target_lang_sense_clarification": "ukraść coś drobnego, podkraść"
                            },
                            {
                                "target_lang_word": "świsnąć",
                                "target_lang_sense_clarification": "zwinąć coś niepostrzeżenie"
                            },
                            {
                                "target_lang_word": "podwędzić",
                                "target_lang_sense_clarification": "zabrać ukradkiem"
                            }
                        ]
                    }
                }
