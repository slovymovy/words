                                    {
                                        "sense_id": "82ea7671-99d1-38db-9e4c-09ea2fed8f96",
                                        "entry_id": "da4cb00d-0de1-3a81-a863-d4c9f050ebef",
                                        "glosses": [
                                            "A city, the capital of Jalisco, in central Mexico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e98b4d-325a-42a9-9d3e-b4e10648edd1",
                                                "sense_id": "82ea7671-99d1-38db-9e4c-09ea2fed8f96",
                                                "text": "For much of the 20th century, the image of Mexico popularized abroad through film, music, art and literature was, more accurately, a portrayal of Jalisco state and especially its capital, Guadalajara."
                                            }
                                        ]
