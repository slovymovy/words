                "senses": [
                    {
                        "sense_id": "932c322c-6c69-3626-a03d-5d44b81741b5",
                        "entry_id": "8274a6cc-3b34-3103-b207-57013d911296",
                        "glosses": [
                            "Gesamtheit der sich verzweigenden Schienen eines Bahnhofs oder verzweigende Gleise an einer Drehscheibe"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "9d71aab8-1d86-468d-9837-c0f90c45eab9",
                                "sense_id": "932c322c-6c69-3626-a03d-5d44b81741b5",
                                "text": "„Die Bedingungen und Auflagen für eine Wiederherstellung der Betriebsfähigkeit einzelner Anlagenteile wie Lokschuppen, Gleisfächer und Drehscheibe soll geprüft werden.“"
                            },
                            {
                                "example_id": "e4454e35-3774-46d2-a4ba-02821cd9a112",
                                "sense_id": "932c322c-6c69-3626-a03d-5d44b81741b5",
                                "text": "„Dasselbe gilt für die Gleisfächer sowohl der Personen- wie Güterbahnhöfe, die heute noch das Stadtbild der Innenstadt zerreißen.“"
                            },
                            {
                                "example_id": "054d566e-dba5-4fbc-99b0-9a7dbe9cdf91",
                                "sense_id": "932c322c-6c69-3626-a03d-5d44b81741b5",
                                "text": "„Dazu hätte auch der für den Eisenbahnhafen Bremen charakteristische, inzwischen beseitigte riesige Gleisfächer des Bahnhofs Bremen-Zollausschluß gehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
