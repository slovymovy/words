                                        "entry_id": "35debe29-36c4-3e7f-8acf-355e6754a30f",
                                        "glosses": [
                                            "kesselförmige Eintiefung an einem Berghang mit flachem Boden und steilen Rückwänden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195cb2b8-ee00-4dbf-b5f3-35a3f8c9062b",
                                                "sense_id": "dcce4882-68fc-3aae-b198-dfe9e8f11ec1",
                                                "text": "Der Mummelsee, dem der Dichter Hans Jakob Christoffel von Grimmelshausen in seinem Roman Simplizissimus ein literarisches Denkmal gesetzt hat, hat sich in einem Kar gebildet."
                                            }
