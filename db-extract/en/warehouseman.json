                                        "glosses": [
                                            "jemand, der gewerbsmäßig die Lagerung und Aufbewahrung von Gütern übernimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbba0d3c-d918-47b0-bbc5-c0ce731612c2",
                                                "sense_id": "698b5d4c-cae1-3b31-bf32-fca36acbe08c",
                                                "text": "Ein Lagerhalter ist Kaufmann im Sinne des HGB, so weit sein Unternehmen einen in Art und Umfang in kaufmännischer Weise eingerichteten Geschäftsbetrieb erfordert (§ 467 HGB)."
                                            }
                                        ],
