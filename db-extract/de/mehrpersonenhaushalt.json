                "senses": [
                    {
                        "sense_id": "ed3da948-9a3c-35e9-a99b-14e13858d1f0",
                        "entry_id": "7151cac3-2f92-3e19-a07e-3baf9bfd4951",
                        "glosses": [
                            "aus mehr als einer Person bestehender Haushalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf069f5-bc2b-4a0c-9251-cb352f2f50c0",
                                "sense_id": "ed3da948-9a3c-35e9-a99b-14e13858d1f0",
                                "text": "„Die Stadt Wien wird bis Mitte Juni jedem Mehrpersonenhaushalt einen Gutschein über 50 Euro für Essen und Trinken beim Wirten zusenden.“"
                            },
                            {
                                "example_id": "cfe375d4-66d7-4960-acd0-d8fedabd7f38",
                                "sense_id": "ed3da948-9a3c-35e9-a99b-14e13858d1f0",
                                "text": "„Ihr Augenmerk richteten sie dabei auf 124 Männer und Frauen, die bis zum 21. Februar 2020 an Covid-19 erkrankt waren und mindestens vier Tage vor und zwei Tage nach Ausbruch der Symptome in einem Mehrpersonenhaushalt gewohnt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
