                },
                {
                    "sense_id": "782a1387-72c6-3cf1-814a-460951ecb527",
                    "sense_definition": "Inquiétude modérée, doute ou appréhension concernant une situation défavorable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai bien <w>peur</w> que le train soit déjà parti.",
                            "target_lang_translations": {
                                "en": "I'm <w>afraid</w> the train has already left.",
                                "ru": "<w>Боюсь</w>, что поезд уже ушёл.",
                                "nl": "Ik <w>vrees</w> helaas dat de trein al vertrokken is.",
                                "de": "Ich <w>fürchte</w> leider, dass der Zug schon weg ist.",
                                "pl": "<w>Obawiam się</w>, że pociąg już odjechał.",
                                "it": "<w>Temo</w> proprio che il treno sia già partito.",
                                "cs": "Bohužel <w>se obávám</w>, že vlak už odjel.",
                                "tr": "<w>Korkarım</w> ki tren çoktan kalkmış.",
                                "es": "<w>Me temo</w> que el tren ya haya salido.",
                                "zh": "我真<w>担心</w>火车已经开走了。"
                            }
                        },
                        {
                            "text": "Elle a fermé la fenêtre de <w>peur</w> d'attraper un coup de froid.",
                            "target_lang_translations": {
                                "en": "She closed the window for <w>fear</w> of catching a chill.",
                                "ru": "Она закрыла окно, <w>опасаясь</w> простудиться.",
                                "nl": "Ze heeft het raam dichtgedaan uit <w>angst</w> om kou te vatten.",
                                "de": "Aus <w>Angst</w> davor, sich zu erkälten, hat sie das Fenster geschlossen.",
                                "pl": "Zamknęła okno z <w>obawy</w> przed przeziębieniem.",
                                "it": "Ha chiuso la finestra per <w>timore</w> di prendere freddo.",
                                "cs": "Zavřela okno ze <w>strachu</w>, aby se nenachladila.",
                                "tr": "Üşütmekten <w>korkarak</w> pencereyi kapattı.",
                                "es": "Cerró la ventana por <w>miedo</w> a coger frío.",
                                "zh": "她关上了窗户，<w>担心</w>自己着凉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appréhension",
                        "inquiétude",
                        "souci",
                        "crainte"
                    ],
                    "common_phrases": [
                        "avoir bien peur",
                        "de peur de",
                        "de peur que"
                    ],
                    "target_lang_definitions": {
                        "en": "A mild worry or doubt about an unfavourable situation.",
                        "ru": "Лёгкое беспокойство или сомнение по поводу неблагоприятной ситуации.",
                        "nl": "Lichte ongerustheid of twijfel over een ongunstige situatie.",
                        "de": "Leichte Sorge, Zweifel oder Befürchtung angesichts einer ungünstigen Situation.",
                        "pl": "Lekkie zmartwienie, wątpliwość lub obawa dotycząca niekorzystnej sytuacji.",
                        "it": "Lieve inquietudine o dubbio riguardo a una situazione sfavorevole, spesso legato al timore di un esito negativo.",
                        "cs": "Mírné znepokojení, pochybnost nebo obava o nepříznivou situaci.",
                        "tr": "Olumsuz bir durumla ilgili hafif bir endişe, şüphe veya kaygı.",
                        "es": "Inquietud leve o duda ante una situación desfavorable, a menudo por temor a que algo salga mal.",
                        "zh": "对不利处境的轻微担忧或疑虑。"
                    },
