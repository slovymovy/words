                        "examples": []
                    },
                    {
                        "sense_id": "99926471-92d2-3474-ad21-4f2388483eb7",
                        "entry_id": "6897fce4-bf96-3198-ab1e-e82a9da3687e",
                        "glosses": [
                            "A component of a nuclear weapon that produces a burst of neutrons to start the chain reaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3df9e1b-20fe-4a87-a973-938c2e64f115",
                                "sense_id": "99926471-92d2-3474-ad21-4f2388483eb7",
                                "text": "‘This, er, initiator of polonium and lithium, would it be used in an anti-personnel bomb?’ he asked. ‘Oh yes, you could say so, boyo,’ replied the Welshman. ‘An initiator, you see, is what sets off a nuke.’"
                            }
                        ]
                    },
