                        "examples": [
                            {
                                "example_id": "a0fe5b80-1749-4cff-8d09-a1d72dc42bbe",
                                "sense_id": "1894f9b0-e476-302b-ac29-386d8746b354",
                                "text": "Near-synonyms: menu, menuet (obsolete), miniature, minuscule, infime; de poche"
                            },
                            {
                                "example_id": "f5765b64-b673-42dc-b8e9-c73b8b61f09e",
                                "sense_id": "1894f9b0-e476-302b-ac29-386d8746b354",
                                "text": "La dernière fois que je te voyais, tu n'étais qu'un petiot garçon. Maintenant, c'est toi qui me dépasses d'au moins cinq à six têtes, quoi !",
                                "translation": "The last time I saw you, you were just a tiny boy. But now you’re at least, like five or six heads taller than I am.",
                                "english": "The last time I saw you, you were just a tiny boy. But now you’re at least, like five or six heads taller than I am."
                            }
                        ]
