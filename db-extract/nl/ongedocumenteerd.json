                                    {
                                        "sense_id": "62356f7d-a6a4-3773-b6d0-c90030e73293",
                                        "entry_id": "4607b9fe-4be0-3557-be53-a9a042c542c0",
                                        "glosses": [
                                            "Lacking instructions or reference material."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4442a1-32e9-48af-bd0d-6cfb7114b2f5",
                                                "sense_id": "62356f7d-a6a4-3773-b6d0-c90030e73293",
                                                "text": "Undocumented software can be very difficult to learn to use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7553227-d98b-3f61-91e4-f64823964a02",
                                        "entry_id": "4607b9fe-4be0-3557-be53-a9a042c542c0",
                                        "glosses": [
                                            "Not having official documents that provide identification, authorization, etc."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0962dfba-16e6-4fae-ad23-f9183579f2de",
                                                "sense_id": "a7553227-d98b-3f61-91e4-f64823964a02",
                                                "text": "On arrival from a foreign port, undocumented foreign-built vessels, if laden with goods, wares or merchandise, may, with their cargoes, be subject to forfeiture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e469038-dd77-3539-a23a-791f5618bec3",
                                        "entry_id": "4607b9fe-4be0-3557-be53-a9a042c542c0",
                                        "glosses": [
                                            "Not having official documents that provide identification, authorization, etc.",
                                            "Not having official documentation required to legally enter, reside in, or work in a country."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6012d77-0a3a-401a-a225-76e9126ad5dc",
                                                "sense_id": "9e469038-dd77-3539-a23a-791f5618bec3",
                                                "text": "undocumented immigrant"
                                            },
                                            {
                                                "example_id": "14f836d1-b75d-4a04-8140-9f5a7698e509",
                                                "sense_id": "9e469038-dd77-3539-a23a-791f5618bec3",
                                                "text": "One day after class I was talking to them about college, and one of my top students raised his hand and said he wasn’t sure he could go because he’s undocumented. He didn’t know if they’d let him in."
                                            },
                                            {
                                                "example_id": "b0df5e2c-9674-4f17-b004-5eae447b7082",
                                                "sense_id": "9e469038-dd77-3539-a23a-791f5618bec3",
                                                "text": "In Tucker, another Atlanta suburb, an undocumented man attending church was arrested after ICE agents arrived, pastor Luis Ortiz told CNN. He said he was in the middle of his sermon when he noticed a couple of members of his church escort the man out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "undocumented",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2f0bc79-6690-3f93-b349-42672e39664f",
                                        "entry_id": "79bd2709-dda6-3e93-b2f6-b9e8cdb25e85",
                                        "glosses": [
                                            "Synonym of undocumented immigrant."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d10bdb-c652-478e-ad88-fed0317e4f73",
                                                "sense_id": "c2f0bc79-6690-3f93-b349-42672e39664f",
                                                "text": "Although the first generation is likely to have greater fluency than the undocumenteds, the controversy over bilingual education attests to the persistence of language difficulties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
