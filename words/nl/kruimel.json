            "senses": [
                {
                    "sense_id": "2af1c8b2-c0fa-3b76-82fa-6bbe02064482",
                    "sense_definition": "Een klein, afgebroken stukje van brood, koek, beschuit of ander droog voedsel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedselresten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het eten van het broodje lagen er overal <w>kruimels</w> op de tafel.",
                            "target_lang_translations": {
                                "en": "After eating the sandwich, there were <w>crumbs</w> everywhere on the table."
                            }
                        },
                        {
                            "text": "Zij veegde voorzichtig elke <w>kruimel</w> van haar schone broek.",
                            "target_lang_translations": {
                                "en": "She carefully wiped every <w>crumb</w> off her clean pants."
                            }
                        }
                    ],
                    "synonyms": [
                        "kruim"
                    ],
                    "common_phrases": [
                        "een kleine kruimel",
                        "kruimels van de tafel"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, broken-off piece of bread, cake, biscuit, or other dry food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crumb",
                                "target_lang_sense_clarification": "a small fragment of bread, cake, or biscuit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c33110aa-d7b9-335a-8e14-718e1d7a206a",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kruimelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kruimel</w> mijn koekje altijd boven een bord om de tafel schoon te houden.",
                            "target_lang_translations": {
                                "en": "I always <w>crumble</w> my cookie over a plate to keep the table clean."
                            }
                        },
                        {
                            "text": "Als ik de cake snijd, <w>kruimel</w> ik meestal heel erg.",
                            "target_lang_translations": {
                                "en": "When I cut the cake, I usually <w>crumble</w> it a lot."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'kruimelen' (to crumble)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crumble",
                                "target_lang_sense_clarification": "first-person singular present tense of the verb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1523a11c-6880-3cbd-8dd7-23d72d44ad7b",
                    "sense_definition": "Gebiedende wijs van <w>kruimelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kruimel</w> niet zo op het tapijt, want dat is lastig schoon te maken.",
                            "target_lang_translations": {
                                "en": "Don't <w>crumble</w> so much on the carpet, because that is hard to clean."
                            }
                        },
                        {
                            "text": "Alsjeblieft, <w>kruimel</w> die droge beschuit boven het aanrecht.",
                            "target_lang_translations": {
                                "en": "Please, <w>crumble</w> that dry rusk over the kitchen counter."
                            }
