            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88af7efd-d4bd-348c-800c-30ee107e4939",
                    "sense_definition": "het feit dat men iets heeft of de toestand van het hebben van eigendom",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eigendom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zijn eindelijk in het <w>bezit</w> van een eigen woning in de stad.",
                            "target_lang_translations": {
                                "en": "They are finally in <w>possession</w> of their own home in the city.",
                                "ru": "Они наконец-то стали <w>владельцами</w> собственного жилья в городе."
                            }
                        },
                        {
                            "text": "Het illegaal <w>bezit</w> van wapens is in dit land streng verboden.",
                            "target_lang_translations": {
                                "en": "The illegal <w>possession</w> of weapons is strictly forbidden in this country.",
                                "ru": "Незаконное <w>владение</w> оружием в этой стране строго запрещено."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in het bezit",
                        "persoonlijk bezit",
                        "illegaal bezit"
                    ],
                    "target_lang_definitions": {
                        "en": "the fact of having something or the state of owning property",
                        "ru": "факт наличия чего-либо или состояние владения собственностью"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "possession",
                                "target_lang_sense_clarification": "the state of having or owning something"
                            },
                            {
                                "target_lang_word": "ownership",
                                "target_lang_sense_clarification": "the legal right of possessing something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "владение",
                                "target_lang_sense_clarification": "факт или процесс обладания чем-либо"
                            },
                            {
                                "target_lang_word": "обладание",
                                "target_lang_sense_clarification": "состояние наличия чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58999fdd-bfb1-3db8-82d0-e6d8c4271dd8",
                    "sense_definition": "iets dat iemand toebehoort of een verzameling van eigendommen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eigendom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Al zijn kostbaar <w>bezit</w> ging verloren tijdens de grote brand.",
                            "target_lang_translations": {
                                "en": "All his valuable <w>possessions</w> were lost during the large fire.",
                                "ru": "Все его ценное <w>имущество</w> погибло во время сильного пожара."
                            }
                        },
                        {
                            "text": "De oude auto was jarenlang zijn enige <w>bezit</w>.",
                            "target_lang_translations": {
                                "en": "The old car was his only <w>possession</w> for years.",
                                "ru": "Старая машина годами была его единственной <w>собственностью</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezitting",
                        "eigendom"
                    ],
                    "common_phrases": [
                        "kostbaar bezit",
                        "enig bezit"
                    ],
                    "target_lang_definitions": {
