                "entry_id": "73b753c1-2ea9-3b23-86af-c89694ca165d",
                "word": "journalism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7944c868-9e46-49f7-afe3-408f3fc694aa",
