                "translations": [
                    {
                        "translation_id": "9ed7c36b-5fad-40a4-bfb1-3cc02a98d549",
                        "source_entry_id": "6bc28b20-ab27-3685-aa1b-128c9c8a84b6",
                        "source_sense_id": "a8f1e22c-d486-312e-aa5f-f832b2d594fc",
                        "source_sense_description": "een boom met peren als vrucht",
                        "target_lang_word": "Birnbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birnbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7024d73-3412-321e-85fe-d61f8289f5c2",
                                        "entry_id": "3f66a9c3-6ab1-337d-be07-b1a6e2326a18",
                                        "glosses": [
                                            "ein Obstbaum, der als Früchte Birnen hervorbringt und trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a14b03-6a1b-478e-9852-d8c5eb5c5c71",
                                                "sense_id": "e7024d73-3412-321e-85fe-d61f8289f5c2",
                                                "text": "Zur Zeit blühen die Birnbäume."
                                            },
                                            {
                                                "example_id": "5eb9fc34-9b0b-4075-b64e-adecf8407ff6",
                                                "sense_id": "e7024d73-3412-321e-85fe-d61f8289f5c2",
                                                "text": "Der Birnbaum gehört zu den Rosengewächsen."
                                            },
                                            {
                                                "example_id": "cce5da9e-f482-4712-89ff-fda841494e0a",
                                                "sense_id": "e7024d73-3412-321e-85fe-d61f8289f5c2",
                                                "text": "Herr von Ribbeck auf Ribbeck im Havelland,",
                                                "translation": "ein Birnbaum in seinem Garten stand. …"
                                            },
                                            {
                                                "example_id": "5077be98-7ed7-48c1-8145-a9d582da4593",
                                                "sense_id": "e7024d73-3412-321e-85fe-d61f8289f5c2",
                                                "text": "„Er ließ kaum eine Blume, einen Baum unbesungen, wusste um die Poesie blühender Apfel- und Birnbäume ebenso wie der Gäser, ließ in seinen Gedichten die Nachtigallen singen und bestaunte die Grazie der Fliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95f0cab3-0f8c-4cc2-9d25-ab9820f5d07b",
                        "source_entry_id": "6bc28b20-ab27-3685-aa1b-128c9c8a84b6",
                        "source_sense_id": "a8f1e22c-d486-312e-aa5f-f832b2d594fc",
                        "source_sense_description": "een boom met peren als vrucht",
                        "target_lang_word": "Birne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15584eb6-90bd-33d0-a9c8-c1f833c532ec",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "Obstbaumart"
                                        ],
                                        "tags": [
                                            "Pyrus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a543c8d-f6a6-451b-a4cc-1e2c2ac03087",
                                                "sense_id": "15584eb6-90bd-33d0-a9c8-c1f833c532ec",
                                                "text": "Die Birne blüht früher als der Apfel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "grün-gelbliche Frucht dieses Obstbaumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3658929b-b376-46cc-b6af-f7397d0e2539",
                                                "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                                "text": "Ich esse lieber Birnen als Äpfel."
                                            },
                                            {
                                                "example_id": "f5c8a585-d99e-4a69-b68e-f8752391dc71",
                                                "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                                "text": "Herr von Ribbeck auf Ribbeck im Havelland: […] Und kam die goldene Herbsteszeit, - Und die Birnen leuchteten weit und breit, - Da stopfte, wenn’s Mittag vom Thurme scholl, - Der von Ribbeck sich beide Taschen voll - […]"
                                            },
                                            {
                                                "example_id": "48e01126-1edc-46f1-b808-6a5c5b319efd",
                                                "sense_id": "7c42ac86-3290-3e3f-8b35-b1fd25f115bd",
                                                "text": "„Über die Katze von Saint-Allyre staunte sie sehr, über die Birne in der Karaffe etwas weniger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "Kopf"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ffd919d-1913-4603-8cf5-e1dda8ebeb8d",
                                                "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                                "text": "Er hat nichts in der Birne."
                                            },
                                            {
                                                "example_id": "70971df6-9376-45aa-9555-92b586c3e5d2",
                                                "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                                "text": "Wer keine weiche Birne hat, kauft harte Äpfel aus Halberstadt."
                                            },
                                            {
                                                "example_id": "931786ef-ef97-43a5-b2a5-3a1cf58c4ab9",
                                                "sense_id": "280a9d3b-8dea-3bc8-877d-4da01c7f4ffe",
                                                "text": "„Du hast Grips in der Birne und solltest als Philosoph tätig sein, anstatt dubiosen Geschäftspartnern Triebwerke zu verhökern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "Glühbirne"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b48dec1-493f-4e46-a6bf-dd7c67841dd3",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "Oh, die Lampe geht nicht mehr, ich muss die Birne wechseln."
                                            },
                                            {
                                                "example_id": "dd8d1c47-f31e-4911-8647-7918eb53cfa1",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "Dank des Preisverfalls werden die innovativen [LED-]Birnen bald zum Massenprodukt, Experten prognostizieren dies schon für das nächste Jahr."
                                            },
                                            {
                                                "example_id": "a2aa785f-be50-4e7e-a737-d55a62e6ce24",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "„Auf sein Banjo war in Schwarz eine Szene am Palmenstrand gemalt, und innen waren rote, gelbe und grüne elektrische Birnen, die aufflackerten und erloschen, während er spielte.“"
                                            },
                                            {
                                                "example_id": "b32fc452-77e2-42b0-aaab-46fc8342ede7",
                                                "sense_id": "2a0b6632-bd30-3498-97d7-e0e118dcc38b",
                                                "text": "„Er stößt gegen die Birne, fällt, krabbelt, fliegt wieder hoch und umkreist das Licht aufs neue.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "36478fb1-4339-3125-9d91-6127e746186d",
                                        "entry_id": "a118a246-32d7-33b4-8a83-651595dc92cb",
                                        "glosses": [
                                            "„auswechselbares, verdicktes Verbindungsstück zwischen Mundstück und Röhre der Klarinette“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5625ada9-f990-482a-be1b-2b559b2ed8a0",
                                                "sense_id": "36478fb1-4339-3125-9d91-6127e746186d",
                                                "text": "„Es kann durchaus sein, daß die eine Klarinette eines Satzes eine engere und die andere Klarinette eine weitere Bohrung der Birne benötigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27af19be-dd6d-49af-b329-4e6ecefd28cf",
                        "source_entry_id": "6bc28b20-ab27-3685-aa1b-128c9c8a84b6",
                        "source_sense_id": "a8f1e22c-d486-312e-aa5f-f832b2d594fc",
                        "source_sense_description": "een boom met peren als vrucht",
                        "target_lang_word": "pear tree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pear tree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa600828-e36c-3c32-b651-196749a8dcac",
                                        "entry_id": "6a5326e0-77a2-3310-8145-fe12febdda46",
                                        "glosses": [
                                            "A tree of the genus Pyrus, which bears the pears as fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e49ebc69-034e-4f5e-8c71-5b6f57c7c6df",
                                                "sense_id": "fa600828-e36c-3c32-b651-196749a8dcac",
                                                "text": "On the first day of Christmas, my true love sent to me\nA partridge in a pear tree"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7718a9ff-6182-44f3-92c9-1ba84e18fb65",
                        "source_entry_id": "6bc28b20-ab27-3685-aa1b-128c9c8a84b6",
                        "source_sense_id": "a8f1e22c-d486-312e-aa5f-f832b2d594fc",
                        "source_sense_description": "een boom met peren als vrucht",
                        "target_lang_word": "poirier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poirier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                        "entry_id": "4c609ca7-dce6-308b-99af-981dba772d84",
                                        "glosses": [
                                            "Arbre fruitier qui produit les poires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60b4294-2726-4d50-a0fa-cc86053a92ba",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "La plupart des montagnes de Walachie sont garnies de bois composés de poiriers, de cerisiers, d’abricotiers et autres arbres fruitiers qui donnent aux forêts l’aspect d’immenses vergers."
                                            },
                                            {
                                                "example_id": "ce3db743-a1b8-46ff-9e19-ed9fe4a3b8b8",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "Les poiriers déjà étaient en fleur, et le bonhomme Rouault, debout maintenant, allait et venait, ce qui rendait la ferme plus animée."
                                            },
                                            {
                                                "example_id": "7b5d5f4e-eb4e-483c-836b-4b2395349501",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "Le poirier, abandonné à lui même, est un arbre assez élevé, et dont le tronc peut acquérir des dimensions considérables."
                                            },
                                            {
                                                "example_id": "cfb7ed48-d1fa-4cb2-abe0-a33ae416d48f",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "Dans les vergers ou les terrains vagues, où l’on ne compte pas sur la récolte du sol, on plante en général 200 pommiers ou poiriers par hectare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27039dfa-0652-3fe7-b500-a0cffb0b33d4",
                                        "entry_id": "4c609ca7-dce6-308b-99af-981dba772d84",
                                        "glosses": [
                                            "Bois du poirier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "484bf701-9856-44dc-ab73-cbd385bd1720",
                                                "sense_id": "27039dfa-0652-3fe7-b500-a0cffb0b33d4",
                                                "text": "L'ancienne taille en fil, qui champlevait péniblement ses blancs dans le poirier, a cédé la place au travail plus net qui creuse dans le bout de buis des lignes où le burin n'a plus à craindre les éclats des fibres lamelleuses."
                                            },
                                            {
                                                "example_id": "3b9d0ee5-ece6-4b09-acd6-e264dd3d6bca",
                                                "sense_id": "27039dfa-0652-3fe7-b500-a0cffb0b33d4",
                                                "text": "Je m’asseyais dans le fauteuil de cuir, à côté de la bibliothèque en poirier noirci, je faisais craquer entre mes mains les livres neufs, je respirais leur odeur, je regardais les images, les cartes, je parcourais une page d’histoire : […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                        "entry_id": "4c609ca7-dce6-308b-99af-981dba772d84",
                                        "glosses": [
                                            "Figure consistant à rester en équilibre sur la tête."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3097a750-d7a2-44e2-989b-a214d8d2eafb",
                                                "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                                "text": "Faire le poirier."
                                            },
                                            {
                                                "example_id": "b1e43c55-6a66-4361-ab69-616eb8084014",
                                                "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                                "text": "Trois gamins qui sortaient de l’eau faisaient le poirier fourchu sur l’herbe."
                                            },
                                            {
                                                "example_id": "7523913f-0a78-4e53-80aa-0ef293fcd9eb",
                                                "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                                "text": "Elle n’avait jamais su faire la roue, ni les sauts de biche, ni le poirier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
