                "senses": [
                    {
                        "sense_id": "ec640d2f-aff9-3f02-a7d3-437b20bcfbd0",
                        "entry_id": "36185845-f818-34e8-ace5-dd1cf80e9e68",
                        "glosses": [
                            "Test de personnalité servant à déterminer son type psychologique parmi seize types différents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb9dc744-ecae-4390-b628-485aba85f469",
                                "sense_id": "ec640d2f-aff9-3f02-a7d3-437b20bcfbd0",
                                "text": "Outre le courant de la socionique (élaboré en Union Soviétique), celui qui s’est imposé jusqu’à aujourd’hui est le modèle proposé par Isabel Briggs Myers et Katharine Cook Briggs. Pendant plus de 40 ans, la fille et la mère ont ainsi travaillé à l’élaboration du MBTI, un outil très complet et très utilisé encore de nos jours."
                            },
                            {
                                "example_id": "d663781c-5094-4b4d-b8d4-ced80c0041ee",
                                "sense_id": "ec640d2f-aff9-3f02-a7d3-437b20bcfbd0",
                                "text": "MBTI (Myers - Briggs Type Indicator) présente des avantages, il est important de considérer également ses limitations et inconvénients."
                            }
                        ]
                    }
