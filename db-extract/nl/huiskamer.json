                "senses": [
                    {
                        "sense_id": "d3082858-fe2e-3905-becd-f7a85674e704",
                        "entry_id": "55b00c26-3c3d-3e38-bd4f-ae470e0d93df",
                        "glosses": [
                            "een kamer die primair is ingericht om in te wonen"
                        ],
                        "tags": [
                            "vertrek",
                            "wonen"
                        ],
                        "examples": [
                            {
                                "example_id": "dcca5a8c-55c9-4dd2-bf33-ad91a8f117e4",
                                "sense_id": "d3082858-fe2e-3905-becd-f7a85674e704",
                                "text": "De huiskamer was op het noorden gelegen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaec7d6e-f15b-47b7-a71b-7f816306cd32",
                        "source_entry_id": "55b00c26-3c3d-3e38-bd4f-ae470e0d93df",
                        "source_sense_id": "d3082858-fe2e-3905-becd-f7a85674e704",
                        "target_lang_word": "Wohnzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Raum in einem Haus oder einer Wohnung, der für den Aufenthalt von Personen am Tag bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c88b32-8655-4e34-81e9-fec041e72d1e",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "Das Wohnzimmer ist meist der größte Wohnraum."
                                            },
                                            {
                                                "example_id": "6d44d3f2-fe32-45ca-8b5b-d30f5d946645",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er stand auf, ließ Hugo und mich im Arbeitszimmer zurück und ging ins Wohnzimmer, wo er sich einen Whiskey aus der Hausbar einschenken würde, einen großen.“"
                                            },
                                            {
                                                "example_id": "648a9392-9d10-4fc8-a742-28cdd4675c4b",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Morell saß, an einem Glas Brandy nippend, in dem warmen Wohnzimmer in Westminster, dem seine Frau eine echt weibliche Note gegeben hatte.“"
                                            },
                                            {
                                                "example_id": "263baad3-9cc7-4d71-b4b3-da18c5f7a8c1",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Sie rannte mit wehender Pelerine ins Wohnzimmer und warf Aschenbecher unter das Klavier.“"
                                            },
                                            {
                                                "example_id": "3b550fb1-50f0-4a46-a6d6-5ec4008cee0d",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Neben ihrer Schlafcouch im Wohnzimmer hängt ein Wandteppich mit einer idyllischen Waldszene.“"
                                            },
                                            {
                                                "example_id": "b3287855-da2a-4b2e-87b9-3435fb7fb86f",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er beobachtete den unten schmiedeeisernen, oben grüngekachelten Ofen im Wohnzimmer wie ein widerspenstiges, gefährliches Biest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Einrichtung eines Wohnzimmers^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab2700c-fda7-4abe-b0d4-455145bd5ac8",
                                                "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                                "text": "Wir haben uns endlich entschlossen, ein neues Wohnzimmer zu kaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd9eec92-8521-451b-b09c-916961546d80",
                        "source_entry_id": "55b00c26-3c3d-3e38-bd4f-ae470e0d93df",
                        "source_sense_id": "d3082858-fe2e-3905-becd-f7a85674e704",
                        "target_lang_word": "living room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "living room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6f008f-097f-3184-b7ba-f2902d139d50",
                                        "entry_id": "d7c118d7-0561-31b4-9f1f-c582d4d2da47",
                                        "glosses": [
                                            "A room in a private house used for general social and leisure activities."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813c0c51-dd9f-47e2-9535-70ba92625936",
                                                "sense_id": "ee6f008f-097f-3184-b7ba-f2902d139d50",
                                                "text": "We relax in the living room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a344a29c-2c21-3695-a1cf-bdd7cfd55cd6",
                                        "entry_id": "d7c118d7-0561-31b4-9f1f-c582d4d2da47",
                                        "glosses": [
                                            "Land intended for settlers."
                                        ],
                                        "tags": [
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "801d8950-3041-44cb-bff3-1a9d3fd8b787",
                                                "sense_id": "a344a29c-2c21-3695-a1cf-bdd7cfd55cd6",
                                                "text": "But in the quest for ‘lebensraum’ — the Nazi quest for living room for the German people — he was to find to his ultimate cost the Russians were made of sterner stuff than he had envisaged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86796736-93c1-4736-84c0-5d6b1937969c",
                        "source_entry_id": "55b00c26-3c3d-3e38-bd4f-ae470e0d93df",
                        "source_sense_id": "d3082858-fe2e-3905-becd-f7a85674e704",
                        "target_lang_word": "séjour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séjour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Demeure, résidence plus ou moins longue dans un lieu, dans un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b773ed-8277-4811-b2af-c63cc941ce88",
                                                "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                                "text": "Ma belle-mère m'avait appris, dans un moment d’égarement, qu'il avait été en prison pendant vingt ans pour inceste sur ses propres filles en Normandie et interdit de séjour depuis lors dans sa région."
                                            },
                                            {
                                                "example_id": "920e060a-a087-46d8-bd4d-c71abb44fbb0",
                                                "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                                "text": "Que je le plains, pécheur, en ton heure dernière !\nLes maux les plus affreux sont amassés sur toi ;\nLe noir enfer, séjour rempli d’effroi,\nT’attend au bout de la carrière."
                                            },
                                            {
                                                "example_id": "f6779e31-828d-406f-9431-6375a3aca018",
                                                "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                                "text": "— Par contre, la grande gueule, celui qui balance les « krèles », je le connais. Il tape sa petite sœur. La gamine a déjà fait trois séjours à l’hosto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a2e5e11-d2f8-38d8-944c-ef6f596f58e3",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Temps qu’un bâtiment de guerre passe en relâche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4c0b47-4d2a-4daa-9937-8451a07cdf29",
                                                "sense_id": "3a2e5e11-d2f8-38d8-944c-ef6f596f58e3",
                                                "text": "Le séjour de ce vaisseau dans tel port a été d’une semaine, d’un mois, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528a9fb8-05e8-3659-8537-eebd763ea619",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Arrêt des liquides qui restent plus ou moins longtemps en quelque endroit."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c6e3d4-3feb-4a2c-88e2-0bc1168d343b",
                                                "sense_id": "528a9fb8-05e8-3659-8537-eebd763ea619",
                                                "text": "Le séjour des eaux dans un terrain."
                                            },
                                            {
                                                "example_id": "536844de-018e-4366-a1a7-df29393922e9",
                                                "sense_id": "528a9fb8-05e8-3659-8537-eebd763ea619",
                                                "text": "Le séjour des mers sur un continent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa32347d-1e02-3894-89af-f20f2797bf1e",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Par métonymie, temps passé dans un lieu déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268c7a1f-5a88-426d-9bb3-19a97afd2eeb",
                                                "sense_id": "aa32347d-1e02-3894-89af-f20f2797bf1e",
                                                "text": "Il a fait un séjour d’une semaine en Andalousie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Lieu considéré par rapport à l’habitation, à la demeure qu’on y fait ou qu’on y peut faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425a4bae-ad3d-4476-94e8-ac901ba66a49",
                                                "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                                "text": "Un séjour champêtre."
                                            },
                                            {
                                                "example_id": "398b9d3f-fb86-4c7e-bf4f-0be6c28f8fcc",
                                                "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                                "text": "Cette maison est un beau séjour."
                                            },
                                            {
                                                "example_id": "3796b21a-a728-45b4-b5d1-263fe0b3ac40",
                                                "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                                "text": "Cette ville est un agréable séjour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f746e7c6-d507-35ce-b4f2-0c8d817a3bf3",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Salle, pièce où l’on se tient habituellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa9c221e-e070-4833-b6b2-c5ec28d4f62a",
                                                "sense_id": "f746e7c6-d507-35ce-b4f2-0c8d817a3bf3",
                                                "text": "Cette maison a un beau séjour."
                                            }
                                        ]
