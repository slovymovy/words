                        "cross_references": [
                            {
                                "target_word": "taillis sous futaie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "919f6dbb-a335-347e-a957-1fb603ae7525",
                                        "entry_id": "29b02d56-170d-3888-b6c5-fa591b26f993",
                                        "glosses": [
                                            "Taillis avec réserves respectant un plan de balivage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc813faf-8e8e-449e-8171-829df1be2d1b",
                                                "sense_id": "919f6dbb-a335-347e-a957-1fb603ae7525",
                                                "text": "La méthode du taillis sous futaie fait participer à la fois des avantages du taillis et d'une partie de ceux de la futaie, c'est-à-dire qu'elle donne lieu à une régénération prompte et facile et à une production de bois de fortes dimensions. Dans ce but on conserve à chaque coupe du taillis un certain nombre d'arbres appelés baliveaux auxquels on laisse parcourir plusieurs révolutions."
                                            },
                                            {
                                                "example_id": "4e34a1c6-5a20-4fa1-98c7-504b00cd4ed2",
                                                "sense_id": "919f6dbb-a335-347e-a957-1fb603ae7525",
                                                "text": "[…]; le régime du taillis sous futaie pratiqué en vue de la production de l'écorce et du tan — […] — a favorisé le Chêne qui, « rejetant » abondamment de souche, a peu à peu éliminé ses concurrents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
