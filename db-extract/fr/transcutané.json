                        "entry_id": "9677ea30-0a8b-3321-99e8-5409b4b9d463",
                        "glosses": [
                            "Pénétrant ou passant à travers la peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4c21259-d284-4cd2-a4e4-8ff2e4a03d92",
                                "sense_id": "2a372845-8f6b-39f2-8e90-66af7d3a684c",
                                "text": "Elles peuvent recourir à des injections sous la peau de différents produits (solutions hypo-osmolaires, produits lipolytiques, mélanges de mésothérapie), de gaz carbonique (carboxythérapie) ou utiliser le laser transcutané."
                            },
                            {
                                "example_id": "db0b10f4-f2ec-4fd6-ae32-a49c6efeb1e2",
                                "sense_id": "2a372845-8f6b-39f2-8e90-66af7d3a684c",
                                "text": "« Contrairement aux autres patchs médicaux, le nôtre n'est pas transcutané mais épicutané », résume Pierre-Henri Benhamou, pédiatre et fondateur de DBV Technologies."
                            }
                        ]
                    }
