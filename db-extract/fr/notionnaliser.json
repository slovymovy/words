                "senses": [
                    {
                        "sense_id": "836825c5-8694-32b1-b2de-2c15f06c843a",
                        "entry_id": "fecfa9dc-79a7-3392-863a-46358369c593",
                        "glosses": [
                            "Donner un caractère notionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1a81f8-2527-4554-bfe0-e80004560697",
                                "sense_id": "836825c5-8694-32b1-b2de-2c15f06c843a",
                                "text": "Dans sa façon de conceptualiser (ou plus exactement de « notionnaliser »), J. Gottmann est d’une grande habileté."
                            },
                            {
                                "example_id": "6fbf8f97-73cc-43a1-9f78-ef940ddff122",
                                "sense_id": "836825c5-8694-32b1-b2de-2c15f06c843a",
                                "text": "Je pense que, à refaire, j'ajouterai des comptines sur les rimes et les sons, sans forcément \"notionnaliser\" le truc."
                            },
                            {
                                "example_id": "dfade130-8f38-4cb4-9430-e20607fefb31",
                                "sense_id": "836825c5-8694-32b1-b2de-2c15f06c843a",
                                "text": "Et normal que je conceptualise (notionnalise)."
                            }
                        ]
                    }
