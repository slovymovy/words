                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metalwork",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He secured the roofing felt using a short galvanized <w>clout</w>.",
                            "target_lang_translations": {
                                "zh": "他用一颗较短的镀锌<w>扁头钉</w>固定住了屋顶油毡。"
                            }
                        },
                        {
                            "text": "A box of rusty iron <w>clouts</w> was found in the old workshop.",
                            "target_lang_translations": {
                                "zh": "旧工坊里发现了一盒生锈的铁质<w>扁头钉</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于固定厚布、瓦片或金属板的扁头铁钉"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扁头钉",
