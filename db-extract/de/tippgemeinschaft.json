                    {
                        "sense_id": "00cdedb0-61b7-36ee-aa75-83f6c8b3422e",
                        "entry_id": "198a2f9f-b0b9-3fad-98f5-65d099ff41ee",
                        "glosses": [
                            "Gruppe von Personen, die mit einem gemeinsamen oder mit unterschiedlichen Lotto- oder Wettscheinen teilnimmt und sich den Gewinn teilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "329887c6-eb2c-4a56-abe9-afe8e11537be",
                                "sense_id": "00cdedb0-61b7-36ee-aa75-83f6c8b3422e",
                                "text": "„Tippgemeinschaften werden von Bürokollegen, Kneipenfreunden, Nachbarn und auch von ganzen Dörfern gebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
