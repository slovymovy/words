                                        "glosses": [
                                            "A group of wrestlers who support each other within a wrestling storyline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49479b06-ace9-4687-8d6b-eda402fd71cc",
                                                "sense_id": "8d8615f5-c474-37a3-b6bc-359f6776c736",
                                                "text": "Paul, who signed with WWE in late June, appeared in a segment with Reigns' stable, the Bloodline, on Friday's episode of SmackDown after making comments earlier in the week regarding a potential match with the Tribal Chief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b48f1a1-1083-3794-8df6-c2647d2b6653",
                                        "entry_id": "365b88b7-c920-3606-a055-2921a97de4bb",
                                        "glosses": [
                                            "A group of prostitutes managed by one pimp."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7e3296d-1e38-46f9-8f7d-4a04f73cd300",
                                                "sense_id": "4b48f1a1-1083-3794-8df6-c2647d2b6653",
                                                "text": "My pimp vision enabled me to see that no hoe in my stable would be more worthy of the game than my young turnout red-bones."
                                            }
