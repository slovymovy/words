                    },
                    {
                        "sense_id": "d61fd29c-7ebc-32e6-b9c5-d8216ee96606",
                        "entry_id": "f888c17b-f0aa-39c1-97de-d8b6b0f3f114",
                        "glosses": [
                            "unerotische Unterhose",
                            "ursprünglich lange Unterhose, dann auch allgemein für unattraktive, altmodische Unterhose, zum Beispiel aus weißem Feinripp"
                        ],
                        "tags": [
                            "bei Männern"
                        ],
                        "examples": [
                            {
                                "example_id": "09affe73-2b74-4856-a1c6-8114033a9c4a",
                                "sense_id": "d61fd29c-7ebc-32e6-b9c5-d8216ee96606",
                                "text": "Der Anblick seines Liebestöters ließ ihre Lust sofort auf den Nullpunkt sinken."
                            },
                            {
                                "example_id": "6af29787-98ac-4f8b-8a3d-cd663d9a85c9",
                                "sense_id": "d61fd29c-7ebc-32e6-b9c5-d8216ee96606",
                                "text": "Gerippte Unterwäsche und Liebestöter – das ist für viele untrennbar mit der Firma Schiesser verbunden."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "cba3980c-b9b9-364a-9c60-f17e229f3ba5",
                        "entry_id": "f888c17b-f0aa-39c1-97de-d8b6b0f3f114",
                        "glosses": [
                            "unerotische Unterhose",
                            "Unterhose mit längerem Beinansatz oder auch allgemein unattraktive, altmodische Unterhose"
                        ],
                        "tags": [
                            "bei Frauen"
                        ],
                        "examples": [
                            {
                                "example_id": "979c4c0f-f4de-49ef-90f4-c1d68dc53f15",
                                "sense_id": "cba3980c-b9b9-364a-9c60-f17e229f3ba5",
                                "text": "„Von der legendären Peinlichkeit zum lukrativen Liebestöter: Der übergroße Damenschlüpfer aus dem britischen Kinofilm ‚Bridget Jones – Schokolade zum Frühstück‘ ist in London für 2000 Pfund (fast 3000 Euro) versteigert worden.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "68a727a2-1014-371b-947a-cf70ea597b03",
                        "entry_id": "f888c17b-f0aa-39c1-97de-d8b6b0f3f114",
                        "glosses": [
                            "verschiedenste Dinge oder Verhaltensweisen, die eine Liebesbeziehung stören"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2d4c5614-c04a-4da4-9cff-97901fad1d7f",
                                "sense_id": "68a727a2-1014-371b-947a-cf70ea597b03",
                                "text": "„Fast jeder Mann kennt das Problem mit dem Gummi: Was eigentlich reibungslos und schnell gehen soll, wird schon mal von einem beschämenden Fingerhakeln zwischen Kerl und Kondom aufgehalten, ein echter Liebestöter in der Hitze des Gefechts.“"
                            },
                            {
                                "example_id": "fcc705b6-6963-43e0-bddb-4477be9f8946",
                                "sense_id": "68a727a2-1014-371b-947a-cf70ea597b03",
                                "text": "Allgemeine Verblödungstendenzen und der Verfall der Familie werden auf übermäßiges [TV-]Glotzen zurückgeführt, es gilt als Kommunikations- und sogar Liebestöter."
                            },
                            {
                                "example_id": "7fcb08d3-97d0-40fd-8a5b-d53802361d40",
                                "sense_id": "68a727a2-1014-371b-947a-cf70ea597b03",
                                "text": "Aber die Tatsache, dass mehr als tausend Menschen in die Hörsäle kommen und dann sehr vergnügt zuhören, was wir über Sex und Intimität sagen, das zeigt, dass solche lang dauernden Beziehungen keineswegs Liebestöter sind oder Sextöter, sondern dass Ehe, lang dauernde Beziehungen eine Art Wachstumsmaschine für diese Beziehung ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
