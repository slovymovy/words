                                            {
                                                "example_id": "e46cac11-095c-49b7-bef7-4f6fba6ac5db",
                                                "sense_id": "2f5de575-8da0-3b88-a826-5b791858c415",
                                                "text": "Heute war ich aber wieder sehr produktiv."
                                            },
                                            {
                                                "example_id": "fcc4acb8-8d6d-4150-96d8-ff4a83acf900",
                                                "sense_id": "2f5de575-8da0-3b88-a826-5b791858c415",
                                                "text": "Der Philosoph Konrad Paul Liessmann sagt: „Obwohl wir in der produktivsten Gesellschaft aller Zeiten leben, merken wir irgendwo nichts von dieser Entlastung. Es ist doch paradox.“"
                                            }
                                        ],
