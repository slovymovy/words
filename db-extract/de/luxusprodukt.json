                                "target_senses": [
                                    {
                                        "sense_id": "4e0b5ba4-904e-3600-9428-5c9a1531733d",
                                        "entry_id": "84478d10-fa74-37eb-b930-9467a8192768",
                                        "glosses": [
                                            "Produit de grande qualité, raffiné et rare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a725bef9-1663-4ae1-9a5c-0e1c8249d998",
                                                "sense_id": "4e0b5ba4-904e-3600-9428-5c9a1531733d",
                                                "text": "Une surtaxe de consommation est perçue sur les « produits de luxe » depuis 1986 ; sur les importations, la surtaxe est ad valorem et comporte huit taux compris entre 5 % et 70 %."
                                            },
                                            {
                                                "example_id": "957612d0-c32e-4890-bb18-cf6e6c04cdcc",
                                                "sense_id": "4e0b5ba4-904e-3600-9428-5c9a1531733d",
                                                "text": "Le livre est encore considéré comme un produit de luxe en Afrique, d’où la nécessité d’encourager l’édition locale avec des prix plus adaptés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128f80db-4e82-30f1-a480-82147a687c64",
                                        "entry_id": "84478d10-fa74-37eb-b930-9467a8192768",
                                        "glosses": [
                                            "Qui est rare, difficile à obtenir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86ea151a-73d3-47e4-8768-c60bca5b011c",
                                                "sense_id": "128f80db-4e82-30f1-a480-82147a687c64",
                                                "text": "« Est-il normal pour un journal d’un pays démocratique que plus d’un exemplaire sur deux vendus en kiosque finance la sécurité des locaux et des journalistes qui y travaillent ? », regrette Riss dans son éditorial, estimant que la liberté d’expression « est en train de devenir un produit de luxe »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
