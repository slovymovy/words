                "senses": [
                    {
                        "sense_id": "61f65924-4309-33e2-8b6c-9e2459270058",
                        "entry_id": "885655d5-010b-3f4e-99f0-e3ddc8ed9506",
                        "glosses": [
                            "Hauptstadt des mexikanischen Bundesstaats Sonora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2782c401-660a-40ac-8fa5-1d49f421f2d4",
                                "sense_id": "61f65924-4309-33e2-8b6c-9e2459270058",
                                "text": "„Sie hatten zwölf Igla-S-Raketen bei sich, versteckt in einer Ladung Buick-Regal-Kühler aus einer General-Motors-Fabrik in Hermosillo.“"
                            },
                            {
                                "example_id": "573cc97b-6d43-49c2-9aa8-be8192bef4ef",
                                "sense_id": "61f65924-4309-33e2-8b6c-9e2459270058",
                                "text": "„Er war noch keine fünf Minuten in der Stadt, gerade erst aus dem Bus aus Hermosillo ausgestiegen, da ging es mit dem ersten Einschüchterungsversuch los.“"
                            },
                            {
                                "example_id": "9b807486-8660-400f-b8c2-698557969616",
                                "sense_id": "61f65924-4309-33e2-8b6c-9e2459270058",
                                "text": "„Weitere Kostenpunkte waren die Aufwendungen für repräsentative Zwecke, wie etwa der Palas aus Tausendundeiner Nacht, den Amado in Hermosillo im Bundesstaat Sonora kaufte.“"
                            }
                        ],
