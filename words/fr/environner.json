                },
                {
                    "sense_id": "a3006898-567e-31ff-8f99-1cfba06578c5",
                    "sense_definition": "Se trouver ou être disposé autour d'une personne ou d'une chose, au propre ou au figuré.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "proximite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur aimait <w>environner</w> son bureau de livres rares et de vieux manuscrits."
                        },
                        {
                            "text": "Dès son arrivée au pouvoir, le ministre fut <w>environné</w> de conseillers fidèles."
