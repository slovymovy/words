                    "sense_definition": "Vorm van het woord 'iets' wanneer het samen met een voorzetsel wordt gebruikt (voornaamwoordelijk bijwoord).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pronominal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kan ik je misschien <w>ergens</w> mee helpen?",
                            "target_lang_translations": {
                                "en": "Can I perhaps help you with <w>something</w>?",
                                "ru": "Могу я тебе <w>чем-нибудь</w> помочь?",
                                "de": "Kann ich dir vielleicht bei <w>etwas</w> helfen?",
                                "it": "Posso aiutarti con <w>qualcosa</w>?",
                                "pl": "Czy mogę ci może w <w>czymś</w> pomóc?",
                                "fr": "Est-ce que je peux t'aider avec <w>quelque chose</w> ?",
                                "cs": "Můžu ti snad <w>něčím</w> pomoci?",
                                "tr": "Sana <w>bir şey</w> konusunda yardım edebilir miyim?",
                                "es": "¿Puedo ayudarte con <w>algo</w>?",
                                "zh": "我能<w>在什么</w>方面帮你吗？"
                            }
                        },
                        {
                            "text": "Hij is <w>ergens</w> heel erg bang voor.",
                            "target_lang_translations": {
                                "en": "He is very afraid of <w>something</w>.",
                                "ru": "Он <w>чего-то</w> очень сильно боится.",
                                "de": "Er hat vor <w>etwas</w> sehr große Angst.",
                                "it": "Ha molta paura di <w>qualcosa</w>.",
                                "pl": "Bardzo się czegoś boi, <w>czegoś</w> konkretnego.",
                                "fr": "Il a très peur de <w>quelque chose</w>.",
                                "cs": "Má z <w>něčeho</w> velký strach.",
                                "tr": "O, <w>bir şeyden</w> çok korkuyor.",
                                "es": "Él tiene mucho miedo de <w>algo</w>.",
                                "zh": "他非常害怕<w>某样</w>东西。"
                            }
                        }
