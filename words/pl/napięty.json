                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Łuk został mocno <w>napięty</w> przez doświadczonego myśliwego tuż przed strzałem.",
                            "target_lang_translations": {
                                "fr": "L'arc a été fortement <w>bandé</w> par le chasseur expérimenté juste avant le tir."
                            }
