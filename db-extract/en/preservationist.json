                        "translation_id": "2679262c-ac9f-4fde-84c2-3bc7b26ac52e",
                        "source_entry_id": "4b56b0aa-da72-3026-996d-08a47950b40e",
                        "source_sense_id": "04f7f256-23fd-3c70-8928-5692c9c4b4d6",
