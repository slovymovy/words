                },
                {
                    "sense_id": "f493d29d-1048-337c-9635-e66f27da01f8",
                    "sense_definition": "Secondary in importance, rank, or standing; minor or subordinate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>petty</w> officer was responsible for maintaining discipline among the crew on the deck.",
                            "target_lang_translations": {
                                "ru": "<w>Старшина</w> отвечал за поддержание дисциплины среди команды на палубе.",
                                "cs": "<w>Poddůstojník</w> byl zodpovědný za udržování kázně mezi posádkou na palubě."
                            }
                        },
                        {
                            "text": "He acted like a <w>petty</w> tyrant, enforcing rules that made no sense to anyone else.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как <w>мелкий</w> тиран, навязывая правила, не имеющие смысла ни для кого другого.",
                                "cs": "Choval se jako <w>drobný</w> tyran a prosazoval pravidla, která nikomu jinému nedávala smysl."
                            }
                        }
