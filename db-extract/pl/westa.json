                "senses": [
                    {
                        "sense_id": "5bbe51ce-1f5d-3b9a-a01d-02d0d509a628",
                        "entry_id": "e3819301-180c-3c3d-9a4d-403ac93af5b0",
                        "glosses": [
                            "bogini ogniska domowego, świętego i wiecznego ognia, utożsamiana z grecką Hestią"
                        ],
                        "tags": [
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "e83d86e1-0f61-4602-b65d-6f7e7e0c446f",
                                "sense_id": "5bbe51ce-1f5d-3b9a-a01d-02d0d509a628",
                                "text": "Atrybutami Westy były: berło, patera, róg obfitości, osioł."
                            },
                            {
                                "example_id": "69a3dd52-11f2-4a35-8ea9-8add1b502a8a",
                                "sense_id": "5bbe51ce-1f5d-3b9a-a01d-02d0d509a628",
                                "text": "Przy modłach i ofiarach Westę wymieniano zawsze na ostatnim miejscu, a Janusa zawsze na pierwszym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bb0dc6a7-62ae-397c-9a9e-4b88d7654c83",
                        "entry_id": "e3819301-180c-3c3d-9a4d-403ac93af5b0",
                        "glosses": [
                            "planetoida o numerze katalogowym 4"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0181e56-9e0f-4d2f-9df6-b5f8c12f919f",
                                "sense_id": "bb0dc6a7-62ae-397c-9a9e-4b88d7654c83",
                                "text": "Westa porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
