                "senses": [
                    {
                        "sense_id": "562c0bae-3cd2-3af0-aaca-ab9fe37d6094",
                        "entry_id": "b7fed52a-3531-3547-8623-2e3b5371ef53",
                        "glosses": [
                            "Kolyma (a region of the Russian Far East)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6bd98d-5b2a-49aa-9025-49bbaa64f5d7",
                                "sense_id": "562c0bae-3cd2-3af0-aaca-ab9fe37d6094",
                                "text": "С конца́ 30-х годо́в регио́ном-си́мволом ГУЛА́Га ста́ла Колыма́, а си́мволом ка́торжного труда́ — Дальстрой.",
                                "translation": "Since the late 1930's, Kolyma has been the symbolic region of the Gulag, and Dalstroy the symbol of hard labor.",
                                "english": "Since the late 1930's, Kolyma has been the symbolic region of the Gulag, and Dalstroy the symbol of hard labor."
                            }
                        ]
                    },
                    {
                        "sense_id": "0269ec4d-a790-37ca-9bbc-db1064385334",
                        "entry_id": "b7fed52a-3531-3547-8623-2e3b5371ef53",
                        "glosses": [
                            "Kolyma (a river in the Russian Far East)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c836ae59-dc56-4aa8-8dd5-aeba08b373b6",
                                "sense_id": "0269ec4d-a790-37ca-9bbc-db1064385334",
                                "text": "Все ручьи зазвенят, как высокие куранты Сибири.\n Вся Нева будет петь и по-прежнему впадать в Колыму.",
                                "translation": "All the streams gonna jingle like the high chimes of Siberia.\n The entire Neva gonna sing, and will still fall into Kolyma.",
                                "english": "All the streams gonna jingle like the high chimes of Siberia.\n The entire Neva gonna sing, and will still fall into Kolyma."
                            }
                        ]
                    }
                ],
