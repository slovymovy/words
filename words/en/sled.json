{
    "word_family": [
        "sledder",
        "sledding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40d6cae1-3a4c-35b3-85d2-0bd828d4e863",
                    "sense_definition": "A small vehicle with runners used for sliding down snow-covered hills for recreation.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle_on_runners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child zoomed down the hill on his <w>sled</w>.",
                            "target_lang_translations": {
                                "tr": "Çocuk <w>kızağıyla</w> tepeden aşağı hızla kaydı."
                            }
                        },
                        {
                            "text": "We took our <w>sled</w> to the park to go <w>sled</w> riding.",
                            "target_lang_translations": {
                                "tr": "Kızakla kaymaya gitmek için <w>kızağımızı</w> parka götürdük."
                            }
                        }
                    ],
                    "synonyms": [
                        "sledge",
                        "toboggan"
                    ],
                    "common_phrases": [
                        "go sledding"
                    ],
                    "target_lang_definitions": {
                        "tr": "Karla kaplı yamaçlardan eğlence amaçlı kaymak için kullanılan, kızaklı küçük araç."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kızak",
                                "target_lang_sense_clarification": "Genel eğlence amaçlı kullanılan kar kızağı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53152dcd-a9dc-318e-8dd6-aeb2649d8e00",
                    "sense_definition": "A vehicle on runners used to transport loads over snow or ice, often pulled by animals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle_on_runners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dogs pulled the heavy <w>sled</w> across the frozen lake.",
                            "target_lang_translations": {
                                "tr": "Köpekler ağır <w>kızağı</w> donmuş gölün üzerinden çekti."
                            }
                        },
                        {
                            "text": "Mushers use a <w>sled</w> to carry supplies through the arctic wilderness.",
                            "target_lang_translations": {
                                "tr": "Kızak sürücüleri, kutup bölgesindeki vahşi doğada erzak taşımak için <w>kızak</w> kullanırlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "sledge"
                    ],
                    "common_phrases": [
                        "dog sled"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kar veya buz üzerinde yük taşımak için kullanılan, genellikle hayvanlar tarafından çekilen kızaklı araç."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kızak",
                                "target_lang_sense_clarification": "Yük taşımacılığında kullanılan araç."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58c2614f-afac-331c-956f-d8218e76add1",
                    "sense_definition": "A motorized vehicle designed for travel over snow.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_on_runners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They traveled across the snowy fields on a <w>sled</w>.",
                            "target_lang_translations": {
                                "tr": "Karlı arazilerde <w>kar motoruyla</w> seyahat ettiler."
                            }
                        },
                        {
                            "text": "The rescue team arrived quickly on a motorized <w>sled</w>.",
                            "target_lang_translations": {
                                "tr": "Kurtarma ekibi motorlu bir <w>kızakla</w> hızla olay yerine ulaştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "snowmobile"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kar üzerinde seyahat etmek için tasarlanmış motorlu araç."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kar motoru",
                                "target_lang_sense_clarification": "Motorlu kar aracı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f52dea9-e76c-3061-ad8c-12c4c375e0c9",
                    "sense_definition": "A large, heavy, and often older automobile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drove that big old <w>sled</w> down the highway with ease.",
                            "target_lang_translations": {
                                "tr": "O koca eski <w>arabayı</w> otobanda rahatça sürdü."
                            }
                        },
                        {
                            "text": "That heavy <w>sled</w> was difficult to park in the city.",
                            "target_lang_translations": {
                                "tr": "O ağır <w>arabayı</w> şehir içinde park etmek zordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "land yacht"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used to describe a large, heavy car."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Büyük, ağır ve genellikle eski model otomobil (argo)."
                    },
                    "translations": {
                        "tr": []
                    }
                },
                {
                    "sense_id": "f3764246-f33c-3485-b818-b1b6b6ea754f",
                    "sense_definition": "An acronym for a single large expensive disk in computing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server architecture relies on a <w>SLED</w> for data storage.",
                            "target_lang_translations": {
                                "tr": "Sunucu mimarisi, veri depolama için bir <w>SLED</w> sistemine dayanır."
                            }
                        },
                        {
                            "text": "Engineers discussed the reliability of the <w>SLED</w> configuration.",
                            "target_lang_translations": {
                                "tr": "Mühendisler <w>SLED</w> yapılandırmasının güvenilirliğini tartıştılar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgi işlemde tek bir büyük pahalı disk için kullanılan kısaltma."
                    },
                    "translations": {
                        "tr": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ffaf955-4b65-3259-b5a3-c2a44448e46d",
                    "sense_definition": "To ride on a sled.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We love to <w>sled</w> down the hill after a fresh snowfall.",
                            "target_lang_translations": {
                                "tr": "Taze kar yağışından sonra tepeden aşağı <w>kızakla kaymaya</w> bayılırız."
                            }
                        },
                        {
                            "text": "The children <w>sled</w> all afternoon until it got dark.",
                            "target_lang_translations": {
                                "tr": "Çocuklar hava kararana kadar tüm öğleden sonra <w>kızakla kaydılar</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go sled"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kızakla kaymak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kızakla kaymak",
                                "target_lang_sense_clarification": "Kızak kullanarak eğlence amaçlı kayma eylemi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "097db654-5882-3812-bc49-c61d17d6c4d9",
                    "sense_definition": "To transport something using a sled.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>sled</w> the firewood across the frozen yard.",
                            "target_lang_translations": {
                                "tr": "Odunları donmuş bahçenin karşısına <w>kızakla taşımak</w> zorunda kaldılar."
                            }
                        },
                        {
                            "text": "The explorers <w>sled</w> their equipment to the base camp.",
                            "target_lang_translations": {
                                "tr": "Kaşifler ekipmanlarını ana kampa <w>kızakla taşıdılar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "transport"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi kızak kullanarak taşımak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kızakla taşımak",
                                "target_lang_sense_clarification": "Kızak aracılığıyla nakliye yapmak."
                            }
                        ]
                    }
                }
            ]
        },
