                "senses": [
                    {
                        "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                        "entry_id": "785e9f21-ea43-3755-b3ec-608cbb666984",
                        "glosses": [
                            "Person, Organisation oder Land, die/das der Umwelt schadet"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "8fbb67a8-8c9c-485a-ad01-4c6f2b62994d",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "Die Fahrerin, die alleine im großen SUV sitzt, ist eine Umweltsau."
                            },
                            {
                                "example_id": "7eec1b0f-c1c8-481c-8f41-84e80d2924c3",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "Die Manager oder Politiker, die meinen, sie müssten um den Erdball jetten, sind Umweltsäue."
                            },
                            {
                                "example_id": "c58d2607-38be-439d-8a6e-def4ce2683ed",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "„Dann stelle ich mir vor, wie sich diese Ski fahrende Umweltsau in seinem Urlaub zwei Wochen lang schlaflos im Bett wälzt, weil ihn sein Gewissen plagt.“"
                            },
                            {
                                "example_id": "75087d8d-9692-4de9-816a-e3fc3830184f",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "[Schlagzeile:] „Wir sind alle Umweltsäue“"
                            },
                            {
                                "example_id": "1cc242de-8466-4a14-b924-56feaac70579",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "[Schlagzeile:] „Luftfahrt: Die subventionierte Umweltsau“"
                            },
                            {
                                "example_id": "467c34b3-08e7-4bbc-867a-bd5f1e833d03",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "„Wer ist die größere \"Umweltsau\"? Alte Menschen machen Urlaub auf dem Kreuzfahrtschiff und essen Fleisch, kochen aber gleichzeitig das Obst aus dem Garten ein und flicken Kleider. Junge Menschen leben vegan und demonstrieren freitags, übers Wochenende aber fliegen sie nach Barcelona und streamen außerdem stundenlang im Internet.“"
                            },
                            {
                                "example_id": "5c80991a-2062-444c-a63a-2822a2942b13",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "„Die USA unter der Bush-Regierung weigern sich als eine der wenigen Staaten, das Kyoto-Protokoll zu ratifizieren, und pusten als Umweltsau ersten Ranges rekordverdächtige Mengen Kohlendioxid in die Luft.“"
                            },
                            {
                                "example_id": "8b780d5f-2abe-499b-ab83-5d57b6e3e1bb",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "„Ein schrulliger Brite tritt [Anmerkung: in der Fernsehshow] auf, der mal von Sheffield nach Essex reisen musste und statt des Zuges lieber fürs gleiche Geld die Billigfliegerroute über Berlin nahm […]. »Sie sind schon eine Umweltsau, gell?« fragt Jauch den Briten.“"
                            },
                            {
                                "example_id": "29f28666-8523-4c22-a1cd-73ce78eb4fc7",
                                "sense_id": "591d9b50-cb1b-3577-bf4c-dafaba1f3d6c",
                                "text": "„Die größte Umweltsau ist die Natur selber: Aus natürlichen Ölquellen fließen jedes Jahr über 170 Millionen Liter ins Meer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
