                    {
                        "translation_id": "278c34d0-eb09-479f-9def-dceb6928bfc8",
                        "source_entry_id": "5feb2985-cf05-389b-99ba-a6837c3b09f6",
                        "source_sense_id": "cb5b9933-6445-3fe3-a7fb-914634e13516",
