                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "10937d4e-b9c4-46ab-bea0-c9fc2245508d",
                        "entry_id": "e265bbb4-ae1a-3af6-9b70-437761499586",
                        "tags": [
