                    {
                        "translation_id": "81ecfd5c-43cd-4754-9c85-923a12709a8f",
                        "source_entry_id": "87332dd6-f05c-370a-8629-0eeddc1f7e34",
                        "source_sense_id": "b9981378-ec87-34d5-b71c-9926de196b8d",
                        "target_lang_word": "peerless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peerless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                        "entry_id": "3f54d836-1f32-3114-8fab-82e0a08c031e",
                                        "glosses": [
                                            "Without peer or equal; unparalleled, nonpareil. Of the highest quality, best."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3260f6-d254-4592-a95f-30dc362a2654",
                                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                                "text": "Let's after him, / Whoſe care is gone before, to bid vs welcome: / It is a peerleſſe Kinſman."
                                            },
                                            {
                                                "example_id": "c8251950-b247-4b74-9490-2cd1b796badb",
                                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                                "text": "Having now seen himself mistaken in supposing Elfride to be peerless, nothing on earth could make him believe she was not so very bad after all."
                                            },
                                            {
                                                "example_id": "28db17b0-484b-468b-838c-c090587227cf",
                                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                                "text": "After wearying oneself with the acres of stuffy, sappy, expressionless babies that populate the canvases of the Old Masters in Italy, it is refreshing to stand before this peerless child and feel that thrill which tells you you are at last in the presence of the real thing."
                                            },
                                            {
                                                "example_id": "98644a60-c92a-4018-8042-306dc2f51525",
                                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                                "text": "Telegram! Malachi Mulligan, The Ship, lower Abbey street. O, you peerless mummer! O, you priestified Kinchite!"
                                            },
                                            {
                                                "example_id": "b8df0f0f-7a6f-4fee-8b67-ade9d01ab240",
                                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                                "text": "“Would you go into the dragon's lair, my peerless Wiglaf?”"
                                            },
                                            {
                                                "example_id": "b462ad73-d281-41d5-8c33-01c60f498b91",
                                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                                "text": "Foden has also grown into this World Cup, having scored against Wales and creating two goals here. England's midfield and attack is taking shape with perfect timing for what will be the sternest of tests against France and the peerless Mbappe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
