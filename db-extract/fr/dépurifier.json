                "senses": [
                    {
                        "sense_id": "2f5bd381-29c1-304d-99f7-4cadff8bd950",
                        "entry_id": "7eaf18b3-9acd-339b-a1c8-d53d974e09be",
                        "glosses": [
                            "Rendre moins pur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "398554aa-4b43-4572-922b-1d08bbf01b60",
                                "sense_id": "2f5bd381-29c1-304d-99f7-4cadff8bd950",
                                "text": "La combustion d’hydrogène dans des centrales thermiques n’est pas polluante et refabrique de l’eau pure que l’on peut réinjecter dans l’océan ou même « dépurifier » pour la rendre buvable."
                            },
                            {
                                "example_id": "1d7cc56a-53fe-4e43-b460-acb3b476a728",
                                "sense_id": "2f5bd381-29c1-304d-99f7-4cadff8bd950",
                                "text": "Heureux dans son oasis de repos il n’aime guère, et je le comprends, descendre en ville et encore moins venir se dépurifier dans la vie tumultueuse et polluée de Paris."
                            }
                        ]
                    }
