                                    {
                                        "sense_id": "e2508687-51c0-3cca-b046-d4220e9d72b1",
                                        "entry_id": "f5ce5f83-613c-39fa-8b05-02413e437e0c",
                                        "glosses": [
                                            "One of the women following Jesus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df613f46-8251-4055-b105-f8e3fe47972f",
                                                "sense_id": "e2508687-51c0-3cca-b046-d4220e9d72b1",
                                                "text": "[A]nd the twelve were with him, and certain women, which had been healed of evil spirits, Mary called Magdalene, out of whom went seven devils, and Joanna wife of Chuza Herod's steward, and Susanna, and many others, which ministered unto him of their substance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecbe8828-056f-309a-96eb-8b8445438e6e",
                                        "entry_id": "f5ce5f83-613c-39fa-8b05-02413e437e0c",
                                        "glosses": [
                                            "Obsolete spelling of Johanna (“the island of Anjouan”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7a3cb47-6254-476a-910e-45c76ef3dbfa",
                        "source_entry_id": "fa53b88d-a96c-3b43-aa4e-703e77a10d75",
                        "source_sense_id": "cfee586b-5abf-38cb-ac02-bf2abdda30f1",
                        "target_lang_word": "Johanna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Johanna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0371f5-d18a-3ca9-b8d7-41d21274528c",
                                        "entry_id": "78bc61db-36e1-3e8a-a91e-f89506640404",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3335391-1484-4d41-8c3b-87a6d27c6fc0",
                                                "sense_id": "ea0371f5-d18a-3ca9-b8d7-41d21274528c",
                                                "text": "Es ist lange her, dass Johanna bei uns zu Besuch war."
                                            },
                                            {
                                                "example_id": "bdc98732-90ff-4b15-b655-2e49536d7477",
                                                "sense_id": "ea0371f5-d18a-3ca9-b8d7-41d21274528c",
                                                "text": "Johanna und Ortwin haben sieben Kinder."
                                            },
                                            {
                                                "example_id": "d3ca2ddd-24a4-48da-8873-3ddfc240e618",
                                                "sense_id": "ea0371f5-d18a-3ca9-b8d7-41d21274528c",
                                                "text": "Johanna spielt gern."
                                            },
                                            {
                                                "example_id": "d5a86278-3c9b-49f3-a915-427e91936ea3",
                                                "sense_id": "ea0371f5-d18a-3ca9-b8d7-41d21274528c",
                                                "text": "Johanna Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "2c4296e6-aed2-4808-8692-9436b53b3c8c",
                                                "sense_id": "ea0371f5-d18a-3ca9-b8d7-41d21274528c",
                                                "text": "Kennen sie den Vornamen Johanna?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbf6cb8b-4a68-48fc-892c-ab5541b38703",
                        "source_entry_id": "fa53b88d-a96c-3b43-aa4e-703e77a10d75",
                        "source_sense_id": "cfee586b-5abf-38cb-ac02-bf2abdda30f1",
                        "target_lang_word": "Żanna",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a00eab39-4028-4f04-a9bd-d6624cfd0268",
                        "source_entry_id": "fa53b88d-a96c-3b43-aa4e-703e77a10d75",
                        "source_sense_id": "cfee586b-5abf-38cb-ac02-bf2abdda30f1",
                        "target_lang_word": "Jeanne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jeanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e2a9f2-6b16-3112-bd48-17691bf6ea1b",
                                        "entry_id": "a9730283-a56a-34ad-84d6-71deb5a2f1ed",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5e4f90-17dd-4431-a772-c51bb2c34fc3",
                                                "sense_id": "b5e2a9f2-6b16-3112-bd48-17691bf6ea1b",
                                                "text": "Il aime Jeanne."
                                            },
                                            {
                                                "example_id": "c596a94b-d9e1-4161-aa60-c90396a2f00c",
                                                "sense_id": "b5e2a9f2-6b16-3112-bd48-17691bf6ea1b",
                                                "text": "Jeanne était au pain sec dans le cabinet noir,\nPour un crime quelconque, et, manquant au devoir,\nJ’allai voir la proscrite en pleine forfaiture,\nEt lui glissai dans l’ombre un pot de confiture\nContraire aux lois."
                                            },
                                            {
                                                "example_id": "800fbc78-ef1c-4502-8c25-4e01c1e8c2b2",
                                                "sense_id": "b5e2a9f2-6b16-3112-bd48-17691bf6ea1b",
                                                "text": "La petite Jeanne était venue passer la journée à la maison ; c’était à la fin de mai, pendant ce même printemps d’attente, et j’avais douze ans."
                                            },
                                            {
                                                "example_id": "5192dd1f-bd3d-44d4-a510-551d8a1b19c9",
                                                "sense_id": "b5e2a9f2-6b16-3112-bd48-17691bf6ea1b",
                                                "text": "Jeanne,\nSi la vie est un rêve\nQue l’amour relève\nTout contre vous Jeanne, au bois dormant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c0e173-f043-3448-a1be-53497e800009",
                                        "entry_id": "a9730283-a56a-34ad-84d6-71deb5a2f1ed",
                                        "glosses": [
                                            "Prénom de Jeanne d’Arc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56bef038-b72c-41db-abc6-d192f0338367",
                                                "sense_id": "f3c0e173-f043-3448-a1be-53497e800009",
                                                "text": "— Ainsi, tu songes à faire la guerre aux Anglais, Jeanne ? Quand tu auras trouvé le trésor, tu achèteras une grosse armée, et tu te mettras en campagne sur un beau cheval blanc, comme Jeanne d’autrefois, la belle Pastoure qui a délivré notre pays des habits rouges ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
