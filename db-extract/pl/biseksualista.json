                "senses": [
                    {
                        "sense_id": "74a9d7ce-2852-3ac2-b5c7-2e68c530436c",
                        "entry_id": "2cdd2a26-591f-3cde-939d-03d104d3c10f",
                        "glosses": [
                            "osoba odczuwająca pociąg seksualny do ludzi obydwu płci"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a168eb9d-de4c-417c-afcb-516c48ce8c41",
                                "sense_id": "74a9d7ce-2852-3ac2-b5c7-2e68c530436c",
                                "text": "Był to film o starszym homoseksualiście zakochanym w młodszym biseksualiście, który ma romans z kobietą - sytuacja ta nie była mi obca."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d0eb5b4-73cb-42e6-aaaf-66ace3bd9083",
                        "source_entry_id": "2cdd2a26-591f-3cde-939d-03d104d3c10f",
                        "source_sense_id": "74a9d7ce-2852-3ac2-b5c7-2e68c530436c",
                        "target_lang_word": "bisexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bisexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19cd3d41-6366-389b-85c1-e115ddd6f89d",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Sexually attracted to both same-gendered and different-gendered partners. (Compare pansexual.)"
                                        ],
                                        "tags": [
                                            "of humans or other animals"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258a62a1-2cf8-4d71-90e1-24ba388b1789",
                                                "sense_id": "19cd3d41-6366-389b-85c1-e115ddd6f89d",
                                                "text": "Skirt Club caters to bisexual or bicurious women. No men are allowed, but women with all levels of experience in same-sex sexuality, from bicurious to fully lesbian, are welcomed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92270223-bc19-343a-8e6e-acf283ea980e",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Having both male and female parts, characteristics, or functions.",
                                            "Of flowers: having both pollen and seeds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75a3eb04-f283-30ed-8930-ec403991aeb0",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Having both male and female parts, characteristics, or functions.",
                                            "Of sporophytes: having both male and female organs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a14c21bb-897f-3c05-8322-a690e2aaaafa",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Having both male and female parts, characteristics, or functions.",
                                            "Of gametophytes: producing both eggs and sperm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a366c06-192d-3ab1-bee7-1086d53fd39a",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Having both male and female parts, characteristics, or functions.",
                                            "Of fungi: producing both the \\\"female\\\" ascogonium and the \\\"male\\\" antheridium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9837ef7-4736-35dd-b90e-cb9ce63cc8a1",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Having both male and female parts, characteristics, or functions.",
                                            "Hermaphroditic/intersex, being both male and female, or alternating between being male and being female."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c88513d-e274-4e1f-8583-abd673e93367",
                                                "sense_id": "d9837ef7-4736-35dd-b90e-cb9ce63cc8a1",
                                                "text": "Midrash and Zohar present Adam as hermaphroditic or bisexual."
                                            },
                                            {
                                                "example_id": "f97a3097-3fe5-4ac6-8b05-f2cffe3b2274",
                                                "sense_id": "d9837ef7-4736-35dd-b90e-cb9ce63cc8a1",
                                                "text": "To say that Loki is bisexual means that he readily alternates between the male and female sexes, becoming female at will or as needed."
                                            },
                                            {
                                                "example_id": "0e05726d-b15f-4782-82a6-a5fff1ab4d31",
                                                "sense_id": "d9837ef7-4736-35dd-b90e-cb9ce63cc8a1",
                                                "text": "Among the arguments put forth for Ishtar's hermaphroditic or bisexual character is the practice of transvestism in religious rites associated with her (e.g. Harris 2000: 170; Groneberg 1986: 39)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae452032-5900-393f-b2dd-bb9da8483e23",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Having both male and female parts, characteristics, or functions.",
                                            "Androgynous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60e86699-356c-4f81-9aee-7814e77e39e3",
                                                "sense_id": "ae452032-5900-393f-b2dd-bb9da8483e23",
                                                "text": "The bisexual name, such as Marion and Carol (and Evelyn and Vivian in England), is frequently a source of annoyance and embarrassment to the letter writer, who, if he does not know his ambiguously named correspondent personally […]"
                                            },
                                            {
                                                "example_id": "c62d9428-45f2-4161-9c2e-6769a740d0c2",
                                                "sense_id": "ae452032-5900-393f-b2dd-bb9da8483e23",
                                                "text": "At the desk, he completed the registration card, signing his name Jean Cable and giving a New York address. He did not know for sure that he was being pursued, but if so, he knew his pursuers would check new registrations around the city. The bisexual name would give them one more obstacle […]"
                                            },
                                            {
                                                "example_id": "02c49565-f40f-4878-ae74-3a54963982c5",
                                                "sense_id": "ae452032-5900-393f-b2dd-bb9da8483e23",
                                                "text": "And although Stevens introduces Nanzia Nunzio as a woman, the inflections of the bisexual name and the symbolism implicit in the messenger's characteristics suggest that the \"contemplated spouse\" is something more than a woman."
                                            },
                                            {
                                                "example_id": "87590b1b-100a-45ea-90d5-b3094783af6a",
                                                "sense_id": "ae452032-5900-393f-b2dd-bb9da8483e23",
                                                "text": "Consider the identity play of the French artist who gave herself the bisexual name of Claude Cahun (1894–1954)."
                                            },
                                            {
                                                "example_id": "38a3879b-4d7b-4c4f-be5a-0b89d5672c0e",
                                                "sense_id": "ae452032-5900-393f-b2dd-bb9da8483e23",
                                                "text": "On August 16, in Mankato, Blue Earth County, Minnesota, Michael McConnell alone applied for a marriage license for himself and Baker, under his new adoptive name. The \"bisexual name of Pat […]\""
                                            },
                                            {
                                                "example_id": "4f554f13-9ba6-4910-ba58-13a2e913aac2",
                                                "sense_id": "ae452032-5900-393f-b2dd-bb9da8483e23",
                                                "text": "The Bionic Woman of the television serial of the seventies, though she wears ordinary dress most of the time, has the bisexual name of Jamie Summers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de97ee49-e0dc-33cf-85a5-cf2a9bb6e1ee",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Having two distinct sexes, male and female (as contrasted with unisexual or hermaphroditic)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdede1f-ef73-455c-be33-87496434feb9",
                                                "sense_id": "de97ee49-e0dc-33cf-85a5-cf2a9bb6e1ee",
                                                "text": "It is probable, therefore, that hermaphroditism must be regarded as a variation from an earlier condition in which the sexes were separate, and that the hermaphrodites which occasionally appear in normally bisexual species are produced by variations occurring sporadically in the same direction."
                                            },
                                            {
                                                "example_id": "7e6e3a4d-ae59-4880-87b9-ab8cd2f3b3ac",
                                                "sense_id": "de97ee49-e0dc-33cf-85a5-cf2a9bb6e1ee",
                                                "text": "We also know that bisexual species reproduce during a longer period than hermaphrodite species."
                                            },
                                            {
                                                "example_id": "193ac20e-1582-43e7-8912-1e31ac10185d",
                                                "sense_id": "de97ee49-e0dc-33cf-85a5-cf2a9bb6e1ee",
                                                "text": "The second line of inquiry has to do with the ultimate fate of unisexual species. Are they doomed to more rapid extinction than bisexual species? On the assumption that unisexual populations lack genetic variation, most theoretical studies […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9ef9ac2-5f4e-3f74-913c-5ee2e8ca0471",
                                        "entry_id": "000672c6-e4d6-3dc3-a5a1-a1d40ccfa691",
                                        "glosses": [
                                            "Involving two sexes (particularly with regard to reproduction; contrast parthenogenetic or asexual)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3e3a08-9aaa-4457-8fc6-04646c706079",
                                                "sense_id": "d9ef9ac2-5f4e-3f74-913c-5ee2e8ca0471",
                                                "text": "[…] where the parthenogenetic and bisexual generations do not differ in any character except their manner of reproduction[…]"
                                            },
                                            {
                                                "example_id": "8645ca70-6f98-43c2-9afb-e5fa0a82011a",
                                                "sense_id": "d9ef9ac2-5f4e-3f74-913c-5ee2e8ca0471",
                                                "text": "But it does not agree with our idea of orthodox sexual reproduction, since many generations may pass without the appearance of males. The reproductive products at such times are purely feminine—that is, eggs which develop without having been fertilized by a male cell, the spermatozoan. We may distinguish this form of reproduction from sexual reproduction, in the restricted sense, or bisexual reproduction, as unisexual or parthenogenetic reproduction."
                                            },
                                            {
                                                "example_id": "0dd43c5c-f5ec-4397-9947-1e36757e753c",
                                                "sense_id": "d9ef9ac2-5f4e-3f74-913c-5ee2e8ca0471",
                                                "text": "[W]e began by noting the social advantages of bisexual reproduction, showing that bisexual beings are free and equal, and thus capable of entire community and fraternity. Thereafter, we treated the subject of bisexual reproduction more particularly: describing the ovatestis and its functions, showing how separate ovaries and testes were developed from the original ovatestes, and indicating the results of such differentiation, […]. Next, we considered asexual versus sexual reproduction: […]"
