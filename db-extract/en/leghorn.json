                        "entry_id": "3610f4c9-1cd6-347f-ac40-c6e155ce2bb2",
                        "glosses": [
                            "A type of dried plaited wheat straw fabric."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e853ae6f-6ba1-3edf-8f30-bd7be44924c3",
                        "entry_id": "3610f4c9-1cd6-347f-ac40-c6e155ce2bb2",
                        "glosses": [
                            "A type of hat made from Leghorn straw."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "584056a3-9689-4480-8e4e-c3eff434fae0",
                                "sense_id": "e853ae6f-6ba1-3edf-8f30-bd7be44924c3",
                                "text": "When straw-hats had become unfashionable, Mrs. Nollekens hinted to old White, the hatter […], that possibly he could accommodate her with a Leghorn hat at a moderate rate."
                            },
                            {
                                "example_id": "ac34454a-6f02-47bb-a44e-6dcb939dcf86",
                                "sense_id": "e853ae6f-6ba1-3edf-8f30-bd7be44924c3",
                                "text": "The difference between the two classifications has always been intended to cover unblocked and untrimmed hat bodies, such as panamas, bangkoks, and leghorns, and other hats which are woven by the natives in South American and oriental countries where they are produced."
                            }
                        ]
                    },
                    {
                        "sense_id": "223c6fe5-7039-3dc9-885a-46088fd9112e",
                        "entry_id": "3610f4c9-1cd6-347f-ac40-c6e155ce2bb2",
                        "glosses": [
                            "A small white chicken of a hardy breed."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
