                    {
                        "sense_id": "481309b2-03ac-3b5f-9f48-bc5616c34b63",
                        "entry_id": "190d0f18-775a-3b0f-9ad6-0bcf9d547085",
                        "glosses": [
                            "Zone de transition entre les aires urbaine et rurale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daba12a5-5e80-447b-90d3-15424a2dd265",
                                "sense_id": "481309b2-03ac-3b5f-9f48-bc5616c34b63",
                                "text": "Les milieux transitionnels, ou le périurbain au sens large, ne constitueraient pas simplement un front périurbain en phase d’urbanisation, mais un espace appelé à demeurer hétérogène et complexe."
                            },
                            {
                                "example_id": "124b2c90-d6a1-49f2-996b-e0e19f38345e",
                                "sense_id": "481309b2-03ac-3b5f-9f48-bc5616c34b63",
                                "text": "Même les classements distinguant le périurbain de la frange urbaine, de la zone d’exode rural et du rural profond n’arrivent pas à décrire précisément la diversité des milieux transitionnels"
                            }
                        ]
                    }
