{
    "word_family": [
        "chiseler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "601d2165-6623-3568-a1b3-221149c6f718",
                    "sense_definition": "A hand or machine tool with a sharp cutting edge at the end, used for shaping or cutting wood, stone, or metal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter picked up a sharp <w>chisel</w> to smooth the edge of the board.",
                            "target_lang_translations": {
                                "it": "Il falegname prese uno <w>scalpello</w> affilato per levigare il bordo dell'asse."
                            }
                        },
                        {
                            "text": "He used a hammer and <w>chisel</w> to carve a small figure from the stone.",
                            "target_lang_translations": {
                                "it": "Ha usato martello e <w>scalpello</w> per ricavare una piccola figura dalla pietra."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hammer and chisel",
                        "cold chisel",
                        "wood chisel"
                    ],
                    "target_lang_definitions": {
                        "it": "Attrezzo manuale o meccanico con un tagliente affilato all'estremità, usato per intagliare o tagliare legno, pietra o metallo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scalpello",
                                "target_lang_sense_clarification": "attrezzo per legno, pietra o muratura"
                            },
                            {
                                "target_lang_word": "cesello",
                                "target_lang_sense_clarification": "attrezzo fine per metallo o intagli di precisione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ee32000-3fc5-3275-9674-74976f568531",
                    "sense_definition": "A cutting component or bit in a larger tool or machine that functions like a chisel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker replaced the worn <w>chisel</w> on the mechanical drill before resuming.",
                            "target_lang_translations": {
                                "it": "L'operaio ha sostituito lo <w>scalpello</w> usurato sul trapano meccanico prima di riprendere."
                            }
                        },
                        {
                            "text": "A specialized <w>chisel</w> cuts through the tough soil ahead of the plowshare.",
                            "target_lang_translations": {
                                "it": "Uno <w>scalpello</w> speciale fende il terreno duro davanti al vomere."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Elemento di taglio o punta di una macchina o attrezzo più grande che funziona come uno scalpello."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scalpello",
                                "target_lang_sense_clarification": "punta o lama di macchina"
                            },
                            {
                                "target_lang_word": "punta",
                                "target_lang_sense_clarification": "utensile da perforazione o fresatura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc663dc9-837e-37b5-88cc-95d7b92906c9",
                    "sense_definition": "Coarse gravel or pebbles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "granules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spread loose <w>chisel</w> along the muddy footpath behind the old barn.",
                            "target_lang_translations": {
                                "it": "Hanno sparso della <w>ghiaia grossa</w> lungo il sentiero fangoso dietro il vecchio fienile."
                            }
                        },
                        {
                            "text": "The riverbed was lined with coarse <w>chisel</w> that made walking difficult.",
                            "target_lang_translations": {
                                "it": "Il letto del fiume era ricoperto di <w>ciottoli grossolani</w> che rendevano difficile camminare."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in traditional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Ghiaia grossolana o ciottoli."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ghiaia grossa",
                                "target_lang_sense_clarification": "ciottoli o pietrisco"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e94c2463-6ec1-341d-94b0-10bd424e8090",
                    "sense_definition": "Coarse flour or bran.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "granules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miller separated the fine flour from the rough <w>chisel</w>.",
                            "target_lang_translations": {
                                "it": "Il mugnaio separava la farina fine dal <w>cruschello</w> grezzo."
                            }
                        },
                        {
                            "text": "A scoop of <w>chisel</w> was added to the feed for the livestock.",
                            "target_lang_translations": {
                                "it": "È stata aggiunta una paletta di <w>crusca</w> al mangime per il bestiame."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Farina grossolana o crusca."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "cruschello",
                                "target_lang_sense_clarification": "crusca o farina grezza"
                            },
                            {
                                "target_lang_word": "crusca",
                                "target_lang_sense_clarification": "residuo della macinazione"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5076760-657e-3a4d-bf66-97fe1c35d03d",
                    "sense_definition": "To cut, shape, or carve wood, stone, or other hard materials using a chisel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cut_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sculptor carefully <w>chiselled</w> a delicate shape out of the marble block.",
                            "target_lang_translations": {
                                "it": "Lo scultore ha <w>scolpito</w> con cura una forma delicata dal blocco di marmo."
                            }
                        },
                        {
                            "text": "She watched him <w>chisel</w> decorative patterns along the wooden frame.",
                            "target_lang_translations": {
                                "it": "Lo guardava <w>intagliare</w> motivi decorativi lungo la cornice di legno."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chisel out",
                        "chisel away"
                    ],
                    "target_lang_definitions": {
                        "it": "Tagliare, modellare o scolpire legno, pietra o altri materiali duri usando uno scalpello o un cesello."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scalpellare",
                                "target_lang_sense_clarification": "lavorare con lo scalpello"
                            },
                            {
                                "target_lang_word": "cesellare",
                                "target_lang_sense_clarification": "incidere o scolpire di precisione"
                            },
                            {
                                "target_lang_word": "scolpire",
                                "target_lang_sense_clarification": "modellare materiale duro"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a27361eb-683c-3bc1-8866-2d738c6fccef",
                    "sense_definition": "To erode, weaken, or reduce something gradually over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Opponents continue to <w>chisel</w> away at the new healthcare regulations.",
                            "target_lang_translations": {
                                "it": "Gli oppositori continuano a <w>sgretolare</w> le nuove normative sanitarie."
                            }
                        },
                        {
                            "text": "Rising inflation threatened to <w>chisel</w> away their hard-earned savings.",
                            "target_lang_translations": {
                                "it": "L'aumento dell'inflazione minacciava di <w>erodere</w> i loro sudati risparmi."
                            }
                        }
                    ],
                    "synonyms": [
                        "chip away"
                    ],
                    "common_phrases": [
                        "chisel away at"
                    ],
                    "target_lang_definitions": {
                        "it": "Erodere, indebolire o ridurre qualcosa gradualmente nel tempo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "erodere",
                                "target_lang_sense_clarification": "consumare poco a poco"
                            },
                            {
                                "target_lang_word": "sgretolare",
                                "target_lang_sense_clarification": "ridurre o indebolire gradualmente"
                            },
                            {
                                "target_lang_word": "intaccare",
                                "target_lang_sense_clarification": "consumare progressivamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "501bd97b-9e8c-3c11-8ab6-d26644b3172c",
                    "sense_definition": "To cheat, swindle, or trick someone out of money or possessions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deceive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest salesman tried to <w>chisel</w> the elderly couple out of their money.",
                            "target_lang_translations": {
                                "it": "Il venditore disonesto ha cercato di <w>spillare</w> denaro all'anziana coppia."
                            }
                        },
                        {
                            "text": "He managed to <w>chisel</w> a few extra dollars by exaggerating the bill.",
                            "target_lang_translations": {
                                "it": "È riuscito a <w>fregare</w> qualche dollaro in più gonfiando il conto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chisel out of"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal or slang use meaning to cheat"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Truffare, imbrogliare o sottrarre denaro o beni con l'inganno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spillare",
                                "target_lang_sense_clarification": "estorcere o sottrarre denaro con astuzia"
                            },
                            {
                                "target_lang_word": "fregare",
                                "target_lang_sense_clarification": "truffare o raggirare (informale)"
                            },
                            {
                                "target_lang_word": "truffare",
                                "target_lang_sense_clarification": "ingannare per denaro"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8407c3c1-04ed-399a-b05a-6e744851ae96",
                    "sense_definition": "To intrude or push one's way into a situation or place uninvited.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intrude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>chisel</w> in on our private conversation without an invitation.",
                            "target_lang_translations": {
                                "it": "Ha cercato di <w>intromettersi</w> nella nostra conversazione privata senza essere invitato."
                            }
                        },
                        {
                            "text": "Several gatecrashers attempted to <w>chisel</w> their way into the exclusive event.",
                            "target_lang_translations": {
                                "it": "Diversi imbucati hanno tentato di <w>farsi strada</w> all'evento esclusivo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chisel in on"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Slang for barging in"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Intromettersi o imbucarsi in una situazione o luogo senza essere invitati."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "intromettersi",
                                "target_lang_sense_clarification": "infilarsi in questioni altrui non invitati"
                            },
                            {
                                "target_lang_word": "imbucarsi",
                                "target_lang_sense_clarification": "infilarsi senza invito (colloquiale)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}