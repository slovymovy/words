                    {
                        "sense_id": "1d6fedd7-2cf7-3914-a5f9-bb3bc327340e",
                        "entry_id": "a4d9e276-76b0-377c-9c43-e20a6ffd554c",
                        "glosses": [
                            "de achterkant van een blad papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd794ea-5f14-4d38-b578-ee750a9259f2",
                                "sense_id": "1d6fedd7-2cf7-3914-a5f9-bb3bc327340e",
                                "text": "Als er op de achterkant van een blad papier nog tekst staat, staat er meestal \"Zie ommezijde\" op de voorkant van het blad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eff33c1f-4d47-4675-a07e-6b277aca9f31",
                        "source_entry_id": "a4d9e276-76b0-377c-9c43-e20a6ffd554c",
                        "source_sense_id": "1d6fedd7-2cf7-3914-a5f9-bb3bc327340e",
                        "source_sense_description": "de achterkant van een blad papier",
                        "target_lang_word": "Rückseite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückseite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                        "entry_id": "7c32f724-fc7d-3965-9cfa-05bb25ff6d57",
                                        "glosses": [
                                            "die hintere Seite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849156e4-7535-4790-89a9-ae8d1272adbc",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "Die Legende zu dieser Karte finden Sie auf ihrer Rückseite."
                                            },
                                            {
                                                "example_id": "5a3331c3-0997-44c3-8ea9-a299a1074111",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "Die Rückseite der 1-Euro-Münze zeigt den Bundesadler."
                                            },
                                            {
                                                "example_id": "a0d5268e-c958-4fbe-a12c-789d35bb6271",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "Die Fahrradständer befinden sich an der Rückseite des Hauses."
                                            },
                                            {
                                                "example_id": "5aef3b62-14d7-4ab0-bb30-93809f16abab",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "An der Rückseite einer Kaltfront dringt kühle Meeresluft in das Sendegebiet vor."
                                            },
                                            {
                                                "example_id": "52ccc7e0-4022-47ab-afd5-2e9a8516d5d4",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "Der Satellit DSCOVR hat faszinierende Bilder von der Rückseite des Mondes zur Erde gefunkt."
                                            },
                                            {
                                                "example_id": "f42bc4c8-330a-45b1-8360-3e0bd01e07c2",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "„Sie erkannte ihn von dem Bild auf der Rückseite seines neuesten Buches, das auf meinem Nachttisch lag, und sie wusste, dass ich ihn kannte.“"
                                            },
                                            {
                                                "example_id": "ecec7d12-d255-4b3c-982e-d2d139154835",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "„Fabiola kramte einen Stift aus ihrer Handtasche und schrieb die Formel auf die Rückseite eines Kassenzettels.“"
                                            },
                                            {
                                                "example_id": "4892af58-6551-446e-a742-b40a32bb5a8d",
                                                "sense_id": "23486129-433a-36c6-a150-8ae59b42732f",
                                                "text": "„Der große Raum diente der Unterhaltung, und die kleinen Zimmer auf der Rückseite waren für ihre Kunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c27daab4-662c-45a7-95c6-6f46dae3a4a5",
                        "source_entry_id": "a4d9e276-76b0-377c-9c43-e20a6ffd554c",
