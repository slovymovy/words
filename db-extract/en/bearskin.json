                "senses": [
                    {
                        "sense_id": "7133bf0b-b79b-375d-8cfa-a5e1d805e9ee",
                        "entry_id": "2272fa12-0ea0-33b2-a23f-c6c5e63066a2",
                        "glosses": [
                            "The pelt of a bear, especially when used as a rug."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc1493d4-03d4-47a6-9bc8-be6f0f0bae3f",
                                "sense_id": "7133bf0b-b79b-375d-8cfa-a5e1d805e9ee",
                                "text": "The farmer flayed him as he had the bear, and so he had both bear-skin and fox-skin."
                            },
                            {
                                "example_id": "ec219e09-49ca-4f4f-88aa-19c3b4346e37",
                                "sense_id": "7133bf0b-b79b-375d-8cfa-a5e1d805e9ee",
                                "text": "In the midst stalked the King, his great limbs muffled, like Goldry’s, in a cloak: and it was of black silk lined with black bearskin, and ornamented with crabs worked in diamonds."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fb39e79-7f18-3f8a-8552-23394b3c8765",
                        "entry_id": "2272fa12-0ea0-33b2-a23f-c6c5e63066a2",
                        "glosses": [
                            "A tall ceremonial hat worn by members of some British regiments for ceremonial occasions; a busby."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
