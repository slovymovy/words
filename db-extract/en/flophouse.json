                    {
                        "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                        "entry_id": "85fb3bab-9a21-378c-81a7-0e533529bcf8",
                        "glosses": [
                            "A cheap hotel or boarding house where many people sleep in large rooms."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "efa3f270-655a-474e-b8cb-868dfaa739f3",
                                "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                                "text": "In one of [Cincinnati’s] slum districts stands the Silver Moon, a “flop house” (i.e., a house where the occupants are “flopped” out of their hanging bunks by letting down the ropes)."
                            },
                            {
                                "example_id": "04301a4b-1dc9-40aa-9315-45ebbc6e70ee",
                                "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                                "text": "We even visited some drunken seamen in a flophouse on Mission Street that she knew; they offered us whisky."
                            },
                            {
                                "example_id": "fa39bcae-de2f-4007-9094-f7aa0296ec7e",
                                "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                                "text": "He was born out back of a twopenny flophouse in what the wags called “The Holy Land” […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
