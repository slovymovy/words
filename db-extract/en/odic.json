                "senses": [
                    {
                        "sense_id": "3ebc220b-9352-3f69-817b-979d294dc306",
                        "entry_id": "db1236b7-fb6b-3def-8b70-17425dad1dae",
                        "glosses": [
                            "Of or pertaining to odes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b6f46d2-7654-4af4-be78-ebe1b015770c",
                                "sense_id": "3ebc220b-9352-3f69-817b-979d294dc306",
                                "text": "The eighteenth century is generally lacking in great odic poetry."
                            },
                            {
                                "example_id": "7905731c-3f72-41ed-876a-8936d38c0733",
                                "sense_id": "3ebc220b-9352-3f69-817b-979d294dc306",
                                "text": "1964, Aleksandr Sergeevich Pushkin, Vladimir Nabokov (translator and author of comments), Eugene Onegin: A Novel in Verse: Commentary,\nBoth the French odic stanza and the EO stanza are related to the sonnet."
                            },
                            {
                                "example_id": "5ce1e0dc-04a0-4861-9545-255a57e89144",
                                "sense_id": "3ebc220b-9352-3f69-817b-979d294dc306",
                                "text": "Among all our Victorian poets none is or was so fitted for the writing of odic poems as Matthew Arnold."
                            },
                            {
                                "example_id": "1356c7d3-0a55-400c-a008-ba167cfcd680",
                                "sense_id": "3ebc220b-9352-3f69-817b-979d294dc306",
                                "text": "In the odic tradition, the poet's visionary authority deriving from God or the muses would invariably be juxtaposed alongside the power of the emperor or empress, and the imperial state."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c038ff14-c5b7-358e-9b52-e4f277d00a13",
