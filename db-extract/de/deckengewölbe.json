                            {
                                "target_word": "arch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10ddb145-f1ff-3af3-af28-ab796bb45324",
                                        "entry_id": "af9c9cc3-ac19-3669-97f4-6ebf137c11ab",
                                        "glosses": [
                                            "To form into an arch shape."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7810b629-7a9c-49ea-b20b-a1e1509ecdd5",
                                                "sense_id": "10ddb145-f1ff-3af3-af28-ab796bb45324",
                                                "text": "The cat arched its back."
                                            },
                                            {
                                                "example_id": "80a79443-7959-44fe-8247-f8520363d632",
                                                "sense_id": "10ddb145-f1ff-3af3-af28-ab796bb45324",
                                                "text": "GBR will either be letting operating contracts or running rail companies directly, depending on which party wins the next General Election. Whichever it is, you can be forgiven for arching an eyebrow at an infrastructure company being placed in overall control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c000fcee-a00d-3d5d-8bcc-f1773eaa560d",
                                        "entry_id": "af9c9cc3-ac19-3669-97f4-6ebf137c11ab",
                                        "glosses": [
                                            "To cover with an arch or arches."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                        "entry_id": "c51ea480-db4b-3cee-9523-226768de5e42",
                                        "glosses": [
                                            "Knowing, clever, mischievous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b59904-bd16-48ba-b617-319165873bbc",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "I attempted to hide my emotions, but an arch remark escaped my lips."
                                            },
                                            {
                                                "example_id": "135b103c-f3d2-4535-9896-4e98436b6e04",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "[He] spoke his request with so arch a leer."
                                            },
                                            {
                                                "example_id": "3d16c696-9f8c-4361-b7d2-533ab44e588b",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "I was every day furniſhing the Court with ſome ridiculous Story; and Glumdalclitch, although ſhe loved me to Exceſs, yet was arch enough to inform the Queen, whenever I committed any Folly that ſhe thought would be diverting to her Majeſty."
                                            },
                                            {
                                                "example_id": "29d3f3a0-4fdb-422d-aae6-6179e2276caf",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "“Oh!” cried Mrs. Green, with an arch laugh, “you are acquainted with Monsieur Margot, then?”"
                                            },
                                            {
                                                "example_id": "b0f2c9e3-7d0c-4205-ba59-1665e4d5117b",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "Blanche’s grey eyes gazed at Foker with such an arch twinkle that both of them burst out laughing […]"
                                            },
                                            {
                                                "example_id": "54dea2e5-197f-4a92-9f49-a970a6ee369e",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "A certain melancholy that touched her countenance must have been of recent birth, for it had not yet altered the fine and youthful contours of her cheek, nor subdued the arch though resolute curve of her lips."
                                            },
                                            {
                                                "example_id": "092803eb-6590-40b2-86dd-1500c4d6615c",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "Lassiter ended there with dry humor, yet behind that was meaning. Jane blushed and made arch eyes at him."
                                            },
                                            {
                                                "example_id": "ece5f43d-cfb6-481c-ad9b-f1da0d65a4e3",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "Not trusting filmgoers to catch the drift, Ms. Coppola underscores the women’s attempts to gussy up with snippets of arch dialogue."
                                            },
                                            {
                                                "example_id": "0f3bdd6f-d0c8-41f7-afe7-9d322f9302a4",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "When you're watching a Wes Anderson film, you know it. Within seconds, you spot the symmetrical compositions, the horizontal camera moves, the blocks of garish colour, the san-serif lettering, the arch, wordy, vaguely melancholy humour and all the other elements that distinguish his comedies from everyone else's."
                                            },
                                            {
                                                "example_id": "9980e646-a638-4934-83da-579682972fc3",
                                                "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                                                "text": "Ms. Brier specializes in point of view, or P.O.V., videos that confront relatable, often hateable characters, with a subtle sneer, gleefully rubbery body and arch delivery of generational catchphrases like “slay, queen” and “I got you,” often repeated for effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b9e3aab-fdae-3312-abb6-234bee4eec4b",
                                        "entry_id": "c51ea480-db4b-3cee-9523-226768de5e42",
                                        "glosses": [
                                            "Cute, sly, prematurely wise."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5243952b-a5e0-3f26-8e96-4c530d8adf90",
                                        "entry_id": "c51ea480-db4b-3cee-9523-226768de5e42",
                                        "glosses": [
                                            "Principal; primary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd5c7df-cb4b-4189-a21f-ea812b75a0a7",
                                                "sense_id": "5243952b-a5e0-3f26-8e96-4c530d8adf90",
                                                "text": "They were arch enemies."
                                            },
                                            {
                                                "example_id": "9bd6dfc1-1c9e-4008-b910-7b418968bd8b",
                                                "sense_id": "5243952b-a5e0-3f26-8e96-4c530d8adf90",
                                                "text": "the most arch act of piteous massacre"
                                            },
                                            {
                                                "example_id": "83f1b04a-fc8d-405b-ac1d-4b2e2d3a47c7",
                                                "sense_id": "5243952b-a5e0-3f26-8e96-4c530d8adf90",
                                                "text": "Challenger the super scientist, Challenger the arch-pioneer, Challenger the first man of all men whom Mother Earth had been compelled to recognize."
                                            }
                                        ]
                                    }
                                ]
                            },
