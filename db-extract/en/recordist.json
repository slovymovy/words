                        "examples": [
                            {
                                "example_id": "b100f969-349a-49e8-ba6e-9d47780179ae",
                                "sense_id": "2898566d-1118-3eab-816e-4b554c5733ec",
                                "text": "Audio Devices, Inc., announce two prize contests, one for Home Recordists, and the other for Church Recordists."
                            },
                            {
                                "example_id": "269ce112-cfaa-497c-a13e-d4df0fa61235",
                                "sense_id": "2898566d-1118-3eab-816e-4b554c5733ec",
                                "text": "A Concert for Three Recordists by Matthew Locke was the program piece."
                            },
                            {
                                "example_id": "6eb9d125-2c8e-457f-a6bd-956df2d50607",
                                "sense_id": "2898566d-1118-3eab-816e-4b554c5733ec",
                                "text": "The more our young recordists can be encouraged to play among themselves in groups with and without piano accompaniment, in their own homes, the better."
                            },
