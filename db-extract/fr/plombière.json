                        "sense_id": "27b7f92f-fb3b-374b-bcde-c2ffd1212921",
                        "entry_id": "a02966e1-a12f-3949-bb6e-d6ac377e2088",
                        "glosses": [
                            "Crème glacée contenant de la macédoine de fruits confits marinée dans un alcool (probablement originellement du marasquin, puis du kirsch, ou du cognac, de l’armagnac…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fbfef28-27d0-4370-828d-09e1b73a5f8c",
                                "sense_id": "27b7f92f-fb3b-374b-bcde-c2ffd1212921",
                                "text": "À la fin du souper on servit des glaces, dites plombières."
                            }
                        ]
