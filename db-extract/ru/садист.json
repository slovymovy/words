                                        "entry_id": "12c13d62-4c6d-3d39-a06a-aa432773cab5",
                                        "glosses": [
                                            "człowiek lubujący się w zadawaniu innym cierpień lub oglądaniu czyjegoś cierpienia"
                                        ],
