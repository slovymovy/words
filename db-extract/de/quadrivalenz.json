                ],
                "senses": [
                    {
                        "sense_id": "41af0a25-0c3c-3922-8f9f-2c1d941f9f7f",
                        "entry_id": "ef0bd63a-2e2d-3200-b396-c9cc68702d75",
                        "glosses": [
                            "Eigenschaft, mit vier anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9e4a6060-dbd9-4482-ad2a-45d92f568200",
                                "sense_id": "41af0a25-0c3c-3922-8f9f-2c1d941f9f7f",
                                "text": "„Aber auch für die Quadrivalenz des Sauerstoffes selbst liegen bereits gewichtige Zeugnisse vor.“"
                            },
                            {
                                "example_id": "773001f0-b48e-4355-a16c-2bb087dfdf99",
                                "sense_id": "41af0a25-0c3c-3922-8f9f-2c1d941f9f7f",
                                "text": "„Dasselbe gilt für Tellur, welches auch in Verbindung mit monovalenten Atomen Quadrivalenz zeigt, und dem sich die analogen Elemente Schwefel und Selen anschliessen.“"
                            },
                            {
                                "example_id": "61bcee47-d18a-4298-961c-f7144be2d866",
                                "sense_id": "41af0a25-0c3c-3922-8f9f-2c1d941f9f7f",
                                "text": "„Daß sich eine Reihe von Chemikern auch heute noch dieser Annahme widersetzt, hat wohl seinen berechtigten Grund darin, daß es durch die oben hervorgehobenen Eigenschaften der vielseitigsten Verkettung des Kohlenstoffatoms möglich ist, den Aufbau fast aller C-Verbindungen bei konstanter Quadrivalenz zu erklären.“"
                            },
                            {
                                "example_id": "e2d76a02-33ae-4f76-8977-05e589c1c793",
                                "sense_id": "41af0a25-0c3c-3922-8f9f-2c1d941f9f7f",
                                "text": "„Es kann in diesem Falle ebenso wenig von einer Quadrivalenz des Kohlenstoffatomes die Rede sein, wie von einer Fünfwerthigkeit des Phosphoratomes im Phosphorpentachlorid.“"
                            },
                            {
                                "example_id": "144bb2fe-feb0-42ef-94aa-241130d80910",
                                "sense_id": "41af0a25-0c3c-3922-8f9f-2c1d941f9f7f",
                                "text": "„Einen Beweis für die Quadrivalenz des Sauerstoffs erblickte Friedel in den von Rose nachgewiesenen Quadrantoxyden Ag₄O, Cu₂O u. a., eine praktische Anwendung derselben findet er zur Erklärung der Verbindungen mit Krystallwasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
