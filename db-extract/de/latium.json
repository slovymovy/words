                "senses": [
                    {
                        "sense_id": "a39239aa-0ae5-38dd-be31-d6ac0d2b0ddf",
                        "entry_id": "136e1596-3f1b-36a1-898b-6c8fd16d3f87",
                        "glosses": [
                            "mittelitalienische Landschaft und Region um und südlich von Rom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "880d2672-eaff-4601-aabe-4b10085e8fb2",
                                "sense_id": "a39239aa-0ae5-38dd-be31-d6ac0d2b0ddf",
                                "text": "„Wichtigste Stadt in Latium ist die italienische Hauptstadt Rom.“"
                            },
                            {
                                "example_id": "1e2572c3-87f7-4c2b-a313-08ba4222425c",
                                "sense_id": "a39239aa-0ae5-38dd-be31-d6ac0d2b0ddf",
                                "text": "„Daher wird die lateinische Sprache […] auch heute noch in ihrem Wortschatz ständig bereichert, was keineswegs das Merkmal einer toten Sprache […] ist: apparatus frigorificus („Kühlschrank“), ozonosphaera („Ozonschicht“), radiatio ultraviolacea („UV-Strahlung“), radiophonia („Hörfunk“), operistitium („Streik“) zählen zu den jüngsten Schöpfungen der über zweitausendjährigen, zum kulturellen Gemeingut der Welt gewordenen Sprache von Latium."
                            },
                            {
                                "example_id": "49d32618-a123-4035-8501-585ee380df78",
                                "sense_id": "a39239aa-0ae5-38dd-be31-d6ac0d2b0ddf",
                                "text": "„843 kam das Latium bei der Teilung des Frankenreiches zum Königreich Italien, erreichte aber bald seine völlige Unabhängigkeit.“"
                            },
                            {
                                "example_id": "4a8ef74e-a085-44f3-b44c-ef0a64a809fb",
                                "sense_id": "a39239aa-0ae5-38dd-be31-d6ac0d2b0ddf",
                                "text": "„Eine geologische Besonderheit ermöglichte in Rom und Latium die Anlage großer unterirdischer Friedhöfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
