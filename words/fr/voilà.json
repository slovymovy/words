                {
                    "sense_id": "baab7c48-d95f-317e-adfc-ee64b9b97ef4",
                    "sense_definition": "Exprime l'achèvement d'une action ou constate un état de fait.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "constat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le travail est terminé, <w>voilà</w> qui est fait !",
                            "target_lang_translations": {
                                "en": "The work is finished, and <w>there it is</w>!",
                                "ru": "Работа окончена, <w>вот и готово</w>!",
                                "nl": "Het werk is af, <w>en klaar is Kees</w>!",
                                "de": "Die Arbeit ist fertig, <w>da haben wir's</w>!",
                                "pl": "Praca skończona, <w>no i gotowe</w>!",
                                "it": "Il lavoro è terminato, <w>ecco fatto</w>!",
                                "cs": "Práce je hotová, <w>a máme to</w>!",
                                "tr": "İş bitti, <w>işte</w> oldu!",
                                "es": "El trabajo está terminado, ¡<w>ya está</w> hecho!",
                                "zh": "工作做完了，<w>搞定了</w>！"
                            }
                        },
                        {
                            "text": "Après des heures d'attente, nous <w>voilà</w> enfin arrivés.",
                            "target_lang_translations": {
                                "en": "After hours of waiting, <w>here we are</w> at last.",
                                "ru": "После долгих часов ожидания <w>вот</w> мы наконец и приехали.",
                                "nl": "Na uren wachten zijn we eindelijk aangekomen, <w>daar zijn we</w>.",
                                "de": "Nach stundenlangem Warten sind wir endlich angekommen, <w>da sind wir</w>.",
                                "pl": "Po godzinach czekania <w>oto</w> wreszcie jesteśmy na miejscu.",
                                "it": "Dopo ore di attesa, <w>eccoci</w> finalmente arrivati.",
                                "cs": "Po hodinách čekání konečně <w>jsme tady</w>.",
                                "tr": "Saatlerce bekledikten sonra <w>işte</w> sonunda geldik.",
                                "es": "Después de horas de espera, <w>ya estamos</w> aquí por fin.",
                                "zh": "等了好几个小时，我们总算<w>到了</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "voilà qui est fait",
                        "nous voilà"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses the completion of an action or confirms a state of affairs.",
                        "ru": "Выражает завершение действия или констатирует положение дел.",
                        "nl": "Geeft aan dat een handeling is voltooid of stelt vast in welke toestand iets zich bevindt.",
                        "de": "Drückt aus, dass eine Handlung abgeschlossen ist, oder stellt einen Zustand fest.",
                        "pl": "Oznacza zakończenie czynności lub stwierdza stan rzeczy.",
                        "it": "Indica che un'azione è stata completata oppure constata una situazione raggiunta.",
                        "cs": "Vyjadřuje dokončení činnosti nebo konstatuje, v jakém stavu věc je.",
                        "tr": "Bir eylemin tamamlandığını ya da ulaşılan bir durumu belirtir.",
                        "es": "Indica que una acción ha terminado o confirma un estado de las cosas.",
                        "zh": "表示某个动作已经完成，或确认某种状况已经达成。"
                    },
