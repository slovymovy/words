                "senses": [
                    {
                        "sense_id": "4641cc22-131e-3054-8998-d6c9680760a7",
                        "entry_id": "8300658b-2e88-32e2-ae1c-4ddedd181c7a",
                        "glosses": [
                            "festgelegter Geldbetrag, den jeder Hochzeitsgast als eine Art Unkostenbeitrag für Speisen und Getränke entrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e569e504-3fc6-4f0b-b8d5-4f76df524416",
                                "sense_id": "4641cc22-131e-3054-8998-d6c9680760a7",
                                "text": "„Die Hochzeit wurde im Gasthaus Kochwirt […] gefeiert. Das Mahlgeld kostete damals neun Mark bei bester Verpflegung.“"
                            },
                            {
                                "example_id": "0f78cb19-0a86-456f-8631-3c033965b018",
                                "sense_id": "4641cc22-131e-3054-8998-d6c9680760a7",
                                "text": "„Das Gericht stellte am späten Nachmittag schließlich fest, dass die Gelder der Hochzeitsgäste wie ein Mahlgeld als Unkostenbeitrag zur Feier anzusehen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
