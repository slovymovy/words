                    },
                    {
                        "sense_id": "1ca5a37e-ec0e-3074-8a5a-f5ae25a15245",
                        "entry_id": "24ac64bf-1a16-3b76-bcc9-9ac577b36aec",
                        "glosses": [
                            "bardzo mocna herbata pita w celu odurzenia, często z dodatkiem tytoniu lub lekarstw"
                        ],
                        "tags": [
