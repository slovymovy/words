                        ]
                    },
                    {
                        "translation_id": "8eec32af-d8ab-43c4-b6e5-2f275f3a9cc4",
                        "source_entry_id": "d472c6ea-07cc-3354-872b-f8148b797ec4",
                        "source_sense_id": "3644c770-580a-39bb-97ce-aadb5d0a8831",
