                    "frequency": "Middle",
                    "semantic_group_id": "eclaircissement_esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces révélations inattendues ont suffi pour m'<w>édifier</w> sur le compte de cet individu."
