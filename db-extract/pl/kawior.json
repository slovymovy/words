                        "entry_id": "7ba9cfc6-365e-391d-a8cc-2055a8ec921b",
                        "glosses": [
                            "przekąska z solonej ikry niektórych gatunków ryb (np. łososia, dorsza), w kolorze czarnym lub czerwonym"
                        ],
                        "tags": [],
                        "examples": [
