                "senses": [
                    {
                        "sense_id": "b26fada8-afb3-334f-8575-4503bed097ca",
                        "entry_id": "1a6bcc4a-3273-3d95-b319-b4fb7291203a",
                        "glosses": [
                            "Qui cherche à provoquer des troubles politiques ou civils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99f0dae1-f8bc-4792-b460-62af1c96231f",
                                "sense_id": "b26fada8-afb3-334f-8575-4503bed097ca",
                                "text": "La diligence de Madrid à Séville, dans laquelle nous devions partir, et où il n’y avait plus de place, fut arrêtée dans la Manche par une bande de factieux ou de voleurs, ce qui est la même chose."
                            },
                            {
                                "example_id": "04a0b378-34fd-4958-81aa-57789a08f988",
                                "sense_id": "b26fada8-afb3-334f-8575-4503bed097ca",
                                "text": "C’était un cri jeté contre un bourreau, cri dont on pouvait être l’organe honorablement, et non pas ces hurlements de l’hypocrisie factieuse et d’un amas de gens sans aveu, sortis de la boue de Paris et vomis par ses égouts."
                            },
                            {
                                "example_id": "8d7eac22-484a-4002-8ac7-a629978934fb",
                                "sense_id": "b26fada8-afb3-334f-8575-4503bed097ca",
                                "text": "Autour de Monsieur se groupaient quelques gentilshommes, factieux, avides, remuants, qui ne pouvaient grandir et s’enrichir que par le désordre."
                            },
                            {
                                "example_id": "3f2bc272-106e-44b0-9734-45082a21bb5a",
                                "sense_id": "b26fada8-afb3-334f-8575-4503bed097ca",
                                "text": "Il a pour adversaire un aventurier mégalomane fou, quasiment factieux, habité par un fantasme de toute-puissance, qui entretient dans la moitié du pays qui le suit un état d’esprit insurrectionnel, je parle évidemment de Donald Trump."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afb050be-97a3-4dfc-8846-3d7373a8b74a",
                        "source_entry_id": "1a6bcc4a-3273-3d95-b319-b4fb7291203a",
                        "source_sense_id": "b26fada8-afb3-334f-8575-4503bed097ca",
