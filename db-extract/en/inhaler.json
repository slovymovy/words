                                "example_id": "cc50b176-a68d-4e55-9621-d75c1348625f",
                                "sense_id": "760423a1-b03d-3949-9ffa-7e83faf37a07",
                                "text": "The exposure of the mouse lungs to smoke was, of course, relatively mild as compared with the exposure of the lungs of a human smoke-inhaler who gets true cancer."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bf5fa95-70a9-35ad-8ccd-bfd0f8d3e86b",
                        "entry_id": "dd3a753d-93da-3037-8315-9a9954ee1445",
                        "glosses": [
                            "A device with a canister holding medicine (either in powder or gas form) which is sprayed and inhaled by the patient, often for treating asthma and other respiratory diseases."
                        ],
                        "tags": [],
                        "examples": [
                            {
