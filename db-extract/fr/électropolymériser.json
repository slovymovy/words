                        "glosses": [
                            "Polymériser par un procédé électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93c5ae7-1197-4d32-bd98-08408d0bf316",
                                "sense_id": "a8a784a0-1527-373c-91bc-8656ee090998",
                                "text": "Depuis le groupe capteurs/membranes a étudié de nouvelles molécules de solvant ou de soluté capables d'électropolymériser à partir de certains critères qui se sont dégagés au cours de nos recherches."
                            },
                            {
                                "example_id": "e2de3fdd-4cda-4ed8-83dd-13c57e09853e",
                                "sense_id": "a8a784a0-1527-373c-91bc-8656ee090998",
                                "text": "Ce résultat ainsi que la diminution du potentiel d'oxydation et l'augmentation de la réactivité du dérivé bithiophène associées à la présence du motif 3,4-éthylènedioxythiophène permettent d'électropolymériser les SAMs correspondantes de façon efficace."
                            }
                        ]
                    }
