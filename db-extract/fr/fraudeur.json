                ],
                "senses": [
                    {
                        "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                        "entry_id": "5947d381-b7c6-36bd-858d-9acef4f76404",
                        "glosses": [
                            "Celui qui fraude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e7ff238-5d33-4d7d-bbfc-07fb29c7ef1c",
                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                "text": "Écoutez bien, je dis pour changer : O bon peuple de Paris ! vous êtes un tas de niais, et vos seigneurs, vos nobles de robe et d’épée, ne sont que d’hypocrites fraudeurs et de fieffés escogriffes !"
                            },
                            {
                                "example_id": "f14a73bf-e748-4eb6-b123-346eccebb7a0",
                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                "text": "Assurément, les fraudeurs ne comptaient pas y entreposer leurs ballots de marchandises prohibées. Les fraudeurs n'ont pas coutume d'emmener leurs femmes dans leurs expéditions."
                            },
                            {
                                "example_id": "13b9980f-0b61-45dd-8e57-edaedf8ec476",
                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                "text": "Le Mohtasib, en effet, surveillait ces métiers pour les poids et mesures, punissant le fraudeur du châtiment du tatouif."
                            },
                            {
                                "example_id": "4591a355-5fdb-4f08-9884-d4087142998a",
                                "sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                                "text": "Le fraudeur essaie de corrompre le douanier ou pas; simultanément le douanier choisit d’être malhonnête ou non."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c03f16a-76f4-4c49-be0e-c907c599d3d5",
                        "source_entry_id": "5947d381-b7c6-36bd-858d-9acef4f76404",
                        "source_sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
                        "target_lang_word": "Betrüger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrüger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                        "entry_id": "6852de93-c45d-3abc-b0e9-ecc31583301d",
                                        "glosses": [
                                            "Person, die andere täuscht, um sich einen Vorteil zu verschaffen; jemand, der betrügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5803090b-ae7e-4323-b9d5-05a4a105d52f",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "Er wurde als Betrüger entlarvt."
                                            },
                                            {
                                                "example_id": "9b1f094e-6dd9-4f7d-b9a2-321bddb5f434",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Per E-Mail stellte ein Betrüger hohe Gewinne in Aussicht - lediglich eine kleine Anzahlung sei zu leisten.“"
                                            },
                                            {
                                                "example_id": "5582df47-cfc3-4e76-9b4c-b3215a517286",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Als die an der Nase herumgeführten Betrüger sich erneut am Telefon meldeten, rief die 85-Jährige die echte Polizei.“"
                                            },
                                            {
                                                "example_id": "5440c2f9-3000-4a80-b292-a65eee9ad55d",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Darüber hinaus schufen sie zahlreiche satirische Romane und Komödien auf Jiddisch, in deren Handlung chassidische Figuren als frömmelnde Fanatiker, Heuchler und intrigante Betrüger dargestellt und entlarvt werden.“"
                                            },
                                            {
                                                "example_id": "e0fa56a5-2507-46fc-99f6-7f585f5a757c",
                                                "sense_id": "dcabcabd-1a1b-35f4-a0c5-11318449e9ae",
                                                "text": "„Er ist ein Betrüger und ein Halunke, das ist klar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5c7a907-b6b8-45bd-9a71-3849884b44ed",
                        "source_entry_id": "5947d381-b7c6-36bd-858d-9acef4f76404",
                        "source_sense_id": "f5449674-f490-3607-bfea-b41b156d2554",
