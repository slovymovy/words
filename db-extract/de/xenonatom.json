                "senses": [
                    {
                        "sense_id": "b0f5bfa8-39ac-3fa9-b286-85ce2898fc53",
                        "entry_id": "6c703c06-4828-39e8-a101-c87ce7f4e298",
                        "glosses": [
                            "Atome de xénon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b1eee80-213b-412a-9ef0-ba3317432754",
                                "sense_id": "b0f5bfa8-39ac-3fa9-b286-85ce2898fc53",
                                "text": "Das Xenonatom ist von vier Sauerstoffatomen in einer regelmäßigen quadratisch planaren Anordnung umgeben.",
                                "translation": "L’atome de xénon est entouré par quatre atomes d’oxygène dans une disposition planaire carée régulière."
                            },
                            {
                                "example_id": "10e72016-3994-4465-bc21-b4c24055f8ad",
                                "sense_id": "b0f5bfa8-39ac-3fa9-b286-85ce2898fc53",
                                "text": "Während die partiell positiv geladenen Xenonatome mit 431.5 pm weiter voneinander entfernt sind als im festen Xenon, kommt es zu einer Annäherung von Xenon- und Fluoratomen benachbarter Moleküle ….",
                                "translation": "Alors que les atomes de xénon partiellement chargés de façon positive sont éloignés les uns des autres de 431,5 pm de plus que dans le xénon solide, il se produit un rapprochement entre les atomes de xénon et de fluor de la molécule avoisinante …."
                            }
                        ]
                    }
                ],
