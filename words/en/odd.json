{
    "word_family": [
        "oddity",
        "oddly",
        "oddness",
        "oddment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc2505d7-2928-348f-b6ea-97a71d742b68",
                    "sense_definition": "Differing from what is usual, ordinary or expected.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_strange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very <w>odd</w> that she left without saying goodbye.",
                            "target_lang_translations": {
                                "ru": "Было очень <w>странно</w>, что она ушла, не попрощавшись.",
                                "de": "Es war sehr <w>seltsam</w>, dass sie ging, ohne sich zu verabschieden."
                            }
                        },
                        {
                            "text": "He has a rather <w>odd</w> way of fixing things.",
                            "target_lang_translations": {
                                "ru": "У него довольно <w>странный</w> способ чинить вещи.",
                                "de": "Er hat eine ziemlich <w>merkwürdige</w> Art, Dinge zu reparieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "strange",
                        "unusual",
                        "peculiar",
                        "weird",
                        "bizarre",
                        "unexpected",
                        "unconventional",
                        "funny"
                    ],
                    "antonyms": [
                        "common",
                        "familiar"
                    ],
                    "common_phrases": [
                        "very odd",
                        "odd behavior",
                        "odd thing",
                        "odd feeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличающийся от обычного или ожидаемого; странный.",
                        "de": "Vom Üblichen, Normalen oder Erwarteten abweichend; merkwürdig."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "странный",
                                "target_lang_sense_clarification": "вызывающий недоумение"
                            },
                            {
                                "target_lang_word": "необычный",
                                "target_lang_sense_clarification": "не такой, как все"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "seltsam",
                                "target_lang_sense_clarification": "nicht normal, merkwürdig"
                            },
                            {
                                "target_lang_word": "merkwürdig",
                                "target_lang_sense_clarification": "auffallend, Verwunderung erregend"
                            },
                            {
                                "target_lang_word": "komisch",
                                "target_lang_sense_clarification": "umgangssprachlich für sonderbar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6db7a401-1954-37fb-9d66-9ab49d7911a3",
                    "sense_definition": "Numerically indivisible by two.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Numbers like one, three, and five are <w>odd</w> numbers.",
                            "target_lang_translations": {
                                "ru": "Числа, такие как один, три и пять — это <w>нечётные</w> числа.",
                                "de": "Zahlen wie eins, drei und fünf sind <w>ungerade</w> Zahlen."
                            }
                        },
                        {
                            "text": "The houses on the left side of the street have <w>odd</w> numbers.",
                            "target_lang_translations": {
                                "ru": "Дома на левой стороне улицы имеют <w>нечётные</w> номера.",
                                "de": "Die Häuser auf der linken Straßenseite haben <w>ungerade</w> Hausnummern."
                            }
                        }
                    ],
                    "antonyms": [
                        "even"
                    ],
                    "common_phrases": [
                        "odd number",
                        "odd and even"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не делящийся на два без остатка (о числах).",
                        "de": "Mathematisch nicht ohne Rest durch zwei teilbar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечётный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ungerade",
                                "target_lang_sense_clarification": "mathematischer Begriff für Zahlen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb29e997-b967-39ae-a772-024b9cb83b51",
                    "sense_definition": "Without a corresponding mate in a pair or set; unmatched or left over.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_unmatched",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always seem to end up with an <w>odd</w> sock after doing the laundry.",
                            "target_lang_translations": {
                                "ru": "Кажется, после стирки у меня всегда остаётся <w>непарный</w> носок.",
                                "de": "Nach dem Waschen habe ich anscheinend immer eine <w>einzelne</w> Socke übrig."
                            }
                        },
                        {
                            "text": "She felt like the <w>odd</w> one out among all the couples.",
                            "target_lang_translations": {
                                "ru": "Среди всех этих пар она чувствовала себя <w>лишней</w>.",
                                "de": "Sie fühlte sich zwischen all den Paaren als das <w>fünfte</w> Rad am Wagen."
                            }
                        }
                    ],
                    "synonyms": [
                        "single",
                        "mismatched"
                    ],
                    "common_phrases": [
                        "odd sock",
                        "odd glove",
                        "odd one out",
                        "odd change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий пары или оставшийся из комплекта; лишний.",
                        "de": "Ohne passendes Gegenstück in einem Paar oder Set; übrig geblieben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непарный",
                                "target_lang_sense_clarification": "без пары (о носках, перчатках)"
                            },
                            {
                                "target_lang_word": "лишний",
                                "target_lang_sense_clarification": "оставшийся, ненужный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einzeln",
                                "target_lang_sense_clarification": "alleine, ohne Partner"
                            },
                            {
                                "target_lang_word": "unpaarig",
                                "target_lang_sense_clarification": "kein Paar bildend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3acc6d0-92dc-318a-921c-349fd213437f",
                    "sense_definition": "Happening or appearing occasionally; not regular or part of a set pattern.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_occasional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He earns extra money by doing <w>odd</w> jobs for the neighbors.",
                            "target_lang_translations": {
                                "ru": "Он подрабатывает, выполняя <w>случайные</w> поручения соседей.",
                                "de": "Er verdient sich etwas dazu, indem er <w>gelegentliche</w> Arbeiten für die Nachbarn erledigt."
                            }
                        },
                        {
                            "text": "We still see each other on the <w>odd</w> occasion.",
                            "target_lang_translations": {
                                "ru": "Мы всё ещё видимся в <w>редких</w> случаях.",
                                "de": "Wir sehen uns noch bei <w>gelegentlichen</w> Anlässen."
                            }
                        }
                    ],
                    "synonyms": [
                        "irregular"
                    ],
                    "common_phrases": [
                        "odd jobs",
                        "odd occasion",
                        "odd moment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случающийся время от времени; нерегулярный.",
                        "de": "Gelegentlich auftretend; nicht regelmäßig oder nach einem festen Muster."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "эпизодический (о работе)"
                            },
                            {
                                "target_lang_word": "нерегулярный",
                                "target_lang_sense_clarification": "редкий"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gelegentlich",
                                "target_lang_sense_clarification": "von Zeit zu Zeit"
                            },
                            {
                                "target_lang_word": "unregelmäßig",
                                "target_lang_sense_clarification": "ohne festes Muster"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f36e57e0-feda-342c-a97b-5bbdfd917ad4",
                    "sense_definition": "About, approximately; somewhat more than a specified round number.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_approx",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were thirty-<w>odd</w> people crowded into the small room.",
                            "target_lang_translations": {
                                "ru": "В маленькую комнату набилось тридцать <w>с лишним</w> человек.",
                                "de": "Es waren dreißig <w>und ein paar</w> Leute in den kleinen Raum gequetscht."
                            }
                        },
                        {
                            "text": "He has written twenty-<w>odd</w> books during his career.",
                            "target_lang_translations": {
                                "ru": "За свою карьеру он написал двадцать <w>с лишним</w> книг.",
                                "de": "Er hat im Laufe seiner Karriere zwanzig <w>und ein paar</w> Bücher geschrieben."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thirty-odd",
                        "twenty-odd",
                        "hundred-odd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизительно; немного больше указанного круглого числа.",
                        "de": "Ungefähr; etwas mehr als eine angegebene runde Zahl."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с лишним",
                                "target_lang_sense_clarification": "чуть больше указанного числа"
                            },
                            {
                                "target_lang_word": "около",
                                "target_lang_sense_clarification": "примерно"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "und ein paar",
                                "target_lang_sense_clarification": "etwas mehr als die genannte Zahl"
                            },
                            {
                                "target_lang_word": "etwa",
                                "target_lang_sense_clarification": "ungefähr"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e458980-8643-3fc2-af4a-46b43e5abe64",
                    "sense_definition": "Something left over, not forming part of a set.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drawer was full of <w>odds</w> and ends that I didn't know what to do with.",
                            "target_lang_translations": {
                                "ru": "Ящик был полон <w>всякой всячины</w>, с которой я не знал, что делать.",
                                "de": "Die Schublade war voll mit <w>Kleinkram</w>, mit dem ich nichts anzufangen wusste."
                            }
                        },
                        {
                            "text": "I have a few <w>odds</w> left from the collection to sell.",
                            "target_lang_translations": {
                                "ru": "У меня осталось несколько <w>разрозненных предметов</w> из коллекции на продажу.",
                                "de": "Ich habe noch ein paar <w>Reststücke</w> aus der Sammlung zu verkaufen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odds and ends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остаток; вещь, не являющаяся частью комплекта.",
                        "de": "Überbleibsel; Dinge, die nicht Teil eines Sets sind."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "разрозненные предметы"
                            },
                            {
                                "target_lang_word": "всякая всячина",
                                "target_lang_sense_clarification": "мелкие предметы (в идиоме)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kleinkram",
                                "target_lang_sense_clarification": "verschiedene kleine Gegenstände"
                            },
                            {
                                "target_lang_word": "Restbestände",
                                "target_lang_sense_clarification": "was übrig geblieben ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74482ad0-57b6-36b6-96cd-55d57598d3c5",
                    "sense_definition": "Initialism of oppositional defiant disorder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was diagnosed with <w>ODD</w> after showing consistent behavioral issues.",
                            "target_lang_translations": {
                                "ru": "Ребёнку поставили диагноз <w>ВР</w> после проявления постоянных поведенческих проблем.",
                                "de": "Bei dem Kind wurde <w>ODD</w> diagnostiziert, nachdem es anhaltende Verhaltensauffälligkeiten gezeigt hatte."
                            }
                        },
                        {
                            "text": "Teachers are trained to support students with <w>ODD</w> in the classroom.",
                            "target_lang_translations": {
                                "ru": "Учителей обучают поддержке учеников с <w>ВР</w> в классе.",
                                "de": "Lehrer werden darin geschult, Schüler mit <w>ODD</w> im Unterricht zu unterstützen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от «вызывающее оппозиционное расстройство».",
                        "de": "Abkürzung für Störung mit oppositionellem Trotzverhalten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ВР",
                                "target_lang_sense_clarification": "медицинская аббревиатура"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ODD",
                                "target_lang_sense_clarification": "medizinische Fachbezeichnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
