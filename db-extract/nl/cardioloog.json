                        ],
                        "form": "cardioloogjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8f30b05-ae3d-30a1-b629-5320af61ef9f",
                        "entry_id": "e934c2d7-6f23-3749-beba-80f606d5076e",
                        "glosses": [
                            "een medisch specialist die zich bezighoudt met het opsporen, diagnosticeren en behandelen van hartziekten"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "87cc1b44-ee50-4cdf-8424-8f83abb3077e",
                                "sense_id": "c8f30b05-ae3d-30a1-b629-5320af61ef9f",
                                "text": "- De hartchirurg opereert, maar een dotter-procedure kan gedaan worden door een cardioloog."
                            },
                            {
                                "example_id": "fefbe886-4a6e-4f06-b745-2801454f1f45",
                                "sense_id": "c8f30b05-ae3d-30a1-b629-5320af61ef9f",
                                "text": "- Een paar jaar geleden zat ik zelf in de spreekkamer van de cardioloog vanwege hartritmestoornissen. Hij wilde mij een bepaald medicijn voorschrijven, waarvan ik gehoord had dat het bij vrouwen heel anders uitwerkt dan bij mannen. ‘Maakt het uit dat ik een vrouw ben, voor dit medicijn?’, vroeg ik. De cardioloog bleef op zijn beeldscherm kijken en zei geïrriteerd: ‘Er is geen verschil.’ Ik had thuis literatuur waaruit het tegendeel bleek. De cardioloog was niet nieuwsgierig: ‘Dat is allemaal onbewezen en onzin.’ En hij deed de deur voor mij open. ‘Volgende?’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a9b851f-5654-40ca-a437-7fb5d8a914fc",
                        "source_entry_id": "e934c2d7-6f23-3749-beba-80f606d5076e",
                        "source_sense_id": "c8f30b05-ae3d-30a1-b629-5320af61ef9f",
                        "target_lang_word": "Kardiologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kardiologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3417f973-4b94-3869-b453-90c1e5ae6263",
                                        "entry_id": "53211584-a4aa-31c0-89e9-830dc6ee2367",
                                        "glosses": [
                                            "Mediziner, der sich mit Erkrankungen des Herzens beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bdc7ba-b5a7-4e33-bcf6-de0dda982562",
                                                "sense_id": "3417f973-4b94-3869-b453-90c1e5ae6263",
                                                "text": "Der Patient musste zum Kardiologen, der ihm einen Herzkatheter legte."
                                            },
                                            {
                                                "example_id": "c768d4fe-88ec-4f36-b5e8-d8dc29d23b70",
                                                "sense_id": "3417f973-4b94-3869-b453-90c1e5ae6263",
                                                "text": "„Ich hatte ihren Namen gegoogelt und gelesen, dass sie die Tochter eines anscheinend weltberühmten Grazer Kardiologen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0235006-5917-4eec-836b-6b353eeea0d7",
                        "source_entry_id": "e934c2d7-6f23-3749-beba-80f606d5076e",
                        "source_sense_id": "c8f30b05-ae3d-30a1-b629-5320af61ef9f",
                        "target_lang_word": "cardiologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardiologist",
