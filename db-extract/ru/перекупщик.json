                "senses": [
                    {
                        "sense_id": "8b1b7b13-0011-38e7-83b5-19c97550ba91",
                        "entry_id": "94e3ab0a-f6f5-323b-965b-51a98109448c",
                        "glosses": [
                            "тот, кто покупает что-либо для перепродажи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfae95cd-a4d8-4889-9d24-0e4d3dbd1042",
                                "sense_id": "8b1b7b13-0011-38e7-83b5-19c97550ba91",
                                "text": "Старушки загомонили: — Сейчас нажрутся, станут песни орать! — А Паша Эмильевич сегодня утром стул из красного уголка продал. С чёрного хода вынес перекупщику."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21215402-e352-416e-895c-91710168ec48",
                        "source_entry_id": "94e3ab0a-f6f5-323b-965b-51a98109448c",
                        "source_sense_id": "8b1b7b13-0011-38e7-83b5-19c97550ba91",
                        "target_lang_word": "dealer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dealer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a35861f5-832e-34d4-b95e-96d5e034b185",
                                        "entry_id": "3c2459af-bea4-3416-8c5a-70bf1b774d17",
                                        "glosses": [
                                            "One who deals in goods, especially automobiles; a middleman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6284ca63-aa11-4fb8-b4d0-315fe6fa8911",
                                                "sense_id": "a35861f5-832e-34d4-b95e-96d5e034b185",
                                                "text": "That used car dealer gave me a great deal on my 1962 rusted-out Volkswagen bug!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1311846-e5f2-3b9c-8947-9e23a180e668",
                                        "entry_id": "3c2459af-bea4-3416-8c5a-70bf1b774d17",
                                        "glosses": [
                                            "A drug dealer, one who peddles illicit drugs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef709239-2638-4c8a-a3cd-bc897b020f28",
                                                "sense_id": "d1311846-e5f2-3b9c-8947-9e23a180e668",
                                                "text": "It's true that all the men you knew were dealers\n Who said they were through with dealing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b4e5e1-40d7-3453-b518-3e03122f1c13",
                                        "entry_id": "3c2459af-bea4-3416-8c5a-70bf1b774d17",
                                        "glosses": [
                                            "A particular type of stock broker or trader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a38fdf8-da07-39a3-9813-b785a4923117",
                                        "entry_id": "3c2459af-bea4-3416-8c5a-70bf1b774d17",
                                        "glosses": [
                                            "The person who deals the cards in a card game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41379b71-bb68-3b84-9b27-f1c2734952cb",
                                        "entry_id": "3c2459af-bea4-3416-8c5a-70bf1b774d17",
                                        "glosses": [
                                            "One who deals or metes out anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d503f38c-a188-4a38-851f-016475c274b9",
                                                "sense_id": "41379b71-bb68-3b84-9b27-f1c2734952cb",
                                                "text": "Dealt a decisive blow, Newman himself becomes a vengeful dealer of blows, perpetuating the repetitive cycle of repression and eruption […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d925f6f-4542-4c43-b1d3-648c94864fea",
