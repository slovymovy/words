                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90368cd-0f03-46a8-bab5-8313591b835d",
                                                "sense_id": "674ddebb-3166-30d1-be23-1dcb4cedcc21",
                                                "text": "Vanaf de bergtop hadden we een prachtig panorama over de omliggende dalen."
                                            },
                                            {
                                                "example_id": "5fb2bbec-8601-4974-80fb-8ef96ebefd22",
                                                "sense_id": "674ddebb-3166-30d1-be23-1dcb4cedcc21",
                                                "text": "Er ontvouwde zich een geraffineerd panorama bij de bocht. Aan het einde van de kade langs de gracht, die met eenvoudige meerpalen van blank hout was gearceerd, was de slanke boog van de Ponte del Gafaro getekend voor de oudroze gevel van een laag palazzo, die was voorzien van zeven hoge puntige ramen in een witmarmeren sponning en werd bekroond met de klokkentoren van een kerk daarachter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df6ce7f1-36c6-3f3d-899f-ac8678571f0e",
                                        "entry_id": "06107955-6ef9-3940-8530-b9380efc015b",
                                        "glosses": [
                                            "een cilindervormig schilderij dat een stuk landschap of een tafereel in zijn geheel voorstelt, waarbij de toeschouwer midden in de cilinder staat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0413babd-bd9e-41b1-adb3-2f1bb214b4af",
                                                "sense_id": "df6ce7f1-36c6-3f3d-899f-ac8678571f0e",
                                                "text": "Panorama Mesdag is een cilindervormig schilderij van ongeveer 14 meter hoog en met een omtrek van 120 meter."
                                            }
                                        ]
                                    }
                                ]
                            }
