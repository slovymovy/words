                ],
                "senses": [
                    {
                        "sense_id": "d4119a0e-a2f4-3e3b-8a23-8d37fd932d6a",
                        "entry_id": "b819af76-f9ca-3284-b042-2f38d4d629c8",
                        "glosses": [
                            "Membre d’une secte hussite installée en Picardie après l’assassinat de Jean Hus et par extension, ces sectateurs de Bohême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe69fee-27c0-4b7f-9adc-40587b3deac2",
                                "sense_id": "d4119a0e-a2f4-3e3b-8a23-8d37fd932d6a",
                                "text": "Les dogmes des picards & des Vaudois sont les mêmes nous l’avons déja vu par le détail que Schlecta a fait des opinions des picards de Bohême. Ils soutenoient qu’il ne faut point adorer l’eucharistie parce que le corps de Jesus-Christ n’y est point, le Seigneur ayant été élevé au ciel en corps & en ame."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ec15cc-e1e8-4886-bdd9-3b65547167b1",
                        "source_entry_id": "b819af76-f9ca-3284-b042-2f38d4d629c8",
                        "source_sense_id": "d4119a0e-a2f4-3e3b-8a23-8d37fd932d6a",
                        "target_lang_word": "пикарт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пикарт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b2d25cdf-0ca9-304c-9bea-7559392a17f8",
                                        "entry_id": "096061a0-c8a1-385e-a8d6-7c48a4e79cc1",
                                        "glosses": [
                                            "представитель крайне левого крыла таборитов во время гуситского движения в Чехии в XV веке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8576a7c-12c9-44a1-9457-39321e60edbe",
                                                "sense_id": "b2d25cdf-0ca9-304c-9bea-7559392a17f8",
                                                "text": "Они носили различные названия, но чаще всего сторонников крайних хилиастических взглядов называли пикартами‚ иногда адамитами."
                                            }
                                        ]
                                    }
                                ]
                            }
