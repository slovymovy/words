    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97bf2488-03f7-3b58-ae34-3eeb8690b3f4",
                    "sense_definition": "The # symbol, often used in computing, social media, or to indicate a number.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "symbols",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please enter your account number followed by the <w>hash</w> key.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, введите номер вашего счета, а затем клавишу <w>решётка</w>.",
                                "zh": "请输入您的账号，然后按<w>井号</w>键。"
                            }
                        },
                        {
                            "text": "You can find the <w>hash</w> sign above the number three on most keyboards.",
                            "target_lang_translations": {
                                "ru": "На большинстве клавиатур символ <w>решётки</w> находится над цифрой три.",
                                "zh": "在大多数键盘上，<w>井号</w>都在数字三的上方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hash sign",
                        "number sign",
                        "pound sign",
                        "octothorpe /octothorn"
                    ],
                    "common_phrases": [
                        "hash key",
                        "hash symbol"
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ #, часто используемый в программировании, социальных сетях или для обозначения номера.",
                        "zh": "井号（#），常用于计算机、社交媒体或表示数字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решётка",
                                "target_lang_sense_clarification": "название символа #"
                            },
                            {
                                "target_lang_word": "знак номера",
                                "target_lang_sense_clarification": "использование символа для обозначения числа"
                            },
                            {
                                "target_lang_word": "октоторп",
                                "target_lang_sense_clarification": "техническое название символа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "井号",
                                "target_lang_sense_clarification": "符号#的名称"
                            },
                            {
                                "target_lang_word": "号码键",
                                "target_lang_sense_clarification": "在电话键盘上指代该符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e25487b-0591-368d-9de3-ed00b31c6e5d",
                    "sense_definition": "A dish consisting of diced meat and potatoes that have been mixed together and fried.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For breakfast, he ordered a plate of corned beef <w>hash</w> with two eggs.",
                            "target_lang_translations": {
                                "ru": "На завтрак он заказал порцию <w>хэша</w> из солонины с двумя яйцами.",
                                "zh": "早餐时，他点了一份咸牛肉<w>碎肉土豆饼</w>和两个鸡蛋。"
                            }
                        },
                        {
                            "text": "The chef prepared a savory beef <w>hash</w> using the leftovers from last night.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил аппетитное мясное <w>крошево</w>, используя остатки со вчерашнего вечера.",
                                "zh": "厨师用昨晚的剩菜做了一份美味的牛肉<w>杂烩</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "corned beef hash",
                        "beef hash",
                        "potato hash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блюдо из мелко нарезанного мяса и картофеля, смешанных и обжаренных вместе.",
                        "zh": "一种由切碎的肉和土豆混合并煎炸而成的菜肴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хэш",
                                "target_lang_sense_clarification": "название блюда"
                            },
                            {
                                "target_lang_word": "крошево",
                                "target_lang_sense_clarification": "мелко нарезанная еда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碎肉土豆饼",
                                "target_lang_sense_clarification": "一种美式早餐菜肴"
                            },
                            {
                                "target_lang_word": "肉末杂烩",
                                "target_lang_sense_clarification": "泛指切碎混合的菜肴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "139bf09f-b327-3a8d-a45b-470d08b1c122",
                    "sense_definition": "A slang term for hashish, a drug derived from the cannabis plant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found a small amount of <w>hash</w> in the suspect's pocket.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла небольшое количество <w>гашиша</w> в кармане подозреваемого.",
                                "zh": "警察在嫌疑人的口袋里发现了一小份<w>大麻脂</w>。"
                            }
                        },
                        {
                            "text": "He was arrested for trying to sell <w>hash</w> near the park.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за попытку продать <w>хэш</w> рядом с парком.",
                                "zh": "他因试图在公园附近兜售<w>大麻脂</w>而被捕。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for hashish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название гашиша, наркотического вещества, получаемого из конопли.",
                        "zh": "大麻制品的俚语称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хэш",
                                "target_lang_sense_clarification": "жаргонное сокращение от гашиш"
                            },
                            {
                                "target_lang_word": "гашиш",
                                "target_lang_sense_clarification": "полное название вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大麻脂",
                                "target_lang_sense_clarification": "大麻制品的正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84005565-2dbd-34c6-b927-0bc07ed9b689",
                    "sense_definition": "A value or string of characters generated by a mathematical function to represent data.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system stores a <w>hash</w> of your password rather than the password itself.",
                            "target_lang_translations": {
                                "ru": "Система хранит <w>хеш</w> вашего пароля, а не сам пароль.",
                                "zh": "系统存储的是你密码的<w>哈希值</w>，而不是密码本身。"
                            }
                        },
                        {
                            "text": "The checksum is a unique <w>hash</w> used to verify that the file is not corrupted.",
                            "target_lang_translations": {
                                "ru": "Контрольная сумма — это уникальный <w>хеш-код</w>, используемый для проверки того, что файл не поврежден.",
                                "zh": "校验和是一种用于验证文件是否损坏的唯一<w>哈希值</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "checksum"
                    ],
                    "common_phrases": [
                        "hash function",
                        "password hash",
                        "unique hash"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical computing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значение или строка символов, созданная математической функцией для представления данных.",
                        "zh": "由数学函数生成，用于代表数据的一串字符或数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хеш",
                                "target_lang_sense_clarification": "результат хеширования данных"
                            },
                            {
                                "target_lang_word": "хэш-код",
                                "target_lang_sense_clarification": "уникальный идентификатор данных"
                            },
                            {
                                "target_lang_word": "контрольная сумма",
                                "target_lang_sense_clarification": "значение для проверки целостности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哈希值",
                                "target_lang_sense_clarification": "计算后的结果"
                            },
                            {
                                "target_lang_word": "散列值",
                                "target_lang_sense_clarification": "计算机科学中的专业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2463152b-9de2-3e59-b83e-53af55aea1f2",
                    "sense_definition": "A confused mess or a muddle of things.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager made a complete <w>hash</w> of the project schedule.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер устроил полную <w>путаницу</w> в графике проекта.",
                                "zh": "新经理把项目进度表弄得<w>一团糟</w>。"
                            }
                        },
                        {
                            "text": "The document was a confused <w>hash</w> of unrelated ideas and statistics.",
                            "target_lang_translations": {
                                "ru": "Документ представлял собой бессвязную <w>мешанину</w> из несвязанных идей и статистики.",
                                "zh": "这份文件是一堆互不相关的观点和统计数据的<w>混乱</w>堆砌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a hash of",
                        "confused hash"
