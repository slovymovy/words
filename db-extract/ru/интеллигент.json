                "senses": [
                    {
                        "sense_id": "50f2d9a1-89f5-3976-8827-25ef3de8b095",
                        "entry_id": "90c20213-3b37-3b13-ab20-602a848a0b71",
                        "glosses": [
                            "лицо, принадлежащее к интеллигенции"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ab59ea99-0243-3e7e-9ece-0525f59fd430",
                        "entry_id": "90c20213-3b37-3b13-ab20-602a848a0b71",
                        "glosses": [
                            "любое лицо, занимающееся умственным трудом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584a7249-e1df-4dde-af7b-eefc072cc21a",
                                "sense_id": "ab59ea99-0243-3e7e-9ece-0525f59fd430",
                                "text": "Кро́ме того, интеллиге́нт вполне́ мо́жет не занима́ться «у́мственным трудо́м профессиона́льно»."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4ef56f6-214f-33d5-baca-1f225eb15a10",
                        "entry_id": "90c20213-3b37-3b13-ab20-602a848a0b71",
                        "glosses": [
                            "пренебр. человек, социальное поведение которого характеризуется безволием, колебаниями, сомнениями, застенчивостью"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fb69cbe-e21e-456c-9ce8-9d454fd4fa60",
                        "source_entry_id": "90c20213-3b37-3b13-ab20-602a848a0b71",
                        "source_sense_description": "представитель интеллигенции",
                        "target_lang_word": "intellectual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intellectual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5bdd5b6-72ee-3a18-a128-8e65b15d2bbd",
                                        "entry_id": "885b2cf5-1ad5-37a4-8856-03d73239822f",
                                        "glosses": [
                                            "Pertaining to, or performed by, the intellect; mental or cognitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae63b8c-429d-4a3c-b82d-6d4ea60d7063",
                                                "sense_id": "e5bdd5b6-72ee-3a18-a128-8e65b15d2bbd",
                                                "text": "intellectual powers, activities, etc."
                                            },
                                            {
                                                "example_id": "d393506f-f51c-45a4-b79c-f2e605a84cb7",
                                                "sense_id": "e5bdd5b6-72ee-3a18-a128-8e65b15d2bbd",
                                                "text": "1920, Harold Monro, Preface to The year's at the spring; an anthology of recent poetry\nPleasure is various, but it cannot exist where the emotions or the imagination have not been powerfully stirred. Whether it be called sensual or intellectual, pleasure cannot be willed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95c58ff5-70e4-38d0-9525-93ee2141fc57",
                                        "entry_id": "885b2cf5-1ad5-37a4-8856-03d73239822f",
                                        "glosses": [
                                            "Endowed with intellect; having a keen sense of understanding; having the capacity for higher forms of knowledge or thought; characterized by intelligence or cleverness"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd602c1-38d3-48e0-b7cc-b19e3d4ce71b",
                                                "sense_id": "95c58ff5-70e4-38d0-9525-93ee2141fc57",
                                                "text": "an intellectual person"
                                            },
                                            {
                                                "example_id": "f6e1f7b8-f527-4fca-aa1a-271a2e03736f",
                                                "sense_id": "95c58ff5-70e4-38d0-9525-93ee2141fc57",
                                                "text": "The Fenimore Cooper Indian is no doubt a brave and highly intellectual person, educated abroad, refined and cultivated by foreign travel, graceful in the grub dance or scalp walk-around, yet tender-hearted as a girl, walking by night fifty-seven miles in a single evening to warn his white friends of danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10910db7-ab06-3750-bb41-0747b22ac811",
                                        "entry_id": "885b2cf5-1ad5-37a4-8856-03d73239822f",
                                        "glosses": [
                                            "Suitable for exercising one's intellect; perceived by the intellect"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2fa1c00-94f5-4ee6-b089-1fb4413b84f5",
                                                "sense_id": "10910db7-ab06-3750-bb41-0747b22ac811",
                                                "text": "intellectual employments"
                                            },
                                            {
                                                "example_id": "d0591447-dd91-4546-bd2e-59023874df7e",
                                                "sense_id": "10910db7-ab06-3750-bb41-0747b22ac811",
                                                "text": "A good deal of nonsense is written about sport and entertainment. Many of us can, with pleasant ease, suspend a severely intellectual task for a few hours to witness a first-class football match."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39c7f7de-1988-3de7-995c-2ff532230593",
                                        "entry_id": "885b2cf5-1ad5-37a4-8856-03d73239822f",
                                        "glosses": [
                                            "Relating to the understanding; treating of the mind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bafedbc-90b9-4272-88b2-f2cbbdf3207e",
                                                "sense_id": "39c7f7de-1988-3de7-995c-2ff532230593",
                                                "text": "intellectual philosophy, sometimes called \"mental\" philosophy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f6f01a-955e-323f-896a-8b7d382367eb",
                                        "entry_id": "885b2cf5-1ad5-37a4-8856-03d73239822f",
                                        "glosses": [
                                            "Spiritual."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2203f37d-1a9b-49cc-ae0a-d0564c6f35aa",
                                                "sense_id": "d4f6f01a-955e-323f-896a-8b7d382367eb",
                                                "text": "I deem not profitless those fleeting moods / Of shadowy exultation; not for this, / That they are kindred to our purer mind / And intellectual life […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intellectual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2df6f226-630a-3e04-ae90-d33f88bc0401",
                                        "entry_id": "3b652acc-479a-3b68-804a-6fcc15f3222d",
                                        "glosses": [
                                            "An intelligent, learned person, especially one who discourses about learned matters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04ef5bf0-6fe1-4ff8-b135-d482a18714a2",
                                                "sense_id": "2df6f226-630a-3e04-ae90-d33f88bc0401",
                                                "text": "It should be noted that there is now no intelligentsia that is not in some sense \"Left\". Perhaps the last right-wing intellectual was T. E. Lawrence. Since about 1930 everyone describable as an “intellectual” has lived in a state of chronic discontent with the existing order."
                                            },
                                            {
                                                "example_id": "81cc35ac-e9b8-4e32-90aa-904cc1e06041",
                                                "sense_id": "2df6f226-630a-3e04-ae90-d33f88bc0401",
                                                "text": "‘You know I hate intellectuals.’\n‘You mean you hate people who are cleverer than you are.’\n‘Yes. I suppose that’s why I like you so much, Tom.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0051664-8aa6-3b6b-9341-c244e42dfb89",
                                        "entry_id": "3b652acc-479a-3b68-804a-6fcc15f3222d",
                                        "glosses": [
                                            "The intellect or understanding; mental powers or faculties."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3921ca-8c62-45f6-9859-616b7f139ef0",
                                                "sense_id": "c0051664-8aa6-3b6b-9341-c244e42dfb89",
                                                "text": "[…] although their intellectuals had not failed in the theory of truth, yet did the inservient and brutall faculties control the suggestion of reason […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
