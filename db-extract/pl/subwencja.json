                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2914872-b97c-48ff-a4d1-d202828606a5",
                                "sense_id": "86b00598-29c3-348b-9133-e1661a2db197",
                                "text": "Mój program otrzymał subwencję."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f48fecc-a199-4e66-af84-d21d42f4e553",
                        "source_entry_id": "2cfc1142-4768-361f-8af2-f107bc23ed30",
                        "source_sense_id": "86b00598-29c3-348b-9133-e1661a2db197",
                        "target_lang_word": "subvention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subvention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a32886fd-202a-342c-b5a8-5e3607e8cd88",
                                        "entry_id": "4f7b9707-b714-3281-8237-0cb550f65eaf",
                                        "glosses": [
                                            "A subsidy; provision of financial or other support."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be91d7b-3fdf-41f0-8aac-eec7662af4d9",
                                                "sense_id": "a32886fd-202a-342c-b5a8-5e3607e8cd88",
                                                "text": "[…] the said religious shall […] pay all papal impositions, subventions, and contributions […]"
                                            },
                                            {
                                                "example_id": "01efd787-e8f5-4b7e-9e11-ab312582bf42",
                                                "sense_id": "a32886fd-202a-342c-b5a8-5e3607e8cd88",
                                                "text": "[…] the Crown-Prince, contrary to wont, broke silence, and begged some dole or subvention for these poor people; but there was nothing to be had."
                                            },
                                            {
                                                "example_id": "8c99af03-dfd9-4749-a9f1-f42b671af416",
                                                "sense_id": "a32886fd-202a-342c-b5a8-5e3607e8cd88",
                                                "text": "Inside its skirts he carried his shopping for Miss Dubber: the bacon from Mr. Aitken, only mind and tell him he's to cut it on number five, give him half a chance he'll make it thicker. And tell that Mr. Crosse three of his tomatoes were rotten last week, not just bad, rotten. If I don't have replacements I'll never go to him again. Pym had followed her instructions to the letter, though not with the ferocity she would have wished, for both Crosse and Aitken were recipients of his secret subventions, and for years had been sending Miss Dubber bills for only half what she had spent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57858df2-d397-320e-8a1d-0b0e64e55a82",
                                        "entry_id": "4f7b9707-b714-3281-8237-0cb550f65eaf",
                                        "glosses": [
                                            "The act of coming under."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445cd7ee-6bd5-482c-ae0d-09eb89e42685",
                                                "sense_id": "57858df2-d397-320e-8a1d-0b0e64e55a82",
                                                "text": "1744, Thomas Stackhouse, A New History of the Holy Bible, London: Stephen Austen, 2nd edition, Volume 2, Book 6, Chapter 2, p. 845,\nNow the only Ascension that we read of, besides these, is that of our blessed Saviour; and the Manner, in which he is said to have been carry’d up, was, by the Subvention of a Cloud, which rais’d him from the Ground […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c27f3ef-dadd-36d8-ae65-a7c087be7e6f",
                                        "entry_id": "4f7b9707-b714-3281-8237-0cb550f65eaf",
                                        "glosses": [
                                            "The act of relieving, as of a burden; support; aid; assistance; help."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb28778d-40b4-4ff1-ba02-c7b2cd2eb79c",
                                                "sense_id": "4c27f3ef-dadd-36d8-ae65-a7c087be7e6f",
                                                "text": "[…] if we pray to God to remove a lesser judgement by way of subvention, questionlesse we may beseech him to deliver us from the great evill of a wounded conscience, by way of prevention."
                                            },
                                            {
                                                "example_id": "cf9c8014-c18d-4cfa-8c4f-82bfaad6a3a4",
                                                "sense_id": "4c27f3ef-dadd-36d8-ae65-a7c087be7e6f",
                                                "text": "A small body of negroes defied the choicest troops of one of the greatest nations in the world, kept an extensive country in alarm, and were at length brought to surrender, only by means of a subvention still more extraordinary than their own mode of warfare."
                                            },
                                            {
                                                "example_id": "2b0c521a-ddda-4095-b144-2582739bf33e",
                                                "sense_id": "4c27f3ef-dadd-36d8-ae65-a7c087be7e6f",
                                                "text": "Let the young critics, who seek a cheap reputation for austerity, by cavilling at “incidental music,” set their faces rather against the attempt to justify inferior dramatic art by the subvention of a quite alien art like painting, of any art, indeed, whose sphere is only surface."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subvention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59221ceb-454e-3532-a220-e9ec79247250",
                                        "entry_id": "2c45bf88-5ee5-3476-8279-c9789ded950a",
                                        "glosses": [
                                            "To subsidise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09665cb-a577-4543-8213-06e58187e2a4",
                                                "sense_id": "59221ceb-454e-3532-a220-e9ec79247250",
                                                "text": "His task was, it is true, made easier by the need of the English to remove troops to put down the 1745-6 Jacobite Rising, which the French had subventioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
