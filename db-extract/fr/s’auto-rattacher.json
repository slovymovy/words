                "senses": [
                    {
                        "sense_id": "048058b8-8bec-3846-a539-0a472fd5e79f",
                        "entry_id": "9f81750b-2cbc-31ee-b4d3-403eb1edbcc1",
                        "glosses": [
                            "Se rattacher de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589861c9-caa2-4cfe-8265-bfb17541f642",
                                "sense_id": "048058b8-8bec-3846-a539-0a472fd5e79f",
                                "text": "La première c'est la décision d'un référendum rapidement et la seconde aujourd'hui, où la Crimée s'est auto-rattachée à la Russie (…)"
                            },
                            {
                                "example_id": "e991f347-76f6-40bc-b535-b6451992f82f",
                                "sense_id": "048058b8-8bec-3846-a539-0a472fd5e79f",
                                "text": "À l'instar des citoyens de Crimée qui se sont auto-rattachés à leur mère-patrie russe avec l'assistance musclée et bienveillante de Vladimir Poutine, les Bonimontains aimeraient rallier vos glorieux États-Unis d'Amérique et devenir leur quatorzième territoire non incorporé."
                            },
                            {
                                "example_id": "bca69ed3-e839-4f70-9551-794901837cfe",
                                "sense_id": "048058b8-8bec-3846-a539-0a472fd5e79f",
                                "text": "Et problème la Russie avait à l’époque contesté la légalité de cette indépendance auto-déclarée, mais réponse de l’Occident, « Le Droit des peuples a disposé d’eux-mêmes » très bien dit Poutine on verra, 6 ans plus tard c’est la Crimée qui s’auto-rattache à la Russie, suite à un referendum organisé le 18 mars 2014."
                            }
                        ]
                    }
