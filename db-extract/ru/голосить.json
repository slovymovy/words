                                                "sense_id": "a4295b66-6c47-3da2-b859-f8113b093a4a",
                                                "text": "She let out a loud, doleful wail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f040fae-360f-354c-9e6e-bf4e8dee47b2",
