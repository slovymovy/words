            "senses": [
                {
                    "sense_id": "914cf803-fb43-330d-a26a-5fc8319f9e5d",
                    "sense_definition": "głęboka, ciemna przepaść lub bezdenna otchłań",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "głębia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wędrowiec ostrożnie spojrzał w ciemną <w>czeluść</w> jaskini, z której wiał chłodny wiatr.",
                            "target_lang_translations": {
                                "ru": "Путник осторожно заглянул в тёмную <w>бездну</w> пещеры, откуда веяло холодным ветром."
                            }
                        },
                        {
                            "text": "Mityczny potwór został zepchnięty prosto w piekielne <w>czeluście</w> ziemi.",
                            "target_lang_translations": {
                                "ru": "Мифическое чудовище было низвергнуто прямо в адские <w>бездны</w> земли."
                            }
                        }
                    ],
                    "synonyms": [
                        "otchłań",
                        "przepaść",
                        "bezdenność"
                    ],
                    "common_phrases": [
                        "piekielne czeluście",
                        "ciemna czeluść",
                        "czeluść jaskini"
                    ],
                    "target_lang_definitions": {
                        "ru": "глубокая, тёмная пропасть или бездонная пучина"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездна",
                                "target_lang_sense_clarification": "бездонная глубина, пучина"
                            },
                            {
                                "target_lang_word": "пропасть",
                                "target_lang_sense_clarification": "крутой глубокий обрыв"
                            },
                            {
                                "target_lang_word": "пучина",
                                "target_lang_sense_clarification": "поглощающая глубина, бездна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3d09d18-7fbd-3a00-8f07-3745bde0af24",
                    "sense_definition": "głęboki dół, jama lub urwisko",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "głębia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Turysta z przerażeniem patrzył, jak jego ciężki plecak stacza się w skalną <w>czeluść</w>.",
                            "target_lang_translations": {
                                "ru": "Турист с ужасом смотрел, как его тяжёлый рюкзак катится в скалистую <w>пропасть</w>."
                            }
                        },
                        {
                            "text": "Stary kamieniołom zamienił się po latach w niebezpieczną, stromą <w>czeluść</w>.",
                            "target_lang_translations": {
                                "ru": "Спустя годы старый карьер превратился в опасный, отвесный <w>провал</w>."
                            }
                        }
                    ],
                    "synonyms": [
