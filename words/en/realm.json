            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3879950e-2b97-3041-b807-8e4664f89d2b",
                    "sense_definition": "A specific area of interest, activity, knowledge, or influence.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_domain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These complex theories belong to the <w>realm</w> of philosophy rather than practical science.",
                            "target_lang_translations": {
                                "ru": "Эти сложные теории относятся к <w>области</w> философии, а не к прикладной науке.",
                                "de": "Diese komplexen Theorien gehören eher in den <w>Bereich</w> der Philosophie als in die praktische Wissenschaft."
                            }
                        },
                        {
                            "text": "Achieving such a result is completely within the <w>realm</w> of possibility.",
                            "target_lang_translations": {
                                "ru": "Достижение такого результата находится вполне в <w>сфере</w> возможного.",
                                "de": "Das Erreichen eines solchen Ergebnisses liegt durchaus im <w>Bereich</w> des Möglichen."
                            }
                        }
                    ],
                    "synonyms": [
                        "field",
                        "province"
                    ],
                    "common_phrases": [
                        "realm of possibility",
                        "realm of science",
                        "realm of imagination",
                        "public realm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная область интересов, деятельности, знаний или влияния.",
                        "de": "Ein spezifischer Bereich von Interesse, Aktivität, Wissen oder Einfluss."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о́бласть",
                                "target_lang_sense_clarification": "сфера деятельности или знаний"
                            },
                            {
                                "target_lang_word": "сфе́ра",
                                "target_lang_sense_clarification": "пределы распространения или влияния"
                            },
                            {
                                "target_lang_word": "мир",
                                "target_lang_sense_clarification": "перен. среда или совокупность явлений"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bereich",
                                "target_lang_sense_clarification": "allgemeiner Begriff für ein Gebiet oder Feld"
                            },
                            {
                                "target_lang_word": "Gebiet",
                                "target_lang_sense_clarification": "spezifisches Wissens- oder Tätigkeitsfeld"
                            },
                            {
                                "target_lang_word": "Sphäre",
                                "target_lang_sense_clarification": "gehobener Ausdruck für einen Wirkungs- oder Einflussbereich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e66b72ee-dc08-3399-bbb9-3b4d52c7cefd",
                    "sense_definition": "A country or state, particularly one ruled by a king or queen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king vowed to defend his <w>realm</w> against any invading forces.",
                            "target_lang_translations": {
                                "ru": "Король поклялся защищать свое <w>королевство</w> от любых сил вторжения.",
                                "de": "Der König schwor, sein <w>Reich</w> gegen jede Invasionsmacht zu verteidigen."
                            }
                        },
                        {
                            "text": "Knights traveled across the <w>realm</w> to serve their sovereign.",
                            "target_lang_translations": {
                                "ru": "Рыцари путешествовали по всему <w>королевству</w>, чтобы служить своему государю.",
                                "de": "Ritter reisten durch das ganze <w>Reich</w>, um ihrem Herrscher zu dienen."
                            }
                        }
                    ],
                    "synonyms": [
                        "kingdom",
                        "country",
                        "land"
                    ],
                    "common_phrases": [
                        "defense of the realm",
                        "peer of the realm",
                        "laws of the realm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страна или государство, особенно управляемое королем или королевой.",
                        "de": "Ein Land oder Staat, insbesondere eines, das von einem König oder einer Königin regiert wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короле́вство",
                                "target_lang_sense_clarification": "монархическое государство"
                            },
                            {
                                "target_lang_word": "ца́рство",
                                "target_lang_sense_clarification": "государство во главе с царем"
                            },
                            {
                                "target_lang_word": "госуда́рство",
                                "target_lang_sense_clarification": "страна, политическое образование"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Reich",
                                "target_lang_sense_clarification": "allgemeiner Begriff für ein Herrschaftsgebiet"
                            },
                            {
                                "target_lang_word": "Königreich",
                                "target_lang_sense_clarification": "Staat, der von einem König regiert wird"
                            }
                        ]
                    }
                }
            ]
        }
    ]
