                        "examples": [
                            {
                                "example_id": "a3afc692-4d6c-494d-9429-89f0a77d6b05",
                                "sense_id": "7c4873f4-0946-3efe-a922-6753cda059f9",
                                "text": "Pourtant, la faculté de choix, loin d’être fondée sur une affectivité pure, requiert dans les faits un dispositif affectif et cognitif complexe pour évaluer les partenaires, pour s’autoconsulter sur ce que l’on ressent, et prévoir sa propre capacité à soutenir ces émotions."
                            },
                            {
                                "example_id": "9cc2a8e9-dc63-42e7-b82e-1ebb6f2fa849",
                                "sense_id": "7c4873f4-0946-3efe-a922-6753cda059f9",
                                "text": "Ohsawa invite chacun de nous à « s'autoconsulter et à se demander à quel niveau il peut encore progresser »."
                            },
                            {
                                "example_id": "45af11de-3b8c-48e2-95e0-9312b57697e6",
                                "sense_id": "7c4873f4-0946-3efe-a922-6753cda059f9",
                                "text": "Il permet aussi de s'autoconsulter et peut indiquer dans quelles dispositions nous sommes."
                            }
                        ]
                    }
