            "senses": [
                {
                    "sense_id": "e5d81d35-a2e9-3c2e-8b1b-774ae430695c",
                    "sense_definition": "The aromatic leaves of the marjoram plant, often dried and used as a culinary seasoning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add a pinch of dried <w>marjoram</w> to the soup for extra flavour.",
                            "target_lang_translations": {
                                "pl": "Dodaj do zupy szczyptę suszonego <w>majeranku</w>, aby nadać jej dodatkowego smaku."
                            }
                        },
                        {
                            "text": "She seasoned the roasted vegetables with fresh <w>marjoram</w> and olive oil.",
                            "target_lang_translations": {
                                "pl": "Doprawiła pieczone warzywa świeżym <w>majerankiem</w> i oliwą z oliwek."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dried marjoram",
                        "sweet marjoram"
                    ],
                    "target_lang_definitions": {
                        "pl": "Aromatyczne liście majeranku, często suszone i używane jako przyprawa kuchenna."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "majeranek",
                                "target_lang_sense_clarification": "przyprawa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "421c024d-bccd-3140-86ae-b779f561082d",
                    "sense_definition": "An aromatic herb of the mint family (Origanum majorana) cultivated for its fragrant foliage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We planted sweet <w>marjoram</w> alongside the basil and rosemary in our garden.",
                            "target_lang_translations": {
                                "pl": "Posadziliśmy w naszym ogrodzie <w>majeranek</w> ogrodowy obok bazylii i rozmarynu."
                            }
                        },
                        {
                            "text": "The bees were attracted to the small white blossoms of the <w>marjoram</w>.",
                            "target_lang_translations": {
                                "pl": "Pszczoły wabiły małe, białe kwiaty <w>majeranku</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "amaracus"
                    ],
                    "common_phrases": [
                        "pot marjoram",
                        "wild marjoram"
                    ],
                    "target_lang_definitions": {
                        "pl": "Aromatyczna roślina zielna z rodziny jasnotowatych (Origanum majorana), uprawiana ze względu na pachnące liście."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "majeranek",
                                "target_lang_sense_clarification": "roślina"
                            },
                            {
                                "target_lang_word": "majeranek ogrodowy",
                                "target_lang_sense_clarification": "nazwa botaniczna rośliny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "11c9b072-974a-389f-9f52-d51f129bee38",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Marjoram</w> attended the annual board meeting yesterday afternoon.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Marjoram</w> uczestniczył wczoraj po południu w dorocznym posiedzeniu zarządu."
                            }
                        },
                        {
                            "text": "The local library was named after the <w>Marjoram</w> family in recognition of their donation.",
                            "target_lang_translations": {
                                "pl": "Miejscowej bibliotece nadano imię rodziny <w>Marjoram</w> w uznaniu za ich darowiznę."
                            }
                        }
                    ],
