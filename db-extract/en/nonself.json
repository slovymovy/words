                        "glosses": [
                            "Any entity other than oneself."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ea9e96fe-cfaf-400a-9a4c-0816ab677861",
                                "sense_id": "dc785011-ace7-360c-af6a-b1d4a0d032ec",
                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c173638-31eb-3190-b5d0-61a24e4f414f",
                        "entry_id": "5b93b47d-7eeb-3061-8402-049cf08ac1b2",
                        "glosses": [
                            "All agents and substances that are not the body's own."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "47ee8cb0-8c6e-453e-9270-8774d7cbb557",
                                "sense_id": "4c173638-31eb-3190-b5d0-61a24e4f414f",
                                "text": "In his classic monograph describing the clonal selection theory of the immune response, Burnet (1959) suggested that the immune system distinguishes between self (no antibody response) and nonself (antibody response)."
                            }
                        ]
                    },
