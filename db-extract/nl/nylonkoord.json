                "senses": [
                    {
                        "sense_id": "e6638f83-40f4-3dca-a5f8-37f016b1c8af",
                        "entry_id": "57a16272-7b8a-3b0e-9d69-f668cf3bb6d5",
                        "glosses": [
                            "een touw of snoer gemaakt van nylonvezels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b38e51e-432b-458b-8763-affc32f57588",
                                "sense_id": "e6638f83-40f4-3dca-a5f8-37f016b1c8af",
                                "text": "De tapijtbranche wordt van vele kanten bestormd met nieuwe ideeën. Er wordt gewerkt met ‘vreemde’ materialen zoals binnenbanden van fietsen en auto’s, resten leer, gebreide viltstrengen, oude dekens en nylonkoord. Maar er wordt nog steeds op grote schaal met de hand geknoopt in landen als Iran, Afghanistan en Nepal."
                            },
                            {
                                "example_id": "16b6692d-9aa7-4c56-82f0-72b18bed5480",
                                "sense_id": "e6638f83-40f4-3dca-a5f8-37f016b1c8af",
                                "text": "`De mannen waren in poncho's gewikkeld, hier en daar slordig dichtgebonden met een nylonkoord, en ingeladen [..]"
                            },
                            {
                                "example_id": "34f190a7-e21a-41e6-b233-5dda0d5cf13e",
                                "sense_id": "e6638f83-40f4-3dca-a5f8-37f016b1c8af",
                                "text": "Ook bij het werken in zijn tuin kan de moderne mens zich elektronisch laten assisteren. Elektrische grasmaaiers en heggenscharen hebben gezelschap gekregen van kettingzagen, hogedrukspuiten, bladblazers en grastrimmers - dat zijn grasmaaiers die werken met een rondzwiepend nylonkoord."
                            }
                        ]
                    }
