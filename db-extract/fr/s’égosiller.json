                "senses": [
                    {
                        "sense_id": "814f41ed-b135-394d-9592-fba73f5086da",
                        "entry_id": "928b4c32-d9c4-3a4a-beea-414d04fc9757",
                        "glosses": [
                            "Forme pronominale de égosiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41cf129c-452f-45fe-a924-46ab0c910963",
                                "sense_id": "814f41ed-b135-394d-9592-fba73f5086da",
                                "text": "Les oiseaux s’égosillaient autour de la maison forestière, le soleil montait entre les cimes des sapins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c56ef80-98b7-4e03-af42-ad44d7914ef5",
                        "source_entry_id": "928b4c32-d9c4-3a4a-beea-414d04fc9757",
                        "source_sense_id": "814f41ed-b135-394d-9592-fba73f5086da",
                        "target_lang_word": "sgolarsi",
