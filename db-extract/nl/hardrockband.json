                        "examples": [
                            {
                                "example_id": "ccff6c55-8dcf-485e-8282-9e06f993711f",
                                "sense_id": "08d270dd-0c01-38c4-9c7a-47c32e504c55",
                                "text": "Als staatssecretaris in het kabinet-Rutte I was hij verantwoordelijk voor forse bezuinigingen op de cultuursector. Die bezuinigingen maakten hem in combinatie met de kennelijke gretigheid waarmee hij ze doorvoerde gehaat in de sector. Dat hij naar hardrockband Metallica luistert en thrillerschrijver Dan Brown leest, maakte het er niet beter op; dat maakte hem volgens critici tot een cultuurbarbaar."
                            },
                            {
                                "example_id": "6c69b82f-18dc-48dd-96fc-10d27cf2cd18",
                                "sense_id": "08d270dd-0c01-38c4-9c7a-47c32e504c55",
                                "text": "Tijdens zijn reizen bezocht hij onder andere een honkbalwedstrijd van de Boston Red Sox, ging een stukje varen op de Atlantische Oceaan en verbleef enkele dagen bij een hardrockband."
                            }
                        ]
                    }
