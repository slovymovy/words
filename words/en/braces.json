{
    "word_family": [
        "brace",
        "bracing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39e12165-0d3c-301c-b4e6-1927948af9e3",
                    "sense_definition": "A device worn on the teeth to straighten them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Susy has to go to the dentist to see if she needs <w>braces</w>.",
                            "target_lang_translations": {
                                "ru": "Сьюзи должна пойти к стоматологу, чтобы узнать, нужны ли ей <w>брекеты</w>."
                            }
                        },
                        {
                            "text": "The teenager felt self-conscious about her new dental <w>braces</w>.",
                            "target_lang_translations": {
                                "ru": "Подросток стеснялась своих новых <w>брекетов</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dental braces"
                    ],
                    "common_phrases": [
                        "wear braces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ортодонтическая конструкция для исправления прикуса и выравнивания зубов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бре́кеты",
                                "target_lang_sense_clarification": "ортодонтическая система для зубов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d10e220-b81c-352d-bf6a-8d80ee0a53e5",
                    "sense_definition": "A pair of straps crossing one's shoulders to hold up trousers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a pair of <w>braces</w> to keep his trousers in place.",
                            "target_lang_translations": {
                                "ru": "Он носил <w>подтяжки</w>, чтобы брюки не спадали."
                            }
                        },
                        {
                            "text": "The old man adjusted his suspenders and <w>braces</w> before leaving.",
                            "target_lang_translations": {
                                "ru": "Старик поправил свои <w>подтяжки</w> перед уходом."
                            }
                        }
                    ],
                    "synonyms": [
                        "suspenders"
                    ],
                    "common_phrases": [
                        "wear braces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пара ремней, перекинутых через плечи для поддержания брюк."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтяжки",
                                "target_lang_sense_clarification": "аксессуар для поддержания брюк"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95fc4e27-2843-3ead-afc9-f16f39460dbf",
                    "sense_definition": "Handcuffs used to restrain a person.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer put the suspect in <w>braces</w>.",
                            "target_lang_translations": {
                                "ru": "Полицейский надел на подозреваемого <w>наручники</w>."
                            }
                        },
                        {
                            "text": "The criminal was locked in heavy manacles and <w>braces</w>.",
                            "target_lang_translations": {
                                "ru": "Преступник был закован в тяжелые кандалы и <w>оковы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "manacles"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This term for handcuffs is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее название наручников или оков для ограничения движений."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "296843a6-8ece-34aa-84cf-383896f3b000",
