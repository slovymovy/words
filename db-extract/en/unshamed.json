                        "sense_id": "8beeaca1-63ad-307c-8895-16868d2b7530",
                        "entry_id": "fd2918be-2224-3aef-b1cb-aefc0d5c94a6",
                        "glosses": [
                            "Not shamed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cee6d69b-0023-42ab-af50-c9ae70b9635f",
                                "sense_id": "8beeaca1-63ad-307c-8895-16868d2b7530",
                                "text": "[Oscar] Wilde, being a first-class subversive, implies that the Wicked Lady, an unshamed adventureress and serial lover, ought be admired for the courage of her convictions: by contrast he mocks the aristocrats as immoralists desperate to be caught in a good light."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aeed258-1dee-420a-ac35-b83ba510ff6e",
                        "source_entry_id": "fd2918be-2224-3aef-b1cb-aefc0d5c94a6",
                        "source_sense_id": "8beeaca1-63ad-307c-8895-16868d2b7530",
                        "source_sense_description": "unshamed",
                        "target_lang_word": "unverschämt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverschämt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "im Verhalten und in den Äußerungen provozierend und/oder auch aggressiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ed7b73-5f57-4a55-bec4-b3e8a90509a7",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "Das ist ein unverschämter Angriff gegen die gesamte Stadt und schadet dem Wirtschaftsstandort Köln."
                                            },
                                            {
                                                "example_id": "6c99ab81-7937-4449-a687-2d8f7466c46d",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "Werd bloß nicht unverschämt!"
                                            },
                                            {
                                                "example_id": "1ed31b8e-29d1-44c8-b75d-b3276225d134",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "„In Amerika hingegen ist der Depp in unverschämter Weise stolz auf seine Dummheit, so sehr, dass er letztlich zum Führer politischer Diskurse und ideologisch dominanter Fraktionen einer ganzen Partei werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "verstärkend, betonend, hervorhebend: über ein übliches Maß hinausgehend, sehr groß/intensiv; übermäßig, überaus, sehr, allzu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd7a2d6-2586-4599-8066-9224531c146d",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Du hast unverschämt viel Glück."
                                            },
                                            {
                                                "example_id": "8bf8e22c-7313-4158-8364-2eceeddea44e",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Das ist unverschämt teuer."
                                            },
                                            {
                                                "example_id": "0bf63e29-b186-462f-a7ec-2f70ce13228b",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Du siehst unverschämt gut aus."
                                            },
                                            {
                                                "example_id": "a7ebf312-1331-46f0-ada2-8b8d8d6c2cf0",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "„Die fragmentierende, auch unverschämt komische, halsbrecherisch Töne und Themen konfrontierende Technik Hemons verstärkt seinen kräftigen Appell, den der Muslim Rora ausspricht: Diesseits des Bildes zu bleiben.“"
                                            },
                                            {
                                                "example_id": "5c329984-6c78-4066-adcf-04e58b2e51df",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "»Da haben Sie unverschämtes Glück gehabt, dass mein Kollege die Dame oder Sie offenbar kennt!«"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "sich sittlich und moralisch nicht gesellschaftskonform verhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c023cd-9827-4ea8-b1ea-fd9331d9f129",
                                                "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                                "text": "Dieses Mädchen zeigt sich unverschämt, es schämt sich nicht im geringsten mit der Entblößung ihres Busens und ihrer Waden."
                                            },
                                            {
                                                "example_id": "6aa4b863-7f60-44d8-a631-79ecda53f036",
                                                "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                                "text": "Das Fräulein ist eine verwöhnte und unverschämte Göre, die allen schöne Augen macht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf6db326-1006-49c9-b7b7-b989793ba9e7",
                        "source_entry_id": "fd2918be-2224-3aef-b1cb-aefc0d5c94a6",
                        "source_sense_id": "8beeaca1-63ad-307c-8895-16868d2b7530",
                        "source_sense_description": "unshamed",
                        "target_lang_word": "schamlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schamlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                        "entry_id": "f60c6356-4d27-3867-b037-fa8552696e3e",
                                        "glosses": [
                                            "ohne Schamgefühl, die sittlichen Grenzen, die Regeln des Anstands verletzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8cbce5-1c66-486b-bdb3-66997c89cacc",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Diesmal wird sogar schamlos geflirtet."
                                            },
                                            {
                                                "example_id": "9e1bf7ce-0826-4ac1-9ca5-c350730760b4",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Durch die schamlose Performance scheint das Flair von Homosexualität, Perversität im Hochglanz, öffentlich zur Schau gestellter Nacktheit, Erotik und Befriedigung, … als Normalität und wird als Fest der Toleranz, Freiheit und Liebe gepriesen."
                                            },
                                            {
                                                "example_id": "8f98d42f-5d7e-47d2-919a-141785ebcacb",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Wer seid Ihr, daß Ihr eine züchtige Frau, die, weiß Gott, nicht ihr freier Wille mit Euch zusammenführte, in Eure Arme zu fassen, ihr Ohr mit den schamlosen Anträgen roher Sinnlichkeit zu entweihen wagt?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                        "entry_id": "f60c6356-4d27-3867-b037-fa8552696e3e",
                                        "glosses": [
                                            "in der Handlungsweise die Rechte oder Gefühle anderer Menschen bewusst ignorierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dede07c-888a-4d20-a8cf-38bd8b760917",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Mit „Antikorruptionskampagnen“ versuchen sie jene Kader in den Griff zu bekommen, die sich schamlos bereichert haben – auch am Olympia-Projekt."
                                            },
                                            {
                                                "example_id": "be9803b6-fcf6-48ec-b74b-b220164bbe9a",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Die Farce erreichte ihren Gipfel, als Sudans Justizminister Reparationen für die Sklaverei forderte, während in seinem Land weiterhin schamlos Menschen versklavt werden."
                                            },
                                            {
                                                "example_id": "a992b06c-1b53-443a-a001-2b3922fefab8",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Der reiche Ausländer nutzt die Notsituation von Frauen und Kindern, die in Krisengebieten ums Überleben kämpfen, schamlos aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
