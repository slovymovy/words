    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc08cb37-7bfa-34e7-98f6-8229583e4493",
                    "sense_definition": "Having a fever or an elevated body temperature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "feverish_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sick child felt <w>feverish</w> and needed to rest in bed.",
                            "target_lang_translations": {
                                "ru": "Больной ребенок чувствовал себя <w>лихорадочно</w> и ему нужно было отдохнуть в постели."
                            }
                        },
                        {
                            "text": "She became <w>feverish</w> after spending the whole day in the hot sun.",
                            "target_lang_translations": {
                                "ru": "Она стала <w>разгоряченной</w> после того, как провела весь день на жарком солнце."
                            }
                        }
                    ],
                    "synonyms": [
                        "febrile"
                    ],
                    "common_phrases": [
                        "feel feverish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором у человека повышенная температура тела или жар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадочный",
                                "target_lang_sense_clarification": "связанный с жаром или болезнью"
                            },
                            {
                                "target_lang_word": "разгоряченный",
                                "target_lang_sense_clarification": "ощущающий жар, например, от солнца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e749f4bb-ce58-3b56-8f9d-8d46ab0f2af4",
                    "sense_definition": "Characterized by intense, restless, or uncontrolled energy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feverish_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team worked with <w>feverish</w> activity to finish the project before the deadline.",
                            "target_lang_translations": {
                                "ru": "Команда работала с <w>лихорадочной</w> активностью, чтобы закончить проект до истечения срока."
                            }
                        },
                        {
                            "text": "There was a <w>feverish</w> pace to the preparations for the grand opening.",
                            "target_lang_translations": {
                                "ru": "Подготовка к торжественному открытию шла в <w>лихорадочном</w> темпе."
                            }
                        }
                    ],
                    "synonyms": [
                        "frantic",
                        "hectic"
                    ],
                    "common_phrases": [
                        "feverish activity",
                        "feverish pace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся интенсивной, беспокойной или неконтролируемой энергией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадочный",
                                "target_lang_sense_clarification": "очень быстрый, суетливый, напряженный"
                            },
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "очень интенсивный, стремительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "812796e3-58fc-3448-9188-884b9fcd40c9",
                    "sense_definition": "Showing an intense, often unhealthy or obsessive level of eagerness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "feverish_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>feverish</w> desire to prove his critics wrong at any cost.",
                            "target_lang_translations": {
                                "ru": "У него было <w>лихорадочное</w> желание доказать критикам, что они неправы, любой ценой."
                            }
                        },
                        {
                            "text": "The fans showed a <w>feverish</w> interest in the celebrity's private life.",
                            "target_lang_translations": {
                                "ru": "Поклонники проявляли <w>лихорадочный</w> интерес к личной жизни знаменитости."
                            }
                        }
                    ],
                    "synonyms": [
                        "obsessive",
                        "fanatical"
                    ],
                    "common_phrases": [
                        "feverish desire",
                        "feverish interest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление сильного, часто нездорового или навязчивого стремления к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадочный",
                                "target_lang_sense_clarification": "навязчивый, болезненно сильный"
                            },
                            {
                                "target_lang_word": "фанатичный",
                                "target_lang_sense_clarification": "чрезмерно увлеченный, одержимый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
