                "senses": [
                    {
                        "sense_id": "07e4808c-e640-3ccc-b87b-b2307384318e",
                        "entry_id": "74275e64-4b57-309c-98b9-74923ef02369",
                        "glosses": [
                            "geneigd de wensen van een ander in te willigen ook als je het er eigenlijk niet mee eens bent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5cdb7cf-18ae-4330-bf32-93ead3cd5704",
                                "sense_id": "07e4808c-e640-3ccc-b87b-b2307384318e",
                                "text": "Clinton, zo luidde de Republikeinse redenering, was tijdens de eerste termijn van Obama als president de minister van Buitenlandse Zaken. Haar zachte en toegevende houding en politiek als bewindsvrouw destijds hebben nu geleid tot de atoomproef."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6522e544-08e2-4a7d-94ed-c84dc4e22469",
                        "source_entry_id": "74275e64-4b57-309c-98b9-74923ef02369",
                        "source_sense_id": "07e4808c-e640-3ccc-b87b-b2307384318e",
                        "source_sense_description": "geneigd de wensen van een ander in te willigen ook als je het er eigenlijk niet mee eens bent",
                        "target_lang_word": "good-hearted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "good-hearted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51c0da06-44fa-36d8-a904-7c5eb549f9a1",
                                        "entry_id": "cc2a9d35-122b-3e9f-a2d0-230e5839abf9",
                                        "glosses": [
                                            "Kind and well-intentioned."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbd76959-7dcd-4657-9b79-b5a85529878a",
                                                "sense_id": "51c0da06-44fa-36d8-a904-7c5eb549f9a1",
                                                "text": "Good-hearted fellows in their way, true to each other, and invariably gentle and courteous to women, is the much-maligned and misunderstood digger."
                                            },
                                            {
                                                "example_id": "0bc30073-664f-47c6-84fe-5f08536c52f0",
                                                "sense_id": "51c0da06-44fa-36d8-a904-7c5eb549f9a1",
                                                "text": "It’s sweet of you to forgive her, Emily dear. You are better-hearted than I am. I’m afraid I could never pardon any one who had made me such a laughing stock."
                                            },
                                            {
                                                "example_id": "4991d684-9a5e-4e2e-8275-d4562fb98fa9",
                                                "sense_id": "51c0da06-44fa-36d8-a904-7c5eb549f9a1",
                                                "text": "‘My pa is the best-hearted man in all of London,’ Lottie said, spooning pease pudding onto the plates. ‘He’s never turned anyone from the door or walked past a beggar on the streets.’"
                                            },
                                            {
                                                "example_id": "51f042f3-48c9-41c2-bec5-cd544e0596d5",
                                                "sense_id": "51c0da06-44fa-36d8-a904-7c5eb549f9a1",
                                                "text": "But Pirates! comes with all the usual Aardman strengths intact, particularly the sense that its characters and creators alike are too good-hearted and sweet to nitpick. The ambition is all in the craft rather than in the storytelling, but it’s hard to say no to the proficiency of that craft, or the mild good cheer behind it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d83cfef1-f673-4288-b308-c32d4c24e3ca",
                        "source_entry_id": "74275e64-4b57-309c-98b9-74923ef02369",
                        "source_sense_id": "07e4808c-e640-3ccc-b87b-b2307384318e",
