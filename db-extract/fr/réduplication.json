        "fr-extract.jsonl": [
            {
                "entry_id": "15147255-3679-3d85-ba47-e9e9cfb614ba",
                "word": "réduplication",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5158ac08-256a-4a34-82fd-1672552977df",
                        "entry_id": "15147255-3679-3d85-ba47-e9e9cfb614ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "réduplications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c3561cf-292d-302c-b0ea-64426ef700a3",
                        "entry_id": "15147255-3679-3d85-ba47-e9e9cfb614ba",
                        "glosses": [
                            "Répétition à l’identique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6def45d-ca6e-43f8-a83e-67ffa48779ce",
                                "sense_id": "5c3561cf-292d-302c-b0ea-64426ef700a3",
                                "text": "Pour nous, le problème n’est pas d’une utopique et stérile tentative de réduplication, mais d’un dépassement."
                            },
                            {
                                "example_id": "4f467652-ba98-4944-b57d-8b5f279afaa6",
                                "sense_id": "5c3561cf-292d-302c-b0ea-64426ef700a3",
                                "text": "En biologie, on considère la capacité de réduplication comme un caractère essentiel de la vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f9f891b-3b80-3619-8eef-154035a86aeb",
                        "entry_id": "15147255-3679-3d85-ba47-e9e9cfb614ba",
                        "glosses": [
                            "Répétition d’un élément : lettre, syllabe, mot, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb4c177-2a25-46cf-b196-6f2d600dbf3f",
                                "sense_id": "2f9f891b-3b80-3619-8eef-154035a86aeb",
                                "text": "L’intensité du sentiment peut être marquée par la réduplication qui est une des formes habituelles de l’emphase. On dit alors : Bon Dieu de Bon Dieu."
                            },
                            {
                                "example_id": "ace94a03-a0be-4e1a-8dd3-8b0149c3b94b",
                                "sense_id": "2f9f891b-3b80-3619-8eef-154035a86aeb",
                                "text": "Puisque le mot Baqbuq signifie en hébreu «bouteille», parler de la dive Bouteille Bacbuc revient à dire la dive Bouteille Bouteille, réduplication que l'on pourrait interpréter comme un ornement oriental, un feston linguistique ajouté à la polyglossie du texte rabelaisien."
                            },
                            {
                                "example_id": "d36dc30e-c692-4cb8-a619-9372fb0035f3",
                                "sense_id": "2f9f891b-3b80-3619-8eef-154035a86aeb",
                                "text": "Caca, dodo et pipi sont des exemples typiques de mots nés par réduplication d’une syllabe."
                            },
                            {
                                "example_id": "a85a2780-a2d9-42c7-aacd-a8455ae0685c",
                                "sense_id": "2f9f891b-3b80-3619-8eef-154035a86aeb",
                                "text": "« Ce n’est pas du joli joli, dites donc ! » est un effet de style par réduplication de mot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2151e94-c5b9-4dba-8cec-233339ca1492",
                        "source_entry_id": "15147255-3679-3d85-ba47-e9e9cfb614ba",
                        "source_sense_description": "Biologie",
                        "target_lang_word": "Reduplikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reduplikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44cf6596-1a02-33d2-bdc2-8fc552f760a0",
                                        "entry_id": "90ee21ff-db85-3822-bd2e-46d639be0380",
                                        "glosses": [
                                            "Flexion oder Wortbildung durch Wiederholung eines Wortes oder Wortteils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6000665c-82ac-44ed-9fe7-0ebc3cf0e56e",
                                                "sense_id": "44cf6596-1a02-33d2-bdc2-8fc552f760a0",
                                                "text": "Die Wortbildungen \"klein-klein\", \"Kuckuck\", \"zackzack\" sind Reduplikationen. Im Gotischen zeigen reduplizierende Verben im Präteritum Reduplikation: haihald (ich) \"hielt\" zu halda \"halten\"."
                                            },
                                            {
                                                "example_id": "16f64a37-5ef0-419a-acbc-6c9aa3141b20",
                                                "sense_id": "44cf6596-1a02-33d2-bdc2-8fc552f760a0",
                                                "text": "Reduplikationen kommen in mehreren Formen vor: einfache Doppelung (Wiederholung gleicher Teile: Wiederholung von Affixen: ur- in Ururoma, von Silben: Kuckuck, von Lexemen Wehweh (dieser letzte Fall ist ein Autokompositum/Selbstkompositum)), Ablautdoppelung (Wiederholung mit Ablaut: Singsang), Reimdoppelung (Wiederholung mit gleichem Auslaut/ gleicher Auslautgruppe: Kuddelmuddel) und Kombination von Ablaut- und Reimdoppelung: Dingsbums)."
                                            },
                                            {
                                                "example_id": "3787a86f-2d9a-4106-9b89-abc3d742c875",
                                                "sense_id": "44cf6596-1a02-33d2-bdc2-8fc552f760a0",
                                                "text": "Reduplikationen einiger Präfixe können nahezu beliebig erweitert werden, wie die folgenden Beispiele zeigen: „Zwei von ihnen sind Urururururururururururururgroßneffen einer Hexe.“ „Legendär ist etwa die Moskauvisite von Söders Vorvorvorvorvorgänger Franz Josef Strauß, der 1987 mit einer Cessna die russische Radarüberwachung unterflog, direkt vor dem Kreml auf dem Roten Platz landete und den verdutzten Michail Gorbatschow von der deutschen Wiedervereinigung überzeugte sowie zur Auflösung der Sowjetunion überredete.“"
                                            },
                                            {
                                                "example_id": "bf5c54af-1e3d-4f72-8693-98759a5c91f7",
                                                "sense_id": "44cf6596-1a02-33d2-bdc2-8fc552f760a0",
                                                "text": "„Immerhin gilt es festzuhalten, daß im Vorgermanischen nicht ausschließlich der Ablaut oder die Reduplikation tempustragend sind, sondern eine zumindest doppelte Tempuskennzeichnung vorliegt, im Stamm (beziehungsweise einer Vorsilbe) und in der Endung.“"
                                            },
                                            {
                                                "example_id": "ecb85c1c-71bc-49cc-bcbd-13b260d14515",
                                                "sense_id": "44cf6596-1a02-33d2-bdc2-8fc552f760a0",
                                                "text": "„Wie Infigierung so ist auch Reduplikation nicht notwendig auf eine Konstituente bezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a75ff1b-bca7-4c11-825e-d5359f0d96e7",
                        "source_entry_id": "15147255-3679-3d85-ba47-e9e9cfb614ba",
                        "source_sense_description": "Biologie",
                        "target_lang_word": "Replikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Replikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff28aaba-d51e-3a94-bd49-ca7ce2381a97",
                                        "entry_id": "920ebe0f-36a4-33f3-95e3-b40f85bf1467",
                                        "glosses": [
                                            "zelluläre Synthese; Erzeugen einer Kopie durch Verdoppelung genetischen Materials (DNA/RNA), zum Beispiel eines Chromosoms oder Virus"
                                        ],
                                        "tags": [
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee7395e-764f-482a-94b9-4c84ba392c11",
                                                "sense_id": "ff28aaba-d51e-3a94-bd49-ca7ce2381a97",
                                                "text": "Nachdem das Virus in die Wirtszelle eingedrungen ist, wird die Replikation eingeleitet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1330d33d-a5e5-3bf4-a962-cf7c1e0fab2e",
                                        "entry_id": "920ebe0f-36a4-33f3-95e3-b40f85bf1467",
                                        "glosses": [
                                            "Wiederholung einer wissenschaftlichen Studie oder eines Versuchs (mit anderen Populationen oder Versuchsanordnungen, letztlich zur Qualitätssicherung des ersten Ergebnisses)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14f0a9d-b1b5-4283-b47a-56f35018eafb",
                                                "sense_id": "1330d33d-a5e5-3bf4-a962-cf7c1e0fab2e",
                                                "text": "Um die Validität eines Experiments zu belegen oder zu hinterfragen, ist eine Replikation die geeignete Maßnahme."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
