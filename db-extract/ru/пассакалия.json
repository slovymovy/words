                                        "entry_id": "34a70bb2-357e-32ff-abdb-c5e099c57a13",
                                        "glosses": [
                                            "eine auf Variationen beruhende Gattung der Instrumentalmusik des 17. und 18. Jahrhunderts"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59005957-7417-4773-9e83-fe7c22b5da59",
                                                "sense_id": "5b2597f4-ef96-3a6d-b7a5-26c3dff0a3cf",
                                                "text": "„Die Passacaglia steht in der Regel im ¾-Takt und in Moll. G. Frescobaldi schrieb 1614 die ersten Passacaglien. […] Seit der Wiederbesinnung auf die Musik des Barock ist die Passacaglia eine gegenwärtige Form geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
