                "senses": [
                    {
                        "sense_id": "78027bcc-54b3-35bd-a54c-ea07f85a5cd5",
                        "entry_id": "80ddd068-2039-3ea6-b07a-6cc627660f4e",
                        "glosses": [
                            "opstand waar grote delen van de bevolking aan deelnemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc191422-26b6-4179-91e5-1a5ea7fa2b87",
                                "sense_id": "78027bcc-54b3-35bd-a54c-ea07f85a5cd5",
                                "text": "Man, een compleet volksoproer. Demonstratie van buurtbewoners tegen de bezetting."
                            },
                            {
                                "example_id": "531e5669-dfa7-4620-8c8a-d93792067407",
                                "sense_id": "78027bcc-54b3-35bd-a54c-ea07f85a5cd5",
                                "text": "Lam staat onder druk van Peking om een einde te maken aan de protesten die inmiddels als drie maanden aanhouden. Vorige week trok ze een omstreden wet in die uitlevering aan China makkelijker maakte. De wet was de directe aanleiding voor de volksoproer, maar het verzet een bredere uiting geworden van onvrede."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d539bea-e232-4242-9100-c46e3b706893",
                        "source_entry_id": "80ddd068-2039-3ea6-b07a-6cc627660f4e",
                        "source_sense_id": "78027bcc-54b3-35bd-a54c-ea07f85a5cd5",
