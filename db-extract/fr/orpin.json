                        "glosses": [
                            "Plante à feuilles charnues, à fleurs à cinq pétales, qui croît sur les toits, sur les murs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf657c9-90ed-49b6-af62-786c9712f6b0",
                                "sense_id": "add9ebba-7170-30f9-88ab-f62b63717e8c",
                                "text": "l'orpin âcre (ou orpin brûlant), l'orpin pourpier ( ou orpin paniculé ), l'orpin blanc, l'orpin reprise."
                            },
                            {
                                "example_id": "337fd216-3ce0-43da-bcc0-676209bd32a7",
                                "sense_id": "add9ebba-7170-30f9-88ab-f62b63717e8c",
                                "text": "Il y avait sur ce mur moussu un orpin mort, et près de l’orpin une seule fleur fanée."
                            }
                        ]
