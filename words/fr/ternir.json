                },
                {
                    "sense_id": "25263f47-e1ee-3a98-a79b-f59da59dc30b",
                    "sense_definition": "Dégrader ou entacher la réputation, l'honneur ou la valeur morale de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reputation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce scandale médiatique risque de <w>ternir</w> durablement la réputation de toute l'entreprise."
                        },
                        {
                            "text": "Une seule maladresse verbale a suffi pour <w>ternir</w> son image auprès des électeurs."
