                "senses": [
                    {
                        "sense_id": "a9c8968c-9625-3607-9edd-3eb2300be391",
                        "entry_id": "656a5894-9b4a-3764-8160-058dbdba91e7",
                        "glosses": [
                            "winzige Kohlensäurebläschen des Schaumweins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "152b90a1-e585-49cc-b3a9-f2c2036aa945",
                                "sense_id": "a9c8968c-9625-3607-9edd-3eb2300be391",
                                "text": "„Der Frizzante überzeugt durch Cremigkeit und feine Perlage, weit entfernt von der Laschheit vieler billiger, mit zusätzlicher Kohlensäure aufgemöbelter Prosecco-Abfüllungen.“"
                            },
                            {
                                "example_id": "f59f9c17-337f-4d55-a285-f0a2060d2430",
                                "sense_id": "a9c8968c-9625-3607-9edd-3eb2300be391",
                                "text": "„Er nimmt einen zweiten Schluck Rosé, bewundert kurz die feine Perlage und schon sprudelt es aus ihm heraus: ‚Eine Begegnung, ein Blick, ein Trost, ein Sonnenaufgang – jeder Tag ist ein Champagner-Tag.‘“"
                            },
                            {
                                "example_id": "e488204b-6ec1-4feb-8c77-e0d30d2562a0",
                                "sense_id": "a9c8968c-9625-3607-9edd-3eb2300be391",
                                "text": "„Dieser Riesling ist schonend versektet […] und besticht durch seine Rasse und Eleganz sowie seine feine Perlage. Sein Hefelager verleiht ihm seine besondere Finesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a24c446-1149-498a-a367-7fe9ca3a2b5d",
                        "source_entry_id": "656a5894-9b4a-3764-8160-058dbdba91e7",
                        "source_sense_id": "a9c8968c-9625-3607-9edd-3eb2300be391",
