            "senses": [
                {
                    "sense_id": "a1fa2552-3edc-3e85-bb61-dc6db7cae4b9",
                    "sense_definition": "dopełniacz liczby mnogiej rzeczownika <w>reszta</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reszta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W sklepie nie miałem drobnych i nie wziąłem <w>reszt</w> od sprzedawcy.",
                            "target_lang_translations": {
                                "ru": "В магазине у меня не было мелочи, и я не взял <w>сдачи</w> у продавца."
                            }
                        },
                        {
                            "text": "Po obiedzie nie zostało na talerzu ani śladu po porcjach dla <w>reszt</w> gości.",
                            "target_lang_translations": {
                                "ru": "После обеда на тарелке не осталось ни следа от порций для <w>остальных</w> гостей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma fleksyjna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "родительный падеж множественного числа существительного reszta (сдача, остаток, остальные)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдача",
                                "target_lang_sense_clarification": "деньги, возвращаемые покупателю"
                            },
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "то, что осталось"
                            },
                            {
                                "target_lang_word": "остальные",
                                "target_lang_sense_clarification": "прочие люди или предметы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80050926-cdfb-3ae2-83ec-799e2a02d546",
                    "sense_definition": "dług lub należność pieniężna pozostała do spłacenia",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musiał szybko oddać stary <w>reszt</w>, żeby nie narobić sobie kłopotów u sąsiada.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось быстро отдать старый <w>долг</w>, чтобы не нажить неприятностей с соседом."
                            }
                        },
                        {
                            "text": "Gospodarz przypomniał mu, że ma jeszcze do spłacenia spory <w>reszt</w> za zeszłoroczne zboże.",
                            "target_lang_translations": {
                                "ru": "Хозяин напомнил ему, что он еще должен выплатить немалый <w>остаток долга</w> за прошлогоднее зерно."
                            }
                        }
                    ],
                    "synonyms": [
                        "dług",
                        "należność"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Śląsk Cieszyński"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Śląsk Cieszyński"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "денежный долг или остаток задолженности к выплате (диалектное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долг",
