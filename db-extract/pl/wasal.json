                ],
                "senses": [
                    {
                        "sense_id": "378083a2-0462-3c37-97d0-150300de7923",
                        "entry_id": "bf3a295d-2e18-38d4-9778-c7c074b664d7",
                        "glosses": [
                            "w feudalizmie: szlachcic, który złożył przysięgę innemu szlachcicowi (seniorowi), zobowiązując się do wierności, pomocy różnego rodzaju, a w zamian korzystając z jego ochrony"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd7f366-ce48-4568-bee7-74a10cc23897",
                                "sense_id": "378083a2-0462-3c37-97d0-150300de7923",
                                "text": "Książę miał pięciu hrabiów jako swoich wasali."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ac98d286-0835-33dc-bdfc-cb49959f1246",
                        "entry_id": "bf3a295d-2e18-38d4-9778-c7c074b664d7",
                        "glosses": [
                            "podmiot zależny od innego podmiotu"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "78a910d5-7529-4a16-91dd-0c51cc1e4622",
                                "sense_id": "ac98d286-0835-33dc-bdfc-cb49959f1246",
                                "text": "Po wojnie kraje te stały się wasalami ZSRR."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f5d0609-63c0-466c-a89a-3dfaec473d1f",
                        "source_entry_id": "bf3a295d-2e18-38d4-9778-c7c074b664d7",
                        "source_sense_id": "378083a2-0462-3c37-97d0-150300de7923",
                        "target_lang_word": "vassal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "The grantee of a fief, a subordinate granted use of a superior's land and its income in exchange for vows of fidelity and homage and (typically) military service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a965f84-2c43-4e99-82d9-0803ca37d772",
                                                "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                                "text": "The manor's vassals owed first fruits and a tithe to the parish church, another 10% to the lord (including at least 50 eels), a week or two each year of service in the manor's upkeep, and service in the local fyrd."
                                            },
                                            {
                                                "example_id": "b4b799b3-b741-4e22-ab2c-89cfc1e74be3",
                                                "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                                "text": "It was superimposed on rules of conduct evolved at an earlier date as the spontaneous expression of class consciousness; rules that pertained to the fealty of vassals (the transition appears clearly, towards the end of the eleventh century, in the Book of the Christian Life by Bishop Bonizo of Sutri, for whom the knight is, first and foremost, an enfeoffed vassal ) and constituted above all a class code of noble and 'courteous' people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e9627d-c5b2-37ab-9964-c0811cf65e98",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "Any direct subordinate bound by such vows to a superior."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987d95d0-2643-4277-a848-5049827766ff",
                                                "sense_id": "43e9627d-c5b2-37ab-9964-c0811cf65e98",
                                                "text": "The king ordered his vassals to join him on the crusade unless they had a written note signed by the archbishop or pope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8cbdcf-b007-31cc-b5f9-0ad851c0a846",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "Any subordinate bound by similar close ties."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9bd31b-b214-4e7f-9a35-2079ca74482f",
                                                "sense_id": "df8cbdcf-b007-31cc-b5f9-0ad851c0a846",
                                                "text": "The vassals of his anger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef0cbb18-91ef-3599-af3e-329eba5d61ef",
                                        "entry_id": "9b8a8a31-c627-390d-bf12-3de04a253adb",
                                        "glosses": [
                                            "Resembling a vassal; slavish; servile."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b896ca3f-6443-48a1-b504-57c03e438497",
                                                "sense_id": "ef0cbb18-91ef-3599-af3e-329eba5d61ef",
                                                "text": "Did they, quoth you? / Who sees the heavenly Rosaline / That, like a rude and savage man of Inde / At the first opening of the gorgeous east / Bows not his vassal head and strucken blind / Kisses the base ground with obedient breast?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc7bc11-dd6d-3cff-b506-003f13825228",
                                        "entry_id": "22fcb951-a5a4-322e-9f35-5bf78ae9ccea",
                                        "glosses": [
                                            "To treat as a vassal or to reduce to the position of a vassal; to subject to control; to enslave."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5d5eb00-d17e-306c-a467-8fc8dfa63dd8",
                                        "entry_id": "22fcb951-a5a4-322e-9f35-5bf78ae9ccea",
                                        "glosses": [
                                            "To subordinate to someone or something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a164e96d-1f4c-4fee-b83a-c99e3696cf23",
                        "source_entry_id": "bf3a295d-2e18-38d4-9778-c7c074b664d7",
                        "source_sense_id": "378083a2-0462-3c37-97d0-150300de7923",
                        "target_lang_word": "Vasall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vasall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb67889-9968-38af-99bd-10f657a4f6c0",
                                        "entry_id": "3bde0bd1-30dd-3e04-869f-543f0920bda1",
                                        "glosses": [
                                            "abhängiger Gefolgsmann, der von einem Lehnsherrn ein Lehen (Land und Amt) zugeordnet bekam und dafür Treue und Leistungen, wie militärische Gefolgschaft, zu erbringen hatte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef01d46-7a5c-46c9-91d8-4f61c5d4de44",
                                                "sense_id": "7fb67889-9968-38af-99bd-10f657a4f6c0",
                                                "text": "„Auch ein Fürst konnte Vasall sein und sich der Oberherrschaft eines anderen Fürsten unterwerfen.“"
                                            },
                                            {
                                                "example_id": "9e345c23-46b7-4389-ac30-b282d15bd24d",
                                                "sense_id": "7fb67889-9968-38af-99bd-10f657a4f6c0",
                                                "text": "„Auch die Sitze der ritterlichen Vasallen und Dienstmannen waren ursprünglich mehr oder weniger stark befestigt.“"
                                            },
                                            {
                                                "example_id": "373a8af2-d182-4406-9071-7a5f9a5c5d7f",
                                                "sense_id": "7fb67889-9968-38af-99bd-10f657a4f6c0",
                                                "text": "„Jahrhundertelang beherrschen die Osmanen und ihre Vasallen die nordafrikanische Küste – bis 1830 eine französische Armada Algier ansteuert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa3454bb-a148-316c-aaa3-721409e048c4",
                                        "entry_id": "3bde0bd1-30dd-3e04-869f-543f0920bda1",
                                        "glosses": [
                                            "treuer Anhänger und Gefolgsmann einer Person, Partei, Organisation oder dergleichen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e60407a-229f-4410-b3ac-853c8e115c45",
                                                "sense_id": "fa3454bb-a148-316c-aaa3-721409e048c4",
                                                "text": "„Trump hetzt gegen Justizminister Jeff Sessions, einen bislang treuen Vasallen und beinharten Konservativen, nur weil der getan hat, was Recht und Gesetz von ihm verlangen: Trump sieht gerade in der Rechtstreue seines Justizministers den Verrat.“"
                                            },
                                            {
                                                "example_id": "80a15322-6ea9-4ae2-a70b-5f15c9f684fb",
                                                "sense_id": "fa3454bb-a148-316c-aaa3-721409e048c4",
                                                "text": "„Dabei hatte Peking angeboten, den sonst so treuen südostasiatischen Vasallen zu versorgen.“"
                                            },
                                            {
                                                "example_id": "2327a2a4-0841-4929-8834-7f109a39f4b4",
                                                "sense_id": "fa3454bb-a148-316c-aaa3-721409e048c4",
                                                "text": "„Zu denen, die eigentlich dazu berufen sind, Trump auf das Ende der […] Regentschaft vorzubereiten, zählen seine Vasallen Mark Meadows und Mike Pence.“"
                                            },
                                            {
                                                "example_id": "1fe27fc3-11b9-45cd-a138-d8f4c084778f",
                                                "sense_id": "fa3454bb-a148-316c-aaa3-721409e048c4",
                                                "text": "„Es scheint, die DUP sei vom einstigen Königsmacher zum nutzlosen Vasallen degradiert worden.“"
                                            },
                                            {
                                                "example_id": "95e20426-d848-43e9-9b82-2e72d3207343",
                                                "sense_id": "fa3454bb-a148-316c-aaa3-721409e048c4",
                                                "text": "„So stimmten die Finnen Geheimverträgen zu, die das Land zum Vasallen des Kaiserreiches machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
