                "senses": [
                    {
                        "sense_id": "0783deaa-dfd5-3a8c-b710-11726d9ea2ff",
                        "entry_id": "5071ad0e-ae75-332e-a6ee-014846d4304e",
                        "glosses": [
                            "Laufen am Samstag"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d97e1bb9-9f94-489e-9a93-bd0ad903f63a",
                                "sense_id": "0783deaa-dfd5-3a8c-b710-11726d9ea2ff",
                                "text": "„Und um nicht zu vergessen, am Samstag war noch der übliche Samstagslauf mit meiner Frau dran.“"
                            },
                            {
                                "example_id": "1d832062-35b3-483c-8d5a-0d9d13e5f8f0",
                                "sense_id": "0783deaa-dfd5-3a8c-b710-11726d9ea2ff",
                                "text": "„Sehr schön, dass deine Ferse beim Samstagslauf ruhig war.“"
                            },
                            {
                                "example_id": "a9dc65ab-e706-46e5-bda2-039e233160c8",
                                "sense_id": "0783deaa-dfd5-3a8c-b710-11726d9ea2ff",
                                "text": "„Meine Frau sagt jedes Mal, wenn ich von den Samstagsläufen zurück komme, ich würde völlig fertig aussehen.“"
                            },
                            {
                                "example_id": "e53277f5-35f2-43be-9614-3d3a6fbf05b8",
                                "sense_id": "0783deaa-dfd5-3a8c-b710-11726d9ea2ff",
                                "text": "„Eigentlich wollte ich nach dem nicht ganz so locker gestandenden, langen Samstagslauf noch einen weiteren Tag pausieren.“"
                            },
                            {
                                "example_id": "be4f3186-3d13-4c0f-877d-672f4d618e71",
                                "sense_id": "0783deaa-dfd5-3a8c-b710-11726d9ea2ff",
                                "text": "„Dass ich Nichts von Deinem Samstagslauf lese, ist sicher kein gutes Zeichen😦 Ich würde Dir wünschen, dass ich falsch liege!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f12b7a9-b00b-3f3f-998d-c98d4ffdfa62",
                        "entry_id": "5071ad0e-ae75-332e-a6ee-014846d4304e",
                        "glosses": [
                            "Wettrennen, das am Samstag stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f2adf7-ad3e-464f-a3e7-b2260e0a58fc",
                                "sense_id": "3f12b7a9-b00b-3f3f-998d-c98d4ffdfa62",
                                "text": "„Bei schwierigen Witterungsbedingungen sicherte sich Renauer Startplatz sechs für den Samstagslauf.“"
                            },
                            {
                                "example_id": "b2feac9e-0f87-42c3-a60d-e3a7cf511961",
                                "sense_id": "3f12b7a9-b00b-3f3f-998d-c98d4ffdfa62",
                                "text": "„Auch im Samstagslauf hatte das Duo mit Position sieben wichtige Punkte in der hart umkämpften Meisterschaft eingefahren.“"
                            },
                            {
                                "example_id": "1612645b-bad0-4775-bd59-5117635c4afe",
                                "sense_id": "3f12b7a9-b00b-3f3f-998d-c98d4ffdfa62",
                                "text": "„Sykes startete im Samstagslauf im MotorLand Aragón von Rang vier - und wurde auf Platz zehn durchgereicht.“"
                            },
                            {
                                "example_id": "b3418761-7d9e-49b2-9a76-d8fceeca20da",
                                "sense_id": "3f12b7a9-b00b-3f3f-998d-c98d4ffdfa62",
                                "text": "Trotz des punktelosen Samstagslaufes beträgt der Rückstand auf die Spitze nach dem achten Saisonlauf nur noch 14 Zähler.“"
                            },
                            {
                                "example_id": "b34e81f1-f499-4db8-b204-49af24dc5400",
                                "sense_id": "3f12b7a9-b00b-3f3f-998d-c98d4ffdfa62",
                                "text": "„Der Samstagslauf beginnt um 15 Uhr, das alles entscheidende Sonntagsrennen um 13.05 Uhr.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
