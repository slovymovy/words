    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "551a8eba-f95a-3efa-8d62-dd248c46e809",
                "word": "sullenness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0fe69b31-140a-4b5c-ae63-8980cdff0a23",
                        "entry_id": "551a8eba-f95a-3efa-8d62-dd248c46e809",
                        "tags": [
                            "plural"
                        ],
                        "form": "sullennesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d6bba79-cb96-3c0f-83fc-c27751af51e8",
                        "entry_id": "551a8eba-f95a-3efa-8d62-dd248c46e809",
                        "glosses": [
                            "The state or quality of being sullen."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f0c25fe-dc93-4b38-b71a-bd7e743d9f1c",
                                "sense_id": "2d6bba79-cb96-3c0f-83fc-c27751af51e8",
                                "text": "’Twas sunset: when the sun will part\nThere comes a sullenness of heart\nTo him who still would look upon\nThe glory of the summer sun."
                            },
                            {
                                "example_id": "f85d63ab-ab5d-4296-85f7-933a522fc115",
                                "sense_id": "2d6bba79-cb96-3c0f-83fc-c27751af51e8",
                                "text": "“Marry come up—are you there with your bears?” muttered the dragon, with a draconic sullenness, which was in good keeping with his character, “we had as good have been Romans still, if we are to have no freedom in our pastimes!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "6a92b557-3d3f-3caf-9c2c-78c96723196e",
                        "entry_id": "551a8eba-f95a-3efa-8d62-dd248c46e809",
                        "glosses": [
                            "The result or product of being sullen."
                        ],
                        "tags": [
                            "countable",
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebaf29a0-5168-4505-81ff-daf8faa52956",
                        "source_entry_id": "551a8eba-f95a-3efa-8d62-dd248c46e809",
                        "source_sense_description": "state or quality of being sullen",
                        "target_lang_word": "Verdrossenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdrossenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afe429a9-23db-3882-b614-6cda7e9e5a4d",
                                        "entry_id": "b665e242-8793-38cd-85b9-81aa7231f697",
                                        "glosses": [
                                            "Mangel an Interesse für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b6742c-c6b2-455f-9539-17c1e706ab30",
                                                "sense_id": "afe429a9-23db-3882-b614-6cda7e9e5a4d",
                                                "text": "Die Finanzkrise führt bei vielen zu großer Verdrossenheit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2759ab1c-11c0-48a8-b2cd-b91e1f0fb815",
                        "source_entry_id": "551a8eba-f95a-3efa-8d62-dd248c46e809",
                        "source_sense_description": "state or quality of being sullen",
                        "target_lang_word": "Verdruss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdruss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                        "entry_id": "e7222bd5-b9fe-3de4-ac0a-49ee3c79a21d",
                                        "glosses": [
                                            "(andauernder) Ärger"
                                        ],
                                        "tags": [
                                            "literary",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf747d9-4005-4ba7-a5af-3ef88eaa4a3a",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Sein Verdruss war groß, als er auch diesmal nicht gewählt wurde."
                                            },
                                            {
                                                "example_id": "ea8d7cf2-5f80-4683-bceb-9cf78dd48be3",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Er ließ keinen Verdruss erkennen."
                                            },
                                            {
                                                "example_id": "f6209935-d665-495b-95e6-ee803ec0db09",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Es ist eine Kultur des Verdrusses, die sich über das Land gelegt hat, findet der Prediger.“"
                                            },
                                            {
                                                "example_id": "cc97100c-d752-4130-8385-bd22ef5e1298",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Vor allem die nach dem Börsenkrach vom Herbst 1873 einsetzende, lang anhaltende Wirtschaftsflaute sorgte für Verdruss.“"
                                            },
                                            {
                                                "example_id": "286ca306-2942-4d4c-bee2-d45dbcb2715d",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Offenbar gibt es nach elf Jahren Merkel doch einen stärkeren Verdruss an der Kanzlerin als angenommen und von den Umfragen suggeriert.“"
                                            },
                                            {
                                                "example_id": "cfaab7b3-12cb-4fec-97a9-2c0930cbef3e",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Er fühlte ihm den Puls und nahm zu seiner Verwunderung und zu seinem Verdruss wahr, dass der Puls ruhiger war.“"
                                            },
                                            {
                                                "example_id": "aa214dbd-38b8-469a-a8f3-ae01b1d59d19",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Ledermüller kam nun nach Nürnberg zurück, wurde aber zu Hause mit so harten Vorwürfen und Verdrussen gequält, daß er fortlief, und sich zu einem Freund nach Römhild begab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c93cb04-eb8d-4f6c-af06-50f911f47321",
                        "source_entry_id": "551a8eba-f95a-3efa-8d62-dd248c46e809",
                        "source_sense_description": "state or quality of being sullen",
                        "target_lang_word": "Überdruss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überdruss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                        "entry_id": "174b1932-d097-3884-9e8f-22550755cb74",
                                        "glosses": [
                                            "Widerwille, den jemand gegenüber jemandem oder etwas empfindet, weil er sich über eine lange Zeit damit hat befassen müssen, ohne dies zu wollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3332f75c-495b-4748-a1b2-86a088821665",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Auf einmal befiel ihn ein Überdruss an seiner ganzen Sammlung von Streichholzschachteln."
                                            },
                                            {
                                                "example_id": "98c5f145-9e3a-4f9b-b51f-cc315322a5d3",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Aus unendlichem Überdruss am Leben stürzte Ottmar sich von den Klippen ins tosende Meer."
                                            },
                                            {
                                                "example_id": "c71a2905-48e7-410f-9093-4f54aad4ad62",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Wir haben das Thema nun bis zum Überdruss diskutiert und trotzdem sind wir zu keinem Ergebnis gekommen."
                                            },
                                            {
                                                "example_id": "09fecfe3-853a-491d-8993-8596dad6b08c",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Und zu ihrem Überdruss sollten die weiteren Entwicklungen Sibylle auch noch recht geben.“"
                                            },
                                            {
                                                "example_id": "d2336b68-9bbe-4a17-9541-3fda75a74a9e",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Zwischen ihr und den Straussens hatte sich nach der langen gemeinsamen Zeit eine Trägheit eingestellt, ja, fast schon Überdruss.“"
                                            },
                                            {
                                                "example_id": "277fe3b5-fd75-4b54-b7d1-610c04ba5fc6",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Doch ihr Überdruss am Dasein überwuchert alle Vorsätze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
