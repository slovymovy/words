                                "target_senses": [
                                    {
                                        "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                                        "entry_id": "010d9b2e-c074-3db5-9e20-6c42dcb1fd48",
                                        "glosses": [
                                            "Épreuve éliminatoire dont le ou les meilleurs concurrents seront appelés à disputer la finale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "060873f9-ad15-4024-8e92-789d5f557e07",
                                                "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                                                "text": "Je ne suis revenu que pour la « petite finale », ce match qui opposait les deux équipes vaincues en demi-finale, les Néo-Zélandais et nous. Pour mon retour dans l'équipe, j'ai été gâté !"
                                            },
                                            {
                                                "example_id": "d7fc1fe3-7084-4016-94dd-be7f1e014517",
                                                "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                                                "text": "Les épreuves comportent des séries, suivies de repêchages, puis des demi-finales, des petites finales pour les places de septième à douzième et des finales pour les places de premier à sixième."
                                            },
                                            {
                                                "example_id": "272b21fb-7495-4ab9-8c0b-c213a402d546",
                                                "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                                                "text": "L’équipe de France de basket peine à trouver la trace d’un match plein de son leadeur, Evan Fournier, alors que se profile la demi-finale de l’Euro, contre la Pologne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
