                                    {
                                        "sense_id": "24bfc4d7-75f1-3f2c-8110-95fc0f043570",
                                        "entry_id": "5b8bebdc-8f10-3e58-bb28-573d137ee1ca",
                                        "glosses": [
                                            "In a glum manner."
                                        ],
