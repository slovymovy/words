                "senses": [
                    {
                        "sense_id": "434dfbe2-1e8c-3add-aaf1-488426600dd9",
                        "entry_id": "c96a2029-b62f-30a5-9135-8ac830ddf3e8",
                        "glosses": [
                            "seiche"
                        ],
