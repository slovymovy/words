                ],
                "senses": [
                    {
                        "sense_id": "c5a76086-24af-3b2d-944c-e35341d1a4ab",
                        "entry_id": "e76b7766-1265-3391-8ae8-86503caf5a88",
                        "glosses": [
                            "ciemnobrunatna, gęsta ciecz otrzymywana w procesie suchej destylacji drewna o intensywnym zapachu, mająca właściwości grzybobójcze i antyseptyczne, dawniej używana także do impregnacji płótna i skóry, uszczelniania beczek, itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f17cf8b-d6d2-4d91-9fab-a7a98a40da10",
                                "sense_id": "c5a76086-24af-3b2d-944c-e35341d1a4ab",
                                "text": "Zaduch smoły, dziegciu, prochu, gałganów palących się od zaprawy otaczał każdy dom płonącą atmosferą."
                            },
                            {
                                "example_id": "5f2d318b-4e6d-4182-a525-be4c1e4e6fda",
                                "sense_id": "c5a76086-24af-3b2d-944c-e35341d1a4ab",
                                "text": "Pomazałem mu rany dziegciem; nalałem gorzałki z popiołem w gardło. Będzie zdrów."
                            },
                            {
                                "example_id": "e8150e86-ee43-4876-9313-5b4b089f9313",
                                "sense_id": "c5a76086-24af-3b2d-944c-e35341d1a4ab",
                                "text": "Rybacy, którzy przybiegli popatrzyć na poczet namiestnika, mieli koszule, twarz i ręce całkiem pomazane dziegciem dla obrony od ukąszeń."
                            },
                            {
                                "example_id": "937af77d-5fb2-4da8-8788-6733f51f7867",
                                "sense_id": "c5a76086-24af-3b2d-944c-e35341d1a4ab",
                                "text": "Na to uprzejme wezwanie, jakby spod ziemi zjawił się opalony wiejski młodzian, w dość starannie połatanej sukmance i dość obficie dziegciem wysmarowanych butach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2ec0f63-cad1-467e-bafa-1e11718677b0",
                        "source_entry_id": "e76b7766-1265-3391-8ae8-86503caf5a88",
                        "source_sense_id": "c5a76086-24af-3b2d-944c-e35341d1a4ab",
