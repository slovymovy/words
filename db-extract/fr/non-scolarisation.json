                            {
                                "example_id": "8158976b-4107-40f5-b3f1-a0a5a7b5f92c",
                                "sense_id": "1fc9f073-525d-3d4d-adb2-56080c32f656",
                                "text": "La non-scolarisation des filles ne leur permet pas de sortir de la pauvreté."
