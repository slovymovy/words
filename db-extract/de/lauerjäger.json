                                        "glosses": [
                                            "A carnivorous animal that prefers to capture or trap prey by stealth or strategy, rather than by speed or strength."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "658edc55-7aba-4a8b-b163-6fe95ff484a1",
                                                "sense_id": "56cfb582-a9ab-3a68-8654-fc753a345537",
                                                "text": "For 10 million years after they arrived in Europe, despite the great numbers of small rodents present, cats showed no sign of prospering, let alone attaining the dominance among ambush predators they have today."
                                            }
                                        ]
