                                            {
                                                "example_id": "b3b5d2de-7f0f-4f67-830d-d13acc8b5bbc",
                                                "sense_id": "5321b4e7-fd19-3e2d-8bb5-5f394873bf0b",
                                                "text": "What is new media? We may begin answering this question by listing the categories commonly discussed under this topic in the popular press: the Internet, Web sites, computer multimedia, computer games, CD-ROMs and DVD, virtual reality."
                                            },
                                            {
                                                "example_id": "11e828c3-404e-4658-8e82-6c792b69fd11",
                                                "sense_id": "5321b4e7-fd19-3e2d-8bb5-5f394873bf0b",
                                                "text": "The techno-pessimists who see new media as commodified by corporations and the market as any ‘old media’ have also missed the point."
                                            }
                                        ]
