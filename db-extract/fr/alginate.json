                        "entry_id": "f9b5ca56-5530-3581-b880-8dc403f1cde8",
                        "glosses": [
                            "Sel de l’acide alginique, utilisé notamment dans la dentisterie et l’industrie des colles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b844559e-9def-48db-8dba-3e8c4913f641",
                                "sense_id": "ed304695-0704-38ad-8b39-7f9dfa0e4bf2",
                                "text": "Ainsi, l’alginate en excès revient vers l’avant et non pas vers la gorge lors de l’enfoncement final."
                            },
                            {
                                "example_id": "5890b737-f79c-425a-85c9-adaf6114cc67",
                                "sense_id": "ed304695-0704-38ad-8b39-7f9dfa0e4bf2",
                                "text": "On propose deux formulations contenant des mono et diglycérides, additionnés pour l'une d’alginate de sodium, de carragénate, de gomme guar et de pyrophosphate de sodium et pour l'autre de carboxyméthyl cellulose, de carragénate et de gomme guar."
                            }
                        ]
                    }
