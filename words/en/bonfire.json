{
    "word_family": [
        "fire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9612f40c-6209-3b31-a0cc-0b65cb70e524",
                    "sense_definition": "A large, controlled outdoor fire lit to celebrate an event or as a signal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The town gathered around the <w>bonfire</w> to celebrate the holiday.",
                            "target_lang_translations": {
                                "ru": "Горожане собрались вокруг <w>костра</w>, чтобы отпраздновать это событие."
                            }
                        },
                        {
                            "text": "We lit a large <w>bonfire</w> on the beach to signal our location.",
                            "target_lang_translations": {
                                "ru": "Мы разожгли большой <w>костёр</w> на берегу, чтобы подать сигнал о нашем местоположении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "light a bonfire",
                        "around the bonfire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой костёр, разжигаемый на открытом воздухе по случаю праздника или в качестве сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костёр",
                                "target_lang_sense_clarification": "большой праздничный или сигнальный огонь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cc604d9-0bf6-3523-ae51-702de04b163f",
                    "sense_definition": "A fire lit outdoors to burn garden waste or unwanted items.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the afternoon clearing the garden and burning the leaves in a <w>bonfire</w>.",
                            "target_lang_translations": {
                                "ru": "Он провёл день, расчищая сад и сжигая листья в <w>костре</w>."
                            }
                        },
                        {
                            "text": "Check local regulations before you light a <w>bonfire</w> for garden waste.",
                            "target_lang_translations": {
                                "ru": "Ознакомьтесь с местными правилами, прежде чем разводить <w>костёр</w> для садового мусора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garden bonfire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Костёр на открытом воздухе для сжигания садового мусора, веток или ненужных вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костёр",
                                "target_lang_sense_clarification": "для сжигания садовых отходов и мусора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ca2cb18-30e0-34fc-ad23-17b155f43b5d",
                    "sense_definition": "To destroy something by burning it in a fire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels decided to <w>bonfire</w> all the captured documents.",
                            "target_lang_translations": {
                                "ru": "Повстанцы решили <w>сжечь на костре</w> все захваченные документы."
                            }
                        },
                        {
                            "text": "They <w>bonfired</w> the old wooden crates to clear the storage area.",
                            "target_lang_translations": {
                                "ru": "Они <w>сожгли на костре</w> старые деревянные ящики, чтобы освободить место на складе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уничтожать что-либо, сжигая на костре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжигать на костре",
                                "target_lang_sense_clarification": "уничтожать огнем"
                            },
                            {
                                "target_lang_word": "жечь на костре",
                                "target_lang_sense_clarification": "предавать огню"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}