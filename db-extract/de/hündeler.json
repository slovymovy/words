                "senses": [
                    {
                        "sense_id": "db4d3758-1e3c-39df-9302-89d17f2678f3",
                        "entry_id": "16efe58c-ecb0-3b45-88b4-bb9e913fac78",
                        "glosses": [
                            "männliche Person, die einen Hund zur Haustierhaltung besitzt, die sich einen Hund hält"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "933ca65e-cffe-41de-8fa0-000e88ca18a6",
                                "sense_id": "db4d3758-1e3c-39df-9302-89d17f2678f3",
                                "text": "«Seit 45 Jahren bin ich aktiver Hündeler. Die tägliche intensive Beschäftigung mit unseren vierbeinigen Freunden gehört mit zu den wertvollsten seelischen Bereicherungen meines Lebens.»"
                            },
                            {
                                "example_id": "847c9126-748b-4790-a155-e4766d67e32c",
                                "sense_id": "db4d3758-1e3c-39df-9302-89d17f2678f3",
                                "text": "«Denen stehen 270 katzenliebende Singles gegenüber, und wenn man die Liebhaberinnen und Liebhaber von Raubkatzen auch noch dazu zählt, gibt es gar 275 mit Hündelern eher unkompatible einsame Kätzeler.»"
                            },
                            {
                                "example_id": "7cab7803-c27b-4e34-9ed2-9e223b5dfb35",
                                "sense_id": "db4d3758-1e3c-39df-9302-89d17f2678f3",
                                "text": "«Da spricht der Neid des hundesteuerpflichtigen Hündelers gegen die Rösseler, die ungeschoren wegkommen.»"
                            },
                            {
                                "example_id": "e9118ad7-87e5-4263-9c34-800735250ea4",
                                "sense_id": "db4d3758-1e3c-39df-9302-89d17f2678f3",
                                "text": "«‹Wir wohnten drei Jahre am Veloweg und wissen, wie gut dieser von Wanderern, Velofahrern und Hündelern frequentiert wird›, so Jenny.»"
                            },
                            {
                                "example_id": "48933471-5636-4645-85bb-ec0c2ac7d8c2",
                                "sense_id": "db4d3758-1e3c-39df-9302-89d17f2678f3",
                                "text": "«Warum treiben sich Hündeler auf dem Golfplatz herum?»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
