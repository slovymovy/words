                        "form": "перенасы́щена"
                    },
                    {
                        "form_id": "2d55dd4d-fae3-4d20-b8bb-b6bc7e32d392",
                        "entry_id": "ad8a9aee-a0b5-30fd-9fcf-373b71510932",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "перенасы́щены"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbb7f3f9-866d-3473-afca-b16c51036ca5",
                        "entry_id": "ad8a9aee-a0b5-30fd-9fcf-373b71510932",
                        "glosses": [
                            "прич. от перенасытить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "870cccc1-9293-44f2-87f2-51779a176ca0",
                                "sense_id": "fbb7f3f9-866d-3473-afca-b16c51036ca5",
                                "text": "Перенасыщенный ударениями, гармонически цветаевский стих непредсказуем; она тяготеет более к хореям и к дактилям, нежели к определённости ямба, начала её строк скорее трохеические, нежели ударные, окончания ― причитающие, дактилические."
                            },
                            {
                                "example_id": "bb69f075-6d8e-4b31-be6f-390a5b9d74f9",
                                "sense_id": "fbb7f3f9-866d-3473-afca-b16c51036ca5",
                                "text": "Рынок межбанковских кредитов в пятницу оказался перенасыщен свободными рублевыми средствами."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dd88726-8a22-3b09-8fab-04d86dc3eb0c",
                        "entry_id": "ad8a9aee-a0b5-30fd-9fcf-373b71510932",
                        "glosses": [
                            "адъектив. слишком сильно насыщенный, пропитанный чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82ce21dd-d4a8-4e34-be53-2a3ec927ceef",
                                "sense_id": "5dd88726-8a22-3b09-8fab-04d86dc3eb0c",
                                "text": "Происходящий при этом процесс можно сравнить с тем процессом кристаллизации, который возникает, когда в перенасыщенный соляной раствор опускают лишний, «критический» кристаллик соли."
                            },
                            {
                                "example_id": "eadc1a6b-1c15-4d81-96be-8ece21f85b94",
                                "sense_id": "5dd88726-8a22-3b09-8fab-04d86dc3eb0c",
                                "text": "Благодаря «подогревающему устройству» ртуть из жидкости перейдёт в состояние перенасыщенного пара."
                            }
                        ]
                    },
                    {
                        "sense_id": "63bf5361-be55-3edf-baf3-3f545abe138b",
                        "entry_id": "ad8a9aee-a0b5-30fd-9fcf-373b71510932",
                        "glosses": [
                            "адъектив. перен. слишком, чрезмерно переполненный, обильный чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4097dc38-c7f8-46e6-9be3-beb6eb891889",
                                "sense_id": "63bf5361-be55-3edf-baf3-3f545abe138b",
                                "text": "Но он уже чувствовал себя перенасыщенным, утомлённым обилием знания людей, и ему казалось, что пришла пора крепко оформить всё, что он видел, слышал, пережил, в свою, оригинальную систему."
                            },
                            {
                                "example_id": "f22d4f62-c82c-400b-a3d8-3829029d1552",
                                "sense_id": "63bf5361-be55-3edf-baf3-3f545abe138b",
                                "text": "А если учесть, что Лос-Анджелес плотно сбитый, перенасыщенный автомобилями город, то можно себе представить, с какими трудностями мы столкнулись."
                            }
                        ]
                    }
                ],
