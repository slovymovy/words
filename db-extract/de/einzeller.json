                "senses": [
                    {
                        "sense_id": "b8ff8d68-50e9-3a54-88c9-278f8103bc0d",
                        "entry_id": "80d0c330-e44f-35e0-bac1-74fd9f7016f9",
                        "glosses": [
                            "Lebewesen, das aus nur einer Zelle besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da7910e6-7019-4951-83e2-e7066bc84fb9",
                                "sense_id": "b8ff8d68-50e9-3a54-88c9-278f8103bc0d",
                                "text": "Der Niederländer Antoni van Leeuwenhoek entdeckte die ersten Einzeller."
                            },
                            {
                                "example_id": "3941fc0b-7a9b-4111-aeb5-c5c852a786be",
                                "sense_id": "b8ff8d68-50e9-3a54-88c9-278f8103bc0d",
                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8537da3c-fa8a-451e-810c-f784ab5f2fef",
                        "source_entry_id": "80d0c330-e44f-35e0-bac1-74fd9f7016f9",
                        "source_sense_id": "b8ff8d68-50e9-3a54-88c9-278f8103bc0d",
                        "source_sense_description": "Biologie: Lebewesen, das aus nur einer Zelle besteht",
                        "target_lang_word": "unicellular organism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5deb19fa-3986-4267-adfd-83d4d2fce462",
                        "source_entry_id": "80d0c330-e44f-35e0-bac1-74fd9f7016f9",
                        "source_sense_id": "b8ff8d68-50e9-3a54-88c9-278f8103bc0d",
                        "source_sense_description": "Biologie: Lebewesen, das aus nur einer Zelle besteht",
                        "target_lang_word": "unicellulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unicellulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a4853f0-5f42-30ba-8ea4-b354d8ed3f76",
                                        "entry_id": "4d7c6d83-1ec0-329e-aaba-6bf6590bb139",
                                        "glosses": [
                                            "Qui n’est constitué que d’une seule cellule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d3f3ad-da02-4fb6-b4fa-1f343ecd9ac1",
                                                "sense_id": "4a4853f0-5f42-30ba-8ea4-b354d8ed3f76",
                                                "text": "Il y a beaucoup plus d’organismes unicellulaires que pluricellulaires en termes de biomasse et de biodiversité."
                                            },
                                            {
                                                "example_id": "66bbebf4-6370-448e-bf83-c9be236b6da6",
                                                "sense_id": "4a4853f0-5f42-30ba-8ea4-b354d8ed3f76",
                                                "text": "Les microbes sont unicellulaires"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unicellulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3766314-18ad-3fdc-96e0-9266a5458487",
                                        "entry_id": "39a2b1c0-86d7-33a1-a4be-e7cdbff6a103",
                                        "glosses": [
                                            "Organisme constitué d’une seule cellule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a8073bf-2165-481b-be9c-84ae67aaddfc",
                                                "sense_id": "c3766314-18ad-3fdc-96e0-9266a5458487",
                                                "text": "La vie d’un unicellulaire est donc d’une simplicité déroutante et d’une tristesse tragique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
