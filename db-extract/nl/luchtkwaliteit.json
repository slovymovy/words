                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4fa2b4-1063-4f91-be9a-a42bd9dc958c",
                                "sense_id": "c332f383-4907-37d3-b1ba-78beb4d5b3e2",
                                "text": "Hier midden in de stad is de luchtverontreiniging zo heftig dat de luchtkwaliteit niet meer aan de eisen voldeed"
                            },
                            {
                                "example_id": "a6e72367-ec06-4f8f-90af-6bb319a38487",
                                "sense_id": "c332f383-4907-37d3-b1ba-78beb4d5b3e2",
                                "text": "Een goede luchtkwaliteit is van groot belang voor de gezondheid."
                            },
                            {
                                "example_id": "1d297f24-16e0-425e-97f2-edbf3da84783",
                                "sense_id": "c332f383-4907-37d3-b1ba-78beb4d5b3e2",
                                "text": "Volgens de Algemene Nederlandse Vereniging van Reisondernemingen (ANVR) en reisorganisatie TUI heeft de luchtvaart nauwelijks invloed op de luchtkwaliteit in Den Haag en is een lokaal verbod op fossiele reclames daarom niet zinvol. Ook vonden ze het verbod in strijd met de vrijheid van meningsuiting en de vrijheid van ondernemerschap."
                            }
                        ]
