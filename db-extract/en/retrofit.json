                    {
                        "translation_id": "c6fbb0fa-8776-4e17-b4fc-9c8ee10128c1",
                        "source_entry_id": "046c7392-9ad8-3292-83c7-35848ab355a5",
                        "source_sense_description": "(transitive) to supply (a device, structure, etc.) with new components or parts that were not previously available or installed — see also modernize",
                        "target_lang_word": "nachrüsten",
