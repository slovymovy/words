    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dede17e7-2ce6-3236-9bc1-f9404a5ce355",
                    "sense_definition": "Qui est conforme à la vérité, à la réalité ou aux faits dans tous ses détails.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous me donner l'heure <w>exacte</w> de votre arrivée ?"
                        },
                        {
                            "text": "Cette déclaration financière ne reflète pas le montant <w>exact</w> des dépenses."
                        }
                    ],
                    "synonyms": [
                        "juste",
                        "précis",
                        "vrai"
                    ],
                    "antonyms": [
                        "faux",
                        "inexact",
                        "erroné"
                    ],
                    "common_phrases": [
                        "heure exacte",
                        "montant exact",
                        "moment exact"
                    ]
                },
                {
                    "sense_id": "711f769f-ba3d-3509-b22d-c7138a75040d",
                    "sense_definition": "Qui respecte scrupuleusement l'heure convenue ou ses engagements ; ponctuel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est toujours très <w>exact</w> et n'arrive jamais en retard au bureau."
                        },
                        {
                            "text": "Soyez bien <w>exact</w> au rendez-vous prévu avec le directeur."
                        }
                    ],
                    "synonyms": [
                        "ponctuel",
                        "assidu"
                    ],
                    "antonyms": [
                        "retardataire",
                        "inexact"
                    ],
                    "common_phrases": [
                        "être exact au rendez-vous"
                    ]
                },
                {
                    "sense_id": "b3b93dd0-3759-3231-b6ab-3161ba721363",
                    "sense_definition": "Qui reproduit fidèlement un modèle original, sans la moindre altération.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conformite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce document constitue une copie <w>exacte</w> du contrat initial."
                        },
                        {
                            "text": "Le peintre a réalisé une reproduction <w>exacte</w> de ce chef-d'œuvre."
                        }
                    ],
                    "synonyms": [
                        "fidèle",
                        "identique",
                        "conforme"
                    ],
                    "antonyms": [
                        "infidèle",
                        "différent"
                    ],
                    "common_phrases": [
                        "copie exacte",
                        "reproduction exacte"
                    ]
                },
                {
                    "sense_id": "c9073b39-bfef-311a-8aaa-93c4c991d8f7",
                    "sense_definition": "Fondé sur des démonstrations rigoureuses et des lois logiques ou mathématiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rigueur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les mathématiques font partie des sciences <w>exactes</w> enseignées à l'université."
                        },
                        {
                            "text": "L'économie s'inspire parfois de démarches issues des disciplines <w>exactes</w>."
                        }
                    ],
                    "synonyms": [
                        "rigoureux"
                    ],
                    "common_phrases": [
                        "sciences exactes"
                    ]
                },
                {
                    "sense_id": "41b0b4e5-656e-33c3-b6b1-e0bdfe633d02",
                    "sense_definition": "Qui fait preuve d'une grande sévérité ou d'une rigueur absolue dans l'application d'un principe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rigueur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge veillait à l'observation d'une <w>exacte</w> justice pour tous les prévenus."
                        },
                        {
                            "text": "Ce travail de laboratoire réclame une discipline particulièrement <w>exacte</w>."
                        }
                    ],
                    "synonyms": [
                        "rigoureux",
                        "strict",
                        "sévère"
                    ],
                    "antonyms": [
                        "laxiste"
                    ],
                    "common_phrases": [
                        "exacte justice"
                    ]
                }
            ]
        }
    ]
