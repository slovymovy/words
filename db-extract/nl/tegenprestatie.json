                "translations": [
                    {
                        "translation_id": "e32a7fe1-46b0-4475-8c15-ead38e483102",
                        "source_entry_id": "9956889b-faf7-371c-9f26-7e008f8f3112",
                        "source_sense_id": "b876ff64-040c-332e-b8b0-35ba1a8f9264",
                        "source_sense_description": "een prestatie als vergoeding",
                        "target_lang_word": "Gegenleistung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenleistung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df107a90-94de-3660-9e69-e82298f866c4",
                                        "entry_id": "2594dcfb-88ee-3317-9d1a-ecb6dd50892e",
                                        "glosses": [
                                            "das, was etwas aufwiegt, das man bereits erhalten hat oder gewährt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845c03e9-f147-4957-9126-0de59af97466",
                                                "sense_id": "df107a90-94de-3660-9e69-e82298f866c4",
                                                "text": "Die Gegenleistung war nicht besonders groß."
                                            },
                                            {
                                                "example_id": "e1dee6a4-6248-4ce9-857b-38f3b4dc4c68",
                                                "sense_id": "df107a90-94de-3660-9e69-e82298f866c4",
                                                "text": "Als Gegenleistung bekam sie den Platz im Verwaltungsrat."
                                            },
                                            {
                                                "example_id": "601993b4-4298-49c8-994f-7d79888b1912",
                                                "sense_id": "df107a90-94de-3660-9e69-e82298f866c4",
                                                "text": "„Die Vermittlungsagenturen unterscheiden sich im Preis der Jahresmitgliedschaft – als Gegenleistung dafür garantieren sie eine bestimmte Anzahl von Vorschlägen.“"
                                            },
                                            {
                                                "example_id": "809f2a26-3ce6-4b2e-b83f-16fd5b065d87",
                                                "sense_id": "df107a90-94de-3660-9e69-e82298f866c4",
                                                "text": "„Nun ist es an uns, eine Gegenleistung zu finden.“"
                                            },
                                            {
                                                "example_id": "5d6882b6-b9e4-44df-be88-1c2cc6c7dc73",
                                                "sense_id": "df107a90-94de-3660-9e69-e82298f866c4",
                                                "text": "„Denn als Gegenleistung erhielt er eine bessere Verpflegung als seine Gefährten – was allerdings nicht viel hieß.“"
                                            },
                                            {
                                                "example_id": "f59f5f79-bcf6-4d1d-b0e8-1b1169dd0bd1",
                                                "sense_id": "df107a90-94de-3660-9e69-e82298f866c4",
                                                "text": "„Als er Isolde von der geplanten Fahrt erzählte, spürte er, dass sie sich um ihn sorgte; ein Besuch in die DDR sei sicher nicht ohne Gegenleistung zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a09ed09-ab56-4bde-8147-b0919b240d55",
                        "source_entry_id": "9956889b-faf7-371c-9f26-7e008f8f3112",
                        "source_sense_id": "b876ff64-040c-332e-b8b0-35ba1a8f9264",
                        "source_sense_description": "een prestatie als vergoeding",
                        "target_lang_word": "compensation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compensation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "660eff43-db2c-387b-871b-f002215de9de",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The act or principle of compensating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e25132c-91f7-4b14-a46f-194bf81804d9",
                                                "sense_id": "660eff43-db2c-387b-871b-f002215de9de",
                                                "text": "Human labor, through all its forms, from the sharpening of a stake to the construction of a city or an epic, is one immense illustration of the perfect compensation of the universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56288dae-ba36-33d3-80a1-ef200e3bbda8",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "Something which is regarded as an equivalent; something which compensates for loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e057567-a91d-4e62-aae3-193302460541",
                                                "sense_id": "56288dae-ba36-33d3-80a1-ef200e3bbda8",
                                                "text": "The parliament which dissolved the monastic foundations […] vouchsafed not a word toward securing the slightest compensation to the dispossessed owners."
                                            },
                                            {
                                                "example_id": "c39a795f-5bd2-4b9b-96ac-6d01ded75b6b",
                                                "sense_id": "56288dae-ba36-33d3-80a1-ef200e3bbda8",
                                                "text": "No pecuniary compensation can possibly reward them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8069b45b-f696-31fd-ad7b-e9d7e5355639",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The extinction of debts of which two persons are reciprocally debtors by the credits of which they are reciprocally creditors; the payment of a debt by a credit of equal amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df6d9c09-8c2a-30ea-a4cc-32558a684ce0",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "A recompense or reward for service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ea090c9-babd-332a-9aa1-08fa55e3dbde",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "An equivalent stipulated for in contracts for the sale of real estate, in which it is customary to provide that errors in description, etc., shall not avoid, but shall be the subject of compensation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d24f41c5-5a60-31ed-b6d6-1b0303287411",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The relationship between air temperature outside a building and a calculated target temperature for provision of air or water to contained rooms or spaces for the purpose of efficient heating. In building control systems, the compensation curve is defined to a compensator for this purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9a2cb70-dac7-3e71-a05c-7399dfe3ae5e",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The ability of one part of the brain to overfunction in order to take over the function of a damaged part (e.g. following a stroke)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83e041da-ec20-42fa-a915-d00a7fccbda0",
                        "source_entry_id": "9956889b-faf7-371c-9f26-7e008f8f3112",
                        "source_sense_id": "b876ff64-040c-332e-b8b0-35ba1a8f9264",
                        "source_sense_description": "een prestatie als vergoeding",
                        "target_lang_word": "compensation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compensation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20c3a8db-4d61-3cef-9edf-1cae3bd84e95",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Action d'établir un équilibre entre deux choses complémentaires ou antagonistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "642bfd1d-85d3-4a6e-bc1c-2d3f597cfcc5",
                                                "sense_id": "20c3a8db-4d61-3cef-9edf-1cae3bd84e95",
                                                "text": "Par un savant jeu d’avances et de compensations, ils laissaient successivement croire aux fervents des deux partis qu’ils étaient leurs hommes pourvu toutefois que le confident eût provoqué cet aveu par l’offre de deux ou trois bouteilles de picolo de l’année […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Dédommagement d’un mal par un bien, d’une perte par un profit, d’un inconvénient par un avantage, d’une valeur moindre par un supplément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef9dfca-31d0-4714-855d-50ba24d386be",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Le brave homme se fit payer deux ducats, mais en compensation il m'enveloppa de sa grosse houppelande, et me chanta deux ou trois chansons mecklembourgeoises qui me parurent assez jolies."
                                            },
                                            {
                                                "example_id": "cff13d8e-0771-4e41-9619-0eac2c0ada92",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Mais le temps n’est pas à philosopher ; il nous faut éclairer le lecteur, que l’on gruge assez souvent pour lui fournir, en compensation, un conseil utile ; quel prix devez-vous mettre à votre parlementaire ?"
                                            },
                                            {
                                                "example_id": "ed319940-e57e-487c-b1b0-a6fe926bf23d",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "En compensation de leur temps donné, ces indispensables personnes reçoivent un t-shirt et une casquette souvenir et sont bien entendu nourries."
                                            },
                                            {
                                                "example_id": "2212ec76-a30b-4ff2-b63f-6b165e050284",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Cela doit entrer en compensation de la perte qu’il a faite."
                                            },
                                            {
                                                "example_id": "b20fd2ff-cb47-496d-98b9-fe8ab9d02adf",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Il n’y a pas lieu à compensation."
                                            },
                                            {
                                                "example_id": "21188e6c-428f-4d14-b5f7-0f21142b121e",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Il lui céda cela en compensation."
                                            },
                                            {
                                                "example_id": "63b472a5-ab1f-4dce-ae6a-e9ac59e75872",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Caisse de compensation, organisme d’assurance, sous forme de mutuelle entre les employeurs, destiné à supprimer tout risque d’inégalité dans les charges de famille de leurs employés."
                                            },
                                            {
                                                "example_id": "b6beed3c-1428-40a7-9db8-68c60fd0e3ef",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Système des compensations, système qui prétend qu’il y a compensation de bien et de mal dans toutes les conditions de la vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b045a66-f11b-3a7f-a3a0-2ac59179bf20",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Libération réciproque entre deux personnes qui se trouvent être à la fois créancières et débitrices l’une de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a2ed7f-acd5-4a0d-84a8-781b900d17d5",
                                                "sense_id": "8b045a66-f11b-3a7f-a3a0-2ac59179bf20",
                                                "text": "La compensation s’opère de plein droit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21384c22-11eb-3786-8fb8-f0b8d9a2fb7b",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Mécanisme consistant à faire le bilan des positions (ordres d'achats et de ventes) pour en établir le solde net. Cela permet de limiter les échanges entre les établissements bancaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41523f27-79d9-3415-a1d2-48c777d35142",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Opération par laquelle celui qui a acheté et revendu une valeur à terme se substitue, au terme fixé, à celui à qui il a vendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84ed5f6-fe65-4afc-803b-ae4ff3a296f4",
                                                "sense_id": "41523f27-79d9-3415-a1d2-48c777d35142",
                                                "text": "Cours de compensation, prix fixé, selon les cours, pour la liquidation périodique des marchés à terme sur les valeurs cotées à la Bourse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a852d4-1d7b-385d-b358-fcab7f414b5a",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Correction de l'effet des réactions aérodynamiques sur les gouvernes d'un avion en vue de réduire les efforts sur les commandes de vol généralement obtenue à l'aide de surfaces auxiliaires appelées « compensateurs »."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef0e4aff-a1c9-336c-95b5-21bea59d0bdf",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Réaction de l'organisme qui compense les effets d'une maladie pour maintenir l’équilibre physiologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e255caca-9e17-4028-976d-943bb2353609",
                                                "sense_id": "ef0e4aff-a1c9-336c-95b5-21bea59d0bdf",
                                                "text": "Les stress psychoémotionnels sont également à prendre en compte ; car, lorsqu’ils entraînent un état de frustration, une compensation de type alimentaire peut survenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aafb6097-52f4-41d8-a045-006a492ab7f9",
