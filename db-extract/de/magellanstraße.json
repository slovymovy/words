                ],
                "senses": [
                    {
                        "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                        "entry_id": "32c3b58c-ba05-32cc-9088-90b42b3e6317",
                        "glosses": [
                            "Meeresstraße zwischen der Südspitze Südamerikas und Feuerland in chilenischem Hoheitsgebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a730779-4272-4592-a2ea-d743191563f6",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "Die Magellanstraße ist ein tückisches Segelrevier mit vielen Untiefen knapp unter der Wasseroberfläche, sehr starken Strömungen und immer wieder Stürmen."
                            },
                            {
                                "example_id": "31ae42f4-0481-4eaa-8c78-e6a3ca978968",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„Doch Magellan hatte die langersehnte Passage gefunden: eine unscheinbare Meerenge, die vom Atlantischen in den Pazifischen Ozean mündete, heute bekannt als Magellanstraße.“"
                            },
                            {
                                "example_id": "40ae73cd-ae58-42d4-a7b6-a71f7e915a7d",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "[August 1592:] „Zusammen mit vier anderen Schiffen war er von England zur Fahrt in den Pazifik aufgebrochen. Ihr erster Versuch, die Magellanstraße zu passieren, war gescheitert, und Davis hatte die anderen Schiffe aus den Augen verloren.“"
                            },
                            {
                                "example_id": "867a0aeb-f617-4200-8b90-651e9c41a8f9",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„Der ehemalige Pilot der chilenischen Luftwaffe fliegt Touristen von Punta Arenas um das Kap Hoorn. Über der Magellanstraße schütteln heftige Böen die zweimotorige Cessna.“"
                            },
                            {
                                "example_id": "0229ffe3-77e0-4d59-8aef-b4eeaa9ee9d0",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„Patagonien beginnt südlich des Río Colorado und erstreckt sich über fast 2000 km Richtung Süden bis zur Magellanstraße.“"
                            },
                            {
                                "example_id": "e422e95a-9f40-4749-8531-433e349a4f5e",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„Eine Passage ähnlich der Magellanstraße suchte auch der Franzose Jacques Cartier, allerdings durch Nordamerika.“"
                            },
                            {
                                "example_id": "8d6741bc-6bd3-4734-a91c-acc3d17381ee",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„Ihre größte Bedeutung hatte die Magellanstraße vor dem Bau des Panamakanals, aber auch heute noch wird sie von vielen Schiffen befahren.“"
                            },
                            {
                                "example_id": "7d641193-5040-4b04-bc58-dfda274a9eab",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„»Mein Großvater war auf Dawson inhaftiert (einer Insel in der Meerenge Magellanstraße, die von der Pinochet-Diktatur als Haftanstalt genutzt wurde).«“"
                            },
                            {
                                "example_id": "0301ba45-49f0-4d5b-ba01-8e5ae695aa45",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "[Den Schlimbachpreis gewann 1983] „Dr. Harm-Hinrich Rotermund für den Törn rund um Südamerika durch die Magellanstraße.“"
                            },
                            {
                                "example_id": "2de65b85-d3c2-4923-ade3-45a617b9eaca",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„Durch die Magellanstraße soll die \"Aventura Zero\" sodann Kurs auf die Südsee bis hin zu den Philippinen nehmen.“"
                            },
                            {
                                "example_id": "7b4eda48-3d01-497a-9362-08daee679ee6",
                                "sense_id": "616b5546-ba52-3196-a3ca-5f3cdc02d513",
                                "text": "„Auf der Suche nach bestmöglichem Schutz vor einem herannahenden schweren Sturm ist das Duo mit seinem Trimaran \"Use it again!\" in der Cook Bay am Eingang des Beagle-Kanals südlich der Magellanstraße unterwegs und dort voraussichtlich noch bis zum 10. Februar zum Warten verdammt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
