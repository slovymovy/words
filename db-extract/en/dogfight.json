                        "entry_id": "f113fe2d-2e38-3100-8666-a403a9fd42c6",
                        "glosses": [
                            "A twisting turning battle between two or more military aircraft, especially between fighters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c139960-0bed-4ba7-9883-ce868e9d4f67",
                                "sense_id": "6164d71a-88ee-32ca-b642-327a92c4e7e5",
                                "text": "The two bi-planes swirled around each other like angry wasps in a violent dogfight."
                            }
                        ]
                    },
                    {
                        "sense_id": "a62fdf3e-0250-3a97-ab00-c35b6dbb093a",
