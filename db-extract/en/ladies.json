                "forms": [],
                "senses": [
                    {
                        "sense_id": "2282c4b6-239a-3642-89dc-3beac88a030d",
                        "entry_id": "31a6da2f-46ed-32d0-8c29-e6ef28cb0777",
                        "glosses": [
                            "plural of lady"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b8eed37d-c0e5-41be-b199-04b124371032",
                                "sense_id": "2282c4b6-239a-3642-89dc-3beac88a030d",
                                "text": "He wet his thumb with saliva pressing on the tongue, ran it up and down faster over the letter 'I' of 'TOILET', the 'LADIES TOILET' was transformed into 'LADIES TO LET' in no time."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1bc8fe3-8392-3066-9516-419704865279",
                        "entry_id": "31a6da2f-46ed-32d0-8c29-e6ef28cb0777",
                        "glosses": [
                            "genitive of lady"
                        ],
                        "tags": [
                            "form-of",
                            "genitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bad3d703-8705-40e7-b72e-36088737c0e4",
                                "sense_id": "f1bc8fe3-8392-3066-9516-419704865279",
                                "text": "The morrow next about the wanted howre, / The Dwarfe cald at the doore of Amyas, / To come forthwith unto his Ladies bowre."
                            },
                            {
                                "example_id": "61a597c5-a8a0-4904-8613-d8e3045b5b81",
                                "sense_id": "f1bc8fe3-8392-3066-9516-419704865279",
                                "text": "Vrge not my fathers anger (Eglamoure) / But thinke vpon my griefe (a Ladies griefe) / And on the iuſtice of my flying hence, / To keepe me from a moſt vnholy match, / Which heauen and fortune ſtill rewards with plagues."
                            },
                            {
                                "example_id": "6881254a-f455-4919-abb6-ab7873963634",
                                "sense_id": "f1bc8fe3-8392-3066-9516-419704865279",
                                "text": "And ſince not only a dead Fathers fame, / But more a Ladies honour muſt be touch’d, / Which nice as Ermines will not bear a Soil ; / Let all retire ; that you alone may hear / What ev’n in whiſpers I won’d tell your ear."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2fc29b2-a777-3d00-a824-befda9607c29",
                        "entry_id": "31a6da2f-46ed-32d0-8c29-e6ef28cb0777",
                        "glosses": [
                            "An initial hand consisting of a pair of queens."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
