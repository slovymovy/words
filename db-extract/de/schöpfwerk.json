                "senses": [
                    {
                        "sense_id": "4cfef475-2485-33b5-8fca-e29f7964e39f",
                        "entry_id": "3ef44f9b-7dd4-3e33-9adc-c86345754dc0",
                        "glosses": [
                            "in unterentwickelten Gegenden Anlage zur Feldbewässerung durch Schöpfräder, Eimerwerke oder Wasserschnecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c2c07e6-3447-46dc-81e5-655b3cedb744",
                                "sense_id": "4cfef475-2485-33b5-8fca-e29f7964e39f",
                                "text": "„Das verbreiteste Schöpfwerk ist das Schaduf, das, unseren Ziehbrunnen sehr ähnlich, aus einer zwischen zwei Pfosten sich vertikal bewegenden Stange besteht, an deren einem Ende ein zum Schöpfen bestimmtes Gefäß und an deren anderem Ende als Gegengewicht gewöhnlich ein Lehmklumnpen oder starkes Holzstück befestigt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8828bbc4-0f65-355d-9440-a34598d08783",
                        "entry_id": "3ef44f9b-7dd4-3e33-9adc-c86345754dc0",
                        "glosses": [
                            "Pumpanlagen zur Entwässerung von Niederungen, zum Beispiel der unter NN liegenden Marschgebiete am Unterlauf eingedeichter Ströme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fecbbb69-6ef6-4bcb-8159-896e8ba31d55",
                                "sense_id": "8828bbc4-0f65-355d-9440-a34598d08783",
                                "text": "In Küstennähe wird das Abflusswasser bei Fehlen der natürlichen Vorflut in großen Schöpfwerken durch den Deich gepumpt."
                            }
                        ],
