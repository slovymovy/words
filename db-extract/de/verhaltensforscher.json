                        "source_sense_description": "Wissenschaftler, der die Verhaltensweisen von Tieren und Menschen studiert und beschreibt",
                        "target_lang_word": "ethologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea984c86-3181-33ff-b589-da3f3e2fbcba",
                                        "entry_id": "8b2982c5-aa01-3cf9-9a58-2edf9c3eadb3",
                                        "glosses": [
                                            "A person who studies ethology."
                                        ],
                                        "tags": [],
