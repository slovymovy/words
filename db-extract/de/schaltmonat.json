                "senses": [
                    {
                        "sense_id": "a031bf5d-20b3-357e-a59d-77300599e66d",
                        "entry_id": "a66a4a36-0451-38ad-b731-fed081d3264a",
                        "glosses": [
                            "zusätzlicher Monat, der in bestimmten Kalendersystemen eingefügt wird, um den Kalender mit astronomischen Ereignissen wie den Jahreszeiten synchron zu halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ef3c660-9c74-45fa-8e4f-5abb05e3ce60",
                                "sense_id": "a031bf5d-20b3-357e-a59d-77300599e66d",
                                "text": "„Aber sehr übel war auch die Dreizehn, und warum? Weil die zwölf Mondmonate nur dreihundertvierundfünfzig Tage hatten und von Zeit zu Zeit Schaltmonate eingeschoben werden mußten, die dem dreizehnten Tierkreiszeichen, dem Raben, entsprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
