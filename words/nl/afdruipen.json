    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a9a6985-33ad-3934-9d07-0236f5facd7a",
                    "sense_definition": "zich stilletjes en beschaamd verwijderen na een nederlaag of afwijzing",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de zware nederlaag moesten de spelers stilletjes <w>afdruipen</w>.",
                            "target_lang_translations": {
                                "en": "After the heavy defeat, the players had to quietly <w>slink off</w>."
                            }
                        },
                        {
                            "text": "Toen hij geen gelijk kreeg van de leraar, liet hij hem beschaamd <w>afdruipen</w>.",
                            "target_lang_translations": {
                                "en": "When the teacher didn't agree with him, he let him <w>sneak away</w> in shame."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegsluipen",
                        "afnokken"
                    ],
                    "antonyms": [
                        "triomferen",
                        "standhouden"
                    ],
                    "common_phrases": [
                        "beschaamd afdruipen",
                        "stilletjes afdruipen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de context van sport of discussies"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to leave quietly and shamefully after a defeat, rejection, or failure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to slink off",
                                "target_lang_sense_clarification": "leaving quietly due to shame or embarrassment"
                            },
                            {
                                "target_lang_word": "to sneak away",
                                "target_lang_sense_clarification": "leaving unnoticed after a failure"
                            },
                            {
                                "target_lang_word": "to beat a retreat",
                                "target_lang_sense_clarification": "withdrawing after being defeated or humiliated"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41653328-124f-311b-a48c-a8a6ec6f290e",
                    "sense_definition": "het proces waarbij vloeistof langzaam van een voorwerp naar beneden valt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de gewassen borden eerst goed laten <w>afdruipen</w> in het rek.",
                            "target_lang_translations": {
                                "en": "You must first let the washed plates <w>drain</w> properly in the rack."
                            }
                        },
                        {
                            "text": "Het zeepsop <w>droop</w> langzaam van de pas gewassen auto <w>af</w>.",
                            "target_lang_translations": {
                                "en": "The soapy water slowly <w>dripped off</w> the newly washed car."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitlekken"
                    ],
                    "common_phrases": [
                        "laten afdruipen"
                    ],
                    "target_lang_definitions": {
                        "en": "the process of liquid slowly falling or running off an object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drain",
                                "target_lang_sense_clarification": "allowing liquid to run off dishes or food"
                            },
                            {
                                "target_lang_word": "to drip off",
                                "target_lang_sense_clarification": "liquid falling in drops from a surface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
