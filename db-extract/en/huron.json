                    {
                        "translation_id": "8af01bfe-1e20-4b51-8775-68cc155a2640",
                        "source_entry_id": "142c23bf-ee94-3411-9c62-016e813a00ff",
                        "source_sense_id": "42123c2b-8c32-32a5-a9b4-7a60b822733d",
