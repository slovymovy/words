    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1aff046f-7fb9-3b29-b7f4-d6b0508059b7",
                    "sense_definition": "Een loofboom uit het geslacht Fagus, met name de gewone beuk met zijn gladde, grijze stam.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het herfstbos zochten de kinderen naar nootjes onder de grote <w>beuk</w>.",
                            "target_lang_translations": {
                                "en": "In the autumn forest, the children looked for nuts under the large <w>beech</w>."
                            }
                        },
                        {
                            "text": "Een gezonde <w>beuk</w> heeft een opvallend gladde stam in vergelijking met een eik.",
                            "target_lang_translations": {
                                "en": "A healthy <w>beech</w> has a remarkably smooth trunk compared to an oak."
                            }
                        }
                    ],
                    "synonyms": [
                        "beukenboom",
                        "gewone beuk"
                    ],
                    "common_phrases": [
                        "een oude beuk"
                    ],
                    "target_lang_definitions": {
                        "en": "A deciduous tree of the genus Fagus, especially the common beech with its smooth, grey trunk."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beech",
                                "target_lang_sense_clarification": "the tree species"
                            },
                            {
                                "target_lang_word": "beech tree",
                                "target_lang_sense_clarification": "the tree species"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2df4aff5-d998-3f91-92e3-c5aea920bc85",
                    "sense_definition": "Een harde klap, flinke duw of krachtige stoot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf de zware houten deur een harde <w>beuk</w> met zijn schouder om hem te openen.",
                            "target_lang_translations": {
                                "en": "He gave the heavy wooden door a hard <w>shove</w> with his shoulder to open it."
                            }
                        },
                        {
                            "text": "Tijdens de wedstrijd kreeg de verdediger een flinke <w>beuk</w> van zijn tegenstander.",
                            "target_lang_translations": {
                                "en": "During the match, the defender took a heavy <w>blow</w> from his opponent."
                            }
                        }
                    ],
                    "synonyms": [
                        "ram",
                        "oplawaai",
                        "dreun"
                    ],
                    "common_phrases": [
                        "een harde beuk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak informeel gebruikt voor een fysieke klap of duw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A hard blow, heavy push, or powerful shove."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "a hard physical hit"
                            },
                            {
                                "target_lang_word": "shove",
                                "target_lang_sense_clarification": "a strong push"
                            },
                            {
                                "target_lang_word": "thump",
                                "target_lang_sense_clarification": "a heavy blow or hit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df45fe77-7fb3-3037-9db5-1f01672e6926",
                    "sense_definition": "Een langgerekte ruimte in een kerkgebouw, begrensd door pilaren of muren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De historische kathedraal bestaat uit een brede centrale <w>beuk</w> en twee smallere zijbeuken.",
                            "target_lang_translations": {
                                "en": "The historic cathedral consists of a wide central <w>nave</w> and two narrower side aisles."
                            }
                        },
                        {
                            "text": "Het zonlicht viel prachtig door de hoge ramen van de middelste <w>beuk</w>.",
                            "target_lang_translations": {
                                "en": "The sunlight fell beautifully through the high windows of the central <w>nave</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schip",
                        "middenschip"
                    ],
                    "common_phrases": [
                        "de centrale beuk"
                    ],
                    "target_lang_definitions": {
                        "en": "An elongated space in a church building, bordered by pillars or walls."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nave",
                                "target_lang_sense_clarification": "the central part of a church building"
                            },
                            {
                                "target_lang_word": "aisle",
                                "target_lang_sense_clarification": "a lateral division of a church"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1622cdcf-3b49-35db-8f15-1bddaa1c2381",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van het werkwoord <w>beuken</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>beuk</w> hard op de trommel om het ritme aan te geven.",
                            "target_lang_translations": {
                                "en": "I <w>pound</w> hard on the drum to set the rhythm."
                            }
                        },
                        {
                            "text": "Als ik boos ben, <w>beuk</w> ik soms tegen de boksbal in de sportschool.",
                            "target_lang_translations": {
                                "en": "When I am angry, I sometimes <w>bash</w> the punching bag in the gym."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of the verb 'beuken' (to pound, batter, or bash)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pound",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            },
                            {
                                "target_lang_word": "batter",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            },
                            {
                                "target_lang_word": "bash",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            }
                        ]
                    }
                }
            ]
        }
