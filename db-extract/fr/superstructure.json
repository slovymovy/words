                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4ac3be9-1475-3ff5-a0fd-7986c8d15c77",
                                        "entry_id": "93ad808f-1e90-3498-b4d4-e71bbba6dfa8",
                                        "glosses": [
                                            "Any structure built above the top full deck (FM 55-501)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bed64b3-4429-3a80-ba7a-003b7e4ca170",
                                        "entry_id": "93ad808f-1e90-3498-b4d4-e71bbba6dfa8",
                                        "glosses": [
                                            "Any material structure or edifice built on something else; that which is raised on a foundation or basis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301d7f3b-2801-4493-9db7-cfbe09325edc",
                                                "sense_id": "8bed64b3-4429-3a80-ba7a-003b7e4ca170",
                                                "text": "The Wards are open-topped, with skyscrapers rising from the superstructure. Towers are sealed against vacuum, as the breathable atmosphere envelope is only maintained to a height of about seven meters. The atmosphere is contained by the centrifugal force of rotation and a \"membrane\" of dense, colorless sulphur hexafluoride gas, held in place by carefully managed mass effect fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "659050c8-3e36-3554-8def-31226a44b6fb",
                                        "entry_id": "93ad808f-1e90-3498-b4d4-e71bbba6dfa8",
                                        "glosses": [
                                            "All that part of a building above the basement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63b1707c-f5bb-362c-b562-6ccf316b6aeb",
                                        "entry_id": "93ad808f-1e90-3498-b4d4-e71bbba6dfa8",
                                        "glosses": [
                                            "The sleepers and fastenings, in distinction from the roadbed."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "254c9dd1-d594-30fa-b839-9422c59c5ef2",
                                        "entry_id": "93ad808f-1e90-3498-b4d4-e71bbba6dfa8",
                                        "glosses": [
                                            "The social sphere of ideology which includes religion, art, politics, law and all traditional values."
                                        ],
                                        "tags": [
                                            "Marxism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7614cc3a-09af-493b-b351-ce13482fa9f6",
                                                "sense_id": "254c9dd1-d594-30fa-b839-9422c59c5ef2",
                                                "text": "The superstructure evolves more slowly and is more resistant to change than the economic infrastructure, especially in the modern industrial age of advanced capitalism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
