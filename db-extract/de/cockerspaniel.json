                "senses": [
                    {
                        "sense_id": "e1eafaae-f75e-3bd1-94b0-de2612d1a420",
                        "entry_id": "7468bbaa-86e1-30ed-acbf-165412342681",
                        "glosses": [
                            "Hunderasse; kleiner Jagdhund mit langer Schnauze, langem seidigem Fell, großen Hängeohren und agilem Wesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b8fcc2-5864-4402-97d2-3050ffd6ec9a",
                                "sense_id": "e1eafaae-f75e-3bd1-94b0-de2612d1a420",
                                "text": "Der Cockerspaniel wurde ursprünglich für die professionelle Jagd auf Vögel gezüchtet und verlor zunehmend an Bedeutung da andere Hunderassen und die Zucht dieser einfach bessere Eigenschaften mitbringen."
                            },
                            {
                                "example_id": "d079d999-0076-4f47-9004-8c07531a4fce",
                                "sense_id": "e1eafaae-f75e-3bd1-94b0-de2612d1a420",
                                "text": "Der Cockerspaniel wurde auf der Jagd entweder als Stöberhund voraus ins Unterholz geschickt oder stand hinter dem Jäger als Apportierhund bereit, die geschossene Wildgans dem Jäger zu apportieren."
                            },
                            {
                                "example_id": "d8862770-e3e7-4abb-a6df-151c1d0a0662",
                                "sense_id": "e1eafaae-f75e-3bd1-94b0-de2612d1a420",
                                "text": "„Die Cockerspaniel sind für ihren ausgeprägten Geruchssinn bekannt, der sie auch für die Jagd geeignet macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
