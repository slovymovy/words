                        "glosses": [
                            "Explication faite avec condescendance par une personne cis sur une personne trans sur ce qu’elle doit faire ou ne pas faire à propos de sa transition, de son militantisme, etc."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
