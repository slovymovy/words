                ],
                "senses": [
                    {
                        "sense_id": "9cdd5f97-83dc-340c-a347-6a31aea1041d",
                        "entry_id": "bb01d397-5589-35c7-8ee7-912cf7d1a910",
                        "glosses": [
                            "gemeinsame, zentrale Bibliothek einer Universität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3017612c-9a08-453c-8b80-4a7a724072c7",
                                "sense_id": "9cdd5f97-83dc-340c-a347-6a31aea1041d",
                                "text": "Er recherchierte in der Universitätsbibliothek für ein Referat."
                            },
                            {
                                "example_id": "d11ca10d-62f6-4e03-9912-72389a65d69c",
                                "sense_id": "9cdd5f97-83dc-340c-a347-6a31aea1041d",
                                "text": "„Zu jener Zeit beschloß das College die meisten seiner kostbaren Buchbestände an eine zentrale Universitätsbibliothek abzugeben, wo sie unter besseren Bedingungen aufbewahrt werden konnten.“"
                            },
                            {
                                "example_id": "83fae4db-9e9d-4f8c-b2d5-dce3c2b30894",
                                "sense_id": "9cdd5f97-83dc-340c-a347-6a31aea1041d",
                                "text": "„Bei nächster Gelegenheit gingen die Kawashimas mit Sung in die Universitätsbibliothek.“"
                            },
                            {
                                "example_id": "bd9f8cc0-a302-449e-933a-32224117ff57",
                                "sense_id": "9cdd5f97-83dc-340c-a347-6a31aea1041d",
                                "text": "„Im 16. Jahrhundert besaß die heute in der Universitätsbibliothek Leiden aufbewahrte Handschrift der flämische Humanist und Philosoph Justus Lipsius.“"
                            },
                            {
                                "example_id": "d037d6dc-8a5c-4b76-b264-c85c4d4a9732",
                                "sense_id": "9cdd5f97-83dc-340c-a347-6a31aea1041d",
                                "text": "„Es verging kein Tag in der Universitätsbibliothek, bei dem er nicht irgendein Wort nachschlug und neugierig las, was dazu geschrieben war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
