                ],
                "senses": [
                    {
                        "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                        "entry_id": "6acbc948-32c9-3e3d-94f1-3e242fd2279b",
                        "glosses": [
                            "unflätige Beleidigung, beleidigende Äußerung, Beschimpfung, Schmähung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f5533e-c32f-49e3-b3b5-89764f8a9b67",
                                "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                                "text": "„Die Sitzung wird nach Austausch weiterer heftiger Invektiven ohne Festsetzung eines neuen Datums vertagt.“"
                            },
                            {
                                "example_id": "c049ed7e-f414-49f2-aee5-a657853d622c",
                                "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                                "text": "„Sein Mißmut steigert sich zu Invektiven auf die ‚saudummen Zeitungsartikel‘, auf das deutsche Volk, das ‚ernste Lektüre nicht liebt‘, auf die ‚üblen Prinzessinnenromane‘, die ihren Verfassern große Summen einbringen, ‚während ein Buch wie mein Steppenwolf im ganzen Reich keine Stelle fand, wo ein Vorabdruck möglich gewesen wäre‘.“"
                            },
                            {
                                "example_id": "a55e863a-9a79-4bab-b469-c209e0db7724",
                                "sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                                "text": "„Doch lassen sich die Titanenkämpfe der Epoche nicht trennen von literarischem Futterneid, persönlichen Animositäten und der schieren Lust an der Invektive.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9bd86c1-7422-4c3a-9a9e-8d1899ed5419",
                        "source_entry_id": "6acbc948-32c9-3e3d-94f1-3e242fd2279b",
                        "source_sense_id": "475a8329-2d6e-34b9-9312-d9b2595f970a",
                        "source_sense_description": "unflätige Beleidigung, beleidigende Äußerung, Beschimpfung, Schmähung",
                        "target_lang_word": "invective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invective",
