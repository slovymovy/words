                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba39eeb6-0ef7-49c7-889e-e8ffdd4f3967",
                                "sense_id": "4547f401-45c2-3cab-ba0d-f3cd2bdb3c40",
                                "text": "it is the most dividing and schismatical form that geometricians know of , and must be fain to inglobe or incube herself among the presbyters"
                            },
                            {
                                "example_id": "6a7f7c78-f7c9-401c-9482-733b484ae657",
                                "sense_id": "4547f401-45c2-3cab-ba0d-f3cd2bdb3c40",
                                "text": "The social order incubed in the cosmic cell will be an empire, because the physical sphere is itself imperial."
                            },
                            {
                                "example_id": "8a679bb0-ac26-47cc-b357-597b689e547a",
                                "sense_id": "4547f401-45c2-3cab-ba0d-f3cd2bdb3c40",
                                "text": "Apatite crystals incubed in soil presented numerous corrosion marks as denticulated margin."
                            },
                            {
                                "example_id": "b96774ec-dcb1-4d67-a092-0d9d3d7b20d3",
                                "sense_id": "4547f401-45c2-3cab-ba0d-f3cd2bdb3c40",
                                "text": "Poking round the attic, Jane discovered a packet of Guy's love letters incubed in the same trunk as the muslin gown."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d89dcbe-b43f-3e3e-b253-1766a8135878",
                        "entry_id": "cc00815d-413a-3b90-be2d-aacacfcfa91a",
                        "glosses": [
                            "To incubate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff666d8-7397-49f5-8b17-96c10ada19f0",
                                "sense_id": "2d89dcbe-b43f-3e3e-b253-1766a8135878",
                                "text": "Cartilage was incubed for 24 hours in basal medium containing 0.1 % ovalbumin with or without additions."
                            },
                            {
                                "example_id": "1333efc1-dfeb-4c24-b5a9-d68184ec3c1a",
                                "sense_id": "2d89dcbe-b43f-3e3e-b253-1766a8135878",
                                "text": "During the initial incubation bottles incubed aerobically are agitated on a rotary shaker."
                            },
                            {
                                "example_id": "41823a08-44e8-4e82-b330-9baa4156500b",
                                "sense_id": "2d89dcbe-b43f-3e3e-b253-1766a8135878",
                                "text": "After inoculation the broth tubes are incubed at 37 ± 2 ° C for 48 hours."
                            }
                        ]
                    }
