{
    "word_family": [
        "soaker",
        "soaking",
        "soaky",
        "soakage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "234bafb4-6946-3523-b3fc-4150d3ed1541",
                    "sense_definition": "To immerse something in liquid until it is completely wet or saturated.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "saturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>soak</w> the beans overnight before cooking them to make them soft.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>замочить</w> фасоль на ночь перед приготовлением, чтобы она стала мягкой."
                            }
                        },
                        {
                            "text": "Please <w>soak</w> the dirty dishes in warm soapy water to loosen the food.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>замочите</w> грязную посуду в теплой мыльной воде, чтобы остатки еды отошли."
                            }
                        }
                    ],
                    "synonyms": [
                        "steep",
                        "immerse",
                        "drench"
                    ],
                    "antonyms": [
                        "dry",
                        "dehydrate"
                    ],
                    "common_phrases": [
                        "soak the beans",
                        "soak in water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Погружать что-либо в жидкость до полного намокания или насыщения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замачивать",
                                "target_lang_sense_clarification": "помещать в воду на время"
                            },
                            {
                                "target_lang_word": "вымачивать",
                                "target_lang_sense_clarification": "длительно держать в жидкости"
                            },
                            {
                                "target_lang_word": "замочить",
                                "target_lang_sense_clarification": "поместить в воду (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff3125d9-baf7-3c0e-b657-2301c254caec",
                    "sense_definition": "To stay in a liquid, such as a bath, for a period of time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "saturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to <w>soak</w> in the bath for a couple of hours after work.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь <w>полежать</w> в ванне пару часов после работы."
                            }
                        },
                        {
                            "text": "After the long hike, my tired feet needed to <w>soak</w> in some cold water.",
                            "target_lang_translations": {
                                "ru": "После долгого похода моим уставшим ногам нужно было <w>отмокнуть</w> в холодной воде."
                            }
                        }
                    ],
                    "synonyms": [
                        "bathe"
                    ],
                    "common_phrases": [
                        "soak in the bath",
                        "soak in the tub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в жидкости, например в ванне, в течение некоторого времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмокать",
                                "target_lang_sense_clarification": "лежать в воде для расслабления или очищения"
                            },
                            {
                                "target_lang_word": "нежиться",
                                "target_lang_sense_clarification": "в ванне"
                            },
                            {
                                "target_lang_word": "париться",
                                "target_lang_sense_clarification": "в горячей воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e643910f-3362-3988-8c30-59a38fbd160e",
                    "sense_definition": "To penetrate or pass through something by being absorbed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain began to <w>soak</w> through my jacket during the walk.",
                            "target_lang_translations": {
                                "ru": "Во время прогулки сильный дождь начал <w>просачиваться</w> сквозь мою куртку."
                            }
                        },
                        {
                            "text": "The spilled juice will <w>soak</w> into the carpet if you do not clean it quickly.",
                            "target_lang_translations": {
                                "ru": "Пролитый сок <w>впитается</w> в ковер, если вы быстро его не вытрите."
                            }
                        }
                    ],
                    "synonyms": [
                        "permeate",
                        "penetrate",
                        "seep"
                    ],
                    "common_phrases": [
                        "soak through",
                        "soak into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проникать сквозь что-либо, впитываясь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просачиваться",
                                "target_lang_sense_clarification": "медленно проникать сквозь преграду"
                            },
                            {
                                "target_lang_word": "пропитывать",
                                "target_lang_sense_clarification": "проходить насквозь"
                            },
                            {
                                "target_lang_word": "промокать",
                                "target_lang_sense_clarification": "становиться мокрым насквозь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5809fcf-6bd7-3021-a251-edd1c949d074",
                    "sense_definition": "To absorb liquid, or figuratively, to take in information or atmosphere.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A dry sponge will <w>soak</w> up water much faster than a damp one.",
                            "target_lang_translations": {
                                "ru": "Сухая губка будет <w>впитывать</w> воду гораздо быстрее, чем влажная."
                            }
                        },
                        {
                            "text": "I spent the whole afternoon at the museum to <w>soak</w> up all the knowledge I could.",
                            "target_lang_translations": {
                                "ru": "Я провел весь день в музее, чтобы <w>впитать</w> в себя все знания, какие только мог."
                            }
                        }
                    ],
                    "synonyms": [
                        "absorb",
                        "assimilate"
                    ],
                    "common_phrases": [
                        "soak up the sun",
                        "soak up the atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впитывать жидкость или, в переносном смысле, поглощать информацию или атмосферу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впитывать",
                                "target_lang_sense_clarification": "жидкость или знания"
                            },
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "атмосферу или информацию"
                            },
                            {
                                "target_lang_word": "вбирать",
                                "target_lang_sense_clarification": "в себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f08f2a7-ec00-3394-8b2c-adf4a7d48075",
                    "sense_definition": "To overcharge someone or force them to pay a very large amount of money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_exploitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>soak</w> the rich by increasing the highest tax bracket.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>обобрать</w> богатых, повысив максимальную налоговую ставку."
                            }
                        },
                        {
                            "text": "The shady contractor tried to <w>soak</w> the homeowners for thousands of dollars in unnecessary repairs.",
                            "target_lang_translations": {
                                "ru": "Подозрительный подрядчик пытался <w>ободрать</w> домовладельцев на тысячи долларов за ненужный ремонт."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleece",
                        "overcharge",
                        "exploit"
                    ],
                    "common_phrases": [
                        "soak the rich"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in political or financial contexts regarding taxes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо платить чрезмерно большую сумму денег; обдирать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдирать",
                                "target_lang_sense_clarification": "заставлять платить слишком много"
                            },
                            {
                                "target_lang_word": "оббирать",
                                "target_lang_sense_clarification": "лишать денег налогами или ценами"
                            },
                            {
                                "target_lang_word": "драть три шкуры",
                                "target_lang_sense_clarification": "идиома о высоких ценах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "097befda-d6ec-363d-a3e7-ef86d66fa347",
                    "sense_definition": "To drink alcohol excessively or frequently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would spend every Friday night at the pub to <w>soak</w> with his old friends.",
                            "target_lang_translations": {
                                "ru": "Каждую пятницу он проводил вечер в пабе, чтобы <w>пьянствовать</w> со своими старыми друзьями."
                            }
                        },
                        {
                            "text": "The old man had done nothing but <w>soak</w> in gin for the last twenty years.",
                            "target_lang_translations": {
                                "ru": "Старик последние двадцать лет только и делал, что <w>глушил</w> джин."
                            }
                        }
                    ],
                    "synonyms": [
                        "tipple",
                        "booze",
                        "carouse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно или часто употреблять алкоголь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьянствовать",
                                "target_lang_sense_clarification": "регулярно пить"
                            },
                            {
                                "target_lang_word": "квасить",
                                "target_lang_sense_clarification": "разговорное о выпивке"
                            },
                            {
                                "target_lang_word": "закладывать",
                                "target_lang_sense_clarification": "за воротник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "925258a7-b09c-3317-8150-a03ad12ec32c",
                    "sense_definition": "To maintain a specific temperature in a kiln or furnace for a set period.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "industrial_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The potter needs to <w>soak</w> the kiln at the peak temperature to ensure the glaze matures.",
                            "target_lang_translations": {
                                "ru": "Гончару необходимо <w>выдержать</w> печь при пиковой температуре, чтобы глазурь закрепилась."
                            }
                        },
                        {
                            "text": "We should <w>soak</w> the metal at a high heat before attempting to shape it.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>прогреть</w> металл при высокой температуре, прежде чем пытаться придать ему форму."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soak the kiln"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать определенную температуру в печи в течение заданного периода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдерживать",
                                "target_lang_sense_clarification": "при температуре"
                            },
                            {
                                "target_lang_word": "прогревать",
                                "target_lang_sense_clarification": "равномерно"
                            },
                            {
                                "target_lang_word": "отжигать",
                                "target_lang_sense_clarification": "в промышленном контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2648112e-5e1e-39ba-b5b7-f4abdfc6c88a",
                    "sense_definition": "To hit or strike someone hard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer managed to <w>soak</w> his opponent with a powerful right hook.",
                            "target_lang_translations": {
                                "ru": "Боксеру удалось <w>врезать</w> противнику мощным правым хуком."
                            }
                        },
                        {
                            "text": "He was angry enough to <w>soak</w> anyone who got in his way.",
                            "target_lang_translations": {
                                "ru": "Он был достаточно зол, чтобы <w>ударить</w> любого, кто встанет у него на пути."
                            }
                        }
                    ],
                    "synonyms": [
                        "clobber",
                        "wallop",
                        "smack"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "specifically boxing or old-fashioned slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "сильно ударить"
                            },
                            {
                                "target_lang_word": "съездить",
                                "target_lang_sense_clarification": "по лицу или телу"
                            },
                            {
                                "target_lang_word": "надавать",
                                "target_lang_sense_clarification": "ударов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25f012b0-a471-352e-93e3-ca1c7f2b0d73",
                    "sense_definition": "The act of immersing oneself or something in liquid.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "saturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the strenuous climb, I had a nice long <w>soak</w> in a hot bath.",
                            "target_lang_translations": {
                                "ru": "После изнурительного восхождения я с удовольствием долго <w>отмокал</w> в горячей ванне."
                            }
                        },
                        {
                            "text": "The recipe requires a two-hour <w>soak</w> for the dried fruit before baking.",
                            "target_lang_translations": {
                                "ru": "Рецепт требует двухчасового <w>замачивания</w> сухофруктов перед выпечкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "immersion",
                        "bath"
                    ],
                    "common_phrases": [
                        "long soak",
                        "hot soak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт погружения себя или чего-либо в жидкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замачивание",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "принятие ванны",
                                "target_lang_sense_clarification": "для человека"
                            },
                            {
                                "target_lang_word": "вымачивание",
                                "target_lang_sense_clarification": "продуктов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a73f34b7-9d3f-33cc-88b8-eaaa793c06cf",
                    "sense_definition": "A low-lying area of land that collects water after it rains.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cattle gathered around the <w>soak</w> to drink the remaining rainwater.",
                            "target_lang_translations": {
                                "ru": "Скот собрался вокруг <w>низины</w>, чтобы выпить оставшуюся дождевую воду."
                            }
                        },
                        {
                            "text": "We found plenty of frogs living in the <w>soak</w> further down the river.",
                            "target_lang_translations": {
                                "ru": "Мы нашли множество лягушек, живущих в <w>заводи</w> ниже по реке."
                            }
                        }
                    ],
                    "synonyms": [
                        "hollow",
                        "depression",
                        "watering hole"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низменный участок земли, где собирается вода после дождя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочажина",
                                "target_lang_sense_clarification": "влажное место"
                            },
                            {
                                "target_lang_word": "низина",
                                "target_lang_sense_clarification": "с водой"
                            },
                            {
                                "target_lang_word": "водопой",
                                "target_lang_sense_clarification": "место сбора воды для животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e554a9d9-b6c6-377e-a4be-1af6af1a8dac",
                    "sense_definition": "A person who habitually drinks too much alcohol.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>soak</w> could be found at the corner of the bar every single afternoon.",
                            "target_lang_translations": {
                                "ru": "Старого <w>пьяницу</w> можно было найти в углу бара каждый божий день."
                            }
                        },
                        {
                            "text": "He was known as a bit of a <w>soak</w> in his younger days, but he is sober now.",
                            "target_lang_translations": {
                                "ru": "В молодости он был известен как изрядный <w>пропойца</w>, но сейчас он в завязке."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunkard",
                        "boozer",
                        "sot",
                        "alcoholic"
                    ],
                    "antonyms": [
                        "teetotaler"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который привычно пьет слишком много алкоголя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяница",
                                "target_lang_sense_clarification": "человек, злоупотребляющий алкоголем"
                            },
                            {
                                "target_lang_word": "пропойца",
                                "target_lang_sense_clarification": "презрительно"
                            },
                            {
                                "target_lang_word": "алкаш",
                                "target_lang_sense_clarification": "грубо-разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "757e5001-faa2-3a5a-b94a-55b8e912964b",
                    "sense_definition": "A period of heavy drinking; a drinking session.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors went on a massive <w>soak</w> as soon as they reached the port.",
                            "target_lang_translations": {
                                "ru": "Матросы устроили грандиозную <w>попойку</w>, как только добрались до порта."
                            }
                        },
                        {
                            "text": "What started as a quick pint turned into an all-night <w>soak</w>.",
                            "target_lang_translations": {
                                "ru": "То, что начиналось как быстрая кружка пива, превратилось в ночной <w>кутеж</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "carouse",
                        "bender",
                        "spree"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период сильного пьянства; попойка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попойка",
                                "target_lang_sense_clarification": "застолье с алкоголем"
                            },
                            {
                                "target_lang_word": "запой",
                                "target_lang_sense_clarification": "длительное пьянство"
                            },
                            {
                                "target_lang_word": "кутеж",
                                "target_lang_sense_clarification": "шумное веселье с выпивкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}