                    {
                        "sense_id": "bd81214b-43a0-32f9-a6ed-45867e392cd3",
                        "entry_id": "9c2f8083-a419-3b71-bc3a-50e0edb8eb42",
                        "glosses": [
                            "Unart, Unartigkeit, Ungezogenheit, Frechheit, Dreistigkeit; Unanständigkeit"
                        ],
                        "tags": [
                            "von Kindern",
                            "auch ironisch von Erwachsenen und umgangssprachlich auf Erotik bezogen"
                        ],
