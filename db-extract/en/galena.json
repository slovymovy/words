            {
                "entry_id": "87521c73-ed9a-3f6e-8735-3c68e00606c7",
                "word": "galena",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2a1b6d48-458d-4af1-ab8b-38d0e7bfc2ea",
                        "entry_id": "87521c73-ed9a-3f6e-8735-3c68e00606c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "galenas"
                    },
                    {
                        "form_id": "98cb5d70-222c-4236-be1d-1bbdae359a20",
                        "entry_id": "87521c73-ed9a-3f6e-8735-3c68e00606c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "galenae"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5956006-f7b7-36ba-9e7e-c6f1f0ab2de7",
                        "entry_id": "87521c73-ed9a-3f6e-8735-3c68e00606c7",
                        "glosses": [
                            "A mineral, lead sulphide (PbS), mined as an ore for lead."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a8aa9c27-8398-46a9-8d18-575e6c7d124a",
                                "sense_id": "f5956006-f7b7-36ba-9e7e-c6f1f0ab2de7",
                                "text": "You can easily extract lead from galena, a natural mineral which has been used in crystal radio receivers."
                            },
                            {
                                "example_id": "c430f6c4-0ed4-4c52-9b33-f13ac6c4661f",
                                "sense_id": "f5956006-f7b7-36ba-9e7e-c6f1f0ab2de7",
                                "text": "1942, G. F. Loughlin, A. H. Koschmann, Geology and Ore Deposits of the Magdalena Mining District, New Mexico, Geological Survey Professional Paper, Issue 200, page 98,\nThe galena of the ore contains microscopic inclusions of various forms that become visible upon polished surfaces etched with hydrochloric or nitric acid."
                            },
                            {
                                "example_id": "297f7628-6523-4e7a-b698-619aa0238e34",
                                "sense_id": "f5956006-f7b7-36ba-9e7e-c6f1f0ab2de7",
                                "text": "These samples had higher Pb²⁰⁶ and Pb²⁰⁸ abundances than any other galenas yet examined."
                            },
                            {
                                "example_id": "e51035b5-8094-4eed-944e-492e65609f06",
                                "sense_id": "f5956006-f7b7-36ba-9e7e-c6f1f0ab2de7",
                                "text": "Very little galena has been reported (recovered mostly from burial mounds) in the Great Lakes region indicating that the mineral was not a major interregional exchange commodity during this period. However, numerous galenas have been recovered from the lower Mississippi Valley region and Florida indicating that galena was part of an important north-south exchange system (Walthall 1981)."
                            }
                        ]
                    },
                    {
                        "sense_id": "a314dab5-9e18-33d7-8da4-9a2022f06dd0",
                        "entry_id": "87521c73-ed9a-3f6e-8735-3c68e00606c7",
                        "glosses": [
                            "A remedy or antidote for poison; theriac"
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c77bdbc-d066-4d2f-9a38-23a3a82f6ca0",
                        "source_entry_id": "87521c73-ed9a-3f6e-8735-3c68e00606c7",
                        "source_sense_description": "mineral",
                        "target_lang_word": "galène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "460ef9d4-bc10-37b5-b3c7-313bb7795b6d",
                                        "entry_id": "24607c38-b42b-3afa-a4f4-92011e7ac69f",
                                        "glosses": [
                                            "Espèce minérale composée de sulfure de plomb de formule brute PbS."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66027319-e819-41da-a670-30a0e6802eb1",
                                                "sense_id": "460ef9d4-bc10-37b5-b3c7-313bb7795b6d",
                                                "text": "— Alors qu’il soit aveuglé ! Apportez la galène, faites rougir le fer."
                                            },
                                            {
                                                "example_id": "bf63f82c-f07c-4ff7-8f8d-48bb756b28de",
                                                "sense_id": "460ef9d4-bc10-37b5-b3c7-313bb7795b6d",
                                                "text": "Le minerai de cette fondrière est souvent pyriteux et contient, dans sa masse, de la galène disséminée en petits fragments."
                                            },
                                            {
                                                "example_id": "6830b99e-3c36-460e-8144-8d5d4fe577ce",
                                                "sense_id": "460ef9d4-bc10-37b5-b3c7-313bb7795b6d",
                                                "text": "Riche par la fertilité du sol, il l’est aussi de toute la fortune enfouie dans ses entrailles […] mines de Torotzko, qui produisent le plomb, la galène, le mercure, et surtout le fer, dont les gisements étaient exploités dès le Xᵉ siècle ;"
                                            },
                                            {
                                                "example_id": "838c42e4-466b-4f99-a719-0f9aa39e8380",
                                                "sense_id": "460ef9d4-bc10-37b5-b3c7-313bb7795b6d",
                                                "text": "L’argent natif est présent sous forme microscopique dans certains cuivres gris et dans certaines galènes : il semble bien y être hypogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3db9f52-455d-31d7-bc36-9143c1e4d5cb",
                                        "entry_id": "24607c38-b42b-3afa-a4f4-92011e7ac69f",
                                        "glosses": [
                                            "Diode à semiconducteur primitive faite à partir de ce minéral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f7d0a4-103f-43a7-9305-ce412c6ba040",
                                                "sense_id": "f3db9f52-455d-31d7-bc36-9143c1e4d5cb",
                                                "text": "La galène a sans doute été l’un des premiers composants à semiconducteur utilisés, sinon par le grand public, du moins par une minorité de passionnés."
                                            },
                                            {
                                                "example_id": "d08bfb20-5d44-4565-9ae8-a6a81c073258",
                                                "sense_id": "f3db9f52-455d-31d7-bc36-9143c1e4d5cb",
                                                "text": "Mon père nous racontait qu’enfant, il bricolait des postes à galène, mais nous n’en n’avons jamais vu fonctionner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21dd9f44-b77d-430a-a796-9c147fd73714",
                        "source_entry_id": "87521c73-ed9a-3f6e-8735-3c68e00606c7",
                        "source_sense_description": "mineral",
                        "target_lang_word": "Galenit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galenit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e61b4b9-3e0b-37a9-b5b8-731909da046d",
                                        "entry_id": "09b134db-28d4-327b-8523-ac5c5826374f",
                                        "glosses": [
                                            "Mineral aus der Mineralklasse der Sulfide und Sulfosalze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f31dc31b-4ad0-4696-9d25-a42fbc6f62cd",
                                                "sense_id": "7e61b4b9-3e0b-37a9-b5b8-731909da046d",
                                                "text": "„Geneigter Twitterer, am Himmel über der Pangaea Crusader ballen sich Gewitterwolken. Ihr Farbe ist die von Galenit, die Farbe, die mein Mund sieht, wenn ich auf einem Graphitstift kaue.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
