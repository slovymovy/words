                                "cs": "<w>Odkud</w> pocházíš?",
                                "tr": "<w>Nereden</w> geliyorsun?",
                                "es": "¿De dónde <w>vienes</w>?",
                                "zh": "你<w>从</w>哪里来？"
                            }
                        },
                        {
                            "text": "Ik weet niet waar dat vreemde geluid <w>vandaan</w> komt.",
