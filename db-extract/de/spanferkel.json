                    {
                        "sense_id": "53e92df9-a100-300c-816a-a3b34c6ec918",
                        "entry_id": "bc551de5-12c6-3c4e-8504-5339764fc960",
                        "glosses": [
                            "Variante der Zubereitung für Schwein, wobei das junge Schwein dabei auf einem Drehspieß gegart wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab538aaa-52d5-4c4a-b67f-b9e77b7746e1",
                                "sense_id": "53e92df9-a100-300c-816a-a3b34c6ec918",
                                "text": "Das Spanferkel schmeckt vielleicht durchgebraten am besten."
                            },
                            {
                                "example_id": "1139d99f-b711-4710-a846-63c6595597a4",
                                "sense_id": "53e92df9-a100-300c-816a-a3b34c6ec918",
                                "text": "„Darin schmorte ein kleines Spanferkel.“"
                            },
                            {
                                "example_id": "d19e7141-d298-44d7-84c3-9b4e5c984f37",
                                "sense_id": "53e92df9-a100-300c-816a-a3b34c6ec918",
                                "text": "„Der Cabiai wurde aufgespießt und wie ein gewöhnliches Spanferkel über dem Feuer geröstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
