                ],
                "senses": [
                    {
                        "sense_id": "54731c39-dec1-31c1-bfe2-3a49445fbd45",
                        "entry_id": "5fb31283-db4c-3483-b357-1ad522b4eefd",
                        "glosses": [
                            "ein aus einem Abbruch stammender Stein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0237ca-9164-4823-889a-ae46e4a68c30",
                                "sense_id": "54731c39-dec1-31c1-bfe2-3a49445fbd45",
                                "text": "So manche deutsche Großstadt wurde nach dem Krieg aus Abbruchsteinen wieder aufgebaut."
                            },
                            {
                                "example_id": "98aa922b-df42-4bf8-891f-f884ac14387d",
                                "sense_id": "54731c39-dec1-31c1-bfe2-3a49445fbd45",
                                "text": "„Bis vor ca. 100 Jahren wurden Häuser noch aus sogenannten \"Abbruchsteinen\" erstellt; heute sind diese Häuser […] ein beliebter Platz zum Wohnen.“"
                            },
                            {
                                "example_id": "48c2468e-f36f-4d24-b18a-8418f19e3b41",
                                "sense_id": "54731c39-dec1-31c1-bfe2-3a49445fbd45",
                                "text": "„Den \"echten\" Feldbrandstein gibt es eigentlich nur noch als Abbruchstein […].“"
                            },
                            {
                                "example_id": "02c130e1-54b5-404a-be47-ab8ebdfa9c04",
                                "sense_id": "54731c39-dec1-31c1-bfe2-3a49445fbd45",
                                "text": "„Bei einem neuen Bauprojekt […] sollen passende Feldbrandsteine, Abbruchklinker und Abbruchsteine verbaut werden.“"
                            },
                            {
                                "example_id": "6e6e1d9c-fc1f-4fdf-beba-0731db397f8a",
                                "sense_id": "54731c39-dec1-31c1-bfe2-3a49445fbd45",
                                "text": "„Mit den Abbruchsteinen der Hauptsynagoge und der Börneplatz-Synagoge ließ die Stadt 1939 die 165 m lange Mauer des Hauptfriedhofes nördlich der Leichenhalle errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
