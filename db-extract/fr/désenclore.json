                ],
                "senses": [
                    {
                        "sense_id": "d6bf8460-5700-3b99-9a56-2799b975bd92",
                        "entry_id": "e3c5c971-50c1-38a6-b8ec-516aa84c3df6",
                        "glosses": [
                            "Cesser d’enclore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d114d0-bcf6-4fd5-ba2e-57106180e873",
                                "sense_id": "d6bf8460-5700-3b99-9a56-2799b975bd92",
                                "text": "Quand il la regardait en dessous, ou alors considérant le lavabo, perplexe devant les robinets, plein d’affection pour une légère crasse, cloison japonaise du corps qui le divise sans le désenclore."
                            },
                            {
                                "example_id": "03b4965d-b97f-4ea4-92e1-b12afae1f290",
                                "sense_id": "d6bf8460-5700-3b99-9a56-2799b975bd92",
                                "text": "Du coup, au lieu de construire du lien pour élaborer un « nous », il suffirait au contraire de déconstruire les clôtures illusoires, défaire les frontières, désenclore les subjectivités."
                            },
                            {
                                "example_id": "52075255-ed74-431e-b7c3-3cb753365f5c",
                                "sense_id": "d6bf8460-5700-3b99-9a56-2799b975bd92",
                                "text": "Aux temps modernes, il n’est souvent plus qu’un moment ou une étape d’une recherche qui le dépasse infiniment ; il tend ainsi à se désenclore pour s’organiser parfois en suite de textes numérotés ou en succession de fragments."
                            }
                        ]
                    }
                ],
