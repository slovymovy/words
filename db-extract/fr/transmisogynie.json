                    },
                    {
                        "translation_id": "172b38bc-3aeb-4f17-b8af-c17bc6f3e5c6",
                        "source_entry_id": "8345f3c6-df8b-368f-88a1-889b955f5697",
                        "source_sense_id": "04ecfeef-ce52-3e09-af63-dcca587bdd03",
                        "target_lang_word": "transmisogyny",
