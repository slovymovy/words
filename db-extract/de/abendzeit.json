                    {
                        "translation_id": "40fef47f-5441-456d-8cba-9c094e6180bb",
                        "source_entry_id": "51a2352e-3f43-3b04-a2e9-87d1de6a0d63",
                        "source_sense_id": "6ee7d18e-fee6-3dd0-8bca-ac08091f7cdc",
                        "source_sense_description": "die Zeit am Abend",
                        "target_lang_word": "evening",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf1028f-273f-3a41-9662-50f9a73addc6",
                                        "entry_id": "ea10eeeb-df94-3323-97c1-dbac4be7c5a9",
                                        "glosses": [
                                            "The time of day between afternoon and night."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd6abb25-823e-440b-9fa7-421c459f6198",
                                                "sense_id": "bdf1028f-273f-3a41-9662-50f9a73addc6",
                                                "text": "Toward evening, there was heavy rain."
                                            },
                                            {
                                                "example_id": "f1d7b6e8-bc96-44fe-8db1-dcd04062ce43",
                                                "sense_id": "bdf1028f-273f-3a41-9662-50f9a73addc6",
                                                "text": "I met my wife on a summer's evening in 1999."
                                            },
                                            {
                                                "example_id": "4c4a0257-dddc-419a-a51a-7af2eb422eb7",
                                                "sense_id": "bdf1028f-273f-3a41-9662-50f9a73addc6",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd948379-e2cd-33f7-9a8d-ff9898a9bb87",
                                        "entry_id": "ea10eeeb-df94-3323-97c1-dbac4be7c5a9",
                                        "glosses": [
                                            "The time of the day between the approximate time of midwinter dusk and midnight (compare afternoon); the period after the end of regular office working hours."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff5a3817-6d47-4462-b514-81cf74e301d3",
                                                "sense_id": "bd948379-e2cd-33f7-9a8d-ff9898a9bb87",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…] In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            },
                                            {
                                                "example_id": "698619d4-1cd5-4a4a-8fe3-e13eabf74609",
                                                "sense_id": "bd948379-e2cd-33f7-9a8d-ff9898a9bb87",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19db0f73-83a7-356e-8ff0-6b12fddf1c92",
                                        "entry_id": "ea10eeeb-df94-3323-97c1-dbac4be7c5a9",
                                        "glosses": [
                                            "A concluding time period; a point in time near the end of something; the beginning of the end of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "267e380b-13b4-42d9-b496-2df57d00db4d",
                                                "sense_id": "19db0f73-83a7-356e-8ff0-6b12fddf1c92",
                                                "text": "It was the evening of the Roman Empire."
                                            },
                                            {
                                                "example_id": "ccfc6617-79f3-4c16-9993-cc0d8d1fcee8",
                                                "sense_id": "19db0f73-83a7-356e-8ff0-6b12fddf1c92",
                                                "text": "The latter [locomotive] had worked on the Hampton Court branch for many years, and was spending the evening of its life in the West Country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba029625-14f9-322c-8e18-e94949b21457",
                                        "entry_id": "ea10eeeb-df94-3323-97c1-dbac4be7c5a9",
                                        "glosses": [
                                            "A party or gathering held in the evening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ec78549-1955-4592-8639-41e7f7cebbee",
                                                "sense_id": "ba029625-14f9-322c-8e18-e94949b21457",
                                                "text": "A few Gorllewin Cymru/West Wales Branch members attended an evening at the Dragon Hotel, Swansea, titled Photographic Techniques in Industry."
                                            }
                                        ]
                                    }
                                ]
                            },
