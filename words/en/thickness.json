                },
                {
                    "sense_id": "3622e0a6-44b1-3aa8-a78f-927a4116988f",
                    "sense_definition": "The quality of being thick in consistency or viscosity, especially of a liquid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Whip the cream until it reaches a good <w>thickness</w> for the cake.",
                            "target_lang_translations": {
                                "ru": "Взбивайте сливки, пока они не достигнут нужной <w>густоты</w> для торта."
                            }
                        },
                        {
                            "text": "The sauce had a perfect <w>thickness</w> and coated the back of the spoon.",
                            "target_lang_translations": {
                                "ru": "Соус имел идеальную <w>консистенцию</w> и обволакивал обратную сторону ложки."
                            }
