                "senses": [
                    {
                        "sense_id": "bae5a214-01b5-306c-8aaa-b3a274282d9c",
                        "entry_id": "92aeb0b8-e79a-3708-90fc-c7c9a0679d5b",
                        "glosses": [
                            "Vorgang, landwirtschaftlich unfruchtbares Land (wieder) nutzbar zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfade96f-7c18-4aa1-83f3-5d346fb90e0e",
                                "sense_id": "bae5a214-01b5-306c-8aaa-b3a274282d9c",
                                "text": "„Einschließlich der Aufwendungen für Urbarmachungen in der Lüneburger Heide und im Emsland wollen die ZvD-Planer für die Landwirtschaft im ersten Jahre 500 Millionen und im zweiten und dritten Jahre je 800 bis 1000 Millionen DM einsetzen.“"
                            },
                            {
                                "example_id": "312968f9-c68b-4024-acbe-958735b3db5e",
                                "sense_id": "bae5a214-01b5-306c-8aaa-b3a274282d9c",
                                "text": "„Die Urbarmachung der Tropen war vor allem ein Kampf gegen das Gelbfieber übertragende Moskitos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
