                                        "sense_id": "75db9ac0-ccc0-37d8-b3f9-273ce2263dc4",
                                        "entry_id": "b0f22587-7ea7-3825-abcd-7cc4814d3cfb",
                                        "glosses": [
                                            "A strumpet; a whore."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313e511b-fc48-4b57-87ea-cedcec0014c9",
                                                "sense_id": "75db9ac0-ccc0-37d8-b3f9-273ce2263dc4",
                                                "text": "Many an unfortunate Tuppenny trollop has gone from the old hag's den to the special ward at Little Bay, but not before the fell disease of the harlotic slums has been spread broadcast among the reckless patrons."
                                            },
                                            {
                                                "example_id": "032ca6f5-95e6-4041-8ea0-e32f759d3765",
                                                "sense_id": "75db9ac0-ccc0-37d8-b3f9-273ce2263dc4",
                                                "text": "However, terrible as it may seem to the tall maiden sisters of J.P.'s in Queen Anne houses with walled vegetable gardens, this courtesan, strumpet, harlot, whore, punk, fille de joie, street-walker, this trollop, this trull, this baggage, this hussy, this drab, skit, rig, quean, mopsy, demirep, demimondaine, this wanton, this fornicatress, this doxy, this concubine, this frail sister, this poor Queenie--did actually solicit me, did actually say 'coming home to-night, dearie' and my soul was not blasted enough to call a policeman."
                                            },
                                            {
                                                "example_id": "62836572-0647-4f96-88e5-1b39f883e87b",
                                                "sense_id": "75db9ac0-ccc0-37d8-b3f9-273ce2263dc4",
                                                "text": "Aarfy's buxom trollop had vanished with her smutty cameo ring, and Nurse Duckett was ashamed of him because he had refused to fly more combat missions and would cause a scandal."
                                            }
                                        ]
                                    }
                                ]
