                                "target_senses": [
                                    {
                                        "sense_id": "a7a23bcc-b63d-3c05-9413-26f906bea9e5",
                                        "entry_id": "e054eaaa-8775-3549-b43d-32d9c169bd56",
                                        "glosses": [
                                            "Initialism of unidentified flying object; (loosely) an alien spacecraft."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22208a56-f71c-4162-ac6e-2790cc78ff5d",
                                                "sense_id": "a7a23bcc-b63d-3c05-9413-26f906bea9e5",
                                                "text": "After the case had been reported in the newspapers, Mrs. Gracindo de Souza, wife of a member of the local stock exchange, told police that she and her daughter had been driving down Alameda Sao Boaventura when they had seen an^([sic]) UFO hovering over the clearing where the bodies were later discovered."
                                            },
                                            {
                                                "example_id": "d4dcae52-55c1-4591-aab7-7685de67a32d",
                                                "sense_id": "a7a23bcc-b63d-3c05-9413-26f906bea9e5",
                                                "text": "To my way of thinking, there is every bit as much evidence for the existence of UFOs as there is for the existence of God. Probably far more. At least in the case of UFOs there have been countless taped and filmed—and, by the way, unexplained—sightings from all over the world, along with documented radar evidence seen by experienced military and civilian radar operators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7257923b-709a-3792-b0da-3a1274a09c54",
                                        "entry_id": "e054eaaa-8775-3549-b43d-32d9c169bd56",
                                        "glosses": [
                                            "An \\\"unfinished object\\\" in knitting or other kinds of craft."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7fc48f8-ab5a-4fd4-83ad-d7f8c3f894e1",
                                                "sense_id": "7257923b-709a-3792-b0da-3a1274a09c54",
                                                "text": "UFOs differ from WIPs in that a WIP is a project one is actively pursuing, while a UFO runs the risk of never getting finished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "261233fc-a15a-3ada-a9b4-7ebb3acd74fc",
                                        "entry_id": "e054eaaa-8775-3549-b43d-32d9c169bd56",
                                        "glosses": [
                                            "Initialism of ultrared flattened object."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
