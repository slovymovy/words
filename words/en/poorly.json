{
    "word_family": [
        "poor",
        "poorness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "077f8942-dc10-3479-83dc-b0c35be4bcd8",
                    "sense_definition": "In a way that shows a lack of skill, quality, or ability.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He plays tennis <w>poorly</w> because he never practices.",
                            "target_lang_translations": {
                                "ru": "Он <w>плохо</w> играет в теннис, потому что никогда не тренируется.",
                                "zh": "他网球打得<w>很糟糕</w>，因为他从不练习。"
                            }
                        },
                        {
                            "text": "The essay was written <w>poorly</w> and was difficult to understand.",
                            "target_lang_translations": {
                                "ru": "Эссе было написано <w>плохо</w>, и его было трудно понять.",
                                "zh": "这篇文章写得<w>很差</w>，让人难以理解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "badly",
                        "incompetently",
                        "ineptly"
                    ],
                    "antonyms": [
                        "well",
                        "skillfully",
                        "superbly"
                    ],
                    "common_phrases": [
                        "perform poorly",
                        "written poorly",
                        "play poorly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, демонстрирующим недостаток навыков, качества или способностей.",
                        "zh": "以缺乏技巧、质量或能力的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плохо",
                                "target_lang_sense_clarification": "некачественно"
                            },
                            {
                                "target_lang_word": "неумело",
                                "target_lang_sense_clarification": "без должных навыков"
                            },
                            {
                                "target_lang_word": "скверно",
                                "target_lang_sense_clarification": "очень плохо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕地",
                                "target_lang_sense_clarification": "质量差"
                            },
                            {
                                "target_lang_word": "笨拙地",
                                "target_lang_sense_clarification": "缺乏技巧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "762d97fa-ba78-3b72-808f-f5cc7340b515",
                    "sense_definition": "With little success or to an unsatisfactory degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company continued to do <w>poorly</w> in business despite the new strategy.",
                            "target_lang_translations": {
                                "ru": "Дела у компании продолжали идти <w>плохо</w>, несмотря на новую стратегию.",
                                "zh": "尽管有了新策略，公司的业务表现依然<w>不佳</w>。"
                            }
                        },
                        {
                            "text": "Students often perform <w>poorly</w> on exams if they do not get enough sleep.",
                            "target_lang_translations": {
                                "ru": "Студенты часто <w>плохо</w> сдают экзамены, если не высыпаются.",
                                "zh": "如果睡眠不足，学生考试往往<w>发挥失常</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unsuccessfully",
                        "unsatisfactorily",
                        "badly",
                        "inadequately"
                    ],
                    "antonyms": [
                        "successfully",
                        "well"
                    ],
                    "common_phrases": [
                        "do poorly",
                        "poorly targeted"
                    ],
                    "target_lang_definitions": {
                        "ru": "С небольшим успехом или в неудовлетворительной степени.",
                        "zh": "成功率低或程度不尽如人意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плохо",
                                "target_lang_sense_clarification": "неуспешно"
                            },
                            {
                                "target_lang_word": "неудовлетворительно",
                                "target_lang_sense_clarification": "ниже ожидаемого уровня"
                            },
                            {
                                "target_lang_word": "неважно",
                                "target_lang_sense_clarification": "посредственно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不理想",
                                "target_lang_sense_clarification": "结果不佳"
                            },
                            {
                                "target_lang_word": "表现不佳",
                                "target_lang_sense_clarification": "成绩或表现差"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2dbce81-bdb3-3c75-b3e5-7e9b92523466",
                    "sense_definition": "With disapproval or a low opinion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think <w>poorly</w> of them for leaving the project unfinished.",
                            "target_lang_translations": {
                                "ru": "Я <w>плохо</w> думаю о них из-за того, что они оставили проект незавершенным.",
                                "zh": "他们没完成项目，我对此<w>评价不高</w>。"
                            }
                        },
                        {
                            "text": "She looked <w>poorly</w> on the suggestion to cut the budget further.",
                            "target_lang_translations": {
                                "ru": "Она <w>неодобрительно</w> отнеслась к предложению еще больше урезать бюджет.",
                                "zh": "她对进一步削减预算的建议<w>不以为然</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unfavorably",
                        "negatively"
                    ],
                    "antonyms": [
                        "highly",
                        "favorably"
                    ],
                    "common_phrases": [
                        "think poorly of",
                        "speak poorly of",
                        "look poorly on"
                    ],
                    "target_lang_definitions": {
                        "ru": "С неодобрением или невысоким мнением.",
                        "zh": "带有不赞同或评价不高。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плохо",
                                "target_lang_sense_clarification": "негативно"
                            },
                            {
                                "target_lang_word": "невысоко",
                                "target_lang_sense_clarification": "о мнении или оценке"
                            },
                            {
                                "target_lang_word": "неодобрительно",
                                "target_lang_sense_clarification": "с осуждением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不以为然",
                                "target_lang_sense_clarification": "不赞同"
                            },
                            {
                                "target_lang_word": "评价不高",
                                "target_lang_sense_clarification": "看法负面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec7955f-0090-3066-95d1-71c647a17175",
                    "sense_definition": "In a condition of poverty or lack of resources.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to live <w>poorly</w> for many years after losing their farm.",
                            "target_lang_translations": {
                                "ru": "Им пришлось жить <w>бедно</w> много лет после потери фермы.",
                                "zh": "失去农场后，他们<w>贫困</w>地生活了多年。"
                            }
                        },
                        {
                            "text": "The peasants were dressed <w>poorly</w> in old rags.",
                            "target_lang_translations": {
                                "ru": "Крестьяне были <w>бедно</w> одеты в старое тряпье.",
                                "zh": "农民们穿着破烂，打扮得十分<w>寒酸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "meagerly"
                    ],
                    "antonyms": [
                        "richly",
                        "wealthily"
                    ],
                    "common_phrases": [
                        "live poorly",
                        "dressed poorly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии бедности или нехватки ресурсов.",
                        "zh": "处于贫困或资源匮乏的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедно",
                                "target_lang_sense_clarification": "в нужде"
                            },
                            {
                                "target_lang_word": "скудно",
                                "target_lang_sense_clarification": "о ресурсах или одежде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贫困地",
                                "target_lang_sense_clarification": "生活拮据"
                            },
                            {
                                "target_lang_word": "寒酸地",
                                "target_lang_sense_clarification": "衣着或环境简陋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23851272-9987-3aa1-b1b6-06d00145187e",
                    "sense_definition": "In a mean or cowardly manner; without spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>poorly</w> retired from the war rather than fighting for their land.",
                            "target_lang_translations": {
                                "ru": "Они <w>малодушно</w> отступили с войны, вместо того чтобы сражаться за свою землю.",
                                "zh": "他们没有为保卫家园而战，而是<w>怯懦地</w>退出了战争。"
                            }
                        },
                        {
                            "text": "He acted <w>poorly</w> and without the courage expected of a leader.",
                            "target_lang_translations": {
                                "ru": "Он поступил <w>трусливо</w>, без мужества, ожидаемого от лидера.",
                                "zh": "他的行为<w>卑劣</w>，缺乏领导者应有的勇气。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "implied by context and usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подло или трусливо; без присутствия духа.",
                        "zh": "以卑劣或怯懦的方式；缺乏勇气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малодушно",
                                "target_lang_sense_clarification": "безвольно"
                            },
                            {
                                "target_lang_word": "трусливо",
                                "target_lang_sense_clarification": "со страхом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怯懦地",
                                "target_lang_sense_clarification": "缺乏勇气"
                            },
                            {
                                "target_lang_word": "卑劣地",
                                "target_lang_sense_clarification": "行为不光彩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2e113a0f-cb81-3b1c-a8b1-a81499759137",
                    "sense_definition": "Not in good health; unwell.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My cousin is very <w>poorly</w> right now and needs to stay in the hospital.",
                            "target_lang_translations": {
                                "ru": "Мой кузен сейчас очень <w>болен</w>, и ему нужно оставаться в больнице.",
                                "zh": "我表弟现在<w>病得很重</w>，需要住院治疗。"
                            }
                        },
                        {
                            "text": "You look a bit <w>poorly</w>, so perhaps you should go home and rest.",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь немного <w>нездоровым</w>, так что, возможно, тебе стоит пойти домой и отдохнуть.",
                                "zh": "你看上去有点<w>不舒服</w>，也许你应该回家休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ill",
                        "unwell",
                        "sick"
                    ],
                    "antonyms": [
                        "well",
                        "healthy"
                    ],
                    "common_phrases": [
                        "feel poorly",
                        "look poorly",
                        "very poorly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нездоровый, плохо себя чувствующий.",
                        "zh": "身体不健康；不舒服。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нездоровый",
                                "target_lang_sense_clarification": "болезненный вид"
                            },
                            {
                                "target_lang_word": "больной",
                                "target_lang_sense_clarification": "о состоянии здоровья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不舒服",
                                "target_lang_sense_clarification": "身体欠佳"
                            },
                            {
                                "target_lang_word": "生病",
                                "target_lang_sense_clarification": "患病状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}