                        ],
                        "examples": [
                            {
                                "example_id": "8962962f-5a17-4385-9ccc-b39373c50f2a",
                                "sense_id": "971efac5-28d5-326a-90de-cb81dcc8ef50",
                                "text": "Avec elle, j’ai un bon feeling."
                            }
                        ]
                    },
