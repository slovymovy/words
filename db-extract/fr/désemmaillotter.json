                ],
                "senses": [
                    {
                        "sense_id": "5e7266cd-67dc-35f5-8878-16131171bf66",
                        "entry_id": "1a4c2fe4-4056-3e9c-b4b6-8e2ed3117d85",
                        "glosses": [
                            "Défaire ce qui emmaillotait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597997eb-223d-43ef-9a88-6d616acc6c63",
                                "sense_id": "5e7266cd-67dc-35f5-8878-16131171bf66",
                                "text": "Et moi, avec des doigts tremblants, je désemmaillotte mon opéra de son enveloppe de papier gris, et je mets mon offrande aux genoux de Paul Emile, qui demeure majestueusement perché sur son cheval."
                            },
                            {
                                "example_id": "494bedca-0d40-4ce0-8d63-d064f3b26847",
                                "sense_id": "5e7266cd-67dc-35f5-8878-16131171bf66",
                                "text": "À la fin, Egmont se désemmaillotte de son manteau, et paraît dans un costume magnifique !"
                            },
                            {
                                "example_id": "1b62e6fd-daa3-40a4-96b4-28c46d57fd3a",
                                "sense_id": "5e7266cd-67dc-35f5-8878-16131171bf66",
                                "text": "Je ne pus m’empêcher de rire, et de conseiller au cousin de se désemmaillotter…"
                            }
                        ]
                    }
                ],
