                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyanide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f52d49-7a8c-3604-9b3c-742e61b64f14",
                                        "entry_id": "e8bab49b-9739-3c6b-9372-4051ae652bcd",
                                        "glosses": [
                                            "Any compound containing the -C≡N group or the CN⁻ anion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                        "entry_id": "e8bab49b-9739-3c6b-9372-4051ae652bcd",
                                        "glosses": [
                                            "Sodium or potassium cyanide, used in the extraction of gold and silver or as a poison."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98ed69d8-7b75-45fa-8c46-d5e3a267985f",
                                                "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                                "text": "The birdies all try an' hide / But they still go for peanuts / When coated with cyanide"
                                            },
                                            {
                                                "example_id": "2fc2a03d-2c13-4ed7-a46e-321d51a76c45",
                                                "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                                "text": "Two doctors and a metallurgist from Scotland patented a process for dissolving gold with cyanide in 1887 and patented the recovery of gold from solution using finely divided zinc (zinc precipitation) the following year. […]\nThe first commercial processing plant to use cyanide in the milling circuit was constructed at the Crown mine at Karangahake, New Zealand in 1889."
                                            },
                                            {
                                                "example_id": "2c7be23f-239f-418b-9d8e-023c9e1b7ffe",
                                                "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                                "text": "The vast majority of the victims, on Jones’s orders, had drunk a fruit punch mixture laced with cyanide, a deadly poison. Adults had fed the poisoned liquid to the children, including infants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf324231-9cf7-37ac-b165-4b9466f3359b",
                                        "entry_id": "e8bab49b-9739-3c6b-9372-4051ae652bcd",
                                        "glosses": [
                                            "Hydrogen cyanide, or cyanide gas, a poisonous gas."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cyanide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a81568d-ac89-3936-ac03-d4cf75dab446",
                                        "entry_id": "cd47d5fa-101e-3135-b1c6-dfeb9eda6f41",
                                        "glosses": [
                                            "To treat or poison with cyanide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "031d4085-6cb9-4053-8169-3cc1b5c28ab2",
                        "source_entry_id": "849c0b7d-eee5-3edf-b0ab-375bf17af22b",
