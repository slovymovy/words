                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7e0a288-a173-38fb-acc5-1109ae5b70fd",
                        "entry_id": "d473d032-f322-356f-8467-522bcbf3ae5c",
                        "glosses": [
                            "лютеранская церковь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd15612-5f2b-4430-88c4-c06e0389dd60",
                                "sense_id": "d7e0a288-a173-38fb-acc5-1109ae5b70fd",
                                "text": "Мать моя была лютеранка и, стало быть, степенью религиознее; она всякий месяц раз или два ездила в воскресенье в свою церковь, или, как Бакай упорно называл, «в свою кирху», и я от нечего делать ездил с ней."
                            },
                            {
                                "example_id": "22fcf579-c6e8-4b2f-bafc-03e69dd10f97",
                                "sense_id": "d7e0a288-a173-38fb-acc5-1109ae5b70fd",
                                "text": "Через двадцать пять минут самолёт коснулся колёсами серого бетона, сильно затормозил, как будто задирая хвост, и Варвара поняла, что прилетела в чужую страну, когда увидела крошечное чистенькое здание аэропорта, зелёные лужайки, шустрых автопогрузчиков, крест немецкой кирхи за редким леском и динамики сообщили, что за бортом плюс двенадцать градусов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60679e61-e448-443f-9623-e5bb1d417d8e",
                        "source_entry_id": "d473d032-f322-356f-8467-522bcbf3ae5c",
                        "source_sense_id": "d7e0a288-a173-38fb-acc5-1109ae5b70fd",
                        "target_lang_word": "church",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "church",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "A Christian house of worship; a building where Christian religious services take place."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc183001-b492-44c8-98e2-bc08b82b4e35",
                                                "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                                "text": "There is a lovely little church in the valley."
                                            },
                                            {
                                                "example_id": "8e208162-046a-4c3a-8c08-f16015c26661",
                                                "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                                "text": "This building used to be a church before being converted into a library."
                                            },
                                            {
                                                "example_id": "6b84b189-f963-44af-b83f-7f025b0dc639",
                                                "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                                "text": "He got the message and was in church the next Sunday. We need to stay in church with the fellowship of others in order to keep the fire of faith burning brightly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa60006-b024-3cc8-bd0a-6a0436ec28bb",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Christians collectively seen as a single spiritual community; Christianity; Christendom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5a015cd-6da8-42a5-9705-fe82aa27ee45",
                                                "sense_id": "2aa60006-b024-3cc8-bd0a-6a0436ec28bb",
                                                "text": "These worshippers make up the Church of Christ."
                                            },
                                            {
                                                "example_id": "e6fe302e-5bc6-4e96-89c0-dc52d1751c66",
                                                "sense_id": "2aa60006-b024-3cc8-bd0a-6a0436ec28bb",
                                                "text": "Be shepherds of the church of God, which he bought with his own blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "A local group of people who follow the same Christian religious beliefs, local or general."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaefaa53-f518-4786-a1bc-6e632ee0c88c",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "Many young people find their only role models of family life in church."
                                            },
                                            {
                                                "example_id": "fcb50f8d-8096-4cd2-8226-db8d5320f60b",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "He got the message and was in church the next Sunday. We need to stay in church with the fellowship of others in order to keep the fire of faith burning brightly."
                                            },
                                            {
                                                "example_id": "cd9012f8-d78e-4169-ba75-6b353d731b3c",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "As they actively get involved in ministry, lay ministry becomes vigorous, and new believers will settle in church with more ease."
                                            },
                                            {
                                                "example_id": "583fe1ca-11f2-46c2-87bd-b2523b71c59a",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "she had very many adults in church with whom she could talk about issues in life."
                                            },
                                            {
                                                "example_id": "93472766-82a0-4ecb-99a3-323c458b1825",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "Ruthie had left the church disappointed , reluctant to give up the idea that she was chosen by God to become a saint . But within a month she had sinned by lying , masturbating , and coveting Sarah 130 • Beu Marshall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d95c790-4d8a-3d90-94b6-34f16166afb7",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "A particular denomination of Christianity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe637ad-3614-4ae1-ae09-335e428cb775",
                                                "sense_id": "4d95c790-4d8a-3d90-94b6-34f16166afb7",
                                                "text": "The Church of England separated from the Roman Catholic Church in 1534."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Christian worship held at a church; service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fde0364-c092-483b-94e7-f7e773b93856",
                                                "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                                "text": "Pastors complained that they were not allowed enough authority in church, with women exercising too much informal control."
                                            },
                                            {
                                                "example_id": "0baed2ef-e15e-428b-87f6-185161ce47e9",
                                                "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                                "text": "Some people are always saying, \"Oh, you have too much church.\" You never get too much church. I go to church every day."
                                            },
                                            {
                                                "example_id": "19fbec8a-afb6-425a-9664-7aef58a7c816",
                                                "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                                "text": "the learned women will be qualified to lead in church with equal grace and equal insight and equal gifts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Organized religion in general or a specific religion considered as a political institution."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6eadce-8b74-4df4-b46d-1cb699835f56",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "Many constitutions enshrine the separation of church and state."
                                            },
                                            {
                                                "example_id": "e1b9dfc6-f64f-42b3-9f1d-c625576e2b80",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "But in Muslim countries, Church and State are one indissolubly, and until the very essence of Islam passes away, that unity cannot be relaxed. The law of the land, too, is, in theory, the law of the Church."
                                            },
                                            {
                                                "example_id": "e3949e8e-2c7e-48fc-b6d7-b37949b4f07e",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "Because the pan-Buddhist movement was heavily supported by the Japanese in Inner Mongolia, the Buddhist church, already under attack by Soviet-backed antireligion campaigns in Outer Mongolia, was further damaged […]"
                                            },
                                            {
                                                "example_id": "1e09368d-636f-4c41-b534-c589f3fc28d3",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "The secular absolutist model is based on a strict separation between church and state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0beaa49-0eb6-3e47-8308-71e35017de7d",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Any religious group or place of worship; a temple."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d372f8c-4e25-43a2-8d7f-08c9a815f4a5",
                                                "sense_id": "a0beaa49-0eb6-3e47-8308-71e35017de7d",
                                                "text": "She goes to a Wiccan church down the road."
                                            },
                                            {
                                                "example_id": "1d2f5e05-7fe7-42a7-bfbd-ea78a2474e77",
                                                "sense_id": "a0beaa49-0eb6-3e47-8308-71e35017de7d",
                                                "text": "Among these, the church must investigate fundemental questions, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6b09de-e2ad-3ade-8992-48682de2d48f",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Assembly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "church",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fed91632-a068-36c0-b985-cc59c1564563",
                                        "entry_id": "365610ba-d173-37eb-874d-23aaf68bebdd",
                                        "glosses": [
                                            "To conduct a religious service for (a woman after childbirth, or a newly married couple)."
                                        ],
                                        "tags": [
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c19761-7190-41c5-866b-2503d93d41f0",
                                                "sense_id": "fed91632-a068-36c0-b985-cc59c1564563",
                                                "text": "Thenne after this lady was delyuerd and chirched / there came a knyghte vnto her / his name was sire Bromel la pleche / the whiche was a grete lord and he hadde loued that lady longe / and he euermore desyred her to wedde her / and soo by no meane she coude putte hym of"
                                            },
                                            {
                                                "example_id": "e242b299-cb07-4df9-bda5-becabd1a5f51",
                                                "sense_id": "fed91632-a068-36c0-b985-cc59c1564563",
                                                "text": "Nor did it [the Church] accept that the woman should stay indoors until she had been churched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "721ae0c2-2efe-3550-9301-88969ac9e5b6",
                                        "entry_id": "365610ba-d173-37eb-874d-23aaf68bebdd",
                                        "glosses": [
                                            "To educate someone religiously, as in a church."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "church",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c841d7-3754-370f-8621-b28087a779c8",
                                        "entry_id": "5b1dee30-7d4f-3f14-b41e-46054a4eb606",
                                        "glosses": [
                                            "Used to express strong agreement."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ecbf68a-3bc8-4f35-a7ee-9f879e07191f",
                                                "sense_id": "b9c841d7-3754-370f-8621-b28087a779c8",
                                                "text": "– These burritos are the best! – Church!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bf8fef0-8d6d-4362-9d39-7cd9d21d76e4",
                        "source_entry_id": "d473d032-f322-356f-8467-522bcbf3ae5c",
                        "source_sense_id": "d7e0a288-a173-38fb-acc5-1109ae5b70fd",
                        "target_lang_word": "Kirche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8765c25-1831-31aa-9d70-c69f15dc6461",
                                        "entry_id": "c362165f-d745-3685-a749-c59976450606",
                                        "glosses": [
                                            "geweihter Versammlungsort einer christlichen Glaubensgemeinschaft, in dem unter anderem Gottesdienste abgehalten werden; Gebäude, das zum Abhalten christlicher Rituale vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664d8a98-6268-4188-82db-b2d62c3c3c9d",
                                                "sense_id": "b8765c25-1831-31aa-9d70-c69f15dc6461",
                                                "text": "Jeden Sonntag findet in der Kirche der Gottesdienst statt."
                                            },
                                            {
                                                "example_id": "60bb6f12-3520-4aa4-b522-669f9bf9f410",
                                                "sense_id": "b8765c25-1831-31aa-9d70-c69f15dc6461",
                                                "text": "„Die Kirchen fielen im Straßenbild Moskaus nicht besonders auf, aber ich kannte eine neben der Metrostation Sokol in der Nähe meiner Theaterschule.“"
                                            },
                                            {
                                                "example_id": "240efb03-1143-4c7f-8739-29f865f5d2cc",
                                                "sense_id": "b8765c25-1831-31aa-9d70-c69f15dc6461",
                                                "text": "„Papa und ich sind dann zu der kleinen Kirche in der Nähe gegangen, in der Mama und Papa früher oft gewesen sind.“"
                                            },
                                            {
                                                "example_id": "054bcde7-8035-4c60-9ac4-a3905763af0e",
                                                "sense_id": "b8765c25-1831-31aa-9d70-c69f15dc6461",
                                                "text": "„Die Kirche war voll.“"
                                            },
                                            {
                                                "example_id": "560c33e2-2868-44ba-9d43-431330e9434c",
                                                "sense_id": "b8765c25-1831-31aa-9d70-c69f15dc6461",
                                                "text": "„Die Kirche war kalt und leer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43d2c9d2-89ac-331e-b66a-df7ada1ebc22",
                                        "entry_id": "c362165f-d745-3685-a749-c59976450606",
                                        "glosses": [
                                            "christliche Glaubensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085e99a1-de3a-4517-b04b-d52c9b1ba681",
                                                "sense_id": "43d2c9d2-89ac-331e-b66a-df7ada1ebc22",
                                                "text": "Der Papst ist das Oberhaupt der katholischen Kirche. Die Kirche ist das Volk Gottes unterwegs."
                                            },
                                            {
                                                "example_id": "b1a1c0cb-681b-46f7-a0c2-12265b0e08ab",
                                                "sense_id": "43d2c9d2-89ac-331e-b66a-df7ada1ebc22",
                                                "text": "Die Kirche hat einen guten Magen, / hat ganze Länder aufgefressen, / und doch noch nie sich übergessen."
                                            },
                                            {
                                                "example_id": "a4519829-2c4b-4ac7-864d-1ffc4927d621",
                                                "sense_id": "43d2c9d2-89ac-331e-b66a-df7ada1ebc22",
                                                "text": "Ich wurde als Kind, ohne meine Zustimmung oder Befragung, getauft, und wurde somit gezwungen, in die Kirche zu gehen."
                                            },
                                            {
                                                "example_id": "09969572-81b5-40d9-bb74-b22f17e84919",
                                                "sense_id": "43d2c9d2-89ac-331e-b66a-df7ada1ebc22",
                                                "text": "„Da sie wie der Vater der Quäkersekte anhing, verwarf sie die Autorität der heiligen Texte ebenso wie die der papistischen Kirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "05fb9b51-f9a4-3e37-9196-115b87d371cf",
                                        "entry_id": "c362165f-d745-3685-a749-c59976450606",
                                        "glosses": [
                                            "Institution zur Organisation einer christlichen Glaubensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "196607be-4ebd-4d63-ac32-aff6be77d03e",
                                                "sense_id": "05fb9b51-f9a4-3e37-9196-115b87d371cf",
                                                "text": "»Fest soll mein Taufbund immer stehen, ich will die Kirche hören.« (Liedtext)"
                                            },
                                            {
                                                "example_id": "36e8355a-6a95-404f-aab9-1312b5e1f079",
                                                "sense_id": "05fb9b51-f9a4-3e37-9196-115b87d371cf",
                                                "text": "„Seine negative Einstellung zur Kirche betont Janosch mehrmals in seinen Romanen.“"
                                            },
                                            {
                                                "example_id": "b64d30fe-6da3-484d-834f-028fc0982c90",
                                                "sense_id": "05fb9b51-f9a4-3e37-9196-115b87d371cf",
                                                "text": "„An Schulen, in Büchereien, bei Demonstrationen reden Survivors wie Tony und Myra heute über das Leid, das der Staat Kanada und die Kirchen ihnen angetan haben mit ihrem kolonialen Rassismus.“"
                                            },
                                            {
                                                "example_id": "fd8abf80-0192-47c1-bc28-0f60298663da",
                                                "sense_id": "05fb9b51-f9a4-3e37-9196-115b87d371cf",
                                                "text": "„Heute haben die Kirchen dieses Landes keinen Saft mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a888c2d6-382b-3c1c-bc68-63491063951f",
                                        "entry_id": "c362165f-d745-3685-a749-c59976450606",
                                        "glosses": [
                                            "Zusammenkunft von Gläubigen, wobei nach einer Liturgie Gott zu Ehren gebetet und/oder gefeiert wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54977d71-c1f1-4e40-9460-41acd45c0b6c",
                                                "sense_id": "a888c2d6-382b-3c1c-bc68-63491063951f",
                                                "text": "Am Sonntag ist um 11 Uhr Kirche."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "977ce583-b691-3135-bc0c-118a232af2b1",
                                        "entry_id": "c362165f-d745-3685-a749-c59976450606",
                                        "glosses": [
                                            "ein Versammlungsort einer Glaubensgemeinschaft"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b6c832f-9ee3-4c28-b48a-c41d94162b72",
                                                "sense_id": "977ce583-b691-3135-bc0c-118a232af2b1",
                                                "text": "Neben den katholischen und reformierten Landeskirchen sind jedoch auch jüdische und islamische Kirchen im Kanton (Internetbeleg)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f0e83d0e-b5cd-3311-ba58-35f52c2dbb31",
                                        "entry_id": "c362165f-d745-3685-a749-c59976450606",
                                        "glosses": [
                                            "eine Glaubensgemeinschaft"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a44273e9-09af-4391-9fe1-9ccf35e77a2f",
                                                "sense_id": "f0e83d0e-b5cd-3311-ba58-35f52c2dbb31",
                                                "text": "Unsere Kirche glaubt an die Existenz mehrerer Götter."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
