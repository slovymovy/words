                            "target_lang_translations": {
                                "tr": "Fırtınada yürüdükten sonra <w>sırılsıklam oldular</w>.",
                                "ru": "После прогулки в шторм они <w>промокли</w> до нитки.",
                                "cs": "Po chůzi v bouři byli <w>promočení</w> na kost."
                            }
