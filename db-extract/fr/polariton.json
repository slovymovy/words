                        "entry_id": "1021623d-ffd2-3c03-b7b0-0671f786d586",
                        "glosses": [
                            "Quasi-particule issue du couplage fort entre une onde lumineuse et une onde de polarisation électrique."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "215f3c16-fa70-46d2-bf91-e24e302ae40d",
                                "sense_id": "130842f3-ff6c-3560-8435-8f0054599d1c",
                                "text": "Le polariton est une quasi-particule correspondant à l’hybridation d’un photon piégé dans une cavité et d’un exciton (une paire électron-trou dans un semi-conducteur)."
                            },
                            {
                                "example_id": "32424ee1-ce58-4f25-9492-ee75a6b31d83",
                                "sense_id": "130842f3-ff6c-3560-8435-8f0054599d1c",
                                "text": "Comment obtient-on des polaritons ? En superposant un piège à excitons à un piège à photons."
                            }
                        ]
                    }
                ],
