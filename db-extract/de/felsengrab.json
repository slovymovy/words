                        "examples": [
                            {
                                "example_id": "632ae8a1-b092-4206-9469-d5941edfc121",
                                "sense_id": "09a9c9df-26d3-3a5c-a7f7-77fe47b4ddc9",
                                "text": "„Ich weiß, dass ich nie das Licht sehen werde, bis auf das des Mondes über den Felsengräbern von Neb, und für mich gibt es auch kein Vergnügen, außer den unbeschreiblichen Festen der Nitokris unter der Großen Pyramide; doch in meiner neuen und wilden Freiheit ist mir die Bitterkeit meines Andersseins beinahe willkommen.“"
                            }
                        ],
