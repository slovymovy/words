                        "target_lang_word": "blunt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e94ccc-5c12-31f1-8083-01630b1df53a",
                                        "entry_id": "5a0b3e84-129b-3e59-8d5d-888aad3a7167",
                                        "glosses": [
                                            "Having a thick edge or point; not sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8915b637-a006-4f3e-b1ca-0e1215667ef6",
                                                "sense_id": "d8e94ccc-5c12-31f1-8083-01630b1df53a",
                                                "text": "The murderous knife was dull and blunt."
                                            },
                                            {
                                                "example_id": "ee29f4d6-dd41-465d-a47e-adfe7ddfcdb5",
                                                "sense_id": "d8e94ccc-5c12-31f1-8083-01630b1df53a",
                                                "text": "The dinghy was trailing astern at the end of its painter, and Merrion looked at it as he passed. He saw that it was a battered-looking affair of the prahm type, with a blunt snout, and like the parent ship, had recently been painted a vivid green."
                                            },
                                            {
                                                "example_id": "dfee0f3a-78c4-4964-8af8-68428a3b311e",
                                                "sense_id": "d8e94ccc-5c12-31f1-8083-01630b1df53a",
                                                "text": "The face which emerged was not reassuring. It was blunt and grey, the nose springing thick and flat from high on the frontal bone of the forehead, whilst his eyes were narrow slits of dark in a tight bandage of tissue. […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce5b22b1-485a-3fbc-b135-095d0655052b",
                                        "entry_id": "5a0b3e84-129b-3e59-8d5d-888aad3a7167",
                                        "glosses": [
                                            "Dull in understanding; slow of discernment; opposed to acute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae2b0072-6eff-4589-a95d-6a3266d4cb54",
                                                "sense_id": "ce5b22b1-485a-3fbc-b135-095d0655052b",
                                                "text": "His wits are not so blunt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9390cfc0-cd71-3d44-8078-a89ff2bdc476",
                                        "entry_id": "5a0b3e84-129b-3e59-8d5d-888aad3a7167",
                                        "glosses": [
                                            "Abrupt in address; plain; unceremonious; wanting in the forms of civility; rough in manners or speech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a8e9a10-c715-4b73-9a13-a95e96c9b16b",
                                                "sense_id": "9390cfc0-cd71-3d44-8078-a89ff2bdc476",
                                                "text": "I was taken aback by the blunt admission that he had never liked my company."
                                            },
                                            {
                                                "example_id": "e0e3e25c-ba6e-4701-b70e-a66a14ff8a3d",
                                                "sense_id": "9390cfc0-cd71-3d44-8078-a89ff2bdc476",
                                                "text": "a plain, blunt man"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc2820e6-ec66-36df-abae-574ef2e44dbe",
                                        "entry_id": "5a0b3e84-129b-3e59-8d5d-888aad3a7167",
                                        "glosses": [
                                            "Hard to impress or penetrate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5aea1f-6650-4ad0-b9e4-69e1e101f296",
                                                "sense_id": "cc2820e6-ec66-36df-abae-574ef2e44dbe",
                                                "text": "December 30, 1736, Alexander Pope, letter to Jonathan Swift\nI find my heart hardened and blunt to new impressions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "310a23a6-fdf6-3439-86b3-4dab2362624d",
                                        "entry_id": "5a0b3e84-129b-3e59-8d5d-888aad3a7167",
                                        "glosses": [
                                            "Slow or deficient in feeling: insensitive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
