                    {
                        "translation_id": "bebf6096-8aa3-4ead-bd52-fc228227c657",
                        "source_entry_id": "10406250-13ea-3bf0-bb52-ee0399163979",
                        "source_sense_id": "b00a720d-bd1b-35e6-81ae-7c5479457efd",
                        "source_sense_description": "an alcohol",
                        "target_lang_word": "ξυλιτόλη",
                        "target_lang_code": "el",
