                    },
                    {
                        "translation_id": "ae8635e0-02bb-4917-bb7a-a587594f2aee",
                        "source_entry_id": "a35422b0-c453-3936-bf93-b67f65ca5bb1",
                        "source_sense_description": "город в Азии, столица КНДР",
                        "target_lang_word": "Pyongyang",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyongyang",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c66dc3b9-e178-3d26-aa56-aea1a664059f",
                                        "entry_id": "cde2a158-e0a4-3555-942e-18b7507e9c4f",
                                        "glosses": [
                                            "Capitale de la Corée du Nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc35b60-4fc5-42e3-83f2-3cb7aa1b330e",
                                                "sense_id": "c66dc3b9-e178-3d26-aa56-aea1a664059f",
                                                "text": "La circulation en ville est d’une irréelle fluidité, Pyongyang est la cité du « comme si » et il y a quelque chose de profondément ludique à observer, aux carrefours de larges artères sans fin, des jeunes femmes policières, petites, très minces, presque diaphanes sous leur casquette d’officier soviétique, qui, avec des gestes saccadés d’automate d’horlogerie, pivotant sur un socle en forme de tambour placé à l’intersection exacte des branches du croisement, règlent un trafic exclusivement piétonnier."
                                            },
                                            {
                                                "example_id": "29939c1c-effe-4735-84b3-d96643ab47ee",
                                                "sense_id": "c66dc3b9-e178-3d26-aa56-aea1a664059f",
                                                "text": "Le Pyolmuri est un restaurant-café de style européen, qui a ouvert ses portes dans le centre de Pyongyang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4cbf409-8b11-3264-9042-64106ca6d199",
                                        "entry_id": "cde2a158-e0a4-3555-942e-18b7507e9c4f",
                                        "glosses": [
                                            "Gouvernement de Corée du Nord."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1132ab6a-6b1e-4df6-8c30-0d1a4a0fc457",
                                                "sense_id": "e4cbf409-8b11-3264-9042-64106ca6d199",
                                                "text": "Pyongyang a pris cette décision après avoir annoncé qu’il quittait les négociations à six sur le démantèlement de son programme nucléaire."
                                            },
                                            {
                                                "example_id": "c0dc6b54-ac2a-434f-8457-b966e7ca1aa5",
                                                "sense_id": "e4cbf409-8b11-3264-9042-64106ca6d199",
                                                "text": "En effet, l’autre possibilité serait que Pyongyang vende sa technologie nucléaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
