                                    {
                                        "sense_id": "d6996e7c-54b6-3248-b5fe-2448b0a08c38",
                                        "entry_id": "22afa021-e666-351b-8b41-79bba5a507a0",
                                        "glosses": [
                                            "unverändert bei Vertauschen der Operanden"
