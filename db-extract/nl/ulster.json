                        "cross_references": [
                            {
                                "target_word": "ulster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7dec25-dde8-3944-8d04-909c37404477",
                                        "entry_id": "9e00037f-03d4-3fc7-8ad0-7a79cf7793ac",
                                        "glosses": [
                                            "A long, loose overcoat made of wool or other rough material, often called a greatcoat, which sometimes features an attached shoulder cape covering the back and sleeves, and which can sometimes be buttoned in front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aebb704-1d4d-4bbe-bf24-bd246bd0bee9",
                                                "sense_id": "5f7dec25-dde8-3944-8d04-909c37404477",
                                                "text": "“That's queer,” said the Tertium Quid. “Where's my ulster?” “What's queer?” said the Man's Wife. “I have got a chill down my back — just as if a goose had walked over my grave.”"
                                            },
                                            {
                                                "example_id": "431a33e3-19d0-4322-adc7-63d7357804a1",
                                                "sense_id": "5f7dec25-dde8-3944-8d04-909c37404477",
                                                "text": "I hardened my heart and took the smoke-rocket from under my ulster."
                                            },
                                            {
                                                "example_id": "de4ca47f-405d-4232-b6b9-d02691f2a43f",
                                                "sense_id": "5f7dec25-dde8-3944-8d04-909c37404477",
                                                "text": "“Do I fidget you ?” he asked apologetically, whilst his long bony fingers buried themselves, string, knots, and all, into the capacious pockets of his magnificent tweed ulster."
                                            },
                                            {
                                                "example_id": "cfd1024c-30ea-4f38-af1e-d56e6fca7d3d",
                                                "sense_id": "5f7dec25-dde8-3944-8d04-909c37404477",
                                                "text": "Off slipped a sodden ulster. He hung it up angrily upon a peg …"
                                            },
                                            {
                                                "example_id": "76557fb8-c530-43c5-904b-a0eaaf1da170",
                                                "sense_id": "5f7dec25-dde8-3944-8d04-909c37404477",
                                                "text": "“By Jove! I’ve left my ulster in the waiting-room,” and hastened off to fetch it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
