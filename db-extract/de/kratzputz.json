                "senses": [
                    {
                        "sense_id": "38895304-cbee-322c-ae93-8ae6c958e11c",
                        "entry_id": "00125324-4844-361a-9d24-93aeccfb0084",
                        "glosses": [
                            "äußerer Belag (Putz) auf Wänden oder Decken, bei dem die Oberfläche durch Abrieb/Kratzen rau gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b346036d-7cf6-4bf8-8a46-45ea85fb0a9f",
                                "sense_id": "38895304-cbee-322c-ae93-8ae6c958e11c",
                                "text": "„Allerdings haben wir Anfang 1980 in Dresden noch Gebäude mit Kratzputz hergestellt, Spritzbewurf, Unterputz und Oberputz.“"
                            },
                            {
                                "example_id": "ac5bc2e8-706e-4da2-a375-88d05996e3e9",
                                "sense_id": "38895304-cbee-322c-ae93-8ae6c958e11c",
                                "text": "„Dafür entstanden an anderer Stelle neue Häuser, die mit Kratzputz der jüngeren Generation verziert, das Dorfbild schmücken.“"
                            },
                            {
                                "example_id": "545dcbd6-959b-46ce-89d2-52ec95ee759d",
                                "sense_id": "38895304-cbee-322c-ae93-8ae6c958e11c",
                                "text": "„Kratzputz wird durch Kratzen mit einem Nagelbrett, einem Sägeblatt oder einer Ziehklinge hergestellt.“"
                            },
                            {
                                "example_id": "69ed3c38-327c-4b1f-b395-1a1574984471",
                                "sense_id": "38895304-cbee-322c-ae93-8ae6c958e11c",
                                "text": "„In dieser Zeit bekam das Gebäude ein neues Dach aus Betonziegeln und den graubraunen Kratzputz, der an vielen DDR-Bauten heute noch zu sehen ist.“"
                            },
                            {
                                "example_id": "45aa2a04-3489-441c-bb68-f189ba00b3fa",
                                "sense_id": "38895304-cbee-322c-ae93-8ae6c958e11c",
                                "text": "„Im Außenbereich sorgt dieser in Kombination mit Kratzputz für eine lebendige Fassadengestaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
