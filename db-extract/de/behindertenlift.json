                ],
                "senses": [
                    {
                        "sense_id": "db5b1bc4-f7ff-390b-b4e2-8c20cff0f892",
                        "entry_id": "f510bec8-13cb-3531-8a45-93449812977e",
                        "glosses": [
                            "in oder an einem Gebäude befindliche mechanische Vorrichtung, mit der gehbehinderte Personen (gegebenenfalls auch zusammen mit einer Gehhilfe oder einem Rollstuhl) hinaufbefördert- beziehungsweise hinabbefördert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f832598-6897-42c4-923b-7414dc17ccbb",
                                "sense_id": "db5b1bc4-f7ff-390b-b4e2-8c20cff0f892",
                                "text": "„Selbstverständlich ist jeder Behindertenlift darüber hinaus TÜV-geprüft und durch seine leichte Bedienbarkeit ein verlässlicher Begleiter in Ihrem Alltag, der schnell und unkompliziert – auch nachträglich – in Ihrem Zuhause montiert werden kann.“"
                            },
                            {
                                "example_id": "e97fc909-f819-4ed8-b899-a3782e427759",
                                "sense_id": "db5b1bc4-f7ff-390b-b4e2-8c20cff0f892",
                                "text": "„Die Konstruktion eines Behindertenlifts ist im Grunde so ausgerichtet, dass die zu befördernde gehbehinderte Person, sich auf einem Sitz platziert, welcher auf einer oder zwei Schienen gelagert ist.“"
                            },
                            {
                                "example_id": "4dda5e9f-7586-4e59-acb2-854faf8b373a",
                                "sense_id": "db5b1bc4-f7ff-390b-b4e2-8c20cff0f892",
                                "text": "„Wird ein solcher Behindertenlift im Innenraum genutzt, so erfolgt die Steuerung mittels einer Fernbedienung oder eines Funksensors.“"
                            },
                            {
                                "example_id": "4f8450ab-b006-49f0-9025-6e70490a9d00",
                                "sense_id": "db5b1bc4-f7ff-390b-b4e2-8c20cff0f892",
                                "text": "„Der Warenlift wurde auch als Personenlift nutzbar gemacht, und zudem konnte ein Behindertenlift im Parterre des Museums eingebaut werden, sodass das ganze Museum mit Ausnahme der Afrika-Ausstellung, rollstuhlgängig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
