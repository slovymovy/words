        "fr-extract.jsonl": [
            {
                "entry_id": "ccadc2f4-fdc9-39a4-8f75-7f2e773befe9",
                "word": "pétulance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "692e1529-70c0-46bd-bd1a-0ee1b788774c",
                        "entry_id": "ccadc2f4-fdc9-39a4-8f75-7f2e773befe9",
                        "tags": [
                            "plural"
                        ],
                        "form": "pétulances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                        "entry_id": "ccadc2f4-fdc9-39a4-8f75-7f2e773befe9",
                        "glosses": [
                            "Caractère de ce qui est vif, voire brusque, sans retenue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dbd7fc9-428a-432a-8af6-182cf3102d00",
                                "sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                                "text": "Parler avec pétulance."
                            },
                            {
                                "example_id": "e1b0f12b-294e-49ea-8d03-328cb44615cc",
                                "sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                                "text": "La pétulance de ses mouvements, de son caractère."
                            },
                            {
                                "example_id": "47fbe7cd-cd76-42f9-9af3-f514aae13322",
                                "sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                                "text": "La brebis est absolument sans ressource et sans défense ; le bélier n'a que de faibles armes, son courage n'est qu'une pétulance inutile pour lui-même, incommode pour les autres, et qu'on détruit par la castration."
                            },
                            {
                                "example_id": "9274716f-defa-4a37-966e-6817af42ece0",
                                "sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                                "text": "Sœur Désirée-des-Anges la suivait des yeux en faisant une petite grimace du coin de la bouche.\nElle n’avait plus sa pétulance de jeune novice, mais elle restait enjouée et moqueuse."
                            },
                            {
                                "example_id": "d013e2d4-d47e-4f26-a079-ec9ef56102c2",
                                "sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                                "text": "Dans ma pétulance, Louise trouvait la justification de ses bouderies ; Anne-Marie celle de son humilité."
                            },
                            {
                                "example_id": "d97a514a-c5e2-49ee-9dac-b5c783bacb63",
                                "sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                                "text": "La résurrection des corps, c’est peut-être d’abord ceci : le passage surprise, par une sorte d’effet tunnel, de la grande fatigue à une certaine pétulance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1daac52d-8a3c-4bcc-b917-224082788953",
                        "source_entry_id": "ccadc2f4-fdc9-39a4-8f75-7f2e773befe9",
                        "source_sense_id": "234527de-c0fa-3fcc-88e8-1e998be7281f",
                        "target_lang_word": "petulance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petulance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a51e95ff-6942-38ea-8925-24cf125ad491",
                                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                                        "glosses": [
                                            "Rudeness, insolence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d22997c9-8039-4e84-9023-36fa4112f111",
                                                "sense_id": "a51e95ff-6942-38ea-8925-24cf125ad491",
                                                "text": "[W]ise men knew, that that, which looked like pride in some, and like petulance in others, would, by experience in affairs, and conversation amongst men, both of which most of them wanted, be in time wrought off […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf07f82-4a5d-399e-9988-37834b2acfd5",
                                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                                        "glosses": [
                                            "An insolent remark or act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b156f3-6fd8-4b89-a495-6b307f34f235",
                                                "sense_id": "bcf07f82-4a5d-399e-9988-37834b2acfd5",
                                                "text": "I believe I was guilty of a petulance, which nothing but my uneasy situation can excuse; if that can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df425096-93ee-332e-9c5c-21146bef2633",
                                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                                        "glosses": [
                                            "Childish impatience or sulkiness; testiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ed5670-0531-4248-b4c1-1c27de6c4f31",
                                                "sense_id": "df425096-93ee-332e-9c5c-21146bef2633",
                                                "text": "She […] had shown herself angry and sore, and was now ashamed of her own petulance, and yet unable to discontinue it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
