                        "target_lang_word": "vorbereiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorbereiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4582f8da-cca2-35a6-93ae-9e487872c514",
                                        "entry_id": "9bb3ebc8-0673-3f1c-a1fa-eb744e6f67fb",
                                        "glosses": [
                                            "etwas, jemanden oder sich selbst einer Voraussicht oder Zukunftserwartung anpassen; so ändern, dass es sich bei den erwarteten Ereignissen positiv auswirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16343ef9-2449-4507-a97c-e8bbad4291b9",
                                                "sense_id": "4582f8da-cca2-35a6-93ae-9e487872c514",
                                                "text": "Ich muss mich noch auf die morgige Prüfung vorbereiten."
                                            },
                                            {
                                                "example_id": "e09c0a4b-e5c9-4b67-a23e-43abae6c68a3",
                                                "sense_id": "4582f8da-cca2-35a6-93ae-9e487872c514",
                                                "text": "Wir haben das Haus auf den kommenden Sturm bereits vorbereitet."
                                            },
                                            {
                                                "example_id": "a9abcefb-07cb-4072-a79f-74250eeb28e4",
                                                "sense_id": "4582f8da-cca2-35a6-93ae-9e487872c514",
                                                "text": "„Das Team bereitet derzeit eine Veröffentlichung in einem Fachmagazin vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66b4d9cf-127e-4a96-a71a-b33c722eaee4",
                        "source_entry_id": "056c673c-634e-31a7-99ea-7d823e349a14",
                        "target_lang_word": "préparer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préparer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                                        "entry_id": "ac9fba6d-8707-396a-bf92-112ef4389327",
                                        "glosses": [
                                            "Apprêter, disposer mettre une chose dans l’état convenable à l’usage auquel on la destine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0c060c9-2db5-444f-af7b-d975c5e07a5b",
                                                "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                                                "text": "Le camphre est une sorte d’acétone dérivée d’un alcool, le bornéol. On le prépare en distillant avec de l’eau le bois du camphrier (Laurus camphora)."
                                            },
                                            {
                                                "example_id": "601ace07-f567-48e0-9ad9-dd926f9d2fee",
                                                "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                                                "text": "Les enfants s’amuseront énormément à préparer les recettes présentées dans \" Les petits cuisiniers \", et ils se feront un plaisir de déguster leur chef-d’œuvre."
                                            },
                                            {
                                                "example_id": "ab6ca8c5-c48d-4331-a803-fd72eafce2fe",
                                                "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                                                "text": "Que vais-je dire au barman Mohamed qui lui préparait si bien son whisky-soda […]"
                                            },
                                            {
                                                "example_id": "5ba037cd-0c3d-4aeb-92a6-98933ad6ff40",
                                                "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                                                "text": "Je préparais les plats préférés de ma petite-fille et surtout l’indéclassable gâteau au chocolat, je mettais des violettes sur la table, j'allumais une chandelle puis je m'assoyais devant la fenêtre."
                                            },
                                            {
                                                "example_id": "b4ef00bc-3cf2-48ed-95a8-8efe25b0b4db",
                                                "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                                                "text": "Si vous préparez la crème anglaise la veille, elle n’en sera que plus parfumée et plus savoureuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb3fb3a-4c36-390f-b983-46f38dfe2530",
                                        "entry_id": "ac9fba6d-8707-396a-bf92-112ef4389327",
                                        "glosses": [
                                            "Soumettre un malade à un certain régime en vue d’une opération chirurgicale ou d’un traitement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                        "entry_id": "ac9fba6d-8707-396a-bf92-112ef4389327",
                                        "glosses": [
                                            "Installer, mettre en place, les causes qui produiront des effets ultérieurs."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d98a070-af1c-4dca-9957-5c9f24d5f336",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "Les causes secrètes qui ont préparé ces événements."
                                            },
                                            {
                                                "example_id": "6027466c-58a2-496d-bcb6-a5d35a0aac2c",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "Cela nous prépare de grands malheurs, de grands chagrins, de grands regrets."
                                            },
                                            {
                                                "example_id": "aedf4f04-0f6c-4a73-8efe-6e2a7c8fe68c",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "Préparer le bonheur des générations futures."
                                            },
                                            {
                                                "example_id": "5fde8507-68e6-4113-a53c-37f09f92d4d4",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "Préparer, se préparer des excuses, des moyens de défense."
                                            },
                                            {
                                                "example_id": "69fbc76c-fb42-4a4c-97b5-c19825b72774",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "On lui avait préparé une grande surprise."
                                            },
                                            {
                                                "example_id": "4e5de8bb-71cd-4616-a747-e1e20b79c6ea",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "Les ennemis avaient préparé une grande résistance."
                                            },
                                            {
                                                "example_id": "1bf80773-d040-4293-a9ea-cf5e99069273",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "Une révolution se préparait alors dans le pays."
                                            },
                                            {
                                                "example_id": "32e9276c-42aa-488c-bb23-fcd4e34be01e",
                                                "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                                                "text": "Voilà un orage qui se prépare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d14edd1-4fcb-3e86-8b3b-3a7df9c0e64f",
                                        "entry_id": "ac9fba6d-8707-396a-bf92-112ef4389327",
                                        "glosses": [
                                            "Méditer, disposer dans sa mémoire après réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c1108e-21a3-4b45-9482-568ac3a07370",
                                                "sense_id": "9d14edd1-4fcb-3e86-8b3b-3a7df9c0e64f",
                                                "text": "Préparer un discours. Préparer un mauvais coup."
                                            },
                                            {
                                                "example_id": "85f1071e-3348-4799-85a2-0af19797ff02",
                                                "sense_id": "9d14edd1-4fcb-3e86-8b3b-3a7df9c0e64f",
                                                "text": "Être préparé sur un sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a4cc897-dca8-37cc-a796-4faeec5a333d",
                                        "entry_id": "ac9fba6d-8707-396a-bf92-112ef4389327",
                                        "glosses": [
                                            "Faire précéder une chose de quelques précautions pour en assurer l’effet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319dbffa-4106-4033-b061-d832eff154e9",
                                                "sense_id": "8a4cc897-dca8-37cc-a796-4faeec5a333d",
                                                "text": "Quand on hasarde certaines propositions hardies, il faut les préparer."
                                            },
                                            {
                                                "example_id": "0f71f602-7d79-45c8-99ad-53e8f4c8c3df",
                                                "sense_id": "8a4cc897-dca8-37cc-a796-4faeec5a333d",
                                                "text": "Il faut préparer ce coup de théâtre."
                                            },
                                            {
                                                "example_id": "f8684496-5d33-4de9-a5e8-439ebdbf5225",
                                                "sense_id": "8a4cc897-dca8-37cc-a796-4faeec5a333d",
                                                "text": "Ce musicien prépare avec soin ses dissonances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c13a4ff4-0d52-30ea-b449-60a27537aa10",
                                        "entry_id": "ac9fba6d-8707-396a-bf92-112ef4389327",
                                        "glosses": [
                                            "Mettre dans une disposition propre à atteindre un but qu’on se propose, en parlant de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f18441ef-af26-4e0a-8cc9-15aa45d7e7f4",
                                                "sense_id": "c13a4ff4-0d52-30ea-b449-60a27537aa10",
                                                "text": "Louis Pasteur ne devait pas partir seul. Son plus cher camarade d'enfance, Jules Vercel, allait aussi à Paris pour préparer paisiblement son baccalauréat."
                                            },
                                            {
                                                "example_id": "bdd293eb-4a4e-4f49-bcbf-4d42db9097a0",
                                                "sense_id": "c13a4ff4-0d52-30ea-b449-60a27537aa10",
                                                "text": "Il avait préparé les esprits aux réformes qu’il projetait."
                                            },
                                            {
                                                "example_id": "e6de8171-2adf-4859-9f11-480c214d3546",
                                                "sense_id": "c13a4ff4-0d52-30ea-b449-60a27537aa10",
                                                "text": "Se préparer pour quelque chose, à quelque chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d5eb45-c9c0-381c-b9fa-78426d9330f3",
                                        "entry_id": "ac9fba6d-8707-396a-bf92-112ef4389327",
                                        "glosses": [
                                            "Parler à quelqu’un avec ménagement pour le disposer à apprendre une nouvelle pénible."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
