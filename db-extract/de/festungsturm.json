                "senses": [
                    {
                        "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                        "entry_id": "5b00be9a-5fd3-3c23-a699-0d57119da92b",
                        "glosses": [
                            "Gebäude des Mittelalters zur Verteidigung gegen Angreifer; oft in eine Stadtmauer integriert; meist mit einem hoch gelegenen Eingang, der nur über eine entfernbare Treppe oder Leiter zu erreichen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08151009-e9dd-4e7e-a115-cfe977c2dc7f",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Stadtmauer von Rom:] „Vielfach wurden die Tore zu wahren Festungstürmen ausgebaut.“"
                            },
                            {
                                "example_id": "62cfae7e-de14-4e46-8211-902288e4f255",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Cáceres/Spanien:] „Die dicken Stadtmauern mit den mächtigen Festungstürmen stammen noch von den arabischen Besetzern aus dem zwölften Jahrhundert.“"
                            },
                            {
                                "example_id": "046fb04b-8ef6-4b4a-91e5-de543bb3426d",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Ritterburg in Vêves-Celles/Belgien:] „Im Mittelalter auf steilem Felsen errichtet, galt die Festung lange als unbezwingbar. Einige Mauern wie der dicke Festungsturm stammen bereits aus dem zwölften Jahrhundert.“"
                            },
                            {
                                "example_id": "f5d206ad-e9bb-442f-a183-416481570559",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Fuerteventura:] Während des 17. und 18. Jahrhunderts kam es immer wieder zu Überfällen von Freibeutern. Daher wurden zum Schutz der Insel 1740 die beiden Festungstürme von El Cotillo und Caleta de Fuste errichtet."
                            },
                            {
                                "example_id": "34a731b2-a026-4c61-9e16-69061bba1601",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Île Saint-Honorat:] „Besonders bedrohlich waren in der Folgezeit die Beutezüge der Sarazenen oder von Piraten. Um sich davor zu schützen, errichteten die Mönche 1073 einen Festungsturm, in dem alle Einrichtungen eines Klosters wie Kapelle, doppelstöckiger Kreuzgang, Schlafräume oder Vorratskeller untergebracht waren.“"
                            },
                            {
                                "example_id": "5209a5fb-5922-4b99-872d-5c03eaf6ea14",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "„Eine 61-stufige Wendeltreppe führt auf die Turmspitze aus Stahl auf dem historischen Festungsturm.“"
                            },
                            {
                                "example_id": "e45216d1-b9ef-4574-89ee-08ea3d21e316",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "„Die historischen Stadtmauern wurden im 13. und 16. Jahrhundert erbaut, ihr Festungsturm Bokra ist zu einem weltbekannten Symbol für Dubrovnik geworden.“"
                            },
                            {
                                "example_id": "74269f67-d8e8-4209-92cf-5a56ad4549b9",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Nîmes:] „Von den einst mehr als 20 Festungstürmen ist heute nur noch der Turm Magne erhalten.“"
                            },
                            {
                                "example_id": "5406391f-a57e-4912-8518-bdcbc483cd5a",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Vatikanbank:] „Geheimnisvoll wirkt schon der Sitz dieses Geldinstitutes in einem mittelalterlichen Festungsturm des Vatikan-Staats.“"
                            },
                            {
                                "example_id": "bd593554-4334-420f-ac02-150fde22c0ee",
                                "sense_id": "f2d1d001-6097-3545-a25c-60516d13bbfb",
                                "text": "[Festung von Carcassonne:] „So ließ sich Walt Disney von den Festungstürmen für seine Zeichentrickfilme Schneewittchen und Dornröschen inspirieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
