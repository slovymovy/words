                    {
                        "translation_id": "f8c98ce1-ac1a-458c-8584-93d0efa7e6d8",
                        "source_entry_id": "55ff720c-318d-37b8-9c49-e702dbcda64b",
                        "source_sense_id": "6737bcc4-f4f0-3d7e-8264-f25fa7df591e",
                        "target_lang_word": "rub out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rub out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88a87930-37b9-3919-8f72-0c49ffb2f3e3",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "To delete or erase or remove (something) by rubbing, especially with a rubber (eraser)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41250726-1fe2-4e28-91bb-8327a2f39359",
                                                "sense_id": "88a87930-37b9-3919-8f72-0c49ffb2f3e3",
                                                "text": "The teacher wanted to rub out the chalk marks on the blackboard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88ad7754-bd84-3ff7-bf6a-6695de552e20",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "To get by; to live."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7c7a19-a1a5-48d2-bbaf-0741145cd831",
                                                "sense_id": "88ad7754-bd84-3ff7-bf6a-6695de552e20",
                                                "text": "The first will understand but little of them, the latter over much; they might perhaps live and rub out in the middle region."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed170306-7253-34f6-a0d5-cf352c51ed2d",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "To kill, especially to murder."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495e9ee8-525f-493a-bc41-f0b6a802c5c1",
                                                "sense_id": "ed170306-7253-34f6-a0d5-cf352c51ed2d",
                                                "text": "It was just a week to the day since Mr. Martin had decided to rub out Mrs. Ulgine Barrows."
                                            },
                                            {
                                                "example_id": "bb7e5d32-7bac-44f9-bb37-35dfa8b89a0a",
                                                "sense_id": "ed170306-7253-34f6-a0d5-cf352c51ed2d",
                                                "text": "'Mr Grimaldi,' fills in Smoke, 'what I believe Fay has too much tact to spit out and say is this: the Rey woman might be imagining we rubbed out Dr Sixsmith.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd51512-f6a5-38de-837c-b22ac890b8d4",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see rub, out."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
