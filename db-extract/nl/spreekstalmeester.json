                            {
                                "example_id": "a5da3d21-691e-4fc3-b151-944e47581a35",
                                "sense_id": "0e99c363-15d7-371f-a26a-2647c7e1554b",
                                "text": "De spreekstalmeester kondigde de verschillende acts aan tijdens de circusvoorstelling.",
                                "translation": "The ringmaster introduced the various acts during the circus performance.",
                                "english": "The ringmaster introduced the various acts during the circus performance."
                            },
                            {
                                "example_id": "fed93187-3fca-4b18-aa66-c5a0af6db397",
                                "sense_id": "0e99c363-15d7-371f-a26a-2647c7e1554b",
                                "text": "De rol van de spreekstalmeester is om het publiek te vermaken en de verschillende nummers aan elkaar te praten.",
                                "translation": "The role of the ringmaster is to entertain the audience and link the various acts together with his announcements.",
                                "english": "The role of the ringmaster is to entertain the audience and link the various acts together with his announcements."
                            },
                            {
                                "example_id": "f025ce3b-a4f7-43df-b8de-24cb482f9bb9",
                                "sense_id": "0e99c363-15d7-371f-a26a-2647c7e1554b",
                                "text": "De enthousiaste stem van de spreekstalmeester vulde de circustent terwijl hij de artiesten aankondigde.",
                                "translation": "The enthusiastic voice of the ringmaster filled the circus tent as he introduced the performers.",
                                "english": "The enthusiastic voice of the ringmaster filled the circus tent as he introduced the performers."
                            },
                            {
                                "example_id": "47d5154d-8c7b-428f-b871-a6771c20010e",
                                "sense_id": "0e99c363-15d7-371f-a26a-2647c7e1554b",
                                "text": "Tijdens de circusvoorstelling was de spreekstalmeester de centrale figuur die de show aan elkaar praatte.",
                                "translation": "During the circus performance, the ringmaster was the central figure who connected the show together with his announcements.",
                                "english": "During the circus performance, the ringmaster was the central figure who connected the show together with his announcements."
                            },
                            {
                                "example_id": "b7def019-ad19-473e-b1e0-52428bda8ee4",
                                "sense_id": "0e99c363-15d7-371f-a26a-2647c7e1554b",
                                "text": "De spreekstalmeester verwelkomde het publiek en zorgde voor een vrolijke en levendige sfeer in het circus.",
                                "translation": "The ringmaster welcomed the audience and created a cheerful and lively atmosphere in the circus.",
                                "english": "The ringmaster welcomed the audience and created a cheerful and lively atmosphere in the circus."
                            }
                        ]
