{
    "word_family": [
        "wryly",
        "wryness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d15d8002-dc84-3451-b2b2-075e5e74b8d8",
                    "sense_definition": "Dryly humorous or sardonic, often involving a sense of irony.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "humor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>wry</w> smile when she realized she had locked her keys inside the car.",
                            "target_lang_translations": {
                                "pl": "Posłała <w>cierpki</w> uśmiech, gdy zdała sobie sprawę, że zatrzasnęła kluczyki w samochodzie."
                            }
                        },
                        {
                            "text": "The comedian made a <w>wry</w> comment about the absurdity of modern office life.",
                            "target_lang_translations": {
                                "pl": "Komik rzucił <w>ironiczną</w> uwagę na temat absurdów współczesnego życia biurowego."
                            }
                        }
                    ],
                    "synonyms": [
                        "sardonic",
                        "ironic",
                        "dry"
                    ],
                    "common_phrases": [
                        "wry smile",
                        "wry humor",
                        "wry comment"
                    ],
                    "target_lang_definitions": {
                        "pl": "Suchy, ironiczny lub sarkastyczny humor, często wyrażający dystans do sytuacji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ironiczny",
                                "target_lang_sense_clarification": "odnoszący się do sarkastycznego lub zdystansowanego humoru"
                            },
                            {
                                "target_lang_word": "sarkastyczny",
                                "target_lang_sense_clarification": "wyrażający drwinę lub gorzki humor"
                            },
                            {
                                "target_lang_word": "cierpki",
                                "target_lang_sense_clarification": "o uśmiechu lub uwadze wyrażającej rezygnację lub ironię"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d20bb963-b993-3d51-844e-a7c179c23e3d",
                    "sense_definition": "Contorted or twisted, especially referring to a facial expression.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled a <w>wry</w> face after tasting the extremely bitter medicine.",
                            "target_lang_translations": {
                                "pl": "Po spróbowaniu wyjątkowo gorzkiego lekarstwa zrobił <w>skrzywioną</w> minę."
                            }
                        },
                        {
                            "text": "The athlete suffered a <w>wry</w> neck after sleeping in an awkward position.",
                            "target_lang_translations": {
                                "pl": "Sportowiec nabawił się <w>skrzywienia</w> szyi po spaniu w niewygodnej pozycji."
                            }
                        }
                    ],
                    "synonyms": [
                        "twisted",
                        "contorted"
                    ],
                    "common_phrases": [
                        "wry face",
                        "wry neck"
                    ],
                    "target_lang_definitions": {
                        "pl": "Skrzywiony lub wykrzywiony, zwłaszcza w odniesieniu do wyrazu twarzy lub części ciała."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skrzywiony",
                                "target_lang_sense_clarification": "o wyrazie twarzy lub części ciała"
                            },
                            {
                                "target_lang_word": "wykrzywiony",
                                "target_lang_sense_clarification": "o nienaturalnym wygięciu ciała lub twarzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da57609a-810e-3b1e-8d85-fa13b3e5934c",
                    "sense_definition": "Bent, crooked, or deviating from a straight line.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old tree had a <w>wry</w> trunk that leaned heavily toward the river.",
                            "target_lang_translations": {
                                "pl": "Stare drzewo miało <w>krzywy</w> pień, który mocno pochylał się w stronę rzeki."
                            }
                        },
                        {
                            "text": "She noticed a <w>wry</w> crack running along the side of the ancient stone wall.",
                            "target_lang_translations": {
                                "pl": "Zauważyła <w>krzywą</w> szczelinę biegnącą wzdłuż boku starożytnego kamiennego muru."
                            }
                        }
                    ],
                    "synonyms": [
                        "crooked",
                        "bent"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wygięty, krzywy lub odbiegający od linii prostej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "krzywy",
                                "target_lang_sense_clarification": "niebędący w linii prostej"
                            },
                            {
                                "target_lang_word": "wygięty",
                                "target_lang_sense_clarification": "posiadający nienaturalne zakrzywienie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6082ea33-74be-3b56-8c1e-811f19d8dbb6",
                    "sense_definition": "To twist or contort the body or face.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pain caused him to <w>wry</w> his features in agony.",
                            "target_lang_translations": {
                                "pl": "Ból sprawił, że <w>wykrzywił</w> twarz w męczarniach."
                            }
                        },
                        {
                            "text": "She tried to <w>wry</w> her body into a more comfortable position on the narrow bench.",
                            "target_lang_translations": {
                                "pl": "Próbowała <w>wygiąć</w> ciało w wygodniejszą pozycję na wąskiej ławce."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "contort"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykrzywiać lub wyginać ciało lub twarz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wykrzywiać",
                                "target_lang_sense_clarification": "o twarzy lub ciele pod wpływem bólu lub wysiłku"
                            },
                            {
                                "target_lang_word": "wyginać",
                                "target_lang_sense_clarification": "o ciele przybierającym nienaturalną pozycję"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}