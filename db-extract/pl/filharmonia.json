                                "target_senses": [
                                    {
                                        "sense_id": "3d14b86f-68f3-3f9d-baf4-f610e3a18a89",
                                        "entry_id": "6366a86b-bfee-3198-a88a-d5974c4cb8f6",
                                        "glosses": [
                                            "Name mehrerer Orchester und Konzertgesellschaften"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14e21cb0-9969-475f-87ad-0f9e2a041f9e",
                                                "sense_id": "3d14b86f-68f3-3f9d-baf4-f610e3a18a89",
                                                "text": "Die Dresdener Philharmonie gibt heute ein Konzert im Kulturpalast."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c8f49c6-50af-3289-88a6-e6e4ee3eb790",
                                        "entry_id": "6366a86b-bfee-3198-a88a-d5974c4cb8f6",
                                        "glosses": [
                                            "ein Konzerthaus, das der Aufführung von Orchestermusik dient"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48d2e60c-08b6-4cbf-8e8b-b055580f12ff",
                                                "sense_id": "4c8f49c6-50af-3289-88a6-e6e4ee3eb790",
                                                "text": "Die Philharmonie in Berlin wurde Anfang der 60er Jahre erbaut."
                                            },
                                            {
                                                "example_id": "145f25ad-bec2-4098-9792-4b0690695e4e",
                                                "sense_id": "4c8f49c6-50af-3289-88a6-e6e4ee3eb790",
                                                "text": "„Als wir aber im Innern der Philharmonie waren, habe ich sehr gestaunt, denn ich hatte noch nie einen so schönen Konzertsaal gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c16f66-c361-42c3-956f-4d667c195f35",
                        "source_entry_id": "32c5a8d9-b66b-3ac4-b389-48b8dc27c62a",
                        "source_sense_id": "e98e8d2e-c3bd-3fa9-9134-1769db2bee45",
                        "target_lang_word": "филармония",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "филармония",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "831e6299-0d61-3b06-97a7-c7e1ec525b39",
                                        "entry_id": "856dfad1-c581-32a2-8fc5-b39169841800",
                                        "glosses": [
                                            "учреждение, занятое организацией концертов и пропагандой музыкального искусства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99781bb5-c47b-4af4-bf0c-23834238fc7c",
                                                "sense_id": "831e6299-0d61-3b06-97a7-c7e1ec525b39",
                                                "text": "Пианист Леонид Сагалов живёт в Харькове, а служит в Киевской филармонии."
                                            },
                                            {
                                                "example_id": "d3b2d6c2-87b3-4cb4-8e07-73ef28356d41",
                                                "sense_id": "831e6299-0d61-3b06-97a7-c7e1ec525b39",
                                                "text": "Уже 6 марта, то есть через четыре дня, Государственная Дума заседала в помещении Дворянского собрания, где нынче находится Ленинградская филармония на улице Бродского."
                                            },
                                            {
                                                "example_id": "c565a502-78b1-4fac-843b-7b2260b51789",
                                                "sense_id": "831e6299-0d61-3b06-97a7-c7e1ec525b39",
                                                "text": "Мы приехали назад к Мравинским на служебной машине филармонии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518113cd-d029-3ece-86d6-e50cbf41403e",
                                        "entry_id": "856dfad1-c581-32a2-8fc5-b39169841800",
                                        "glosses": [
                                            "концертный зал такого учреждения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668ba530-ac05-43f0-9a97-24b2878d5426",
                                                "sense_id": "518113cd-d029-3ece-86d6-e50cbf41403e",
                                                "text": "Мы глотали книги, бегали на все доклады в городе и на все концерты в филармонии."
                                            },
                                            {
                                                "example_id": "4b894b31-2224-41da-8ea1-f6feca71b702",
                                                "sense_id": "518113cd-d029-3ece-86d6-e50cbf41403e",
                                                "text": "Двери филармонии закрыты, у дверей висит табличка с надписью: СЕГОДНЯ КОНЦЕРТА НЕТ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
