                "senses": [
                    {
                        "sense_id": "2cdee3bb-9e5b-34ff-9807-996940093248",
                        "entry_id": "937e371a-b2b5-3c94-bb43-c2bf667593dd",
                        "glosses": [
                            "Ziffer (Zahl), die angibt, wie schnell die Anzahl von Betroffenen/Infizierten zweimal so groß ist, sich also verdoppelt"
                        ],
                        "tags": [
                            "Epidemiologie",
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "15af3c62-40cc-490f-bec0-5e5e95d1ad8c",
                                "sense_id": "2cdee3bb-9e5b-34ff-9807-996940093248",
                                "text": "Bei einer Verdoppelungszahl von 2,5 Tagen sind nach zweieinhalb Tagen doppelt so viele Menschen infiziert wie zu Beginn."
                            },
                            {
                                "example_id": "97159c1b-5a3f-40b1-9b45-d7c67d77846a",
                                "sense_id": "2cdee3bb-9e5b-34ff-9807-996940093248",
                                "text": "„Ich ertappe mich in diesen Tagen dabei, dass ich mit so schönen Begriffen wie „Verdoppelungszahl“ oder „R0-Wert“ hantiere. Beides sind wichtige Indikatoren für die Verbreitung oder eben die Eindämmung des Virus. Einmal, Sie wissen es, geht es um den Zeitraum, in dem sich die Zahl der mit dem Coronavirus Infizierten verdoppelt. Je länger es dauert, desto besser, weil es zum berühmten Abflachen der Kurve von Covid-19-Erkrankungen und -Todesfällen beiträgt.“"
                            },
                            {
                                "example_id": "95c8598f-a86b-45fb-be2e-9b4871be2f04",
                                "sense_id": "2cdee3bb-9e5b-34ff-9807-996940093248",
                                "text": "„Merkel hatte jüngst als Etappenziel eine Verdoppelungszahl bei den Infektionen \"in Richtung\" zehn Tage ausgegeben. Wenn dieses erreicht sei, werde das Gesundheitssystem nicht überlastet. Am Mittwoch sprach sie allerdings davon, dass der Zeitraum \"über zehn Tage\" liegen müsse, eher bei \"12, 13, 14 Tagen\".“"
                            },
                            {
                                "example_id": "cab9033e-a14e-4ece-b20c-de70fdea9855",
                                "sense_id": "2cdee3bb-9e5b-34ff-9807-996940093248",
                                "text": "„Wir müssen schnell bemerken, wann die Verdoppelungszahl wieder steigt. Wir dürfen uns keineswegs zurücklehnen.“"
                            },
                            {
                                "example_id": "ce765545-b50e-4908-8279-d2e81d1ba866",
                                "sense_id": "2cdee3bb-9e5b-34ff-9807-996940093248",
                                "text": "„Die Demographen rechnen in ihren Tabellen mit der Verdoppelungszahl. Sie zeigt, in wieviel Jahren sich die Bevölkerung eines Staates verdoppeln würde. Für die Bundesrepublik Deutschland liegt dieser Wert bei 175 Jahren.“"
                            },
                            {
                                "example_id": "0ded659f-d2d2-4565-befe-40bcd123d052",
                                "sense_id": "2cdee3bb-9e5b-34ff-9807-996940093248",
                                "text": "„In den Populationen von Fibroblasten von Menschen verschiedenen Alters vermindert sich die Verdoppelungszahl mit jedem Lebensjahr des Spenders um 0,2.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
