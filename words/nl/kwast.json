{
    "word_family": [
        "kwasten",
        "kwastje",
        "kwastig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d28fc73-ce00-3ae7-a4a9-77a9c2ccdb5a",
                    "sense_definition": "een voorwerp bestaande uit haren of vezels aan een steel, gebruikt om vloeistoffen zoals verf aan te brengen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schilder maakte zijn <w>kwasten</w> schoon voordat hij ze opborg.",
                            "target_lang_translations": {
                                "en": "The painter cleaned his <w>brushes</w> before putting them away.",
                                "ru": "Маляр очистил свои <w>кисти</w> перед тем, как убрать их."
                            }
                        },
                        {
                            "text": "Ik heb een brede <w>kwast</w> nodig om de hele muur te schilderen.",
                            "target_lang_translations": {
                                "en": "I need a wide <w>brush</w> to paint the entire wall.",
                                "ru": "Мне нужна широкая <w>кисть</w>, чтобы покрасить всю стену."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brede kwast",
                        "kwast schoonmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "an object consisting of hairs or fibers on a handle, used to apply liquids such as paint",
                        "ru": "предмет, состоящий из волосков или волокон на рукоятке, используемый для нанесения жидкостей, таких как краска"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brush",
                                "target_lang_sense_clarification": "general term for painting or cleaning"
                            },
                            {
                                "target_lang_word": "paintbrush",
                                "target_lang_sense_clarification": "specifically for applying paint"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кисть",
                                "target_lang_sense_clarification": "инструмент для покраски или рисования"
                            },
                            {
                                "target_lang_word": "кисточка",
                                "target_lang_sense_clarification": "небольшая кисть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd02a0ff-1bd8-35e5-a51f-884581014906",
                    "sense_definition": "een borstelachtige versiering van bijeengebonden draden, vaak aan gordijnen of kleding",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "versiering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rand van het gordijn was afgezet met kleine <w>kwastjes</w>.",
                            "target_lang_translations": {
                                "en": "The edge of the curtain was trimmed with small <w>tassels</w>.",
                                "ru": "Край шторы был отделан маленькими <w>кисточками</w>."
                            }
                        },
                        {
                            "text": "Aan de hoeken van het kussen hangt een decoratieve <w>kwast</w>.",
                            "target_lang_translations": {
                                "en": "A decorative <w>tassel</w> hangs from the corners of the cushion.",
                                "ru": "По углам подушки висит декоративная <w>кисть</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gordijn met kwastjes"
                    ],
                    "target_lang_definitions": {
                        "en": "a brush-like decoration of bundled threads, often on curtains or clothing",
                        "ru": "украшение в виде пучка связанных нитей, часто на шторах или одежде"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tassel",
                                "target_lang_sense_clarification": "decorative bunch of threads"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кисть",
                                "target_lang_sense_clarification": "декоративное украшение из нитей"
                            },
                            {
                                "target_lang_word": "кисточка",
                                "target_lang_sense_clarification": "небольшая декоративная деталь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bab0384-4b59-3fee-aafc-f3ee37e68343",
                    "sense_definition": "een drankje gemaakt van citroensap, water en suiker, dat zowel warm als koud gedronken kan worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op deze bloedhete dag was het heerlijk om koude <w>kwast</w> te drinken.",
                            "target_lang_translations": {
                                "en": "On this scorching day, it was lovely to drink cold <w>lemonade</w>.",
                                "ru": "В этот жаркий день было так приятно выпить холодного <w>лимонада</w>."
                            }
                        },
                        {
                            "text": "In de winter drinken we vaak warme <w>kwast</w> tegen de verkoudheid.",
                            "target_lang_translations": {
                                "en": "In the winter, we often drink hot <w>lemonade</w> for a cold.",
                                "ru": "Зимой мы часто пьем горячий <w>лимонад</w> от простуды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warme kwast",
                        "koude kwast"
                    ],
                    "target_lang_definitions": {
                        "en": "a drink made from lemon juice, water, and sugar, which can be drunk both hot and cold",
                        "ru": "напиток из лимонного сока, воды и сахара, который можно пить как горячим, так и холодным"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lemonade",
                                "target_lang_sense_clarification": "lemon-based beverage"
                            },
                            {
                                "target_lang_word": "lemon squash",
                                "target_lang_sense_clarification": "concentrated fruit drink"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лимонад",
                                "target_lang_sense_clarification": "напиток на основе лимонного сока"
                            },
                            {
                                "target_lang_word": "горячий лимонад",
                                "target_lang_sense_clarification": "лимонный напиток, подаваемый горячим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bcab6f7-e390-35d3-b366-6f6a90e2ef55",
                    "sense_definition": "een harde, ronde plek in hout op de plaats waar vroeger een zijtak aan de boom zat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze <w>kwast</w> maakt dit dure stuk hout onbruikbaar voor het maken van een muziekinstrument.",
                            "target_lang_translations": {
                                "en": "This <w>knot</w> makes this expensive piece of wood unusable for making a musical instrument.",
                                "ru": "Этот <w>сучок</w> делает этот дорогой кусок дерева непригодным для изготовления музыкального инструмента."
                            }
                        },
                        {
                            "text": "Het hout van de grenen tafel zit vol met donkere <w>kwasten</w>.",
                            "target_lang_translations": {
                                "en": "The wood of the pine table is full of dark <w>knots</w>.",
                                "ru": "Древесина соснового стола полна темных <w>сучков</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "knoest",
                        "noest"
                    ],
                    "common_phrases": [
                        "kwast in het hout"
                    ],
                    "target_lang_definitions": {
                        "en": "a hard, round spot in wood at the place where a side branch used to be on the tree",
                        "ru": "твердое круглое место в древесине на месте, где раньше росла ветка дерева"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knot",
                                "target_lang_sense_clarification": "imperfection in timber"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сучок",
                                "target_lang_sense_clarification": "дефект древесины на месте ветки"
                            },
                            {
                                "target_lang_word": "сук",
                                "target_lang_sense_clarification": "крупный сучок в древесине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a43b352-c7a3-3374-920b-e38a9012442e",
                    "sense_definition": "een persoon die als vreemd, eigenzinnig of verwaand wordt beschouwd",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een rare <w>kwast</w> is hij toch met zijn vreemde gewoontes!",
                            "target_lang_translations": {
                                "en": "What a strange <w>character</w> he is with his odd habits!",
                                "ru": "Какой же он все-таки странный <w>чудак</w> со своими нелепыми привычками!"
                            }
                        },
                        {
                            "text": "De Fransen werden in dat boek omschreven als hooghartige <w>kwasten</w>.",
                            "target_lang_translations": {
                                "en": "The French were described in that book as haughty <w>fops</w>.",
                                "ru": "Французы были описаны в той книге как высокомерные <w>франты</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rare kwast",
                        "verwaande kwast"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person who is considered strange, idiosyncratic, or conceited",
                        "ru": "человек, которого считают странным, своеобразным или высокомерным"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oddball",
                                "target_lang_sense_clarification": "eccentric person"
                            },
                            {
                                "target_lang_word": "weirdo",
                                "target_lang_sense_clarification": "strange person, informal"
                            },
                            {
                                "target_lang_word": "character",
                                "target_lang_sense_clarification": "unusual or interesting person"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "странный, эксцентричный человек"
                            },
                            {
                                "target_lang_word": "франт",
                                "target_lang_sense_clarification": "высокомерный, щеголеватый человек"
                            },
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "странный субъект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}