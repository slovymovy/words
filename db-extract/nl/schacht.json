                                "target_senses": [
                                    {
                                        "sense_id": "ba597a11-a653-3a47-88b2-40b527120e1a",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "The entire body of a long weapon, such as an arrow."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9fbd6c5-9363-47df-b5e8-4314eef26521",
                                                "sense_id": "ba597a11-a653-3a47-88b2-40b527120e1a",
                                                "text": "A shaft hath three principal parts, the stele, the feathers, and the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf78c60-ad25-353b-a69e-86351b847969",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "The long, narrow, central body of a spear, arrow, or javelin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f4c173-e1d5-461c-b245-be97f0809140",
                                                "sense_id": "0cf78c60-ad25-353b-a69e-86351b847969",
                                                "text": "Her hand slipped off the javelin's shaft towards the spearpoint and that's why her score was lowered."
                                            },
                                            {
                                                "example_id": "fca7b75d-2459-4ba9-ba5e-06a5b3825928",
                                                "sense_id": "0cf78c60-ad25-353b-a69e-86351b847969",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d6f478-9cbd-36a4-821e-77e0ccb9b8b1",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "Anything cast or thrown as a spear or javelin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824e7c0d-2625-4821-b398-4f2ab1efa3c7",
                                                "sense_id": "a9d6f478-9cbd-36a4-821e-77e0ccb9b8b1",
                                                "text": "[…]and the Thunder, / Wing'd with red Lightning and impetuous rage, / Perhaps hath ſpent his ſhafts […]"
                                            },
                                            {
                                                "example_id": "d8f291bb-b9d3-447a-86bb-2f98c2af0243",
                                                "sense_id": "a9d6f478-9cbd-36a4-821e-77e0ccb9b8b1",
                                                "text": "The correction of theſe will reſtore its proper dignity to the ſtudy of antiquities, and cauſe the ſhafts of ridicule, which have been ſucceſsfully thrown at it, to recoil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487b13ea-8884-37db-8bc2-621276c3d059",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "Any long thin object, such as the handle of a tool.",
                                            "One of the poles between which a draught animal is harnessed to a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e83740c-06cf-4592-9d1b-c17aba3ed218",
                                                "sense_id": "487b13ea-8884-37db-8bc2-621276c3d059",
                                                "text": "While Kitto chatted to William, Jessamy looked with interest at the dog cart. It had a pair of high wooden wheels with two seats back to back above. Between the shafts the bay mare tossed her head and fidgeted on the cobbles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1603ae4e-ed6d-3516-b903-826ad71ec8f0",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "Any long thin object, such as the handle of a tool.",
                                            "A rotating machine element used to transmit power; a driveshaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b31526-8cec-4028-8a59-c75f4e928951",
                                                "sense_id": "1603ae4e-ed6d-3516-b903-826ad71ec8f0",
                                                "text": "Turbines have been around for a long time—windmills and water wheels are early examples. The name comes from the Latin turbo, meaning vortex, and thus the defining property of a turbine is that a fluid or gas turns the blades of a rotor, which is attached to a shaft that can perform useful work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a575e67-3f8e-37cf-97b3-c288f06f6ff4",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "Any long thin object, such as the handle of a tool.",
                                            "The long narrow body of a lacrosse stick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec08df18-ac0a-4c4d-87b5-109886e5381f",
                                                "sense_id": "0a575e67-3f8e-37cf-97b3-c288f06f6ff4",
                                                "text": "Sarah, if you wear gloves your hands might not slip on your shaft and you can up your game, girl!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85dc3608-7ee7-3118-adaf-fe246a229254",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "A beam or ray of light."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f494a33-009d-4e1c-9201-7e0c39e77826",
                                                "sense_id": "85dc3608-7ee7-3118-adaf-fe246a229254",
                                                "text": "Isn't that shaft of light from that opening in the cave beautiful?"
                                            },
                                            {
                                                "example_id": "b483022b-74a5-4747-9640-35712b17de80",
                                                "sense_id": "85dc3608-7ee7-3118-adaf-fe246a229254",
                                                "text": "They were a fine company of old women, and a Dutch painter would have loved to find them there together, where the sun made bright patches on the floor and sent long, quivering shafts of gold through the dusky shade up among the rafters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73da4854-5b5a-3215-b889-5600b22e0289",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "The main axis of a feather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd2ee9b-cf4e-4c1b-9b79-bca8a9ae6c8e",
                                                "sense_id": "73da4854-5b5a-3215-b889-5600b22e0289",
                                                "text": "I had no idea that they removed the feathers' shafts to make the pillows softer!"
                                            }
