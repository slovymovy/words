                                    {
                                        "sense_id": "baab8640-560a-353d-82e6-657353db1049",
                                        "entry_id": "afe97476-ed49-3b6c-89c1-2307cc663fd8",
                                        "glosses": [
                                            "The process of making or becoming slimmer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7d4dba1-0380-4b7b-9eac-3d773597a1b9",
                                                "sense_id": "baab8640-560a-353d-82e6-657353db1049",
                                                "text": "We have become accustomed to Thatcherite slimmings of the system — massive ward closures punctuated from time to time by the royal opening of an Aids unit for ten patients, but here is something new."
                                            }
                                        ]
