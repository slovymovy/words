                                "example_id": "25faf337-a0cc-46ec-8c0a-a67db1e6da03",
                                "sense_id": "3820f764-02f3-307f-b662-718ce61e112a",
                                "text": "But whenever a Kuna artist shows a face in front view there seems to be an overpowering urge to bewhisker it."
                            }
                        ]
