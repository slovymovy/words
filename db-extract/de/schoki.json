                "senses": [
                    {
                        "sense_id": "4270884a-74a2-3255-a5f7-50bb61de428e",
                        "entry_id": "8bd0a586-2a97-3d95-b0d4-d222b8f8f549",
                        "glosses": [
                            "Schokolade"
                        ],
                        "tags": [
                            "colloquial",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "cca370fc-4883-41ed-980f-c0b2f1ebcbf9",
                                "sense_id": "4270884a-74a2-3255-a5f7-50bb61de428e",
                                "text": "Ich holte mir etwas Schoki aus der Schublade."
                            },
                            {
                                "example_id": "32592f51-071f-4c50-9dd2-898ab0e5eb8f",
                                "sense_id": "4270884a-74a2-3255-a5f7-50bb61de428e",
                                "text": "„Und wenn uns kalt war, dann hat er uns unten am Häuschen eine heiße Schoki gekauft – dafür gibt er mir immer noch extra Geld mit, wenn wir jetzt allein dort Skifahren gehen.“"
                            },
                            {
                                "example_id": "dbb3d068-4771-42e1-9bb9-cea8cb3d9539",
                                "sense_id": "4270884a-74a2-3255-a5f7-50bb61de428e",
                                "text": "„Ab 70 Prozent Kakaogehalt wirkt Schoki antientzündlich und kann Altersprozesse in den Adern verlangsamen.“"
                            },
                            {
                                "example_id": "bc414ba4-852d-439b-9d53-0af91eda912f",
                                "sense_id": "4270884a-74a2-3255-a5f7-50bb61de428e",
                                "text": "„Zur Belohnung gibt es für die Fahrer eine Schoki, ohne Rum, versteht sich, denn ein Ausrutscher bei der Bergabfahrt soll möglichst vermieden werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba09962d-5016-4879-887d-7b820b909a3b",
