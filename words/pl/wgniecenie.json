                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдавливание",
                                "target_lang_sense_clarification": "процесс воздействия силой для создания углубления"
                            },
                            {
                                "target_lang_word": "вмятие",
                                "target_lang_sense_clarification": "действие по значению глагола вмять"
                            }
                        ]
                    }
                }
            ]
