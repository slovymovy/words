            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "14ffccc6-76bf-3649-8f35-c166eed68d8f",
                    "sense_definition": "Niet verbonden met of tegen andere gebouwen of objecten aan geplaatst.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wonen in een prachtig <w>vrijstaand</w> huis aan de rand van het bos.",
                            "target_lang_translations": {
                                "en": "They live in a beautiful <w>detached</w> house on the edge of the forest."
                            }
                        },
                        {
                            "text": "De makelaar liet ons een <w>vrijstaande</w> woning zien met een grote tuin.",
                            "target_lang_translations": {
                                "en": "The real estate agent showed us a <w>detached</w> home with a large garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "losstaand",
                        "apart"
                    ],
                    "antonyms": [
                        "geschakeld",
                        "aaneengesloten"
                    ],
                    "common_phrases": [
                        "vrijstaand huis",
                        "vrijstaande woning",
                        "vrijstaande schuur"
                    ],
                    "target_lang_definitions": {
                        "en": "Not connected to or placed against other buildings or objects."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detached",
                                "target_lang_sense_clarification": "specifically for houses not joined to others"
                            },
                            {
                                "target_lang_word": "freestanding",
                                "target_lang_sense_clarification": "standing on its own without support"
                            },
                            {
                                "target_lang_word": "standalone",
                                "target_lang_sense_clarification": "independent and not part of a larger structure"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29e3e03a-59f7-3a8b-b3d8-d8e953b2b753",
                    "sense_definition": "Het onvoltooid deelwoord van <w>vrijstaan</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>vrijstaande</w> kolom in het midden van de kamer ondersteunt het hele dak.",
                            "target_lang_translations": {
                                "en": "The <w>freestanding</w> column in the middle of the room supports the entire roof."
                            }
                        },
                        {
                            "text": "Met een <w>vrijstaand</w> fornuis heb je meer flexibiliteit bij het inrichten van je keuken.",
                            "target_lang_translations": {
                                "en": "With a <w>freestanding</w> stove, you have more flexibility when designing your kitchen."
                            }
