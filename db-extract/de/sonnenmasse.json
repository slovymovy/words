                "senses": [
                    {
                        "sense_id": "6b749042-c235-3733-a6dc-323b4b1cc780",
                        "entry_id": "2a026951-6715-3e19-8c6e-72e168f9cd3d",
                        "glosses": [
                            "„astronomische Maßeinheit, die über die Masse der Sonne definiert wird“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c742b1-a855-49b8-abd4-e9dd4ac81bf9",
                                "sense_id": "6b749042-c235-3733-a6dc-323b4b1cc780",
                                "text": "„Demnach haben die Ligo-Forscher angeblich die Verschmelzung von zwei Schwarzen Löchern mitverfolgt, das eine mit einer Masse von 29 Sonnen, das andere mit 36 Sonnenmassen.“"
                            },
                            {
                                "example_id": "e1c0690d-0e4d-4766-baba-4d7fd5c7d879",
                                "sense_id": "6b749042-c235-3733-a6dc-323b4b1cc780",
                                "text": "Wann wurde das erste Mal die Sonnenmasse ermittelt?"
                            },
                            {
                                "example_id": "0e9a490d-53f7-41e9-9597-6d3b4d11c4e1",
                                "sense_id": "6b749042-c235-3733-a6dc-323b4b1cc780",
                                "text": "Die Sonnenmasse, kurz M_☉, ist eine astronomische Maßeinheit, die über die Masse der Sonne definiert wird. Sie beträgt: 1 M_☉ = (1,98892 ± 0,00025) · 10³⁰ kg. Dies entspricht 1,99 Quintillionen kg oder 332.946 Erdmassen."
                            },
                            {
                                "example_id": "e43ba10a-2af2-42d9-9c9d-a0b9922e2d00",
                                "sense_id": "6b749042-c235-3733-a6dc-323b4b1cc780",
                                "text": "„Die Schwarzen Löcher mit insgesamt 65 Sonnenmassen, deren Ineinanderkrachen die nun entdeckten Wellen ausgelöst hat, sind galaktisch gesehen nicht beeindruckend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
