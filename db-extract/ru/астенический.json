                "senses": [
                    {
                        "sense_id": "5b601bee-f307-32eb-8cae-6f692c928ffb",
                        "entry_id": "c12d8f0d-b081-36bc-899c-bdf4cb2e378d",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным астения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b022a905-d861-44e5-ba70-3ae59d693e3b",
                                "sense_id": "5b601bee-f307-32eb-8cae-6f692c928ffb",
                                "text": "Именно прессорецепторы первыми реагируют на изменения атмосферного давления, что при астенических состояниях проявляется симптоматикой метеопатии."
                            }
                        ]
                    },
                    {
                        "sense_id": "b10409e7-f14f-39eb-b240-f64290630038",
                        "entry_id": "c12d8f0d-b081-36bc-899c-bdf4cb2e378d",
                        "glosses": [
                            "свойственный астенику, характерный для него"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
