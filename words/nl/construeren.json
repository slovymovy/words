    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c431d558-b532-363b-b6a8-7987abc94064",
                    "sense_definition": "onderdelen tot een werkzaam geheel samenvoegen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Romeinse ingenieurs <w>construeerden</w> een aquaduct om de stad van water te voorzien.",
                            "target_lang_translations": {
                                "en": "Roman engineers <w>constructed</w> an aqueduct to provide the city with water."
                            }
                        },
                        {
                            "text": "Het is lastig om een stevige brug te <w>construeren</w> met deze materialen.",
                            "target_lang_translations": {
                                "en": "It is difficult to <w>build</w> a sturdy bridge with these materials."
                            }
                        }
                    ],
                    "synonyms": [
                        "bouwen",
                        "samenstellen",
                        "ineenzetten",
                        "maken"
                    ],
                    "antonyms": [
                        "afbreken",
                        "slopen"
                    ],
                    "common_phrases": [
                        "een brug construeren",
                        "een machine construeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To assemble parts into a functional whole"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construct",
                                "target_lang_sense_clarification": "to build by assembling parts"
                            },
                            {
                                "target_lang_word": "build",
                                "target_lang_sense_clarification": "general term for making a structure"
                            },
                            {
                                "target_lang_word": "assemble",
                                "target_lang_sense_clarification": "to put together components"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34553e28-2ebb-365d-8930-a998c9018d0a",
                    "sense_definition": "iets abstracts of kunstmatigs vormen of bedenken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het concept ‘logica’s’ kan gebruikt worden om verschillende patronen te <w>construeren</w> in het denken.",
                            "target_lang_translations": {
                                "en": "The concept of 'logics' can be used to <w>construct</w> different patterns in thinking."
                            }
                        },
                        {
                            "text": "De advocaat probeerde een waterdichte juridische constructie te <w>construeren</w> voor zijn cliënt.",
                            "target_lang_translations": {
                                "en": "The lawyer tried to <w>devise</w> a watertight legal construction for his client."
                            }
                        }
                    ],
                    "synonyms": [
                        "samenstellen",
                        "maken"
                    ],
                    "common_phrases": [
                        "een theorie construeren",
                        "een argument construeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To form or devise something abstract or artificial"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construct",
                                "target_lang_sense_clarification": "to build an argument or theory"
                            },
                            {
                                "target_lang_word": "formulate",
                                "target_lang_sense_clarification": "to create a strategy or concept"
                            },
                            {
                                "target_lang_word": "devise",
                                "target_lang_sense_clarification": "to plan or invent a complex system"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f672037-b4ef-373f-a43e-7b4c6970c672",
                    "sense_definition": "woorden of zinsdelen volgens de grammaticaregels samenvoegen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze taal moet men een zin heel zorgvuldig <w>construeren</w> om misverstanden te voorkomen.",
                            "target_lang_translations": {
                                "en": "In this language, one must <w>construct</w> a sentence very carefully to avoid misunderstandings."
                            }
                        },
                        {
                            "text": "De student leerde hoe hij een complexe zin met een lijdend voorwerp kon <w>construeren</w>.",
                            "target_lang_translations": {
                                "en": "The student learned how he could <w>form</w> a complex sentence with a direct object."
                            }
                        }
                    ],
                    "synonyms": [
                        "samenstellen"
                    ],
                    "common_phrases": [
                        "een zin construeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To join words or phrases according to grammatical rules"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construct",
                                "target_lang_sense_clarification": "to arrange words into a sentence"
                            },
                            {
                                "target_lang_word": "form",
                                "target_lang_sense_clarification": "to create a grammatical structure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca7ed51d-a364-3df7-b080-f26aec153dac",
                    "sense_definition": "een meetkundige figuur tekenen met alleen een liniaal en een passer",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet mogelijk om een trisectrice te <w>construeren</w> met enkel een passer en liniaal.",
                            "target_lang_translations": {
                                "en": "It is not possible to <w>construct</w> a trisectrix with only a compass and ruler."
                            }
                        },
                        {
                            "text": "De leerlingen moesten een gelijkzijdige driehoek <w>construeren</w> tijdens de wiskundeles.",
                            "target_lang_translations": {
                                "en": "The students had to <w>draw</w> an equilateral triangle during the math lesson."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een figuur construeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To draw a geometric figure using only a ruler and compass"
                    },
                    "translations": {
                        "en": [
