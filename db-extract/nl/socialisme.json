                                        "sense_id": "674a56fb-a4ed-3daa-8247-b3cf1a63dc2f",
                                        "entry_id": "05d6fa9e-7600-31c8-a19d-78d554540095",
                                        "glosses": [
                                            "společenský a ekonomický systém založený na společném vlastnictví výrobních prostředků, kolektivismu, státním intervencionismu a případně též plánovaném hospodářství"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f36cee60-22c7-420b-8f26-f3a772971beb",
                                                "sense_id": "674a56fb-a4ed-3daa-8247-b3cf1a63dc2f",
                                                "text": "Byl přesvědčen, že socialismus je jediné východisko pro lidstvo, má-li překonat krizi, do níž se svět řítí rozdělením na bohaté a chudé, na technicky vyspělé a zaostalé národy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "522e24f3-3b76-3fb0-a8ee-453c3d92ea86",
                                        "entry_id": "05d6fa9e-7600-31c8-a19d-78d554540095",
                                        "glosses": [
                                            "konkrétní pokusy o uskutečnění státního zřízení a společnosti založené na socialismu (1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "675adc91-b376-46fe-9a72-3dba01a06828",
                                                "sense_id": "522e24f3-3b76-3fb0-a8ee-453c3d92ea86",
                                                "text": "Když u nás ten divný socialismus padl, těšil jsem se, že se zase vrátí pekaři a pořádný chleba. Půl roku to tak vypadalo, ale nevydrželi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e48160-1b10-3d64-9020-d1f0a80f890b",
                                        "entry_id": "05d6fa9e-7600-31c8-a19d-78d554540095",
                                        "glosses": [
                                            "levicová politická ideologie a filozofie usilující o sociální spravedlnost, rovnost a reálnou svobodu všech prostřednictvím různých forem zásahů do soukromého vlastnictví"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74080074-c4bf-4a0b-a60d-4ceecb1900ca",
                                                "sense_id": "94e48160-1b10-3d64-9020-d1f0a80f890b",
                                                "text": "Filozoficky je socialismus říší nekoncizních, vzájemně nesouvisejících, zato přepestrých iluzí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e122278f-9b56-3b86-8ca9-708f50057735",
