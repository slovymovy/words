                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f88a412-fd8a-30b9-8287-c355a4043694",
                        "entry_id": "f3cd7bc6-1a8e-3532-9a21-d807d14258d9",
                        "glosses": [
                            "een beetje vochtig aanvoelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c4fbdc-1bb5-4602-84c9-1da672499984",
                                "sense_id": "8f88a412-fd8a-30b9-8287-c355a4043694",
                                "text": "Van het zweten heb ik klamme handen gekregen."
                            },
                            {
                                "example_id": "9b1cc64a-ecd4-4a8e-9b5a-9eec7f685fde",
                                "sense_id": "8f88a412-fd8a-30b9-8287-c355a4043694",
                                "text": "Ik wreef mijn klamme handen droog aan mijn korte broek en stak mijn armen en wandelstokken wijd uit om als een trapezeartiest naar de overkant te balanceren, mijn blik geconcentreerd op de overkant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5894708d-c165-4e55-85f5-0f04e0b44788",
                        "source_entry_id": "f3cd7bc6-1a8e-3532-9a21-d807d14258d9",
                        "source_sense_id": "8f88a412-fd8a-30b9-8287-c355a4043694",
                        "source_sense_description": "een beetje vochtig aanvoelend",
                        "target_lang_word": "feucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                        "entry_id": "ae1a682d-02de-3edd-8c7d-67177151ab2e",
                                        "glosses": [
                                            "mit ein wenig Wasser (seltener mit einer anderen Flüssigkeit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e57dfff-f526-4ad1-be0e-05ddc6fe081b",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "Die Kleidungsstücke sind noch immer etwas feucht."
                                            },
                                            {
                                                "example_id": "77bfe603-b012-427c-a155-7bc8a68ab551",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "In diesem feuchten Keller darf niemand wohnen."
                                            },
                                            {
                                                "example_id": "4ddf5a75-ac98-4310-8e8b-71f6db68b8ae",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Zwei winzige, feuchte Abstellkammern des Kinos ohne Fenster fungierten als erste Schlafstatt der Beatles, die sie selbst nur \"schwarzes Loch\" nannten.“"
                                            },
                                            {
                                                "example_id": "285181b6-cf22-4b56-b288-531b2da6db12",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Ich habe gar kein Bedürfnis, durch die feuchten Gänge zu kriechen.“"
                                            },
                                            {
                                                "example_id": "d7439af1-16b2-4339-a589-5ec0139bf800",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "Schnecken lieben eine feuchte Witterung."
                                            },
                                            {
                                                "example_id": "0c8f3fb0-a1d6-4030-9622-c431758ce8b0",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Die knapp einen Zentimeter langen Silberfischchen mögen es warm und feucht.“"
                                            },
                                            {
                                                "example_id": "3be68705-d380-4ab3-8d18-4f88d64fc70f",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "[Krankheit auf Obstbäumen:] „Das zuletzt warme und feuchte Wetter hat die Ausbreitung laut Amt begünstigt.“"
                                            },
                                            {
                                                "example_id": "bafc0133-2d58-48ce-9641-6b79cbe13c40",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Im Flachland und auf der Alpensüdseite ist die Luft seit ein paar Tagen sehr feucht und warm. Es ist schwül.“"
                                            },
                                            {
                                                "example_id": "ffd02cbd-5349-4354-806f-6c15928545f8",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Feuchte Luft kann sich weniger rasch abkühlen als trockene. Der Grund liegt in der Fähigkeit von Wasserdampf, Wärme zu speichern.“"
                                            },
                                            {
                                                "example_id": "8a19c523-fee8-4cc5-b48c-abb42b352d1e",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Wir stehen hier in Österreich, direkt an der Grenze zu Bayern und atmen die feuchte Luft ein.“"
                                            },
                                            {
                                                "example_id": "92d8b3fb-792e-4e3d-8d33-f4d9ae5371e0",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Durch regelmäßiges Lüften soll die Feuchtigkeit entweichen und Schimmelbildung verhindert werden. Wenn die Außenluft jedoch feuchter ist als die Luft im Raum, hat das Lüften wenig Sinn.“"
                                            },
                                            {
                                                "example_id": "4e750aa8-147a-46b3-af25-74126c6dd0e4",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Eigentlich liebt die Wiesenweihe feuchte Wiesen, unberührte Moorlandschaften und Brachflächen. Doch die sind selten geworden,“ […]."
                                            },
                                            {
                                                "example_id": "848c114c-4324-40a5-af43-c51904516103",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Die Buchsbaum-Stecklinge benötigen gleichmäßig feuchte Erde, Staunässe vertragen sie nicht, dann beginnen sie zu faulen.“"
                                            },
                                            {
                                                "example_id": "21fcec25-8287-4ef1-917f-db7a1b45bb4e",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Schwarzerlen gedeihen auf feuchtem Boden,“ […]."
                                            },
                                            {
                                                "example_id": "2cdd4723-e06f-4c5f-b12b-b07e942de850",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Gladiolen mögen keine Staunässe, deshalb ist es wichtig, sie in durchlässigen Boden zu setzen.Trotzdem sollten sie feucht gehalten werden.“"
                                            },
                                            {
                                                "example_id": "ae173071-8e94-44e5-b987-29d5e1873956",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "[Niger:] „Der westafrikanische Staat liegt im Sahel, also in der kargen Übergangszone zwischen der Wüste Sahara und der feuchten Savanne weiter südlich.“"
                                            },
                                            {
                                                "example_id": "b4ee4860-67a2-4d2a-80d4-2b4158113969",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "[Trockenheit in Europa 2022:] „In Amsterdam sind Mitarbeiter der Stadtverwaltung dabei, mit Wasser aus Feuerwehrschläuchen die Dämme der Stadt feucht und damit schwer genug zu halten.“"
                                            },
                                            {
                                                "example_id": "1c05a8b0-89ef-4338-b2d7-4ed24cad3183",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "[Schlagzeile:] „Moore, Auen, Sumpfgebiete – Faszinierende feuchte Lebensräume“"
                                            },
                                            {
                                                "example_id": "8023af57-a943-4b95-a085-b1d982af8671",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "[…] „in diesem Garten ging ich mit Natascha spazieren, und hinter dem Garten war ein großer, feuchter Wald, in dem wir Kinder uns beide einmal verirrten … O du goldene, schöne Zeit!“"
                                            },
                                            {
                                                "example_id": "46119d44-0289-42c6-8b34-5d8420fcb745",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "Flecken auf Polstern und Sitzen entfernt man am besten mit einem feuchten Lappen und ein wenig Seife."
                                            },
                                            {
                                                "example_id": "df8fb5da-60bc-4789-8a77-a5302b3106b4",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "[Sonnenstich:] „Kalte, feuchte Tücher können helfen, Körperareale, wie etwa den Nacken, zu kühlen.“"
                                            },
                                            {
                                                "example_id": "b5fd8348-67c9-4894-8056-3c6c01084b17",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "Bei Fieber kann man feuchte Umschläge/Wadenwickel machen."
                                            },
                                            {
                                                "example_id": "5e1cf108-e088-4b58-bfea-04a37f6fb700",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Haushaltsschwamm und Lappen bieten ein ideales Milieu für Bakterien, da sie fast immer feucht sind“ […]."
                                            },
                                            {
                                                "example_id": "0dc2f668-b1f1-4d8d-8e77-2111d44a358e",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "Der Arzt trug ein feuchtes Gel auf den Bauch der Schwangeren auf und zeigte ihr mit dem Ultraschallgerät ihr künftiges Kind."
                                            },
                                            {
                                                "example_id": "749a8557-d218-4726-bd9d-1fa3dd4d757a",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "Er hatte vor lauter Aufregung feuchte Hände."
                                            },
                                            {
                                                "example_id": "c1a2c9d1-cb85-4b3e-9855-a2e41fd9f080",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "Bei großer Hitze ist ein feuchter Mund ein guter Indikator, genug getrunken zu haben."
                                            },
                                            {
                                                "example_id": "e11217ea-40ec-4af6-a1b9-a2dacb7a9a42",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Ich spüre seine feuchten Lippen, seine Zunge, seine Zähne und an meiner Hüfte den deutlichen Beweis, dass ich nicht allein erregt bis in die letzte Faser meines Körpers bin.“"
                                            },
                                            {
                                                "example_id": "ba030058-5880-4446-8a59-6120306bee7d",
                                                "sense_id": "f50139a4-e645-35a4-a668-10044a0a5a75",
                                                "text": "„Seine Handfläche war feucht, eine feuchte Haarsträhne lag auf seiner Stirn, und seine feuchtglänzenden, schwarzen, schmalgeschlitzten Augen blickten auf sie mit feuchter Zärtlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
