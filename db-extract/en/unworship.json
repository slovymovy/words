                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "81f0ec26-7cfb-318c-82ec-56a71f1553e3",
                        "entry_id": "2079ed50-5950-3ded-a28f-8c327b3af542",
                        "glosses": [
                            "Lack of worship or respect; dishonour; failure or refusal to worship; irreverence."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "26422b73-03bf-449b-bb11-8713ed7d254b",
                                "sense_id": "81f0ec26-7cfb-318c-82ec-56a71f1553e3",
                                "text": "Some might think that I do little worship to Martha, that special saint, for I liken her words of complaining of her sister unto these worldly men's words, or theirs unto hers : and truly I mean no unworship to her nor to them."
                            },
                            {
                                "example_id": "639e6d55-083c-4c97-acfd-1a9a2b944589",
                                "sense_id": "81f0ec26-7cfb-318c-82ec-56a71f1553e3",
                                "text": "But whatever the world might think about such men, they are judged 'right shameful before God and all the company of heaven', for before them all sin is shame and 'unworship'."
                            },
                            {
                                "example_id": "63ff68e9-bf8c-4787-8338-636a1f3c1b65",
                                "sense_id": "81f0ec26-7cfb-318c-82ec-56a71f1553e3",
                                "text": "Whoe'er he be, who on my Queen hath laid\nStress of unworship: […]"
                            },
                            {
                                "example_id": "b000d584-dea9-40f4-a402-69551edd503e",
                                "sense_id": "81f0ec26-7cfb-318c-82ec-56a71f1553e3",
                                "text": "They hold God in great unworship [contempt] when all day and for nought him call to witness of all that is said, for swearing is no other thing but calling God to witness, and his mother and his holy ones [halzen]."
                            }
                        ]
                    }
                ],
