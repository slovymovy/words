                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verunsicherung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "159645e4-6faa-34d4-972c-72e1a53f5e11",
                                        "entry_id": "b421dc95-1092-35c4-84d1-00d4e9b7f79d",
                                        "glosses": [
                                            "Zustand, bei welchem die Gewissheit über etwas verloren gegangen ist, beziehungsweise Handlung/Vorgang, die Ursache für diesen Zustand sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0628ceb-cc44-40fb-a306-89e905d177b8",
                                                "sense_id": "159645e4-6faa-34d4-972c-72e1a53f5e11",
                                                "text": "Unter den Beteiligten machte sich eine deutlich spürbare Verunsicherung breit."
                                            },
                                            {
                                                "example_id": "aa0f8db8-d10c-40e3-a03e-af99ad1a9218",
                                                "sense_id": "159645e4-6faa-34d4-972c-72e1a53f5e11",
                                                "text": "„Die geballte Verunsicherung entlud sich zulasten von Italienern in Deutschland.“"
                                            },
                                            {
                                                "example_id": "ac44390c-aec9-4cf4-8a6c-d0ae4891f59c",
                                                "sense_id": "159645e4-6faa-34d4-972c-72e1a53f5e11",
                                                "text": "„Währungsreformen sind immer mit Verunsicherung und logistischen Herausforderungen verbunden, ihre Folgen sind niemals vollständig kalkulierbar.“"
                                            },
                                            {
                                                "example_id": "9f72e2bc-b733-477b-9122-8f491bcad6d3",
                                                "sense_id": "159645e4-6faa-34d4-972c-72e1a53f5e11",
                                                "text": "„Dann liest er den Brief noch einmal, und sein Zorn legt sich; dafür nimmt jetzt Verunsicherung überhand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
