                        "entry_id": "63c0c639-1d81-3c99-bad8-9526c5f6150e",
                        "glosses": [
                            "een van de zeven fundamentele wiskundige vraagstukken die zo genoemd worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55296b6-cf3f-491a-91d6-6225888e58c5",
                                "sense_id": "6b7db310-f739-3364-a39d-3f3a3135ef53",
                                "text": "Bovendien is er een miljoen dollar mee te verdienen, want het is een van de zeven Millenniumproblemen. Het Amerikaanse Clay Instituut stelde in 2000 voor elk van deze zeven fundamentele wiskundige vraagstukken een miljoen dollar beschikbaar."
                            }
                        ]
