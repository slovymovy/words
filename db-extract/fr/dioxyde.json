                        "entry_id": "4a190abd-df30-39d7-9f92-d7571dd92faf",
                        "glosses": [
                            "Oxyde comportant deux atomes d’oxygène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c78da8-3beb-4f14-90eb-9f6d73fb0ff2",
                                "sense_id": "b8ee3404-06dc-3903-95ad-7a65aeba1777",
                                "text": "Le dioxyde de carbone est aussi appelé gaz carbonique."
                            },
                            {
                                "example_id": "dc300dd1-f91c-4927-a12c-dd12f02c63f7",
                                "sense_id": "b8ee3404-06dc-3903-95ad-7a65aeba1777",
                                "text": "Le dioxyde d’azote."
                            },
                            {
                                "example_id": "da09d6f9-c0a9-47d8-bfdd-a43b11e20739",
                                "sense_id": "b8ee3404-06dc-3903-95ad-7a65aeba1777",
                                "text": "Le dioxyde, très instable, ne peut prendre naissance que dans ces conditions."
                            }
                        ]
                    }
                ],
                "translations": [
