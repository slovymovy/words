                "senses": [
                    {
                        "sense_id": "f453a6a9-36d1-3714-aad7-fc758bb78a32",
                        "entry_id": "9e8c7432-6fb8-343c-b5c7-c013ac9d5caa",
                        "glosses": [
                            "To use an angle to delimit (mark off, enclose) part of a straight or curved line, for example an arc or the opposite side of a triangle."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ea40488b-6f20-4732-8eee-f732224a4388",
                                "sense_id": "f453a6a9-36d1-3714-aad7-fc758bb78a32",
                                "text": "A 43° angle subtends an arc of about 0.75 meters on a circle with a radius of 1 meter."
                            }
                        ]
                    },
                    {
                        "sense_id": "300ab72f-e797-34b2-ad39-9ec96a1186d1",
                        "entry_id": "9e8c7432-6fb8-343c-b5c7-c013ac9d5caa",
                        "glosses": [
                            "To extend or stretch opposite something; to be part of a straight or curved line that is opposite to and delimits an angle."
                        ],
                        "tags": [
                            "also",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca72795-7976-4b9e-b855-702ace443199",
                                "sense_id": "300ab72f-e797-34b2-ad39-9ec96a1186d1",
                                "text": "An arc measuring about 0.75 meters on a circle with a radius of 1 meter subtends an angle of about 43°."
                            },
                            {
                                "example_id": "ba1bb3f1-c614-4e52-a00e-80b23d9db74c",
                                "sense_id": "300ab72f-e797-34b2-ad39-9ec96a1186d1",
                                "text": "A hypotenuse subtends the right angle of a right triangle."
                            },
                            {
                                "example_id": "c0e3671a-270b-48db-98bc-e862b5436d9e",
                                "sense_id": "300ab72f-e797-34b2-ad39-9ec96a1186d1",
                                "text": "[…] trillions of bacteria, each equally an individual, which are found in a person’s gut, his mouth, his scalp, his skin and all of the crevices and orifices that subtend from his body’s surface."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f13c21f-00c4-3221-b23e-16a4d8a60763",
                        "entry_id": "9e8c7432-6fb8-343c-b5c7-c013ac9d5caa",
                        "glosses": [
                            "To form the central angle of a circle underneath an arc."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "948b996a-7a21-4473-bee8-53a80f7fa8c6",
                                "sense_id": "3f13c21f-00c4-3221-b23e-16a4d8a60763",
                                "text": "The points A and B on the circumference form the arc AB, which subtends the central angle θ."
                            }
                        ]
                    },
