                            {
                                "target_word": "réalisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd6760d-6f6e-37f2-a06a-d9445904bc18",
                                        "entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                                        "glosses": [
                                            "Celui qui réalise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2bf529f-386a-465b-b1cd-acb7afe8803a",
                                                "sense_id": "0cd6760d-6f6e-37f2-a06a-d9445904bc18",
                                                "text": "Ce n’est pas seulement un imaginatif, c’est un réalisateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759747e3-f541-3d14-a068-147ed0ca5467",
                                        "entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                                        "glosses": [
                                            "Personne responsable de la réalisation d’un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c6a288-492c-4333-acbf-60510fa3aab7",
                                                "sense_id": "759747e3-f541-3d14-a068-147ed0ca5467",
                                                "text": "A Marchand, le réalisateur reprochera de « ribouler » quand il joue la colère. En pleine projection de rushes, sa voix s'élève, pour lancer à l'acteur sur l'écran : « Arrête de ribouler des yeux! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
