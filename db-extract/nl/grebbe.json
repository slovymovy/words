                        ],
                        "examples": [
                            {
                                "example_id": "c1850c7c-d033-4383-af21-d7517babdab9",
                                "sense_id": "1c68edd9-f2b8-3d58-a3c9-b7f0f4f1461c",
                                "text": "⧖ Verbrijzelt, decimeert, verkracht,\nWerpt bommen uit den duisteren nacht,\nDuikt, torpedeert, scheurt, spietst en slacht,\nLaat weg en weide, grebbe' en gracht\nVan wond- en lijklucht stinken; (…)"
                            },
                            {
                                "example_id": "1642b7bf-2f1b-4437-87dc-e0eaf3b687d2",
                                "sense_id": "1c68edd9-f2b8-3d58-a3c9-b7f0f4f1461c",
                                "text": "⧖ Zij zag toen, dat ze in een hoog, ruim mastenbosch zat, aan den rand van een opgedroogde grebbe, die het in slingeringen doorsneed."
                            }
                        ]
