                                "target_lang_word": "воспалять",
                                "target_lang_sense_clarification": "медицинский термин, воспалительная реакция"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "reizen",
                                "target_lang_sense_clarification": "Haut, Augen, Schleimhäute"
                            },
                            {
                                "target_lang_word": "entzünden",
                                "target_lang_sense_clarification": "Fachsprache, Wunden, Gewebe"
