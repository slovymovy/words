                        "entry_id": "ed5b4996-3ac3-3eeb-ad65-c74a8f05ae30",
                        "glosses": [
                            "библейск. истор. библейский персонаж, сын Исаака и Ревекки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "217c4786-080f-4590-b93c-d43d9f7445bd",
                                "sense_id": "6f44d7a1-7f87-3a13-817b-0cc5553bdb95",
                                "text": "Врываются они во владения Эдома, и Эдо́м не впускает их ибо знает, чем грозит прикосновение Израиля."
                            }
