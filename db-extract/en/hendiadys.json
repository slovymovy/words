                "senses": [
                    {
                        "sense_id": "84fb1bbb-a102-31ff-bc03-e77b61fdd70e",
                        "entry_id": "885bd11e-e380-3b52-810c-f1b78f540fce",
                        "glosses": [
                            "A figure of speech used for emphasis, where two words joined by and are used to express a single complex idea."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "1d532103-b2a5-490c-9358-ef94d51dd5c4",
                                "sense_id": "84fb1bbb-a102-31ff-bc03-e77b61fdd70e",
                                "text": "Some examples of hendiadys comprise two words in the bound state; others, two words in appositional hendiadys. It would seem that certain cases of appositional hendiadys are closely related to wordpairs (see WORD-PAIRS, BREAK-UP), though which way the development proceeded is far from certain."
                            },
                            {
                                "example_id": "32638878-33b1-464f-a801-044c3675130f",
                                "sense_id": "84fb1bbb-a102-31ff-bc03-e77b61fdd70e",
                                "text": "Each illustrates a different facet of verbal hendiadys in English."
                            }
                        ]
                    }
                ],
