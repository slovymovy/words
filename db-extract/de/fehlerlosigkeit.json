                        "form": "der Fehlerlosigkeit"
                    },
                    {
                        "form_id": "64ede688-238c-47f6-bc5a-4388d7f46483",
                        "entry_id": "71a80952-b896-3b0d-ac93-1ad25ce6543d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Fehlerlosigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                        "entry_id": "71a80952-b896-3b0d-ac93-1ad25ce6543d",
                        "glosses": [
                            "Eigenschaft, Zustand, keine Schwächen oder Mängel zu haben, also vollkommen zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e59480-bbab-43a4-892c-15a8d48df117",
                                "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                                "text": "„Chelsea ist kein Team, das durch Brillanz entnervt, sondern durch Fehlerlosigkeit.“"
                            },
                            {
                                "example_id": "8a38574f-e9ae-41d9-b7ff-d04a00d4cf62",
                                "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                                "text": "„Fehlerlosigkeit, gar Vollständigkeit mag dabei ein Ideal bleiben, das sich nur annäherungsweise erreichen läßt; Flüchtigkeits- oder Übertragungsfehler dürften sich nie ganz vermeiden lassen.“"
                            },
                            {
                                "example_id": "18ce515b-53c6-4632-86dc-6372f74c872e",
                                "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                                "text": "„‚Menschen mit Ecken und Kanten und all ihren Schwächen‘ Christian Wulff sagte, von Leistungssportlern und vor allem Torhütern werde Fehlerlosigkeit verlangt und ein erheblicher Leistungsdruck.“"
                            },
                            {
                                "example_id": "c63e955c-4875-49fa-a243-2a87977e099a",
                                "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                                "text": "„Dass Fehlerlosigkeit nicht vor Kritik schütze, sei ihnen nicht bewusst.“"
                            },
                            {
                                "example_id": "ec94572e-b138-4d11-8a49-81053d04853a",
                                "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                                "text": "„Sie preisen seine Fehlerlosigkeit unter großem Druck und erinnern an den zweiten WM-Kampf gegen Michael Schumacher 2006.“"
                            },
                            {
                                "example_id": "0619d40c-0f0a-4beb-8519-ed1c2873d498",
                                "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                                "text": "„Brendel selbst hat zur Frage der Fehlerlosigkeit einmal im Gespräch mit Martin Meyer eingeräumt: „Ich war nie der perfekteste Interpret.“"
                            },
                            {
                                "example_id": "51473eae-143b-4687-8fd8-6eeaf3e33d9e",
                                "sense_id": "8cc399e4-537b-3ddc-b3ad-b5f667164f7a",
                                "text": "„Während wir uns der eigenen Fehler bewusst sind, sehen wir nur die angebliche Fehlerlosigkeit der anderen im Virtuellen und zweifeln an uns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
