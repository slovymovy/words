                                                "sense_id": "048faf19-3ee6-3997-a877-94f484a496ec",
                                                "text": "Beim Zerreiben riecht die Melisse zitronenartig und wird daher auch Zitronenmelisse genannt."
                                            },
                                            {
                                                "example_id": "fb7d86ea-9bf7-4da8-af27-9ba63ccd3e8e",
                                                "sense_id": "048faf19-3ee6-3997-a877-94f484a496ec",
                                                "text": "Die Blätter der Melisse sind ein erfrischendes Gewürzkraut für Salate."
                                            },
