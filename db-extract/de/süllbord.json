                "senses": [
                    {
                        "sense_id": "6970720e-97b9-3eeb-b844-6c85adb9e247",
                        "entry_id": "bd11cc62-278f-38f8-bf00-90098cdd3602",
                        "glosses": [
                            "Einfassung (äußere Abgrenzung) bei Öffnungen an Deck von Booten oder Schiffen, die zum Schutz gegen eindringendes Wasser dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8adc1ad4-9add-44f5-ab5f-f0da88d599f1",
                                "sense_id": "6970720e-97b9-3eeb-b844-6c85adb9e247",
                                "text": "„Das Gefährt tanzte wild, als sie es ins Wasser setzten, als würde der See danach greifen. Wellen schwappten bis zu den Süllbords des Cockpits, doch es war für raues Wasser konstruiert, und die Gepäckfächer waren dicht.“"
                            },
                            {
                                "example_id": "fe344c35-3eeb-4858-8f31-66b202846fad",
                                "sense_id": "6970720e-97b9-3eeb-b844-6c85adb9e247",
                                "text": "„Als die Feier zu Ende ging, stand ich wieder brav an der Gangway und reichte den schaukelnden Gästen die Hand beim Übersteigen des Süllbords.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
