                "senses": [
                    {
                        "sense_id": "96a0e8fc-1bc8-3b7c-8599-88722d4b4306",
                        "entry_id": "a67230df-f7d0-3ac9-b51b-48542f61161a",
                        "glosses": [
                            "Reaktion der Verteidigung, wenn man Gewalt oder Einwirkungen anderer ausgesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181977b9-218d-408e-a357-4fe9ba01ad4f",
                                "sense_id": "96a0e8fc-1bc8-3b7c-8599-88722d4b4306",
                                "text": "Ich konnte und wollte nicht akzeptieren, dass sie aufgab, dass sie sich ihrem Schicksal ohne Gegenwehr fügte."
                            },
                            {
                                "example_id": "5c77abfa-bf9f-4c70-ad76-1b12bc1d893b",
                                "sense_id": "96a0e8fc-1bc8-3b7c-8599-88722d4b4306",
                                "text": "Alle Spuren der Gegenwehr können bei der Ermittlung des Verbrechens helfen."
                            },
                            {
                                "example_id": "371e9928-9046-4686-a68f-ab4cb19f1008",
                                "sense_id": "96a0e8fc-1bc8-3b7c-8599-88722d4b4306",
                                "text": "„Die Älteste litt darunter, von den Jüngeren vexiert und geschädigt zu werden, während diese sich durch derartige kleine Gegenwehren von ihrer mütterlich-autoritären Übermacht distanzierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
