                        "sense_id": "03735079-2585-3057-87f9-d374bd5e847e",
                        "entry_id": "c274833f-e9b5-3e1c-89ce-66fb24907cce",
                        "glosses": [
                            "legacy hunter"
                        ],
                        "tags": [
