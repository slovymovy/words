                "forms": [
                    {
                        "form_id": "39bc9596-9a27-433b-9429-aef2a965acb6",
                        "entry_id": "91cd8930-d59c-3f02-9ac0-3be2690c76c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "radicules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2a5bec1-8a84-3124-8bb0-9d9e45a2b7a3",
                        "entry_id": "91cd8930-d59c-3f02-9ac0-3be2690c76c9",
                        "glosses": [
                            "Rudiment de la racine, dans un germe qui se développe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c1dd757-7d50-4759-becb-7b61658e7eb4",
                                "sense_id": "a2a5bec1-8a84-3124-8bb0-9d9e45a2b7a3",
                                "text": "Et en quelques jours seulement, l’enveloppe du gland se fissure sous la poussée de la plantule et de la radicule. Ces deux organes détectent vite la direction à prendre. La radicule est la première racine de Quercus. Celle qui lui permettra de s’ancrer dans le sol nourricier."
                            },
                            {
                                "example_id": "09474bbc-48f8-4269-8604-93ef84820496",
                                "sense_id": "a2a5bec1-8a84-3124-8bb0-9d9e45a2b7a3",
                                "text": "Après quelques semaines de stratification, les graines donnent naissance à une radicule (la première racine) et une tigelle (la future tige)."
                            },
                            {
                                "example_id": "fb5dfbf0-0b0e-44f1-88a6-b8911553bdb6",
                                "sense_id": "a2a5bec1-8a84-3124-8bb0-9d9e45a2b7a3",
                                "text": "Des carottes bio, avec des radicules comme des poils."
                            }
                        ]
                    }
                ],
