    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1e0f5b44-a9f3-3d42-9e8a-017d4f816c92",
                "word": "Tantalus",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "342e0a64-8d2a-3dd2-878b-8d2d67087cae",
                        "entry_id": "1e0f5b44-a9f3-3d42-9e8a-017d4f816c92",
                        "glosses": [
                            "A Phrygian king who was condemned to remain in Tartarus, chin-deep in water, with fruit-laden branches hanging above his head; whenever he tried to drink or eat, the water and fruit receded out of reach."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "4a1b3e46-970d-46eb-85ba-6e4bc0ea179f",
                                "sense_id": "342e0a64-8d2a-3dd2-878b-8d2d67087cae",
                                "text": "He will not mannage her, although he mount her, / That worse then Tantalus is her annoy"
                            },
                            {
                                "example_id": "142bd114-a5b3-4c7c-b57f-6e663079a600",
                                "sense_id": "342e0a64-8d2a-3dd2-878b-8d2d67087cae",
                                "text": "But like still pining Tantalus he sits / And vselesse barnes the haruest of his wits"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96ceb023-65e2-45d2-b96e-56028457c9ad",
                        "source_entry_id": "1e0f5b44-a9f3-3d42-9e8a-017d4f816c92",
                        "source_sense_id": "342e0a64-8d2a-3dd2-878b-8d2d67087cae",
                        "source_sense_description": "condemned Phrygian king",
                        "target_lang_word": "Tantale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tantale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "927c9d04-21ec-38df-96f7-2f63c933dc8e",
                                        "entry_id": "5ae1ad2b-0be2-3060-a814-e77fe08e9011",
                                        "glosses": [
                                            "Mortel, fils de Zeus et de la nymphe Plouto, et roi de Phrygie ou de Lydie, condamné à endurer éternellement la faim et la soif."
                                        ],
                                        "tags": [
                                            "Mythologie grecque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "641aa7a1-16ee-4d57-8591-f227fed5419b",
                                                "sense_id": "927c9d04-21ec-38df-96f7-2f63c933dc8e",
                                                "text": "« Tu penses bien, dit-il, que je ne déploie pas cette monnaie pour irriter et titiller tes convoitises à la mode de Tantale."
                                            },
                                            {
                                                "example_id": "cd714765-d5b1-4fbd-80e5-5c22ee529ffe",
                                                "sense_id": "927c9d04-21ec-38df-96f7-2f63c933dc8e",
                                                "text": "Il racontait tout en mangeant, désolé de ne pouvoir savourer davantage, jetant des regards tristes aux mets exquis que notre curiosité l’obligeait ainsi à saboter. Mme de Loynes compensait ce Tantale par toutes sortes de gentilles petites attentions et de gâteries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
