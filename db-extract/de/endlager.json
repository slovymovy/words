                        "sense_id": "38f377eb-b677-3528-aff6-c61c1b842108",
                        "entry_id": "61376121-b8ae-390e-a556-021062d06fcb",
                        "glosses": [
                            "Ort, an dem sehr schädliche Abfälle dauerhaft gelagert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0236566-ff51-464c-a649-76cfb75870b0",
                                "sense_id": "38f377eb-b677-3528-aff6-c61c1b842108",
                                "text": "Die Debatte um ein Endlager für radioaktiven Müll ist noch nicht abgeschlossen."
                            },
                            {
                                "example_id": "b7b3c85f-0fae-4337-a9bd-64ea43f9e632",
                                "sense_id": "38f377eb-b677-3528-aff6-c61c1b842108",
                                "text": "Geologen halten einen Salzstock für einen guten Ort für ein Endlager."
                            },
                            {
                                "example_id": "9bcfcb88-ee1e-4b2f-8fae-e7eb805ec939",
                                "sense_id": "38f377eb-b677-3528-aff6-c61c1b842108",
                                "text": "Das Bundesverwaltungsgericht in Leipzig beendete heute einen jahrelangen Rechtsstreit um die Zulässigkeit einer Klage gegen die Errichtung eines Endlagers für radioaktive Abfälle im „Schacht Konrad“ bei Salzgitter."
                            }
