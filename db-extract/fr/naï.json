                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c184d7-c447-4bd5-a203-ff4e1adedf86",
                                "sense_id": "7d1fd999-b87b-3d7c-be95-2fdc7545e3af",
                                "text": "Aujourd’hui, vous allez (re)découvrir une flûte de Pan originaire d’Europe de l’Est, et plus précisément de Roumanie : le naï roumain."
                            },
                            {
                                "example_id": "3504b76f-ac3a-4d30-ac9d-22f51078dd57",
                                "sense_id": "7d1fd999-b87b-3d7c-be95-2fdc7545e3af",
                                "text": "Plus tard, elle fut communément appelée “muscal” et encore plus tard seulement, “naï”. L’origine orientale de ces deux noms, “nay” en persan, arabe et turc signifient “roseau”."
                            }
                        ]
