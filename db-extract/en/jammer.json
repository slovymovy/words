    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4286d98d-d44e-3be6-ba56-4783429935fa",
                "word": "Jammer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "33e81b69-8b06-4b32-b419-fa5a1bd81536",
                        "entry_id": "4286d98d-d44e-3be6-ba56-4783429935fa",
                        "tags": [
                            "plural"
                        ],
                        "form": "Jammers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c786a0e-ffdc-3ea2-bc20-7ce34e26e90d",
                        "entry_id": "4286d98d-d44e-3be6-ba56-4783429935fa",
                        "glosses": [
                            "A player of the massively multiplayer online game Animal Jam (now either the app so named, formerly Animal Jam – Play Wild!, or the desktop game renamed Animal Jam Classic)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16557a2b-292b-4a16-b3d3-4525c382afff",
                                "sense_id": "8c786a0e-ffdc-3ea2-bc20-7ce34e26e90d",
                                "text": "A growing percentage of \"Jammers\" are visiting from international territories, and global growth of the Animal Jam property will be a strong focus for Smart Bomb Interactive in 2013."
                            },
                            {
                                "example_id": "54b75662-249e-4ffb-9ba9-6d493e8dfc72",
                                "sense_id": "8c786a0e-ffdc-3ea2-bc20-7ce34e26e90d",
                                "text": "So come meet over 16 million Animal Jam players, or Jammers. […] Liza appears throughout this book to share her advice and tips with all Jammers."
                            },
                            {
                                "example_id": "c276454f-5c5f-4fa7-b2a7-c10deee38dba",
                                "sense_id": "8c786a0e-ffdc-3ea2-bc20-7ce34e26e90d",
                                "text": "This Is Animal Jam, which has recently hit magazine racks across the country, is filled with insider tips, a Jammer name generator, games and puzzles and fun facts about the natural world."
                            },
                            {
                                "example_id": "4ff4bb63-52b5-41af-82db-1b1e4bfb8836",
                                "sense_id": "8c786a0e-ffdc-3ea2-bc20-7ce34e26e90d",
                                "text": "Only as an actual adult did I realize how bizarre one particular user-created facet of the game was: an obsession with “adopting” other Jammers, or being “adopted” oneself. […] It’s a little disconcerting to ponder how much of my happy online childhood was spent hanging out virtually with people who were old enough to own Hondas and go on PornHub^([sic]) on purpose (and definitely people old enough to be active on Reddit), but I loved being a Jammer."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "a89493a4-6c3a-4149-957f-e89cd003b371",
                        "source_entry_id": "4286d98d-d44e-3be6-ba56-4783429935fa",
