                        "examples": [
                            {
                                "example_id": "593cbce1-0009-405b-a858-060cbe188fb9",
                                "sense_id": "9dc18155-21d3-3d6c-915a-30f516ea448e",
                                "text": "Als hij buiten speelde, werd hij naar binnen geroepen door het gelui van een bel."
                            },
                            {
                                "example_id": "a99f6c03-7742-4d90-ab8c-bf9fa8073f55",
                                "sense_id": "9dc18155-21d3-3d6c-915a-30f516ea448e",
                                "text": "Ze konden niet tegen het gelui van de klokken."
                            }
                        ]
                    },
