                    {
                        "translation_id": "fad48b98-6c82-4e8f-928f-2a8741f15081",
                        "source_entry_id": "cd2f4083-bdb8-3dec-a9a1-2496050def5c",
                        "source_sense_id": "6b431dd3-be42-3fcb-9a4f-fdd8c54f3534",
                        "source_sense_description": "im Bergbau eingesetzte, tragbare Lampe",
                        "target_lang_word": "lampe de mineur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lampe de mineur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48baec58-cf75-3e82-bd05-7abea80fb553",
                                        "entry_id": "559d3c99-6bde-341a-afcc-d66dd5b355da",
                                        "glosses": [
                                            "Ustensile pouvant être posé, transporté manuellement ou suspendu et permettant l’éclairage dans une mine."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e656247e-d3d7-4e31-84f9-803a76da2226",
                                                "sense_id": "48baec58-cf75-3e82-bd05-7abea80fb553",
                                                "text": "Accompagné de l’un des nombreux guides qui se trouvent à l’entrée de la caverne, pour diriger les touristes, et muni d’une lampe de mineur, notre voyageur descendit d’abord soixante marches."
                                            },
                                            {
                                                "example_id": "59078fe4-c78e-45ed-85b8-3f96effe4f9c",
                                                "sense_id": "48baec58-cf75-3e82-bd05-7abea80fb553",
                                                "text": "Un lointain classicisme le guide, lampe de mineur qu’il porte sur la nuque comme pour déséclairer le chemin tout fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2f2e07-7f67-3181-9a1e-821040e14297",
                                        "entry_id": "559d3c99-6bde-341a-afcc-d66dd5b355da",
                                        "glosses": [
                                            "Meuble représentant l’ustensile du même nom dans les armoiries. On la dit allumée quand la flamme est d'un autre émail. À rapprocher de falot, fanal, flambeau, lampe et torche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fff1793-e74f-4499-9d71-d948ded0c6a2",
                                                "sense_id": "8a2f2e07-7f67-3181-9a1e-821040e14297",
                                                "text": "D’argent à deux bandes de gueules, à la lampe de mineur de sable, allumée de gueules, brochant en barre, qui est de la commune de Petite-Rosselle de Moselle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
