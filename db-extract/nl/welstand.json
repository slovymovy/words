                                                "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                                "text": "Near-synonym: thriving"
                                            },
                                            {
                                                "example_id": "3d281ed2-658e-4d33-89ed-37980f85246b",
                                                "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                                "text": "“Eating meat means prosperity in the coming year,” the roastery wrote on Weibo on February 5, days before the Lunar New Year began."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6c78cad-8832-4652-9dff-c94dbda1c851",
                        "source_entry_id": "500b81be-abce-31d7-aab8-9be6c252c24e",
                        "source_sense_id": "36c4b221-09d9-394e-916d-da640e347ec1",
                        "source_sense_description": "het overvloed aan geld, land, grondstoffen, bezittingen en/of eigenschappen",
                        "target_lang_word": "success",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "success",
                                "target_lang_code": "en",
                                "target_senses": [
