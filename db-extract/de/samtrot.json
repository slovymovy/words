                "senses": [
                    {
                        "sense_id": "05e8f193-85d0-3ac1-9c05-4d58c93f2e54",
                        "entry_id": "0265bc11-2f26-397a-98dc-a17f86d07eee",
                        "glosses": [
                            "eine heute eher seltene, ertragsarme, rote Rebsorte, die durch zwei Mutationen vom Schwarzriesling (in Frankreich Pinot Meunier genannt) aus entstanden ist und sich den Charakteristiken der Herkunftsrebe des Schwarzrieslings, dem Pinot Noir (in Deutschland blauer Spätburgunder) wieder sehr stark angenähert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67e01357-56ba-48d6-9408-8b05055b9a80",
                                "sense_id": "05e8f193-85d0-3ac1-9c05-4d58c93f2e54",
                                "text": "Phänologisch stellt der Samtrot eine Rückmutation des Schwarzrieslings zum Pinot Noir dar und wird dementsprechend auch in Deutschland als Pinot-Noir-Klon klassifiziert."
                            },
                            {
                                "example_id": "98822514-9f9b-4b35-88c9-12a93736942b",
                                "sense_id": "05e8f193-85d0-3ac1-9c05-4d58c93f2e54",
                                "text": "\"Die Sorte Samtrot wird vorwiegend in Württemberg angebaut […] Sie entstand als natürliche Mutation aus dem Schwarzriesling.\""
                            },
                            {
                                "example_id": "8c5cda1b-69eb-44fc-a398-eb491172e675",
                                "sense_id": "05e8f193-85d0-3ac1-9c05-4d58c93f2e54",
                                "text": "Samtrot wird von vielen Weinkennern als ein klassischer Frauenwein charakterisiert."
                            },
                            {
                                "example_id": "54298aae-845d-4343-8534-c10066695873",
                                "sense_id": "05e8f193-85d0-3ac1-9c05-4d58c93f2e54",
                                "text": "Ein Samtrot passt ideal zu Linsengerichten, schwäbischer Küche und würzig belegten Pizzen."
                            },
                            {
                                "example_id": "bc2caaa1-103f-42a3-99b6-11b2a575f77c",
                                "sense_id": "05e8f193-85d0-3ac1-9c05-4d58c93f2e54",
                                "text": "Samtrot, eine Mutation aus Schwarzriesling, wird in Württemberg auf ca. 90 Hektar angebaut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
