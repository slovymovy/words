                "senses": [
                    {
                        "sense_id": "8a0c6cae-1977-3111-8df4-1bb655685f6a",
                        "entry_id": "da04ad33-54e3-3b57-8f69-ef9b88a46f66",
                        "glosses": [
                            "een werpspel dat gespeeld wordt met drie darts (pijltjes) en een dartbord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98482b98-7b87-45d2-88e1-4a989a758167",
                                "sense_id": "8a0c6cae-1977-3111-8df4-1bb655685f6a",
                                "text": "Ik moest overal opdraven. Bij de supporters, bij de biljartvereniging en bij de vogelpik. En ik zei overal ja tegen. Achteraf gezien had ik toen een manager moeten hebben, die nee had gezegd.'"
                            },
                            {
                                "example_id": "09fb1702-ca81-4654-9810-5683a21dee52",
                                "sense_id": "8a0c6cae-1977-3111-8df4-1bb655685f6a",
                                "text": "Burnetts capaciteit om afsluitende doubles te gooien, bleek te groot. Van Barneveld gaf toe dat hij vooral op dat laatste gesneuveld was. 'Maar ik kom terug', verzekerde hij zijn Britse gastheren. In 1993 was hij nog niet verder gekomen dan de laatste zestien.Het wereldkampioenschap darts, pijltjes gooien, of vogelpik, zoals de Vlamingen het plastischer uitdrukken, wordt al jaren per traditie gehouden in The Lakeside Country Club in Frimley Green, op een vuurpijl afstand van Windsor Castle."
                            }
                        ]
                    }
