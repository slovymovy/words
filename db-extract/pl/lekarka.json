                "senses": [
                    {
                        "sense_id": "a61d0ab1-862b-327b-bd7a-9ddff155ad18",
                        "entry_id": "7bf15c46-013b-31ba-91c7-110fbf3c2fbd",
                        "glosses": [
                            "kobieta pracująca jako lekarz"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bc84bd83-f720-4386-a991-b0ea3b9f8903",
                                "sense_id": "a61d0ab1-862b-327b-bd7a-9ddff155ad18",
                                "text": "Widziałem naszą lekarkę najpierw w kościele, a potem późnym wieczorem wychodzącą z plebanii, gdzie zamówiła mszę za swą chorą matkę."
                            },
                            {
                                "example_id": "2f8b84f0-191a-4dab-8e56-551882fa3cac",
                                "sense_id": "a61d0ab1-862b-327b-bd7a-9ddff155ad18",
                                "text": "Podobno w Polsce brakuje lekarek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "690d74d3-f346-4223-94b2-94ef8cb3fb95",
                        "source_entry_id": "7bf15c46-013b-31ba-91c7-110fbf3c2fbd",
