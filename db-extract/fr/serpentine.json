                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4e8b5e97-77d2-3929-9bd5-6746fd913fd9",
                        "entry_id": "90755cb9-1d4b-3a14-91f0-52a0b6493033",
                        "glosses": [
