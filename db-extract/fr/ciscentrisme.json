                "senses": [
                    {
                        "sense_id": "73d42782-d0a1-3515-9646-fa8bf64950c5",
                        "entry_id": "0e8f77e2-ca16-371b-a25b-5bcb835e4cd5",
                        "glosses": [
                            "Système de comportements, de représentations et de discriminations favorisant les personnes cisgenres, en dépit des personnes trans."
                        ],
                        "tags": [
                            "Transféminisme"
                        ],
                        "examples": [
                            {
                                "example_id": "e7d04568-0137-496f-8f42-ff3142c1d146",
                                "sense_id": "73d42782-d0a1-3515-9646-fa8bf64950c5",
                                "text": "L’emploi d’une formulation épicène permet d’éviter toute discrimination, y compris celle commise involontairement en raison d’une mécompréhension ou d’une méconnaissance des phénomènes de l’androcentrisme et du ciscentrisme."
                            },
                            {
                                "example_id": "dfe44cb9-c4ca-45cd-99cb-602b22707175",
                                "sense_id": "73d42782-d0a1-3515-9646-fa8bf64950c5",
                                "text": "Certaines remarques ne sont pas portées par des intentions transphobes, mais relèvent tout de même du ciscentrisme."
                            }
                        ]
                    }
                ],
