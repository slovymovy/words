                        "form": "den Stiefbruder"
                    },
                    {
                        "form_id": "1119a6bb-8388-40ba-b22c-4de5b34fb542",
                        "entry_id": "a339cdb7-d2a6-39f4-abfd-99dd6a9bc316",
                        "tags": [
                            "accusative",
