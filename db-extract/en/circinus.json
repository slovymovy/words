                "senses": [
                    {
                        "sense_id": "8a5dbe62-c330-370c-ab35-d5e1423f20c0",
                        "entry_id": "b0aace8f-9c3c-31ce-ae47-543297446a77",
                        "glosses": [
                            "A small constellation of the southern winter sky, said to resemble a compass. It lies between the constellations of Centaurus and Triangulum Australe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c1f3c32-4284-4e6b-b49b-ca31c6580b26",
                        "source_entry_id": "b0aace8f-9c3c-31ce-ae47-543297446a77",
                        "source_sense_id": "8a5dbe62-c330-370c-ab35-d5e1423f20c0",
                        "source_sense_description": "a small constellation of the southern winter sky",
                        "target_lang_word": "Compas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Compas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0061095a-5b9e-3e4c-a207-0a0bf1dd9c59",
                                        "entry_id": "788b40c2-f534-3718-bc1e-09fe2ab088b9",
                                        "glosses": [
                                            "Constellation du ciel austral, bordée par le Loup, le Centaure, la Mouche, l’Oiseau de paradis, le Triangle austral et la Règle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12159229-f3db-4f48-af5e-9f6030102588",
                                                "sense_id": "0061095a-5b9e-3e4c-a207-0a0bf1dd9c59",
                                                "text": "Voici donc ces nouvelles constellations suivant l’ordre des ascensions droites, & telles que M. de la Caille les rapporte dans les Mémoires de 1752 […] X. Le Compas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7476fb41-9049-41d0-82e6-260c8688d672",
                        "source_entry_id": "b0aace8f-9c3c-31ce-ae47-543297446a77",
                        "source_sense_id": "8a5dbe62-c330-370c-ab35-d5e1423f20c0",
                        "source_sense_description": "a small constellation of the southern winter sky",
                        "target_lang_word": "Zirkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zirkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cbef448-08bc-3829-8445-47f467da7873",
                                        "entry_id": "cb3d732f-f99b-340e-bb45-0071ac0180e4",
                                        "glosses": [
                                            "Gerät zum Zeichnen von Kreisen"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e96f41a-0dbc-4de0-99f3-8ce1718e8406",
                                                "sense_id": "8cbef448-08bc-3829-8445-47f467da7873",
                                                "text": "In der antiken Geometrie waren Zirkel und Lineal geradezu heilige Gegenstände."
                                            },
                                            {
                                                "example_id": "b315fedc-87cd-41a5-ba35-b373aa5c3c82",
                                                "sense_id": "8cbef448-08bc-3829-8445-47f467da7873",
                                                "text": "„Der Haupteingang der British Library liegt nicht direkt an der Straße, sondern in einem Innenhof, in dem eine riesige Statue von Isaac Newton steht, der über einen Zirkel gebeugt dasitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f88ce53-68e2-3ef1-b66b-f829424dd51a",
                                        "entry_id": "cb3d732f-f99b-340e-bb45-0071ac0180e4",
                                        "glosses": [
                                            "feste, aber nicht als Verein organisierte Gruppe"
                                        ],
                                        "tags": [
                                            "Gesellschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc431031-7c5c-4ad5-b741-fb7556a9c278",
                                                "sense_id": "2f88ce53-68e2-3ef1-b66b-f829424dd51a",
                                                "text": "In dem Café traf sich regelmäßig ein Zirkel von Literaten."
                                            },
                                            {
                                                "example_id": "a62d1d29-fd92-408a-9ad2-f435dcd0e64a",
                                                "sense_id": "2f88ce53-68e2-3ef1-b66b-f829424dd51a",
                                                "text": "„Denn das Casino war eben nicht nur ein Zirkel gebildeter Bürgerlichkeit, ein Kommunikationskreis, in dem über Lessing und Moses Mendelssohn gesprochen wurde, es war auch ein Machtzentrum.“"
                                            },
                                            {
                                                "example_id": "117b1cd1-89ec-4d78-ac8a-fa0db4aa6926",
                                                "sense_id": "2f88ce53-68e2-3ef1-b66b-f829424dd51a",
                                                "text": "„In dem Salon der in der Behrenstraße wohnenden Frau von Carayon und ihrer Tochter Victoire waren an ihrem gewöhnlichen Empfangsabend einige Freunde versammelt, aber freilich wenige nur, da die große Hitze des Tages auch die treuesten Anhänger des Zirkels ins Freie gelockt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2e6e628e-6a58-3891-bcf8-146a4c8c3af1",
                                        "entry_id": "cb3d732f-f99b-340e-bb45-0071ac0180e4",
                                        "glosses": [
                                            "Schlussfolgerung, bei der das Erschlossene vorausgesetzt wird"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3990488-a49c-4318-b262-4060fc9347ef",
                                                "sense_id": "2e6e628e-6a58-3891-bcf8-146a4c8c3af1",
                                                "text": "Diese Schlussfolgerung ist ein Zirkel!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
