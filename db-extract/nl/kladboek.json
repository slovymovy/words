                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c717c21a-252a-42f5-aee6-3a8737be0e7b",
                                "sense_id": "5b51ba83-14d3-3952-90e6-a56c9ca9a56e",
                                "text": "Ik krijg nog geld van je, want je staat nog steeds in mijn kladboek."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef9c6d6f-8171-3ed0-a111-424aefe80f28",
                        "entry_id": "a85bdb73-d2c8-3375-b9a2-9c4ed5240400",
                        "glosses": [
                            "een werkboek waarin ontwerpen gemaakt worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e8713d-4b28-43cd-90f1-06deaabd729d",
                                "sense_id": "ef9c6d6f-8171-3ed0-a111-424aefe80f28",
                                "text": "Hij maakte al jaren tekeningen en ontwerpen in zijn kladboekje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5462cc82-7c1b-4142-91ec-a50e02f7fb3f",
                        "source_entry_id": "a85bdb73-d2c8-3375-b9a2-9c4ed5240400",
                        "target_lang_word": "Kladde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kladde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "985a7891-0c13-3bbe-b7cd-8438b5f50710",
                                        "entry_id": "79573169-0df9-3942-ae42-e751e22ce3c6",
                                        "glosses": [
                                            "Heft für Entwürfe, erste Niederschriften, Hausaufgaben, Notizen oder dergleichen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec936c6b-eaab-4b49-ad4b-0f3640f00bc4",
                                                "sense_id": "985a7891-0c13-3bbe-b7cd-8438b5f50710",
                                                "text": "„Die Klagen und Anfragen, die auf diesem Amtswege vorgebracht wurden, sind säuberlich in Kladden festgehalten.“"
                                            },
                                            {
                                                "example_id": "13beedec-f6ef-4832-b3b3-3e1e35dd520d",
                                                "sense_id": "985a7891-0c13-3bbe-b7cd-8438b5f50710",
                                                "text": "„Wiederum werden Papiere ausgefüllt und abgestempelt, wird das Fahrzeugkennzeichen in einer dicken Kladde handschriftlich vermerkt.“"
                                            },
                                            {
                                                "example_id": "77e04373-d822-49e7-9877-b3077992b5bb",
                                                "sense_id": "985a7891-0c13-3bbe-b7cd-8438b5f50710",
                                                "text": "„Papa schaute sich die Kladden genauer an, und wir entdeckten, dass es Mamas Haushaltsbücher waren.“"
                                            },
                                            {
                                                "example_id": "10579216-4a0d-4cae-a281-ab3f24083cf9",
                                                "sense_id": "985a7891-0c13-3bbe-b7cd-8438b5f50710",
                                                "text": "„Der Vorsitzende klappte mit einem dumpfen Ton seine Kladde mit den Notizen zu.“"
                                            },
                                            {
                                                "example_id": "9fab7358-4776-4042-b621-9cfb0b4985d7",
                                                "sense_id": "985a7891-0c13-3bbe-b7cd-8438b5f50710",
                                                "text": "„Die Kladde war auf alt gemacht mit künstlich gequältem Papier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9e52462-1764-347f-87ff-1b2301f9e88e",
                                        "entry_id": "79573169-0df9-3942-ae42-e751e22ce3c6",
                                        "glosses": [
                                            "Buch für (vorläufige, tägliche) geschäftliche Vermerke und Notizen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b61435-45ec-4412-9ff9-6f1581869870",
                                                "sense_id": "b9e52462-1764-347f-87ff-1b2301f9e88e",
                                                "text": "„Im späten 17. Jahrhundert wird in Frankreich, im frühen 18. Jahrhundert auch in Deutschland die komplette Zerlegung des Memorial in eine Reihe von Kladden – etwa Wareneingangs- und -ausgangsbuch, Kassen- und Notizbuch – propagiert.“"
                                            },
                                            {
                                                "example_id": "6f9e5c19-a2a0-4bac-9b67-67a2606784f5",
                                                "sense_id": "b9e52462-1764-347f-87ff-1b2301f9e88e",
                                                "text": "Die Kaufleute schrieben früher die täglichen Geschäftsvorfälle in chronologischer Ordnung in eine Kladde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7283a40e-e1a5-3b56-b48f-e32ba8bef633",
                                        "entry_id": "79573169-0df9-3942-ae42-e751e22ce3c6",
                                        "glosses": [
                                            "vorläufiger Entwurf, erste Niederschrift"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c908b381-df2f-4a85-9a80-04f9d05fcb4f",
                                                "sense_id": "7283a40e-e1a5-3b56-b48f-e32ba8bef633",
                                                "text": "„Dass eine Kladde oder ein Entwurf vorgelegen haben muss, scheint von der Bemerkung »Nonnulla desunt« (lat., ‚einiges fehlt‘) im ersten Teil des Briefes bestätigt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
