                {
                    "sense_id": "1fb9a3a4-c75c-3200-84e9-b52378f10bfd",
                    "sense_definition": "The lowest side of a triangle or other polygon, or the lowest face of a cone, pyramid or other polyhedron laid flat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "math_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To calculate the area of a triangle, you need to know its <w>base</w> and height.",
                            "target_lang_translations": {
                                "ru": "Чтобы вычислить площадь треугольника, нужно знать его <w>основание</w> и высоту.",
                                "tr": "Bir üçgenin alanını hesaplamak için <w>tabanını</w> ve yüksekliğini bilmeniz gerekir.",
                                "zh": "要计算三角形的面积，你需要知道它的<w>底</w>和高。"
                            }
                        },
                        {
                            "text": "The <w>base</w> of the pyramid is a perfect square.",
                            "target_lang_translations": {
                                "ru": "<w>Основание</w> пирамиды представляет собой идеальный квадрат.",
                                "tr": "Piramidin <w>tabanı</w> mükemmel bir karedir.",
                                "zh": "金字塔的<w>底</w>是一个完美的正方形。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "base and height",
                        "length of the base"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "geometry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя сторона многоугольника или грань многогранника.",
                        "tr": "Bir üçgenin veya çokgenin en alt kenarı ya da bir piramit veya koninin oturduğu alt yüzey.",
                        "zh": "多边形的最下边，或锥体、棱锥体等平放时的底面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "геометрия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "taban",
                                "target_lang_sense_clarification": "geometride alt kenar veya yüzey"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "底",
                                "target_lang_sense_clarification": "几何图形的底边或底面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88293dee-91d3-3e70-8526-6db4774ebec5",
                    "sense_definition": "The starting point of a logical deduction or thought; basis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foundation_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This theory has no scientific <w>base</w> and should be ignored.",
                            "target_lang_translations": {
                                "ru": "Эта теория не имеет научной <w>основы</w> и ее следует игнорировать.",
                                "tr": "Bu teorinin hiçbir bilimsel <w>dayanağı</w> yoktur ve göz ardı edilmelidir.",
                                "zh": "这个理论没有科学<w>基础</w>，应该被忽略。"
                            }
                        },
                        {
                            "text": "We need a solid <w>base</w> of evidence before we can proceed.",
                            "target_lang_translations": {
                                "ru": "Нам нужна прочная доказательная <w>база</w>, прежде чем мы сможем продолжить.",
                                "tr": "Devam edebilmemiz için sağlam bir kanıt <w>temeline</w> ihtiyacımız var.",
                                "zh": "在继续之前，我们需要坚实的证据<w>基础</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "radix"
                    ],
                    "common_phrases": [
                        "base for",
                        "knowledge base",
                        "customer base"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправная точка логического вывода или мысли; основа.",
                        "tr": "Bir mantıksal çıkarımın veya düşüncenin başlangıç noktası; temel.",
                        "zh": "逻辑推论或思想的出发点；基础。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "суть, начало"
                            },
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "данных, знаний"
                            },
                            {
                                "target_lang_word": "фундамент",
                                "target_lang_sense_clarification": "перен. прочная основа"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "bir şeyin dayandığı esas"
                            },
                            {
                                "target_lang_word": "dayanak",
                                "target_lang_sense_clarification": "destek, kanıt"
                            },
                            {
                                "target_lang_word": "esas",
                                "target_lang_sense_clarification": "ana öge, öz"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基础",
                                "target_lang_sense_clarification": "事物的根基"
                            },
                            {
                                "target_lang_word": "根据",
                                "target_lang_sense_clarification": "论据或理由"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "357e0f5b-cbc3-330d-906e-84c808728126",
                    "sense_definition": "Any of a class of generally water-soluble compounds that turn red litmus blue and react with acids to form salts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ammonia is a common weak <w>base</w> used in cleaning products.",
                            "target_lang_translations": {
                                "ru": "Аммиак — это распространенное слабое <w>основание</w>, используемое в чистящих средствах.",
                                "tr": "Amonyak, temizlik ürünlerinde kullanılan yaygın bir zayıf <w>bazdır</w>.",
                                "zh": "氨是一种常用于清洁产品的弱<w>碱</w>。"
                            }
                        },
                        {
                            "text": "In this reaction, the acid neutralizes the <w>base</w> to produce water and salt.",
                            "target_lang_translations": {
                                "ru": "В этой реакции кислота нейтрализует <w>основание</w>, образуя воду и соль.",
                                "tr": "Bu tepkimede asit, <w>bazi</w> nötralize ederek su ve tuz oluşturur.",
                                "zh": "在这个反应中，酸中和了<w>碱</w>以生成水和盐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alkali"
                    ],
                    "antonyms": [
                        "acid"
                    ],
                    "common_phrases": [
                        "acid and base",
                        "weak base",
                        "strong base"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Класс соединений, реагирующих с кислотами с образованием солей.",
                        "tr": "Genellikle suda çözünen, kırmızı turnusol kağıdını maviye çeviren ve asitlerle tepkimeye girerek tuz oluşturan bileşikler sınıfı.",
                        "zh": "一类通常可溶于水、能使红色石蕊试纸变蓝并与酸反应生成盐的化合物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "химия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "baz",
                                "target_lang_sense_clarification": "kimya"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碱",
                                "target_lang_sense_clarification": "化学术语"
                            }
                        ]
                    }
