            "pos": "noun",
            "senses": [
                {
                    "sense_id": "710d4bf7-7e04-3345-aad9-e0ad26604bd5",
                    "sense_definition": "Place ou espace dégagé qui s'étend devant la façade principale d'une église ou d'une cathédrale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_architectural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les touristes se rassemblent souvent sur le <w>parvis</w> de la cathédrale pour prendre des photos."
                        },
                        {
                            "text": "Après la cérémonie, les invités ont attendu les mariés sur le <w>parvis</w> ensoleillé."
                        }
                    ],
                    "synonyms": [
                        "esplanade",
                        "place"
                    ],
                    "common_phrases": [
                        "parvis de l'église",
                        "parvis de la cathédrale",
                        "parvis Notre-Dame"
                    ]
                },
                {
                    "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                    "sense_definition": "Vaste espace piétonnier ou esplanade aménagée devant l'entrée d'un édifice public moderne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_architectural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous sommes donné rendez-vous directement sur le <w>parvis</w> de la gare à midi."
                        },
                        {
                            "text": "Une grande foule manifestait pacifiquement sur le <w>parvis</w> de l'hôtel de ville."
                        }
                    ],
                    "synonyms": [
                        "esplanade",
                        "place"
                    ],
                    "common_phrases": [
                        "parvis de la gare",
                        "parvis de la mairie",
                        "parvis du musée"
                    ]
                },
                {
                    "sense_id": "e7cb1c21-ba15-36fd-b5ac-903308542c26",
                    "sense_definition": "Chacune des cours ouvertes entourant le Tabernacle ou le Temple de Jérusalem dans l'Antiquité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seuls les fidèles autorisés pouvaient accéder au premier <w>parvis</w> du temple lors des fêtes."
                        },
                        {
                            "text": "Les prêtres préparaient les offrandes dans le <w>parvis</w> intérieur selon les textes anciens."
                        }
                    ],
                    "synonyms": [
                        "enceinte",
                        "cour"
                    ],
                    "common_phrases": [
                        "parvis du temple",
                        "parvis des gentils"
                    ]
                },
                {
                    "sense_id": "040d4fe7-df6c-3975-8e27-78699f017c48",
                    "sense_definition": "Enceinte sacrée, vestibule d'un sanctuaire ou, métaphoriquement, le séjour céleste.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète contemplait les <w>parvis</w> célestes au crépuscule en quête d'inspiration."
                        },
                        {
                            "text": "Ils franchirent silencieusement les mystérieux <w>parvis</w> du sanctuaire oublié des hommes."
                        }
                    ],
                    "synonyms": [
                        "vestibule",
                        "enceinte",
                        "séjour"
                    ],
                    "common_phrases": [
                        "célestes parvis"
                    ]
                }
            ]
        }
    ]
