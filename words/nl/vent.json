                    "sense_definition": "de gebiedende wijs van <w>venten</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vent</w> je spullen ergens anders, want hier is het verboden.",
                            "target_lang_translations": {
                                "en": "<w>Peddle</w> your stuff somewhere else, because it is forbidden here.",
                                "ru": "<w>Торгуй</w> своими вещами в другом месте, потому что здесь это запрещено."
                            }
                        },
                        {
                            "text": "Nee, ik <w>vent</w> niet meer, ik sta nu liever op de markt.",
                            "target_lang_translations": {
                                "en": "No, I don't <w>hawk</w> goods anymore; I prefer standing at the market now.",
                                "ru": "Нет, я больше не <w>торгую вразнос</w>, теперь я предпочитаю стоять на рынке."
                            }
                        }
