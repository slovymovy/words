                        "sense_id": "8127ef3e-5cb9-3e6e-9468-92c48f0137d1",
                        "entry_id": "c6b9e5ec-5037-3b43-8ab9-2a42cd05b276",
                        "glosses": [
                            "Personne qui lit beaucoup de livres."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "39d0df7e-08fa-49ce-bbcb-ca2b9341cba3",
                                "sense_id": "8127ef3e-5cb9-3e6e-9468-92c48f0137d1",
                                "text": "Plus loin on trouvait le bureau surchargé de Daniel Vernet, papivore insatiable, qui communiquait avec la rédaction en chef, et le secrétariat de rédaction, lieu stratégique du final cut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c47bf9e-31ef-4554-aba7-34d296469d3e",
                        "source_entry_id": "c6b9e5ec-5037-3b43-8ab9-2a42cd05b276",
