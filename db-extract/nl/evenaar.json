                    {
                        "translation_id": "1d4ce43c-19af-4f38-b206-173b74c41fe3",
                        "source_entry_id": "0fd2678b-637a-30ed-92c2-760b2da7ac4d",
                        "source_sense_id": "617e5de1-405b-35ab-8b53-c7bc0efa398d",
                        "source_sense_description": "denkbeeldige cirkel die op een hemellichaam het noordelijk van het zuidelijk halfrond scheidt",
                        "target_lang_word": "équateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "équateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d042bb7-6f8c-3c5a-9ea1-3f68058a1233",
                                        "entry_id": "017f3fc0-b693-3ac4-ac5d-15e7f52e4630",
                                        "glosses": [
                                            "Ligne imaginaire tracée autour d’un astre, en particulier de la Terre, à mi-chemin des pôles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c63d58-d885-4630-91a4-14011ed4b26f",
                                                "sense_id": "2d042bb7-6f8c-3c5a-9ea1-3f68058a1233",
                                                "text": "Sur l'ellipsoïde terrestre, l'équateur est le seul parallèle à être orthogonal aux méridiens."
                                            },
                                            {
                                                "example_id": "244f8e63-76f9-4515-826d-186c0a67aa9f",
                                                "sense_id": "2d042bb7-6f8c-3c5a-9ea1-3f68058a1233",
                                                "text": "Au midi, les Anglais et les Hollandais refoulent chaque jour davantage vers l’équateur les peuples de la Caffrerie."
                                            },
                                            {
                                                "example_id": "4e7eea2f-2804-453e-aef1-8ca94af363a5",
                                                "sense_id": "2d042bb7-6f8c-3c5a-9ea1-3f68058a1233",
                                                "text": "Le temps était calme et le navire dériva vers l’Équateur, sans que l’équipage se souciât de son sort."
                                            },
                                            {
                                                "example_id": "07f4dbfb-2791-4e3b-8846-d730fd18fc4b",
                                                "sense_id": "2d042bb7-6f8c-3c5a-9ea1-3f68058a1233",
                                                "text": "Le terme «soudanien» désigne couramment un milieu climatique et végétal de l’Afrique intertropicale. Se rapportant plus habituellement au nord de l’Équateur, il comporte cependant un homologue dans l'hémisphère sud, dénommé «zambézien»."
                                            },
                                            {
                                                "example_id": "ad993869-556e-4138-b47a-b2c42b9e028b",
                                                "sense_id": "2d042bb7-6f8c-3c5a-9ea1-3f68058a1233",
                                                "text": "Jupiter est entourée par une énorme magnétosphère qui dévie les particules chargées du vent solaire. […]. Le plasma piégé est concentré dans une nappe de plasma en forme de disque aligné sur l’équateur de la planète."
                                            },
                                            {
                                                "example_id": "62c3e2db-04e4-415f-8de0-b3fba1fef7b2",
                                                "sense_id": "2d042bb7-6f8c-3c5a-9ea1-3f68058a1233",
                                                "text": "Le plan de l’équateur terrestre, prolongé indéfiniment dans l’espace, constitue l’équateur céleste, que le soleil traverse deux fois dans l’année, aux temps des équinoxes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a55aac0e-f62f-30ba-856c-327e6684851f",
                                        "entry_id": "017f3fc0-b693-3ac4-ac5d-15e7f52e4630",
                                        "glosses": [
                                            "Section de l'ellipsoïde de référence par le plan passant par le centre et perpendiculaire à l'axe de l'ellipsoïde."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
