                        "examples": [
                            {
                                "example_id": "9f9f485e-7b77-40df-857b-1b022f65e860",
                                "sense_id": "1500367b-1fe9-327e-9d26-4f45ac40b34d",
                                "text": "In de regio Paraná, waar de gevangenis ligt, gebeuren dit soort acties vaker. Vorig maand was er nog een gevangenenopstand die 24 uur duurde."
                            },
                            {
                                "example_id": "74431047-e823-4c8e-8837-1ec3bf8c6ab1",
                                "sense_id": "1500367b-1fe9-327e-9d26-4f45ac40b34d",
                                "text": "De onderzoekers noemen de vondst belangrijk voor het onderzoek naar de Holocaust. Na een gevangenenopstand in oktober 1943 sloten de Duitsers het kamp en sloopten ze de gebouwen, om de sporen van hun misdaad uit te wissen. Daarna groeide er een bos overheen."
                            },
                            {
                                "example_id": "fefe003a-b97d-4f07-8ab5-ca862c4fcdfd",
                                "sense_id": "1500367b-1fe9-327e-9d26-4f45ac40b34d",
                                "text": "De gevangenenopstand begon vorige week. De militairen vonden in de gevangenis tientallen wapens, granaten en 45 kilo cocaïne. Drie militairen en een onbekend aantal gevangenen zijn al omgekomen."
                            }
                        ]
                    }
