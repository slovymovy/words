                        "entry_id": "dab04bb8-cf6f-3d9e-8665-55bf9b1d21bd",
                        "glosses": [
                            "A cone-shaped structure built from sediment and other available materials by ants or white ants (termites), and beneath which the colony nests."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6c699b-88a6-4bf3-9bbc-584dccbe0463",
                                "sense_id": "6e0da99e-04cc-3ecf-b225-d6d3ba93c223",
                                "text": "On arrival at Edinburgh Waverley, I fight my way through the throngs of tourists and locals turning the place into a human anthill."
                            }
                        ]
                    }
                ],
