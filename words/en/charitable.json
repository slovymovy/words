{
    "word_family": [
        "charity",
        "charitably",
        "uncharitable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb82aa6a-6a0a-35eb-b889-f8de75eb8439",
                    "sense_definition": "Generous in giving money or help to those in need; kind and lenient in judging others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "generosity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community is known for its <w>charitable</w> giving during the winter holidays.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество известно своими <w>благотворительными</w> пожертвованиями во время зимних праздников."
                            }
                        },
                        {
                            "text": "He made a <w>charitable</w> donation to the hospital to fund the new children's wing.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>благотворительное</w> пожертвование больнице на финансирование нового детского корпуса."
                            }
                        }
                    ],
                    "antonyms": [
                        "selfish",
                        "unkind",
                        "stingy"
                    ],
                    "common_phrases": [
                        "charitable giving",
                        "charitable donation",
                        "charitable act"
                    ],
                    "target_lang_definitions": {
                        "ru": "Щедрый в оказании помощи нуждающимся; проявляющий доброту и снисходительность в суждениях о других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милосердный",
                                "target_lang_sense_clarification": "проявляющий сострадание и доброту"
                            },
                            {
                                "target_lang_word": "щедрый",
                                "target_lang_sense_clarification": "готовый бескорыстно помогать деньгами"
                            },
                            {
                                "target_lang_word": "снисходительный",
                                "target_lang_sense_clarification": "мягкий в оценке поступков других"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5daf6008-3b5e-3dda-9b94-1d2aff6529a1",
                    "sense_definition": "Relating to or being an organization set up to provide help and raise money for those in need.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum is a <w>charitable</w> institution that relies heavily on public support.",
                            "target_lang_translations": {
                                "ru": "Музей является <w>благотворительным</w> учреждением, которое в значительной степени полагается на общественную поддержку."
                            }
                        },
                        {
                            "text": "They registered their new foundation as a <w>charitable</w> organization to receive tax benefits.",
                            "target_lang_translations": {
                                "ru": "Они зарегистрировали свой новый фонд как <w>благотворительную</w> организацию, чтобы получить налоговые льготы."
                            }
                        }
                    ],
                    "synonyms": [
                        "eleemosynary"
                    ],
                    "antonyms": [
                        "profit-making",
                        "commercial"
                    ],
                    "common_phrases": [
                        "charitable organization",
                        "charitable institution",
                        "charitable status",
                        "charitable trust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к организации, созданной для оказания помощи и сбора средств для нуждающихся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотворительный",
                                "target_lang_sense_clarification": "связанный с оказанием безвозмездной помощи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}