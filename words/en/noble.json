{
    "word_family": [
        "nobility",
        "nobly",
        "ennoble",
        "ignoble"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa0dadbe-1cac-3968-816d-db57cf7585d3",
                    "sense_definition": "Having honorable qualities; having moral eminence and freedom from anything petty, mean, or dubious in conduct and character.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "moral_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>noble</w> effort to help the community despite his own problems.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>благородную</w> попытку помочь обществу, несмотря на свои собственные проблемы.",
                                "zh": "尽管他自己也有困难，他还是为帮助社区作出了<w>高尚</w>的努力。"
                            }
                        },
                        {
                            "text": "Fighting for peace is a <w>noble</w> cause that requires great dedication.",
                            "target_lang_translations": {
                                "ru": "Борьба за мир — это <w>благородное</w> дело, требующее огромной самоотдачи.",
                                "zh": "为和平而奋斗是一项<w>崇高</w>的事业，需要极大的奉献精神。"
                            }
                        }
                    ],
                    "synonyms": [
                        "honorable"
                    ],
                    "antonyms": [
                        "despicable",
                        "ignoble",
                        "mean",
                        "vile"
                    ],
                    "common_phrases": [
                        "noble cause",
                        "noble deed",
                        "noble character",
                        "noble gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий высокими нравственными качествами; честный, великодушный.",
                        "zh": "具有可敬的品质；品德高尚，不卑鄙、不狭隘、行为正直。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "высоконравственный"
                            },
                            {
                                "target_lang_word": "великодушный",
                                "target_lang_sense_clarification": "проявляющий душевную щедрость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高尚",
                                "target_lang_sense_clarification": "指品德高尚、行为正直"
                            },
                            {
                                "target_lang_word": "崇高",
                                "target_lang_sense_clarification": "指理想、事业等值得敬重"
                            },
                            {
                                "target_lang_word": "高贵",
                                "target_lang_sense_clarification": "侧重胸怀宽广、品行可敬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dd52a6c-d603-3b14-8e8e-6dbf8cc0fe8a",
                    "sense_definition": "Of exalted rank; of or relating to the nobility; distinguished from the masses by birth, station, or title.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "social_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She comes from a <w>noble</w> family that has served the crown for centuries.",
                            "target_lang_translations": {
                                "ru": "Она происходит из <w>знатной</w> семьи, которая служила короне веками.",
                                "zh": "她出身于一个为王室效力了数百年的<w>贵族</w>家庭。"
                            }
                        },
                        {
                            "text": "Only people of <w>noble</w> birth were allowed to attend the royal ceremony.",
                            "target_lang_translations": {
                                "ru": "Только людям <w>благородного</w> происхождения разрешалось присутствовать на королевской церемонии.",
                                "zh": "只有出身<w>贵族</w>的人才被允许参加皇家仪式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "superior"
                    ],
                    "antonyms": [
                        "inferior",
                        "plebeian"
                    ],
                    "common_phrases": [
                        "noble birth",
                        "noble family",
                        "noble blood",
                        "noble rank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий к знати или высшему сословию; отличающийся высоким происхождением.",
                        "zh": "指地位尊贵的；属于贵族的；因出身、身份或爵位而高于平民的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знатный",
                                "target_lang_sense_clarification": "высокого происхождения"
                            },
                            {
                                "target_lang_word": "дворянский",
                                "target_lang_sense_clarification": "относящийся к дворянству"
                            },
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "о происхождении (устар./форм.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贵族",
                                "target_lang_sense_clarification": "指出身于贵族阶层"
                            },
                            {
                                "target_lang_word": "高贵",
                                "target_lang_sense_clarification": "书面语，指门第显赫"
                            },
                            {
                                "target_lang_word": "显贵",
                                "target_lang_sense_clarification": "强调身份、血统或爵位上的显贵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "677dd678-19da-3496-bf83-f63b01fc872d",
                    "sense_definition": "Grand; stately; magnificent; splendid.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "grandeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral is a <w>noble</w> edifice that dominates the city skyline.",
                            "target_lang_translations": {
                                "ru": "Собор — это <w>величественное</w> здание, возвышающееся над городским горизонтом.",
                                "zh": "这座大教堂是一座<w>宏伟</w>的建筑，高耸于城市天际线之上。"
                            }
                        },
                        {
                            "text": "We stood in silence, admiring the <w>noble</w> mountains in the distance.",
                            "target_lang_translations": {
                                "ru": "Мы стояли молча, любуясь <w>величественными</w> горами вдалеке.",
                                "zh": "我们静静地站着，欣赏远处<w>雄伟</w>的群山。"
                            }
                        }
                    ],
                    "synonyms": [
                        "great"
                    ],
                    "common_phrases": [
                        "noble sight",
                        "noble building",
                        "noble appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грандиозный; величественный; великолепный.",
                        "zh": "宏大而庄严的；雄伟的；壮丽的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "величественный",
                                "target_lang_sense_clarification": "производящий сильное впечатление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏伟",
                                "target_lang_sense_clarification": "形容建筑、景色等壮丽庄严"
                            },
                            {
                                "target_lang_word": "雄伟",
                                "target_lang_sense_clarification": "形容气势庄重不凡"
                            },
                            {
                                "target_lang_word": "庄严",
                                "target_lang_sense_clarification": "较书面，指外观庄严壮观"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f09e141-c4ba-3ef9-80f3-8ea0c2651ff9",
                    "sense_definition": "Of an element, unreactive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Helium is known as a <w>noble</w> gas because it rarely reacts with other elements.",
                            "target_lang_translations": {
                                "ru": "Гелий известен как <w>благородный</w> газ, потому что он редко вступает в реакцию с другими элементами.",
                                "zh": "氦被称为<w>惰性</w>气体，因为它很少与其他元素发生反应。"
                            }
                        },
                        {
                            "text": "Gold is a <w>noble</w> metal that does not rust or tarnish easily.",
                            "target_lang_translations": {
                                "ru": "Золото — это <w>благородный</w> металл, который не ржавеет и не тускнеет.",
                                "zh": "金是一种<w>贵</w>金属，不容易生锈或失去光泽。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "noble gas",
                        "noble metal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical (chemistry)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Об элементе: инертный, химически малоактивный.",
                        "zh": "指化学元素不活泼、反应性很低的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "химический термин (газ, металл)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惰性",
                                "target_lang_sense_clarification": "化学中常用于 noble gas"
                            },
                            {
                                "target_lang_word": "贵",
                                "target_lang_sense_clarification": "化学术语，常用于 noble metal"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c1b9266-b562-3e2b-a5d5-c7f614557a14",
                    "sense_definition": "An aristocrat; one of aristocratic blood.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king summoned his <w>nobles</w> to discuss the defense of the realm.",
                            "target_lang_translations": {
                                "ru": "Король созвал своих <w>дворян</w>, чтобы обсудить оборону королевства.",
                                "zh": "国王召集了他的<w>贵族</w>们来商议王国的防务。"
                            }
                        },
                        {
                            "text": "Although he was born a <w>noble</w>, he preferred to live a simple life.",
                            "target_lang_translations": {
                                "ru": "Хотя он родился <w>дворянином</w>, он предпочитал жить простой жизнью.",
                                "zh": "虽然他生来是个<w>贵族</w>，却更喜欢过简朴的生活。"
                            }
                        }
                    ],
                    "antonyms": [
                        "commoner",
                        "plebeian"
                    ],
                    "common_phrases": [
                        "council of nobles",
                        "landed noble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аристократ; человек, принадлежащий к дворянскому роду.",
                        "zh": "贵族；有贵族血统的人；贵族阶层中的一员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дворянин",
                                "target_lang_sense_clarification": "представитель дворянства"
                            },
                            {
                                "target_lang_word": "аристократ",
                                "target_lang_sense_clarification": "представитель высшей знати"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贵族",
                                "target_lang_sense_clarification": "最常见，对应有爵位或贵族血统的人"
                            },
                            {
                                "target_lang_word": "贵族成员",
                                "target_lang_sense_clarification": "强调属于上层贵族阶层的人"
                            },
                            {
                                "target_lang_word": "显贵",
                                "target_lang_sense_clarification": "较正式，指上层社会的贵族人物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c454d846-9706-3955-8c18-97992a248902",
                    "sense_definition": "A medieval gold coin of England in the 14th and 15th centuries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum collection includes a rare gold <w>noble</w> from the reign of Edward III.",
                            "target_lang_translations": {
                                "ru": "В коллекции музея есть редкий золотой <w>нобль</w> времен правления Эдуарда III.",
                                "zh": "博物馆的藏品中有一枚爱德华三世统治时期罕见的金币<w>诺布尔</w>。"
                            }
                        },
                        {
                            "text": "Merchants in the Middle Ages often used the <w>noble</w> for large transactions.",
                            "target_lang_translations": {
                                "ru": "Купцы в Средние века часто использовали <w>нобль</w> для крупных сделок.",
                                "zh": "中世纪的商人经常使用<w>诺布尔</w>进行大额交易。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical currency"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средневековая английская золотая монета XIV и XV веков.",
                        "zh": "英国14至15世纪使用的一种中世纪金币。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нобль",
                                "target_lang_sense_clarification": "историческая монета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诺布尔",
                                "target_lang_sense_clarification": "英国中世纪一种金币的音译名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3e124a73-49aa-3363-8c2b-740b71ed81be",
                    "sense_definition": "A surname or a male given name.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Noble</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Нобл</w> примет вас в своем кабинете сейчас.",
                                "zh": "<w>诺布尔</w>先生现在会在办公室见你。"
                            }
                        },
                        {
                            "text": "They decided to name their newborn son <w>Noble</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать своего новорожденного сына <w>Нобл</w>.",
                                "zh": "他们决定给刚出生的儿子取名为<w>诺布尔</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия или мужское имя.",
                        "zh": "一个姓氏或男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нобл",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诺布尔",
                                "target_lang_sense_clarification": "用作姓氏或男性名字的音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11c718b8-392f-3b06-a79e-bd470a6cb036",
                    "sense_definition": "A place name used for various locations in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through the small town of <w>Noble</w> on our road trip.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через маленький городок <w>Нобл</w> во время нашего автопутешествия.",
                                "zh": "我们自驾旅行时开车经过了名叫<w>诺布尔</w>的小镇。"
                            }
                        },
                        {
                            "text": "The map shows that <w>Noble</w> is located in the southern part of the county.",
                            "target_lang_translations": {
                                "ru": "Карта показывает, что <w>Нобл</w> находится в южной части округа.",
                                "zh": "地图显示，<w>诺布尔</w>位于该县的南部。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название населенного пункта, используемое для различных мест в США.",
                        "zh": "美国多个地点使用的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нобл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诺布尔",
                                "target_lang_sense_clarification": "美国若干地名的音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}