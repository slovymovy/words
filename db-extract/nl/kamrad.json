                                                "sense_id": "b9abf714-4480-3e27-8294-35bfc733b279",
                                                "text": "Near-synonyms: (wheel types) cog, cogwheel, gear wheel, gearwheel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ee132e-b2bd-32a6-8f69-3fc9ba9ef837",
                                        "entry_id": "994e5f22-432c-364f-bdfe-30cb451a7b39",
