            "senses": [
                {
                    "sense_id": "115e72a6-f31d-3c25-bc4e-334b2c2c9e3d",
                    "sense_definition": "Mouvement d'ondulation régulier de la surface de la mer provoqué par le vent au large ou persistant après une tempête.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bateau avançait difficilement face à la forte <w>houle</w> qui venait du large."
                        },
                        {
                            "text": "Après la tempête, une longue <w>houle</w> berçait encore doucement les embarcations du port."
                        }
                    ],
                    "synonyms": [
                        "lame",
                        "ondulation"
                    ],
                    "antonyms": [
                        "calme"
                    ],
                    "common_phrases": [
                        "forte houle",
                        "grosse houle",
                        "longue houle"
                    ]
                },
                {
                    "sense_id": "2ec1df8d-8dc2-3f06-8480-1f9f5ba2b7a5",
                    "sense_definition": "Grosse vague ou suite d'ondes puissantes soulevées à la surface de l'eau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit navire montait et descendait au rythme des <w>houles</w> impressionnantes."
                        },
                        {
                            "text": "Une puissante <w>houle</w> a soudainement submergé la digue lors de la marée montante."
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "ressac"
                    ],
                    "common_phrases": [
                        "creux de la houle"
                    ]
                },
                {
                    "sense_id": "31dc2d93-1777-3d65-a536-24198e36af1b",
                    "sense_definition": "Mouvement ondulant, continu et rythmé d'une masse ou d'une foule.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On apercevait au loin la <w>houle</w> des blés dorés agités par la brise d'été."
                        },
                        {
                            "text": "La lente <w>houle</w> de la foule compacte se déplaçait vers la sortie du stade."
                        }
                    ],
                    "synonyms": [
