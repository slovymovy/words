                        "glosses": [
                            "dział medycyny, który bada związek pomiędzy zaburzeniami psychicznymi i somatycznymi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa204325-25f4-461f-9d69-59e9cee20c82",
                                "sense_id": "84d2107a-fc8c-3afd-b458-9beac90bfdcf",
                                "text": "Można mówić o psychosomatyce sensu stricto, rozumianej jako skutku zaburzenia spowodowanego przez przyczyny natury psychicznej w organizmie, które powodują zaistnienie różnych jednostek chorobowych."
                            }
                        ],
