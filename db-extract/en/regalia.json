                        ],
                        "form": "regalias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "018e1265-7065-3c4e-bf95-80a4f8b282a2",
                        "entry_id": "b9133e75-89cd-3743-9510-3894079cdda6",
                        "glosses": [
                            "A kind of large cigar of superior quality."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5bfcc12d-23ab-4314-b824-4b2117a7ebe4",
                                "sense_id": "018e1265-7065-3c4e-bf95-80a4f8b282a2",
                                "text": "I have taken care that there's both brandy and whiskey nicely stowed away in the barrack-room, with plenty of prime regalia cigars[…]"
                            },
                            {
                                "example_id": "9d569c40-47b2-4945-a983-70dc871ff405",
                                "sense_id": "018e1265-7065-3c4e-bf95-80a4f8b282a2",
                                "text": "The quantity of regalias imported into northern ports is comparatively small."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                "word": "regalia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e8f8e333-fc7b-3944-ba6d-2f6161189452",
                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                        "glosses": [
                            "Royal rights, prerogatives and privileges actually enjoyed by any sovereign, regardless of his title (emperor, grand duke etc.)."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7f5c1d41-274c-33f0-b41d-ab9fff7fbe9e",
                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                        "glosses": [
                            "The emblems, symbols, or paraphernalia indicative of royalty or any other sovereign status; such as a crown, orb, sceptre or sword."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1a33d8b8-594b-4592-a026-1421f40a5f10",
                                "sense_id": "7f5c1d41-274c-33f0-b41d-ab9fff7fbe9e",
                                "text": "THE INTHRONIZATION. The King ascended the Theatre, accompanied by the two Bishops his Supporters, the Great Officers of State, the Lords carrying the Swords, and the Lords who had borne Their Majesties' Regalia, and was Inthroned by the Archbishops, Bishops, and the other Peers, who then stood about the steps of the Throne."
                            }
                        ]
                    },
                    {
                        "sense_id": "f38f8527-c1b5-3bb6-b9f0-5a809c665dc6",
                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                        "glosses": [
                            "Decorations or insignia indicative of an office or membership of an order or society; such as freemasonry."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2bc43a43-a11d-3cd4-802f-f6ec6252d6a1",
                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                        "glosses": [
                            "Traditional dress and accessories of North American Indigenous nations worn for ritual purposes."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5514d8a5-89a1-3653-b9bd-a4ead235d463",
                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                        "glosses": [
                            "Finery, magnificent dress, or lavish or flashy costume."
                        ],
                        "tags": [
                            "broadly",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "8957ec1a-ed4c-4008-8ff2-86ca1b2599a7",
                                "sense_id": "5514d8a5-89a1-3653-b9bd-a4ead235d463",
                                "text": "to be dressed in full regalia (dressed up)"
                            },
                            {
                                "example_id": "05d664c0-692e-483d-917d-6ae3c80e0d17",
                                "sense_id": "5514d8a5-89a1-3653-b9bd-a4ead235d463",
                                "text": "[…] the throngs included tribes of American Indians celebrating […] like victorious conventioneers in their burnished regalia at a hotel party Monday night."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bdfb211-e9f2-3cb4-9172-811e4e020b50",
                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                        "glosses": [
                            "Sumptuous food."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "f4f83090-4f6d-47ee-b45a-ee48bff4477c",
                                "sense_id": "9bdfb211-e9f2-3cb4-9172-811e4e020b50",
                                "text": "c. 1685-1686, Charles Cotton, the Essays of M. de Montaigne\nAfter having a long time treated their Prisoners very well, and given them all the Regalia's they can think of, he to whom the Prisoner belongs, invites a great Assembly of his Kindred and Friends"
                            }
                        ]
                    }
                ],
