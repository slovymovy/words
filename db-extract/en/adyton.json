                "senses": [
                    {
                        "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                        "entry_id": "c8acfd32-d067-373f-b1e6-96d8820a103d",
                        "glosses": [
                            "Synonym of adytum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d02d26a-79e9-4bcc-9391-cd10cda91d31",
                                "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                                "text": "The temple had no opisthodomos as usually understood, but this name was given at Didyma to the west wall of the adyton. The adyton floor was covered with a pavement in later centuries, but in the third century B.C. a grove of bay trees, it appears, grew in the adyton (and this is probably true of the archaic Didymeion)."
                            },
                            {
                                "example_id": "7aebee48-ad21-4d94-8091-fd93b55beffe",
                                "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                                "text": "1998 [Routledge], Rodney Castleden, Atlantis Destroyed, 2001, Taylor & Francis (Routledge), Paperback, page 101,\nHere too is the only adyton so far discovered at Akrotiri. There are four in the temple at Knossos, and because the Akrotiri adyton is embellished with frescoes illuminating its use it is a crucial example, throwing light on the way the four adyta at Knossos were used."
                            },
                            {
                                "example_id": "06cbf5ae-1357-4ce2-86e5-ad5222abaa53",
                                "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                                "text": "Others with similar elaborate adytons are at Qasr Neba and Sfira in Lebanon."
                            }
                        ]
                    }
                ],
