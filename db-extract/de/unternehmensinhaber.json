                "senses": [
                    {
                        "sense_id": "e1c8a26c-19ff-3488-98a2-4c985807a9ab",
                        "entry_id": "b10f9ec3-3ee6-33ff-b94b-b3a208304680",
                        "glosses": [
                            "Person, die eine Firma, einen Betrieb besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae31d24f-8af2-4efe-9b12-1919058888b7",
                                "sense_id": "e1c8a26c-19ff-3488-98a2-4c985807a9ab",
                                "text": "„Dass der Unternehmensinhaber für das Verhalten anderer rechtlich selbstständiger Unternehmen einstehen muss, ist jedoch im weit gefassten Begriff des Beauftragten angelegt.“"
                            },
                            {
                                "example_id": "f46ed3ec-34cd-4d0e-b886-2bdec4202b8a",
                                "sense_id": "e1c8a26c-19ff-3488-98a2-4c985807a9ab",
                                "text": "„Unternehmensinhaber, Führungskräfte und Mitarbeiter werden in sämtlichen Bereichen des Lebens und Wirtschaftens mit der digitalen Themenvielfalt konfrontiert.“"
                            },
                            {
                                "example_id": "e43bfbbf-28ff-4895-b436-8a41a9e10ca3",
                                "sense_id": "e1c8a26c-19ff-3488-98a2-4c985807a9ab",
                                "text": "„Die regelmäßige Wochenendarbeit der Unternehmensinhaber prägt oft auch die Einstellung der Kinder zum Unternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
