                        "entry_id": "39566d2f-aa7b-34c0-9cc2-f72f139ebddc",
                        "glosses": [
                            "The chemical change produced by passing an electric current through a conducting solution or a molten salt."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72c9b4f4-0961-479f-a2a3-42e9fdfe52e6",
                                "sense_id": "b0c43934-ee78-310f-89fd-0eac34232adb",
                                "text": "But current leakage in a Tube tunnel can cause electrolysis to occur in steel retaining walls, which in turn causes them to rust; it could also damage the foundations of nearby buildings."
                            }
                        ]
                    },
