                "senses": [
                    {
                        "sense_id": "e7c3ec5b-1b40-3aaf-8681-4ffd5a76ed21",
                        "entry_id": "3c80f507-6e9b-30e7-b960-bed7822a4e82",
                        "glosses": [
                            "mit Öffnungen versehenes Abdeckblech, durch das Luft strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44521d9e-3d19-4d7c-816d-03a2c73d3748",
                                "sense_id": "e7c3ec5b-1b40-3aaf-8681-4ffd5a76ed21",
                                "text": "„Die Seiten sind mit Lüftungsblechen ausgestattet, Ober- und Unterboden haben je einen Kabelauslaß.“"
                            },
                            {
                                "example_id": "e8a9737a-4a05-47c6-adce-18be3d39b6dc",
                                "sense_id": "e7c3ec5b-1b40-3aaf-8681-4ffd5a76ed21",
                                "text": "„Unten gelangt die kalte Luft durch ein Lüftungsblech von vorne in das Gehäuse hinein, erwärmt sich infolge der Abwärme der Elektronikbauteile, steigt auf und kann über perforierte Deckbleche auf der Rückseite wieder entweichen.“"
                            },
                            {
                                "example_id": "fd4e8c16-7262-412e-be32-d5fac7fc1b14",
                                "sense_id": "e7c3ec5b-1b40-3aaf-8681-4ffd5a76ed21",
                                "text": "„Lüftungsbleche werden vor einen Lüfter gesetzt, der in der Wand sitzt, damit man nicht direkt rein greifen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
