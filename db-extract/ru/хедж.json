                "senses": [
                    {
                        "sense_id": "d8d2d4da-1bcd-3380-8423-d91bb9849a01",
                        "entry_id": "445e2234-a0a2-3ee2-8c67-3e5eba43ed45",
                        "glosses": [
                            "фин. сделка, заключаемая для страхования от возможных финансовых потерь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e8cb89-0a81-4e0d-a881-acf7c0c507e3",
                                "sense_id": "d8d2d4da-1bcd-3380-8423-d91bb9849a01",
                                "text": "Хедж продавца осуществляется тогда, когда хеджер имеет длинную позицию на наличном рынке и открывает короткую позицию на фьючерсном рынке, применяется при необходимости ограничить риски, связанные с возможным снижением цены на товар."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6015c106-9ae2-42b8-a2e3-929a55dd1ec1",
                        "source_entry_id": "445e2234-a0a2-3ee2-8c67-3e5eba43ed45",
                        "source_sense_id": "d8d2d4da-1bcd-3380-8423-d91bb9849a01",
                        "target_lang_word": "hedge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hedge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fab8a5f3-27b7-3543-81e8-50f581428148",
                                        "entry_id": "5219016b-85c2-3066-8649-4981b5a11c30",
                                        "glosses": [
                                            "A thicket of bushes or other shrubbery, especially one planted as a fence between two portions of land, or to separate the parts of a garden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba4e7ba-c435-4312-bc72-d5dfd71eb6b4",
                                                "sense_id": "fab8a5f3-27b7-3543-81e8-50f581428148",
                                                "text": "He trims the hedge once a week."
                                            },
                                            {
                                                "example_id": "4a400eec-5fe7-42cc-a015-a91dbba8e788",
                                                "sense_id": "fab8a5f3-27b7-3543-81e8-50f581428148",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…], and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904c35a6-8796-3654-a82d-a02d8114ac98",
                                        "entry_id": "5219016b-85c2-3066-8649-4981b5a11c30",
                                        "glosses": [
                                            "A barrier (often consisting of a line of persons or objects) to protect someone or something from harm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00180a75-c9ad-49c2-90fb-c6cd98e07069",
                                                "sense_id": "904c35a6-8796-3654-a82d-a02d8114ac98",
                                                "text": "Then Satan answered the Lord, and said, Doth Job fear God for nought? Hast not thou made an hedge about him, and about his house, and about all that he hath on every side? thou hast blessed the work of his hands, and his substance is increased in the land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "813dcb0d-3065-3993-a3fd-c4a44e1e9eff",
                                        "entry_id": "5219016b-85c2-3066-8649-4981b5a11c30",
                                        "glosses": [
                                            "A mound of earth, stone- or turf-faced, often topped with bushes, used as a fence between any two portions of land."
                                        ],
                                        "tags": [
                                            "Cornwall",
                                            "Devon",
                                            "UK",
                                            "West-Country"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a86b91f5-3397-3d4c-b42c-41cd930f4754",
                                        "entry_id": "5219016b-85c2-3066-8649-4981b5a11c30",
                                        "glosses": [
                                            "A noncommittal or intentionally ambiguous statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af70396-bdda-4802-bc38-dc5a34f18e8d",
                                                "sense_id": "a86b91f5-3397-3d4c-b42c-41cd930f4754",
                                                "text": "When not inaccurate, much commentary on the contents of Hobson-Jobson is couched in hedges or relies on speculative estimates in the absence of exact information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000ce934-b03a-392d-b463-0bf48d34802b",
                                        "entry_id": "5219016b-85c2-3066-8649-4981b5a11c30",
                                        "glosses": [
                                            "Contract or arrangement reducing one's exposure to risk (for example the risk of price movements or interest rate movements)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa26a5e3-8efb-4a04-bcfe-9e1aa336ef18",
                                                "sense_id": "000ce934-b03a-392d-b463-0bf48d34802b",
                                                "text": "The asset class acts as a hedge."
                                            },
                                            {
                                                "example_id": "3dc2d0a5-e3ea-425c-9b4c-d86dfb8733ff",
                                                "sense_id": "000ce934-b03a-392d-b463-0bf48d34802b",
                                                "text": "A hedge is an investment position intended to offset potential losses/gains that may be incurred by a companion investment. In simple language, a hedge is used to reduce any substantial losses/gains suffered by an individual or an organization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f01d7d16-c502-3084-a454-4308baec3d99",
                                        "entry_id": "5219016b-85c2-3066-8649-4981b5a11c30",
                                        "glosses": [
                                            "With indication of a person's upbringing, or professional activities, taking place by the side of the road; third-rate, poor, shoddy."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8103c91d-6af2-40e5-bd8d-f9cd49c40f13",
                                                "sense_id": "f01d7d16-c502-3084-a454-4308baec3d99",
                                                "text": "Attalus[…]made him so dead-drunke that insensibly and without feeling he might prostitute his beauty as the body of a common hedge-harlot, to Mulettiers, Groomes and many of the abject servants of his house."
                                            },
                                            {
                                                "example_id": "3b7769b4-ec41-443c-8fca-1a208be271eb",
                                                "sense_id": "f01d7d16-c502-3084-a454-4308baec3d99",
                                                "text": "He then traced them from place to place, till at last he found two of them drinking together, with a third person, at a hedge-tavern near Aldersgate."
                                            },
                                            {
                                                "example_id": "1e002ba0-7415-4d34-b823-b9cdc04da5de",
                                                "sense_id": "f01d7d16-c502-3084-a454-4308baec3d99",
                                                "text": "This particular wheelwright is only a hedge carpenter, without even a shop of his own,[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hedge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb03feb-b781-3f06-82a9-71f8a127f619",
                                        "entry_id": "c507d4f1-0cc0-315e-a826-70592ab23009",
                                        "glosses": [
                                            "To enclose with a hedge or hedges."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00f5aa47-ca61-4f61-9dad-504d14fc1d9b",
                                                "sense_id": "bfb03feb-b781-3f06-82a9-71f8a127f619",
                                                "text": "to hedge a field or garden"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31cd235f-d265-3fb9-8933-0cde3db047f9",
                                        "entry_id": "c507d4f1-0cc0-315e-a826-70592ab23009",
                                        "glosses": [
                                            "To obstruct or surround."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "023e702c-905b-42a6-938f-fcfdd0675736",
                                                "sense_id": "31cd235f-d265-3fb9-8933-0cde3db047f9",
                                                "text": "Therefore, behold, I will hedge up thy way with thorns, and make a wall, that she shall not find her paths."
                                            },
                                            {
                                                "example_id": "ec2cb9a6-41d2-4561-a400-f27e9a83180e",
                                                "sense_id": "31cd235f-d265-3fb9-8933-0cde3db047f9",
                                                "text": "Lollius Urbius […] drew another wall […] to hedge out incursions from the north."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9943edeb-0590-380d-a8b4-9772b96966f7",
                                        "entry_id": "c507d4f1-0cc0-315e-a826-70592ab23009",
                                        "glosses": [
                                            "To offset the risk associated with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a3c3104-e6c2-3060-b599-ecc9b3e33f69",
                                        "entry_id": "c507d4f1-0cc0-315e-a826-70592ab23009",
                                        "glosses": [
                                            "To avoid verbal commitment."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c7d6344-61f2-4295-86d0-1ff55815a3a2",
                                                "sense_id": "9a3c3104-e6c2-3060-b599-ecc9b3e33f69",
                                                "text": "He carefully hedged his statements with weasel words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77459092-1e91-3fed-84c6-5eeb92a04579",
                                        "entry_id": "c507d4f1-0cc0-315e-a826-70592ab23009",
                                        "glosses": [
                                            "To construct or repair a hedge."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
