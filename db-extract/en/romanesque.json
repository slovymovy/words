                                        "entry_id": "9dabd079-8402-3669-bee2-fcc63187e3aa",
                                        "glosses": [
                                            "wywodzący się ze starożytnej kultury rzymskiej lub z nią związany"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6ed470-60a3-4a39-ba7a-acd5ea29b36f",
                                                "sense_id": "6ba961c9-bc91-3eda-9353-0249b50e34f0",
                                                "text": "Do języków romańskich zaliczamy m.in. włoski."
                                            }
