                "senses": [
                    {
                        "sense_id": "94b4f703-8c97-364b-9d31-9625e9ce1085",
                        "entry_id": "d0c8eb0c-1a23-3963-80f6-6eb5a35d65de",
                        "glosses": [
                            "Relatif à la granulométrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1dd00fb-e33d-43c1-8dd2-15ee8c5caeee",
                                "sense_id": "94b4f703-8c97-364b-9d31-9625e9ce1085",
                                "text": "Au cours de ces dernières années, de nombreux modèles nouveaux de tamis pour le classement granulométrique du charbon, sont entrés en service dans l'industrie houillère."
                            },
                            {
                                "example_id": "66c99071-5243-41c5-b8bb-aafde2cbd2a7",
                                "sense_id": "94b4f703-8c97-364b-9d31-9625e9ce1085",
                                "text": "L'essai de granulométrie utilisant le vidéogranulomètre (XP P 18-580) peut se substituer à l'analyse granulométrique par tamisage."
                            },
                            {
                                "example_id": "10956c1b-7125-449b-aed0-3cb1c992ae67",
                                "sense_id": "94b4f703-8c97-364b-9d31-9625e9ce1085",
                                "text": "En fait, le laboratoire réalise une analyse granulométrique après avoir dissout le CaCO₃ par HCl ; il s'agit donc bien d'une décarbonatation artificielle, quasi-instantanée, in vitro, qui simule une décarbonatation pédologique naturelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb3bccc0-7659-3e3c-8789-d0ac8bea42eb",
                        "entry_id": "d0c8eb0c-1a23-3963-80f6-6eb5a35d65de",
                        "glosses": [
                            "Relatif à la granularité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "baff16b7-53a3-4075-8012-6fad98439fbe",
                                "sense_id": "cb3bccc0-7659-3e3c-8789-d0ac8bea42eb",
                                "text": "Les relevés granulométriques montrent une dérive régulière de la granularité"
                            }
                        ]
                    }
