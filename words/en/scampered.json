{
    "word_family": [
        "scamper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ef43b1d-8166-3d6a-962c-ac0c2abbbd30",
                    "sense_definition": "simple past and past participle of <w>scamper</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened mouse <w>scampered</w> across the kitchen floor when it heard the cat.",
                            "target_lang_translations": {
                                "ru": "Испуганная мышь <w>удрала</w> через кухонный пол, когда услышала кошку."
                            }
                        },
                        {
                            "text": "The children <w>scampered</w> into the garden as soon as the rain stopped.",
                            "target_lang_translations": {
                                "ru": "Дети <w>побежали вприпрыжку</w> в сад, как только дождь прекратился."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «бегать вприпрыжку» или «удирать»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удрал",
                                "target_lang_sense_clarification": "быстро убежал, спасаясь или пугаясь"
                            },
                            {
                                "target_lang_word": "побежал вприпрыжку",
                                "target_lang_sense_clarification": "быстро и легко передвигался мелкими шагами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13c95cf9-2dca-3c7f-8f06-ca3b9ff08322",
                    "sense_definition": "Achieved by a quick, hurried movement, often used in sports contexts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman took a <w>scampered</w> single to reach his half-century.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен совершил <w>поспешную</w> перебежку, чтобы достичь полусотни очков."
                            }
                        },
                        {
                            "text": "They managed a <w>scampered</w> run before the fielder could throw the ball.",
                            "target_lang_translations": {
                                "ru": "Они успели совершить <w>быструю</w> перебежку, прежде чем полевой игрок успел бросить мяч."
                            }
                        }
                    ],
                    "synonyms": [
                        "hurried",
                        "rushed"
                    ],
                    "common_phrases": [
                        "scampered single"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенный быстрым, поспешным движением, часто используется в спортивном контексте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поспешный",
                                "target_lang_sense_clarification": "сделанный быстро и суетливо"
                            },
                            {
                                "target_lang_word": "быстрый",
                                "target_lang_sense_clarification": "выполненный в спешке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}