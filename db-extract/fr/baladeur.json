                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "973e0e82-71a5-4df6-9e90-26dde34d1d88",
                                "sense_id": "0a2e2de4-9975-3c04-84a6-b6367e4ed1ad",
                                "text": "Sony est l’inventeur du baladeur appelé « Walkman »."
                            }
                        ]
                    },
                    {
                        "sense_id": "31625fe6-f7fc-3179-8996-90b36dccccb3",
                        "entry_id": "f2a5e21e-d9ae-3b37-8358-979a12b2ebfd",
                        "glosses": [
                            "Rôle court mais qui oblige son interprète à intervenir tout au long d’une pièce de théâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58670507-e97b-4ab0-b5c3-dda636aadd62",
                                "sense_id": "31625fe6-f7fc-3179-8996-90b36dccccb3",
                                "text": "Baladeur : petit rôle de dix lignes étiré sur trois actes."
                            }
                        ]
                    }
