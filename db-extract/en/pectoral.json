                    {
                        "translation_id": "99cccb49-e1e5-436a-a13b-821ab712b161",
                        "source_entry_id": "a53716ec-c62c-313a-ba64-f1ee56688a21",
                        "source_sense_description": "of or pertaining to the breast or chest",
                        "target_lang_word": "pectoral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pectoral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "555eb476-2502-3206-9924-6f04b02dd7be",
                                        "entry_id": "3ca7a523-e5d4-3d76-bbd1-734d59b1ea39",
                                        "glosses": [
                                            "Relatif à la poitrine, aux poumons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec39b4d6-cb50-4e01-a04a-648efc75aedf",
                                                "sense_id": "555eb476-2502-3206-9924-6f04b02dd7be",
                                                "text": "Les mousses, en raison de leur gymnastique particulière, ont aussi les bras et les muscles pectoraux très-gros."
                                            },
                                            {
                                                "example_id": "18de50ed-c7fd-4114-bda9-961101c5a683",
                                                "sense_id": "555eb476-2502-3206-9924-6f04b02dd7be",
                                                "text": "Plus courantes sans doute furent les protections pectorales en cuir, car plus légères et pratiques : le développement de la cavalerie légère imposa un allégement de l’équipement."
                                            },
                                            {
                                                "example_id": "90f9a798-d0e5-433c-94e7-cf29e1396323",
                                                "sense_id": "555eb476-2502-3206-9924-6f04b02dd7be",
                                                "text": "Il lampa au goulot une gorgée de sirop pectoral qui lui donna immédiatement la nausée."
                                            },
                                            {
                                                "example_id": "98df15e7-d66f-4f1c-8414-66ee7df49441",
                                                "sense_id": "555eb476-2502-3206-9924-6f04b02dd7be",
                                                "text": "En attendant, elle achetait de l’aspirine, des pâtes pectorales, des tubes de lanoline, de l’eau de toilette, de la teinture d’iode…"
                                            },
                                            {
                                                "example_id": "16a48c91-ff85-4d8e-aaf8-1bccb52a2cb2",
                                                "sense_id": "555eb476-2502-3206-9924-6f04b02dd7be",
                                                "text": "Ce vin léger est pectoral."
                                            },
                                            {
                                                "example_id": "3687dcd5-c3dd-4aaa-8e1f-8f15ff7ee980",
                                                "sense_id": "555eb476-2502-3206-9924-6f04b02dd7be",
                                                "text": "Croix pectorale, celle que les évêques portent sur la poitrine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pectoral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9068adaf-69ea-3d71-97c7-d6413f41eb5e",
                                        "entry_id": "03722564-587f-3b09-b0b4-a990edbd1396",
                                        "glosses": [
                                            "Ornement garni de pierres précieuses que le grand-prêtre des juifs portait sur la poitrine. Bijou similaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dacc06ce-8e48-4290-bbc5-8ef0cf6ec90d",
                                                "sense_id": "9068adaf-69ea-3d71-97c7-d6413f41eb5e",
                                                "text": "[…] les petits vitraux en losange avaient pris la transparence profonde, l’infrangible dureté de saphirs qui eussent été juxtaposés sur quelque immense pectoral."
                                            },
                                            {
                                                "example_id": "911ad811-5731-4419-bdb9-e7c119b263d4",
                                                "sense_id": "9068adaf-69ea-3d71-97c7-d6413f41eb5e",
                                                "text": "Elle portait un diadème de cauris dans ses cheveux et un collier prolongé d’un pectoral qui irriguait sa poitrine d’une pluie de perles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                                        "entry_id": "03722564-587f-3b09-b0b4-a990edbd1396",
                                        "glosses": [
                                            "Chacun des muscles de la région du thorax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f865ee-cc6b-4678-b43e-b5582d5c7b78",
                                                "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                                                "text": "On y voyait de vastes défilés d’hommes à peu près nus, aux pectoraux bulbeux et le prince égyptien Narkiss, beau garçon vêtu seulement de poudre d’or et d’un cache-sexe."
                                            },
                                            {
                                                "example_id": "53d0b83e-4c79-4182-9e4b-b96b365028dd",
                                                "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                                                "text": "Suivirent des frimeuses téléphonant, des cadres sportifs, des exhibeurs de pectoraux, des enfants aux sourcils froncés d’inquiétude que leurs pères tenaient par la main […]"
                                            },
                                            {
                                                "example_id": "5b784cd5-77f6-4b35-861d-4cd04a7f92c8",
                                                "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                                                "text": "Le grand pectoral, le petit pectoral."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
