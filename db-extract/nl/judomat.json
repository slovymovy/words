                    {
                        "sense_id": "8d967d39-0071-3d94-ae26-78310fab0ac7",
                        "entry_id": "5ef16931-587d-3754-a14b-b4122950ea0b",
                        "glosses": [
                            "een dikke veerkrachtige mat waarop men veilig kan judoën"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a105abe7-defd-4fd1-a9eb-5797e3b71b9c",
                                "sense_id": "8d967d39-0071-3d94-ae26-78310fab0ac7",
                                "text": "Juul Franssen verwacht over een paar maanden haar rentree te maken op de judomat."
                            },
                            {
                                "example_id": "9b880cf2-3581-49c3-8243-30e67cc5f26f",
                                "sense_id": "8d967d39-0071-3d94-ae26-78310fab0ac7",
                                "text": "Judoka Kim Polling komt volgend jaar april niet in actie op de Europese kampioenschappen in Polen. De drievoudig Europees kampioene in de klasse tot 70 kilogram kampt met een slepende elleboogblessure. \"Het beste scenario is dat ik na de rustperiode in maart weer op de judomat sta. De EK komt dan te vroeg\", zegt Polling tegen de NOS."
                            }
                        ]
                    }
                ],
