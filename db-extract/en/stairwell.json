                    {
                        "translation_id": "e5ae444a-06ff-4a2d-bee3-857b1794e99d",
                        "source_entry_id": "5d0b30a2-7140-3f98-9f38-d3f394b82bb8",
                        "source_sense_id": "d53efe56-e415-3084-b385-4713d362e266",
                        "source_sense_description": "a shaft in a multi-story building enclosing a stairway or staircase",
                        "target_lang_word": "Treppenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treppenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                        "entry_id": "a75c84bf-b751-3464-9046-15979abe3e54",
                                        "glosses": [
                                            "Bereich eines Gebäudes mit einer Treppe, die zu anderen Geschossen führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3495c065-8a81-4368-bf4e-d3e1a86c4a01",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "Das Treppenhaus bildet die Verbindung zwischen den Stockwerken eines Gebäudes."
                                            },
                                            {
                                                "example_id": "de9506cb-4464-4d93-8ac4-adb596c74058",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "Das Treppenhaus des Hauses ist mit dem Treppenhaus des anderen Hauses verbunden."
                                            },
                                            {
                                                "example_id": "42a1cdb9-9b1f-4eb6-a81f-ce4f0f0c5129",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "Das Treppenhaus muss einmal pro Woche nass gewischt werden."
                                            },
                                            {
                                                "example_id": "38e9c4d5-0920-401a-b3af-22dc5a56ac40",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "Die Tochter vom Nachbarn knutscht am Wochenende immer im Treppenhaus mit den Jungs rum."
                                            },
                                            {
                                                "example_id": "17dbcdda-4d65-4813-9a98-904017afd76b",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "„Im Treppenhaus roch es bereits nach Braten, und wenn die Etagentür aufgeschlossen war, hörte man das Silber klirren.“"
                                            },
                                            {
                                                "example_id": "9f8645c8-8c9f-4484-bfb0-c6467f6a35da",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "„Ich nickte und verließ die Wohnung, und als ich draußen im Treppenhaus auf der gedrehten Treppe war, atmete ich durch, so erleichtert war ich, mich nicht mehr nach Berliner Art unterhalten zu müssen.“"
                                            },
                                            {
                                                "example_id": "7dd64b71-a0e8-40a9-b8c5-44f846200f1c",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "„Die Kinder wurden oft im Treppenhaus oder in der Kohlenkammer gezeugt, denn in den Wohnungen war kein Platz für ein ruhiges Stelldichein.“"
                                            },
                                            {
                                                "example_id": "92a5d225-df73-4a9c-8a38-812800481a05",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "„In einem sauber gefegten Treppenhaus aus der Zwischenkriegszeit stieg ich auf bräunlich-weißgesprenkelten Terrakottastufen empor.“"
                                            },
                                            {
                                                "example_id": "5cc4d0c2-28cc-4a64-9a6c-abb301a8045b",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "„Besonders von der Eleganz des Foyers und der geschwungenen Treppenhäuser waren die jungen Fotografinnen begeistert.“"
                                            },
                                            {
                                                "example_id": "dbfdab26-0240-4cf7-b4bd-edbb914dcfdf",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "„Olga und Yara treffen sich im Treppenhaus und sprechen noch mal über Frau Moll.“"
                                            },
                                            {
                                                "example_id": "5efc829b-9f06-474e-9f68-07e22709100f",
                                                "sense_id": "9db0b62e-cb0e-3ea9-9d5f-96a765b5ce6d",
                                                "text": "„Dass ein Stadtviertel - wie vor einer Woche - abgesperrt wird und Antiterroreinheiten das Treppenhaus hochstürmen, passiert in Tel Aviv so gut wie nie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
