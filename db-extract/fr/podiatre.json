                        "translation_id": "c9618433-d05b-45b0-b4c7-73b6604758c4",
                        "source_entry_id": "84dab634-1c72-30ed-8e11-0d48a4901d49",
                        "source_sense_id": "54353306-840b-3256-8498-e5b7811412ad",
                        "source_sense_description": "regional (Kanada), Medizin: medizinisch ausgebildeter Fußspezialist, Podologe",
                        "target_lang_word": "Podologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Podologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                        "entry_id": "2f645900-0f99-3ac1-bea2-1f87148e3046",
                                        "glosses": [
                                            "Person, die Fußpflege beruflich betreibt"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5bd3812-389b-4c11-8aa7-df93f4d9b423",
                                                "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                                "text": "„Die medizinische Fußpflege kann dann bei einem zugelassenen Podologen durchgeführt werden.“"
                                            },
                                            {
                                                "example_id": "4a838906-422a-4546-acc7-7789c3a5c030",
                                                "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                                "text": "„Der Podologe schlug mir eine Operation vor, doch konnte er mich nicht überzeugen, dass eine Operation Heilung bringen würde.“"
                                            },
                                            {
                                                "example_id": "7988d427-e9bc-40a7-a50b-42ea1b6fabfb",
                                                "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                                "text": "„Jeder Podologe und jeder FußpflegerIn [sic] muss wissen, wie er verantwortungsvoll mit seinen Kunden umgeht und sie fachgerecht behandelt, ohne Grenzen zu überschreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c76c55db-8894-4858-b271-256418c896aa",
                        "source_entry_id": "84dab634-1c72-30ed-8e11-0d48a4901d49",
                        "source_sense_id": "54353306-840b-3256-8498-e5b7811412ad",
                        "source_sense_description": "regional (Kanada), Medizin: medizinisch ausgebildeter Fußspezialist, Podologe",
                        "target_lang_word": "podiatrist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podiatrist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                        "entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                                        "glosses": [
                                            "A health care practitioner who specializes in the diagnosis and treatment of foot ailments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77fde215-06b9-4fa2-9ef0-06cab4c11e30",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "I visited my podiatrist to get a new pair of orthopedic inserts for my sneakers."
                                            },
                                            {
                                                "example_id": "4ab19f91-f9fd-4589-9fe8-7aa539bca75e",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "Dr. Larry Braunstein, a podiatrist who died in 2007, often told the story of providing Donald Trump with the diagnosis of bone spurs in his heels so he could be exempt from military service, his two daughters – Dr. Elysa Braunstein and Sharon Kessel – told the New York Times."
                                            },
                                            {
                                                "example_id": "6fbd054c-4049-4931-810d-3452887dfe3d",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "To better help you in your quest, we asked multiple podiatrists and seasoned long-distance walkers exactly what to look for when selecting the best walking shoes."
                                            },
                                            {
                                                "example_id": "5252c4e2-a8b1-4523-b432-f2d222599b6d",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "The subcommittee, which is chaired by Ohio Republican Rep. Brad Wenstrup, a podiatrist, will hold a markup session for the report Wednesday before submitting it to the congressional record."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
