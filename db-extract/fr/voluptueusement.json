                "senses": [
                    {
                        "sense_id": "dbb8cb3e-ee9a-356e-a12c-cbdf7c8cd135",
                        "entry_id": "28b040bf-acb6-31cc-8ab7-b0ed835686a8",
                        "glosses": [
                            "Avec volupté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "545e480f-ffb7-44f0-a375-c8b73af44cb4",
                                "sense_id": "dbb8cb3e-ee9a-356e-a12c-cbdf7c8cd135",
                                "text": "Ce sont des hommes lâches… qui ne savent que vivre voluptueusement, sans règle, sans morale,"
                            },
                            {
                                "example_id": "e82bd77a-f652-45c2-b389-7f8ab33f3853",
                                "sense_id": "dbb8cb3e-ee9a-356e-a12c-cbdf7c8cd135",
                                "text": "Il voyait bien qu’il devenait peu à peu, insensiblement, enclin à une moindre activité, mais il s’abandonnait voluptueusement…"
                            },
                            {
                                "example_id": "3d9f2839-e19f-40b6-98a8-638edc9811a2",
                                "sense_id": "dbb8cb3e-ee9a-356e-a12c-cbdf7c8cd135",
                                "text": "Jamais le magnifique paysage et le parc des Aigues n’avaient été plus voluptueusement beaux qu’ils l’étaient alors."
                            }
                        ]
                    }
                ],
