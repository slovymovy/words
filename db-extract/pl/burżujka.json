                "translations": [
                    {
                        "translation_id": "1ed04c85-fbaf-4ed6-8920-85a905b3e953",
                        "source_entry_id": "2031dc19-6461-3cef-8c27-4a7f95249d2c",
                        "source_sense_id": "92c4a30d-f0ab-3ee9-8c2d-e65392db7b25",
                        "target_lang_word": "буржуйка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "буржуйка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bf18e84f-fb98-3d78-a706-d94fc7dfc3a9",
                                        "entry_id": "a8eb9c62-5be1-3521-b8ad-ea18730bfc60",
                                        "glosses": [
                                            "устар., разг. металлическая печь для обогрева помещений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c4ecb5-e263-47c4-a487-2b049eb4fab0",
                                                "sense_id": "bf18e84f-fb98-3d78-a706-d94fc7dfc3a9",
                                                "text": "Печку скоро приобрели ― круглую, невысокую, чугунную колонку, ― из тех, что тогда называли «буржуйками»."
                                            },
                                            {
                                                "example_id": "ac78eb33-8967-464b-9bc7-e4d3453e35dd",
                                                "sense_id": "bf18e84f-fb98-3d78-a706-d94fc7dfc3a9",
                                                "text": "Жестяную «буржуйку» мы топили старыми газетами и быстро доводили её до белого каления. Но она так же стремительно остывала, как и разъярялась."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "буржуйка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "41be97f5-46d0-339c-b026-60a4e97e7d95",
                                        "entry_id": "fc1a7782-6701-3b66-960f-2402392bd2b4",
                                        "glosses": [
                                            "разг. женск. к буржуй"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703c081e-3086-460f-87fc-6d0524b1b465",
                                                "sense_id": "41be97f5-46d0-339c-b026-60a4e97e7d95",
                                                "text": "Буржуем был Лилович с автомобилем, крупчаткой, кольцами колбасы. Но Мишке с Титкой этого не объяснишь. Для них и он буржуй, и Варя буржуйка…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
