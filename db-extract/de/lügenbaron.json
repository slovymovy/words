                "senses": [
                    {
                        "sense_id": "6c75d24a-5489-3d81-b611-337f3457a082",
                        "entry_id": "2f46020a-32ef-3b58-8efd-fca483c4cd4c",
                        "glosses": [
                            "geläufiger Beiname von Hieronimus Carl Friedrich Freiherr von Münchhausen, der im Titel des Buches Wunderbare Reisen zu Wasser und zu Lande, Feldzüge und lustige Abenteuer des Freiherrn von Münchhausen, wie er dieselben bei der Flasche im Zirkel seiner Freunde zu erzählen pflegt (1788) genannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46fe2e0-5ad4-4902-9aaf-a29a3e7dc459",
                                "sense_id": "6c75d24a-5489-3d81-b611-337f3457a082",
                                "text": "„Es ist erst knapp vier Wochen her, das kasperte sich TV-Star Jan-Josef Liefers als Freiherr von Münchhausen durch einen opulenten ARD-Zweiteiler - jetzt ist Ben Becker in der Rolle des legendären Lügenbarons zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0a01eaad-737b-3526-b546-f49fe6cff6ae",
                        "entry_id": "2f46020a-32ef-3b58-8efd-fca483c4cd4c",
                        "glosses": [
                            "Person, die als notorischer Lügner gilt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "f14d0305-4b18-4867-b2e8-666558ca23be",
                                "sense_id": "0a01eaad-737b-3526-b546-f49fe6cff6ae",
                                "text": "„Ich möchte weder als Revanchist noch als Lügenbaron in die Literaturgeschichte eingehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
