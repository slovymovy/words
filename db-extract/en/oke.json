                "senses": [
                    {
                        "sense_id": "88bb5999-1af1-3d87-b8af-8007cb7af497",
                        "entry_id": "d00b76fe-51e2-35c4-8af1-464fec4d8bb7",
                        "glosses": [
                            "Man; guy; bloke."
                        ],
                        "tags": [
                            "South-Africa",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a5aa9901-eef6-4bb5-8d2f-73810f8b0f24",
                                "sense_id": "88bb5999-1af1-3d87-b8af-8007cb7af497",
                                "text": "When that oke talked, I listened."
                            },
                            {
                                "example_id": "d73d35f9-51ce-40bf-b4a8-175f6058cf81",
                                "sense_id": "88bb5999-1af1-3d87-b8af-8007cb7af497",
                                "text": "An oke meets up with his ex-wife at a party. After a few dops, he puts his arm around her and suggests they go to bed. 'Over my dead body,' she snarls at him. He downs his drink and says, 'I see you haven't changed.'"
                            },
                            {
                                "example_id": "08d0a91d-1f95-47b2-80a1-43d69950e5e0",
                                "sense_id": "88bb5999-1af1-3d87-b8af-8007cb7af497",
                                "text": "I had initiated an African ritual by giving the pipe to him. And you can never stay befuck with an oke you smoke nchangu with."
                            }
                        ]
                    }
                ],
