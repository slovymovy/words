                                    {
                                        "sense_id": "84fb4449-2ab1-3414-92f9-605c9849072e",
                                        "entry_id": "88981359-01d8-3b03-aa39-723c4a919d59",
                                        "glosses": [
                                            "osoba, zajmująca się pisaniem programów komputerowych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59fbe306-e02b-4e4f-b9f6-cd47d78cf092",
                                                "sense_id": "84fb4449-2ab1-3414-92f9-605c9849072e",
                                                "text": "Nasz najlepszy programista spędza przy komputerze dwadzieścia dwie godziny na dobę."
                                            }
