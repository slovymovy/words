        "fr-extract.jsonl": [
            {
                "entry_id": "6913e1e2-025f-3cb3-94f6-dd65fa62efb4",
                "word": "algarade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8ecc9ddd-6297-4fe9-9453-4412c8674e29",
                        "entry_id": "6913e1e2-025f-3cb3-94f6-dd65fa62efb4",
                        "tags": [
                            "plural"
                        ],
                        "form": "algarades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fbc8589-1817-3217-9cd0-18f061539268",
                        "entry_id": "6913e1e2-025f-3cb3-94f6-dd65fa62efb4",
                        "glosses": [
                            "Discussion vive et inattendue, dispute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80eb68b0-7cf0-4669-95b4-2548e9dbbc56",
                                "sense_id": "2fbc8589-1817-3217-9cd0-18f061539268",
                                "text": "Écrasée sous une avalanche de questions, reproches, menaces, remontrances, l’infortunée fondit en larmes, sans comprendre un traitre mot à l’algarade."
                            },
                            {
                                "example_id": "c73bb2bd-e2ad-44de-947e-99c56923cab9",
                                "sense_id": "2fbc8589-1817-3217-9cd0-18f061539268",
                                "text": "Au moment où survenait cette algarade, j’eus à nouveau, mais cette fois bien plus précisément que la première fois, l’impression très désagréable de reconnaître Madelon au premier rang d’un groupe, juste au même endroit, devant la grille."
                            },
                            {
                                "example_id": "e85cc167-8cff-4dbe-8088-9ad1dae1f4c6",
                                "sense_id": "2fbc8589-1817-3217-9cd0-18f061539268",
                                "text": "On est tombé sur l’algarade entre la chanteuse allumée et le présentateur diplômé d’insolence, sur la publicité débile, la colère du politique poussé hors de ses gonds."
                            },
                            {
                                "example_id": "63e01fa9-bb73-4be1-91ba-1646b3bb4b9d",
                                "sense_id": "2fbc8589-1817-3217-9cd0-18f061539268",
                                "text": "L’algarade commence avec le très vallsiste Christophe Caresche, qui regrette notamment le refus du candidat PS d’assumer le bilan du quinquennat et « ses bons résultats »."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a94ef6e-8408-36af-8637-66bee2e05c6e",
                        "entry_id": "6913e1e2-025f-3cb3-94f6-dd65fa62efb4",
                        "glosses": [
                            "Insulte faite brusquement, avec un certain éclat, sans sujet, ou pour un sujet très léger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e22ef763-9412-4b60-9cb5-98817992ba88",
                                "sense_id": "6a94ef6e-8408-36af-8637-66bee2e05c6e",
                                "text": "Le pauvre secrétaire, tout décontenancé de l’algarade, baissait le nez et gardait le silence."
                            },
                            {
                                "example_id": "32c75b9a-973f-4709-bf65-ab965bc7e5b4",
                                "sense_id": "6a94ef6e-8408-36af-8637-66bee2e05c6e",
                                "text": "Je viens, au contraire, général, vous faire mes excuses sur l’algarade malheureuse que je me suis permise à votre égard […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc71736c-79a6-37b3-959e-3efc657f99d9",
                        "entry_id": "6913e1e2-025f-3cb3-94f6-dd65fa62efb4",
                        "glosses": [
                            "Incursion sur un territoire ennemi, non précédée d’une déclaration de guerre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4a730d-772c-4abf-8701-d55e2ab8e5b2",
                                "sense_id": "cc71736c-79a6-37b3-959e-3efc657f99d9",
                                "text": "Faire une algarade."
                            },
                            {
                                "example_id": "2b6d3fa7-1652-4285-a695-b123f6e6b17e",
                                "sense_id": "cc71736c-79a6-37b3-959e-3efc657f99d9",
                                "text": "Il lui a fait mille algarades."
                            },
                            {
                                "example_id": "376f9129-d598-42f4-b784-310933106c13",
                                "sense_id": "cc71736c-79a6-37b3-959e-3efc657f99d9",
                                "text": "Il vint nous faire une algarade."
                            },
                            {
                                "example_id": "d0fb3ea4-a0e5-4240-a87a-da2d8f13d591",
                                "sense_id": "cc71736c-79a6-37b3-959e-3efc657f99d9",
                                "text": "Des correspondances, des reconnaissances de dette, des contrats de mariage, des jugements, des algarades familiales, des plans de fraude fiscale, des appels au secours, des lettres du roi d’Assyrie en personne…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7c257f2-cd37-4ad4-a948-10f8aeab3c11",
                        "source_entry_id": "6913e1e2-025f-3cb3-94f6-dd65fa62efb4",
                        "source_sense_id": "2fbc8589-1817-3217-9cd0-18f061539268",
