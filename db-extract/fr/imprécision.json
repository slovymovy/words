                ],
                "senses": [
                    {
                        "sense_id": "747c19cf-8af6-36e2-b7b2-2be0cfe7fee2",
                        "entry_id": "51970beb-e659-3574-933c-406194cb7590",
                        "glosses": [
                            "Qualité de ce qui est imprécis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba6533f7-53a8-4021-9792-d233dc632c2c",
                                "sense_id": "747c19cf-8af6-36e2-b7b2-2be0cfe7fee2",
                                "text": "Dans le brouillard, les objets restent dans l’imprécision."
                            },
                            {
                                "example_id": "eac0ab40-7725-47a0-ae0e-d3a845aab321",
                                "sense_id": "747c19cf-8af6-36e2-b7b2-2be0cfe7fee2",
                                "text": "L’imprécision du style, du souvenir, d’un récit."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d36241a-3573-392e-b8c2-f11bf1a25243",
                        "entry_id": "51970beb-e659-3574-933c-406194cb7590",
                        "glosses": [
                            "Point qui manque de précision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a2cb761-3bfb-4880-9024-8159c8033b1e",
                                "sense_id": "0d36241a-3573-392e-b8c2-f11bf1a25243",
                                "text": "Néanmoins la vectorisation entraîne des imprécisions et des pertes d'informations qui peuvent être parfois gênantes pour des traitements ultérieurs. Pour vectoriser une image il faut au préalable extraire le squelette des objets."
                            },
                            {
                                "example_id": "d8344850-0336-42a2-9344-48491029b44a",
                                "sense_id": "0d36241a-3573-392e-b8c2-f11bf1a25243",
                                "text": "L’utilisation de ce mot dans ce contexte est une imprécision."
                            }
                        ]
                    }
                ],
