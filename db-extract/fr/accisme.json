                        "entry_id": "d450288c-9945-3326-8f72-93314da0a219",
                        "glosses": [
                            "Refus simulé, acte de refuser ce que l’on désire."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d3f85056-2352-4a8d-bc09-5d165d60cf15",
                                "sense_id": "7daa5433-cc9a-389f-afad-cc4304961729",
                                "text": "Les filles répondent ordinairement par un accisme, lorsqu’on leur parle de mariage."
                            },
                            {
                                "example_id": "91dbba45-06af-40aa-a7fa-7f340d93592e",
                                "sense_id": "7daa5433-cc9a-389f-afad-cc4304961729",
                                "text": "La femme n’use jamais aussi souvent de figures d’éloquence (exceptée la sienne propre), que celle de l’« accisme »."
                            }
                        ]
                    }
                ],
                "translations": [
