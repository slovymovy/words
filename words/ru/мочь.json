{
    "word_family": [
        "смочь",
        "могучий",
        "могущество"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa6631f2-9fd6-327b-bc05-b7cf952f5e37",
                    "sense_definition": "быть способным, иметь физическую или интеллектуальную возможность совершить действие",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>могу</w> прочитать эту книгу на русском языке.",
                            "target_lang_translations": {
                                "de": "Ich <w>kann</w> dieses Buch auf Russisch lesen."
                            }
                        },
                        {
                            "text": "Ты <w>можешь</w> прийти ко мне завтра вечером?",
                            "target_lang_translations": {
                                "de": "<w>Kannst</w> du morgen Abend zu mir kommen?"
                            }
                        }
                    ],
                    "synonyms": [
                        "быть в состоянии",
                        "быть в силах",
                        "уметь"
                    ],
                    "common_phrases": [
                        "могу себе позволить",
                        "не могу сказать"
                    ],
                    "target_lang_definitions": {
                        "de": "in der Lage sein, die physische oder intellektuelle Möglichkeit haben, eine Handlung auszuführen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "können",
                                "target_lang_sense_clarification": "die Fähigkeit oder Möglichkeit haben"
                            },
                            {
                                "target_lang_word": "in der Lage sein",
                                "target_lang_sense_clarification": "körperlich oder geistig fähig sein"
                            },
                            {
                                "target_lang_word": "fähig sein",
                                "target_lang_sense_clarification": "die Kompetenz oder Kraft besitzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d4ebaf5-5d11-335f-964c-a71ccd130de7",
                    "sense_definition": "выражает вероятность или предположение",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завтра <w>может</w> пойти дождь.",
                            "target_lang_translations": {
                                "de": "Morgen <w>könnte</w> es regnen."
                            }
                        },
                        {
                            "text": "Это <w>может</w> быть правдой.",
                            "target_lang_translations": {
                                "de": "Das <w>kann</w> wahr sein."
                            }
                        }
                    ],
                    "common_phrases": [
                        "может быть"
                    ],
                    "target_lang_definitions": {
                        "de": "drückt eine Wahrscheinlichkeit, Vermutung oder Möglichkeit aus"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "können",
                                "target_lang_sense_clarification": "etwas ist möglich oder denkbar"
                            },
                            {
                                "target_lang_word": "dürfen",
                                "target_lang_sense_clarification": "im Konjunktiv II: eine begründete Vermutung ausdrückend (dürfte)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a17db11d-57b4-3f3a-9974-73b5c0daf2c7",
                    "sense_definition": "физическая сила, энергия или способность что-либо сделать",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он кричал во всю <w>мочь</w>.",
                            "target_lang_translations": {
                                "de": "Er schrie aus Leibeskräften."
                            }
                        },
                        {
                            "text": "У него уже нет <w>мочи</w> продолжать эту работу.",
                            "target_lang_translations": {
                                "de": "Er hat keine <w>Kraft</w> mehr, diese Arbeit fortzusetzen."
                            }
                        }
                    ],
                    "synonyms": [
                        "сила",
                        "мощь"
                    ],
                    "antonyms": [
                        "немочь"
                    ],
                    "common_phrases": [
                        "во всю мочь",
                        "нет мочи"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в устойчивых выражениях"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "physische Kraft, Energie oder das Vermögen, etwas zu tun (meist in Redewendungen)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kraft",
                                "target_lang_sense_clarification": "körperliche Stärke oder Energie"
                            },
                            {
                                "target_lang_word": "Macht",
                                "target_lang_sense_clarification": "Stärke, Vermögen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}