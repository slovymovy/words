                                "target_senses": [
                                    {
                                        "sense_id": "288d872d-b2a4-3e50-8636-4958fd5d8d7a",
                                        "entry_id": "395cd92c-e13d-3922-8cb3-51ee8d72c595",
                                        "glosses": [
                                            "Of, from, or pertaining to Palestine or the Palestinian people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5fd045-1290-4eab-b5f1-08f0ab791866",
                                                "sense_id": "288d872d-b2a4-3e50-8636-4958fd5d8d7a",
                                                "text": "Halaby […] accompanied the curators on their trip through the Middle East to collect the artwork of over 20 Palestinian artists."
                                            },
                                            {
                                                "example_id": "84af9234-9ef6-4932-a1c9-28c941c2dc4f",
                                                "sense_id": "288d872d-b2a4-3e50-8636-4958fd5d8d7a",
                                                "text": "Here, Rose shares her Palestinian grandmother's delicious rice and lamb recipe. Her grandmother would make this as a family meal."
                                            },
                                            {
                                                "example_id": "e9c00e07-25d2-4499-9783-690bc1c218ea",
                                                "sense_id": "288d872d-b2a4-3e50-8636-4958fd5d8d7a",
                                                "text": "Prospects for a Palestinian state seem unclear amid various regional challenges, resistance from Israeli officials, and questions regarding U.S. policy in early 2025."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Palestinian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e563f0c5-e8a1-3478-81f8-167b4a64ca6b",
                                        "entry_id": "b66f1c9d-d16a-323d-84d2-2c67c96957f0",
                                        "glosses": [
                                            "An inhabitant of Palestine or someone descending from that area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "560e24ce-0ed5-43b1-b6e2-fd1183e99278",
                                                "sense_id": "e563f0c5-e8a1-3478-81f8-167b4a64ca6b",
                                                "text": "فقال لي الأستاذ أنت مصري قلت لا بل فلسطيني",
                                                "translation": "The Soundest Divisions in Understanding the Regions",
                                                "english": "The Soundest Divisions in Understanding the Regions"
                                            },
                                            {
                                                "example_id": "e7e83720-b12a-437d-a3c3-869c9f0e7cc2",
                                                "sense_id": "e563f0c5-e8a1-3478-81f8-167b4a64ca6b",
                                                "text": "In 2008 the Rozana Association […] instituted a Maftoul Festival in Bir Zeit, near Ramallah, celebrating the many tasty ways in which Palestinians cook maftoul, or couscous."
                                            },
                                            {
                                                "example_id": "d6514493-9302-427b-8622-d11c290cba72",
                                                "sense_id": "e563f0c5-e8a1-3478-81f8-167b4a64ca6b",
                                                "text": "We got a message back from Israel that they were withdrawing their troops immediately from Lebanon. We are notifying the Syrians and the Lebanese and demanding that they mutually participate in a cease-fire and withdrawal of the Palestinians back ten kilometers from the Israeli borders."
                                            },
                                            {
                                                "example_id": "c0d27fdc-b5e4-4706-81d5-ff9a16080352",
                                                "sense_id": "e563f0c5-e8a1-3478-81f8-167b4a64ca6b",
                                                "text": "About 3 million Palestinians live in the West Bank, plus an estimated 2.1 million in Gaza. Around 98% are Sunni Muslim, with a small Christian minority. Another estimated 2 million Palestinians live in Israel as citizens. Of the Palestinians living in the Middle East, about 5.9 million are registered refugees (in the West Bank, Gaza, Jordan, Lebanon, and Syria) whose claims to land in present-day Israel constitute a major issue of Israeli-Palestinian dispute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
