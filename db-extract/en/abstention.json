                        "cross_references": [
                            {
                                "target_word": "abstention",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a31b8ff1-56a9-380c-9f73-aafbeb556132",
                                        "entry_id": "f53544ea-5aca-334f-b65b-5e4029123e69",
                                        "glosses": [
                                            "Action de s’abstenir, non-exercice d’un droit, refus de prendre part, d’intervenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223e2c31-3d8b-4a48-b4b0-dd5f4f976d8e",
                                                "sense_id": "a31b8ff1-56a9-380c-9f73-aafbeb556132",
                                                "text": "L'abstention de vote. L'abstention des électeurs."
                                            },
                                            {
                                                "example_id": "81b20103-d98c-47cd-9d7d-52510ed0d0ac",
                                                "sense_id": "a31b8ff1-56a9-380c-9f73-aafbeb556132",
                                                "text": "Ce qu’ils rêvaient, c’était l’abstention complète, la panique générale des fonctionnaires. Si toute administration régulière disparaissait, et s’ils étaient alors un seul jour les maîtres des destinées de Plassans, leur fortune était solidement fondée."
                                            },
                                            {
                                                "example_id": "5a308e16-1d68-40ec-acdb-7521a3dcc837",
                                                "sense_id": "a31b8ff1-56a9-380c-9f73-aafbeb556132",
                                                "text": "On passerait d’une abstention passive à une abstention active et interactive."
                                            },
                                            {
                                                "example_id": "1436b8b0-b8d7-4fc2-92b7-916d7730dabe",
                                                "sense_id": "a31b8ff1-56a9-380c-9f73-aafbeb556132",
                                                "text": "L’expérience négative du mérite peut ainsi avoir un effet sur la participation au jeu politique : soit pour s’en exclure, avec l’abstention, soit pour s’engager dans des mouvements alternatifs ou extrêmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49bbf076-6d0a-3bec-a751-00375ddb4e07",
                                        "entry_id": "f53544ea-5aca-334f-b65b-5e4029123e69",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "804f2e81-a4e7-4b8c-9c84-bd3f15963648",
                                                "sense_id": "49bbf076-6d0a-3bec-a751-00375ddb4e07",
                                                "text": "Il y a eu, à ces élections, un grand nombre d'abstentions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20df0f39-8e14-3695-80ce-e98b22b7e721",
                                        "entry_id": "f53544ea-5aca-334f-b65b-5e4029123e69",
                                        "glosses": [
                                            "Acte par lequel un juge s’abstient, se récuse lui-même."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48b7f818-539c-3eb1-8c68-68faf60d9604",
                                        "entry_id": "f53544ea-5aca-334f-b65b-5e4029123e69",
                                        "glosses": [
