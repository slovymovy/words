                ],
                "senses": [
                    {
                        "sense_id": "f5597dbc-48cd-3de3-aa75-70735ad830eb",
                        "entry_id": "bac6e452-0202-3c6b-8450-8d64943046d4",
                        "glosses": [
                            "twór przypominający człowieka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0d457a-622d-4cc0-95a8-803e24b1b23c",
                                "sense_id": "f5597dbc-48cd-3de3-aa75-70735ad830eb",
                                "text": "Zazwyczaj fikcyjne humanoidy to stworzenia dwunożne, o kształcie ciała podobnym do ludzkiego, jednak różniące się od ludzi kolorem skóry, ilością i umiejscowieniem włosów, wzrostem, masą ciała, kształtem uszu i nosa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "330458a1-469b-46f5-937e-b9ae241ce8f4",
                        "source_entry_id": "bac6e452-0202-3c6b-8450-8d64943046d4",
                        "source_sense_id": "f5597dbc-48cd-3de3-aa75-70735ad830eb",
                        "target_lang_word": "humanoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36cdb10a-4362-38cf-89d4-b57417ae4892",
                                        "entry_id": "4e65a2e3-239b-39a8-b32d-45eb85832779",
                                        "glosses": [
                                            "Having the appearance or characteristics of a human; being anthropomorphic under some criteria (physical, mental, genetical, ethological, ethical etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "808e6a44-fa75-4239-81ab-242a66061c1b",
                                                "sense_id": "36cdb10a-4362-38cf-89d4-b57417ae4892",
                                                "text": "That's how I came to be down there, Captain, pursuing the devil's own spawn, a thing I've chased across the universe. He's humanoid outside, but inside, he's a hideous, murdering monster. I'll get him, Captain. I swear it."
                                            },
                                            {
                                                "example_id": "75a7800a-d082-4fdc-a26e-275d1002ff10",
                                                "sense_id": "36cdb10a-4362-38cf-89d4-b57417ae4892",
                                                "text": "About 56% of the humanoid robot supply chain companies are based in China, according to a Morgan Stanley research report last month."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humanoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a64066-8a4b-3c1d-a6ac-f4d7c11f12ae",
                                        "entry_id": "a430f414-a406-33d5-b280-e40e4543da4f",
                                        "glosses": [
                                            "A being having the appearance or characteristics of a human."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6df123f-8b80-4fbf-abba-e89211f2ecf2",
                                                "sense_id": "15a64066-8a4b-3c1d-a6ac-f4d7c11f12ae",
                                                "text": "Lowering prices for humanoids would mark a major step to their eventual commercialization and wider adoption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc4f6e90-d751-46c3-a8ce-83fe3e1468b4",
                        "source_entry_id": "bac6e452-0202-3c6b-8450-8d64943046d4",
                        "source_sense_id": "f5597dbc-48cd-3de3-aa75-70735ad830eb",
                        "target_lang_word": "humanoid",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5e63993e-f0df-49ab-b333-d605e57c90d3",
                        "source_entry_id": "bac6e452-0202-3c6b-8450-8d64943046d4",
                        "source_sense_id": "f5597dbc-48cd-3de3-aa75-70735ad830eb",
                        "target_lang_word": "humanoïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanoïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a95cbc3-3f9b-3aa9-a075-ca5c628ecc6f",
                                        "entry_id": "5fe69a59-505e-3e4a-b91f-2a0c35edc9a9",
                                        "glosses": [
                                            "De forme humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3c55152-a210-43e9-8061-8c2ea96f8f46",
                                                "sense_id": "7a95cbc3-3f9b-3aa9-a075-ca5c628ecc6f",
                                                "text": "En 1947, au tout début des apparitions d’ovnis, une soucoupe se serait écrasée à Roswell, au Nouveau-Mexique. On aurait trouvé des extraterrestres humanoïdes morts à bord et des médecins militaires les auraient autopsiés."
                                            },
                                            {
                                                "example_id": "31506ef1-cd55-40ab-a297-ac2a680f9d12",
                                                "sense_id": "7a95cbc3-3f9b-3aa9-a075-ca5c628ecc6f",
                                                "text": "Elle a, ainsi, à son actif des nudges en lien avec Astérix, Maître Yoda et une souris humanoïde."
                                            },
                                            {
                                                "example_id": "b88d7a66-d15f-40dc-877d-d64250304b81",
                                                "sense_id": "7a95cbc3-3f9b-3aa9-a075-ca5c628ecc6f",
                                                "text": "Un tarif qui semble étonnamment bas pour un robot humanoïde avancé, surtout quand on connaît le coût des robots industriels actuels. Mais, très élevé pour le grand public."
                                            },
                                            {
                                                "example_id": "d51dc00f-84c0-4fa9-9e04-f36144e64fb8",
                                                "sense_id": "7a95cbc3-3f9b-3aa9-a075-ca5c628ecc6f",
                                                "text": "Qu’ils aient un look vaguement humanoïde, donc puissent tenir debout et marcher sur deux jambes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humanoïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "764ab2c6-d786-3e22-a425-2d044860abee",
                                        "entry_id": "969bfeb6-1a32-3aa4-a148-e50fbf7db2be",
                                        "glosses": [
                                            "Robot humanoïde."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c434ef92-465b-4688-be6d-801889f98dae",
                                                "sense_id": "764ab2c6-d786-3e22-a425-2d044860abee",
                                                "text": "Parallèlement, le Dr Doi et son équipe ont créé un humanoïde bipède qui a connu un succès immense lorsqu’il a été présenté à la foire Robodex, il y a un an."
                                            },
                                            {
                                                "example_id": "e25856c1-4577-45d1-81f5-c7c5e7eb85e5",
                                                "sense_id": "764ab2c6-d786-3e22-a425-2d044860abee",
                                                "text": "\"Ensuite, j’ai pensé que l’intrusion des humanoïdes dans le système d’éducation allait entraîner la démission des parents et la dislocation de la cellule familiale.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f3b6364-f066-3fcc-ada0-67faf80b696c",
                                        "entry_id": "969bfeb6-1a32-3aa4-a148-e50fbf7db2be",
                                        "glosses": [
                                            "Pour les ufologues, être extraterrestre ayant une morphologie humaine."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78262290-e21a-482e-a8c0-889c0caae1d2",
                                                "sense_id": "9f3b6364-f066-3fcc-ada0-67faf80b696c",
                                                "text": "Lorsque nous prenons l’Atterrissage de Villers-le-Tilleul (Ardennes), s'étant déroulé le 4 octobre 1954 vers 18 heures, où fut aperçu un Humanoïde vêtu d'une « combinaison à longs poils » et que nous le comparons à titre d'exemple avec l'atterrissage survenu près de Voillecomte (Haute-Marne), très exactement le 5 octobre 1954, vers 7 heures du matin, nous pouvons en tirer les constatations suivantes, […]."
                                            },
                                            {
                                                "example_id": "04da4a65-59b2-46e1-9a0c-f4311f134369",
                                                "sense_id": "9f3b6364-f066-3fcc-ada0-67faf80b696c",
                                                "text": "Le concept de remplacement des gens que l'on fréquente et qui nous sont proches par des humanoïdes est évidemment puissant et traumatisant car il suscite le doute et la paranoïa aiguë."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
