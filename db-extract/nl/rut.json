            {
                "entry_id": "55277e64-7273-3895-8952-6b146f40cf87",
                "word": "rut",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3975167d-bb1c-37ed-853b-60df8993a02a",
                        "entry_id": "55277e64-7273-3895-8952-6b146f40cf87",
                        "glosses": [
                            "niets (meer) bezittend"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3a4ca72c-ab8c-4a0d-b947-81578ca7565b",
                                "sense_id": "3975167d-bb1c-37ed-853b-60df8993a02a",
                                "text": "Eylacen nu ist te mijnent al rut en pover"
                            }
                        ]
                    },
                    {
                        "sense_id": "3fc09784-abfc-3b02-9b55-239149396d87",
                        "entry_id": "55277e64-7273-3895-8952-6b146f40cf87",
                        "glosses": [
                            "al zijn inzet verspeeld hebbend (ook bij andere spelletjes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4322aad7-3f08-433b-9711-b93d280f8563",
                                "sense_id": "3fc09784-abfc-3b02-9b55-239149396d87",
                                "text": "Eerst begin je (voor veel geld) zes maanden op proef, daarna word je leerling (kost extra), speciaal leerling (kost extra), speciaal Hubbard-leerling (kost extra), erkend Hubbard-leerling (kost extra), erkend scientoloog (kost extra), professioneel auditeur (kost extra), en dan vergeet ik nog enkele tussenstadia (kosten allemaal extra). Geheel bovenaan de trap bevinden zich de Power-mensen, die speciale bevoegdheden hebben gekregen, maar in ruil daarvoor volkomen rut zijn."
                            },
                            {
                                "example_id": "b0d0a767-91ec-4123-8e7d-afc2cdbb8b7f",
                                "sense_id": "3fc09784-abfc-3b02-9b55-239149396d87",
                                "text": "Hoeveel centen heb je? vroeg Herman. Hugo hield hem zijn geopende hand met het geld voor. Ik zal voor je spelen, zei hij, als ik dit potje verlies, ben ik rut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebc564e0-b62e-4ef1-ab5d-b89216def1e8",
                        "source_entry_id": "55277e64-7273-3895-8952-6b146f40cf87",
                        "source_sense_description": "niets (meer) bezittend",
                        "target_lang_word": "blank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e18ae3c7-94a6-3196-b936-d9626e476245",
                                        "entry_id": "7ac6156a-5602-3dac-aee1-319ab580f317",
                                        "glosses": [
                                            "(metallisch) hell schimmernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce2a2b53-28f9-49e5-8218-3e87f58f4fb1",
                                                "sense_id": "e18ae3c7-94a6-3196-b936-d9626e476245",
                                                "text": "Der Ritter zog in seiner blanken Rüstung in den Kampf."
                                            },
                                            {
                                                "example_id": "0a44c158-1cd4-4acf-9526-4661bf33af42",
                                                "sense_id": "e18ae3c7-94a6-3196-b936-d9626e476245",
                                                "text": "„Dieser Neubau war das Haus, das jetzt noch stand. Es hatte denselben nüchternen Charakter wie fast alles, was unter dem Soldatenkönig entstand, und war nichts weiter als ein einfaches Corps de logis, dessen zwei vorspringende, bis dicht an den Graben reichende Seitenflügel ein Hufeisen und innerhalb desselben einen kahlen Vorhof bildeten, auf dem, als einziges Schmuckstück, eine große blanke Glaskugel sich präsentierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0be2b16b-2972-36dd-8a4c-2ac9fa3ef342",
                                        "entry_id": "7ac6156a-5602-3dac-aee1-319ab580f317",
                                        "glosses": [
                                            "offen, bloß; klar ersichtlich, rein"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018939af-ebc3-4320-b5e8-6134cbb361b3",
                                                "sense_id": "0be2b16b-2972-36dd-8a4c-2ac9fa3ef342",
                                                "text": "Er wies auf seinen blanken Hintern und zitierte Götz von Berlichingen."
                                            },
                                            {
                                                "example_id": "8776fb57-d70d-4ff8-833f-a213d8f4b684",
                                                "sense_id": "0be2b16b-2972-36dd-8a4c-2ac9fa3ef342",
                                                "text": "Er griff das Schwert und zog blank. (Die Klinge ist sichtbar/unverdeckt)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "87c513ac-958f-3340-9afc-c4798d2fc834",
                                        "entry_id": "7ac6156a-5602-3dac-aee1-319ab580f317",
                                        "glosses": [
                                            "ohne Geld"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19f0c1cd-9434-4514-a446-cc085b21e7ee",
                                                "sense_id": "87c513ac-958f-3340-9afc-c4798d2fc834",
                                                "text": "Jetzt bin ich blank. (Das Geld ist alle – Der Boden der Kasse ist sichtbar/unverdeckt)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5e92e1d0-9a96-326d-819d-e546c5d64271",
                                        "entry_id": "7ac6156a-5602-3dac-aee1-319ab580f317",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096c4e5f-ec5f-40f8-a6d7-56433291860e",
                                                "sense_id": "5e92e1d0-9a96-326d-819d-e546c5d64271",
                                                "text": "Was du da erzählst, ist blanker Unsinn!"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38886090-b5a4-422e-977a-984179737815",
                        "source_entry_id": "55277e64-7273-3895-8952-6b146f40cf87",
                        "source_sense_description": "niets (meer) bezittend",
                        "target_lang_word": "pleite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d08df67f-887a-3777-9b87-ed0adb23c78f",
                                        "entry_id": "134aa0fd-ca5f-33f0-912e-c80b74b02d1b",
                                        "glosses": [
                                            "(als Geschäftsmann, Firma) illiquid, finanziell ruiniert, zahlungsunfähig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a4918b-c5cd-4937-b81c-8e8cbef408ff",
                                                "sense_id": "d08df67f-887a-3777-9b87-ed0adb23c78f",
                                                "text": "Die Firma war schon nach einem halben Jahr pleite."
                                            },
                                            {
                                                "example_id": "d6ef3f5e-c813-4734-846a-748a46fbb21c",
                                                "sense_id": "d08df67f-887a-3777-9b87-ed0adb23c78f",
                                                "text": "„Damals standen die \"Big Three\", die drei Giganten der Autoindustrie General Motors, Ford und Chrysler, für den \"American Way of Life\" schlechthin. Heute sind sie pleite und vom Untergang bedroht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a222a52c-b3d7-375b-8a2f-285a8b6c8e62",
                                        "entry_id": "134aa0fd-ca5f-33f0-912e-c80b74b02d1b",
                                        "glosses": [
                                            "derzeit kein bares Geld besitzend; nur für eine gewisse Zeit mittellos"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34bda8b5-6d5c-4827-9c51-f1ecc922ff37",
                                                "sense_id": "a222a52c-b3d7-375b-8a2f-285a8b6c8e62",
                                                "text": "„Man merkt es schon, ich bin pleite und schlecht gelaunt. Die besten Voraussetzungen für den Samstagseinkauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
