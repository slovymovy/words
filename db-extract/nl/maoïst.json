                "senses": [
                    {
                        "sense_id": "f88fa1d6-9764-3590-863d-a7d8fcdf7f6d",
                        "entry_id": "f37910f4-eb37-38bd-b26d-13901f4b82e7",
                        "glosses": [
                            "communist die zich vooral heeft laten inspireren door Mao Zedong"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a183ec7-2746-474b-ad0e-3a57853fa3f0",
                                "sense_id": "f88fa1d6-9764-3590-863d-a7d8fcdf7f6d",
                                "text": "Het is een maoïst die een sociaaldemocraat de maat neemt. En o ja, de lijst deugt voor geen meter, schrijft de man wiens partij bij oekaze leden benoemt en waar gestaalde kaders verkouden worden van openheid."
                            },
                            {
                                "example_id": "2a970d44-6f2e-46bf-b769-20ebbabd0b9a",
                                "sense_id": "f88fa1d6-9764-3590-863d-a7d8fcdf7f6d",
                                "text": "Het zuidelijke eiland Mindanao wordt al jaren geterroriseerd door islamitische en maoïstische extremisten. De verantwoordelijkheid voor de aanslagen is nog niet opgeëist."
                            },
                            {
                                "example_id": "f7862bf7-9921-4ddd-811e-a05cc8c165d6",
                                "sense_id": "f88fa1d6-9764-3590-863d-a7d8fcdf7f6d",
                                "text": "Door de aanslag in 1992 in de straat Tarata vielen 25 doden. Ook raakten circa 155 mensen gewond. Het ging om de dodelijkste aanslag die de maoïstische rebellen pleegden in de hoofdstad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7016da61-4f39-4a1e-afc5-608f9d124b60",
                        "source_entry_id": "f37910f4-eb37-38bd-b26d-13901f4b82e7",
