                        "tags": [
                            "Québec"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c56f9603-3ef5-35eb-85d3-856b87b1cf2c",
                        "entry_id": "b159cc1a-92e1-3766-8020-aa48d676dc2d",
                        "glosses": [
                            "Ensemble de cannes (boîtes de conserve)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2c16d33b-9302-4860-9e89-ab68e3ff4c22",
                                "sense_id": "c56f9603-3ef5-35eb-85d3-856b87b1cf2c",
                                "text": "Cannage, nourriture déshydratée, procédé de lyophilisation : l’abc d’une grande et longue expédition réussie passe en grande partie par la gestion des vivres."
                            },
                            {
                                "example_id": "82f2aab7-23ac-4050-b0e9-93ec631bef00",
                                "sense_id": "c56f9603-3ef5-35eb-85d3-856b87b1cf2c",
                                "text": "Les plats se résumaient à des cannages, des lentilles et des plats mijotés de viande comme le yack ou l’ibex."
                            }
                        ]
                    }
