                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49c447ca-b95b-3308-8949-541f58142441",
                                        "entry_id": "ad6ec583-a673-3b88-b3a5-ff38aaa8d079",
                                        "glosses": [
                                            "Partikel, die die Verneinung, die Negierung beziehungsweise die Negation ausdrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "870d3f93-8ed9-46e3-a184-2f3eb460ad48",
                                                "sense_id": "49c447ca-b95b-3308-8949-541f58142441",
                                                "text": "Sie kommt nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5963c6af-9beb-3e80-a08c-1877c192cf8d",
                                        "entry_id": "ad6ec583-a673-3b88-b3a5-ff38aaa8d079",
                                        "glosses": [
                                            "Negation, Negator"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d996ecc0-c399-4289-8d2d-0b7bc6dcab78",
                                                "sense_id": "5963c6af-9beb-3e80-a08c-1877c192cf8d",
                                                "text": "„A und nicht A“ ist falsch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "98cd8571-f5d3-32b2-bf0e-cccb643e978c",
                                        "entry_id": "ad6ec583-a673-3b88-b3a5-ff38aaa8d079",
                                        "glosses": [
                                            "den Sinn nicht verändernde Partikel in Sätzen oder Satzteilen (Nebensätzen), die schon anders als durch das Wort „nicht“ funktional negiert sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d450da4-783c-4aee-b691-c0b1ddcae701",
                                                "sense_id": "98cd8571-f5d3-32b2-bf0e-cccb643e978c",
                                                "text": "„Bevor man sich das nicht klargemacht hat, sollte man nicht in Einstellungsgespräche gehen.“"
                                            },
                                            {
                                                "example_id": "6b509457-fbfa-4918-ba0e-71002e170400",
                                                "sense_id": "98cd8571-f5d3-32b2-bf0e-cccb643e978c",
                                                "text": "„Bis die Ermittlungen nicht abgeschlossen sind, ist offen, ob es dabei bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98e28eb1-0c28-44f4-9eba-61db2c645a7e",
                        "source_entry_id": "19d98815-5675-3225-934e-f75a15b32d09",
                        "source_sense_id": "a519ef3b-c591-344d-b0bc-ab9e02f076ce",
                        "target_lang_word": "sans",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24d3b79b-5358-3bfd-860f-69b32a69cd5e",
                                        "entry_id": "e225890f-79d5-3042-8350-dfbeb57c9450",
                                        "glosses": [
                                            "Préposition marquant l’absence, le manque, l’exclusion d’une personne, d’une chose. — Note d’usage : On n’utilise généralement pas d’article indéfini ou partitif. Peut s’accentuer avec aucun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f0a44d4-d234-40b0-8f4f-eb8cd1f726d6",
                                                "sense_id": "24d3b79b-5358-3bfd-860f-69b32a69cd5e",
                                                "text": "Nous reçûmes l'ordre de côtoyer en le remontant le ruisseau de la Tourbe, qui arrose la plus triste vallée du monde, entre des collines basses, sans arbres et sans buissons."
                                            },
                                            {
                                                "example_id": "29248d97-78bd-4954-b14d-9ccd5624ecbc",
                                                "sense_id": "24d3b79b-5358-3bfd-860f-69b32a69cd5e",
                                                "text": "La nuit n'était pas brouillardeuse, mais terne, humide sans pluie, froide sans frimas, une vraie nuit française de janvier."
                                            },
                                            {
                                                "example_id": "940959fe-5716-4c94-8536-6df71bb272f5",
                                                "sense_id": "24d3b79b-5358-3bfd-860f-69b32a69cd5e",
                                                "text": "La région que nous parcourons est une vaste plaine monotone, sans arbres et presque sans reliefs, qui s'élève insensiblement à fur et à mesure que nous avançons."
                                            },
                                            {
                                                "example_id": "ec906c5f-22c9-411c-8a55-8945f5ae64ff",
                                                "sense_id": "24d3b79b-5358-3bfd-860f-69b32a69cd5e",
                                                "text": "[…], la Tivabro est décorée à la mode Bretagne d'antan, avec goût et sans folklore tartignole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f87d840-c313-372e-ac6c-6f4f31fa3f15",
                                        "entry_id": "e225890f-79d5-3042-8350-dfbeb57c9450",
                                        "glosses": [
                                            "Elle se place aussi devant un infinitif pour marquer l’absence, le manque d’une manière d’être ou d’agir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c38e4f-aeff-4f1e-a27a-e1f1ac44c89f",
                                                "sense_id": "5f87d840-c313-372e-ac6c-6f4f31fa3f15",
                                                "text": "Je commençais à m'amuser quand mon supérieur m'interrompit. Il déchira la énième lettre sans même la lire et me dit que mademoiselle Mori était arrivée."
                                            },
                                            {
                                                "example_id": "497d5b4c-8ac1-4110-99fb-d5803eb83efb",
                                                "sense_id": "5f87d840-c313-372e-ac6c-6f4f31fa3f15",
                                                "text": "Pas question de féminiser les dénominations professionnelles. […]. Pendant quelques années encore, on peut écrire sans rire que «le ministre est enceinte», c’est ce qu’on appelle une syllepse, le sens l’emportant sur l’accord grammatical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48726c32-0007-4e8c-a358-7ade4ce15538",
                        "source_entry_id": "19d98815-5675-3225-934e-f75a15b32d09",
                        "source_sense_id": "a519ef3b-c591-344d-b0bc-ab9e02f076ce",
                        "target_lang_word": "peu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85860d31-b642-3743-845b-40a50c35f95e",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Presque pas ; pas beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d52cc5-5898-4534-b755-487a04f17b55",
                                                "sense_id": "85860d31-b642-3743-845b-40a50c35f95e",
                                                "text": "J’aime peu les proverbes."
                                            },
                                            {
                                                "example_id": "bdef8bf9-022b-4ef5-813c-2728d9edefa8",
                                                "sense_id": "85860d31-b642-3743-845b-40a50c35f95e",
                                                "text": "J’ai peu mangé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "997a4752-b158-3dcf-a994-dc33e050aa2c",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Presque pas ; pas très."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ad5988-1838-4fd5-bf9f-f6c36ec23a22",
                                                "sense_id": "997a4752-b158-3dcf-a994-dc33e050aa2c",
                                                "text": "Il y a des cépages peu hâtifs qui prudemment n'ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            },
                                            {
                                                "example_id": "adfbd904-8760-4c6d-894c-fab0f4788bb9",
                                                "sense_id": "997a4752-b158-3dcf-a994-dc33e050aa2c",
                                                "text": "Ce film est peu intéressant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd4aae9-9310-329f-ab8f-229094307644",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Presque aucun. Pas beaucoup."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475e9061-cd6f-4bdc-9304-588ae9035fbe",
                                                "sense_id": "4fd4aae9-9310-329f-ab8f-229094307644",
                                                "text": "Peu de gens le savent."
                                            },
                                            {
                                                "example_id": "d4a944a1-fb0d-4c77-ad0f-8b426e6853d6",
                                                "sense_id": "4fd4aae9-9310-329f-ab8f-229094307644",
                                                "text": "Il arrivera dans peu de jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e023a5d8-b743-3632-8376-dfa5031ec376",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Peu de choses."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b3e5301-afd2-48a5-bfa0-30b600def3a3",
                                                "sense_id": "e023a5d8-b743-3632-8376-dfa5031ec376",
                                                "text": "… je l'ai suppliée de vous envoyer quelque secours. … Elle m'a donc répondu que peu ne vous servirait à rien, et que, dans la vie simple que vous menez, beaucoup vous embarrasserait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efa1e37a-a8a5-31db-be0b-e67e78f1e187",
                                        "entry_id": "5488cc39-04aa-310b-a5fd-ef9fc9a87ac2",
                                        "glosses": [
                                            "Peu de gens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58bc49b8-4833-43a0-9a2d-79c2053fb3af",
                                                "sense_id": "efa1e37a-a8a5-31db-be0b-e67e78f1e187",
                                                "text": "Beaucoup sont appelés mais peu sont élus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                        "entry_id": "5488cc39-04aa-310b-a5fd-ef9fc9a87ac2",
                                        "glosses": [
                                            "Peu de chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1205c901-5ffb-4dd1-8a75-1dfbb89627c8",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Se contenter de peu."
                                            },
                                            {
                                                "example_id": "f59f33a6-48e6-4252-b390-8175dcfac217",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Vivre de peu."
                                            },
                                            {
                                                "example_id": "ad766bcf-3fb2-4746-be23-8e882aa3e55c",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Peu lui suffit."
                                            },
                                            {
                                                "example_id": "854e12b7-2d30-4f70-a31d-688d8a4fa72d",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Peu avant dîner, l’oncle Rocheflamme entra en traînant les pieds, comme quelqu’un qui a fini sa vie, mais on ne se dérangea pas pour si peu."
                                            },
                                            {
                                                "example_id": "c78d39ac-77c8-4742-bf60-68f3931debf7",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "— Eh bien, non, je ne veux pas qu’on me dérange pour si peu !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                        "entry_id": "96c5dafc-74c5-30ae-b8d9-a358f3d617af",
                                        "glosses": [
                                            "Petite quantité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85064cb0-be09-4263-a36a-fcf6df3e20d2",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Le peu que j’ai fait pour vous ne mérite pas tant de remerciements, Le peu qui me reste à vivre."
                                            },
                                            {
                                                "example_id": "f091d690-6979-44a7-a55f-5662b71a0fa9",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Le peu de cas qu’on en fait. Son peu de mérite. Il vit du peu qu’il a."
                                            },
                                            {
                                                "example_id": "9a3c9051-2e7c-4525-adf7-280624afd1ff",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Excusez mon peu de mémoire. J’attribue cela au peu de soin que vous avez eu."
                                            },
                                            {
                                                "example_id": "b1b11c7d-9802-4098-97a4-86efba805e42",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Cette nuit-là, il y avait dehors une petite pluie de peu : donc, de l’encre, et les feuilles faisaient du bruit comme une robe de faille."
                                            },
                                            {
                                                "example_id": "f5724d84-b851-4bba-9a25-c5c55e2145f8",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "On venait de supprimer les confitures du petit déjeuner, tout commençait à prendre un goût de peu et de sucre de raisin…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
