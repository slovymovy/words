{
    "word_family": [
        "fume",
        "fumigation",
        "fumigant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "84afa9f7-155c-3c68-ad26-6b7119c0044e",
                    "sense_definition": "Feeling or showing great anger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>fuming</w> after the team lost the game in the final minute.",
                            "target_lang_translations": {
                                "cs": "Manažer <w>zuřil</w> poté, co tým prohrál zápas v poslední minutě.",
                                "ru": "Тренер <w>был в ярости</w> после того, как команда проиграла матч на последней минуте."
                            }
                        },
                        {
                            "text": "She was left <w>fuming</w> when she discovered that her car had been towed away.",
                            "target_lang_translations": {
                                "cs": "Zůstala <w>zuřit</w>, když zjistila, že jí odtáhli auto.",
                                "ru": "Она <w>пришла в бешенство</w>, когда обнаружила, что её машину эвакуировали."
                            }
                        }
                    ],
                    "synonyms": [
                        "enraged",
                        "livid",
                        "incensed"
                    ],
                    "antonyms": [
                        "calm",
                        "placid"
                    ],
                    "common_phrases": [
                        "left fuming"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit nebo projev velkého hněvu či vzteku.",
                        "ru": "Испытывающий или выражающий сильный гнев, ярость."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zuřící",
                                "target_lang_sense_clarification": "vyjadřující intenzivní hněv"
                            },
                            {
                                "target_lang_word": "vzteklý",
                                "target_lang_sense_clarification": "být v afektu nebo vznětlivý"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разъярённый",
                                "target_lang_sense_clarification": "испытывающий сильный гнев"
                            },
                            {
                                "target_lang_word": "взбешённый",
                                "target_lang_sense_clarification": "крайне рассерженный"
                            },
                            {
                                "target_lang_word": "в ярости",
                                "target_lang_sense_clarification": "в состоянии сильного гнева"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "768a4cd8-b8ad-3f82-bcda-aefc75601da2",
                    "sense_definition": "Releasing or producing smoke, gas, or vapor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist carefully handled the <w>fuming</w> nitric acid inside the laboratory hood.",
                            "target_lang_translations": {
                                "cs": "Chemik opatrně manipuloval s <w>dýmající</w> kyselinou dusičnou v laboratorní digestoři.",
                                "ru": "Химик осторожно работал с <w>дымящей</w> азотной кислотой под вытяжным шкафом."
                            }
                        },
                        {
                            "text": "A <w>fuming</w> liquid was poured into the beaker during the science experiment.",
                            "target_lang_translations": {
                                "cs": "Během vědeckého experimentu byla do kádinky nalita <w>dýmající</w> tekutina.",
                                "ru": "Во время научного эксперимента в мензурку налили <w>дымящуюся</w> жидкость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fuming acid"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vylučující nebo produkující kouř, plyn nebo výpary.",
                        "ru": "Выделяющий дым, газ или едкие пары."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dýmající",
                                "target_lang_sense_clarification": "vydávající kouř nebo výpary"
                            },
                            {
                                "target_lang_word": "kouřící",
                                "target_lang_sense_clarification": "vypouštějící plyn či páru"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дымящий",
                                "target_lang_sense_clarification": "выделяющий дым или пар"
                            },
                            {
                                "target_lang_word": "дымящийся",
                                "target_lang_sense_clarification": "испускающий пар или едкие газы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65af1c25-6adb-395a-932a-4e1dded4e1cc",
                    "sense_definition": "The act of expressing intense, often suppressed, anger or frustration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>fumings</w> against the new policy did not change the final decision.",
                            "target_lang_translations": {
                                "cs": "Jeho neustálé <w>zuření</w> proti nové politice konečné rozhodnutí nezměnilo.",
                                "ru": "Его постоянное <w>негодование</w> по поводу новых правил не повлияло на окончательное решение."
                            }
                        },
                        {
                            "text": "The public grew tired of the politician's endless <w>fumings</w> about the state of the economy.",
                            "target_lang_translations": {
                                "cs": "Veřejnost byla unavená z politikových nekonečných <w>vzteklých výlevů</w> o stavu ekonomiky.",
                                "ru": "Общественность устала от бесконечных <w>гневных тирад</w> политика о состоянии экономики."
                            }
                        }
                    ],
                    "synonyms": [
                        "ranting",
                        "raving"
                    ],
                    "target_lang_definitions": {
                        "cs": "Projev intenzivního, často potlačovaného hněvu nebo frustrace.",
                        "ru": "Проявление сильного, часто сдерживаемого гнева, возмущения или раздражения."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zuření",
                                "target_lang_sense_clarification": "dlouhotrvající projev hněvu"
                            },
                            {
                                "target_lang_word": "vzteklé výlevy",
                                "target_lang_sense_clarification": "opakované projevy frustrace"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вспышки гнева",
                                "target_lang_sense_clarification": "выражение сильного раздражения"
                            },
                            {
                                "target_lang_word": "негодование",
                                "target_lang_sense_clarification": "проявление возмущения"
                            },
                            {
                                "target_lang_word": "кипение от злости",
                                "target_lang_sense_clarification": "скрытый или открытый гнев"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa244dac-2f57-30b6-86a9-48e77f7b297a",
                    "sense_definition": "Present participle and gerund of <w>fume</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon <w>fuming</w> about the unfair treatment he received at work.",
                            "target_lang_translations": {
                                "cs": "Strávil celé odpoledne tím, že <w>zuřil</w> kvůli nespravedlivému zacházení, kterého se mu v práci dostalo.",
                                "ru": "Он провёл весь день, <w>кипя от злости</w> из-за несправедливого отношения на работе."
                            }
                        },
                        {
                            "text": "She was <w>fuming</w> while waiting in the long line at the post office.",
                            "target_lang_translations": {
                                "cs": "Při čekání v dlouhé frontě na poště <w>zuřila</w>.",
                                "ru": "Она <w>кипела от негодования</w>, пока стояла в длинной очереди на почте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomný příčestí a gerundium slovesa 'fume' (zuřit, dýmat).",
                        "ru": "Причастие настоящего времени или герундий от глагола fume (кипеть от злости, дымиться)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zuřící",
                                "target_lang_sense_clarification": "v kontextu hněvu"
                            },
                            {
                                "target_lang_word": "dýmající",
                                "target_lang_sense_clarification": "v kontextu výparů"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кипящий от злости",
                                "target_lang_sense_clarification": "в значении ярости"
                            },
                            {
                                "target_lang_word": "дымящийся",
                                "target_lang_sense_clarification": "в значении выделения дыма или паров"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}