                        "sense_id": "8bf19702-2efd-325a-b89a-9a08e4cc97d0",
                        "entry_id": "c0294c28-dafe-3731-8daa-db01c62ac010",
                        "glosses": [
                            "устар., поэт. и разг. то же, что мучение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e638f9c-00ec-4889-abac-72f68dbd3f05",
                                "sense_id": "8bf19702-2efd-325a-b89a-9a08e4cc97d0",
                                "text": "[Г-жа Простакова:] Лишь тебе мученье, а всё, вижу, пустота."
                            },
                            {
                                "example_id": "85d24645-18ce-496c-afb2-62b5b94f999d",
                                "sense_id": "8bf19702-2efd-325a-b89a-9a08e4cc97d0",
                                "text": "Счастлив, что материнское благосостоянье не делало его вовсе неспособным к мученьям душевным."
                            },
                            {
                                "example_id": "b5a00e27-42e6-4a06-8d0a-820e58bd1c6e",
                                "sense_id": "8bf19702-2efd-325a-b89a-9a08e4cc97d0",
                                "text": "А об истинном значенье // Думать мне — одно мученье // И, конечно, не игра."
                            }
                        ]
                    }
                ],
