                                "target_senses": [
                                    {
                                        "sense_id": "db24a074-0b44-30e4-acd8-f46eb170c8b6",
                                        "entry_id": "24c6263c-39ed-3177-9910-9167ba80ed53",
                                        "glosses": [
                                            "Langstreckenlauf über die Distanz von 42,195 km"
                                        ],
                                        "tags": [
                                            "Laufsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e1fd05-71f6-40df-9459-f175178aea85",
                                                "sense_id": "db24a074-0b44-30e4-acd8-f46eb170c8b6",
                                                "text": "„Der Marathonlauf (kurz Marathon genannt) ist eine auf Straßen oder Wegen ausgetragene sportliche Laufveranstaltung und zugleich die längste olympische Laufdisziplin in der Leichtathletik, deren Streckenlänge 1921 auf 42,195 Kilometer festgelegt wurde.“"
                                            },
                                            {
                                                "example_id": "ee01cc87-c64e-474d-bf75-9bd92d360bbe",
                                                "sense_id": "db24a074-0b44-30e4-acd8-f46eb170c8b6",
                                                "text": "„Diese suchte sogenannte ‹Sofasportler›, die während einem Jahr fit für einen Marathon gemacht werden.“"
                                            },
                                            {
                                                "example_id": "4abaa4e1-6215-45e2-9dfe-4f0e73f917fd",
                                                "sense_id": "db24a074-0b44-30e4-acd8-f46eb170c8b6",
                                                "text": "„Hoffmann ist 52 und sieht aus, als liefe er Marathon oder betriebe Höhenbergsteigen: fast mager, immer ein bisschen durch den Wind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
