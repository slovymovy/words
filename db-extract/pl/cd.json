                                        "glosses": [
                                            "разг. то же, что компакт-диск"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e231842-9cde-43d7-a921-9a5d595a786c",
                                                "sense_id": "fc1a61b3-7e42-3f41-98d8-e0e0eaca40bf",
                                                "text": "Именно такие источники питания подходят к фотоаппаратам со вспышками, видеокамерам, портативным проигрывателям сиди- и мини-дисков, портативным компьютерам."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сиди",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bdcab517-8dcb-3147-a26f-9c4508018b00",
                                        "entry_id": "6b07df08-d8ff-3a9b-8e9d-82a7b9b5a0a9",
                                        "glosses": [
                                            "форма второго лица единственного числа повелительного наклонения глагола сидеть"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
