{
    "word_family": [
        "cynic",
        "cynicism",
        "cynically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "932ce4fc-a5c6-3540-aad2-a0536faee390",
                    "sense_definition": "Believing that people are motivated purely by self-interest and doubting their sincerity or integrity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "distrustful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people have become <w>cynical</w> about politics because of the constant broken promises.",
                            "target_lang_translations": {
                                "ru": "Многие люди стали <w>цинично</w> относиться к политике из-за постоянных невыполненных обещаний."
                            }
                        },
                        {
                            "text": "He has a <w>cynical</w> view of human nature and rarely trusts anyone's motives.",
                            "target_lang_translations": {
                                "ru": "У него <w>циничный</w> взгляд на человеческую природу, и он редко доверяет чьим-либо мотивам."
                            }
                        }
                    ],
                    "synonyms": [
                        "skeptical",
                        "distrustful",
                        "suspicious",
                        "pessimistic"
                    ],
                    "antonyms": [
                        "idealistic",
                        "trusting",
                        "optimistic",
                        "naive"
                    ],
                    "common_phrases": [
                        "cynical view",
                        "cynical about politics",
                        "cynical attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убежденность в том, что люди руководствуются исключительно корыстными интересами, и сомнение в их искренности или честности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "циничный",
                                "target_lang_sense_clarification": "о взглядах на людей"
                            },
                            {
                                "target_lang_word": "скептический",
                                "target_lang_sense_clarification": "недоверчивый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "907e5b1f-f8fb-3522-9881-eda61e1a7fe7",
                    "sense_definition": "Showing a mocking or jaded lack of faith in the value of something or the goodness of others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distrustful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>cynical</w> laugh when they suggested that the company cared about its employees.",
                            "target_lang_translations": {
                                "ru": "Она <w>цинично</w> рассмеялась, когда предположили, что компания заботится о своих сотрудниках."
                            }
                        },
                        {
                            "text": "He made a <w>cynical</w> remark about how the charity was just a tax write-off for the rich.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>циничное</w> замечание о том, что благотворительность — это всего лишь списание налогов для богатых."
                            }
                        }
                    ],
                    "synonyms": [
                        "sardonic",
                        "mocking",
                        "jaded",
                        "scornful"
                    ],
                    "antonyms": [
                        "sincere",
                        "earnest"
                    ],
                    "common_phrases": [
                        "cynical remark",
                        "cynical laugh",
                        "cynical smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление насмешливого или разочарованного отсутствия веры в ценность чего-либо или доброту других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "циничный",
                                "target_lang_sense_clarification": "насмешливо-недоверчивый"
                            },
                            {
                                "target_lang_word": "скептический",
                                "target_lang_sense_clarification": "полный сомнения"
                            },
                            {
                                "target_lang_word": "саркастический",
                                "target_lang_sense_clarification": "язвительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11626c0c-84a3-3fc4-869a-7e6d5180c4d5",
                    "sense_definition": "Showing a complete lack of concern for whether an action is morally right or proper.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unethical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The decision to raise prices during the crisis was a <w>cynical</w> ploy to increase profits.",
                            "target_lang_translations": {
                                "ru": "Решение поднять цены во время кризиса было <w>циничной</w> уловкой для увеличения прибыли."
                            }
                        },
                        {
                            "text": "It was a <w>cynical</w> exploitation of the public's fears for political gain.",
                            "target_lang_translations": {
                                "ru": "Это была <w>циничная</w> эксплуатация страхов общественности ради политической выгоды."
                            }
                        }
                    ],
                    "synonyms": [
                        "unscrupulous",
                        "exploitative",
                        "callous"
                    ],
                    "antonyms": [
                        "ethical",
                        "principled"
                    ],
                    "common_phrases": [
                        "cynical ploy",
                        "cynical exploitation",
                        "cynical manipulation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полное отсутствие заботы о том, является ли действие морально правильным или подобающим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "циничный",
                                "target_lang_sense_clarification": "беспринципный и корыстный"
                            },
                            {
                                "target_lang_word": "бесстыдный",
                                "target_lang_sense_clarification": "наглый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33feb58e-6dfe-3a18-b619-4ed154018b1a",
                    "sense_definition": "Relating to the Cynics, a school of Ancient Greek philosophers who emphasized virtue and self-control.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cynical</w> philosophers of old sought to live in accordance with nature rather than social convention.",
                            "target_lang_translations": {
                                "ru": "Философы-<w>киники</w> древности стремились жить в соответствии с природой, а не с общественными условностями."
                            }
                        },
                        {
                            "text": "Diogenes is perhaps the most famous figure associated with <w>cynical</w> thought.",
                            "target_lang_translations": {
                                "ru": "Диоген, пожалуй, самая известная фигура, связанная с <w>кинической</w> мыслью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cynical philosophy",
                        "cynical school"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often capitalized as Cynical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к киникам, школе древнегреческих философов, подчеркивавших добродетель и самоконтроль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кинический",
                                "target_lang_sense_clarification": "относящийся к школе киников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da26f81-6bfc-3423-b2e6-31f688a3c8c5",
                    "sense_definition": "Resembling the facial expressions or movements of a snarling dog, often used in a medical context regarding spasms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered from a <w>cynical</w> spasm that caused his facial muscles to contort painfully.",
                            "target_lang_translations": {
                                "ru": "Пациент страдал от <w>цинического</w> спазма, из-за которого мышцы его лица мучительно сокращались."
                            }
                        },
                        {
                            "text": "Historical medical texts describe the <w>cynical</w> contraction of the jaw as a symptom of certain diseases.",
                            "target_lang_translations": {
                                "ru": "В исторических медицинских текстах <w>циническое</w> сокращение челюсти описывается как симптом определенных заболеваний."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cynical spasm"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older medical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий выражение морды или движения оскалившейся собаки; часто используется в медицинском контексте относительно спазмов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цинический",
                                "target_lang_sense_clarification": "медицинский термин, напоминающий оскал"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}