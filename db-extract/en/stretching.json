                "senses": [
                    {
                        "sense_id": "c43084a5-8e4d-323a-aed9-a78a08e02aeb",
                        "entry_id": "146b454e-3832-3649-9786-046f9220d3a7",
                        "glosses": [
                            "The act by which something is stretched."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "88d07d5f-be7e-45f0-8692-0ff3b933d892",
                                "sense_id": "c43084a5-8e4d-323a-aed9-a78a08e02aeb",
                                "text": "[Skins] must be submitted to several washings, treadings, and stretchings, before they acquire the necessary pliancy."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0ab5aeb-2624-356e-a582-3e97c5b0f900",
                        "entry_id": "146b454e-3832-3649-9786-046f9220d3a7",
                        "glosses": [
                            "A form of physical exercise in which a specific skeletal muscle (or muscle group) is deliberately elongated to its fullest length in order to improve the muscle's felt elasticity and reaffirm comfortable muscle tone."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54c0952a-b87e-450f-ab00-5bea83e75467",
                        "source_entry_id": "146b454e-3832-3649-9786-046f9220d3a7",
