                        "examples": [
                            {
                                "example_id": "b378af4a-cc8d-4d79-8bb4-a1d9b4f07483",
                                "sense_id": "7e8f0022-0c68-3452-bf3a-73a510fae6db",
                                "text": "„Längs der Wände standen wacklige Tische auf Bambusbeinen, in der Mitte, auf dem glänzenden Linoleumboden, tanzten einige hemdärmelige Paare.“"
                            },
                            {
                                "example_id": "f45001fe-9503-4577-b5c9-efcbb92fcfd3",
                                "sense_id": "7e8f0022-0c68-3452-bf3a-73a510fae6db",
                                "text": "„Tränen rannen über ihre Wangen und tropften vom Kinn auf den grauen Linoleumboden.“"
                            }
                        ],
