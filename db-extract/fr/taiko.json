                        "sense_id": "d2c3f4bb-a4f2-307b-8ff4-9d4da4f16bab",
                        "entry_id": "b062b767-25d8-3d49-bc81-05bebe6dc8ef",
                        "glosses": [
                            "Gros tambour japonais, dont on joue avec deux baguettes. Il est sculpté dans un tronc de zelkova ou d’orme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fca514b-4143-41a4-8ecd-21bb15b91fcc",
                                "sense_id": "d2c3f4bb-a4f2-307b-8ff4-9d4da4f16bab",
                                "text": "Le taiko est un grand tambour suspendu, souvent décoré d’un motif de flammes, il est censé indiquer le temps principal de chaque phrase, tandis que le kakko, petit tambour et le shōko, petit gong de bronze, complètent les motifs rythmiques."
                            },
                            {
                                "example_id": "e9053ea6-8abb-44f7-8d56-df3eb2af71d6",
                                "sense_id": "d2c3f4bb-a4f2-307b-8ff4-9d4da4f16bab",
                                "text": "[…] au fond, les musiciennes, artistes du shamisen et du tambourin (taiko)."
                            }
                        ]
                    }
