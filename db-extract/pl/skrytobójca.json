                "senses": [
                    {
                        "sense_id": "0354201c-efb0-305d-9fcc-52843f484ba6",
                        "entry_id": "9f5ad2de-72c3-36b3-bd4d-d560cd871ec1",
                        "glosses": [
                            "osoba, która popełnia skrytobójstwo; zabija podstępnie, zza węgła, z ukrycia"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "b9b33b7d-3623-4d83-9864-db91d6b3634d",
                                "sense_id": "0354201c-efb0-305d-9fcc-52843f484ba6",
                                "text": "Szczerość Priyanki może wzruszać, ale niewykluczone, że nie spieszy się jej do polityki także dlatego, iż pamięta, jak skończyły się kariery Indiry i Rajiva Gandhich: przerwały je kule skrytobójców"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f7f43ce-4f72-48f2-acf0-4a6bf74ad049",
                        "source_entry_id": "9f5ad2de-72c3-36b3-bd4d-d560cd871ec1",
                        "source_sense_id": "0354201c-efb0-305d-9fcc-52843f484ba6",
                        "target_lang_word": "Meuchelmörder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meuchelmörder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8403b18d-43b4-3903-a4ff-20b36e6caadf",
                                        "entry_id": "54c03602-883c-37f8-bcf9-ec52330c67ab",
                                        "glosses": [
                                            "Person, die einen Meuchelmord begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc970a8-60fc-4fd1-a782-143ff3f77665",
                                                "sense_id": "8403b18d-43b4-3903-a4ff-20b36e6caadf",
                                                "text": "In der Region treibt ein Meuchelmörder sein Unwesen."
                                            },
                                            {
                                                "example_id": "6c8feb14-76f2-4a4a-bd1d-697c00efc5eb",
                                                "sense_id": "8403b18d-43b4-3903-a4ff-20b36e6caadf",
                                                "text": "„Ich erwiderte ihr, ich hätte geträumt, sie sei so böse auf mich, daß sie mit Meuchelmördern gesprochen hätte, um mich umbringen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
