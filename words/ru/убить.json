{
    "word_family": [
        "убийство",
        "убийца",
        "самоубийство",
        "убой",
        "убийственный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b949f686-202c-3a6a-90dd-b2475191e8b9",
                    "sense_definition": "Лишить жизни, умертвить кого-либо или что-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Охотнику удалось <убить> крупного зверя одним выстрелом.",
                            "target_lang_translations": {
                                "en": "The hunter managed to <w>kill</w> a large beast with one shot.",
                                "pl": "Myśliwemu udało się <w>zabić</w> duże zwierzę jednym strzałem."
                            }
                        },
                        {
                            "text": "Солдат был <убит> во время сражения за город.",
                            "target_lang_translations": {
                                "en": "The soldier was <w>killed</w> during the battle for the city.",
                                "pl": "Żołnierz został <w>zabity</w> podczas bitwy o miasto."
                            }
                        }
                    ],
                    "synonyms": [
                        "уничтожить",
                        "лишить жизни",
                        "прикончить"
                    ],
                    "antonyms": [
                        "оживить",
                        "воскресить",
                        "реанимировать"
                    ],
                    "common_phrases": [
                        "убить человека",
                        "убить животное",
                        "убить врага",
                        "убить наповал"
                    ],
                    "target_lang_definitions": {
                        "en": "To deprive of life, to cause the death of someone or something.",
                        "pl": "Pozbawić kogoś lub coś życia, spowodować śmierć."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "to cause death"
                            },
                            {
                                "target_lang_word": "murder",
                                "target_lang_sense_clarification": "to kill unlawfully"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zabić",
                                "target_lang_sense_clarification": "pozbawić życia"
                            },
                            {
                                "target_lang_word": "zamordować",
                                "target_lang_sense_clarification": "zabić z premedytacją"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b18159b7-5ac4-3119-b9b7-acd17b8bdbb9",
                    "sense_definition": "Заполнить чем-либо свободное время, чтобы оно прошло быстрее.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили сыграть в карты, чтобы <убить> время до поезда.",
                            "target_lang_translations": {
                                "en": "We decided to play cards to <w>kill</w> time before the train.",
                                "pl": "Postanowiliśmy zagrać w karty, żeby <w>zabić</w> czas do przyjazdu pociągu."
                            }
                        },
                        {
                            "text": "Пассажир читал журнал, пытаясь <убить> скучные часы ожидания.",
                            "target_lang_translations": {
                                "en": "The passenger was reading a magazine, trying to <w>kill</w> the boring hours of waiting.",
                                "pl": "Pasażer czytał czasopismo, próbując <w>zabić</w> nudne godziny oczekiwania."
                            }
                        }
                    ],
                    "common_phrases": [
                        "убить время",
                        "убить час",
                        "убить вечер"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To occupy oneself with something to make time pass faster.",
                        "pl": "Zajmować się czymś, aby czas szybciej upłynął."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "to make time pass"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zabić czas",
                                "target_lang_sense_clarification": "spędzić czas na czymś, by szybciej minął"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cce30947-e1ff-3384-90d0-727da5c2db81",
                    "sense_definition": "Уничтожить или разрушить что-либо нематериальное (чувства, надежды, талант).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Грубые слова могут <убить> любовь и доверие навсегда.",
                            "target_lang_translations": {
                                "en": "Rude words can <w>kill</w> love and trust forever.",
                                "pl": "Szorstkie słowa mogą na zawsze <w>zabić</w> miłość i zaufanie."
                            }
                        },
                        {
                            "text": "Постоянная критика способна <убить> в человеке любой талант.",
                            "target_lang_translations": {
                                "en": "Constant criticism can <w>kill</w> any talent in a person.",
                                "pl": "Ciągła krytyka potrafi <w>zabić</w> w człowieku każdy talent."
                            }
                        }
                    ],
                    "synonyms": [
                        "разрушить",
                        "уничтожить",
                        "умножить на ноль"
                    ],
                    "antonyms": [
                        "восстановить",
                        "построить",
                        "оживить"
                    ],
                    "common_phrases": [
                        "убить надежду",
                        "убить веру",
                        "убить любовь",
                        "убить талант"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To destroy or ruin something intangible (feelings, hopes, talent).",
                        "pl": "Zniszczyć lub unicestwić coś niematerialnego, np. uczucia, nadzieje lub talent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "to destroy hopes or feelings"
                            },
                            {
                                "target_lang_word": "destroy",
                                "target_lang_sense_clarification": "to put an end to"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zabić",
                                "target_lang_sense_clarification": "zniszczyć uczucia lub nadzieje"
                            },
                            {
                                "target_lang_word": "zdusić",
                                "target_lang_sense_clarification": "stłumić, np. talent lub entuzjazm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6dc1e40-8e91-36a0-a0d8-50d1d539d685",
                    "sense_definition": "Бесполезно, неразумно или напрасно истратить (деньги, силы, здоровье).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они <убили> кучу денег на ремонт старого дома.",
                            "target_lang_translations": {
                                "en": "They <w>wasted</w> a heap of money on renovating the old house.",
                                "pl": "<w>Zmarnowali</w> mnóstwo pieniędzy na remont starego domu."
                            }
                        },
                        {
                            "text": "Не стоит <убивать> свои силы на этот бессмысленный проект.",
                            "target_lang_translations": {
                                "en": "It is not worth <w>wasting</w> your energy on this senseless project.",
                                "pl": "Nie warto <w>marnować</w> sił na ten bezsensowny projekt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "убить деньги",
                        "убить молодость",
                        "убить здоровье",
                        "убить силы"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To waste or spend uselessly (money, effort, health).",
                        "pl": "Marnować coś bezproduktywnie, np. pieniądze, siły lub zdrowie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "waste",
                                "target_lang_sense_clarification": "money or effort"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "health"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zmarnować",
                                "target_lang_sense_clarification": "stracić bezproduktywnie"
                            },
                            {
                                "target_lang_word": "trwonić",
                                "target_lang_sense_clarification": "lekkomyślnie wydawać pieniądze lub siły"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "822a8337-19c6-33df-b300-fd3e06e4010d",
                    "sense_definition": "Привести в состояние сильного расстройства, отчаяния или потрясения.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это печальное известие окончательно <убило> бедную женщину.",
                            "target_lang_translations": {
                                "en": "This sad news completely <w>devastated</w> the poor woman.",
                                "pl": "Ta smutna wiadomość ostatecznie <w>zdruzgotała</w> biedną kobietę."
                            }
                        },
                        {
                            "text": "Его равнодушие просто <убивает> меня.",
                            "target_lang_translations": {
                                "en": "His indifference is simply <w>killing</w> me.",
                                "pl": "Jego obojętność po prostu mnie <w>dobija</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "огорошить"
                    ],
                    "antonyms": [
                        "оживить"
                    ],
                    "common_phrases": [
                        "убить горем",
                        "убить новостью",
                        "меня это убивает"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cause severe distress, despair, or shock.",
                        "pl": "Doprowadzić kogoś do stanu głębokiego przygnębienia, rozpaczy lub szoku."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "devastate",
                                "target_lang_sense_clarification": "to overwhelm with shock or grief"
                            },
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "figurative: to cause great distress"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zdruzgotać",
                                "target_lang_sense_clarification": "wprawić w stan rozpaczy"
                            },
                            {
                                "target_lang_word": "dobić",
                                "target_lang_sense_clarification": "sprawić komuś wielki ból psychiczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2bf2723-650f-3f12-bdc9-92bb9a4132b0",
                    "sense_definition": "В карточных играх: покрыть карту противника старшей картой или козырем.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Игрок смог <убить> валета своим козырным тузом.",
                            "target_lang_translations": {
                                "en": "The player managed to <w>beat</w> the jack with his trump ace.",
                                "pl": "Gracz zdołał <w>przebić</w> waleta swoim atutowym asem."
                            }
                        },
                        {
                            "text": "Тебе нечем <убить> эту карту, поэтому бери её себе.",
                            "target_lang_translations": {
                                "en": "You have nothing to <w>beat</w> this card with, so take it.",
                                "pl": "Nie masz czym <w>przebić</w> tej karty, więc weź ją do siebie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "убить козырем",
                        "убить карту",
                        "убить туза"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In card games: to beat an opponent's card with a higher card or trump.",
                        "pl": "W grach karcianych: przebić kartę przeciwnika wyższą kartą lub atutem."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beat",
                                "target_lang_sense_clarification": "a card"
                            },
                            {
                                "target_lang_word": "trump",
                                "target_lang_sense_clarification": "to beat with a trump card"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przebić",
                                "target_lang_sense_clarification": "w grach karcianych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d623a8e-9f1a-3557-800f-371162a88431",
                    "sense_definition": "Сломать технику, вывести механизм из строя или удалить компьютерный файл.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Плохие дороги быстро <убили> подвеску моего автомобиля.",
                            "target_lang_translations": {
                                "en": "Bad roads quickly <w>ruined</w> my car's suspension.",
                                "pl": "Złe drogi szybko <w>zniszczyły</w> zawieszenie mojego samochodu."
                            }
                        },
                        {
                            "text": "Системный администратор случайно <убил> важный процесс на сервере.",
                            "target_lang_translations": {
                                "en": "The system administrator accidentally <w>killed</w> an important process on the server.",
                                "pl": "Administrator systemu przypadkowo <w>zabił</w> ważny proces na serwerze."
                            }
                        }
                    ],
                    "antonyms": [
                        "восстановить"
                    ],
                    "common_phrases": [
                        "убить процесс",
                        "убить файл",
                        "убить двигатель"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To break equipment, disable a mechanism, or delete a computer file.",
                        "pl": "Zepsuć urządzenie, uszkodzić mechanizm lub usunąć plik komputerowy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "a process or engine"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "equipment or mechanisms"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zniszczyć",
                                "target_lang_sense_clarification": "uszkodzić mechanizm"
                            },
                            {
                                "target_lang_word": "zamknąć",
                                "target_lang_sense_clarification": "zakończyć proces komputerowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1201f53f-3dfb-3593-95ff-7b25139fab87",
                    "sense_definition": "Сильно уплотнить, утрамбовать поверхность чего-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочие тщательно <убили> глиняный пол в доме.",
                            "target_lang_translations": {
                                "en": "The workers carefully <w>tamped</w> the clay floor in the house.",
                                "pl": "Robotnicy starannie <w>ubili</w> glinianą podłogę w domu."
                            }
                        },
                        {
                            "text": "Дождь прибил и <убил> дорожную пыль.",
                            "target_lang_translations": {
                                "en": "The rain beat down and <w>settled</w> the road dust.",
                                "pl": "Deszcz przybił i <w>przytłumił</w> kurz na drodze."
                            }
                        }
                    ],
                    "synonyms": [
                        "уплотнить",
                        "утрамбовать",
                        "прибить",
                        "утоптать",
                        "прихлопать"
                    ],
                    "antonyms": [
                        "разрыхлить"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "or technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To tightly pack or tamp down a surface.",
                        "pl": "Mocno ubić lub zagęścić powierzchnię czegoś."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tamp",
                                "target_lang_sense_clarification": "to pack down earth or clay"
                            },
                            {
                                "target_lang_word": "pack",
                                "target_lang_sense_clarification": "to make compact"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ubić",
                                "target_lang_sense_clarification": "zagęścić ziemię lub grunt"
                            },
                            {
                                "target_lang_word": "utwardzić",
                                "target_lang_sense_clarification": "uczynić powierzchnię twardszą"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}