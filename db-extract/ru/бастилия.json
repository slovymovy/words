                "translations": [
                    {
                        "translation_id": "64bba775-75ce-4d50-b073-8df55c5f5b58",
                        "source_entry_id": "48f25d43-96e5-32a5-90c2-366d02ba1579",
                        "source_sense_id": "3f7d1c41-3797-3a3b-b9c8-57142c3974bc",
                        "target_lang_word": "Bastille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bastille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "093bff51-f195-3516-9caf-abfd19d099d7",
                                        "entry_id": "ed63ada2-ed41-3dc1-b611-4a207165c890",
                                        "glosses": [
                                            "Célèbre château-fort de Paris, devenu prison d’État, qui fut pris par le peuple et détruit en 1789."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad32e9e-522e-4d87-a355-ecb0d037f3a8",
                                                "sense_id": "093bff51-f195-3516-9caf-abfd19d099d7",
                                                "text": "Un soir on ramassa dans un tripot un petit mauvais sujet qu'on mit à la Bastille, sous le nom de l’abbé boiteux."
                                            },
                                            {
                                                "example_id": "eda6f01d-cece-4a4a-83a7-dceb61315e8e",
                                                "sense_id": "093bff51-f195-3516-9caf-abfd19d099d7",
                                                "text": "La garnison se composait de trente-deux Suisses et de quatre-vingt-deux invalides. La Bastille n'était-elle pas imprenable ?"
                                            },
                                            {
                                                "example_id": "b520da22-4df9-4088-ae37-e5f069066074",
                                                "sense_id": "093bff51-f195-3516-9caf-abfd19d099d7",
                                                "text": "Et pour mettre le comble à cette adoration de la force, à ces implacabilités du pouvoir absolu, je le menais sous les murs de la Bastille, et je lui faisais savourer, comme il convient, cet isolement, ce silence, et les désespoirs muets qui pesaient sur le vaste faubourg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
