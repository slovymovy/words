                        "glosses": [
                            "Frucht der aus Südostasien stammenden Arekapalme (auch Betelpalme genannt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d38e8be-baf3-4845-8925-63cb6b9c68e2",
                                "sense_id": "a7c80e9f-c3f4-3a8d-a68c-363d7091843f",
                                "text": "„Die Blütenstände sind zunächst in einer Scheide verborgen; nach der Bestäubung tragen sie eine große Anzahl Früchte, die späteren Betel- oder Arekanüsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef829450-6985-4a5e-8389-491ec50f634c",
                        "source_entry_id": "b048a04e-edc3-3f43-98a3-8e2cafe812d9",
                        "source_sense_id": "a7c80e9f-c3f4-3a8d-a68c-363d7091843f",
                        "source_sense_description": "Botanik: Frucht der aus Südostasien stammenden Arekapalme (auch Betelpalme genannt)",
                        "target_lang_word": "areca nut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "areca nut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0b6bee6-8b48-3507-8be1-0f51bfe564d8",
                                        "entry_id": "fd4dd4df-9e33-300e-8941-4c9ff5fbdc2c",
                                        "glosses": [
                                            "The seed of the areca palm (not a true nut but a drupe), chewed as a mild stimulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e5936e-ee0b-4876-b76d-c6a8ddcfa173",
                                                "sense_id": "a0b6bee6-8b48-3507-8be1-0f51bfe564d8",
                                                "text": "It was the custom for the Englishmen to bring auspicious gifts, like areca-nuts and saffron, as well as bills and bullion."
                                            },
                                            {
                                                "example_id": "929b9922-bb64-47cf-9bf0-21c1e572cf5b",
                                                "sense_id": "a0b6bee6-8b48-3507-8be1-0f51bfe564d8",
                                                "text": "Holding out a tray with betel leaves and areca nut, they knelt before the strapping young boys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1746bbdf-1db9-4d5c-9584-af179dc70dd1",
                        "source_entry_id": "b048a04e-edc3-3f43-98a3-8e2cafe812d9",
