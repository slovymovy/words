                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fb2d74d-47fc-4400-843f-d8bdbfab538b",
                                "sense_id": "f5782509-61db-312e-bd20-02e205439cb5",
                                "text": "„Zum gottgefälligen Büßerleben zogen sich Eremiten, Klausner und Inklusen in die Waldeinsamkeit zurück und lebten dort in Höhlen oder Hütten, vom Volk mit schaudernder Ehrfurcht bestaunt.“"
                            },
                            {
                                "example_id": "494ed566-abb9-421c-9b0d-aef823b6dd28",
                                "sense_id": "f5782509-61db-312e-bd20-02e205439cb5",
                                "text": "„Die Abtrünnigen des offiziellen Tempelglaubens führten in Qumran nicht, wie die katholische Kirche lehrt, ein zölibatäres Büßerleben.“"
                            }
                        ],
