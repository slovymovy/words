                {
                    "sense_id": "a83df702-2a39-3246-b29d-769f310f75c1",
                    "sense_definition": "Former des boucles ou des ondulations dans des cheveux ou des poils, ou s'enrouler naturellement en boucles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boucler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle utilise un fer chauffant chaque matin pour se <w>friser</w> les cheveux avant de partir."
                        },
                        {
                            "text": "L'humidité de l'air fait naturellement <w>friser</w> ses cheveux courts après la pluie."
                        }
                    ],
                    "synonyms": [
                        "boucler",
                        "onduler"
                    ],
                    "antonyms": [
                        "défriser",
                        "lisser"
                    ],
                    "common_phrases": [
                        "fer à friser",
                        "friser les cheveux"
                    ]
                },
                {
                    "sense_id": "dfaef621-db85-305e-ad02-645e7f2304f3",
                    "sense_definition": "Être tout près d'atteindre un état extrême, une limite critique ou un âge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avoisiner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son comportement excentrique commence sérieusement à <w>friser</w> le ridicule aux yeux de ses collègues."
                        },
                        {
                            "text": "Le conducteur roulait tellement vite qu'il a failli <w>friser</w> la catastrophe au virage."
                        }
                    ],
                    "synonyms": [
                        "avoisiner",
                        "côtoyer",
                        "approcher"
                    ],
                    "common_phrases": [
                        "friser le ridicule",
                        "friser la catastrophe",
                        "friser la cinquantaine"
                    ]
                },
                {
                    "sense_id": "90b85e51-1dc0-3b0c-8777-d3f867b3d6d3",
                    "sense_definition": "Passer très près de quelque chose en l'effleurant ou en le touchant à peine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "effleurer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'oiseau volait à ras de l'eau, semblant <w>friser</w> la surface sans jamais s'y mouiller."
                        },
                        {
                            "text": "La balle du joueur adverse est passée si près qu'elle a semblé lui <w>friser</w> l'oreille."
                        }
                    ],
                    "synonyms": [
                        "effleurer",
                        "frôler",
                        "raser"
                    ],
                    "common_phrases": [
                        "friser la surface"
                    ]
                },
                {
                    "sense_id": "03986213-40c5-31c6-9348-f183b04004f9",
                    "sense_definition": "Pétiller ou exprimer une gaieté malicieuse, en parlant des yeux ou du regard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "malice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand le vieil homme racontait des plaisanteries, on pouvait voir son œil qui <w>frisait</w> de malice."
                        },
                        {
                            "text": "Elle écoutait l'anecdote avec attention, le regard pétillant et les yeux qui <w>frisaient</w> d'amusement."
                        }
                    ],
                    "synonyms": [
                        "pétiller"
                    ],
                    "common_phrases": [
                        "avoir l'œil qui frise"
                    ]
                }
            ]
        }
    ]
