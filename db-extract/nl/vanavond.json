                            {
                                "example_id": "83e07c7d-bc8d-4fda-88de-5111058f8e5d",
                                "sense_id": "d96a01ff-5ae6-34a2-a607-9b8c8381fccc",
                                "text": "Ook in Zwolle is verslagen gereageerd. De restaurants van Boer in de stad die vanavond open waren sloten hun deuren om het personeel de mogelijkheid te geven om het nieuws van zijn dood te verwerken. \"Hij was meer dan een topkok\", zegt burgemeester van Zwolle Peter Snijders. \"Hij was een vernieuwer, een inspiratiebron en een trotse ambassadeur van onze stad.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b71c444a-3454-33de-99ae-2dba45f9d546",
                        "entry_id": "ab7303b4-749e-3001-85dd-1205e473f098",
                        "glosses": [
                            "tijdens de komende avond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ffc8eb9-7592-443d-a336-52f2440d0130",
                                "sense_id": "b71c444a-3454-33de-99ae-2dba45f9d546",
                                "text": "'Het lijkt me niet dat ze jou vanavond nodig heeft."
                            },
                            {
                                "example_id": "ea73edc8-997a-4907-be9b-6916c1ce77f1",
                                "sense_id": "b71c444a-3454-33de-99ae-2dba45f9d546",
                                "text": "Misschien kun je vanavond met die jongen afspreken."
                            },
                            {
                                "example_id": "0fbe5c1f-5880-44ed-b9f5-416488b08734",
                                "sense_id": "b71c444a-3454-33de-99ae-2dba45f9d546",
                                "text": "Hier ging ik vanavond slapen, helemaal in mijn eentje."
                            }
                        ]
                    }
