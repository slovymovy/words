                ],
                "senses": [
                    {
                        "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                        "entry_id": "bf0911ba-ad2f-3ec4-a1bc-c9e153c06655",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80b4697f-79ec-4169-939d-f493b8b4d19e",
                                "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                                "text": "Frau Gebhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6420315a-b6c8-4557-aa62-b9f06b13e52b",
                                "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                                "text": "Herr Gebhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2e161d88-4a14-4f5c-a157-f884ee94c502",
                                "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                                "text": "Die Gebhardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6a210f10-9b4b-4926-803e-3c3162b9d32b",
                                "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                                "text": "Der Gebhardt trägt nie die Schals, die die Gebhardt ihm strickt."
                            },
                            {
                                "example_id": "8abf431f-0a88-4a10-b9cc-1bf3402c76ae",
                                "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebhardt kommt, geht der Herr Gebhardt.“"
                            },
                            {
                                "example_id": "68a891b0-5d5d-4cc1-bff6-580d2ad52990",
                                "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                                "text": "Gebhardt kommt und geht."
                            },
                            {
                                "example_id": "e8992c19-13d8-47be-9711-31cc09ba5496",
                                "sense_id": "97ef208d-6624-3afc-892d-4da9063581ba",
                                "text": "Gebhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
