                ],
                "senses": [
                    {
                        "sense_id": "8a07a671-72e9-3092-a50e-4bc9fac5df5c",
                        "entry_id": "a51927a1-39c4-3bb3-aace-cc9e8e2ff8df",
                        "glosses": [
                            "innere Empfindung der persönlichen Lebensumstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf288bd-0c79-45c9-974b-85d84244778b",
                                "sense_id": "8a07a671-72e9-3092-a50e-4bc9fac5df5c",
                                "text": "„Unser Lebensgefühl ist die Entfremdung.“"
                            },
                            {
                                "example_id": "2df45001-7ed5-4d95-8543-9188feeb3ebf",
                                "sense_id": "8a07a671-72e9-3092-a50e-4bc9fac5df5c",
                                "text": "„Noch ein paar Jahre früher, mit Mitte vierzig, hatte sich sein bis dahin so wohltemperiertes Lebensgefühl drastisch geändert.“"
                            },
                            {
                                "example_id": "66dcef83-be38-4383-b6f3-a1e1b940bc97",
                                "sense_id": "8a07a671-72e9-3092-a50e-4bc9fac5df5c",
                                "text": "„Der Tod, dem ein handelndes Kollektiv in der Gemeinsamkeit des Kampfes und der Gefahr begegnet, zeigt ein anderes Gesicht; dann ist es, als ob nichts unser Lebensgefühl stärker zu intensivieren vermöchte als seine Nähe.“"
                            },
                            {
                                "example_id": "47b8425c-3f27-4723-b001-b4b560b9902d",
                                "sense_id": "8a07a671-72e9-3092-a50e-4bc9fac5df5c",
                                "text": "„Das Lebensgefühl der westlichen Welt oder, genauer gesagt, des nicht mehr ganz so Wilden Westens drückt sich in der Suche nach Freiheit und Selbstverwirklichung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
