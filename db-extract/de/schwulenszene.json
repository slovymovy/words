                        "examples": [
                            {
                                "example_id": "ec26053f-d4f4-455e-884a-7084eeea69a2",
                                "sense_id": "3987a0ad-3c0c-3fa9-8229-0562e080e6ad",
                                "text": "„Das Gärtnerviertel und das Glockenbachviertel sind Eldorados der Münchner Schwulenszene mit teilweise sehr edlen und stilvollen Bars und Restaurants.“"
                            },
                            {
                                "example_id": "768df14e-3500-4596-87c7-e6a0bb052fb2",
                                "sense_id": "3987a0ad-3c0c-3fa9-8229-0562e080e6ad",
                                "text": "„Sie sind das wohl schrillste Statement der Schwulenszene: Die Drag Queens. Riesige Haare, Absätze die töten können und Glitzer, Glitzer, Glitzer.“"
                            },
                            {
                                "example_id": "436ca71a-739b-46f7-88e2-754bbf6bb8ba",
                                "sense_id": "3987a0ad-3c0c-3fa9-8229-0562e080e6ad",
                                "text": "„Indem er jüngste Abhandlungen zitierte, beschrieb er, wie Malcolm X in der Schwulenszene unterwegs gewesen war und es den wohlhabenden Weißen besorgt hatte, die er später ausrauben würde.“"
                            }
                        ],
