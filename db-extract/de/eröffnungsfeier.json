                "senses": [
                    {
                        "sense_id": "4f25d7fb-3475-3964-b12d-f2ce5c930c3c",
                        "entry_id": "e59628c7-3b74-32b7-8afe-6a6583105165",
                        "glosses": [
                            "Feierlichkeit zur Eröffnung einer Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3975ca8e-70c8-4a01-903c-51b96a84f19e",
                                "sense_id": "4f25d7fb-3475-3964-b12d-f2ce5c930c3c",
                                "text": "Die Eröffnungsfeier der Olympischen Spiele wird live im Fernsehen übertragen."
                            },
                            {
                                "example_id": "e6b67266-7c8d-4769-b06a-7648b3327f63",
                                "sense_id": "4f25d7fb-3475-3964-b12d-f2ce5c930c3c",
                                "text": "„In Erinnerung an die Eröffnungsfeier von Shakespeare and Company, als Cyprian und Adrienne sie dazugebracht hatten, schwor Sylvia sich, es diesmal nicht zu tun, obwohl sie ebenso von Stolz und Freude erfüllt war wie damals.“"
                            }
                        ],
