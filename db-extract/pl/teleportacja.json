                                        "sense_id": "48b19d37-09e1-319f-b060-673ce1dda020",
                                        "entry_id": "b3faf767-5af9-3c73-811a-bcac94dbc885",
                                        "glosses": [
                                            "Any of many (mostly hypothetical or fictional) processes of moving matter from one spatial point to another without physically crossing the space in between and which are often depicted or described as happening instantaneously, and through dematerialization or gateways."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0495e679-4e18-4ca6-8e87-1f53558d1003",
                        "source_entry_id": "ed7a8b28-46af-3b8c-9140-48829e87c0a3",
                        "source_sense_id": "30321734-1f88-3a6f-ba75-c8c62c7bef56",
                        "target_lang_word": "téléportation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléportation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e039be05-b711-3d80-ba01-1170c73b5efa",
                                        "entry_id": "3716ecc8-8fb9-370d-837c-84707d0f04ee",
                                        "glosses": [
                                            "Action de passer d’un point à un autre sans passer par l’espace intermédiaire : dématérialisation puis rematérialisation à un endroit différent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8adfc86-837a-435e-a4a4-1d66c17b6f98",
                                                "sense_id": "e039be05-b711-3d80-ba01-1170c73b5efa",
                                                "text": "La téléportation quantique permet de reproduire à distance, en se servant des propriétés de l’intrication, l’état d’une particule quantique."
                                            },
                                            {
                                                "example_id": "b05457d5-567d-4048-bd8a-729047df8c10",
                                                "sense_id": "e039be05-b711-3d80-ba01-1170c73b5efa",
                                                "text": "Pour ce deuxième type de téléportation, les scientifiques en sont toujours à l’étape de la copie, ou un objet est détruit dans une machine pour être reproduit exactement de la même manière dans une autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9143d575-f29a-4570-a1aa-13acd13927c9",
