                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e97b0f2-ee30-33af-8b11-030c8a58f86c",
                        "entry_id": "7cf11868-42ec-3505-bef3-cbcaf8537ca7",
                        "glosses": [
                            "Qui est assez rond ; qui a un peu d’embonpoint."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d8011a06-53d0-4451-aafb-3d0446e3a511",
                                "sense_id": "8e97b0f2-ee30-33af-8b11-030c8a58f86c",
                                "text": "En face de nous un petit monsieur rondelet picorait avec vigilance dans son assiette et lia conversation dès le potage."
                            },
                            {
                                "example_id": "6ba462bc-e43e-4a8d-92ab-b53fb522e288",
                                "sense_id": "8e97b0f2-ee30-33af-8b11-030c8a58f86c",
                                "text": "Au physique, M. Jules Simon est un petit homme rondelet ; il est du nombre de ces philanthropes que l’étude des misères sociales engraisse."
                            },
                            {
                                "example_id": "3110404d-a1e1-442e-ac36-10b855669c7d",
                                "sense_id": "8e97b0f2-ee30-33af-8b11-030c8a58f86c",
                                "text": "Voyez-vous le nuage rondelet qui se déchire là-haut comme une peau d’orange ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "835c0021-b0c6-3cb7-adf6-7b882e1eec8b",
                        "entry_id": "7cf11868-42ec-3505-bef3-cbcaf8537ca7",
                        "glosses": [
                            "Qui est bien garni, ou de taille importante."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2ae6f82e-81db-460e-bc3d-85393badb8c1",
                                "sense_id": "835c0021-b0c6-3cb7-adf6-7b882e1eec8b",
                                "text": "Dès mon arrivée à Paris, dit-il, lesté d’un joli petit patrimoine assez rondelet, je fus tout de suite remarquable par le grand nombre de mes amis et de mes maîtresses…"
                            },
                            {
                                "example_id": "8badc350-1a00-466c-8195-441bf6ecc822",
                                "sense_id": "835c0021-b0c6-3cb7-adf6-7b882e1eec8b",
                                "text": "Quant aux gestionnaires de fortune, ils n’hésitent plus à ponctionner leurs clients parce que ceux-ci ont le malheur de déposer des sommes rondelettes dans leurs coffres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7a9af6f-f246-4ba3-8f64-ca3384aaa71a",
                        "source_entry_id": "7cf11868-42ec-3505-bef3-cbcaf8537ca7",
                        "source_sense_description": "Qui est assez rond",
                        "target_lang_word": "rundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rundlich",
