                        "examples": []
                    },
                    {
                        "sense_id": "71d25c54-9d86-3f6f-bb9b-226d1d1fff8a",
                        "entry_id": "7bf672a6-6532-3e4f-a693-03ca5d4fa6e6",
                        "glosses": [
                            "Something that acts or spreads quickly and uncontrollably."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd843c6-b14c-4384-af20-38e2ed5e7b82",
                                "sense_id": "71d25c54-9d86-3f6f-bb9b-226d1d1fff8a",
                                "text": "“It was my own personal watch and I wanted to change the face,” she said in an interview during a recent business trip to New York. “I started wearing it, and it was wildfire — everybody wanted one.”"
                            },
                            {
                                "example_id": "8b072ee3-2d8c-4fbf-b984-6fb4b4456a5a",
                                "sense_id": "71d25c54-9d86-3f6f-bb9b-226d1d1fff8a",
                                "text": "So, it appears a revolution has happened and a very unexpected one. Of course it was only a matter of time before it happened. With WiFi connectivity spreading faster than wildfire and a laptop or tablet in one’s bag, what’s the point of a mobile nowadays?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c63cc4c9-c229-4bd2-93be-1f44d51ba29f",
                        "source_entry_id": "7bf672a6-6532-3e4f-a693-03ca5d4fa6e6",
                        "source_sense_description": "rapidly spreading fire",
                        "target_lang_word": "feu de forêt",
