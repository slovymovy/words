                "senses": [
                    {
                        "sense_id": "433c249e-69ca-30ce-ae65-4f8ff4883b43",
                        "entry_id": "1975d390-3298-39c7-87a9-9133e5bc163a",
                        "glosses": [
                            "in seinem ursprünglichen Aufgabengebiet nicht mehr benötigter Mitarbeiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73012e70-5b80-44be-8db5-56df286f2eeb",
                                "sense_id": "433c249e-69ca-30ce-ae65-4f8ff4883b43",
                                "text": "„Das Zentrale Personalüberhangmanagement ist nun zuständige Dienstbehörde und Personalstelle für alle Überhangkräfte des Landes.“"
                            },
                            {
                                "example_id": "1684b91b-2933-4bd8-a016-108d535083f6",
                                "sense_id": "433c249e-69ca-30ce-ae65-4f8ff4883b43",
                                "text": "„Insgesamt 3200 Überhangkräfte des Öffentlichen Dienstes sollen auf freie Stellen vermittelt werden.“"
                            },
                            {
                                "example_id": "5631cb5f-68bc-47c0-b49b-0a3f15faaf6b",
                                "sense_id": "433c249e-69ca-30ce-ae65-4f8ff4883b43",
                                "text": "„Trotz des hohen Altersdurchschnitts der Belegschaft müssen hierbei Maßnahmen ergriffen werden, um diese Überhangkräfte für künftige Einsatzmöglichkeiten zu qualifizieren und ihnen damit eine berufliche Perspektive zu ermöglichen.“"
                            },
                            {
                                "example_id": "4ef7fd6d-44c1-487e-93c6-29cec9af2d7a",
                                "sense_id": "433c249e-69ca-30ce-ae65-4f8ff4883b43",
                                "text": "„Vielmehr sollen nunmehr mit dem Programm die Überhangkräfte abgesichert werden, so dass das Programm kaum noch zusätzliche Beschäftigungswirkungen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
