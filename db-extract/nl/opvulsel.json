                        "entry_id": "aeda6d15-1c00-3536-a6e6-d4c935c98bef",
                        "glosses": [
                            "materiaal waarmee je iets vol kan maken zonder dat dit materiaal erg waardevol of belangrijk is vaak in figuurlijke zin gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05c2f267-8fa0-47a5-b78f-37dfe308c932",
                                "sense_id": "58dbd622-7138-388b-963b-66659421b0b0",
                                "text": "Ik denk dat het vooral komt doordat in het deel over Wessel tamelijk veel ’opvulsel’ zit, zoals de al genoemde vergaderingen."
                            },
                            {
                                "example_id": "0620715d-3ed9-46e7-ac9b-5184ebdda52f",
                                "sense_id": "58dbd622-7138-388b-963b-66659421b0b0",
                                "text": "De bokspartijtjes in Arms zijn leuk en uitdagend, maar spelvarianten als volleybal en basketbal kunnen minder boeien. Ze voelen als opvulsel."
                            },
                            {
                                "example_id": "d4db3473-35dc-4e67-8c7b-2a67b0ddfff8",
                                "sense_id": "58dbd622-7138-388b-963b-66659421b0b0",
                                "text": "Sommige hespen in de Belgische supermarkten bevatten zoveel additieven en ‘opvulsel’ dat ze buiten de wettelijke definitie van gekookte ham vallen."
                            }
                        ]
                    }
                ],
