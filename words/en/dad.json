        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4be1f8b-b207-3933-bda0-dbd0e8cabb48",
                    "sense_definition": "To perform the duties of a father; to act in a fatherly way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "parenting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is still learning how to start <w>dadding</w> effectively.",
                            "target_lang_translations": {
                                "ru": "Он всё ещё учится тому, как эффективно <w>быть папой</w>.",
                                "zh": "他还在学习如何更好地<w>尽父亲的责任</w>。"
                            }
                        },
                        {
                            "text": "After the baby was born, he spent all his time <w>dadding</w>.",
                            "target_lang_translations": {
                                "ru": "После рождения ребёнка он всё своё время <w>занимался отцовством</w>.",
                                "zh": "孩子出生后，他把所有时间都花在<w>尽父亲的责任</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parent",
                        "father"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously or informally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять отцовские обязанности; вести себя как отец.",
                        "zh": "履行父亲的职责；表现得像个父亲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть папой",
                                "target_lang_sense_clarification": "фразовый эквивалент"
                            },
                            {
                                "target_lang_word": "отцовствовать",
                                "target_lang_sense_clarification": "разговорное, редкое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尽父亲的责任",
                                "target_lang_sense_clarification": "描述履行父职的行为"
                            }
                        ]
                    }
                }
            ]
        }
