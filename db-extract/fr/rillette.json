                                "sense_id": "d88f623a-9d3d-3907-b289-b62e2781c71d",
                                "text": "Rillette aux deux saumons."
                            },
                            {
                                "example_id": "c8649589-227c-4222-981d-fad66e827e58",
                                "sense_id": "d88f623a-9d3d-3907-b289-b62e2781c71d",
