                        ],
                        "form": "die Schultüten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f95f0a49-7550-3637-9587-ab13b7b8dd61",
                        "entry_id": "dff0964f-f95b-3354-b745-4b97c7ea91b2",
                        "glosses": [
                            "eine Papiertüte, gefüllt mit Schulutensilien und/oder Naschereien, die ein Kind zu seinem ersten Schultag bekommt und mit zur Schule bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecfd68a1-b246-41a2-9c40-0e4d6393fda9",
                                "sense_id": "f95f0a49-7550-3637-9587-ab13b7b8dd61",
                                "text": "Meine Schultüte war mit vielen Süßigkeiten gefüllt."
                            },
                            {
                                "example_id": "f5d65251-7490-4221-a83a-f8de5213648e",
                                "sense_id": "f95f0a49-7550-3637-9587-ab13b7b8dd61",
                                "text": "„Und als sie dann endlich, noch vor allen anderen, aus dem Raum stürzten, stand Lea wieder auf dem Flur, mit zwei großen Schultüten beladen, die sie den strahlenden Söhnen überreichte.“"
                            },
                            {
                                "example_id": "fa12169c-60dd-49cc-ad17-b902ec56e559",
                                "sense_id": "f95f0a49-7550-3637-9587-ab13b7b8dd61",
                                "text": "„Auf Mamas Frisiertisch lag meine Schultüte.“"
                            },
                            {
                                "example_id": "64ef54ef-5a6b-4c9c-937f-c563c4c111ff",
                                "sense_id": "f95f0a49-7550-3637-9587-ab13b7b8dd61",
                                "text": "„Das schlagkräftigste Argument für mich damals war ohnehin die prächtige, bis obenhin mit Süßigkeiten gefüllte Schultüte, die mir Tante Louise nach guter deutscher Tradition mit auf den Weg gab.“"
                            },
                            {
                                "example_id": "0c61ae0a-8a0c-4d10-9463-83ceed6e7236",
                                "sense_id": "f95f0a49-7550-3637-9587-ab13b7b8dd61",
                                "text": "„In drei Wochen sollte Michaels erster Schultag sein, und die beiden Frauen machten sich Gedanken über die Schultüte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
