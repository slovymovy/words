    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a7f04456-718a-36fa-9406-0381cb7b2a85",
                    "sense_definition": "Feeling pleased and honored because of a compliment or attention that makes one feel proud.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt deeply <w>flattered</w> when the famous author praised her debut novel during the interview.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя глубоко <w>польщённой</w>, когда знаменитый автор похвалил её дебютный роман во время интервью."
                            }
                        },
                        {
                            "text": "I am <w>flattered</w> by your offer to lead the project, but I must decline due to my current workload.",
                            "target_lang_translations": {
                                "ru": "Я <w>польщён</w> вашим предложением возглавить проект, но вынужден отказаться из-за текущей нагрузки."
                            }
                        }
                    ],
                    "synonyms": [
                        "honored",
                        "pleased",
                        "gratified"
                    ],
                    "antonyms": [
                        "insulted",
                        "offended",
                        "humiliated"
                    ],
                    "common_phrases": [
                        "deeply flattered",
                        "flattered by the attention",
                        "feel flattered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство удовольствия и гордости, вызванное комплиментом или вниманием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "польщённый",
                                "target_lang_sense_clarification": "чувствующий удовлетворение своего самолюбия"
                            },
                            {
                                "target_lang_word": "приятно удивлённый",
                                "target_lang_sense_clarification": "когда внимание вызывает радость и гордость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e89852df-42bd-3cb9-a0d6-aa7ea046d898",
                    "sense_definition": "Past tense and past participle of <w>flatter</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>flattered</w> his boss for an hour, hoping to secure a promotion before the end of the year.",
                            "target_lang_translations": {
                                "ru": "Он целый час <w>льстил</w> своему боссу, надеясь получить повышение до конца года."
                            }
                        },
                        {
                            "text": "The portrait <w>flattered</w> the queen by making her look much younger than she actually was.",
                            "target_lang_translations": {
                                "ru": "Портрет <w>приукрашивал</w> королеву, делая её намного моложе, чем она была на самом деле."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «льстить»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льстил",
                                "target_lang_sense_clarification": "говорил неискренние комплименты"
                            },
                            {
                                "target_lang_word": "приукрашивал",
                                "target_lang_sense_clarification": "представлял в более выгодном свете"
                            }
                        ]
                    }
                }
            ]
        }
    ]
