                "senses": [
                    {
                        "sense_id": "4ab6a797-907c-3526-b32b-5a08aa97beca",
                        "entry_id": "2711cb70-636b-32e3-869b-1a54f380fce2",
                        "glosses": [
                            "kind dat (op een leuke manier) speels en ongehoorzaam is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c23705c2-9325-4ea1-b5d5-f1c0c1eb0a80",
                                "sense_id": "4ab6a797-907c-3526-b32b-5a08aa97beca",
                                "text": "Het beeldje 'De Kleine Deugeniet' staat niet meer op zijn sokkel. Het is niet de eerste keer dat het beeldje werd gestolen. Meestal wordt het na enkele dagen ook weer teruggeplaatst."
                            },
                            {
                                "example_id": "53be74bc-da4f-418e-8fda-fb976b7a15c3",
                                "sense_id": "4ab6a797-907c-3526-b32b-5a08aa97beca",
                                "text": "Het nieuwe college blijft zoeken naar een gepaste locatie voor een fuifzaal. Nu zal meer bepaald de Leugenberg onder de loep genomen worden. 'We gaan onderzoeken of er een fuifzaal kan ingeplant worden achter kinderspeeltuin Den Deugeniet', legt Koen Palinckx uit. Voor dat gebied zal ook een masterplan voor dagrecreatie uitgetekend worden."
                            }
                        ]
                    }
