                    {
                        "translation_id": "d216cedc-58f0-4877-b3bb-75ed6cc11d6a",
                        "source_entry_id": "7e459869-0c1f-37ab-ab56-4876fb333d2e",
                        "source_sense_id": "38b335d0-8356-306c-b775-15f6de7d3776",
                        "target_lang_word": "turn up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turn up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8245e77-3e0e-314d-8bd6-53a383206e0f",
                                        "entry_id": "5355f36d-498c-31c0-8deb-c71c58e84752",
                                        "glosses": [
                                            "To show up; to appear suddenly or unexpectedly."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c17dfa9-30fa-4a5e-be5f-3e269517d6de",
                                                "sense_id": "f8245e77-3e0e-314d-8bd6-53a383206e0f",
                                                "text": "Is this your t-shirt that turned up in my drawer?"
                                            },
                                            {
                                                "example_id": "2ecf93e0-7e8c-442c-93c6-da7f9aa4093b",
                                                "sense_id": "f8245e77-3e0e-314d-8bd6-53a383206e0f",
                                                "text": "I don't like people turning up without an appointment."
                                            },
                                            {
                                                "example_id": "3b5c9f07-cd27-4a74-8acb-ff637efd6e0e",
                                                "sense_id": "f8245e77-3e0e-314d-8bd6-53a383206e0f",
                                                "text": "Highly providential was the appearance on the scene of Corny Kelleher when Stephen was blissfully unconscious but for that man in the gap turning up at the eleventh hour the finis might have been that he might have been a candidate for the accident ward […]"
                                            },
                                            {
                                                "example_id": "8d22abdc-31d6-4122-83b9-a5b191241876",
                                                "sense_id": "f8245e77-3e0e-314d-8bd6-53a383206e0f",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f40409d-91e0-319b-aab6-92f9819f79cd",
                                        "entry_id": "5355f36d-498c-31c0-8deb-c71c58e84752",
                                        "glosses": [
                                            "To cause to appear; to find by searching, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "074bfe8e-4b39-416b-b6db-3e30324fc41f",
                                                "sense_id": "8f40409d-91e0-319b-aab6-92f9819f79cd",
                                                "text": "I spent hours in the archives, but couldn't turn up anything on the alleged criminal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d7cf7a4-fe6d-3281-92df-72af3d61502a",
                                        "entry_id": "5355f36d-498c-31c0-8deb-c71c58e84752",
                                        "glosses": [
                                            "To increase the amount of something by means of a control, such as the volume, heat, or light."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b0c753-649e-49c0-8a94-1bec8fa44ae4",
                                                "sense_id": "0d7cf7a4-fe6d-3281-92df-72af3d61502a",
                                                "text": "Turn up the radio and sing along."
                                            },
                                            {
                                                "example_id": "3be82d30-0d77-4328-b8f9-c297ff075f40",
                                                "sense_id": "0d7cf7a4-fe6d-3281-92df-72af3d61502a",
                                                "text": "Turn the rhythm up, don't you wanna just\nCome along for the ride?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082f2de4-1085-3d6d-8e9b-5587fa934850",
                                        "entry_id": "5355f36d-498c-31c0-8deb-c71c58e84752",
                                        "glosses": [
                                            "To reposition by rotating, flipping, etc., upwards."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1945e51-63ba-4386-94b6-a9747d1c11e4",
                                                "sense_id": "082f2de4-1085-3d6d-8e9b-5587fa934850",
                                                "text": "He turned up his collar against the cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45498f48-5c04-331f-8d4e-de53d1c679a6",
                                        "entry_id": "5355f36d-498c-31c0-8deb-c71c58e84752",
                                        "glosses": [
                                            "To belay or make fast (a line on a cleat or pin)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f164d2a8-befc-4967-9f78-19745ee41317",
                                                "sense_id": "45498f48-5c04-331f-8d4e-de53d1c679a6",
                                                "text": "Turn up the main halyard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83db2bf0-1449-36ab-92f8-218739e10bd9",
                                        "entry_id": "5355f36d-498c-31c0-8deb-c71c58e84752",
                                        "glosses": [
                                            "To party hard, especially when involving alcohol or drugs."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cdc457-14d0-4446-bc5b-cb93a37e39e4",
                                                "sense_id": "83db2bf0-1449-36ab-92f8-218739e10bd9",
                                                "text": "We're going to turn up at the concert tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a59c327-9a8d-3f61-a045-90be75be0a54",
                                        "entry_id": "5355f36d-498c-31c0-8deb-c71c58e84752",
                                        "glosses": [
                                            "To acquit."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c7ec975-6527-4dc9-8fc0-3533a4a34e95",
                                                "sense_id": "6a59c327-9a8d-3f61-a045-90be75be0a54",
                                                "text": "Thirty-six were cast for death, and only one was ‘topped’ (hanged), the very one that expected to be ‘turned up’ (acquitted) for highway robbery."
                                            }
                                        ]
                                    }
                                ]
                            },
