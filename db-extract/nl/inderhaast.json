                        "source_sense_description": "met grote spoed,zonder enige voorbereiding, zonder treuzelen",
                        "target_lang_word": "in a hurry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in a hurry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566ef476-27a6-3441-8c66-d044c4859185",
                                        "entry_id": "968fa832-fca6-3d36-ac84-c23195f2254f",
                                        "glosses": [
                                            "Rushed, hurried; short of time."
                                        ],
                                        "tags": [
                                            "adjectival"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00e78daf-29be-44aa-ad90-c7259caa4fa4",
                                                "sense_id": "566ef476-27a6-3441-8c66-d044c4859185",
                                                "text": "I can’t stop now. I'm in rather a hurry."
                                            },
                                            {
                                                "example_id": "9f255cfe-7ef2-4546-851d-cc1ca3198fe4",
                                                "sense_id": "566ef476-27a6-3441-8c66-d044c4859185",
                                                "text": "To worry, worry, super-scurry / Call out the troops now in a hurry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76a61ff1-eaf3-3181-9efc-e7f4f2a2f5b2",
                                        "entry_id": "968fa832-fca6-3d36-ac84-c23195f2254f",
                                        "glosses": [
                                            "In a hurried manner."
                                        ],
                                        "tags": [
                                            "adverbial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
