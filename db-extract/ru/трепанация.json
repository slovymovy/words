                            {
                                "target_word": "trepanning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75cf9ab0-aa9d-35ce-a588-11b7dfce6d63",
                                        "entry_id": "88f1e8f4-9334-3844-a957-6fb8c5519b6e",
                                        "glosses": [
                                            "The act of one who trepans."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bfdc2b2-e941-4d55-b1f3-d733e6dd7c3f",
                                                "sense_id": "75cf9ab0-aa9d-35ce-a588-11b7dfce6d63",
                                                "text": "\"I believe in the good old British public. Slow and stupid, but sound at the core. They will not stand for injustice if you can get the truth into their heads.\" \"They damned well need trepanning before you can get it there,\" said the solicitor."
                                            },
                                            {
                                                "example_id": "a01d4384-8e06-479c-b84f-bd0f3f46d6d8",
                                                "sense_id": "75cf9ab0-aa9d-35ce-a588-11b7dfce6d63",
                                                "text": "Ms. Feilding, who was known as Lady Mindbender and the Crackpot Countess, once drilled a tiny hole in her skull to increase blood flow, a medieval practice called trepanning. […] Eager to stretch the boundaries of her mind further, Ms. Feilding became obsessed with trepanning, believing that puncturing the skull relieved pressure and increased blood flow, perhaps creating a permanent high."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
