                "senses": [
                    {
                        "sense_id": "d72ae840-e763-31cd-8343-03f974d48ab4",
                        "entry_id": "54ea0b41-2ecb-37f6-ad9d-605092afac90",
                        "glosses": [
                            "plaats of gebouw gewijd aan een god of godin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7280d5e-4f81-49cd-a7d4-b8507c6edbb3",
                                "sense_id": "d72ae840-e763-31cd-8343-03f974d48ab4",
                                "text": "Het Parthenon was een belangrijk heiligdom."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dd235ea-490a-3ec4-9ef1-1b2c1e82ac27",
                        "entry_id": "54ea0b41-2ecb-37f6-ad9d-605092afac90",
                        "glosses": [
                            "plaats die voor iemand heel belangrijk is en waar hij almachtig is"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "4054d7d3-79ed-493e-95a3-8c6b5194e964",
                                "sense_id": "3dd235ea-490a-3ec4-9ef1-1b2c1e82ac27",
                                "text": "Ook als ik niet op het bestaan van de majordomus zou zijn voorbereid, had hij mij onmogelijk kunnen ontgaan. Zodra ik één voet over de drempel had gezet van zijn vesting en heiligdom, danste hij mij tegemoet. Hij verwelkomde mij met zoveel egards, krullen en arabesken dat het overduidelijk was dat ik met een professional te maken had"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e029626-4ee2-4ff3-a1e2-38dca2e5e58f",
                        "source_entry_id": "54ea0b41-2ecb-37f6-ad9d-605092afac90",
                        "source_sense_id": "d72ae840-e763-31cd-8343-03f974d48ab4",
                        "source_sense_description": "plaats of gebouw gewijd aan een god of godin",
                        "target_lang_word": "Heiligtum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiligtum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87d2fdf3-42fc-3da0-84a5-abfbce9a98e5",
                                        "entry_id": "dcbde755-b2c0-375b-8be9-6c3019f06bb3",
                                        "glosses": [
                                            "heilige Stätte zur Verehrung (eines) Gottes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5d6042-43d4-4dae-a9c7-52084cd684e8",
                                                "sense_id": "87d2fdf3-42fc-3da0-84a5-abfbce9a98e5",
                                                "text": "Nur Auserwählte dürfen das Heiligtum betreten."
                                            },
                                            {
                                                "example_id": "b2a8bf7f-833f-4257-83cc-c8c94f154e7d",
                                                "sense_id": "87d2fdf3-42fc-3da0-84a5-abfbce9a98e5",
                                                "text": "„Der islamistische Fundamentalismus hatte besorgniserregende Ausmaße angenommen; nach London war jetzt auch Brüssel zu einem Heiligtum des Terrors geworden.“"
                                            },
                                            {
                                                "example_id": "57851e72-d080-451d-abe8-493493630bd3",
                                                "sense_id": "87d2fdf3-42fc-3da0-84a5-abfbce9a98e5",
                                                "text": "„Stattdessen verbrachte er den Morgen im Heiligtum der Kirche, kniete vor dem riesigen Kruzifix und betete.“"
                                            },
                                            {
                                                "example_id": "05fc7139-9858-4ca1-931a-39a1e292c84a",
                                                "sense_id": "87d2fdf3-42fc-3da0-84a5-abfbce9a98e5",
                                                "text": "„Die Straße von Niedaltdorf nach Ihn macht eine Rechtskurve, und links liegt der Parkplatz, von dem der kleine Pfad durch den Wald auf das Heiligtum zuführt.“"
                                            },
                                            {
                                                "example_id": "aa08d1ad-0385-4b44-abe0-effa7db5a4c3",
                                                "sense_id": "87d2fdf3-42fc-3da0-84a5-abfbce9a98e5",
                                                "text": "„Siedlung und Heiligtümer verschmolzen in Manching zu einer Einheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "297eb833-1142-3daf-8918-ef904bb35b20",
                                        "entry_id": "dcbde755-b2c0-375b-8be9-6c3019f06bb3",
                                        "glosses": [
                                            "heiliger, der Verehrung würdiger Gegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe91eec-1783-416c-80b8-16c297d987c2",
                                                "sense_id": "297eb833-1142-3daf-8918-ef904bb35b20",
                                                "text": "Das Heiligtum wird vor den Augen aller verborgen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2306425-844f-46ad-aeb0-49201c803294",
                        "source_entry_id": "54ea0b41-2ecb-37f6-ad9d-605092afac90",
                        "source_sense_id": "d72ae840-e763-31cd-8343-03f974d48ab4",
                        "source_sense_description": "plaats of gebouw gewijd aan een god of godin",
                        "target_lang_word": "sanctuary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanctuary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "A place of safety, refuge, or protection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3ca2c1-fbb2-4770-a1c0-e9a9db4c85b1",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "My car is a sanctuary, where none can disturb me except for people who cut me off."
                                            },
                                            {
                                                "example_id": "3d61d001-c9ee-4dcd-bb6d-be12370270a8",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "She saw him, even as she had last gazed upon him, pale, cold, and awful; but still he was there. The coffin was to her like a shrine; all that she held most dear and most precious was within its dark and silent sanctuary."
                                            },
                                            {
                                                "example_id": "9ad6d4c9-7b01-450e-95af-b7ba9b47c6ef",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "‘I understand that the district was considered a sort of sanctuary,’ the Chief was saying. ‘An Alsatia like the ancient one behind the Strand, or the Saffron Hill before the First World War.[…]’"
                                            },
                                            {
                                                "example_id": "bf30e63b-7247-4a58-865b-cbc272f50f2b",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "In January, federal agents indicted 16 sanctuary leaders from Texas and Arizona on charges of helping to harbor illegal immigrants from Central America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "428eab59-917c-3c51-894d-50b4cc06f47e",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "An area set aside for protection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d9defc0-7b6c-4991-8ee2-52f53be57f67",
                                                "sense_id": "428eab59-917c-3c51-894d-50b4cc06f47e",
                                                "text": "The bird sanctuary has strict restrictions on visitors so the birds aren't disturbed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661767ec-9dab-3e56-a71c-e667319de03f",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "A state of being protected, asylum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd96ac0e-ccdb-4418-a377-4ed709e7e00a",
                                                "sense_id": "661767ec-9dab-3e56-a71c-e667319de03f",
                                                "text": "The government granted sanctuary to the defector, protecting him from his former government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a93d8258-452a-36b5-ac3b-4df14233491e",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "The consecrated (or sacred) area of a church or temple around its tabernacle or altar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a5e1b39-9152-4e30-b940-fc8054f1d976",
                        "source_entry_id": "54ea0b41-2ecb-37f6-ad9d-605092afac90",
                        "source_sense_id": "d72ae840-e763-31cd-8343-03f974d48ab4",
                        "source_sense_description": "plaats of gebouw gewijd aan een god of godin",
                        "target_lang_word": "sanctuaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanctuaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c257e5f-66fe-3163-aa8b-5a07143365c6",
                                        "entry_id": "a43b1c1b-bb69-33d5-981f-8473c4601d14",
                                        "glosses": [
                                            "Lieu le plus saint d’un temple ; partie interdite aux profanes dans les temples consacrés aux divinités du paganisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781656e2-e1f9-4ad7-a2f9-9797ea613a41",
                                                "sense_id": "8c257e5f-66fe-3163-aa8b-5a07143365c6",
                                                "text": "Un poème du VIIᵉ siècle conte la venue du dieu à Pythô, l’Hymne homerique à Apollon : après sa naissance, le dieu cherche un sanctuaire digne de lui et se fixe à Delphes où il tue de ses flèches un dragon, ennemi de la lumière, ou plutôt une dracène, que la Terre a suscitée."
                                            },
                                            {
                                                "example_id": "8fdc1674-d6e3-44e2-b092-6677ab696896",
                                                "sense_id": "8c257e5f-66fe-3163-aa8b-5a07143365c6",
                                                "text": "Le grand prêtre seul pouvait entrer dans le sanctuaire. — La pythie rendait ses oracles du fond du sanctuaire."
                                            },
                                            {
                                                "example_id": "651f5232-1c84-416d-95f6-e0225f46f2d3",
                                                "sense_id": "8c257e5f-66fe-3163-aa8b-5a07143365c6",
                                                "text": "Le sanctuaire d’un temple chinois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72e39baa-be61-3494-8563-4433b83731ba",
                                        "entry_id": "a43b1c1b-bb69-33d5-981f-8473c4601d14",
                                        "glosses": [
                                            "Partie de l’église où est le maitre-autel et qui est ordinairement entourée d’un chancel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b74dd3-ee87-4618-914a-ef8c10bdb039",
                                                "sense_id": "72e39baa-be61-3494-8563-4433b83731ba",
                                                "text": "Le sanctuaire, dont les piliers sont décorés des statues des Apôtres, était entièrement peint."
                                            },
                                            {
                                                "example_id": "3c875079-be57-45c0-b036-388bf8b2de1c",
                                                "sense_id": "72e39baa-be61-3494-8563-4433b83731ba",
                                                "text": "L’on y voyait à peine, le sanctuaire n’étant éclairé que par des veilleuses pendues au plafond, des veilleuses couleur d’orange sanguine et d’or trouble."
                                            },
                                            {
                                                "example_id": "3ec816a8-e936-4f70-ac8b-c2c1cf02c4a7",
                                                "sense_id": "72e39baa-be61-3494-8563-4433b83731ba",
                                                "text": "Le chancel est destiné à isoler le chœur ou sanctuaire de la nef. Le chœur est réservé aux clercs, la nef aux fidèles. Ces derniers ne peuvent pénétrer dans le chœur et doivent suivre les offices à travers la clôture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6605c783-8138-3c2a-b92a-30b3c5bf9b79",
                                        "entry_id": "a43b1c1b-bb69-33d5-981f-8473c4601d14",
                                        "glosses": [
                                            "Édifice ou lieu consacré aux cérémonies d’un culte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76780759-3290-4e65-ab5a-b32e18323801",
                                                "sense_id": "6605c783-8138-3c2a-b92a-30b3c5bf9b79",
                                                "text": "J’aurais voulu visiter le fameux sanctuaire d’Atesh-Gâh ; mais il est à vingt-deux verstes de la ville, et le temps m’eût manqué."
                                            },
                                            {
                                                "example_id": "ab22e34a-345b-4d55-9905-0a8af408340a",
                                                "sense_id": "6605c783-8138-3c2a-b92a-30b3c5bf9b79",
                                                "text": "La chapelle des fonts ou baptistère, […], est une des parties les plus remarquables de la basilique ; ce fut là, pendant des siècles, le vrai sanctuaire lorrain."
                                            },
                                            {
                                                "example_id": "d9a36cdc-7c0b-4c39-8f69-0b403710761e",
                                                "sense_id": "6605c783-8138-3c2a-b92a-30b3c5bf9b79",
                                                "text": "L'ambitieux chantier comprend notamment la construction d'un nouveau bâtiment d'accueil, la rénovation de la basilique et du petit sanctuaire, et l'aménagement d'une immense esplanade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f2d38d-9e06-3164-91e6-7e2db9aefb40",
                                        "entry_id": "a43b1c1b-bb69-33d5-981f-8473c4601d14",
                                        "glosses": [
                                            "Lieu où la puissance temporelle de l'État ne s'exerçait pas."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be142df-92d5-4423-a308-4de7bb2cc66f",
                                                "sense_id": "42f2d38d-9e06-3164-91e6-7e2db9aefb40",
                                                "text": "Il se réfugia dans le sanctuaire de telle église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6135c1d-54de-33c0-8dff-8385e926d492",
                                        "entry_id": "a43b1c1b-bb69-33d5-981f-8473c4601d14",
                                        "glosses": [
                                            "Lieu où s'exerce une activité profondément respectée ou particulièrement révérée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00de26b8-f5de-4a6a-82a6-ed7e7c6bf9b0",
                                                "sense_id": "b6135c1d-54de-33c0-8dff-8385e926d492",
                                                "text": "Le jour où ils ont suffisamment pénétré dans les sanctuaires de l’État, dans les salons, dans les lieux de plaisir, ils cessent généralement d’être révolutionnaires et parlent savamment de l’évolution."
                                            },
                                            {
                                                "example_id": "e7addcac-6c94-4701-9946-521c3312fc55",
                                                "sense_id": "b6135c1d-54de-33c0-8dff-8385e926d492",
                                                "text": "Pour encourager ce mouvement dans l’un des sanctuaires du calvinisme, le roi nomma cettui Milaud à un poste élevé dans les Eaux et Forêts, lui donna des armes et le titre de Sire de La Baudraye en lui faisant présent du fief des vrais et vieux La Baudraye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68108a62-5f26-3f0c-aebd-5f7a8fe93c3a",
                                        "entry_id": "a43b1c1b-bb69-33d5-981f-8473c4601d14",
                                        "glosses": [
                                            "Lieu où l'on est protégé de toute présence importune."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e991474-ce1a-4965-afe9-9bbd0af30295",
                                                "sense_id": "68108a62-5f26-3f0c-aebd-5f7a8fe93c3a",
                                                "text": "Un lieu à soi : mais si je suis seul chez moi, sans visiteurs, ni amis ni enfants, les murs ne reflètent que mon abandon. Le sanctuaire devient prison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
