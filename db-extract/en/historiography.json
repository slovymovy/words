                                        "entry_id": "fc1c3f45-3d7b-352c-9c88-13a5b390d0e4",
                                        "glosses": [
                                            "piśmiennictwo historyczne, czyli takie, które opisuje dzieje na podstawie badań naukowych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53cb4a6b-d1ab-4fbf-a1c6-0abf11342584",
                                                "sense_id": "dd077dab-0546-3956-8131-e2f9b002b22d",
                                                "text": "W polskiej historiografii i pamięci historycznej relacje Rzeczypospolitej z Turcją są nierzadko postrzegane przez pryzmat Polski jako przedmurza Zachodu i chrześcijaństwa, szlacheckiej republiki broniącej Europy przed jej antytezą – Imperium Osmańskim, muzułmańskim Wschodem i azjatycką despocją"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "94981457-6090-3d20-aa0c-96955a929ae3",
