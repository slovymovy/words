                                                "text": "les laiteries associées."
                                            },
                                            {
                                                "example_id": "53de003e-03cd-40d1-bf38-8fa4ec3baf10",
                                                "sense_id": "1cad3010-e0e4-37e5-a645-7105f9e030c0",
                                                "text": "Les étoiles associées."
