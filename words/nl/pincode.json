            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19221f56-1f2c-369a-9f62-f91fdece95f5",
                    "sense_definition": "Een geheime getallencode die je gebruikt om te betalen met een bankpas of om geld op te nemen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben mijn <w>pincode</w> vergeten en nu kan ik geen geld meer opnemen. ",
                            "target_lang_translations": {
                                "en": "I forgot my <w>PIN code</w> and now I can't withdraw money anymore."
                            }
                        },
                        {
                            "text": "Vergeet niet je <w>pincode</w> in te voeren als je met je bankpas betaalt.",
                            "target_lang_translations": {
                                "en": "Don't forget to enter your <w>PIN</w> when you pay with your debit card."
                            }
                        }
                    ],
                    "synonyms": [
                        "pin"
                    ],
                    "common_phrases": [
                        "pincode invoeren",
                        "geheime pincode",
                        "pincode vergeten"
                    ],
                    "target_lang_definitions": {
                        "en": "A secret numerical code used to pay with a debit card or to withdraw money."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "PIN code",
                                "target_lang_sense_clarification": "for bank card or ATM"
                            },
                            {
                                "target_lang_word": "PIN",
                                "target_lang_sense_clarification": "personal identification number for banking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54fb6420-6da0-3f5b-92a3-021c5e1f461f",
                    "sense_definition": "Een cijfercode die nodig is om toegang te krijgen tot een apparaat, account of digitaal systeem.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het aanzetten van mijn telefoon moet ik een <w>pincode</w> ingeven. ",
                            "target_lang_translations": {
                                "en": "When turning on my phone, I have to enter a <w>PIN</w>."
                            }
                        },
                        {
                            "text": "Toets de juiste <w>pincode</w> in om het gebouw te betreden.",
                            "target_lang_translations": {
                                "en": "Enter the correct <w>passcode</w> to enter the building."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pincode ingeven",
                        "juiste pincode"
                    ],
                    "target_lang_definitions": {
                        "en": "A numerical code required to access a device, account, or digital system."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "PIN code",
                                "target_lang_sense_clarification": "for device or system access"
                            },
                            {
                                "target_lang_word": "passcode",
                                "target_lang_sense_clarification": "for unlocking phones or security systems"
                            }
                        ]
                    }
                }
