                "senses": [
                    {
                        "sense_id": "99441480-1808-3f7f-a731-a476626ffa7d",
                        "entry_id": "b0928ee8-3503-34ba-bb65-206e9fc02bad",
                        "glosses": [
                            "Cesser d’éblouir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a1a4ee-c9de-4a84-abc3-39c858898f8b",
                                "sense_id": "99441480-1808-3f7f-a731-a476626ffa7d",
                                "text": "Faut-il s’étonner que l’étincelant Joseph de Maistre, que Sainte-Beuve encore mal guéri du romantisme, mal désébloui, aient trouvé Saci, Nicole, Thomas du Fossé, mornes, ternes et pour tout dire, ennuyeux ?"
                            },
                            {
                                "example_id": "20f7e2f0-dd2f-4f0a-b98a-e23136146515",
                                "sense_id": "99441480-1808-3f7f-a731-a476626ffa7d",
                                "text": "Pour comprendre, pour se déséblouir, pour revenir au privé de cet univers public, il faut recourir aux confidences."
                            }
                        ]
                    }
