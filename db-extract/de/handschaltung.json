                "senses": [
                    {
                        "sense_id": "01699db4-de69-3e08-8b72-ae1283bb3011",
                        "entry_id": "7f601275-167b-3092-ab85-1dcc9b47f8f8",
                        "glosses": [
                            "Schaltung^([4]), die von Hand betätigt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3534cd0e-3ea8-4678-ac3e-3923b2d80211",
                                "sense_id": "01699db4-de69-3e08-8b72-ae1283bb3011",
                                "text": "„Wenn bei einem richtig guten Automatikgetriebe alles passt, dann sind Schaltvorgänge kaum spürbar, das Auto beschleunigt besser als mit Handschaltung und verbraucht auch noch weniger.“"
                            },
                            {
                                "example_id": "a90b3e55-e1f4-414e-9862-f6d19f8a4cb5",
                                "sense_id": "01699db4-de69-3e08-8b72-ae1283bb3011",
                                "text": "„Das Angebot an Automatikgetrieben als Alternative zur Handschaltung wird immer breiter.“"
                            },
                            {
                                "example_id": "4e54b34e-7ea1-4625-b79a-b543323d791f",
                                "sense_id": "01699db4-de69-3e08-8b72-ae1283bb3011",
                                "text": "„Die Handschaltung – je nach Motorisierung fünf oder sechs Gänge – lässt sich präzise und mit kurzen Wegen bedienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
