                        "sense_id": "fd7f3924-5c41-36ba-b92b-e5d8643926ae",
                        "entry_id": "aa5d9bef-1f35-35db-9552-f3a96b19edb5",
                        "glosses": [
                            "Ce qui appartient en propre à un territoire considéré politiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319ecf97-754e-4828-b2a2-28f27e6a2398",
                                "sense_id": "fd7f3924-5c41-36ba-b92b-e5d8643926ae",
                                "text": "Les reprises de chaque conjoint doivent être exclusivement déduites des valeurs françaises, parce que leur imputation, même partielle, sur les biens étrangers violerait le principe de la territorialité de l’impôt"
                            },
                            {
                                "example_id": "31a35212-c73f-4af6-9fb7-9339ae4a7acd",
                                "sense_id": "fd7f3924-5c41-36ba-b92b-e5d8643926ae",
                                "text": "En matière de droit international, le principe de la territorialité doit l’emporter sur celui de la nationalité."
                            }
                        ]
                    }
                ],
