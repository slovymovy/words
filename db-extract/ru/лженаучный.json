                        "cross_references": [
                            {
                                "target_word": "pseudowissenschaftlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8babc80c-e523-3c3e-b54a-b31ac1acbf80",
                                        "entry_id": "ff29ac69-8b2c-33e8-b756-799feb128544",
                                        "glosses": [
                                            "nicht wirklich wissenschaftlich, nur dem Anschein nach wissenschaftlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891ffd07-c59f-458e-a21c-dba8dfb26468",
                                                "sense_id": "8babc80c-e523-3c3e-b54a-b31ac1acbf80",
                                                "text": "„Theorien, welche die Existenz eines Perpetuum mobiles behaupten, gelten daher als pseudowissenschaftlich, da sie nicht dasselbe unter \"Energie\" verstehen wie die Physik, sich aber in ihren Aussagen sehr wohl auf den physikalischen Begriff beziehen.“"
                                            }
                                        ],
