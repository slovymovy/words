                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a42adc-b638-4947-997b-5fd416321060",
                                "sense_id": "210955c8-3412-3dd1-8d17-2959bdbf7adc",
                                "text": "„Gebrselassie ist Amhare, Angehöriger der seit Jahrhunderten mächtigsten Volksgruppe in Äthiopien.“"
                            },
                            {
                                "example_id": "f7b678ff-5b16-430a-9964-ec917c290725",
                                "sense_id": "210955c8-3412-3dd1-8d17-2959bdbf7adc",
                                "text": "„Und wenn der Amhare Haile Selassie in Würde beerdigt wird, kann das Ministerpräsident Meles Zenawi bei dieser Volksgruppe nur noch mehr Sympathiepunkte verschaffen.“"
                            }
                        ],
