                                            "Australia",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928bf25d-8bfa-4319-bc9a-e1549e682d52",
                                                "sense_id": "d9bf7074-a78a-3411-8e73-7261343cff77",
                                                "text": "We live in a federation house."
                                            },
                                            {
                                                "example_id": "edce67eb-0085-413e-9228-8b332f271dfb",
                                                "sense_id": "d9bf7074-a78a-3411-8e73-7261343cff77",
                                                "text": "The Federation house claimed a unique place in architecture, even if it offended architects."
                                            },
                                            {
                                                "example_id": "69e43cc2-5e56-4244-b0b5-aa98aa253893",
                                                "sense_id": "d9bf7074-a78a-3411-8e73-7261343cff77",
                                                "text": "Five Chimneys, 15 Maria St, T8563 0240. Comfortable accomodation ^([sic]) in large federation house, spa, swimming pool."
                                            },
                                            {
                                                "example_id": "55e93755-8a4a-411c-acfb-40d7c1ba90db",
                                                "sense_id": "d9bf7074-a78a-3411-8e73-7261343cff77",
