                                "target_senses": [
                                    {
                                        "sense_id": "9f727230-b134-3e02-8376-03a6f49f54ae",
                                        "entry_id": "c6045ec8-03f8-3604-b58c-5b919a50e049",
                                        "glosses": [
                                            "vegetationsarme, unfruchtbare Gegend"
                                        ],
                                        "tags": [],
