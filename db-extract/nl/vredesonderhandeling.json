                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904ef78e-db68-48a6-9537-0075a4aac9e2",
                                "sense_id": "a7784d9f-900b-3273-8b56-e1d0a63c6ad4",
                                "text": "Murat verzekerde dat er reeds vredesonderhandelingen gaande waren en dat hij daarom, om nodeloos bloedvergieten te voorkomen, een wapenstilstand voorstelde."
                            },
                            {
                                "example_id": "77f6c0ba-d106-43c8-92ca-85de83039ef8",
                                "sense_id": "a7784d9f-900b-3273-8b56-e1d0a63c6ad4",
                                "text": "De Israëlische Yossi Beilin was in 1992, samen met de Noor Terje Larsen, de initiatiefnemer van een geheime vredesonderhandeling met de Palestijnen. Ze dachten dat een geheime onderhandeling succesvoller zou kunnen zijn dan de officiële onderhandelingen die in 1991 in Madrid waren begonnen."
                            }
                        ]
                    }
