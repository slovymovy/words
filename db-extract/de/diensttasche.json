                "senses": [
                    {
                        "sense_id": "725e2af7-bf2b-3cbb-8af1-eced1dbd758d",
                        "entry_id": "5ec22bdd-da39-3642-b103-6da0bfd42cad",
                        "glosses": [
                            "Tasche, die zur Dienstausrüstung gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ec322d-9331-4b1c-b44d-cb85c067cb1c",
                                "sense_id": "725e2af7-bf2b-3cbb-8af1-eced1dbd758d",
                                "text": "„Ein Mann steigt heraus – nein, ein Beamter, ein Schaffner der Reichsbahn, wie er im Buche steht: ordentliche Uniform, seine Dienstmütze sehr korrekt auf dem Kopf und die Diensttasche umgehängt, saubere Stiefel.“"
                            },
                            {
                                "example_id": "a4518585-a73d-45e1-bf6a-50fe0853982a",
                                "sense_id": "725e2af7-bf2b-3cbb-8af1-eced1dbd758d",
                                "text": "„Dort sind seit einiger Zeit sämtliche Personenzugführer ähnlich wie im Deutschen Reiche, mit einer Diensttasche aus rotem Leder ausgerüstet, die, an einem roten breiten Tragbande befestigt bandelierartig umgehangen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
