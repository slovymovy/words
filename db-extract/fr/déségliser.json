                "senses": [
                    {
                        "sense_id": "d9cfb44f-cbdf-36c3-8537-3aa437cf3350",
                        "entry_id": "e0e1fd9a-0363-3f62-89de-a22e3af12dc7",
                        "glosses": [
                            "Faire sortir, exclure de l’Église (i.e. la communauté des croyants)"
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7e5bd57d-c13e-4f77-9338-28d0752bb3eb",
                                "sense_id": "d9cfb44f-cbdf-36c3-8537-3aa437cf3350",
                                "text": "Si l'hypocrisie est satanique, il faut la DÉSÉGLISER (Retirel nan Legliz) pour que les jeunes puissent s'ouvrir dans une totale liberté."
                            },
                            {
                                "example_id": "87cd67da-c480-499c-bdde-db15769da6e3",
                                "sense_id": "d9cfb44f-cbdf-36c3-8537-3aa437cf3350",
                                "text": "Nous sommes tous trop prêts à déségliser ou à déchristianiser les autres ; de dire : « Nous sommes à Christ », avec une emphase qui signifie que les autres ne le sont pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "37393a19-ab43-39aa-806b-1b0c5e506b44",
                        "entry_id": "e0e1fd9a-0363-3f62-89de-a22e3af12dc7",
                        "glosses": [
                            "Supprimer les églises."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1c831ecd-015d-4bcc-bae0-509c7796cf77",
                                "sense_id": "37393a19-ab43-39aa-806b-1b0c5e506b44",
                                "text": "Ce fut beaucoup plus glorieux que de vouloir créer une France halal, et “déségliser” comme l’on dératise."
                            }
                        ]
                    }
                ],
