{
    "word_family": [
        "batcher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "130c6b29-0cea-343c-bd93-3e7f6c10f1d3",
                    "sense_definition": "A group or collection of things of the same kind that are dealt with at the same time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager signed a <w>batch</w> of letters before leaving the office.",
                            "target_lang_translations": {
                                "ru": "Менеджер подписал <w>пачку</w> писем перед уходом из офиса.",
                                "zh": "经理在离开办公室前签了<w>一批</w>信件。",
                                "pl": "Kierownik podpisał <w>partię</w> listów przed wyjściem z biura."
                            }
                        },
                        {
                            "text": "A new <w>batch</w> of recruits arrived at the training camp yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера в тренировочный лагерь прибыла новая <w>партия</w> новобранцев.",
                                "zh": "昨天有<w>一批</w>新兵抵达了训练营。",
                                "pl": "Nowa <w>grupa</w> rekrutów przybyła wczoraj do obozu szkoleniowego."
                            }
                        }
                    ],
                    "synonyms": [
                        "group",
                        "lot",
                        "set",
                        "collection"
                    ],
                    "common_phrases": [
                        "a batch of",
                        "the next batch",
                        "first batch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа или коллекция предметов одного типа, которые обрабатываются или рассматриваются одновременно.",
                        "zh": "指同时处理或考虑的一组同类事物。",
                        "pl": "Grupa lub zbiór przedmiotów tego samego rodzaju, które są przetwarzane lub rozpatrywane w tym samym czasie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́ртия",
                                "target_lang_sense_clarification": "товаров, документов, людей"
                            },
                            {
                                "target_lang_word": "гру́ппа",
                                "target_lang_sense_clarification": "людей, объектов"
                            },
                            {
                                "target_lang_word": "па́чка",
                                "target_lang_sense_clarification": "писем, документов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一批",
                                "target_lang_sense_clarification": "用于人或事物的集合"
                            },
                            {
                                "target_lang_word": "一堆",
                                "target_lang_sense_clarification": "用于文件或杂物"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "partia",
                                "target_lang_sense_clarification": "określona ilość towarów lub przedmiotów"
                            },
                            {
                                "target_lang_word": "grupa",
                                "target_lang_sense_clarification": "zbiór osób lub obiektów"
                            },
                            {
                                "target_lang_word": "zestaw",
                                "target_lang_sense_clarification": "komplet rzeczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47a31a0f-235d-3b7f-a47f-f0c34a6fb1e1",
                    "sense_definition": "A quantity of food, goods, or materials produced at one operation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We baked a fresh <w>batch</w> of chocolate chip cookies for the party.",
                            "target_lang_translations": {
                                "ru": "Мы испекли свежую <w>партию</w> печенья с шоколадной крошкой для вечеринки.",
                                "zh": "我们为派对烤了<w>一炉</w>新鲜的巧克力豆曲奇。",
                                "pl": "Upiekliśmy świeżą <w>partię</w> ciasteczek z kawałkami czekolady na przyjęcie."
                            }
                        },
                        {
                            "text": "The factory produced a bad <w>batch</w> of tires that had to be recalled.",
                            "target_lang_translations": {
                                "ru": "Завод выпустил бракованную <w>партию</w> шин, которую пришлось отозвать.",
                                "zh": "工厂生产了<w>一批</w>有问题的轮胎，不得不进行召回。",
                                "pl": "Fabryka wyprodukowała wadliwą <w>partię</w> opon, którą trzeba było wycofać z rynku."
                            }
                        }
                    ],
                    "synonyms": [
                        "run",
                        "lot"
                    ],
                    "common_phrases": [
                        "batch of cookies",
                        "bad batch",
                        "fresh batch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество продуктов, товаров или материалов, произведенных за один производственный цикл.",
                        "zh": "指在一次生产操作中制造出的食品、商品或材料的数量。",
                        "pl": "Ilość żywności, towarów lub materiałów wyprodukowanych w jednym cyklu operacyjnym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́ртия",
                                "target_lang_sense_clarification": "продукции, изделий"
                            },
                            {
                                "target_lang_word": "се́рия",
                                "target_lang_sense_clarification": "промышленная, изделий"
                            },
                            {
                                "target_lang_word": "по́рция",
                                "target_lang_sense_clarification": "еды, выпечки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一批",
                                "target_lang_sense_clarification": "一次生产或制作出的数量"
                            },
                            {
                                "target_lang_word": "一炉",
                                "target_lang_sense_clarification": "一次烘烤出的数量"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "partia",
                                "target_lang_sense_clarification": "ilość produkcji wytworzonej w fabryce"
                            },
                            {
                                "target_lang_word": "wsad",
                                "target_lang_sense_clarification": "porcja materiałów wkładana jednorazowo do urządzenia"
                            },
                            {
                                "target_lang_word": "porcja",
                                "target_lang_sense_clarification": "ilość jedzenia przygotowana za jednym razem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10c0a7e6-a5a5-3b73-a752-9cd606a85c95",
                    "sense_definition": "A set of data or tasks processed by a computer program at one time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system processes the invoices in <w>batches</w> overnight to save resources.",
                            "target_lang_translations": {
                                "ru": "Система обрабатывает счета <w>пакетами</w> в ночное время для экономии ресурсов.",
                                "zh": "系统在夜间<w>分批</w>处理发票以节省资源。",
                                "pl": "System przetwarza faktury <w>partiami</w> w nocy, aby oszczędzać zasoby."
                            }
                        },
                        {
                            "text": "You should upload the files in small <w>batches</w> to avoid server errors.",
                            "target_lang_translations": {
                                "ru": "Вам следует загружать файлы небольшими <w>группами</w>, чтобы избежать ошибок сервера.",
                                "zh": "你应该将文件<w>分批</w>小量上传，以避免服务器错误。",
                                "pl": "Powinieneś przesyłać pliki w małych <w>partiach</w>, aby uniknąć błędów serwera."
                            }
                        }
                    ],
                    "common_phrases": [
                        "batch processing",
                        "in batches",
                        "batch file"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор данных или задач, обрабатываемых компьютерной программой одновременно, без участия пользователя.",
                        "zh": "指计算机程序一次性处理的一组数据或任务。",
                        "pl": "Zbiór danych lub zadań przetwarzanych przez program komputerowy jednocześnie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паке́т",
                                "target_lang_sense_clarification": "данных, задач"
                            },
                            {
                                "target_lang_word": "гру́ппа",
                                "target_lang_sense_clarification": "файлов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批处理",
                                "target_lang_sense_clarification": "计算机任务处理方式"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "partia",
                                "target_lang_sense_clarification": "dane przetwarzane w trybie wsadowym"
                            },
                            {
                                "target_lang_word": "pakiet",
                                "target_lang_sense_clarification": "zbiór zadań do wykonania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "348fda18-fd9e-3be7-9036-7351f41a35d6",
                    "sense_definition": "A group of students who graduate from a school or university in the same year.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was the top student in her <w>batch</w> at medical school.",
                            "target_lang_translations": {
                                "ru": "Она была лучшей студенткой на своем <w>потоке</w> в медицинском институте.",
                                "zh": "她是医学院那<w>一届</w>学生中的佼佼者。",
                                "pl": "Była najlepszą studentką na swoim <w>roczniku</w> w szkole medycznej."
                            }
                        },
                        {
                            "text": "The alumni association organized a reunion for the <w>batch</w> of 1990.",
                            "target_lang_translations": {
                                "ru": "Ассоциация выпускников организовала встречу для <w>выпуска</w> 1990 года.",
                                "zh": "校友会为1990<w>届</w>的毕业生组织了一次聚会。",
                                "pl": "Stowarzyszenie absolwentów zorganizowało zjazd dla <w>rocznika</w> 1990."
                            }
                        }
                    ],
                    "common_phrases": [
                        "batch of",
                        "current batch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа студентов, оканчивающих учебное заведение в одном и том же году.",
                        "zh": "指在同一年毕业的学生群体。",
                        "pl": "Grupa uczniów lub studentów kończących szkołę lub uczelnię w tym samym roku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́пуск",
                                "target_lang_sense_clarification": "студентов одного года"
                            },
                            {
                                "target_lang_word": "пото́к",
                                "target_lang_sense_clarification": "группа студентов"
                            },
                            {
                                "target_lang_word": "ку́рс",
                                "target_lang_sense_clarification": "год обучения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "届",
                                "target_lang_sense_clarification": "用于毕业年份"
                            },
                            {
                                "target_lang_word": "一批",
                                "target_lang_sense_clarification": "用于学生群体"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rocznik",
                                "target_lang_sense_clarification": "osoby kończące szkołę w tym samym roku"
                            },
                            {
                                "target_lang_word": "absolwenci",
                                "target_lang_sense_clarification": "osoby, które ukończyły dany etap edukacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a76ffe7a-cf92-3bc1-a8cc-6a6371d83eec",
                    "sense_definition": "To group things together for processing or handling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software <w>batches</w> the transactions to improve efficiency.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение <w>пакетирует</w> транзакции для повышения эффективности.",
                                "zh": "该软件将交易<w>分批</w>处理以提高效率。",
                                "pl": "Oprogramowanie <w>grupuje</w> transakcje, aby zwiększyć wydajność."
                            }
                        },
                        {
                            "text": "We need to <w>batch</w> these orders before shipping them out.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>сгруппировать</w> эти заказы перед отправкой.",
                                "zh": "我们需要在发货前将这些订单<w>归类</w>。",
                                "pl": "Musimy <w>zgrupować</w> te zamówienia przed ich wysyłką."
                            }
                        }
                    ],
                    "synonyms": [
                        "group"
                    ],
                    "common_phrases": [
                        "batch together",
                        "batch up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группировать вещи вместе для совместной обработки или транспортировки.",
                        "zh": "将事物归类以便统一处理或运输。",
                        "pl": "Grupowanie rzeczy w celu ich wspólnego przetworzenia lub obsługi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группирова́ть",
                                "target_lang_sense_clarification": "объединять в группы"
                            },
                            {
                                "target_lang_word": "пакети́ровать",
                                "target_lang_sense_clarification": "формировать пакеты"
                            },
                            {
                                "target_lang_word": "комплектова́ть",
                                "target_lang_sense_clarification": "собирать в комплект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分批",
                                "target_lang_sense_clarification": "按批次处理"
                            },
                            {
                                "target_lang_word": "归类",
                                "target_lang_sense_clarification": "将事物分组"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "grupować",
                                "target_lang_sense_clarification": "łączyć w grupy"
                            },
                            {
                                "target_lang_word": "kompletować",
                                "target_lang_sense_clarification": "zbierać w całość"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0349458-40b7-30fa-b1d7-bc88f17194b9",
                    "sense_definition": "To live as a bachelor for a short time, usually while one's spouse is away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lifestyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My wife is out of town, so I am <w>batching</w> it this week.",
                            "target_lang_translations": {
                                "ru": "Моя жена в отъезде, так что на этой неделе я <w>холостякую</w>.",
                                "zh": "我妻子出城了，所以我这周在<w>过单身生活</w>。",
                                "pl": "Moja żona wyjechała z miasta, więc w tym tygodniu <w>żyję</w> jak kawaler."
                            }
                        },
                        {
                            "text": "He didn't mind <w>batching</w> for a few days while his family visited relatives.",
                            "target_lang_translations": {
                                "ru": "Он был не против <w>похолостяковать</w> несколько дней, пока его семья гостила у родственников.",
                                "zh": "他不介意在家人探亲的几天里<w>过单身生活</w>。",
                                "pl": "Nie przeszkadzało mu <w>bycie</w> słomianym wdowcem przez kilka dni, podczas gdy jego rodzina odwiedzała krewnych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "batching it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить холостяцкой жизнью в течение короткого времени, обычно пока супруга в отъезде.",
                        "zh": "指在配偶不在家时，短时间内过单身生活。",
                        "pl": "Życie w stanie kawalerskim przez krótki czas, zazwyczaj podczas nieobecności współmałżonka."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холостякова́ть",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过单身生活",
                                "target_lang_sense_clarification": "指配偶不在时的生活状态"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "być słomianym wdowcem",
                                "target_lang_sense_clarification": "idiomatyczne określenie osoby, której współmałżonek wyjechał"
                            },
                            {
                                "target_lang_word": "życie kawalerskie",
                                "target_lang_sense_clarification": "stan bycia samemu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fbd62ce5-3eda-3167-9937-245c8fc4c68d",
                    "sense_definition": "Relating to a process that operates on a specific group of items at once rather than continuously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "process_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant switched from continuous production to <w>batch</w> processing.",
                            "target_lang_translations": {
                                "ru": "Завод перешел с непрерывного производства на <w>серийную</w> обработку.",
                                "zh": "工厂从连续生产转向了<w>批量</w>处理。",
                                "pl": "Zakład przeszedł z produkcji ciągłej na przetwarzanie <w>wsadowe</w>."
                            }
                        },
                        {
                            "text": "We use a <w>batch</w> system to manage the laundry services.",
                            "target_lang_translations": {
                                "ru": "Мы используем <w>пакетную</w> систему для управления услугами прачечной.",
                                "zh": "我们使用<w>批量</w>系统来管理洗衣服务。",
                                "pl": "Używamy systemu <w>wsadowego</w> do zarządzania usługami pralniczymi."
                            }
                        }
                    ],
                    "antonyms": [
                        "continuous"
                    ],
                    "common_phrases": [
                        "batch processing",
                        "batch production"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к процессу, который обрабатывает группу элементов одновременно, а не по одному или непрерывно.",
                        "zh": "指一次处理一组项目而非连续处理的过程。",
                        "pl": "Dotyczący procesu, który działa na określonej grupie elementów jednocześnie, a nie w sposób ciągły."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паке́тный",
                                "target_lang_sense_clarification": "режим, обработка"
                            },
                            {
                                "target_lang_word": "сери́йный",
                                "target_lang_sense_clarification": "тип производства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批量的",
                                "target_lang_sense_clarification": "指生产或处理方式"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wsadowy",
                                "target_lang_sense_clarification": "dotyczący przetwarzania w partiach"
                            },
                            {
                                "target_lang_word": "seryjny",
                                "target_lang_sense_clarification": "dotyczący produkcji w seriach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8aaf5111-7a28-3946-a94b-e16d7812909f",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Batch</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бэтч</w> был известен своим вкладом в местную библиотеку.",
                                "zh": "<w>巴奇</w>先生因对当地图书馆的贡献而闻名。",
                                "pl": "Pan <w>Batch</w> był znany ze swojego wkładu w lokalną bibliotekę."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Batch</w> at the conference.",
