                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b676d4e-bc33-4378-81e9-fb774d72606e",
                                                "sense_id": "fea4de03-5954-3bd7-b4eb-4300280a6025",
                                                "text": "It's important to put a lot of thought into owning a chinchilla since they have a considerably long lifespan of 10 to 20 years.\nChinchillas are most widely known for their exceptional fur coat."
                                            },
                                            {
                                                "example_id": "4e66edb6-6637-487f-b1d7-c1a7c80e773b",
                                                "sense_id": "fea4de03-5954-3bd7-b4eb-4300280a6025",
                                                "text": "Chinchillas inhabit high elevations (3,000–5,000m) of the Chilean Andes Mountains. The chinchillas kept as pet or research animals in North America are all descendents^([sic]) of 13 founders wild caught in 1927."
                                            },
                                            {
                                                "example_id": "7b60fdc7-4261-453f-8f6c-afa57b7bf7cb",
                                                "sense_id": "fea4de03-5954-3bd7-b4eb-4300280a6025",
                                                "text": "Chinchillas are long-lived rodents that are native to South America, primarily Peru, Argentina, Bolivia, and Chile. The chinchilla is a hystricomorph (hedgehoglike) rodent closely related to guinea pigs, porcupines, and agoutis (Hrapkiewicz et al., 1998)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ef26a2-2375-3ed2-8e35-2f09da409cee",
                                        "entry_id": "55419980-10f0-3831-bac9-4086277478a6",
                                        "glosses": [
                                            "The fur of a chinchilla, used for clothing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "980454c4-1fd7-399c-af39-8d85bcd94a9a",
                                        "entry_id": "55419980-10f0-3831-bac9-4086277478a6",
                                        "glosses": [
                                            "A variety of Persian cat with white fur and green eyes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
