                "senses": [
                    {
                        "sense_id": "aa2e9b69-e780-37a4-b66d-d535fca0df4c",
                        "entry_id": "9be94a47-4fb8-379a-811c-4a48af04d30d",
                        "glosses": [
                            "Kosten für das Material, aus dem ein Gegenstand besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4c86f7-f5cb-43cc-99e1-7538aceab04b",
                                "sense_id": "aa2e9b69-e780-37a4-b66d-d535fca0df4c",
                                "text": "„Werkstoffkosten (synonym für Materialkosten) fallen grundsätzlich für Materialien an, die im Rahmen des Produktionsprozesses verarbeitet werden und in das Endprodukt eingehen.“"
                            },
                            {
                                "example_id": "d5082939-d1b2-439d-8ecb-88357b43cda3",
                                "sense_id": "aa2e9b69-e780-37a4-b66d-d535fca0df4c",
                                "text": "„In den letzten Jahren wuchsen die Verarbeitungskosten stärker als die Werkstoffkosten.“"
                            },
                            {
                                "example_id": "4cbe472a-53ae-4536-83f2-f0db7bb080d6",
                                "sense_id": "aa2e9b69-e780-37a4-b66d-d535fca0df4c",
                                "text": "„Die Werkstoffkosten sind determiniert durch die verbrauchten Werkstoffmengen und die Werkstoffpreise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
