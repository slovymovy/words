                "senses": [
                    {
                        "sense_id": "7ee116ff-73e7-3c5a-8e2a-e22750122ae8",
                        "entry_id": "e73ad982-282f-3673-aadd-31685b469de8",
                        "glosses": [
                            "Sammelbezeichnung für alle Arten des Transports von Gütern mit Verkehrsmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e788b4-618e-423d-934e-819f20c9aaa1",
                                "sense_id": "7ee116ff-73e7-3c5a-8e2a-e22750122ae8",
                                "text": "Güterverkehr findet zu Lande, zu Wasser und in der Luft statt."
                            },
                            {
                                "example_id": "db0708de-f8b9-4548-9761-f477b1eb689b",
                                "sense_id": "7ee116ff-73e7-3c5a-8e2a-e22750122ae8",
                                "text": "„Nach einer vom Institut für Mobilitätsforschung (ifmo) vorgelegten Studie werden sich die Ost-West-Güterverkehre im Zeitraum von 2005 bis 2030 verdoppeln.“"
                            },
                            {
                                "example_id": "06dba05b-932d-4caa-8598-0168cd828482",
                                "sense_id": "7ee116ff-73e7-3c5a-8e2a-e22750122ae8",
                                "text": "„Zwar bemühten sich die Betreiber von Anfang an, auch im Güterverkehr Fuß zu fassen und Geschäfte zu machen, diese Versuche waren jedoch nur von wirklich zu vernachlässigenden Erfolgen gekrönt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
