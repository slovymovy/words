                        "entry_id": "a49d48ec-35e1-3406-bb78-db8ed2fdce61",
                        "glosses": [
                            "A casual, courteous remark."
                        ],
                        "tags": [
                            "countable",
                            "proscribed",
                            "sometimes",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0d4b43db-dcf0-33c6-907c-a9a493fdfb4e",
                        "entry_id": "a49d48ec-35e1-3406-bb78-db8ed2fdce61",
                        "glosses": [
                            "A playful remark; a jest."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "26a7c339-d5e3-4cc8-9cca-48cb2734174f",
                                "sense_id": "0d4b43db-dcf0-33c6-907c-a9a493fdfb4e",
                                "text": "Charlie Mulgrew could easily have been shown two yellow cards by a stricter referee and amid all the usual Anglo-Scottish pleasantries, the two sets of fans put an awful lot of effort into trying to drown out one another’s national anthems."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f7ca7f5-326c-3953-bbab-e75f057b0821",
                        "entry_id": "a49d48ec-35e1-3406-bb78-db8ed2fdce61",
                        "glosses": [
                            "Anything that promotes pleasure or merriment."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "64939112-9884-445d-8c42-a6f09fd7689f",
                                "sense_id": "3f7ca7f5-326c-3953-bbab-e75f057b0821",
                                "text": "C.O.O: \"The office was quite close to the home of our youth—\"\nCHRM: \"Thomas, your trip to Suitopia was not meant to be for pleasantries.\"\nC.O.O: \"No… I know… But I was close by, so I went to visit them…\"\nCHRM: \"You should not have. You and I both know the way they are.\""
                            }
                        ]
                    }
