                "forms": [],
                "senses": [
                    {
                        "sense_id": "5fcd931c-5d1e-3069-8981-a57b069715e2",
                        "entry_id": "1ffa9146-57df-371b-9eb7-9cc7b544c325",
                        "glosses": [
                            "D’une manière longitudinale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee16936-bca0-4fed-a66c-9ef2dbd7fd8a",
                                "sense_id": "5fcd931c-5d1e-3069-8981-a57b069715e2",
                                "text": "Un polype coupé transversalement ou longitudinalement en deux ou plusieurs parties, ne meurt point, mais chaque partie devient en peu de temps un polype complet."
                            },
                            {
                                "example_id": "2a035bd7-247a-41f1-b05f-9f6a024bd850",
                                "sense_id": "5fcd931c-5d1e-3069-8981-a57b069715e2",
                                "text": "La conduite principale est constituée d'un tuyau Bonna en béton précontraint radialement et longitudinalement de 35 km dont 3 km en aérien pour franchir les marigots ; les tuyaux sont fabriqués sur place par centrifugation et essayés à des pressions variant de 4 à 9 kg/cm2."
                            },
                            {
                                "example_id": "cfdf4752-0a73-4e17-8c1c-f78dfe1be04b",
                                "sense_id": "5fcd931c-5d1e-3069-8981-a57b069715e2",
                                "text": "Pour la fabrication des ressorts de forme en feuillard, l'idéal est d'utiliser des feuillards d'épaisseur uniforme, aussi bien longitudinalement que transversalement. De plus, les feuillards doivent avoir une parfaite planéité."
                            }
                        ]
                    },
                    {
                        "sense_id": "72e46757-0926-397c-81ac-ce2d17e1d6b3",
                        "entry_id": "1ffa9146-57df-371b-9eb7-9cc7b544c325",
                        "glosses": [
                            "En longueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d3ea64a-1853-4d47-9a96-7ed135530dea",
                                "sense_id": "72e46757-0926-397c-81ac-ce2d17e1d6b3",
                                "text": "Mesurer une chose longitudinalement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f14c7263-e740-4993-9b1e-7ec7ddec3463",
