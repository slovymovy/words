                "senses": [
                    {
                        "sense_id": "36211658-3f13-3e1a-8c96-0e1216acc606",
                        "entry_id": "30dcac58-3fd4-3cdd-b11c-50579f96ae27",
                        "glosses": [
                            "Mensch, mit dem man außerhalb der beruflichen Arbeit und der Familie (in der Freizeit) bei einer (regelmäßigen) Aktivität Umgang (Kontakt) hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cebd9a0e-aff2-4f7c-826c-d79d9d225dbb",
                                "sense_id": "36211658-3f13-3e1a-8c96-0e1216acc606",
                                "text": "„Ohne einer Reduktion bei den Freizeitkontakten wird eine Eindämmung des Coronavirus in Österreich nicht möglich sein, gibt Simulationsforscher Niki Popper zu bedenken.“"
                            },
                            {
                                "example_id": "7785e965-f8ae-44d0-a95c-7da33cf73020",
                                "sense_id": "36211658-3f13-3e1a-8c96-0e1216acc606",
                                "text": "„Darüber hinaus gelten ähnliche Kontaktbeschränkungen wie in Bayern. Auf diese Art und Weise haben sich die Freizeitkontakte um die Hälfte reduziert.“"
                            },
                            {
                                "example_id": "351f237e-ed92-470c-8e0e-689965664493",
                                "sense_id": "36211658-3f13-3e1a-8c96-0e1216acc606",
                                "text": "„Mittlerweile kennt Nering dessen Inhalt und warnt: „Als einzige Leistung steht darin die Herstellung eines Freizeitkontakts.“ Das habe nichts mit einer Partnervermittlung zu tun, das könne auch der Kontakt zu einem Sportverein sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
