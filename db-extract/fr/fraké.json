                        "entry_id": "f10f587c-1821-3067-a853-d4bdff5b0f54",
                        "glosses": [
                            "Arbre tropical, de nom scientifique Terminalia superba, dont le bois, couleur blanc crème pouvant devenir jaune paille, est utilisé en menuiserie et dans l’ameublement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e03c947-91cf-4d81-b6db-1af154155813",
                                "sense_id": "f595a193-a029-3425-98ef-12a764c78275",
                                "text": "S’il s'agit au contraire de menuiserie intérieure courante, on préfère le bahia, le bibolo, le fraké, l’abein, le landa qui sont plus légers."
                            }
                        ]
                    }
                ],
