                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7c03080-6dd5-446f-9f46-5fb016248dac",
                                                "sense_id": "7ee54353-119f-34ed-ba79-4339c24a401e",
                                                "text": "they were messagers vnto kyng Ban & Bors sent from kynge Arthur / therfor said the viij knyghtes ye shalle dye or be prysoners / for we ben knyghtes of kyng Claudas And therwith two of them dressid theire sperys / and Vlfyus and Brastias dressid theire speres and ranne to gyder with grete raundon",
                                                "translation": "they were messengers unto King Ban and Bors sent from King Arthur. Therefore, said the eight knights, ye shall die or be prisoners, for we be knights of King Claudas. And therewith two of them dressed their spears, and Ulfius and Brastias dressed their spears, and ran together with great random.",
                                                "english": "they were messengers unto King Ban and Bors sent from King Arthur. Therefore, said the eight knights, ye shall die or be prisoners, for we be knights of King Claudas. And therewith two of them dressed their spears, and Ulfius and Brastias dressed their spears, and ran together with great random."
                                            },
                                            {
                                                "example_id": "619fb988-5ca0-4565-bbb2-ce4cb2ecb435",
                                                "sense_id": "7ee54353-119f-34ed-ba79-4339c24a401e",
                                                "text": "[…] for coragiouſly the two kynges newely foughte with great randon and force, they ſhewed their vigors and ſtrengthes and did ſo nobly that their coũter parties had none aduaũtage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e242b8e0-9244-331d-8a4e-44118f04380e",
                                        "entry_id": "2a1e501b-fdf8-328b-b7fe-851d03e3b625",
                                        "glosses": [
                                            "The full range of a bullet or other projectile; hence, the angle at which a weapon is tilted to allow the greatest range."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ab7f1f-6bfe-4b7b-bcdd-8f8c8be0abbc",
                                                "sense_id": "e242b8e0-9244-331d-8a4e-44118f04380e",
                                                "text": "Fortie yards will they shoot levell, or very neare the marke, and 120 is their best at Random."
                                            },
                                            {
                                                "example_id": "ae7d860d-1197-4acf-bb9f-c40d7771fa92",
                                                "sense_id": "e242b8e0-9244-331d-8a4e-44118f04380e",
                                                "text": "[…] the angle at which the miſſive is to mount by ( if we will have it go to its furtheſt randome ) muſt be the half of a right one […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8954d3a-75a4-3368-8031-c42b384b6f4a",
                                        "entry_id": "2a1e501b-fdf8-328b-b7fe-851d03e3b625",
                                        "glosses": [
                                            "An undefined, unknown or unimportant person; a person of no consequence."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f582a36-f6d0-4b1d-a535-195fe354b7d5",
                                                "sense_id": "b8954d3a-75a4-3368-8031-c42b384b6f4a",
                                                "text": "The party was boring. It was full of randoms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77ef392-ff5b-3812-9892-57db03b8d9f6",
                                        "entry_id": "2a1e501b-fdf8-328b-b7fe-851d03e3b625",
                                        "glosses": [
                                            "The direction of a rake-vein."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3efe5a3-add0-34f7-b4d2-e990c7fb549b",
                                        "entry_id": "2a1e501b-fdf8-328b-b7fe-851d03e3b625",
                                        "glosses": [
                                            "A frame for composing type."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "819d348f-247b-4f5c-929e-5229e09815bd",
                                                "sense_id": "c3efe5a3-add0-34f7-b4d2-e990c7fb549b",
                                                "text": "Utilization of all floor space underneath case racks and randoms is another feature of the modern composing room; […]"
                                            },
                                            {
                                                "example_id": "32838807-f68e-4541-ae91-d5ee5daee77f",
                                                "sense_id": "c3efe5a3-add0-34f7-b4d2-e990c7fb549b",
                                                "text": "Printers' frames and randoms"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "random",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f442e5e5-fc53-375b-9656-40688b4dc01a",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Occurring for no particular reason; haphazard, unpredictable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea81a01a-7f8d-4ebd-a5c9-cd7d8e9cc2c7",
                                                "sense_id": "f442e5e5-fc53-375b-9656-40688b4dc01a",
                                                "text": "Our city is plagued by random acts of violence."
                                            },
                                            {
                                                "example_id": "9d12ce02-f9a8-425a-8b5a-feeec90c9723",
                                                "sense_id": "f442e5e5-fc53-375b-9656-40688b4dc01a",
                                                "text": "random acts of kindness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Involving an outcome which is impossible to predict, but which may be represented by a probability distribution; in the ideal case, involving outcomes which are equally likely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683ca776-d1fb-4212-8817-76aa98911227",
                                                "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                                                "text": "Near-synonyms: aleatory, stochastic"
                                            },
                                            {
                                                "example_id": "2a67bb99-0712-4514-99eb-6278002cfb1b",
                                                "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                                                "text": "The flip of a fair coin is purely random."
                                            },
                                            {
                                                "example_id": "a0269636-a89d-4a75-ac17-dbd14168b60a",
                                                "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                                                "text": "The newspaper conducted a random sample of five hundred American teenagers."
                                            },
                                            {
                                                "example_id": "d3bb0565-8cda-4842-832d-6e7f03cec1ff",
                                                "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                                                "text": "The results of the field survey look random by several different measures."
                                            },
                                            {
                                                "example_id": "d24702ce-9843-42fa-903d-f218414d55ac",
                                                "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                                                "text": "A toss of a loaded die is still random, though biased."
                                            },
                                            {
                                                "example_id": "ce6bb9ee-b846-4c27-ac17-40bcb6455a8d",
                                                "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                                                "text": "July 18 2012, Scott Tobias, AV Club The Dark Knight Riseshttp://www.avclub.com/articles/the-dark-knight-rises-review-batman,82624/\nWhere the Joker preys on our fears of random, irrational acts of terror, Bane has an all-consuming, dictatorial agenda that’s more stable and permanent, a New World Order that’s been planned out with the precision of a military coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64ed236f-e0a4-3072-8b08-ca5dd8472740",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Pseudorandom; mimicking the result of random selection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afe4d612-8cbc-42ff-a1ec-7322d8fde6c3",
                                                "sense_id": "64ed236f-e0a4-3072-8b08-ca5dd8472740",
                                                "text": "The rand function generates a random number from a seed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee495af-d73b-3e83-b8c8-c95a9e527f09",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Selected for no particular reason; arbitrary; unspecified."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dfe3a08-166a-4358-a999-c3d2cb3e2692",
                                                "sense_id": "1ee495af-d73b-3e83-b8c8-c95a9e527f09",
                                                "text": "A random American off the street couldn't tell the difference."
                                            },
                                            {
                                                "example_id": "a52d59d8-64cb-4e72-a78f-a7941801eab5",
                                                "sense_id": "1ee495af-d73b-3e83-b8c8-c95a9e527f09",
                                                "text": "You're just going to trust the word of random people on the Internet?"
                                            },
                                            {
                                                "example_id": "27233a88-bdd3-40a8-b50f-780aacf140d2",
                                                "sense_id": "1ee495af-d73b-3e83-b8c8-c95a9e527f09",
                                                "text": "I didn't have time to peruse the resturant's menu, so I just ordered some random dish."
                                            },
                                            {
                                                "example_id": "e691c1fa-e79a-42f1-b491-d59f1b7a8d74",
                                                "sense_id": "1ee495af-d73b-3e83-b8c8-c95a9e527f09",
                                                "text": "Whatever random hobby you're into, there's an Internet community for it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5aec473-ec89-32b4-83de-eebeab6bab35",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Being (part of) a varied, unrelated, and apparently arbitrary collection of things; diverse, heterogeneous."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e27f79-6901-4e5c-a777-4e6027e39120",
                                                "sense_id": "e5aec473-ec89-32b4-83de-eebeab6bab35",
                                                "text": "My notebook has turned into a random collection of thoughts."
                                            },
                                            {
                                                "example_id": "f8a9a78a-4328-440e-9e3b-cd4c704de987",
                                                "sense_id": "e5aec473-ec89-32b4-83de-eebeab6bab35",
                                                "text": "I brought a bunch of random snacks, but nothing nutritious."
                                            },
                                            {
                                                "example_id": "e046def1-ab88-4f35-bdd5-cf4a2a050280",
                                                "sense_id": "e5aec473-ec89-32b4-83de-eebeab6bab35",
                                                "text": "I mixed a bunch of random vegetables into a salad, and it actually turned out pretty good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54cc8680-03cc-323e-86de-e7d71d96b657",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Apropos of nothing; lacking context, relevance, or any connection to the previous situation; unexpected."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14aa4741-324c-44ca-ad14-505537a9e66d",
                                                "sense_id": "54cc8680-03cc-323e-86de-e7d71d96b657",
                                                "text": "This random guy just came up to me to say that he was a fan of my work."
                                            },
                                            {
                                                "example_id": "8b0b469e-5893-4a5b-95f5-93b412ea6160",
                                                "sense_id": "54cc8680-03cc-323e-86de-e7d71d96b657",
                                                "text": "Thank you for that completely random comment... now, let's get back to our actual topic of discussion."
                                            },
                                            {
                                                "example_id": "5efd2f19-2292-4265-a200-a3e67b552ea2",
                                                "sense_id": "54cc8680-03cc-323e-86de-e7d71d96b657",
                                                "text": "The teacher's bartending story was interesting, but very random."
                                            },
                                            {
                                                "example_id": "16be9137-1690-47b8-9576-c795ac038c5b",
                                                "sense_id": "54cc8680-03cc-323e-86de-e7d71d96b657",
                                                "text": "I feel like pineapple is a very random thing to put on a pizza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6235c390-7df5-3c15-b8ba-00f6e700d45a",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Of a person: characterized by or often saying random things; habitually using non sequiturs."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc1f630a-bc61-4ebb-93e0-6bda13812ae0",
                                                "sense_id": "6235c390-7df5-3c15-b8ba-00f6e700d45a",
                                                "text": "You're so random! I never know what you're going to do next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c53019-ebf8-3761-b3bf-82613afe4dfc",
                                        "entry_id": "bf516634-4dd0-37e7-ab34-6ccf73996c3d",
                                        "glosses": [
                                            "Being out of the ordinary; unusual or unexpected; odd, strange, bizarre."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5948a0d-5631-4087-8e93-f5c2378dd3a1",
                                                "sense_id": "76c53019-ebf8-3761-b3bf-82613afe4dfc",
                                                "text": "That's a rather random fact!"
                                            },
                                            {
                                                "example_id": "bfe3ef83-5fb4-4f32-bbff-d7c8bf3fa35c",
                                                "sense_id": "76c53019-ebf8-3761-b3bf-82613afe4dfc",
                                                "text": "I can't believe he would say that. That's so random!"
                                            }
                                        ]
                                    }
                                ]
                            },
