                        "target_lang_word": "Zwangslage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwangslage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5255475-c99a-3058-baad-93429e5cb391",
                                        "entry_id": "3b38c4f3-d8e6-3ae8-9282-f23dd121fe79",
                                        "glosses": [
                                            "eine schwierige Situation, in der man zu einem bestimmten Verhalten, einer bestimmten Tat gezwungen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a478cda9-c7b1-405d-be89-49a669af4cdc",
                                                "sense_id": "b5255475-c99a-3058-baad-93429e5cb391",
                                                "text": "„Einmal, in einer echten Zwangslage, hat Micha dann doch versucht, Miriams Aufmerksamkeit auf sich zu lenken.“"
                                            },
                                            {
                                                "example_id": "b3306add-e0f7-4bcb-8621-1ad665ac5106",
                                                "sense_id": "b5255475-c99a-3058-baad-93429e5cb391",
                                                "text": "„In einer solchen Zwangslage kann ein Unternehmen versuchen, mit technologischen Mitteln den Einsatz von Rohstoffen zu vermindern. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "241896be-7a5a-3f33-8f1e-2c6feb4ab626",
                                        "entry_id": "3b38c4f3-d8e6-3ae8-9282-f23dd121fe79",
                                        "glosses": [
                                            "eine beim Schweißen durch die Werkstücke vorgegebene, nicht veränderbare Lage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c47dd069-0c6a-4d6c-8f49-5c407ef3a372",
                                                "sense_id": "241896be-7a5a-3f33-8f1e-2c6feb4ab626",
                                                "text": "„Das Schweißen der Rundnaht in waagerechter Zwangslage kann beim offenen Lichtbogenschweißen von Hand auf zwei Arten erfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e1fc72-bbf0-416a-bcc2-77c90b1e8f60",
                        "source_entry_id": "459b5ec2-aae2-318a-990e-1dfe139ba91e",
                        "source_sense_description": "urgent situation",
                        "target_lang_word": "Notlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1628f5bf-42ca-3897-86cf-1865c5ca1203",
                                        "entry_id": "0cf7f44f-1aaa-3c3e-821e-abf409fae428",
                                        "glosses": [
                                            "schwierige, bedrohende Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf1fabd7-966a-431f-b588-22aa4fe0bcc8",
                                                "sense_id": "1628f5bf-42ca-3897-86cf-1865c5ca1203",
                                                "text": "„Doch was immer es an Mitgefühl mit der Notlage der Juden in London noch gegeben haben mag, die Maßnahmen, die darauf abzielten Flüchtlingsschiffe davon abzuhalten, die Blockade der palästinensischen Küste durch die Navy zu umgehen, wurden noch entschlossener als Großbritannien schließlich allein dastand.“"
                                            },
                                            {
                                                "example_id": "5bd35da5-fdb9-41a8-acf5-7755917be95a",
                                                "sense_id": "1628f5bf-42ca-3897-86cf-1865c5ca1203",
                                                "text": "„Roms Widerstandskraft war nach Cannae durchaus nicht gebrochen. Dem Adressaten dieser Botschaft soll der römische Großmut sowie die Solidarität der Römer in einer Notlage vorgeführt werden und im Gegensatz dazu die karthagische Kleinmütigkeit.“"
                                            },
                                            {
                                                "example_id": "d7d164be-e72a-4a28-94be-e8d06f3b070a",
                                                "sense_id": "1628f5bf-42ca-3897-86cf-1865c5ca1203",
                                                "text": "„Wilhelm wäre kein Hohenzoller gewesen und hätte nicht von Gottes Gnaden regiert, wenn ihm in dieser Notlage nicht der Herr zu Hilfe geeilt wäre, so wie dem Alten Fritz bei Leuthen.“"
                                            },
                                            {
                                                "example_id": "d8f90429-2391-4444-90ae-03892a3b998b",
                                                "sense_id": "1628f5bf-42ca-3897-86cf-1865c5ca1203",
                                                "text": "„Ich habe das Gefühl, daß sie in einer Notlage ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dd159f8-4269-4d37-b37c-6dd7933f7c6b",
