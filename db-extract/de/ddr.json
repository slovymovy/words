                        "form": "der DDR"
                    },
                    {
                        "form_id": "6ef8cedf-288b-4e21-8b37-0424c5216d6a",
                        "entry_id": "2c8e9e5a-1a4a-3047-a7b6-86ad18ef7179",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die DDR"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                        "entry_id": "2c8e9e5a-1a4a-3047-a7b6-86ad18ef7179",
                        "glosses": [
                            "Kurzwort für Deutsche Demokratische Republik"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d0cf493b-f8c7-4321-9033-3ae7eb5c0b55",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "Berlin war die Hauptstadt der DDR."
                            },
                            {
                                "example_id": "419c3eec-53cc-4ae5-8da0-eb57611ee4e1",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "„Angeblich waren die Wiedervereinigung und der Niedergang der DDR durch Weingenuss beschleunigt worden.“"
                            },
                            {
                                "example_id": "e40306ba-0818-442a-bad8-00da1a5a0d1a",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "„Ich bin im westlichen Ausland gelegentlich gefragt worden, warum ich in der DDR bleibe. Niemand wird einen Franzosen fragen, warum er in Frankreich bleibt.“"
                            },
                            {
                                "example_id": "08849b30-48d4-4783-89cf-8917f0525be8",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "„Sie habe selbst erlebt, wie einer, der Werbung für die sogenannte DDR gemacht habe, nach Hause geschickt worden sei.“"
                            },
                            {
                                "example_id": "539c11e0-065b-40c8-b806-20b49c41c01e",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "„Und doch legte ich diese romantische Folie auf die Orte, die ich bei meinen Streifzügen durch die DDR entdeckte.“"
                            },
                            {
                                "example_id": "f3c39efa-583a-4138-8878-8fe4188c0667",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "Ich bin in der DDR geboren."
                            },
                            {
                                "example_id": "f9ccf5a8-d0a9-4ceb-81ce-ec859249bfc8",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "Wir haben in der DDR unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "b8006189-1287-42c0-a83a-b138265d38aa",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "In die DDR führten einige Wege."
                            },
                            {
                                "example_id": "7e3c99bf-1d54-4371-b48a-56f64f81c22e",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "Die DDR lag auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "5d50802e-83df-4010-aaf3-e9bac579abb1",
                                "sense_id": "3935370c-1b7f-3083-a8b9-a2d2c652bbba",
                                "text": "„Die große Unzufriedenheit mit dem politischen und wirtschaftlichen System der DDR zeigte sich auch in der hohen Zahl von Flüchtlingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
