    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1535f58-0d40-3b1f-93da-dd25e7d35025",
                    "sense_definition": "Сопоставление для установления сходства или различия; соотнесение качеств или свойств.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "сопоставление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Провести детальное <w>сравнение</w> двух моделей телефонов оказалось непросто.",
                            "target_lang_translations": {
                                "tr": "İki telefon modelinin ayrıntılı bir <w>karşılaştırmasını</w> yapmak kolay olmadı."
                            }
                        },
                        {
                            "text": "По <w>сравнению</w> с прошлым годом наши результаты значительно улучшились.",
                            "target_lang_translations": {
                                "tr": "Geçen yıla <w>kıyasla</w> sonuçlarımız önemli ölçüde iyileşti."
                            }
                        }
                    ],
                    "synonyms": [
                        "сопоставление",
                        "сличение"
                    ],
                    "common_phrases": [
                        "по сравнению с",
                        "провести сравнение",
                        "не идёт в сравнение"
                    ],
                    "target_lang_definitions": {
                        "tr": "Benzerlik veya farklılıkları belirlemek için yapılan karşılaştırma; nitelik veya özelliklerin birbiriyle ilişkilendirilmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karşılaştırma",
                                "target_lang_sense_clarification": "iki veya daha fazla şeyi kıyaslama eylemi"
                            },
                            {
                                "target_lang_word": "kıyaslama",
                                "target_lang_sense_clarification": "özellikleri karşılaştırarak değerlendirme"
                            },
                            {
                                "target_lang_word": "kıyas",
                                "target_lang_sense_clarification": "karşılaştırma, oranlama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35c1293a-ac74-3c1a-a27e-05ffd8ae2f48",
                    "sense_definition": "Действие по значению глаголов <w>сравнивать</w>, <w>сравнить</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "сопоставление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для точного анализа требуется <w>сравнение</w> фактических показателей с плановыми.",
                            "target_lang_translations": {
                                "tr": "Doğru bir analiz için fiili göstergelerin planlananlarla <w>karşılaştırılması</w> gerekir."
                            }
                        },
                        {
                            "text": "Процесс <w>сравнения</w> данных занял у аналитиков несколько часов.",
                            "target_lang_translations": {
                                "tr": "Verileri <w>karşılaştırma</w> süreci analistlerin birkaç saatini aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "сопоставление"
                    ],
                    "common_phrases": [
                        "процесс сравнения",
                        "метод сравнения"
                    ],
                    "target_lang_definitions": {
                        "tr": "Karşılaştırmak eyleminin süreci veya yapılışı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karşılaştırma",
                                "target_lang_sense_clarification": "verileri veya durumları karşılaştırma süreci"
                            },
                            {
                                "target_lang_word": "kıyaslama",
                                "target_lang_sense_clarification": "analiz amacıyla yapılan karşılaştırma işlemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31cb5226-1042-395c-8574-dce656cc925e",
                    "sense_definition": "Образное выражение, троп, в котором одно явление или предмет уподобляется другому на основе общего признака.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "риторика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поэт использовал красивое <w>сравнение</w>, назвав глаза любимой звёздами.",
                            "target_lang_translations": {
                                "tr": "Şair, sevgilisinin gözlerini yıldızlara benzeterek güzel bir <w>benzetme</w> kullandı."
                            }
                        },
                        {
                            "text": "В этом тексте часто встречается развёрнутое <w>сравнение</w>.",
                            "target_lang_translations": {
                                "tr": "Bu metinde sıkça ayrıntılı <w>benzetmelere</w> rastlanmaktadır."
                            }
                        }
                    ],
                    "synonyms": [
                        "уподобление"
                    ],
                    "common_phrases": [
                        "образное сравнение",
                        "литературное сравнение"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin niteliğini daha belirgin kılmak için onunla başka bir şey arasında ortak bir nitelikte benzerlik kurma sanatı, teşbih."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "benzetme",
                                "target_lang_sense_clarification": "edebi bir sanat olarak teşbih"
                            },
                            {
                                "target_lang_word": "teşbih",
                                "target_lang_sense_clarification": "edebiyatta benzetme sanatı"
                            },
                            {
                                "target_lang_word": "mukayese",
                                "target_lang_sense_clarification": "mecazi anlamda karşılaştırma"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}