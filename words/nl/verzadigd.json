{
    "word_family": [
        "verzadigen",
        "verzadiging",
        "onverzadigd"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41d450c5-16e5-3a3f-b2b4-95467c5d22db",
                    "sense_definition": "Genoeg gegeten of gedronken hebbend, of ergens genoeg van hebben.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voldaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het uitgebreide kerstdiner voelde iedereen zich volkomen <w>verzadigd</w>.",
                            "target_lang_translations": {
                                "en": "After the extensive Christmas dinner, everyone felt completely <w>full</w>."
                            }
                        },
                        {
                            "text": "Ik ben nu echt <w>verzadigd</w> en hoef geen dessert meer.",
                            "target_lang_translations": {
                                "en": "I am really <w>satisfied</w> now and don't need any dessert."
                            }
                        }
                    ],
                    "synonyms": [
                        "vol",
                        "zat"
                    ],
                    "antonyms": [
                        "onverzadigd"
                    ],
                    "common_phrases": [
                        "volkomen verzadigd"
                    ],
                    "target_lang_definitions": {
                        "en": "Having eaten or drunk enough, or having had enough of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "full",
                                "target_lang_sense_clarification": "having eaten to satisfaction"
                            },
                            {
                                "target_lang_word": "satisfied",
                                "target_lang_sense_clarification": "no longer hungry or wanting more"
                            },
                            {
                                "target_lang_word": "replete",
                                "target_lang_sense_clarification": "filled to satisfaction, formal"
                            },
                            {
                                "target_lang_word": "sated",
                                "target_lang_sense_clarification": "fully satisfied, especially with food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3305ef00-879e-3ad8-a467-92dd9f959833",
                    "sense_definition": "Zoveel mogelijk vocht of een andere stof in zich opgenomen hebbend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absorptie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De spons was zo <w>verzadigd</w> met water dat hij begon te lekken.",
                            "target_lang_translations": {
                                "en": "The sponge was so <w>saturated</w> with water that it started to leak."
                            }
                        },
                        {
                            "text": "De grond is na de hevige regenval volledig <w>verzadigd</w>.",
                            "target_lang_translations": {
                                "en": "The ground is completely <w>saturated</w> after the heavy rainfall."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verzadigd met water"
                    ],
                    "target_lang_definitions": {
                        "en": "Having absorbed as much moisture or other substance as possible."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saturated",
                                "target_lang_sense_clarification": "soaked or completely filled with liquid"
                            },
                            {
                                "target_lang_word": "soaked",
                                "target_lang_sense_clarification": "extremely wet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "522aaca8-4864-31ba-8603-82eb494cf9ce",
                    "sense_definition": "Zoveel opgeloste stof bevattend als onder de gegeven omstandigheden mogelijk is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je meer zout toevoegt aan deze <w>verzadigde</w> oplossing, lost het niet meer op.",
                            "target_lang_translations": {
                                "en": "If you add more salt to this <w>saturated</w> solution, it will no longer dissolve."
                            }
                        },
                        {
                            "text": "De lucht is bij deze temperatuur volledig <w>verzadigd</w> met waterdamp.",
                            "target_lang_translations": {
                                "en": "At this temperature, the air is completely <w>saturated</w> with water vapor."
                            }
                        }
                    ],
                    "antonyms": [
                        "onverzadigd"
                    ],
                    "common_phrases": [
                        "verzadigde oplossing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Containing the maximum possible amount of a dissolved substance under the given conditions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saturated",
                                "target_lang_sense_clarification": "of a chemical solution"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b4f9f10-2b53-3880-8260-d0d932acf194",
                    "sense_definition": "Met uitsluitend enkelvoudige bindingen tussen koolstofatomen in een molecuul.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dierlijke vetten bevatten vaak een hoog percentage aan <w>verzadigde</w> vetzuren.",
                            "target_lang_translations": {
                                "en": "Animal fats often contain a high percentage of <w>saturated</w> fatty acids."
                            }
                        },
                        {
                            "text": "Dit molecuul is volledig <w>verzadigd</w> en kan geen extra waterstofatomen binden.",
                            "target_lang_translations": {
                                "en": "This molecule is completely <w>saturated</w> and cannot bind any additional hydrogen atoms."
                            }
                        }
                    ],
                    "antonyms": [
                        "onverzadigd"
                    ],
                    "common_phrases": [
                        "verzadigde vetzuren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Containing only single bonds between carbon atoms in a molecule."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saturated",
                                "target_lang_sense_clarification": "of organic compounds like fats"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dcc43cd-20a2-3226-8d7a-d7f096a320b4",
                    "sense_definition": "Zuiver en intens van kleur, zonder bijmenging van wit of grijs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "kleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schilder gebruikte zeer <w>verzadigde</w> kleuren om het contrast te vergroten.",
                            "target_lang_translations": {
                                "en": "The painter used highly <w>saturated</w> colors to increase the contrast."
                            }
                        },
                        {
                            "text": "Op de foto zien we een diepe, <w>verzadigde</w> blauwe lucht.",
                            "target_lang_translations": {
                                "en": "In the photo, we see a deep, <w>saturated</w> blue sky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verzadigde kleuren"
                    ],
                    "target_lang_definitions": {
                        "en": "Pure and intense in color, without any mixing of white or gray."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saturated",
                                "target_lang_sense_clarification": "of colors, highly intense"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9eb2e754-53b4-3629-85f5-69ab5d4fec0b",
                    "sense_definition": "Voltooid deelwoord van <w>verzadigen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De maaltijd heeft de hongerige reizigers snel <w>verzadigd</w>.",
                            "target_lang_translations": {
                                "en": "The meal quickly <w>satisfied</w> the hungry travelers."
                            }
                        },
                        {
                            "text": "Nadat hij zijn honger had <w>verzadigd</w>, viel hij in slaap.",
                            "target_lang_translations": {
                                "en": "After he had <w>satisfied</w> his hunger, he fell asleep."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of 'verzadigen' (to satisfy, saturate)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "satisfied",
                                "target_lang_sense_clarification": "appeased or fulfilled"
                            },
                            {
                                "target_lang_word": "saturated",
                                "target_lang_sense_clarification": "filled to capacity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}