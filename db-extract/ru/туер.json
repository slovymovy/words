                                "target_senses": [
                                    {
                                        "sense_id": "a3e0da57-d580-315d-9f6c-2e878b98d243",
                                        "entry_id": "9f68d505-9b88-3199-9915-95cb9f8877f8",
                                        "glosses": [
                                            "Remorqueur qui avance au moyen d’une chaîne mouillée au fond de l’eau."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4ad3f59-d26a-4eb2-a41b-09ef7586cb02",
                                                "sense_id": "a3e0da57-d580-315d-9f6c-2e878b98d243",
                                                "text": "Au centre, un bateau toueur, horriblement noir, lentement promène avec une respiration rauque, sans but visible, son fanal rouge et menaçant comme le fanal du dieu des morts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b8e883-5f83-3d40-9caa-5fec7a91796e",
