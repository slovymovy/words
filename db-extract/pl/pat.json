                    {
                        "sense_id": "e1651f25-7045-3e34-937a-1e31693964bd",
                        "entry_id": "07836b12-7ee1-342f-ae06-1632d06f5238",
                        "glosses": [
                            "sytuacja remisowa, w której gracz, na którego przypada posunięcie, nie może wykonać ruchu, a jego król nie jest szachowany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3572c7a7-bb17-4008-af1e-01e28beeb967",
                                "sense_id": "e1651f25-7045-3e34-937a-1e31693964bd",
                                "text": "Białe nie zauważyły, że po ich posunięciu czarny król znajduje się w pacie, więc partia zakończyła się remisem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f1e94847-5bfa-3721-bce2-b3fb7f2ce710",
                        "entry_id": "07836b12-7ee1-342f-ae06-1632d06f5238",
                        "glosses": [
                            "trudna sytuacja, gdy żadna ze stron nie może wykonać ruchu"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0248bbbe-abbd-4272-b7b8-cc3d01f42c89",
                        "source_entry_id": "07836b12-7ee1-342f-ae06-1632d06f5238",
                        "source_sense_id": "e1651f25-7045-3e34-937a-1e31693964bd",
                        "target_lang_word": "stalemate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalemate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41940be8-2062-32fe-86b9-a22c9ea6b534",
                                        "entry_id": "164d40b3-1e16-36e4-9aed-b222e73896cb",
                                        "glosses": [
                                            "The state in which the player to move is not in check but has no legal moves, resulting in a draw."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ee9b8b9-9bc5-4fd5-9900-4a7bd64f44b9",
                                                "sense_id": "41940be8-2062-32fe-86b9-a22c9ea6b534",
                                                "text": "The game is drawn when the player to move has no legal move and his/her king is not in check. The game is said to end in ‘stalemate’. This immediately ends the game, provided that the move producing the stalemate position was in accordance with Article 3 and Articles 4.2 – 4.7."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b2e401b-9eac-364b-a4a3-064b08235ff9",
                                        "entry_id": "164d40b3-1e16-36e4-9aed-b222e73896cb",
                                        "glosses": [
                                            "Any situation that has no obvious possible movement, but involves no personal loss."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c565e2-a927-416d-b51f-f83f6c51e31e",
                                                "sense_id": "6b2e401b-9eac-364b-a4a3-064b08235ff9",
                                                "text": "Indian military analysts said the situation was heading into a dangerous stalemate. Neither side wants to start a war. But neither side wants to back down either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0374c8d6-d195-3781-a5f4-740e901cbf0d",
                                        "entry_id": "164d40b3-1e16-36e4-9aed-b222e73896cb",
                                        "glosses": [
                                            "Any kind of match in which neither contestant laid claim to victory; a draw."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stalemate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc454b7-2e5b-3b45-b100-ca59f9619078",
                                        "entry_id": "bc0b59b7-a1e5-3977-8308-cda4453bc867",
                                        "glosses": [
                                            "To bring about a state in which the player to move is not in check but has no legal moves."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec8d0897-bda7-3d61-90e3-66db2617b1b6",
                                        "entry_id": "bc0b59b7-a1e5-3977-8308-cda4453bc867",
                                        "glosses": [
                                            "To bring about a stalemate, in which no advance in an argument is achieved."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15d9c379-e87b-43cb-a3d9-4c50ceca6b95",
                                                "sense_id": "ec8d0897-bda7-3d61-90e3-66db2617b1b6",
                                                "text": "The North Korean nuclear issue, stalemated for the past three years, is now back in play again—not before time."
                                            },
                                            {
                                                "example_id": "b0aebb52-309f-4143-8cc8-e18066d84e24",
                                                "sense_id": "ec8d0897-bda7-3d61-90e3-66db2617b1b6",
                                                "text": "But with the war also still largely stalemated, other theatres of conflict have become more important. In Russia’s case, that includes the secret domain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a8c5111-8428-40e2-9689-f13f86aae2bb",
                        "source_entry_id": "07836b12-7ee1-342f-ae06-1632d06f5238",
                        "source_sense_id": "e1651f25-7045-3e34-937a-1e31693964bd",
                        "target_lang_word": "pat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52a9ae4c-3424-308e-80fd-c52c3243adda",
                                        "entry_id": "20483b00-3b32-3b33-9460-6e88c155e9ee",
                                        "glosses": [
                                            "Situation où un des deux joueurs, qui n’a pas son roi en échec et qui a le trait, ne peut pas jouer sans mettre le roi en prise, et qui constitue un des cas de nullité de la partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c188ac7-17bd-4523-9562-ee513fe752ec",
                                                "sense_id": "52a9ae4c-3424-308e-80fd-c52c3243adda",
                                                "text": "L’application sembla dissiper un moment le nuage qui couvrait le front du ministre : il venait d’avancer une tour qui mettait le roi de Louis XIII dans cette fausse position qu’on nomme Pat, situation où ce roi d’ébène, sans être attaqué personnellement, ne peut cependant ni reculer ni avancer dans aucun sens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20e48bdf-b153-3d90-91a4-6970edb69e6d",
                                        "entry_id": "9429f1d4-a724-3e4d-9ed7-e41cb9f74bfb",
                                        "glosses": [
                                            "Aux échecs, se dit du roi qui, sans être en échec, ne peut pas jouer sans être en prise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e93dd60-902c-4531-867a-46ae10b7f727",
                                                "sense_id": "20e48bdf-b153-3d90-91a4-6970edb69e6d",
                                                "text": "Le Roi est Pat lorsqu’il se trouve dans une position telle qu’il n’est pas en échec, mais qu’il ne peut bouger sans s’y mettre, et que ses autres Pièces ou Pions, s’il en a, sont placés de manière à ne pas pouvoir être joués."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a8c7a35-59b7-305c-91d8-170f4f3646e8",
                                        "entry_id": "9429f1d4-a724-3e4d-9ed7-e41cb9f74bfb",
                                        "glosses": [
                                            "Se dit du joueur dont le roi est en situation de pat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
