                        "sense_id": "cfb3477f-a1a1-328f-ab5a-664429b1d370",
                        "entry_id": "34696fa0-9644-311f-931d-cb22eb853ce2",
                        "glosses": [
                            "Qui a la forme d’un doigt."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "48b9905d-5d56-43fb-af61-26714a8e76ac",
                                "sense_id": "cfb3477f-a1a1-328f-ab5a-664429b1d370",
                                "text": "DIGITIFORME, adj., digitiformis ; fingerförmig (all.) (digitus, doigt, forma, forme) ; qui a la forme d’un doigt, comme les épines de certains oursins et les feuilles du Mesembryanthemum digitiforme ; ou qui a des feuilles digitées, comme l’Hibiscus digitiformis."
                            },
                            {
                                "example_id": "b4a164c6-a6e2-4751-9ac4-77018d4700d0",
                                "sense_id": "cfb3477f-a1a1-328f-ab5a-664429b1d370",
                                "text": "Légende : A : colonie en chandelier ; B : colonie digitiforme; C : colonie encroûtante ; D : colonie lobée ; E : colonie plumeuse ; F : colonie plane ; G : colonie à ramifications dichotomiques ; H : colonie à ramifications latérales ; I : colonie rétiforme ou en éventail (Gorgonia)."
                            }
                        ]
                    }
