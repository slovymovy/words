                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre est monté en <w>chaire</w> pour prononcer son sermon devant les fidèles attentifs."
                        },
                        {
                            "text": "Cette ancienne église conserve une magnifique <w>chaire</w> en bois sculpté du dix-septième siècle."
                        }
                    ],
                    "synonyms": [
