                "senses": [
                    {
                        "sense_id": "b8c12d31-ccdf-3b78-ae44-44cfe7911889",
                        "entry_id": "fe717c69-b18d-3f04-bfda-8f9a70677295",
                        "glosses": [
                            "Eigenschaft einer Person, ganz offen ihre Meinung zu sagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad24f14-60e5-43b1-94eb-947cf3e152c1",
                                "sense_id": "b8c12d31-ccdf-3b78-ae44-44cfe7911889",
                                "text": "„Doch empörte er sich über das Prozedere und redete mit bewundernswertem Freimut den Regenten und Obrigkeiten ins Gewissen.“"
                            },
                            {
                                "example_id": "31d70af9-10c5-4c99-ab81-7333beda840c",
                                "sense_id": "b8c12d31-ccdf-3b78-ae44-44cfe7911889",
                                "text": "„Mit unerhörtem Freimut redet hier ein einfacher Ordensgeistlicher den Kurfürsten, Fürstbischöfen und ihren Beichtvätern ins Gewissen.“"
                            },
                            {
                                "example_id": "1a93f6c8-6dd2-4a84-9c7e-7f07d60eb716",
                                "sense_id": "b8c12d31-ccdf-3b78-ae44-44cfe7911889",
                                "text": "„Er hat die Frage verneint, aber insgeheim hat ihn Käthes Freimut doch überrascht.“"
                            },
                            {
                                "example_id": "093f2e36-a03a-450a-b67b-28699f72924f",
                                "sense_id": "b8c12d31-ccdf-3b78-ae44-44cfe7911889",
                                "text": "„Seufzend lauschte ich ihren vernünftigen Reden, deren Freimut man bei ihrem Alter kaum erwartet hätte, und ich brannte lichterloh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edf144d3-8f12-46be-99f4-1795afd3531e",
                        "source_entry_id": "fe717c69-b18d-3f04-bfda-8f9a70677295",
                        "source_sense_id": "b8c12d31-ccdf-3b78-ae44-44cfe7911889",
