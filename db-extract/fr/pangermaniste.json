                ],
                "senses": [
                    {
                        "sense_id": "aca3ea58-bb6e-35fc-be83-27a1e078411f",
                        "entry_id": "d6a25248-e985-3bcf-abd1-2350712a98dc",
                        "glosses": [
                            "Relatif au pangermanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "001c316d-2d22-4436-861b-c977f9df47d5",
                                "sense_id": "aca3ea58-bb6e-35fc-be83-27a1e078411f",
                                "text": "Lorsque les États-Unis entrèrent dans la guerre, mille huit cents ressortissants allemands soupçonnés d’activités pangermanistes furent emprisonnés à Ellis Island."
                            },
                            {
                                "example_id": "ea9d980e-71ec-44ec-ae83-cbee41ce13af",
                                "sense_id": "aca3ea58-bb6e-35fc-be83-27a1e078411f",
                                "text": "Il fallait en effet empêcher que le comportement des Français donnât du grain à moudre à certains pans de l’opinion allemande – le Quai d'Orsay craignait particulièrement les publications pangermanistes et leur effet sur la population et les dirigeants allemands."
                            },
                            {
                                "example_id": "5444e8bb-0e63-4eb5-96d8-fc0d7b940856",
                                "sense_id": "aca3ea58-bb6e-35fc-be83-27a1e078411f",
                                "text": "Dans le sillage du mouvement pangermaniste et en réaction aux idées libérales, le courant politique et culturel völkisch émerge au XIXᵉ siècle."
                            }
                        ]
                    }
                ],
