        "fr-extract.jsonl": [
            {
                "entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                "word": "défloration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e5c1e53-ebd8-4a80-8bdd-927a1be01239",
                        "entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                        "tags": [
                            "plural"
                        ],
                        "form": "déflorations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                        "entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                        "glosses": [
                            "Action de déflorer une jeune fille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3622c0-5102-4fe5-93bb-be0b413a893e",
                                "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                                "text": "Or Belle de Candeur était vierge, et au moment de la défloration, elle ne manqua pas de ressentir une douleur passablement désagréable."
                            },
                            {
                                "example_id": "411cf3c6-2f06-43ab-b8e7-8500638d1eea",
                                "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                                "text": "Le lit si bien bordé a connu le sang des déflorations et des accouchements et la sueur des agonies, la mode des voyages de noces étant de date récente et celle d’aller naître et mourir à l’hôpital ou à la clinique encore à venir."
                            },
                            {
                                "example_id": "734e2a69-584e-4ba2-b86d-e62f996dba83",
                                "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                                "text": "J’ai cessé d’être vierge à l’âge de dix-huit ans – ce qui n’est pas spécialement tôt – mais j’ai partouzé pour la première fois dans les semaines qui ont suivi ma défloration."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea27d08f-6b36-3a03-a0af-693f251b17c6",
                        "entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                        "glosses": [
                            "Fait de passer en premier dans un endroit vierge."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "0170f033-80b8-4ae5-87f0-788008b8c419",
                                "sense_id": "ea27d08f-6b36-3a03-a0af-693f251b17c6",
                                "text": "Il existe au ski une préséance de la trace, un plaisir de passer le premier. C’est une défloration de l’éphémère, vice inoffensif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e90c87f3-f7b8-427a-a7d4-d409fe6b9215",
                        "source_entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                        "target_lang_word": "Defloration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Defloration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fce21a8b-45b9-319b-a726-811223541814",
                                        "entry_id": "ad0fb3cd-0d02-3f9d-8d07-80a5cd597f83",
                                        "glosses": [
                                            "mögliche Verletzung des Hymens (ebenfalls althergebracht: Jungfernhäutchen) einer Frau bei ihrem ersten gemischtgeschlechtlichen Geschlechtsverkehr (siehe auch: Koitus, Kopulation, Penetration)"
                                        ],
                                        "tags": [
                                            "althergebracht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be472b01-11e9-4db0-baeb-dc508297ad53",
                                                "sense_id": "fce21a8b-45b9-319b-a726-811223541814",
                                                "text": "„Kurzum, wenn man sie den Vorfall erzählen hörte, war er ein Mann, der für seine Sache äußerst geschickt plädierte und nicht nur in der Kunst der Defloration, sondern auch der der Verführung erfahren war.“"
                                            },
                                            {
                                                "example_id": "c8ea2321-0eae-4ba8-9132-30d391a014a8",
                                                "sense_id": "fce21a8b-45b9-319b-a726-811223541814",
                                                "text": "„Und es wird ein besonders mörderischer Bestandteil des islamischen Glaubens charakterisiert, nämlich der Glaube an die paradiesische Belohnung durch Defloration einer großen Anzahl jungfräulicher Bräute im Himmel.“"
                                            },
                                            {
                                                "example_id": "a798569b-c8b4-4e95-946d-d2065f6c1a0b",
                                                "sense_id": "fce21a8b-45b9-319b-a726-811223541814",
                                                "text": "„Es sind die Hochzeitsnachtwitze, oder ganz allgemein der erste Geschlechtsverkehr, die Defloration.“"
                                            },
                                            {
                                                "example_id": "aa44bc5a-e4b6-4aff-a85c-91f0e4b35a5a",
                                                "sense_id": "fce21a8b-45b9-319b-a726-811223541814",
                                                "text": "„Es handelt von der Defloration des schönen Kindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51afb874-6f53-4a03-bce8-c212e503ab5b",
                        "source_entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                        "target_lang_word": "Deflorierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dc02a88b-b71d-403a-b2e3-06a830fd3954",
                        "source_entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                        "target_lang_word": "Entjungferung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entjungferung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                        "entry_id": "f1831698-d217-3eec-897b-4ecee241e490",
                                        "glosses": [
                                            "erster Geschlechtsverkehr der Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163df600-6b29-41b1-be1f-6f6d1850c5eb",
                                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                                "text": "Entjungferung ist die Bezeichnung für den ersten vollzogenen Geschlechtsverkehr einer Frau (auch: Penetration, Kopulation); überkommenerweise wird die damit einhergehende mögliche, unter Umständen blutende Verletzung ihres Hymens (Jungfernhäutchens) verbunden"
                                            },
                                            {
                                                "example_id": "c14aab38-0e4f-4617-96f2-b7e5d94e3990",
                                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                                "text": "„Andererseits kursieren die übelsten Gerüchte über Entjungferungen; es wird behauptet, diese Mädels würden einem ein Leben lang nachlaufen.“"
                                            },
                                            {
                                                "example_id": "3c9ae48a-f044-4f95-8f3d-a25df2512039",
                                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                                "text": "Jutta Vey: „Entjungferung - Frauen erzählen vom ersten Sex.“"
                                            },
                                            {
                                                "example_id": "94068a42-11dc-4a1c-b2b2-ce538cf6830a",
                                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                                "text": "„So fand sich auch der Mann, der die Entjungferung vornahm.“"
                                            },
                                            {
                                                "example_id": "3a3e0b49-115c-463e-9764-77f532948052",
                                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                                "text": "„Die Raton war weniger hübsch als anziehend, und sie hatte sich zum Gegenstand des Begehrens gemacht, indem sie ihre Entjungferung zu einem Preis von fünfundzwanzig Louis ausgeschrieben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0139fd30-4591-3523-bcca-ff6d7c8cf797",
                                        "entry_id": "f1831698-d217-3eec-897b-4ecee241e490",
                                        "glosses": [
                                            "erster Geschlechtsverkehr des Mannes"
                                        ],
                                        "tags": [
                                            "mangels sprachlicher Alternative",
                                            "im übertragenen Sinne auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db07e248-0138-4009-9c18-d27328afdb4e",
                                                "sense_id": "0139fd30-4591-3523-bcca-ff6d7c8cf797",
                                                "text": "„Crazy, der 1999 erschienene, stark autobiografische und sensationell erfolgreiche Roman des damals sechzehnjährigen Benjamin Lebert, beschreibt den Schock einer männlichen Entjungferung in unseren Tagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
