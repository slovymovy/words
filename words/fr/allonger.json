    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1169bf48-0aeb-37e5-9cba-47cc75909755",
                    "sense_definition": "Rendre plus grand en longueur ou en dimension spatiale.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière a dû <w>allonger</w> cette jupe de quelques centimètres."
                        },
                        {
                            "text": "Pour accueillir tous les invités, nous voulons <w>allonger</w> la grande table du salon."
                        }
                    ],
                    "common_phrases": [
                        "allonger une table",
                        "allonger une robe"
                    ]
                },
                {
                    "sense_id": "b103c0e9-7b22-3417-8ba6-83d97d9af447",
                    "sense_definition": "Déployer ou tendre un membre, le corps ou une partie du corps de toute sa longueur.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a demandé d'<w>allonger</w> les jambes sur la table médicale."
                        },
                        {
                            "text": "Il a dû <w>allonger</w> le bras pour attraper le livre posé tout en haut."
                        }
                    ],
                    "synonyms": [
                        "étendre"
                    ],
                    "common_phrases": [
                        "allonger le bras",
                        "allonger les jambes",
                        "allonger le cou"
                    ]
                },
                {
                    "sense_id": "9898a5ed-cf5c-3803-a9b7-78bb61ad5a50",
                    "sense_definition": "Faire durer plus longtemps dans le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "duree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces discussions imprévues vont <w>allonger</w> la réunion d'au moins une heure."
                        },
                        {
                            "text": "La direction a refusé d'<w>allonger</w> le délai fixé pour ce projet important."
                        }
                    ],
                    "common_phrases": [
                        "allonger les délais",
                        "allonger la durée"
                    ]
                },
                {
                    "sense_id": "b17b7569-bfff-3e60-a465-e6cc69f60b51",
                    "sense_definition": "Ajouter de l'eau ou un autre liquide à une boisson pour en atténuer la force ou augmenter sa quantité.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce café noir est trop fort, je vais l'<w>allonger</w> avec un peu d'eau chaude."
                        },
                        {
                            "text": "Le serveur propose d'<w>allonger</w> le sirop avec de l'eau fraîche pour les enfants."
                        }
                    ],
                    "common_phrases": [
                        "allonger avec de l'eau",
                        "allonger la sauce"
                    ]
                },
                {
                    "sense_id": "a2542b97-b7bb-3602-9c73-209a7d8e7e72",
                    "sense_definition": "Donner ou payer une somme d'argent, souvent à contrecœur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a dû <w>allonger</w> cent euros pour remplacer la vitre cassée."
                        },
                        {
                            "text": "Le client a fini par <w>allonger</w> la monnaie après une longue discussion."
                        }
                    ],
                    "common_phrases": [
                        "allonger la monnaie",
                        "allonger les billets"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "1ad477b9-a522-382b-8361-b871c3690e2e",
                    "sense_definition": "Donner vivement un coup à quelqu'un en tendant le bras.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "coup",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous le coup de la colère, il a failli lui <w>allonger</w> une gifle."
                        },
                        {
                            "text": "Le boxeur a réussi à lui <w>allonger</w> un direct en plein visage."
                        }
                    ],
                    "common_phrases": [
                        "allonger une gifle",
                        "allonger un coup"
                    ],
                    "traits": [
