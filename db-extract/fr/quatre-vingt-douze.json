                        "translation_id": "124f4bb2-8c28-4723-b0a8-238f2bc386d6",
                        "source_entry_id": "f559c0ac-bc87-3233-be2f-183edb605ca1",
                        "target_lang_word": "zweiundneunzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
