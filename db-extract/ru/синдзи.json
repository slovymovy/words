                        "examples": [
                            {
                                "example_id": "dd3b24b2-c160-45eb-96a2-d333dfe2ef8a",
                                "sense_id": "70ea874d-e9b6-33aa-905b-523e3f864a53",
                                "text": "За Синдзи Кагаву, защищающего цвета дортмундской «Боруссии», дают 13 млн."
                            },
                            {
                                "example_id": "a0d4c649-87c9-4e46-b98a-3ff1c64f7bd0",
                                "sense_id": "70ea874d-e9b6-33aa-905b-523e3f864a53",
                                "text": "41-летний мужчина по имени Синдзи Аоба, который подозревается в поджоге студии аниме Kyoto Animation в Японии, признал свою вину, сообщает агентство Kyodo со ссылкой на источники."
                            }
                        ]
                    }
