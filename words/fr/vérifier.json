                    "frequency": "High",
                    "semantic_group_id": "examen_controle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en voyage, pense à <w>vérifier</w> l'état de tes pneus."
                        },
                        {
                            "text": "Le professeur demande à chaque élève de bien <w>vérifier</w> ses réponses."
                        }
                    ],
                    "synonyms": [
                        "checker"
                    ],
                    "common_phrases": [
                        "vérifier une information",
                        "vérifier ses sources"
                    ]
                },
                {
                    "sense_id": "e61d3cc2-9d5f-3b8f-94e9-968a3cff3738",
                    "sense_definition": "Faire voir ou établir la vérité d'une hypothèse ou d'un fait ; confirmer dans la réalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preuve_confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les résultats de cette étude viennent de <w>vérifier</w> notre théorie initiale."
                        },
                        {
                            "text": "Les événements récents ont rapidement <w>vérifié</w> ses prédictions économiques les plus sombres."
                        }
                    ],
                    "synonyms": [
