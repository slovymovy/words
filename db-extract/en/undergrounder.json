                        "glosses": [
                            "A person who dwells underground."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fb40d06-6684-4ce5-9047-3a8fd067afd7",
                                "sense_id": "a75f9d48-60d6-3029-a640-af9df4282130",
                                "text": "[…] sewer people, derelicts, bag ladies, undergrounders, and Bowery bums. Whatever the cause of their illness, as in Scanners, homeless people are victims but, more importantly, a threat to be eliminated."
                            }
                        ]
                    },
                    {
