{
    "word_family": [
        "enamored",
        "enamorment",
        "disenamor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26952e60-8982-30bd-92b0-d60d4ccfa942",
                    "sense_definition": "To inspire with love; to cause someone to fall in love.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "love",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her charming laugh and kind nature began to <w>enamor</w> him from their very first date.",
                            "target_lang_translations": {
                                "de": "Ihr bezauberndes Lachen und ihr freundliches Wesen begannen ihn schon bei ihrem allerersten Date zu <w>betören</w>."
                            }
                        },
                        {
                            "text": "The poet hoped that his verses would <w>enamor</w> the young lady who inspired them.",
                            "target_lang_translations": {
                                "de": "Der Dichter hoffte, dass seine Verse das Herz der jungen Dame <w>erobern</w> würden, die ihn dazu inspiriert hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "infatuate"
                    ],
                    "antonyms": [
                        "disenamor",
                        "disenamour"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden mit Liebe erfüllen; bewirken, dass sich jemand verliebt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erobern",
                                "target_lang_sense_clarification": "das Herz von jemandem gewinnen"
                            },
                            {
                                "target_lang_word": "betören",
                                "target_lang_sense_clarification": "jemanden liebestrunken oder vernarrt machen"
                            },
                            {
                                "target_lang_word": "einnehmen für",
                                "target_lang_sense_clarification": "jemandes Zuneigung gewinnen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a14499a-2639-326a-b1f2-bd65dd3bacc4",
                    "sense_definition": "To captivate, charm, or fascinate strongly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "charm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet beauty of the seaside village continues to <w>enamor</w> travelers from around the world.",
                            "target_lang_translations": {
                                "de": "Die ruhige Schönheit des Küstendorfes <w>bezaubert</w> weiterhin Reisende aus aller Welt."
                            }
                        },
                        {
                            "text": "Few modern films manage to <w>enamor</w> audiences quite like this classic masterpiece did.",
                            "target_lang_translations": {
                                "de": "Nur wenigen modernen Filmen gelingt es, das Publikum so sehr zu <w>faszinieren</w>, wie es dieses klassische Meisterwerk tat."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivate",
                        "charm",
                        "enchant",
                        "fascinate"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden stark bezaubern, fesseln oder faszinieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bezaubern",
                                "target_lang_sense_clarification": "durch Charme oder Schönheit faszinieren"
                            },
                            {
                                "target_lang_word": "begeistern",
                                "target_lang_sense_clarification": "in Entzücken versetzen"
                            },
                            {
                                "target_lang_word": "faszinieren",
                                "target_lang_sense_clarification": "eine starke Anziehungskraft ausüben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}