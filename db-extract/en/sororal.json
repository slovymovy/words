                    {
                        "translation_id": "404ae477-9583-4242-8e50-9ef50d988fc1",
                        "source_entry_id": "e7b20f74-1268-36c7-986b-adc44e449be9",
                        "source_sense_description": "of, pertaining to, or characteristic of a sister or sisters",
                        "target_lang_word": "zusterlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zusterlijk",
