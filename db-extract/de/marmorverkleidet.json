                ],
                "senses": [
                    {
                        "sense_id": "155cd9d3-ef10-34bf-8f38-567bbacd9dc9",
                        "entry_id": "f72c3a40-160a-376a-b1fc-a4329ed1615c",
                        "glosses": [
                            "mit Marmor bedeckt, eine Marmorverkleidung habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79121dd-e64f-47b4-b9e3-9f6f29d2a932",
                                "sense_id": "155cd9d3-ef10-34bf-8f38-567bbacd9dc9",
                                "text": "„In Sarachs, an der Grenze von Turkmenistan und dem Iran, wurde 1995 ein funkelnagelneuer Bahnhof mit marmorverkleideten Wänden und Fahrkartenschaltern vollendet.“"
                            },
                            {
                                "example_id": "46fcbc02-f0cb-4f3c-96d3-e396b437d5bb",
                                "sense_id": "155cd9d3-ef10-34bf-8f38-567bbacd9dc9",
                                "text": "„Es war ein Ort voller totenstiller, marmorverkleideter Korridore; mit vielen großen Schreibtischen, an denen die wenigen libanesischen Regierungsbeamten, die zu sehen waren, zu arbeiten vorgaben; mit Bürofluchten, die bei näherer Betrachtung nur Leute beherbergten, die dem Pascha am Ende des Flurs Tee und Kaffee machten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
