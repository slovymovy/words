            "senses": [
                {
                    "sense_id": "241b9b3b-301e-362b-87ca-c448eb3dd101",
                    "sense_definition": "Rendre blanc ou plus blanc, couvrir d'une couche blanche.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a décidé de <w>blanchir</w> les murs du salon pour apporter plus de lumière."
                        },
                        {
                            "text": "Une fine couche de neige fraîche est venue <w>blanchir</w> les toits du village pendant la nuit."
                        }
                    ],
                    "antonyms": [
                        "noircir"
                    ],
                    "common_phrases": [
                        "blanchir les dents",
                        "blanchir à la chaux"
                    ]
                },
                {
                    "sense_id": "43d3c7a8-3769-3806-8d77-b33993056c79",
                    "sense_definition": "Prendre une teinte blanche, devenir blanc sous l'effet du temps ou d'une émotion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses tempes commencent à <w>blanchir</w> sous le poids des années."
                        },
                        {
                            "text": "Ses joues pâlissent et <w>blanchissent</w> dès qu'elle ressent une vive frayeur."
                        }
                    ],
                    "antonyms": [
                        "noircir"
                    ],
                    "common_phrases": [
                        "cheveux qui blanchissent"
                    ]
                },
                {
                    "sense_id": "28c77be1-d124-345a-88f7-dcae36ade109",
                    "sense_definition": "Plonger brièvement un aliment dans de l'eau bouillante avant de le refroidir ou de le cuisiner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut d'abord <w>blanchir</w> les épinards quelques minutes dans l'eau bouillante salée."
                        },
                        {
                            "text": "Le chef recommande de toujours <w>blanchir</w> le chou pour faciliter sa digestion."
                        }
                    ],
                    "common_phrases": [
                        "blanchir des légumes"
                    ]
                },
                {
                    "sense_id": "3009997b-a96b-3c43-9ada-87405aa7feec",
                    "sense_definition": "Déclarer innocent d'une accusation ou laver d'un soupçon, disculper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a décidé de <w>blanchir</w> le prévenu après la découverte de nouveaux témoignages décisifs."
                        },
                        {
                            "text": "Après plusieurs mois d'enquête rigoureuse, il a été définitivement <w>blanchi</w> par la justice."
                        }
                    ],
                    "antonyms": [
                        "salir"
                    ],
                    "common_phrases": [
                        "être blanchi de tout soupçon"
                    ]
                },
                {
                    "sense_id": "e82853f6-9133-3e4a-b761-287cb498eee1",
                    "sense_definition": "Dissimuler l'origine illégale d'argent en l'injectant dans des circuits économiques légaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette organisation criminelle utilisait des commerces de façade pour <w>blanchir</w> des sommes considérables."
                        },
                        {
                            "text": "Les enquêteurs surveillent les mouvements de fonds suspects qui servent à <w>blanchir</w> de l'argent sale."
                        }
                    ],
                    "common_phrases": [
                        "blanchir de l'argent"
                    ]
                },
                {
                    "sense_id": "3a8a8a8e-eff0-33f4-b388-0dfd6d438d5d",
                    "sense_definition": "Laver et entretenir le linge de maison ou les vêtements.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "entretien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés étaient nourris, logés et l'entreprise s'occupait aussi de les <w>blanchir</w> chaque semaine."
                        },
                        {
                            "text": "Dans ce village de montagne, les femmes allaient souvent au lavoir pour <w>blanchir</w> les draps."
                        }
                    ],
                    "antonyms": [
