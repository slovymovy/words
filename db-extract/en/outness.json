                "entry_id": "f6f848d9-6c27-36e2-a019-39f5818bff49",
                "word": "outness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4aec4ce5-92b7-4edb-bd92-d564a2bbe954",
                        "entry_id": "f6f848d9-6c27-36e2-a019-39f5818bff49",
                        "tags": [
                            "plural"
                        ],
                        "form": "outnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a390c68b-773e-3833-bff1-29dbd84c5a25",
                        "entry_id": "f6f848d9-6c27-36e2-a019-39f5818bff49",
                        "glosses": [
                            "The quality of being out, or outside."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e016df30-2267-4785-a854-a695f57386e1",
                                "sense_id": "a390c68b-773e-3833-bff1-29dbd84c5a25",
                                "text": "The forces which work in and upon organic life know nothing of outness and inness. They shine through the materials which they build up and mould, as light shines through the clearest glass."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a5637e8-16a2-31e0-b3bb-5e7b04a6b9fe",
                        "entry_id": "f6f848d9-6c27-36e2-a019-39f5818bff49",
                        "glosses": [
                            "The collective of things that are distinct from the observer."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "70cda2c0-8707-4837-82b2-5e0cd2c50715",
                                "sense_id": "8a5637e8-16a2-31e0-b3bb-5e7b04a6b9fe",
                                "text": "From what we have shewn it is a manifest Consequence, that the Ideas of Space, Outness, and things placed at a distance are not strictly speaking, the Object of Sight."
                            }
                        ]
                    },
                    {
                        "sense_id": "c54c6368-6d06-32d9-8131-6628ed4999b9",
                        "entry_id": "f6f848d9-6c27-36e2-a019-39f5818bff49",
                        "glosses": [
                            "The property of being distinct."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ab074ea3-4602-4312-abe6-00ea8a52e412",
                                "sense_id": "c54c6368-6d06-32d9-8131-6628ed4999b9",
                                "text": "Distance means degree of outness of one thing from another; but it presupposes outness as a fact and a conception."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bedf3f4-1343-3f80-9dae-99a4450d15f6",
                        "entry_id": "f6f848d9-6c27-36e2-a019-39f5818bff49",
                        "glosses": [
                            "The extent to which someone, particularly a gay person, is open about their sexuality."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b95c1a32-750b-40b1-b648-083310501903",
                                "sense_id": "4bedf3f4-1343-3f80-9dae-99a4450d15f6",
                                "text": "If I use my own name to publish pieces which use homosexual themes, this decision forces a certain amount of \"outness\" upon those who associate with me."
                            },
                            {
                                "example_id": "e0e1fed4-ca69-4797-8ec6-dc64466de920",
                                "sense_id": "4bedf3f4-1343-3f80-9dae-99a4450d15f6",
                                "text": "Couples who are discrepant on outness may have conflict around such issues as where to live (e.g. in an obvious gay neighbourhood), whether to bring a partner to work-related social events, and how to introduce their partner to family members."
                            }
                        ]
                    }
                ],
