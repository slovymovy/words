                                        "entry_id": "86740a2e-b1f1-33a9-bbf1-467be94bedd0",
                                        "glosses": [
                                            "Espèce de niche dans un cloître réservée à des religieux susceptibles de lire, d’écrire et d'étudier individuellement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b18a60c8-7a6e-3b97-ac07-b216a5fa087a",
                                        "entry_id": "86740a2e-b1f1-33a9-bbf1-467be94bedd0",
                                        "glosses": [
                                            "Espace d’étude individuel dans une bibliothèque universitaire, qui peut être soit cloisonné dans une salle de lecture soit une petite pièce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91d0755-a7fc-4c03-a105-24b83d3c81e7",
                                                "sense_id": "b18a60c8-7a6e-3b97-ac07-b216a5fa087a",
                                                "text": "Le mot carrel est entré dans le vocabulaire technique des bibliothèques et les architectes de nos universités en construisent pour les lecteurs privilégiés, sans toujours savoir que leur invention date de cinq siècles."
                                            }
                                        ]
                                    }
