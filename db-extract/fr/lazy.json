                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07fca75c-21dc-3af2-8fe2-6fabea774dbe",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Unwilling to do work or make an effort; disinclined to exertion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8454fa57-1c35-4730-a324-4746ac1a61f4",
                                                "sense_id": "07fca75c-21dc-3af2-8fe2-6fabea774dbe",
                                                "text": "Get out of bed, you lazy lout!"
                                            },
                                            {
                                                "example_id": "a3d3df33-bf53-4c24-a354-d4752ed64798",
                                                "sense_id": "07fca75c-21dc-3af2-8fe2-6fabea774dbe",
                                                "text": "If there bee any lasie fellow, any that cannot away with worke, any that would wallow in pleasures, hee is hastie to be priested. And when hee is made one, and has gotten a benefice, he consorts with his neighbour priests, who are altogether given to pleasures; and then both hee, and they, live, not like Christians, but like epicures; drinking, eating, feasting, and revelling, till the cow come home, as the saying is."
                                            },
                                            {
                                                "example_id": "4ac9ca2c-da5d-4ca7-8c15-e00db2f5f0d7",
                                                "sense_id": "07fca75c-21dc-3af2-8fe2-6fabea774dbe",
                                                "text": "\"I'm too lazy,\" he said. \"My wife says I'm the laziest man in all Oz, and she is a truthful woman. I hate work of any kind, and making a raft is hard work.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "706aae45-5150-3681-b3f1-7ef61acf43e4",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Causing or characterised by idleness; relaxed or leisurely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca662b7-ecfd-4c57-b86d-4fd3ec0bfb07",
                                                "sense_id": "706aae45-5150-3681-b3f1-7ef61acf43e4",
                                                "text": "I love staying inside and reading on a lazy Sunday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89400992-484d-3e3f-a6a5-6a959b4aa46f",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Showing a lack of effort or care."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd04b26c-3f10-401a-ac02-4c32b06a78c5",
                                                "sense_id": "89400992-484d-3e3f-a6a5-6a959b4aa46f",
                                                "text": "lazy writing"
                                            },
                                            {
                                                "example_id": "2b8e0298-8a93-4924-bef5-1756d8d01f88",
                                                "sense_id": "89400992-484d-3e3f-a6a5-6a959b4aa46f",
                                                "text": "So it was this beautiful young woman Rokoff had been persecuting. Tarzan wondered in a lazy sort of way whom she might be, and what relations one so lovely could have with the surly, bearded Russian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d11c87-2179-3846-92a8-43dd5d24f1f5",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Sluggish; slow-moving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5de8064-fba9-4db9-8908-345cee2dc43b",
                                                "sense_id": "27d11c87-2179-3846-92a8-43dd5d24f1f5",
                                                "text": "We strolled along beside a lazy stream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6267e790-5416-3a36-9f3f-f22db0c1c8c6",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Lax:",
                                            "Droopy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc7df37-3cc2-49bc-807e-6f55e3174f81",
                                                "sense_id": "6267e790-5416-3a36-9f3f-f22db0c1c8c6",
                                                "text": "a lazy-eared rabbit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e47e6d4-e90c-3157-a439-43e7a6787b6d",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Lax:",
                                            "Of an eye, squinting because of a weakness of the eye muscles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a9057b7-97df-325f-9c5f-9d41729dd50a",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Turned so that (the letter) is horizontal instead of vertical."
                                        ],
                                        "tags": [
                                            "of a cattle brand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78201ad4-c44c-44fa-8fd6-76a1fb004bbc",
                                                "sense_id": "6a9057b7-97df-325f-9c5f-9d41729dd50a",
                                                "text": "There was probably more cattle bearing the Lazy S brand marketed than those of any other ranch in the world."
                                            },
                                            {
                                                "example_id": "30ee586a-4cfa-4455-85be-71a2d7b53ec6",
                                                "sense_id": "6a9057b7-97df-325f-9c5f-9d41729dd50a",
                                                "text": "The Zuliagas branded a Lazy B. In order to distinguish his cows from theirs for the drive back to Arizona, Mr. Day added a britchen brand across their butts, under their tails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6399a465-fc91-3e19-8038-5c801130b39a",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Employing lazy evaluation; not calculating results until they are immediately required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5139a77-e75f-4db1-a1c0-5121ffd1292c",
                                                "sense_id": "6399a465-fc91-3e19-8038-5c801130b39a",
                                                "text": "a lazy algorithm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "538a0bc9-ce09-34ec-b87d-d60f41693205",
                                        "entry_id": "95e7dddd-62c4-313c-aa6d-8a2a7a5d5248",
                                        "glosses": [
                                            "Wicked; vicious."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "452da724-bdd0-458c-b1e6-b8bd8ae675b8",
                                                "sense_id": "538a0bc9-ce09-34ec-b87d-d60f41693205",
                                                "text": "The swilland dropsy enter in\nThe lazy cuke , and swell his skin"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lazy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "580c3856-60b2-30ae-8868-8192c6806af2",
                                        "entry_id": "5ea7f6bf-ee44-3cee-bdc1-68682b3c84d5",
                                        "glosses": [
                                            "To laze, act in a lazy manner."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aba9614e-7628-43e1-80f6-fc86540bcfc2",
                                                "sense_id": "580c3856-60b2-30ae-8868-8192c6806af2",
                                                "text": "“Go to sea,” muttered Mr. Unity Peach. “Work for your living—don’t lazy away your time here!”"
                                            },
                                            {
                                                "example_id": "82dc7b4e-b96e-43eb-a8f1-c00fdadda380",
                                                "sense_id": "580c3856-60b2-30ae-8868-8192c6806af2",
                                                "text": "You’d see a muddy sow and a litter of pigs come lazying along the street and whollop herself right down in the way, where folks had to walk around her […]"
                                            },
                                            {
                                                "example_id": "70ec0485-9cd9-48bc-acf5-60cbd20648f5",
                                                "sense_id": "580c3856-60b2-30ae-8868-8192c6806af2",
                                                "text": "That same afternoon we were lazying around in a boat among the water-lilies at the edge of the bay."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lazy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a149a00-1f64-3a01-9038-9b55f4e8a05f",
                                        "entry_id": "115248f1-1686-381e-9adc-e75900c8cb68",
                                        "glosses": [
                                            "A lazy person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98a42819-9a6b-459a-82a4-3fdc07770307",
                                                "sense_id": "6a149a00-1f64-3a01-9038-9b55f4e8a05f",
                                                "text": "The “lazies” of the party seized the opportunity of remaining behind—wandering, as they said, though all the cross paths were marked."
                                            },
                                            {
                                                "example_id": "aef94cc0-0235-4300-9ae9-f8246b42eaec",
                                                "sense_id": "6a149a00-1f64-3a01-9038-9b55f4e8a05f",
                                                "text": "1898, Jason E. Hammond, “Work and Reward” in Suggestive Programs for Special Day Exercises, Lansing, Michigan: Department of Public Instruction for District Schools, p. ,\nThe dudes and noodles, cads and snobs, had better move away,\nThis busy land can’t spare the room for lazies, such as they,\nTo foreign climate let them go and there forever stay.\nOurs is a land for busy workers."
                                            },
                                            {
                                                "example_id": "fd8060ff-de21-47a1-a7df-f7cc7b8a9ad3",
                                                "sense_id": "6a149a00-1f64-3a01-9038-9b55f4e8a05f",
                                                "text": "Which myth of the Greek crisis would you like to debunk? — That the Greeks are a nation of lazies on a permanent vacation; that austerity measures, as they were implemented, were proportionally distributed or worth the sacrifice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a61d009d-e83f-362a-8dcd-e081e194553f",
                                        "entry_id": "115248f1-1686-381e-9adc-e75900c8cb68",
                                        "glosses": [
                                            "Sloth (animal)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2fa44d-175f-492f-accc-ec0fd80f7858",
                                                "sense_id": "a61d009d-e83f-362a-8dcd-e081e194553f",
                                                "text": "To strenuous minds there is an inquietude in overquietness, and no laboriousness in labour; and to tread a mile after the slow pace of a snail, or the heavy measures of the lazy of Brazilia, were a most tiring pennance, and worse than a race of some furlongs at the Olympicks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
