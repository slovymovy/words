                "senses": [
                    {
                        "sense_id": "21fd07dc-9243-38f8-a1fb-8a57a7e760a3",
                        "entry_id": "8f18b4c4-767b-3602-9a65-8360c0808058",
                        "glosses": [
                            "coś wyjątkowo udanego, umiejętnie przeprowadzonego; osiągnięcie"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "fb68c231-833f-41d6-83b5-7870f3367ac4",
                                "sense_id": "21fd07dc-9243-38f8-a1fb-8a57a7e760a3",
                                "text": "Widziałeś go w tym najnowszym spektaklu? Jego gra to prawdziwy majstersztyk."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "99bf95a8-974b-39dd-98a7-ccf80285a2ce",
                        "entry_id": "8f18b4c4-767b-3602-9a65-8360c0808058",
                        "glosses": [
                            "przedmiot, produkt będący sprawdzianem umiejętności zawodowych rzemieślnika, warunek uzyskania tytułu mistrza"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "ea4fa822-8962-48f0-84aa-61d9c862e7e9",
                                "sense_id": "99bf95a8-974b-39dd-98a7-ccf80285a2ce",
                                "text": "Jego zegary, prawdziwe majstersztyki, zdobiły salony Wiednia i Berlina."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
