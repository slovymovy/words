                "senses": [
                    {
                        "sense_id": "7cafe8a1-0baa-33ce-b0d9-567296546bea",
                        "entry_id": "ffed49eb-3004-35dd-8793-ba82a9c5a3e1",
                        "glosses": [
                            "osoba pełniąca służbę przy wejściu, drzwiach, bramie"
                        ],
                        "tags": [
                            "obsolete"
                        ],
