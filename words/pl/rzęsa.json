{
    "word_family": [
        "rzęsisty",
        "rzęskowy",
        "rzęskowce"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0727d90-26a9-389f-b4aa-16186ba42150",
                    "sense_definition": "włos rosnący na krawędzi powieki, chroniący oko przed zanieczyszczeniami",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wpadła mi do oka <w>rzęsa</w> i teraz strasznie mnie piecze.",
                            "target_lang_translations": {
                                "ru": "Мне в глаз попала <w>ресница</w>, и теперь страшно жжёт."
                            }
                        },
                        {
                            "text": "Dziewczyna pomalowała każdą <w>rzęsę</w> nowym czarnym tuszem.",
                            "target_lang_translations": {
                                "ru": "Девушка прокрасила каждую <w>ресничку</w> новой чёрной тушью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "długie rzęsy",
                        "sztuczne rzęsy",
                        "tusz do rzęs"
                    ],
                    "target_lang_definitions": {
                        "ru": "волосок, растущий на краю века и защищающий глаз от пыли и загрязнений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ресница",
                                "target_lang_sense_clarification": "волосок на веке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61f98063-8177-30d4-a943-694e390b21f6",
                    "sense_definition": "drobna roślina wodna pływająca na powierzchni wód stojących",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Staw w parku był całkowicie porośnięty zieloną <w>rzęsą</w>.",
                            "target_lang_translations": {
                                "ru": "Пруд в парке полностью зарос зелёной <w>ряской</w>."
                            }
                        },
                        {
                            "text": "Kaczki chętnie zjadały <w>rzęsę</w> pływającą po powierzchni jeziora.",
                            "target_lang_translations": {
                                "ru": "Утки охотно поедали <w>ряску</w>, плавающую по поверхности озера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rzęsa wodna"
                    ],
                    "target_lang_definitions": {
                        "ru": "мелкое водное растение, плавающее на поверхности стоячих вод"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ряска",
                                "target_lang_sense_clarification": "водное растение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a0d0773e-7e35-3c92-a7bf-224f833e9a90",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Rzęsa</w> przyszedł dzisiaj punktualnie na zebranie zarządu.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Женса</w> пришёл сегодня вовремя на собрание правления."
                            }
                        },
                        {
                            "text": "Wczoraj rozmawiałem z doktorem <w>Rzęsą</w> o wynikach moich badań.",
                            "target_lang_translations": {
                                "ru": "Вчера я говорил с доктором <w>Женсой</w> о результатах моих анализов."
                            }
                        }
                    ],
