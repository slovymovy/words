                        "glosses": [
                            "Bewusstsein für die Wichtigkeit einer intakten natürlichen Umwelt und die damit verbundenen Gegenmaßnahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "384115a6-2408-4c14-9ff6-86f3b6cb4afc",
                                "sense_id": "cbd0a76e-c8e8-3c8a-980a-161745ed6a8a",
                                "text": "„Unter seinem Nachfolger Werner Maihofer als Innenminister rückte der Umweltgedanke in der FDP in den Hintergrund.“"
                            },
                            {
                                "example_id": "5ebccbd2-b15a-4115-a27e-4cb210f287c5",
                                "sense_id": "cbd0a76e-c8e8-3c8a-980a-161745ed6a8a",
                                "text": "„Die ökologische Katastrophe des Landes hatte dafür gesorgt, dass sich der Umweltgedanke in den Köpfen der Libanesen tief verankert hat.“"
                            },
                            {
                                "example_id": "5f794132-0606-4e86-87ac-c9a54b3600c2",
                                "sense_id": "cbd0a76e-c8e8-3c8a-980a-161745ed6a8a",
                                "text": "„Erst mit Beginn der 1980er Jahre beginnt sich der Umweltgedanke und somit auch die Kritik an Gletscherskigebieten mehr und mehr zu etablieren.“"
                            }
                        ],
