                                                "sense_id": "67cdd6b2-27d1-31ce-b062-7821ab8735e1",
                                                "text": "The q-quantile is the same as the (1/q)-fractile."
                                            },
                                            {
                                                "example_id": "81aee073-e4e9-450d-8133-f22ac8da2949",
                                                "sense_id": "67cdd6b2-27d1-31ce-b062-7821ab8735e1",
                                                "text": "The median is the .5-fractile."
                                            }
