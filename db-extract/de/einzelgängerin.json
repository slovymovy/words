                "senses": [
                    {
                        "sense_id": "a0af4f13-7dea-389f-8dc8-17c4a9ad94eb",
                        "entry_id": "a83fd47c-08d1-3cb5-8f06-c51c8d3aff76",
                        "glosses": [
                            "weibliche Person, die dazu neigt, sich von anderen Personen fernzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d667cb79-b873-4c75-9b54-884d3885a048",
                                "sense_id": "a0af4f13-7dea-389f-8dc8-17c4a9ad94eb",
                                "text": "„2001 spielte sie in Katalin Gödrös’ Spielfilmdebüt ‚Mutanten‘ die 13-jährige Einzelgängerin Paula, die während der Pubertät ihre eigene Identität sucht.“"
                            },
                            {
                                "example_id": "8198ef11-fa6c-40eb-be6a-bda0eb94f7eb",
                                "sense_id": "a0af4f13-7dea-389f-8dc8-17c4a9ad94eb",
                                "text": "„Guđrún hatte nicht viel über Elisabet zu sagen und beschrieb sie als ziemliche Einzelgängerin, die ihre Zeit lieber allein in ihrem Zimmer als mit der Familie verbrachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ff70ce6-5499-4f88-a045-4e955cf9dbd6",
                        "source_entry_id": "a83fd47c-08d1-3cb5-8f06-c51c8d3aff76",
                        "source_sense_id": "a0af4f13-7dea-389f-8dc8-17c4a9ad94eb",
                        "source_sense_description": "weibliche Person, die dazu neigt, sich von anderen Personen fernzuhalten",
                        "target_lang_word": "solitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c65ce06d-3e1e-3de0-95c4-a95ec8b806f0",
                                        "entry_id": "eee74357-ac5e-3b7f-8f6e-930ed95c4b2b",
                                        "glosses": [
                                            "Qui est seul ; qui vit dans la solitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "214d67c3-9b8d-42dd-9df2-9cbc73912a6d",
                                                "sense_id": "c65ce06d-3e1e-3de0-95c4-a95ec8b806f0",
                                                "text": "Tu étais de plus en plus malade, solitaire, retranché en toi-même."
                                            },
                                            {
                                                "example_id": "98b81a06-163f-4ae8-88e1-a7b790a19943",
                                                "sense_id": "c65ce06d-3e1e-3de0-95c4-a95ec8b806f0",
                                                "text": "L’hiver, lorsque la neige a cessé de tomber depuis quelques jours, lorsque l’armée des sapins noirs immobiles se détache sur le sol blanc, le voyageur solitaire doit se défendre contre un sentiment de crainte, presque d’angoisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c20fa4-952b-3941-a21c-e4edaaac0c9e",
                                        "entry_id": "eee74357-ac5e-3b7f-8f6e-930ed95c4b2b",
                                        "glosses": [
                                            "Qui est seul ; qui vit dans la solitude.",
                                            "Qui qualifie celui qui vit reclus dans l’abbaye de Port-Royal."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81c4b214-34ba-3f42-aa6d-222af7d419da",
                                        "entry_id": "eee74357-ac5e-3b7f-8f6e-930ed95c4b2b",
                                        "glosses": [
                                            "Qualifie un lieu désert, un lieu éloigné du commerce du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad72586-bd28-4982-aaec-f7d3e2423450",
                                                "sense_id": "81c4b214-34ba-3f42-aa6d-222af7d419da",
                                                "text": "J’occupais, il y a quinze ans, dans un quartier fort solitaire, une maison dont le jardin tenait à celui d’un couvent de femmes."
                                            },
                                            {
                                                "example_id": "9af9031b-cb12-4512-9d64-e729986c85db",
                                                "sense_id": "81c4b214-34ba-3f42-aa6d-222af7d419da",
                                                "text": "[…] ; les places et les rues attenantes, habituellement si solitaires dès que neuf heures sonnaient à Saint-Germain-l’Auxerrois, étaient, quoiqu’il fût minuit, encombrées de populaire."
                                            },
                                            {
                                                "example_id": "19b72510-fce0-4489-a591-d83dc4cb5006",
                                                "sense_id": "81c4b214-34ba-3f42-aa6d-222af7d419da",
                                                "text": "Le porc-épic creuse de préférence son terrier dans les parois abruptes et boisées des vallées solitaires."
                                            },
                                            {
                                                "example_id": "b6e7f171-c665-4ef8-81a6-46430cccbaa0",
                                                "sense_id": "81c4b214-34ba-3f42-aa6d-222af7d419da",
                                                "text": "Jusqu’après Valpuiseaux, sur plus d'une lieue, les groupes de fermes se suivent. Ensuite le vallon est solitaire, pli étroit et profond dont les côtés sont striés par une infinité de vaux très courts."
                                            },
                                            {
                                                "example_id": "b9434748-e50a-47a1-bab7-29a8cef7d6f7",
                                                "sense_id": "81c4b214-34ba-3f42-aa6d-222af7d419da",
                                                "text": "On s’en vient donc deux à deux et quand on a trouvé dans un petit coin, au bord du bois, un endroit paisible et solitaire, on déballe les provisions et l’on s’assied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bf6ce2a-a294-3883-931c-5079e734d9c7",
                                        "entry_id": "eee74357-ac5e-3b7f-8f6e-930ed95c4b2b",
                                        "glosses": [
                                            "Relatif à Saint-Jean-aux-Bois, commune française située dans le département de l’Oise, dont l'ancien nom était La Solitude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "solitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0c15b6-0263-3ae2-9506-d8e1884ba4fa",
                                        "entry_id": "a3ed6308-0dc8-3093-8383-dd972d29b49c",
                                        "glosses": [
                                            "Anachorète ou moine qui vit dans la solitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c577a2-059a-42a6-ada5-297b41512a9d",
                                                "sense_id": "8a0c15b6-0263-3ae2-9506-d8e1884ba4fa",
                                                "text": "Les solitaires d’Égypte, de la Thébaïde."
                                            },
                                            {
                                                "example_id": "a9c90f15-0e59-496c-be49-c41b501f3d95",
                                                "sense_id": "8a0c15b6-0263-3ae2-9506-d8e1884ba4fa",
                                                "text": "C’est un pieux solitaire."
                                            },
                                            {
                                                "example_id": "18b0b45f-de29-4844-9a28-515da252ed17",
                                                "sense_id": "8a0c15b6-0263-3ae2-9506-d8e1884ba4fa",
                                                "text": "La voilà dans le vieux bâtiment où, jadis, les solitaires de Port-Royal goûtaient en commun la solitude, et dont on a pu faire une prison sans y rien changer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff0297d-d4ad-3e9a-b911-f8531d943ad4",
                                        "entry_id": "a3ed6308-0dc8-3093-8383-dd972d29b49c",
                                        "glosses": [
                                            "Tout homme qui vit dans la solitude, qui vit très retiré."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441bd50b-0e14-4b92-901f-154a3a1cedaf",
                                                "sense_id": "cff0297d-d4ad-3e9a-b911-f8531d943ad4",
                                                "text": "Solitaire endurci, M. des Lourdines aurait, à la rigueur, consenti à voir les gens, mais il ne voulait pas être vu, de sorte qu’on avait fini par le laisser se pelotonner dans son Fougeray, comme un pigeon dans son boulin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b814919-dbb1-3647-ae74-47beb04e6344",
                                        "entry_id": "a3ed6308-0dc8-3093-8383-dd972d29b49c",
                                        "glosses": [
                                            "Vieux sanglier sorti de la compagnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4f8282-1c7e-4485-9f42-9bc70b52da14",
                                                "sense_id": "9b814919-dbb1-3647-ae74-47beb04e6344",
                                                "text": "Sans souci des brindilles qui le giflent, des ronces qui l'agriffent, il court, il court, pareil au solitaire qui charge l'ennemi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6c3bf2-ff5e-3692-9a3a-30b40054039f",
                                        "entry_id": "a3ed6308-0dc8-3093-8383-dd972d29b49c",
                                        "glosses": [
                                            "Diamant monté seul, sans entourage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16533ed3-07a5-4589-85de-ceea378d10fb",
                                                "sense_id": "9f6c3bf2-ff5e-3692-9a3a-30b40054039f",
                                                "text": "Porter au doigt un solitaire."
                                            },
                                            {
                                                "example_id": "fa80571e-2ad0-41bc-adb7-da2ef6ae143d",
                                                "sense_id": "9f6c3bf2-ff5e-3692-9a3a-30b40054039f",
                                                "text": "Hier soir, Valéry arborait à son doigt un solitaire aux facettes scintillantes. Sa bague de fiançailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa44893-ab52-3f55-9b0e-d33dc8f28619",
                                        "entry_id": "a3ed6308-0dc8-3093-8383-dd972d29b49c",
                                        "glosses": [
                                            "Sorte de patience (jeu de cartes se jouant seul)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "solitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99947a47-eab5-31f2-93d4-049139a7d3a6",
                                        "entry_id": "f621f9dd-e3f8-308f-a7d9-53a0ebfacde5",
                                        "glosses": [
                                            "Espèce de papillon de jour de la famille des piéridés (Pieridae), du centre et nord de l’Europe et d’Amérique du Nord, de couleur jaune pâle, bordé d’une frange rouge, avec un point noir ou blanc au centre de l’aile antérieure, de nom scientifique Colias palaeno’."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8d45d5-ffb9-49fb-b273-194d8ffaf30a",
                                                "sense_id": "99947a47-eab5-31f2-93d4-049139a7d3a6",
                                                "text": "La chenille du solitaire se nourrit sur l’airelle-myrtille ou l’airelle des marais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "036c72d9-538f-3b7c-89c5-a4728d4a190d",
                                        "entry_id": "f621f9dd-e3f8-308f-a7d9-53a0ebfacde5",
                                        "glosses": [
                                            "Dronte."
                                        ],
