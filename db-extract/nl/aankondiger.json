                ],
                "senses": [
                    {
                        "sense_id": "b2165e52-0e5a-38b5-8b54-615d09e07755",
                        "entry_id": "9370d1b5-19d2-3233-bc4b-c906c0383a7e",
                        "glosses": [
                            "iemand die zegt wat er gaat gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2951e3-822a-44aa-b82f-d14bac4532a2",
                                "sense_id": "b2165e52-0e5a-38b5-8b54-615d09e07755",
                                "text": "Daar klinken de twee bekende zinnen uit de mond van de vaste aankondiger Martin Fitzmaurice, 72 jaar en min of meer vastgeroest aan het Lakeside-podium. ,,Are you ready? Ladies and gentlemen, let’s play darts’’"
                            },
                            {
                                "example_id": "1d7f4a96-7af7-41f4-8b16-63b0160c8fc1",
                                "sense_id": "b2165e52-0e5a-38b5-8b54-615d09e07755",
                                "text": "Het was opnieuw Sussex, de aankondiger van slechte tijdingen, die ons het nieuws bracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "f163911e-ce2c-35ab-ab75-bc64fffafcef",
                        "entry_id": "9370d1b5-19d2-3233-bc4b-c906c0383a7e",
                        "glosses": [
                            "een teken dat er later iets gaat gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5727c284-be1e-4f9f-bea8-a5db9b7dded3",
                                "sense_id": "f163911e-ce2c-35ab-ab75-bc64fffafcef",
                                "text": "Zoals het Verdrag van Rome in zijn technocratische pacificatiedrang de aankondiger was van het 'Einde van de Geschiedenis', zo draagt de hedendaagse terugkeer van diezelfde Geschiedenis een wedergeboorte van de politiek in zich. De democratie is niet enkel een besluitvormingsmechanisme, maar zeker ook een manier om sociale en politieke conflicten in scène te zetten, in goede banen te leiden, ja zelfs tot bron van vrijheid te maken."
                            },
                            {
                                "example_id": "ba9eb148-2010-4948-b8f8-de12f9770e27",
                                "sense_id": "f163911e-ce2c-35ab-ab75-bc64fffafcef",
                                "text": "De 2014 van Château de la Botinière is een lief voorbeeld, rank en slank, bleek van teint, en daarmee een ongekunstelde aankondiger van de zomer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b2f515f-0049-4814-ad4b-ffe1b8768d09",
                        "source_entry_id": "9370d1b5-19d2-3233-bc4b-c906c0383a7e",
                        "source_sense_id": "b2165e52-0e5a-38b5-8b54-615d09e07755",
