                "senses": [
                    {
                        "sense_id": "090eadcd-eeb4-3efe-b7b9-6209dd04468a",
                        "entry_id": "635b56d6-4fc3-3133-a0bd-efc4b3ab316d",
                        "glosses": [
                            "Rand eines Bettes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e484277e-fc88-4270-9a59-33c1ff0f253b",
                                "sense_id": "090eadcd-eeb4-3efe-b7b9-6209dd04468a",
                                "text": "„Ich sitze hier auf dem Bettrand in einem sehr netten Zimmer.“"
                            },
                            {
                                "example_id": "704f2a28-e5cf-4a46-aca3-31bdef80830a",
                                "sense_id": "090eadcd-eeb4-3efe-b7b9-6209dd04468a",
                                "text": "„Eine brennende Kerze am Bettrand hat am Montagabend in Döttingen ein ganzes Schlafzimmer in Brand gesetzt.“"
                            },
                            {
                                "example_id": "ac0e8a54-67bb-4a64-9627-41698c18fc53",
                                "sense_id": "090eadcd-eeb4-3efe-b7b9-6209dd04468a",
                                "text": "„Mein Vater setzte sich auf den Bettrand und nahm das Buch in die Hand.“"
                            },
                            {
                                "example_id": "c15fb90d-6386-48dd-a9c0-a5e796706072",
                                "sense_id": "090eadcd-eeb4-3efe-b7b9-6209dd04468a",
                                "text": "„Thomas schlug die Decke zurück und setzte sich auf den Bettrand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
