                    {
                        "sense_id": "1c46f199-0e4d-3a4d-8e18-0c1c5476d69e",
                        "entry_id": "ef4942ea-3366-36eb-9dde-af048868e0f4",
                        "glosses": [
                            "Jeu de retournement de pions très semblable à Othello (réinventé en 1971)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fffc5c2-ef03-477e-98d8-97c9cd34c6f4",
                                "sense_id": "1c46f199-0e4d-3a4d-8e18-0c1c5476d69e",
                                "text": "Au cours de l’instance il fut établi que le mot « Reversi » s’appliquait à un ancien jeu de cartes français ; mais comme le jeu en litige n’était pas un jeu de cartes, le demandeur prétendait que le mot « Reversi » avait été choisi comme dénomination de pure fantaisie."
                            }
                        ]
                    }
                ],
