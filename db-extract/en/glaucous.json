                        "sense_id": "8cfb28ed-9236-3cf0-9786-801a9ce2104b",
                        "entry_id": "fdaf6a9b-2ee1-3211-b6ff-363c95696bea",
                        "glosses": [
                            "Covered with a bloom or a pale powdery covering, regardless of colour."
                        ],
                        "tags": [],
                        "examples": []
                    }
