                "senses": [
                    {
                        "sense_id": "cd1312b9-63db-3f69-9377-67f3f390884e",
                        "entry_id": "e0b95c71-e112-3fdd-9f8f-a26633f953e5",
                        "glosses": [
                            "Assemblage de pièces de bois qui forment la baie, l’ouverture d’une porte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990f0900-4343-4e33-b2c7-d74d8d8c9a90",
                                "sense_id": "cd1312b9-63db-3f69-9377-67f3f390884e",
                                "text": "L’ensemble du linteau, de deux poteaux d’huisserie et de l’appui E, constitue l’huisserie d'une porte ou d'une fenêtre."
                            },
                            {
                                "example_id": "529da2f3-920d-414c-9b57-eba880c54dff",
                                "sense_id": "cd1312b9-63db-3f69-9377-67f3f390884e",
                                "text": "Un vieux menuisier à moitié sourd avait aménagé dans les murs et dans les cloisons les organes de fermeture tels que portes et fenêtres composées de bâtis ouvrants fixés sur les huisseries, elles-mêmes scellées dans le mur."
                            },
                            {
                                "example_id": "adeaa887-ca0b-4184-843f-d9f40ca44dba",
                                "sense_id": "cd1312b9-63db-3f69-9377-67f3f390884e",
                                "text": "Tous les trois ans au printemps, elle repeignait les volets et les huisseries."
                            }
                        ]
                    }
                ],
