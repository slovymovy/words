                                            {
                                                "example_id": "a5021ccd-6a1d-4e6a-8d88-682c9c148bc0",
                                                "sense_id": "5a2ac0c7-a727-3cde-b68d-791103ed9eaa",
                                                "text": "Die Dalmatiner sind sehr mit dem Meer verbunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "196be622-c348-3896-81ee-ddff7fa897f3",
                                        "entry_id": "8feb40e1-1d1b-3da3-b124-dd4b537206cb",
                                        "glosses": [
                                            "aus Kroatien stammende mittelgroße Hunderasse mit auffälligen braunen oder schwarzen Tupfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b0988b-8bf0-4c43-891c-c9e52486051e",
                                                "sense_id": "196be622-c348-3896-81ee-ddff7fa897f3",
                                                "text": "Dalmatiner brauchen sehr viel Bewegung."
                                            },
                                            {
                                                "example_id": "660da60c-da7d-482a-83d3-922b8a14a317",
                                                "sense_id": "196be622-c348-3896-81ee-ddff7fa897f3",
                                                "text": "„Panisch leckte der Dalmatiner die Hand meines Vaters, ständig wischte die rosa Hundezunge über seine Haut und strich die dunklen Härchen glatt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
