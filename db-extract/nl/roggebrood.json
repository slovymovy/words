                "translations": [
                    {
                        "translation_id": "d0a27c77-9d6a-4b35-a695-9a5f2f0393c8",
                        "source_entry_id": "c35d4f45-9567-3bb2-8b49-218ba8e7c690",
                        "source_sense_id": "805b1d63-7cb5-3f47-b68b-3674955b45ce",
                        "source_sense_description": "een van rogge gebakken brood",
                        "target_lang_word": "Roggenbrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roggenbrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fef0fb8f-06ce-3a7c-ab2f-5cecedeb39cb",
                                        "entry_id": "4e73cb94-cbb7-3336-b7d3-7033704f32ab",
                                        "glosses": [
                                            "Brot, das überwiegend mit Roggenmehl gebacken wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f3e9a17-c1c7-4c8f-83a3-691e2ecbed3c",
                                                "sense_id": "fef0fb8f-06ce-3a7c-ab2f-5cecedeb39cb",
                                                "text": "Bärenbraten, Fisch und Roggenbrot: mit heimischen Spezialitäten lockt Estland als Partnerland der Internationalen Agrarmesse [„Grüne Woche“] dieses Jahr die Besucher in die Messehalle."
                                            },
                                            {
                                                "example_id": "d5b55a17-5574-47e3-a416-a0fe021ea784",
                                                "sense_id": "fef0fb8f-06ce-3a7c-ab2f-5cecedeb39cb",
                                                "text": "Mischbrot ist milder im Geschmack als Roggenbrot und hat eine lockerere Krume. Der Großteil der in Deutschland angebotenen Brote sind Mischbrote."
                                            },
                                            {
                                                "example_id": "2251283d-2a16-4e49-ba97-66905e2b0b64",
                                                "sense_id": "fef0fb8f-06ce-3a7c-ab2f-5cecedeb39cb",
                                                "text": "Roggenbrote können durch die Absenkung des pH-Wertes [durch den Sauerteig] besser gekaut werden."
                                            },
                                            {
                                                "example_id": "40f35c82-e678-4150-9e06-7c504dfbbfa4",
                                                "sense_id": "fef0fb8f-06ce-3a7c-ab2f-5cecedeb39cb",
                                                "text": "Frisch aus dem Ofen, erscheinen sie [die Teiglinge der Schnellbrotbäckerei] noch zum Anbeißen, schon einen halben Tag später sind so manche davon reif für die Biomülltonne: Sie sind trocken und schmecken alt – kein Vergleich mit einem reinen Roggenbrot, das noch Tage nach dem Anschnitt frisch und saftig ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
