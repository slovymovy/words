                        "source_sense_id": "3276b8b0-ba75-3ed0-aa1a-437184d25fd1",
                        "source_sense_description": "Vertreter einer Gruppe ausgestorbener Reptilien aus dem Mesozoikum (Erdmittelalter), die vollständig an das Leben im Meer angepasst waren (Ichthyopterygia)",
                        "target_lang_word": "ichthyosaur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
