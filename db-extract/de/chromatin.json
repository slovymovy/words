                                "target_senses": [
                                    {
                                        "sense_id": "3e396766-9105-3da8-8cc8-69ffb51003f6",
                                        "entry_id": "3820b5b9-7a5b-34af-a5ff-459d04919e5d",
                                        "glosses": [
                                            "A complex of DNA, RNA and proteins within the cell nucleus out of which chromosomes condense during cell division."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49aab161-97fb-47a4-8ed1-c54a229ad79f",
                        "source_entry_id": "fe4ed018-c578-36ae-814d-68238d017d52",
                        "source_sense_id": "9f42c5bc-646f-3187-bc9c-8afb1d45343a",
                        "source_sense_description": "Komplex aus Desoxyribonukleinsäure und Proteinen, aus dem die Chromosomen bestehen",
                        "target_lang_word": "chromatine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chromatine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "592abdfa-b59e-35f3-885f-d4694e229af1",
                                        "entry_id": "e2f0cef3-1b6c-34a7-a838-bbdc0c2cf5b2",
                                        "glosses": [
                                            "Substance composée de molécule d’ADN, d’ARN et de protéines, qui sert à créer les chromosomes eucaryotes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6bc570-a7c7-4826-9825-b661829aa20f",
                                                "sense_id": "592abdfa-b59e-35f3-885f-d4694e229af1",
                                                "text": "Par des recherches cytogénétiques, on a mis en évidence la présence de la chromatine sexuelle chez environ 82 p. 100 des cellules examinées chez tous les intersexes qui appartiennent du point de vue anatomo-clinique à cette dysgénésie."
                                            },
                                            {
                                                "example_id": "45aefcef-df90-4e56-9826-0a4f9ca83cb8",
                                                "sense_id": "592abdfa-b59e-35f3-885f-d4694e229af1",
                                                "text": "Le degré de condensation de la chromatine varie au cours du cycle cellulaire."
                                            },
                                            {
                                                "example_id": "f51c12ed-65a3-4b5e-b317-fbaa32bd7aa8",
                                                "sense_id": "592abdfa-b59e-35f3-885f-d4694e229af1",
                                                "text": "À l’heure actuelle, les scientifiques ne savent pas exactement ce qui provoque le ramollissement des cellules cancéreuses, mais ils pensent que cela pourrait être dû à des modifications de la chromatine, cette structure du noyau des cellules constituée d'ADN et de protéines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
