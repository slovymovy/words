                "senses": [
                    {
                        "sense_id": "68313ace-a1b9-32a0-bcfd-5a731c5e7917",
                        "entry_id": "6d3b3726-9437-3c54-beb1-7b71ad0f0f59",
                        "glosses": [
                            "te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9e8358-757b-4bbf-9f05-781656e806b8",
                                "sense_id": "68313ace-a1b9-32a0-bcfd-5a731c5e7917",
                                "text": "De hele trail is tenslotte ook voor paarden toegankelijk."
                            },
                            {
                                "example_id": "dd06be05-ce18-4c74-a29c-4535f75edbd3",
                                "sense_id": "68313ace-a1b9-32a0-bcfd-5a731c5e7917",
                                "text": "Wiggers krijgt de koninklijke onderscheiding voor \"zijn inzet voor het innovatieve en inclusieve karakter van de dansproducties, zijn bijdrage aan het voor een breed publiek toegankelijk maken van moderne dans en het betrekken van de regio bij het dansgezelschap\", aldus een verklaring van het Koninklijk Huis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd5c9dc8-5230-48de-96c1-9a4ef84c7c7c",
                        "source_entry_id": "6d3b3726-9437-3c54-beb1-7b71ad0f0f59",
                        "source_sense_id": "68313ace-a1b9-32a0-bcfd-5a731c5e7917",
                        "source_sense_description": "te bereiken",
                        "target_lang_word": "zugänglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugänglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                        "entry_id": "a04d1dbb-e85b-35ad-aec6-64e5eb66698c",
                                        "glosses": [
                                            "einen Zugang besitzend, so dass man eintreten und ein eventuelles dortiges Angebot nutzen kann"
                                        ],
                                        "tags": [
                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e13e1f8-ac52-486d-b637-914cb3b2c547",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "Der Buckingham Palace ist einmal im Jahr der Öffentlichkeit zugänglich."
                                            },
                                            {
                                                "example_id": "9616e2f2-6c6a-4842-8bf5-7d4aba142630",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "„Die christliche Grabeskirche war frei zugänglich von früh um sieben bis abends um sieben und meist überfüllt.“"
                                            },
                                            {
                                                "example_id": "b6ee9f28-9c70-4803-a12b-52c1dbb436e5",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "3c293610-6f1f-4006-94a1-8b83612ad7f2",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "Die Tiefen der Weltmeere sind nur wenigen Forschern zugänglich."
                                            },
                                            {
                                                "example_id": "43acfea1-2dc8-4ab8-b5fc-c0112c9d2598",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "Das Flugzeugwrack lag an einer schwer zugänglichen Stelle."
                                            },
                                            {
                                                "example_id": "2ca47779-3a04-4ae3-8846-9fcb0477bfa8",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "„Dabei hängen Fotos, auf denen Leni Ottos griechischen Schwiegervater in Heldenpose porträtiert hat, durchaus an Gästen zugänglichen Stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af63bb2f-8776-3fcd-8c27-6955bb66980c",
                                        "entry_id": "a04d1dbb-e85b-35ad-aec6-64e5eb66698c",
                                        "glosses": [
                                            "sich gerne anderen (oder auch Themen) öffnend und kommunikationsbereit"
                                        ],
                                        "tags": [
                                            "über Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33094716-1a5c-4837-bc45-d9d156c9d6fe",
                                                "sense_id": "af63bb2f-8776-3fcd-8c27-6955bb66980c",
                                                "text": "Meine Oma war eine sehr zugängliche, gesellige und aufgeschlossene alte Dame."
                                            },
                                            {
                                                "example_id": "392abeb5-e70d-4e63-8464-4004b5bd2423",
                                                "sense_id": "af63bb2f-8776-3fcd-8c27-6955bb66980c",
                                                "text": "Sie ist allem Ästhetischen zugänglich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4925583f-be92-319c-880e-e6e8b36d3b09",
                                        "entry_id": "a04d1dbb-e85b-35ad-aec6-64e5eb66698c",
                                        "glosses": [
                                            "so, dass es verstanden und genutzt werden kann"
                                        ],
                                        "tags": [
                                            "über Information",
                                            "Wissen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64b47b0-d02b-4b32-9612-92e6af438d18",
                                                "sense_id": "4925583f-be92-319c-880e-e6e8b36d3b09",
                                                "text": "Eine gute Übersetzung der fremdsprachigen Texte macht das Werk zugänglicher."
                                            },
                                            {
                                                "example_id": "4883ec91-7fe9-47b4-b5bf-9e6ff87988c6",
                                                "sense_id": "4925583f-be92-319c-880e-e6e8b36d3b09",
                                                "text": "Diese Informationen müssen wir unbedingt einer breiteren Öffentlichkeit zugänglich machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "406bf679-63b8-4dad-a470-08a7e3227e07",
                        "source_entry_id": "6d3b3726-9437-3c54-beb1-7b71ad0f0f59",
                        "source_sense_id": "68313ace-a1b9-32a0-bcfd-5a731c5e7917",
                        "source_sense_description": "te bereiken",
                        "target_lang_word": "accessible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accessible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b37af978-4d58-367b-b274-02a3e8d951ed",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Easy of access or approach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122062e7-1377-4e25-8c90-a6128fb7a804",
                                                "sense_id": "b37af978-4d58-367b-b274-02a3e8d951ed",
                                                "text": "an accessible town or mountain"
                                            },
                                            {
                                                "example_id": "94c1b9da-246c-430c-b58c-d4a419413b1b",
                                                "sense_id": "b37af978-4d58-367b-b274-02a3e8d951ed",
                                                "text": "At first sight it would seem that the deep interior of the sun and stars is less accessible to scientific investigation than any other region of the universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Built or designed as to be usable by people with disabilities."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d86291-6094-4f48-b26d-788c6055ff91",
                                                "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                                "text": "an accessible website"
                                            },
                                            {
                                                "example_id": "67d15d29-cc8e-4c13-b38f-98381d13e291",
                                                "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                                "text": "accessible public transport"
                                            },
                                            {
                                                "example_id": "e0ab111a-2174-4c72-82d9-3220c70b7c5c",
                                                "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                                "text": "As well as the boom in off-peak leisure numbers, \"there has been a big spike in passenger assistance - that's really taken off as well\", he continues. \"We're probably victims of our own success because we promote this more than we ever used to. We promote how accessible the railways are. I think that this area has more than doubled from pre-COVID levels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd386699-cff1-39e0-a49c-eae6211536e6",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Easy to get along with."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "858c93ec-0518-3203-9e54-83262ecaf48f",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Open to the influence of."
                                        ],
                                        "tags": [
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631a2be2-d8e6-4f26-aca6-f2979558d006",
                                                "sense_id": "858c93ec-0518-3203-9e54-83262ecaf48f",
                                                "text": "Minds accessible to reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "930526b8-6b3c-3552-88f2-416e8cbac1f0",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Obtainable; to be got at."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8273e848-6a4c-4a13-b84d-61a2d0e0fb38",
                                                "sense_id": "930526b8-6b3c-3552-88f2-416e8cbac1f0",
                                                "text": "The materials, however, which are at present accessible, are sufficient for the construction of a narrative not to be read without shame and loathing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66de9cae-1bb2-321b-b471-0e8910eea171",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Easily understood or appreciated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0053a778-facb-434a-9186-b7441c906585",
                                                "sense_id": "66de9cae-1bb2-321b-b471-0e8910eea171",
                                                "text": "But something new was rippling through a million MySpace profiles. The sound was electro, and bass-laced synthetic dance pop would soon start streaming in from producers in Paris, dizzying the twenteens of Britain with its accessible, anthemic funk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e553168-a5bf-326e-a0c5-0903336a0f1a",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Capable of being used or seen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0698f613-c315-47cb-9fd1-a9410e3bc28a",
                        "source_entry_id": "6d3b3726-9437-3c54-beb1-7b71ad0f0f59",
                        "source_sense_id": "68313ace-a1b9-32a0-bcfd-5a731c5e7917",
                        "source_sense_description": "te bereiken",
                        "target_lang_word": "accessible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accessible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                        "entry_id": "15e4264c-4a8a-3d32-a924-976f5b774cac",
                                        "glosses": [
                                            "Où l’on peut accéder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54be370d-d1f2-4b35-b649-a1ce3ea2cf15",
                                                "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                                "text": "Nous n'hésitâmes pas à choisir le premier, un naturel roux de la tète aux pieds, qui n'avait jamais quitté son île, et en connaissait tous les endroits accessibles."
                                            },
                                            {
                                                "example_id": "ed973ba9-48fb-4479-b784-c14bdec21c88",
                                                "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                                "text": "Les rez-de-chaussée étaient seuls accessibles, car le feu avait détruit tous les escaliers qui conduisaient aux étages supérieurs."
                                            },
                                            {
                                                "example_id": "d7c14f6e-1018-4df7-ac0e-1e578e047135",
                                                "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                                "text": "Le principal avantage des vis à bois est de permettre des assemblages résistant à la traction, même lorsqu'un seul côté est accessible."
                                            },
                                            {
                                                "example_id": "882afe8c-9b37-496f-b5b8-1e320b515025",
                                                "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                                "text": "C’est donner à la personne les moyens dont elle a besoin, compte tenu du handicap, pour qu’elle dispose de toutes les chances de s’épanouir, au même titre que tous les citoyens, dans une société accessible à tous sans discrimination."
                                            },
                                            {
                                                "example_id": "b94158f6-8d59-4cdb-b987-fb5bf2944f35",
                                                "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                                "text": "Cette place, ce poste n’est pas accessible."
                                            },
                                            {
                                                "example_id": "2805ac4c-ccd6-4fa6-82c6-076f0ad2207b",
                                                "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                                "text": "C’est un homme qui est accessible à toute heure. — Il est accessible à tout le monde."
                                            },
                                            {
                                                "example_id": "ef1f1f3e-775b-4590-bd64-5e0c624da92c",
                                                "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                                                "text": "Cette science est devenue accessible à tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ae495f-29ab-399b-98f5-9a2d30304d0c",
                                        "entry_id": "15e4264c-4a8a-3d32-a924-976f5b774cac",
                                        "glosses": [
                                            "Que l'on est susceptible d'obtenir ; qui est à la portée de quelqu'un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02be1bef-c211-46a6-9afa-bb67229f75ee",
                                                "sense_id": "61ae495f-29ab-399b-98f5-9a2d30304d0c",
                                                "text": "Il est difficile de rencontrer des ouvrages d'un prix accessible à toutes les bourses qui soit en même temps moral, instructif et amusant, triple but de tout livre écrit pour la jeunesse."
                                            },
                                            {
                                                "example_id": "916e06ca-d715-4362-84d0-70055c8be46c",
                                                "sense_id": "61ae495f-29ab-399b-98f5-9a2d30304d0c",
                                                "text": "En outre, la distinction opérable / inopérable se complique, certains cancers inopérables peuvent devenir accessibles à l’exérèse si celle-ci est couplée à la radiothérapie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3142e07-ff3d-37e9-98ec-7c7a7afcf997",
                                        "entry_id": "15e4264c-4a8a-3d32-a924-976f5b774cac",
                                        "glosses": [
                                            "Qui permet l’accueil de personnes à mobilité réduite ou porteuse d’un handicap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0ff230-6b14-46d4-9005-c7934ddb1af0",
                                                "sense_id": "f3142e07-ff3d-37e9-98ec-7c7a7afcf997",
                                                "text": "Est considéré comme accessible aux personnes handicapées tout bâtiment ou aménagement permettant, dans des conditions normales de fonctionnement, à des personnes handicapées, avec la plus grande autonomie possible, de circuler, d’accéder aux locaux et équipements, d’utiliser les équipements, de se repérer, de communiquer et de bénéficier des prestations en vue desquelles cet établissement ou cette installation a été conçu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
