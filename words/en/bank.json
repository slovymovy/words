    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36f9840b-4654-3ba9-bce5-9162fe6ad20f",
                    "sense_definition": "An institution where one can place and borrow money and take care of financial affairs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to go to the <w>bank</w> to withdraw some cash for the weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нужно сходить в <w>банк</w>, чтобы снять наличные на выходные."
                            }
                        },
                        {
                            "text": "Most people now use a mobile app to manage their <w>bank</w> accounts.",
                            "target_lang_translations": {
                                "ru": "Большинство людей сейчас используют мобильное приложение для управления своими <w>банковскими</w> счетами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank account",
                        "bank loan",
                        "investment bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учреждение, где можно хранить и брать в долг деньги, а также вести финансовые дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банк",
                                "target_lang_sense_clarification": "финансовая организация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf192024-c64a-3ee5-88c1-2990ae8068a2",
                    "sense_definition": "A branch office of a financial institution.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a small <w>bank</w> located inside the local supermarket.",
                            "target_lang_translations": {
                                "ru": "В местном супермаркете расположено небольшое отделение <w>банка</w>."
                            }
                        },
                        {
                            "text": "The local <w>bank</w> closed down last year due to the rise of online services.",
                            "target_lang_translations": {
                                "ru": "Местный <w>банк</w> закрылся в прошлом году из-за роста онлайн-услуг."
                            }
                        }
                    ],
                    "common_phrases": [
                        "local bank",
                        "branch bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделение финансового учреждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банк",
                                "target_lang_sense_clarification": "здание или филиал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "917a2a31-9a03-31f9-9fab-7e5b18582b70",
                    "sense_definition": "A safe and guaranteed place of storage for and retrieval of important items or goods.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital requested more donors to help replenish the blood <w>bank</w>.",
                            "target_lang_translations": {
                                "ru": "Больница попросила больше доноров помочь пополнить <w>банк</w> крови."
                            }
                        },
                        {
                            "text": "Scientists are building a massive data <w>bank</w> to store genetic information.",
                            "target_lang_translations": {
                                "ru": "Ученые создают огромный <w>банк</w> данных для хранения генетической информации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blood bank",
                        "data bank",
                        "food bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надежное место для хранения и получения важных предметов или товаров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банк",
                                "target_lang_sense_clarification": "хранилище данных или биоматериалов"
                            },
                            {
                                "target_lang_word": "хранилище",
                                "target_lang_sense_clarification": "общее место хранения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c219d899-ae78-39c2-878c-25f658926667",
                    "sense_definition": "A device used to store coins or currency.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child put all his spare change into a ceramic piggy <w>bank</w>.",
                            "target_lang_translations": {
                                "ru": "Ребенок положил всю мелочь в керамическую <w>копилку</w>-свинью."
                            }
                        },
                        {
                            "text": "She broke her <w>bank</w> to see how much money she had saved.",
                            "target_lang_translations": {
                                "ru": "Она разбила свою <w>копилку</w>, чтобы посмотреть, сколько денег ей удалось накопить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "piggy bank",
                        "coin bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, используемое для хранения монет или валюты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копилка",
                                "target_lang_sense_clarification": "для хранения мелочи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1400b33-a798-3b2c-8feb-523755777920",
                    "sense_definition": "Money or profit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was making serious <w>bank</w> working as a consultant for that tech firm.",
                            "target_lang_translations": {
                                "ru": "Он зашибал серьезные <w>бабки</w>, работая консультантом в той технологической фирме."
                            }
                        },
                        {
                            "text": "The movie made good <w>bank</w> during its opening weekend at the box office.",
                            "target_lang_translations": {
                                "ru": "Фильм сорвал хороший <w>куш</w> в прокате за первые выходные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make bank"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage referring to money"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги или прибыль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куш",
                                "target_lang_sense_clarification": "большие деньги"
                            },
                            {
                                "target_lang_word": "бабки",
                                "target_lang_sense_clarification": "сленг: деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87037b8d-c281-3cad-9011-684593c599dc",
                    "sense_definition": "A fund from deposits or contributions, to be used in transacting business.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The partners decided to pool their resources into a common <w>bank</w> for the venture.",
                            "target_lang_translations": {
                                "ru": "Партнеры решили объединить свои ресурсы в общий <w>банк</w> для этого предприятия."
                            }
                        },
                        {
                            "text": "Every man should be master of his own money rather than relying on a joint <w>bank</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый должен сам распоряжаться своими деньгами, а не полагаться на общий <w>банк</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "common bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фонд из вкладов или взносов, используемый для ведения бизнеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банк",
                                "target_lang_sense_clarification": "общий фонд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e77aea2-920e-3784-a514-88a973cd0098",
                    "sense_definition": "An edge of river, lake, or other watercourse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat on the river <w>bank</w> and watched the boats go by.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на <w>берегу</w> реки и смотрели на проплывающие мимо лодки."
                            }
                        },
                        {
                            "text": "The heavy rain caused the water to overflow the <w>bank</w> of the stream.",
                            "target_lang_translations": {
                                "ru": "Из-за сильного дождя вода вышла за <w>берега</w> ручья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "river bank",
                        "grassy bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Край реки, озера или другого водоема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "берег",
                                "target_lang_sense_clarification": "у воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98a4adaf-74ff-3477-bbe0-7602ba2841da",
                    "sense_definition": "A row or panel of items stored or grouped together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician checked the <w>bank</w> of switches to find the faulty connection.",
                            "target_lang_translations": {
                                "ru": "Техник проверил <w>ряд</w> переключателей, чтобы найти неисправное соединение."
                            }
                        },
                        {
                            "text": "A large <w>bank</w> of monitors displayed the security footage from across the building.",
                            "target_lang_translations": {
                                "ru": "На большой <w>панели</w> мониторов отображались записи с камер видеонаблюдения со всего здания."
                            }
                        }
                    ],
                    "synonyms": [
                        "line",
                        "rank",
                        "tier",
                        "block",
                        "grid",
                        "panel"
                    ],
                    "common_phrases": [
                        "bank of switches",
                        "bank of monitors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд или панель предметов, хранящихся или сгруппированных вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ряд",
                                "target_lang_sense_clarification": "группа объектов"
                            },
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "группа приборов или переключателей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83a31e45-5330-3bca-ad18-35cdf7a87018",
                    "sense_definition": "A mass of clouds or fog.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thick <w>bank</w> of fog rolled in from the sea, hiding the coastline.",
                            "target_lang_translations": {
                                "ru": "Густая <w>пелена</w> тумана пришла с моря, скрыв береговую линию."
                            }
                        },
                        {
                            "text": "The sun disappeared behind a heavy <w>bank</w> of clouds on the horizon.",
                            "target_lang_translations": {
                                "ru": "Солнце скрылось за плотной <w>грядой</w> облаков на горизонте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank of clouds",
                        "fog bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масса облаков или тумана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гряда",
                                "target_lang_sense_clarification": "облаков"
                            },
                            {
                                "target_lang_word": "пелена",
                                "target_lang_sense_clarification": "тумана"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "319cea2d-8d33-3df7-b78b-d9602829ab4e",
                    "sense_definition": "An elevation under the sea; a shallow area of shifting sand or gravel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishing boats headed toward the Grand <w>Banks</w> where the water is shallow.",
                            "target_lang_translations": {
                                "ru": "Рыболовные суда направились к Большой Ньюфаундлендской <w>банке</w>, где вода неглубокая."
                            }
                        },
                        {
                            "text": "The ship ran aground on a hidden sand <w>bank</w> near the coast.",
                            "target_lang_translations": {
                                "ru": "Корабль сел на мель на скрытой песчаной <w>отмели</w> у побережья."
                            }
                        }
                    ],
                    "synonyms": [
                        "bar"
                    ],
                    "common_phrases": [
                        "sand bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвышение под водой; мелководье из песка или гравия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмель",
                                "target_lang_sense_clarification": "мелководье"
                            },
                            {
                                "target_lang_word": "банка",
                                "target_lang_sense_clarification": "морской термин: подводная мель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8cd722a-27dc-3ef0-845d-099c8660196a",
                    "sense_definition": "The incline of an aircraft, especially during a turn.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot maintained a steady <w>bank</w> as the plane circled the airport.",
                            "target_lang_translations": {
                                "ru": "Пилот поддерживал устойчивый <w>крен</w>, пока самолет кружил над аэропортом."
                            }
                        },
                        {
                            "text": "The steep <w>bank</w> of the aircraft made some of the passengers feel uneasy.",
                            "target_lang_translations": {
                                "ru": "Крутой <w>крен</w> самолета заставил некоторых пассажиров понервничать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steep bank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклон самолета, особенно во время поворота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крен",
                                "target_lang_sense_clarification": "наклон судна или самолета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd3fb915-9471-3181-88d9-ea997a6e94f5",
                    "sense_definition": "To put money into a bank.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finance_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>bank</w> this check before the weekend starts.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>положить</w> этот чек в банк до начала выходных."
                            }
                        },
                        {
                            "text": "She <w>banked</w> the winnings from the competition immediately.",
                            "target_lang_translations": {
                                "ru": "Она сразу же <w>внесла</w> выигрыш в соревновании на банковский счет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank the money",
                        "bank a check"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить деньги в банк."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "класть в банк",
                                "target_lang_sense_clarification": "вносить средства"
                            },
                            {
                                "target_lang_word": "положить на счет",
                                "target_lang_sense_clarification": "зачислить деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8ca0585-537f-3cba-bf15-1ab4d3088c3f",
                    "sense_definition": "To deal with a bank, or for an institution to provide financial services to a client.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My family has <w>banked</w> with the same institution for three generations.",
                            "target_lang_translations": {
                                "ru": "Моя семья <w>обслуживается</w> в одном и том же банке уже три поколения."
                            }
                        },
                        {
                            "text": "It is much easier to <w>bank</w> online than to visit a physical branch.",
                            "target_lang_translations": {
                                "ru": "Гораздо проще <w>пользоваться банковскими услугами</w> онлайн, чем посещать физическое отделение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пользоваться услугами банка или предоставлять финансовые услуги клиенту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обслуживаться в банке",
                                "target_lang_sense_clarification": "быть клиентом"
                            },
                            {
                                "target_lang_word": "вести дела с банком",
                                "target_lang_sense_clarification": "взаимодействовать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c738639-a7da-3381-bbe9-b3a830eea4eb",
                    "sense_definition": "To roll or incline laterally in order to turn, especially of an aircraft or vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airplane began to <w>bank</w> to the left as it approached the runway.",
                            "target_lang_translations": {
                                "ru": "Самолет начал <w>накреняться</w> влево при приближении к взлетно-посадочной полосе."
                            }
                        },
                        {
                            "text": "The cyclist had to <w>bank</w> sharply to stay on the curved track.",
                            "target_lang_translations": {
                                "ru": "Велосипедисту пришлось резко <w>наклониться</w>, чтобы удержаться на вираже трассы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank left",
                        "bank sharply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклоняться в сторону для совершения поворота (о самолете или транспортном средстве)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накреняться",
                                "target_lang_sense_clarification": "делать крен"
                            },
                            {
                                "target_lang_word": "ложиться на крыло",
                                "target_lang_sense_clarification": "об авиации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e731439e-54ce-39f9-8397-96bd960d09c7",
                    "sense_definition": "To form into a bank or heap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind started to <w>bank</w> the snow against the side of the house.",
                            "target_lang_translations": {
                                "ru": "Ветер начал <w>наметать</w> снег к стене дома."
                            }
                        },
                        {
                            "text": "The workers had to <w>bank</w> up the earth to create a temporary dam.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>насыпать</w> землю, чтобы создать временную дамбу."
                            }
                        }
                    ],
                    "synonyms": [
                        "bank up"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Складывать в кучу или насыпь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыпать",
                                "target_lang_sense_clarification": "формировать вал"
                            },
                            {
                                "target_lang_word": "громоздить",
                                "target_lang_sense_clarification": "складывать в кучу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "800e530b-d73e-3f21-9067-bd882341a3d2",
                    "sense_definition": "To cover the embers of a fire with ashes in order to retain heat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fire_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before going to bed, he <w>banked</w> the fire so it would stay warm until morning.",
                            "target_lang_translations": {
                                "ru": "Перед сном он <w>присыпал</w> огонь золой, чтобы он сохранял тепло до утра."
                            }
