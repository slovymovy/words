                    {
                        "sense_id": "ef0c54cd-06f3-3d8e-bdb0-8af8ea071982",
                        "entry_id": "bc953edf-5219-3443-b04d-5d2916a635f3",
                        "glosses": [
                            "Chiffonnier ambulant qui passait, autrefois, de village en village."
                        ],
                        "tags": [
                            "Auvergne",
                            "Limousin"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9bc019-b231-4f6a-bd68-c228a624a7b7",
                                "sense_id": "ef0c54cd-06f3-3d8e-bdb0-8af8ea071982",
                                "text": "C'était le chiffonnier surnommé « peillarot », qui achète chiffons, ferrailles, peaux de lapins, de sauvagines, de taupes, soies de porcs, etc."
                            },
                            {
                                "example_id": "3b801601-e91d-40fb-af7c-9355da0682da",
                                "sense_id": "ef0c54cd-06f3-3d8e-bdb0-8af8ea071982",
                                "text": "Les tournées en ville résonnaient de leurs cris : « Car il fallait les crier, les chiffons, pour que les gens entendent : peillarot , peillarot. Les gens sortaient la tête par la fenêtre et ils les faisaient monter, ou bien ils disaient : je descends »."
                            }
                        ]
                    },
                    {
                        "sense_id": "f26ba0ae-9cfe-3083-b55e-19e0dcdaa4fe",
                        "entry_id": "bc953edf-5219-3443-b04d-5d2916a635f3",
                        "glosses": [
                            "Colporteur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6473ce91-dd3a-4794-8eea-076c570ae623",
                                "sense_id": "f26ba0ae-9cfe-3083-b55e-19e0dcdaa4fe",
                                "text": "Là, lorsque d'aventure, à la chute du jour, on voyait le peillarot s'avancer à travers la plaine , portant sur le dos toute sa petite boutique empaquetée ballot informe, aux plus curieux renflements, presque toujours bardé de peaux de lièvres et de lapins retournées, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "8aacb017-f2e8-375e-b778-3d9e93df0975",
                        "entry_id": "bc953edf-5219-3443-b04d-5d2916a635f3",
                        "glosses": [
                            "Commerçant ambulant en peaux de lapin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab442404-8a5e-45df-aaa0-8d34cd2e7431",
                                "sense_id": "8aacb017-f2e8-375e-b778-3d9e93df0975",
                                "text": "Tout au plus si on me considère à l'égal du « peillarot » , avec ses chiens , sa carriole et ses peaux de lapins ."
                            }
                        ]
                    }
