{
    "word_family": [
        "heave",
        "heave-off",
        "heaver",
        "upheaval"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e0e8d2d-1004-3063-860b-f4ff5442d110",
                    "sense_definition": "present participle and gerund of <w>heave</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "heave_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers were exhausted after <w>heaving</w> heavy boxes onto the truck all morning.",
                            "target_lang_translations": {
                                "cs": "Dělníci byli vyčerpaní po celém ránu <w>tahání</w> těžkých krabic na náklaďák."
                            }
                        },
                        {
                            "text": "His chest was <w>heaving</w> rapidly as he tried to catch his breath after the race.",
                            "target_lang_translations": {
                                "cs": "Hrudník se mu zprudka <w>zvedal</w>, jak se po závodě snažil popadnout dech."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heaving a sigh",
                        "chest heaving"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium od slovesa heave; zvedání těžkého břemene s námahou, nebo prudké dmýchání/zvedání se (např. hrudníku)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tahat",
                                "target_lang_sense_clarification": "s velkou námahou břemeno"
                            },
                            {
                                "target_lang_word": "zvedat",
                                "target_lang_sense_clarification": "těžký náklad"
                            },
                            {
                                "target_lang_word": "zvedat se",
                                "target_lang_sense_clarification": "o hrudníku při těžkém dýchání"
                            },
                            {
                                "target_lang_word": "dmychat se",
                                "target_lang_sense_clarification": "o hrudi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3fae06e-c02b-3015-bd1f-efb8c97bf1be",
                    "sense_definition": "Extremely crowded or packed full of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crowded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train station was absolutely <w>heaving</w> with commuters during the evening rush hour.",
                            "target_lang_translations": {
                                "cs": "Vlakové nádraží bylo během večerní špičky dojíždějícími lidmi doslova <w>narvané k prasknutí</w>."
                            }
                        },
                        {
                            "text": "We decided to leave the pub because it was <w>heaving</w> and there was nowhere to sit.",
                            "target_lang_translations": {
                                "cs": "Rozhodli jsme se z hospody odejít, protože byla <w>přeplněná</w> a nebylo si kam sednout."
                            }
                        }
                    ],
                    "synonyms": [
                        "crowded",
                        "jam-packed",
                        "packed",
                        "teeming"
                    ],
                    "antonyms": [
                        "deserted",
                        "empty"
                    ],
                    "common_phrases": [
                        "absolutely heaving",
                        "heaving with people"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in British and Commonwealth English"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "extrémně přeplněný, narvaný k prasknutí (hlavně lidmi)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "narvaný",
                                "target_lang_sense_clarification": "k prasknutí lidmi, hovorově"
                            },
                            {
                                "target_lang_word": "přeplněný",
                                "target_lang_sense_clarification": "plný lidí"
                            },
                            {
                                "target_lang_word": "nacpaný",
                                "target_lang_sense_clarification": "lidmi k nehnutí"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5aef247d-da7f-32d0-9dc6-e60f7cf9e9c1",
                    "sense_definition": "An instance or motion of lifting, rising, or swelling forcefully.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "heave_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>heaving</w> of the ship made several passengers feel instantly seasick.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>houpání</w> lodi způsobilo několika pasažérům okamžitou mořskou nemoc."
                            }
                        },
                        {
                            "text": "Violent subterraneous <w>heavings</w> shook the ground before the volcano finally erupted.",
                            "target_lang_translations": {
                                "cs": "Než sopka konečně vybuchla, otřásalo zemí prudké podzemní <w>vzdouvání</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rising",
                        "swelling"
                    ],
                    "common_phrases": [
                        "violent heaving"
                    ],
                    "target_lang_definitions": {
                        "cs": "prudký pohyb nahoru a dolů, houpání nebo vzdouvání"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vzdouvání",
                                "target_lang_sense_clarification": "vln, země či hrudi"
                            },
                            {
                                "target_lang_word": "houpání",
                                "target_lang_sense_clarification": "lodi na vlnách"
                            },
                            {
                                "target_lang_word": "nadouvání",
                                "target_lang_sense_clarification": "povrchu či země"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}