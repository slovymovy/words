                        "examples": [
                            {
                                "example_id": "18ae8484-f501-4cf2-9226-f0663596f560",
                                "sense_id": "d1b69fa7-6833-3190-bf29-22f64b8ac8d2",
                                "text": "Ich bin in Alicante geboren."
                            },
                            {
                                "example_id": "f96bf7ba-45c5-40f4-81ee-77be5c2db362",
                                "sense_id": "d1b69fa7-6833-3190-bf29-22f64b8ac8d2",
                                "text": "Ich habe in Alicante meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "a151b3c6-7de3-4ebb-b2d5-1e86f346401b",
                                "sense_id": "d1b69fa7-6833-3190-bf29-22f64b8ac8d2",
                                "text": "Nach Alicante führen viele Wege."
                            },
                            {
                                "example_id": "1aac01d2-593f-4664-aa1e-339b22c95a81",
                                "sense_id": "d1b69fa7-6833-3190-bf29-22f64b8ac8d2",
                                "text": "„In Spanien, wo die Weine ausgezeichnet sind, besonders an der Küste, an der ich mich aufhielt, in der Nähe von Malaga und Alicante, kann sich ein Fremder nur mit großen Schwierigkeiten ein Glas leidlichen Weines verschaffen.“"
                            }
                        ],
