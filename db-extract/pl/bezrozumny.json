                        "source_sense_id": "bd8c9232-5d5f-3bc9-a8f2-6016d47a199e",
                        "target_lang_word": "irrational",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11324c79-e3e8-3ffb-9ebf-6ae02c435839",
                                        "entry_id": "2fa2da3b-f3c0-3701-95a0-454e47a5b47d",
                                        "glosses": [
                                            "Not rational; unfounded, nonsensical or wrong-headed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe62e9f3-dae8-481c-b9d7-429edd65e2da",
                                                "sense_id": "11324c79-e3e8-3ffb-9ebf-6ae02c435839",
                                                "text": "an irrational decision"
                                            },
                                            {
                                                "example_id": "115ae65a-2f5b-4c84-afc5-fdad2b1d30c2",
                                                "sense_id": "11324c79-e3e8-3ffb-9ebf-6ae02c435839",
                                                "text": "July 18, 2012, Scott Tobias, AV Club The Dark Knight Riseshttp://www.avclub.com/articles/the-dark-knight-rises-review-batman,82624/\nWhere the Joker preys on our fears of random, irrational acts of terror, Bane has an all-consuming, dictatorial agenda that’s more stable and permanent, a New World Order that’s been planned out with the precision of a military coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d99f907-1069-3181-ba65-093313a07ec6",
                                        "entry_id": "2fa2da3b-f3c0-3701-95a0-454e47a5b47d",
                                        "glosses": [
                                            "Of a real number, that cannot be written as the ratio of two integers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ef1beb8-2238-431b-8580-62d0f993d285",
                                                "sense_id": "4d99f907-1069-3181-ba65-093313a07ec6",
                                                "text": "The number π is irrational."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irrational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "655a45c5-d09a-3e25-9ad1-fae25ff9d30c",
                                        "entry_id": "a858dede-5373-3dac-bffe-96a2a4f7c2d1",
                                        "glosses": [
                                            "A real number that can not be expressed as the quotient of two integers, an irrational number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6571742e-22e0-4318-9672-c976a00fa0f0",
                                                "sense_id": "655a45c5-d09a-3e25-9ad1-fae25ff9d30c",
                                                "text": "The square root of 2, which was the first irrational to be discovered, was known to the early Pythagoreans, and ingenious methods of approximating to its value were discovered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdf432b9-703a-4394-95f9-cd42f4765ad2",
                        "source_entry_id": "6e898ee2-f0e1-3296-95f9-8f014547249d",
