                        ],
                        "form": "ontdekkinkje"
                    },
                    {
                        "form_id": "d1247045-c998-48af-ba39-4462481a771a",
                        "entry_id": "5578abf0-ec96-3929-9bfe-1d7c320cc0d7",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "ontdekkinkjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9712d37c-d7e1-3d8f-a498-f5fb8e95804c",
                        "entry_id": "5578abf0-ec96-3929-9bfe-1d7c320cc0d7",
                        "glosses": [
                            "het vinden van iets dat nog niet bekend was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1a8fb7-c3dc-4d4f-867d-39d4f5f422a1",
                                "sense_id": "9712d37c-d7e1-3d8f-a498-f5fb8e95804c",
                                "text": "Hij deed een ontdekking die de wereld schokte."
                            },
                            {
                                "example_id": "4ad7fd23-e591-4842-aef6-7eb6b19c90b2",
                                "sense_id": "9712d37c-d7e1-3d8f-a498-f5fb8e95804c",
                                "text": "Als hij overeind komt, is Albert nog volkomen versuft door zijn ontdekking."
                            },
                            {
                                "example_id": "60e5f8f8-76fa-4679-8c77-4771c49444d0",
                                "sense_id": "9712d37c-d7e1-3d8f-a498-f5fb8e95804c",
                                "text": "Het was soms verrassend te ontdekken wat ik nou echt van een onderwerp vond, net zoals de ontdekking dat ik over een aantal onderwerpen ook helemaal geen uitgesproken mening had."
                            },
                            {
                                "example_id": "32356ba4-ff51-4446-afc4-d5581450d6cc",
                                "sense_id": "9712d37c-d7e1-3d8f-a498-f5fb8e95804c",
                                "text": "‘Alle antimaterieontdekkingen zijn iets heel interessants. Dit is er een die nog ontbrak’, zegt Dönigus. Zijn onderzoeksgroep gebruikte kunstmatige intelligentie (machine learning) om gegevens te analyseren van een experiment uit 2018 met de ALICE-detector bij de LHC om het antihyperhelium-4 te identificeren met een significantie van 3,5 standaarddeviaties. Het onderzoek haalt niet de ‘gouden standaard’ van 5 standaarddeviaties. Maar het geeft wel aan dat het zeer waarschijnlijk is dat de ontdekking echt is en geen gril van de gegevens is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c62b4ded-e38e-4e4a-a1a1-ed5c2c6db597",
                        "source_entry_id": "5578abf0-ec96-3929-9bfe-1d7c320cc0d7",
                        "source_sense_id": "9712d37c-d7e1-3d8f-a498-f5fb8e95804c",
                        "source_sense_description": "het vinden van iets nieuws",
                        "target_lang_word": "discovery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discovery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3d36d6-352b-38f5-adbf-de761add97ff",
                                        "entry_id": "861c0dc9-3005-3591-bc6d-1068534a1672",
                                        "glosses": [
                                            "Something discovered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a233c2e6-7011-4a70-a9df-fac20fb35225",
                                                "sense_id": "fd3d36d6-352b-38f5-adbf-de761add97ff",
                                                "text": "This latest discovery should eventually lead to much better treatments for disease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "033ff9fb-27a4-35af-a6b9-4bacac31ecba",
                                        "entry_id": "861c0dc9-3005-3591-bc6d-1068534a1672",
                                        "glosses": [
                                            "The discovering of new things."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8375b4c-0d2a-45bb-8f95-e4e663cb1bc9",
                                                "sense_id": "033ff9fb-27a4-35af-a6b9-4bacac31ecba",
                                                "text": "The purpose of the voyage was discovery."
                                            },
                                            {
                                                "example_id": "d991ad49-07e2-4527-9548-27f6aee15812",
                                                "sense_id": "033ff9fb-27a4-35af-a6b9-4bacac31ecba",
                                                "text": "Automatic discovery of RSS feeds by a Web browser."
                                            },
                                            {
                                                "example_id": "f8220b83-59eb-4aa8-ab78-3fbbcda7bd5a",
                                                "sense_id": "033ff9fb-27a4-35af-a6b9-4bacac31ecba",
                                                "text": "The letters patents of king Henry the ſeuenth granted vnto Iohn Cabot and his three ſonnes, Lewis, Sebastian, and Sancius, for the discouerie of new and vnknowen lands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f30a723e-03ca-3175-874e-1d0593eb26ca",
                                        "entry_id": "861c0dc9-3005-3591-bc6d-1068534a1672",
                                        "glosses": [
                                            "An act of uncovering or revealing something; a revelation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32eff1e4-5be0-4ce1-b015-1646e53d30bd",
                                                "sense_id": "f30a723e-03ca-3175-874e-1d0593eb26ca",
                                                "text": "Don Huberto actually fell in love with his kinswoman, and had presumption enough to declare his passion […] The lady being a woman of discretion, instead of making a discovery, which might have been attended with melancholy consequences, reprimanded her relation with gentleness […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9acfc33e-c92f-37f5-a9b3-69c5603ffe47",
                                        "entry_id": "861c0dc9-3005-3591-bc6d-1068534a1672",
                                        "glosses": [
                                            "A pre-trial phase in which evidence is gathered."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700f384f-bb78-462c-b3d6-0e689df5cca6",
                                                "sense_id": "9acfc33e-c92f-37f5-a9b3-69c5603ffe47",
                                                "text": "The prosecution moved to suppress certain items turned up during discovery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea4df13-dba3-3cf5-838e-ec7e1876b1b9",
                                        "entry_id": "861c0dc9-3005-3591-bc6d-1068534a1672",
                                        "glosses": [
                                            "Materials revealed to the opposing party during the pre-trial phase in which evidence is gathered."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ece559e-0ffc-438a-9f90-98d9a3c67c8c",
                                                "sense_id": "4ea4df13-dba3-3cf5-838e-ec7e1876b1b9",
                                                "text": "The defense argued that the plaintiff's discovery was inadequate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92479fd7-2d04-36d1-8352-b1d6ea58fca8",
                                        "entry_id": "861c0dc9-3005-3591-bc6d-1068534a1672",
                                        "glosses": [
                                            "A discovered attack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1183522b-8ce8-4a6f-9af4-a40d6d4df73b",
                                                "sense_id": "92479fd7-2d04-36d1-8352-b1d6ea58fca8",
                                                "text": "1700: \"If I play f4, he can check me with ...Qd4, but then he has to move his Queen because he can easily lose it to a Bishop discovery on b5. He could also check me on c5 when his Queen might be safer. I could just move out of the way, though, and continue my attack.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a78dee6-b011-48a2-a5e1-738f38337027",
                        "source_entry_id": "5578abf0-ec96-3929-9bfe-1d7c320cc0d7",
                        "source_sense_id": "9712d37c-d7e1-3d8f-a498-f5fb8e95804c",
                        "source_sense_description": "het vinden van iets nieuws",
                        "target_lang_word": "découverte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "découverte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49a517d1-f2c6-301f-a290-cb01524d6879",
                                        "entry_id": "737ba958-6772-320e-9bdd-0c6fc5b809d7",
                                        "glosses": [
                                            "Action de découvrir, de trouver ce qui n’était pas connu, invention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21610ae2-8242-447f-9e97-a28862fcacb7",
                                                "sense_id": "49a517d1-f2c6-301f-a290-cb01524d6879",
                                                "text": "Le saisissement que provoque la découverte du cadavre est le déclencheur d’un autre mode de résolution de l’énigme."
                                            },
                                            {
                                                "example_id": "e6aea6c2-8139-4ae1-b6b5-1db9bb59b60c",
                                                "sense_id": "49a517d1-f2c6-301f-a290-cb01524d6879",
                                                "text": "J’ai eu longtemps avec moi un homme qui avait demeuré dix ou douze ans en cet autre monde qui a été découvert en notre siècle, en l’endroit où Vilegaignon prit terre, qu’il surnomma la France Antartique. Cette découverte d’un pays infini semble être de considération. Je ne sais si je me puis répondre qu'il ne s’en fasse à l’avenir quelqu' autre, tant de personnages plus grands que nous ayant été trompés en celle-ci."
                                            },
                                            {
                                                "example_id": "39d53bad-4d1a-4150-b1a0-39f7f7b8a5e3",
                                                "sense_id": "49a517d1-f2c6-301f-a290-cb01524d6879",
                                                "text": "La découverte d'un manuscrit complètement inconnu, dans une époque où la science historique est poussée à un si haut degré, nous parut presque miraculeuse."
                                            },
                                            {
                                                "example_id": "0436773e-a4d3-4986-bb13-90867fb4de75",
                                                "sense_id": "49a517d1-f2c6-301f-a290-cb01524d6879",
                                                "text": "Je m’éveillai le lendemain dans le Breidifjord, d’où fit voile Erik le Rouge lorsqu’il alla à la découverte du Groënland en 984."
                                            },
                                            {
                                                "example_id": "89c300b2-4025-4749-9bd6-fac4fb03eeb1",
                                                "sense_id": "49a517d1-f2c6-301f-a290-cb01524d6879",
                                                "text": "Les gens des hautes classes ont toujours estimé qu’ils avaient moins besoin d’être disciplinés moralement que leurs subordonnés, et c’est pour avoir fait de cette belle découverte la base de leur théologie, que des jésuites ont tant de succès dans la bourgeoisie contemporaine."
                                            },
                                            {
                                                "example_id": "4026c750-33ee-45b2-8790-7a08c3e33fb5",
                                                "sense_id": "49a517d1-f2c6-301f-a290-cb01524d6879",
                                                "text": "On attribue aux Arabes la découverte de l’art d’extraire l’alcool du vin et des autres boissons fermentées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ced5933-1913-32dd-9002-65d0b03ed896",
                                        "entry_id": "737ba958-6772-320e-9bdd-0c6fc5b809d7",
                                        "glosses": [
                                            "Action d’inventer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbabe040-a4db-40e6-a65d-fe9740a6ee76",
                                                "sense_id": "7ced5933-1913-32dd-9002-65d0b03ed896",
                                                "text": "La découverte de la pénicilline a révolutionné la médecine."
                                            },
                                            {
                                                "example_id": "6f9bcd71-a774-44a0-a026-a9e239d6d648",
                                                "sense_id": "7ced5933-1913-32dd-9002-65d0b03ed896",
                                                "text": "La découverte de la vaccination rencontrait encore beaucoup d'opposants du temps de Voltaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "750560bf-e599-37e1-a202-b133ce21db3a",
                                        "entry_id": "737ba958-6772-320e-9bdd-0c6fc5b809d7",
                                        "glosses": [
                                            "Chose même qu’on a découverte, qu’on a trouvée, trouvaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b406b5fd-d877-422d-9996-17ccd05451f8",
                                                "sense_id": "750560bf-e599-37e1-a202-b133ce21db3a",
                                                "text": "Ces idiots prétendent découvrir une Amérique tous les matins ; mais nous rions de leur découverte, ne voulant pas être brimés par des canotiers de la Seine déguisés en Christophe Colomb."
                                            },
                                            {
                                                "example_id": "5781f1c0-2184-4e73-824f-0f1d03ece658",
                                                "sense_id": "750560bf-e599-37e1-a202-b133ce21db3a",
                                                "text": "Mais toutes les grandes découvertes des cinq derniers siècles ne sont pour lui que tissus de mensonges et hérésies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e7594c-20da-34ae-925e-90defd5edcee",
                                        "entry_id": "737ba958-6772-320e-9bdd-0c6fc5b809d7",
                                        "glosses": [
                                            "Partie supérieure d’un gisement qui n’est pas exploitée et qui est évacuée."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffdeb42e-4f48-3d21-b898-e4fc82ae8329",
                                        "entry_id": "737ba958-6772-320e-9bdd-0c6fc5b809d7",
                                        "glosses": [
                                            "Action d’évacuer cette partie du gisement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b02fa2-51e9-46f6-860f-5dd7da9183be",
                                                "sense_id": "ffdeb42e-4f48-3d21-b898-e4fc82ae8329",
                                                "text": "Après découverte à sec et décapage sélectif par engins mécaniques (pelle mécanique, tombereau), l’extraction du gisement sera réalisée majoritairement en eau, à l’aide d’un scraper, d’une dragueline ou d’une pelle."
                                            }
                                        ]
                                    }
                                ]
                            },
