                "senses": [
                    {
                        "sense_id": "9de355c6-269c-3b3e-85d1-cdc4f8232ae3",
                        "entry_id": "921f10c5-cc1c-3d0f-a67e-96b43c0887df",
                        "glosses": [
                            "Person, die andere mit Forderungen/Wünschen nachhaltig bedrängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9df33a3f-26c6-498e-b605-d57e3a7802ff",
                                "sense_id": "9de355c6-269c-3b3e-85d1-cdc4f8232ae3",
                                "text": "„Der derzeit größte Plagegeist von ARD und ZDF sitzt in Dresden.“"
                            },
                            {
                                "example_id": "0c10f2f8-3515-432c-a65c-6e0435af5079",
                                "sense_id": "9de355c6-269c-3b3e-85d1-cdc4f8232ae3",
                                "text": "„Etwas anderes haben diese Plagegeister nicht im Angebot.“"
                            },
                            {
                                "example_id": "e00609c6-84ea-44b2-b67d-542d3b611115",
                                "sense_id": "9de355c6-269c-3b3e-85d1-cdc4f8232ae3",
                                "text": "„Aber als ich es weiter beobachtete, sah ich, daß es die Augen ein wenig öffnete und seinen Plagegeist mit einem verschlagenen Ausdruck bewachte.“"
                            },
                            {
                                "example_id": "fbfdb4fc-35aa-4b09-a3a7-0334b6116142",
                                "sense_id": "9de355c6-269c-3b3e-85d1-cdc4f8232ae3",
                                "text": "„Diese Frau war es – sie schien ein echter Plagegeist gewesen zu sein –, die den armen Kerl vor zwanzig Jahren nach Amerika getrieben und ihm eine Abneigung gegen sein Heimatland eingeflößt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
