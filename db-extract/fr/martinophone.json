                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a789cc6f-42e0-38be-be72-9061d3813da7",
                                        "entry_id": "0df0dbd0-b4ac-3214-b611-a52c8f3459d3",
                                        "glosses": [
                                            "in der Bundesrepublik gebräuchlicher Ausdruck für das Folgetonhorn, eine akustische Warnvorrichtung an den Fahrzeugen der Polizei, der Feuerwehr und anderen Hilfskräften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d76327a-41ba-411e-b89c-701b5c606b09",
                                                "sense_id": "a789cc6f-42e0-38be-be72-9061d3813da7",
                                                "text": "Der Einsatz des Martinshorns während der Fahrt ist genau geregelt."
                                            },
                                            {
                                                "example_id": "0b50360f-5424-4d16-968a-a34351212ff1",
                                                "sense_id": "a789cc6f-42e0-38be-be72-9061d3813da7",
                                                "text": "Der Krankenwagen raste mit Blaulicht und Martinshorn durch die Stadt, um den Verletzten noch rechtzeitig ins Krankenhaus zu bringen."
                                            },
                                            {
                                                "example_id": "64d1ed06-0d65-4f58-b0c3-cd9b9fa5221c",
                                                "sense_id": "a789cc6f-42e0-38be-be72-9061d3813da7",
                                                "text": "„Das Martinshorn vom Vortag hatte ihr den Rest gegeben.“"
                                            },
                                            {
                                                "example_id": "8d08c67b-368b-4951-baa5-1e765b0e004a",
                                                "sense_id": "a789cc6f-42e0-38be-be72-9061d3813da7",
                                                "text": "„Kurz darauf klingelte das Telefon und er bekam die Adresse eines Krankenhauses genannt, rief sie dem Fahrer zu, der das Martinshorn aufheulen ließ und den Motor startete.“"
                                            }
                                        ],
