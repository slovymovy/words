                "senses": [
                    {
                        "sense_id": "632d18ed-8a8b-3e20-98df-f518d5372861",
                        "entry_id": "c4fe5d8a-d383-3803-8ebd-45b26c32c8da",
                        "glosses": [
                            "становиться хуже; проявлять тенденцию к ухудшению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d71fae81-41bf-4e64-a68a-452607ab65b2",
                                "sense_id": "632d18ed-8a8b-3e20-98df-f518d5372861",
                                "text": "С этого дня здоровье Дмитрия Александровича стало видимо и ежедневно ухудшаться: у него сделалась одышка, стали опухать ноги, и наконец, Шнауберт потребовал, чтобы созвали консилиум."
                            },
                            {
                                "example_id": "3b31dd3d-aad2-4fbb-bedc-6da629b96438",
                                "sense_id": "632d18ed-8a8b-3e20-98df-f518d5372861",
                                "text": "Советско-китайские отношения стали быстро ухудшаться с конца 1958 года, когда в Китае развернулась кампания за создание народных коммун."
                            }
                        ]
                    }
