{
    "word_family": [
        "impurity",
        "pure",
        "purify",
        "purity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e274db77-0132-37c2-bfea-7927f6a94d29",
                    "sense_definition": "Mixed with other substances; not clean or pure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>impure</w> gemstone was not good enough to be made into a necklace, so it was thrown out.",
                            "target_lang_translations": {
                                "ru": "Драгоценный камень <w>с примесями</w> был недостаточно хорош для ожерелья, поэтому его выбросили."
                            }
                        },
                        {
                            "text": "Scientists found that the <w>impure</w> water contained high levels of minerals.",
                            "target_lang_translations": {
                                "ru": "Ученые обнаружили, что <w>нечистая</w> вода содержит высокий уровень минералов."
                            }
                        }
                    ],
                    "synonyms": [
                        "tainted"
                    ],
                    "antonyms": [
                        "pure"
                    ],
                    "common_phrases": [
                        "impure water",
                        "impure substances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешанный с другими веществами; не чистый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с примесью",
                                "target_lang_sense_clarification": "содержащий посторонние элементы"
                            },
                            {
                                "target_lang_word": "нечистый",
                                "target_lang_sense_clarification": "загрязненный или содержащий добавки"
                            },
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "о воде или материалах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d867d00e-6548-363d-8bdf-2c6e9b31fb45",
                    "sense_definition": "Morally wrong or dirty, especially in a sexual way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was thinking <w>impure</w> thoughts involving a girl from school.",
                            "target_lang_translations": {
                                "ru": "Его посещали <w>нечистые</w> мысли о девочке из школы."
                            }
                        },
                        {
                            "text": "The book was banned because it was considered to contain <w>impure</w> ideas.",
                            "target_lang_translations": {
                                "ru": "Книга была запрещена, так как считалось, что она содержит <w>порочные</w> идеи."
                            }
                        }
                    ],
                    "synonyms": [
                        "imperfect"
                    ],
                    "antonyms": [
                        "pure"
                    ],
                    "common_phrases": [
                        "impure thoughts",
                        "impure motives"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально предосудительный или грязный, особенно в сексуальном плане."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечистый",
                                "target_lang_sense_clarification": "о помыслах или намерениях"
                            },
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "морально развращенный"
                            },
                            {
                                "target_lang_word": "греховный",
                                "target_lang_sense_clarification": "нарушающий моральные нормы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a302bd6-d717-3b78-b8a1-675151dd2bc5",
                    "sense_definition": "Considered religiously or spiritually unclean.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some cultures, certain animals are regarded as <w>impure</w> and cannot be eaten.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах определенные животные считаются <w>нечистыми</w>, и их нельзя употреблять в пищу."
                            }
                        },
                        {
                            "text": "The priest explained that the temple had become <w>impure</w> after the incident.",
                            "target_lang_translations": {
                                "ru": "Священник объяснил, что после случившегося храм стал <w>оскверненным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tainted"
                    ],
                    "antonyms": [
                        "pure"
                    ],
                    "common_phrases": [
                        "impure spirit",
                        "ritually impure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считающийся религиозно или духовно нечистым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечистый",
                                "target_lang_sense_clarification": "в религиозном или ритуальном смысле"
                            },
                            {
                                "target_lang_word": "оскверненный",
                                "target_lang_sense_clarification": "утративший святость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62b6f058-08cc-362c-81ef-e41a90f04898",
                    "sense_definition": "To make something dirty or to pollute it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pollution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemicals from the factory began to <w>impure</w> the local stream.",
                            "target_lang_translations": {
                                "ru": "Химикаты с завода начали <w>загрязнять</w> местный ручей."
                            }
                        },
                        {
                            "text": "He feared that bad company would <w>impure</w> his character.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что плохая компания <w>испортит</w> его характер."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо грязным или загрязнять это."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнять",
                                "target_lang_sense_clarification": "делать нечистым"
                            },
                            {
                                "target_lang_word": "осквернять",
                                "target_lang_sense_clarification": "портить характер или святыню"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}