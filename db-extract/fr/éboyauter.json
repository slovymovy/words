                "senses": [
                    {
                        "sense_id": "6ca2d52c-edd0-342e-ae11-721fc8eb98a4",
                        "entry_id": "25935539-c8eb-3198-87a7-4990b5e8a94e",
                        "glosses": [
                            "Déboyauter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f1b898-75cf-4568-b1e5-e8cbc6a405e2",
                                "sense_id": "6ca2d52c-edd0-342e-ae11-721fc8eb98a4",
                                "text": "A Villers-Bretonneux, on monte sur les tombes engazonnées jusqu’au monument des Anzacs à qui l’on servait des rasades de rhum et de vin pour qu’ils aillent éboyauter à l’arme blanche leurs adversaires."
                            },
                            {
                                "example_id": "57e47632-a4c8-4ffe-a56c-75b9f1899128",
                                "sense_id": "6ca2d52c-edd0-342e-ae11-721fc8eb98a4",
                                "text": "Ensuite il faut assassiner ces pauvres crabes, afin de les « éboyauter », jeter carapace et viscères, je connais une petite fille qui aurait adoré !"
                            }
                        ]
                    }
