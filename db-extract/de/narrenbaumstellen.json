                        "sense_id": "9e0a2668-46a1-3dc2-9767-d9e88b5c7cbb",
                        "entry_id": "04a0465e-676e-3995-bc14-b83b4c72c3be",
                        "glosses": [
                            "festliche Zeremonie, bei der ein Narrenbaum aufgestellt wird, um die Zeit der schwäbisch-alemannischen Fasnet einzuleiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2939de0f-9ff9-42f4-a3f5-1cbd6385747b",
                                "sense_id": "9e0a2668-46a1-3dc2-9767-d9e88b5c7cbb",
                                "text": "„Der Startschuss fiel beim Narrenbaumstellen am Donnerstagabend am Stachus.“"
                            },
                            {
                                "example_id": "2315e88c-9580-4d0a-9df2-349fb7e93cff",
                                "sense_id": "9e0a2668-46a1-3dc2-9767-d9e88b5c7cbb",
                                "text": "„Zur geselligen Hausfasnet mit Narrenbaumstellen lud das Franziskuszentrum der Stiftung Liebenau in Friedrichshafen ein.“"
                            },
                            {
                                "example_id": "5ab1abc3-449f-4841-87bd-cd71cab32231",
                                "sense_id": "9e0a2668-46a1-3dc2-9767-d9e88b5c7cbb",
                                "text": "„Das Ergebnis könnte durchaus Kultpotenzial haben – testen können es alle, die am Samstag zum Narrenbaumstellen auf den Marktplatz kommen.“"
                            },
                            {
                                "example_id": "9c7e4a14-5580-4596-8b55-4b776e9dc6e9",
                                "sense_id": "9e0a2668-46a1-3dc2-9767-d9e88b5c7cbb",
                                "text": "„Schwenningen hat mit dem traditionellen Narrensprung und dem Narrenbaumstellen am Samstag groß gefeiert.“"
                            },
                            {
                                "example_id": "8bdbb88c-c3dd-40d4-a99b-e81ea2262c24",
                                "sense_id": "9e0a2668-46a1-3dc2-9767-d9e88b5c7cbb",
                                "text": "„Das Narrenbaumstellen findet bei jeder Witterung und im Freien statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
