                        "sense_id": "4eeb33e1-95ae-365d-a001-fb1c6d21cb34",
                        "entry_id": "ee082534-effd-3fef-91de-d972bf248af8",
                        "glosses": [
                            "ein aus Wachs gegossener naturgetreuer Abguss einer erkrankten Körperregion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5928c460-0aa3-419e-9e2b-4bd887075f27",
                                "sense_id": "4eeb33e1-95ae-365d-a001-fb1c6d21cb34",
                                "text": "Seit dem ersten Internationalen Kongress für Haut- und Geschlechtskrankheiten 1889 im Musée des Moulages am Hôpital St. Louis in Paris galten Moulagen als die idealen Lehrmittel im dermatologischen universitären Unterricht."
                            },
                            {
                                "example_id": "563ecb53-feaa-41a8-bbd7-b78d48907a08",
                                "sense_id": "4eeb33e1-95ae-365d-a001-fb1c6d21cb34",
                                "text": "„Man macht eine Moulage von ihr, malt alles in natürlichen Farben an, das ist täuschend ähnlich, eine Art Zelluloid.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
