                ],
                "senses": [
                    {
                        "sense_id": "ab07d03a-46b6-3b8d-ad13-65bb77800ebc",
                        "entry_id": "9d70f530-3ba8-33f6-a78f-719339cd7325",
                        "glosses": [
                            "Mignon, à croquer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5fa8627f-03e6-4f44-a13c-59dc106bc70b",
                                "sense_id": "ab07d03a-46b6-3b8d-ad13-65bb77800ebc",
                                "text": "Il était une fois un Roi et une Reine qui affurèrent d’une petite môme des plus croquignolettes."
                            },
                            {
                                "example_id": "e57082f3-191d-4419-b59c-c25f6a08f39e",
                                "sense_id": "ab07d03a-46b6-3b8d-ad13-65bb77800ebc",
                                "text": "Sous le soleil, il est si croquignolet, le phare blanc bleu du cabo Home…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2f5d80aa-9939-33f1-8d4d-466654bac1c1",
                        "entry_id": "9d70f530-3ba8-33f6-a78f-719339cd7325",
                        "glosses": [
                            "Bizarre, extraordinaire ou désagréable."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "4669ef74-bc64-4e23-9a13-aa78d385e4d8",
                                "sense_id": "2f5d80aa-9939-33f1-8d4d-466654bac1c1",
                                "text": "Du haut d’un avion, [un suicide] une nuit de brouillard, en plein océan. Ça, c’est croquignolet."
                            },
                            {
                                "example_id": "d38e4682-d351-44c0-9c9c-f5b49efa8cbb",
                                "sense_id": "2f5d80aa-9939-33f1-8d4d-466654bac1c1",
                                "text": "Mark Rosenfelder s'est amusé, à partir des quelques bribes figurant dans les différents albums de Tintin, à reconstituer le syldave. Une conclusion passablement croquignolette l'attendait : les habitants de ce pays, a priori slave et situé dans les confins balkaniques, parlent une langue germanique fort proche du batave, empruntant, pour être précis, au parler des Marolles, quartier populaire de Bruxelles !"
                            },
                            {
                                "example_id": "9fed03e1-a264-4102-aae5-368ffaf718a1",
                                "sense_id": "2f5d80aa-9939-33f1-8d4d-466654bac1c1",
                                "text": "Ce vaste riad au caractère bien trempé, avec ses salons cossus et ses terrasses croquignolettes, invite joliment à se (re)poser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76afb1c4-c8b9-418d-923a-1b00d68f50ad",
                        "source_entry_id": "9d70f530-3ba8-33f6-a78f-719339cd7325",
                        "target_lang_word": "cute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "960c78a9-8cbc-318c-aa8e-f38c2f311ca1",
                                        "entry_id": "2d7de0f3-592a-34c7-b1d6-adb0f0b0240a",
                                        "glosses": [
                                            "Possessing physical features, behaviors, personality traits or other properties that are mainly attributed to infants and small or cuddly animals; e.g. fair, dainty, round, and soft physical features, disproportionately large eyes and head, playfulness, fragility, helplessness, curiosity or shyness, innocence, affectionate behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bafe856-125d-438c-bbec-00f977c9899f",
                                                "sense_id": "960c78a9-8cbc-318c-aa8e-f38c2f311ca1",
                                                "text": "Our reaction to cute attributes is understood as the way nature ensures mammals care for their young."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c37333c4-4dab-35d3-a66f-d91951ba8c55",
                                        "entry_id": "2d7de0f3-592a-34c7-b1d6-adb0f0b0240a",
                                        "glosses": [
                                            "Lovable, charming, attractive or pleasing, especially in a youthful, dainty, quaint or fun-spirited way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a6e5b1-a246-404e-ad7a-a07ac0d01c7b",
                                                "sense_id": "c37333c4-4dab-35d3-a66f-d91951ba8c55",
                                                "text": "Let's go to the mall and look for cute girls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d3f7822-acaf-373a-bd82-beda086ba983",
                                        "entry_id": "2d7de0f3-592a-34c7-b1d6-adb0f0b0240a",
                                        "glosses": [
                                            "Sexually attractive or pleasing; gorgeous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aad346e-aeca-447b-ad43-41b59991dc32",
                                                "sense_id": "5d3f7822-acaf-373a-bd82-beda086ba983",
                                                "text": "He's got such cute buns."
                                            },
                                            {
                                                "example_id": "97c90f2e-aab3-409c-a0de-cb3f6bf5efe5",
                                                "sense_id": "5d3f7822-acaf-373a-bd82-beda086ba983",
                                                "text": "I ordered her to strip for me and made her wiggle her cute little ass as she took off her panties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf5c6440-c3d3-3f42-8e39-ffc81001341d",
                                        "entry_id": "2d7de0f3-592a-34c7-b1d6-adb0f0b0240a",
                                        "glosses": [
                                            "Affected or contrived to charm; mincingly clever; precious; cutesy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d52d0d46-a3c5-4722-a2a8-f50c9a19153c",
                                                "sense_id": "cf5c6440-c3d3-3f42-8e39-ffc81001341d",
                                                "text": "Don't get cute with me, boy!"
                                            },
                                            {
                                                "example_id": "91af14bc-f92e-4a3a-bb67-be32345879e0",
                                                "sense_id": "cf5c6440-c3d3-3f42-8e39-ffc81001341d",
                                                "text": "The actor's performance was too cute for me. All that mugging to the audience killed the humor."
                                            },
                                            {
                                                "example_id": "0752f65a-4337-491e-a9d5-5c7d0327b623",
                                                "sense_id": "cf5c6440-c3d3-3f42-8e39-ffc81001341d",
                                                "text": "\"This time we aren't interested in anything cute or cryptic. We want the truth.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47bb8775-0d58-33bd-83aa-72d3a43569ac",
                                        "entry_id": "2d7de0f3-592a-34c7-b1d6-adb0f0b0240a",
                                        "glosses": [
                                            "Mentally keen or discerning (See also acute)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf493d9-110d-4614-abc6-2bf8e8cc3f57",
                                                "sense_id": "47bb8775-0d58-33bd-83aa-72d3a43569ac",
                                                "text": "Then Turpin being so very cute,\nHe hid his money in his boot."
                                            },
                                            {
                                                "example_id": "3e599e80-6bf6-444f-8e66-1d98ea89f808",
                                                "sense_id": "47bb8775-0d58-33bd-83aa-72d3a43569ac",
                                                "text": "'Filled with old doddering peers, cute financial magnates, clever wirepullers, big brewers with bulbous noses. All the enemies of progress are there — weaklings, sleek, slug, comfortable, self-important individuals."
                                            },
                                            {
                                                "example_id": "63b28e68-bf8d-4dfa-ab04-22adff583094",
                                                "sense_id": "47bb8775-0d58-33bd-83aa-72d3a43569ac",
                                                "text": "\"The police are cute enough, of course, to choose either a Roman Catholic or a materialist as the magistrate.\""
                                            },
                                            {
                                                "example_id": "29471988-106d-422d-8624-cc0a1b6d00d4",
                                                "sense_id": "47bb8775-0d58-33bd-83aa-72d3a43569ac",
                                                "text": "Cute trick, but can you do it consistently?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bec0a885-b76a-315a-8bb8-62041ef39f71",
                                        "entry_id": "2d7de0f3-592a-34c7-b1d6-adb0f0b0240a",
                                        "glosses": [
                                            "Evincing cleverness; surprising in its elegance or unconventionality (but of limited importance)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a0f3807-2bc1-41ae-a9e3-266fba7ca553",
                                                "sense_id": "bec0a885-b76a-315a-8bb8-62041ef39f71",
                                                "text": "There's a cute alternative proof of this using lambda calculus."
                                            },
                                            {
                                                "example_id": "6a61ca2f-3d31-483c-a6d1-4bc3f91479ad",
                                                "sense_id": "bec0a885-b76a-315a-8bb8-62041ef39f71",
                                                "text": "Cute solution to pin one Knight by unpinning the other and so force discovered guard for the Bishop: it took me hours to find that Bishop key."
                                            },
                                            {
                                                "example_id": "459ff9e8-c7f1-40f7-bf49-00647391bddd",
                                                "sense_id": "bec0a885-b76a-315a-8bb8-62041ef39f71",
                                                "text": "We state a cute result that can be derived from our calcuations^([sic]). It is not applied anywhere later, but shows that graphs with heavy tails and large clustering coefficients have large cores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb8a48e2-7046-4548-9bde-fb230c630e05",
                        "source_entry_id": "9d70f530-3ba8-33f6-a78f-719339cd7325",
