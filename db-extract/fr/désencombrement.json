                "senses": [
                    {
                        "sense_id": "01d65c37-3237-39ee-a99a-f6a705247ec9",
                        "entry_id": "475ad183-45ce-3c3d-bc01-b8c2256f1444",
                        "glosses": [
                            "Action de désencombrer ce qui est encombré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28d7e90-616f-4a1c-ae2a-881cab6b834e",
                                "sense_id": "01d65c37-3237-39ee-a99a-f6a705247ec9",
                                "text": "L’exécution de ce projet aurait pour résultat immédiat la suppression d’un assez grand nombre de vieilles maisons dans la partie la plus épaisse du quartier, la circulation de l’air, et le désencombrement de la rue Martainville , obstruée dans presque toute son étendue par les étaux des marchandes de poisson et de légumes."
                            },
                            {
                                "example_id": "93f4c2fe-c34f-44c4-90f1-6a095a7e4913",
                                "sense_id": "01d65c37-3237-39ee-a99a-f6a705247ec9",
                                "text": "Les techniques d'accélération du flux expiratoire permettent le désencombrement et sont applicables dès les premières heures postopératoires chez un patient bénéficiant d'une bonne analgésie."
                            },
                            {
                                "example_id": "6bdb9e4d-66a9-494a-a1d4-0cb02bb8f82b",
                                "sense_id": "01d65c37-3237-39ee-a99a-f6a705247ec9",
                                "text": "Nos compétences vont au-delà de la kiné de désencombrement, répond Yvan Tourjansky, président de l’union régionale des kinésithérapeutes libéraux d’Île-de-France."
                            }
                        ]
                    }
                ],
