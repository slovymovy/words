        "fr-extract.jsonl": [
            {
                "entry_id": "a38c6acf-3e61-3b06-a78d-53a2c1b7e77c",
                "word": "corselet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "86d8a8ca-26ef-4dab-b297-e36a8f0bff3d",
                        "entry_id": "a38c6acf-3e61-3b06-a78d-53a2c1b7e77c",
                        "tags": [
                            "plural"
                        ],
                        "form": "corselets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d6aecb6-677e-379a-a3a8-d0c2ee7d5a22",
                        "entry_id": "a38c6acf-3e61-3b06-a78d-53a2c1b7e77c",
                        "glosses": [
                            "Cuirasse que portaient certaines troupes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "317dc954-67f1-4059-8c1e-10731693d9fc",
                                "sense_id": "7d6aecb6-677e-379a-a3a8-d0c2ee7d5a22",
                                "text": "Aucun médecin chrétien, entre les quatre mers de la Bretagne, ne pourrait vous mettre à même de revêtir votre corselet d’ici à un mois."
                            },
                            {
                                "example_id": "d0ea4358-6914-465f-aa67-224287166693",
                                "sense_id": "7d6aecb6-677e-379a-a3a8-d0c2ee7d5a22",
                                "text": "Le lourd corselet en bronze de l’hoplite s'efface progressivement au Vᵉ siècle av. J.-C. devant celui en lin plus léger."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ca6b45a-3ce2-37d5-959b-4fcff35de083",
                        "entry_id": "a38c6acf-3e61-3b06-a78d-53a2c1b7e77c",
                        "glosses": [
                            "Sorte de corsage qui se ferme par le devant et qui est serré à la taille."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8800c67d-2497-4b46-ad2c-3d8291bdda35",
                                "sense_id": "1ca6b45a-3ce2-37d5-959b-4fcff35de083",
                                "text": "Les Indiennes offrent leurs puissants bras nus, des surfaces brunes et élastiques de chair entre leur jupe et le corselet étroit qui bande leurs omoplates et leurs seins."
                            },
                            {
                                "example_id": "c8157dc6-3d2e-482a-bbf0-7799c5bde34a",
                                "sense_id": "1ca6b45a-3ce2-37d5-959b-4fcff35de083",
                                "text": "La seconde sœur, Georgine, se présente sous l’aspect d’un majestueuse jeune femme au corselet étroitement lacé et à l’ample décolletage."
                            },
                            {
                                "example_id": "c4c39bf7-a3f3-4acb-999d-26d88d74e514",
                                "sense_id": "1ca6b45a-3ce2-37d5-959b-4fcff35de083",
                                "text": "J’étais fascinée par l’idée de ces longues robes à corselet qui remontent la poitrine."
                            }
                        ]
                    },
                    {
                        "sense_id": "24c3488e-54ee-32b4-b443-c39f2446cccc",
                        "entry_id": "a38c6acf-3e61-3b06-a78d-53a2c1b7e77c",
                        "glosses": [
                            "Partie du corps des insectes ou crustacés qui est située entre la tête et le ventre et qui supporte la première paire de pattes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5dc9d87-4140-40b5-80fe-2bca0d05e16b",
                                "sense_id": "24c3488e-54ee-32b4-b443-c39f2446cccc",
                                "text": "Le corselet d’un hanneton, d’une guêpe, d’un papillon."
                            },
                            {
                                "example_id": "b9bd81a7-4a6c-4cdc-bc4a-9ddbdcb05191",
                                "sense_id": "24c3488e-54ee-32b4-b443-c39f2446cccc",
                                "text": "Le corselet d’une écrevisse, d’une langouste, etc."
                            },
                            {
                                "example_id": "0c16c15c-26ff-4fa8-8255-21bbce620cc6",
                                "sense_id": "24c3488e-54ee-32b4-b443-c39f2446cccc",
                                "text": "les cigales font grincer leur corselet avec plus de vivacité que jamais."
                            },
                            {
                                "example_id": "11e07f51-b4c6-4756-9e00-2e3184841990",
                                "sense_id": "24c3488e-54ee-32b4-b443-c39f2446cccc",
                                "text": "Ses petits vêtements de coupe ancestrale, mais usés, si j’ose le dire, jusqu’à la corde et reluisants comme le corselet d’un grillon, étaient tirés à quatre épingles sur ses petits membres, et c’était une chose qui remuait profondément de voir ce joli vieillard, titulaire sans descendance d’un des Noms les plus glorieux de l’Occident, s’efforçant d’appareiller sa misère au décor triomphal des siècles."
                            },
                            {
                                "example_id": "9c76f770-3d55-4922-9f06-a2b0dd728fcf",
                                "sense_id": "24c3488e-54ee-32b4-b443-c39f2446cccc",
                                "text": "Une abeille voltige autour de sa bouche, puis s’éloigne, le corselet gonflé de dépit, car elle se trompait de ruche."
                            }
                        ]
                    }
                ],
