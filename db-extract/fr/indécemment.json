                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f28bf887-3c4d-3519-8cd4-8804a34f7d1d",
                        "entry_id": "df15e06d-c04e-3f39-bc57-85dc1f60210c",
                        "glosses": [
                            "D’une manière indécente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a209ab-002f-4add-ae5e-66e7456e28bc",
                                "sense_id": "f28bf887-3c4d-3519-8cd4-8804a34f7d1d",
                                "text": "Le prince de Conti, à la mort duquel il [Vendôme] fut si indécemment insensible."
                            },
                            {
                                "example_id": "b88dad52-335c-4d40-90fe-5eed178cf78a",
                                "sense_id": "f28bf887-3c4d-3519-8cd4-8804a34f7d1d",
                                "text": "Louvois fut accusé de s’être réjoui indécemment de la mort de Turenne."
                            },
                            {
                                "example_id": "2dfd36aa-3491-4e5a-b04c-3f94578f6d52",
                                "sense_id": "f28bf887-3c4d-3519-8cd4-8804a34f7d1d",
                                "text": "En présence d’un général en chef, un général de division ne doit pas se tenir indécemment, fût-ce un gaillard comme Kléber."
                            }
                        ]
                    }
                ],
