                        "examples": [
                            {
                                "example_id": "7ad2bc2e-41d8-403c-9fc3-ccf9af3cf9b8",
                                "sense_id": "5a4bb6a7-1086-31dc-bd20-266723bd91bc",
                                "text": "„Ein Bauer konnte eine mehrjährige Gefängnisstrafe bekommen, wenn er in seinem Garten einen Obstbaum fällte, wenn er ohne Genehmigung ein Schwein schlachtete, wenn er beim Abgabesoll einige Dutzend Eier zu spät lieferte, wenn er einen Sack Weizen von seiner Ernte verheimlichte, damit ihm noch Saatgut blieb.“"
                            }
                        ],
