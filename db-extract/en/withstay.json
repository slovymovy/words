                "senses": [
                    {
                        "sense_id": "04d95a9e-e0c4-304c-8664-ac2ccea450b7",
                        "entry_id": "770b332e-6b02-3135-aa2c-9f373e0d54c9",
                        "glosses": [
                            "To hold back; oppose; withstand."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "57d4ec76-819d-40e4-8033-4720bbc7631b",
                                "sense_id": "04d95a9e-e0c4-304c-8664-ac2ccea450b7",
                                "text": "Death, careful of my learning, hath withstayed His final presence."
                            },
                            {
                                "example_id": "8056e0c6-2697-42f2-9b86-a1898fb7ef75",
                                "sense_id": "04d95a9e-e0c4-304c-8664-ac2ccea450b7",
                                "text": "It filled the passage of the rising glade, And there withstayed the sun in dazzling sheen."
                            },
                            {
                                "example_id": "5fd20607-3297-4cf8-809a-2b5443e133ee",
                                "sense_id": "04d95a9e-e0c4-304c-8664-ac2ccea450b7",
                                "text": "More interestingly the shock has sufficiently high temperatures that nuclear binding cannot withstay and matter is ejected as free protons and neutrons from the neutron star surface."
                            }
                        ]
                    }
