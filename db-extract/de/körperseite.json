                "senses": [
                    {
                        "sense_id": "06b6fb8b-f012-3153-b253-0480c66c1777",
                        "entry_id": "3e1a48a7-7fbb-386a-8aa9-3e8c2c0a14ed",
                        "glosses": [
                            "Seite eines Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd5e10d6-988a-41ae-bd9d-a2a406fbaa80",
                                "sense_id": "06b6fb8b-f012-3153-b253-0480c66c1777",
                                "text": "„Aber die Kälte ist jetzt nicht unbedeutend, bald friert die Körperseite, die nach oben gekehrt ist, und ich stehe auf und gehe zu den Pferden hinauf.“"
                            },
                            {
                                "example_id": "4fa02d8c-1d9a-46ab-a13a-35a1a7a464f9",
                                "sense_id": "06b6fb8b-f012-3153-b253-0480c66c1777",
                                "text": "„Der Schmerz wächst, ich bekomme heftiges Fieber bis zum Schüttelfrost, eine Lähmung tritt hinzu, die die linke Körperseite erfaßt; ich kann meinen Arm nicht mehr bewegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
