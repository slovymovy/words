{
    "word_family": [
        "губной",
        "губка",
        "губёнка",
        "губища"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19e8fd5c-660c-36e9-a77c-74cfee6900b5",
                    "sense_definition": "часть лица, кожно-мускульная складка, закрывающая рот сверху или снизу",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой у меня часто сохнут <w>губы</w>.",
                            "target_lang_translations": {
                                "nl": "In de winter worden mijn <w>lippen</w> vaak droog."
                            }
                        },
                        {
                            "text": "Девочка накрасила <w>губы</w> маминой помадой.",
                            "target_lang_translations": {
                                "nl": "Het meisje stifte haar <w>lippen</w> met de lippenstift van haar moeder."
                            }
                        }
                    ],
                    "synonyms": [
                        "уста"
                    ],
                    "common_phrases": [
                        "кусать губы",
                        "накрасить губы"
                    ],
                    "target_lang_definitions": {
                        "nl": "Elk van de twee vlezige randen van de mondopening."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "lip",
                                "target_lang_sense_clarification": "deel van het gezicht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49961ab5-6bb6-3334-b8d2-aa0668a1afe8",
                    "sense_definition": "залив моря или озера, обычно являющийся устьем крупной реки",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рыбаки вышли на лодках в <w>губу</w>, где река впадает в Белое море.",
                            "target_lang_translations": {
                                "nl": "De vissers voeren met hun boten de <w>baai</w> in, waar de rivier uitmondt in de Witte Zee."
                            }
                        },
                        {
                            "text": "Там вода в <w>губе</w> тепла и неглубока.",
                            "target_lang_translations": {
                                "nl": "Het water in de <w>baai</w> is daar warm en ondiep."
                            }
                        }
                    ],
                    "synonyms": [
                        "залив",
                        "бухта"
                    ],
                    "common_phrases": [
                        "Обская губа"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "используется преимущественно на севере и востоке России"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Brede zeeboezem of diep landinwaarts reikende baai, vaak de monding van een grote rivier in Noord- en Oost-Rusland."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "baai",
                                "target_lang_sense_clarification": "inham, zeearm"
                            },
                            {
                                "target_lang_word": "zeeboezem",
                                "target_lang_sense_clarification": "brede inham van de zee"
                            },
                            {
                                "target_lang_word": "golf",
                                "target_lang_sense_clarification": "grote baai"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd35770-a5d8-34ee-b828-93d04dae4e97",
                    "sense_definition": "помещение для содержания под арестом военнослужащих",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На <w>губе</w> он просидел десять суток за самовольную отлучку из части.",
                            "target_lang_translations": {
                                "nl": "Hij zat tien dagen in het <w>cachot</w> wegens ongeoorloofde afwezigheid van zijn eenheid."
                            }
                        },
                        {
                            "text": "Солдата отправили на <w>губу</w> за нарушение дисциплины.",
                            "target_lang_translations": {
                                "nl": "De soldaat werd naar het <w>cachot</w> gestuurd wegens een schending van de discipline."
                            }
                        }
                    ],
                    "synonyms": [
                        "гауптвахта"
                    ],
                    "common_phrases": [
                        "сидеть на губе"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "военный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Militaire arrestantencel of straflokaal waar militairen worden opgesloten; militaire gevangenis."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "amman",
                                "target_lang_sense_clarification": "militair arrestlokaal, cachot"
                            },
                            {
                                "target_lang_word": "cachot",
                                "target_lang_sense_clarification": "arrestantencel"
                            },
                            {
                                "target_lang_word": "strafbak",
                                "target_lang_sense_clarification": "informeel voor militaire gevangenis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9daa3282-0bcf-3730-88ef-aed82f638ed5",
                    "sense_definition": "гриб, растущий на стволах деревьев",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На старой берёзе выросла большая <w>губа</w>.",
                            "target_lang_translations": {
                                "nl": "Op de oude berk groeide een grote <w>boomzwam</w>."
                            }
                        },
                        {
                            "text": "Этот древесный гриб, или <w>губа</w>, часто встречается в лесу.",
                            "target_lang_translations": {
                                "nl": "Deze houtzwam, ofwel <w>tonderzwam</w>, komt vaak voor in het bos."
                            }
                        }
                    ],
                    "synonyms": [
                        "трутовик"
                    ],
                    "target_lang_definitions": {
                        "nl": "Houtzwam of paddenstoel die op boomstammen groeit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tonderzwam",
                                "target_lang_sense_clarification": "specifieke houtzwam"
                            },
                            {
                                "target_lang_word": "boomzwam",
                                "target_lang_sense_clarification": "zwam op boomstammen"
                            },
                            {
                                "target_lang_word": "houtzwam",
                                "target_lang_sense_clarification": "paddenstoel op hout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4695520d-e25b-3e44-9774-f4597c43780e",
                    "sense_definition": "концевая рабочая часть некоторых инструментов",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочая <w>губа</w> щипцов должна плотно прилегать к детали.",
                            "target_lang_translations": {
                                "nl": "De werkende <w>bek</w> van de tang moet stevig aansluiten op het onderdeel."
                            }
                        },
                        {
                            "text": "Инструмент сломался, когда его <w>губы</w> соскользнули с гайки.",
                            "target_lang_translations": {
                                "nl": "Het gereedschap brak toen de <w>bekken</w> van de moer gleden."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Uiteinde of grijpdeel van bepaalde gereedschappen zoals een bankschroef of tang."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bek",
                                "target_lang_sense_clarification": "grijpdeel van tang of bankschroef"
                            },
                            {
                                "target_lang_word": "klauw",
                                "target_lang_sense_clarification": "klemdeel van gereedschap"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "075677b4-73af-3e6b-bab4-fc0c1a4adae5",
                    "sense_definition": "украинская фамилия",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Известный ученый по фамилии <w>Губа</w> выступил с докладом.",
                            "target_lang_translations": {
                                "nl": "Een bekende wetenschapper met de achternaam <w>Guba</w> hield een lezing."
                            }
                        },
                        {
                            "text": "Семья <w>Губы</w> переехала в новый дом на окраине города.",
                            "target_lang_translations": {
                                "nl": "De familie <w>Guba</w> verhuisde naar een nieuw huis aan de rand van de stad."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "фамилия"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Oekraïense achternaam."
                    },
                    "translations": {
