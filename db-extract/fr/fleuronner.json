                "senses": [
                    {
                        "sense_id": "a626a120-62f0-36d7-9aac-69eebfb8e799",
                        "entry_id": "ab60ce49-819b-3778-96be-f655a24a43f4",
                        "glosses": [
                            "Fleurir."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c2b850d4-095e-315a-8546-23066ba8f64a",
                        "entry_id": "ab60ce49-819b-3778-96be-f655a24a43f4",
                        "glosses": [
                            "Orner de fleurons le cercle d’une couronne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac579964-2eef-4e4f-8ba0-cb22a968c241",
                                "sense_id": "c2b850d4-095e-315a-8546-23066ba8f64a",
                                "text": "Une gigantesque salle apparut pavée de porphyre, supportée par de vastes piliers aux chapiteaux fleuronnés de coloquintes de bronze et de lis d’or."
                            },
                            {
                                "example_id": "0ac2b34d-e1af-4c80-83cf-200c96c45202",
                                "sense_id": "c2b850d4-095e-315a-8546-23066ba8f64a",
                                "text": "REIMS – […] Tout à fait supérieur ; bien au-dessus des cathédrales de Paris, Tours, Strasbourg, pour la richesse et l’élégance. Cela fleuronne et foisonne comme un arbre épanoui de fleurs mystiques chez Dante."
                            },
                            {
                                "example_id": "76d263a6-5ef4-4ce9-9698-f26605235ef1",
                                "sense_id": "c2b850d4-095e-315a-8546-23066ba8f64a",
                                "text": "La longue digue fleuronnée y perd de son prestige."
                            }
                        ]
                    }
                ],
