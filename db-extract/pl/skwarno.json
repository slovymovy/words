                                            {
                                                "example_id": "f06d4261-e93a-434a-9863-7d89cfa89c7a",
                                                "sense_id": "7e0473f6-bc4d-36d4-bf31-e87b66016a93",
                                                "text": "Bei dem Hurrikan „Katrina“ handelt es sich um einen extrem starken, tropischen Wirbelsturm."
                                            },
                                            {
                                                "example_id": "f07b858c-2c3a-4116-a8e7-5f386d3dfe3a",
                                                "sense_id": "7e0473f6-bc4d-36d4-bf31-e87b66016a93",
                                                "text": "Es erwartet uns tropische Hitze."
                                            },
                                            {
                                                "example_id": "cead75bd-a22e-4023-a1ae-dd5086feb7f6",
                                                "sense_id": "7e0473f6-bc4d-36d4-bf31-e87b66016a93",
                                                "text": "„Im Oligozän wichen die tropischen Wälder in die niederen Breiten zurück und machten grasbewachsenen Ebenen mit einzelnen Bäumen und Sträuchern Platz (Savanne).“"
                                            },
                                            {
                                                "example_id": "4c953565-e20d-4aeb-813a-13b0511b9810",
                                                "sense_id": "7e0473f6-bc4d-36d4-bf31-e87b66016a93",
                                                "text": "„Der Schwund tropischer Regenwälder hielt 2021 nach Satellitenbild-Auswertungen unverändert an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85e73c3a-caca-3463-9df2-0d615baffe37",
                                        "entry_id": "193386a8-17b8-30bf-a9ed-104a52dc7376",
                                        "glosses": [
                                            "Astronomie: auf den Frühlingspunkt bezogen"
                                        ],
