                "senses": [
                    {
                        "sense_id": "805e5b6c-1af0-3ae3-85ec-2aaa8f4c34b6",
                        "entry_id": "eaaf176b-65c0-3617-9627-dc2b0bfb1c8b",
                        "glosses": [
                            "Schuss, bei dem das Projektil den Kopf trifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91b672cd-3b58-482d-8337-c7088f038790",
                                "sense_id": "805e5b6c-1af0-3ae3-85ec-2aaa8f4c34b6",
                                "text": "Beim Angriff der Terroristen erlitt der Soldat einen Kopfschuss."
                            },
                            {
                                "example_id": "77e2c18d-e0d7-40fc-adfd-b48d924bc605",
                                "sense_id": "805e5b6c-1af0-3ae3-85ec-2aaa8f4c34b6",
                                "text": "„Die Infanteristen Barbanek und Vavra erhielten Kopfschüsse und waren sofort tot, dem Gefreiten Perin wurde das Schulterblatt zerschmettert, zwei Leute trugen ihn weg.“"
                            },
                            {
                                "example_id": "a10f8a04-319e-4cb3-9eed-8b1501583a61",
                                "sense_id": "805e5b6c-1af0-3ae3-85ec-2aaa8f4c34b6",
                                "text": "„Eine spektakuläre Hirschjagd durch das Zentrum der Südtiroler Landeshauptstadt Bozen hat am Montag für das Tier mit einem Kopfschuss geendet.“"
                            },
                            {
                                "example_id": "520f53cb-e69c-4128-91d8-206e78f8a547",
                                "sense_id": "805e5b6c-1af0-3ae3-85ec-2aaa8f4c34b6",
                                "text": "„SS und Sicherheitsdienst töten ihn durch Kopfschuss in seinem Dienstzimmer, als Todesursache wird Suizid angegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f00d4d1b-e701-4cf7-a254-7d60b73f9e78",
                        "source_entry_id": "eaaf176b-65c0-3617-9627-dc2b0bfb1c8b",
                        "source_sense_id": "805e5b6c-1af0-3ae3-85ec-2aaa8f4c34b6",
                        "source_sense_description": "Schuss, bei dem das Projektil den Kopf trifft",
                        "target_lang_word": "headshot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headshot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7e5f80-5a2a-3c00-b62f-d1d2f2104cc7",
                                        "entry_id": "70ae4219-d9a8-3122-9e29-9c02949a2b34",
                                        "glosses": [
                                            "A portrait for branding or social media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c169598-70ff-48f2-ab2d-3c57f058f1f9",
                                                "sense_id": "7e7e5f80-5a2a-3c00-b62f-d1d2f2104cc7",
                                                "text": "I went home, I changed, I went to Walgreens and printed out a headshot of me and signed it ‘from your favorite local news reporter,’ and I sat in the parking lot for four hours until she said, ‘Hey, your passes to go backstage are at will-call’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d0d8cd-ebde-3126-be16-6a95ec8a1dab",
                                        "entry_id": "70ae4219-d9a8-3122-9e29-9c02949a2b34",
                                        "glosses": [
                                            "A gunshot to the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2dce8be-fcdd-4d59-9b01-856c643ecb95",
                                                "sense_id": "a1d0d8cd-ebde-3126-be16-6a95ec8a1dab",
                                                "text": "Smelling victory amongst the gunpowder Graeme started shooting off his mouth. “True Counter-Strikers like me don’t even count kills unless they’re headshots or a knife in the back of the nut…”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46cf1af0-4c52-3339-8b1d-7860a6751bbc",
                                        "entry_id": "70ae4219-d9a8-3122-9e29-9c02949a2b34",
                                        "glosses": [
                                            "A one-page, double-sided resume of an actor, consisting of the actor's photograph (usually of the head and shoulders) on one side and their curriculum vitae on the other."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "headshot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c02ce836-450a-3772-bab3-e968a07493ea",
                                        "entry_id": "aa4d3420-758f-3da3-8708-4f219e6bd568",
                                        "glosses": [
                                            "To kill (someone) by shooting them in the head."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ec68701-ed27-4715-82c3-f60827a2decc",
                                                "sense_id": "c02ce836-450a-3772-bab3-e968a07493ea",
                                                "text": "SCOUTMASTER / HEADSHOTTED A SCOUT WITH THE BREECHSHOT."
                                            },
                                            {
                                                "example_id": "d8b3b79e-6756-4e0b-a5f2-5dc4903cc8fc",
                                                "sense_id": "c02ce836-450a-3772-bab3-e968a07493ea",
                                                "text": "Everybody knows someone who feels left out when video games are being played. Maybe your girlfriend is bad at headshotting newbs in “Halo 4” or racing against you in “Gran Turismo,” but she could definitely play this."
                                            },
                                            {
                                                "example_id": "7e1c7cd9-df25-4019-9718-7364a04d7bcc",
                                                "sense_id": "c02ce836-450a-3772-bab3-e968a07493ea",
                                                "text": "Workplace bouts of Novalogic’s tactical firstperson shooter Delta Force 2 further seeded the sense that cover was neglected. “We all were playing that after work when we were having the debate about cover and first- or thirdperson,” [Chris] Esaki says. “I remember very vividly getting headshotted when I thought I was behind a piece of cover, but it was clear in the replay afterwards that my head was above the piece of stone. I couldn’t tell, and that was the reason why we went thirdperson with Kill Switch.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
