                        "glosses": [
                            "Excessively fed; given too much to eat; having had too much to eat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3dae42-0d33-4137-bcee-e2cb05897c3a",
                                "sense_id": "8ffd8c7e-403b-397e-a30a-6e80b2b3df9d",
                                "text": "He allowed his ‘boy’—an overfed young negro from the coast—to treat the white men, under his very eyes, with provoking insolence."
                            },
                            {
                                "example_id": "c4e8b418-7e0b-44b1-9042-3773b3673de5",
                                "sense_id": "8ffd8c7e-403b-397e-a30a-6e80b2b3df9d",
                                "text": "Was this stupid system, so cruel, so crushing, and producing at the top such absurd results as flashy, insolent autos and silly palaces and overfed, overdressed women, and dogs in jeweled collars, and babies of wealth brought up by low menials—was this system really the best?"
                            }
                        ]
                    }
