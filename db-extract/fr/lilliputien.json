                                        "examples": [
                                            {
                                                "example_id": "7aca0f62-5253-4b8c-b415-61291325f557",
                                                "sense_id": "e216f136-e840-33ce-8267-cb412ddee0a3",
                                                "text": "„In der Schlüterstraße öffnete ein grünlivrierter Liliputaner, erklomm eine zierliche Leiter, half dem Besucher aus dem Mantel und verschwand.“"
                                            },
                                            {
                                                "example_id": "6f36ff3a-f7af-4db0-a6fd-6478d942b9d4",
                                                "sense_id": "e216f136-e840-33ce-8267-cb412ddee0a3",
                                                "text": "„Er schloss die Augen und stellte sich vor, wie ihm die Liliputaner ihre Speere in den Leib stießen und die Fesseln um seinen Bauch immer enger zogen, bis sie ihm ins Fleisch schnitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
