                    {
                        "translation_id": "fb2d9738-dede-4985-a678-960c62eb5ab9",
                        "source_entry_id": "340386fc-93dd-334d-b3fb-00a7c9a95209",
                        "source_sense_id": "6885e9c5-529c-3cf8-9cdc-79f68aec0294",
                        "target_lang_word": "Spannung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spannung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0774ff4-787e-395e-8c1c-bbc6ef5c7c97",
                                        "entry_id": "6dc8aca9-871b-3433-ab3c-6e196f8ca358",
                                        "glosses": [
                                            "(»elektrische Spannung«) die (nutzbare) Potenzialdifferenz zwischen zwei Orten im elektrischen Feld"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9be6ff-35f8-42bd-a665-0ed8d005ce26",
                                                "sense_id": "d0774ff4-787e-395e-8c1c-bbc6ef5c7c97",
                                                "text": "Elektrische Spannung resultiert aus Arbeit, die geleistet ist, indem eine elektrische Ladung entlang eines elektrischen Feldes transportiert wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddb2d574-3cc0-3a56-86ee-b16e1f9984d0",
                                        "entry_id": "6dc8aca9-871b-3433-ab3c-6e196f8ca358",
                                        "glosses": [
                                            "(»mechanische Spannung«) die nutzbare Potentialdifferenz zwischen zwei Formzuständen im Kraftfeld"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b346e07d-d262-4c0a-8559-a094ecbfa9a4",
                                                "sense_id": "ddb2d574-3cc0-3a56-86ee-b16e1f9984d0",
                                                "text": "Mechanische Spannung resultiert nach Formänderung aus Kraft pro Fläche, die auf einen elastischen Körper wirkte."
                                            },
                                            {
                                                "example_id": "e1d6c06e-845c-4060-8673-914740011025",
                                                "sense_id": "ddb2d574-3cc0-3a56-86ee-b16e1f9984d0",
                                                "text": "Er half eigenhändig beim Spannen der Ballisten. Da die Spannung rechts wie links völlig gleich sein musste, schlug man, während des Anziehens der Spansehnen, abwechselnd auf den rechten und den linken Spannbolzen, bis beide einen gleichen Klang gaben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f339733-867c-3d41-ae07-5460082cb547",
                                        "entry_id": "6dc8aca9-871b-3433-ab3c-6e196f8ca358",
                                        "glosses": [
                                            "das Gefühl in Form eines Konflikts nach einer emotional aufladenden Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58cce97-d4fb-4780-b9e9-72099b33091b",
                                                "sense_id": "7f339733-867c-3d41-ae07-5460082cb547",
                                                "text": "„Bald nach 16 Uhr endete die Spannung.“"
                                            },
                                            {
                                                "example_id": "8dd8bc64-c4c8-4af7-8630-f111f887fc52",
                                                "sense_id": "7f339733-867c-3d41-ae07-5460082cb547",
                                                "text": "„Nach der lähmenden Spannung und dem wochenlangen Zögern war jetzt überall Aufregung und hektisches Gewusel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1cc6d951-b958-3ba3-9834-42f1e32c1afc",
                                        "entry_id": "6dc8aca9-871b-3433-ab3c-6e196f8ca358",
                                        "glosses": [
                                            "Anspannung/Verspannung als Zwischenresultat einer zu bewältigenden Problemlage"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6826109-710e-43a8-a500-a238195d010c",
                                                "sense_id": "1cc6d951-b958-3ba3-9834-42f1e32c1afc",
                                                "text": "Die Spannung der männlichen Muskulatur reicht locker aus, um eine Ehefrau über die Türschwelle zu tragen."
                                            },
                                            {
                                                "example_id": "8396bb14-507d-427e-964b-e0cf8a788739",
                                                "sense_id": "1cc6d951-b958-3ba3-9834-42f1e32c1afc",
                                                "text": "„Auch körperliche Spannung trug zu seiner Nervosität bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0604cb8d-5722-3881-8d4a-03ef21f85731",
                                        "entry_id": "6dc8aca9-871b-3433-ab3c-6e196f8ca358",
                                        "glosses": [
                                            "Ergebnis einer Spielhandlung, welches im Publikum Interesse auslöst"
                                        ],
                                        "tags": [
                                            "Unterhaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca95438e-c5af-4d94-847a-bddacb1d7edb",
                                                "sense_id": "0604cb8d-5722-3881-8d4a-03ef21f85731",
                                                "text": "Unter Spannung folgte das Publikum diesen pikanten Details aus dem Vorleben der Angeklagten."
                                            },
                                            {
                                                "example_id": "748577d7-8d58-4701-ab67-a6be840f0529",
                                                "sense_id": "0604cb8d-5722-3881-8d4a-03ef21f85731",
                                                "text": "Ew. Wohlgeboren, die ordentliche Schreibart ist aus der Mode. Ein jeder Autor, der etwas vor sich bringen will, muß sich auf die unordentliche verlegen, dann entsteht die Spannung, die den Leser nicht zu Atem kommen lässt, und ihn par force bis zur letzten Seite jagt."
                                            },
                                            {
                                                "example_id": "19e25b7c-f6df-45de-a0d1-06c27d453c5a",
                                                "sense_id": "0604cb8d-5722-3881-8d4a-03ef21f85731",
                                                "text": "„Der mit Spannung erwartete Abriss des Anlaufturms der Inselbergschanze in Brotterode im Thüringer Wald ist gescheitert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
