                },
                {
                    "sense_id": "87be275a-34c9-3097-99c0-87f1574e9c1f",
                    "sense_definition": "Общая сумма, полученная при сложении чисел или подсчёте расходов.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бухгалтер проверил общий <итог> в конце отчёта.",
                            "target_lang_translations": {
                                "en": "The accountant checked the grand <w>total</w> at the end of the report.",
                                "es": "El contable verificó el <w>total</w> general al final del informe.",
                                "fr": "Le comptable a vérifié le <w>total</w> général à la fin du rapport."
                            }
                        },
                        {
                            "text": "Если сложить все расходы, <итог> получится слишком большим.",
                            "target_lang_translations": {
                                "en": "If you add up all the expenses, the <w>total</w> will be too large.",
                                "es": "Si se suman todos los gastos, el <w>total</w> resultará demasiado alto.",
                                "fr": "Si l'on additionne toutes les dépenses, le <w>total</w> sera trop élevé."
                            }
                        }
                    ],
                    "synonyms": [
                        "сумма"
                    ],
                    "common_phrases": [
                        "общий итог",
                        "подводить итог"
                    ],
                    "target_lang_definitions": {
                        "en": "The total amount obtained by adding numbers or calculating expenses.",
                        "es": "Cantidad total obtenida al sumar números o calcular gastos.",
                        "fr": "Montant total obtenu en additionnant des nombres ou en calculant des dépenses."
                    },
