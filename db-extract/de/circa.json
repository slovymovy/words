                                        "examples": [
                                            {
                                                "example_id": "5341b476-6ca4-40bf-b0da-076c367f0ea0",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "approximately 60 beats per minute"
                                            },
                                            {
                                                "example_id": "fa575429-4024-4e94-ab8c-5afef641dc7b",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "In every box of matches there are approximately 40 matchsticks."
                                            },
                                            {
                                                "example_id": "6fe7bf28-6dca-48f2-8d21-ef1fa2274a35",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "Per 100 g of chocolate there is approximately 11.6 g of saturated fat."
                                            },
                                            {
                                                "example_id": "54a62ec8-c059-4ff7-836e-2963bdb39751",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "Returning to our own epistemic situation, we do not know the sense in which quantum mechanics and relativity will be taken to be approximately true after their descriptive infelicities are addressed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdd9ad86-5601-43fa-8f68-08a5fa110b4e",
                        "source_entry_id": "4e2c15a6-36c3-3830-88e7-b2455abe93e7",
                        "source_sense_id": "bff292f7-d100-3e7f-9045-bb0c62597445",
