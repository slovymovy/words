                "senses": [
                    {
                        "sense_id": "eb615e0d-7c24-31fc-95fb-09974daa80c6",
                        "entry_id": "50426b7f-d808-31e4-9b92-93b4ae6cb56c",
                        "glosses": [
                            "Abdeckung oder Verschluss aus Metall"
