                                        "entry_id": "a6544330-4c7e-385d-9195-0d52f003d050",
                                        "glosses": [
                                            "sich sträubend, unbeugsam, sich nicht fügen wollend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1488ea-20bf-4c62-8ba5-b78ee4e6b44e",
                                                "sense_id": "27fe8d3e-5844-3ba3-8258-68e307308711",
                                                "text": "Frau Müller hat eine widerspenstige Tochter, die mitten in der Pubertät steckt."
                                            },
                                            {
                                                "example_id": "d2a27e75-d92a-4540-88e2-aec8644be236",
                                                "sense_id": "27fe8d3e-5844-3ba3-8258-68e307308711",
                                                "text": "„Dabei konnte man Mirko keineswegs unwillig oder widerspenstig nennen. Er tat gehorsam, was man ihm gebot,“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c15ee007-0822-45a4-a836-2cd9a3d0a1b6",
                        "source_entry_id": "f125e0a7-4587-3cf0-8432-51fb73d7dabb",
                        "source_sense_id": "4da08fcd-9201-3dda-a9dc-719d53583607",
                        "source_sense_description": "of, related to, or involved in sedition",
                        "target_lang_word": "auf Krawall gebürstet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf5b6ec9-7c5f-475b-aa27-90f0db7c8d85",
                        "source_entry_id": "f125e0a7-4587-3cf0-8432-51fb73d7dabb",
                        "source_sense_id": "4da08fcd-9201-3dda-a9dc-719d53583607",
                        "source_sense_description": "of, related to, or involved in sedition",
                        "target_lang_word": "мятежный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мятежный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8c664726-7f88-3213-a3c1-dfbf858c15d1",
                                        "entry_id": "f7b553f4-8a23-3f85-9ed2-148124fb3d29",
                                        "glosses": [
                                            "книжн., причастный к мятежу || охваченный мятежом || бунтарски настроенный, склонный к мятежу || призывающий к мятежу"
                                        ],
                                        "tags": [
                                            "только полн. ф."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb66c0b-7274-4195-8044-8172e3ef13a5",
                                                "sense_id": "8c664726-7f88-3213-a3c1-dfbf858c15d1",
                                                "text": "Ярослав является в первый раз в истории мятежным сыном против отца."
                                            },
                                            {
                                                "example_id": "8385eecd-f3d0-4780-89b3-01d41ba692a9",
                                                "sense_id": "8c664726-7f88-3213-a3c1-dfbf858c15d1",
                                                "text": "К сожалению, нет актов этого собора, но из последующих событий видно, что на этом соборе постановлено было употребить ещё раз кроткие меры против мятежного Пскова."
                                            },
                                            {
                                                "example_id": "cb59774a-6630-4ff0-818a-01008c7b4358",
                                                "sense_id": "8c664726-7f88-3213-a3c1-dfbf858c15d1",
                                                "text": "Мятежные люди, собравшись вокруг Гамалиота, разжигали в народе огонь негодования и мести за невинно погубленных."
                                            },
                                            {
                                                "example_id": "c4d855de-83c9-4921-9004-0bfed9d484d2",
                                                "sense_id": "8c664726-7f88-3213-a3c1-dfbf858c15d1",
                                                "text": "О том помысли, что было бы, ежели б, коим ни на есть случаем, сведал владыка о таковых мятежных речах твоих?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84feb5a4-11ee-3908-885d-ab6ca0153d31",
                                        "entry_id": "f7b553f4-8a23-3f85-9ed2-148124fb3d29",
                                        "glosses": [
                                            "тревожный, неспокойный, бурный, мятущийся"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68acf2b4-1266-4743-a0a0-89b5d492b449",
                                                "sense_id": "84feb5a4-11ee-3908-885d-ab6ca0153d31",
                                                "text": "Песня на берегу моря уже умолкла, и старухе вторил теперь только шум морских волн, — задумчивый, мятежный шум был славной второй рассказу о мятежной жизни."
                                            },
                                            {
                                                "example_id": "0fb46170-78e0-46ea-b687-ee9f02b9297e",
                                                "sense_id": "84feb5a4-11ee-3908-885d-ab6ca0153d31",
                                                "text": "Зулейка любила Юзуфа мятежною страстью, такою же, какой ты дала над собою волю однажды."
                                            },
                                            {
                                                "example_id": "27eb370d-ff38-44d2-b116-4285f97ea28e",
                                                "sense_id": "84feb5a4-11ee-3908-885d-ab6ca0153d31",
                                                "text": "Прислушиваясь к твоим мыслям прежде слов, любуясь душою твоей прежде лица, я воображал иногда, что мои мятежные чувства уникают под твоими ясными взорами, как злые духи под кропилом, что я дышу твоим спокойствием, вкушаю какую-то неведомую тихую негу."
                                            },
                                            {
                                                "example_id": "09db052a-8c78-4ca6-94bc-a69b8881dfcc",
                                                "sense_id": "84feb5a4-11ee-3908-885d-ab6ca0153d31",
                                                "text": "А он, мятежный, просит бури, // Как будто в бурях есть покой!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45778269-34fd-3b9d-a92f-f565e06c3594",
                                        "entry_id": "f7b553f4-8a23-3f85-9ed2-148124fb3d29",
                                        "glosses": [
                                            "возбуждающий тревогу, волнение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63e8a3b-7dfe-4ffe-9d42-f2e6da23ab94",
                                                "sense_id": "45778269-34fd-3b9d-a92f-f565e06c3594",
                                                "text": "В душе, в груди моей был плач и стон мятежный…"
                                            },
                                            {
                                                "example_id": "a2f0c5b2-e0d7-453c-b88b-981fbcff4e7b",
                                                "sense_id": "45778269-34fd-3b9d-a92f-f565e06c3594",
                                                "text": "От ранних лет кипит в моей крови // Твой жар и бурь твоих порыв мятежный"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
