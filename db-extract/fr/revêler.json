                "senses": [
                    {
                        "sense_id": "ec73d0d4-989a-3978-8ea1-199c23a63d4a",
                        "entry_id": "d6265bed-ca36-3adc-9e32-ea261ae52f79",
                        "glosses": [
                            "Vêler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf32017-be1d-44c3-bed3-f966c5a33626",
                                "sense_id": "ec73d0d4-989a-3978-8ea1-199c23a63d4a",
                                "text": "La vache tarie vient de terminer une lactation, toujours épuisante pour l’organisme, et s’apprête à revêler pour redémarrer la production de lait."
                            },
                            {
                                "example_id": "8c38a822-f4da-4446-8a68-692c37183540",
                                "sense_id": "ec73d0d4-989a-3978-8ea1-199c23a63d4a",
                                "text": "Avec des vaches vides dont la lactation est prolongée avec une production de 20 litres de lait ou des vaches que l’éleveur fait revêler, au lieu de les vendre, avec une production de 30 litres de lait en début de lactation, le prix d’achat de l’ensilage de maïs par exemple, ne doit pas dépasser 200 € par tonne de matière sèche soit 60 € la tonne brute à 30 % MS rendue à l’auge."
                            }
                        ]
                    }
                ],
