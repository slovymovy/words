                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitsanzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1fff5ab-d50e-3c81-9c22-29fe6bd6338a",
                                        "entry_id": "859ed47e-a2d7-3d37-9744-0034a394ad22",
                                        "glosses": [
                                            "Kleidung, die bei der Arbeit getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305b522b-27c1-42b3-ac70-34183315efef",
                                                "sense_id": "c1fff5ab-d50e-3c81-9c22-29fe6bd6338a",
                                                "text": "„Dass ich einen Arbeitsanzug bekommen habe und nicht meine Strümpfe abgeben musste, war wirklich ein seltenes Glück.“"
                                            },
                                            {
                                                "example_id": "845063a4-1d1c-4f09-b41d-73212ba4566e",
                                                "sense_id": "c1fff5ab-d50e-3c81-9c22-29fe6bd6338a",
                                                "text": "„Vor mir stand ein drahtiger, mittelgroßer Mann in einem ölverschmierten Arbeitsanzug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37c224ab-1830-4b43-bc14-e46531f55937",
                        "source_entry_id": "6b0be566-3554-3b54-9bd0-4ed74fcec47b",
