                                        "sense_id": "7d8f4520-1d1d-3f09-bbb0-2b249b660b99",
                                        "entry_id": "01370cb2-3bc4-3c54-bad9-a6e31b7fa358",
                                        "glosses": [
                                            "The practice of promoting a political agenda by hacking, especially by defacing or disabling websites."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add10b8b-b6ef-4a1e-8e36-487cd4590c2e",
                                                "sense_id": "7d8f4520-1d1d-3f09-bbb0-2b249b660b99",
                                                "text": "Hacktivism is a form of activism for social change that appropriates computers and electronic networks for this purpose. Also called electronic civil disobedience, hacktivism is geared to political ends."
                                            },
                                            {
                                                "example_id": "2441edd0-6220-4ebb-b23f-55460c6007dc",
                                                "sense_id": "7d8f4520-1d1d-3f09-bbb0-2b249b660b99",
                                                "text": "My aim will be to identify and highlight the potential problems of the existing approach that is followed when dealing with hacktivism and its impact on user rights, protesters, and overall cybersecurity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
