                        "examples": [
                            {
                                "example_id": "aa6e80b0-8211-4777-8a17-0f49177ba1bc",
                                "sense_id": "607c2d09-a4f8-3be8-a455-e4dc918009fd",
                                "text": "Waarom zouden we onze kinderen niet inprenten wat de Schrift en de gereformeerde traditie ons voorhouden? God is met ons een verbond aangegaan, waarin Hij toezegt dat Hij onze Vader is, waarin Christus ons belooft dat Hij ons wast in Zijn bloed, door ons in te lijven in Zijn dood en opstanding, en waarin de Heilige Geest verzegelt dat Hij altijd bij ons wonen wil en ons toe-eigent wat wij in Christus hebben: de afwassing van de zonden en de dagelijkse vernieuwing van ons leven (doopformulier)."
                            },
                            {
                                "example_id": "2532bec1-5195-4150-8313-1c1ae23c223c",
                                "sense_id": "607c2d09-a4f8-3be8-a455-e4dc918009fd",
                                "text": "De doop is voor Augustinus de afwassing van de erfzonde."
                            }
                        ]
                    }
