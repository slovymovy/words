                "senses": [
                    {
                        "sense_id": "1b3fcf1f-3f5f-308e-a7ba-88923097f2bb",
                        "entry_id": "5edba032-f2c8-3104-9926-a26fc159b212",
                        "glosses": [
                            "porzucenie jakiejś wiary religijnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08edb074-06e4-4bb4-97f3-f7ebc391c1b9",
                                "sense_id": "1b3fcf1f-3f5f-308e-a7ba-88923097f2bb",
                                "text": "Współcześnie apostazja rozumiana jest jako świadome, dobrowolne i publiczne odejście od wiary."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d6ac1171-9746-3459-8385-03ef338d555c",
                        "entry_id": "5edba032-f2c8-3104-9926-a26fc159b212",
                        "glosses": [
                            "porzucenie swoich idei, przekonań"
                        ],
