                ],
                "senses": [
                    {
                        "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                        "entry_id": "64354842-8939-3147-8481-27e350e46039",
                        "glosses": [
                            "Vorgang, in dem etwas zu Eis wird oder mit Eis bedeckt wird"
                        ],
                        "tags": [
                            "Nomen Actionis"
                        ],
                        "examples": [
                            {
                                "example_id": "5738d9d5-ce45-4e8b-b35b-41775fb660fd",
                                "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                                "text": "Die Vereisung des Sees erfolgte schneller als erwartet."
                            },
                            {
                                "example_id": "999fc7a0-ddbb-4af3-876f-63bc7a34040a",
                                "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                                "text": "„Aufgrund der Verlagerung der Kontinente in Richtung der Pole vollzogen sich vor etwa 40 bis zehn Millionen Jahren die Vereisung der Antarktis und nachfolgend die Gletscherbildung auf Grönland vor ca. fünf Millionen Jahren.“"
                            },
                            {
                                "example_id": "9a36d2f4-4459-4627-9a8b-73522cd86eab",
                                "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                                "text": "„Indessen nimmt die Glut im Innern ab, und die Sonne verliert ihre Kraft, so daß die Erde eines Tages durch Vereisung zugrunde geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d87be42b-3a64-3ece-b224-3668fb80275c",
                        "entry_id": "64354842-8939-3147-8481-27e350e46039",
                        "glosses": [
                            "Zustand, nachdem etwas zu Eis wurde oder mit Eis bedeckt wurde"
                        ],
                        "tags": [
                            "Nomen Acti"
                        ],
                        "examples": [
                            {
                                "example_id": "32b44bbb-65c8-4bd4-a017-f458b2706681",
                                "sense_id": "d87be42b-3a64-3ece-b224-3668fb80275c",
                                "text": "Die Vereisung vor der Haustür ist stärker als erwartet."
                            },
                            {
                                "example_id": "d6ff352c-8c89-4372-be0a-a8b9e3d5770f",
                                "sense_id": "d87be42b-3a64-3ece-b224-3668fb80275c",
                                "text": "„Im Winter des Jahres 1514 konnten in vielen deutschen Gegenden die Mühlen wegen der Vereisung der Flüsse und im Sommer desselben Jahres wegen ihrer Austrocknung nicht arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4144feff-ae0b-3913-bb56-9cc0c4f96d2c",
                        "entry_id": "64354842-8939-3147-8481-27e350e46039",
                        "glosses": [
                            "Behandlung mit Kälte, zum Beispiel von Warzen"
                        ],
                        "tags": [
                            "Nomen Acti"
                        ],
                        "examples": [
                            {
                                "example_id": "7403040a-c915-48ae-aca9-25d948c49e40",
                                "sense_id": "4144feff-ae0b-3913-bb56-9cc0c4f96d2c",
                                "text": "Die Patientin bekam eine Vereisung."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3ac22c62-36cb-3555-920c-9399b8d899e9",
                        "entry_id": "64354842-8939-3147-8481-27e350e46039",
                        "glosses": [
                            "örtliche Betäubung mittels Kälteanwendung"
                        ],
                        "tags": [
                            "Nomen Acti"
                        ],
                        "examples": [
                            {
                                "example_id": "aa286df9-2875-49e9-86bb-99307ea72a39",
                                "sense_id": "3ac22c62-36cb-3555-920c-9399b8d899e9",
                                "text": "Die Patientin bekam eine Vereisung."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a06a3258-c1ab-4d01-ad1b-f980247e4d37",
                        "source_entry_id": "64354842-8939-3147-8481-27e350e46039",
                        "source_sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                        "source_sense_description": "Vorgang, in dem etwas zu Eis wird oder mit Eis bedeckt wird",
                        "target_lang_word": "glaciation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaciation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "The process of covering with a glacier, or the state of being glaciated; the production of glacial phenomena; an ice age"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4afc0278-1b00-4935-bba1-2225eb9c36dc",
                                                "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                                "text": "That the habitability of our planet was severely endangered by the significant rise in oxygen levels and reduction in methane due to oxygen-producing bacteria combined with the low luminosity of the Sun in the Proterozoic era (2500– 542 million years ago) is suggested by geological evidence for severe global glaciations in this epoch."
                                            },
                                            {
                                                "example_id": "426b33a2-00e9-4c97-9ee9-ac231ef502b0",
                                                "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                                "text": "This simulation aims at describing the hydrological conditions at a Swedish deep repository of nuclear waste during a glaciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "A particular instance of glacier formation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6161c3f2-8ed0-4228-b8cb-a7e93ce7271f",
                                                "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                                "text": "Deposits of the Caribou Hills glaciation only locally retain a distinct hummocky morainal form, with filled kettle depressions and subdued knobs. Along the mountain fronts the marginal deposits of this glaciation reach an average altitude of slightly more than 3,000 feet."
                                            },
                                            {
                                                "example_id": "a25619c7-b15e-4680-a663-18086c0c86f3",
                                                "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                                "text": "Deposits from the glaciation are sparse, but glacial surfaces at 4150–4300 m in the Hunza area, above 2600 m in the Gilgit region, above 3200 m in the Haramosh region, above 4000 m on Deosai, and at 3200–3500 m in the Shigar valley area provide much evidence for this glaciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8a5bc6-9ff9-3ae1-b9ea-a13f402e3936",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "The act of freezing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "048f8606-0605-4bb6-b974-0d20e4707d70",
                                                "sense_id": "ba8a5bc6-9ff9-3ae1-b9ea-a13f402e3936",
                                                "text": "For cave glaciation to occur it is necessary that the air temperature outside the caves be negative either for all or part of a year; such conditions exist in many regions of the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aa20859-7dae-4791-ae9f-e36f9df3bc75",
                        "source_entry_id": "64354842-8939-3147-8481-27e350e46039",
                        "source_sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                        "source_sense_description": "Vorgang, in dem etwas zu Eis wird oder mit Eis bedeckt wird",
