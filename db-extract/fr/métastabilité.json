                "senses": [
                    {
                        "sense_id": "a396eadd-bc41-3a25-84e2-fc7ce857910c",
                        "entry_id": "44e2f987-e972-3058-9cfe-17bcb4f6935c",
                        "glosses": [
                            "État métastable de la matière."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "3890d1ef-24b6-4eb7-8283-8f5a329c20df",
                                "sense_id": "a396eadd-bc41-3a25-84e2-fc7ce857910c",
                                "text": "La métastabilité est la capacité pour un état d'être stable cinétiquement mais pas thermodynamiquement."
                            },
                            {
                                "example_id": "28c8a4d7-adf6-46c7-9278-3b85320bdc42",
                                "sense_id": "a396eadd-bc41-3a25-84e2-fc7ce857910c",
                                "text": "Modélisation de la métastabilité de structures MIS à base de silicium amorphe d'après des mesures de capacité quasistatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "86f62500-f1a7-3dec-ae0e-c919aea1054d",
                        "entry_id": "44e2f987-e972-3058-9cfe-17bcb4f6935c",
                        "glosses": [
                            "Caractère potentiellement instable, fondamentalement transitoire d'une situation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a08da729-28ac-40ed-ab18-e7a639a9580a",
                                "sense_id": "86f62500-f1a7-3dec-ae0e-c919aea1054d",
                                "text": "Dans le passage de G. Hottois, le terme pré-individué souligne la métastabilité que sous-entend le processus d'individuation."
                            },
                            {
                                "example_id": "4ae56758-b378-4d10-9255-055a530f79d7",
                                "sense_id": "86f62500-f1a7-3dec-ae0e-c919aea1054d",
                                "text": "La dimension symbolique de toute forme instituée doit être prise en compte parmi les éléments constituant la métastabilité du système."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "907ff9b1-2ad0-47df-94c2-1333b39ba1ad",
                        "source_entry_id": "44e2f987-e972-3058-9cfe-17bcb4f6935c",
