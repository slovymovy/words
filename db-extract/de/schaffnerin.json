                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Schaffnerin"
                    },
                    {
                        "form_id": "7a8f21e9-77a2-4523-907e-76500a7a44c8",
                        "entry_id": "af16a6ec-d1bf-32eb-b9d1-155d88a48335",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schaffnerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c359c8af-685c-3699-b83e-625bbe4798c2",
                        "entry_id": "af16a6ec-d1bf-32eb-b9d1-155d88a48335",
                        "glosses": [
                            "weibliche Person, die als Schaffner arbeitet, also in der Bahn/Straßenbahn und so weiter Fahrkarten kontrolliert"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "3067dc16-0c4f-4601-8ee3-e652c8fcee3a",
                                "sense_id": "c359c8af-685c-3699-b83e-625bbe4798c2",
                                "text": "„Im Herbst 1914 berichteten Zeitungen von den ersten Schaffnerinnen in Berlin.“"
                            },
                            {
                                "example_id": "009234d4-ae8f-4db2-b217-e002f4500175",
                                "sense_id": "c359c8af-685c-3699-b83e-625bbe4798c2",
                                "text": "„Sie arbeitete zunächst als Bürokraft und ab 1957 als Schaffnerin bei den Wiener Verkehrsbetrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                        "entry_id": "af16a6ec-d1bf-32eb-b9d1-155d88a48335",
                        "glosses": [
                            "weibliche Person, welche die wirtschaftlichen Angelegenheiten regelt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "b680d480-993e-446e-b069-f75ddfd6ec21",
                                "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                                "text": "„Und die Drescher antworteten dem Hennchen: ‚Wir geben dir nicht früher das Hintergetreide, bevor du uns nicht von der Schaffnerin süßen Schmetten bringst.‘“"
                            },
                            {
                                "example_id": "fd47228c-d45e-4973-82da-ee12d298d2a9",
                                "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                                "text": "„Im entgegengesetzten Fall müssen Sie entweder oder es muß die Schaffnerin das Gut verlassen.“"
                            },
                            {
                                "example_id": "28735c06-74ef-4a35-8692-cee9d34a76b1",
                                "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                                "text": "„Sie steckte die Hand unter ihr Brustmieder und zog einen Speziestaler herau, der sorgfältig in ein Tuch eingewickelt war, und zeigte ihn der Schaffnerin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
