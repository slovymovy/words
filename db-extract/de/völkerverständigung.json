                    }
                ],
                "senses": [
                    {
                        "sense_id": "c78decc0-28a1-3e87-8413-b33151530c97",
                        "entry_id": "de5ea4b9-1114-3e5c-b232-20e54904402e",
                        "glosses": [
                            "Aufbau und Erhalt von tiefgreifender Kommunikation zwischen verschiedenen Völkern, Bevölkerungsgruppen oder Kulturkreisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56a77924-91dd-470a-89ad-a892837e71b3",
                                "sense_id": "c78decc0-28a1-3e87-8413-b33151530c97",
                                "text": "Der Völkerverständigung kommt in unserer heutigen globalen Welt eine immer größere Bedeutung zu."
                            },
                            {
                                "example_id": "c1314d34-b251-408a-902f-b186d81f4baf",
                                "sense_id": "c78decc0-28a1-3e87-8413-b33151530c97",
                                "text": "Die Völkerverständigung trägt zur Vermeidung von Kriegen bei."
                            },
                            {
                                "example_id": "68066828-c854-4d29-9033-408276a84932",
                                "sense_id": "c78decc0-28a1-3e87-8413-b33151530c97",
                                "text": "„Eine solche große Geste im Sinne der Völkerverständigung durfte nicht abgelehnt werden.“"
                            },
                            {
                                "example_id": "98ea222b-fd66-4423-a383-8538aa6ec8c0",
                                "sense_id": "c78decc0-28a1-3e87-8413-b33151530c97",
                                "text": "„Im Zeichen des guten Willens standen die Weihnachts- und Neujahrsbotschaften der Staatsmänner. Der Gedanke der Völkerverständigung soll als Leitstern über dem Jahre 1947 stehen.“"
                            },
                            {
                                "example_id": "80ec3060-b665-4987-bc9c-757fe3b4b7a0",
                                "sense_id": "c78decc0-28a1-3e87-8413-b33151530c97",
                                "text": "„Die Bundesrepublik, so schien es mir, war als Demokratie unerschütterbar, das aufrichtige Bemühen um Veränderung und Sühne, Ausgleich, Völkerverständigung und Freiheit ihr nicht abzusprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
