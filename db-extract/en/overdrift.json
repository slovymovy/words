        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "58497324-9c53-386d-adcc-6c57b78b8e25",
                "word": "overdrift",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5effb7e-c6a5-3acf-a840-5ce0e5858c89",
                        "entry_id": "58497324-9c53-386d-adcc-6c57b78b8e25",
                        "glosses": [
                            "Having gearing that turns the millstone by means of a pole that rises above it."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "64e6aba3-694d-4144-ad58-4df0f094d3a9",
                                "sense_id": "d5effb7e-c6a5-3acf-a840-5ce0e5858c89",
                                "text": "The overdrift method in smock mills may be seen at Punnetts Town, and the underdrift at Shipley."
                            },
                            {
                                "example_id": "9183b278-300f-4a13-ad10-d40bde74229a",
                                "sense_id": "d5effb7e-c6a5-3acf-a840-5ce0e5858c89",
                                "text": "In an overdrift mill this gear is mounted on the quant, in an underdrift mill on the stone spindle."
                            },
                            {
                                "example_id": "fa37f11c-6722-404d-aae6-1d29c2ea203e",
                                "sense_id": "d5effb7e-c6a5-3acf-a840-5ce0e5858c89",
                                "text": "For cleanliness, experienced millers prefer an 'overdrift' mill (as, indeed windmills should be, for lightness and efficiency of driving gears), because underdrift gearing becomes very dirty and clogged with a compound of meal dust and grease, besides being generally inaccessible for repairs and adjustments."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6dafcecf-2e38-38cb-8c6e-28cdef743fbb",
                "word": "overdrift",
                "pos": "noun",
                "lang_code": "en",
