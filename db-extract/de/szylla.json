                        "translation_id": "51a31829-e6e4-4f72-aac8-2a1b68bb0aaf",
                        "source_entry_id": "73f21496-fe8f-3d3e-86f2-3e00e1aea605",
                        "source_sense_id": "217f6c94-d9ea-3d86-be2a-0a69d2a673b8",
