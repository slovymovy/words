                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efebfba8-9f35-4670-80fd-544368ed1235",
                                "sense_id": "74f0614d-fd08-395a-bafe-d1299874fa0a",
                                "text": "„Ähnliche Gräuel sind auch auf den Felsbildern von Vista Verde dargestellt.“"
                            },
                            {
                                "example_id": "21e06347-1a3b-4712-93f5-115e6ccba2ef",
                                "sense_id": "74f0614d-fd08-395a-bafe-d1299874fa0a",
                                "text": "„Im Juli 1850 stößt der Hamburger auf Felsbilder, die neben bogenbewehrten Wesen, einem Esel und einem Pferd auch Rinderherden zeigen.“"
                            }
                        ],
