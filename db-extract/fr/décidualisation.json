                        "glosses": [
                            "Processus qui entraine des changements importants dans les cellules de l’endomètre en préparation à la grossesse et pendant celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "393946f9-9b5d-47e2-b7e4-e463a46d9841",
                                "sense_id": "9e0e283d-b847-386c-acc5-99307ae41dbe",
                                "text": "Après l’ovulation, le corps jaune produit progestérone. Les cellules de l’endomètre se modifient alors pour se préparer à recevoir un blastocyste nouvellement conçu et à former le placenta. Ce processus s’appelle la décidualisation."
                            }
                        ]
                    }
