                ],
                "senses": [
                    {
                        "sense_id": "a0f47e0e-4236-35cf-a4fd-03ba87448ef9",
                        "entry_id": "63ad9b74-b55f-388a-a4b8-5e54b45f395f",
                        "glosses": [
                            "Versuch, die Existenz eines Gottes zu beweisen"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "82d9e3fc-472e-4271-bbf6-50e837345048",
                                "sense_id": "a0f47e0e-4236-35cf-a4fd-03ba87448ef9",
                                "text": "„Im Archiv stieß er auf Aufzeichnungen des österreichischen Mathematikers Kurt Gödel, in denen es um Zeitreisen, Gottesbeweise und Engel ging.“"
                            },
                            {
                                "example_id": "2bbc1782-d04d-4777-8842-ea2216bff24b",
                                "sense_id": "a0f47e0e-4236-35cf-a4fd-03ba87448ef9",
                                "text": "„Der ausführliche und methodische Nachweis der Wirklichkeit des reinen Seins ist ein Hauptanliegen der Gottesbeweise, […]“"
                            },
                            {
                                "example_id": "53f0becf-8b5b-4bc7-9623-3c0250bddf3f",
                                "sense_id": "a0f47e0e-4236-35cf-a4fd-03ba87448ef9",
                                "text": "„Gottesbeweise haben eine lange Tradition; seit mehr als zweitausend Jahren wird über Gottesbeweise nachgedacht, werden überlieferte Argumentationen geprüft und zum Teil verworfen, werden neue Beweise erdacht.“"
                            },
                            {
                                "example_id": "d1c971ec-9be7-474b-a79d-54be6b0a4732",
                                "sense_id": "a0f47e0e-4236-35cf-a4fd-03ba87448ef9",
                                "text": "„Der Glaube, dass es einen Gott gibt, bleibt jedoch trotz der Versuche des menschlichen Geistes, sich über sogenannte Gottesbeweise, über intellektuelle Erkenntnisse und logische Schlüsse, Sicherheit zu verschaffen, ein Wagnis.“"
                            },
                            {
                                "example_id": "78dba37e-bdcf-4ee8-aba9-a10b094389a2",
                                "sense_id": "a0f47e0e-4236-35cf-a4fd-03ba87448ef9",
                                "text": "„Robert Spaemann, der große Wertkonservative, der sich nicht nur gegen die moderne verbrauchende Embryonenforschung, sondern auch gegen jede Form von Euthanasie aussprach, wartete im Herbst 2006 mit einem neuen Gottesbeweis, dem wohlgemerkt letzten Gottesbeweis, auf.“"
                            },
                            {
                                "example_id": "b74e670d-f0a5-4098-8d32-5755cf3aba35",
                                "sense_id": "a0f47e0e-4236-35cf-a4fd-03ba87448ef9",
                                "text": "„Mit diesem moralischen Gottesbeweis hätten wir den einzig möglichen Gottesbeweis vor uns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
