            "senses": [
                {
                    "sense_id": "2330b6fa-0141-3b88-b1e8-15fa34899e8b",
                    "sense_definition": "op een manier die laat zien dat men iets niet verwacht had",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verwondering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongen keek <w>verbaasd</w> om zich heen toen hij de grote stad voor het eerst zag.",
                            "target_lang_translations": {
                                "en": "The boy looked around <w>with surprise</w> when he saw the big city for the first time.",
                                "ru": "Мальчик <w>удивлённо</w> оглядывался по сторонам, когда впервые увидел большой город.",
                                "de": "Der Junge schaute sich <w>verwundert</w> um, als er die große Stadt zum ersten Mal sah."
                            }
                        },
                        {
                            "text": "<w>Verbaasd</w> zag ik de volgende ochtend dat er een dun laagje ijs op mijn tent lag.",
                            "target_lang_translations": {
                                "en": "<w>Surprised</w>, I saw the next morning that there was a thin layer of ice on my tent.",
                                "ru": "На следующее утро я с <w>удивлением</w> обнаружил, что на моей палатке лежит тонкий слой льда.",
                                "de": "<w>Überrascht</w> sah ich am nächsten Morgen, dass eine dünne Eisschicht auf meinem Zelt lag."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwonderd",
                        "verrast"
                    ],
                    "common_phrases": [
                        "verbaasd kijken",
                        "verbaasd reageren"
                    ],
                    "target_lang_definitions": {
                        "en": "in a way that shows one did not expect something",
                        "ru": "таким образом, который показывает, что человек не ожидал чего-либо",
                        "de": "Auf eine Weise, die zeigt, dass man etwas nicht erwartet hat."
                    },
