                "senses": [
                    {
                        "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                        "entry_id": "a91719af-f050-3cfc-96e5-2310dfa582ee",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd35ac74-60db-4a09-a275-b44423b081f8",
                                "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                                "text": "Frau Thompson ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2ec7565c-5b36-4272-8024-276e9a3a1203",
                                "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                                "text": "Herr Thompson wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "818a18d0-35a5-4523-b5c8-020d14d4ce18",
                                "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                                "text": "Die Thompsons fahren heute ins Emsland."
                            },
                            {
                                "example_id": "b5d316d2-57cd-47e3-9d39-785fecd1c088",
                                "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                                "text": "Der Thompson trägt nie die Schals, die die Thompson ihm strickt."
                            },
                            {
                                "example_id": "c0c5676d-9ad3-4d12-b889-adb89181db2e",
                                "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thompson kommt, geht der Herr Thompson.“"
                            },
                            {
                                "example_id": "28639879-e7d1-4be9-8d4c-826ec5f7a8ea",
                                "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                                "text": "Thompson kommt und geht."
                            },
                            {
                                "example_id": "f70c0d21-747f-47f5-9753-2256de9bc69f",
                                "sense_id": "ac6532d7-3b4f-396f-b20b-f2ac99481345",
                                "text": "Thompsons kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
