                "senses": [
                    {
                        "sense_id": "5fbae4df-b16b-3ad2-9e03-9ab617c8d25c",
                        "entry_id": "b8cf6db9-1fe3-3d1a-bc55-4e51a89dc15e",
                        "glosses": [
                            "Not systematic; random, disorganised, or unthorough."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be6f93d-ac82-4dd7-9180-d60860aeb3f9",
                                "sense_id": "5fbae4df-b16b-3ad2-9e03-9ab617c8d25c",
                                "text": "None of the traditional proposals suffers from the weaknesses characteristic of CAW's suggestions: what CAW has to offer are mere guesses, arrived at in a totally unsystematic way and totally unsupported by rational and reasonable argumentation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ff09f44-1ffc-4423-9f66-3052332c2838",
                        "source_entry_id": "b8cf6db9-1fe3-3d1a-bc55-4e51a89dc15e",
                        "source_sense_id": "5fbae4df-b16b-3ad2-9e03-9ab617c8d25c",
                        "source_sense_description": "not systematic",
                        "target_lang_word": "onsystematisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onsystematisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "94621402-f24e-315f-a934-8cd1f9627e5e",
                                        "entry_id": "ad94a2a3-d2ea-3f4c-b50c-186caacbc7bf",
                                        "glosses": [
                                            "chaotisch, gefragmenteerd en niet stelselmatig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2693d8e9-0acf-4ce4-b48f-29100e5a9389",
                                                "sense_id": "94621402-f24e-315f-a934-8cd1f9627e5e",
                                                "text": "Dit brede en lastig te vatten begrip tekent Herders filosofie, die principieel onsystematisch is."
                                            },
                                            {
                                                "example_id": "e1cdeb62-9e01-4ec5-b097-1c674e0172b9",
                                                "sense_id": "94621402-f24e-315f-a934-8cd1f9627e5e",
                                                "text": "Je kunt je die voorstellen als een zwerm agressieve insecten die in een lege schuur opgesloten zitten, van de ene muur naar de andere vliegen, botsen, naar beneden schieten en dan weer omhoog, van links naar rechts en van rechts naar links, en dat allemaal volkomen ongericht en onsystematisch."
                                            },
                                            {
                                                "example_id": "32f7cac8-b19b-46bd-b192-0e80df361019",
                                                "sense_id": "94621402-f24e-315f-a934-8cd1f9627e5e",
                                                "text": "Volgens astronoom David Spergel, de voorzitter van het team, worden vandaag de dag nog steeds veel te weinig UAP-meldingen gedaan en is dat gebrek aan data het grootste struikelblok om tot een beter begrip van UAP’s te komen. ‘Veel piloten die een UAP opmerken, zijn terughoudend om dat te melden, omdat het stigma te groot is’, zegt Spergel. ‘Eén van onze doelen is om dat weg te werken, want als ik in één zin moet samenvatten wat we geleerd hebben, is het dat we nood hebben aan betere gegevens. Momenteel gebeurt die gegevensverzameling onsystematisch en gefragmenteerd. Om UAP’s beter te kunnen verklaren is een gerichter en grondiger plan van aanpak nodig.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
