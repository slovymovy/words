{
    "word_family": [
        "converge",
        "convergent",
        "convergency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09eaa1a6-8ba7-3ede-9f33-ee05f8d7fd1f",
                    "sense_definition": "The act of moving toward union, uniformity, or a common point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "union",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>convergence</w> of different cultures in the city has created a unique and vibrant community.",
                            "target_lang_translations": {
                                "ru": "<w>Сближение</w> различных культур в городе создало уникальное и яркое сообщество."
                            }
                        },
                        {
                            "text": "There is a steady <w>convergence</w> of interests between the two companies regarding the new project.",
                            "target_lang_translations": {
                                "ru": "Наблюдается устойчивое <w>сближение</w> интересов двух компаний в отношении нового проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "convergency"
                    ],
                    "antonyms": [
                        "divergence",
                        "divergency"
                    ],
                    "common_phrases": [
                        "steady convergence",
                        "convergence of interests",
                        "cultural convergence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс движения к объединению, единообразию или общей точке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сближение",
                                "target_lang_sense_clarification": "интересов, позиций или культур"
                            },
                            {
                                "target_lang_word": "конвергенция",
                                "target_lang_sense_clarification": "процесс сближения или уподобления"
                            },
                            {
                                "target_lang_word": "схождение",
                                "target_lang_sense_clarification": "в одной точке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f05bb13-ece8-32c4-9de6-9010c184c4ea",
                    "sense_definition": "The merging of distinct technologies, industries, or devices into a unified whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>convergence</w> of mobile phones and cameras has changed how we capture memories.",
                            "target_lang_translations": {
                                "ru": "<w>Конвергенция</w> мобильных телефонов и камер изменила то, как мы запечатлеваем воспоминания."
                            }
                        },
                        {
                            "text": "Digital <w>convergence</w> allows us to access media across many different types of devices.",
                            "target_lang_translations": {
                                "ru": "Цифровая <w>конвергенция</w> позволяет нам получать доступ к медиафайлам на самых разных типах устройств."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital convergence",
                        "technological convergence",
                        "media convergence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слияние различных технологий, отраслей или устройств в единое целое."
