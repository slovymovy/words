                "translations": [
                    {
                        "translation_id": "8145e52f-521c-4a55-961e-2893750b3bf5",
                        "source_entry_id": "56268d83-d3f1-3a5c-9c8f-e4e5f847aac0",
                        "source_sense_id": "fd94ccab-a2f3-3466-adbb-59c18f71fd90",
