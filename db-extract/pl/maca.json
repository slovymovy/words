                                    {
                                        "sense_id": "15bc3e98-98d9-3a53-876b-4c57834805cd",
                                        "entry_id": "f0e6fdd2-d8eb-3ecb-aa4a-adb402c148ab",
                                        "glosses": [
                                            "Pain non levé, consommé pendant Pessa’h."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f909eeb4-9baa-4c2c-b91a-68fc409aae6f",
                                                "sense_id": "15bc3e98-98d9-3a53-876b-4c57834805cd",
                                                "text": "La matza casher pour Pessa'h (ou matza shmourah, par opposition au pain azyme ordinaire) est fabriquée avec une farine spécialement contrôlée, depuis le moment où le blé est coupé jusqu’au moment où elle est trempée dans l’eau et cuite rapidement dans les 18 minutes."
                                            },
                                            {
                                                "example_id": "95c3447d-6bda-4b1c-a993-96bde064e843",
                                                "sense_id": "15bc3e98-98d9-3a53-876b-4c57834805cd",
                                                "text": "Mélangez les œufs, la farine de matza, l’ail, le gingembre haché finement, l’huile de coco, les herbes ciselées finement, le shot d’huile et d’eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
