                "senses": [
                    {
                        "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                        "entry_id": "613f7f6a-cf24-3640-9064-8fc128fd4c0c",
                        "glosses": [
                            "kleine Kammer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fba5ec5-ff96-4db9-90b2-fd74b0a218b7",
                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                "text": "In seinem Kämmerchen sammelt er seinen Unrat."
                            },
                            {
                                "example_id": "9321f0ed-82a0-4af4-bc51-fceb073f1508",
                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                "text": "„Um im Kämmerchen durch die Dachluke den Schloßturm sehen zu können, mußte ich auf die Kommode klettern.“"
                            },
                            {
                                "example_id": "3fa2dc2c-9695-43a8-8329-e3315cfe5e8e",
                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                "text": "„Die Rückkehr Secondas ließ auf sich warten, und da der Aufenthalt im Gasthaus Hoffmanns letzte Mittel aufgezehrt hat, mietet er sich mit Mischa in einem möblierten Kämmerchen ein, einer Künstlermansarde im vierten Stock eines Hauses am Alten Markt.“"
                            },
                            {
                                "example_id": "e147f575-b6c3-423e-b916-ea40d1650d4a",
                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                "text": "„Als ich durch Bettinas Kämmerchen ging, um in mein Zimmer zurückzukehren, und auf ihrem Bett ihre Tasche liegen sah, überkam mich das Verlangen, hineinzublicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02bc8dde-6857-4cdb-affb-71c0af919702",
                        "source_entry_id": "613f7f6a-cf24-3640-9064-8fc128fd4c0c",
                        "source_sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                        "source_sense_description": "kleine Kammer",
                        "target_lang_word": "cubbyhole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cubbyhole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "363c5895-ecd4-3679-bc08-2fa85ffd6dd1",
                                        "entry_id": "ddca9e3d-f44d-3d6d-a06a-0959358b33d8",
                                        "glosses": [
                                            "A small, snug room which may be used as a place of privacy and safety by children"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14420d78-9e04-3183-b0c8-828cdc40d5ff",
                                        "entry_id": "ddca9e3d-f44d-3d6d-a06a-0959358b33d8",
                                        "glosses": [
                                            "A small compartment; a pigeonhole"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e71fba50-06c4-3dfd-b8c7-2492df2a9b9d",
                                        "entry_id": "ddca9e3d-f44d-3d6d-a06a-0959358b33d8",
                                        "glosses": [
                                            "A glove compartment"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cubbyhole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                        "entry_id": "7991b0ce-22dc-3ea2-b8f6-19daba363af8",
                                        "glosses": [
                                            "To restrict, limit or narrowly define; to pigeonhole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2900ac0-11ac-4c67-b229-3f365bf11349",
                                                "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                                "text": "Rivera: The world has changed. It is no longer cubbyholed. I do not think — Friendly: What do you mean cubbyholed? Rivera: I do not think the definition of journalist is as narrowly construed these days as perhaps it was once."
                                            },
                                            {
                                                "example_id": "3476cb3b-34e3-4d3e-a087-0546bac7242f",
                                                "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                                "text": "A true Renaissance man, Walcott has consistently resisted being cubbyholed. He has rejected neither his Caribbean heritage nor his British education."
                                            },
                                            {
                                                "example_id": "67fcc2fc-5374-4dff-b783-0781d33e4648",
                                                "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                                "text": "The Americans wanted to have enclosed offices, or at the very least, shoulder-high partitions cubbyholing individual desks."
                                            },
                                            {
                                                "example_id": "35db824e-0bb6-47e5-9350-ed37ef588889",
                                                "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                                "text": "And, if we do so, it would be useful to bear in mind Sloterdijk’s insights regarding the amphibian quality of discourse within the Weimar Republic and the compelling ways in which it eludes easy generalization and comfortable cubbyholing."
                                            },
                                            {
                                                "example_id": "810de354-1064-412b-a7d0-c111e754e298",
                                                "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                                "text": "Delimited files and spreadsheets compartmentalize data by separating each piece of info with a comma or a tab, or by cubbyholing them into columns and rows in a spreadsheet file."
                                            },
                                            {
                                                "example_id": "6a0ed302-b20b-4693-928e-487f4f366d70",
                                                "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                                "text": "In the current era, there is too much demand for customer service and the restrains on budgets too great for you to allow cubbyholing.[…]And finally, out of necessity, a small organization like ours, with an increasing workload, could not afford to cubbyhole anyone, let alone 10 percent of our workforce. I advised my directors of my expectation that everybody had to work, that there was to be no cubbyholing, and that there would be no exceptions."
                                            },
                                            {
                                                "example_id": "3a2468a3-fded-41f4-9ff3-e831d508f8dd",
                                                "sense_id": "4f935c7d-771d-3a81-a8eb-200921485596",
                                                "text": "If you have more than two dozen databases on your server, consider cubbyholing them into schemas in a single database."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
