                "senses": [
                    {
                        "sense_id": "7ffb5092-828e-30d3-9108-f35a007010c9",
                        "entry_id": "721d840f-dea6-3853-9715-cd1939f6ba2d",
                        "glosses": [
                            "Soumettre à l'influence des Phalanges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40161605-3802-494e-9e5b-01a7f2a5a1a9",
                                "sense_id": "7ffb5092-828e-30d3-9108-f35a007010c9",
                                "text": "Il choisira de s'appuyer sur les Etats-Unis, de laisser libre cours aux Phalanges, devenues milices officieuses, de reconstituer une armée « partisane », de phalangiser l'appareil d'Etat."
                            }
                        ]
                    },
                    {
                        "sense_id": "22204dd4-da0b-3028-aa8b-1facc626d9e9",
                        "entry_id": "721d840f-dea6-3853-9715-cd1939f6ba2d",
                        "glosses": [
                            "Rallonger, reconstruire, en particulier un doigt en utilisant une partie d'un os métacarpien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c71be5b-dd40-487b-a348-33d325fd7117",
                                "sense_id": "22204dd4-da0b-3028-aa8b-1facc626d9e9",
                                "text": "Un autre cas, vu presque en même temps, avant que j'ai pu tirer les enseignements de cet échec, m'a confirmé l'inutilité de phalangiser des métacarpiens trop courts."
                            }
                        ]
                    }
                ],
