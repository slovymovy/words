                                        "sense_id": "cc694ff1-eb8e-3135-80b0-a1a340a0cc71",
                                        "entry_id": "75a7ccf3-00e9-33be-9e50-829fb36407de",
                                        "glosses": [
                                            "During the night following the current day; during the evening of today."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df786128-674e-468b-9860-621380245389",
                                                "sense_id": "cc694ff1-eb8e-3135-80b0-a1a340a0cc71",
                                                "text": "I want to party tonight!"
                                            },
                                            {
                                                "example_id": "e3dbb0ce-d442-499d-b3da-e34e78e92e47",
                                                "sense_id": "cc694ff1-eb8e-3135-80b0-a1a340a0cc71",
                                                "text": "I had a wonderful time with you tonight."
                                            },
                                            {
                                                "example_id": "64223e28-5fa5-4475-9dbf-ff596c147407",
                                                "sense_id": "cc694ff1-eb8e-3135-80b0-a1a340a0cc71",
                                                "text": "I had a dreadful nightmare last night; I hope I sleep better tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4945025-48fb-354b-b30c-187abb11e216",
                                        "entry_id": "75a7ccf3-00e9-33be-9e50-829fb36407de",
                                        "glosses": [
                                            "Last night."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c88963-83ad-4cc0-a5c3-34c02780a34d",
                                                "sense_id": "d4945025-48fb-354b-b30c-187abb11e216",
                                                "text": "Besides, I met Lord Bigot and Lord Salisbury,\nWith eyes as red as new-enkindled fire,\nAnd others more, going to seek the grave\nOf Arthur, whom they say is killed to-night\nOn your suggestion."
                                            },
                                            {
                                                "example_id": "a50e5352-f1b6-4988-80c5-9c061d866b4b",
                                                "sense_id": "d4945025-48fb-354b-b30c-187abb11e216",
                                                "text": "I dreamt tonight that I did feast with Caesar,\nAnd things unluckily charge my fantasy;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
