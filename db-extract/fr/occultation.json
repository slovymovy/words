                                "target_senses": [
                                    {
                                        "sense_id": "2c133b6d-df37-3ede-aa78-a60d7900d3a1",
                                        "entry_id": "71e3f08a-d9b7-3f09-abf1-79fe84e796fe",
                                        "glosses": [
                                            "Acción o efecto de ocultar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca2e12cd-8685-413f-8312-b00adda0ffe2",
                                                "sense_id": "2c133b6d-df37-3ede-aa78-a60d7900d3a1",
                                                "text": "Toda simulación y distorsión es, en realidad, una ocultación, pero no todo ocultar es un disimular en el sentido de distorsionar y desfigurar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
