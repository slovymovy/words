                        ],
                        "examples": [
                            {
                                "example_id": "d0bc8d46-e0c6-4dd2-8545-70b70f21ff56",
                                "sense_id": "1d3a71a3-e6d8-3d8d-bbb4-8b8b7946e5d8",
                                "text": "Het vlees wordt niet ingevroren maar vacuüm verpakt en gekoeld gescheept."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c6bff88-a109-3960-b904-aa9c9f798203",
