                {
                    "sense_id": "b464359a-07d2-33f9-b947-5c208fb0f0a5",
                    "sense_definition": "Being intentionally concealed so as to deceive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hidden_intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She claimed to be helping him, but I suspected she had an <w>ulterior</w> motive.",
                            "target_lang_translations": {
                                "nl": "Ze beweerde hem te helpen, maar ik vermoedde dat ze een <w>bijbedoeling</w> had."
                            }
                        },
                        {
                            "text": "He offered to pay for the dinner without any <w>ulterior</w> motive behind his kindness.",
                            "target_lang_translations": {
                                "nl": "Hij bood aan om het diner te betalen zonder enige <w>bijbedoeling</w> achter zijn vriendelijkheid."
                            }
                        }
                    ],
                    "synonyms": [
                        "hidden",
                        "secret",
                        "covert"
                    ],
                    "antonyms": [
                        "ostensible"
                    ],
                    "common_phrases": [
                        "ulterior motive"
                    ],
                    "target_lang_definitions": {
                        "nl": "Opzettelijk verborgen om te misleiden."
                    },
                    "translations": {
