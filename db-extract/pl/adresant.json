                            "Verwaltung"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a63ba659-ed98-333b-a952-d2c26774b6d0",
                        "entry_id": "9c12da51-b200-3766-b6ac-e5911d5002a0",
                        "glosses": [
                            "Person, die etwas per Post, Boten und/oder Kurier erhält; Adressat, Empfänger"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce7a6b50-9b4f-4231-9c3b-90ab696ab692",
                        "source_entry_id": "9c12da51-b200-3766-b6ac-e5911d5002a0",
                        "source_sense_id": "d974d5fd-5eda-307e-a5cb-7887826ded05",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Adressant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adressant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a704ba92-1142-33f8-93cb-674364ba29ee",
                                        "entry_id": "3ab89a7e-263c-3040-ba35-5e9e3245bda5",
                                        "glosses": [
                                            "Person, die etwas sendet"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d31cc59b-aefa-48b9-9ebb-317fdbe747fe",
                                                "sense_id": "a704ba92-1142-33f8-93cb-674364ba29ee",
                                                "text": "„Der neue Vertrag wird abgeschlossen, indem der Adressant (Zar) dem Subjekt-Adressaten (Held) das Objekt der Suche (Zarentochter) anbietet.“"
                                            },
                                            {
                                                "example_id": "69fde5d9-b720-4a00-8ba6-cb91f47e0aa7",
                                                "sense_id": "a704ba92-1142-33f8-93cb-674364ba29ee",
                                                "text": "„Weitere Anzeichen dafür, daß der Adressant und somit der fiktive Autor dieses Briefs der Bodhisattva Avalokiteśvara ist, sind: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1de458ef-972e-46e6-ad17-14c8002d42e4",
                        "source_entry_id": "9c12da51-b200-3766-b6ac-e5911d5002a0",
                        "source_sense_id": "d974d5fd-5eda-307e-a5cb-7887826ded05",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Absender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absender",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb42fcf5-0f6f-39f4-a2c0-49be1c5ef418",
                                        "entry_id": "6e3ffcc2-6273-3aee-9be7-bf855d3826ec",
                                        "glosses": [
                                            "Person oder Institution, die eine Information durch ein Medium zu einem Empfänger sendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699ce8c7-70bc-4f96-90cb-4acb108b1ed0",
                                                "sense_id": "fb42fcf5-0f6f-39f4-a2c0-49be1c5ef418",
                                                "text": "Ich habe ein Funksignal empfangen, weiß aber nicht, wer der Absender ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "afde0563-1b4f-3f07-8a82-67266953d30b",
                                        "entry_id": "6e3ffcc2-6273-3aee-9be7-bf855d3826ec",
                                        "glosses": [
                                            "Name und Anschrift des Versenders einer Sendung"
                                        ],
                                        "tags": [
                                            "Post"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018c3207-f431-4e70-885f-54e60d8f2bcb",
                                                "sense_id": "afde0563-1b4f-3f07-8a82-67266953d30b",
                                                "text": "Die Adresse des Absenders gehört auf jedes Paket."
                                            },
                                            {
                                                "example_id": "e808c2fe-8418-4566-8925-3b2c66ecc063",
                                                "sense_id": "afde0563-1b4f-3f07-8a82-67266953d30b",
                                                "text": "„Die Fotos werden als eine Art Empfangsbestätigung zurück an den Absender geschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2553460b-1791-4195-8e60-c24179e19038",
                        "source_entry_id": "9c12da51-b200-3766-b6ac-e5911d5002a0",
                        "source_sense_id": "a63ba659-ed98-333b-a952-d2c26774b6d0",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Adressat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adressat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                        "entry_id": "b3f0fe5b-b2e9-3544-a8b0-bcd211d5219a",
                                        "glosses": [
                                            "Empfänger einer Nachricht, insbesondere im Postwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5228fd-1bbf-4848-a59e-80a13538cb31",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "Der Adressat dieses Briefs ist Herr Peter Drünschick."
                                            },
                                            {
                                                "example_id": "74a2843a-502c-421c-ab6e-50051f57e82a",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "Alle Briefe an unsere Firma landen erst in der Poststelle. Von dort aus werden sie an die Adressaten weitergeleitet."
                                            },
                                            {
                                                "example_id": "f1335188-e8a6-43c1-a630-85942894e05c",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "„Roms Widerstandskraft war nach Cannae durchaus nicht gebrochen. Dem Adressaten dieser Botschaft soll der römische Großmut sowie die Solidarität der Römer in einer Notlage vorgeführt werden und im Gegensatz dazu die karthagische Kleinmütigkeit.“"
                                            },
                                            {
                                                "example_id": "f46fa173-d0b6-4b3b-a3f3-8480e39dbaec",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "„Er schreibt dem jeweiligen Adressaten, wie entzückt der von ihr wäre, wenn er sie kennte, und wenn er ihr eine Liebeserklärung machen möchte, liest er ihr das vor.“"
                                            },
                                            {
                                                "example_id": "5aaf5dec-aedb-427a-bb4c-b2de747fd2a6",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "„Die Karte aus Gotenhafen, die immerhin in Prenzlau angekommen war, hatte den Adressaten nicht mehr viel Hoffnung gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
