                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f2722a1-2fca-3292-8204-0bfde5139095",
                        "entry_id": "846276f8-3aee-3f8d-b72e-18991dcb9e9b",
                        "glosses": [
                            "kraje poza ojczyzną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d151a7b-97a1-4ab1-a69c-cdbd5c1df8b4",
                                "sense_id": "9f2722a1-2fca-3292-8204-0bfde5139095",
                                "text": "Czy kto się modlić będzie na mym grobie / I kto zapłacze, / Gdy na obczyźnie dni skończę tułacze?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9c69f226-a7b8-3085-aacb-bf648e722e9f",
                        "entry_id": "846276f8-3aee-3f8d-b72e-18991dcb9e9b",
                        "glosses": [
