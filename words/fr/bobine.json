            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e96a0b0-1f5a-383d-9756-501ee88fbf6b",
                    "sense_definition": "Petit cylindre sur lequel on enroule des matières flexibles comme du fil, du câble ou de la bande.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cylindre_enroulement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une <w>bobine</w> de fil blanc pour réparer sa chemise.",
                            "target_lang_translations": {
                                "en": "She bought a <w>spool</w> of white thread to mend her shirt.",
                                "ru": "Она купила <w>катушку</w> белых ниток, чтобы починить рубашку.",
                                "de": "Sie hat eine <w>Spule</w> mit weißem Nähgarn gekauft, um ihr Hemd zu flicken.",
                                "es": "Ella compró un <w>carrete</w> de hilo blanco para remendar su camisa.",
                                "zh": "她买了一个<w>线轴</w>的白线，用来缝补她的衬衫。"
                            }
                        },
                        {
                            "text": "Le projectionniste installe une nouvelle <w>bobine</w> de film dans l'appareil.",
                            "target_lang_translations": {
                                "en": "The projectionist loads a new <w>reel</w> of film into the projector.",
                                "ru": "Киномеханик ставит в аппарат новую <w>бобину</w> с плёнкой.",
                                "de": "Der Vorführer legt eine neue <w>Rolle</w> Film in den Projektor ein.",
                                "es": "El proyeccionista instala una nueva <w>bobina</w> de película en el proyector.",
                                "zh": "放映员在放映机里装上了一个新的<w>卷盘</w>，上面缠着电影胶片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bobine de fil",
                        "bobine de film"
                    ],
                    "target_lang_definitions": {
                        "en": "A small cylinder on which flexible materials such as thread, wire or tape are wound.",
                        "ru": "Небольшой цилиндр, на который наматывают гибкие материалы: нить, проволоку или ленту.",
                        "de": "Kleiner Zylinder, auf den flexible Materialien wie Faden, Draht oder Band aufgewickelt werden.",
                        "es": "Cilindro pequeño sobre el que se enrollan hilos, cables o cintas flexibles.",
                        "zh": "一种小圆筒，用来缠绕线、铁丝或胶带等柔软材料。"
                    },
