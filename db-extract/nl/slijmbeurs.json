                "senses": [
                    {
                        "sense_id": "099b0508-d2ec-3cb5-ac32-93315ddafd46",
                        "entry_id": "486bda20-9c75-3125-86f7-ac6d870e8d9d",
                        "glosses": [
                            "een met vocht gevuld 'kussentje' tussen een pees en de onderliggende botstructuur bij een gewricht, dicht bij de aanhechting van de pees op het bot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634bfd39-8605-4516-b01d-0e7c619a9106",
                                "sense_id": "099b0508-d2ec-3cb5-ac32-93315ddafd46",
                                "text": "Een slijmbeurs zorgt ervoor dat het gewricht nagenoeg wrijvingloos kan bewegen, zonder dat de pees over het bot of de huid schuurt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1902ef68-e72b-41f5-97aa-bca9018afd66",
                        "source_entry_id": "486bda20-9c75-3125-86f7-ac6d870e8d9d",
                        "source_sense_id": "099b0508-d2ec-3cb5-ac32-93315ddafd46",
                        "source_sense_description": "een met vocht gevuld 'kussentje' tussen een pees en de onderliggende botstructuur bij een gewricht, dicht bij de aanhechting van de pees op het bot",
                        "target_lang_word": "Schleimbeutel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
