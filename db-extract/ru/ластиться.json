                ],
                "senses": [
                    {
                        "sense_id": "52682f27-65a5-3a45-bd9f-3dbf51b6d89f",
                        "entry_id": "a1e2fdbd-5125-3ad3-9131-b83d700b8a97",
                        "glosses": [
                            "разг. с лаской, нежностью льнуть, приникать к кому-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d5aad8-936c-4ef5-9285-236b8f32b9eb",
                                "sense_id": "52682f27-65a5-3a45-bd9f-3dbf51b6d89f",
                                "text": "Там гнутся с утеса в понт воды, // Там ластятся струи к брегам."
                            },
                            {
                                "example_id": "03bacc87-719b-4489-88e5-11883070424d",
                                "sense_id": "52682f27-65a5-3a45-bd9f-3dbf51b6d89f",
                                "text": "Ни роду нет, ни племени // В чужой мне стороне // Не ластится любезная // Подруженька ко мне!"
                            },
                            {
                                "example_id": "257792b5-2814-4ba7-9e2d-d2e9ae8de666",
                                "sense_id": "52682f27-65a5-3a45-bd9f-3dbf51b6d89f",
                                "text": "«Купи гостинчик, дедушка. // Купи!» — Головкой шелковой // Лицо щекочет, ластится, // Целует старика."
                            }
                        ]
                    },
                    {
                        "sense_id": "c56319c7-8e77-3127-8f34-23dcd989beb4",
                        "entry_id": "a1e2fdbd-5125-3ad3-9131-b83d700b8a97",
                        "glosses": [
                            "разг. льнуть, ласкаться с покорностью, заискивая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0edbdd1-7c1b-4b68-87e2-786fb749dfab",
                                "sense_id": "c56319c7-8e77-3127-8f34-23dcd989beb4",
                                "text": "Скверная собачонка, увидевши это, сначала укусила меня за икру, а потом, когда пронюхала, что я взял бумаги, начала визжать и ластиться, но я сказал: «Нет, голубушка, прощай!» — и бросился бежать."
                            },
                            {
                                "example_id": "92d4966a-a957-4835-bdb9-7f6648d41009",
                                "sense_id": "c56319c7-8e77-3127-8f34-23dcd989beb4",
                                "text": "Но разве я собака, чтобы ластиться к тому, кто бьет меня?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35dd6687-cc4e-4ddc-a52b-3da2c2fc24ea",
                        "source_entry_id": "a1e2fdbd-5125-3ad3-9131-b83d700b8a97",
                        "target_lang_word": "anschmiegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anschmiegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                        "entry_id": "90a17bf2-3c52-3af2-aba1-2b82f04cedf6",
                                        "glosses": [
                                            "sich zärtlich irgendwo herandrücken oder anlehnen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7288e7d8-8ad0-4372-9207-b6cb4132b580",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "Bernd war glücklich, als er mit Suleika im Bett lag und spürte, wie sie sich an ihn anschmiegte."
                                            },
                                            {
                                                "example_id": "c9ea6c0b-25fc-4958-a1cb-7c14682ecda1",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "„Dieser Eingang hatte ein Vordach, von zwei Säulen getragen, an deren eine er sich anschmiegte, um einigermaßen vor der Nässe geschützt, doch in der Nähe bleiben zu können, um einen der abfahrenden Wagen genau zu beobachten.“"
                                            },
                                            {
                                                "example_id": "9ca42681-1bde-48a3-9ee9-1db6b1cb530f",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "Dieses Kleid schmiegt sich vorzüglich an Ihre Figur an, Frau Engel."
                                            },
                                            {
                                                "example_id": "8c5d9a98-699d-48be-983f-08e2d2d39ea1",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "Viele kleine Hütten schmiegen sich dort an den Abhang an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65aaa667-3120-3e4b-89dd-b479bc399354",
                                        "entry_id": "90a17bf2-3c52-3af2-aba1-2b82f04cedf6",
                                        "glosses": [
                                            "etwas zärtlich irgendwo herandrücken oder anlehnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0355b8f-f0ec-4bb4-9270-091f8b4f531b",
                                                "sense_id": "65aaa667-3120-3e4b-89dd-b479bc399354",
                                                "text": "Das Kind schmiegte sein Gesicht an die Schulter seines Vaters an."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
