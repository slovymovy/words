                ],
                "translations": [
                    {
                        "translation_id": "7deb2ef0-9d98-45db-8596-074a3fab3b40",
                        "source_entry_id": "79de938e-48c7-374e-a84e-0ca84f997122",
                        "source_sense_id": "e1d5ca54-c745-331e-a820-44238d7571f7",
                        "target_lang_word": "neoconservative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoconservative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8097cc85-c1da-326d-8df4-9c0b755d70b5",
                                        "entry_id": "c0b007ad-e452-3d95-9549-6bae644632e1",
                                        "glosses": [
                                            "A supporter of neoconservatism."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7c0f7b0-26fb-408b-86b3-7e53cab33839",
                                                "sense_id": "8097cc85-c1da-326d-8df4-9c0b755d70b5",
                                                "text": "The neoliberals stand today in somewhat the position neoconservatives occupied a decade ago. Their ambition is to attain the influence in liberal politics that the neoconservatives have attained in conservative politics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neoconservative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb0831da-2a3f-34ba-82dc-980c80f74b97",
                                        "entry_id": "6669b382-721b-34a2-b874-da982b70a19a",
                                        "glosses": [
                                            "Of or relating to neoconservatism."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3f0f42-4de1-4c55-9658-282a3b6478d9",
                                                "sense_id": "eb0831da-2a3f-34ba-82dc-980c80f74b97",
                                                "text": "There have been suggestions by a number of American neoconservative hawks to denuke Iran with “swift, massive, devastating force that decapitates the regime."
                                            },
                                            {
                                                "example_id": "ac32d3c8-26fc-4b02-97d2-bfc4c239ea80",
                                                "sense_id": "eb0831da-2a3f-34ba-82dc-980c80f74b97",
                                                "text": "And the liberal blogosphere has long labeled Clinton part of the neoconservative wing, a conservative intellectual movement that supports an interventionist foreign policy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "615cb253-2fd4-4d64-abd4-45a658ebb704",
                        "source_entry_id": "79de938e-48c7-374e-a84e-0ca84f997122",
