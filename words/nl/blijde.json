                            "target_lang_translations": {
                                "en": "She was very <w>happy</w> with the beautiful gift she received."
                            }
                        },
                        {
                            "text": "De kinderen waren <w>blijde</w> toen de vakantie eindelijk begon.",
                            "target_lang_translations": {
                                "en": "The children were <w>glad</w> when the vacation finally started."
                            }
