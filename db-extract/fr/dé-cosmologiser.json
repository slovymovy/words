                ],
                "senses": [
                    {
                        "sense_id": "eac69cf5-06f0-3237-8ac0-a114021e1a8f",
                        "entry_id": "6aef241c-2794-3dd7-a940-cde927ea3888",
                        "glosses": [
                            "Enlever son caractère cosmologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee87227-c3c4-4391-91e1-b8c730d650aa",
                                "sense_id": "eac69cf5-06f0-3237-8ac0-a114021e1a8f",
                                "text": "On achève ainsi de le dé-cosmologiser, puisqu'il est libéré entièrement de la référence à l'actuel."
                            },
                            {
                                "example_id": "f295ac4c-7678-4247-97d5-6d5de5960f5a",
                                "sense_id": "eac69cf5-06f0-3237-8ac0-a114021e1a8f",
                                "text": "Mais cette conquête s'exprime ici par un mouvement à l'intérieur du monde des mythes, un mouvement qui « dé-cosmologise » le mal pour le « psychologiser », qui ramène du démonique à l'humain."
                            }
                        ]
                    }
