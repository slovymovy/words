                "senses": [
                    {
                        "sense_id": "0095b4cf-6518-36c3-99e9-b22c4bf9adc0",
                        "entry_id": "370ddde7-36e6-3b63-894d-cf025b00853b",
                        "glosses": [
                            "rare spelling of Seoul"
                        ],
                        "tags": [
                            "alt-of",
                            "neuter",
