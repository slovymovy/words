                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить в тупик",
                                "target_lang_sense_clarification": "неожиданным вопросом или поведением"
                            },
                            {
                                "target_lang_word": "заставать врасплох",
                                "target_lang_sense_clarification": "сбивать с толку"
                            },
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "приводить в замешательство"
                            }
                        ]
