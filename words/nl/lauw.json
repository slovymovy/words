            "senses": [
                {
                    "sense_id": "d784f8b8-2f44-31ea-94ca-b6c1ef80b3ea",
                    "sense_definition": "een temperatuuraanduiding die tussen warm en koud ligt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vindt het niet lekker om zich met <w>lauw</w> water te wassen.",
                            "target_lang_translations": {
                                "en": "He doesn't like washing himself with <w>lukewarm</w> water."
                            }
                        },
                        {
                            "text": "Drink een glas <w>lauwe</w> melk voordat je naar bed gaat om beter te slapen.",
                            "target_lang_translations": {
                                "en": "Drink a glass of <w>lukewarm</w> milk before you go to bed to sleep better."
                            }
                        }
                    ],
                    "synonyms": [
                        "handwarm"
                    ],
                    "antonyms": [
                        "heet",
                        "ijskoud"
                    ],
                    "common_phrases": [
                        "lauw water",
                        "lauwe melk"
                    ],
                    "target_lang_definitions": {
                        "en": "a temperature indication that lies between warm and cold"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lukewarm",
                                "target_lang_sense_clarification": "moderately warm; between warm and cool"
                            },
                            {
                                "target_lang_word": "tepid",
                                "target_lang_sense_clarification": "slightly warm; often used for liquids"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e10a1fcc-8607-31b6-a5b3-aa609898a7b7",
                    "sense_definition": "weinig enthousiast of onverschillig reagerend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het publiek gaf een <w>lauwe</w> reactie op het nieuwe voorstel van de directeur.",
                            "target_lang_translations": {
                                "en": "The audience gave a <w>lukewarm</w> reaction to the director's new proposal."
                            }
                        },
                        {
                            "text": "Zijn enthousiasme werd beantwoord met een <w>lauw</w> applaus van de aanwezigen.",
                            "target_lang_translations": {
                                "en": "His enthusiasm was met with <w>tepid</w> applause from those present."
                            }
                        }
                    ],
                    "synonyms": [
