                                        "entry_id": "f4080ae0-08ac-3236-a5ea-fb6c58822c39",
                                        "glosses": [
                                            "een middel dat de verschijnselen van een ziekte onderdrukt zonder de ziekte te genezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1a0149-360c-4703-b0d5-dc74f3c825be",
                                                "sense_id": "0b733590-6175-3cad-8df6-f8561b15811a",
                                                "text": "Hij leefde bij gratie van de pijnstiller."
                                            },
                                            {
                                                "example_id": "2f7275b9-d5e3-4a25-b827-ada724443835",
                                                "sense_id": "0b733590-6175-3cad-8df6-f8561b15811a",
                                                "text": "Twee artsen constateren op basis van een meta-analyse dat twee morfine-achtige pijnstillers (oxycodon en fentanyl) nauwelijks beter werken dan een placebo"
                                            },
                                            {
                                                "example_id": "ff17c09a-3679-4fd0-8692-7445ed65e2b2",
                                                "sense_id": "0b733590-6175-3cad-8df6-f8561b15811a",
                                                "text": "Sinds OxyContin op de markt kwam zijn in Amerika zo'n tweehonderdduizend Amerikanen gestorven door een overdosis pijnstillers."
                                            }
                                        ]
