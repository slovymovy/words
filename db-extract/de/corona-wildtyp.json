                ],
                "senses": [
                    {
                        "sense_id": "dfb6af4d-eb75-3b74-a897-b351605097c1",
                        "entry_id": "4d979271-c1df-31fc-8595-3afa1888e290",
                        "glosses": [
                            "diejenige Art (derjenige Typ) des Coronavirus, die 2019 erstmalig beim Menschen nachgewiesen wurde; Urform bevor Mutationen zu Veränderungen führten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fdfb42e-4f2a-4af8-a17a-30a5523baa54",
                                "sense_id": "dfb6af4d-eb75-3b74-a897-b351605097c1",
                                "text": "„Watzl geht davon aus, dass sich die indische Variante etwas schneller verbreiten kann als der Corona-Wildtyp.“"
                            },
                            {
                                "example_id": "167bb49a-8654-4cba-9d1e-702b5e09c609",
                                "sense_id": "dfb6af4d-eb75-3b74-a897-b351605097c1",
                                "text": "„Womöglich trifft das alles nicht genauso auf die indische Mutation zu, jedoch wird davon ausgegangen, dass sie wohl etwas ansteckender als der Corona-Wildtyp sein wird.“"
                            },
                            {
                                "example_id": "46d83414-61c0-4816-bcec-9ef08dccc82c",
                                "sense_id": "dfb6af4d-eb75-3b74-a897-b351605097c1",
                                "text": "„Was zum Schutz gegen eine Infektion mit dem so genannten Corona-Wildtyp hilft, das hilft auch zur Vorbeugung gegen eine SARS-CoV-2-Infektion mit einer der Varianten.“"
                            },
                            {
                                "example_id": "ca01757f-c562-476d-8e7f-2d076e3f9adc",
                                "sense_id": "dfb6af4d-eb75-3b74-a897-b351605097c1",
                                "text": "„Erste, noch nicht von Fachleuten begutachtete Studien deuten darauf hin, dass sich diese Variante etwas schneller verbreiten kann als der Corona-Wildtyp – allerdings wohl nicht annähernd so schnell wie B.1.1.7 aus Großbritannien […].“"
                            },
                            {
                                "example_id": "925b91c0-7aca-4b9d-a4a9-989c682d23f0",
                                "sense_id": "dfb6af4d-eb75-3b74-a897-b351605097c1",
                                "text": "„Die Labore würden derzeit jede Probe, wo dies labortechnisch möglich sei, auf mögliche Abweichungen vom Corona-Wildtyp überprüfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
