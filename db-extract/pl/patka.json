                "translations": [
                    {
                        "translation_id": "fa2c4ef7-4c7c-47ad-8875-47267747d428",
                        "source_entry_id": "64ce6128-a28d-3ba8-a28b-c233f0a7f825",
                        "source_sense_id": "f387fc26-dd72-37cc-bcc2-4f583588e844",
                        "target_lang_word": "flap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "Anything broad and flexible that hangs loose, or that is attached by one side or end and is easily moved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529a474a-97a8-41ac-9ece-abc0de85f836",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "a flap of a garment"
                                            },
                                            {
                                                "example_id": "74bdb455-6c4d-40b4-805a-05d5f9220da1",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "The envelope flap seemed curiously wrinkled."
                                            },
                                            {
                                                "example_id": "44933e9e-d6f1-40ff-a9d6-e986d1e075fc",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "Again, Beside these parts destin'd to divers offices, there is a peculiar provision for the wind-pipe, that is, a cartilagineous flap upon the opening of the Larynx or Throttle, which hath an open cavity for the admiffion of the air"
                                            },
                                            {
                                                "example_id": "587765cf-89af-4dbc-9c7d-26726dedeafa",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "The hairs guide the pollinating insect to the base of the petal, where there is a purplish nectary covered by a flap of tissue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240ea877-5736-39a1-9959-f3ef3fb28514",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A hinged leaf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5436f686-c077-4f4c-af32-8f4b72fa1f51",
                                                "sense_id": "240ea877-5736-39a1-9959-f3ef3fb28514",
                                                "text": "the flaps of a table"
                                            },
                                            {
                                                "example_id": "3938b78f-f4a4-49e6-a1ee-07da4a95f3af",
                                                "sense_id": "240ea877-5736-39a1-9959-f3ef3fb28514",
                                                "text": "the flap of a shutter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb04fe9-c1af-3c3d-b007-dbc027c2fbb1",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A hinged surface on the trailing edge of the wings of an aeroplane, used to increase lift and drag."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4f9853a-6326-3aa6-be98-5884f3b5ecd8",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A side fin of a ray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "The motion of anything broad and loose, or a sound or stroke made with it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f2f7a59-d341-4d47-ac82-edecc1a659a4",
                                                "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                                "text": "the flap of a sail"
                                            },
                                            {
                                                "example_id": "c5ea2cb7-396c-4dff-bd95-8826807d3001",
                                                "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                                "text": "the flap of a wing"
                                            },
                                            {
                                                "example_id": "3a96cbde-a2af-4b2b-a102-2aa15b5526ec",
                                                "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A controversy, scandal, stir, or upset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d74e05-ae6e-4f10-819b-a148d1968cb3",
                                                "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                                "text": "The comment caused quite a flap in the newspapers."
                                            },
                                            {
                                                "example_id": "ef5d3c0c-916a-480f-82a5-367aba1cf951",
                                                "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                                "text": "“[…] We saw him vanish right in front of the rest of us. He was there and then he wasn’t. We were to wait for a year for his return or for some message. We waited. Nothing.” / Calvin, his voice cracking: “Jeepers, sir. You must have been in sort of a flap.”"
                                            },
                                            {
                                                "example_id": "d85a9567-19bf-4dd8-ae95-f7d1e9b91246",
                                                "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                                "text": "The current Middlesex grand jury […] is once again on the case, partly as the result of the public flap created by Brill's death and, of course, by the series of articles written by Corsetti in the month after Brill's demise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84c3309-ef84-37f3-aa31-fe2cf7613eff",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A consonant sound made by a single muscle contraction, such as the sound /ɾ/ in the standard American English pronunciation of body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "651d993b-77b0-3720-867a-a9c1728fae86",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A piece of tissue incompletely detached from the body, as an intermediate stage of plastic surgery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0107d9f-3e68-338e-a6ed-825ed4809b2b",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "The labia, the vulva."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54da9eb5-69a6-36bc-96f8-49f1a5841c9a",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A blow or slap (especially to the face)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7ca3824-21b6-4d24-b3b4-e65ac9c1b168",
                                                "sense_id": "54da9eb5-69a6-36bc-96f8-49f1a5841c9a",
                                                "text": "1450, Palladius on Husbondrieː\nWare the horn and heels lest they fling a flap to thee."
                                            },
                                            {
                                                "example_id": "67d15ac3-746d-4859-8bb4-3bc5eb989fb2",
                                                "sense_id": "54da9eb5-69a6-36bc-96f8-49f1a5841c9a",
                                                "text": "a1500 The Prose Merlinː\nThe squire lift up his hand and gave him such a flap that all they in the chapel might it hear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "989f3208-6625-3365-b888-d5ac4826c699",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A young prostitute."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27d3d8e-43e7-4101-8981-3993c67abc0e",
                                                "sense_id": "989f3208-6625-3365-b888-d5ac4826c699",
                                                "text": "Fall to your flap, my Masters, kisse and clip. […] Come hither, you foule flappes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56cfda5c-0703-3334-83a3-6b8fb51f831b",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A connected component of the induced subgraph formed by deleting a set of vertices."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f417a065-554b-304a-b9fd-e0b4ab474230",
                                        "entry_id": "7ba70287-eb70-3ff3-bf7f-e6b8d4035bf3",
                                        "glosses": [
                                            "To move (something broad and loose) up and down."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "684e454f-319d-4aba-ae49-43165db45d70",
                                                "sense_id": "f417a065-554b-304a-b9fd-e0b4ab474230",
                                                "text": "The crow slowly flapped its wings."
                                            },
                                            {
                                                "example_id": "2f94cf91-ff12-4469-91d3-5de5faa7ead5",
                                                "sense_id": "f417a065-554b-304a-b9fd-e0b4ab474230",
                                                "text": "Startled, the wood pigeon flew off, its wings flapping noisily."
                                            },
                                            {
                                                "example_id": "f15f8929-837f-497e-a479-c01c79c97dc8",
                                                "sense_id": "f417a065-554b-304a-b9fd-e0b4ab474230",
                                                "text": "He could be flapping his tongue about you right this minute to anybody who'll bloody listen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b47e65-c7c1-343a-bd2f-7fc8ce46a3e9",
                                        "entry_id": "7ba70287-eb70-3ff3-bf7f-e6b8d4035bf3",
                                        "glosses": [
                                            "To move loosely back and forth."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b775a545-6124-4509-949f-65de789fdacb",
                                                "sense_id": "98b47e65-c7c1-343a-bd2f-7fc8ce46a3e9",
                                                "text": "The flag flapped in the breeze."
                                            }
                                        ]
