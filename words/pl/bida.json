{
    "word_family": [
        "bieda",
        "biedak",
        "biedny",
        "biedować",
        "biedactwo"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f735a0cd-a583-37d8-a14b-2bf7bf3a274b",
                    "sense_definition": "Wariant potoczny lub gwarowy słowa <w>bieda</w>; trudna sytuacja materialna, ubóstwo lub kłopot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ubóstwo_kłopot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej małej wiosce panowała straszna <w>bida</w> i brakowało podstawowych produktów.",
                            "target_lang_translations": {
                                "ru": "В этой маленькой деревне царила страшная <w>бедность</w>, и не хватало основных продуктов."
                            }
                        },
                        {
                            "text": "Zapytany o samopoczucie, machnął tylko ręką i powiedział, że to stara <w>bida</w>.",
                            "target_lang_translations": {
                                "ru": "На вопрос о самочувствии он лишь махнул рукой и сказал: «по-старому, <w>тянем лямку</w>»."
                            }
                        }
                    ],
                    "synonyms": [
                        "bieda",
                        "ubóstwo",
                        "nędza"
                    ],
                    "antonyms": [
                        "bogactwo",
                        "dostatek"
                    ],
                    "common_phrases": [
                        "stara bida",
                        "piszczeć bidę"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "spotykane w gwarach"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорный или диалектный вариант слова «бедность» (bieda); тяжелое материальное положение, нищета или неприятность, беда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беднота",
                                "target_lang_sense_clarification": "бедность, нищета (разг.)"
                            },
                            {
                                "target_lang_word": "бедность",
                                "target_lang_sense_clarification": "нехватка средств"
                            },
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "неприятности, проблемы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cb8ce21-639f-30e9-9cbf-81155d3c82a8",
                    "sense_definition": "W islamie: nieuzasadniona innowacja doktrynalna lub rytualna, uznawana za sprzeczną z tradycją religijną.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niektórzy uczeni twierdzą, że wprowadzenie takiego zwyczaju to niedopuszczalna <w>bida</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые ученые утверждают, что введение такого обычая — это недопустимая <w>бида</w>."
                            }
                        },
                        {
                            "text": "W teologii muzułmańskiej pojęcie <w>bida</w> odnosi się do nieuprawnionych innowacji w kulcie.",
                            "target_lang_translations": {
                                "ru": "В мусульманском богословии понятие <w>бидъа</w> относится к неправомерным новшествам в культе."
                            }
                        }
                    ],
                    "synonyms": [
                        "innowacja"
                    ],
                    "antonyms": [
                        "sunna"
                    ],
                    "target_lang_definitions": {
                        "ru": "В исламе: необоснованное новшество в религиозной доктрине или обрядовой практике, ересь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бида",
                                "target_lang_sense_clarification": "нововведение в религии, ересь"
                            },
                            {
                                "target_lang_word": "бидъа",
                                "target_lang_sense_clarification": "исламский религиозный термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f1c9aac3-785b-3dc1-bfd7-590cde222706",
                    "sense_definition": "Polskie nazwisko męskie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Bida</w> przyszedł dzisiaj punktualnie na zebranie zarządu naszej spółdzielni.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Бида</w> пришел сегодня вовремя на собрание правления нашего кооператива."
                            }
                        },
                        {
                            "text": "Wczoraj spotkałem na ulicy starszego pana <w>Bidę</w>, który mieszka w tej okolicy.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил на улице пожилого господина <w>Биду</w>, который живет по соседству."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Польская мужская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бида",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b110a4ba-ebe4-35e9-879f-66ff3060b948",
                    "sense_definition": "Polskie nazwisko żeńskie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Bida</w> podpisała wszystkie wymagane dokumenty podczas wczorajszego spotkania w urzędzie.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Бида</w> подписала все необходимые документы во время вчерашней встречи в ведомстве."
                            }
                        },
                        {
                            "text": "Rozmawiałem z nową sąsiadką, panią <w>Bidą</w>, o remoncie klatki schodowej.",
                            "target_lang_translations": {
                                "ru": "Я разговаривал с новой соседкой, госпожой <w>Бидой</w>, о ремонте лестничной клетки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Польская женская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бида",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5928a2-5095-3ef1-9cf0-eb1da83d0b29",
                    "sense_definition": "Miasto i obszar samorządowy w środkowo-zachodniej Nigerii, w stanie Niger.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografia_nigeria",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Nasz przewodnik opowiadał, że nigeryjska <w>Bida</w> słynie z tradycyjnego rzemiosła szklarskiego.",
                            "target_lang_translations": {
                                "ru": "Наш гид рассказывал, что нигерийская <w>Бида</w> славится традиционным стеклодувным ремеслом."
                            }
                        },
                        {
                            "text": "Po wielu godzinach podróży dotarliśmy wreszcie do miasta <w>Bida</w> w Nigerii.",
                            "target_lang_translations": {
                                "ru": "После долгих часов пути мы наконец добрались до города <w>Бида</w> в Нигерии."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город и район местного управления в Нигерии, в штате Нигер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бида",
                                "target_lang_sense_clarification": "город в Нигерии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}