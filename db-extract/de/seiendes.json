                                    }
                                ]
                            },
                            {
                                "target_word": "being",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87b5819f-fdea-3fd1-ae71-0b0953ea457a",
                                        "entry_id": "55f791c0-5f97-39b2-ae27-06a555fecb4f",
                                        "glosses": [
                                            "A living creature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca6c681e-a548-4d62-973d-85fe56389ab3",
                                                "sense_id": "87b5819f-fdea-3fd1-ae71-0b0953ea457a",
                                                "text": "Minute grew into minute, and still there was no sign of life, nor did the curtain move; but I felt the gaze of the unknown being sinking through and through me, and filling me with a nameless terror, till the perspiration stood in beads upon my brow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f53d54-dd0c-3124-8505-14200ad28ca5",
                                        "entry_id": "55f791c0-5f97-39b2-ae27-06a555fecb4f",
                                        "glosses": [
                                            "The state or fact of existence, consciousness, or life, or something in such a state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474e23c8-3156-47c0-981b-20d1b78bd73e",
                                                "sense_id": "49f53d54-dd0c-3124-8505-14200ad28ca5",
                                                "text": "1608-1634, John Webster (and perhaps Thomas Heywood), Appius and Virginia\nClaudius, thou / Wast follower of his fortunes in his being."
                                            },
                                            {
                                                "example_id": "554cc96e-7f32-42cd-8629-9fe7f4fcf24d",
                                                "sense_id": "49f53d54-dd0c-3124-8505-14200ad28ca5",
                                                "text": "For the service to be considered was not the service of one servant, but of two servants, and even of three servants, and even of an infinity of servants, of whom the first could not out till the second up, nor the second up till the third in, nor the third in till the first out, nor the first out till the third in, nor the third in till the second up, nor the second up till the first out, every going, every being, every coming consisting with a being and a coming, a coming and a going, a going and a being, nay with all the beings and all the comings, with all the comings and all the goings, with all the goings and all the beings, of all the servants that had ever served Mr. Knott, of all the servants that ever would serve Mr. Knott."
                                            },
                                            {
                                                "example_id": "aefc403b-42d6-4b98-9659-282dd191e95c",
                                                "sense_id": "49f53d54-dd0c-3124-8505-14200ad28ca5",
                                                "text": "The written word, he often argued, could only ever be a low-fidelity reproduction of the fullness of being; any text was ultimately humbled by the reality that it sought to represent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05eae4a2-6787-3480-a831-f419f940b69a",
                                        "entry_id": "55f791c0-5f97-39b2-ae27-06a555fecb4f",
                                        "glosses": [
                                            "That which has actuality (materially or in concept)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d55b307d-9c9e-3d41-83f2-a4c42d0d838c",
                                        "entry_id": "55f791c0-5f97-39b2-ae27-06a555fecb4f",
                                        "glosses": [
                                            "One's basic nature, or the qualities thereof; essence or personality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "245244df-1769-3a1a-961f-3b80e765bc72",
                                        "entry_id": "55f791c0-5f97-39b2-ae27-06a555fecb4f",
                                        "glosses": [
                                            "An abode; a cottage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be7a79d-0621-443d-8c28-25a00896dbed",
                                                "sense_id": "245244df-1769-3a1a-961f-3b80e765bc72",
                                                "text": "It was a relief to dismiss them [Sir Roger's servants] into little beings within my manor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "being",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2960a576-ff8e-357d-b92d-16aacdfe33e3",
                                        "entry_id": "887f1b3e-cb31-3370-b68f-fc4b7d6110b2",
                                        "glosses": [
                                            "Given that; since."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6bf422-6774-4ab4-9493-2f4885687785",
                                                "sense_id": "2960a576-ff8e-357d-b92d-16aacdfe33e3",
                                                "text": "’Tis a hard matter therefore to confine them, being they are so various and many […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6bb5a4d-2b58-47b6-b84a-ed52e2996afc",
                        "source_entry_id": "0fe497dd-4ee8-35b0-b1ed-5f13985c1247",
                        "source_sense_id": "80639ba1-14e2-3d18-a4d1-28679ad6e122",
                        "target_lang_word": "étant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                        "entry_id": "d8cf52f4-90ba-3dd6-9122-d50706782b53",
                                        "glosses": [
                                            "Concept utilisé pour désigner tout ce qui se présente d'une façon déterminée, sur un mode concret, opposé à l’être qui est indéterminé, indifférencié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01445d2b-a1a0-40e8-8ee5-64e8f8b6b424",
                                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                                "text": "Pour échapper au monisme de Parménide, Aristote eût pu faire remarquer que l’expression « L’Être est » est vide de sens, car aucune expérience vécue ne correspond à la saisie de l’être en soi : nous n’appréhendons que des « étants »."
                                            },
                                            {
                                                "example_id": "cc65b695-1634-471b-ab7d-24618a455b6a",
                                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                                "text": "Le paradoxe trouve sa justification dans l’analogicité de l’étant et de ses propriétés."
                                            },
                                            {
                                                "example_id": "227c6c07-9cbc-4dc5-970f-ace3993706e2",
                                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                                "text": "Gilles fait ici une mention assez cocasse de l'erreur légendaire d'Avicenne. Il félicite Averroès d'avoir blâmé Avicenne, qui croyait à tort que l’étant catégorial (l'essence) s'ajoutait comme un accident."
                                            },
                                            {
                                                "example_id": "63683d95-f4b7-453f-81e9-0edf59aed495",
                                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                                "text": "Derrière cet être-pour-la-mort se trouve lÊtre, avec une majuscule, une instance néantisant tous les êtres singuliers, les étants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "étant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e25aad-3ccf-3278-a101-a6f91beb5981",
                                        "entry_id": "de7f9406-f853-3338-bdf1-1008156f0820",
                                        "glosses": [
                                            "Participe présent de être."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ad8b02-e524-445d-ab4f-494a6903aa73",
                                                "sense_id": "c2e25aad-3ccf-3278-a101-a6f91beb5981",
                                                "text": "Mais l’opérateur, lui, absorbe les rayons égarés — et ils sont nombreux — tout le jour et tous les jours ; il n’a encore que des moyens bien infidèles de protection : on lui a fait des lunettes, des gants, de grands tabliers où le plomb entre en plus ou moins grande quantité et arrête les rayons au passage, souvent, des fissures se produisent, ou, ces accessoires étant lourds, gênants, empêchant les mouvements du radiologue, ne sont pas gardés par lui ; on a fait aussi des cages en verre plombé, où se place l’opérateur avec les appareils de commande, mais souvent, le patient à radiographier ou radiothérapiser, a bougé, on va à lui pour faire rectifier la position, les appareils étant en marche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
