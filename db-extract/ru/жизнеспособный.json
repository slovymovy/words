                ],
                "senses": [
                    {
                        "sense_id": "80d456bb-a4ba-38ae-9780-51a5801c1ab9",
                        "entry_id": "146d88d4-3959-3a7e-a634-fef5c9ee00b6",
                        "glosses": [
                            "способный существовать, развиваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2503465-c44a-4b9e-9fe6-212bc7db3c6a",
                                "sense_id": "80d456bb-a4ba-38ae-9780-51a5801c1ab9",
                                "text": "И, наоборот, животные, обладающие разветвлённой сетью сигнально-импульсного реагирования на окружающую среду, оказывались более жизнеспособными, чем всякие гигантозавры."
                            }
