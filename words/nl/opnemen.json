                    "sense_definition": "De telefoon beantwoorden wanneer deze overgaat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun jij de telefoon even <w>opnemen</w>?",
                            "target_lang_translations": {
                                "en": "Can you just <w>pick up</w> the phone?",
                                "ru": "Ты можешь <w>взять трубку</w>?",
                                "de": "Kannst du mal kurz das Telefon <w>abheben</w>?"
                            }
                        },
                        {
                            "text": "Ik belde hem gisteren, maar hij <w>nam</w> niet <w>op</w>.",
                            "target_lang_translations": {
                                "en": "I called him yesterday, but he didn't <w>pick up</w>.",
                                "ru": "Я звонил ему вчера, но он не <w>брал трубку</w>.",
