                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e6141907-9799-3ec5-849f-663b789bf32e",
                        "entry_id": "59edc9a2-cc3e-3372-a7d7-66ad662ba6b6",
                        "glosses": [
                            "A male given name from the Germanic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5ce48e-3f45-472f-92d9-cd0019b72244",
                                "sense_id": "e6141907-9799-3ec5-849f-663b789bf32e",
                                "text": "\"Do you think so? Her husband has an odd name - Derek Keppel. He is a musician - a violinist.\""
                            },
                            {
                                "example_id": "17e8d5bb-3b88-42a7-9d63-3c5257986e65",
                                "sense_id": "e6141907-9799-3ec5-849f-663b789bf32e",
                                "text": "We do not entertain as much anymore because of Derek. (He produces strain. We have to pretend he doesn't.) I used to like him when I still thought he was normal. I was fond of him. I used to call him Dirk, and Kiddo, Steamshovel, Dinky Boy, and Dicky Dare. Till I found out what he was. Now it's always formal: Derek."
                            },
                            {
                                "example_id": "0a0d9f2a-3dc2-4b19-94e7-e67a2509384c",
                                "sense_id": "e6141907-9799-3ec5-849f-663b789bf32e",
                                "text": "Frederick or Derek Boothby was in his late fifties, the son of a naval officer and a daughter of the Earl of Limerick."
                            },
                            {
                                "example_id": "f193f617-3ca2-423b-9b56-b83572a35ecc",
                                "sense_id": "e6141907-9799-3ec5-849f-663b789bf32e",
                                "text": "The willingness to bring more marginal legal cases reflects how the amount of money being put toward election litigation has increased significantly, said Derek Muller, an election law professor at the University of Notre Dame who noted that the trend also applies to Democrats and outside groups across the ideological spectrum."
                            }
                        ]
                    },
