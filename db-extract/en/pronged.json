                    {
                        "translation_id": "e7b39e92-1956-47b0-bbc1-00872c3010c1",
                        "source_entry_id": "54054a6f-9082-39fc-98b2-06538efde36a",
                        "source_sense_id": "c269a81a-edef-354d-955e-1db1d5a2d7d1",
                        "source_sense_description": "having prongs",
                        "target_lang_word": "zackig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zackig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fbf32b3-26b2-3b60-bb06-7f6dddf19354",
                                        "entry_id": "be0e915d-5681-3cf1-952f-4302ad2e2f2d",
                                        "glosses": [
                                            "mit Zacken versehen, besetzt, ausgestattet; ausgefranst, nicht glatt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a3f2fe-c5a0-4fbf-adb4-cb9f650c4c5e",
                                                "sense_id": "8fbf32b3-26b2-3b60-bb06-7f6dddf19354",
                                                "text": "Die Klinge des Schwertes ist nach den schweren Kämpfen zackig und stumpf geworden."
                                            },
                                            {
                                                "example_id": "d0b38dd6-6e61-469c-a9c2-f9df9acc2e28",
                                                "sense_id": "8fbf32b3-26b2-3b60-bb06-7f6dddf19354",
                                                "text": "„Es gibt viele Arten von Kilim, deren Musterung von den gröbsten, zackig abgesetzten geometrischen Figuren bis zu seinen stilisierten Flächenfüllungen abwechseln.“"
                                            },
                                            {
                                                "example_id": "528ab163-aece-4284-b987-58c793f9f85e",
                                                "sense_id": "8fbf32b3-26b2-3b60-bb06-7f6dddf19354",
                                                "text": "„Solothurn (franz. Soleure), 1) Canton der Schweiz, liegt zackig zwischen Basel, Aargau u. Bern, hat zwei kleine Enclaven (Klein. Lützel u. Mariastein nach den Hauptortschaften) zwischen den Cantonen Bern u. Basel u. dem französischen Departement Oberrhein […].“"
                                            },
                                            {
                                                "example_id": "3df94fcc-4a61-4161-bc06-ceca7c2f959d",
                                                "sense_id": "8fbf32b3-26b2-3b60-bb06-7f6dddf19354",
                                                "text": "„Bald waren die beiden schroff und zackig emporstrebenden Felsen erreicht, die, einander gegenüberstehend, von dieser Seite die Gränze der zu Schloß Aarheim gehörenden Ländereien bezeichnen, und den, einem Riesenthor ähnlichen Eingang zu dem schauerlichen Felsenthale bilden, in welchem der Eisenhammer liegt.“"
                                            },
                                            {
                                                "example_id": "775248b9-90fa-4cba-974f-fef345b67f28",
                                                "sense_id": "8fbf32b3-26b2-3b60-bb06-7f6dddf19354",
                                                "text": "„Zu beiden Seiten eines sumpfigen Wegs ziehen sich kahle Baumstrünke hin, deren Äste zackig und verworren in die Luft gespreizt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ccb9a1c-f12d-3671-b215-407c1bcac169",
                                        "entry_id": "be0e915d-5681-3cf1-952f-4302ad2e2f2d",
                                        "glosses": [
                                            "schneidig, straff"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a089f4fb-bad1-4a0b-b137-da18f74e7a9d",
                                                "sense_id": "4ccb9a1c-f12d-3671-b215-407c1bcac169",
                                                "text": "Der Offizier wurde von seinem Untergebenen zackig gegrüßt."
                                            },
                                            {
                                                "example_id": "bf090377-c651-4bb6-9bac-291a73f2e2b4",
                                                "sense_id": "4ccb9a1c-f12d-3671-b215-407c1bcac169",
                                                "text": "„Jetzt allerdings schnellte die Stimme Oettingers scharf, zackig, hart in die Höhe.“"
                                            },
                                            {
                                                "example_id": "de2fbbb9-7a2c-43ed-88fc-1850d923a127",
                                                "sense_id": "4ccb9a1c-f12d-3671-b215-407c1bcac169",
                                                "text": "„Der Anrufer soll sich deutlich melden. Konkret heißt das: Er soll sich vorher überlegen, wer an den Apparat kommen könnte, und ob ihn diese Person kennt. Dann soll er, wenn möglich, seinem Namen einige Worte vorausgehen lassen, damit sich der Angerufene an seine Stimme gewöhnen kann. Also nicht zackig:",
                                                "translation": "»Guten Morgen, Frau X., hier ist Hans Peter Schmid«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
