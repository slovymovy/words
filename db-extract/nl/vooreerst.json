                                                "sense_id": "c801e5ea-9915-3ea8-9264-1e8b80fc8113",
                                                "text": "He can't be staring at you. For a start, he's asleep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed3deaa1-6c84-4df6-a318-30e033318f6e",
