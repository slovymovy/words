                    {
                        "sense_id": "a496ebd8-6690-3176-8b51-f70ae7e67992",
                        "entry_id": "5c48babd-6c67-345a-b7ec-9d60c72071b9",
                        "glosses": [
                            "metoda samoleczenia, której celem jest oczyszczenie organizmu z toksyn i pozbycie się nadmiaru tkanki tłuszczowej, polegająca na nieprzyjmowaniu pokarmów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d4ca9d-a185-4d51-aad2-92434a7d1d3a",
                                "sense_id": "a496ebd8-6690-3176-8b51-f70ae7e67992",
                                "text": "Po dwóch dniach głodówki, szuflowałem grochówkę, aż się uszy trzęsły."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c2a89639-c0c2-366a-bbf3-420d504022e1",
                        "entry_id": "5c48babd-6c67-345a-b7ec-9d60c72071b9",
                        "glosses": [
                            "strajk głodowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d01acd1b-bea8-493e-8997-3309f3686ecc",
                                "sense_id": "c2a89639-c0c2-366a-bbf3-420d504022e1",
                                "text": "Sufrażystki ogłaszały strajki, głodówki, podpalały urzędy publiczne"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
