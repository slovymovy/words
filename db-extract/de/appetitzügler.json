                "senses": [
                    {
                        "sense_id": "37dc597c-02ab-324c-9b86-5872d6842831",
                        "entry_id": "834d926d-82f2-33e3-a9b7-d40e1bacd809",
                        "glosses": [
                            "ein Medikament, das den Appetit hemmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42298ae9-3034-4d2d-a7de-02affd34d3e4",
                                "sense_id": "37dc597c-02ab-324c-9b86-5872d6842831",
                                "text": "„Um trotzdem seine Linie zu halten, nahm er bereits in jungen Jahren Appetitzügler.“"
                            },
                            {
                                "example_id": "86a4d078-d34f-40ed-99c6-5fe64b43bac9",
                                "sense_id": "37dc597c-02ab-324c-9b86-5872d6842831",
                                "text": "…; 3.300 Euro für 14 Tage als Proband für Tests mit einem Appetitzügler: Für die Teilnahme an medizinischen Studien winkt oft ein phänomenales Entgelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e98b1906-95d9-4a2c-b9fc-54300d84a20e",
                        "source_entry_id": "834d926d-82f2-33e3-a9b7-d40e1bacd809",
