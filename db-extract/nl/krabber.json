                    {
                        "translation_id": "959a0372-a5c6-4dcd-aa14-3c79221c8e04",
                        "source_entry_id": "eecd93a4-2cd2-31b8-b5dc-a58b064e390c",
                        "source_sense_id": "a3106397-95a8-3fc8-a105-37a1d9a30b43",
                        "source_sense_description": "(gereedschap) voorwerp om mee te krabben, onmisbaar voor schilders die oude verflagen willen verwijderen of mensen die jeuk op hun rug hebben.",
                        "target_lang_word": "Kratzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kratzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                        "entry_id": "1e9d75d9-7d91-367c-b1d5-dd0ddda7e4cb",
                                        "glosses": [
                                            "kleine bis mittelgroße Wunde oder Beschädigung, die durch bewegte Berührung mit einem spitzen Gegenstand hervorgerufen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85cef711-15a3-4a05-9c9c-b66a92efba9f",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "Nicht weinen, es ist doch nur ein Kratzer."
                                            },
                                            {
                                                "example_id": "140537bc-2c1a-4538-8a85-b182057ea7bd",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "Jemand hat einen Kratzer an meinen neuen Sportwagen gemacht!"
                                            },
                                            {
                                                "example_id": "7a03e0de-9522-4670-b57f-1ed49930d950",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "„Die kleinen Kratzer zeigt er dann den Ausländern, die meist kein Wort der Landessprache Amharisch beherrschen.“"
                                            },
                                            {
                                                "example_id": "266d872f-67f3-4b5a-96f4-91338db18748",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "„Mein kleiner Bruder dagegen war unversehrt, unglaublich, meine Mutter hatte ihn mit ihrem eigenen Körper so gut geschützt, dass er nicht einen Kratzer abbekommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dc53e7b-c934-3add-ad2d-1ac10ad3f9ed",
                                        "entry_id": "1e9d75d9-7d91-367c-b1d5-dd0ddda7e4cb",
                                        "glosses": [
                                            "Werkzeug zum Schaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8fa86a4-cfde-4297-9d4b-3e6fa9714436",
                                                "sense_id": "5dc53e7b-c934-3add-ad2d-1ac10ad3f9ed",
                                                "text": "Er benutzt einen Kratzer um den Vogelkot von der Treppe zu kratzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a7e6168b-5741-3309-94ff-dbfdd982704f",
                                        "entry_id": "1e9d75d9-7d91-367c-b1d5-dd0ddda7e4cb",
                                        "glosses": [
                                            "im Darm vorkommende parasitischer Wurm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b61c91-ca7d-4786-8dde-c0c78d453f30",
                                                "sense_id": "a7e6168b-5741-3309-94ff-dbfdd982704f",
                                                "text": "„Weltweit parasitieren die getrenntgeschlechtlichen Kratzer im Darm von über 300 Fischarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
