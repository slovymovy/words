                ],
                "senses": [
                    {
                        "sense_id": "e78f1cb4-2304-3d3b-bb00-0c7b61f1d142",
                        "entry_id": "2a00c37c-0b60-3682-a895-971f28d3458c",
                        "glosses": [
                            "Verhalten oder Benehmen, das so gekünstelt oder übertrieben ist, dass es als lächerlich oder unangenehm empfunden wird"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "cc18ad46-e934-409b-8259-f8b1d0602dfb",
                                "sense_id": "e78f1cb4-2304-3d3b-bb00-0c7b61f1d142",
                                "text": "„Er findet, Byrons ›himmelschreiende menschliche Schwächen, seine Vulgarität, seine Affektiertheit‹ seien mit den ›Fehlern der Gewöhnlichkeit, der künstlerischen Schwächen in seinem dichterischen Werk‹ innerlich verwandt.“"
                            },
                            {
                                "example_id": "0e19acb8-3e74-43e5-b015-4ca26a0fe9f1",
                                "sense_id": "e78f1cb4-2304-3d3b-bb00-0c7b61f1d142",
                                "text": "„Wenn Schiller in seiner Kritik Empfindsamkeit und Affektiertheit kontrastiert, dann bedient er sich bürgerlicher Kampfbegriffe. Der Vorwurf der Affektiertheit richtet sich zum einen gegen den Habitus der Höflinge, zum anderen aber auch gegen die Bürger aus den eigenen Reihen, die sozial erwünschte Gefühle nur vortäuschen, statt sie zu empfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5846db21-b76e-3236-a4f0-5e39e4bbd441",
                        "entry_id": "2a00c37c-0b60-3682-a895-971f28d3458c",
                        "glosses": [
                            "Handlung, die affektiert ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb08171-8f63-4ac6-9c13-5405fc99b6f7",
                        "source_entry_id": "2a00c37c-0b60-3682-a895-971f28d3458c",
                        "source_sense_id": "e78f1cb4-2304-3d3b-bb00-0c7b61f1d142",
                        "source_sense_description": "Verhalten oder Benehmen, das als lächerlich oder unangenehm empfunden wird",
                        "target_lang_word": "affectation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affectation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69ea6a0d-447c-39c8-8b17-8b6728dd1378",
                                        "entry_id": "b7931b8d-4e43-3934-96a0-da2e1a2131e5",
                                        "glosses": [
                                            "An attempt to assume or exhibit what is not natural or real; false display; artificial show."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4f4156-3393-474b-a90d-78107f773696",
                                                "sense_id": "69ea6a0d-447c-39c8-8b17-8b6728dd1378",
                                                "text": "This poem is strongly tinctured with those pedantic affectations concerning the passion of love ..."
                                            },
                                            {
                                                "example_id": "78902a0f-bae1-44d7-95de-210fb4790ba0",
                                                "sense_id": "69ea6a0d-447c-39c8-8b17-8b6728dd1378",
                                                "text": "[T]hey were not the spoiled children of affectation and refinement, but a bold, vigorous, independent race of thinkers, with prodigious strength and energy, with none but natural grace, and heartfelt unobtrusive delicacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb08ea4-47be-3e1e-8113-a37f50d0f483",
                                        "entry_id": "b7931b8d-4e43-3934-96a0-da2e1a2131e5",
                                        "glosses": [
                                            "An unusual mannerism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                        "entry_id": "b7931b8d-4e43-3934-96a0-da2e1a2131e5",
                                        "glosses": [
                                            "An ostentatious fondness for something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b67f58e-abb3-4115-a918-48c5319dc089",
                                                "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                                "text": "The grace diuineſt Mercvrie hath done me, / In this vouchſafde diſcouerie of himſelfe, / Binds my obſeruance in the vtmoſt terme / Of ſatisfaction, to his godly will: / Though I profeſſe (without the affectation / Of an enforc’d, and form’d auſteritie) / I could be willing to enioy no place / With ſo vnequall natures."
                                            },
                                            {
                                                "example_id": "0250ba52-5340-467a-a55a-63e8d277cf39",
                                                "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                                "text": "Her upper part of decent diſcipline / Shew’d affecation of an ancient line: / And fathers, councils, church and churches head, / Were on her reverend Phylacteries read."
                                            },
                                            {
                                                "example_id": "db3e4624-b956-4992-90ce-320db17d55bf",
                                                "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                                "text": "While for some, women’s lack of knowledge is a matter for censure, throughout the century both male and female writers emphasize that affectation of knowledge, for example when it is not properly assimilated (Du Bosc 1633: 78), and above all pedantry from women, are far more unacceptable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37e3ae3d-7c0c-43f9-a469-4c905306e1c7",
                        "source_entry_id": "2a00c37c-0b60-3682-a895-971f28d3458c",
