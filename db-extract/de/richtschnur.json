                ],
                "senses": [
                    {
                        "sense_id": "fabae5ae-406f-36e8-b975-384c33d97dd8",
                        "entry_id": "c3d17035-5017-3644-98b0-62fae4b77432",
                        "glosses": [
                            "um gerade Linien vorzugeben, straff gespannte Schnur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95190d8-bad0-48b9-8a90-38dbc467ce59",
                                "sense_id": "fabae5ae-406f-36e8-b975-384c33d97dd8",
                                "text": "Der Gärtner und der Maurer kommen ohne Richtschnur nicht aus, weil sie in ihrer Arbeit auf gerade Linien angewiesen sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "704e72d5-c5a9-329b-a9a3-f5dc1b4def9e",
                        "entry_id": "c3d17035-5017-3644-98b0-62fae4b77432",
                        "glosses": [
                            "etwas Abstraktes, nach dem man seine Bewertungen oder sein Verhalten richten kann"
                        ],
                        "tags": [
                            "übertragen, Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "3c0d3f2e-6454-4491-be7a-58babbcf92d4",
                                "sense_id": "704e72d5-c5a9-329b-a9a3-f5dc1b4def9e",
                                "text": "Als Richtschnur dient hier das durchschnittliche Jahreseinkommen eines ausgebildeten Handwerkers."
                            },
                            {
                                "example_id": "f5494ac0-27b7-4f94-95d6-7b0e4dcba625",
                                "sense_id": "704e72d5-c5a9-329b-a9a3-f5dc1b4def9e",
                                "text": "Die Auswirkungen auf eine mögliche Wiederwahl sollten nicht zur Richtschnur unseres Handelns werden."
                            },
                            {
                                "example_id": "56b99b44-01b0-4a59-97e5-f355ba564058",
                                "sense_id": "704e72d5-c5a9-329b-a9a3-f5dc1b4def9e",
                                "text": "„Vor Hugos Tod war mir diese Frage Richtschnur gewesen.“"
                            },
                            {
                                "example_id": "4e8851b1-94c7-48d9-8bcb-7cfe8b04ff75",
                                "sense_id": "704e72d5-c5a9-329b-a9a3-f5dc1b4def9e",
                                "text": "„In dieser Situation konnte ihnen das Hochdeutsche, das sie als die dem Jiddischen ähnlichste Hochsprache empfanden, ersatzweise als Richtschnur für einen literarischen Sprachgebrauch dienen.“"
                            },
                            {
                                "example_id": "08c79a69-77ce-48bd-9d0b-149d95cb8a55",
                                "sense_id": "704e72d5-c5a9-329b-a9a3-f5dc1b4def9e",
                                "text": "„Niemand sollte je sein Leben anderen anvertrauen – das ist wohl eine der düstersten Aussagen, die ich kenne, und auch eine der traurigsten, und trotzdem ist sie mein Mantra und meine Richtschnur gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
