                                "target_senses": [
                                    {
                                        "sense_id": "4d448994-d2c5-3ecc-8511-db22eef5d2d8",
                                        "entry_id": "8ba39332-f75c-32fa-bf73-b7ec21788e62",
                                        "glosses": [
                                            "An adult man in Ancient Greece who courted or was in a pederastic relationship with an adolescent boy."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d164e0a-9cdf-44be-a1ab-abb9279c972c",
                                                "sense_id": "4d448994-d2c5-3ecc-8511-db22eef5d2d8",
                                                "text": "In regard to the boys (erōmenos) involved in ancient Greek pederasty, Dover (1978:52) asked: “What does the eromenos get out of submission to his erastēs?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
