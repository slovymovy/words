                        "entry_id": "5c08e4a0-db8f-30ce-929a-6cccac8b6a4e",
                        "glosses": [
                            "Extrêmement courant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb560b0-42d1-4f10-a2c6-db4d4df15c83",
                                "sense_id": "e72fbd34-e204-3e70-a675-ffe0f913ef57",
                                "text": "La charpente du décryptage gestuel se résume à trois refrains gestuels archicourants : le croisement des bras, le croisement des doigts et l’oreille téléphonique privilégiée."
                            },
                            {
                                "example_id": "1df17071-a9b1-4126-bf46-4dac6e0b6cb0",
                                "sense_id": "e72fbd34-e204-3e70-a675-ffe0f913ef57",
                                "text": "Sous une appellation neuve, qui fait fortune, et qui aurait pu le conduire à penser pour de bon les évolutions en cours, l’accusation de Sainte-Beuve ne fait que recueillir des observations archicourantes."
                            },
                            {
                                "example_id": "c6153c77-1af5-4c2f-a98f-b5aaae12feb6",
                                "sense_id": "e72fbd34-e204-3e70-a675-ffe0f913ef57",
                                "text": "Se photographier soi-même – et en publier le résultat sur les réseaux sociaux – est devenu une pratique archicourante."
                            }
                        ]
                    }
