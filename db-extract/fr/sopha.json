                ],
                "senses": [
                    {
                        "sense_id": "a82e9954-9948-3959-9e2b-4492bc12790f",
                        "entry_id": "353fcddd-6b42-3d83-9562-43adad451861",
                        "glosses": [
                            "Orthographe ancienne de sofa."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "42d2afd2-7f97-4a6a-9f2d-e159de0d29a7",
                                "sense_id": "a82e9954-9948-3959-9e2b-4492bc12790f",
                                "text": "Sa tête seule, blanche, immobile et renversée sur le coussin du sopha, était visible."
                            },
                            {
                                "example_id": "dcbba963-916c-45f5-9794-186753d30adc",
                                "sense_id": "a82e9954-9948-3959-9e2b-4492bc12790f",
                                "text": "La pauvre Jeanne fondit en larmes, et, tout entière à sa douleur, elle ne s’aperçut pas que Léon était assis tout près d’elle sur le sopha, qu’il l’entourait de ses bras, prêt à la serrer sur sa poitrine, et que son souffle brûlant effleurait dans l’obscurité son cou d’albâtre penché sur son sein."
                            },
                            {
                                "example_id": "11c2256e-b180-4404-b5e0-8c6261558316",
                                "sense_id": "a82e9954-9948-3959-9e2b-4492bc12790f",
                                "text": "Il parlait avec vivacité et en se levant souvent du sopha sur lequel il était couché."
                            },
                            {
                                "example_id": "f5849806-17f9-460e-a84d-f7c51514ff2b",
                                "sense_id": "a82e9954-9948-3959-9e2b-4492bc12790f",
                                "text": "La Dalluys entretenoit un pauvre Morainville, vieux mousquetaire ; elle lui payoit le fiacre pour arriver chez elle, de peur que ses souliers ne crottassent le sopha, mais il s'en retournoit à pied."
                            },
                            {
                                "example_id": "90af3993-062c-4e17-a8f8-a3ab58f0fc50",
                                "sense_id": "a82e9954-9948-3959-9e2b-4492bc12790f",
                                "text": "Bien qu’elle ne fît que passer de sa mauvaise ottomane sur un antique sopha que Corentin avait su lui trouver, la fantasque Parisienne prit possession de cette maison comme d’une chose qui lui aurait appartenu."
                            }
                        ]
                    }
                ],
