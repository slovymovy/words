                "senses": [
                    {
                        "sense_id": "9afbed67-ac7b-3e77-87f0-8081d5fa05c3",
                        "entry_id": "31b6ef3a-794b-36eb-a692-a7a319348d78",
                        "glosses": [
                            "Bénir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8672c6b8-a79f-4dd5-8119-23efa5bfadf0",
                                "sense_id": "9afbed67-ac7b-3e77-87f0-8081d5fa05c3",
                                "text": "Ensuite on força les protestants à faire baptiser ou rebaptiser leurs enfants à l'église romaine et d'y faire bénir ou rebénir leurs mariages."
                            },
                            {
                                "example_id": "5ab1e9b8-2aad-47b0-981f-e22481ca050f",
                                "sense_id": "9afbed67-ac7b-3e77-87f0-8081d5fa05c3",
                                "text": "Quand les femmes avaient eu des enfants, elles allaient se faire «rebénir» aussitôt qu’elles pouvaient sortir."
                            }
                        ]
                    }
