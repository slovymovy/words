                                                "sense_id": "58f3887f-8216-3bdf-9122-c13a2bf54168",
                                                "text": "„Um die Raupen zu vertilgen, schlugen sie die Bäume mit wuchtigen Stockhieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
