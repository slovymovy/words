                                    },
                                    {
                                        "sense_id": "196b3534-bc5f-353d-9a48-4fb3717774b5",
                                        "entry_id": "e1ebb98f-39f1-3fba-b7f7-2ba5116ce680",
                                        "glosses": [
                                            "A challenge from one to another."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ad293c-001b-462c-8038-099eb94759d9",
                                                "sense_id": "196b3534-bc5f-353d-9a48-4fb3717774b5",
                                                "text": "to throw down the glove, i.e. to offer a challenge; to take up the glove, to accept it"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b59afba-8e95-3a49-a4cc-7cce2aaf92af",
