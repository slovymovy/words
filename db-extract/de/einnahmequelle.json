                ],
                "senses": [
                    {
                        "sense_id": "4c0b4ca8-d5a5-366e-8a15-670175f13c21",
                        "entry_id": "404c6b3c-3146-30e9-8df9-79a073f60793",
                        "glosses": [
                            "Möglichkeit, Einnahmen zu erzielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbcabae-a22e-4163-b5f8-7fd71e2f61c7",
                                "sense_id": "4c0b4ca8-d5a5-366e-8a15-670175f13c21",
                                "text": "Viele Menschen haben außer ihrem Arbeitslohn noch weitere Einnahmequellen wie zum Beispiel Erträge aus Kapitalanlagen oder aus Vermietung."
                            },
                            {
                                "example_id": "9ec8c57d-7556-41a4-9740-25218223e007",
                                "sense_id": "4c0b4ca8-d5a5-366e-8a15-670175f13c21",
                                "text": "„Was letztendlich dazu führte, dass sich die Bauern der Schafzucht zuwandten, die zu ihrer wichtigsten Einnahmequelle wurde.“"
                            },
                            {
                                "example_id": "284d5368-71ac-4f14-8ebe-ca12bfc42fcc",
                                "sense_id": "4c0b4ca8-d5a5-366e-8a15-670175f13c21",
                                "text": "„Pücklers Geschäftsgebaren war ein ständiges Jonglieren mit Soll und Haben, ein ständiger Kampf, die Flut wachsender Ausgaben aus neuen Einnahmequellen zu speisen.“"
                            },
                            {
                                "example_id": "9c59f0ec-a9af-4e9d-9151-8851413ba40e",
                                "sense_id": "4c0b4ca8-d5a5-366e-8a15-670175f13c21",
                                "text": "„Ein bevorzugtes Ziel war damals Franco-Spanien, das im Tourismus eine Einnahmequelle entdeckte.“"
                            },
                            {
                                "example_id": "6c71cf51-dbf7-4e26-a562-1af54128cd45",
                                "sense_id": "4c0b4ca8-d5a5-366e-8a15-670175f13c21",
                                "text": "„Für das Volk der Makonde bedeutet seine künstlerische Begabung eine wichtige Einnahmequelle.“"
                            },
                            {
                                "example_id": "7cd6527c-0947-4537-8469-46512e5de2a4",
                                "sense_id": "4c0b4ca8-d5a5-366e-8a15-670175f13c21",
                                "text": "„Durch den Weiterverkauf der Ausrüstung hätten sie sich eine Einnahmequelle verschaffen wollen, hatte die Staatsanwaltschaft erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
