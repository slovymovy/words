                "translations": [
                    {
                        "translation_id": "5eee2f45-75a0-442a-a1cf-6279aff870d4",
                        "source_entry_id": "b4a43f04-2109-328b-9ab7-91bfe802426e",
                        "source_sense_id": "706ccdf5-87d1-38ed-a16d-bcde2425f2e4",
                        "target_lang_word": "promeneuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promeneuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "441d5130-d235-3975-86c8-77f5aa4bf587",
                                        "entry_id": "b311a671-099d-3cad-ac13-4d2d4f69573a",
                                        "glosses": [
                                            "Personne qui se promène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8e1865-7aad-469c-a314-f891ea36f99e",
                                                "sense_id": "441d5130-d235-3975-86c8-77f5aa4bf587",
                                                "text": "Quelques mots échappés à la mauvaise humeur de ces belles promeneuses désappointées et saisis au vol par la jolie inconnue, l’avaient singulièrement inquiétée."
                                            },
                                            {
                                                "example_id": "c9f21400-eded-468d-9435-8757c308ec9b",
                                                "sense_id": "441d5130-d235-3975-86c8-77f5aa4bf587",
                                                "text": "Ah ! je les écraserai, toutes ces belles promeneuses du Mail qui toisent dédaigneusement mes robes de laine !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a57587-eef7-3183-a29f-934426907d89",
                                        "entry_id": "b311a671-099d-3cad-ac13-4d2d4f69573a",
                                        "glosses": [
                                            "Personne qui aime à se promener."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da37dea5-af3e-35b9-b126-df4a737a0187",
                                        "entry_id": "b311a671-099d-3cad-ac13-4d2d4f69573a",
                                        "glosses": [
                                            "Petit véhicule qui sert à soutenir un enfant qui apprend à marcher, et reçoit l’impulsion des mouvements mêmes que fait l’enfant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "661ea7bf-d7f7-3095-9db0-6d5e37870e94",
                                        "entry_id": "b311a671-099d-3cad-ac13-4d2d4f69573a",
                                        "glosses": [
                                            "Personne qui promène une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4b2968-b5fa-4d98-8adb-5afe306250ac",
                                                "sense_id": "661ea7bf-d7f7-3095-9db0-6d5e37870e94",
                                                "text": "Elle est la promeneuse de cet enfant, de ce vieillard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f0579ee-e477-4155-85b4-51875f6a9744",
                        "source_entry_id": "b4a43f04-2109-328b-9ab7-91bfe802426e",
                        "source_sense_id": "706ccdf5-87d1-38ed-a16d-bcde2425f2e4",
                        "target_lang_word": "baladeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baladeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "259c6b96-311f-30c7-8732-b34b97077b4a",
                                        "entry_id": "edacee45-20f2-3c28-864d-fb8694319067",
                                        "glosses": [
                                            "Petite voiture de marchand ambulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fefcf4e5-4a52-471c-ae08-4b972979e915",
                                                "sense_id": "259c6b96-311f-30c7-8732-b34b97077b4a",
                                                "text": "… deux poignées en arrière permettant de la pousser comme les baladeuses des marchands ambulants ;"
                                            },
                                            {
                                                "example_id": "57dd0577-eac3-43f9-94a6-7e9d3bb396c2",
                                                "sense_id": "259c6b96-311f-30c7-8732-b34b97077b4a",
                                                "text": "Des chats sont parfois installés dans les vitrines de certains magasins, parmi les légumes et autres produits. Les marchands ambulants laissent des chiens couchés dans leurs baladeuses, au milieu de fruits ou autres denrées de consommation. […] Ces pratiques doivent immédiatement disparaître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff57b245-7142-3a30-a8c1-5fb3c62f8077",
                                        "entry_id": "edacee45-20f2-3c28-864d-fb8694319067",
                                        "glosses": [
                                            "Celle qui aime à séduire en quantité."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23abe70a-5c68-45f9-a4d7-55d7adbbc117",
                                                "sense_id": "ff57b245-7142-3a30-a8c1-5fb3c62f8077",
                                                "text": "— Elle t’a trahi sans te trahir… C’est une baladeuse, voilà tout."
                                            },
                                            {
                                                "example_id": "819d7f0d-b255-499c-b3d9-64f7a4ae841a",
                                                "sense_id": "ff57b245-7142-3a30-a8c1-5fb3c62f8077",
                                                "text": "Baladeuse. Fille de mauvaise vie, — par allusion à la boutique roulante des marchandes des quatre saisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f100364-2386-351b-ac15-9485843b7b40",
                                        "entry_id": "edacee45-20f2-3c28-864d-fb8694319067",
                                        "glosses": [
                                            "Danseuse qui aime à séduire."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially",
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0827c7-7ac6-4a4b-bdf5-0f32c312af4f",
                                                "sense_id": "7f100364-2386-351b-ac15-9485843b7b40",
                                                "text": "L’été, naturellement, il y avait toujours un peu plus de travail, les jupons blancs et les robes de percale des baladeuses du boulevard extérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b3c089e-3c32-3c0d-b6f2-0b500b6fe3f1",
                                        "entry_id": "edacee45-20f2-3c28-864d-fb8694319067",
                                        "glosses": [
                                            "Remorque qui s’accroche à la voiture motrice d’un tramway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fb98f9e-a237-4576-8cb4-0296ee84d070",
                                                "sense_id": "4b3c089e-3c32-3c0d-b6f2-0b500b6fe3f1",
                                                "text": "Il était monté non pas dans la première voiture, mais dans la baladeuse, et, rencogné sur sa banquette, fumait sans discontinuer."
                                            },
                                            {
                                                "example_id": "30a3982f-612a-4ced-a284-960f4a80b43e",
                                                "sense_id": "4b3c089e-3c32-3c0d-b6f2-0b500b6fe3f1",
                                                "text": "L’été, à la motrice était attachée une voiture à découvert, la « baladeuse », dont les sièges étaient orientés dans le sens de la marche. De grands rideaux protégeaient du soleil et de la pluie. Lorsque le tramway prenait de la vitesse, les hommes devaient retenir leur canotier et les femmes leur chapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c118157-b2cd-33e1-aa1e-bbfa1e7600d2",
                                        "entry_id": "edacee45-20f2-3c28-864d-fb8694319067",
                                        "glosses": [
                                            "Lampe portative, habituellement alimentée par le secteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba811911-9557-4802-84b2-133a01220cea",
                                                "sense_id": "4c118157-b2cd-33e1-aa1e-bbfa1e7600d2",
                                                "text": "Dans son coffre bourré jusqu’à la gueule, on pouvait trouver en permanence de quoi équiper un chantier de fouilles improvisé : un groupe électrogène, des baladeuses, une échelle pliable, un échafaudage démontable, et tous les produits nécessaires pour une restauration."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baladeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb555df1-7893-33c2-8144-38209b5ce25d",
                                        "entry_id": "33866f33-257e-3dcb-87f9-15227a4405d3",
                                        "glosses": [
                                            "Féminin singulier de baladeur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9c07dc-1e0d-48ab-8f78-f267584c7d2f",
                                                "sense_id": "eb555df1-7893-33c2-8144-38209b5ce25d",
                                                "text": "Quand les fils eurent grandi, Cadusseau leur acheta une voiture baladeuse à bras qu’ils chargeaient le matin de fruits et de légumes et ils s’en allaient, promenant leur marchandise autour de la ville, avant de venir, à un sou près, le soir, rendre leurs comptes dans la chambre somptueuse, où ne les attendaient bien souvent pour toute récompense qu’une hargne et deux soufflets."
                                            },
                                            {
                                                "example_id": "08890ceb-2378-423e-87d3-5fda37a850ec",
                                                "sense_id": "eb555df1-7893-33c2-8144-38209b5ce25d",
                                                "text": "Avoir la main baladeuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
