                "senses": [
                    {
                        "sense_id": "42982e85-6afa-3993-93b3-60a39ca341cd",
                        "entry_id": "88727074-4de9-3e7e-bb55-d561e69411a1",
                        "glosses": [
                            "Pollution particulièrement forte (par rapport à un autre lieu ou un autre temps, par exemple)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "176a56cf-838f-4045-aefa-0d1adc92924d",
                                "sense_id": "42982e85-6afa-3993-93b3-60a39ca341cd",
                                "text": "Aucun média ne s’enhardissait à parler de la sur-pollution des mers et du ciel par ces véritables villes flottantes qu’étaient les immenses bateaux de croisière, les porte-containers, les navires cargos, et par les avions de passagers ou les avions-cargos ou militaires, sans parler des yachts super-pollueurs de plus de cinquante mètres de long…"
                            },
                            {
                                "example_id": "18119351-facd-40e7-becb-eb299409f070",
                                "sense_id": "42982e85-6afa-3993-93b3-60a39ca341cd",
                                "text": "Nous rappelons que la pollution a des effets spatiaux très différenciés, et qu’une répartition des activités industrielles sur l’ensemble du territoire serait à même de réduire un certain nombre de « sur-pollutions » liées à la trop forte concentration des activités, notamment dans certaines zones."
                            },
                            {
                                "example_id": "d80c850c-2114-4085-b536-9e4d2cc77331",
                                "sense_id": "42982e85-6afa-3993-93b3-60a39ca341cd",
                                "text": "En effet, on peut lui imputer pour une grande partie la sur-pollution des eaux souterraines, qui échappent aux logiques générales de gestion des eaux et dont la responsabilité est de ce fait impossible à établir."
                            }
                        ]
                    }
