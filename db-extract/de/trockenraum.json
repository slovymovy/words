                        "source_entry_id": "4f514421-0cf7-3aa7-8a0b-82e7a3cc5752",
                        "source_sense_id": "7694744e-e835-3fac-aace-aae575e0adab",
                        "source_sense_description": "vorgesehener Raum, in dem Dinge oder Sachen zum Trocknen verweilen",
                        "target_lang_word": "séchoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séchoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd905db6-61cc-3512-9b7e-16643c5d2df4",
                                        "entry_id": "0b8a6976-0de5-32a4-9ab1-8200fd176d7e",
                                        "glosses": [
                                            "Lieu où l’on étend, où l’on suspend les toiles, les cuirs, les papiers, etc., pour les faire sécher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed730fa3-f30c-4961-b171-6c05352e0f73",
                                                "sense_id": "bd905db6-61cc-3512-9b7e-16643c5d2df4",
                                                "text": "Et ces costumes, ils se trouvaient étendus dans les séchoirs, numérotés par habilleuses, car on leur donnait aussi des serviteurs pour s'en vêtir !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                        "entry_id": "0b8a6976-0de5-32a4-9ab1-8200fd176d7e",
                                        "glosses": [
                                            "Dispositif qui sert à faire sécher différentes préparations, différents objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f65af3ca-bf07-4880-a0f6-61c1fbdc06b8",
                                                "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                                "text": "Comme les pluies nuisent beaucoup à la dessiccation en plein air, on vient d'inaugurer un séchoir artificiel : c'est un four à chaleur modérée, où l'on dispose les poissons sur des lattes; au bout de trois jours ils sont séchés à point."
                                            },
                                            {
                                                "example_id": "7204c869-5cc0-4987-b038-11e342d35942",
                                                "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                                "text": "On procède ensuite au séchage par les moyens ordinaires: […], ou séchoirs à tabliers mobiles avec soufflerie d'air chaud, ou enfin séchoirs à l'air libre."
                                            },
                                            {
                                                "example_id": "1313d263-3e2e-4562-b8bd-8366fcbb95a2",
                                                "sense_id": "8a7dfa9e-0475-381d-8d6c-7c6703b8e0ff",
                                                "text": "Pour faire plaisir au photographe, il jeta un coup d’œil sur les épreuves étalées sur des séchoirs, encore mouillées et luisantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35a7085b-834b-35d5-8e8c-49ca869a5620",
                                        "entry_id": "0b8a6976-0de5-32a4-9ab1-8200fd176d7e",
                                        "glosses": [
                                            "Appareil électrique servant à sécher les cheveux en soufflant de l’air chaud."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Maghreb"
                                        ],
                                        "examples": []
                                    },
