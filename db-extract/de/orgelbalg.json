                "senses": [
                    {
                        "sense_id": "faf07e27-ee6c-3df5-85b3-30cabb71b8b9",
                        "entry_id": "619089bc-c4c4-37b8-a831-450e6283efdd",
                        "glosses": [
                            "der Blasebalg einer Orgel"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "e6338cd1-fdec-4d27-b9b4-1f56d496f577",
                                "sense_id": "faf07e27-ee6c-3df5-85b3-30cabb71b8b9",
                                "text": "„Ein Oberprimaner spielt die Orgel, ein Quartaner versorgt den Orgelbalg mit Luft, der Schulchor singt, und der Direktor hält eine Ansprache.“"
                            },
                            {
                                "example_id": "48e42101-b6c4-4962-9402-78c28b8542df",
                                "sense_id": "faf07e27-ee6c-3df5-85b3-30cabb71b8b9",
                                "text": "„Damals, so sagt der Vater, habe die kleine Yuko Mine gerne den Orgelbalg getreten und dafür gesorgt, dass die Orgel Töne machen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
