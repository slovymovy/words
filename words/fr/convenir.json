                    "sense_definition": "Être convenable, séant ou opportun dans une situation donnée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adequation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de commencer le travail, il <w>convient</w> de vérifier les instructions.",
                            "target_lang_translations": {
                                "en": "Before starting the work, it <w>behooves</w> us to check the instructions.",
                                "ru": "Прежде чем приступить к работе, <w>следует</w> проверить инструкции.",
                                "nl": "Voordat we aan het werk beginnen, <w>past</w> het om de instructies te controleren.",
                                "de": "Bevor man mit der Arbeit beginnt, <w>gehört</w> es <w>sich</w>, die Anleitung zu prüfen.",
                                "pl": "Przed rozpoczęciem pracy <w>należy</w> sprawdzić instrukcje.",
                                "it": "Prima di iniziare il lavoro, <w>conviene</w> verificare le istruzioni.",
