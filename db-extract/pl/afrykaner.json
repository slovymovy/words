                                "target_senses": [
                                    {
                                        "sense_id": "c88cac17-925d-3594-92ee-69193e9151c8",
                                        "entry_id": "b4ca4297-1b60-3d6e-b67a-897381c6c949",
                                        "glosses": [
                                            "Persona descendiente de los colonos holandeses que poblaron Sudáfrica."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
