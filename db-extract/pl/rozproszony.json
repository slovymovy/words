                                                "sense_id": "2d665bf8-7e64-3d99-a273-4acae2cc8bf9",
                                                "text": "The small window diffuses light throughout the room."
                                            },
                                            {
                                                "example_id": "a446f89b-a8da-4bae-8fe9-69e31d29240a",
                                                "sense_id": "2d665bf8-7e64-3d99-a273-4acae2cc8bf9",
                                                "text": "Ideas are easily diffused with the help of technology."
                                            },
                                            {
                                                "example_id": "8e58e634-19d7-4f7c-823a-ff12ae56b882",
                                                "sense_id": "2d665bf8-7e64-3d99-a273-4acae2cc8bf9",
                                                "text": "We do not know by whom the insufficiency of the year of 365 days was first discovered; we find this knowledge diffused among all civilized nations, and various artifices used in making the correction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6cf4db-34e5-3948-8ad5-b0e0f929a489",
                                        "entry_id": "a0bc176a-74e7-31ac-925e-71dd04937b15",
                                        "glosses": [
                                            "To be spread over or through as in air, water, or other matter, especially by fluid motion or passive means."
