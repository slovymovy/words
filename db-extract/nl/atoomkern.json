                "forms": [
                    {
                        "form_id": "76fc6f7a-6586-485a-957b-bb4af7e1b9dc",
                        "entry_id": "f91bf017-8327-3766-bbfc-97a0ecdc8353",
                        "tags": [
                            "plural"
                        ],
                        "form": "atoomkernen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59afaace-48bd-3f3f-a274-adda0331aba2",
                        "entry_id": "f91bf017-8327-3766-bbfc-97a0ecdc8353",
                        "glosses": [
                            "onderdeel van het atoom, dat bestaat uit twee soorten subatomaire deeltjes of nucleonen: protonen en neutronen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223ee320-b51b-4a9b-8fe5-d713adfa3d23",
                                "sense_id": "59afaace-48bd-3f3f-a274-adda0331aba2",
                                "text": "Er is weer eens een antimaterierecord gebroken. In de botsing van zeer energierijke, geladen looddeeltjes hebben onderzoekers bewijs gevonden voor de zwaarste antimaterieversie van een atoomkern die ooit is waargenomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b67505a-6629-467c-b6cc-00b3314d789f",
                        "source_entry_id": "f91bf017-8327-3766-bbfc-97a0ecdc8353",
                        "source_sense_id": "59afaace-48bd-3f3f-a274-adda0331aba2",
                        "target_lang_word": "Atomkern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atomkern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                        "entry_id": "84955cba-6831-3613-89ec-e01375280e97",
                                        "glosses": [
                                            "aus Protonen und Neutronen bestehender Kern des Atoms"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4ab5df2-b890-45ed-a520-0a080c840b5f",
                                                "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                                "text": "Bei der Kernfusion verschmelzen Atomkerne miteinander."
                                            },
                                            {
                                                "example_id": "bed99529-46e8-459d-94f3-b99199c031ba",
                                                "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                                "text": "„Der Mensch gehört einer Größenordnung an, die etwas in der Mitte liegt zwischen den Bereichen des Allerkleinsten (10⁻¹³ cm = Durchmesser eines Atomkerns des Wasserstoffs) und des Allergrößten (Entfernung der fernsten für uns erkennbaren Weltsysteme etwa 1 Milliarde Lichtjahre = 10²⁷ cm). Der Biologe Adolf Portmann hat diesen Bereich der mittleren Größenordnungen, in dem wir leben, darum den »Mediokosmos« genannt. …“"
                                            },
                                            {
                                                "example_id": "a319e504-c559-491b-a092-28b1ca61f535",
                                                "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                                "text": "„Nach dem Kern-Hülle-Modell von RUTHERFORD enthalten die winzigen Atomkerne die positive Ladung des Atoms und über 99,9 % der Atommasse.“"
                                            },
                                            {
                                                "example_id": "097cc027-31bf-4d52-83af-6dabf4966999",
                                                "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                                "text": "„Man wusste lange Zeit“ […] „nicht, dass Atomkerne sich aus zwei verschiedenen Arten von Teilchen zusammensetzen, den Protonen und den Neutronen.“"
                                            },
                                            {
                                                "example_id": "e6b8b012-2eb2-434b-8b5e-9783b1a83f13",
                                                "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                                "text": "„Ordnet man alle Elemente nach steigender Protonenzahl, so nimmt die Zahl der Protonen in den Atomkernen jeweils um eins zu.“"
                                            },
                                            {
                                                "example_id": "8befba07-01eb-4c9d-b29d-062ac6eb214f",
                                                "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                                "text": "„Da die Elektronen so gut wie keine Masse tragen, müssen im Atomkern neben Protonen noch weitere Elementarteilchen enthalten sein“ […]."
                                            },
                                            {
                                                "example_id": "f1ffe51c-53ec-48e9-8911-8a8b3a726ec2",
                                                "sense_id": "03963dca-3b54-38c7-8697-70b00f236812",
                                                "text": "„Im Wasserstoff-Molekül werden die beiden Elektronen der H-H-Bindung gleich stark von den positiv geladenen Atomkernen angezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86475d38-57c5-4d58-8a34-9a5a432037e3",
                        "source_entry_id": "f91bf017-8327-3766-bbfc-97a0ecdc8353",
