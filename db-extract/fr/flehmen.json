                                    {
                                        "sense_id": "2473051c-b277-3b77-8da8-dba95b8bede7",
                                        "entry_id": "de8e2f4a-497a-3b71-a9df-3c24c77aae1b",
                                        "glosses": [
                                            "Flaring of the lip in mammals, associated with intensive smelling; flehming."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91625555-4262-4945-bc97-7c60a9286d52",
                                                "sense_id": "2473051c-b277-3b77-8da8-dba95b8bede7",
                                                "text": "During the preliminary phase of courtship between captive animals, Matthew Gaughwin observed flehmen on a number of occasions when the male sniffed intensely at areas of ground where the female had previously urinated and once when the male had sniffed the female's cloacal region."
                                            },
                                            {
                                                "example_id": "8490e5c0-63c0-4a23-bf45-dea338b51b44",
                                                "sense_id": "2473051c-b277-3b77-8da8-dba95b8bede7",
                                                "text": "Ladewig and Hart showed that when a male goat displayed flehmen after investigating female urine containing a tracer material, the urine was found throughout the vomeronasal organ."
                                            },
                                            {
                                                "example_id": "c410cdd4-57db-4617-9c97-8e2dd6092294",
                                                "sense_id": "2473051c-b277-3b77-8da8-dba95b8bede7",
                                                "text": "Behaviors recorded included sniffing, flehmen, blowing, avoidance, and penile erections."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flehmen",
                                "target_lang_code": "en",
