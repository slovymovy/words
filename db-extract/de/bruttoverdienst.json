                "senses": [
                    {
                        "sense_id": "7b7329ca-0b2a-3d39-abe6-be41da8df734",
                        "entry_id": "504d950d-e054-3f18-b1a5-c8e02144561f",
                        "glosses": [
                            "Verdienst/Einkommen einschließlich aller Abgaben (Steuern, Sozialabgaben…)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f6755c8-2611-4193-a484-f6cf50d1db0b",
                                "sense_id": "7b7329ca-0b2a-3d39-abe6-be41da8df734",
                                "text": "Der Bruttoverdienst ist meistens wesentlich höher als der Betrag, der monatlich zur freien Verfügung steht."
                            },
                            {
                                "example_id": "e1742382-cda5-40f0-9060-3c0fc936b6d9",
                                "sense_id": "7b7329ca-0b2a-3d39-abe6-be41da8df734",
                                "text": "„Dieser Monatsverdienst werde errechnet, indem der Bruttoverdienst des Arbeitnehmers in den zuletzt abgerechneten drei Monaten durch drei geteilt werde.“"
                            },
                            {
                                "example_id": "24eb1e53-f490-4bb7-bfef-681dedab4410",
                                "sense_id": "7b7329ca-0b2a-3d39-abe6-be41da8df734",
                                "text": "„Erlaubt ist ein Bruttoverdienst von 4800 Euro pro Jahr oder 400 Euro im Monatsdurchschnitt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
