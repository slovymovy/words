                                    {
                                        "sense_id": "3340bc62-211d-3d30-a53e-023c24437c5c",
                                        "entry_id": "ae7f6700-17d5-3d80-a946-2d497e01fe17",
                                        "glosses": [
                                            "Angehöriger der Marine; niedrigster Dienstgrad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d0a5dc-ebc4-4b39-b4dd-c0ec839bc5d4",
                                                "sense_id": "3340bc62-211d-3d30-a53e-023c24437c5c",
                                                "text": "„Auf, Matrosen, die Anker gelichtet, // Segel gespannt, den Kompass gerichtet.“"
                                            },
                                            {
                                                "example_id": "609b41c3-d0a7-4c26-9ad9-f2fadaef191b",
                                                "sense_id": "3340bc62-211d-3d30-a53e-023c24437c5c",
                                                "text": "„Lastautos mit Matrosen rasen über die Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                        "entry_id": "ae7f6700-17d5-3d80-a946-2d497e01fe17",
                                        "glosses": [
                                            "Angehöriger einer zivilen Schiffsbesatzung; in der BRD als Ausbildungsberuf bis 1983"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03649c52-6d3d-460a-bd85-1a2e40e72f00",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "Die Matrosen trafen sich abends in der Bar am Hafen."
                                            },
                                            {
                                                "example_id": "a4e38137-3311-413e-b435-fbd5556d9e66",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Ein Matrose maß am Bug mit einem Handlot die Wassertiefe.“"
                                            },
                                            {
                                                "example_id": "ed1acacd-4a08-4801-81c1-8f540ee88b54",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Kurz nachdem sich die beiden Matrosen Lenz und Kremp in ihre Unterkunft im Vorschiff zurückgezogen hatten, klopfte es an der Außentür zum Achterruff.“"
                                            },
                                            {
                                                "example_id": "a0766cc7-686a-41c2-9bc7-aa8fe84bcb91",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Er stellte sicher - oder auch nicht -, dass der Schiffsarzt seine Pflicht tat und dass Matrosen und Offiziere die Gefangenen nicht misshandelten.“"
                                            },
                                            {
                                                "example_id": "0d825cde-f19e-4aa9-a967-f51aabbc7033",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Auf seinen zwei vorangegangenen Reisen hatte sich Cook derlei Widrigkeiten in der Regel mit Gleichmut gestellt und im Umgang mit Matrosen und Einheimischen eine strenge, aber gerechte Hand bewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
