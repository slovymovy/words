                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8ff5e85-78df-4b0f-96cc-0b9b0471b1cd",
                        "source_entry_id": "67bd7f35-6887-3cf6-95c2-5c412f9fb42e",
                        "source_sense_id": "4391bd6d-433e-35ed-b688-7ca68c4561ab",
                        "source_sense_description": "kleiner, unbedeutender Ort, Kaff, Provinznest, Nest",
                        "target_lang_word": "Kaff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc828d03-3165-3544-a1cd-7f8e5e9c5752",
                                        "entry_id": "15a6d943-5c2a-3727-916f-6416a2d8161d",
                                        "glosses": [
                                            "kleine, abgelegene, unbedeutende Ortschaft"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338da263-e71f-4ea2-9ee5-ae1129a4f1f6",
                                                "sense_id": "fc828d03-3165-3544-a1cd-7f8e5e9c5752",
                                                "text": "Was für ein Kaff! Hier ist ja überhaupt nichts los! Nichts wie zurück in die Stadt!"
                                            },
                                            {
                                                "example_id": "97b184d9-7f4b-4af1-b2b9-1a4da510fca4",
                                                "sense_id": "fc828d03-3165-3544-a1cd-7f8e5e9c5752",
                                                "text": "„Aufgrund eines Übermaßes an Heißwasser und Energie leisten sich die Isländer in nahezu jedem noch so kleinen Kaff ein Schwimmbad (Sundlaugar).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kaff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19c2b043-490b-3e52-8278-07e4d1402877",
                                        "entry_id": "1c78347f-ddb8-361e-89aa-ce6344c1a547",
                                        "glosses": [
                                            "Spreu"
                                        ],
                                        "tags": [
                                            "North German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6de3218f-aa9f-4765-a9a5-f220ea2c2506",
                                                "sense_id": "19c2b043-490b-3e52-8278-07e4d1402877",
                                                "text": "In der Winterfütterung erhielten die Laufschweine gebrühtes Kaff (Spreu) mit einigem Zusatz von geschrotenem Getreide."
                                            },
                                            {
                                                "example_id": "60837fdd-bf26-42fc-a1b5-a05e55af1684",
                                                "sense_id": "19c2b043-490b-3e52-8278-07e4d1402877",
                                                "text": "„Jes Lou krabbelte jetzt aus dem Kaff heraus, zog die Hose hoch und warf sich ebenfalls auf den Junker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a41954d8-4fc3-34f9-8fc1-63157d9ede47",
                                        "entry_id": "1c78347f-ddb8-361e-89aa-ce6344c1a547",
                                        "glosses": [
                                            "als wertlos Betrachtetes"
                                        ],
                                        "tags": [
                                            "North German",
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c7a807-7bcb-4c6a-a598-130c2e0ac8b4",
                        "source_entry_id": "67bd7f35-6887-3cf6-95c2-5c412f9fb42e",
                        "source_sense_id": "4391bd6d-433e-35ed-b688-7ca68c4561ab",
                        "source_sense_description": "kleiner, unbedeutender Ort, Kaff, Provinznest, Nest",
                        "target_lang_word": "Provinznest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Provinznest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0db32a6e-34e4-3dd3-a2bd-fcf9d24ce369",
                                        "entry_id": "ff268e07-3283-3281-98b9-5f72c4b0a91b",
                                        "glosses": [
                                            "kleiner Ort in einer provinziellen, schlecht entwickelten Region"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b840373b-2089-45c5-afab-65e58ead141d",
                                                "sense_id": "0db32a6e-34e4-3dd3-a2bd-fcf9d24ce369",
                                                "text": "„Ein Grund mag darin bestehen - obwohl er nicht auf unkundige Fremde zutreffen kann -, dass die Einheimischen mittlerweile abstoßend entartet und auf dem Pfad der Rückentwicklung schon weit vorangeschritten sind, wie es in so vielen Provinznestern Neuenglands üblich ist.“"
                                            },
                                            {
                                                "example_id": "1dffb7d0-15cd-4a26-9c6e-97096097dc60",
                                                "sense_id": "0db32a6e-34e4-3dd3-a2bd-fcf9d24ce369",
                                                "text": "„›Nein, Letitia. Schlimm genug, dass George und ich dorthin müssen. Das ist nicht irgendein rassistisches Provinznest, es ist ... irgendwie unheimlich.‹“"
                                            },
                                            {
                                                "example_id": "1e1233f8-dab1-42b4-997b-13b3110c3772",
                                                "sense_id": "0db32a6e-34e4-3dd3-a2bd-fcf9d24ce369",
                                                "text": "„Zeit, sich in irgendeinem Provinznest niederzulassen.“"
                                            },
                                            {
                                                "example_id": "d7e09cb2-cae5-4d1c-a144-ab6a7897816d",
                                                "sense_id": "0db32a6e-34e4-3dd3-a2bd-fcf9d24ce369",
                                                "text": "„Später wandte er sich mehr und mehr seinem stetig wachsenden Freundeskreis zu, er trank gern Scotch und versäumte keine Übertragung eines Formel-eins-Rennens, auch nicht während seiner Probezeit in einem Provinznest in Madhya Pradesh; damals war er per Anhalter in einem Kohlenlaster zum nächsten größeren Fernseher gefahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f70f86a0-1aa2-4b17-8d56-b00cfc9b1e78",
                        "source_entry_id": "67bd7f35-6887-3cf6-95c2-5c412f9fb42e",
                        "source_sense_id": "4391bd6d-433e-35ed-b688-7ca68c4561ab",
                        "source_sense_description": "kleiner, unbedeutender Ort, Kaff, Provinznest, Nest",
                        "target_lang_word": "Nest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7de7a066-2081-34d6-8281-a9c0f03216ce",
                                        "entry_id": "a58e423a-de8b-30ff-81d7-f40e6437edb8",
                                        "glosses": [
                                            "Stätte der Aufzucht der Jungen und der Wohnort bestimmter Tiere (zum Beispiel der Vögel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab5b049-4a8e-4478-a59a-2cb41f937ec3",
                                                "sense_id": "7de7a066-2081-34d6-8281-a9c0f03216ce",
                                                "text": "Das Männchen sammelt Zweige, um daraus ein Nest zu bauen."
                                            },
                                            {
                                                "example_id": "8734d63b-05ef-43b2-8bbb-2bebde17ff6b",
                                                "sense_id": "7de7a066-2081-34d6-8281-a9c0f03216ce",
                                                "text": "Was die Aufzucht ihrer Jungvögel, ihrer Brut, anbetrifft, unterstellt man den Raben eine lieblose, zuweilen auch brutale Pflege. Lange Zeit war die Vorstellung verbreitet, dass sie, wenn sie nicht genug Futter herbeischaffen können, einige Jungvögel aus dem Nest werfen."
                                            },
                                            {
                                                "example_id": "a365b317-d7b0-41be-812f-a9dc25135bd6",
                                                "sense_id": "7de7a066-2081-34d6-8281-a9c0f03216ce",
                                                "text": "„Schließlich war das die Zahl der Seelen, mit denen sie das Nest geteilt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0e1637b-2078-356b-b665-cf5a37cd6083",
                                        "entry_id": "a58e423a-de8b-30ff-81d7-f40e6437edb8",
                                        "glosses": [
                                            "Wohnstätte als Zufluchtsort, Ort der Geborgenheit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29bcdb68-b033-4218-acb7-d32e254c8b71",
                                                "sense_id": "b0e1637b-2078-356b-b665-cf5a37cd6083",
                                                "text": "Er kehrte heim, ins sichere Nest."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4980b8d7-fd3d-3c56-8d34-bc55e9959df8",
                                        "entry_id": "a58e423a-de8b-30ff-81d7-f40e6437edb8",
                                        "glosses": [
                                            "Stellung in militärischen Belangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8c51bf-9852-43e3-8592-ee35a29092e3",
                                                "sense_id": "4980b8d7-fd3d-3c56-8d34-bc55e9959df8",
                                                "text": "Durch taktisches Geschick gelang es ihnen, das feindliche Nest mit den MGs auszuheben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "27f3ddaa-207a-3685-bb12-9bdc5684c65d",
                                        "entry_id": "a58e423a-de8b-30ff-81d7-f40e6437edb8",
                                        "glosses": [
                                            "kleines Dorf"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880770a8-e2e1-4596-8186-ebeeac61d26e",
                                                "sense_id": "27f3ddaa-207a-3685-bb12-9bdc5684c65d",
                                                "text": "Liesel kommt aus irgend so einem Nest im Bayerischen Wald und ist eine richtige Landpomeranze."
                                            },
                                            {
                                                "example_id": "c5f01529-d746-4d62-bca5-1526ccec14f1",
                                                "sense_id": "27f3ddaa-207a-3685-bb12-9bdc5684c65d",
                                                "text": "„Rasch war er angekleidet, um den Zug wenigstens heute morgen nicht zu versäumen und gezwungen zu sein, noch länger in diesem schrecklichen Neste liegenzubleiben.“"
                                            },
                                            {
                                                "example_id": "b7d2059f-c46c-48b6-afff-8bfe57cccefd",
                                                "sense_id": "27f3ddaa-207a-3685-bb12-9bdc5684c65d",
                                                "text": "„In dem verschlafenen Nest Enugu kannte jeder Bruder Cyril.“"
                                            },
                                            {
                                                "example_id": "c69dadb0-f2d5-4871-900c-2ef8f53b0791",
                                                "sense_id": "27f3ddaa-207a-3685-bb12-9bdc5684c65d",
                                                "text": "„Der Ort verkam zu einem abgelegenen Nest.“"
                                            },
                                            {
                                                "example_id": "7c12c62c-f52d-47a5-ab08-85b0ef9a13a0",
                                                "sense_id": "27f3ddaa-207a-3685-bb12-9bdc5684c65d",
                                                "text": "„Dagegen war Meran einfach ein dummes, kleines Nest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
