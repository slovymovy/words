        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b549f5fc-416c-3286-8cc6-c2911aac4201",
                    "sense_definition": "To slide uncontrollably across a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sliding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bicycle began to <w>skid</w> on the wet pavement.",
                            "target_lang_translations": {
                                "cs": "Kolo začalo na mokrém chodníku <w>smýkat</w>.",
                                "nl": "De fiets begon te <w>slippen</w> op het natte wegdek.",
                                "fr": "Le vélo a commencé à <w>déraper</w> sur la chaussée mouillée."
                            }
                        },
                        {
                            "text": "The truck <w>skidded</w> across the road when the driver braked suddenly.",
                            "target_lang_translations": {
                                "cs": "Kamion <w>dostal smyk</w> a přejel přes silnici, když řidič náhle zabrzdil.",
                                "nl": "De vrachtwagen <w>slipte</w> over de weg toen de chauffeur plotseling remde.",
                                "fr": "Le camion a <w>dérapé</w> en travers de la route lorsque le conducteur a freiné brusquement."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide",
                        "slip"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nekontrolovaně klouzat po povrchu.",
                        "nl": "Ongecontroleerd over een oppervlak glijden.",
                        "fr": "Glisser de manière incontrôlée sur une surface."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dostat smyk",
