                                        "sense_id": "6db37b65-6a06-3ae1-9aa4-d59eaf550e87",
                                        "entry_id": "5c3722c9-1d72-3ee7-bd84-ddead0755055",
                                        "glosses": [
                                            "Neither temporary nor entirely permanent; of indefinite duration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42485e9-b17b-484b-a18e-ee58e255a547",
                                                "sense_id": "6db37b65-6a06-3ae1-9aa4-d59eaf550e87",
                                                "text": "Such movable insulation could be applied to the end walls, either in the form of insulating shutters or a more semipermanent arrangement such as the one I use on the north roof of my pit."
                                            },
                                            {
                                                "example_id": "abff8f88-d45f-4478-a27a-28fb4070717e",
                                                "sense_id": "6db37b65-6a06-3ae1-9aa4-d59eaf550e87",
                                                "text": "We are not at all permanent collections of particles. It is the patterns of matter and energy that are semipermanent (that is, changing only gradually), but our actual material content is changing constantly, and very quickly."
                                            },
                                            {
                                                "example_id": "77f3fe32-6601-47cf-9cf1-bb5f5491a4a5",
                                                "sense_id": "6db37b65-6a06-3ae1-9aa4-d59eaf550e87",
                                                "text": "Although tens of thousands of refugees now live in semipermanent camps along the Thai border with Myanmar, some of them are periodically forced back against their will."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
