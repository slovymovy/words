                "senses": [
                    {
                        "sense_id": "f24adc2f-4ba5-3756-bde3-726886cf37d5",
                        "entry_id": "853bae5b-8e84-3f57-8e42-043aed637c17",
                        "glosses": [
                            "Chromatographier conjointement avec une autre substance qui sert de base de comparaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39368f62-7ef5-49ab-9b3a-6ca19614e0f6",
                                "sense_id": "f24adc2f-4ba5-3756-bde3-726886cf37d5",
                                "text": "Les échantillons à tester : l’huile de lentisque (HL), l’insaponifiable de l’huile de lentisque (INSAP), et l’extrait hexanoique des baies (HEX) ont été co-chromatographiés avec des substances témoins : le stigmastérol (STIG) et α-tocophérol synthétique (TOCO)."
                            },
                            {
                                "example_id": "3ce895f9-3d30-4273-8bbe-41b35915bad2",
                                "sense_id": "f24adc2f-4ba5-3756-bde3-726886cf37d5",
                                "text": "Les niveaux des produits co-chromatographiés avec l’adénosine et l’adénine nucléotide sont mesurés seulement au cours des 24 h de nutrition et restent faibles."
                            }
                        ]
                    }
