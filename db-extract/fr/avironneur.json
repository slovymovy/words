                        "entry_id": "102a9eb0-f7e6-3665-9b3d-7e4f608ffac8",
                        "glosses": [
                            "Rameur qui pratique l’aviron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4c8aa6-08d6-44c8-9555-7db72705be21",
                                "sense_id": "c07adbdf-df8f-36f6-a793-f6dedc25ff2b",
                                "text": "Aussi, son adresse et son endurance d’avironneur ne sont-elles nulle part contestées."
                            },
                            {
                                "example_id": "641acabb-ec01-49a7-be6a-cbd20a883558",
                                "sense_id": "c07adbdf-df8f-36f6-a793-f6dedc25ff2b",
                                "text": "Les avironneurs de tous âges et représentant plus de dix nationalités ont ainsi éveillé la curiosité des badauds aux abords de l’île Saint-Louis, ou surpris les passagers du métro aérien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f569338c-a56e-46ac-bdea-f7c80a3fe79f",
                        "source_entry_id": "102a9eb0-f7e6-3665-9b3d-7e4f608ffac8",
                        "source_sense_id": "c07adbdf-df8f-36f6-a793-f6dedc25ff2b",
                        "target_lang_word": "rower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
