        "fr-extract.jsonl": [
            {
                "entry_id": "d877b219-3332-3ac6-b12b-99d26b9563ca",
                "word": "protéase",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6779022a-2539-4e52-8e4b-b6895ab95044",
                        "entry_id": "d877b219-3332-3ac6-b12b-99d26b9563ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "protéases"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53235a0d-ab44-3868-8752-9a4841d5b6c4",
                        "entry_id": "d877b219-3332-3ac6-b12b-99d26b9563ca",
                        "glosses": [
                            "Enzyme de type hydrolase qui lyse une protéine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8835ea0-22c8-4b43-a1c7-932e487843c8",
                                "sense_id": "53235a0d-ab44-3868-8752-9a4841d5b6c4",
                                "text": "Actinobacillus pleuropneumoniae produit une immunoglobuline A protéase spécifique des IgA du porc. Cette protéase pourrait intervenir dans la pathogénie et sa spécificité serait un des facteurs expliquant que cette bactérie ne soit naturellement pathogène que pour le porc."
                            },
                            {
                                "example_id": "5c2906f9-a62a-4e98-9b2d-21659813e2c0",
                                "sense_id": "53235a0d-ab44-3868-8752-9a4841d5b6c4",
                                "text": "Les plaquettes activées libèrent des protéines comme la thrombospondine, la fibronectine, des protéases et des métabolites de l’acide arachidonique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc215105-92e1-4888-9aff-c42481344e22",
                        "source_entry_id": "d877b219-3332-3ac6-b12b-99d26b9563ca",
                        "source_sense_id": "53235a0d-ab44-3868-8752-9a4841d5b6c4",
                        "target_lang_word": "protease",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb386ed4-4b5b-343d-94b2-9e8d52a3a45b",
                                        "entry_id": "6c594dc9-e987-3736-a3e9-7dacfc48c8ed",
                                        "glosses": [
                                            "An enzyme that cuts or cleaves proteins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b866f561-9700-4172-9733-4a94d9fa96ba",
                                                "sense_id": "eb386ed4-4b5b-343d-94b2-9e8d52a3a45b",
                                                "text": "As a matter of fact the casein protease digests boiled and coagulated serum far more easily than unboiled serum, as set forth by the following experiments."
                                            },
                                            {
                                                "example_id": "f29edd5b-8dab-4234-ad58-aabd0e55fd1e",
                                                "sense_id": "eb386ed4-4b5b-343d-94b2-9e8d52a3a45b",
                                                "text": "All were tested for their ability to clot milk and to hydrolyze denatured hemoglobin, egg albumin, protamine (salmon), histone (calf thymus), and benzoyl-l-arginineamide. In no case was any trace of protease activity detected."
                                            },
                                            {
                                                "example_id": "fd417812-f800-4340-a61e-1dd7b59c3f86",
                                                "sense_id": "eb386ed4-4b5b-343d-94b2-9e8d52a3a45b",
                                                "text": "For our purposes, it is sufficient to note that dysregulation of desquamatory protease activity in the SC is often involved in conditions of compromised skin barrier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82280851-dc91-4c95-a88c-ed3e238b0fe3",
                        "source_entry_id": "d877b219-3332-3ac6-b12b-99d26b9563ca",
