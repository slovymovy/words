                "senses": [
                    {
                        "sense_id": "e6a93082-d68f-332c-9610-f7f4f5d4f8f1",
                        "entry_id": "5b90fc0d-0f57-3af7-a8e9-89d80066250b",
                        "glosses": [
                            "aus Plastik/Kunststoff bestehende Tüte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42372d0c-e38f-40e4-8ab8-17bbcbd26329",
                                "sense_id": "e6a93082-d68f-332c-9610-f7f4f5d4f8f1",
                                "text": "„Das geht von der Plastikfolie des eingeschweißten Gemüses über Werbeflyer und Visitenkarten bis zur Kunststofftüte, die an der Supermarktkasse liegt.“"
                            },
                            {
                                "example_id": "87aa0826-1c2f-4647-bee4-62ea71222134",
                                "sense_id": "e6a93082-d68f-332c-9610-f7f4f5d4f8f1",
                                "text": "„Die Kunststofftüte ist leicht, hygienisch und preisgünstig.“"
                            },
                            {
                                "example_id": "52779bc7-59ba-401e-99bf-f202b614a871",
                                "sense_id": "e6a93082-d68f-332c-9610-f7f4f5d4f8f1",
                                "text": "„Frisch gestochener Spargel mag es feucht: Wickeln Sie ihn in ein feuchtes Tuch und dann in eine Kunststofftüte, sodass er bis zur Verwendung frisch bleibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
