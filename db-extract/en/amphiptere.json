                        "glosses": [
                            "A type of winged serpent, with two bat-like wings and typically with no other limbs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "520bbb26-2008-45b7-849a-d7d398d8fd65",
                                "sense_id": "9aa8e70c-81a7-3928-8b93-cd1bd2b53ae7",
                                "text": "Azure, an amphiptere or, rising between two mountains argent, are the arms of Camoens, the Portuguese poet."
                            }
                        ]
                    }
                ],
