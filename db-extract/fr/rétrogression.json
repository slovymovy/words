                "senses": [
                    {
                        "sense_id": "18d609f1-aa6f-3a34-bf43-e058758c2c94",
                        "entry_id": "4ffabb77-151c-3e04-80e6-8da4db5c2407",
                        "glosses": [
                            "Action de rétrograder, déclin vers une forme plus simple, moins complexe, moins évoluée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a91cb3e-577f-4514-8332-f1eb9cf36062",
                                "sense_id": "18d609f1-aa6f-3a34-bf43-e058758c2c94",
                                "text": "Les relations de la Communauté avec la Chine connaissent une amélioration constante, après la rétrogression qui a suivi les événements de la place Tien an Men."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0db68f7-21e3-3c03-991f-4ab887b5663e",
                        "entry_id": "4ffabb77-151c-3e04-80e6-8da4db5c2407",
                        "glosses": [
                            "Mouvement en arrière, sans nuance péjorative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05819ab4-9d89-45c5-943e-ab581c84b6e8",
                                "sense_id": "d0db68f7-21e3-3c03-991f-4ab887b5663e",
                                "text": "« Il existe une rétrogression prospective, non réactionnaire, et c'est elle qu'il faut continuer de conquérir »"
                            }
                        ]
                    },
                    {
                        "sense_id": "9cf7a831-2c27-33b7-b44a-861117d5410f",
                        "entry_id": "4ffabb77-151c-3e04-80e6-8da4db5c2407",
                        "glosses": [
                            "Figure de style qui consiste à reprendre, dans une même phrase, une suite de mots en les plaçant en ordre inverse."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": []
                    }
