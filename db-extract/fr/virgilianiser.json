                "senses": [
                    {
                        "sense_id": "ce3c1494-0d88-3a2b-9c93-1b48810ef877",
                        "entry_id": "a9e2c13f-d743-3707-89f4-17c4239bc680",
                        "glosses": [
                            "Donner un caractère virgilien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca4c705a-1985-4ea3-a160-bea524027e8c",
                                "sense_id": "ce3c1494-0d88-3a2b-9c93-1b48810ef877",
                                "text": "Cependant elle est en partie dénaturée par des interventions arbitraires de l’éditeur, qui tendent en général à virgilianiser le texte."
                            },
                            {
                                "example_id": "47c935c6-0fca-4483-bdd2-5454f12b0d27",
                                "sense_id": "ce3c1494-0d88-3a2b-9c93-1b48810ef877",
                                "text": "Or « virgilianiser » Shakespeare ou « shakespearianiser » Virgile pose le problème de fonder un style uni."
                            },
                            {
                                "example_id": "d9b9a3a7-3dd3-4c76-b902-33c76dc33496",
                                "sense_id": "ce3c1494-0d88-3a2b-9c93-1b48810ef877",
                                "text": "Appliqué à la critique textuelle, il aboutit à virgilianiser ou ovidianiser, en tout cas à uniformiser, les textes poétiques."
                            }
                        ]
                    }
