                                "example_id": "dfbb99c8-4d85-4f7b-bf39-377d12a3a311",
                                "sense_id": "879723e6-c81b-351f-82a3-ee0f40187360",
                                "text": "Podobają mi się obrazy włoskiego futuryzmu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54bffaeb-1620-418c-b4ce-557b0fde259b",
                        "source_entry_id": "c1a0cbd3-532a-3f5a-a2a5-cf30128cbc47",
                        "source_sense_id": "879723e6-c81b-351f-82a3-ee0f40187360",
                        "target_lang_word": "futurism",
