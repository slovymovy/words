{
    "word_family": [
        "transport",
        "transporter",
        "transportable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96832bb3-27e2-3436-ae83-69458bb5e4c0",
                    "sense_definition": "The act of moving people or goods from one place to another, or the system used for doing this.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to improve public <w>transportation</w> to reduce traffic in the city.",
                            "target_lang_translations": {
                                "ru": "Нам нужно улучшить общественный <w>транспорт</w>, чтобы уменьшить пробки в городе.",
                                "zh": "我们需要改善公共<w>交通</w>以减少城市拥堵。"
                            }
                        },
                        {
                            "text": "The <w>transportation</w> of heavy machinery requires specialized trucks.",
                            "target_lang_translations": {
                                "ru": "<w>Транспортировка</w> тяжелой техники требует специализированных грузовиков.",
                                "zh": "重型机械的<w>运输</w>需要专门的卡车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transit",
                        "transport"
                    ],
                    "common_phrases": [
                        "public transportation",
                        "means of transportation",
                        "ground transportation",
                        "air transportation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс перемещения людей или грузов из одного места в другое, или система, используемая для этого.",
                        "zh": "将人员或货物从一地运送到另一地的行为，或用于此目的的系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транспорт",
                                "target_lang_sense_clarification": "система перевозок"
                            },
                            {
                                "target_lang_word": "перевозка",
                                "target_lang_sense_clarification": "действие по перемещению"
                            },
                            {
                                "target_lang_word": "транспортировка",
                                "target_lang_sense_clarification": "перемещение грузов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交通",
                                "target_lang_sense_clarification": "指运输系统或往来"
                            },
                            {
                                "target_lang_word": "运输",
                                "target_lang_sense_clarification": "指运送货物的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa31a813-692b-3ee5-bb6e-e792bd6eefbc",
                    "sense_definition": "A vehicle or method used to travel or move things.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you have your own <w>transportation</w>, or will you need a ride?",
                            "target_lang_translations": {
                                "ru": "У тебя есть свой <w>транспорт</w>, или тебя нужно подвезти?",
                                "zh": "你有自己的<w>交通工具</w>吗，还是需要搭便车？"
                            }
                        },
                        {
                            "text": "His bicycle is his primary mode of <w>transportation</w> around campus.",
                            "target_lang_translations": {
                                "ru": "Велосипед — его основное средство <w>передвижения</w> по кампусу.",
                                "zh": "自行车是他校园内主要的<w>交通工具</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vehicle",
                        "ride",
                        "transport"
                    ],
                    "common_phrases": [
                        "reliable transportation",
                        "own transportation",
                        "mode of transportation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство или способ передвижения.",
                        "zh": "用于旅行或移动物品的车辆或方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транспорт",
                                "target_lang_sense_clarification": "средство передвижения"
                            },
                            {
                                "target_lang_word": "транспортное средство",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "средство передвижения",
                                "target_lang_sense_clarification": "способ перемещения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交通工具",
                                "target_lang_sense_clarification": "指代步的车辆或设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb8d29e8-1554-33be-b484-f35299671192",
                    "sense_definition": "The punishment of sending a criminal to a distant place, usually a penal colony.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the nineteenth century, <w>transportation</w> to Australia was a common sentence for thieves.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке <w>ссылка</w> в Австралию была обычным приговором для воров.",
                                "zh": "在十九世纪，将小偷<w>流放</w>到澳大利亚是一种常见的判决。"
                            }
                        },
                        {
                            "text": "The prisoner faced <w>transportation</w> for life instead of the death penalty.",
                            "target_lang_translations": {
                                "ru": "Заключенному грозила пожизненная <w>ссылка</w> вместо смертной казни.",
                                "zh": "这名囚犯面临终身<w>流放</w>，而不是死刑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deportation",
                        "banishment",
                        "exile"
                    ],
                    "common_phrases": [
                        "sentenced to transportation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказание в виде высылки преступника в отдаленное место, обычно в исправительную колонию.",
                        "zh": "将罪犯流放到遥远地方（通常是流放地）的惩罚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылка",
                                "target_lang_sense_clarification": "изгнание, депортация"
                            },
                            {
                                "target_lang_word": "каторга",
                                "target_lang_sense_clarification": "исторический контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流放",
                                "target_lang_sense_clarification": "指将罪犯驱逐到边远地区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a258af1-57b4-389f-afcd-67afb0f00983",
                    "sense_definition": "A ticket or document authorizing travel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agent checked his files to see if the <w>transportation</w> had been issued.",
                            "target_lang_translations": {
                                "ru": "Агент проверил свои файлы, чтобы узнать, был ли выписан <w>проездной документ</w>.",
                                "zh": "代理人检查了文件，看是否已经签发了<w>车票</w>。"
                            }
                        },
                        {
                            "text": "She arrived at the station only to realize she had forgotten her <w>transportation</w>.",
                            "target_lang_translations": {
                                "ru": "Она прибыла на станцию только чтобы понять, что забыла свой <w>билет</w>.",
                                "zh": "她到达车站后才意识到自己忘了带<w>车票</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ticket",
                        "fare",
                        "pass"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in older travel contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Билет или документ, дающий право на проезд.",
                        "zh": "授权旅行的票据或文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "билет",
                                "target_lang_sense_clarification": "проездной документ"
                            },
                            {
                                "target_lang_word": "проездной",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "车票",
                                "target_lang_sense_clarification": "指乘车凭证"
                            },
                            {
                                "target_lang_word": "票据",
                                "target_lang_sense_clarification": "指旅行凭证"
                            }
                        ]
                    }
                }
            ]
        }
    ]
