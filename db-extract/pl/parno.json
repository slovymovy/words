                                            "velmi teplo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779cfc1c-cdd0-44e1-86eb-33ec1f64b187",
                                                "sense_id": "3ce23fb6-eaff-3805-a738-e36ba855443f",
                                                "text": "Včera bylo zase parno, teplota přesáhla třicet stupňů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d011138-4796-49a9-8ddc-f9286b6644c6",
                        "source_entry_id": "c3724626-5a55-3d07-9bf7-8d590284b22f",
                        "source_sense_id": "74ed167d-1640-3811-988a-9cbe2171d9c8",
                        "target_lang_word": "vedro",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
