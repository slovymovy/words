                                        "entry_id": "c78c236b-f546-36a5-bab8-ae1ded0ef27f",
                                        "glosses": [
                                            "A game used by baseball players to warm up where fielders standing close to a batter rapidly return the batted ball to be hit again"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0608d9bb-57cd-49ba-84f3-59d526be8a90",
                                                "sense_id": "fc1d76d3-d306-33e0-8a3a-9d2563362060",
                                                "text": "Some ballparks have signs saying \"No pepper games\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "856e36b4-bdd7-3e8c-a145-d818f7a5ff0d",
                                        "entry_id": "c78c236b-f546-36a5-bab8-ae1ded0ef27f",
                                        "glosses": [
                                            "A randomly-generated value that is added to another value (such as a password) prior to hashing. Unlike a salt, a new one is generated for each value and it is held separately from the value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c3bf39a-00ac-3121-88c3-644b46ddef04",
                                        "entry_id": "c78c236b-f546-36a5-bab8-ae1ded0ef27f",
                                        "glosses": [
                                            "A beating; a thrashing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23cb076c-f696-4a27-97c0-e28e4ba3062b",
                                                "sense_id": "4c3bf39a-00ac-3121-88c3-644b46ddef04",
                                                "text": "He means to snatch the laurels from his brow, / At all his boasted pluck and prowess smile, / And give him pepper in superior style."
                                            },
                                            {
                                                "example_id": "4168dc1d-483a-45bd-8acc-1a0824283bb3",
                                                "sense_id": "4c3bf39a-00ac-3121-88c3-644b46ddef04",
                                                "text": "[T]he Chicken had been tapped, and bunged, and had received pepper, and had been made groggy, and had come up piping, and had endured a complication of similar strange inconveniences, until he had been gone into and finished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f3f8f1-23e3-3155-86e6-2057f9d6c4fa",
                                        "entry_id": "c78c236b-f546-36a5-bab8-ae1ded0ef27f",
                                        "glosses": [
                                            "A shotgun."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbe804bf-5f61-4260-93aa-577d337c4681",
                                                "sense_id": "33f3f8f1-23e3-3155-86e6-2057f9d6c4fa",
                                                "text": "Chew beef like breakfast (Yum)\nTwo shanks, get 'round in seconds (Two)\nBe feeding my area, peppers"
                                            },
                                            {
                                                "example_id": "b3135cc4-8bda-410b-a83d-ce94f6236d48",
                                                "sense_id": "33f3f8f1-23e3-3155-86e6-2057f9d6c4fa",
                                                "text": "Number plates already hot, and plus we've got like three peppers"
                                            }
                                        ]
                                    }
