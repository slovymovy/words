                "senses": [
                    {
                        "sense_id": "aa99d5ed-20a5-3770-a3c5-0cbf4d92c0b8",
                        "entry_id": "0b15028d-c18d-3b39-b449-32219436362f",
                        "glosses": [
                            "separater Raum oder Raumgruppe eines Gebäudes, in dem wesentlichen Teile einer Raum-Luft-Technischen-Anlage, für die Luftbehandlung, untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9472fcf-741a-4878-ba82-66fe66fd2a92",
                                "sense_id": "aa99d5ed-20a5-3770-a3c5-0cbf4d92c0b8",
                                "text": "„Bei einem Brand in der Lüftungszentrale können Feuer und Rauch über die in mehreren Geschossen oder Brandabschnitten angeschlossenen Leitungen auf andere Gebäudebereiche übertragen werden.“"
                            },
                            {
                                "example_id": "b24a7dd1-6665-4e33-87ec-9796adfa9276",
                                "sense_id": "aa99d5ed-20a5-3770-a3c5-0cbf4d92c0b8",
                                "text": "„Innerhalb von Gebäuden müssen Ventilatoren und Luftaufbereitungseinrichtungen in besonderen Räumen (Lüftungszentralen) aufgestellt werden, wenn an die Ventilatoren oder Luftaufbereitungseinichtungen in Strömungsrichtung anschließende Leitungen in mehrere Geschosse (nicht in Gebäuden geringer Höhe) oder Brandabschnitte führen.“"
                            },
                            {
                                "example_id": "a177ea10-a795-4d07-936f-a9bcd1f862de",
                                "sense_id": "aa99d5ed-20a5-3770-a3c5-0cbf4d92c0b8",
                                "text": "„Für den späteren Anlagebetreiber ist es von grosser Wichtigkeit, eine gut geplante Lüftungszentrale zu haben.“"
                            },
                            {
                                "example_id": "b556eedf-b1ec-4522-b5c1-e51cf0e5fa2c",
                                "sense_id": "aa99d5ed-20a5-3770-a3c5-0cbf4d92c0b8",
                                "text": "„Die Lüftungszentrale versorgt die Antriebe mit Strom und steuert die Antriebe.“"
                            },
                            {
                                "example_id": "1afef328-482b-41ff-83a2-5f27ac0d0bc2",
                                "sense_id": "aa99d5ed-20a5-3770-a3c5-0cbf4d92c0b8",
                                "text": "„ Für die Wärmerückgewinnung gelangt in den Lüftungszentralen bei der Anlage „Strahlentherapie“ sowie „Innenliegende Räume“ ein Wärmetauscher zum Einbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
