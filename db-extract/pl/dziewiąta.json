                "senses": [
                    {
                        "sense_id": "99fe35a1-71fe-3c31-a169-6bbf285e7091",
                        "entry_id": "d5bf9cda-eb46-37ab-bb29-f7a8fe67bbf9",
                        "glosses": [
                            "godzina 9 rano lub wieczorem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "838edb2d-6242-4269-8b91-c8c637f3d8b7",
                                "sense_id": "99fe35a1-71fe-3c31-a169-6bbf285e7091",
                                "text": "Umówiłem się z nią na dziewiątą."
