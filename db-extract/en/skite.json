                        "examples": []
                    },
                    {
                        "sense_id": "491b525b-279b-3c67-9673-a98c77c7a78f",
                        "entry_id": "da6f2352-330f-3daf-8651-7fb3a81dacab",
                        "glosses": [
                            "A trick."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dc87004a-bcae-376e-a4a4-c42676d6b216",
                        "entry_id": "da6f2352-330f-3daf-8651-7fb3a81dacab",
                        "glosses": [
                            "A contemptible person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a40f8c3-efb8-49f2-90aa-7d05cfaab210",
                                "sense_id": "dc87004a-bcae-376e-a4a4-c42676d6b216",
                                "text": "When Carey told on Skin-the-Goat / O'Donnell caught him on the boat / He wished he'd never been afloat / The dirty skite."
                            }
                        ]
                    },
                    {
                        "sense_id": "579efe9a-5090-39a2-aafa-39d797e5e1dd",
                        "entry_id": "da6f2352-330f-3daf-8651-7fb3a81dacab",
                        "glosses": [
                            "A drinking binge."
                        ],
                        "tags": [
                            "Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "b4e4a92f-a566-4142-9373-a78017506320",
                                "sense_id": "579efe9a-5090-39a2-aafa-39d797e5e1dd",
                                "text": "I needed alcohol to stop my nerves rattling. This felt like the longest period I'd been without my drug of choice for at least three years. I needed to go on a skite."
                            }
                        ]
                    },
                    {
                        "sense_id": "52a20677-14f2-31eb-9cf0-c183fb8f07d3",
                        "entry_id": "da6f2352-330f-3daf-8651-7fb3a81dacab",
                        "glosses": [
                            "One who skites; a boaster."
                        ],
                        "tags": [
                            "Australia",
                            "Ireland",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "080a7a32-b17a-4207-bf70-0a6f4ed45903",
                                "sense_id": "52a20677-14f2-31eb-9cf0-c183fb8f07d3",
                                "text": "[T]he Rooster was one of those fine, upstanding, bumptious skites who love to talk all day, in the heartiest manner, to total strangers while their wives do the washing."
                            }
                        ]
                    },
                    {
                        "sense_id": "3843c8dc-7e83-3dec-8fa2-f0fef7a0ac4e",
                        "entry_id": "da6f2352-330f-3daf-8651-7fb3a81dacab",
                        "glosses": [
                            "A whimsical or leisurely trip."
                        ],
                        "tags": [
                            "Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "a54684ea-a09f-4c60-9136-9aed331e43a5",
                                "sense_id": "3843c8dc-7e83-3dec-8fa2-f0fef7a0ac4e",
                                "text": "We're going on a skite to Dublin."
                            }
                        ]
                    }
                ],
