                                        "examples": [
                                            {
                                                "example_id": "fb47ef94-15f3-4a7d-8420-513e29bd41ce",
                                                "sense_id": "8b499006-0837-300b-b989-7c5f85162697",
                                                "text": "Volgens de politie komen er tientallen tips binnen van mensen die aanwijzingen hebben die mogelijk leiden naar de daders. De politie sluit niet uit dat er sprake is van kopieergedrag en er meerdere snelwegschutters zijn."
                                            },
                                            {
                                                "example_id": "69492405-3d58-4cdf-bf99-1ddef2f9f982",
                                                "sense_id": "8b499006-0837-300b-b989-7c5f85162697",
                                                "text": "Volgens Walma heeft dat voorval niets met het incident van deze te maken. \"In dat geval waren het een stel opgeschoten kinderen. Nu gaat het om kinderen van twaalf. Misschien is er sprake van kopieergedrag.\""
                                            }
                                        ]
