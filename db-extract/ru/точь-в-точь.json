                        "source_entry_id": "0ba9a610-97d0-31a0-bc81-522cf9b2fcbc",
                        "target_lang_word": "eins zu eins",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4c09559a-85f5-4ac4-a235-45601c69e5c9",
                        "source_entry_id": "0ba9a610-97d0-31a0-bc81-522cf9b2fcbc",
                        "target_lang_word": "absolut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a98d720-7b39-30e1-a09e-9aa09fa4e84a",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "durch nichts bedingt, von uneingeschränkter Gültigkeit und/oder Verbindlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a764e961-d692-47a6-8742-95079d723721",
                                                "sense_id": "9a98d720-7b39-30e1-a09e-9aa09fa4e84a",
                                                "text": "Dieses Gesetz garantiert absolute Glaubensfreiheit."
                                            },
                                            {
                                                "example_id": "ba30c2aa-5ee2-401c-92b2-294f9944457c",
                                                "sense_id": "9a98d720-7b39-30e1-a09e-9aa09fa4e84a",
                                                "text": "Das hat absolute Priorität."
                                            },
                                            {
                                                "example_id": "a4af72e3-b0e4-4e99-b31c-54e00cb77587",
                                                "sense_id": "9a98d720-7b39-30e1-a09e-9aa09fa4e84a",
                                                "text": "Hier ist absolutes Halteverbot."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1f26e4c-2ae8-3e3a-8dff-f24296b4ce2f",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "unumschränkte Herrschaft betreffend oder habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3cf10b-0d6f-4cd9-9939-5d33cad7bb6a",
                                                "sense_id": "c1f26e4c-2ae8-3e3a-8dff-f24296b4ce2f",
                                                "text": "Absolutismus bedeutete für den Herrscher absolute Macht, Ludwig XIV war ein solcher absoluter Herrscher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cfe05b05-6cbb-31ea-bfa5-bc641b874ab3",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "ganz und gar, in vollem Maße"
                                        ],
                                        "tags": [
                                            "adverbiell",
                                            "meist mit Negation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba41f3b-484e-4514-a767-0f9ae3dc8cb0",
                                                "sense_id": "cfe05b05-6cbb-31ea-bfa5-bc641b874ab3",
                                                "text": "Ich kann ihn absolut nicht leiden."
                                            },
                                            {
                                                "example_id": "a8ae2f02-2409-4a3c-9410-5fcb30b86f34",
                                                "sense_id": "cfe05b05-6cbb-31ea-bfa5-bc641b874ab3",
                                                "text": "Du hast absolut keine Ahnung."
                                            },
                                            {
                                                "example_id": "cef87834-5230-4b16-bad2-7f0bbb199448",
                                                "sense_id": "cfe05b05-6cbb-31ea-bfa5-bc641b874ab3",
                                                "text": "Das da will ich absolut nicht probieren."
                                            },
                                            {
                                                "example_id": "2fbbf1f9-a938-48f9-ab3e-40dbdcda38d1",
                                                "sense_id": "cfe05b05-6cbb-31ea-bfa5-bc641b874ab3",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            },
                                            {
                                                "example_id": "fe924840-2f2c-4d8e-b44c-89a9dd1b6d3e",
                                                "sense_id": "cfe05b05-6cbb-31ea-bfa5-bc641b874ab3",
                                                "text": "Das Gesetz in seiner vorliegenden Form [mit einer Frauenquote von 30 Prozent in Aufsichtsräten von Großunternehmen] sei \"absolut machbar\" für die Unternehmen in diesem Land [, so die CDU-Abgeordnete Nadine Schön]."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6dfd839f-34ec-31bf-9774-a0160a153e10",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "auf jeden Fall"
                                        ],
                                        "tags": [
                                            "adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ddeecb-49ac-4853-a602-439622eb8d5d",
                                                "sense_id": "6dfd839f-34ec-31bf-9774-a0160a153e10",
                                                "text": "Das hier musst du absolut probieren."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3dbf12df-4494-309a-bc9e-eeb44fdba0f3",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "sich nicht überbieten oder steigern lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af52bba-d792-4e0d-89a0-9c8a4ec4aefc",
                                                "sense_id": "3dbf12df-4494-309a-bc9e-eeb44fdba0f3",
                                                "text": "Wir haben den absoluten Tiefpunkt erreicht."
                                            },
                                            {
                                                "example_id": "37cb997a-23b0-4727-ba53-0eaf2972f5f5",
                                                "sense_id": "3dbf12df-4494-309a-bc9e-eeb44fdba0f3",
                                                "text": "Das ist eine absolute Grenze."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "3012476f-fd41-3024-9f2e-8f9c2d5d3c46",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "völlig, vollkommen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8cf7784-f5e6-4126-94f9-f94c23fe93b1",
                                                "sense_id": "3012476f-fd41-3024-9f2e-8f9c2d5d3c46",
                                                "text": "Er ist ein absoluter Idiot."
                                            },
                                            {
                                                "example_id": "95e29de5-db63-44de-ad85-6f07bc3faa33",
                                                "sense_id": "3012476f-fd41-3024-9f2e-8f9c2d5d3c46",
                                                "text": "Sie sorgten für absolute Sicherheit."
                                            },
                                            {
                                                "example_id": "90b34441-13e3-44ba-8c42-bcd6ea3f9183",
                                                "sense_id": "3012476f-fd41-3024-9f2e-8f9c2d5d3c46",
                                                "text": "Sie lebte in absoluter Einsamkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "cfb0ab30-79c6-38ee-80e8-84708cd921f4",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "von nichts abhängend und zu nichts in Beziehung stehend, an sich betrachtet"
                                        ],
                                        "tags": [
                                            "Wissenschaftstheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "033552ca-226b-49f7-8104-15ec73e9908d",
                                                "sense_id": "cfb0ab30-79c6-38ee-80e8-84708cd921f4",
                                                "text": "Deine Aussage hat absolut nichts mit dem vorherigen Satz zu tun."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "95668a04-da7f-383f-8488-04a9348e4bc9",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "auf eine bestimmte Grundeinheit bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129fe435-f176-450d-bc72-f64e0abc7b43",
                                                "sense_id": "95668a04-da7f-383f-8488-04a9348e4bc9",
                                                "text": "Die absolute Höhe über dem Meeresspiegel beträgt an diesem Punkt 1.234 Meter."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "13b3be89-0377-30b8-b4ad-8eb3221369d8",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "für sich stehend, von nichts abhängend und/oder sich nicht durch einen Vergleich bestimmen lassend, ohne jegliche Hilfsmittel auskommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241a64c0-1a6e-4216-bde9-4c1b426bbf6f",
                                                "sense_id": "13b3be89-0377-30b8-b4ad-8eb3221369d8",
                                                "text": "Sie hat das absolute Gehör."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "66235832-3585-3076-a6b3-4c1e4a27b686",
                                        "entry_id": "68a8cae9-3350-3b4e-a2e1-e0dd16847632",
                                        "glosses": [
                                            "rein oder fast rein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18de1d21-fecf-4e9c-a4ed-e37a159d2862",
                                                "sense_id": "66235832-3585-3076-a6b3-4c1e4a27b686",
