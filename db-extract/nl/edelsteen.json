                    {
                        "sense_id": "0bcd1bf6-cf7e-3750-8164-8d21b93c684b",
                        "entry_id": "430dc03c-d489-3fb3-85b6-4aabe1979177",
                        "glosses": [
                            "een stuk van een zeldzame, harde, kostbare en glanzende steensoort, een stuk edelgesteente bijvoorbeeld diamant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ab84cd-1797-4cbc-9c44-a1cbcb84f142",
                                "sense_id": "0bcd1bf6-cf7e-3750-8164-8d21b93c684b",
                                "text": "De rijke vrouw droeg sieraden met veel kostbare edelstenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f460c366-0ccf-4daa-b770-f82d4abacd7b",
                        "source_entry_id": "430dc03c-d489-3fb3-85b6-4aabe1979177",
                        "source_sense_id": "0bcd1bf6-cf7e-3750-8164-8d21b93c684b",
                        "source_sense_description": "een stuk edelgesteente",
                        "target_lang_word": "Edelstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edelstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "955b2d67-d5d2-3889-a810-3f8c151f50a5",
                                        "entry_id": "863ead90-43c5-3cdb-a11e-4500d50a4879",
                                        "glosses": [
                                            "seltener kostbarer Stein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d64d6b-80e4-4660-8841-2d85fc66b22a",
                                                "sense_id": "955b2d67-d5d2-3889-a810-3f8c151f50a5",
                                                "text": "Das sind schöne Edelsteine."
                                            },
                                            {
                                                "example_id": "fc9fcbd0-a30c-46cf-b708-c86e63f90715",
                                                "sense_id": "955b2d67-d5d2-3889-a810-3f8c151f50a5",
                                                "text": "Hier kann man günstig Kristalle, Edelsteine, Fossilien und alten Schmuck kaufen."
                                            },
                                            {
                                                "example_id": "3e9c04e1-8ed3-4bf2-9072-9daf49dce41e",
                                                "sense_id": "955b2d67-d5d2-3889-a810-3f8c151f50a5",
                                                "text": "„Die Uranminen waren weit weg, ebenso wie die Abbaugebiete für Edelsteine – Turmaline und Granate –, nach denen irgendwo in der Wüste gegraben wurde.“"
                                            },
                                            {
                                                "example_id": "81dd2c6e-419c-41d2-9695-4fd61835b909",
                                                "sense_id": "955b2d67-d5d2-3889-a810-3f8c151f50a5",
                                                "text": "„Der Marchese Serpos war ein in Venedig ansässiger armenischer Kaufmann, der nur mit Edelsteinen handelte; er war ein intimer Freund des Abtes.“"
                                            },
                                            {
                                                "example_id": "1ee44e9e-4539-4e8f-af63-88ef2877eaf3",
                                                "sense_id": "955b2d67-d5d2-3889-a810-3f8c151f50a5",
                                                "text": "„Während der kurzen bolschewistischen Besatzungszeit hatte ein Soldat die kostbaren Edelsteine herausgenommen, so daß Tante Praskovia jetzt vor einer blinden Gottesmutter betete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "caa14be4-d0f6-3945-9dec-a2a30fcfcb8e",
                                        "entry_id": "863ead90-43c5-3cdb-a11e-4500d50a4879",
                                        "glosses": [
                                            "Speisekartoffel: Sortenname: Edelstein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031c3c94-1c64-493a-8c43-3206f8447744",
                                                "sense_id": "caa14be4-d0f6-3945-9dec-a2a30fcfcb8e",
                                                "text": "Edelstein, ist eine Kartoffelsorte, der 2002 offiziell von der Bundessortenamt zugelassen wurde. Die Schalenfarbe ist gelb, die Fleischfarbe ist gelblich. Verwendet wird der Edelstein als Speisekartoffel, gut geeignet als Pommes frites. Auch industriell wird die Kartoffelsorte Edelstein verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92fb00e2-8b91-4cd0-bf8f-301a3a43ecbd",
                        "source_entry_id": "430dc03c-d489-3fb3-85b6-4aabe1979177",
