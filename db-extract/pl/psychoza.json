                                "sense_id": "476a157d-e2bb-3d68-8242-efcd1eb0271d",
                                "text": "Z powodu swojej przewlekłej psychozy trafił do szpitala psychiatrycznego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8a2cac96-8e53-3d2b-b8ef-8b4bea2508b7",
                        "entry_id": "8fd80ad5-2f11-374e-9dd1-6fcc38f39856",
                        "glosses": [
                            "skłonność do ulegania intensywnym emocjom, nastrojom, szczególnie szerzącym się w jakiejś zbiorowości"
                        ],
