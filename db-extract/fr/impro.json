                "senses": [
                    {
                        "sense_id": "ade5953d-f65e-3f40-b9ab-bc9577debcc1",
                        "entry_id": "659922f2-1d66-319b-ae86-8f40c9d66d61",
                        "glosses": [
                            "Improvisation."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6bbe5d2c-0d2e-43b6-8eb9-0b9c9bfe6b69",
                                "sense_id": "ade5953d-f65e-3f40-b9ab-bc9577debcc1",
                                "text": "J’ai eu un trou. Une absence. En impro, ça arrive, on se laisse facilement emporter."
                            },
                            {
                                "example_id": "10485f8b-06c3-4ecc-bce1-fefdddc1e19c",
                                "sense_id": "ade5953d-f65e-3f40-b9ab-bc9577debcc1",
                                "text": "Ils seront accompagnés par le musicien Sammy Pelgris de la compagnie Aline qui improvisera sa musique selon les thèmes d’impro."
                            },
                            {
                                "example_id": "dff3dd1e-3f84-4606-b1b5-40f819546380",
                                "sense_id": "ade5953d-f65e-3f40-b9ab-bc9577debcc1",
                                "text": "L’athlète s’est même payé le luxe d’une impro avec l’acteur Pascal Légitimus, lui aussi invité dans un épisode."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b83c8c05-2813-3270-86a2-90a370d5f651",
                "word": "IMPRO",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "16ebc24c-a5d2-486e-bfa5-c576b481ea9e",
                        "entry_id": "b83c8c05-2813-3270-86a2-90a370d5f651",
                        "tags": [],
                        "form": "IMPro"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7e1b2ab-6dde-3cc2-a279-09e6b1fc303b",
                        "entry_id": "b83c8c05-2813-3270-86a2-90a370d5f651",
                        "glosses": [
                            "En France, type d’établissement qui préparait à la vie professionnelle et était destiné aux adolescents ayant des problèmes intellectuels, sensoriels ou cognitifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "248aeefe-423d-450d-8273-5a79d268ac3c",
                                "sense_id": "b7e1b2ab-6dde-3cc2-a279-09e6b1fc303b",
                                "text": "Si le retard mental ne permet pas une scolarité normale, plusieurs types d’institutions peuvent les accueillir : les IME (instituts médicoéducatifs), les hôpitaux de jour, les IMPRO (internats médicoprofessionnels), etc."
                            },
                            {
                                "example_id": "15a2d66d-30eb-46c3-8077-370489c219c8",
                                "sense_id": "b7e1b2ab-6dde-3cc2-a279-09e6b1fc303b",
                                "text": "A l’IMPRO, l’objectif est de préparer les adolescents à la vie adulte."
                            },
                            {
                                "example_id": "e7d11862-53cc-48fc-91f9-708157a9fbdf",
                                "sense_id": "b7e1b2ab-6dde-3cc2-a279-09e6b1fc303b",
                                "text": "Possibilité d’entrée à l’IMPRO à 19 ans et plus."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0674bfcf-9641-355e-a9d4-486a303753ab",
                "word": "IMPro",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ded4f37b-68df-422b-9dd4-99c051f8e168",
                        "entry_id": "0674bfcf-9641-355e-a9d4-486a303753ab",
                        "tags": [],
                        "form": "IMPRO"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d222786-d65a-3d19-8db3-ab761378201c",
                        "entry_id": "0674bfcf-9641-355e-a9d4-486a303753ab",
                        "glosses": [
                            "En France, type d’établissement qui préparait à la vie professionnelle et était destiné aux adolescents ayant des problèmes intellectuels, sensoriels ou cognitifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69068cb7-d0cc-4736-87c9-65ffcb96e77a",
                                "sense_id": "5d222786-d65a-3d19-8db3-ab761378201c",
                                "text": "Les instituts médico-éducatifs (IME) regroupent les anciens instituts médico-pédagogiques (IMP) et les anciens instituts médico-professionnels (IMPro)."
                            },
                            {
                                "example_id": "c7c36bb7-df1f-48f2-9cfb-d6caba9d677c",
                                "sense_id": "5d222786-d65a-3d19-8db3-ab761378201c",
                                "text": "L’IMPro le Manoir accompagne les adolescents accueillis dans leur insertion sociale et professionnelle."
                            },
                            {
                                "example_id": "d375b24e-fd6b-45fb-a861-adcd06e756db",
                                "sense_id": "5d222786-d65a-3d19-8db3-ab761378201c",
                                "text": "En accord avec la loi, l’IMPro a décidé d’externaliser l’Unité d'Enseignement et de l’inscrire au sein d’écoles ordinaires (collèges, lycées)."
                            }
                        ]
                    }
                ],
