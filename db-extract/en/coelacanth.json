                    }
                ],
                "senses": [
                    {
                        "sense_id": "f529f24a-62e7-30b3-a5f6-870e59e12a9d",
                        "entry_id": "ea9aed15-ba4d-3cad-a79c-066d938cb924",
                        "glosses": [
                            "Any of the class Actinistia of primitive lobe-finned fish, thought to have been extinct for 70 million years until a living specimen was discovered in 1938. Most species are large and plump and they all have bodies covered in tough elasmoid scales that act as armor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a6f082-e831-48e5-a00d-237cbeb05baf",
                                "sense_id": "f529f24a-62e7-30b3-a5f6-870e59e12a9d",
                                "text": "Among them were ancient relatives of the piranhas and those popular aquarium fish the tetras, along with garfish and freshwater coelacanths, known as mawsonids."
                            }
                        ]
                    },
                    {
                        "sense_id": "691f9a66-19f9-3f7d-81b0-466a04987731",
                        "entry_id": "ea9aed15-ba4d-3cad-a79c-066d938cb924",
                        "glosses": [
                            "Any of the class Actinistia of primitive lobe-finned fish, thought to have been extinct for 70 million years until a living specimen was discovered in 1938. Most species are large and plump and they all have bodies covered in tough elasmoid scales that act as armor.",
                            "Either of the two extant species in this group; the West Indian Ocean coelacanth (Latimeria chalumnae) or the Indonesian coelacanth (Latimeria menadoensis)."
                        ],
                        "tags": [
                            "in particular"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab3b954c-9882-4fd7-a8ed-e152b5e96b7f",
                        "source_entry_id": "ea9aed15-ba4d-3cad-a79c-066d938cb924",
                        "source_sense_description": "either of two species of deep-water fish",
                        "target_lang_word": "cœlacanthe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cœlacanthe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abec36fc-ed35-3e34-bfb8-347e42589233",
                                        "entry_id": "20f4b46a-b427-386b-a460-b8a3f4984901",
                                        "glosses": [
                                            "Poisson actinistien, apparu au Dévonien, connu en tant que fossile avant d’être découvert vivant par l’ornithologue sud-africaine Marjorie Courtenay-Latimer en 1938 (genre Latimeria pour les spécimens actuels)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc935334-fd28-4755-be52-c3ca08985792",
                                                "sense_id": "abec36fc-ed35-3e34-bfb8-347e42589233",
                                                "text": "Le cœlacanthe n’a presque pas changé depuis des centaines de millions d’années. L’ADN de ce proche parent des premiers poissons qui sont sortis de l’eau vient d’être séquencé."
                                            },
                                            {
                                                "example_id": "2b3f56ff-c24a-43b7-a35f-a5a3d36801f2",
                                                "sense_id": "abec36fc-ed35-3e34-bfb8-347e42589233",
                                                "text": "Il existe un poisson nommé cœlacanthe qui a le pouvoir de s’éteindre pendant des années si son biotope devient trop hostile : il se laisse gagner par la mort en attendant les conditions de sa résurrection. Sans le savoir, Épicène recourut au stratagème du cœlacanthe. Elle commit ce suicide symbolique qui consiste à se mettre entre parenthèses. Ce meurtre invisible est beaucoup plus fréquent qu’on ne le croit. Comme on ne l’identifie pas pour ce qu’il est, on y voit en général un signe avant-coureur de l’adolescence."
                                            },
                                            {
                                                "example_id": "ab1916b6-efb5-4292-9144-39a0a9e2501d",
                                                "sense_id": "abec36fc-ed35-3e34-bfb8-347e42589233",
                                                "text": "plus rien ne me retient\nde l’oubli\nses écluses\npuis la mer\nla mer avec ses cœlacanthes\nrevenus du précambrien"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3975060-10ec-4482-af1e-9a1e15e6853d",
                        "source_entry_id": "ea9aed15-ba4d-3cad-a79c-066d938cb924",
                        "source_sense_description": "either of two species of deep-water fish",
                        "target_lang_word": "Quastenflosser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quastenflosser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                        "entry_id": "244f9d68-bca9-3947-8b1a-9e035679fb97",
                                        "glosses": [
                                            "Knochenfisch mit quastenförmigen Flossen (Latimeria)"
                                        ],
                                        "tags": [
                                            "speziell Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e0a331c-9875-46f9-baf1-62e141ec3337",
                                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                                "text": "Die Quastenflosser hielt man lange Zeit für bereits ausgestorben."
                                            },
                                            {
                                                "example_id": "829f049a-968b-4294-9d84-68f20e92cf2b",
                                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                                "text": "Wissenschaftler haben 2012 das Genom des Quastenflossers sequenziert und dabei festgestellt, dass er nicht das Brückentier zwischen Fisch und Landtier ist."
                                            },
                                            {
                                                "example_id": "3b6acb01-7744-48d1-93ed-7930b18da4e4",
                                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                                "text": "„Das Ei des Quastenflossers (Latimeria chalumnae) hat einen Durchmesser von 9 cm und wiegt 300 g.“"
                                            },
                                            {
                                                "example_id": "2016f9e1-8d93-4857-9f46-5689afd70a10",
                                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                                "text": "„Auf Lateinisch nennen ihn die Zoologen »Coelacanthus«, auf Deutsch Hohlstachler, weil die Flossenstrahlen im Schwanz hohl sind, oder Quastenflosser, weil die Flossen wie Quasten aussehen.“"
                                            },
                                            {
                                                "example_id": "1e12db5b-f487-46d9-b272-0e3d34baf104",
                                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                                "text": "„1987 entstanden so die ersten Bilder von Quastenflossern in ihrem natürlichem Lebensraum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
