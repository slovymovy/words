                            }
                        ]
                    },
                    {
                        "sense_id": "ef1d6ecf-ed3f-33f7-9e0e-e7293433cc7b",
                        "entry_id": "e4e959de-cb0b-3c16-aa63-9803a33518ac",
                        "glosses": [
                            "short for Löffelchenstellung (“spooning, spoon position, kind of sleeping [or sex] position”)"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "neuter",
                            "strong",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b40387-66e4-4e8d-860b-c2a2618c3f70",
                                "sense_id": "ef1d6ecf-ed3f-33f7-9e0e-e7293433cc7b",
                                "text": "Im zehnten Beziehungsjahr schlafen die Eheleute „jeden Abend Löffelchen“ ein – und fallen sich tagsüber schrecklich auf die Nerven.",
                                "translation": "In the tenth year of the relation, the spouses fall asleep \"every night in spoon position\" – and terribly get on each other's nerves during the day.",
