                    {
                        "sense_id": "b80e29c0-53a6-3205-9932-2e016bbb6ef4",
                        "entry_id": "fec518e0-1d69-3d77-800d-58353254678f",
                        "glosses": [
                            "A nonsense word commonly used in YouTube Poop by playing an audio clip forward and in reverse consecutively; said in reference to this editing style, and to describe palindromes and humorously symmetrized images."
                        ],
                        "tags": [
                            "Internet",
                            "humorous",
                            "nonce-word"
                        ],
                        "examples": [
                            {
                                "example_id": "bd7c6df1-d5d6-4294-a4ce-5a682974aae5",
                                "sense_id": "b80e29c0-53a6-3205-9932-2e016bbb6ef4",
                                "text": "she JOJ on my SOS til i LOL"
                            },
                            {
                                "example_id": "663f4314-5604-4059-818b-a4ca2214be56",
                                "sense_id": "b80e29c0-53a6-3205-9932-2e016bbb6ef4",
                                "text": "Saw this poster in the wild today and instinctively laughed out loud because like. That’s the Joj. The SoS. From my YTPs."
                            },
                            {
                                "example_id": "0f1c4840-0792-4bb7-8c08-9aa76e4f5c66",
                                "sense_id": "b80e29c0-53a6-3205-9932-2e016bbb6ef4",
                                "text": "#the JoJ burger.... with extra Sos"
                            },
                            {
                                "example_id": "b85d8e5f-7e4c-4b0e-811c-1d66740fa022",
                                "sense_id": "b80e29c0-53a6-3205-9932-2e016bbb6ef4",
                                "text": "Whoa! What is Flelf [Yu-Gi-Oh! trading card] doing on the field? You know this is actually a retrain? The original card is called Sos."
                            }
                        ]
                    }
