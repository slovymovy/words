        "fr-extract.jsonl": [
            {
                "entry_id": "cd5c0703-9cf9-3e4c-838a-c79e5fc37e87",
                "word": "sciemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                        "entry_id": "cd5c0703-9cf9-3e4c-838a-c79e5fc37e87",
                        "glosses": [
                            "Avec pleine connaissance de ce que l’on fait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "341a06cf-413d-4392-8a66-47e45e288f87",
                                "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                                "text": "Les généraux renégats sont les représentants d'une classe qui, pour survivre en tant que telle, a renoncé à la nation chilienne et est sciemment devenue l'alliée de l'impérialisme nord-américain."
                            },
                            {
                                "example_id": "da2ad3c6-7453-49c2-8d74-21b2b30870db",
                                "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                                "text": "À quatre heures de l’après-midi, nous étions sur nos lits, attendant le dîner, mot aussi creux que nos estomacs, car il n’y avait à peu près rien à manger, les paysans affamant sciemment les succursales de l’Intourist, dont dépendait notre hôtel."
                            },
                            {
                                "example_id": "2e4275a9-39d6-4704-acb4-808e071489bb",
                                "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                                "text": "Depuis fort longtemps, « on » oppose le Christianisme à l'Islam ! Depuis fort longtemps, « on » arbore les valeurs chrétiennes comme supérieures aux valeurs musulmanes en omettant sciemment les legs de ces dernières aux premières."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11971d00-2529-4603-929b-b4c648246aa3",
                        "source_entry_id": "cd5c0703-9cf9-3e4c-838a-c79e5fc37e87",
                        "source_sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                        "target_lang_word": "wissentlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wissentlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1a8c6c7-7c80-363f-89b4-ccf56f6c93d8",
                                        "entry_id": "3a652992-45da-3367-a582-49356d6d5e75",
                                        "glosses": [
                                            "die Auswirkung seiner Handlung wollend; mit Absicht, Vorsatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0735de-eba6-4091-b224-78fe1b5eb2c7",
                                                "sense_id": "a1a8c6c7-7c80-363f-89b4-ccf56f6c93d8",
                                                "text": "Er hatte wissentlich die Vase seiner Großmutter fallen lassen."
                                            },
                                            {
                                                "example_id": "e37235b2-3f17-49e6-a26f-45e4a075b13e",
                                                "sense_id": "a1a8c6c7-7c80-363f-89b4-ccf56f6c93d8",
                                                "text": "„Spitzenvertreter der amerikanischen Geheimdienste hatten zunächst öffentlich stets darauf bestanden, die NSA habe niemals wissentlich Informationen über Amerikaner gesammelt.“"
                                            },
                                            {
                                                "example_id": "0d61b9f3-5291-4336-8d2c-ebb35bbf63ce",
                                                "sense_id": "a1a8c6c7-7c80-363f-89b4-ccf56f6c93d8",
                                                "text": "„Ein Geschäftsmann wirft ihm nun wissentliche Falschaussage vor.“"
                                            },
                                            {
                                                "example_id": "17d27993-f3c0-4b82-bfd3-4f4942f51176",
                                                "sense_id": "a1a8c6c7-7c80-363f-89b4-ccf56f6c93d8",
                                                "text": "„Im Februar hatte das Unternehmen von ‚wissentlichen Verstößen gegen gesetzliche Vorschriften‘ berichtet, die bei der Prüfung des Konzernabschlusses für 2005 zu Tage getreten seien, und Strafanzeige angekündigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31823a8d-8df4-4c36-a667-3b25a71802a4",
                        "source_entry_id": "cd5c0703-9cf9-3e4c-838a-c79e5fc37e87",
                        "source_sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                        "target_lang_word": "knowingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knowingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5359215c-7e44-3d11-b742-a287bc5d7f26",
                                        "entry_id": "b6b19b0b-7869-3008-bb62-1ed30f44390f",
                                        "glosses": [
                                            "In the manner of one who knows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27a087b-1943-4de5-89e0-c284a1dc3eb2",
                                                "sense_id": "5359215c-7e44-3d11-b742-a287bc5d7f26",
                                                "text": "She smiled knowingly, but kept the secret."
                                            },
                                            {
                                                "example_id": "d78cdcf8-4af1-48ab-a081-08a00308551a",
                                                "sense_id": "5359215c-7e44-3d11-b742-a287bc5d7f26",
                                                "text": "He pursed his lips knowingly and winked exaggeratedly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7bc48fa-18ec-3a21-9617-038bcdd6ea9a",
                                        "entry_id": "b6b19b0b-7869-3008-bb62-1ed30f44390f",
                                        "glosses": [
                                            "With knowledge of all relevant facts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3356774e-59fb-42f5-b42f-00b5d7212423",
                                                "sense_id": "d7bc48fa-18ec-3a21-9617-038bcdd6ea9a",
                                                "text": "She would never knowingly pour any pollutant down the drain."
                                            },
                                            {
                                                "example_id": "9645fc55-c80c-40da-891b-f127452d052f",
                                                "sense_id": "d7bc48fa-18ec-3a21-9617-038bcdd6ea9a",
                                                "text": "We keep our prices low and are never knowingly undersold."
                                            },
                                            {
                                                "example_id": "272dca7e-7ca1-4092-bc00-73e3ad93a87e",
                                                "sense_id": "d7bc48fa-18ec-3a21-9617-038bcdd6ea9a",
                                                "text": "The real bombshell it contains is not the confidence of the spy agencies that Russia hoped to subvert American democracy. It is that US intelligence experts effectively confirmed that for the second election in a row, Trump acolytes repeatedly used, knowingly or otherwise, misinformation produced by the spies of one of America’s most sworn foreign adversaries to try to win a US election."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0754c53-dddc-439d-9a01-b443e4145e0b",
                        "source_entry_id": "cd5c0703-9cf9-3e4c-838a-c79e5fc37e87",
                        "source_sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                        "target_lang_word": "deliberately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deliberately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                        "entry_id": "42cfed69-0936-3a52-820c-dc009339b4db",
                                        "glosses": [
                                            "Intentionally, or after deliberation; not accidentally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab75e1f-1903-43d3-a918-c83055f70cee",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "He deliberately broke that, didn't he?"
                                            },
                                            {
                                                "example_id": "fed1fd58-a2d6-4855-972a-93f84ff009f0",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "Major funding for this book was made possible by deliberately starving a family of four in Tennessee."
                                            },
                                            {
                                                "example_id": "3c4bf725-812b-4daf-a095-03ece4419ba7",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "“As a result, OCR found that the district’s pattern of inconsistent responses to reports it received of sexual harassment – infrequently responding under Title IX or not responding at all – rose to the level that the district’s response to some families’ sexual harassment reports was deliberately indifferent to students’ civil rights,” a news release from DOE reads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9793113-f44f-33ad-a757-951c6e41f58c",
                                        "entry_id": "42cfed69-0936-3a52-820c-dc009339b4db",
                                        "glosses": [
                                            "Taking one's time, slowly and carefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12512be0-345b-4ad3-91eb-9079027ca084",
                                                "sense_id": "f9793113-f44f-33ad-a757-951c6e41f58c",
                                                "text": "After being called upon, he strode deliberately up to the blackboard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6590e17-c687-4fcc-8692-178221da70cc",
                        "source_entry_id": "cd5c0703-9cf9-3e4c-838a-c79e5fc37e87",
                        "source_sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
