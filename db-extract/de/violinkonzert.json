                "senses": [
                    {
                        "sense_id": "50f46a48-8d33-3544-ba8c-bbaba4d5809f",
                        "entry_id": "c52365b6-673e-3f36-beeb-85f4e65a5c97",
                        "glosses": [
                            "ein Solokonzert, in dem das Soloinstrument Violine vom Orchester begleitet wird"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "4e7240f7-c401-4e48-9ab6-d4ba70ae72b4",
                                "sense_id": "50f46a48-8d33-3544-ba8c-bbaba4d5809f",
                                "text": "„Mendelssohn eröffnet mit diesem Werk die Serie der großen romantischen Violinkonzerte.“"
                            },
                            {
                                "example_id": "422f8c0b-a85d-4e76-8b43-2183ac2ab7cb",
                                "sense_id": "50f46a48-8d33-3544-ba8c-bbaba4d5809f",
                                "text": "„Almuth hatte inzwischen den Schallplattenapparat laut werden lassen: Das dritte Violinkonzert von Mozart, mit Yehudi Menuhin und dem Orchestre de Paris; eine Aufnahme von 1935.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
