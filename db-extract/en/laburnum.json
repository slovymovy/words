    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d69440ff-6ce3-3f4d-8a1d-3268b6083fc2",
                "word": "laburnum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2399a54b-3107-43fb-85a8-0e5e5801aee8",
                        "entry_id": "d69440ff-6ce3-3f4d-8a1d-3268b6083fc2",
                        "tags": [
                            "plural"
                        ],
                        "form": "laburnums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5d81319-3281-3404-acfe-0772bb272cef",
                        "entry_id": "d69440ff-6ce3-3f4d-8a1d-3268b6083fc2",
                        "glosses": [
                            "Any tree of the genus Laburnum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1f8801-3902-428a-98b8-9c6b3bfad8b9",
                                "sense_id": "b5d81319-3281-3404-acfe-0772bb272cef",
                                "text": "[…] Lord Henry Wotton could just catch the gleam of the honey-sweet and honey-coloured blossoms of a laburnum, whose tremulous branches seemed hardly able to bear the burden of a beauty so flame-like as theirs[.]"
                            },
                            {
                                "example_id": "1257f093-a5f9-4f9e-ae0d-25b317ac227a",
                                "sense_id": "b5d81319-3281-3404-acfe-0772bb272cef",
                                "text": "The trees began to come fully alive. The larches and birches were covered with green, the laburnums with gold."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "649a9e35-41b4-4754-bd6d-e8629f9ac13d",
                        "source_entry_id": "d69440ff-6ce3-3f4d-8a1d-3268b6083fc2",
                        "source_sense_id": "b5d81319-3281-3404-acfe-0772bb272cef",
                        "source_sense_description": "any tree of genus Laburnum",
                        "target_lang_word": "cytise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cytise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "933e174b-3218-3fc3-904f-b1b0dc0d249f",
                                        "entry_id": "0281a8f7-7ab7-3132-8313-d087fb69945a",
                                        "glosses": [
                                            "Nom désignant plusieurs espèces d’arbres appartenant à des genres différents mais tous de la famille de Fabacées : Argyrolobium, Calicotome, Cytisus, Cytisophyllum, Erinacea, Laburnum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da9e9152-1011-3334-873b-aeb0a065410c",
                                        "entry_id": "0281a8f7-7ab7-3132-8313-d087fb69945a",
                                        "glosses": [
                                            "Plante de la famille des Fabacées dont une espèce remarquable par l’élégance de ses fleurs est cultivée dans nos jardins sous le nom de faux ébénier , et dont le nom scientifique de genre est Laburnum anagyroides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82821df-9dc6-463e-a349-2df7a14ed9c9",
                                                "sense_id": "da9e9152-1011-3334-873b-aeb0a065410c",
                                                "text": "Les grands cytises des Alpes font également un très bel effet par leurs belles grappes de fleurs jaunes pendantes."
                                            },
                                            {
                                                "example_id": "7fa3ceb0-1459-43aa-8c11-717ab54255a4",
                                                "sense_id": "da9e9152-1011-3334-873b-aeb0a065410c",
                                                "text": "Il reprit ses bagages et sortit. Elle vit sa longue forme rustique disparaître derrière les cytises du jardin."
                                            },
                                            {
                                                "example_id": "6075a32c-6f06-4637-9897-fcfd26ed76b5",
                                                "sense_id": "da9e9152-1011-3334-873b-aeb0a065410c",
                                                "text": "Je marche sur le sol sec et poudreux ; la brise\nFait danser et tourner la cosse du cytise."
                                            },
                                            {
                                                "example_id": "ce5d0f5b-1503-46ee-bc3c-42780cc9b857",
                                                "sense_id": "da9e9152-1011-3334-873b-aeb0a065410c",
                                                "text": "Les vacances de Pâques s’achevèrent ; dans les jardins de l’École normale, fleuris de lilas, de cytises et d’épine rouge, je me retrouvai avec plaisir au milieu de mes camarades."
                                            },
                                            {
                                                "example_id": "f2d38609-9bdd-4b69-bd76-2c8b9bd957c9",
                                                "sense_id": "da9e9152-1011-3334-873b-aeb0a065410c",
                                                "text": "Il y avait des piscines, des fontaines et des parterres de fleurs au désordre méticuleusement étudié : des hibiscus écarlates, des cytises d’un jaune éclatant, des gardénias saphir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
