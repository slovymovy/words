                                "target_senses": [
                                    {
                                        "sense_id": "143b91ca-75be-3e2e-962b-484b3f03b077",
                                        "entry_id": "bd8df531-f3e3-3108-ad7d-4e4867fee9aa",
                                        "glosses": [
                                            "farbloses, geruchloses, brennbares Gas, deren Moleküle aus drei Kohlenstoff- und acht Wasserstoffatomen bestehen"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f25aec-1b9d-45b0-952f-872f2fb7c6e1",
                                                "sense_id": "143b91ca-75be-3e2e-962b-484b3f03b077",
                                                "text": "Propan wird aus Erdgas gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "facc9744-fdd2-4eee-8532-ed8507c4c7a4",
                        "source_entry_id": "0675fe78-7e50-39ac-9f96-42fa14fd8deb",
                        "source_sense_id": "c1b89562-64f7-3f5c-8a09-21ae2543cefc",
                        "target_lang_word": "Propangas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Propangas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "495d2f26-b6a8-3195-8167-be9a1187f69a",
                                        "entry_id": "473246cd-049a-3432-acec-9eec2f2add7b",
                                        "glosses": [
                                            "farbloses, geruchloses, brennbares Gas, dessen Moleküle aus drei Kohlenstoff- und acht Wasserstoffatomen besteht"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "747fc3a8-d74a-416e-9288-6801342f6175",
                                                "sense_id": "495d2f26-b6a8-3195-8167-be9a1187f69a",
                                                "text": "„Wird eine Gasflasche hingegen im Keller gelagert, wovon Flacher dringend abrät, kann das Propangas, das schwerer ist als Luft, einen See bilden und sich durch einen einzigen Funken entzünden.“"
                                            },
                                            {
                                                "example_id": "44e62f19-f69a-4693-aa94-8e3f68b31773",
                                                "sense_id": "495d2f26-b6a8-3195-8167-be9a1187f69a",
                                                "text": "„Sowohl auf der ‚Darwin‘ als auch auf den Liefer- und Verteilerschiffen muß das Propangas auf minus 40 Grad gehalten werden, damit es flüssig bleibt und umgeladen werden kann.“"
                                            },
                                            {
                                                "example_id": "65be2114-f510-409a-9cb4-6dc61ab9913e",
                                                "sense_id": "495d2f26-b6a8-3195-8167-be9a1187f69a",
                                                "text": "„Ihre Touristenbusse wurden schon vor 20 Jahren auf Propangas umgerüstet, ihre Amphibienfahrzeuge fahren mit Biodiesel.“"
                                            },
                                            {
                                                "example_id": "46b0a90b-c005-4bf4-8a6f-7216a5b4e6d5",
                                                "sense_id": "495d2f26-b6a8-3195-8167-be9a1187f69a",
                                                "text": "„Diesel, Benzin und Propangas fließen wieder: Israel reagiert auf internationalen Druck und will Treibstoff in den Gazastreifen pumpen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92730202-8d4d-4e43-b2a7-c9306f556ad2",
                        "source_entry_id": "0675fe78-7e50-39ac-9f96-42fa14fd8deb",
