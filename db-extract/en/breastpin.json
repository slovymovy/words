                        "glosses": [
                            "An ornamental pin attached to clothing in a person's upper chest area; a brooch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46c5601-e8b3-44cc-a47f-f5fac2e18b89",
                                "sense_id": "741164e5-889b-3209-a955-c4637d1e8790",
                                "text": "Mark on that nose the colour left by too copious port and viands; to which the profuse cravat with exorbitant breastpin, and the fixed, forward, and as it were menacing glance of the eyes correspond."
                            },
                            {
                                "example_id": "4e02c9a3-59bf-45ff-a9c2-a31ecab354b0",
                                "sense_id": "741164e5-889b-3209-a955-c4637d1e8790",
                                "text": "A sprig of white flowers was in her light wavy hair, and another fastened by her breastpin drooped over her bosom."
                            }
                        ]
                    }
