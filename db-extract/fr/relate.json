                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0728d041-1eb1-3e49-834c-e0e7aff08e0e",
                                        "entry_id": "ba8b4985-3083-36f1-8fd3-905aaaaf8978",
                                        "glosses": [
                                            "To respond through reaction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3eeb427-0f33-387f-9d57-ee1ccbee8859",
                                        "entry_id": "ba8b4985-3083-36f1-8fd3-905aaaaf8978",
                                        "glosses": [
                                            "To identify with; to understand."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4598d637-ba88-4129-a489-a0830d56113e",
                                                "sense_id": "d3eeb427-0f33-387f-9d57-ee1ccbee8859",
                                                "text": "I find it difficult to relate to others because I'm extremely introverted."
