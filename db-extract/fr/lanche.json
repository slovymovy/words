                    {
                        "sense_id": "22d57ac5-aa38-3ea1-8e62-dbc9d26558f0",
                        "entry_id": "f53b0b4d-06bf-3bb2-80ff-56f2f3b92a03",
                        "glosses": [
                            "Petit bateau de faible tirant dʼeau muni de deux mâts gréant chacun une voile carrée."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "2e62adaf-5751-4542-93e7-f7faf3c3f558",
                                "sense_id": "22d57ac5-aa38-3ea1-8e62-dbc9d26558f0",
                                "text": "M. du Quesne me donne avis qu'il serait nécessaire d'avoir, à la suite des escadres, quelques lanches ou doubles felouques qui sont propres pour porter les avis."
                            },
                            {
                                "example_id": "fdcbbe8c-e4d4-4f5d-821e-4f276eb379c7",
                                "sense_id": "22d57ac5-aa38-3ea1-8e62-dbc9d26558f0",
                                "text": "Il consacra ses premières économies à lʼachat dʼune lanche (bateau), sur laquelle il parcourut les divers affluents de lʼAmazone, échangeant ses marchandises contre de la borracha (caoutchouc) et les autres produits de la selve amazonienne quʼil revendait à Para."
                            },
                            {
                                "example_id": "49b50693-515e-43c3-a930-0c6802a9cbdd",
                                "sense_id": "22d57ac5-aa38-3ea1-8e62-dbc9d26558f0",
                                "text": "Le lendemain, j’ai traversé le détroit à bord d’une lanche chargée à ras bord de bonbonnes de gaz."
                            }
                        ]
                    }
                ],
