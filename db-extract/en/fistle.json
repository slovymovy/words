                        "entry_id": "ba291b78-3a11-39fd-969f-fd92c35110a0",
                        "glosses": [
                            "To rustle; to make a slight rustling (or whistling sound)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56747f3c-08be-4ba7-b602-b7188ed546f7",
                                "sense_id": "8bca7703-93ae-36ea-b2e4-54631eee8e51",
                                "text": "[…] they both plainly heard a fistling within."
                            },
                            {
                                "example_id": "ad2f112a-dadd-4abd-8e0d-dd0ef745ba06",
                                "sense_id": "8bca7703-93ae-36ea-b2e4-54631eee8e51",
                                "text": "It might be about midnight, when I was awoke by a sort of fistling noise at the head of my couch. It seemed as though something was scratching and stirring about the fern which formed my pillow."
                            },
                            {
                                "example_id": "506f77ef-95da-4f94-a8f8-b84d0956db6a",
                                "sense_id": "8bca7703-93ae-36ea-b2e4-54631eee8e51",
                                "text": "... untroubled in the meadows, the rooks were tossing about over the heath, the sparrows were visiting from tree to tree, and the dead leaves were fistling in troops down the lanes as if returning gay, in companies, from the funeral of Summer."
                            },
                            {
                                "example_id": "e078e97c-ea61-45cd-8dfa-deb272b935b1",
                                "sense_id": "8bca7703-93ae-36ea-b2e4-54631eee8e51",
                                "text": "The thing began to fistle among the straw in the cradle."
                            }
                        ]
                    }
