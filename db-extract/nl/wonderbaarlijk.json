                ],
                "senses": [
                    {
                        "sense_id": "07dc7f18-6550-39fd-a5c0-ceec25edc3f1",
                        "entry_id": "49eba774-c0e6-37db-a1c3-a6080d1bcd2e",
                        "glosses": [
                            "iets wat bijna niet te geloven is, iets wat lijkt op een wonder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa76a8e-4682-4e6a-aa11-00e27e789efd",
                                "sense_id": "07dc7f18-6550-39fd-a5c0-ceec25edc3f1",
                                "text": "Een wonderbaarlijk voorval heb ik vandaag meegemaakt."
                            },
                            {
                                "example_id": "8d9e5546-92b3-41b7-85d6-3ff03e8c17c5",
                                "sense_id": "07dc7f18-6550-39fd-a5c0-ceec25edc3f1",
                                "text": "Vandaag keek hij vanzelfsprekend niet meer zo tegen de dingen aan. Hij wist dat de oorlog niets anders was dan een reusachtige loterij met levensechte kogels, waarin vier jaar overleven aan het wonderbaarlijke grensde."
                            },
                            {
                                "example_id": "49eb320f-0d1f-44bf-a6f8-419710da74ef",
                                "sense_id": "07dc7f18-6550-39fd-a5c0-ceec25edc3f1",
                                "text": "Niet één aanwezige kon een andere indruk krijgen dan dat de zaken fantastisch gingen, misschien op de grens van het wonderbaarlijke."
                            },
                            {
                                "example_id": "bc750d4a-e003-429a-ae19-b3213a246903",
                                "sense_id": "07dc7f18-6550-39fd-a5c0-ceec25edc3f1",
                                "text": "De eerste stap op weg naar heiligheid is zaligverklaring. Om zalig te worden is er een wonder nodig. Meestal is dat een wonderbaarlijke genezing, waarbij er diepgravend medisch onderzoek plaatsvindt om uit te zoeken of de genezing echt onverklaarbaar is. De Kerk gaat daarbij niet over één nacht ijs."
                            }
                        ]
                    }
