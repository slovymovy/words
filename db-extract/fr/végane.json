                ],
                "senses": [
                    {
                        "sense_id": "243e7891-df14-301d-b4f5-822271118f4d",
                        "entry_id": "7ccf9194-bb04-33a8-a9be-9f5695281715",
                        "glosses": [
                            "Variante de végan."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "036f7152-6d83-4979-9f14-933a411a70ad",
                                "sense_id": "243e7891-df14-301d-b4f5-822271118f4d",
                                "text": "J’estime également qu’il ne faut pas consommer de produits vendus par des sociétés qui commercialisent des produits véganes mais qui appartiennent à des groupes non véganes."
                            },
                            {
                                "example_id": "d2933bc6-bc5a-4fec-8a92-a6adb2b5e252",
                                "sense_id": "243e7891-df14-301d-b4f5-822271118f4d",
                                "text": "Or, « près de 20 % de la population serait en déficit, en particulier les personnes végétariennes ou véganes et les personnes âgées », note Thierry Soucar."
                            },
                            {
                                "example_id": "d56b756a-9b57-47fe-8ffb-5db1b7cd82dc",
                                "sense_id": "243e7891-df14-301d-b4f5-822271118f4d",
                                "text": "Venez découvrir notre nouvelle gamme de cosméto-soin végane, élaborée par des pharmaciens et surtout fabriquée en France !"
                            }
                        ]
                    }
                ],
