                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8be2842b-543e-45c4-a92c-4efec90c617a",
                                                "sense_id": "681169cc-0ede-3045-a563-fb9236d3ef76",
                                                "text": "[B]y those many kings mentioned in the Old Testament, \"thirty and one\" in the little land of Canaan, (Joshua xii. 24,) is meant only toparchs, not great kings, but lords of a little dition and dominion; […]"
                                            },
                                            {
                                                "example_id": "431d9510-0964-4364-8afb-15627d2cf7d7",
                                                "sense_id": "681169cc-0ede-3045-a563-fb9236d3ef76",
                                                "text": "Henry the Eight add[ed] the portcluse to his current money, as a character of his peculiar title to this dition"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
