                        "examples": [
                            {
                                "example_id": "ae52ee24-f326-453a-8b4d-cbab9b33707e",
                                "sense_id": "9f3a983d-8966-3805-b894-5b2c8f5fa007",
                                "text": "Hé, Anquetil, vas-y doucement ! lui cria un rotativiste qui causait avec le concierge."
                            },
                            {
                                "example_id": "2e82e453-1511-4176-a3f3-0585b2b64784",
                                "sense_id": "9f3a983d-8966-3805-b894-5b2c8f5fa007",
                                "text": "Dans un communiqué distinct, le comité inter-CGT regroupant les rotativistes, également majoritaire dans les imprimeries, appelle à une \"non-parution\" des journaux datés du 21 avril, sans parler de mouvement reconductible."
                            },
                            {
                                "example_id": "3121ecc9-1486-44d0-bf49-698c60da8709",
                                "sense_id": "9f3a983d-8966-3805-b894-5b2c8f5fa007",
                                "text": "Avec un rendement de 84 000 exemplaires à l’heure par machine, la rotativiste doit agir vite, au risque d’imprimer des milliers de journaux invendables."
                            }
                        ]
                    }
