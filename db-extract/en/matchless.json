                    },
                    {
                        "form_id": "bcb49acc-2cba-4567-b798-68924aeb0d43",
                        "entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most matchless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                        "entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                        "glosses": [
                            "Having no match; without equal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389fa414-8057-4cc0-b85a-99aa2ddc6970",
                                "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                "text": "[T]he Prince was to declare the victor in the first day's tourney, who should receive as prize a warhorse of exquisite beauty and matchless strength."
                            },
                            {
                                "example_id": "0ac65a0a-b116-4410-84d4-6606c6c2cc5d",
                                "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                "text": "It was not his matchless talent that exalted Koufax beyond his greatest contemporaries so much as it was his knowledge that character was not connected to talent."
                            }
                        ]
                    },
                    {
                        "sense_id": "159011ce-8252-33c8-b0f6-95b78e3b17f4",
                        "entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                        "glosses": [
                            "Having no mate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4419da4b-12ed-40f6-8773-7a671d0a5cae",
                                "sense_id": "159011ce-8252-33c8-b0f6-95b78e3b17f4",
                                "text": "In this comedy, a matchmaker has a matchless daughter. Try as he might, he cannot seem to find anyone for her."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08874e33-fb3e-4e5c-a6ab-7f8e4afd53bb",
                        "source_entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                        "source_sense_description": "without equal",
                        "target_lang_word": "onvergelijkelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onvergelijkelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a861476e-0053-34ed-91d7-1956b227713c",
                                        "entry_id": "72ce0f45-fe31-35cb-910d-6aeeed60deda",
                                        "glosses": [
                                            "zo verschillend van elkaar dat je ze eigenlijk niet met elkaar kunt vergelijken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610af170-71d3-45a3-b32b-223beb60e54b",
                                                "sense_id": "a861476e-0053-34ed-91d7-1956b227713c",
                                                "text": "„In de westerse wereld hebben jullie schaken, maar go is onvergelijkelijk veel subtieler en intellectueler.” Dat zegt de beste go-speler van de afgelopen tien jaar, de Zuid-Koreaan Sedol Lee. Toch is zelfs het millennia oude Aziatische bordspel go niet meer veilig voor de computer. Het computerprogramma AlphaGo heeft de eer voor het eerst een beroepsspeler, drievoudig Europees kampioen Fan Hui, te hebben verslagen. Het werd 5-0 voor de computer in een match van vijf wedstrijden."
                                            }
                                        ]
                                    }
                                ]
