                    }
                ],
                "senses": [
                    {
                        "sense_id": "d45274ee-d9cb-3b2f-a22c-8831d8b592c0",
                        "entry_id": "785bfc24-133b-3b1b-8935-41ea0adb3bc1",
                        "glosses": [
                            "kleiner, beim Menschen etwa u-förmiger Knochen beziehungsweise Knorpel, der sich zwischen Zungenwurzel und Kehlkopf befindet und sowohl die Zunge als auch die umliegende Muskulatur stützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46933e4-d8ea-4618-b41f-0c7a67f6a683",
                                "sense_id": "d45274ee-d9cb-3b2f-a22c-8831d8b592c0",
                                "text": "„Bis zu vier Prozent der Menschen tragen entweder einen überlangen Griffelfortsatz in ihrem Hals, oder das zum Zungenbein verlaufende Band, das aus dem Stylohyoid erwächst, ist verknöchert. Der Knochen kann auf die umliegenden Gefäße und Nerven drücken und so zu Durchblutungsstörungen oder Schmerzen führen.“"
                            },
                            {
                                "example_id": "45d573c8-210d-46bb-8476-3cd887fb6b96",
                                "sense_id": "d45274ee-d9cb-3b2f-a22c-8831d8b592c0",
                                "text": "„Der Kehldeckel ist ein elastisches Knorpelplättchen, das sich an das Zungenbein und die Spannknorpel des Kehlkopfes (…) mittelst elastischer Bänder anheftet, welche ihm, wenn er sich selbst überlassen bleibt, eine solche Stellung zu der Zungenwurzel sichern, dass ihn ein Flüssigkeitsstrom in der Richtung vom Schlund zur Speiseröhre gegen den Kehlkopf umklappt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b411719-c777-4e66-835e-188cb86f2727",
                        "source_entry_id": "785bfc24-133b-3b1b-8935-41ea0adb3bc1",
                        "source_sense_id": "d45274ee-d9cb-3b2f-a22c-8831d8b592c0",
                        "source_sense_description": "u-förmiger Knochen beziehungsweise Knorpel zwischen Zungenwurzel und Kehlkopf",
                        "target_lang_word": "hyoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                        "entry_id": "208c2e0d-5875-319e-99a8-4927749dd257",
                                        "glosses": [
                                            "Shaped like a U, or like the letter upsilon (υ)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f22cca0-6cde-481a-a9eb-0d9472b4b397",
                                                "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                                "text": "This stick has a hyoid shape."
                                            },
                                            {
                                                "example_id": "ca9f4adf-5ff6-480e-b41f-4726afdc3632",
                                                "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                                "text": "The hyoid bone in her throat flutters as if discharging some subvocal rosary."
                                            },
                                            {
                                                "example_id": "b5f2b2f9-93a4-42cb-9808-ccc6fe378113",
                                                "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                                "text": "Beebe referred to these never-before-seen creatures as monsters, as devils and dragons. But he though of their bodies as philosophies, traditions of thought, as schools of dragonism. A college drop-out, he wondered what was to be learned at their great university: An astronesthes with batteries of hells-eye lights on its cheeks, a looped string of twenty lavender glowing beads suspended from its hyoid dewlap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1138d1a6-e5a1-3466-b0d9-7a3fff890467",
                                        "entry_id": "208c2e0d-5875-319e-99a8-4927749dd257",
                                        "glosses": [
                                            "Of or pertaining to the hyoid bone."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hyoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ddfb62-f36f-385d-b4c7-49a4532baf24",
                                        "entry_id": "00f6f8ed-1d36-3a26-ac61-1b0aa49fd7ee",
                                        "glosses": [
                                            "Ellipsis of hyoid bone."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d25b75d8-5a3e-4167-87a2-694c9737ce8f",
                                                "sense_id": "a6ddfb62-f36f-385d-b4c7-49a4532baf24",
                                                "text": "the vulture, relinquishing its title, surely in natural justice gave me a right to this femur, this curiously distorted hyoid?"
                                            }
