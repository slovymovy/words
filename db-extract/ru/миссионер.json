                                    }
                                ]
                            },
                            {
                                "target_word": "missionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a4d3157-3fc2-3a86-a0ae-895ee51ebc36",
                                        "entry_id": "03f90ff8-cfb3-3184-8e72-020256593804",
                                        "glosses": [
                                            "Relating to a (religious) mission."
                                        ],
