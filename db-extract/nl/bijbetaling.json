                                        "sense_id": "6285abdd-419c-310a-88a1-6fcaf7e1e0ff",
                                        "entry_id": "a1518a21-f77d-3240-ba98-edb77b6064bf",
                                        "glosses": [
                                            "An excessive load or burden."
