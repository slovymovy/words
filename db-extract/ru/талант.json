                                "target_senses": [
                                    {
                                        "sense_id": "5b057a9c-7945-39d9-b116-15a55b4d9afa",
                                        "entry_id": "65dc573c-acbe-39dd-952f-0e414ee8db91",
                                        "glosses": [
                                            "die außerordentliche Begabung einer Person in einem bestimmten Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5618a8d-6593-4a0d-a516-5ff9f6ad8c83",
                                                "sense_id": "5b057a9c-7945-39d9-b116-15a55b4d9afa",
                                                "text": "Man muss sein Talent für das Musizieren unbedingt fördern."
                                            },
                                            {
                                                "example_id": "80646082-83d9-406e-9c0c-d48c11861e18",
                                                "sense_id": "5b057a9c-7945-39d9-b116-15a55b4d9afa",
                                                "text": "„Ich kam mit keinem Talent auf die Welt.“"
                                            },
                                            {
                                                "example_id": "e909f537-0253-4e90-97be-932c19907e24",
                                                "sense_id": "5b057a9c-7945-39d9-b116-15a55b4d9afa",
                                                "text": "„Ein von den Musen mit vielen Talenten begabter Künstler, ein Mensch mit allem Hin und Her, Vor und Zurück.“"
                                            },
                                            {
                                                "example_id": "fd23bfef-71a9-41ff-ba31-7aab187c7b97",
                                                "sense_id": "5b057a9c-7945-39d9-b116-15a55b4d9afa",
                                                "text": "„Neben allem anderen zeigen diese Zeilen auch Benns Talent für Freundschaft und sein Faible für originelle Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98ae84f9-763f-35db-9f33-4e33ae24c529",
                                        "entry_id": "65dc573c-acbe-39dd-952f-0e414ee8db91",
                                        "glosses": [
                                            "ein Mensch mit Talent [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6559aa59-c8e0-428b-a7e6-7fc793140559",
                                                "sense_id": "98ae84f9-763f-35db-9f33-4e33ae24c529",
                                                "text": "Es gibt sehr viele unentdeckte Talente auf dieser Welt."
                                            },
                                            {
                                                "example_id": "b0732426-9ab3-431f-8356-bd7b2f517cc0",
                                                "sense_id": "98ae84f9-763f-35db-9f33-4e33ae24c529",
                                                "text": "„Lampe ist ein Talent.“"
                                            },
                                            {
                                                "example_id": "95d49946-6ed9-40ae-a9d8-b4c03e1ea1f4",
                                                "sense_id": "98ae84f9-763f-35db-9f33-4e33ae24c529",
                                                "text": "„Während des Kriegs entwickelte sich der Schachanfänger zu einem vielversprechenden Talent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Talent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a562bbfb-10c5-3b80-8d9c-5abab8e925eb",
                                        "entry_id": "fca596aa-7894-3070-b795-35ecdb59e12c",
                                        "glosses": [
