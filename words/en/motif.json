{
    "word_family": [
        "motivate",
        "motivation",
        "motive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dec955f0-12ab-3718-95ce-22c69cfe79e7",
                    "sense_definition": "A recurring or dominant theme or idea in a work of art or literature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "artistic_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>motif</w> of isolation appears throughout the entire novel.",
                            "target_lang_translations": {
                                "pl": "<w>Motyw</w> izolacji pojawia się w całej powieści."
                            }
                        },
                        {
                            "text": "The artist uses a recurring floral <w>motif</w> in all her paintings.",
                            "target_lang_translations": {
                                "pl": "Artystka używa powracającego kwiatowego <w>motywu</w> we wszystkich swoich obrazach."
                            }
                        }
                    ],
                    "synonyms": [
                        "theme",
                        "subject"
                    ],
                    "common_phrases": [
                        "recurring motif",
                        "central motif"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powracający lub dominujący temat, idea lub element w dziele sztuki lub literaturze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "motyw",
                                "target_lang_sense_clarification": "element tematyczny w literaturze lub sztuce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5501b6f1-9cff-3a05-95d5-bdad8e529b90",
                    "sense_definition": "A decorative figure or shape that is repeated in a design or pattern.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "artistic_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wallpaper features a delicate geometric <w>motif</w>.",
                            "target_lang_translations": {
                                "pl": "Tapeta przedstawia delikatny geometryczny <w>motyw</w>."
                            }
                        },
                        {
                            "text": "She chose a fabric with a traditional <w>motif</w> for the curtains.",
                            "target_lang_translations": {
                                "pl": "Wybrała tkaninę z tradycyjnym <w>motywem</w> na zasłony."
                            }
                        }
                    ],
                    "synonyms": [
                        "pattern",
                        "design"
                    ],
                    "common_phrases": [
                        "decorative motif"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ozdobny element lub kształt powtarzający się w projekcie lub wzorze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "motyw",
                                "target_lang_sense_clarification": "element dekoracyjny lub wzór"
                            },
                            {
                                "target_lang_word": "wzór",
                                "target_lang_sense_clarification": "powtarzalny układ graficzny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc900290-7dbf-33bf-94dd-b952104e5223",
                    "sense_definition": "A short, repeated musical phrase or melodic idea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "artistic_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The symphony begins with a haunting four-note <w>motif</w>.",
                            "target_lang_translations": {
                                "pl": "Symfonia rozpoczyna się zapadającym w pamięć czteronutowym <w>motywem</w>."
                            }
                        },
                        {
                            "text": "The composer weaves a simple <w>motif</w> through the entire movement.",
                            "target_lang_translations": {
                                "pl": "Kompozytor wplata prosty <w>motyw</w> przez całą część utworu."
                            }
                        }
                    ],
                    "synonyms": [
                        "theme",
                        "melody"
                    ],
                    "common_phrases": [
                        "musical motif"
                    ],
                    "target_lang_definitions": {
                        "pl": "Krótka, powtarzająca się fraza muzyczna lub pomysł melodyczny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "motyw",
                                "target_lang_sense_clarification": "najmniejsza jednostka formy muzycznej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "575d37a0-ad1f-3a31-ad2a-f9c71086c790",
                    "sense_definition": "A specific sequence of nucleotides or amino acids that appears repeatedly and has biological significance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists identified a specific protein <w>motif</w> in the virus.",
                            "target_lang_translations": {
                                "pl": "Naukowcy zidentyfikowali specyficzny <w>motyw</w> białkowy w wirusie."
                            }
                        },
                        {
                            "text": "This genetic <w>motif</w> is essential for the cell's function.",
                            "target_lang_translations": {
                                "pl": "Ten <w>motyw</w> genetyczny jest niezbędny dla funkcjonowania komórki."
                            }
                        }
                    ],
                    "synonyms": [
                        "pattern"
                    ],
                    "common_phrases": [
                        "protein motif"
                    ],
                    "target_lang_definitions": {
                        "pl": "Określona sekwencja nukleotydów lub aminokwasów, która powtarza się i ma znaczenie biologiczne."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "motyw",
                                "target_lang_sense_clarification": "powtarzalna sekwencja w biologii molekularnej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3612f4fb-b29f-3f56-870b-6f2391689ba3",
                    "sense_definition": "A separate decorative piece of fabric or lace applied to a garment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "artistic_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wedding dress was adorned with a delicate lace <w>motif</w>.",
                            "target_lang_translations": {
                                "pl": "Suknia ślubna była ozdobiona delikatną koronkową <w>aplikacją</w>."
                            }
                        },
                        {
                            "text": "She sewed a velvet <w>motif</w> onto the collar of her jacket.",
                            "target_lang_translations": {
                                "pl": "Przyszyła aksamitną <w>aplikację</w> do kołnierza swojej kurtki."
                            }
                        }
                    ],
                    "synonyms": [
                        "applique"
                    ],
                    "common_phrases": [
                        "lace motif"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osobny element dekoracyjny z tkaniny lub koronki naszyty na odzież."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "aplikacja",
                                "target_lang_sense_clarification": "ozdobny element naszyty na tkaninę"
                            },
                            {
                                "target_lang_word": "naszywka",
                                "target_lang_sense_clarification": "element dekoracyjny przymocowany do ubrania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39dff857-fc79-30f0-99fc-03f5be8322a9",
                    "sense_definition": "The specific arrangement of atoms or molecules that repeats within a crystal lattice.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crystal structure is defined by its repeating atomic <w>motif</w>.",
                            "target_lang_translations": {
                                "pl": "Struktura kryształu jest określona przez powtarzający się <w>motyw</w> atomowy."
                            }
                        },
                        {
                            "text": "Each unit cell contains a complex <w>motif</w> of ions.",
                            "target_lang_translations": {
                                "pl": "Każda komórka elementarna zawiera złożony <w>motyw</w> jonów."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Specyficzny układ atomów lub cząsteczek powtarzający się w sieci krystalicznej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "motyw",
                                "target_lang_sense_clarification": "powtarzalny układ strukturalny w krystalografii"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f767704c-1adc-3174-b1c8-80c30bf88887",
                    "sense_definition": "A fundamental tactical or strategic element in a game move.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player recognized a common tactical <w>motif</w> in the chess game.",
                            "target_lang_translations": {
                                "pl": "Gracz rozpoznał powszechny <w>motyw</w> taktyczny w partii szachów."
                            }
                        },
                        {
                            "text": "Mastering this <w>motif</w> helps in planning future moves.",
                            "target_lang_translations": {
                                "pl": "Opanowanie tego <w>motywu</w> pomaga w planowaniu przyszłych ruchów."
                            }
                        }
                    ],
                    "synonyms": [
                        "tactic"
                    ],
                    "common_phrases": [
                        "tactical motif"
                    ],
                    "target_lang_definitions": {
                        "pl": "Podstawowy element taktyczny lub strategiczny w ruchu w grze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "motyw",
                                "target_lang_sense_clarification": "typowa sytuacja taktyczna w grze"
                            },
                            {
                                "target_lang_word": "taktyka",
                                "target_lang_sense_clarification": "sposób prowadzenia gry"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}