                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "023b3208-d920-3966-8b1b-14b6c175385a",
                                        "entry_id": "d06562bd-9a60-37cb-b460-bf1660168311",
                                        "glosses": [
                                            "A member of an emergency service who is first on the scene, or among those first on the scene, at an emergency."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d605da1a-da16-4633-b50a-c3790fe14608",
                                                "sense_id": "023b3208-d920-3966-8b1b-14b6c175385a",
                                                "text": "Many survivors tried to describe what they felt, but words failed them. Hard to imagine, too, the emotions of the first responders – the ambulance crews, the medics and the police – faced by ghastly mayhem. It must have felt overwhelming, but they did their jobs and doubtless saved many lives."
                                            },
                                            {
                                                "example_id": "14e16d23-fee4-4829-b92c-ea058de2b606",
                                                "sense_id": "023b3208-d920-3966-8b1b-14b6c175385a",
                                                "text": "At the same time the hazard warning lights and, once the vehicle has come to a standstill, the Mercedes-Benz emergency call system is activated and the doors and windows are unlocked, to make access to the interior easier for any first responders."
                                            },
                                            {
                                                "example_id": "b25d8fd2-5639-45e1-8359-10865e77cdd6",
                                                "sense_id": "023b3208-d920-3966-8b1b-14b6c175385a",
                                                "text": "In July, the New Taipei city government organized a large-scale drill with its disaster services and the Defense Ministry. Included for the first time was urban warfare, such as how first responders would react to an attack on a train station or a port."
                                            }
                                        ]
                                    },
