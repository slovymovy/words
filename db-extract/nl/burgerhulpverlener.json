                    {
                        "sense_id": "7d2ee878-550b-3332-a336-27a8495263cc",
                        "entry_id": "655b7e3d-2d18-3e5f-b8ec-c2f49864b4bf",
                        "glosses": [
                            "iemand die als vrijwilliger opgeroepen kan worden voor het reannimeren van een persoon met een acute hartstilstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d178ae5-7aa3-4ce3-99fa-b85e726a0357",
                                "sense_id": "7d2ee878-550b-3332-a336-27a8495263cc",
                                "text": "Burgerhulpverleners zijn vrijwilligers die kunnen reanimeren en worden opgeroepen in een noodsituatie. Een half jaar geleden waren het er 88.000. Nu staan zo'n 130.000 mensen geregistreerd. Dat klinkt goed, maar in heel veel dorpen en vooral steden is het systeem nog niet actief."
                            },
                            {
                                "example_id": "d58dcedf-ddb7-40af-93d9-c1fcf6ca82dd",
                                "sense_id": "7d2ee878-550b-3332-a336-27a8495263cc",
                                "text": "In Nederland staan ongeveer 170.000 mensen geregistreerd als burgerhulpverlener, 40.000 meer dan vorig jaar zomer. Daarmee is Nederland volgens de Hartstichting het eerste land ter wereld dat een landelijk netwerk van burgerhulpverleners heeft die na een oproep binnen zes minuten kunnen reanimeren."
                            },
                            {
                                "example_id": "8e362906-777b-4161-bc27-d14f7a334600",
                                "sense_id": "7d2ee878-550b-3332-a336-27a8495263cc",
                                "text": "‘Als de 112-centrale een oproep van een hartaanval krijgt, stuurt die de ambulance en MUG uit’, zegt woordvoerder dokter Thomas Tackaert. ‘Via de app worden ook burgerhulpverleners die dichterbij zijn opgeroepen. Dat zijn vrijwilligers die een EHBO-cursus volgden en dus correct kunnen reanimeren.’"
                            }
                        ]
                    }
