                    "sense_definition": "sich abfällig, boshaft oder spöttisch über jemanden oder etwas äußern, meist in dessen Abwesenheit",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abwertend_sprechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Mittagspause sitzen die Kollegen zusammen und <w>lästern</w> über ihren neuen Vorgesetzten."
                        },
                        {
                            "text": "Es ist unhöflich und unfair, ständig hinter dem Rücken anderer Menschen zu <w>lästern</w>."
                        }
                    ],
                    "synonyms": [
                        "ablästern",
                        "herziehen",
                        "schlechtmachen"
                    ],
                    "common_phrases": [
                        "über jemanden lästern",
                        "hinter dem Rücken lästern"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "im alltäglichen Sprachgebrauch"
                        }
                    ]
                },
                {
                    "sense_id": "c6385174-9354-35a0-b200-9e94014678f4",
                    "sense_definition": "durch verächtliche Äußerungen Gott oder heilige Dinge herabwürdigen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "blasphemie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Mittelalter wurde jeder schwer bestraft, der es wagte, öffentlich Gott zu <w>lästern</w>."
                        },
                        {
                            "text": "Der Künstler betonte in seiner Rede, dass er mit seinem Bild keineswegs heilige Symbole <w>lästern</w> wollte."
                        }
                    ],
                    "synonyms": [
                        "blasphemieren",
                        "schmähen"
                    ],
                    "common_phrases": [
