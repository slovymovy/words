                ],
                "senses": [
                    {
                        "sense_id": "1da693dc-0c83-3b7a-a6de-b896f04fef57",
                        "entry_id": "79847d7e-a22d-3353-904f-2fb781ec9558",
                        "glosses": [
                            "een plaats waar men bij het treinreizen op verhaal kan komen en versnaperingen of een maaltijd kan nuttigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd85132-8097-4a61-99d6-98ba8cbd5a49",
                                "sense_id": "1da693dc-0c83-3b7a-a6de-b896f04fef57",
                                "text": "Laten we afspreken in de restauratie."
                            }
                        ]
                    },
                    {
                        "sense_id": "357c89ac-b461-39f8-8241-9edbb32f6fde",
                        "entry_id": "79847d7e-a22d-3353-904f-2fb781ec9558",
                        "glosses": [
                            "het minitieus herstellen van een voorwerp van kunstzinnig of historisch belang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80bb0f49-1472-4183-a61a-50fe1a461f98",
                                "sense_id": "357c89ac-b461-39f8-8241-9edbb32f6fde",
                                "text": "De restauratie van dat schilderij heeft lange geduurd."
                            },
                            {
                                "example_id": "2b836015-2dee-4a38-921e-24bfbce515f6",
                                "sense_id": "357c89ac-b461-39f8-8241-9edbb32f6fde",
                                "text": "De restaurateur schreef het plan voor de MeyerBergman Erfgoed Groep, die het paleis in 2017 kocht. De eigenaar wil van het monument en omringende landgoed een evenementencentrum maken. Ook komen er een hotel, horeca en tientallen woningen. De inkomsten daaruit worden gebruikt voor de restauratie van het paleis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f97e76c3-2c21-33a8-b345-ae0c13eb36e4",
                        "entry_id": "79847d7e-a22d-3353-904f-2fb781ec9558",
                        "glosses": [
                            "het op de troon herstellen van een eerder verdreven vorstenhuis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8eaa4b9-8c83-4705-8c8f-43a0259b68e5",
                                "sense_id": "f97e76c3-2c21-33a8-b345-ae0c13eb36e4",
                                "text": "Na de tijd van Cromwell volgde de restauratie van het Huis Stuart op de Engelse troon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34394d55-6416-48ae-939f-0f34dac31b52",
                        "source_entry_id": "79847d7e-a22d-3353-904f-2fb781ec9558",
                        "source_sense_id": "357c89ac-b461-39f8-8241-9edbb32f6fde",
                        "source_sense_description": "het minitieus herstellen van een voorwerp van kunstzinnig of historisch belang",
                        "target_lang_word": "Restaurant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Restaurant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                        "entry_id": "7ee323cf-7f3a-3c5c-acb4-7d7289737b41",
                                        "glosses": [
                                            "Lokalität, in der Speisen gekauft und gegessen werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db4f0cc2-a53d-4d39-9f86-8377c7680a77",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "Ach, an der Ecke ist ein Restaurant."
                                            },
                                            {
                                                "example_id": "67e9235a-266f-45c1-a6b7-f8380dd17e9f",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "Im Restaurant muss man sich benehmen."
                                            },
                                            {
                                                "example_id": "270979e9-2df4-4564-9bda-85d358662d3a",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "Ich kenne bessere Restaurants."
                                            },
                                            {
                                                "example_id": "a9e05231-d400-4a26-9a3e-7c19bbbea122",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "„Wir wagen kaum noch, ins Restaurant zu gehen, meine Mutter und ich.“"
                                            },
                                            {
                                                "example_id": "0cc1b6f5-6c7c-4e8f-9162-a6e5e39b430c",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "„In einem kleinen Restaurant aßen wir einen Happen und gingen dann gemeinsam zur Bank.“"
                                            },
                                            {
                                                "example_id": "4303b824-9c2a-490d-9523-d23650e206d2",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "„Zum Abend essen sie etwas Leichtes in einem Restaurant in der Nähe des Bahnhofs.“"
                                            },
                                            {
                                                "example_id": "e02b1ac1-2180-4ca8-a858-48c573ebc30d",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "„Philip führte mich ins Theater aus, in Restaurants und einmal in den Kölner Zoo.“"
                                            },
                                            {
                                                "example_id": "9853fb0d-615d-4842-844b-dd54e5edc5b7",
                                                "sense_id": "c8edab6b-8513-3012-86d0-53bc0f2e1894",
                                                "text": "„Nur die, denen es finanziell gut geht, gehen in ein Restaurant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43942293-028b-40bc-9a8c-e7cc64e60f3d",
                        "source_entry_id": "79847d7e-a22d-3353-904f-2fb781ec9558",
                        "source_sense_id": "357c89ac-b461-39f8-8241-9edbb32f6fde",
                        "source_sense_description": "het minitieus herstellen van een voorwerp van kunstzinnig of historisch belang",
                        "target_lang_word": "Restauration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Restauration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e304ed93-05dd-3b0c-bc5c-6a9bfb51ab4d",
                                        "entry_id": "42c38f19-a881-3a20-8779-28d35c8c4d51",
                                        "glosses": [
                                            "für das Restaurieren"
                                        ],
                                        "tags": [
                                            "formal",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b7bda2-2744-4eda-b64a-a2820ab68617",
                                                "sense_id": "e304ed93-05dd-3b0c-bc5c-6a9bfb51ab4d",
                                                "text": "Der Historismus des 19. Jahrhunderts hat aber außer seiner echten Tochter, der Denkmalpflege, auch ein illegitimes Kind gezeugt, das Restaurationswesen. Sie werden oft miteinander verwechselt und sind doch Antipoden. Die Denkmalpflege will Bestehendes erhalten, die Restauration will Nichtbestehendes wiederherstellen."
                                            },
                                            {
                                                "example_id": "316bfbde-a6d7-42fe-882e-9e51c6c189da",
                                                "sense_id": "e304ed93-05dd-3b0c-bc5c-6a9bfb51ab4d",
                                                "text": "Das Staatliche Museum der bildenden Künste „AS Puschkin\" erhielt eine ehrenvolle Aufgabe. Es sollte die Gemälde der Dresdner Galerie übernehmen, um deren Restauration zu ermöglichen."
                                            },
                                            {
                                                "example_id": "2b957b7f-149d-4eae-8b89-c9a822ff4fa1",
                                                "sense_id": "e304ed93-05dd-3b0c-bc5c-6a9bfb51ab4d",
                                                "text": "„Sie hätten zumindest die Restauration kapitalistischer Strukturen gestört.“"
                                            },
                                            {
                                                "example_id": "4b11f152-6b54-487c-a266-46414d45e25a",
                                                "sense_id": "e304ed93-05dd-3b0c-bc5c-6a9bfb51ab4d",
                                                "text": "„Wie er mich ablenkte mit seiner Angewohnheit, beim Fahren mit einer Hand zu gestikulieren, wenn wir uns über die richtige Ordnung eines Bibliothekskatalogs austauschten und die Restauration von antikem Papier, über Landkarten und alte Manuskripte – und das nicht nur, weil er mich mit seinem Fahrstil in Todesangst versetzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2cfd722-5096-3d62-a350-191134302e87",
                                        "entry_id": "42c38f19-a881-3a20-8779-28d35c8c4d51",
                                        "glosses": [
                                            "Wiedereinrichtung früherer gesellschaftlicher oder politischer Verhältnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acba91fa-9916-4c49-944f-c80621cd0e3b",
                                                "sense_id": "c2cfd722-5096-3d62-a350-191134302e87",
                                                "text": "Die Siegermächte berufen den Wiener Kongress ein, um mit der ‚Restauration‘ die vorrevolutionäre absolutistische Ordnung Europas wieder herzustellen."
                                            },
                                            {
                                                "example_id": "4730de12-b0d0-470b-8071-3d39a16e7a21",
                                                "sense_id": "c2cfd722-5096-3d62-a350-191134302e87",
                                                "text": "Franco hat diesen Bruch mit der monarchischen Legitimität zunächst zwar nicht betont, jedoch auch nie verhehlt, daß es sich nicht um eine „Restauration“, sondern um eine „Instauration“ der Monarchie handele."
                                            },
                                            {
                                                "example_id": "b5fcd5c0-67ee-4241-9749-21ff79ee1992",
                                                "sense_id": "c2cfd722-5096-3d62-a350-191134302e87",
                                                "text": "„Heinrich Böll und Paul Celan verband eine kurze Freundschaft, die alsdann vom geistigen Klima der Restauration beschädigt wurde.“"
                                            },
                                            {
                                                "example_id": "e0f1c678-cefd-42ed-905a-0d56673103bc",
                                                "sense_id": "c2cfd722-5096-3d62-a350-191134302e87",
                                                "text": "„Das geistige Tauwetter, das mit der Restauration einherging, erfasste alle Schichten der englischen Bevölkerung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "71d71277-6182-3d20-abd1-b445217f1058",
                                        "entry_id": "42c38f19-a881-3a20-8779-28d35c8c4d51",
                                        "glosses": [
                                            "landschaftlich³, besonders österreichisch auch schweizerdeutsch, sonst veraltet: Restaurant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f50f90f-84d9-4954-8b38-28408a16f4f5",
                                                "sense_id": "71d71277-6182-3d20-abd1-b445217f1058",
                                                "text": "Überwiegend ist jedoch die Restauration eines Hotels auch für externe Gäste, d.h. Gäste, die nicht im Hotel wohnen, geöffnet."
                                            },
                                            {
                                                "example_id": "a4536337-6382-4be0-ad95-8246f625b5ac",
                                                "sense_id": "71d71277-6182-3d20-abd1-b445217f1058",
                                                "text": "Als wir nachts nach 2 Uhr bis auf die Haut durchnäßt den Rückweg nach Berlin antraten und in einer an der Straße liegenden Restauration Einkehr hielten, stießen wir auf unsere Berliner Geheimpolizisten, die uns offenbar gefolgt waren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e38a9ca9-e693-4ff4-84d8-b5118deff30f",
                        "source_entry_id": "79847d7e-a22d-3353-904f-2fb781ec9558",
                        "source_sense_id": "357c89ac-b461-39f8-8241-9edbb32f6fde",
                        "source_sense_description": "het minitieus herstellen van een voorwerp van kunstzinnig of historisch belang",
                        "target_lang_word": "restoration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restoration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The process of bringing an object back to its original state; the process of restoring something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f000f6-fb65-4d80-a0a4-dd866e6e22dd",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "foreskin restoration"
                                            },
                                            {
                                                "example_id": "d55f33af-d5e2-4732-9f87-f1f4dfc4e433",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "The restoration of this painting will take years."
                                            },
                                            {
                                                "example_id": "39a07c9e-b344-4bc8-9efd-c90c97bc722d",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "The restoration of this medieval church involved undoing all the Victorian modifications."
                                            },
                                            {
                                                "example_id": "bc8f46db-1e28-4e49-8772-8a979d55a484",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "There is all the difference between preservation and restoration."
                                            },
                                            {
                                                "example_id": "da667a84-2ce8-4987-8b4d-30e07d81df82",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "As Sir Ronald Matthews said at the meeting of L.N.E.R. stockholders earlier this year, the public must realise \"the inevitability of a certain amount of gradualness\" in connection with the restoration of passenger train services and facilities."
                                            },
                                            {
                                                "example_id": "e5930d00-3edd-4ae1-b416-940da0deabe4",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "Providing accommodation is a significant constraint, and an unexpected development from the restoration of services to Okehampton is demand from the Exeter student population to rent local properties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279d834d-56e9-3a35-b2eb-1fa5ab10b1c1",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The result of such a process, such as a dental restoration (a dental prosthesis)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db7d8ac5-32e4-419b-9eda-030c4a509edc",
                                                "sense_id": "279d834d-56e9-3a35-b2eb-1fa5ab10b1c1",
                                                "text": "These restorations were especially impressive and were reported in a leading prosthodontics journal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The return of a former monarchy or monarch to power, usually after having been forced to step down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfe59654-8f95-413e-8072-0d2b6e22c353",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "But now here we are, faced with the prospect of a Trump restoration."
                                            },
                                            {
                                                "example_id": "bb59fc67-790c-4879-a9ab-621aff2be811",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "The restoration of the House of Stuart took place a few years after the death of Cromwell."
                                            },
                                            {
                                                "example_id": "2bad862c-e025-4267-8b53-1057773d5869",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "The restoration of the Kingdom of Spain took place immediately after the death of Franco."
                                            },
                                            {
                                                "example_id": "ecf8db0a-aeb6-4daf-8670-7c2923eeb198",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "Behold the differing Climes agree, / Rejoycing in thy Reſtauration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51a85060-7c64-3680-87b4-82979722d35a",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The return of a socioeconomic formation in the role of the dominant mode of production."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5615567-014a-49ae-aebe-bb8442bdeb95",
                                                "sense_id": "51a85060-7c64-3680-87b4-82979722d35a",
                                                "text": "The restoration of capitalism in Russia gave rise to unemployment."
                                            },
                                            {
                                                "example_id": "c9808232-25fe-4a07-9c9b-f9944c72509e",
                                                "sense_id": "51a85060-7c64-3680-87b4-82979722d35a",
                                                "text": "The restoration of capitalism in Eastern Europe made way for improvement in human rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f70f172-93db-3275-8362-413c6ac78704",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The receiving of a sinner to divine favor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7a52704-d351-4637-b6a8-3cf17e02097b",
                        "source_entry_id": "79847d7e-a22d-3353-904f-2fb781ec9558",
                        "source_sense_id": "357c89ac-b461-39f8-8241-9edbb32f6fde",
                        "source_sense_description": "het minitieus herstellen van een voorwerp van kunstzinnig of historisch belang",
                        "target_lang_word": "restauration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restauration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c162dd31-4bb4-307e-bdb6-e18579be091b",
                                        "entry_id": "870bcf76-7c28-3686-ad58-a19c27a6b178",
                                        "glosses": [
                                            "Réparation ; remise en bon état ou, en informatique, remise d’un système en état d’origine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5732462-bd3b-4cd3-8619-02bc13e0acb3",
                                                "sense_id": "c162dd31-4bb4-307e-bdb6-e18579be091b",
                                                "text": "La barbacane avait été élevée très-probablement sous saint Louis, comme la plupart des adjonctions et restaurations faites au château."
                                            },
                                            {
                                                "example_id": "6438c8fc-c350-4240-ad9a-ca6afeb6c145",
                                                "sense_id": "c162dd31-4bb4-307e-bdb6-e18579be091b",
                                                "text": "De réels efforts ont été poursuivis par l'État pour mener à bien l'œuvre du reboisement. C'est seulement par la restauration des anciennes forêts qu'on rendrait à ce pays sa naturelle armature …."
                                            },
                                            {
                                                "example_id": "30002bb0-6468-4baa-b919-4f3bfdd5009f",
                                                "sense_id": "c162dd31-4bb4-307e-bdb6-e18579be091b",
                                                "text": "La valorisation du patrimoine juif est un processus de grande ampleur en Catalogne où la restauration des calls (nom hébreu désignant les quartiers juifs au Moyen Âge) et la récupération des témoignages du passé, ont donné des résultats notoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77aa7e26-a485-39f8-bead-1857fe88e82d",
                                        "entry_id": "870bcf76-7c28-3686-ad58-a19c27a6b178",
                                        "glosses": [
                                            "Travail fait d’après un édifice antique, pour en rétablir selon la vraisemblance les parties qui n’existent plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c42895a-6058-48cd-b9d4-7087e34f3567",
                                                "sense_id": "77aa7e26-a485-39f8-bead-1857fe88e82d",
                                                "text": "La restauration des monuments anciens est toujours en partie conjecturale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c0ea980-d87c-35a5-84fa-a5a1792033da",
                                        "entry_id": "870bcf76-7c28-3686-ad58-a19c27a6b178",
                                        "glosses": [
                                            "Rétablissement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f600533-0e09-4392-9eb6-78b185415204",
                                                "sense_id": "7c0ea980-d87c-35a5-84fa-a5a1792033da",
                                                "text": "Mais la destruction par l’inflation du capital circulant a entravé la restauration de l'activité économique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "882ced95-d0c4-34f1-8bb7-f802545b3f8a",
                                        "entry_id": "870bcf76-7c28-3686-ad58-a19c27a6b178",
                                        "glosses": [
                                            "Rétablissement d’une ancienne dynastie sur le trône."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ba4d60-dd16-44ed-9b7a-898ce11e588f",
                                                "sense_id": "882ced95-d0c4-34f1-8bb7-f802545b3f8a",
                                                "text": "Dans le fait, le retour de Richard avait détruit tout espoir de restauration de la dynastie saxonne en Angleterre ; […]."
                                            },
                                            {
                                                "example_id": "3fb81f12-0074-442d-bffe-798f7e02cc77",
                                                "sense_id": "882ced95-d0c4-34f1-8bb7-f802545b3f8a",
                                                "text": "Fouché, dans ses Mémoires, avoue que ses plans ne réussirent pas; Talleyrand fut plus heureux, il contribua grandement à la restauration des Bourbons ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a291b7a-fbf5-34cf-a650-abd416dc3fb5",
                                        "entry_id": "870bcf76-7c28-3686-ad58-a19c27a6b178",
                                        "glosses": [
                                            "Rétablissement de la dynastie des Bourbons en France. — → voir Restauration."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "651841e8-28a2-47a0-b013-17cfeefe8613",
                                                "sense_id": "9a291b7a-fbf5-34cf-a650-abd416dc3fb5",
                                                "text": "Un ancien officier d'ordonnance de Napoléon, […], et qui sous la restauration fit une haute fortune, était venu passer les beaux jours à Versailles, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c4bf77f-362f-3eb1-8927-4ad1b506988a",
                                        "entry_id": "870bcf76-7c28-3686-ad58-a19c27a6b178",
                                        "glosses": [
                                            "Retour à une organisation sociale du passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1adbd9b-a4ec-44ca-92ab-66a2d712b658",
                                                "sense_id": "6c4bf77f-362f-3eb1-8927-4ad1b506988a",
                                                "text": "Une restauration n'est possible qu'aux brefs instants de lassitude quand les idées, les hommes et les faits s'accordent une trêve, quand l'essoufflement rompt l'assaut des générations montantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471de851-9f01-3b5d-85ad-f75e0012386b",
                                        "entry_id": "870bcf76-7c28-3686-ad58-a19c27a6b178",
                                        "glosses": [
                                            "Secteur des activités liées aux établissements permettant de prendre un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae37d60-4ac2-4195-99a8-c9330a38a801",
                                                "sense_id": "471de851-9f01-3b5d-85ad-f75e0012386b",
                                                "text": "Pour intégrer certains métiers liés au secteur de la restauration - comme celui de serveur -, il n’est pas forcément nécessaire d’être diplômé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
