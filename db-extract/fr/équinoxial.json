                    {
                        "form_id": "e1a30029-f8d0-4c29-83d9-bdd150dc0a7c",
                        "entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "équinoxiales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                        "entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
                        "glosses": [
                            "Qui est relatif à l’équinoxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0998d4f4-0b4c-43c3-a61d-14a978a25a37",
                                "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                                "text": "Sans les digues élevées et solidement établies qui l’en garantissent, la Camargue serait submergée par le Rhône plusieurs fois durant le cours du printemps, au moment sur-tout de la fonte des neiges, et pendant l'automne lors des pluies équinoxiales : […]."
                            },
                            {
                                "example_id": "f8179446-afe6-42e6-b469-188ea8bdb28e",
                                "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                                "text": "Une nuit, nous descendîmes le Castelreagh à l’aide de nos avirons, et nous entrâmes bravement dans le grand Océan équinoxial."
                            },
                            {
                                "example_id": "d162fa85-d35a-4668-9ac3-a30b6bf73ed4",
                                "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                                "text": "Il en va presque de même au cours des deux saisons équinoxiales : feuilles mortes, crottes de chien, vieux mégots, papiers griffonnés et autres denrées oubliées bloquent les bouches des puisards et le joli ruissèlement de la montagne se transforme en mare malodorante et hautement incommodante."
                            }
                        ]
                    },
                    {
                        "sense_id": "6077265e-d5c7-3162-8d67-0399d8af3a1a",
                        "entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
                        "glosses": [
                            "Qualifie les fleurs qui s’ouvrent et se ferment chaque jour à des heures déterminées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c769e74-b858-4711-afbe-1c9937eefb35",
                                "sense_id": "6077265e-d5c7-3162-8d67-0399d8af3a1a",
                                "text": "Fleurs équinoxiales."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fda64f8-f2ae-3c7f-8f33-e25f0e2f45ad",
                        "entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
                        "glosses": [
                            "Qualifie les régions proches de l’équateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eac135b-38d6-4a4e-a432-edbaaabb6c98",
                                "sense_id": "4fda64f8-f2ae-3c7f-8f33-e25f0e2f45ad",
                                "text": "Après s’être lancée à travers les régions équinoxiales, sans doute elle voulait pénétrer jusqu’aux dernières limites des contrées hyperboréennes."
                            },
                            {
                                "example_id": "6da9a702-e987-44de-8ea9-01257ac51d7e",
                                "sense_id": "4fda64f8-f2ae-3c7f-8f33-e25f0e2f45ad",
                                "text": "La France d’outre-mer ! Les départements français d’Amérique ! La France équinoxiale ! La Région ultrapériphérique ! Les confettis de l’Empire !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24c129d5-9d67-48ab-964d-851fc275ed0d",
                        "source_entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
