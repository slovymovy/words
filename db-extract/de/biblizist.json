                "senses": [
                    {
                        "sense_id": "753af6e3-5e7a-38a6-9f6f-8b6a308a80a0",
                        "entry_id": "2c27eca3-51cc-3fd9-a7db-720f4c861eae",
                        "glosses": [
                            "Anhänger der wörtlichen Auslegung der Bibel (Biblizismus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd220e4-1c08-4836-95fb-4fa81104e43e",
                                "sense_id": "753af6e3-5e7a-38a6-9f6f-8b6a308a80a0",
                                "text": "„Sie [die historisch-kritische Auslegung] ist heute ausser bei den so genannten Biblizisten oder Fundamentalisten allgemein anerkannt.“"
                            },
                            {
                                "example_id": "63e468f0-2aad-4203-9f7b-65c7f4e90306",
                                "sense_id": "753af6e3-5e7a-38a6-9f6f-8b6a308a80a0",
                                "text": "„Es gibt wenige Schriften im Neuen Testament, die im Lauf der Jahrhunderte nicht schon vom einen oder andern protestantischen Biblizisten oder von dieser oder jener Schule als nichtapostolisch und unkanonisch erklärt worden wären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
