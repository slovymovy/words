                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцапать",
                                "target_lang_sense_clarification": "поймать, арестовать"
                            },
                            {
                                "target_lang_word": "загрести",
                                "target_lang_sense_clarification": "арестовать"
                            }
                        ],
                        "zh": [
