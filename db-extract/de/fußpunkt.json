                ],
                "senses": [
                    {
                        "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                        "entry_id": "2fe7a649-254d-3e77-b799-d1e9dd732a22",
                        "glosses": [
                            "unteres Ende von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e65290d-5348-4b80-a949-0aca16dd64ab",
                                "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                                "text": "„Verbinde die Punkte mit einer Geraden. Diese ist das Lot von P auf die Gerade g mit dem Fußpunkt F.“"
                            },
                            {
                                "example_id": "120ec706-9d5a-4049-842b-43c5a0a45d30",
                                "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                                "text": "„Da dieser Gegentakt B-Betrieb mit ungünstigen sogenannten Übernahmeverzerrungen verbunden ist, werden zur Linearisierung die Arbeitspunkte der beiden Endstufenbauteile in den geradlinigen Bereich zwischen Fußpunkt und Mitte der Kennlinie verschoben.“"
                            },
                            {
                                "example_id": "e3c231d3-faaa-4ae0-9d0a-bb3ad76ca652",
                                "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                                "text": "„Die PURR-Kurve ist durch einen spezifischen Fußpunkt (Schnittpunkt mit der Druckachse) und einen Kurvenanstieg definiert.“"
                            },
                            {
                                "example_id": "fec5329f-525a-4741-ac0b-c3c11a502630",
                                "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                                "text": "„Im Endzustand wird von einem gelenkigen Fußpunkt ausgegangen.“"
                            },
                            {
                                "example_id": "0db22a32-cad0-4f41-994c-f5be01412849",
                                "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                                "text": "„Der Radikale Konstruktivismus, und das sind vor allem Gebhard Rusch und Siegfried J Schmidt, baut auf der, mit dem Namen Humberto Maturana verbundenen, Theorie der Autopoiesis auf und hat seinen Fußpunkt in der These der informationellen Geschlossenheit lebender Systeme.“"
                            },
                            {
                                "example_id": "82115feb-67fd-46c3-b655-b49f7774c14a",
                                "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                                "text": "„Die Liberalen meinen im Formalismus des Gerechtigkeitsprinzips einen unerschütterlichen Fußpunkt zu haben.“"
                            },
                            {
                                "example_id": "55cd92d4-c817-41ae-baa2-838d3e7e1cf3",
                                "sense_id": "6d09cb64-b2b1-3fc3-b6d5-2d25fb6ed72a",
                                "text": "„In der Tristesse am Fußpunkt eines Jahres, eines Lebens glimmt ein Funke der Hoffnung auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
