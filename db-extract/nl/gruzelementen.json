                    {
                        "translation_id": "14b09d77-e275-41f5-9615-beec32989205",
                        "source_entry_id": "ae1a3f1e-cb95-3928-96c2-62659baac0a9",
                        "source_sense_id": "474ecc76-0612-37e8-844c-64eb3f307e8c",
                        "source_sense_description": "stukken die ontstaan wanneer een voorwerp breekt",
                        "target_lang_word": "smithereens",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smithereens",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53af86a6-91b0-3451-aaae-758913f37d3a",
                                        "entry_id": "8bed6209-bec4-3576-8b7f-c3f762eab03d",
                                        "glosses": [
                                            "Fragments or splintered pieces; numerous tiny disconnected items."
                                        ],
                                        "tags": [
                                            "informal",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aebecdff-9d65-4af8-b370-1d2fb3ecef6f",
                                                "sense_id": "53af86a6-91b0-3451-aaae-758913f37d3a",
                                                "text": "The urn shattered into smithereens the moment it hit the ground."
                                            },
                                            {
                                                "example_id": "b1d4c51d-d63e-41ec-b4d7-204bb8a45625",
                                                "sense_id": "53af86a6-91b0-3451-aaae-758913f37d3a",
                                                "text": "When the waiter dropped the platter, one smithereen struck him above the knee, and the four remaining smithereens scattered across the floor."
                                            },
                                            {
                                                "example_id": "9a2e9a18-2990-44ca-8d72-7e112e75de77",
                                                "sense_id": "53af86a6-91b0-3451-aaae-758913f37d3a",
                                                "text": "However, something once happened on the railway there which showed the very best of mankind: heroism, duty, self-sacrifice and calm professionalism under terrible pressure. It is a story which gives us far, far better reasons for remembering this attractive little town, which without these heroes would have been blown to smithereens in a gigantic explosion. (Two railwaymen lost their lives in 1944 when a wagon in an ammunition train caught fire and blew up, an even worse disaster was averted however.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac071984-96c0-41dc-9354-a3f78066c02f",
                        "source_entry_id": "ae1a3f1e-cb95-3928-96c2-62659baac0a9",
                        "source_sense_id": "474ecc76-0612-37e8-844c-64eb3f307e8c",
                        "source_sense_description": "stukken die ontstaan wanneer een voorwerp breekt",
                        "target_lang_word": "débris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e26bf7-ffcc-410b-b960-a945072012c4",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                                            },
                                            {
                                                "example_id": "f945e94b-3b21-4798-a147-cdc4b405d264",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Si l'on écrase entre deux pierres des grains de blé, l'enveloppe corticale de chaque grain est brisée, et les débris, qui portent le nom de son, se mêlent à la farine provenant de la trituration de la partie intérieure."
                                            },
                                            {
                                                "example_id": "d8dddf08-0176-4803-a9fd-3f6b129ef3b1",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Ce qui m’émerveillait le plus dans les premiers temps, c'était l’étonnante habileté de nos poneys à se tirer d'affaire au milieu d'un chaos de débris volcaniques où un piéton aurait pu difficilement trouver son chemin."
                                            },
                                            {
                                                "example_id": "0b5c0b2f-7245-4667-be59-e998fba24b38",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "D'énormes blocs de corail éblouissants de blancheur sortaient de l'eau et semblaient les débris d'une gigantesque convulsion."
                                            },
                                            {
                                                "example_id": "f70f4fb0-980b-49c8-9eb9-a2793bae9b96",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Après un certains laps de temps, les femmes brûlent les défrichements au feu courant. Ensuite elles ramassent les débris et les réincinèrent en petits tas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a88768e-b87c-31ce-880d-06a9fd44b285",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite.",
                                            "Les restes d'un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ee565c-30a4-42c2-a4dd-82dc377b28f3",
                                                "sense_id": "9a88768e-b87c-31ce-880d-06a9fd44b285",
                                                "text": "Les débris d’un souper, les débris d’un pâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite.",
                                            "Ce qui reste d’une chose après sa ruine, sa destruction, son abolition ; bien qui reste à quelqu’un après un revers de fortune ; troupes qui restent après la défaite d’une armée, d’un corps, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d8650d-5f9e-48b6-a01e-140c46772ecb",
                                                "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                                "text": "Après une journée pendant laquelle j'avais écouté avec terreur le bruit du canon qui se rapprochait incessamment, je vis arriver mon père avec une centaine de cavaliers, débris de trois mille hommes qu'il commandait."
                                            },
                                            {
                                                "example_id": "6c381868-09d2-42b5-ba42-4c091e002877",
                                                "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                                "text": "Dans les débris de mon opulence se trouvait une somme assez forte en titres étrangers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03ec0f33-83d2-391f-bfb9-c4e45619efaa",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Personne physiquement débile."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
