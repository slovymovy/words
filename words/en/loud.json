                                "target_lang_word": "浓烈",
                                "target_lang_sense_clarification": "形容气味强烈"
                            },
                            {
                                "target_lang_word": "刺鼻",
                                "target_lang_sense_clarification": "形容气味冲鼻"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "aef09838-4704-31b9-b535-1d5cff085af0",
                    "sense_definition": "In a way that makes a lot of noise; with high volume.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not talk so <w>loud</w> in the library.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не разговаривайте так <w>громко</w> в библиотеке.",
                                "tr": "Lütfen kütüphanede bu kadar <w>yüksek sesle</w> konuşmayın.",
                                "zh": "请不要在图书馆里<w>大声</w>说话。"
                            }
                        },
                        {
                            "text": "He laughed <w>loud</w> when he heard the funny joke.",
                            "target_lang_translations": {
                                "ru": "Он <w>громко</w> рассмеялся, когда услышал смешную шутку.",
                                "tr": "Komik fıkrayı duyunca <w>yüksek sesle</w> güldü.",
                                "zh": "听到那个有趣的笑话时，他<w>大声</w>地笑了出来。"
                            }
                        },
                        {
                            "text": "Actions speak <w>louder</w> than words.",
                            "target_lang_translations": {
                                "ru": "Поступки говорят <w>громче</w> слов.",
                                "tr": "Eylemler sözlerden daha <w>yüksek sesle</w> konuşur.",
                                "zh": "行动比言语更<w>响亮</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
