{
    "word_family": [
        "float",
        "floater",
        "flotation",
        "afloat",
        "floaty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2060a410-d73b-396b-8885-4269e9459799",
                    "sense_definition": "Present participle and gerund of <w>float</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children are <w>floating</w> their toy boats in the pond.",
                            "target_lang_translations": {
                                "ru": "Дети <w>пускают</w> свои игрушечные кораблики в пруду.",
                                "zh": "孩子们正在池塘里<w>放</w>玩具船。"
                            }
                        },
                        {
                            "text": "Leaves were <w>floating</w> gently down the stream.",
                            "target_lang_translations": {
                                "ru": "Листья тихо <w>плыли</w> вниз по течению.",
                                "zh": "树叶正顺着小溪轻轻地<w>漂</w>下去。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола float (плавать, держаться на воде).",
                        "zh": "动词 float 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плывущий",
                                "target_lang_sense_clarification": "находящийся в процессе плавания"
                            },
                            {
                                "target_lang_word": "плавающий",
                                "target_lang_sense_clarification": "способный держаться на воде или перемещающийся в ней"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂浮",
                                "target_lang_sense_clarification": "在水面上漂、随水移动"
                            },
                            {
                                "target_lang_word": "放",
                                "target_lang_sense_clarification": "使某物漂在水上，尤指把东西放到水里任其漂动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5bfb3c83-107b-3d35-be54-66c63485f407",
                    "sense_definition": "That stays on the surface of a liquid or is suspended in the air without sinking or falling.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We swam out to the <w>floating</w> dock in the middle of the lake.",
                            "target_lang_translations": {
                                "ru": "Мы поплыли к <w>плавучему</w> доку на середине озера.",
                                "zh": "我们游到了湖中央的<w>浮动</w>码头。"
                            }
                        },
                        {
                            "text": "The <w>floating</w> balloons drifted high into the sky.",
                            "target_lang_translations": {
                                "ru": "<w>Парящие</w> шары дрейфовали высоко в небо.",
                                "zh": "那些<w>漂浮</w>的气球越飘越高，进入了天空。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buoyant",
                        "afloat",
                        "drifting"
                    ],
                    "antonyms": [
                        "sunken",
                        "submerged"
                    ],
                    "common_phrases": [
                        "floating bridge",
                        "floating debris",
                        "floating dock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся на поверхности жидкости или взвешенный в воздухе; не тонущий и не падающий.",
                        "zh": "漂在液体表面上，或悬在空中而不下沉、不坠落的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавучий",
                                "target_lang_sense_clarification": "приспособленный для плавания, не тонущий (о сооружениях, средствах)"
                            },
                            {
                                "target_lang_word": "плавающий",
                                "target_lang_sense_clarification": "находящийся на поверхности воды"
                            },
                            {
                                "target_lang_word": "наплавной",
                                "target_lang_sense_clarification": "технический термин, обычно о мостах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂浮的",
                                "target_lang_sense_clarification": "漂在水面上或空中悬着，不下沉不落下"
                            },
                            {
                                "target_lang_word": "浮动的",
                                "target_lang_sense_clarification": "不固定地浮在水上，常用于码头、桥等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "112f80dc-5ab6-3f68-81c8-4431c2ec9d8a",
                    "sense_definition": "Not fixed in a specific position, value, or commitment; able to move or change freely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "not_fixed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to win the support of the <w>floating</w> voters.",
                            "target_lang_translations": {
                                "ru": "Политик пытался заручиться поддержкой <w>колеблющихся</w> избирателей.",
                                "zh": "那位政治人物试图争取<w>摇摆</w>选民的支持。"
                            }
                        },
                        {
                            "text": "The country adopted a <w>floating</w> exchange rate for its currency.",
                            "target_lang_translations": {
                                "ru": "Страна приняла <w>плавающий</w> валютный курс.",
                                "zh": "该国对本国货币实行了<w>浮动</w>汇率。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unfixed",
                        "variable",
                        "fluctuating"
                    ],
                    "antonyms": [
                        "fixed",
                        "settled",
                        "permanent"
                    ],
                    "common_phrases": [
                        "floating voter",
                        "floating exchange rate",
                        "floating population"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не зафиксированный в определенном положении или значении; способный свободно меняться.",
                        "zh": "不固定在某个特定位置、数值或立场上；可以自由移动或变化的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавающий",
                                "target_lang_sense_clarification": "изменяющийся, не фиксированный (о курсе, графике)"
                            },
                            {
                                "target_lang_word": "колеблющийся",
                                "target_lang_sense_clarification": "неопределившийся (об избирателях)"
                            },
                            {
                                "target_lang_word": "непостоянный",
                                "target_lang_sense_clarification": "переменный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浮动的",
                                "target_lang_sense_clarification": "不固定、可随情况变化，常用于汇率、价格、时间等"
                            },
                            {
                                "target_lang_word": "摇摆的",
                                "target_lang_sense_clarification": "立场未定、可能转向另一方，常用于选民"
                            },
                            {
                                "target_lang_word": "游离的",
                                "target_lang_sense_clarification": "不依附于固定一方，常用于选民、人口等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76193c08-8c5d-3c43-bb75-a06b27ecd12b",
                    "sense_definition": "That is not attached to any specific consonant or vowel within its morpheme.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist identified a <w>floating</w> tone that affected the pronunciation.",
                            "target_lang_translations": {
                                "ru": "Лингвист выявил <w>плавающий</w> тон, влияющий на произношение.",
                                "zh": "这位语言学家识别出一种会影响发音的<w>浮动</w>声调。"
                            }
                        },
                        {
                            "text": "In this language, a <w>floating</w> feature can change the sound of adjacent words.",
                            "target_lang_translations": {
                                "ru": "В этом языке <w>плавающий</w> признак может изменять звучание соседних слов.",
                                "zh": "在这种语言里，<w>浮动</w>特征会改变相邻词语的读音。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не привязанный к конкретному согласному или гласному звуку внутри морфемы.",
                        "zh": "不附着在该语素中的某个特定辅音或元音上的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавающий",
                                "target_lang_sense_clarification": "лингвистический термин (о тоне или ударении)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浮动的",
                                "target_lang_sense_clarification": "语言学术语，指不附着在某个具体音段上的声调、特征等"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "001d3076-5d5e-385f-b79a-c08159e41ad7",
                    "sense_definition": "The action or process of staying on the surface of a liquid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentle <w>floating</w> of the boat rocked us to sleep.",
                            "target_lang_translations": {
                                "ru": "Мягкое <w>покачивание</w> лодки укачало нас.",
                                "zh": "小船轻轻的<w>漂荡</w>把我们摇得睡着了。"
                            }
                        },
                        {
                            "text": "His <w>floating</w> was effortless in the salty water.",
                            "target_lang_translations": {
                                "ru": "То, как он <w>держался на воде</w>, не требовало усилий в соленой воде.",
                                "zh": "在咸水里，他的<w>漂浮</w>毫不费力。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс удержания на поверхности жидкости.",
                        "zh": "停留在液体表面的动作或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавание",
                                "target_lang_sense_clarification": "процесс нахождения на воде"
                            },
                            {
                                "target_lang_word": "дрейф",
                                "target_lang_sense_clarification": "медленное перемещение по течению или ветру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂浮",
                                "target_lang_sense_clarification": "停留在液体表面上的状态或过程"
                            },
                            {
                                "target_lang_word": "漂荡",
                                "target_lang_sense_clarification": "轻轻随水移动、摇荡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c953c39-6cf5-3369-9ba1-bfe6a4b8b558",
                    "sense_definition": "The spreading of plaster on the surface of walls to create a smooth finish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>floating</w> must be done quickly before the plaster sets.",
                            "target_lang_translations": {
                                "ru": "<w>Затирку</w> нужно выполнять быстро, пока штукатурка не схватилась.",
                                "zh": "必须赶在灰泥凝固前迅速完成<w>抹平</w>。"
                            }
                        },
                        {
                            "text": "He is skilled in the <w>floating</w> of large wall surfaces.",
                            "target_lang_translations": {
                                "ru": "Он опытен в <w>выравнивании</w> больших поверхностей стен.",
                                "zh": "他很擅长对大面积墙面进行<w>抹平</w>处理。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выравнивание штукатурки на поверхности стен для создания гладкой отделки.",
                        "zh": "将灰泥抹在墙面并抹平，以形成光滑表面的工序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затирка",
                                "target_lang_sense_clarification": "строительный процесс выравнивания"
                            },
                            {
                                "target_lang_word": "выравнивание",
                                "target_lang_sense_clarification": "разглаживание поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抹平",
                                "target_lang_sense_clarification": "建筑中把灰泥或抹灰层抹匀抹平的工序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77e96539-2cca-3814-ba32-810dd152ad97",
                    "sense_definition": "A veterinary dental procedure involving the filing down of sharp surfaces on a horse's teeth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse requires <w>floating</w> to chew its food without pain.",
                            "target_lang_translations": {
                                "ru": "Лошади требуется <w>подпиливание зубов</w>, чтобы жевать пищу без боли.",
                                "zh": "这匹马需要进行<w>锉牙</w>，这样咀嚼食物时才不会疼。"
                            }
                        },
                        {
                            "text": "Regular <w>floating</w> is an essential part of equine care.",
                            "target_lang_translations": {
                                "ru": "Регулярное <w>подпиливание зубов</w> — важная часть ухода за лошадьми.",
                                "zh": "定期<w>锉牙</w>是马匹护理中非常重要的一部分。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ветеринарная стоматологическая процедура, включающая подпиливание острых краев зубов у лошади.",
                        "zh": "一种兽医牙科处理，即把马牙上尖锐的边缘锉平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпиливание зубов",
                                "target_lang_sense_clarification": "ветеринарная процедура для лошадей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锉牙",
                                "target_lang_sense_clarification": "兽医牙科中为马锉磨牙齿尖锐边缘的处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "809a9045-f0d6-3c5c-806e-46f043008f8a",
                    "sense_definition": "Material that floats in a liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist analyzed the <w>floatings</w> found in the water sample.",
                            "target_lang_translations": {
                                "ru": "Ученый проанализировал <w>всплывшие частицы</w>, найденные в пробе воды.",
                                "zh": "科学家分析了水样中发现的<w>漂浮物</w>。"
                            }
                        },
                        {
                            "text": "We skimmed the <w>floatings</w> off the top of the mixture.",
                            "target_lang_translations": {
                                "ru": "Мы сняли <w>всплывшую массу</w> с поверхности смеси.",
                                "zh": "我们把混合物表面的<w>漂浮物</w>撇掉了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал или вещество, плавающее в жидкости.",
                        "zh": "漂浮在液体中的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всплывшая масса",
                                "target_lang_sense_clarification": "вещество на поверхности"
                            },
                            {
                                "target_lang_word": "взвесь",
                                "target_lang_sense_clarification": "частицы в жидкости (если не полностью всплыли)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂浮物",
                                "target_lang_sense_clarification": "漂在液体表面的物质"
                            },
                            {
                                "target_lang_word": "浮渣",
                                "target_lang_sense_clarification": "漂在表面的渣滓或杂质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}