                                                "example_id": "fe909648-1e57-4d08-95ba-6d919eae34dc",
                                                "sense_id": "318606a7-60d4-3706-a8b4-84ef63c9565f",
                                                "text": "Ollantaï : drame en vers quechuas du temps des Incas"
                                            },
                                            {
                                                "example_id": "f5fc524f-7f6f-44c6-8347-56e99232e51b",
                                                "sense_id": "318606a7-60d4-3706-a8b4-84ef63c9565f",
                                                "text": "La littérature orale quechua : De la région de Cuzco, Pérou"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d79941-1794-367a-a1d0-ac3d71b82282",
                                        "entry_id": "b2f6877c-7b7e-354e-baf6-f5191155e62a",
                                        "glosses": [
                                            "Relatif aux lesbiennes pratiquant la randonnée et le bricolage et s'habillant généralement en sportwear, par métonymie avec la marque de vêtement."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6859f8e9-3286-4482-8ca9-50ed5e0edf7a",
                                                "sense_id": "c1d79941-1794-367a-a1d0-ac3d71b82282",
                                                "text": "Vous pensiez que la lesbienne Quechua n’existait qu’en France ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quechua",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6335d550-4fc2-3a20-94e1-15dcb6a683d0",
                                        "entry_id": "65d4c839-84ee-3630-bb0c-43afd57570a8",
                                        "glosses": [
                                            "Famille de langues SOV agglutinantes parlées au Pérou, en Bolivie, Colombie, Équateur et Argentine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "401660a4-2fb8-42be-91e5-4b2664f92fc1",
                                                "sense_id": "6335d550-4fc2-3a20-94e1-15dcb6a683d0",
                                                "text": "Le quechua est une langue agglutinante à suffixes. Il ne possède pas d’article défini ni de distinction de genre, celle de nombre sur le nom étant facultative. Il possède, en revanche, une panoplie de suffixes verbaux et de phrase parmi lesquels se trouvent entre autres, des personnels subjectaux, objectaux et sagittaux ainsi que des suffixes temporels, aspectuels, modaux, diathétiques, un médiatif et des nominalisateurs à valeur sémantique variée."
                                            },
                                            {
                                                "example_id": "a5cc076e-cc37-4e1a-8f49-203e5fdc4b27",
                                                "sense_id": "6335d550-4fc2-3a20-94e1-15dcb6a683d0",
                                                "text": "\"Quechua\" est la désignation commune d’un ensemble de dialectes parlés par quelque sept millions de personnes au Pérou, en Bolivie, Colombie, Équateur et Argentine."
                                            },
                                            {
                                                "example_id": "d1643195-0c35-4fd8-a486-f64bfe49712b",
                                                "sense_id": "6335d550-4fc2-3a20-94e1-15dcb6a683d0",
                                                "text": "Mais ce qui irrite plus encore les patrons criollos et assimilés aux criollos, … est de voir leurs \"peones\" parler depuis le plus haut degré de l’État à tout le Pérou dans des langues autochtones comme le quechua. Une langue millénaire que les caciques politiques ont tenté d’annihiler, voire d’effacer depuis plus de cinq siècles, mais sans succès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
