                                        "glosses": [
                                            "Not adequate; lacking in quality or quantity required; insufficient for a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c761ec15-37af-45c8-b47e-7479dafabf97",
