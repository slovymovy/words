{
    "word_family": [
        "torture",
        "torturateur",
        "tortueux",
        "tortuosité"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa5c5545-79c3-36e9-94a6-179f3223aa0e",
                    "sense_definition": "Infliger d'atroces souffrances corporelles à une personne ou à un animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont refusé de <w>torturer</w> ce prisonnier malgré les ordres stricts de leur capitaine."
                        },
                        {
                            "text": "Dans ce vieux château, les gardes <w>torturaient</w> autrefois les captifs pour leur arracher des aveux."
                        }
                    ],
                    "synonyms": [
                        "martyriser"
                    ],
                    "common_phrases": [
                        "torturer un prisonnier",
                        "torturer un animal"
                    ]
                },
                {
                    "sense_id": "6c0daa59-d844-3923-991d-503d831c50eb",
                    "sense_definition": "Tourmenter moralement, infliger une grande angoisse psychologique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette affreuse incertitude continue de me <w>torturer</w> chaque nuit depuis son départ précipité."
                        },
                        {
                            "text": "Il ne sert à rien de se <w>torturer</w> l'esprit avec des fautes déjà commises."
                        }
                    ],
                    "synonyms": [
                        "tourmenter",
                        "angoisser"
                    ],
                    "antonyms": [
                        "apaiser",
                        "rassurer"
                    ],
                    "common_phrases": [
                        "se torturer l'esprit",
                        "se torturer les méninges"
                    ]
                },
                {
                    "sense_id": "ff9f9635-5439-34aa-94e7-d97c7cba71d3",
                    "sense_definition": "Déformer un objet matériel ou dénaturer le sens d'un texte ou d'un propos.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a fini par <w>torturer</w> le sens des propos tenus par le ministre."
                        },
                        {
                            "text": "Dans son anxiété, elle ne cessait de <w>torturer</w> un bout de papier entre ses mains tremblantes."
                        }
                    ],
                    "synonyms": [
                        "dénaturer",
                        "altérer",
                        "tordre"
                    ],
                    "antonyms": [
                        "respecter"
                    ],
                    "common_phrases": [
                        "torturer le sens"
                    ]
                }
            ]
        }
    ]
}