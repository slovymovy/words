                "senses": [
                    {
                        "sense_id": "d737f278-a3e1-3893-b496-5eed90994a44",
                        "entry_id": "2bf68e7c-b411-3ce4-be90-8180fd44810c",
                        "glosses": [
                            "Étoffe de soie, épaisse, à double chaîne, unie et sans lustre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a101356f-6cce-458e-8ebd-031dcdbddf54",
                                "sense_id": "d737f278-a3e1-3893-b496-5eed90994a44",
                                "text": "Croizeau se montrait toujours avec de beau linge, avec un habit bleu barbeau, gilet de pou-de-soie, pantalon noir, souliers à double semelle, noués avec des rubans de soie noire et craquant comme ceux d’un abbé."
                            },
                            {
                                "example_id": "49615ee6-e3fd-4685-91b9-97ca74b6411f",
                                "sense_id": "d737f278-a3e1-3893-b496-5eed90994a44",
                                "text": "Ce vieillard portait des souliers à boucles en acier à facettes, des bas de soie à raies circulaires alternativement blanches et bleues, une culotte en pou-de-soie à boucles ovales pareilles à celles des souliers, quant à la façon."
                            },
                            {
                                "example_id": "19f5bdac-7644-4864-92c8-71e0931a8c1a",
                                "sense_id": "d737f278-a3e1-3893-b496-5eed90994a44",
                                "text": "A part les accessoires indispensables, elle ne veut rien d’autre.\n– Ce pou-de-soie ne vous dit rien? On ne se marie pas tous les jours."
                            }
                        ]
                    }
                ],
